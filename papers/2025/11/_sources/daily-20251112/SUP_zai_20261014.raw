\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"在文字渲染以外，GLM-Image也同样擅长生成各种景别和尺寸的人像、宠物、风景、静物。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"id\":\"69e5b040dca8453370f68fc8\",\"type\":\"upload\",\"value\":{\"id\":979,\"alt\":\" \",\"updatedAt\":\"2026-04-20T04:39:51.696Z\",\"createdAt\":\"2026-04-20T04:39:51.695Z\",\"url\":\"/api/media/file/14-1.webp\",\"thumbnailURL\":null,\"filename\":\"14-1.webp\",\"mimeType\":\"image/webp\",\"filesize\":224690,\"width\":1080,\"height\":1202,\"focalX\":50,\"focalY\":50},\"fields\":null,\"format\":\"\",\"version\":3,\"relationTo\":\"media\"},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"linebreak\",\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"开源与在线体验\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"在线体验\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"ul\",\"type\":\"list\",\"start\":1,\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"listitem\",\"value\":1,\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"开放平台：https://bigmodel.cn/trialcenter/modeltrial/image\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":2,\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"即将上线Z.ai、智谱清言\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null}],\"listType\":\"bullet\",\"direction\":null},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"API接入\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"ul\",\"type\":\"list\",\"start\":1,\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"listitem\",\"value\":1,\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"开放平台：https://docs.bigmodel.cn/cn/guide/models/image-generation/glm-image\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":2,\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"GLM Coding Plan后续将接入GLM-Image MCP，现有订阅用户可直接使用。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null}],\"listType\":\"bullet\",\"direction\":null},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"开源部署\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"ul\",\"type\":\"list\",\"start\":1,\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"listitem\",\"value\":1,\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"GitHub：https://github.com/zai-org/GLM-Image\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":2,\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Hugging Face：https://huggingface.co/zai-org/GLM-Image\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":3,\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"魔搭社区：https://modelscope.cn/models/ZhipuAI/GLM-Image\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null}],\"listType\":\"bullet\",\"direction\":null},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"最后，我们用GLM-Image生成的一张图总结一下模型的核心要点。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"id\":\"69e5b06bdca8453370f68fc9\",\"type\":\"upload\",\"value\":{\"id\":980,\"alt\":\" \",\"updatedAt\":\"2026-04-20T04:49:47.320Z\",\"createdAt\":\"2026-04-20T04:49:47.319Z\",\"url\":\"/api/media/file/16-1.webp\",\"thumbnailURL\":null,\"filename\":\"16-1.webp\",\"mimeType\":\"image/webp\",\"filesize\":137656,\"width\":1080,\"height\":1906,\"focalX\":50,\"focalY\":50},\"fields\":null,\"format\":\"\",\"version\":3,\"relationTo\":\"media\"},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"我们期待GLM-Image能成为您创意的得力助手，也欢迎社区广大用户和开发者提出宝贵建议，共同推动国产开源图像生成模型的发展。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"contentType_en\":\"external\",\"externalUrl_en\":\"https://z.ai/blog/glm-image\",\"content_en\":null,\"featured\":false,\"thumbnail_zh\":null,\"thumbnail_en\":null,\"active\":true,\"order\":0,\"tag_zh\":[\"多模态\"],\"tag_en\":[\"Mutimodal AI\"],\"apiConfig_zh\":null,\"apiConfig_en\":null,\"experienceUrl_zh\":null,\"experienceUrl_en\":null,\"updatedAt\":\"2026-05-11T11:36:28.005Z\",\"createdAt\":\"2026-04-20T04:50:41.638Z\"},\"externalurl_zh\":\"https://www.zhipuai.cn/zh/glmImage\",\"externalurl_en\":\"https://www.zhipuai.cn/en/glmImage\",\"title_zh\":\"GLM-Image\",\"title_en\":\"GLM-Image\",\"desc_zh\":\"智谱联合华为开源国产芯片训练的多模态 SOTA 模型\",\"desc_en\":\"Zhipu AI x Huawei: Open-sourcing the Multimodal SOTA Model Trained on Domestic Computing Power\",\"showNew\":false,\"active\":true,\"order\":4,\"updatedAt\":\"2026-06-22T06:27:23.206Z\",\"createdAt\":\"2026-03-19T12:47:39.192Z\"},{\"id\":5,\"link_type\":\"external\",\"article\":{\"id\":145,\"title_zh\":\"AutoGLM开源：每台手机，都可以成为AI手机\",\"title_en\":\"AutoGLM Goes Open Source\",\"createAt\":\"2025-12-08T16:00:00.000Z\",\"category\":\"blog\",\"resume_zh\":\"\",\"resume_en\":\"Unlocking the AI Phone for Everyone\",\"contentType_zh\":\"content\",\"externalUrl_zh\":null,\"content_zh\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"left\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"我们想做的，到底是一件什么事\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"过去的很长时间，我们一直在回答同一个问题：\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"如果 AI 真的是“助手”，它能不能像人一样，自己把手机拿起来，把一件事从头做到尾？\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"在我们的想象里，AI 不该只停留在聊天框里，而是可以走进用户每天真正要点的那些 App 里：\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"帮你在外卖 App 里完成从选择到下单；\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"帮你在云手机里，批量处理通知、点赞评论；\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"帮你在销售、客服、出勤等场景里，自动做完一堆“你自己也不想点的重复动作”。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"AutoGLM 想做的，就是这件事：让 AI 真正学会“使用手机”。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"left\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"32个月，我们具体做到了什么？\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"left\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"用一句简单的话来说：\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"我们希望 AutoGLM，不仅能“说”，还能“做”。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"为了这一句话，我们从 2023 年 4 月——一个大多数人还不知道大模型是什么的时候，完全从零去探索每一个细节，到今天，已经 32 个月了。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h3\",\"type\":\"heading\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"1.“乱点” -\u003e “可控”\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"在最开始的版本里，基于大模型所构建的系统只知道“点”、“滑”等操作，偶尔能完成一个很短的流程，更多时候会迷失在不知所谓的操作中，甚至陷入死循环。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"为了解决这类问题，我们花了近一年的时间，去梳理每一个可能的问题，尝试把这些“乱点的手”变成一只“\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"可控的手”\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"：\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"建了一整套 Phone Use 能力框架；\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"把点击、滑动、输入、截图、界面理解这些最基础的动作抽象出来；\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"让模型学会把一句自然语言拆解为一系列稳定、可回放的操作步骤；\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"处理掉各种真实世界的“脏信息”：网络波动、弹窗打断、广告遮挡……\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"2024 年 10 月 25 日，我们发布了第一个能够在真机上稳定完成一条完整操作链路的 AutoGLM，\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"它被业内视为全球首个具备 Phone Use 能力的 AI Agent。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h3\",\"type\":\"heading\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"2.第一个由 AI 发出的红包\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"2024 年 11 月，AutoGLM 发出了人类历史上第一个由 AI 完成的手机红包：不是脚本录制，不是内嵌 API 调用，而是通过在屏幕上“看见”界面、“理解”含义，一步一步完成点击。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"对我们来说，这是一个信号：\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"从此以后，手机上的很多交互，第一次可以完全由 AI 接手。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"id\":\"69e5a9e2b63f5a24437fc435\",\"type\":\"upload\",\"value\":{\"id\":965,\"alt\":\" \",\"updatedAt\":\"2026-04-20T04:21:53.814Z\",\"createdAt\":\"2026-04-20T04:21:53.813Z\",\"url\":\"/api/media/file/640.webp\",\"thumbnailURL\":null,\"filename\":\"640.webp\",\"mimeType\":\"image/webp\",\"filesize\":21164,\"width\":850,\"height\":566,\"focalX\":50,\"focalY\":50},\"fields\":null,\"format\":\"\",\"version\":3,\"relationTo\":\"media\"},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h3\",\"type\":\"heading\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"3.走向云手机：把能力放到一个更安全的空间\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"2025 年\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"，我们发布了 AutoGLM 2.0，验证了强化学习的规模扩展定律，提出了 MobileRL、ComputerRL 和 AgentRL 算法，让 AutoGLM 在上千个虚拟设备环境里同时强化学习，极大扩展了 Agent 的准确性和泛化能力。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"更关键的是，我们不希望 Agent 直接在用户真实手机、真实微信上肆意操作，于是选择把它放进一台和用户真实世界脱离的虚拟手机里：\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"这台手机跑在云端；\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"每一个动作都可以回放、审计、干预；\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"真正敏感的数据可以严格隔离。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"这套设计背后的直觉很简单：\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"让 AI 会用手机之前，我们要先保证，它不会在不该点的地方胡乱伸手。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"除了云手机的选择，我们主动放弃了操作微信等这些离用户隐私较近的 APP。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"left\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"为什么要开源？我们真正在意的是什么？\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"left\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"从产品的角度，AutoGLM 已经可以支撑起很多真实场景；从工程的角度，AutoGLM的积累足够写成一大摞技术报告。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"那为什么，在这个时间点，我们选择把它开源？\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"我们想清楚的，大概有三件事。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h3\",\"type\":\"heading\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"1.这件事只在一家公司做，是不够的\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"AI 手机已经是趋势，但如果“会用手机的 AI 能力”只掌握在极少数厂商手里，那意味着：\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"开发者的创新空间，要看平台愿不愿意开放接口；\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"用户日常生活中最重要的那台设备，越来越像“别人家的入口”。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"AutoGLM 开源的第一层初衷，是把这一层能力变成整个行业可以共同拥有、共同打磨的公共底座。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"你可以把它当成一块积木，放进你自己的系统里，也可以把它拆开、重写、改造，那一刻起，它就不再只是“智谱的 AutoGLM”，而是你和你的团队做出来的东西的一部分。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h3\",\"type\":\"heading\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"2.让隐私和控制权，真正留在使用方这一侧\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"我们也很清楚，Phone Use 能力，一旦做大，天然会碰到最敏感的那一部分世界：个人微信、支付、聊天记录、照片相册、企业内部系统。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"我们不希望也不应该，把这些东西握在自己手里。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"通过开源和私有化部署，企业和开发者可以在自己的合规环境中完整掌控数据、日志和权限。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"可以让手机，成为专属自己的 AI 手机。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"用一句话概括就是：\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"技术向整个生态开放，数据与隐私，永远留在使用方这一侧。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h3\",\"type\":\"heading\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"3.把我们走过的路，变成大家在Agent爆发时代的起跑线\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"AutoGLM是一条很陡的路：我们啃过的技术难题、踩过的坑、重写过的框架，\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"在很多场景里都可以复用，也值得被复用。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"但这还不够，“一花独放不是春”。Agent 的爆发，需要所有人一起参与。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"我们更乐见的是：\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"有团队基于 AutoGLM，做出真正意义上的 AI 原生手机；\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"有研究者把其中的某个模块拆出来，变成一篇论文、一套新算法；\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"有个人开发者把一个 Demo 改成自己的项目，在某个小众场景里真正跑起来。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"我们希望开源社区：\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"从今天开始，人人都可以拥有自己的手机 Agent。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"left\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"你现在能拿到什么\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"left\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"我们开源的，是一整套可以「拿来就用」的能力，而不仅仅是一份概念说明。具体包括：\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"训练好的核心模型；\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Phone Use 能力框架与工具链；\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"可直接跑通的 Demo，覆盖 50+ 高频中文 App；\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"针对 Android 的适配层与示例工程；\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"文档、快速上手指南。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"模型会以 MIT 开源许可证的形式开放，而所有代码会以 Apache-2.0 开源许可证的形式，托管在 GitHub 仓库（示例：github.com/zai-org/Open-AutoGLM）中。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"你可以把它当成一套现成的基础设施，也可以单独拆用其中的某一部分，甚至可以把它改得面目全非——只要它帮助你更接近你心目中的「AI 原生手机」。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"left\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"接下来\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"