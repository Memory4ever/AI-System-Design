{"data":{"id":"10.48550/arxiv.2511.20182","type":"dois","attributes":{"doi":"10.48550/arxiv.2511.20182","prefix":"10.48550","suffix":"arxiv.2511.20182","identifiers":[{"identifier":"2511.20182","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2511.20182"}],"creators":[{"name":"Metinov, Adilet","nameType":"Personal","givenName":"Adilet","familyName":"Metinov","affiliation":[],"nameIdentifiers":[]},{"name":"Kudakeeva, Gulida M.","nameType":"Personal","givenName":"Gulida M.","familyName":"Kudakeeva","affiliation":[],"nameIdentifiers":[]},{"name":"Kabaeva, Gulnara D.","nameType":"Personal","givenName":"Gulnara D.","familyName":"Kabaeva","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"KyrgyzBERT: A Compact, Efficient Language Model for Kyrgyz NLP"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"},{"lang":"en","subject":"I.2.7","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-11-25T11:05:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-11-26T01:45:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Kyrgyz remains a low-resource language with limited foundational NLP tools. To address this gap, we introduce KyrgyzBERT, the first publicly available monolingual BERT-based language model for Kyrgyz. The model has 35.9M parameters and uses a custom tokenizer designed for the language's morphological structure. To evaluate performance, we create kyrgyz-sst2, a sentiment analysis benchmark built by translating the Stanford Sentiment Treebank and manually annotating the full test set. KyrgyzBERT fine-tuned on this dataset achieves an F1-score of 0.8280, competitive with a fine-tuned mBERT model five times larger. All models, data, and code are released to support future research in Kyrgyz NLP.","descriptionType":"Abstract"},{"description":"3 pages, 1 figure, 2 tables. Preprint","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2511.20182","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-11-26T03:04:16.000Z","registered":"2025-11-26T03:04:16.000Z","published":"2025","updated":"2025-11-26T03:04:16.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2511.20182","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}