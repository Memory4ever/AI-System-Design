{"data":{"id":"10.48550/arxiv.2511.20172","type":"dois","attributes":{"doi":"10.48550/arxiv.2511.20172","prefix":"10.48550","suffix":"arxiv.2511.20172","identifiers":[{"identifier":"2511.20172","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2511.20172"}],"creators":[{"name":"Yang, Xinjun","nameType":"Personal","givenName":"Xinjun","familyName":"Yang","affiliation":[],"nameIdentifiers":[]},{"name":"Hu, Qingda","nameType":"Personal","givenName":"Qingda","familyName":"Hu","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Junru","nameType":"Personal","givenName":"Junru","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Feifei","nameType":"Personal","givenName":"Feifei","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Zhu, Yicong","nameType":"Personal","givenName":"Yicong","familyName":"Zhu","affiliation":[],"nameIdentifiers":[]},{"name":"Zhou, Yuqi","nameType":"Personal","givenName":"Yuqi","familyName":"Zhou","affiliation":[],"nameIdentifiers":[]},{"name":"Lin, Qiuru","nameType":"Personal","givenName":"Qiuru","familyName":"Lin","affiliation":[],"nameIdentifiers":[]},{"name":"Dai, Jian","nameType":"Personal","givenName":"Jian","familyName":"Dai","affiliation":[],"nameIdentifiers":[]},{"name":"Kong, Yang","nameType":"Personal","givenName":"Yang","familyName":"Kong","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Jiayu","nameType":"Personal","givenName":"Jiayu","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Xu, Guoqiang","nameType":"Personal","givenName":"Guoqiang","familyName":"Xu","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Qiang","nameType":"Personal","givenName":"Qiang","familyName":"Liu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Beluga: A CXL-Based Memory Architecture for Scalable and Efficient LLM KVCache Management"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-11-25T10:51:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-11-26T01:45:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-27T06:20:27Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-01T01:25:50Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-11","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"The rapid increase in LLM model sizes and the growing demand for long-context inference have made memory a critical bottleneck in GPU-accelerated serving systems. Although high-bandwidth memory (HBM) on GPUs offers fast access, its limited capacity necessitates reliance on host memory (CPU DRAM) to support larger working sets such as the KVCache. However, the maximum DRAM capacity is constrained by the limited number of memory channels per CPU socket. To overcome this limitation, current systems often adopt RDMA-based disaggregated memory pools, which introduce significant challenges including high access latency, complex communication protocols, and synchronization overhead. Fortunately, the emerging CXL technology introduces new opportunities in KVCache design. In this paper, we propose Beluga, a novel memory architecture that enables GPUs and CPUs to access a shared, large-scale memory pool through CXL switches. By supporting native load/store access semantics over the CXL fabric, our design delivers near-local memory latency, while reducing programming complexity and minimizing synchronization overhead. We conduct a systematic characterization of a commercial CXL switch-based memory pool and propose a set of design guidelines. Based on Beluga, we design and implement Beluga-KVCache, a system tailored for managing the large-scale KVCache in LLM inference. Beluga-KVCache achieves an 89.6% reduction in Time-To-First-Token (TTFT) and 7.35x throughput improvement in the vLLM inference engine compared to RDMA-based solutions. To the best of our knowledge, Beluga is the first system that enables GPUs to directly access large-scale memory pools through CXL switches, marking a significant step toward low-latency, shared access to vast memory resources by GPUs.","descriptionType":"Abstract"},{"description":"13 pages, accepted by SIGMOD'26","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2511.20172","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-11-26T03:04:02.000Z","registered":"2025-11-26T03:04:02.000Z","published":"2025","updated":"2025-12-01T04:26:44.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2511.20172","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}