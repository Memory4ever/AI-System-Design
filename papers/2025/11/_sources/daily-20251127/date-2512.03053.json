{"data":{"id":"10.48550/arxiv.2512.03053","type":"dois","attributes":{"doi":"10.48550/arxiv.2512.03053","prefix":"10.48550","suffix":"arxiv.2512.03053","identifiers":[{"identifier":"2512.03053","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2512.03053"}],"creators":[{"name":"Cassidy, Andrew S.","nameType":"Personal","givenName":"Andrew S.","familyName":"Cassidy","affiliation":[],"nameIdentifiers":[]},{"name":"Garreau, Guillaume","nameType":"Personal","givenName":"Guillaume","familyName":"Garreau","affiliation":[],"nameIdentifiers":[]},{"name":"Sivagnaname, Jay","nameType":"Personal","givenName":"Jay","familyName":"Sivagnaname","affiliation":[],"nameIdentifiers":[]},{"name":"Grassi, Mike","nameType":"Personal","givenName":"Mike","familyName":"Grassi","affiliation":[],"nameIdentifiers":[]},{"name":"Brezzo, Bernard","nameType":"Personal","givenName":"Bernard","familyName":"Brezzo","affiliation":[],"nameIdentifiers":[]},{"name":"Arthur, John V.","nameType":"Personal","givenName":"John V.","familyName":"Arthur","affiliation":[],"nameIdentifiers":[]},{"name":"Modha, Dharmendra S.","nameType":"Personal","givenName":"Dharmendra S.","familyName":"Modha","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Mitigating hallucinations and omissions in LLMs for invertible problems: An application to hardware logic design automation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Hardware Architecture (cs.AR)","subjectScheme":"arXiv"},{"lang":"en","subject":"Programming Languages (cs.PL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-11-25T00:47:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-12-04T01:00:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-16T21:39:03Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-20T00:10:50Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-12","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"We show for invertible problems that transform data from a source domain (for example, Logic Condition Tables (LCTs)) to a destination domain (for example, Hardware Description Language (HDL) code), an approach of using Large Language Models (LLMs) as a lossless encoder from source to destination followed by as a lossless decoder back to the source, comparable to lossless compression in information theory, can mitigate most of the LLM drawbacks of hallucinations and omissions. Specifically, using LCTs as inputs, we generate the full HDL for a two-dimensional network-on-chip router (13 units, 1500-2000 lines of code) using seven different LLMs, reconstruct the LCTs from the auto-generated HDL, and compare the original and reconstructed LCTs. This approach yields significant productivity improvements, not only confirming correctly generated LLM logic and detecting incorrectly generated LLM logic but also assisting developers in finding design specification errors.","descriptionType":"Abstract"},{"description":"7 pages, 2 figures, 7 tables","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2512.03053","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-12-04T02:33:43.000Z","registered":"2025-12-04T02:33:44.000Z","published":"2025","updated":"2026-04-20T02:10:42.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2512.03053","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}