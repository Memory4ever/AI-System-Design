{"data":{"id":"10.48550/arxiv.2511.20196","type":"dois","attributes":{"doi":"10.48550/arxiv.2511.20196","prefix":"10.48550","suffix":"arxiv.2511.20196","identifiers":[{"identifier":"2511.20196","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2511.20196"}],"creators":[{"name":"Zeng, Zhen","nameType":"Personal","givenName":"Zhen","familyName":"Zeng","affiliation":[],"nameIdentifiers":[]},{"name":"Gu, Leijiang","nameType":"Personal","givenName":"Leijiang","familyName":"Gu","affiliation":[],"nameIdentifiers":[]},{"name":"Duan, Zhangling","nameType":"Personal","givenName":"Zhangling","familyName":"Duan","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Feng","nameType":"Personal","givenName":"Feng","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Snoek, Cees G. M.","nameType":"Personal","givenName":"Cees G. M.","familyName":"Snoek","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Meng","nameType":"Personal","givenName":"Meng","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Shi, Zenglin","nameType":"Personal","givenName":"Zenglin","familyName":"Shi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Benign Memory Forgetting for Selective Multimodal Large Language Model Unlearning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-11-25T11:22:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-11-26T01:46:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-26T06:16:30Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-29T00:25:08Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-11","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Multimodal large language models (MLLMs) can inadvertently memorize privacy-sensitive information during training. While existing unlearning methods can remove such content, they often severely degrade the model's foundational capabilities, such as general image understanding. This critical shortfall motivates our investigation into benign memory forgetting, the precise removal of targeted, privacy-sensitive knowledge while rigorously preserving unrelated capabilities. To pioneer and evaluate progress toward this objective, we introduce S-MLLMUn Bench, the first benchmark designed to jointly and quantitatively assess an unlearning method's efficacy in knowledge erasure and the preservation of image understanding. Furthermore, we propose the Sculpted Memory Forgetting Adapter (SMFA), a new framework that enables benign memory forgetting. SMFA confines forgetting to designated memory regions, maintaining overall model performance. By initially fine-tuning the model to replace sensitive outputs with refusals, SMFA generates a memory forgetting adapter, followed by a retaining anchor-guided masking mechanism that safeguards unrelated knowledge. Extensive experiments on S-MLLMUn Bench demonstrate that existing methods fail to achieve benign forgetting, whereas our proposed SMFA serves as an effective baseline, successfully achieving targeted knowledge erasure without compromising the model's foundational visual capabilities. Code and data are available at https://github.com/zeng-zhen/S-MLLMUn.","descriptionType":"Abstract"},{"description":"Accepted by ECCV 2026","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2511.20196","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-11-26T03:04:35.000Z","registered":"2025-11-26T03:04:36.000Z","published":"2025","updated":"2026-06-29T01:59:57.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2511.20196","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}