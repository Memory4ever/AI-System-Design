{"data":{"id":"10.48550/arxiv.2511.20644","type":"dois","attributes":{"doi":"10.48550/arxiv.2511.20644","prefix":"10.48550","suffix":"arxiv.2511.20644","identifiers":[{"identifier":"2511.20644","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2511.20644"}],"creators":[{"name":"Liu, Zuntao","nameType":"Personal","givenName":"Zuntao","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Du, Yi","nameType":"Personal","givenName":"Yi","familyName":"Du","affiliation":[],"nameIdentifiers":[]},{"name":"Fu, Taimeng","nameType":"Personal","givenName":"Taimeng","familyName":"Fu","affiliation":[],"nameIdentifiers":[]},{"name":"Su, Shaoshu","nameType":"Personal","givenName":"Shaoshu","familyName":"Su","affiliation":[],"nameIdentifiers":[]},{"name":"Ho, Cherie","nameType":"Personal","givenName":"Cherie","familyName":"Ho","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Chen","nameType":"Personal","givenName":"Chen","familyName":"Wang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Vision-Language Memory for Spatial Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-11-25T18:59:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-11-26T02:09:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-09T17:59:10Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-09-11T00:15:43Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-11","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1007/978-3-032-37356-4_17","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Spatial reasoning is a critical capability for intelligent robots, yet current vision-language models (VLMs) still fall short of human-level performance in video-based spatial reasoning. This gap mainly stems from two challenges: a semantic-geometric misalignment that prevents consistent 3D understanding, and the absence of persistent memory to retain 3D representation and understanding across frames. To address these limitations, we present VLM$^2$, a Vision-Language Model with persistent Memory for spatial reasoning with a view-consistent, 3D-aware representation purely from 2D videos. Specifically, we incorporate a dual-memory module consisting of a working memory that operates as a sliding window to focus on immediate context, and an episodic memory that consolidates and stores critical information across frames. This design enables bounded and efficient spatial reasoning under a fixed computational cost. Extensive experiments on multiple benchmarks show that VLM$^2$ achieves state-of-the-art performance among video-based models, significantly advancing the frontier of visual-spatial intelligence.","descriptionType":"Abstract"},{"description":"Accepted to European Conference on Computer Vision (ECCV), 2026","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2511.20644","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-11-26T03:14:54.000Z","registered":"2025-11-26T03:14:54.000Z","published":"2025","updated":"2026-09-11T02:37:34.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2511.20644","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[{"id":"10.1007/978-3-032-37356-4_17","type":"dois"}]}}}}