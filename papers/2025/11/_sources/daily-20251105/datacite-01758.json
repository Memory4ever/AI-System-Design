{"data":{"id":"10.48550/arxiv.2511.01758","type":"dois","attributes":{"doi":"10.48550/arxiv.2511.01758","prefix":"10.48550","suffix":"arxiv.2511.01758","identifiers":[{"identifier":"2511.01758","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2511.01758"}],"creators":[{"name":"Wu, Mian","nameType":"Personal","givenName":"Mian","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Gavin","nameType":"Personal","givenName":"Gavin","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Min, Sewon","nameType":"Personal","givenName":"Sewon","familyName":"Min","affiliation":[],"nameIdentifiers":[]},{"name":"Levine, Sergey","nameType":"Personal","givenName":"Sergey","familyName":"Levine","affiliation":[],"nameIdentifiers":[]},{"name":"Kumar, Aviral","nameType":"Personal","givenName":"Aviral","familyName":"Kumar","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RLAC: Reinforcement Learning with Adversarial Critic for Free-Form Generation Tasks"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-11-03T17:15:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-11-04T02:50:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Open-ended generation tasks require outputs to satisfy diverse and often implicit task-specific evaluation rubrics. The sheer number of relevant rubrics leads to prohibitively high verification costs and incomplete assessments of a response, making reinforcement learning (RL) post-training with rubric-based rewards difficult to scale. This problem is exacerbated by the fact that often the best way to combine these rubrics into one single reward is also highly prompt-specific. We propose Reinforcement Learning with Adversarial Critic (RLAC), a post-training approach that addresses these challenges via dynamic rubric verification. Our approach employs a large language model (LLM) as a critic that dynamically identifies only the most likely failure modes (e.g., a factual error or unhandled edge case), which are then verified by an external validator to optimize both generator and critic jointly. By training both the generator and the critic, this game enhances the critic's error detection and the generator's output quality while reducing required verifications. Our experiments demonstrate that RLAC improves factual accuracy in text generation and correctness in code generation, while also outperforming exhaustive verification and reward model methods. We show that dynamic critics are more effective than fixed critics, showcasing the potential of RLAC for scaling RL post-training to free-form generation tasks.","descriptionType":"Abstract"},{"description":"Project page: https://mianwu01.github.io/RLAC_website/","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2511.01758","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-11-04T04:30:38.000Z","registered":"2025-11-04T04:30:39.000Z","published":"2025","updated":"2025-11-04T04:30:39.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2511.01758","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}