{"data":{"id":"10.48550/arxiv.2511.02776","type":"dois","attributes":{"doi":"10.48550/arxiv.2511.02776","prefix":"10.48550","suffix":"arxiv.2511.02776","identifiers":[{"identifier":"2511.02776","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2511.02776"}],"creators":[{"name":"Fan, Shichao","nameType":"Personal","givenName":"Shichao","familyName":"Fan","affiliation":[],"nameIdentifiers":[]},{"name":"Wu, Kun","nameType":"Personal","givenName":"Kun","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Che, Zhengping","nameType":"Personal","givenName":"Zhengping","familyName":"Che","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Xinhua","nameType":"Personal","givenName":"Xinhua","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Wu, Di","nameType":"Personal","givenName":"Di","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Liao, Fei","nameType":"Personal","givenName":"Fei","familyName":"Liao","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Ning","nameType":"Personal","givenName":"Ning","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Yixue","nameType":"Personal","givenName":"Yixue","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhao, Zhen","nameType":"Personal","givenName":"Zhen","familyName":"Zhao","affiliation":[],"nameIdentifiers":[]},{"name":"Xu, Zhiyuan","nameType":"Personal","givenName":"Zhiyuan","familyName":"Xu","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Meng","nameType":"Personal","givenName":"Meng","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Qingjie","nameType":"Personal","givenName":"Qingjie","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Shanghang","nameType":"Personal","givenName":"Shanghang","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Wan, Min","nameType":"Personal","givenName":"Min","familyName":"Wan","affiliation":[],"nameIdentifiers":[]},{"name":"Tang, Jian","nameType":"Personal","givenName":"Jian","familyName":"Tang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"XR-1: Towards Versatile Vision-Language-Action Models via Learning Unified Vision-Motion Representations"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Robotics (cs.RO)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-11-04T17:59:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-11-05T02:00:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-14T09:17:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-15T00:44:01Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-07-12T06:20:43Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-07-14T00:43:27Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-11","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Recent progress in large-scale robotic datasets and vision-language models (VLMs) has advanced research on vision-language-action (VLA) models. However, existing VLA models still face two fundamental challenges: (i) producing precise low-level actions from high-dimensional observations, (ii) bridging domain gaps across heterogeneous data sources, including diverse robot embodiments and human demonstrations. Existing methods often encode latent variables from either visual dynamics or robotic actions to guide policy learning, but they fail to fully exploit the complementary multi-modal knowledge present in large-scale, heterogeneous datasets. In this work, we present X Robotic Model 1 (XR-1), a novel framework for versatile and scalable VLA learning across diverse robots, tasks, and environments. XR-1 introduces the \\emph{Unified Vision-Motion Codes (UVMC)}, a discrete latent representation learned via a dual-branch VQ-VAE that jointly encodes visual dynamics and robotic motion. UVMC addresses these challenges by (i) serving as an intermediate representation between the observations and actions, and (ii) aligning multimodal dynamic information from heterogeneous data sources to capture complementary knowledge. To effectively exploit UVMC, we propose a three-stage training paradigm: (i) self-supervised UVMC learning, (ii) UVMC-guided pretraining on large-scale cross-embodiment robotic datasets, and (iii) task-specific post-training. We validate XR-1 through extensive real-world experiments with more than 14,000 rollouts on six different robot embodiments, spanning over 120 diverse manipulation tasks. XR-1 consistently outperforms state-of-the-art baselines such as $π_{0.5}$, $π_0$, RDT, UniVLA, and GR00T-N1.5 while demonstrating strong generalization to novel objects, background variations, distractors, and illumination changes. Our project is at https://xr-1-vla.github.io/.","descriptionType":"Abstract"},{"description":"Accepted to ICML2026 as Oral","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2511.02776","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-11-05T03:00:36.000Z","registered":"2025-11-05T03:00:37.000Z","published":"2025","updated":"2026-07-14T03:58:43.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2511.02776","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}