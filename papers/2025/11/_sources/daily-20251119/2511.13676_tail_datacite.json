{"data":{"id":"10.48550/arxiv.2511.13676","type":"dois","attributes":{"doi":"10.48550/arxiv.2511.13676","prefix":"10.48550","suffix":"arxiv.2511.13676","identifiers":[{"identifier":"2511.13676","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2511.13676"}],"creators":[{"name":"Oh, Hyunwoo","nameType":"Personal","givenName":"Hyunwoo","familyName":"Oh","affiliation":[],"nameIdentifiers":[]},{"name":"Nam, KyungIn","nameType":"Personal","givenName":"KyungIn","familyName":"Nam","affiliation":[],"nameIdentifiers":[]},{"name":"Bhattacharjya, Rajat","nameType":"Personal","givenName":"Rajat","familyName":"Bhattacharjya","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Hanning","nameType":"Personal","givenName":"Hanning","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Das, Tamoghno","nameType":"Personal","givenName":"Tamoghno","familyName":"Das","affiliation":[],"nameIdentifiers":[]},{"name":"Yun, Sanggeon","nameType":"Personal","givenName":"Sanggeon","familyName":"Yun","affiliation":[],"nameIdentifiers":[]},{"name":"Jang, Suyeon","nameType":"Personal","givenName":"Suyeon","familyName":"Jang","affiliation":[],"nameIdentifiers":[]},{"name":"Ding, Andrew","nameType":"Personal","givenName":"Andrew","familyName":"Ding","affiliation":[],"nameIdentifiers":[]},{"name":"Dutt, Nikil","nameType":"Personal","givenName":"Nikil","familyName":"Dutt","affiliation":[],"nameIdentifiers":[]},{"name":"Imani, Mohsen","nameType":"Personal","givenName":"Mohsen","familyName":"Imani","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"T-SAR: A Full-Stack Co-design for CPU-Only Ternary LLM Inference via In-Place SIMD ALU Reorganization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Hardware Architecture (cs.AR)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-11-17T18:32:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-11-18T03:07:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Recent advances in LLMs have outpaced the computational and memory capacities of edge platforms that primarily employ CPUs, thereby challenging efficient and scalable deployment. While ternary quantization enables significant resource savings, existing CPU solutions rely heavily on memory-based lookup tables (LUTs) which limit scalability, and FPGA or GPU accelerators remain impractical for edge use. This paper presents T-SAR, the first framework to achieve scalable ternary LLM inference on CPUs by repurposing the SIMD register file for dynamic, in-register LUT generation with minimal hardware modifications. T-SAR eliminates memory bottlenecks and maximizes data-level parallelism, delivering 5.6-24.5x and 1.1-86.2x improvements in GEMM latency and GEMV throughput, respectively, with only 3.2% power and 1.4% area overheads in SIMD units. T-SAR achieves up to 2.5-4.9x the energy efficiency of an NVIDIA Jetson AGX Orin, establishing a practical approach for efficient LLM inference on edge platforms.","descriptionType":"Abstract"},{"description":"Accepted to DATE 2026","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2511.13676","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-11-18T04:53:53.000Z","registered":"2025-11-18T04:53:54.000Z","published":"2025","updated":"2025-11-18T04:53:54.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2511.13676","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}