{"data":{"id":"10.48550/arxiv.2511.12860","type":"dois","attributes":{"doi":"10.48550/arxiv.2511.12860","prefix":"10.48550","suffix":"arxiv.2511.12860","identifiers":[{"identifier":"2511.12860","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2511.12860"}],"creators":[{"name":"Jang, Yongjoo","nameType":"Personal","givenName":"Yongjoo","familyName":"Jang","affiliation":[],"nameIdentifiers":[]},{"name":"Hwang, Sangwoo","nameType":"Personal","givenName":"Sangwoo","familyName":"Hwang","affiliation":[],"nameIdentifiers":[]},{"name":"Lee, Hojin","nameType":"Personal","givenName":"Hojin","familyName":"Lee","affiliation":[],"nameIdentifiers":[]},{"name":"Jung, Sangwoo","nameType":"Personal","givenName":"Sangwoo","familyName":"Jung","affiliation":[],"nameIdentifiers":[]},{"name":"Lee, Donghun","nameType":"Personal","givenName":"Donghun","familyName":"Lee","affiliation":[],"nameIdentifiers":[]},{"name":"Shim, Wonbo","nameType":"Personal","givenName":"Wonbo","familyName":"Shim","affiliation":[],"nameIdentifiers":[]},{"name":"Kung, Jaeha","nameType":"Personal","givenName":"Jaeha","familyName":"Kung","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dissecting and Re-architecting 3D NAND Flash PIM Arrays for Efficient Single-Batch Token Generation in LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Hardware Architecture (cs.AR)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-11-17T01:20:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-11-18T02:16:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"The advancement of large language models has led to models with billions of parameters, significantly increasing memory and compute demands. Serving such models on conventional hardware is challenging due to limited DRAM capacity and high GPU costs. Thus, in this work, we propose offloading the single-batch token generation to a 3D NAND flash processing-in-memory (PIM) device, leveraging its high storage density to overcome the DRAM capacity wall. We explore 3D NAND flash configurations and present a re-architected PIM array with an H-tree network for optimal latency and cell density. Along with the well-chosen PIM array size, we develop operation tiling and mapping methods for LLM layers, achieving a 2.4x speedup over four RTX4090 with vLLM and comparable performance to four A100 with only 4.9% latency overhead. Our detailed area analysis reveals that the proposed 3D NAND flash PIM architecture can be integrated within a 4.98mm2 die area under the memory array, without extra area overhead.","descriptionType":"Abstract"},{"description":"This paper is accepted in the 43rd IEEE International Conference on Computer Design (ICCD), 2025","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2511.12860","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-11-18T04:34:35.000Z","registered":"2025-11-18T04:34:36.000Z","published":"2025","updated":"2025-11-18T04:34:36.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2511.12860","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}