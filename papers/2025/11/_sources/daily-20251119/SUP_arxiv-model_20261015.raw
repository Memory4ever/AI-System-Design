      <a href="/search/?searchtype=author&amp;query=Wen%2C+W">Weiping Wen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Wu%2C+X">Xiaojie Wu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Liu%2C+J">Junhua Liu</a>
      
