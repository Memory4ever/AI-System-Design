    <p class="title is-5 mathjax">
      
        Knowledge-Grounded Agentic Large <span class="search-hit mathjax">Language</span> <span class="search-hit mathjax">Models</span> for Multi-Hazard Understanding from Reconnaissance Reports
      
    </p>
    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Kuai%2C+C">Chenchen Kuai</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Li%2C+Z">Zihao Li</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Rosen%2C+B">Braden Rosen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Paal%2C+S">Stephanie Paal</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Jafari%2C+N">Navid Jafari</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Briaud%2C+J">Jean-Louis Briaud</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhang%2C+Y">Yunlong Zhang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Hashash%2C+Y+M+A">Youssef M. A. Hashash</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhou%2C+Y">Yang Zhou</a>
      
