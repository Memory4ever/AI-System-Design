      <a href="/search/?searchtype=author&amp;query=Kwak%2C+S">SeokJoo Kwak</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Kim%2C+J">Jihoon Kim</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Kim%2C+B">Boyoun Kim</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Yoon%2C+J+J">Jung Jae Yoon</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Jang%2C+W">Wooseok Jang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Hong%2C+J">Jeonghoon Hong</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Yang%2C+J">Jaeho Yang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Kwon%2C+Y">Yeong-Dae Kwon</a>
      
