{"data":{"id":"10.48550/arxiv.2511.13368","type":"dois","attributes":{"doi":"10.48550/arxiv.2511.13368","prefix":"10.48550","suffix":"arxiv.2511.13368","identifiers":[{"identifier":"2511.13368","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2511.13368"}],"creators":[{"name":"Dymkiewicz, Kajetan","nameType":"Personal","givenName":"Kajetan","familyName":"Dymkiewicz","affiliation":[],"nameIdentifiers":[]},{"name":"Vulic, Ivan","nameType":"Personal","givenName":"Ivan","familyName":"Vulic","affiliation":[],"nameIdentifiers":[]},{"name":"Yannakoudakis, Helen","nameType":"Personal","givenName":"Helen","familyName":"Yannakoudakis","affiliation":[],"nameIdentifiers":[]},{"name":"Shapira, Eilam","nameType":"Personal","givenName":"Eilam","familyName":"Shapira","affiliation":[],"nameIdentifiers":[]},{"name":"Reichart, Roi","nameType":"Personal","givenName":"Roi","familyName":"Reichart","affiliation":[],"nameIdentifiers":[]},{"name":"Korhonen, Anna","nameType":"Personal","givenName":"Anna","familyName":"Korhonen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Donors and Recipients: On Asymmetric Transfer Across Tasks and Languages with Parameter-Efficient Fine-Tuning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-11-17T13:41:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-11-18T02:50:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-08T15:10:27Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-09T01:48:17Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-09-11T19:22:29Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-09-15T00:10:42Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-11","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Large language models (LLMs) perform strongly across tasks and languages, yet how improvements in one task or language affect other tasks and languages remains poorly understood. We conduct a controlled LoRA fine-tuning study across multiple open-weight LLM families and scales, using a standardised grid of 11 languages and four benchmarks. We fine-tune each model on a single task-language source, then evaluate it on all other task-language target pairs to measure transfer. We decompose transfer into three regimes: (i) Matched-Task (Cross-Language), (ii) Cross-Task (Matched-Language), and (iii) Cross-Task (Cross-Language). Single-source fine-tuning yields a net positive uplift across regimes, but the gains are strongly asymmetric. Matched-Task (Cross-Language) transfer emerges as the most effective and structurally regular regime, with transfer magnitude driven principally by the identity of the target language rather than model architecture. We identify a stable coarse-grained hierarchy in which some task and language targets consistently absorb gains from diverse sources, while others remain relatively isolated. These results imply that effective fine-tuning requires accounting for donor-recipient roles to maximise downstream gains while limiting collateral degradation in other capabilities.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2511.13368","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-11-18T04:46:13.000Z","registered":"2025-11-18T04:46:13.000Z","published":"2025","updated":"2026-09-15T04:42:34.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2511.13368","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}