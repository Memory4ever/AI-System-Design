{"data":{"id":"10.48550/arxiv.2511.13254","type":"dois","attributes":{"doi":"10.48550/arxiv.2511.13254","prefix":"10.48550","suffix":"arxiv.2511.13254","identifiers":[{"identifier":"2511.13254","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2511.13254"}],"creators":[{"name":"Maiti, Shalini","nameType":"Personal","givenName":"Shalini","familyName":"Maiti","affiliation":[],"nameIdentifiers":[]},{"name":"Budhiraja, Amar","nameType":"Personal","givenName":"Amar","familyName":"Budhiraja","affiliation":[],"nameIdentifiers":[]},{"name":"Gauri, Bhavul","nameType":"Personal","givenName":"Bhavul","familyName":"Gauri","affiliation":[],"nameIdentifiers":[]},{"name":"Chaurasia, Gaurav","nameType":"Personal","givenName":"Gaurav","familyName":"Chaurasia","affiliation":[],"nameIdentifiers":[]},{"name":"Protopopov, Anton","nameType":"Personal","givenName":"Anton","familyName":"Protopopov","affiliation":[],"nameIdentifiers":[]},{"name":"Audran-Reiss, Alexis","nameType":"Personal","givenName":"Alexis","familyName":"Audran-Reiss","affiliation":[],"nameIdentifiers":[]},{"name":"Slater, Michael","nameType":"Personal","givenName":"Michael","familyName":"Slater","affiliation":[],"nameIdentifiers":[]},{"name":"Magka, Despoina","nameType":"Personal","givenName":"Despoina","familyName":"Magka","affiliation":[],"nameIdentifiers":[]},{"name":"Shavrina, Tatiana","nameType":"Personal","givenName":"Tatiana","familyName":"Shavrina","affiliation":[],"nameIdentifiers":[]},{"name":"Raileanu, Roberta","nameType":"Personal","givenName":"Roberta","familyName":"Raileanu","affiliation":[],"nameIdentifiers":[]},{"name":"Bachrach, Yoram","nameType":"Personal","givenName":"Yoram","familyName":"Bachrach","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Souper-Model: How Simple Arithmetic Unlocks State-of-the-Art LLM Performance"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-11-17T11:13:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-11-18T02:42:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-09-18T09:07:24Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-09-21T00:39:03Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-11","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Large Language Models (LLMs) have displayed remarkable capabilities across diverse domains, but their training remains resource- and time-intensive, requiring massive computational resources and careful orchestration of training procedures. Model souping-the practice of averaging weights from multiple models of the same architecture-has emerged as a promising pre- and post-training technique that can enhance performance without expensive retraining. We observe that previous souping approaches can lead to collapse in precision-sensitive LLM capabilities. In this paper, we introduce SoCE, a principled approach for model souping to overcome this shortcoming. The proposed method utilizes benchmark composition to identify optimal model candidates and applies non-uniform weighted averaging to maximize performance. Contrary to previous approaches, our method leverages the observation that different clusters (or categories) of points within a benchmark often exhibit low inter-correlations in model performance. SoCE identifies \"expert\" models for each weakly-correlated category cluster and combines them using optimized weighted averaging rather than uniform weights. We demonstrate that SoCE improves performance and robustness across multiple domains and achieves state-of-the-art results on the Berkeley Function Calling Leaderboard.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2511.13254","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-11-18T04:43:27.000Z","registered":"2025-11-18T04:43:28.000Z","published":"2025","updated":"2026-09-21T02:24:20.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2511.13254","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}