<th id="Sx4.T2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="3">CDs<math id="Sx4.T2.m1" class="ltx_Math" alttext="{}_{\text{dense}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext>dense</mtext></msub><annotation encoding="application/x-tex">{}_{\text{dense}}</annotation></semantics></math></th></tr>
