<td id="S4.T3.5.12.2" class="ltx_td ltx_align_center"><span id="S4.T3.5.12.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-bg-color:#EBEBEB;">39.3</span></td>
