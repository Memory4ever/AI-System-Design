            Embed <math id="alg1.l2.m1" class="ltx_Math" alttext="q\!\to\!\mathbf{e}(q)" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo lspace="0.108em" rspace="0.108em" stretchy="false">→</mo><mrow><mi>𝐞</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q\!\to\!\mathbf{e}(q)</annotation></semantics></math>; for each <math id="alg1.l2.m2" class="ltx_Math" alttext="d\!\in\!\mathcal{D}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo lspace="0.108em" rspace="0.108em">∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow><annotation encoding="application/x-tex">d\!\in\!\mathcal{D}</annotation></semantics></math>, get <math id="alg1.l2.m3" class="ltx_Math" alttext="\mathbf{e}(d)" display="inline" intent=":literal"><semantics><mrow><mi>𝐞</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{e}(d)</annotation></semantics></math>

