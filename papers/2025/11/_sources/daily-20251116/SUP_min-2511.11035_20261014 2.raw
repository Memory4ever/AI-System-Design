<td id="S4.T3.2.3.3" class="ltx_td ltx_align_center ltx_border_bb"><math id="S4.T3.m2" class="ltx_Math" alttext="&lt;0.001" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>&lt;</mo><mn>0.001</mn></mrow><annotation encoding="application/x-tex">&lt;0.001</annotation></semantics></math></td></tr>
