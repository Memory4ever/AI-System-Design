<td id="S2.T2.7.73.1" class="ltx_td ltx_align_left" style="padding-top:-1.2pt;padding-bottom:-1.2pt;"><math id="S2.T2.m78" class="ltx_Math" style="--ltx-bg-color:#FFFFFF;" alttext="(t_{i},\varphi_{i},\Delta t_{i},s_{i})" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" maxsize="0.700em" minsize="0.700em">(</mo><msub><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathsize="0.700em">t</mi><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathsize="0.700em">i</mi></msub><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathsize="0.700em">,</mo><msub><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathsize="0.700em">φ</mi><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathsize="0.700em">i</mi></msub><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathsize="0.700em">,</mo><mrow><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathsize="0.700em" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathsize="0.700em">t</mi><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathsize="0.700em">i</mi></msub></mrow><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathsize="0.700em">,</mo><msub><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathsize="0.700em">s</mi><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathsize="0.700em">i</mi></msub><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" maxsize="0.700em" minsize="0.700em">)</mo></mrow><annotation encoding="application/x-tex">(t_{i},\varphi_{i},\Delta t_{i},s_{i})</annotation></semantics></math></td>
<td id="S2.T2.7.73.2" class="ltx_td ltx_align_left" style="padding-top:-1.2pt;padding-bottom:-1.2pt;"><span id="S2.T2.7.73.2.1" class="ltx_text" style="font-size:70%;--ltx-bg-color:#FFFFFF;">Faults</span></td>
