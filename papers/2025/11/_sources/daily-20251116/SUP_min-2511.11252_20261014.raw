<tr id="S3.T3.6.3" class="ltx_tr" style="--ltx-bg-color:#FFFFFF;">
<td id="S3.T3.6.3.1" class="ltx_td ltx_align_left" style="padding-top:-1.5pt;padding-bottom:-1.5pt;"><span id="S3.T3.6.3.1.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">Imaging thermal</span></td>
