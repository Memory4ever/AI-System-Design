<td id="S3.T3.6.6.5" class="ltx_td ltx_align_right" style="padding-top:-1.5pt;padding-bottom:-1.5pt;"><span id="S3.T3.6.6.5.1" class="ltx_text" style="--ltx-bg-color:#E9F3FF;">10</span></td>
<td id="S3.T3.6.6.6" class="ltx_td ltx_align_left" style="padding-top:-1.5pt;padding-bottom:-1.5pt;"><span id="S3.T3.6.6.6.1" class="ltx_text" style="--ltx-bg-color:#E9F3FF;">Network extension</span></td></tr>
<tr id="S3.T3.6.7" class="ltx_tr" style="--ltx-bg-color:#FFFFFF;">
<td id="S3.T3.6.7.1" class="ltx_td ltx_align_left" style="padding-top:-1.5pt;padding-bottom:-1.5pt;"><span id="S3.T3.6.7.1.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">Communication link</span></td>
<td id="S3.T3.6.7.2" class="ltx_td ltx_align_left" style="padding-top:-1.5pt;padding-bottom:-1.5pt;"><span id="S3.T3.6.7.2.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">Satellite communication terminal</span></td>
