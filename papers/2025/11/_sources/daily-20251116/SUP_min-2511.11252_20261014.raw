<td id="S2.T2.7.74.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:-1.2pt;padding-bottom:-1.2pt;"><math id="S2.T2.m79" class="ltx_Math" style="--ltx-bg-color:#E9F3FF;" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi style="--ltx-bg-color:#E9F3FF;" class="ltx_font_mathcaligraphic" mathbackground="#E9F3FF" mathsize="0.700em">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math></td>
