<td id="S3.T3.6.2.2" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:-1.5pt;padding-bottom:-1.5pt;"><span id="S3.T3.6.2.2.1" class="ltx_text" style="--ltx-bg-color:#E9F3FF;">Gimbaled camera</span></td>
