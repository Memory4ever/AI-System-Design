<td id="S3.T3.6.5.5" class="ltx_td ltx_align_right" style="padding-top:-1.5pt;padding-bottom:-1.5pt;"><span id="S3.T3.6.5.5.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">18</span></td>
<td id="S3.T3.6.5.6" class="ltx_td ltx_align_left" style="padding-top:-1.5pt;padding-bottom:-1.5pt;"><span id="S3.T3.6.5.6.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">Terrain and infrastructure mapping</span></td></tr>
