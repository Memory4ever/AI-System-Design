<span id="S2.T2.7.74.3.1" class="ltx_inline-block ltx_align_top" style="width:128.0pt;--ltx-bg-color:#E9F3FF;">
<span id="S2.T2.7.74.3.1.1" class="ltx_p"><span id="S2.T2.7.74.3.1.1.1" class="ltx_text" style="font-size:70%;">Communication constraints (uplink, downlink, signal strength)</span></span>
</span></td></tr>
<tr id="S2.T2.7.75" class="ltx_tr" style="--ltx-bg-color:#FFFFFF;">
<td id="S2.T2.7.75.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:-1.2pt;padding-bottom:-1.2pt;"><math id="S2.T2.m80" class="ltx_Math" style="--ltx-bg-color:#FFFFFF;" alttext="\theta" display="inline" intent=":literal"><semantics><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathsize="0.700em">θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math></td>
