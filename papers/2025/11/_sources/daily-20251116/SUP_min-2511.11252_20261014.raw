<td id="S3.T3.6.6.2" class="ltx_td ltx_align_left" style="padding-top:-1.5pt;padding-bottom:-1.5pt;"><span id="S3.T3.6.6.2.1" class="ltx_text" style="--ltx-bg-color:#E9F3FF;">Radio repeater</span></td>
