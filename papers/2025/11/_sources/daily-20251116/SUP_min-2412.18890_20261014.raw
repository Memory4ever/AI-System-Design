<figure id="Sx4.F7.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2412.18890v2/fig_valid_oscillation_2.svg" id="Sx4.F7.sf2.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:161/96;" width="161" height="96"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(b) </span>Oscillation 2</figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<figure id="Sx4.F7.sf3" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2412.18890v2/fig_valid_bactgrow.svg" id="Sx4.F7.sf3.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:161/96;" width="161" height="96"></object>
