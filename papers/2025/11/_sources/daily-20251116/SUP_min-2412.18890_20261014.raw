<figure id="Sx4.F6.sf4" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2412.18890v2/fig_best_score_stress_strain.svg" id="Sx4.F6.sf4.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:161/94;" width="161" height="94"></object>
