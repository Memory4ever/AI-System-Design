              <span id="alg1.l11.3" class="ltx_text" style="font-size:90%;">   </span><math id="alg1.l11.m1" class="ltx_math_unparsed" alttext="\Gamma\leftarrow\Gamma\cup\{\{(x_{i},s_{i})\mid s_{i}=\text{MLLM}(x_{i},h),(x_{i},y_{i})\in\mathcal{D}\}\mid h\in H\}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em" mathvariant="normal">Γ</mi><mo mathsize="0.900em" stretchy="false">←</mo><mi mathsize="0.900em" mathvariant="normal">Γ</mi><mo mathsize="0.900em">∪</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">{</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">x</mi><mi mathsize="0.900em">i</mi></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">s</mi><mi mathsize="0.900em">i</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" mathsize="0.900em" rspace="0.167em">∣</mo><msub><mi mathsize="0.900em">s</mi><mi mathsize="0.900em">i</mi></msub><mo mathsize="0.900em">=</mo><mtext mathsize="0.900em">MLLM</mtext><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">x</mi><mi mathsize="0.900em">i</mi></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">h</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo mathsize="0.900em">,</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">x</mi><mi mathsize="0.900em">i</mi></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">y</mi><mi mathsize="0.900em">i</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo mathsize="0.900em">∈</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒟</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em" mathsize="0.900em" rspace="0.167em">∣</mo><mi mathsize="0.900em">h</mi><mo mathsize="0.900em">∈</mo><mi mathsize="0.900em">H</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\Gamma\leftarrow\Gamma\cup\{\{(x_{i},s_{i})\mid s_{i}=\text{MLLM}(x_{i},h),(x_{i},y_{i})\in\mathcal{D}\}\mid h\in H\}</annotation></semantics></math><span id="alg1.l11.4" class="ltx_text" style="font-size:90%;"> </span><span id="alg1.l11.5" class="ltx_text" style="font-size:90%;float:right;"><math id="alg1.l11.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Generate descriptions for new prompts
