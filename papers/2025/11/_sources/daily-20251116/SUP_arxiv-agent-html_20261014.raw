        <span>&nbsp;[<a href="https://arxiv.org/pdf/2511.11788">pdf</a>, <a href="https://arxiv.org/ps/2511.11788">ps</a>, <a href="https://arxiv.org/format/2511.11788">other</a>]&nbsp;</span>
