        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.08068">pdf</a>, <a href="https://arxiv.org/ps/2510.08068">ps</a>, <a href="https://arxiv.org/format/2510.08068">other</a>]&nbsp;</span>
