        <span>&nbsp;[<a href="https://arxiv.org/pdf/2508.07570">pdf</a>, <a href="https://arxiv.org/ps/2508.07570">ps</a>, <a href="https://arxiv.org/format/2508.07570">other</a>]&nbsp;</span>
