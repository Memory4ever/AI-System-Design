  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2511.11898">arXiv:2511.11898</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2511.11898">pdf</a>, <a href="https://arxiv.org/ps/2511.11898">ps</a>, <a href="https://arxiv.org/format/2511.11898">other</a>]&nbsp;</span>
