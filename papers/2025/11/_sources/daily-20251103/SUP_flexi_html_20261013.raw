<td id="S2.T1.4.1.9.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;">0.81</td>
<td id="S2.T1.4.1.9.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;">0.77</td>
<td id="S2.T1.4.1.9.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;">0.80</td>
<td id="S2.T1.4.1.9.5" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;">0.86</td>
<td id="S2.T1.4.1.9.6" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;">0.83</td>
