<td id="S2.T1.4.1.6.8" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">0.80</td>
<td id="S2.T1.4.1.6.9" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">0.83</td></tr>
<tr id="S2.T1.4.1.7" class="ltx_tr">
<td id="S2.T1.4.1.7.1" class="ltx_td ltx_align_left" style="padding-left:3.0pt;padding-right:3.0pt;">SPACE</td>
<td id="S2.T1.4.1.7.2" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">0.83</td>
<td id="S2.T1.4.1.7.3" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">0.75</td>
<td id="S2.T1.4.1.7.4" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">0.77</td>
<td id="S2.T1.4.1.7.5" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">0.84</td>
<td id="S2.T1.4.1.7.6" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">0.84</td>
<td id="S2.T1.4.1.7.7" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">1.00</td>
<td id="S2.T1.4.1.7.8" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">0.70</td>
<td id="S2.T1.4.1.7.9" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">0.91</td></tr>
<tr id="S2.T1.4.1.8" class="ltx_tr">
<td id="S2.T1.4.1.8.1" class="ltx_td ltx_align_left" style="padding-left:3.0pt;padding-right:3.0pt;">CUAD</td>
