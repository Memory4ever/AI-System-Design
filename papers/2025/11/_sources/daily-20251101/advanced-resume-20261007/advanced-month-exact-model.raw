        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.21867">pdf</a>, <a href="https://arxiv.org/ps/2510.21867">ps</a>, <a href="https://arxiv.org/format/2510.21867">other</a>]&nbsp;</span>
