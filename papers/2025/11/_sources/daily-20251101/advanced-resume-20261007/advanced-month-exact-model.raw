      <a href="/search/?searchtype=author&amp;query=Zhang%2C+T">Tianle Zhang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Yuan%2C+Y">Yuchen Yuan</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhang%2C+C">Chi Zhang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Li%2C+X">Xuelong Li</a>
      
