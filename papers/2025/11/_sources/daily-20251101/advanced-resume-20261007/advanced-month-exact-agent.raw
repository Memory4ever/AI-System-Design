        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.12668">pdf</a>, <a href="https://arxiv.org/ps/2510.12668">ps</a>, <a href="https://arxiv.org/format/2510.12668">other</a>]&nbsp;</span>
