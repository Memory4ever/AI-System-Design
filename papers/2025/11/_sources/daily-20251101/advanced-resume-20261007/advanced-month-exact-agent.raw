        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.16128">pdf</a>, <a href="https://arxiv.org/ps/2510.16128">ps</a>, <a href="https://arxiv.org/format/2510.16128">other</a>]&nbsp;</span>
