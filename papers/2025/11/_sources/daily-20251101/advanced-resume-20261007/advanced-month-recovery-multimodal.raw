  </nav>
</header>

<div class="arxiv-search-overlay" id="arxiv-search-overlay" hidden>
  <div class="arxiv-search-panel" role="search">
    <form method="GET" action="/search">
      <label for="arxiv-search-input" class="is-sr-only">Search arXiv</label>
      <input type="text" name="query" id="arxiv-search-input" autocomplete="off"
        placeholder="Search papers by title, author, abstract, or ID...">
      <input type="hidden" name="searchtype" value="all">
      <input type="hidden" name="source" value="header">
    </form>
    <div class="arxiv-search-hint">
      Press Enter to search &middot; <a href="/search/advanced">Advanced search</a>
    </div>
  </div>
</div>

  </header>
  <main class="container" id="main-container">
    


    
  <div class="level is-marginless">
    <div class="level-left">
      <h1 class="title is-clearfix">
    
        Showing 1&ndash;50 of 488 results
    
</h1>
    </div>
    <div class="level-right is-hidden-mobile">
      <!-- feedback for mobile is moved to footer -->
      <span class="help" style="display: inline-block;"><a href="https://github.com/arXiv/arxiv-search/releases">Search v0.5.6 released 2020-02-24</a>&nbsp;&nbsp;</span>
    </div>
  </div>
    <div class="content">
      
  
    

    <div class="columns">
      <div class="column is-two-thirds-tablet">
        <p style="margin-bottom: .5em">Query: <a href="/search/advanced?classification-include_cross_list=include&amp;date-filter_by=date_range&amp;date-from_date=2025-10-01&amp;date-to_date=2025-11-01&amp;date-date_type=announced_date_first&amp;abstracts=show&amp;size=50&amp;order=-announced_date_first&amp;start=0&amp;terms-0-operator=AND&amp;terms-0-term=video+generation&amp;terms-0-field=title&amp;terms-1-operator=OR&amp;terms-1-term=vision+language+model&amp;terms-1-field=title&amp;terms-2-operator=OR&amp;terms-2-term=flow+matching&amp;terms-2-field=title&amp;terms-3-operator=OR&amp;terms-3-term=embodied&amp;terms-3-field=title&amp;terms-4-operator=OR&amp;terms-4-term=world+model&amp;terms-4-field=title">order: -announced_date_first; size: 50; date_range: from 2025-10-01 to 2025-11-01; include_cross_list: True; terms: AND title=video generation; OR title=vision language model; OR title=flow matching; OR title=embodied; OR title=world model</a></p>
        <div class="buttons">
          <a class="button is-link" href="/search/advanced?classification-include_cross_list=include&amp;date-filter_by=date_range&amp;date-from_date=2025-10-01&amp;date-to_date=2025-11-01&amp;date-date_type=announced_date_first&amp;abstracts=show&amp;size=50&amp;order=-announced_date_first&amp;start=0&amp;terms-0-operator=AND&amp;terms-0-term=video+generation&amp;terms-0-field=title&amp;terms-1-operator=OR&amp;terms-1-term=vision+language+model&amp;terms-1-field=title&amp;terms-2-operator=OR&amp;terms-2-term=flow+matching&amp;terms-2-field=title&amp;terms-3-operator=OR&amp;terms-3-term=embodied&amp;terms-3-field=title&amp;terms-4-operator=OR&amp;terms-4-term=world+model&amp;terms-4-field=title">Refine query</a><a class="button" href="/search/advanced">New search</a>
        </div>
      </div>
      <div class="column is-one-third-tablet is-hidden-mobile">
        <p class="has-text-right" style="margin-top: 1em">
          
          <a href="/search/?order=-announced_date_first&amp;size=50">Simple Search</a>
          
        </p>
      </div>
