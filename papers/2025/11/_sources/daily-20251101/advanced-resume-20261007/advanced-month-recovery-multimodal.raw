      <a href="/search/?searchtype=author&amp;query=Pereira%2C+L+K">Lis Kanashiro Pereira</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Han%2C+P">Peitao Han</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Cheng%2C+F">Fei Cheng</a>, 
      
