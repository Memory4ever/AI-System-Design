        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.25889">pdf</a>, <a href="https://arxiv.org/ps/2510.25889">ps</a>, <a href="https://arxiv.org/format/2510.25889">other</a>]&nbsp;</span>
