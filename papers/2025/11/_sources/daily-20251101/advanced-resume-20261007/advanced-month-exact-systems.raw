      <a href="/search/?searchtype=author&amp;query=Li%2C+Q">Qi Li</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Wu%2C+J">Junpan Wu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Liu%2C+X">Xiang Liu</a>, 
      
