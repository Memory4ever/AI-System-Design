        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.27556">pdf</a>, <a href="https://arxiv.org/ps/2510.27556">ps</a>, <a href="https://arxiv.org/format/2510.27556">other</a>]&nbsp;</span>
