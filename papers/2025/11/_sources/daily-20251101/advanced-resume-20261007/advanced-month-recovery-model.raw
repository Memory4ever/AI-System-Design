      <a href="/search/?searchtype=author&amp;query=Kim%2C+C+W">Cheol Woo Kim</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Verma%2C+S">Shresth Verma</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Tec%2C+M">Mauricio Tec</a>, 
      
