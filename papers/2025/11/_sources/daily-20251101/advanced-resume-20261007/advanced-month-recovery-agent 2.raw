      <a href="/search/?searchtype=author&amp;query=Yue%2C+L">Le Yue</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Xiong%2C+H">Honghui Xiong</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Yang%2C+Y">Yi Yang</a>
      
