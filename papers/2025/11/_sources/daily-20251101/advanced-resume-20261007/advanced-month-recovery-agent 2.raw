    <div class="columns">
      <div class="column is-two-thirds-tablet">
        <p style="margin-bottom: .5em">Query: <a href="/search/advanced?classification-include_cross_list=include&amp;date-filter_by=date_range&amp;date-from_date=2025-10-01&amp;date-to_date=2025-11-01&amp;date-date_type=announced_date_first&amp;abstracts=show&amp;size=50&amp;order=-announced_date_first&amp;start=0&amp;terms-0-operator=AND&amp;terms-0-term=retrieval+augmented+generation&amp;terms-0-field=title&amp;terms-1-operator=OR&amp;terms-1-term=agent+memory&amp;terms-1-field=title&amp;terms-2-operator=OR&amp;terms-2-term=prompt+injection&amp;terms-2-field=title&amp;terms-3-operator=OR&amp;terms-3-term=computer+use&amp;terms-3-field=title&amp;terms-4-operator=OR&amp;terms-4-term=multi-agent+language&amp;terms-4-field=title">order: -announced_date_first; size: 50; date_range: from 2025-10-01 to 2025-11-01; include_cross_list: True; terms: AND title=retrieval augmented generation; OR title=agent memory; OR title=prompt injection; OR title=computer use; OR title=multi-agent language</a></p>
