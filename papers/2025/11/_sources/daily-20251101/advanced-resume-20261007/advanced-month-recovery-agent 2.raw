        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.26789">pdf</a>, <a href="https://arxiv.org/ps/2510.26789">ps</a>, <a href="https://arxiv.org/format/2510.26789">other</a>]&nbsp;</span>
