      <a href="/search/?searchtype=author&amp;query=Hu%2C+J">Junjie Hu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Cho%2C+S+Y">Steve Y. Cho</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Bradshaw%2C+T+J">Tyler J. Bradshaw</a>
      
