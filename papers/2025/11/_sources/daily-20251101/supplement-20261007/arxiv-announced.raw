      <a href="/search/?searchtype=author&amp;query=Jongbloed%2C+K+V">Klaske Vliegenthart Jongbloed</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Jordans%2C+C">Carlijn Jordans</a>, 
      
