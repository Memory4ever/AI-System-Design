      <a href="/search/?searchtype=author&amp;query=Zeng%2C+B">Bin Zeng</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Oliveira%2C+A+L">Arlindo L. Oliveira</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Li%2C+L">Lei Li</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Li%2C+Z">Zhuo Li</a>
      
