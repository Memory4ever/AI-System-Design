    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Hili%2C+Y+A+E">Youssef Attia El Hili</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Thomas%2C+A">Albert Thomas</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Tiomoko%2C+M">Malik Tiomoko</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Benechehab%2C+A">Abdelhakim Benechehab</a>, 
      
      <a href="/search/?searchtype=author&amp;query=L%C3%A9ger%2C+C">Corentin Léger</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Ancourt%2C+C">Corinne Ancourt</a>, 
      
