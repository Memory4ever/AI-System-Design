      <a href="/search/?searchtype=author&amp;query=Sharma%2C+A+S">Arnab Sen Sharma</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Rogers%2C+G">Giordano Rogers</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Shapira%2C+N">Natalie Shapira</a>, 
      
