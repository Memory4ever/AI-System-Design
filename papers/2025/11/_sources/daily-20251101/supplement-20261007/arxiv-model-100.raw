      <a href="/search/?searchtype=author&amp;query=Fan%2C+G">Guoliang Fan</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Huang%2C+T">Tiejun Huang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Wang%2C+Y">Yu Wang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Yu%2C+C">Chao Yu</a>
      
