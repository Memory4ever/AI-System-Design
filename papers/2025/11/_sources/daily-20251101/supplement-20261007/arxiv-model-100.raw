      <a href="/search/?searchtype=author&amp;query=Yuan%2C+J">Jiazhen Yuan</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Gong%2C+Z">Zhike Gong</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Hang%2C+J">Jinquan Hang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Bai%2C+Z">Zhengbiao Bai</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhao%2C+W">Wei Zhao</a>
      
