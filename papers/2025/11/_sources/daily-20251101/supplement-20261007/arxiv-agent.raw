    <p class="title is-5 mathjax">
      
        The FM <span class="search-hit mathjax">Agent</span>
      
    </p>
    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Li%2C+A">Annan Li</a>, 
      
