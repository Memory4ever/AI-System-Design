      <a href="/search/?searchtype=author&amp;query=Fawzi%2C+F">Fares Fawzi</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Swamy%2C+V">Vinitra Swamy</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Glandorf%2C+D">Dominik Glandorf</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Nazaretsky%2C+T">Tanya Nazaretsky</a>, 
      
      <a href="/search/?searchtype=author&amp;query=K%C3%A4ser%2C+T">Tanja Käser</a>
      
