      <a href="/search/?searchtype=author&amp;query=Makroum%2C+R+E">Reda El Makroum</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zwickl-Bernhard%2C+S">Sebastian Zwickl-Bernhard</a>, 
      
