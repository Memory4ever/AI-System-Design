      <a href="/search/?searchtype=author&amp;query=Fang%2C+R">Ruishan Fang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Wang%2C+H">Hongwei Wang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Lin%2C+T">Tao Lin</a>
      
