        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.25616">pdf</a>, <a href="https://arxiv.org/ps/2510.25616">ps</a>, <a href="https://arxiv.org/format/2510.25616">other</a>]&nbsp;</span>
