      <a href="/search/?searchtype=author&amp;query=Tanaka%2C+H">Hidetake Tanaka</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Tanaka%2C+H">Haruto Tanaka</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Shimari%2C+K">Kazumasa Shimari</a>, 
      
