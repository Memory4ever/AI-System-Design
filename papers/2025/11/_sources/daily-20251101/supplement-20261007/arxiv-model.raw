  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2511.08593">arXiv:2511.08593</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2511.08593">pdf</a>, <a href="https://arxiv.org/ps/2511.08593">ps</a>, <a href="https://arxiv.org/format/2511.08593">other</a>]&nbsp;</span>
