    <div class="columns">
      <div class="column is-two-thirds-tablet">
        <p style="margin-bottom: .5em">Query: <a href="/search/advanced?classification-include_cross_list=include&amp;date-filter_by=date_range&amp;date-from_date=2025-10-29&amp;date-to_date=2025-10-31&amp;date-date_type=submitted_date_first&amp;abstracts=show&amp;size=50&amp;order=-announced_date_first&amp;terms-0-operator=AND&amp;terms-0-term=LLM+agent&amp;terms-0-field=title&amp;terms-1-operator=OR&amp;terms-1-term=agentic&amp;terms-1-field=title&amp;terms-2-operator=OR&amp;terms-2-term=RAG&amp;terms-2-field=title&amp;terms-3-operator=OR&amp;terms-3-term=tool+use&amp;terms-3-field=title&amp;terms-4-operator=OR&amp;terms-4-term=tool+calling&amp;terms-4-field=title&amp;start=50">order: -announced_date_first; size: 50; page_start: 50; date_range: from 2025-10-29 to 2025-10-31; include_cross_list: True; terms: AND title=LLM agent; OR title=agentic; OR title=RAG; OR title=tool use; OR title=tool calling</a></p>
        <div class="buttons">
          <a class="button is-link" href="/search/advanced?classification-include_cross_list=include&amp;date-filter_by=date_range&amp;date-from_date=2025-10-29&amp;date-to_date=2025-10-31&amp;date-date_type=submitted_date_first&amp;abstracts=show&amp;size=50&amp;order=-announced_date_first&amp;terms-0-operator=AND&amp;terms-0-term=LLM+agent&amp;terms-0-field=title&amp;terms-1-operator=OR&amp;terms-1-term=agentic&amp;terms-1-field=title&amp;terms-2-operator=OR&amp;terms-2-term=RAG&amp;terms-2-field=title&amp;terms-3-operator=OR&amp;terms-3-term=tool+use&amp;terms-3-field=title&amp;terms-4-operator=OR&amp;terms-4-term=tool+calling&amp;terms-4-field=title&amp;start=50">Refine query</a><a class="button" href="/search/advanced">New search</a>
        </div>
