      <a href="/search/?searchtype=author&amp;query=Rakotonirainy%2C+A">Andry Rakotonirainy</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Kuo%2C+J">Jonny Kuo</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Demmel%2C+S">Sebastien Demmel</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Lenn%C3%A9%2C+M">Mike Lenné</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Schroeter%2C+R">Ronald Schroeter</a>
      
