      <a href="/search/?searchtype=author&amp;query=Yin%2C+D">Di Yin</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Sun%2C+X">Xing Sun</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Shen%2C+Y">Ying Shen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Yu%2C+P+S">Philip S. Yu</a>
      
