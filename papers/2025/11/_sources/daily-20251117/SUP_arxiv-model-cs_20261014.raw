        <span>&nbsp;[<a href="https://arxiv.org/pdf/2505.17089">pdf</a>, <a href="https://arxiv.org/ps/2505.17089">ps</a>, <a href="https://arxiv.org/format/2505.17089">other</a>]&nbsp;</span>
