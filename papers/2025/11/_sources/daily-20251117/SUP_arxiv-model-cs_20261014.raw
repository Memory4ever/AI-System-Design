      <a href="/search/?searchtype=author&amp;query=Corazzini%2C+L">Luca Corazzini</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Deriu%2C+E">Elisa Deriu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Guerzoni%2C+M">Marco Guerzoni</a>
      
