        <span>&nbsp;[<a href="https://arxiv.org/pdf/2408.04998">pdf</a>, <a href="https://arxiv.org/ps/2408.04998">ps</a>, <a href="https://arxiv.org/format/2408.04998">other</a>]&nbsp;</span>
