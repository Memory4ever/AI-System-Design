{"data":{"id":"10.48550/arxiv.2511.11617","type":"dois","attributes":{"doi":"10.48550/arxiv.2511.11617","prefix":"10.48550","suffix":"arxiv.2511.11617","identifiers":[{"identifier":"2511.11617","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2511.11617"}],"creators":[{"name":"Xu, Wendong","nameType":"Personal","givenName":"Wendong","familyName":"Xu","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Chujie","nameType":"Personal","givenName":"Chujie","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Xiao, He","nameType":"Personal","givenName":"He","familyName":"Xiao","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Kuan","nameType":"Personal","givenName":"Kuan","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Xiong, Jing","nameType":"Personal","givenName":"Jing","familyName":"Xiong","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Chen","nameType":"Personal","givenName":"Chen","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhou, Wenyong","nameType":"Personal","givenName":"Wenyong","familyName":"Zhou","affiliation":[],"nameIdentifiers":[]},{"name":"Tao, Chaofan","nameType":"Personal","givenName":"Chaofan","familyName":"Tao","affiliation":[],"nameIdentifiers":[]},{"name":"Bai, Yang","nameType":"Personal","givenName":"Yang","familyName":"Bai","affiliation":[],"nameIdentifiers":[]},{"name":"Yu, Bei","nameType":"Personal","givenName":"Bei","familyName":"Yu","affiliation":[],"nameIdentifiers":[]},{"name":"Wong, Ngai","nameType":"Personal","givenName":"Ngai","familyName":"Wong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AnchorTP: Resilient LLM Inference with State-Preserving Elastic Tensor Parallelism"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-11-05T13:21:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-11-18T01:01:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Large Language Model (LLM) inference services demand exceptionally high availability and low latency, yet multi-GPU Tensor Parallelism (TP) makes them vulnerable to single-GPU failures. We present AnchorTP, a state-preserving elastic TP framework for fast recovery. It (i) enables Elastic Tensor Parallelism (ETP) with unequal-width partitioning over any number of GPUs and compatibility with Mixture-of-Experts (MoE), and (ii) preserves model parameters and KV caches in GPU memory via a daemon decoupled from the inference process. To minimize downtime, we propose a bandwidth-aware planner based on a Continuous Minimal Migration (CMM) algorithm that minimizes reload bytes under a byte-cost dominance assumption, and an execution scheduler that pipelines P2P transfers with reloads. These components jointly restore service quickly with minimal data movement and without changing service interfaces. In typical failure scenarios, AnchorTP reduces Time to First Success (TFS) by up to 11x and Time to Peak (TTP) by up to 59% versus restart-and-reload.","descriptionType":"Abstract"},{"description":"accpeted paper by Design, Automation and Test in Europe Conference (DATE'26). 8 pages in total with 6 figures and 2 tables","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2511.11617","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-11-18T04:05:36.000Z","registered":"2025-11-18T04:05:36.000Z","published":"2025","updated":"2025-11-18T04:05:37.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2511.11617","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}