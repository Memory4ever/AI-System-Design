{"data":{"id":"10.48550/arxiv.2511.21702","type":"dois","attributes":{"doi":"10.48550/arxiv.2511.21702","prefix":"10.48550","suffix":"arxiv.2511.21702","identifiers":[{"identifier":"2511.21702","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2511.21702"}],"creators":[{"name":"Liu, Dong","nameType":"Personal","givenName":"Dong","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Shu","nameType":"Personal","givenName":"Shu","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Yu, Yanxuan","nameType":"Personal","givenName":"Yanxuan","familyName":"Yu","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Haisheng","nameType":"Personal","givenName":"Haisheng","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Lengerich, Ben","nameType":"Personal","givenName":"Ben","familyName":"Lengerich","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CSV-Decode: Certifiable Sub-Vocabulary Decoding for Efficient Large Language Model Inference"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-11-16T14:02:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-12-01T01:00:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-26T00:30:31Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-28T00:40:57Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-11","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Large language models face significant computational bottlenecks during inference due to the expensive output layer computation over large vocabularies. We present CSV-Decode, a novel approach that uses geometric upper bounds to construct small sub-vocabularies for each decoding step, enabling efficient sparse computation while maintaining dual correctness guarantees: exact top-$k$ certification and $\\varepsilon$-certified softmax approximations. Our method clusters vocabulary embeddings offline and uses centroid-plus-radius bounds to identify which tokens can be safely omitted from computation. We provide a complete system implementation with sparse GEMV kernels, multi-GPU sharding, and CUDA Graph optimization. Experimental results demonstrate significant speedup over full vocabulary decoding while maintaining distributional guarantees and low fallback rates. Our code implementation available at \\href{https://github.com/FastLM/CSV-Decode}{https://github.com/FastLM/CSV-Decode}.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2511.21702","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-12-01T03:28:14.000Z","registered":"2025-12-01T03:28:14.000Z","published":"2025","updated":"2026-07-28T03:49:26.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2511.21702","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}