<td id="A4.T6.2.1.2.2" class="ltx_td ltx_align_left ltx_border_t">Landon Donovan</td>
<td id="A4.T6.2.1.2.3" class="ltx_td ltx_align_right ltx_border_t">57</td>
<td id="A4.T6.2.1.2.4" class="ltx_td ltx_align_right ltx_border_t">155</td>
<td id="A4.T6.2.1.2.5" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t">2000–present</td></tr>
<tr id="A4.T6.2.1.3" class="ltx_tr">
<td id="A4.T6.2.1.3.1" class="ltx_td ltx_align_center">2</td>
<td id="A4.T6.2.1.3.2" class="ltx_td ltx_align_left">Clint Dempsey</td>
<td id="A4.T6.2.1.3.3" class="ltx_td ltx_align_right">36</td>
<td id="A4.T6.2.1.3.4" class="ltx_td ltx_align_right">103</td>
<td id="A4.T6.2.1.3.5" class="ltx_td ltx_nopad_r ltx_align_left">2004–present</td></tr>
<tr id="A4.T6.2.1.4" class="ltx_tr">
<td id="A4.T6.2.1.4.1" class="ltx_td ltx_align_center">3</td>
<td id="A4.T6.2.1.4.2" class="ltx_td ltx_align_left">Eric Wynalda</td>
<td id="A4.T6.2.1.4.3" class="ltx_td ltx_align_right">34</td>
<td id="A4.T6.2.1.4.4" class="ltx_td ltx_align_right">106</td>
<td id="A4.T6.2.1.4.5" class="ltx_td ltx_nopad_r ltx_align_left">1990–2000</td></tr>
<tr id="A4.T6.2.1.5" class="ltx_tr">
<td id="A4.T6.2.1.5.1" class="ltx_td ltx_align_center">4</td>
