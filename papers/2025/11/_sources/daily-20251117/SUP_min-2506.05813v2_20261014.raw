<th id="S4.T3.2.1.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="S4.T3.2.1.1.1.1" class="ltx_text ltx_font_bold">Settings</span></th>
<th id="S4.T3.2.1.1.2" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T3.2.1.1.2.1" class="ltx_text ltx_font_bold ltx_font_smallcaps">LLAMA3.3-70B</span></th></tr>
