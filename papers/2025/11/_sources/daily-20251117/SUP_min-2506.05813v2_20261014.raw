<td id="A5.T8.2.1.1.4.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="A5.T8.2.1.1.4.1.1.1.1" class="ltx_text ltx_font_bold">Memory</span></td></tr>
