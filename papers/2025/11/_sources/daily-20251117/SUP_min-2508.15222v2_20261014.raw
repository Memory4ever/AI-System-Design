<section id="A1.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.2 </span>SVG Grammar</h3>

<div id="A1.SS2.p1" class="ltx_para ltx_noindent">
<div id="A1.SS2.p1.1" class="ltx_logical-block ltx_minipage ltx_align_middle" style="width:345.0pt;">
          
<figure id="LST1" class="ltx_float ltx_lstlisting">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float">Listing 1: </span>SVG grammar</figcaption>
<div id="LST1.2" class="ltx_listing ltx_lstlisting ltx_framed ltx_framed_rectangle ltx_listing" style="--ltx-bg-color:#F7F7F7;--ltx-border-color:#CCCCCC;"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></div>
<div id="lstnumberx1" class="ltx_listingline"><span id="lstnumberx1.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">Canvas</span>
</div>
<div id="lstnumberx2" class="ltx_listingline"><span id="lstnumberx2.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;">  </span><span id="lstnumberx2.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">size</span><span id="lstnumberx2.3" class="ltx_text ltx_font_typewriter" style="font-size:90%;">:</span><span id="lstnumberx2.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx2.5" class="ltx_text ltx_font_typewriter" style="font-size:90%;">{</span><span id="lstnumberx2.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">canvas_width</span><span id="lstnumberx2.7" class="ltx_text ltx_font_typewriter" style="font-size:90%;">}</span><span id="lstnumberx2.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx2.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">x</span><span id="lstnumberx2.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx2.11" class="ltx_text ltx_font_typewriter" style="font-size:90%;">{</span><span id="lstnumberx2.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">canvas_height</span><span id="lstnumberx2.13" class="ltx_text ltx_font_typewriter" style="font-size:90%;">}</span><span id="lstnumberx2.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;">   </span><span id="lstnumberx2.15" class="ltx_text ltx_font_typewriter" style="font-size:90%;">#</span><span id="lstnumberx2.16" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx2.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">pixels</span><span id="lstnumberx2.18" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx2.19" class="ltx_text ltx_font_typewriter" style="font-size:90%;">(</span><span id="lstnumberx2.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">width</span><span id="lstnumberx2.21" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx2.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">x</span><span id="lstnumberx2.23" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx2.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">height</span><span id="lstnumberx2.25" class="ltx_text ltx_font_typewriter" style="font-size:90%;">)</span>
</div>
<div id="lstnumberx3" class="ltx_listingline"><span id="lstnumberx3.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;">  </span><span id="lstnumberx3.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">coords</span><span id="lstnumberx3.3" class="ltx_text ltx_font_typewriter" style="font-size:90%;">:</span><span id="lstnumberx3.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx3.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">origin</span><span id="lstnumberx3.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx3.7" class="ltx_text ltx_font_typewriter" style="font-size:90%;">(0,0)</span><span id="lstnumberx3.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx3.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">top</span><span id="lstnumberx3.10" class="ltx_text ltx_font_typewriter" style="font-size:90%;">-</span><span id="lstnumberx3.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">left</span><span id="lstnumberx3.12" class="ltx_text ltx_font_typewriter" style="font-size:90%;">;</span><span id="lstnumberx3.13" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx3.14" class="ltx_text ltx_font_typewriter" style="font-size:90%;">+</span><span id="lstnumberx3.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">x</span><span id="lstnumberx3.16" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx3.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">right</span><span id="lstnumberx3.18" class="ltx_text ltx_font_typewriter" style="font-size:90%;">;</span><span id="lstnumberx3.19" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx3.20" class="ltx_text ltx_font_typewriter" style="font-size:90%;">+</span><span id="lstnumberx3.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">y</span><span id="lstnumberx3.22" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx3.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">down</span>
</div>
<div id="lstnumberx4" class="ltx_listingline"><span id="lstnumberx4.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;">  </span><span id="lstnumberx4.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">positioning</span><span id="lstnumberx4.3" class="ltx_text ltx_font_typewriter" style="font-size:90%;">:</span><span id="lstnumberx4.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx4.5" class="ltx_text ltx_font_typewriter" style="font-size:90%;">(</span><span id="lstnumberx4.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">x</span><span id="lstnumberx4.7" class="ltx_text ltx_font_typewriter" style="font-size:90%;">,</span><span id="lstnumberx4.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">y</span><span id="lstnumberx4.9" class="ltx_text ltx_font_typewriter" style="font-size:90%;">)</span><span id="lstnumberx4.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx4.11" class="ltx_text ltx_font_typewriter" style="font-size:90%;">=</span><span id="lstnumberx4.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx4.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">center</span><span id="lstnumberx4.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx4.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">of</span><span id="lstnumberx4.16" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx4.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">shape</span>
</div>
<div id="lstnumberx5" class="ltx_listingline">
</div>
