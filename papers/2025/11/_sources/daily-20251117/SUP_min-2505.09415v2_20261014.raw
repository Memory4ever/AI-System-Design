<tr id="A1.T12.1.2" class="ltx_tr">
<td id="A1.T12.1.2.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" rowspan="4"><span id="A1.T12.1.2.1.1" class="ltx_text">FaceShield-sft45K</span></td>
<td id="A1.T12.1.2.2" class="ltx_td ltx_align_center ltx_border_t">Coarse-grained Classification</td>
<td id="A1.T12.1.2.3" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">13076</td></tr>
<tr id="A1.T12.1.3" class="ltx_tr">
<td id="A1.T12.1.3.1" class="ltx_td ltx_align_center">Fine-grained Classification</td>
