<th id="A1.T12.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A1.T12.1.1.2.1" class="ltx_text ltx_font_bold">Task</span></th>
<th id="A1.T12.1.1.3" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A1.T12.1.1.3.1" class="ltx_text ltx_font_bold">Data Size</span></th></tr>
</thead>
