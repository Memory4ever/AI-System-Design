          image.removeEventListener('error', failed);
          imageListeners.delete(dispose);
        };
        const reveal = (status) => {
          dispose();
          if (!active) return;
          release(image, status);
        };
        const loaded = () => {
          if (image.decode) image.decode().then(() => reveal('loaded'), () => reveal('fallback'));
          else reveal('loaded');
        };
        const failed = () => reveal('fallback');
        imageListeners.add(dispose);
        image.addEventListener('load', loaded, { once: true });
        image.addEventListener('error', failed, { once: true });
      }
      for (const element of document.querySelectorAll(selector)) {
        if (seen.has(element)) continue;
        seen.add(element);
        sawText = true;
        const rect = element.getBoundingClientRect();
        const style = getComputedStyle(element);
        // Offscreen text, hidden Blog entries and the hero's back face never
        // hold up the visible page. Their fonts still load normally through CSS.
        if (!rect.width || !rect.height || rect.bottom <= 0 || rect.top >= window.innerHeight || style.visibility === 'hidden' || element.closest('[aria-hidden="true"], [data-font-skip]')) {
