      for (const element of blockedInteractions) element.inert = false;
      blockedInteractions.clear();
      imageListeners.clear();
      busy.clear();
    }

    function fontRanges() {
      // Called after stylesheets are ready; keep the actual CSS unicode ranges.
      if (ranges.size) return;
      for (const face of document.fonts) {
        const family = familyName(face.family);
        const list = ranges.get(family) || [];
        for (const part of face.unicodeRange.split(',')) {
          const range = part.trim().replace(/^U\+/i, '').split('-');
          const lower = parseInt(range[0].replace(/\?/g, '0'), 16);
          const upper = parseInt((range[1] || range[0]).replace(/\?/g, 'F'), 16);
          list.push([lower, upper]);
