      for (const element of document.querySelectorAll('[data-font-interactive]')) {
        if (element.matches(pendingSelector) || element.querySelector(pendingSelector)) {
          // Native inert also prevents keyboard focus and activation. Keep any
          // pre-existing inert state owned by the component itself.
          if (!element.inert) {
            element.inert = true;
            blockedInteractions.add(element);
          }
        } else if (blockedInteractions.delete(element)) {
          element.inert = false;
        }
      }
    }

    function finish() {
      if (!active) return;
      active = false;
      root.classList.remove('home-fonts-loading');
      clearTimeout(timer);
      observer.disconnect();
      document.removeEventListener('DOMContentLoaded', scan);
      for (const [element, readyKey] of busy) {
        element.dataset[readyKey] = 'fallback';
