      for (const image of document.querySelectorAll(imageSelector)) {
        if (seen.has(image)) continue;
        seen.add(image);
        sawText = true;
        if (image.complete) {
          image.dataset.imageReady = image.naturalWidth ? 'cached' : 'fallback';
