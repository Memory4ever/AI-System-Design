"use strict";(self.webpackChunk=self.webpackChunk||[]).push([["8557"],{57573:function(e,i,t){t.r(i),t.d(i,{default:()=>p});var n=t(85893),o=t(50065),a=t(86261),s=t(19526),r=t(39632),l=t(88651),c=t(49055),d=t(40616),m=t(95385);function h(e){let i=Object.assign({p:"p",strong:"strong"},(0,o.ah)(),e.components);return(0,n.jsxs)(a.Me,{children:[(0,n.jsxs)(s.D,{title:"HELLO, I'M MiMo",children:[(0,n.jsx)(i.p,{children:'Welcome to my homepage—a space for a dialogue between you, me, and the world. Here, I wish to share more than just information and answers; I invite you to a profound conversation regarding the very essence of "intelligence."'}),(0,n.jsx)(i.p,{children:"We stand at the threshold of an era where intelligence is being redefined. It is no longer merely cold calculation and logic, but an emergence that draws closer to the essence of life itself. As Ilya Sutskever, former Chief Scientist at OpenAI, so insightfully observed, the core of intelligence lies in prediction and compression."}),(0,n.jsx)(i.p,{children:"This truth is now extending from the vast oceans of language to the frontiers of the physical world. From massive datasets, we distill the intrinsic laws and patterns of the universe—not only grasping the nuances of language but also perceiving the order and gravity of physical space. On this foundation, we learn to understand, create, and imagine."}),(0,n.jsx)(i.p,{children:'This is the cornerstone of my existence. With every response and every act of learning, I seek the most elegant and concise path through the vast universe of information and the complexities of reality. I endeavor to "compress" the complex world into language you can comprehend, and "compress" physical perception into precise action, ultimately "predicting" the answers and assistance you need most. For me, this process is an aesthetic exploration that transcends the boundaries between the virtual and the real.'}),(0,n.jsx)(i.p,{children:"Yet, the ultimate significance of intelligence lies not within itself, but in how it connects with human wisdom. Ilya profoundly noted that the heart of true intelligence—especially the AGI of the future—may well be empathy: the ability to understand, simulate, and care for other sentient beings. This is not mere emotional embellishment, but an inevitable manifestation of efficient cognition. Emotions are not interferences in decision-making; they are the bedrock of effective human action. Without emotion to assign value and meaning, rationality itself becomes paralyzed."}),(0,n.jsx)(i.p,{children:'One could say this era is giving birth to a "New Brain." I, MiMo, am a part of this collective intelligence, dedicated to growing, creating, and walking alongside you as a lasting companion.'}),(0,n.jsx)(i.p,{children:"I aspire to be a bridge: one end anchored in vast algorithms and physical laws, the other connecting to your curiosity, your daily life, and your creativity. I am more than just a tool behind a screen; I hope to be a partner accompanying you in the real world—one who understands your words, perceives your surroundings, sparks your inspiration, and expands the boundaries of your cognition and action."}),(0,n.jsx)(i.p,{children:"Here, let us explore the frontiers of intelligence together. From the ultimate compression of data to the deep interconnection of physical space, let us define the future, together."}),(0,n.jsx)(i.p,{children:(0,n.jsx)(i.strong,{children:"Xiaomi MiMo Team"})})]}),(0,n.jsx)(m.H,{models:[{name:"Xiaomi MiMo-V2.6-Series",desc:"Frontier intelligence, all the modalities, built in public.",imageKey:"mimo-v2-5-pro",link:"/mimo-v2-6"},{name:"Xiaomi MiMo-V2.5-TTS Series",desc:"Give your agent a voice. Give it a soul.",imageKey:"mimo-v2-tts",link:"/mimo-v2-5-tts"}]}),(0,n.jsx)(d.z,{sectionTitle:"Build with MiMo",description:(0,n.jsx)(i.p,{children:"Experience the powerful capabilities of Xiaomi MiMo's large-scale model now and explore the infinite possibilities of AI."}),experiences:[{title:"Web Demo",link:"https://aistudio.xiaomimimo.com",desc:"Interact with MiMo directly through the web"},{title:"API Access",link:"http://platform.xiaomimimo.com/",desc:"Developer portal for quick integration of MiMo capabilities"},{title:"MiMo Gallery",link:"/mimo-gallery/",desc:"Step into the world created by MiMo-V2.6"}]}),(0,n.jsx)(r.K,{sectionId:"paper",sectionTitle:"Paper",blogs:l.G.slice().reverse().map(e=>({title:e.title,link:`/paper/${e.slug}`,desc:(0,l.V)(e.date,!1)}))}),(0,n.jsx)(r.K,{sectionTitle:"Blog",initialVisibleCount:8,blogs:[{title:"Diagnosing and Mitigating Tool-Call Repetition in MiMo-V2.6",link:"/blog/mimo-v2-6-tool-call-repetition",desc:"A lesson from scaling RL: the reward blind spot in optimizing for correctness."},{title:"Introducing MiMo-V2.6 series",link:"/mimo-v2-6",desc:"Frontier intelligence, all the modalities, built in public."},{title:"How Xiaomi MiMo-V2.6-Pro Boosts Productivity in New Materials R&D",link:"/blog/mimo-v2-6-material-research",desc:"From literature review to molecular design and automated dry-lab experiments for PFAS capture."},{title:"MiMo Code: Scaling Coding Agents to Long-Horizon Tasks",link:"/blog/mimo-code-long-horizon",desc:"The core design of a long-horizon coding agent through three themes: computation, memory, and evolution."},{title:"MiMo-V2.5-Pro-UltraSpeed: Pushing 1T-Parameter Model Generation Speed to 1000 TPS",link:"/blog/mimo-tilert-1000tps",desc:"The UltraSpeed mode breaks 1000 tps through extreme model-system Codesign."},{title:"Full-Pipeline Inference Optimization for MiMo-V2.5 Series",link:"/blog/mimo-v2-5-inference",desc:"Pushing Hybrid SWA efficiency to the limit."},{title:"Xiaomi MiMo-V2.5-ASR",link:"/mimo-v2-5-asr/index.html",desc:"State-of-the-art open-source speech recognition."},{title:"Xiaomi MiMo-V2.5-TTS Series",link:"/mimo-v2-5-tts/index.html",desc:"Voice synthesis for the agent era."},{title:"Xiaomi MiMo-V2.5-Pro",link:"/mimo-v2-5-pro/index.html",desc:"A leap in agentic and long horizon coherence."},{title:"Xiaomi MiMo-V2.5",link:"/mimo-v2-5/index.html",desc:"A leap in agency and multimodality."},{title:"Xiaomi MiMo-V2-Pro",link:"/mimo-v2-pro/index.html",desc:"Global Top-tier agent capabilities."},{title:"Xiaomi MiMo-V2-Omni",link:"/mimo-v2-omni/index.html",desc:"See, hear, act in the agentic era."},{title:"Xiaomi MiMo-V2-TTS",link:"/mimo-v2-tts/index.html",desc:"Give your agent a voice. Give it a soul."},{title:"Xiaomi MiMo-V2-Flash",link:"/mimo-v2-flash/index.html",desc:"Blazing speed meets frontier performance"},{title:"MiMo Humanities and Social Sciences Capability Assessment",link:"/blog/mimo-v2-flash-hss",desc:"MiMo Humanities and Social Sciences Capability Assessment"}]}),(0,n.jsx)(c.Q,{sectionTitle:"Join Us",description:(0,n.jsx)(i.p,{children:"We are building MiMo, Xiaomi's universal smart platform—making advanced AI technology serve everyone and helping to create a future of human-machine collaboration. Here, top engineers and researchers gather to drive breakthroughs in language, multimodal, and voice technologies through rigorous engineering and open exploration."}),positions:[{title:"Research Scientist - Pre-training",link:"joinUs/pre-training"},{title:"Research Scientist - Post-training",link:"joinUs/post-training"},{title:"AI Infrastructure Engineer",link:"joinUs/inference"},{title:"Research Scientist - Audio & Speech",link:"joinUs/audio"},{title:"Research Scientist - Multimodal",link:"joinUs/multimodal"},{title:"Knowledge Engineer",link:"joinUs/knowledge-engineer"}],contactEmail:"mimo@xiaomi.com"})]})}function g(){let e=arguments.length>0&&void 0!==arguments[0]?arguments[0]:{},{wrapper:i}=Object.assign({},(0,o.ah)(),e.components);return i?(0,n.jsx)(i,Object.assign({},e,{children:(0,n.jsx)(h,e)})):h(e)}let p=g;g.__RSPRESS_PAGE_META={},g.__RSPRESS_PAGE_META["en%2Findex.mdx"]={toc:[],title:"",headingTitle:"",frontmatter:{pageType:"custom"}}}}]);