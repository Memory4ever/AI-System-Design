{"data":{"id":"10.48550/arxiv.2511.21397","type":"dois","attributes":{"doi":"10.48550/arxiv.2511.21397","prefix":"10.48550","suffix":"arxiv.2511.21397","identifiers":[{"identifier":"2511.21397","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2511.21397"}],"creators":[{"name":"Bae, Jiyun","nameType":"Personal","givenName":"Jiyun","familyName":"Bae","affiliation":[],"nameIdentifiers":[]},{"name":"Ok, Hyunjong","nameType":"Personal","givenName":"Hyunjong","familyName":"Ok","affiliation":[],"nameIdentifiers":[]},{"name":"Mo, Sangwoo","nameType":"Personal","givenName":"Sangwoo","familyName":"Mo","affiliation":[],"nameIdentifiers":[]},{"name":"Lee, Jaeho","nameType":"Personal","givenName":"Jaeho","familyName":"Lee","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Understanding the Effects of Distractors on Reasoning Vision-Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-11-26T13:49:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-11-27T01:48:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-01T11:45:59Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-02T02:01:52Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-09-14T07:24:45Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-09-15T01:40:21Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-11","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"How does irrelevant information (i.e., distractors) affect test-time scaling in vision-language models (VLMs)? Prior work on text-only language models has shown that textual distractors can intensify inverse scaling, causing models to reason longer but less effective reasoning traces. In this work, we investigate whether similar phenomena arise in multimodal settings. We introduce Idis (Images with distractors), a visual question-answering dataset that systematically varies distractors along semantic and numerical dimensions. Our analyses reveal that visual distractors affect reasoning VLMs in a fundamentally different way from textual distractors: although inverse scaling still emerges, visual distractors reduce accuracy without increasing reasoning length. We further show that attribute counts extracted from reasoning traces provide key insights into how distractors interact with reasoning length and accuracy. As a sanity check, we propose a simple prompting strategy that mitigates distractor-driven predictions in reasoning vision-language models.","descriptionType":"Abstract"},{"description":"EMNLP 2026","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2511.21397","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount"