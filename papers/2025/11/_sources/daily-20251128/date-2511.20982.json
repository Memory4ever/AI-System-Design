{"data":{"id":"10.48550/arxiv.2511.20982","type":"dois","attributes":{"doi":"10.48550/arxiv.2511.20982","prefix":"10.48550","suffix":"arxiv.2511.20982","identifiers":[{"identifier":"2511.20982","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2511.20982"}],"creators":[{"name":"Liao, Junhan","nameType":"Personal","givenName":"Junhan","familyName":"Liao","affiliation":[],"nameIdentifiers":[]},{"name":"Xu, Minxian","nameType":"Personal","givenName":"Minxian","familyName":"Xu","affiliation":[],"nameIdentifiers":[]},{"name":"Zheng, Wanyi","nameType":"Personal","givenName":"Wanyi","familyName":"Zheng","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Yan","nameType":"Personal","givenName":"Yan","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Ye, Kejiang","nameType":"Personal","givenName":"Kejiang","familyName":"Ye","affiliation":[],"nameIdentifiers":[]},{"name":"Buyya, Rajkumar","nameType":"Personal","givenName":"Rajkumar","familyName":"Buyya","affiliation":[],"nameIdentifiers":[]},{"name":"Xu, Chengzhong","nameType":"Personal","givenName":"Chengzhong","familyName":"Xu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DOPD: A Dynamic PD-Disaggregation Architecture for Maximizing Goodput in LLM Inference Serving"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-11-26T02:27:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-11-27T01:17:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-28T03:31:23Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-01T02:08:42Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-09T04:31:26Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-10T01:40:51Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-11","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"To meet strict Service-Level Objectives (SLOs),contemporary Large Language Models (LLMs) decouple the prefill and decoding stages and place them on separate GPUs to mitigate the distinct bottlenecks inherent to each phase. However, the heterogeneity of LLM workloads causes producerconsumer imbalance between the two instance types in such disaggregated architecture. To address this problem, we propose DOPD (Dynamic Optimal Prefill/Decoding), a dynamic LLM inference system that adjusts instance allocations to achieve an optimal prefill-to-decoding (P/D) ratio based on real-time load monitoring. Combined with an appropriate request-scheduling policy, DOPD effectively resolves imbalances between prefill and decoding instances and mitigates resource allocation mismatches due to mixed-length requests under high concurrency. Experimental evaluations show that, compared with vLLM and DistServe (representative aggregation-based and disaggregationbased approaches), DOPD improves overall system goodput by up to 1.5X, decreases P90 time-to-first-token (TTFT) by up to 67.5%, and decreases P90 time-per-output-token (TPOT) by up to 22.8%. Furthermore, our dynamic P/D adjustment technique performs proactive reconfiguration based on historical load, achieving over 99% SLOs attainment while using less additional resources.","descriptionType":"Abstract"},{"description":"14 pages","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2511.20982","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-11-27T02:47:37.000Z","registered":"2025-11-27T02:47:38.000Z","published":"2025","updated":"2026-03-10T04:53:54.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2511.20982","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}