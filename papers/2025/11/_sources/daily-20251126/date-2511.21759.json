{"data":{"id":"10.48550/arxiv.2511.21759","type":"dois","attributes":{"doi":"10.48550/arxiv.2511.21759","prefix":"10.48550","suffix":"arxiv.2511.21759","identifiers":[{"identifier":"2511.21759","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2511.21759"}],"creators":[{"name":"Wei, Linye","nameType":"Personal","givenName":"Linye","familyName":"Wei","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Wenjue","nameType":"Personal","givenName":"Wenjue","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Tang, Pingzhi","nameType":"Personal","givenName":"Pingzhi","familyName":"Tang","affiliation":[],"nameIdentifiers":[]},{"name":"Guo, Xiaotian","nameType":"Personal","givenName":"Xiaotian","familyName":"Guo","affiliation":[],"nameIdentifiers":[]},{"name":"Ye, Le","nameType":"Personal","givenName":"Le","familyName":"Ye","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Runsheng","nameType":"Personal","givenName":"Runsheng","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Meng","nameType":"Personal","givenName":"Meng","familyName":"Li","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Orchestrating Dual-Boundaries: An Arithmetic Intensity Inspired Acceleration Framework for Diffusion Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-11-24T13:36:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-12-01T01:01:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-03T02:53:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-04T01:25:24Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-11","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Diffusion-based large language models (dLLMs) have recently gained significant attention for their exceptional performance and inherent potential for parallel decoding. Existing frameworks further enhance its inference efficiency by enabling KV caching. However, its bidirectional attention mechanism necessitates periodic cache refreshes that interleave prefill and decoding phases, both contributing substantial inference cost and constraining achievable speedup. Inspired by the heterogeneous arithmetic intensity of the prefill and decoding phases, we propose ODB-dLLM, a framework that orchestrates dual-boundaries to accelerate dLLM inference. In the prefill phase, we find that the predefined fixed response length introduces heavy yet redundant computational overhead, which affects efficiency. To alleviate this, ODB-dLLM incorporates an adaptive length prediction mechanism that progressively reduces prefill overhead and unnecessary computation. In the decoding phase, we analyze the computational characteristics of dLLMs and propose a dLLM-specific jump-share speculative decoding method to enhance efficiency by reducing the number of decoding iterations. Experimental results demonstrate that ODB-dLLM achieves 46-162x and 2.63-6.30x speedups over the baseline dLLM and Fast-dLLM, respectively, while simultaneously mitigating the accuracy degradation in existing acceleration frameworks.","descriptionType":"Abstract"},{"description":"Accepted by DAC 2026","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2511.21759","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-12-01T03:29:32.000Z","registered":"2025-12-01T03:29:33.000Z","published":"2025","updated":"2026-08-04T04:37:38.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2511.21759","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}