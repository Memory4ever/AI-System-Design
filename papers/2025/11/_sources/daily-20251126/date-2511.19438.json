{"data":{"id":"10.48550/arxiv.2511.19438","type":"dois","attributes":{"doi":"10.48550/arxiv.2511.19438","prefix":"10.48550","suffix":"arxiv.2511.19438","identifiers":[{"identifier":"2511.19438","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2511.19438"}],"creators":[{"name":"Zhang, Yaozheng","nameType":"Personal","givenName":"Yaozheng","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Wei","nameType":"Personal","givenName":"Wei","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Kong, Jie","nameType":"Personal","givenName":"Jie","familyName":"Kong","affiliation":[],"nameIdentifiers":[]},{"name":"Zhou, Jiehan","nameType":"Personal","givenName":"Jiehan","familyName":"Zhou","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Xianwei","nameType":"Personal","givenName":"Xianwei","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Cui, Huanqing","nameType":"Personal","givenName":"Huanqing","familyName":"Cui","affiliation":[],"nameIdentifiers":[]},{"name":"Bao, Han","nameType":"Personal","givenName":"Han","familyName":"Bao","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Yuhai","nameType":"Personal","givenName":"Yuhai","familyName":"Liu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Opt4GPTQ: Co-Optimizing Memory and Computation for 4-bit GPTQ Quantized LLM Inference on Heterogeneous Platforms"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","subjectScheme":"arXiv"},{"lang":"en","subject":"Performance (cs.PF)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-29T12:57:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-11-26T01:00:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-05T05:37:04Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-06T01:25:49Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-11","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"The increasing adoption of large language models (LLMs) on heterogeneous computing platforms poses significant challenges to achieving high inference efficiency. To address these efficiency bottlenecks across diverse platforms, this paper proposes Opt4GPTQ, a practical optimization method designed for 4-bit GPTQ quantized LLMs inference on heterogeneous AI accelerators. Built upon the vLLM serving system, Opt4GPTQ integrates three platform-level optimization strategies: Shared Memory Buffering Optimization (SMB-Opt), which caches frequently accessed data in shared memory and employs single-threaded writes; Vectorized Memory Loading Optimization (VML-Opt), which utilizes vectorized memory operations for efficient data loading; and Inline Assembly Optimization (ILA-Opt), which directly leverages hardwarenative vector half-precision addition and fused multiply-accumulate instructions. Experimental results show that Opt4GPTQ effectively improves performance across various models while maintaining original model accuracy, achieving throughput gains of up to 84.42%. This work highlights the critical role of platformlevel engineering in enabling efficient LLMs inference on emerging architectures and provides valuable methodologies for future heterogeneous platform adaptation.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2511.19438","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-11-26T02:47:28.000Z","registered":"2025-11-26T02:47:29.000Z","published":"2025","updated":"2026-02-06T03:23:05.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2511.19438","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}