      <a href="/search/?searchtype=author&amp;query=Du%2C+P">Peng Du</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Qin%2C+C">Chuan Qin</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Shen%2C+D">Dazhong Shen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Xiong%2C+H">Hui Xiong</a>
      
