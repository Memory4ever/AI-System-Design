      <a href="/search/?searchtype=author&amp;query=Guo%2C+Q">Qihao Guo</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhang%2C+S">Shaoting Zhang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Huang%2C+Q">Qi Huang</a>, 
      
