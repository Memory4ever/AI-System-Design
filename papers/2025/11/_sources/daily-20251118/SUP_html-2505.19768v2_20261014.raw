<tr id="Sx4.T3.1.1" class="ltx_tr">
<td id="Sx4.T3.1.1.1" class="ltx_td ltx_align_left ltx_border_tt"><span id="Sx4.T3.1.1.1.1" class="ltx_text ltx_font_bold">Method</span></td>
<td id="Sx4.T3.1.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="Sx4.T3.1.1.2.1" class="ltx_text ltx_font_bold">F1 <math id="Sx4.T3.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td>
<td id="Sx4.T3.1.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="Sx4.T3.1.1.3.1" class="ltx_text ltx_font_bold">Accuracy <math id="Sx4.T3.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td></tr>
