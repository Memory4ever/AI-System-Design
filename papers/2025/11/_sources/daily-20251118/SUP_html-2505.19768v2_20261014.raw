<span id="A1.SSx6.pic1.p1.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><img src="2505.19768v2/Newsclipings_person_val_19.png" id="A1.SSx6.pic1.p1.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:197/114;" width="197" height="114" alt="[Uncaptioned image]"></span></span>
</span>
