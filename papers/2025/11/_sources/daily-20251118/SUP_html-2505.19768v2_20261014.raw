.17em;font-size:11.5pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="481.52"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A1.SSx6.pic1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Good case: Output a correct answer after obtaining reliable evidence</span></span></span></foreignObject></g></g></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 16.85)"><foreignObject style="--ltx-fo-width:47.46em;--ltx-fo-height:19.51em;--ltx-fo-depth:0.22em;font-size:10pt;" height="273.08" overflow="visible" transform="matrix(1 0 0 -1 0 270.01)" width="656.71"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A1.SSx6.pic1.2" class="ltx_inline-logical-block ltx_minipage ltx_align_bottom" style="width:47.46em;">
<span id="A1.SSx6.pic1.p1" class="ltx_para ltx_noindent">
