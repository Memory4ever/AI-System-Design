<td id="Sx4.T3.1.2.3" class="ltx_td ltx_align_center ltx_border_t">0.424</td></tr>
<tr id="Sx4.T3.1.3" class="ltx_tr">
<td id="Sx4.T3.1.3.1" class="ltx_td ltx_align_left">TOOLs</td>
