<td id="A1.T6.1.12.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_r" style="padding:0.5pt 4.6pt;">
<span id="A1.T6.1.12.1.1" class="ltx_inline-block ltx_align_top" style="width:42.7pt;">
<span id="A1.T6.1.12.1.1.1" class="ltx_p">Chain</span>
</span></td>
<td id="A1.T6.1.12.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_r" style="padding:0.5pt 4.6pt;">
