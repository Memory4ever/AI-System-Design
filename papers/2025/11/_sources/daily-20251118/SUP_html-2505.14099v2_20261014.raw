<span id="A1.T8.1.14.2.1.2" class="ltx_p"><math id="A1.T8.m4" class="ltx_Math" alttext="\mathcal{T}_{2}^{q_{c},R}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mn>2</mn><mrow><msub><mi>q</mi><mi>c</mi></msub><mo>,</mo><mi>R</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathcal{T}_{2}^{q_{c},R}</annotation></semantics></math>: [UnName Entity, film.performance.actor, Taylor Swift], [UnName Entity, film.performance.film, <span id="A1.T8.1.14.2.1.2.1" class="ltx_text ltx_font_bold">The Lorax</span>]</span>
</span></td>
