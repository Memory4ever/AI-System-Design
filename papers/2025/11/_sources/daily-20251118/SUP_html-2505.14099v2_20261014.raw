<td id="A1.T6.1.11.1" class="ltx_td ltx_align_left ltx_align_top" style="padding:0.5pt 4.6pt;" colspan="3"><span id="A1.T6.1.11.1.1" class="ltx_text ltx_leader"><span class="ltx_rule" style="width:100%;height:0.4pt;--ltx-bg-color:black;display:inline-block;"> </span></span></td></tr>
