<span id="A1.T9.1.8.3.1.1" class="ltx_p"><span id="A1.T9.1.8.3.1.1.1" class="ltx_text ltx_font_bold">Result</span></span>
</span></td></tr>
<tr id="A1.T9.1.9" class="ltx_tr">
<td id="A1.T9.1.9.1" class="ltx_td ltx_align_left ltx_align_top" style="padding:1pt 4.6pt;" colspan="3"><span id="A1.T9.1.9.1.1" class="ltx_text ltx_leader"><span class="ltx_rule" style="width:100%;height:0.4pt;--ltx-bg-color:black;display:inline-block;"> </span></span></td></tr>
