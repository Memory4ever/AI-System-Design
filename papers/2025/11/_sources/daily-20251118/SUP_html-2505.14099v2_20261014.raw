<td id="Sx5.T3.1.26.1" class="ltx_td ltx_align_left" style="padding-left:4.6pt;padding-right:4.6pt;">PDRR(gt)</td>
<td id="Sx5.T3.1.26.2" class="ltx_td ltx_align_center" style="padding-left:4.6pt;padding-right:4.6pt;"><span id="Sx5.T3.1.26.2.1" class="ltx_text ltx_font_bold">62.2</span></td>
