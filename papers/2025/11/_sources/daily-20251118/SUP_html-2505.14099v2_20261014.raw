<td id="Sx5.T3.1.21.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.6pt;padding-right:4.6pt;" colspan="6"><span id="Sx5.T3.1.21.1.1" class="ltx_text ltx_font_italic">GPT-4o-2024-11-20</span></td></tr>
<tr id="Sx5.T3.1.22" class="ltx_tr">
<td id="Sx5.T3.1.22.1" class="ltx_td ltx_align_left" style="padding-left:4.6pt;padding-right:4.6pt;" colspan="6"><span id="Sx5.T3.1.22.1.1" class="ltx_text ltx_leader"><span class="ltx_rule" style="width:100%;height:0.4pt;--ltx-bg-color:black;display:inline-block;"> </span></span></td></tr>
<tr id="Sx5.T3.1.23" class="ltx_tr">
<td id="Sx5.T3.1.23.1" class="ltx_td ltx_align_left" style="padding-left:4.6pt;padding-right:4.6pt;">CoT</td>
<td id="Sx5.T3.1.23.2" class="ltx_td ltx_align_center" style="padding-left:4.6pt;padding-right:4.6pt;">44.8</td>
<td id="Sx5.T3.1.23.3" class="ltx_td ltx_align_center" style="padding-left:4.6pt;padding-right:4.6pt;">44.2</td>
<td id="Sx5.T3.1.23.4" class="ltx_td ltx_align_center" style="padding-left:4.6pt;padding-right:4.6pt;">49.5</td>
<td id="Sx5.T3.1.23.5" class="ltx_td ltx_align_center" style="padding-left:4.6pt;padding-right:4.6pt;">30.5</td>
<td id="Sx5.T3.1.23.6" class="ltx_td ltx_align_center" style="padding-left:4.6pt;padding-right:4.6pt;">27.4</td></tr>
<tr id="Sx5.T3.1.24" class="ltx_tr">
<td id="Sx5.T3.1.24.1" class="ltx_td ltx_align_left" style="padding-left:4.6pt;padding-right:4.6pt;">ToG</td>
<td id="Sx5.T3.1.24.2" class="ltx_td ltx_align_center" style="padding-left:4.6pt;padding-right:4.6pt;">48.9</td>
<td id="Sx5.T3.1.24.3" class="ltx_td ltx_align_center" style="padding-left:4.6pt;padding-right:4.6pt;">49.9</td>
<td id="Sx5.T3.1.24.4" class="ltx_td ltx_align_center" style="padding-left:4.6pt;padding-right:4.6pt;">50.1</td>
<td id="Sx5.T3.1.24.5" class="ltx_td ltx_align_center" style="padding-left:4.6pt;padding-right:4.6pt;"><span id="Sx5.T3.1.24.5.1" class="ltx_text ltx_underline">42.7</span></td>
<td id="Sx5.T3.1.24.6" class="ltx_td ltx_align_center" style="padding-left:4.6pt;padding-right:4.6pt;"><span id="Sx5.T3.1.24.6.1" class="ltx_text ltx_font_bold">37.1</span></td></tr>
<tr id="Sx5.T3.1.25" class="ltx_tr">
<td id="Sx5.T3.1.25.1" class="ltx_td ltx_align_left" style="padding-left:4.6pt;padding-right:4.6pt;">PDRR</td>
<td id="Sx5.T3.1.25.2" class="ltx_td ltx_align_center" style="padding-left:4.6pt;padding-right:4.6pt;"><span id="Sx5.T3.1.25.2.1" class="ltx_text ltx_underline">59.6</span></td>
<td id="Sx5.T3.1.25.3" class="ltx_td ltx_align_center" style="padding-left:4.6pt;padding-right:4.6pt;"><span id="Sx5.T3.1.25.3.1" class="ltx_text ltx_font_bold">66.2</span></td>
<td id="Sx5.T3.1.25.4" class="ltx_td ltx_align_center" style="padding-left:4.6pt;padding-right:4.6pt;"><span id="Sx5.T3.1.25.4.1" class="ltx_text ltx_underline">59.1</span></td>
<td id="Sx5.T3.1.25.5" class="ltx_td ltx_align_center" style="padding-left:4.6pt;padding-right:4.6pt;">38.5</td>
<td id="Sx5.T3.1.25.6" class="ltx_td ltx_align_center" style="padding-left:4.6pt;padding-right:4.6pt;">34.5</td></tr>
