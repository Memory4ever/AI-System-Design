<td id="A1.T7.1.8.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_r" style="padding:1.5pt 4.6pt;">
<span id="A1.T7.1.8.1.1" class="ltx_inline-block ltx_align_top" style="width:42.7pt;">
<span id="A1.T7.1.8.1.1.1" class="ltx_p"><span id="A1.T7.1.8.1.1.1.1" class="ltx_text ltx_font_bold">Answer</span></span>
</span></td>
