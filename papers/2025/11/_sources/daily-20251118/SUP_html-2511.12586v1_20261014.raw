class="ltx_Math" alttext="\tilde{D}=d" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi mathsize="0.800em">D</mi><mo>~</mo></mover><mo mathsize="0.800em">=</mo><mi mathsize="0.800em">d</mi></mrow><annotation encoding="application/x-tex">\tilde{D}=d</annotation></semantics></math><span id="algx1.l6.9" class="ltx_text" style="font-size:80%;">
</span>
</div>
