ion encoding="application/x-tex">P_{b}=P_{b}+[p]</annotation></semantics></math><span id="algx1.l38.6" class="ltx_text" style="font-size:80%;">, </span><math id="algx1.l38.m4" class="ltx_Math" alttext="call(\Omega(p))" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em" mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mi mathsize="0.800em">p</mi><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow><annotation encoding="application/x-tex">call(\Omega(p))</annotation></semantics></math><span id="algx1.l38.7" class="ltx_text" style="font-size:80%;">
