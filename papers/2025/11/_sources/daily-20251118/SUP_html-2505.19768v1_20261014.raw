<div id="algx1.l5" class="ltx_listingline">
              
              
            <span id="algx1.l5.2" class="ltx_text" style="font-size:90%;">  Select node</span><math id="algx1.l5.m1" class="ltx_Math" alttext="s\leftarrow\arg\max_{s^{\prime}\in children(s)}\left[V(s^{\prime})+C\sqrt{\frac{\ln(N(s)+1)}{N(s^{\prime})+1}}\right]" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">s</mi><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mi mathsize="0.900em">arg</mi><mo lspace="0.167em">⁡</mo><mrow><msub><mi mathsize="0.900em">max</mi><mrow><msup><mi mathsize="0.900em">s</mi><mo mathsize="0.900em">′</mo></msup><mo mathsize="0.900em">∈</mo><mrow><mi mathsize="0.900em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">h</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">s</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow></msub><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi mathsize="0.900em">V</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mi mathsize="0.900em">s</mi><mo mathsize="0.900em">′</mo></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">C</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><mi mathsize="0.900em">ln</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mi mathsize="0.900em">N</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">s</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1