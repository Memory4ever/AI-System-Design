<td id="A1.T6.2.3.4" class="ltx_td ltx_align_center ltx_border_t">0.556</td>
<td id="A1.T6.2.3.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.573</td>
<td id="A1.T6.2.3.6" class="ltx_td ltx_align_center ltx_border_t">2.40</td></tr>
