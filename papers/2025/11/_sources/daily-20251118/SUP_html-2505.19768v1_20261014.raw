<div id="algx1.l4" class="ltx_listingline">
              
              
            <span id="algx1.l4.2" class="ltx_text" style="font-size:90%;">  </span><math id="algx1.l4.m1" class="ltx_Math" alttext="s\leftarrow" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">s</mi><mo mathsize="0.900em" stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">s\leftarrow</annotation></semantics></math><span id="algx1.l4.3" class="ltx_text" style="font-size:90%;"> root node
</span>
