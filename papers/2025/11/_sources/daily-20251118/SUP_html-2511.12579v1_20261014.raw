<td id="Sx4.T2.1.11.7" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_right ltx_border_bb" style="padding-left:0.7pt;padding-right:0.7pt;"><span id="Sx4.T2.1.11.7.1" class="ltx_text ltx_font_italic">29.74%</span></td></tr>
