</span></span></span></foreignObject></g><g style="--ltx-fill-color:#FADBD8;" fill="#FADBD8"><path d="M 41.34 186.02 L -41.34 186.02 L -41.34 144.68 L 41.34 144.68 Z M -41.34 144.68"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.7 0.0 0.0 0.7 -28.98 156.18)"><foreignObject style="--ltx-fo-width:5.98em;--ltx-fo-height:1.89em;--ltx-fo-depth:0em;font-size:10pt;" height="26.21" overflow="visible" transform="matrix(1 0 0 -1 0 26.21)" width="82.79"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
