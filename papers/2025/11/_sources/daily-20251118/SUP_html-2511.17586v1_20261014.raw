-55.12"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.7 0.0 0.0 0.7 -135.19 -57.75)"><foreignObject style="--ltx-fo-width:5.15em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.68" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="71.3"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F3.pic1.m3" class="ltx_Math" alttext="w_{3}=c_{3}\times h_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>w</mi><mn>3</mn></msub><mo>=</mo><mrow><msub><mi>c</mi><mn>3</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>h</mi><mn>3</mn></msub></mrow></mrow><annotation encoding="application/x-tex">w_{3}=c_{3}\times h_{3}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M -70.18 0 L -42.09 0"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 -41.81 0)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><path style="fill:none" d="M -81.21 -20.3 L -42.07 -10.5"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.9701 0.24274 -0.24274 0.9701 -41.8 -10.43)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><path style="fill:none" d="M -91.59 -45.79 L -42.03 -20.98"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.89427 0.44753 -0.44753 0.89427 -41.78 -20.86)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-fill-color:#FFFFCC;" fill="#FFFFCC"><path d="M 154.1 41.34 L 110.24 85.21 L 66.37 41.34 L 110.24 