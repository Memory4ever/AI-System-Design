<span id="alg1.l3.2.1" class="ltx_p"><math id="alg1.l3.m1" class="ltx_Math" alttext="n=length(A)" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">n=length(A)</annotation></semantics></math></span>
