<span id="alg1.l4.2" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:345.0pt;"><span class="ltx_inline-block"><svg id="alg1.l4.pic1" class="ltx_picture" height="1" overflow="visible" version="1.1" viewBox="0 0 1 1" width="1"><g transform="translate(0,1) matrix(1 0 0 -1 0 0)"></g></svg></span>
<span id="alg1.l4.2.1" class="ltx_p"><span id="alg1.l4.2.1.1" class="ltx_text ltx_font_bold">for</span> each agent <math id="alg1.l4.m1" class="ltx_Math" alttext="a_{i}\in A" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>i</mi></msub><mo>∈</mo><mi>A</mi></mrow><annotation encoding="application/x-tex">a_{i}\in A</annotation></semantics></math> <span id="alg1.l4.2.1.2" class="ltx_text ltx_font_bold">do</span></span>
</span><span class="ltx_inline-block"><svg id="alg1.l4.pic2" class="ltx_picture" height="1" overflow="visible" version="1.1" viewBox="0 0 1 1" width="1"><g transform="translate(0,1) matrix(1 0 0 -1 0 0)"></g></svg></span><span class="ltx_inline-block"><svg id="alg1.l4.pic3" class="ltx_picture" height="1" overflow="visible" version="1.1" viewBox="0 0 1 1" width="1"><g transform="translate(0,1) matrix(1 0 0 -1 0 0)"></g></svg></span>
</div>
<div id="alg1.l5" class="ltx_listingline">
              
              
              <span class="ltx_inline-block"><svg id="alg1.l5.pic1" class="ltx_picture" height="1" overflow="visible" version="1.1" viewBox="0 0 1 1" width="1"><g transform="translate(0,1) matrix(1 0 0 -1 0 0)"></g></svg></span>
<span id="alg1.l5.2" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:330.0pt;">
<span id="alg1.l5.2.1" class="ltx_p"><math id="alg1.l5.m1" class="ltx_Math" alttext="v_{i}=f(\text{expertise}(a_{i}),\text{performance}(a_{i},H),\text{relevance}(a_{i},T))" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi>i</mi></msub><mo>=</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>expertise</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mtext>performance</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>i</mi></msub><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mtext>relevance</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>i</mi></msub><mo>,</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">v_{i}=f(\text{expertise}(a_{i}),\text{performance}(a_{i},H),\text{relevance}(a_{i},T))</annotation></semantics></math> <span id="alg1.l5.2.1.1" class="ltx_text" style="float:right; float:right;"><math id="alg1.l5.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math><span id="alg1.l5.2.1.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#808080;"> <math id="alg1.l5.m3" class="ltx_Math" alttext="v_{i}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">v</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">i</mi></msub><annotation encoding="application/x-tex">v_{i}</annotation></semantics></math><span id="alg1.l5.2.1.1.1.1" class="ltx_text" style="--ltx-fg-color:#0000FF;">: capability vector</span></span></span></span>
</span><span class="ltx_inline-block"><svg id="alg1.l5.pic2" class="ltx_picture" height="1" overflow="visible" version="1.1" viewBox="0 0 1 1" width="1"><g transform="translate(0,1) matrix(1 0 0 -1 0 0)"></g></svg></span><span class="ltx_inline-block"><svg id="alg1.l5.pic3" class="ltx_picture" height="1" overflow="visible" version="1.1" viewBox="0 0 1 1" width="1"><g transform="translate(0,1) matrix(1 0 0 -1 0 0)"></g></svg></span><span class="ltx_inline-block"><svg id="alg1.l5.pic4" class="ltx_picture" height="1" overflow="visible" version="1.1" viewBox="0 0 1 1" width="1"><g transform="translate(0,1) matrix(1 0 0 -1 0 0)"></g></svg></span>
</div>
