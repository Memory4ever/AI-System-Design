<span id="alg1.l2.2.1" class="ltx_p">Cluster: <math id="alg1.l2.m1" class="ltx_Math" alttext="C=\{c_{1},c_{2},\ldots,c_{k}\}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo>,</mo><msub><mi>c</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>c</mi><mi>k</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">C=\{c_{1},c_{2},\ldots,c_{k}\}</annotation></semantics></math></span>
</span>
