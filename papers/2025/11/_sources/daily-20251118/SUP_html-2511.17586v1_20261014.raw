<span id="S3.F3.pic1.3.2" class="ltx_p">Orchestration</span>
</span></span></span></foreignObject></g><g stroke-width="0.8pt"><path style="fill:none" d="M 0 20.86 L 0 58.22"></path><g transform="matrix(0.0 1.0 -1.0 0.0 0 58.22)"><path style="stroke:none" d="M 3.6 0 L -2.16 2.88 L 0 0 L -2.16 -2.88"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.7 0.0 0.0 0.7 3.62 37.98)"><foreignObject style="--ltx-fo-width:4.52em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="62.54"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F3.pic1.4" class="ltx_text">Escalation</span></span></span></foreignObject></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 0 103.54 L 0 140.89"></path><g transform="matrix(0.0 1.0 -1.0 0.0 0 140.89)"><path style="stroke:none" d="M 3.6 0 L -2.16 2.88 L 0 0 L -2.16 -2.88"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.7 0.0 0.0 0.7 3.62 120.65)"><foreignObject style="--ltx-fo-width:6.26em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="86.56"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F3.pic1.5" class="ltx_text">Final Decision</span></span></span></foreignObject></g></g><g style="--ltx-fill-color:#D5F5E3;" fill="#D5F5E3"><path d="M -70.38 0 C -70.38 5.72 -88.22 10.35 -110.24 10.35 C -132.25 10.35 -150.09 5.72 -150.09 0 C -150.09 -5.72 -132.25 -10.35 -110.24 -10.35 C -88.22 -10.35 -70.38 -5.72 -70.38 0 Z M -110.24 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.7 0.0 0.0 0.7 -135.19 -2.64)"><foreignObject style="--ltx-fo-width:5.15em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.15em;font-size:10pt;" heigh