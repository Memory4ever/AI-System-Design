{"data":{"id":"10.48550/arxiv.2511.11313","type":"dois","attributes":{"doi":"10.48550/arxiv.2511.11313","prefix":"10.48550","suffix":"arxiv.2511.11313","identifiers":[{"identifier":"2511.11313","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2511.11313"}],"creators":[{"name":"Hannan, Tanveer","nameType":"Personal","givenName":"Tanveer","familyName":"Hannan","affiliation":[],"nameIdentifiers":[]},{"name":"Mallios, Dimitrios","nameType":"Personal","givenName":"Dimitrios","familyName":"Mallios","affiliation":[],"nameIdentifiers":[]},{"name":"Pathak, Parth","nameType":"Personal","givenName":"Parth","familyName":"Pathak","affiliation":[],"nameIdentifiers":[]},{"name":"Sardari, Faegheh","nameType":"Personal","givenName":"Faegheh","familyName":"Sardari","affiliation":[],"nameIdentifiers":[]},{"name":"Seidl, Thomas","nameType":"Personal","givenName":"Thomas","familyName":"Seidl","affiliation":[],"nameIdentifiers":[]},{"name":"Bertasius, Gedas","nameType":"Personal","givenName":"Gedas","familyName":"Bertasius","affiliation":[],"nameIdentifiers":[]},{"name":"Fayyaz, Mohsen","nameType":"Personal","givenName":"Mohsen","familyName":"Fayyaz","affiliation":[],"nameIdentifiers":[]},{"name":"Sengupta, Sunando","nameType":"Personal","givenName":"Sunando","familyName":"Sengupta","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DocSLM: A Small Vision-Language Model for Long Multimodal Document Understanding"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-11-14T13:56:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-11-17T01:45:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-17T20:52:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-19T01:07:23Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-11-21T14:18:23Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-11-24T01:40:11Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-11","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Large Vision-Language Models (LVLMs) have demonstrated strong multimodal reasoning capabilities on long and complex documents. However, their high memory footprint makes them impractical for deployment on resource-constrained edge devices. We present DocSLM, an efficient Small Vision-Language Model designed for long-document understanding under constrained memory resources. DocSLM incorporates a Hierarchical Multimodal Compressor that jointly encodes visual, textual, and layout information from each page into a fixed-length sequence, greatly reducing memory consumption while preserving both local and global semantics. To enable scalable processing over arbitrarily long inputs, we introduce a Streaming Abstention mechanism that operates on document segments sequentially and filters low-confidence responses using an entropy-based uncertainty calibrator. Across multiple long multimodal document benchmarks, DocSLM matches or surpasses state-of-the-art methods while using 82\\% fewer visual tokens, 75\\% fewer parameters, and 71\\% lower latency, delivering reliable multimodal document understanding on lightweight edge devices. Code and Model are available in https://github.com/Tanveer81/DocSLM.git.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2511.11313","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-11-17T02:51:08.000Z","registered":"2025-11-17T02:51:09.000Z","published":"2025","updated":"2025-11-24T02:50:26.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2511.11313","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}