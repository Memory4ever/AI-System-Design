{"data":{"id":"10.48550/arxiv.2507.13546","type":"dois","attributes":{"doi":"10.48550/arxiv.2507.13546","prefix":"10.48550","suffix":"arxiv.2507.13546","identifiers":[{"identifier":"2507.13546","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2507.13546"}],"creators":[{"name":"Mikhailov, Dmitrii","nameType":"Personal","givenName":"Dmitrii","familyName":"Mikhailov","affiliation":[],"nameIdentifiers":[]},{"name":"Letunovskiy, Aleksey","nameType":"Personal","givenName":"Aleksey","familyName":"Letunovskiy","affiliation":[],"nameIdentifiers":[]},{"name":"Kovaleva, Maria","nameType":"Personal","givenName":"Maria","familyName":"Kovaleva","affiliation":[],"nameIdentifiers":[]},{"name":"Arkhipkin, Vladimir","nameType":"Personal","givenName":"Vladimir","familyName":"Arkhipkin","affiliation":[],"nameIdentifiers":[]},{"name":"Korviakov, Vladimir","nameType":"Personal","givenName":"Vladimir","familyName":"Korviakov","affiliation":[],"nameIdentifiers":[]},{"name":"Polovnikov, Vladimir","nameType":"Personal","givenName":"Vladimir","familyName":"Polovnikov","affiliation":[],"nameIdentifiers":[]},{"name":"Vasilev, Viacheslav","nameType":"Personal","givenName":"Viacheslav","familyName":"Vasilev","affiliation":[],"nameIdentifiers":[]},{"name":"Sidorova, Evelina","nameType":"Personal","givenName":"Evelina","familyName":"Sidorova","affiliation":[],"nameIdentifiers":[]},{"name":"Dimitrov, Denis","nameType":"Personal","givenName":"Denis","familyName":"Dimitrov","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"NABLA: Neighborhood Adaptive Block-Level Attention"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-07-17T21:36:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-07-02T00:31:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-03T09:09:34Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-07T00:34:02Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-07","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/access.2026.3686867","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Recent progress in transformer-based architectures has demonstrated remarkable success in video generation tasks. However, the quadratic complexity of full attention mechanisms remains a critical bottleneck, particularly for high-resolution and long-duration video sequences. In this paper, we propose NABLA, a novel Neighborhood Adaptive Block-Level Attention mechanism that dynamically adapts to sparsity patterns in video diffusion transformers (DiTs). By leveraging block-wise attention with adaptive sparsity-driven threshold, NABLA reduces computational overhead while preserving generative quality. Our method does not require custom low-level operator design and can be seamlessly integrated with PyTorch's Flex Attention operator. Experiments demonstrate that NABLA achieves up to 2.7x faster training and inference compared to baseline almost without compromising quantitative metrics (CLIP score, VBench score, human evaluation score) and visual quality drop. The code and model weights are available here: https://github.com/gen-ai-team/Wan2.1-NABLA","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2507.13546","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-07-21T01:21:25.000Z","registered":"2025-07-21T01:21:26.000Z","published":"2025","updated":"2026-07-07T04:55:56.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2507.13546","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[{"id":"10.1109/access.2026.3686867","type":"dois"}]}}}}