<td id="S4.T3.5.3.3" class="ltx_td ltx_align_right ltx_border_t"><span id="S4.T3.5.3.3.1" class="ltx_text ltx_phantom"><span style="visibility:hidden">0</span></span> 31.4</td>
<td id="S4.T3.5.3.4" class="ltx_td ltx_align_right ltx_border_t"><span id="S4.T3.5.3.4.1" class="ltx_text ltx_phantom"><span style="visibility:hidden">0</span></span> 10.5</td>
<td id="S4.T3.5.3.5" class="ltx_td ltx_nopad_r ltx_align_right ltx_border_t"><span id="S4.T3.5.3.5.1" class="ltx_text ltx_phantom"><span style="visibility:hidden">0</span></span> 20.3</td></tr>
<tr id="S4.T3.5.4" class="ltx_tr">
<td id="S4.T3.5.4.1" class="ltx_td ltx_align_left">NABLA(0.7) is better</td>
<td id="S4.T3.5.4.2" class="ltx_td ltx_align_right"><span id="S4.T3.5.4.2.1" class="ltx_text ltx_phantom"><span style="visibility:hidden">0</span></span> 13.3</td>
<td id="S4.T3.5.4.3" class="ltx_td ltx_align_right"><span id="S4.T3.5.4.3.1" class="ltx_text ltx_phantom"><span style="visibility:hidden">0</span></span> 26.7</td>
<td id="S4.T3.5.4.4" class="ltx_td ltx_align_right"><span id="S4.T3.5.4.4.1" class="ltx_text ltx_phantom"><span style="visibility:hidden">0</span></span> 15.2</td>
<td id="S4.T3.5.4.5" class="ltx_td ltx_nopad_r ltx_align_right"><span id="S4.T3.5.4.5.1" class="ltx_text ltx_phantom"><span style="visibility:hidden">0</span></span> 18.4</td></tr>
<tr id="S4.T3.5.5" class="ltx_tr">
<td id="S4.T3.5.5.1" class="ltx_td ltx_align_left">Both are good</td>
