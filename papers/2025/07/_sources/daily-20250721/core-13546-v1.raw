<td id="S4.T3.5.1.3" class="ltx_td ltx_align_right ltx_border_tt">Visual</td>
<td id="S4.T3.5.1.4" class="ltx_td ltx_align_right ltx_border_tt">Motion</td>
<td id="S4.T3.5.1.5" class="ltx_td ltx_nopad_r ltx_align_right ltx_border_tt">Overall</td></tr>
<tr id="S4.T3.5.2" class="ltx_tr">
<td id="S4.T3.5.2.1" class="ltx_td"></td>
<td id="S4.T3.5.2.2" class="ltx_td ltx_align_right">Alignment</td>
<td id="S4.T3.5.2.3" class="ltx_td ltx_align_right">Quality</td>
<td id="S4.T3.5.2.4" class="ltx_td ltx_align_right">Naturalness</td>
<td id="S4.T3.5.2.5" class="ltx_td ltx_nopad_r"></td></tr>
<tr id="S4.T3.5.3" class="ltx_tr">
