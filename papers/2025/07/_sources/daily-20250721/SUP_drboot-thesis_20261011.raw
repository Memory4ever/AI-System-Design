   		<script>
            function setlanguage(lang) {
                url = window.location.href
                url = url.replace(/;?setlang=[a-zA-Z]+/g, "") // remove existing setlang parameters
                url = url.replace(/#.*/, "") // remove hash
                url = url.replace(/\?$/, "") // remove trailing ?
                url = url + (url.indexOf("?") != -1 ? ';' : '?') + 'setlang=' + lang
                window.location = url
                return false
            }
        </script>
