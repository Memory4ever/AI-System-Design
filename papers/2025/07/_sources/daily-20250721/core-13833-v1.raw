<span class="ltx_contact ltx_role_affiliation"><span class="ltx_contact_name">Affiliation: </span><span id="id13" class="ltx_text ltx_affiliation_institution">Shanghai Innovation Institute</span>, <span id="id14" class="ltx_text ltx_affiliation_institution"><math id="m1" class="ltx_Math" alttext="AI^{3}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>I</mi><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">AI^{3}</annotation></semantics></math>, Fudan University</span>, <span id="id15" class="ltx_text ltx_affiliation_institution">Shanghai Academy of AI for Science</span>
