<td id="S4.T6.2.1.6.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T6.2.1.6.1.1" class="ltx_text ltx_font_italic">Statistical Analysis</span></td>
<td id="S4.T6.2.1.6.2" class="ltx_td ltx_border_t"></td>
<td id="S4.T6.2.1.6.3" class="ltx_td ltx_border_t"></td></tr>
