<section id="S4.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.3 </span>Experiment on RQ2</h3>

<figure id="S4.T3" class="ltx_table">
<div id="S4.T3.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:76.5pt;vertical-align:-37.2pt;"><span class="ltx_transformed_inner" style="transform:translate(-238.8pt,53.0pt) scale(0.41942412103855,0.41942412103855) ;">
