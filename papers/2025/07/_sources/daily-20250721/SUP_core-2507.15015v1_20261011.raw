row></msup><mo style="--ltx-bg-color:#D4F4FC;" mathbackground="#D4F4FC">,</mo><msup><mi style="--ltx-bg-color:#D4F4FC;" mathbackground="#D4F4FC">O</mi><mrow><mi style="--ltx-bg-color:#D4F4FC;" mathbackground="#D4F4FC">r</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#D4F4FC;" mathbackground="#D4F4FC">p</mi></mrow></msup><mo style="--ltx-bg-color:#D4F4FC;" mathbackground="#D4F4FC" stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(T^{rp},S^{rp},A^{rp},C^{rp},R^{rp},O^{rp})</annotation></semantics></math></span></td>
