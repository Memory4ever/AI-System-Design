<td id="S3.T1.fig1.2.5.5" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:1pt;padding-bottom:1pt;">47.2%</td>
<td id="S3.T1.fig1.2.5.6" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">1.45</td>
<td id="S3.T1.fig1.2.5.7" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:1pt;padding-bottom:1pt;">7.2%</td>
<td id="S3.T1.fig1.2.5.8" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">1.00</td>
