<td id="S3.T1.fig1.2.6.4" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">1.89</td>
<td id="S3.T1.fig1.2.6.5" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:1pt;padding-bottom:1pt;">4.5%</td>
<td id="S3.T1.fig1.2.6.6" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">1.26</td>
<td id="S3.T1.fig1.2.6.7" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:1pt;padding-bottom:1pt;">6.1%</td>
<td id="S3.T1.fig1.2.6.8" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">1.00</td>
<td id="S3.T1.fig1.2.6.9" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">0%</td></tr>
<tr id="S3.T1.fig1.2.7" class="ltx_tr">
<th id="S3.T1.fig1.2.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r" style="padding-top:1pt;padding-bottom:1pt;">Geography</th>
<td id="S3.T1.fig1.2.7.2" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">1.28</td>
<td id="S3.T1.fig1.2.7.3" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:1pt;padding-bottom:1pt;">14.1%</td>
<td id="S3.T1.fig1.2.7.4" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">3.12</td>
<td id="S3.T1.fig1.2.7.5" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:1pt;padding-bottom:1pt;">62.3%</td>
<td id="S3.T1.fig1.2.7.6" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">2.05</td>
<td id="S3.T1.fig1.2.7.7" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:1pt;padding-bottom:1pt;">4.8%</td>
