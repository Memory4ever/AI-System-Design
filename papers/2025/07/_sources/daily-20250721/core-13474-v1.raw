<td id="S5.T2.fig1.2.7.14" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:1pt 4.0pt;">43%</td></tr>
<tr id="S5.T2.fig1.2.8" class="ltx_tr">
<th id="S5.T2.fig1.2.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding:1pt 4.0pt;">PSA-A(Ours)</th>
<th id="S5.T2.fig1.2.8.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding:1pt 4.0pt;">6</th>
