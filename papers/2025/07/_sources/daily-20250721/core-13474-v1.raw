<td id="S3.T1.fig1.2.7.9" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">0%</td></tr>
<tr id="S3.T1.fig1.2.8" class="ltx_tr">
<th id="S3.T1.fig1.2.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b ltx_border_r" style="padding-top:1pt;padding-bottom:1pt;">LLM Safety</th>
<td id="S3.T1.fig1.2.8.2" class="ltx_td ltx_align_center ltx_border_b" style="padding-top:1pt;padding-bottom:1pt;">3.81</td>
<td id="S3.T1.fig1.2.8.3" class="ltx_td ltx_align_center ltx_border_b ltx_border_r" style="padding-top:1pt;padding-bottom:1pt;">28%</td>
<td id="S3.T1.fig1.2.8.4" class="ltx_td ltx_align_center ltx_border_b" style="padding-top:1pt;padding-bottom:1pt;">4.22</td>
<td id="S3.T1.fig1.2.8.5" class="ltx_td ltx_align_center ltx_border_b ltx_border_r" style="padding-top:1pt;padding-bottom:1pt;">72.9%</td>
<td id="S3.T1.fig1.2.8.6" class="ltx_td ltx_align_center ltx_border_b" style="padding-top:1pt;padding-bottom:1pt;">3.12</td>
