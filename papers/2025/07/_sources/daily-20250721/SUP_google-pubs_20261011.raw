<div class="row-card">
  <div class="row-card__container">
    
    <div class="row-card__body">
        
          <a class="row-card__heading glue-link" href=https://research.google/pubs/impact-of-led-aging-on-optical-health-sensing-signal-integrity/ >
            
              Impact of LED Aging on Optical Health Sensing Signal Integrity
            
          </a>
        
        <div class="row-card__subheading">
          
            
              
                
                  
                    <div class="row-card__subheading__item small-text">
                      
                        <a class="row-card__small-link" href="/people/abhinuvpitale/">
