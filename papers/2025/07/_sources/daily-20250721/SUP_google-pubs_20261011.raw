</div>

        
            












<div class="row-card">
  <div class="row-card__container">
    
    <div class="row-card__body">
        
          <a class="row-card__heading glue-link" href=https://research.google/pubs/confusable-characters-as-endangered-language-markers-the-case-of-north-caucasus-writing-systems/ >
            
