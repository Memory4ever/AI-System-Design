<th id="S3.T2.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">IoU(%)<math id="S3.T2.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></th>
<th id="S3.T2.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">Precision(%)<math id="S3.T2.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></th>
<th id="S3.T2.2.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">Recall(%)<math id="S3.T2.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></th></tr>
