<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E12.m2" class="ltx_Math" alttext="\displaystyle p_{x}(x_{t-1}|x_{t},y_{t})\cdot p_{y}(y_{t-1}|x_{t-1},y_{t})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>p</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>y</mi><mi>t</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>p</mi><mi>y</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>y</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle p_{x}(x_{t-1}|x_{t},y_{t})\cdot p_{y}(y_{t-1}|x_{t-1},y_{t})</annotation></semantics></math></td>
