                  <math id="alg1.l13.m1" class="ltx_Math" alttext="\mathcal{D}=\mathcal{D}\cup\{\bm{s}_{t}^{G_{j}},\{\bm{o}_{t}^{i},z_{t}^{i},\bm{a}_{t}^{i},\bm{\phi}_{t}^{i},r_{L}^{i},\bm{o}_{t+1}^{i}\}_{i\in G^{j}},r_{H}^{G^{j}},\bm{s}_{t+1}^{G_{j}}\}_{\forall j\in\mathcal{N}_{G}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>∪</mo><msub><mrow><mo stretchy="false">{</mo><mrow><msubsup><mi>𝒔</mi><mi>t</mi><msub><mi>G</mi><mi>j</mi></msub></msubsup><mo>,</mo><msub><mrow><mo stretchy="false">{</mo><mrow><msubsup><mi>𝒐</mi><mi>t</mi><mi>i</mi></msubsup><mo>,</mo><msubsup><mi>z</mi><mi>t</mi><mi>i</mi></msubsup><mo>,</mo><msubsup><mi>𝒂</mi><mi>t</mi><mi>i</mi></msubsup><mo>,</mo><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>t</mi><mi>i</mi></msubsup><mo>,</mo><msubsup><mi>r</mi><mi>L</mi><mi>i</mi></msubsup><mo>,</mo><msubsup><mi>𝒐</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mi>i</mi></msubsup></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><msup><mi>G</mi><mi>j</mi></msup></mrow></msub><mo>,</mo><msubsup><mi>r</mi><mi>H</mi><msup><mi>G</mi><mi>j</mi></msup></msubsup><mo>,</mo><msubsup><mi>𝒔</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><msub><mi>G</mi><mi>j</mi></msub></msubsup></mrow><mo stretchy="false">}</mo></mrow><mrow><mrow><mo rspace="0.167em">∀</mo><mi>j</mi></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>G</mi></msub></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\mathcal{D}=\mathcal{D}\cup\{\bm{s}_{t}^{G_{j}},\{\bm{o}_{t}^{i},z_{t}^{i},\bm{a}_{t}^{i},\bm{\phi}_{t}^{i},r_{L}^{i},\bm{o}_{t+1}^{i}\}_{i\in G^{j}},r_{H}^{G^{j}},\bm{s}_{t+1}^{G_{j}}\}_{\forall j\in\mathcal{N}_{G}}</annotation></semantics></math>

</div>
<div id="alg1.l14" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
                
                
                 <span id="alg1.l14.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l14.4" class="ltx_text ltx_font_bold">if</span>
</div>
