<td id="S7.T9.3.1.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;">Benchmark</td>
<td id="S7.T9.3.1.3" class="ltx_td ltx_align_left ltx_border_r ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;">Description</td>
<td id="S7.T9.3.1.4" class="ltx_td ltx_align_left ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;">Metric</td></tr>
