<td id="S5.T1.4.1.7" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T1.4.1.7.1" class="ltx_text ltx_font_bold">Llama3.3</span></td>
<td id="S5.T1.4.1.8" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T1.4.1.8.1" class="ltx_text ltx_font_bold">Qwen3</span></td>
