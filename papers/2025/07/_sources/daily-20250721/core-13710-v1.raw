<th id="S5.T3.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><math id="S5.T3.m1" class="ltx_Math" alttext="P_{\text{LLM}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mtext>LLM</mtext></msub><annotation encoding="application/x-tex">P_{\text{LLM}}</annotation></semantics></math> (w/o LTR)</th>
