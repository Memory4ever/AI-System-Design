<span id="S4.T3.5.1.1.1.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_column">Kernel</span>
<span id="S4.T3.5.1.1.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column">time (sec)</span>
<span id="S4.T3.5.1.1.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column">CLIPScore</span>
<span id="S4.T3.5.1.1.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column">PickScore</span></span>
</span>
<span class="ltx_tbody">
<span id="S4.T3.5.1.1.1.2" class="ltx_tr">
<span id="S4.T3.5.1.1.1.2.1" class="ltx_td ltx_align_center ltx_border_tt">FM</span>
<span id="S4.T3.5.1.1.1.2.2" class="ltx_td ltx_align_center ltx_border_tt" style="--ltx-bg-color:#FF9999;"><span id="S4.T3.5.1.1.1.2.2.1" class="ltx_text" style="--ltx-bg-color:#FF9999;">10.8</span></span>
<span id="S4.T3.5.1.1.1.2.3" class="ltx_td ltx_align_center ltx_border_tt" style="--ltx-bg-color:#CCEBCC;">
<span id="S4.T3.5.1.1.1.2.3.1" class="ltx_text" style="--ltx-bg-color:#CCEBCC;">26.0</span></span>
<span id="S4.T3.5.1.1.1.2.4" class="ltx_td ltx_align_center ltx_border_tt" style="--ltx-bg-color:#CCEBCC;">
<span id="S4.T3.5.1.1.1.2.4.1" class="ltx_text" style="--ltx-bg-color:#CCEBCC;">21.0</span></span></span>
