<tr id="S4.T1.7.1.4" class="ltx_tr">
<th id="S4.T1.7.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:1pt 4.0pt;">MAR-Fluid</th>
<th id="S4.T1.7.1.4.2" class="ltx_td ltx_align_center ltx_th ltx_th_row" style="padding:1pt 4.0pt;">DiT</th>
