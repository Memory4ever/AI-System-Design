<span id="S4.T3.5.1.1.1.3.1" class="ltx_td ltx_align_center">DTM</span>
<span id="S4.T3.5.1.1.1.3.2" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FFD8D8;"><span id="S4.T3.5.1.1.1.3.2.1" class="ltx_text" style="--ltx-bg-color:#FFD8D8;">1.6</span></span>
<span id="S4.T3.5.1.1.1.3.3" class="ltx_td ltx_align_center" style="--ltx-bg-color:#99D699;">
