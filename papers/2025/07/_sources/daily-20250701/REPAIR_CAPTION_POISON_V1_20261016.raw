<td id="S5.T4.2.1.7.3" class="ltx_td ltx_align_center ltx_border_bb">0.85 <math id="S5.T4.m12" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.02</td></tr>
