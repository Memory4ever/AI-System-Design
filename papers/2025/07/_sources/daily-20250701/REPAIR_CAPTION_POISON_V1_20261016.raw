<td id="S5.T4.2.1.3.3" class="ltx_td ltx_align_center">0.83 <math id="S5.T4.m4" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.02</td></tr>
<tr id="S5.T4.2.1.4" class="ltx_tr">
<td id="S5.T4.2.1.4.1" class="ltx_td ltx_align_center">CogVLM</td>
<td id="S5.T4.2.1.4.2" class="ltx_td ltx_align_center"><span id="S5.T4.2.1.4.2.1" class="ltx_text ltx_font_bold">0.88 <math id="S5.T4.m5" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.02</span></td>
<td id="S5.T4.2.1.4.3" class="ltx_td ltx_align_center">0.87 <math id="S5.T4.m6" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.02</td></tr>
