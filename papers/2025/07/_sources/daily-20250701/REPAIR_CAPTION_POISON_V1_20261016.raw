</tbody>
</table>
</span></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 2. </span>Adversarial images achieve high mislabeling success (MSR) across datasets and VLM architectures without revealing original concepts.</figcaption>
</figure>
<figure id="S5.T3" class="ltx_table">
<div id="S5.T3.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:144.9pt;height:51.8pt;vertical-align:-24.7pt;"><span class="ltx_transformed_inner" style="transform:translate(-80.1pt,28.7pt) scale(0.474885437146644,0.474885437146644) ;">
<table id="S5.T3.2.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S5.T3.2.1.1" class="ltx_tr">
<th id="S5.T3.2.1.1.1" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt"><span id="S5.T3.2.1.1.1.1" class="ltx_text ltx_font_bold">Prompt</span></th>
<th id="S5.T3.2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T3.2.1.1.2.1" class="ltx_text ltx_font_bold">AAR (<math id="S5.T3.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>)</span></th>
<th id="S5.T3.2.1.1.3" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T3.2.1.1.3.1" class="ltx_text ltx_font_bold">BAR (<math id="S5.T3.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math>)</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T3.2.1.2" class="ltx_tr">
