<td id="S5.T5.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T5.2.1.2.2.1" class="ltx_text ltx_font_bold">0.95</span></td>
<td id="S5.T5.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t">0.85</td></tr>
