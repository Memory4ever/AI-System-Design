<td id="S5.T4.2.1.6.3" class="ltx_td ltx_align_center">0.92 <math id="S5.T4.m10" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.02</td></tr>
<tr id="S5.T4.2.1.7" class="ltx_tr">
