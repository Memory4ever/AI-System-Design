<th id="S3.T1.2.1.5.2" class="ltx_td ltx_align_center ltx_th ltx_th_row">OpenAI</th>
<th id="S3.T1.2.1.5.3" class="ltx_td ltx_align_center ltx_th ltx_th_row">8/2023</th>
<td id="S3.T1.2.1.5.4" class="ltx_td ltx_align_center"><span id="S3.T1.2.1.5.4.1" class="ltx_text" style="--ltx-fg-color:#00FF00;">✔</span></td>
<td id="S3.T1.2.1.5.5" class="ltx_td ltx_align_center"><span id="S3.T1.2.1.5.5.1" class="ltx_text" style="--ltx-fg-color:#00FF00;">✔</span></td>
<td id="S3.T1.2.1.5.6" class="ltx_td ltx_align_center"><span id="S3.T1.2.1.5.6.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">✗</span></td></tr>
<tr id="S3.T1.2.1.6" class="ltx_tr">
<th id="S3.T1.2.1.6.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">PixArt-<math id="S3.T1.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib13" title="" class="ltx_ref">Chen et al., 2024b</a>)</cite></th>
<th id="S3.T1.2.1.6.2" class="ltx_td ltx_align_center ltx_th ltx_th_row">Huawei</th>
<th id="S3.T1.2.1.6.3" class="ltx_td ltx_align_center ltx_th ltx_th_row">9/2023</th>
<td id="S3.T1.2.1.6.4" class="ltx_td ltx_align_center"><span id="S3.T1.2.1.6.4.1" class="ltx_text" style="--ltx-fg-color:#00FF00;">✔</span></td>
<td id="S3.T1.2.1.6.5" class="ltx_td ltx_align_center"><span id="S3.T1.2.1.6.5.1" class="ltx_text" style="--ltx-fg-color:#00FF00;">✔</span></td>
<td id="S3.T1.2.1.6.6" class="ltx_td ltx_align_center"><span id="S3.T1.2.1.6.6.1" class="ltx_text" style="--ltx-fg-color:#00FF00;">✔</span></td></tr>
<tr id="S3.T1.2.1.7" class="ltx_tr">
<th id="S3.T1.2.1.7.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">Kolors <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib73" title="" class="ltx_ref">Team, 2024</a>)</cite></th>
