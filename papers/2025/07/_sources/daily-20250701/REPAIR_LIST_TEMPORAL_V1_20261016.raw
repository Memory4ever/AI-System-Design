<span id="S3.T2.5.1.1.1.1.1" class="ltx_p ltx_align_center"><span id="S3.T2.5.1.1.1.1.1.1" class="ltx_text ltx_font_bold">Relation ID</span></span>
</span></th>
<th id="S3.T2.5.1.1.2" class="ltx_td ltx_align_left ltx_align_middle ltx_th ltx_th_column ltx_border_tt">
<span id="S3.T2.5.1.1.2.1" class="ltx_inline-block ltx_align_middle" style="width:51.7pt;">
<span id="S3.T2.5.1.1.2.1.1" class="ltx_p ltx_align_center"><span id="S3.T2.5.1.1.2.1.1.1" class="ltx_text ltx_font_bold">Infobox Type</span></span>
</span></th>
