<td id="S3.T3.5.3.2" class="ltx_td ltx_align_center"><span id="S3.T3.5.3.2.1" class="ltx_text" style="font-size:90%;">251</span></td>
<td id="S3.T3.5.3.3" class="ltx_td ltx_align_center"><span id="S3.T3.5.3.3.1" class="ltx_text" style="font-size:90%;">5.438</span></td></tr>
