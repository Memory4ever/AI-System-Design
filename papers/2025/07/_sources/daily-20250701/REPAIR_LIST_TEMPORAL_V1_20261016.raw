<span id="S3.T2.5.1.3.1.1.1" class="ltx_p ltx_align_center">P39</span>
</span></td>
<td id="S3.T2.5.1.3.2" class="ltx_td ltx_align_left ltx_align_middle ltx_border_bb ltx_border_t">
<span id="S3.T2.5.1.3.2.1" class="ltx_inline-block ltx_align_middle" style="width:51.7pt;">
