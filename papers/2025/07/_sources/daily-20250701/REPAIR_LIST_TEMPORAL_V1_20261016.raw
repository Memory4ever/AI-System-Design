<td id="S3.T3.5.4.3" class="ltx_td ltx_align_center"><span id="S3.T3.5.4.3.1" class="ltx_text" style="font-size:90%;">5.463</span></td></tr>
<tr id="S3.T3.5.5" class="ltx_tr">
<td id="S3.T3.5.5.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t" rowspan="3"><span id="S3.T3.5.5.1.1" class="ltx_text" style="font-size:90%;">Sports</span></td>
