--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.7071 0.7071 -0.7071 0.7071 144.48 -36.91)"><foreignObject style="--ltx-fo-width:3.58em;--ltx-fo-height:0.51em;--ltx-fo-depth:0.14em;font-size:6.81pt;" height="6.15" overflow="visible" transform="matrix(1 0 0 -1 0 4.8)" width="33.74"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F3.pic1.4" class="ltx_text" style="font-size:50%;">Military</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.7071 0.7071 -0.7071 0.7071 197.03 -38.33)"><foreignObject style="--ltx-fo-width:3.8em;--ltx-fo-height:0.51em;--ltx-fo-depth:0em;font-size:6.81pt;" height="4.8" overflow="visible" transform="matrix(1 0 0 -1 0 4.8)" width="35.75"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F3.pic1.5" class="ltx_text" style="font-size:50%;">Cardinal</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.7071 0.7071 -0.7071 0.7071 249.88 -38.06)"><foreignObject style="--ltx-fo-width:3.79em;--ltx-fo-height:0.5em;--ltx-fo-depth:0em;font-size:6.81pt;" height="4.7" overflow="visible" transform="matrix(1 0 0 -1 0 4.7)" width="35.7"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F3.pic1.6" class="ltx_text" style="font-size:50%;">Scientist</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.7071 0.7071 -0.7071 0.7071 306.74 -30.04)"><foreignObject style="--ltx-fo-width:2.55em;--ltx-fo-height:0.51em;--ltx-fo-depth:0em;font-size:6.81pt;" height="4.8" overflow="visible" transform="matrix(1 0 0 -1 0 4.8)" width="24.02"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F3.pic1.7" class="ltx_text" style="font-size:50%;">Other</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -33.98 -2.23)"><foreignObject style="--ltx-fo-width:0.66em;--ltx-fo-height:0.56em;--ltx-fo-depth:0em;font-size:5.75pt;" height="4.46" overflow="visible" transform="matrix(1 0 0 -1 0 4.46)" width="5.25"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F3.pic1.m1" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn mathsize="0.500em">𝟎</mn><annotation encoding="application/x-tex">0</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -44.47 40.72)"><foreignObject style="--ltx-fo-width:1.98em;--ltx-fo-height:0.56em;--ltx-fo-depth:0em;font-size:5.75pt;" height="4.46" overflow="visible" transform="matrix(1 0 0 -1 0 4.46)" width="15.74"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F3.pic1.m2" class="ltx_Math" alttext="500" display="inline" intent=":literal"><semantics><mn mathsize="0.500em">𝟓𝟎𝟎</mn><annotation encoding="application/x-tex">500</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -52.74 84.35)"><foreignObject style="--ltx-fo-width:3.02em;--ltx-fo-height:0.56em;--ltx-fo-depth:0.17em;font-size:5.75pt;" height="5.8" overflow="visible" transform="matrix(1 0 0 -1 0 4.46)" width="24"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F3.pic1.m3" class="ltx_Math" alttext="1{,}000" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_bold" mathsize="0.500em" mathvariant="bold">1,000</mn><annotation encoding="application/x-tex">1{,}000</annotation></semantics></math></span></span></foreignObject></g><clipPath id="pgfcp1"><path d="M -25.34 0 L 342.03 0 L 342.03 103.09 L -25.34 103.09 Z"></path></clipPath><g clip-path="url(#pgfcp1)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#B3B3FF;" fill="#B3B3FF" stroke="#000000"><path d="M -6.6 0 h 13.2 v 91.49 h -13.2 Z M 46.18 0 h 13.2 v 4.98 h -13.2 Z M 98.97 0 h 13.2 v 1.63 h -13.2 Z M 151.75 0 h 13.2 v 1.37 h -13.2 Z M 204.53 0 h 13.2 v 1.03 h -13.2 Z M 257.31 0 h 13.2 v 0.86 h -13.2 Z M 310.09 0 h 13.2 v 11.68 h -13.2 Z"></path><defs><pattern height="4" id="pgfpat3" patternUnits="userSpaceOnUse" width="4"><symbol id="pgfsym3"><g stroke-width="0.4pt"><path style="fill:none" d="M 0 0 L 4.29 4.29"></path></g><g></g><defs><pattern id="pgfupat2" href="#pgfpat3"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000"><use href="#pgfsym3"></use></g></pattern></defs><g style="--ltx-fill-color:#B3B3FF;" fill="#B3B3FF"><path d="M -6.6 0 h 13.2 v 91.49 h -13.2 Z M 46.18 0 h 13.2 v 4.98 h -13.2 Z M 98.97 0 h 13.2 v 1.63 h -13.2 Z M 151.75 0 h 13.2 v 1.37 h -13.2 Z M 204.53 0 h 13.2 v 1.03 h -13.2 Z M 257.31 0 h 13.2 v 0.86 h -13.2 Z M 310.09 0 h 13.2 v 11.68 h -13.2 Z"></path></g><g style="--ltx-fill-color:url(#pgfupat2);" fill="url(#pgfupat2)"></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 132.06 -54.55)"><foreignObject style="--ltx-fo-width:5.58em;--ltx-fo-height:0.51em;--ltx-fo-depth:0.14em;font-size:6.81pt;" height="6.15" overflow="visible" transform="matrix(1 0 0 -1 0 4.8)" width="52.57"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F3.pic1.8" class="ltx_text" style="font-size:50%;">Infobox type</span></span></span></foreignObject></g><g></g><g style="--ltx-stroke-color:#00