<span id="S4.T5.14.7.1.1.1" class="ltx_p ltx_align_left"><span id="S4.T5.14.7.1.1.1.1" class="ltx_text" style="font-size:90%;">Auto COT</span></span>
</span></td>
<td id="S4.T5.14.7.2" class="ltx_td ltx_align_left ltx_align_top">
<span id="S4.T5.14.7.2.1" class="ltx_inline-block ltx_align_top" style="width:56.9pt;">
<span id="S4.T5.14.7.2.1.1" class="ltx_p ltx_align_left"><span id="S4.T5.14.7.2.1.1.1" class="ltx_text" style="font-size:90%;">0.523</span></span>
</span></td>
