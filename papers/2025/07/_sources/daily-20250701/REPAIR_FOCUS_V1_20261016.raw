<tr id="S4.T3.1.1.4" class="ltx_tr">
<td id="S4.T3.1.1.4.1" class="ltx_td ltx_align_center"><span id="S4.T3.1.1.4.1.1" class="ltx_text" style="font-size:80%;">✓</span></td>
<td id="S4.T3.1.1.4.2" class="ltx_td ltx_align_center"><span id="S4.T3.1.1.4.2.1" class="ltx_text" style="font-size:80%;">✗</span></td>
<td id="S4.T3.1.1.4.3" class="ltx_td ltx_align_center"><span id="S4.T3.1.1.4.3.1" class="ltx_text" style="font-size:80%;">51.30</span></td>
<td id="S4.T3.1.1.4.4" class="ltx_td ltx_align_center"><span id="S4.T3.1.1.4.4.1" class="ltx_text" style="font-size:80%;">38.48</span></td>
<td id="S4.T3.1.1.4.5" class="ltx_td ltx_align_center"><span id="S4.T3.1.1.4.5.1" class="ltx_text" style="font-size:80%;">41.13</span></td></tr>
<tr id="S4.T3.1.1.5" class="ltx_tr">
<td id="S4.T3.1.1.5.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T3.1.1.5.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Pseudo-attn.</span></td>
