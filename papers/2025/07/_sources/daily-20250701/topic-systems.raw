        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.09034">pdf</a>, <a href="https://arxiv.org/ps/2506.09034">ps</a>, <a href="https://arxiv.org/format/2506.09034">other</a>]&nbsp;</span>
