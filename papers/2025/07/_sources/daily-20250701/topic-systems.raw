  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2506.12446">arXiv:2506.12446</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.12446">pdf</a>, <a href="https://arxiv.org/ps/2506.12446">ps</a>, <a href="https://arxiv.org/format/2506.12446">other</a>]&nbsp;</span>
