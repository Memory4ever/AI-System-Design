<td id="S3.T1.3.21.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.3pt;padding-right:2.3pt;"><span id="S3.T1.3.21.3.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#EFEFEF;">5%</span></td>
