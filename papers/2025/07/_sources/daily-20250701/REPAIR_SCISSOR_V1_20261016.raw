<td id="S3.T1.3.20.12" class="ltx_td ltx_align_center" style="padding-left:2.3pt;padding-right:2.3pt;"><span id="S3.T1.3.20.12.1" class="ltx_text ltx_underline" style="font-size:90%;--ltx-bg-color:#EFEFEF;">79.11</span></td>
<td id="S3.T1.3.20.13" class="ltx_td ltx_align_center" style="padding-left:2.3pt;padding-right:2.3pt;"><span id="S3.T1.3.20.13.1" class="ltx_text ltx_underline" style="font-size:90%;--ltx-bg-color:#EFEFEF;">95.8%</span></td></tr>
