<td id="S3.T1.3.20.9" class="ltx_td ltx_align_center" style="padding-left:2.3pt;padding-right:2.3pt;"><span id="S3.T1.3.20.9.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#EFEFEF;">2.82</span></td>
<td id="S3.T1.3.20.10" class="ltx_td ltx_align_center" style="padding-left:2.3pt;padding-right:2.3pt;"><span id="S3.T1.3.20.10.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#EFEFEF;">2.51</span></td>
