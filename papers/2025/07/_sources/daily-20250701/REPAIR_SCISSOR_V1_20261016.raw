</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S4.F3.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2506.21862v1/imgs/statistics/threshold_low.png" id="S4.F3.sf2.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:476/470;" width="476" height="470" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S4.F3.sf2.3" class="ltx_text" style="font-size:90%;">(b)</span> </span><span id="S4.F3.sf2.4" class="ltx_text" style="font-size:90%;">Impact of <math id="S4.F3.sf2.m2" class="ltx_Math" alttext="\tau\in[0.8,0.89]" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0.8</mn><mo>,</mo><mn>0.89</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\tau\in[0.8,0.89]</annotation></semantics></math> </span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S4.F3.sf3" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2506.21862v1/imgs/statistics/error_tolerance_1.png" id="S4.F3.sf3.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:476/471;" width="476" height="471" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S4.F3.sf3.3" class="ltx_text" style="font-size:90%;">(c)</span> </span><span id="S4.F3.sf3.4" class="ltx_text" style="font-size:90%;">Impact of <math id="S4.F3.sf3.m2" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math></span></figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S4.F3.3" class="ltx_text" style="font-size:90%;">Figure 3</span>: </span><span id="S4.F3.4" class="ltx_text" style="font-size:90%;">Token number statistics of similarity threshold <math id="S4.F3.m3" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> and error tolerance <math id="S4.F3.m4" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>.</span></figcaption>
</figure>
