<td id="S3.T1.3.20.4" class="ltx_td ltx_align_center" style="padding-left:2.3pt;padding-right:2.3pt;"><span id="S3.T1.3.20.4.1" class="ltx_text ltx_underline" style="font-size:90%;--ltx-bg-color:#EFEFEF;">46.25</span></td>
