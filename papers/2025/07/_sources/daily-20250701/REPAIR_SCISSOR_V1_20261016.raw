            <math id="alg2.l7.m1" class="ltx_Math" alttext="\texttt{sampled\_nodes}\leftarrow\texttt{random.sample}(\{1,2,...,n\},\texttt{sample\_size})" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">sampled_nodes</mtext><mo stretchy="false">←</mo><mrow><mtext class="ltx_mathvariant_monospace">random.sample</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi></mrow><mo stretchy="false">}</mo></mrow><mo>,</mo><mtext class="ltx_mathvariant_monospace">sample_size</mtext><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\texttt{sampled\_nodes}\leftarrow\texttt{random.sample}(\{1,2,...,n\},\texttt{sample\_size})</annotation></semantics></math>

</div>
<div id="alg2.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
              
              
            Set <math id="alg2.l8.m1" class="ltx_Math" alttext="\texttt{nodes\_flag}[i]=0" display="inline" intent=":literal"><semantics><mrow><mrow><mtext class="ltx_mathvariant_monospace">nodes_flag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\texttt{nodes\_flag}[i]=0</annotation></semantics></math> for all <math id="alg2.l8.m2" class="ltx_Math" alttext="i\in\texttt{sampled\_nodes}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mtext class="ltx_mathvariant_monospace">sampled_nodes</mtext></mrow><annotation encoding="application/x-tex">i\in\texttt{sampled\_nodes}</annotation></semantics></math>

</div>
