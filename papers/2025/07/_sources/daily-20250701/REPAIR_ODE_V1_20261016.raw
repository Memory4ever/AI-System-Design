<td id="A1.T7.4.13.2" class="ltx_td ltx_align_center" colspan="3">90% const. with 5,000 iter. warmup <math id="A1.T7.m14" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> 10% cosine decay</td></tr>
<tr id="A1.T7.4.14" class="ltx_tr">
<th id="A1.T7.4.14.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Optimizer</th>
<td id="A1.T7.4.14.2" class="ltx_td ltx_align_center" colspan="3">AdamW with <math id="A1.T7.m15" class="ltx_Math" alttext="\beta_{1}=0.9" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>=</mo><mn>0.9</mn></mrow><annotation encoding="application/x-tex">\beta_{1}=0.9</annotation></semantics></math>, <math id="A1.T7.m16" class="ltx_Math" alttext="\beta_{2}=0.999" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>2</mn></msub><mo>=</mo><mn>0.999</mn></mrow><annotation encoding="application/x-tex">\beta_{2}=0.999</annotation></semantics></math> and weight decay <math id="A1.T7.m17" class="ltx_Math" alttext="=0.1" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mn>0.1</mn></mrow><annotation encoding="application/x-tex">=0.1</annotation></semantics></math></td></tr>
<tr id="A1.T7.4.15" class="ltx_tr">
<th id="A1.T7.4.15.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">EMA ratio</th>
<td id="A1.T7.4.15.2" class="ltx_td ltx_align_center" colspan="3">0.999</td></tr>
<tr id="A1.T7.4.16" class="ltx_tr">
<th id="A1.T7.4.16.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Class. free guid.</th>
<td id="A1.T7.4.16.2" class="ltx_td ltx_align_center">0</td>
<td id="A1.T7.4.16.3" class="ltx_td ltx_align_center">1.5</td>
<td id="A1.T7.4.16.4" class="ltx_td ltx_align_center">1.5</td></tr>
<tr id="A1.T7.4.17" class="ltx_tr">
<th id="A1.T7.4.17.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">GPUs</th>
<td id="A1.T7.4.17.2" class="ltx_td ltx_align_center"><math id="A1.T7.m18" class="ltx_math_unparsed" alttext="4\times" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">4\times</annotation></semantics></math>A6000</td>
<td id="A1.T7.4.17.3" class="ltx_td ltx_align_center"><math id="A1.T7.m19" class="ltx_math_unparsed" alttext="8\times" display="inline" intent=":literal"><semantics><mrow><mn>8</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">8\times</annotation></semantics></math>A6000</td>
<td id="A1.T7.4.17.4" class="ltx_td ltx_align_center"><math id="A1.T7.m20" class="ltx_math_unparsed" alttext="8\times" display="inline" intent=":literal"><semantics><mrow><mn>8</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">8\times</annotation></semantics></math>H100</td></tr>
<tr id="A1.T7.4.18" class="ltx_tr">
<th id="A1.T7.4.18.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Generation</th>
<td id="A1.T7.4.18.2" class="ltx_td ltx_align_center ltx_border_t">uncond.</td>
<td id="A1.T7.4.18.3" class="ltx_td ltx_align_center ltx_border_t">class-cond.</td>
<td id="A1.T7.4.18.4" class="ltx_td ltx_align_center ltx_border_t">class-cond.</td></tr>
<tr id="A1.T7.4.19" class="ltx_tr">
<th id="A1.T7.4.19.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Classes</th>
<td id="A1.T7.4.19.2" class="ltx_td ltx_align_center">1</td>
<td id="A1.T7.4.19.3" class="ltx_td ltx_align_center">1000</td>
<td id="A1.T7.4.19.4" class="ltx_td ltx_align_center">1000</td></tr>
<tr id="A1.T7.4.20" class="ltx_tr">
<th id="A1.T7.4.20.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T7.m21" class="ltx_Math" alttext="\textrm{ODE}_{l}" display="inline" intent=":literal"><semantics><msub><mtext>ODE</mtext><mi>l</mi></msub><annotation encoding="application/x-tex">\textrm{ODE}_{l}</annotation></semantics></math> solver</th>
<td id="A1.T7.4.20.2" class="ltx_td ltx_align_center" colspan="3">Euler by the neural network</td></tr>
<tr id="A1.T7.4.21" class="ltx_tr">
<th id="A1.T7.4.21.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T7.m22" class="ltx_Math" alttext="\textrm{ODE}_{t}" display="inline" intent=":literal"><semantics><msub><mtext>ODE</mtext><mi>t</mi></msub><annotation encoding="application/x-tex">\textrm{ODE}_{t}</annotation></semantics></math> solver</th>
<td id="A1.T7.4.21.2" class="ltx_td ltx_align_center">Euler/Dopri5</td>
<td id="A1.T7.4.21.3" class="ltx_td ltx_align_center">Euler</td>
<td id="A1.T7.4.21.4" class="ltx_td ltx_align_center">Euler</td></tr>
<tr id="A1.T7.4.22" class="ltx_tr">
<th id="A1.T7.4.22.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">EMA weights</th>
<td id="A1.T7.4.22.2" class="ltx_td ltx_align_center ltx_border_bb">✓</td>
<td id="A1.T7.4.22.3" class="ltx_td ltx_align_center ltx_border_bb">✓</td>
<td id="A1.T7.4.22.4" class="ltx_td ltx_align_center ltx_border_bb">✓</td></tr>
