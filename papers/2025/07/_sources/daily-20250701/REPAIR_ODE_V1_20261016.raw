</thead>
<tbody class="ltx_tbody">
<tr id="S5.T2.4.1.4" class="ltx_tr">
<th id="S5.T2.4.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">DM <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib18" title="" class="ltx_ref">18</a>]</cite></th>
<th id="S5.T2.4.1.4.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t">1</th>
<td id="S5.T2.4.1.4.3" class="ltx_td ltx_align_center ltx_border_t">23.0</td>
<td id="S5.T2.4.1.4.4" class="ltx_td ltx_align_center ltx_border_t">(123)</td>
