<td id="S4.T2.3.1.8.6" class="ltx_td ltx_align_center"><math id="S4.T2.m40" class="ltx_Math" alttext="\textbf{0.35}{\scriptstyle\pm 0.017}" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_bold">0.35</mtext><mo mathsize="0.700em">±</mo><mn mathsize="0.700em">0.017</mn></mrow><annotation encoding="application/x-tex">\textbf{0.35}{\scriptstyle\pm 0.017}</annotation></semantics></math></td>
<td id="S4.T2.3.1.8.7" class="ltx_td ltx_align_center"><math id="S4.T2.m41" class="ltx_Math" alttext="\textbf{0.80}{\scriptstyle\pm 0.003}" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_bold">0.80</mtext><mo mathsize="0.700em">±</mo><mn mathsize="0.700em">0.003</mn></mrow><annotation encoding="application/x-tex">\textbf{0.80}{\scriptstyle\pm 0.003}</annotation></semantics></math></td>
<td id="S4.T2.3.1.8.8" class="ltx_td ltx_align_left"><math id="S4.T2.m42" class="ltx_Math" alttext="\textbf{0.57}{\scriptstyle\pm 0.004}" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_bold">0.57</mtext><mo mathsize="0.700em">±</mo><mn mathsize="0.700em">0.004</mn></mrow><annotation encoding="application/x-tex">\textbf{0.57}{\scriptstyle\pm 0.004}</annotation></semantics></math></td></tr>
