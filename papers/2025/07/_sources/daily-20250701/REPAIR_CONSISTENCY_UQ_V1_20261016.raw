</div>
<div id="alg1.l12" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
            
            
            <span id="alg1.l12.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l12.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l13" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
            
            
            Compute <math id="alg1.l13.m1" class="ltx_Math" alttext="\rho_{r}(n_{g})\leftarrow\frac{n_{v}}{n_{g}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ρ</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>n</mi><mi>g</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mfrac><msub><mi>n</mi><mi>v</mi></msub><msub><mi>n</mi><mi>g</mi></msub></mfrac></mrow><annotation encoding="application/x-tex">\rho_{r}(n_{g})\leftarrow\frac{n_{v}}{n_{g}}</annotation></semantics></math>

</div>
<div id="alg1.l14" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
            
            
          <span id="alg1.l14.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l14.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l15" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
            
            
          Compute <math id="alg1.l15.m1" class="ltx_Math" alttext="\rho(n_{g})\leftarrow\frac{1}{R}\sum_{r=1}^{R}\rho_{r}(n_{g})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>n</mi><mi>g</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mfrac><mn>1</mn><mi>R</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>R</mi></msubsup><mrow><msub><mi>ρ</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>n</mi><mi>g</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho(n_{g})\leftarrow\frac{1}{R}\sum_{r=1}^{R}\rho_{r}(n_{g})</annotation></semantics></math>

</div>
<div id="alg1.l16" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
            
            
          Compute the error bar of <math id="alg1.l16.m1" class="ltx_Math" alttext="\rho(n_{g})" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>n</mi><mi>g</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho(n_{g})</annotation></semantics></math> as the variance

</div>
<div id="alg1.l17" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l17.1" class="ltx_text" style="font-size:80%;">17:</span></span>
            
            
          <span id="alg1.l17.3" class="ltx_text ltx_font_bold">Output:</span> <math id="alg1.l17.m1" class="ltx_Math" alttext="\rho(n_{g})" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>n</mi><mi>g</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho(n_{g})</annotation></semantics></math> with the error bar

</div>
</div>
</figure>
