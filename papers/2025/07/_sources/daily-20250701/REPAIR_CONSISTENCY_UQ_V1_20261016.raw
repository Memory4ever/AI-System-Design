<td id="S4.T2.3.1.9.1" class="ltx_td ltx_border_bb"></td>
<td id="S4.T2.3.1.9.2" class="ltx_td ltx_align_left ltx_border_bb">harm-agg</td>
<td id="S4.T2.3.1.9.3" class="ltx_td ltx_align_center ltx_border_bb"><math id="S4.T2.m43" class="ltx_Math" alttext="\textbf{0.85}{\scriptstyle\pm 0.008}" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_bold">0.85</mtext><mo mathsize="0.700em">±</mo><mn mathsize="0.700em">0.008</mn></mrow><annotation encoding="application/x-tex">\textbf{0.85}{\scriptstyle\pm 0.008}</annotation></semantics></math></td>
<td id="S4.T2.3.1.9.4" class="ltx_td ltx_align_center ltx_border_bb"><math id="S4.T2.m44" class="ltx_Math" alttext="\textbf{0.83}{\scriptstyle\pm 0.008}" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_bold">0.83</mtext><mo mathsize="0.700em">±</mo><mn mathsize="0.700em">0.008</mn></mrow><annotation encoding="application/x-tex">\textbf{0.83}{\scriptstyle\pm 0.008}</annotation></semantics></math></td>
