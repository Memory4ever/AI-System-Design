<tr id="S4.F6.3.3" class="ltx_tr">
<td id="S4.F6.3.3.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:-1.4pt;padding-right:-1.4pt;"><span id="S4.F6.3.3.1.1" class="ltx_text" style="font-size:80%;">(a) Hypo 1 (Sim-Any)</span></td>
<td id="S4.F6.3.3.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:-1.4pt;padding-right:-1.4pt;"><span id="S4.F6.3.3.2.1" class="ltx_text" style="font-size:80%;">(b) Hypo 2 (Sim-Correct)</span></td>
