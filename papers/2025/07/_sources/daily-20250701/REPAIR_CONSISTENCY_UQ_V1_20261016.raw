<td id="S4.T2.3.1.8.4" class="ltx_td ltx_align_center"><math id="S4.T2.m38" class="ltx_Math" alttext="\textbf{0.83}{\scriptstyle\pm 0.007}" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_bold">0.83</mtext><mo mathsize="0.700em">±</mo><mn mathsize="0.700em">0.007</mn></mrow><annotation encoding="application/x-tex">\textbf{0.83}{\scriptstyle\pm 0.007}</annotation></semantics></math></td>
