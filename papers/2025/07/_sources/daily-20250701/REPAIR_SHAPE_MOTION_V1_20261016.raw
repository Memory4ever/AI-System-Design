<td id="A4.T5.2.1.2.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">12.2</td>
<td id="A4.T5.2.1.2.6" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">91.4</td></tr>
