</span>
</div>
<div id="alg1.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
              
              
            <span id="alg1.l9.3" class="ltx_text" style="font-size:90%;">  </span><math id="alg1.l9.m1" class="ltx_Math" alttext="M[TE]" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">M</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mrow><mi mathsize="0.900em">T</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">E</mi></mrow><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><annotation encoding="application/x-tex">M[TE]</annotation></semantics></math><span id="alg1.l9.4" class="ltx_text" style="font-size:90%;"> = </span><math id="alg1.l9.m2" class="ltx_Math" alttext="M[TE](D^{T})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mrow><mi mathsize="0.900em">T</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">E</mi></mrow><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mi mathsize="0.900em">D</mi><mi mathsize="0.900em">T</mi></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">M[TE](D^{T})</annotation></semantics></math><span id="alg1.l9.5" class="ltx_text" style="font-size:90%;">   # The text expert undergoes specialized training on </span><math id="alg1.l9.m3" class="ltx_Math" alttext="D^{T}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.900em">D</mi><mi mathsize="0.900em">T</mi></msup><annotation encoding="application/x-tex">D^{T}</annotation></semantics></math><span id="alg1.l9.6" class="ltx_text" style="font-size:90%;">.
</span>
</div>
<div id="alg1.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
              
              
            <span id="alg1.l10.3" class="ltx_text" style="font-size:90%;"> </span><span id="alg1.l10.4" class="ltx_text ltx_font_bold" style="font-size:90%;">Stpe 3.</span><span id="alg1.l10.5" class="ltx_text" style="font-size:90%;"> Joint training of multi-modality experts
</span>
</div>
<div id="alg1.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
              
              
            <span id="alg1.l11.3" class="ltx_text" style="font-size:90%;">  </span><math id="alg1.l11.m1" class="ltx_Math" alttext="M^{\prime}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.900em">M</mi><mo mathsize="0.900em">′</mo></msup><annotation encoding="application/x-tex">M^{\prime}</annotation></semantics></math><span id="alg1.l11.4" class="ltx_text" style="font-size:90%;"> = </span><math id="alg1.l11.m2" class="ltx_Math" alttext="M(D^{A}\cup D^{T})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">M</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><msup><mi mathsize="0.900em">D</mi><mi mathsize="0.900em">A</mi></msup><mo mathsize="0.900em">∪</mo><msup><mi mathsize="0.900em">D</mi><mi mathsize="0.900em">T</mi></msup></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">M(D^{A}\cup D^{T})</annotation></semantics></math><span id="alg1.l11.5" class="ltx_text" style="font-size:90%;">
