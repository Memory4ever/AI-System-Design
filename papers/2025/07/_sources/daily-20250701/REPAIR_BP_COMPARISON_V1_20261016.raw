</table></th>
<th id="S4.T3.15.1.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:0.9pt;padding-right:0.9pt;">
<table id="S4.T3.15.1.4.1" class="ltx_tabular ltx_align_middle">
