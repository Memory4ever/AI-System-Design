<th id="S4.T3.15.2.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_t" style="padding-left:0.9pt;padding-right:0.9pt;"><span id="S4.T3.15.2.1.1" class="ltx_text ltx_font_smallcaps" style="font-size:80%;">BP-Checkpointing</span></th>
<th id="S4.T3.15.2.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:0.9pt;padding-right:0.9pt;"><span id="S4.T3.15.2.2.1" class="ltx_text" style="font-size:80%;">434.4</span></th>
<th id="S4.T3.15.2.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:0.9pt;padding-right:0.9pt;"><span id="S4.T3.15.2.3.1" class="ltx_text" style="font-size:80%;">65.2 <math id="S4.T3.m3" class="ltx_Math" alttext="\times 10^{4}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mn>4</mn></msup></mrow><annotation encoding="application/x-tex">\times 10^{4}</annotation></semantics></math></span></th>
<th id="S4.T3.15.2.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:0.9pt;padding-right:0.9pt;"><span id="S4.T3.15.2.4.1" class="ltx_text" style="font-size:80%;">1.5<math id="S4.T3.m4" class="ltx_Math" alttext="\times 10^{3}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">\times 10^{3}</annotation></semantics></math></span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T3.15.3" class="ltx_tr">
<th id="S4.T3.15.3.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:0.9pt;padding-right:0.9pt;"><span id="S4.T3.15.3.1.1" class="ltx_text ltx_font_smallcaps" style="font-size:80%;">ZO-Vanilla</span></th>
<td id="S4.T3.15.3.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:0.9pt;padding-right:0.9pt;"><span id="S4.T3.15.3.2.1" class="ltx_text" style="font-size:80%;">288.7</span></td>
<td id="S4.T3.15.3.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:0.9pt;padding-right:0.9pt;"><span id="S4.T3.15.3.3.1" class="ltx_text" style="font-size:80%;">251.2 <math id="S4.T3.m5" class="ltx_Math" alttext="\times 10^{4}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mn>4</mn></msup></mrow><annotation encoding="application/x-tex">\times 10^{4}</annotation></semantics></math></span></td>
<td id="S4.T3.15.3.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:0.9pt;padding-right:0.9pt;"><span id="S4.T3.15.3.4.1" class="ltx_text" style="font-size:80%;">8.7 <math id="S4.T3.m6" class="ltx_Math" alttext="\times 10^{3}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">\times 10^{3}</annotation></semantics></math></span></td></tr>
<tr id="S4.T3.15.4" class="ltx_tr">
<th id="S4.T3.15.4.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_row" style="padding-left:0.9pt;padding-right:0.9pt;"><span id="S4.T3.15.4.1.1" class="ltx_text ltx_font_smallcaps" style="font-size:80%;">ZO-Multiple</span></th>
<td id="S4.T3.15.4.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:0.9pt;padding-right:0.9pt;"><span id="S4.T3.15.4.2.1" class="ltx_text" style="font-size:80%;">2886.8</span></td>
