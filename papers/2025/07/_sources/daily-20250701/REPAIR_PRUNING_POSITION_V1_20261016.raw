<td id="S5.T7.3.27.4" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S5.T7.3.27.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">71.32</span></td>
