<td id="S4.T3.2.2.5" class="ltx_td ltx_align_center">184.71</td>
<td id="S4.T3.2.2.6" class="ltx_td ltx_align_left">24.10</td></tr>
<tr id="S4.T3.2.3" class="ltx_tr">
<td id="S4.T3.2.3.1" class="ltx_td ltx_align_center">w/o SPA</td>
<td id="S4.T3.2.3.2" class="ltx_td ltx_align_left">0.1415</td>
<td id="S4.T3.2.3.3" class="ltx_td ltx_align_left">0.7032</td>
<td id="S4.T3.2.3.4" class="ltx_td ltx_align_left"><math id="S4.T3.m8" class="ltx_Math" alttext="\mathrm{2}\mathrm{0}\,\mathrm{3}\mathrm{6}" display="inline" intent=":literal"><semantics><mn>20 36</mn><annotation encoding="application/x-tex">\mathrm{2}\mathrm{0}\,\mathrm{3}\mathrm{6}</annotation></semantics></math></td>
<td id="S4.T3.2.3.5" class="ltx_td ltx_align_center">169.50</td>
<td id="S4.T3.2.3.6" class="ltx_td ltx_align_left">24.19</td></tr>
