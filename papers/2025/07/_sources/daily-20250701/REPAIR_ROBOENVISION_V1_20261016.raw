<td id="S4.T3.2.4.4" class="ltx_td ltx_align_left"><math id="S4.T3.m9" class="ltx_Math" alttext="\mathrm{2}\mathrm{0}\,\mathrm{1}\mathrm{1}" display="inline" intent=":literal"><semantics><mn>20 11</mn><annotation encoding="application/x-tex">\mathrm{2}\mathrm{0}\,\mathrm{1}\mathrm{1}</annotation></semantics></math></td>
<td id="S4.T3.2.4.5" class="ltx_td ltx_align_center">168.83</td>
