<figure id="S4.F3" class="ltx_figure"><img src="2506.22395v1/update_steps_v3.png" id="S4.F3.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:238/71;" width="238" height="71" alt="Refer to caption">
