<th id="S4.T5.4.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">LLaVA 1.5M</th>
<th id="S4.T5.4.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">LLaVA-Next</th>
<th id="S4.T5.4.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Qwen2-VL</th></tr>
</thead>
