<td id="A1.T6.4.17.4" class="ltx_td ltx_align_center ltx_border_t">32.11</td>
<td id="A1.T6.4.17.5" class="ltx_td ltx_align_center ltx_border_t">58.44</td>
<td id="A1.T6.4.17.6" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#DFDFDF;"><span id="A1.T6.4.17.6.1" class="ltx_text" style="--ltx-bg-color:#DFDFDF;">35.23</span></td></tr>
<tr id="A1.T6.4.18" class="ltx_tr">
<th id="A1.T6.4.18.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">+ Constant <math id="A1.T6.m20" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math></th>
<td id="A1.T6.4.18.2" class="ltx_td ltx_align_center">32.50</td>
