<th id="S4.T1.4.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_r ltx_border_tt"><span id="S4.T1.4.1.2.1" class="ltx_text ltx_font_bold">Models</span></th>
<th id="S4.T1.4.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt"><math id="S4.T1.m1" class="ltx_Math" alttext="\mathbf{Acc}" display="inline" intent=":literal"><semantics><mi>𝐀𝐜𝐜</mi><annotation encoding="application/x-tex">\mathbf{Acc}</annotation></semantics></math></th>
<th id="S4.T1.4.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt"><math id="S4.T1.m2" class="ltx_Math" alttext="\mathbf{S_{GT}}" display="inline" intent=":literal"><semantics><msub><mi>𝐒</mi><mi>𝐆𝐓</mi></msub><annotation encoding="application/x-tex">\mathbf{S_{GT}}</annotation></semantics></math></th>
<th id="S4.T1.4.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt"><math id="S4.T1.m3" class="ltx_Math" alttext="\mathbf{Con}" display="inline" intent=":literal"><semantics><mi>𝐂𝐨𝐧</mi><annotation encoding="application/x-tex">\mathbf{Con}</annotation></semantics></math></th>
<th id="S4.T1.4.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt"><math id="S4.T1.m4" class="ltx_Math" alttext="\mathbf{S_{C}}" display="inline" intent=":literal"><semantics><msub><mi>𝐒</mi><mi>𝐂</mi></msub><annotation encoding="application/x-tex">\mathbf{S_{C}}</annotation></semantics></math></th>
<th id="S4.T1.4.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="S4.T1.m5" class="ltx_Math" alttext="O_{all}" display="inline" intent=":literal"><semantics><msub><mi>O</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">O_{all}</annotation></semantics></math></th></tr>
</thead>
<tbody class="ltx_tbody">
