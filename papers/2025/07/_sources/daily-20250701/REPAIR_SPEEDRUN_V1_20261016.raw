<figure id="A4.F8" class="ltx_figure"><span class="ltx_inline-block"><svg id="A4.F8.pic1" class="ltx_picture" height="159.71" overflow="visible" version="1.1" viewBox="0 0 653.15 159.71" width="653.15"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,159.71) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#BF6000;" fill="#BF6000" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 153.8 C 0 157.06 2.64 159.71 5.91 159.71 L 647.24 159.71 C 650.51 159.71 653.15 157.06 653.15 153.8 L 653.15 5.91 C 653.15 2.64 650.51 0 647.24 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#FFF9F2;" fill="#FFF9F2" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 135.59 L 651.18 135.59 L 651.18 5.91 C 651.18 3.73 649.42 1.97 647.24 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 144.19)"><foreignObject style="--ltx-fo-width:44.07em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="609.8"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
