  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2506.23032">arXiv:2506.23032</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.23032">pdf</a>]&nbsp;</span>
