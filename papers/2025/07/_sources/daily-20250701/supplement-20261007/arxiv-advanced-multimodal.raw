        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.16565">pdf</a>, <a href="https://arxiv.org/ps/2506.16565">ps</a>, <a href="https://arxiv.org/format/2506.16565">other</a>]&nbsp;</span>
