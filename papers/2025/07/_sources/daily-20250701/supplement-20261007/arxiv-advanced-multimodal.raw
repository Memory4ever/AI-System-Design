        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.19850">pdf</a>, <a href="https://arxiv.org/ps/2506.19850">ps</a>, <a href="https://arxiv.org/format/2506.19850">other</a>]&nbsp;</span>
