  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2506.23731">arXiv:2506.23731</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.23731">pdf</a>, <a href="https://arxiv.org/ps/2506.23731">ps</a>, <a href="https://arxiv.org/format/2506.23731">other</a>]&nbsp;</span>
