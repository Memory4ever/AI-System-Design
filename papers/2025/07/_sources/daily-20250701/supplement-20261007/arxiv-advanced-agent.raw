        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.12104">pdf</a>, <a href="https://arxiv.org/ps/2506.12104">ps</a>, <a href="https://arxiv.org/format/2506.12104">other</a>]&nbsp;</span>
