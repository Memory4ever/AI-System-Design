        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.12666">pdf</a>, <a href="https://arxiv.org/ps/2506.12666">ps</a>, <a href="https://arxiv.org/format/2506.12666">other</a>]&nbsp;</span>
