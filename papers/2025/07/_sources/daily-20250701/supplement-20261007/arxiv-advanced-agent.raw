    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Zhang%2C+G">Gengyuan Zhang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Hannan%2C+T">Tanveer Hannan</a>, 
      
