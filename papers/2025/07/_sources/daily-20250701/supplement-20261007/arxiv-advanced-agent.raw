        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.18679">pdf</a>, <a href="https://arxiv.org/ps/2506.18679">ps</a>, <a href="https://arxiv.org/format/2506.18679">other</a>]&nbsp;</span>
