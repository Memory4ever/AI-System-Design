        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.17318">pdf</a>, <a href="https://arxiv.org/ps/2506.17318">ps</a>, <a href="https://arxiv.org/format/2506.17318">other</a>]&nbsp;</span>
