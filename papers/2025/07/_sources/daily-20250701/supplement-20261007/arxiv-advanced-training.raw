        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.20664">pdf</a>, <a href="https://arxiv.org/ps/2506.20664">ps</a>, <a href="https://arxiv.org/format/2506.20664">other</a>]&nbsp;</span>
