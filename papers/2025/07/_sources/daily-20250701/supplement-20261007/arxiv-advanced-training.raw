        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.21277">pdf</a>, <a href="https://arxiv.org/ps/2506.21277">ps</a>, <a href="https://arxiv.org/format/2506.21277">other</a>]&nbsp;</span>
