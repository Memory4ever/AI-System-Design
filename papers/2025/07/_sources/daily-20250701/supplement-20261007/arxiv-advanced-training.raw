        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.21853">pdf</a>, <a href="https://arxiv.org/ps/2506.21853">ps</a>, <a href="https://arxiv.org/format/2506.21853">other</a>]&nbsp;</span>
