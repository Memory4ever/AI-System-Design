        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.20495">pdf</a>, <a href="https://arxiv.org/ps/2506.20495">ps</a>, <a href="https://arxiv.org/format/2506.20495">other</a>]&nbsp;</span>
