        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.22777">pdf</a>, <a href="https://arxiv.org/ps/2506.22777">ps</a>, <a href="https://arxiv.org/format/2506.22777">other</a>]&nbsp;</span>
