      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2506.21590">arXiv:2506.21590</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.21590">pdf</a>, <a href="https://arxiv.org/ps/2506.21590">ps</a>, <a href="https://arxiv.org/format/2506.21590">other</a>]&nbsp;</span>
      </p>
      <div class="tags is-inline-block">
        <span class="tag is-small is-link tooltip is-tooltip-top" data-tooltip="Computation and Language">cs.CL</span>
        
          
