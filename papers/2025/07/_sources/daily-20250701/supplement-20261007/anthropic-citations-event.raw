 17.5C13 17.7761 12.7761 18 12.5 18H7.5C7.22386 18 7 17.7761 7 17.5C7 17.2239 7.22386 17 7.5 17H12.5ZM10 2C13.3137 2 16 4.68629 16 8C16 9.73776 15.2608 11.3033 14.0811 12.3984L13.8389 12.6113C13.3268 13.0382 13 13.5753 13 14.124V15.5C13 15.7761 12.7761 16 12.5 16H7.5C7.22386 16 7 15.7761 7 15.5V14.124C6.99998 13.6438 6.7495 13.1727 6.34375 12.7764L6.16113 12.6113C4.84147 11.5115 4 9.85368 4 8C4 4.68629 6.68629 2 10 2ZM10 3C7.23858 3 5 5.23858 5 8C5 9.5443 5.69948 10.9248 6.80078 11.8428L7.03711 12.0557C7.57356 12.5787 7.99998 13.2899 8 14.124V15H9.5V11.207L7.14648 8.85352L7.08203 8.77539C6.95387 8.58131 6.97562 8.31735 7.14648 8.14648C7.31735 7.97562 7.58131 7.95387 7.77539 8.08203L7.85352 8.14648L10 10.293L12.1465 8.14648L12.2246 8.08203C12.4187 7.95387 12.6827 7.97562 12.8535 8.14648C13.0244 8.31735 13.0461 8.58131 12.918 8.77539L12.8535 8.85352L10.5 11.207V15H12V14.124C12 13.1706 12.5575 12.3776 13.1992 11.8428L13.4004 11.665C14.3848 10.7513 15 9.44786 15 8C15 5.23858 12.7614 3 10 3Z3f:[\"$\",\"ul\",null,{\"className\":\"DetailSidebar-module-scss-module__3RcHtG__sidebar DetailHero-module-scss-module__VKMbIq__sidebar\",\"children\":[[[\"$\",\"li\",\"0\",{\"className\":\"DetailSidebar-module-scss-module__3RcHtG__item\",\"children\":[[\"$\",\"span\",null,{\"className\":\"DetailSidebar-module-scss-module__3RcHtG__icon\",\"aria-hidden\":\"true\",\"children\":[\"$\",\"div\",null,{\"className\":\"_base-module-scss-module__SsgDWW__wrapper\",\"style\":{\"width\":20,\"height\":20},\"children\":[\"$\",\"svg\",null,{\"width\":20,\"height\":20,\"viewBox\":\"0 0 20 20\",\"fill\":\"currentColor\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"className\":\"_base-module-scss-module__SsgDWW__vector\",\"aria-label\":\"$undefined\",\"aria-hidden\":true,\"children\":[\"$\",\"path\",null,{\"d\":\"$43\"}]}]}]}],[\"$\",\"div\",null,{\"className\":\"DetailSidebar-module-scss-module__3RcHtG__content\",\"children\":[[\"$\",\"span\",null,{\"className\":\"DetailSidebar-module-scss-module__3RcHtG__label text-caption\",\"children\":\"Category\"}],[\"$\",\"span\",null,{\"className\":\"DetailSidebar-module-scss-module__3RcHtG__value text-body-3\",\"children\":[[\"$\",\"a\",\"/resources/product-announcements\",{\"href\":\"/resources/product-announcements\",\"className\":\"DetailSidebar-module-scss-module__3RcHtG__inlineLink\",\"children\":\"Announcements\"}]]}]]}]]}],[\"$\",\"li\",\"1\",{\"className\":\"DetailSidebar-module-scss-module__3RcHtG__item\",\"children\":[[\"$\",\"span\",null,{\"className\":\"DetailSidebar-module-scss-module__3RcHtG__icon\",\"aria-hidden\":\"true\",\"children\":[\"$\",\"div\",null,{\"className\":\"_base-module-scss-module__SsgDWW__wrapper\",\"style\":{\"width\":20,\"height\":20},\"children\":[\"$\",\"svg\",null,{\"width\":20,\"height\":20,\"viewBox\":\"0 0 20 20\",\"fill\":\"currentColor\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"className\":\"_base-module-scss-module__SsgDWW__vector\",\"aria-label\":\"$undefined\",\"aria-hidden\":true,\"children\":[\"$\",\"path\",null,{\"d\":\"M12.5 3C13.3284 3 14 3.67157 14 4.5V6H14.5C16.433 6 18 7.567 18 9.5V15.5C18 16.3284 17.3284 17 16.5 17H3.5C2.72334 17 2.08461 16.4097 2.00781 15.6533L2 15.5V9.5C2 7.567 3.567 6 5.5 6H6V4.5C6 3.67157 6.67157 3 7.5 3H12.5ZM3 15.5L3.00977 15.6006C3.05629 15.8286 3.25829 16 3.5 16H16.5C16.7761 16 17 15.7761 17 15.5V12H13V12.5C13 12.7761 12.7761 13 12.5 13C12.2239 13 12 12.7761 12 12.5V12H8V12.5C8 12.7761 7.77614 13 7.5 13C7.22386 13 7 12.7761 7 12.5V12H3V15.5ZM5.5 7C4.11929 7 3 8.11929 3 9.5V11H7V10.5C7 10.2239 7.22386 10 7.5 10C7.77614 10 8 10.2239 8 10.5V11H12V10.5C12 10.2239 12.2239 10 12.5 10C12.7761 10 13 10.2239 13 10.5V11H17"])</script><script nonce="O2AiRF6Rt4k043IesqPpJQ==">self.__next_f.push([1,"V9.5C17 8.11929 15.8807 7 14.5 7H5.5ZM7.5 4C7.22386 4 7 4.22386 7 4.5V6H13V4.5C13 4.22386 12.7761 4 12.5 4H7.5Z\"}]}]}]}],[\"$\",\"div\",null,{\"className\":\"DetailSidebar-module-scss-module__3RcHtG__content\",\"children\":[[\"$\",\"span\",null,{\"className\":\"DetailSidebar-module-scss-module__3RcHtG__label text-caption\",\"children\":\"Product\"}],\"$L44\"]}]]}],\"$L45\",\"$L46\"],\"$L47\"]}]\n40:[\"$\",\"div\",null,{\"className\":\"grid-12 ArticleLayout-module-scss-module__W3addq__wrap\",\"children\":[[\"$\",\"div\",null,{\"className\":\"ArticleLayout-module-scss-module__W3addq__content\",\"children\":[\"\",[\"$\",\"div\",null,{\"className\":\"text-rich-text text-rich-text--article w-richtext\",\"style\":\"$undefined\",\"children\":[[\"$\",\"p\",\"265fe71ca250\",{\"className\":\"$undefined\",\"children\":[[\"$\",\"em\",\"b1054f0cee41\",{\"children\":[[\"$\",\"strong\",\"b1054f0cee41\",{\"children\":[\"Update: \"]}],\"Now available in Amazon Bedrock. (June 30, 2025)\"]}]]}],[\"$\",\"p\",\"1e50f5004773\",{\"className\":\"$undefined\",\"children\":[\"Today, we're launching Citations, a new API feature that lets Claude ground its answers in source documents. Claude can now provide detailed references to the exact sentences and passages it uses to generate responses, leading to more verifiable, trustworthy outputs.\"]}],[\"$\",\"p\",\"a4a3e78dd247\",{\"className\":\"$undefined\",\"children\":[\"Citations is generally available on the Anthropic API and Google Cloud’s Vertex AI.\"]}],[\"$\",\"h3\",\"cde1f4db0080\",{\"className\":\"$undefined\",\"children\":[\"Trust by verification\"]}],[\"$\",\"p\",\"8d9aff3575f6\",{\"className\":\"$undefined\",\"children\":[\"All Claude models are trained to be trustworthy and steerable by design. Citations builds upon this foundation, addressing a specific need in AI applications: verifying the sources behind AI-generated responses.\"]}],[\"$\",\"p\",\"3b80626f84ed\",{\"className\":\"$undefined\",\"children\":[\"Previously, developers relied on complex prompts that instruct Claude to include source information, often resulting in inconsistent performance and significant time investment in prompt engineering and testing. With Citations, users can now add source documents to the context window, and when querying the model, Claude automatically cites claims in its output that are inferred from those sources.\"]}],[\"$\",\"p\",\"e14e901ce249\",{\"className\":\"$undefined\",\"children\":[[\"$\",\"strong\",\"a3da54582154\",{\"children\":[\"Our internal evaluations show that Claude's built-in citation capabilities outperform most custom implementations, increasing recall accuracy by up to 15%.1\"]}]]}],[\"$\",\"h3\",\"a1b9a77adf1c\",{\"className\":\"$undefined\",\"children\":[\"Use cases\"]}],[\"$\",\"p\",\"c0d624d4bb2e\",{\"className\":\"$undefined\",\"children\":[\"With Citations, developers can create AI solutions that offer enhanced accountability across use cases like:\"]}],[\"$\",\"ul\",\"eea6f196cd8f-parent\",{\"className\":\"$undefined\",\"children\":[[\"$\",\"li\",\"eea6f196cd8f\",{\"children\":[\"Document summarization: Generate concise summaries of long documents, like case files, with each key point linked back to its original source.\"]}],[\"$\",\"li\",\"9eeb06197446\",{\"children\":[\"Complex Q\u0026A: Provide detailed answers to user queries across a large corpus of documents, like financial statements, with each response element traced back to specific sections of relevant texts.\"]}],[\"$\",\"li\",\"77988848d7c3\",{\"children\":[\"Customer support: Create support systems that can answer complex queries by referencing multiple product manuals, FAQs, and support tickets, always citing the exact source of information.\"]}]]}],[\"$\",\"h3\",\"4e37ee37f425\",{\"className\":\"$undefined\",\"children\":[\"How it works\"]}],[\"$\",\"p\",\"a3afe16d6fa5\",{\"className\":\"$undefined\",\"children\":[\"When Citations is enabled, the API processes user-provided source documents (PDF documents and plain text files) by chunking them into sentences. These chunked sentences, along with user-provided context, are then passed to the model with the user's query. Alternatively, users can provide their own chunks for the source documents.\"]}],[\"$\",\"p\",\"3a0bf5f3cace\",{\"className\":\"$undefined\",\"children\":[\"Claude analyzes the query and generates a response that includes precise citations"])</script><script nonce="O2AiRF6Rt4k043IesqPpJQ==">self.__next_f.push([1," based on the provided chunks and context for any claims derived from the source material. Cited text will reference source documents to minimize hallucinations.\"]}],\"$L48\",\"$L49\",\"$L4a\",\"$L4b\",\"$L4c\",\"$L4d\",\"$L4e\",\"$L4f\",\"$L50\",\"$L51\",\"$L52\"]}],\"$L53\"]}],false,false,false]}]\n55:Tc44f,\u003csvg width=\"1000\" height=\"1000\" viewBox=\"0 0 1000 1000\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"\u003e\n\u003cg clip-path=\"url(#clip0_15352_67)\"\u003e\n\u003cpath d=\"M483.39 195.75C494.74 200.12 506.01 204.66 517.39 208.81C528.77 212.96 540.16 216.75 551.61 220.52C563.06 224.29 573.94 228.98 584.86 233.83C594.72 238.21 604.69 242.32 614.58 246.63C620.94 249.41 627.06 252.8 633.58 255.1C648.192 260.205 662.502 266.138 676.44 272.87C685.1 277.09 693.8 281.23 702.63 285.07C711.11 288.77 719.75 292.07 728.35 295.5C738.27 299.42 748.35 302.97 758.11 307.22C765.9 310.61 773.35 314.81 780.95 318.65C782.12 319.24 784.05 319.71 784.23 320.54C784.47 321.6 783.35 323.01 782.69 324.2C780.69 327.92 778.47 331.57 776.46 335.31C774.3 339.31 772.26 343.44 770.18 347.51C767.84 352.1 765.77 356.86 763.11 361.25C760 366.37 758.35 372.03 756.18 377.5C751.92 388.26 746.47 398.41 740.97 408.55C737.86 414.28 735.39 420.37 732.7 426.32C727.45 437.91 722.19 449.5 717.07 461.15C715.55 464.6 714.66 468.32 713.14 471.76C710.52 477.69 707.61 483.5 704.89 489.39C703.65 492.07 702.59 494.82 701.39 497.7C693.16 496.55 685.68 492.93 678.03 489.99C666.17 485.41 654.55 480.21 642.76 475.45C634.05 471.94 625.14 468.92 616.47 465.33C599.28 458.23 582.2 450.89 565.07 443.64C556.41 439.98 547.81 436.18 539.07 432.69C531.46 429.69 523.57 427.3 516.07 424.05C504.49 419.05 491.89 416.65 480.85 410.29C473.62 409.29 467.85 404.64 460.94 402.74C460.63 402.65 460.34 402