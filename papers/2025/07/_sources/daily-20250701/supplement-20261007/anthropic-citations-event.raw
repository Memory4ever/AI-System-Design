47 397.262C549.512 397.076 551.293 395.156 551.859 394.387C557.88 386.263 565.794 382.571 573.948 377.257C575.655 376.144 578.253 373.436 580.044 372.388C590.898 366.045 607.922 361.955 618.284 355.111C623.35 351.763 630.901 343.852 635.531 339.539C636.069 339.039 639.594 337.314 638.815 336.488L638.825 336.507Z\" fill=\"#141413\"/\u003e\n\u003c/svg\u003e\n4:[\"$\",\"$L26\",null,{\"types\":{\"language\":\"en\",\"article\":{\"label\":\"Article\",\"plural\":\"Articles\",\"description\":\"News, announcements, and stories from Anthropic about Claude and the people building with it.\",\"fallbackIllustration\":{\"name\":\"Hand Quill\",\"description\":\"An elegant hand holding a vintage quill pen, depicted in minimalist design with warm cream and dark tones, representing writing, creativity, and classical literacy.\",\"svgMarkup\":\"$27\",\"url\":\"https://assets.claude.com/182c77698de29f9b805a28b5b58a7b1104b660dc.svg\",\"lottieUrl\":null,\"lottieAnimateInFrames\":null,\"lottieLoopFrames\":null}},\"guide\":{\"label\":\"Guide\",\"plural\":\"Guides\",\"description\":\"Step-by-step walkthroughs and practical playbooks for getting the most out of Claude.\",\"fallbackIllustration\":{\"name\":\"Hand Book\",\"description\":\"Open book with two pages shown in profile view, displaying a classic handbook or journal design with curved spine and readable page edges\",\"svgMarkup\":\"$28\",\"url\":\"https://assets.claude.com/15bb237f74df42eb4b9d4423de1cf935f226c91f.svg\",\"lottieUrl\":null,\"lottieAnimateInFrames\":null,\"lottieLoopFrames\":null}},\"brief\":{\"label\":\"Brief\",\"plural\":\"Briefs\",\"description\":\"Short, focused reads that break down one idea, workflow, or capability at a time.\",\"fallbackIllustration\":{\"name\":\"Object Page\",\"description\":\"An abstract map or landmass illustration with curved geographical boundaries shown in cream and dark charcoal colors, suggesting continents or territorial divisions.\",\"svgMarkup\":\"$29\",\"url\":\"https://assets.claude.