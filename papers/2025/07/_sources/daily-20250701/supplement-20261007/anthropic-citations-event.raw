215C8.25179 9.38783 8.31014 9.59583 8.37793 9.81152Z46:[\"$\",\"li\",\"3\",{\"className\":\"DetailSidebar-module-scss-module__3RcHtG__item\",\"children\":[[\"$\",\"span\",null,{\"className\":\"DetailSidebar-module-scss-module__3RcHtG__icon\",\"aria-hidden\":\"true\",\"children\":[\"$\",\"div\",null,{\"className\":\"_base-module-scss-module__SsgDWW__wrapper\",\"style\":{\"width\":20,\"height\":20},\"children\":[\"$\",\"svg\",null,{\"width\":20,\"height\":20,\"viewBox\":\"0 0 20 20\",\"fill\":\"currentColor\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"className\":\"_base-module-scss-module__SsgDWW__vector\",\"aria-label\":\"$undefined\",\"aria-hidden\":true,\"children\":[\"$\",\"path\",null,{\"d\":\"$5a\"}]}]}]}],[\"$\",\"div\",null,{\"className\":\"DetailSidebar-module-scss-module__3RcHtG__content\",\"children\":[[\"$\",\"span\",null,{\"className\":\"DetailSidebar-module-scss-module__3RcHtG__label text-caption\",\"children\":\"Reading time\"}],[\"$\",\"span\",null,{\"className\":\"DetailSidebar-module-scss-module__3RcHtG__value text-body-3\",\"children\":\"5 min\"}]]}]]}]\n47:[\"$\",\"$L5b\",null,{\"url\":\"https://claude.com/resources/articles/introducing-citations-api\"}]\n48:[\"$\",\"p\",\"60046aa7afb4\",{\"className\":\"$undefined\",\"children\":[\"This approach offers superior flexibility and ease of use, as it doesn't require file storage and seamlessly integrates with the Messages API.\"]}]\n49:[\"$\",\"h3\",\"e427fba93863\",{\"className\":\"$undefined\",\"children\":[\"Pricing\"]}]\n4a:[\"$\",\"p\",\"ee7a3268073f\",{\"className\":\"$undefined\",\"children\":[\"Citations uses our standard token-based pricing model. While it may use additional input tokens to process documents, users will not pay for output tokens that return the quoted text itself.\"]}]\n4b:[\"$\",\"h3\",\"57d36cfcac7b\",{\"className\":\"$undefined\",\"children\":[\"Customer spotlight: Thomson Reuters\"]}]\n4c:[\"$\",\"p\",\"458a339cbf43\",{\"className\":\"$undefined\",\"children\":[\"Thomson Reuters uses Claude to power their AI platform, CoCounsel, helping legal and tax professionals synthesize expert knowledge and deliver comprehensive advice to clients.\"]}]\n4d:[\"$\",\"p\",\"f56f56ec7cde\",{\"className\":\"$undefined\",\"children\":[\"“For CoCounsel to be trustworthy and immediately useful for practicing attorneys, it needs to cite its work. We first built this ourselves, but it was really hard to build and maintain. That's why we were excited to test out Anthropic’s Citations functionality. It makes citing and linking to primary sources much easier to build, maintain, and deploy to our users. This capability not only helps minimize hallucination risk but also strengthens trust in AI-generated content. The Citations feature will enable us to build an even more accurate and thorough AI assistant for lawyers,” said Jake Heller, Head of Product, CoCounsel, Thomson Reuters.\"]}]\n4e:[\"$\",\"h3\",\"239403c04af7\",{\"className\":\"$undefined\",\"children\":[\"Customer Spotlight: Endex\"]}]\n4f:[\"$\",\"p\",\"76384a600526\",{\"className\":\"$undefined\",\"children\":[\"Endex uses Claude to power an Autonomous Agent for financial firms.\"]}]\n50:[\"$\",\"p\",\"24a12a70658a\",{\"className\":\"$undefined\",\"children\":[\"\\\"With Anthropic's Citations, we reduced source hallucinations and formatting issues from 10% to 0% and saw a 20% increase in references per response. This removed the need for elaborate prompt engineering around references and improved our accuracy when conducting complex, multi-stage financi"])</script><script nonce="O2AiRF6Rt4k043IesqPpJQ==">self.__next_f.push([1,"al research,” said Tarun Amasa, CEO, Endex.\"]}]\n51:[\"$\",\"h3\",\"83beae072847\",{\"className\":\"$undefined\",\"children\":[\"Get started\"]}]\n52:[\"$\",\"p\",\"32f9bf4fb35f\",{\"className\":\"$undefined\",\"children\":[\"Citations is now available for the new Claude 3.5 Sonnet and Claude 3.5 Haiku. To start using Citations, explore our \",[\"$\",\"a\",\"15385ef17553\",{\"href\":\"https://docs.anthropic.com/en/docs/build-with-claude/citations\",\"target\":\"$undefined\",\"rel\":\"$undefined\",\"children\":[[\"documentation\"],\"$undefined\"]}],\".\"]}]\n53:[null,null,false,\"$undefined\"]\n5c:T6f6c,\u003csvg width=\"1000\" height=\"1000\" viewBox=\"0 0 1000 1000\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"\u003e\n\u003cpath d=\"M49.4132 840.313L60.1058 840.654L71.1046 841.685L82.1122 840.366L93.1198 841.948L104.127 840.733L115.135 840.951L126.134 840.829L137.141 841.493L148.149 841.441L159.157 840.671L170.164 840.619L181.172 840.907L192.171 841.039L203.178 840.488L214.186 839.894L225.193 841.886L236.201 840.567L247.209 840.811L258.216 839.885L269.215 839.5L280.223 839.684L291.23 840.715L302.238 841.554L313.245 841.878L324.253 840.304L335.252 841.344L346.26 840.007L357.267 841.738L368.275 840.671L379.282 840.374L390.29 840.444L401.297 839.763L412.296 841.886L423.304 840.068L434.312 840.339L445.319 840.182L456.327 841.222L467.334 840.654L478.342 841.79L489.341 841.825L500.348 839.815L511.356 841.729L522.364 841.598L533.371 841.012L544.37 841.712L555.378 839.71L566.385 841.1L577.393 842L588.4 841.843L599.408 841.397L610.416 839.693L621.414 839.422L632.422 840.095L643.43 840.532L654.437 840.427L665.445 839.605L676.452 840.68L687.46 840.392L698.468 839.806L709.466 841.31L720.474 841.143L731.482 839.282L742.489 841.074L753.497 840.252L764.504 841.476L775.512 839.92L786.52 841.362L797.527 840.698L808.526 841.965L819.534 840.724L830.541 840.007L841.549 840.033L852.556 841.082L863.564 839.885L874.572 840.462L885.579 840.759L896.587 840.523L907.594 840.366L918.602 841.021L929.61 839.43L940.958 841.012L940.022 830.087L941.501 819.528L941.457 808.961L939.69 798.394L941.895 787.826L939.838 778.072L929.557 777.425L918.497 777.513L907.437 776.997L895.904 777.766L896.359 766.692L896.709 756.116L896.552 745.549L895.983 734.99L895.37 724.432L895.545 713.27L884.757 711.233L874.502 709.625L864.273 707.816L854.201 705.15L842.669 705.421L844.55