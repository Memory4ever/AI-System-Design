<td id="A2.T12.3.1.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="A2.T12.3.1.1.2.1" class="ltx_text ltx_align_center ltx_inline-block" style="width:149.1pt;">Acc(%)</span></td></tr>
