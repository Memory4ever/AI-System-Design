<tr id="A2.T14.3.1.3" class="ltx_tr">
<td id="A2.T14.3.1.3.1" class="ltx_td ltx_align_center ltx_border_t" rowspan="2"><span id="A2.T14.3.1.3.1.1" class="ltx_text">64</span></td>
<td id="A2.T14.3.1.3.2" class="ltx_td ltx_align_center ltx_border_t">8</td>
<td id="A2.T14.3.1.3.3" class="ltx_td ltx_align_center ltx_border_t">76.7</td>
<td id="A2.T14.3.1.3.4" class="ltx_td ltx_align_center ltx_border_t">87.1</td>
<td id="A2.T14.3.1.3.5" class="ltx_td ltx_align_center ltx_border_t">56.8</td></tr>
<tr id="A2.T14.3.1.4" class="ltx_tr">
<td id="A2.T14.3.1.4.1" class="ltx_td ltx_align_center"><span id="A2.T14.3.1.4.1.1" class="ltx_text" style="--ltx-fg-color:#808080;">4</span> + <span id="A2.T14.3.1.4.1.2" class="ltx_text" style="--ltx-fg-color:#B3B3B3;">8</span> + <span id="A2.T14.3.1.4.1.3" class="ltx_text" style="--ltx-fg-color:#B3B3B3;">32</span></td>
<td id="A2.T14.3.1.4.2" class="ltx_td ltx_align_center">73.5</td>
<td id="A2.T14.3.1.4.3" class="ltx_td ltx_align_center">89.4</td>
<td id="A2.T14.3.1.4.4" class="ltx_td ltx_align_center">57.7</td></tr>
<tr id="A2.T14.3.1.5" class="ltx_tr">
<td id="A2.T14.3.1.5.1" class="ltx_td ltx_align_center ltx_border_t" rowspan="2"><span id="A2.T14.3.1.5.1.1" class="ltx_text">128</span></td>
<td id="A2.T14.3.1.5.2" class="ltx_td ltx_align_center ltx_border_t">8</td>
<td id="A2.T14.3.1.5.3" class="ltx_td ltx_align_center ltx_border_t">123.8</td>
<td id="A2.T14.3.1.5.4" class="ltx_td ltx_align_center ltx_border_t">178.6</td>
<td id="A2.T14.3.1.5.5" class="ltx_td ltx_align_center ltx_border_t">57.6</td></tr>
<tr id="A2.T14.3.1.6" class="ltx_tr">
<td id="A2.T14.3.1.6.1" class="ltx_td ltx_align_center"><span id="A2.T14.3.1.6.1.1" class="ltx_text" style="--ltx-fg-color:#808080;">4</span> + <span id="A2.T14.3.1.6.1.2" class="ltx_text" style="--ltx-fg-color:#B3B3B3;">8</span> + <span id="A2.T14.3.1.6.1.3" class="ltx_text" style="--ltx-fg-color:#B3B3B3;">32</span></td>
<td id="A2.T14.3.1.6.2" class="ltx_td ltx_align_center">120.1</td>
<td id="A2.T14.3.1.6.3" class="ltx_td ltx_align_center">182.8</td>
<td id="A2.T14.3.1.6.4" class="ltx_td ltx_align_center">58.4</td></tr>
<tr id="A2.T14.3.1.7" class="ltx_tr">
<td id="A2.T14.3.1.7.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" rowspan="2"><span id="A2.T14.3.1.7.1.1" class="ltx_text">256</span></td>
<td id="A2.T14.3.1.7.2" class="ltx_td ltx_align_center ltx_border_t">8</td>
<td id="A2.T14.3.1.7.3" class="ltx_td ltx_align_center ltx_border_t">218.0</td>
<td id="A2.T14.3.1.7.4" class="ltx_td ltx_align_center ltx_border_t">361.1</td>
<td id="A2.T14.3.1.7.5" class="ltx_td ltx_align_center ltx_border_t">57.8</td></tr>
<tr id="A2.T14.3.1.8" class="ltx_tr">
<td id="A2.T14.3.1.8.1" class="ltx_td ltx_align_center ltx_border_bb"><span id="A2.T14.3.1.8.1.1" class="ltx_text" style="--ltx-fg-color:#808080;">4</span> + <span id="A2.T14.3.1.8.1.2" class="ltx_text" style="--ltx-fg-color:#B3B3B3;">8</span> + <span id="A2.T14.3.1.8.1.3" class="ltx_text" style="--ltx-fg-color:#B3B3B3;">32</span></td>
<td id="A2.T14.3.1.8.2" class="ltx_td ltx_align_center ltx_border_bb">220.6</td>
<td id="A2.T14.3.1.8.3" class="ltx_td ltx_align_center ltx_border_bb">365.6</td>
