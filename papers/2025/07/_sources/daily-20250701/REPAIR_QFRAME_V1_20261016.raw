<td id="S4.T5.3.1.6.4" class="ltx_td ltx_align_center">57.9</td></tr>
<tr id="S4.T5.3.1.7" class="ltx_tr">
<td id="S4.T5.3.1.7.1" class="ltx_td ltx_align_center">✓</td>
<td id="S4.T5.3.1.7.2" class="ltx_td"></td>
