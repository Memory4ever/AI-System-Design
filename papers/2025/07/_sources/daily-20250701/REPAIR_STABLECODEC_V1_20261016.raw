<td id="S5.T5.3.4.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.8pt;padding-right:1.8pt;">-21.37%</td>
<td id="S5.T5.3.4.7" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.8pt;padding-right:1.8pt;">-16.60%</td></tr>
<tr id="S5.T5.3.5" class="ltx_tr">
<td id="S5.T5.3.5.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.8pt;padding-right:1.8pt;">✓</td>
<td id="S5.T5.3.5.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.8pt;padding-right:1.8pt;">✓</td>
<td id="S5.T5.3.5.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r" style="padding-left:1.8pt;padding-right:1.8pt;">-</td>
<td id="S5.T5.3.5.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.8pt;padding-right:1.8pt;">24.41%</td>
<td id="S5.T5.3.5.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.8pt;padding-right:1.8pt;">9.88%</td>
<td id="S5.T5.3.5.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.8pt;padding-right:1.8pt;">-36.18%</td>
<td id="S5.T5.3.5.7" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.8pt;padding-right:1.8pt;">-49.24%</td></tr>
