<td id="S4.T1.2.5.5" class="ltx_td ltx_align_center"><span id="S4.T1.2.5.5.1" class="ltx_text ltx_markedasmath ltx_font_bold">3.1037</span></td>
<td id="S4.T1.2.5.6" class="ltx_td ltx_align_center"><span id="S4.T1.2.5.6.1" class="ltx_text ltx_markedasmath ltx_font_bold">3.0882</span></td>
<td id="S4.T1.2.5.7" class="ltx_td ltx_align_center"><span id="S4.T1.2.5.7.1" class="ltx_text ltx_markedasmath ltx_font_bold">3.0711</span></td></tr>
