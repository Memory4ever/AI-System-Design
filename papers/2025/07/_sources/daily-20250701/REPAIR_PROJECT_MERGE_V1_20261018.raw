<td id="S4.T1.2.6.1" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.2.6.1.1" class="ltx_text">800M</span></td>
<td id="S4.T1.2.6.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.2.6.2.1" class="ltx_text">HPR</span></td>
<td id="S4.T1.2.6.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.2.6.3.1" class="ltx_text ltx_markedasmath ltx_font_bold">2.9224</span></td>
<td id="S4.T1.2.6.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T1.m13" class="ltx_Math" alttext="2.8827" display="inline" intent=":literal"><semantics><mn>2.8827</mn><annotation encoding="application/x-tex">2.8827</annotation></semantics></math></td>
<td id="S4.T1.2.6.5" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T1.m14" class="ltx_Math" alttext="2.8519" display="inline" intent=":literal"><semantics><mn>2.8519</mn><annotation encoding="application/x-tex">2.8519</annotation></semantics></math></td>
<td id="S4.T1.2.6.6" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T1.m15" class="ltx_Math" alttext="2.8420" display="inline" intent=":literal"><semantics><mn>2.8420</mn><annotation encoding="application/x-tex">2.8420</annotation></semantics></math></td>
<td id="S4.T1.2.6.7" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T1.m16" class="ltx_Math" alttext="2.8259" display="inline" intent=":literal"><semantics><mn>2.8259</mn><annotation encoding="application/x-tex">2.8259</annotation></semantics></math></td></tr>
