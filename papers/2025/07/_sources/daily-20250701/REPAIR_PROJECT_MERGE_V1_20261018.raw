<td id="S4.T1.2.2.6" class="ltx_td ltx_align_center"><span id="S4.T1.2.2.6.1" class="ltx_text ltx_font_typewriter">7.5B</span></td>
<td id="S4.T1.2.2.7" class="ltx_td ltx_align_center"><span id="S4.T1.2.2.7.1" class="ltx_text ltx_font_typewriter">10B</span></td></tr>
