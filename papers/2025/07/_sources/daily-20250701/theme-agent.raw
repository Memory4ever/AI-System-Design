        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.23306">pdf</a>, <a href="https://arxiv.org/ps/2506.23306">ps</a>, <a href="https://arxiv.org/format/2506.23306">other</a>]&nbsp;</span>
