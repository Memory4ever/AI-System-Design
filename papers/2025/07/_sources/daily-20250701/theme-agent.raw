        <span>&nbsp;[<a href="https://arxiv.org/pdf/2507.02948">pdf</a>, <a href="https://arxiv.org/ps/2507.02948">ps</a>, <a href="https://arxiv.org/format/2507.02948">other</a>]&nbsp;</span>
