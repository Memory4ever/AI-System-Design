        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.22853">pdf</a>, <a href="https://arxiv.org/ps/2506.22853">ps</a>, <a href="https://arxiv.org/format/2506.22853">other</a>]&nbsp;</span>
