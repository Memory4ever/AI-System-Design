        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.23273">pdf</a>, <a href="https://arxiv.org/ps/2506.23273">ps</a>, <a href="https://arxiv.org/format/2506.23273">other</a>]&nbsp;</span>
