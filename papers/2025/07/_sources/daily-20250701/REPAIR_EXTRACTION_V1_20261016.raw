<td id="S6.T1.4.6.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="--ltx-bg-color:#ECECEC;padding-left:3.0pt;padding-right:3.0pt;"><span id="S6.T1.4.6.7.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#ECECEC;">Minimal</span></td>
<td id="S6.T1.4.6.8" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#ECECEC;padding-left:3.0pt;padding-right:3.0pt;"><span id="S6.T1.4.6.8.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#ECECEC;">Minimal</span></td></tr>
<tr id="S6.T1.4.7" class="ltx_tr">
<td id="S6.T1.4.7.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S6.T1.4.7.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Output Sanitization [4]</span></td>
