<td id="S6.T1.4.6.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="--ltx-bg-color:#BFFFBF;padding-left:3.0pt;padding-right:3.0pt;"><span id="S6.T1.4.6.5.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#BFFFBF;">High</span></td>
