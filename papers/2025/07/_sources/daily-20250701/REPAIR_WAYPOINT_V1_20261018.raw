<td id="S4.T2.6.2.1" class="ltx_td ltx_align_left ltx_align_top"></td>
<td id="S4.T2.6.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_r"></td>
<td id="S4.T2.6.2.3" class="ltx_td ltx_align_left ltx_align_top">
<span id="S4.T2.6.2.3.1" class="ltx_inline-block ltx_align_top" style="width:14.2pt;">
<span id="S4.T2.6.2.3.1.1" class="ltx_p">SR<math id="S4.T2.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span>
</span></td>
<td id="S4.T2.6.2.4" class="ltx_td ltx_align_left ltx_align_top">
