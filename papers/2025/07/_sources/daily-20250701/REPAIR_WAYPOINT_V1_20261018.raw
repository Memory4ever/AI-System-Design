</span></span><span id="S4.T2.6.1.1.1.1.3" class="ltx_text"></span></span>
</span></td>
<td id="S4.T2.6.1.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_tt">
<span id="S4.T2.6.1.2.1" class="ltx_inline-block ltx_align_top" style="width:42.7pt;">
<span id="S4.T2.6.1.2.1.1" class="ltx_p">Method</span>
</span></td>
<td id="S4.T2.6.1.3" class="ltx_td ltx_align_center ltx_align_top ltx_border_r ltx_border_tt" colspan="3">w/o obst.</td>
