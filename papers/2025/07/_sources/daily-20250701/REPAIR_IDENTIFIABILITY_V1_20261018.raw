</table>
<p id="A1.SS6.SSS3.p2.2" class="ltx_p"><span id="A1.SS6.SSS3.p2.2.1" class="ltx_text">To distinguish, we use <math id="A1.SS6.SSS3.p2.m2" class="ltx_Math" alttext="{\varepsilon}_{0}" display="inline" intent=":literal"><semantics><msub><mi>ε</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\varepsilon}_{0}</annotation></semantics></math> to denote the true proportion that generates <math id="A1.SS6.SSS3.p2.m3" class="ltx_Math" alttext="\widehat{F}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>F</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{F}</annotation></semantics></math>.
Observe the equation that</span></p>
<table id="A1.Ex27a" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex27a.m1" class="ltx_Math" alttext="{\mathrm{d}}\bar{F}=(1-{\varepsilon}_{0}){\mathrm{d}}F_{0}+{\varepsilon}_{0}{\mathrm{d}}\bar{F}_{\bm{P}}=\left[(1-{\varepsilon}_{0})+{\varepsilon}_{0}g\right]{\mathrm{d}}F_{0}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>F</mi><mo>¯</mo></mover></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><msub><mi>ε</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub></mrow></mrow><mo>=</mo><mrow><mrow><mo>[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><msub><mi>ε</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathrm{d}}\bar{F}=(1-{\varepsilon}_{0}){\mathrm{d}}F_{0}+{\varepsilon}_{0}{\mathrm{d}}\bar{F}_{\bm{P}}=\left[(1-{\varepsilon}_{0})+{\varepsilon}_{0}g\right]{\mathrm{d}}F_{0}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS6.SSS3.p2.3" class="ltx_p"><span id="A1.SS6.SSS3.p2.3.1" class="ltx_text">Rearranging terms yields that</span></p>
<table id="A1.EGx22" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex28a"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
