<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="A2.F7.sf3.3" class="ltx_text" style="font-size:90%;">(c)</span> </span><math id="A2.F7.sf3.m2" class="ltx_Math" alttext="(\gamma,\mu)=(0.1,0.7)" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">γ</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">μ</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo mathsize="0.900em">=</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mn mathsize="0.900em">0.1</mn><mo mathsize="0.900em">,</mo><mn mathsize="0.900em">0.7</mn><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">(\gamma,\mu)=(0.1,0.7)</annotation></semantics></math></figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_3">
