</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="A2.F7.sf5" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2506.22343v1/GreenRed-gamma0.3-mu0.5.svg" id="A2.F7.sf5.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:476/357;" width="476" height="357"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="A2.F7.sf5.3" class="ltx_text" style="font-size:90%;">(e)</span> </span><math id="A2.F7.sf5.m2" class="ltx_Math" alttext="(\gamma,\mu)=(0.3,0.5)" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">γ</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">μ</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo mathsize="0.900em">=</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mn mathsize="0.900em">0.3</mn><mo mathsize="0.900em">,</mo><mn mathsize="0.900em">0.5</mn><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">(\gamma,\mu)=(0.3,0.5)</annotation></semantics></math></figcaption>
