</table>
</div>
<div id="A1.Thmlem2" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmlem2.2" class="ltx_text ltx_font_bold">Lemma A.2</span></span><span id="A1.Thmlem2.3" class="ltx_text ltx_font_bold"> </span>(High probability concentration)<span id="A1.Thmlem2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmlem2.p1" class="ltx_para">
<p id="A1.Thmlem2.p1.2" class="ltx_p"><span id="A1.Thmlem2.p1.2.1" class="ltx_text ltx_font_italic">Define two classes of functions as</span></p>
<table id="A1.E20" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A1.E20X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E20X.m2" class="ltx_Math" alttext="\displaystyle{\mathcal{H}}_{1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\displaystyle{\mathcal{H}}_{1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E20X.m3" class="ltx_Math" alttext="\displaystyle=\left\{\frac{1-\widehat{g}(x)}{(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)}:{\varepsilon}\in[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]\right\}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ε</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ε</mi><mi>min</mi></msub><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mi>min</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>}</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left\{\frac{1-\widehat{g}(x)}{(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)}:{\varepsilon}\in[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]\right\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(20)</span></td></tr>
<tr id="A1.E20Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E20Xa.m2" class="ltx_Math" alttext="\displaystyle{\mathcal{H}}_{2}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle{\mathcal{H}}_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E20Xa.m3" class="ltx_Math" alttext="\displaystyle=\left\{\frac{[1-\widehat{g}(x)]^{2}}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)]^{2}}:{\varepsilon}\in[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]\right\}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ε</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ε</mi><mi>min</mi></msub><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mi>min</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left\{\frac{[1-\widehat{g}(x)]^{2}}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)]^{2}}:{\varepsilon}\in[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.Thmlem2.p1.3" class="ltx_p"><span id="A1.Thmlem2.p1.3.1" class="ltx_text ltx_font_italic">There exists some universal constant <math id="A1.Thmlem2.p1.m1" class="ltx_Math" alttext="K&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">K&gt;0</annotation></semantics></math> so that for every <math id="A1.Thmlem2.p1.m2" class="ltx_Math" alttext="C&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C&gt;0</annotation></semantics></math>,</span></p>
<table id="A1.EGx27" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="A1.E21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E21.m1" class="ltx_Math" alttext="\displaystyle\begin{split}{\mathbb{P}}\left(\sup_{h\in\mathcal{H}_{1}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq\frac{1}{{\varepsilon}_{\min}}\sqrt{\frac{C\log n}{2n}}\right)\leq\frac{4K}{{\varepsilon}_{\min}^{3}}\cdot\frac{1}{n^{C-1}},\\
{\mathbb{P}}\left(\sup_{h\in\mathcal{H}_{2}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq\frac{1}{{\varepsilon}_{\min}^{2}}\sqrt{\frac{C\log n}{2n}}\right)\leq\frac{4K}{{\varepsilon}_{\min}^{3}}\cdot\frac{1}{n^{C-1}}.\end{split}" display="block" intent=":literal"><semantics><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>1</mn></msub></mrow></munder><mrow><mo>|</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>≥</mo><mrow><mfrac><mn>1</mn><msub><mi>ε</mi><mi>min</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></msqrt></mrow></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><msubsup><mi>ε</mi><mi>min</mi><mn>3</mn></msubsup></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mn>1</mn><msup><mi>n</mi><mrow><mi>C</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>2</mn></msub></mrow></munder><mrow><mo>|</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>≥</mo><mrow><mfrac><mn>1</mn><msubsup><mi>ε</mi><mi>min</mi><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></msqrt></mrow></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><msubsup><mi>ε</mi><mi>min</mi><mn>3</mn></msubsup></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mn>1</mn><msup><mi>n</mi><mrow><mi>C</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}{\mathbb{P}}\left(\sup_{h\in\mathcal{H}_{1}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq\frac{1}{{\varepsilon}_{\min}}\sqrt{\frac{C\log n}{2n}}\right)\leq\frac{4K}{{\varepsilon}_{\min}^{3}}\cdot\frac{1}{n^{C-1}},\\
{\mathbb{P}}\left(\sup_{h\in\mathcal{H}_{2}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq\frac{1}{{\varepsilon}_{\min}^{2}}\sqrt{\frac{C\log n}{2n}}\right)\leq\frac{4K}{{\varepsilon}_{\min}^{3}}\cdot\frac{1}{n^{C-1}}.\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
<p id="A1.Thmlem2.p1.4" class="ltx_p"><span id="A1.Thmlem2.p1.4.1" class="ltx_text ltx_font_italic">If we further have <math id="A1.Thmlem2.p1.m3" class="ltx_Math" alttext="\EB_{\bar{F}}[\widehat{g}]^{-2}&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mover accent="true"><mi mathvariant="normal">F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">[</mo><mover accent="true"><mi mathvariant="normal">g</mi><mo>^</mo></mover><mo stretchy="false">]</mo></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\EB_{\bar{F}}[\widehat{g}]^{-2}&lt;\infty</annotation></semantics></math>, we then define <math id="A1.Thmlem2.p1.m4" class="ltx_Math" alttext="M:=8\EB_{\bar{F}}\left[\widehat{g}-1/\widehat{g}\right]^{2}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>:=</mo><mrow><mn>8</mn><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>𝔼</mi><mover accent="true"><mi mathvariant="normal">F</mi><mo>¯</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mrow><mover accent="true"><mi mathvariant="normal">g</mi><mo>^</mo></mover><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mover accent="true"><mi mathvariant="normal">g</mi><mo>^</mo></mover></mrow></mrow><mo>]</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">M:=8\EB_{\bar{F}}\left[\widehat{g}-1/\widehat{g}\right]^{2}</annotation></semantics></math>.
There exists some universal constant <math id="A1.Thmlem2.p1.m5" class="ltx_Math" alttext="K&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">K&gt;0</annotation></semantics></math> so that for every <math id="A1.Thmlem2.p1.m6" class="ltx_Math" alttext="C&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C&gt;0</annotation></semantics></math>,</span></p>
<table id="A1.EGx28" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="A1.E22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E22.m1" class="ltx_Math" alttext="\displaystyle\begin{split}{\mathbb{P}}\left(\sup_{h\in\mathcal{H}_{1}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq\frac{C\log n}{n{\varepsilon}_{\min}}+\sqrt{\frac{CM\log n}{n}}\right)\leq\frac{4K}{{\varepsilon}_{\min}^{3}}\cdot\frac{1}{n^{C-1}},\\
{\mathbb{P}}\left(\sup_{h\in\mathcal{H}_{2}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq\frac{C\log n}{n{\varepsilon}_{\min}^{2}}+\sqrt{\frac{CM\log n}{n{\varepsilon}_{\min}^{2}}}\right)\leq\frac{4K}{{\varepsilon}_{\min}^{3}}\cdot\frac{1}{n^{C-1}}.\end{split}" display="block" intent=":literal"><semantics><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>1</mn></msub></mrow></munder><mrow><mo>|</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>≥</mo><mrow><mfrac><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ε</mi><mi>min</mi></msub></mrow></mfrac><mo>+</mo><msqrt><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mi>n</mi></mfrac></msqrt></mrow></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><msubsup><mi>ε</mi><mi>min</mi><mn>3</mn></msubsup></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mn>1</mn><msup><mi>n</mi><mrow><mi>C</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>2</mn></msub></mrow></munder><mrow><mo>|</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>≥</mo><mrow><mfrac><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mi>min</mi><mn>2</mn></msubsup></mrow></mfrac><mo>+</mo><msqrt><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mi>min</mi><mn>2</mn></msubsup></mrow></mfrac></msqrt></mrow></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><msubsup><mi>ε</mi><mi>min</mi><mn>3</mn></msubsup></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mn>1</mn><msup><mi>n</mi><mrow><mi>C</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}{\mathbb{P}}\left(\sup_{h\in\mathcal{H}_{1}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq\frac{C\log n}{n{\varepsilon}_{\min}}+\sqrt{\frac{CM\log n}{n}}\right)\leq\frac{4K}{{\varepsilon}_{\min}^{3}}\cdot\frac{1}{n^{C-1}},\\
{\mathbb{P}}\left(\sup_{h\in\mathcal{H}_{2}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq\frac{C\log n}{n{\varepsilon}_{\min}^{2}}+\sqrt{\frac{CM\log n}{n{\varepsilon}_{\min}^{2}}}\right)\leq\frac{4K}{{\varepsilon}_{\min}^{3}}\cdot\frac{1}{n^{C-1}}.\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.SS6.SSS3.p6" class="ltx_para">
<p id="A1.SS6.SSS3.p6.1" class="ltx_p"><span id="A1.SS6.SSS3.p6.1.1" class="ltx_text">We now proceed to prove (<a href="#A1.E15.1" title="Equation 15a ‣ Equation 15 ‣ Lemma A.1. ‣ A.6.1 Proof of Lemma ‣ A.6 Analysis for the Optimal Estimator ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15a</span></a>). To this end, we utilize the high-probability concentration result established in Lemma <a href="#A1.Thmlem2" title="Lemma A.2 (High probability concentration). ‣ Proof of Lemma . ‣ A.6.3 Proof of Lemma ‣ A.6 Analysis for the Optimal Estimator ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2</span></a>, whose proof is provided in Appendix <a href="#A1.SS7" title="A.7 Proof of Lemma ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.7</span></a>.
We further consider two cases, depending on whether the moment condition <math id="A1.SS6.SSS3.p6.m1" class="ltx_Math" alttext="\EB_{\bar{F}}[\widehat{g}]^{-2}&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">]</mo></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\EB_{\bar{F}}[\widehat{g}]^{-2}&lt;\infty</annotation></semantics></math> holds.</span></p>
</div>
</div>
<section id="A1.SS6.SSS3.Px1" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">Without the moment condition <math id="A1.SS6.SSS3.Px1.m1" class="ltx_Math" alttext="\EB_{\bar{F}}[\widehat{g}]^{-2}&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">]</mo></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\EB_{\bar{F}}[\widehat{g}]^{-2}&lt;\infty</annotation></semantics></math>.</h6>

<div id="A1.SS6.SSS3.Px1.p1" class="ltx_para">
<p id="A1.SS6.SSS3.Px1.p1.1" class="ltx_p">Similar to the way we bounded the individual terms in (<a href="#A1.E16" title="Equation 16 ‣ Proof of Lemma . ‣ A.6.3 Proof of Lemma ‣ A.6 Analysis for the Optimal Estimator ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>), we have:</p>
<table id="A1.Ex41a" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex41a.m1" class="ltx_Math" alttext="\frac{\int\frac{|1-\widehat{g}|^{3}}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}]^{2}}{\mathrm{d}}{F}_{0}}{\left[\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}{F}_{0}\right]^{2}}\overset{\eqref{eq:fraction-bound}}{\leq}\frac{1}{{\varepsilon}_{\min}}\cdot\frac{1}{\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}{F}_{0}}\leq C_{1},\quad\text{and}\quad\frac{1}{\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}{F}_{0}}\leq C_{2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mfrac><mrow><mo>∫</mo><mrow><mfrac><msup><mrow><mo stretchy="false">|</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">|</mo></mrow><mn>3</mn></msup><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow></mrow><msup><mrow><mo>[</mo><mrow><mo lspace="0em">∫</mo><mrow><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow></mrow><mo>]</mo></mrow><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo>≤</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#A1.E18" title="Equation 18 ‣ Proof of Lemma . ‣ A.6.3 Proof of Lemma ‣ A.6 Analysis for the Optimal Estimator ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">18</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><msub><mi>ε</mi><mi>min</mi></msub></mfrac></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mn>1</mn><mrow><mo>∫</mo><mrow><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow></mrow></mfrac></mrow><mo>≤</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><mo rspace="1.167em">,</mo><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mfrac><mn>1</mn><mrow><mo>∫</mo><mrow><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow></mrow></mfrac><mo>≤</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{\int\frac{|1-\widehat{g}|^{3}}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}]^{2}}{\mathrm{d}}{F}_{0}}{\left[\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}{F}_{0}\right]^{2}}\overset{\eqref{eq:fraction-bound}}{\leq}\frac{1}{{\varepsilon}_{\min}}\cdot\frac{1}{\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}{F}_{0}}\leq C_{1},\quad\text{and}\quad\frac{1}{\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}{F}_{0}}\leq C_{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS6.SSS3.Px1.p1.2" class="ltx_p">where</p>
<table id="A1.Ex42a" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex42a.m1" class="ltx_Math" alttext="C_{1}:=\frac{C_{g}}{4{\varepsilon}_{\min}D_{\mathrm{TV}}^{2}(F_{0},\widehat{F}_{\bm{P}})}=\frac{C_{2}}{{\varepsilon}_{\min}},\quad\text{and}\quad C_{2}:=\frac{C_{g}}{4D_{\mathrm{TV}}^{2}(F_{0},\widehat{F}_{\bm{P}})}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>C</mi><mn>1</mn></msub><mo>:=</mo><mfrac><msub><mi>C</mi><mi>g</mi></msub><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>ε</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>D</mi><mi>TV</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mn>0</mn></msub><mo>,</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>=</mo><mfrac><msub><mi>C</mi><mn>2</mn></msub><msub><mi>ε</mi><mi>min</mi></msub></mfrac></mrow><mo rspace="1.167em">,</mo><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mi>C</mi><mn>2</mn></msub><mo>:=</mo><mfrac><msub><mi>C</mi><mi>g</mi></msub><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>D</mi><mi>TV</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mn>0</mn></msub><mo>,</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">C_{1}:=\frac{C_{g}}{4{\varepsilon}_{\min}D_{\mathrm{TV}}^{2}(F_{0},\widehat{F}_{\bm{P}})}=\frac{C_{2}}{{\varepsilon}_{\min}},\quad\text{and}\quad C_{2}:=\frac{C_{g}}{4D_{\mathrm{TV}}^{2}(F_{0},\widehat{F}_{\bm{P}})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS6.SSS3.Px1.p1.3" class="ltx_p">With the above inequalities in place, we are now ready to prove (<a href="#A1.E15.1" title="Equation 15a ‣ Equation 15 ‣ Lemma A.1. ‣ A.6.1 Proof of Lemma ‣ A.6 Analysis for the Optimal Estimator ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15a</span></a>):</p>
<table id="A1.EGx29" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex43a"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex43a.m1" class="ltx_Math" alttext="\displaystyle{\mathbb{P}}" display="inline" intent=":literal"><semantics><mi>ℙ</mi><annotation encoding="application/x-tex">\displaystyle{\mathbb{P}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex43a.m2" class="ltx_Math" alttext="\displaystyle\left(\sup_{{\varepsilon}\in[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]}\left|\frac{{\mathrm{d}}\widetilde{{\mathcal{T}}}({\varepsilon})}{{\mathrm{d}}{\varepsilon}}-\EB\frac{{\mathrm{d}}\widetilde{{\mathcal{T}}}({\varepsilon})}{{\mathrm{d}}{\varepsilon}}\right|\geq\left(\frac{C_{1}}{{\varepsilon}_{\min}}+\frac{C_{2}}{{\varepsilon}_{\min}^{2}}\right)\sqrt{\frac{C\log n}{n}}\right)" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>ε</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ε</mi><mi>min</mi></msub><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mi>min</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow></mfrac></mstyle><mo>−</mo><mrow><mi>𝔼</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow></mfrac></mstyle></mrow></mrow><mo>|</mo></mrow></mrow><mo>≥</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>C</mi><mn>1</mn></msub><msub><mi>ε</mi><mi>min</mi></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msub><mi>C</mi><mn>2</mn></msub><msubsup><mi>ε</mi><mi>min</mi><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mi>n</mi></mfrac></mstyle></msqrt></mrow></mrow><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left(\sup_{{\varepsilon}\in[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]}\left|\frac{{\mathrm{d}}\widetilde{{\mathcal{T}}}({\varepsilon})}{{\mathrm{d}}{\varepsilon}}-\EB\frac{{\mathrm{d}}\widetilde{{\mathcal{T}}}({\varepsilon})}{{\mathrm{d}}{\varepsilon}}\right|\geq\left(\frac{C_{1}}{{\varepsilon}_{\min}}+\frac{C_{2}}{{\varepsilon}_{\min}^{2}}\right)\sqrt{\frac{C\log n}{n}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex44a"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex44a.m1" class="ltx_Math" alttext="\displaystyle\leq{\mathbb{P}}\left(\frac{\int\frac{|1-\widehat{g}|^{3}}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}]^{2}}{\mathrm{d}}{F}_{0}}{\left[\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}{F}_{0}\right]^{2}}\sup_{h\in\mathcal{H}_{1}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq\frac{C_{1}}{{\varepsilon}_{\min}}\sqrt{\frac{C\log n}{n}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∫</mo><mrow><mfrac><msup><mrow><mo stretchy="false">|</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">|</mo></mrow><mn>3</mn></msup><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow></mrow><msup><mrow><mo>[</mo><mrow><mo lspace="0em">∫</mo><mrow><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow></mrow><mo>]</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">sup</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>1</mn></msub></mrow></munder><mrow><mo>|</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow><mo>≥</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>C</mi><mn>1</mn></msub><msub><mi>ε</mi><mi>min</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mi>n</mi></mfrac></mstyle></msqrt></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq{\mathbb{P}}\left(\frac{\int\frac{|1-\widehat{g}|^{3}}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}]^{2}}{\mathrm{d}}{F}_{0}}{\left[\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}{F}_{0}\right]^{2}}\sup_{h\in\mathcal{H}_{1}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq\frac{C_{1}}{{\varepsilon}_{\min}}\sqrt{\frac{C\log n}{n}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex45a"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex45a.m1" class="ltx_Math" alttext="\displaystyle\qquad+{\mathbb{P}}\left(\frac{1}{\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}{F}_{0}}\sup_{h\in\mathcal{H}_{2}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq\frac{C_{2}}{{\varepsilon}_{\min}^{2}}\sqrt{\frac{C\log n}{n}}\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo>∫</mo><mrow><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">sup</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>2</mn></msub></mrow></munder><mrow><mo>|</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow><mo>≥</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>C</mi><mn>2</mn></msub><msubsup><mi>ε</mi><mi>min</mi><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mi>n</mi></mfrac></mstyle></msqrt></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad+{\mathbb{P}}\left(\frac{1}{\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}{F}_{0}}\sup_{h\in\mathcal{H}_{2}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq\frac{C_{2}}{{\varepsilon}_{\min}^{2}}\sqrt{\frac{C\log n}{n}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex46a"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex46a.m1" class="ltx_Math" alttext="\displaystyle\leq{\mathbb{P}}\left(\sup_{h\in\mathcal{H}_{1}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq\frac{1}{{\varepsilon}_{\min}}\sqrt{\frac{C\log n}{n}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>1</mn></msub></mrow></munder><mrow><mo>|</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>≥</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>ε</mi><mi>min</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mi>n</mi></mfrac></mstyle></msqrt></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq{\mathbb{P}}\left(\sup_{h\in\mathcal{H}_{1}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq\frac{1}{{\varepsilon}_{\min}}\sqrt{\frac{C\log n}{n}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex47a"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex47a.m1" class="ltx_Math" alttext="\displaystyle\qquad+{\mathbb{P}}\left(\sup_{h\in\mathcal{H}_{2}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq\frac{1}{{\varepsilon}_{\min}^{2}}\sqrt{\frac{C\log n}{n}}\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>2</mn></msub></mrow></munder><mrow><mo>|</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>≥</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msubsup><mi>ε</mi><mi>min</mi><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mi>n</mi></mfrac></mstyle></msqrt></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad+{\mathbb{P}}\left(\sup_{h\in\mathcal{H}_{2}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq\frac{1}{{\varepsilon}_{\min}^{2}}\sqrt{\frac{C\log n}{n}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex48a"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex48a.m1" class="ltx_Math" alttext="\displaystyle\overset{\eqref{eq:concentration-no-moment}}{\leq}\frac{8K}{{\varepsilon}_{\min}^{3}}\cdot\frac{1}{n^{C-1}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mo>≤</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#A1.E21" title="Equation 21 ‣ Lemma A.2 (High probability concentration). ‣ Proof of Lemma . ‣ A.6.3 Proof of Lemma ‣ A.6 Analysis for the Optimal Estimator ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">21</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><msubsup><mi>ε</mi><mi>min</mi><mn>3</mn></msubsup></mfrac></mstyle></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>n</mi><mrow><mi>C</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\eqref{eq:concentration-no-moment}}{\leq}\frac{8K}{{\varepsilon}_{\min}^{3}}\cdot\frac{1}{n^{C-1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS6.SSS3.Px1.p1.4" class="ltx_p">We can then rearrange the last inequality as follows:</p>
<table id="A1.Ex49a" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex49a.m1" class="ltx_Math" alttext="{\mathbb{P}}\left(\sup_{{\varepsilon}\in[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]}\left|\frac{{\mathrm{d}}\widetilde{{\mathcal{T}}}({\varepsilon})}{{\mathrm{d}}{\varepsilon}}-\EB\frac{{\mathrm{d}}\widetilde{{\mathcal{T}}}({\varepsilon})}{{\mathrm{d}}{\varepsilon}}\right|\geq\frac{C_{g}}{2{\varepsilon}_{\min}^{2}D_{\mathrm{TV}}^{2}(F_{0},\widehat{F}_{\bm{P}})}\sqrt{\frac{C\log n}{n}}\right)\leq\frac{8K}{{\varepsilon}_{\min}^{3}}\cdot\frac{1}{n^{C-1}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>ε</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ε</mi><mi>min</mi></msub><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mi>min</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mo>|</mo><mrow><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow></mfrac><mo>−</mo><mrow><mi>𝔼</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow></mfrac></mrow></mrow><mo>|</mo></mrow></mrow><mo>≥</mo><mrow><mfrac><msub><mi>C</mi><mi>g</mi></msub><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mi>min</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>D</mi><mi>TV</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mn>0</mn></msub><mo>,</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mi>n</mi></mfrac></msqrt></mrow></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><msubsup><mi>ε</mi><mi>min</mi><mn>3</mn></msubsup></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mn>1</mn><msup><mi>n</mi><mrow><mi>C</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathbb{P}}\left(\sup_{{\varepsilon}\in[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]}\left|\frac{{\mathrm{d}}\widetilde{{\mathcal{T}}}({\varepsilon})}{{\mathrm{d}}{\varepsilon}}-\EB\frac{{\mathrm{d}}\widetilde{{\mathcal{T}}}({\varepsilon})}{{\mathrm{d}}{\varepsilon}}\right|\geq\frac{C_{g}}{2{\varepsilon}_{\min}^{2}D_{\mathrm{TV}}^{2}(F_{0},\widehat{F}_{\bm{P}})}\sqrt{\frac{C\log n}{n}}\right)\leq\frac{8K}{{\varepsilon}_{\min}^{3}}\cdot\frac{1}{n^{C-1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS6.SSS3.Px1.p1.5" class="ltx_p">We complete the proof by noting that <math id="A1.SS6.SSS3.Px1.p1.m1" class="ltx_Math" alttext="C_{g}\geq 1" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>g</mi></msub><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">C_{g}\geq 1</annotation></semantics></math> and <math id="A1.SS6.SSS3.Px1.p1.m2" class="ltx_Math" alttext="D_{\mathrm{TV}}(F_{0},\widehat{F}_{\bm{P}})\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>D</mi><mi>TV</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mn>0</mn></msub><mo>,</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">D_{\mathrm{TV}}(F_{0},\widehat{F}_{\bm{P}})\leq 1</annotation></semantics></math>.</p>
</div>
</section>
<section id="A1.SS6.SSS3.Px2" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">With the moment condition <math id="A1.SS6.SSS3.Px2.m1" class="ltx_Math" alttext="\EB_{\bar{F}}[\widehat{g}]^{-2}&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">]</mo></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\EB_{\bar{F}}[\widehat{g}]^{-2}&lt;\infty</annotation></semantics></math>.</h6>

<div id="A1.SS6.SSS3.Px2.p1" class="ltx_para">
<p id="A1.SS6.SSS3.Px2.p1.1" class="ltx_p">When the moment condition <math id="A1.SS6.SSS3.Px2.p1.m1" class="ltx_Math" alttext="\EB_{\bar{F}}[\widehat{g}]^{-2}&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">]</mo></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\EB_{\bar{F}}[\widehat{g}]^{-2}&lt;\infty</annotation></semantics></math> holds, it also implies that <math id="A1.SS6.SSS3.Px2.p1.m2" class="ltx_Math" alttext="\EB_{F_{0}}[\widehat{g}]^{-2}&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><msub><mi>F</mi><mn>0</mn></msub></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">]</mo></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\EB_{F_{0}}[\widehat{g}]^{-2}&lt;\infty</annotation></semantics></math>. It then follows that:</p>
<table id="A1.Ex50" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex50.m1" class="ltx_Math" alttext="\frac{\left|\int\frac{[1-\widehat{g}]^{3}}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}]^{2}}{\mathrm{d}}{F}_{0}\right|}{\left[\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}{F}_{0}\right]^{2}}\leq\frac{\EB_{F_{0}}[\widehat{g}]^{3}+\EB_{F_{0}}[\widehat{g}]^{-2}}{\left[\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}{F}_{0}\right]^{2}}\leq C_{1}^{\prime},\quad\text{and}\quad\frac{1}{\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}{F}_{0}}\leq C_{2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mrow><mo>|</mo><mrow><mo lspace="0em">∫</mo><mrow><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mn>3</mn></msup><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow></mrow><mo>|</mo></mrow><msup><mrow><mo>[</mo><mrow><mo lspace="0em">∫</mo><mrow><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow></mrow><mo>]</mo></mrow><mn>2</mn></msup></mfrac><mo>≤</mo><mfrac><mrow><mrow><msub><mi>𝔼</mi><msub><mi>F</mi><mn>0</mn></msub></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">]</mo></mrow><mn>3</mn></msup></mrow><mo>+</mo><mrow><msub><mi>𝔼</mi><msub><mi>F</mi><mn>0</mn></msub></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">]</mo></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow></mrow><msup><mrow><mo>[</mo><mrow><mo lspace="0em">∫</mo><mrow><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow></mrow><mo>]</mo></mrow><mn>2</mn></msup></mfrac><mo>≤</mo><msubsup><mi>C</mi><mn>1</mn><mo>′</mo></msubsup></mrow><mo rspace="1.167em">,</mo><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mfrac><mn>1</mn><mrow><mo>∫</mo><mrow><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow></mrow></mfrac><mo>≤</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{\left|\int\frac{[1-\widehat{g}]^{3}}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}]^{2}}{\mathrm{d}}{F}_{0}\right|}{\left[\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}{F}_{0}\right]^{2}}\leq\frac{\EB_{F_{0}}[\widehat{g}]^{3}+\EB_{F_{0}}[\widehat{g}]^{-2}}{\left[\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}{F}_{0}\right]^{2}}\leq C_{1}^{\prime},\quad\text{and}\quad\frac{1}{\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}{F}_{0}}\leq C_{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS6.SSS3.Px2.p1.2" class="ltx_p">where the constants <math id="A1.SS6.SSS3.Px2.p1.m3" class="ltx_Math" alttext="C_{1}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mn>1</mn><mo>′</mo></msubsup><annotation encoding="application/x-tex">C_{1}^{\prime}</annotation></semantics></math> and <math id="A1.SS6.SSS3.Px2.p1.m4" class="ltx_Math" alttext="C_{2}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mn>2</mn></msub><annotation encoding="application/x-tex">C_{2}</annotation></semantics></math> are defined as</p>
<table id="A1.Ex51" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex51.m1" class="ltx_Math" alttext="C_{1}^{\prime}=\frac{C_{g}^{2}\left[\EB_{F_{0}}[\widehat{g}]^{3}+\EB_{F_{0}}[\widehat{g}]^{-2}\right]}{16D_{\mathrm{TV}}^{4}(F_{0},\widehat{F}_{\bm{P}})},\quad\text{and}\quad C_{2}=\frac{C_{g}}{4D_{\mathrm{TV}}^{2}(F_{0},\widehat{F}_{\bm{P}})}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>C</mi><mn>1</mn><mo>′</mo></msubsup><mo>=</mo><mfrac><mrow><msubsup><mi>C</mi><mi>g</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>𝔼</mi><msub><mi>F</mi><mn>0</mn></msub></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">]</mo></mrow><mn>3</mn></msup></mrow><mo>+</mo><mrow><msub><mi>𝔼</mi><msub><mi>F</mi><mn>0</mn></msub></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">]</mo></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow></mrow><mo>]</mo></mrow></mrow><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>D</mi><mi>TV</mi><mn>4</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mn>0</mn></msub><mo>,</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo rspace="1.167em">,</mo><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mi>C</mi><mn>2</mn></msub><mo>=</mo><mfrac><msub><mi>C</mi><mi>g</mi></msub><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>D</mi><mi>TV</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mn>0</mn></msub><mo>,</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">C_{1}^{\prime}=\frac{C_{g}^{2}\left[\EB_{F_{0}}[\widehat{g}]^{3}+\EB_{F_{0}}[\widehat{g}]^{-2}\right]}{16D_{\mathrm{TV}}^{4}(F_{0},\widehat{F}_{\bm{P}})},\quad\text{and}\quad C_{2}=\frac{C_{g}}{4D_{\mathrm{TV}}^{2}(F_{0},\widehat{F}_{\bm{P}})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS6.SSS3.Px2.p1.3" class="ltx_p">With the concentration result in (<a href="#A1.E22" title="Equation 22 ‣ Lemma A.2 (High probability concentration). ‣ Proof of Lemma . ‣ A.6.3 Proof of Lemma ‣ A.6 Analysis for the Optimal Estimator ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>) in mind, we define the following deviation thresholds:</p>
<table id="A1.Ex52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex52.m1" class="ltx_Math" alttext="t_{1}=\frac{C\log n}{n{\varepsilon}_{\min}}+\sqrt{\frac{CM\log n}{n}},\quad\text{and}\quad t_{2}=\frac{C\log n}{n{\varepsilon}_{\min}^{2}}+\sqrt{\frac{CM\log n}{n{\varepsilon}_{\min}^{2}}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>=</mo><mrow><mfrac><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ε</mi><mi>min</mi></msub></mrow></mfrac><mo>+</mo><msqrt><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mi>n</mi></mfrac></msqrt></mrow></mrow><mo rspace="1.167em">,</mo><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>=</mo><mrow><mfrac><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mi>min</mi><mn>2</mn></msubsup></mrow></mfrac><mo>+</mo><msqrt><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mi>min</mi><mn>2</mn></msubsup></mrow></mfrac></msqrt></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">t_{1}=\frac{C\log n}{n{\varepsilon}_{\min}}+\sqrt{\frac{CM\log n}{n}},\quad\text{and}\quad t_{2}=\frac{C\log n}{n{\varepsilon}_{\min}^{2}}+\sqrt{\frac{CM\log n}{n{\varepsilon}_{\min}^{2}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS6.SSS3.Px2.p1.4" class="ltx_p">With the above bounds and notation in place, we are now ready to prove (<a href="#A1.E15.1" title="Equation 15a ‣ Equation 15 ‣ Lemma A.1. ‣ A.6.1 Proof of Lemma ‣ A.6 Analysis for the Optimal Estimator ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15a</span></a>):</p>
<table id="A1.EGx30" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex53.m1" class="ltx_Math" alttext="\displaystyle{\mathbb{P}}" display="inline" intent=":literal"><semantics><mi>ℙ</mi><annotation encoding="application/x-tex">\displaystyle{\mathbb{P}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex53.m2" class="ltx_Math" alttext="\displaystyle\left(\sup_{{\varepsilon}\in[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]}\left|\frac{{\mathrm{d}}\widetilde{{\mathcal{T}}}({\varepsilon})}{{\mathrm{d}}{\varepsilon}}-\EB\frac{{\mathrm{d}}\widetilde{{\mathcal{T}}}({\varepsilon})}{{\mathrm{d}}{\varepsilon}}\right|\geq C_{1}^{\prime}t_{1}+C_{2}t_{2}\right)" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>ε</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ε</mi><mi>min</mi></msub><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mi>min</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow></mfrac></mstyle><mo>−</mo><mrow><mi>𝔼</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow></mfrac></mstyle></mrow></mrow><mo>|</mo></mrow></mrow><mo>≥</mo><mrow><mrow><msubsup><mi>C</mi><mn>1</mn><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mn>2</mn></msub></mrow></mrow></mrow><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left(\sup_{{\varepsilon}\in[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]}\left|\frac{{\mathrm{d}}\widetilde{{\mathcal{T}}}({\varepsilon})}{{\mathrm{d}}{\varepsilon}}-\EB\frac{{\mathrm{d}}\widetilde{{\mathcal{T}}}({\varepsilon})}{{\mathrm{d}}{\varepsilon}}\right|\geq C_{1}^{\prime}t_{1}+C_{2}t_{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex54.m1" class="ltx_Math" alttext="\displaystyle\leq{\mathbb{P}}\left(\frac{\left|\int\frac{[1-\widehat{g}]^{3}}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}]^{2}}{\mathrm{d}}{F}_{0}\right|}{\left[\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}{F}_{0}\right]^{2}}\sup_{h\in\mathcal{H}_{1}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq C_{1}^{\prime}t_{1}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>|</mo><mrow><mo lspace="0em">∫</mo><mrow><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mn>3</mn></msup><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow></mrow><mo>|</mo></mrow><msup><mrow><mo>[</mo><mrow><mo lspace="0em">∫</mo><mrow><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow></mrow><mo>]</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">sup</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>1</mn></msub></mrow></munder><mrow><mo>|</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow><mo>≥</mo><mrow><msubsup><mi>C</mi><mn>1</mn><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mn>1</mn></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq{\mathbb{P}}\left(\frac{\left|\int\frac{[1-\widehat{g}]^{3}}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}]^{2}}{\mathrm{d}}{F}_{0}\right|}{\left[\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}{F}_{0}\right]^{2}}\sup_{h\in\mathcal{H}_{1}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq C_{1}^{\prime}t_{1}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex55"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex55.m1" class="ltx_Math" alttext="\displaystyle\qquad+{\mathbb{P}}\left(\frac{1}{\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}{F}_{0}}\sup_{h\in\mathcal{H}_{2}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq C_{2}t_{2}\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo>∫</mo><mrow><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">sup</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>2</mn></msub></mrow></munder><mrow><mo>|</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow><mo>≥</mo><mrow><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mn>2</mn></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad+{\mathbb{P}}\left(\frac{1}{\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}{F}_{0}}\sup_{h\in\mathcal{H}_{2}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq C_{2}t_{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex56"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex56.m1" class="ltx_Math" alttext="\displaystyle\leq{\mathbb{P}}\left(\sup_{h\in\mathcal{H}_{1}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq t_{1}\right)+{\mathbb{P}}\left(\sup_{h\in\mathcal{H}_{2}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq t_{2}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>1</mn></msub></mrow></munder><mrow><mo>|</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>≥</mo><msub><mi>t</mi><mn>1</mn></msub></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>2</mn></msub></mrow></munder><mrow><mo>|</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>≥</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq{\mathbb{P}}\left(\sup_{h\in\mathcal{H}_{1}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq t_{1}\right)+{\mathbb{P}}\left(\sup_{h\in\mathcal{H}_{2}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq t_{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex57"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex57.m1" class="ltx_Math" alttext="\displaystyle\overset{\eqref{eq:concentration-with-moment}}{\leq}\frac{8K}{{\varepsilon}_{\min}^{3}}\cdot\frac{1}{n^{C-1}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mo>≤</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#A1.E22" title="Equation 22 ‣ Lemma A.2 (High probability concentration). ‣ Proof of Lemma . ‣ A.6.3 Proof of Lemma ‣ A.6 Analysis for the Optimal Estimator ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">22</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><msubsup><mi>ε</mi><mi>min</mi><mn>3</mn></msubsup></mfrac></mstyle></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>n</mi><mrow><mi>C</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\eqref{eq:concentration-with-moment}}{\leq}\frac{8K}{{\varepsilon}_{\min}^{3}}\cdot\frac{1}{n^{C-1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS6.SSS3.Px2.p1.5" class="ltx_p">Using the fact that <math id="A1.SS6.SSS3.Px2.p1.m5" class="ltx_Math" alttext="t_{1}\leq t_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>≤</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">t_{1}\leq t_{2}</annotation></semantics></math> and defining <math id="A1.SS6.SSS3.Px2.p1.m6" class="ltx_Math" alttext="C_{0}^{\prime}:=C_{1}^{\prime}+C_{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>C</mi><mn>0</mn><mo>′</mo></msubsup><mo>:=</mo><mrow><msubsup><mi>C</mi><mn>1</mn><mo>′</mo></msubsup><mo>+</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">C_{0}^{\prime}:=C_{1}^{\prime}+C_{2}</annotation></semantics></math>, we can now rearrange the last inequality as follows:</p>
<table id="A1.Ex58" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex58.m1" class="ltx_Math" alttext="{\mathbb{P}}\left(\sup_{{\varepsilon}\in[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]}\left|\frac{{\mathrm{d}}\widetilde{{\mathcal{T}}}({\varepsilon})}{{\mathrm{d}}{\varepsilon}}-\EB\frac{{\mathrm{d}}\widetilde{{\mathcal{T}}}({\varepsilon})}{{\mathrm{d}}{\varepsilon}}\right|\geq C_{0}^{\prime}\left[\frac{C\log n}{n{\varepsilon}_{\min}^{2}}+\sqrt{\frac{CM\log n}{n{\varepsilon}_{\min}^{2}}}\right]\right)\leq\frac{8K}{{\varepsilon}_{\min}^{3}}\cdot\frac{1}{n^{C-1}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>ε</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ε</mi><mi>min</mi></msub><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mi>min</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mo>|</mo><mrow><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow></mfrac><mo>−</mo><mrow><mi>𝔼</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow></mfrac></mrow></mrow><mo>|</mo></mrow></mrow><mo>≥</mo><mrow><msubsup><mi>C</mi><mn>0</mn><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mfrac><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mi>min</mi><mn>2</mn></msubsup></mrow></mfrac><mo>+</mo><msqrt><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mi>min</mi><mn>2</mn></msubsup></mrow></mfrac></msqrt></mrow><mo>]</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><msubsup><mi>ε</mi><mi>min</mi><mn>3</mn></msubsup></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mn>1</mn><msup><mi>n</mi><mrow><mi>C</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathbb{P}}\left(\sup_{{\varepsilon}\in[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]}\left|\frac{{\mathrm{d}}\widetilde{{\mathcal{T}}}({\varepsilon})}{{\mathrm{d}}{\varepsilon}}-\EB\frac{{\mathrm{d}}\widetilde{{\mathcal{T}}}({\varepsilon})}{{\mathrm{d}}{\varepsilon}}\right|\geq C_{0}^{\prime}\left[\frac{C\log n}{n{\varepsilon}_{\min}^{2}}+\sqrt{\frac{CM\log n}{n{\varepsilon}_{\min}^{2}}}\right]\right)\leq\frac{8K}{{\varepsilon}_{\min}^{3}}\cdot\frac{1}{n^{C-1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS6.SSS3.Px2.p1.6" class="ltx_p">For notation simplicity, noting that <math id="A1.SS6.SSS3.Px2.p1.m7" class="ltx_Math" alttext="C_{g}\geq 1,D_{\mathrm{TV}}(F_{0},\widehat{F}_{\bm{P}})\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mi>g</mi></msub><mo>≥</mo><mn>1</mn></mrow><mo>,</mo><mrow><mrow><msub><mi>D</mi><mi>TV</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mn>0</mn></msub><mo>,</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">C_{g}\geq 1,D_{\mathrm{TV}}(F_{0},\widehat{F}_{\bm{P}})\leq 1</annotation></semantics></math>, and <math id="A1.SS6.SSS3.Px2.p1.m8" class="ltx_Math" alttext="\EB_{F_{0}}[\widehat{g}]^{-2}\geq[\EB_{F_{0}}\widehat{g}]^{-2}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><msub><mi>F</mi><mn>0</mn></msub></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">]</mo></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><mo>≥</mo><msup><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝔼</mi><msub><mi>F</mi><mn>0</mn></msub></msub><mo lspace="0.167em">⁡</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\EB_{F_{0}}[\widehat{g}]^{-2}\geq[\EB_{F_{0}}\widehat{g}]^{-2}=1</annotation></semantics></math>, we introduce a slightly larger but more convenient upper bound <math id="A1.SS6.SSS3.Px2.p1.m9" class="ltx_Math" alttext="C_{0}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mn>0</mn><mo>′</mo></msubsup><annotation encoding="application/x-tex">C_{0}^{\prime}</annotation></semantics></math> given by</p>
<table id="A1.Ex59" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex59.m1" class="ltx_Math" alttext="C_{0}^{\prime}=\frac{C_{g}^{2}\left[\EB_{F_{0}}[\widehat{g}]^{3}+\EB_{F_{0}}[\widehat{g}]^{-2}\right]}{D_{\mathrm{TV}}^{4}(F_{0},\widehat{F}_{\bm{P}})}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>C</mi><mn>0</mn><mo>′</mo></msubsup><mo>=</mo><mfrac><mrow><msubsup><mi>C</mi><mi>g</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>𝔼</mi><msub><mi>F</mi><mn>0</mn></msub></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">]</mo></mrow><mn>3</mn></msup></mrow><mo>+</mo><mrow><msub><mi>𝔼</mi><msub><mi>F</mi><mn>0</mn></msub></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">]</mo></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow></mrow><mo>]</mo></mrow></mrow><mrow><msubsup><mi>D</mi><mi>TV</mi><mn>4</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mn>0</mn></msub><mo>,</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">C_{0}^{\prime}=\frac{C_{g}^{2}\left[\EB_{F_{0}}[\widehat{g}]^{3}+\EB_{F_{0}}[\widehat{g}]^{-2}\right]}{D_{\mathrm{TV}}^{4}(F_{0},\widehat{F}_{\bm{P}})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS6.SSS3.Px2.p1.7" class="ltx_p">It is straightforward to verify that <math id="A1.SS6.SSS3.Px2.p1.m10" class="ltx_Math" alttext="C_{0}^{\prime}\geq C_{1}^{\prime}+C_{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>C</mi><mn>0</mn><mo>′</mo></msubsup><mo>≥</mo><mrow><msubsup><mi>C</mi><mn>1</mn><mo>′</mo></msubsup><mo>+</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">C_{0}^{\prime}\geq C_{1}^{\prime}+C_{2}</annotation></semantics></math> still holds.
∎</p>
</div>
</section>
</section>
<section id="A1.SS6.SSS4" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">A.6.4 </span>Proof of Theorem <a href="#A1.Thmtheorem2" title="Theorem A.2 (Full version of the second part of Theorem ; proof in Appendix ). ‣ A.6.2 Proof of Theorem ‣ A.6 Analysis for the Optimal Estimator ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2</span></a></h5>

<div id="A1.SS6.SSS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Theorem <a href="#A1.Thmtheorem2" title="Theorem A.2 (Full version of the second part of Theorem ; proof in Appendix ). ‣ A.6.2 Proof of Theorem ‣ A.6 Analysis for the Optimal Estimator ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2</span></a>.</h6>
<div id="A1.SS6.SSS4.p1" class="ltx_para">
<p id="A1.SS6.SSS4.p1.1" class="ltx_p"><span id="A1.SS6.SSS4.p1.1.1" class="ltx_text">By the moment conditions, <math id="A1.SS6.SSS4.p1.m1" class="ltx_Math" alttext="0&lt;D_{\mathrm{TV}}(F_{0},\widehat{F}_{\bm{P}})" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mrow><msub><mi>D</mi><mi>TV</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mn>0</mn></msub><mo>,</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">0&lt;D_{\mathrm{TV}}(F_{0},\widehat{F}_{\bm{P}})</annotation></semantics></math>.
By definition, <math id="A1.SS6.SSS4.p1.m2" class="ltx_Math" alttext="{\widehat{{\varepsilon}}_{\mathrm{opt}}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>opt</mi></msub><annotation encoding="application/x-tex">{\widehat{{\varepsilon}}_{\mathrm{opt}}}</annotation></semantics></math> is the fixed point of the equation <math id="A1.SS6.SSS4.p1.m3" class="ltx_Math" alttext="{\varepsilon}=\widehat{{\mathcal{T}}}({\varepsilon})={\mathcal{P}}\circ\widetilde{{\mathcal{T}}}({\varepsilon})" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>=</mo><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>~</mo></mover></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\varepsilon}=\widehat{{\mathcal{T}}}({\varepsilon})={\mathcal{P}}\circ\widetilde{{\mathcal{T}}}({\varepsilon})</annotation></semantics></math>, where the operators <math id="A1.SS6.SSS4.p1.m4" class="ltx_Math" alttext="\widehat{{\mathcal{T}}},{\mathcal{P}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>^</mo></mover><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow><annotation encoding="application/x-tex">\widehat{{\mathcal{T}}},{\mathcal{P}}</annotation></semantics></math> and <math id="A1.SS6.SSS4.p1.m5" class="ltx_Math" alttext="\widetilde{{\mathcal{T}}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{{\mathcal{T}}}</annotation></semantics></math> are defined in (<a href="#A1.E14" title="Equation 14 ‣ A.6.1 Proof of Lemma ‣ A.6 Analysis for the Optimal Estimator ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>). Let the true proportion that generates the observed samples <math id="A1.SS6.SSS4.p1.m6" class="ltx_Math" alttext="Y_{1},\ldots,Y_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>Y</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">Y_{1},\ldots,Y_{n}</annotation></semantics></math> be denoted by <math id="A1.SS6.SSS4.p1.m7" class="ltx_Math" alttext="{\varepsilon}_{0}" display="inline" intent=":literal"><semantics><msub><mi>ε</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\varepsilon}_{0}</annotation></semantics></math>. Then, <math id="A1.SS6.SSS4.p1.m8" class="ltx_Math" alttext="{\varepsilon}_{0}" display="inline" intent=":literal"><semantics><msub><mi>ε</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\varepsilon}_{0}</annotation></semantics></math> satisfies the fixed-point equation <math id="A1.SS6.SSS4.p1.m9" class="ltx_Math" alttext="{\varepsilon}_{0}={\mathcal{T}}({\varepsilon}_{0})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ε</mi><mn>0</mn></msub><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\varepsilon}_{0}={\mathcal{T}}({\varepsilon}_{0})</annotation></semantics></math>, where <math id="A1.SS6.SSS4.p1.m10" class="ltx_Math" alttext="{\mathcal{T}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒯</mi><annotation encoding="application/x-tex">{\mathcal{T}}</annotation></semantics></math> is essentially an identity mapping:</span></p>
<table id="A1.Ex60" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex60.m1" class="ltx_Math" alttext="{{\mathcal{T}}}({\varepsilon})=\frac{\int v_{\mathrm{opt}}({\varepsilon},x)\left[{\mathrm{d}}{F}_{0}(x)-{\mathrm{d}}\bar{F}(x)\right]}{\int v_{\mathrm{opt}}({\varepsilon},x)\left[{\mathrm{d}}{F}_{0}(x)-{\mathrm{d}}\bar{F}_{\bm{P}}(x)\right]}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mo>∫</mo><mrow><msub><mi>v</mi><mi>opt</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mrow><mo>∫</mo><mrow><msub><mi>v</mi><mi>opt</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{{\mathcal{T}}}({\varepsilon})=\frac{\int v_{\mathrm{opt}}({\varepsilon},x)\left[{\mathrm{d}}{F}_{0}(x)-{\mathrm{d}}\bar{F}(x)\right]}{\int v_{\mathrm{opt}}({\varepsilon},x)\left[{\mathrm{d}}{F}_{0}(x)-{\mathrm{d}}\bar{F}_{\bm{P}}(x)\right]},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS6.SSS4.p1.2" class="ltx_p"><span id="A1.SS6.SSS4.p1.2.1" class="ltx_text">and <math id="A1.SS6.SSS4.p1.m11" class="ltx_Math" alttext="v_{\mathrm{opt}}({\varepsilon},x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi>opt</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">v_{\mathrm{opt}}({\varepsilon},x)</annotation></semantics></math> is the optimal weight function.
To see this, we substitute the definition of <math id="A1.SS6.SSS4.p1.m12" class="ltx_Math" alttext="v_{\mathrm{opt}}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>opt</mi></msub><annotation encoding="application/x-tex">v_{\mathrm{opt}}</annotation></semantics></math> and get</span></p>
<table id="A1.Ex61" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex61.m1" class="ltx_Math" alttext="{{\mathcal{T}}}({\varepsilon})=\frac{\int\frac{1-{g}(x)}{(1-{\varepsilon})+{\varepsilon}{g}(x)}\left[{\mathrm{d}}F_{0}(x)-{\mathrm{d}}\bar{F}(x)\right]}{\int\frac{[1-{g}(x)]^{2}}{(1-{\varepsilon})+{\varepsilon}{g}(x)}{\mathrm{d}}{F}_{0}(x)}={\varepsilon}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mo>∫</mo><mrow><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mrow><mo>∫</mo><mrow><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo>=</mo><mi>ε</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{{\mathcal{T}}}({\varepsilon})=\frac{\int\frac{1-{g}(x)}{(1-{\varepsilon})+{\varepsilon}{g}(x)}\left[{\mathrm{d}}F_{0}(x)-{\mathrm{d}}\bar{F}(x)\right]}{\int\frac{[1-{g}(x)]^{2}}{(1-{\varepsilon})+{\varepsilon}{g}(x)}{\mathrm{d}}{F}_{0}(x)}={\varepsilon}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS6.SSS4.p2" class="ltx_para">
<p id="A1.SS6.SSS4.p2.1" class="ltx_p"><span id="A1.SS6.SSS4.p2.1.1" class="ltx_text">As <math id="A1.SS6.SSS4.p2.m1" class="ltx_Math" alttext="{\widehat{{\varepsilon}}_{\mathrm{opt}}}\in[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>opt</mi></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ε</mi><mi>min</mi></msub><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mi>min</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\widehat{{\varepsilon}}_{\mathrm{opt}}}\in[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]</annotation></semantics></math> and <math id="A1.SS6.SSS4.p2.m2" class="ltx_Math" alttext="{\varepsilon}_{0}\in[0,1]" display="inline" intent=":literal"><semantics><mrow><msub><mi>ε</mi><mn>0</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\varepsilon}_{0}\in[0,1]</annotation></semantics></math> are solutions to their respective fixed-point equations, we have</span></p>
<table id="A1.EGx31" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex62"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex62.m1" class="ltx_Math" alttext="\displaystyle|{\widehat{{\varepsilon}}_{\mathrm{opt}}}-{\varepsilon}_{0}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>opt</mi></msub><mo>−</mo><msub><mi>ε</mi><mn>0</mn></msub></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle|{\widehat{{\varepsilon}}_{\mathrm{opt}}}-{\varepsilon}_{0}|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex62.m2" class="ltx_Math" alttext="\displaystyle\leq|{\widehat{{\varepsilon}}_{\mathrm{opt}}}-{\mathcal{P}}({\varepsilon}_{0})|+|{\varepsilon}_{0}-{\mathcal{P}}({\varepsilon}_{0})|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>opt</mi></msub><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>ε</mi><mn>0</mn></msub><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq|{\widehat{{\varepsilon}}_{\mathrm{opt}}}-{\mathcal{P}}({\varepsilon}_{0})|+|{\varepsilon}_{0}-{\mathcal{P}}({\varepsilon}_{0})|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex63.m1" class="ltx_math_unparsed" alttext="\displaystyle\overset{(a)}{\leq}|\widehat{{\mathcal{T}}}({\widehat{{\varepsilon}}_{\mathrm{opt}}})-{{\mathcal{T}}}\circ{\mathcal{P}}({\varepsilon}_{0})|+{\varepsilon}_{\min}{\bf 1}\{{\varepsilon}\notin[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]\}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">a</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo fence="false" lspace="0em" rspace="0.167em" stretchy="false">|</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>opt</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo fence="false" stretchy="false">|</mo><mo lspace="0em">+</mo><msub><mi>ε</mi><mi>min</mi></msub><mn>𝟏</mn><mrow><mo stretchy="false">{</mo><mi>ε</mi><mo>∉</mo><mrow><mo stretchy="false">[</mo><msub><mi>ε</mi><mi>min</mi></msub><mo>,</mo><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mi>min</mi></msub><mo stretchy="false">]</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(a)}{\leq}|\widehat{{\mathcal{T}}}({\widehat{{\varepsilon}}_{\mathrm{opt}}})-{{\mathcal{T}}}\circ{\mathcal{P}}({\varepsilon}_{0})|+{\varepsilon}_{\min}{\bf 1}\{{\varepsilon}\notin[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex64"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex64.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq|\widehat{{\mathcal{T}}}({\widehat{{\varepsilon}}_{\mathrm{opt}}})-\widehat{{\mathcal{T}}}\circ{\mathcal{P}}({\varepsilon}_{0})|+|\widehat{{\mathcal{T}}}\circ{\mathcal{P}}({\varepsilon}_{0})-{{\mathcal{T}}}\circ{\mathcal{P}}({\varepsilon}_{0})|+{\varepsilon}_{\min}{\bf 1}\{{\varepsilon}\notin[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]\}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">≤</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>opt</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>^</mo></mover><mo lspace="0.222em" rspace="0.222em">∘</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo fence="false" stretchy="false">|</mo><mo lspace="0em" rspace="0em">+</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>^</mo></mover><mo lspace="0.222em" rspace="0.222em">∘</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo fence="false" stretchy="false">|</mo><mo lspace="0em">+</mo><msub><mi>ε</mi><mi>min</mi></msub><mn>𝟏</mn><mrow><mo stretchy="false">{</mo><mi>ε</mi><mo>∉</mo><mrow><mo stretchy="false">[</mo><msub><mi>ε</mi><mi>min</mi></msub><mo>,</mo><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mi>min</mi></msub><mo stretchy="false">]</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq|\widehat{{\mathcal{T}}}({\widehat{{\varepsilon}}_{\mathrm{opt}}})-\widehat{{\mathcal{T}}}\circ{\mathcal{P}}({\varepsilon}_{0})|+|\widehat{{\mathcal{T}}}\circ{\mathcal{P}}({\varepsilon}_{0})-{{\mathcal{T}}}\circ{\mathcal{P}}({\varepsilon}_{0})|+{\varepsilon}_{\min}{\bf 1}\{{\varepsilon}\notin[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex65.m1" class="ltx_math_unparsed" alttext="\displaystyle\overset{(b)}{\leq}|\widetilde{{\mathcal{T}}}({\widehat{{\varepsilon}}_{\mathrm{opt}}})-\widetilde{{\mathcal{T}}}\circ{\mathcal{P}}({\varepsilon}_{0})|+|\widetilde{{\mathcal{T}}}\circ{\mathcal{P}}({\varepsilon}_{0})-{{\mathcal{T}}}\circ{\mathcal{P}}({\varepsilon}_{0})|+{\varepsilon}_{\min}{\bf 1}\{{\varepsilon}\notin[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]\}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">b</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo fence="false" lspace="0em" rspace="0.167em" stretchy="false">|</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>opt</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>~</mo></mover><mo lspace="0.222em" rspace="0.222em">∘</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo fence="false" stretchy="false">|</mo><mo lspace="0em" rspace="0em">+</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>~</mo></mover><mo lspace="0.222em" rspace="0.222em">∘</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo fence="false" stretchy="false">|</mo><mo lspace="0em">+</mo><msub><mi>ε</mi><mi>min</mi></msub><mn>𝟏</mn><mrow><mo stretchy="false">{</mo><mi>ε</mi><mo>∉</mo><mrow><mo stretchy="false">[</mo><msub><mi>ε</mi><mi>min</mi></msub><mo>,</mo><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mi>min</mi></msub><mo stretchy="false">]</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(b)}{\leq}|\widetilde{{\mathcal{T}}}({\widehat{{\varepsilon}}_{\mathrm{opt}}})-\widetilde{{\mathcal{T}}}\circ{\mathcal{P}}({\varepsilon}_{0})|+|\widetilde{{\mathcal{T}}}\circ{\mathcal{P}}({\varepsilon}_{0})-{{\mathcal{T}}}\circ{\mathcal{P}}({\varepsilon}_{0})|+{\varepsilon}_{\min}{\bf 1}\{{\varepsilon}\notin[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex66"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex66.m1" class="ltx_math_unparsed" alttext="\displaystyle\overset{(c)}{\leq}L\cdot|{\widehat{{\varepsilon}}_{\mathrm{opt}}}-{\mathcal{P}}({\varepsilon}_{0})|+|\widetilde{{\mathcal{T}}}\circ{\mathcal{P}}({\varepsilon}_{0})-{{\mathcal{T}}}\circ{\mathcal{P}}({\varepsilon}_{0})|+{\varepsilon}_{\min}{\bf 1}\{{\varepsilon}\notin[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]\}," display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">c</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mi>L</mi><mo lspace="0.222em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>opt</mi></msub><mo>−</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo fence="false" stretchy="false">|</mo><mo lspace="0em" rspace="0em">+</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>~</mo></mover><mo lspace="0.222em" rspace="0.222em">∘</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo fence="false" stretchy="false">|</mo><mo lspace="0em">+</mo><msub><mi>ε</mi><mi>min</mi></msub><mn>𝟏</mn><mrow><mo stretchy="false">{</mo><mi>ε</mi><mo>∉</mo><mrow><mo stretchy="false">[</mo><msub><mi>ε</mi><mi>min</mi></msub><mo>,</mo><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mi>min</mi></msub><mo stretchy="false">]</mo></mrow><mo stretchy="false">}</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(c)}{\leq}L\cdot|{\widehat{{\varepsilon}}_{\mathrm{opt}}}-{\mathcal{P}}({\varepsilon}_{0})|+|\widetilde{{\mathcal{T}}}\circ{\mathcal{P}}({\varepsilon}_{0})-{{\mathcal{T}}}\circ{\mathcal{P}}({\varepsilon}_{0})|+{\varepsilon}_{\min}{\bf 1}\{{\varepsilon}\notin[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS6.SSS4.p2.2" class="ltx_p"><span id="A1.SS6.SSS4.p2.2.1" class="ltx_text">where <math id="A1.SS6.SSS4.p2.m3" class="ltx_Math" alttext="(a)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a)</annotation></semantics></math> uses the relation that <math id="A1.SS6.SSS4.p2.m4" class="ltx_math_unparsed" alttext="|{\varepsilon}_{0}-{\mathcal{P}}({\varepsilon}_{0})|\leq{\varepsilon}_{\min}{\bf 1}\{{\varepsilon}\notin[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]\}" display="inline" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>ε</mi><mn>0</mn></msub><mo>−</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">≤</mo><msub><mi>ε</mi><mi>min</mi></msub><mn>𝟏</mn><mrow><mo stretchy="false">{</mo><mi>ε</mi><mo>∉</mo><mrow><mo stretchy="false">[</mo><msub><mi>ε</mi><mi>min</mi></msub><mo>,</mo><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mi>min</mi></msub><mo stretchy="false">]</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">|{\varepsilon}_{0}-{\mathcal{P}}({\varepsilon}_{0})|\leq{\varepsilon}_{\min}{\bf 1}\{{\varepsilon}\notin[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]\}</annotation></semantics></math>.
This is because we have <math id="A1.SS6.SSS4.p2.m5" class="ltx_Math" alttext="|{\varepsilon}_{0}-{\mathcal{P}}({\varepsilon}_{0})|=0" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>ε</mi><mn>0</mn></msub><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">|{\varepsilon}_{0}-{\mathcal{P}}({\varepsilon}_{0})|=0</annotation></semantics></math> if <math id="A1.SS6.SSS4.p2.m6" class="ltx_Math" alttext="{\varepsilon}_{0}" display="inline" intent=":literal"><semantics><msub><mi>ε</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\varepsilon}_{0}</annotation></semantics></math> is within the interval <math id="A1.SS6.SSS4.p2.m7" class="ltx_Math" alttext="[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ε</mi><mi>min</mi></msub><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mi>min</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]</annotation></semantics></math>; otherwise, <math id="A1.SS6.SSS4.p2.m8" class="ltx_Math" alttext="|{\varepsilon}_{0}-{\mathcal{P}}({\varepsilon}_{0})|\leq{\varepsilon}_{\min}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>ε</mi><mn>0</mn></msub><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><msub><mi>ε</mi><mi>min</mi></msub></mrow><annotation encoding="application/x-tex">|{\varepsilon}_{0}-{\mathcal{P}}({\varepsilon}_{0})|\leq{\varepsilon}_{\min}</annotation></semantics></math>.
Here <math id="A1.SS6.SSS4.p2.m9" class="ltx_Math" alttext="(b)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b)</annotation></semantics></math> uses the relation <math id="A1.SS6.SSS4.p2.m10" class="ltx_Math" alttext="{\mathcal{P}}\circ{\mathcal{T}}\circ{\mathcal{P}}={\mathcal{T}}\circ{\mathcal{P}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{P}}\circ{\mathcal{T}}\circ{\mathcal{P}}={\mathcal{T}}\circ{\mathcal{P}}</annotation></semantics></math>, and <math id="A1.SS6.SSS4.p2.m11" class="ltx_Math" alttext="(c)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(c)</annotation></semantics></math> uses the fact that <math id="A1.SS6.SSS4.p2.m12" class="ltx_Math" alttext="\widetilde{{\mathcal{T}}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{{\mathcal{T}}}</annotation></semantics></math> is <math id="A1.SS6.SSS4.p2.m13" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>-Lipschitz continuous, where</span></p>
<table id="A1.Ex67" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex67.m1" class="ltx_Math" alttext="L=\sup_{{\varepsilon}\in[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]}\left|\frac{{\mathrm{d}}\widetilde{{\mathcal{T}}}({\varepsilon})}{{\mathrm{d}}{\varepsilon}}\right|." display="block" intent=":literal"><semantics><mrow><mrow><mi>L</mi><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>ε</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ε</mi><mi>min</mi></msub><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mi>min</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mo>|</mo><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow></mfrac><mo>|</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">L=\sup_{{\varepsilon}\in[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]}\left|\frac{{\mathrm{d}}\widetilde{{\mathcal{T}}}({\varepsilon})}{{\mathrm{d}}{\varepsilon}}\right|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS6.SSS4.p2.3" class="ltx_p"><span id="A1.SS6.SSS4.p2.3.1" class="ltx_text">Rearranging the resulting inequality yields</span></p>
<table id="A1.E23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E23.m1" class="ltx_Math" alttext="|{\widehat{{\varepsilon}}_{\mathrm{opt}}}-{\varepsilon}_{0}|\leq\frac{|\widetilde{{\mathcal{T}}}\circ{\mathcal{P}}({\varepsilon}_{0})-{{\mathcal{T}}}\circ{\mathcal{P}}({\varepsilon}_{0})|+2{\varepsilon}_{\min}{\bf 1}\{{\varepsilon}\notin[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]\}}{1-L}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>opt</mi></msub><mo>−</mo><msub><mi>ε</mi><mn>0</mn></msub></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mfrac><mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>~</mo></mover><mo lspace="0.222em" rspace="0.222em">∘</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">(</mo><mi>ε</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo>−</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">(</mo><mi>ε</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo fence="false" stretchy="false">|</mo><mo lspace="0em">+</mo><mn>2</mn><mi>ε</mi><msub><mrow></mrow><mi>min</mi></msub><mn>𝟏</mn><mo stretchy="false">{</mo><mi>ε</mi><mo>∉</mo><mo stretchy="false">[</mo><mi>ε</mi><msub><mrow></mrow><mi>min</mi></msub><mo>,</mo><mn>1</mn><mo>−</mo><mi>ε</mi><msub><mrow></mrow><mi>min</mi></msub><mo stretchy="false">]</mo><mo stretchy="false">}</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>L</mi></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|{\widehat{{\varepsilon}}_{\mathrm{opt}}}-{\varepsilon}_{0}|\leq\frac{|\widetilde{{\mathcal{T}}}\circ{\mathcal{P}}({\varepsilon}_{0})-{{\mathcal{T}}}\circ{\mathcal{P}}({\varepsilon}_{0})|+2{\varepsilon}_{\min}{\bf 1}\{{\varepsilon}\notin[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]\}}{1-L}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS6.SSS4.p3" class="ltx_para">
<p id="A1.SS6.SSS4.p3.1" class="ltx_p"><span id="A1.SS6.SSS4.p3.1.1" class="ltx_text">Without loss of generality, we assume <math id="A1.SS6.SSS4.p3.m1" class="ltx_Math" alttext="{\varepsilon}_{0}\in[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>ε</mi><mn>0</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ε</mi><mi>min</mi></msub><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mi>min</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\varepsilon}_{0}\in[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]</annotation></semantics></math>. If <math id="A1.SS6.SSS4.p3.m2" class="ltx_Math" alttext="{\varepsilon}_{0}" display="inline" intent=":literal"><semantics><msub><mi>ε</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\varepsilon}_{0}</annotation></semantics></math> lies outside this interval, we instead consider <math id="A1.SS6.SSS4.p3.m3" class="ltx_Math" alttext="{\mathcal{P}}({\varepsilon}_{0})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{P}}({\varepsilon}_{0})</annotation></semantics></math>.
Now, let us derive a bound for <math id="A1.SS6.SSS4.p3.m4" class="ltx_Math" alttext="\EB|\widetilde{{\mathcal{T}}}({\varepsilon}_{0})-{{\mathcal{T}}}({\varepsilon}_{0})|" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">\EB|\widetilde{{\mathcal{T}}}({\varepsilon}_{0})-{{\mathcal{T}}}({\varepsilon}_{0})|</annotation></semantics></math>.
It follows that</span></p>
<table id="A1.EGx32" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex68.m1" class="ltx_Math" alttext="\displaystyle\EB" display="inline" intent=":literal"><semantics><mi>𝔼</mi><annotation encoding="application/x-tex">\displaystyle\EB</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex68.m2" class="ltx_Math" alttext="\displaystyle|\widetilde{{\mathcal{T}}}({\varepsilon}_{0})-{{\mathcal{T}}}({\varepsilon}_{0})|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle|\widetilde{{\mathcal{T}}}({\varepsilon}_{0})-{{\mathcal{T}}}({\varepsilon}_{0})|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex69.m1" class="ltx_Math" alttext="\displaystyle=\EB|\widetilde{{\mathcal{T}}}({\varepsilon}_{0})-\EB\widetilde{{\mathcal{T}}}({\varepsilon}_{0})+\EB\widetilde{{\mathcal{T}}}({\varepsilon}_{0})-{{\mathcal{T}}}({\varepsilon}_{0})|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><mrow><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mi>𝔼</mi><mo lspace="0.167em">⁡</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>~</mo></mover></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mi>𝔼</mi><mo lspace="0.167em">⁡</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>~</mo></mover></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\EB|\widetilde{{\mathcal{T}}}({\varepsilon}_{0})-\EB\widetilde{{\mathcal{T}}}({\varepsilon}_{0})+\EB\widetilde{{\mathcal{T}}}({\varepsilon}_{0})-{{\mathcal{T}}}({\varepsilon}_{0})|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex70"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex70.m1" class="ltx_Math" alttext="\displaystyle\leq\EB|\widetilde{{\mathcal{T}}}({\varepsilon}_{0})-\EB\widetilde{{\mathcal{T}}}({\varepsilon}_{0})|+|\EB\widetilde{{\mathcal{T}}}({\varepsilon}_{0})-{{\mathcal{T}}}({\varepsilon}_{0})|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mi>𝔼</mi><mo lspace="0.167em">⁡</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>~</mo></mover></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><mrow><mi>𝔼</mi><mo lspace="0.167em">⁡</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>~</mo></mover></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\EB|\widetilde{{\mathcal{T}}}({\varepsilon}_{0})-\EB\widetilde{{\mathcal{T}}}({\varepsilon}_{0})|+|\EB\widetilde{{\mathcal{T}}}({\varepsilon}_{0})-{{\mathcal{T}}}({\varepsilon}_{0})|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex71"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex71.m1" class="ltx_Math" alttext="\displaystyle\leq\sqrt{\mathrm{Var}(\widetilde{{\mathcal{T}}}({\varepsilon}_{0}))}+\left|\frac{\int\widehat{v}_{\mathrm{opt}}({\varepsilon}_{0},x)\left[{\mathrm{d}}{F}_{0}(x)-{\mathrm{d}}\bar{F}(x)\right]}{\int\widehat{v}_{\mathrm{opt}}({\varepsilon}_{0},x)\left[{\mathrm{d}}{F}_{0}(x)-{\mathrm{d}}\widehat{F}_{\bm{P}}(x)\right]}-{\varepsilon}_{0}\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msqrt><mrow><mi>Var</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo>+</mo><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∫</mo><mrow><msub><mover accent="true"><mi>v</mi><mo>^</mo></mover><mi>opt</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mrow><mo>∫</mo><mrow><msub><mover accent="true"><mi>v</mi><mo>^</mo></mover><mi>opt</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mfrac></mstyle><mo>−</mo><msub><mi>ε</mi><mn>0</mn></msub></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sqrt{\mathrm{Var}(\widetilde{{\mathcal{T}}}({\varepsilon}_{0}))}+\left|\frac{\int\widehat{v}_{\mathrm{opt}}({\varepsilon}_{0},x)\left[{\mathrm{d}}{F}_{0}(x)-{\mathrm{d}}\bar{F}(x)\right]}{\int\widehat{v}_{\mathrm{opt}}({\varepsilon}_{0},x)\left[{\mathrm{d}}{F}_{0}(x)-{\mathrm{d}}\widehat{F}_{\bm{P}}(x)\right]}-{\varepsilon}_{0}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex72"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex72.m1" class="ltx_Math" alttext="\displaystyle=\frac{\sqrt{\frac{1}{n}\int\left[\frac{1-\widehat{g}(x)}{(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)}\right]^{2}{\mathrm{d}}\bar{F}(x)}}{\int\frac{[1-\widehat{g}(x)]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)}{\mathrm{d}}F_{0}(x)}+{\varepsilon}_{0}\left|\frac{\int\widehat{v}_{\mathrm{opt}}({\varepsilon}_{0},x)\left[{\mathrm{d}}\widehat{F}_{\bm{P}}(x)-{\mathrm{d}}\bar{F}_{\bm{P}}(x)\right]}{\int\widehat{v}_{\mathrm{opt}}({\varepsilon}_{0},x)\left[{\mathrm{d}}{F}_{0}(x)-{\mathrm{d}}\widehat{F}_{\bm{P}}(x)\right]}\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msqrt><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">∫</mo><mrow><msup><mrow><mo>[</mo><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo>]</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mover accent="true"><mi>F</mi><mo>¯</mo></mover></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msqrt><mrow><mo>∫</mo><mrow><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>+</mo><mrow><msub><mi>ε</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∫</mo><mrow><msub><mover accent="true"><mi>v</mi><mo>^</mo></mover><mi>opt</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mrow><mo>∫</mo><mrow><msub><mover accent="true"><mi>v</mi><mo>^</mo></mover><mi>opt</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>0</mn></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mfrac></mstyle><mo>|</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\sqrt{\frac{1}{n}\int\left[\frac{1-\widehat{g}(x)}{(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)}\right]^{2}{\mathrm{d}}\bar{F}(x)}}{\int\frac{[1-\widehat{g}(x)]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)}{\mathrm{d}}F_{0}(x)}+{\varepsilon}_{0}\left|\frac{\int\widehat{v}_{\mathrm{opt}}({\varepsilon}_{0},x)\left[{\mathrm{d}}\widehat{F}_{\bm{P}}(x)-{\mathrm{d}}\bar{F}_{\bm{P}}(x)\right]}{\int\widehat{v}_{\mathrm{opt}}({\varepsilon}_{0},x)\left[{\mathrm{d}}{F}_{0}(x)-{\mathrm{d}}\widehat{F}_{\bm{P}}(x)\right]}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E24.m1" class="ltx_Math" alttext="\displaystyle=:{\mathcal{V}}+{\mathcal{B}}." display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">=</mo><mo rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>+</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=:{\mathcal{V}}+{\mathcal{B}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS6.SSS4.p4" class="ltx_para">
<p id="A1.SS6.SSS4.p4.1" class="ltx_p"><span id="A1.SS6.SSS4.p4.1.1" class="ltx_text">Finally, we analyze the Lipschitz constant <math id="A1.SS6.SSS4.p4.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>.
By Lemma <a href="#A1.Thmlem1" title="Lemma A.1. ‣ A.6.1 Proof of Lemma ‣ A.6 Analysis for the Optimal Estimator ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.1</span></a>, we have</span></p>
<table id="A1.E25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E25.m1" class="ltx_Math" alttext="{\mathbb{P}}(L\geq A)\leq\frac{8K}{{\varepsilon}_{\min}^{3}}\frac{1}{n^{C-1}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>≥</mo><mi>A</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><msubsup><mi>ε</mi><mi>min</mi><mn>3</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><msup><mi>n</mi><mrow><mi>C</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathbb{P}}(L\geq A)\leq\frac{8K}{{\varepsilon}_{\min}^{3}}\frac{1}{n^{C-1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
<p id="A1.SS6.SSS4.p4.2" class="ltx_p"><span id="A1.SS6.SSS4.p4.2.1" class="ltx_text">We then complete the proof by combining (<a href="#A1.E23" title="Equation 23 ‣ Proof of Theorem . ‣ A.6.4 Proof of Theorem ‣ A.6 Analysis for the Optimal Estimator ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>), (<a href="#A1.Ex68" title="In Proof of Theorem . ‣ A.6.4 Proof of Theorem ‣ A.6 Analysis for the Optimal Estimator ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>) and (<a href="#A1.E25" title="Equation 25 ‣ Proof of Theorem . ‣ A.6.4 Proof of Theorem ‣ A.6 Analysis for the Optimal Estimator ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">25</span></a>).
∎</span></p>
</div>
</div>
</section>
</section>
<section id="A1.SS7" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.7 </span>Proof of Lemma <a href="#A1.Thmlem2" title="Lemma A.2 (High probability concentration). ‣ Proof of Lemma . ‣ A.6.3 Proof of Lemma ‣ A.6 Analysis for the Optimal Estimator ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2</span></a></h4>

<div id="A1.SS7.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Lemma <a href="#A1.Thmlem2" title="Lemma A.2 (High probability concentration). ‣ Proof of Lemma . ‣ A.6.3 Proof of Lemma ‣ A.6 Analysis for the Optimal Estimator ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2</span></a>.</h6>
<div id="A1.SS7.p1" class="ltx_para">
<p id="A1.SS7.p1.1" class="ltx_p"><span id="A1.SS7.p1.1.1" class="ltx_text">We use a uniform bound in conjunction with either Hoeffding’s inequality or Bernstein’s inequality to establish high-probability concentration results.</span></p>
</div>
<div id="A1.Thmlem3" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmlem3.2" class="ltx_text ltx_font_bold">Lemma A.3</span></span><span id="A1.Thmlem3.3" class="ltx_text ltx_font_bold"> </span>(Example 19.7 in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib31" title="" class="ltx_ref">31</a>]</cite>)<span id="A1.Thmlem3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmlem3.p1" class="ltx_para">
<p id="A1.Thmlem3.p1.1" class="ltx_p"><span id="A1.Thmlem3.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A1.Thmlem3.p1.m1" class="ltx_Math" alttext="\mathcal{H}=\{h_{\theta}:\theta\in\Theta\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>h</mi><mi>θ</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>θ</mi><mo>∈</mo><mi mathvariant="normal">Θ</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{H}=\{h_{\theta}:\theta\in\Theta\}</annotation></semantics></math> be a collection of measurable functions indexed by a bounded subset <math id="A1.Thmlem3.p1.m2" class="ltx_Math" alttext="\Theta\subset\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Θ</mi><mo>⊂</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\Theta\subset\mathbb{R}^{d}</annotation></semantics></math>. Suppose there exists a measurable function <math id="A1.Thmlem3.p1.m3" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> such that</span></p>
<table id="A1.Ex73" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex73.m1" class="ltx_Math" alttext="|h_{\theta_{1}}(x)-h_{\theta_{2}}(x)|\leq m(x)\cdot\|\theta_{1}-\theta_{2}\|,\quad\text{for every }\theta_{1},\theta_{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><msub><mi>h</mi><msub><mi>θ</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>h</mi><msub><mi>θ</mi><mn>2</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>θ</mi><mn>1</mn></msub><mo>−</mo><msub><mi>θ</mi><mn>2</mn></msub></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mtext class="ltx_mathvariant_italic">for every </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>1</mn></msub></mrow><mo>,</mo><msub><mi>θ</mi><mn>2</mn></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|h_{\theta_{1}}(x)-h_{\theta_{2}}(x)|\leq m(x)\cdot\|\theta_{1}-\theta_{2}\|,\quad\text{for every }\theta_{1},\theta_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.Thmlem3.p1.2" class="ltx_p"><span id="A1.Thmlem3.p1.2.1" class="ltx_text ltx_font_italic">If <math id="A1.Thmlem3.p1.m4" class="ltx_Math" alttext="\EB_{F}[|m|]&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mi mathvariant="normal">F</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">|</mo><mi mathvariant="normal">m</mi><mo stretchy="false">|</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\EB_{F}[|m|]&lt;\infty</annotation></semantics></math>, then there exists a constant <math id="A1.Thmlem3.p1.m5" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> depending only on <math id="A1.Thmlem3.p1.m6" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math> and <math id="A1.Thmlem3.p1.m7" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, such that the bracketing numbers satisfy</span></p>
<table id="A1.Ex74" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex74.m1" class="ltx_Math" alttext="N_{[\,]}({\varepsilon}\EB_{F}[|m|],\mathcal{H},L_{1}(\bar{F}))\leq K\left(\frac{\operatorname{diam}\Theta}{{\varepsilon}}\right)^{d},\quad\text{for every }0&lt;{\varepsilon}&lt;\operatorname{diam}\Theta." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>N</mi><mrow><mo rspace="0.170em" stretchy="false">[</mo><mo stretchy="false">]</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ε</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">|</mo><mi>m</mi><mo stretchy="false">|</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>,</mo><mrow><msub><mi>L</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><mrow><mi>diam</mi><mo lspace="0.167em">⁡</mo><mi mathvariant="normal">Θ</mi></mrow><mi>ε</mi></mfrac><mo>)</mo></mrow><mi>d</mi></msup></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mtext class="ltx_mathvariant_italic">for every </mtext><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mo>&lt;</mo><mi>ε</mi><mo>&lt;</mo><mrow><mi>diam</mi><mo lspace="0.167em">⁡</mo><mi mathvariant="normal">Θ</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">N_{[\,]}({\varepsilon}\EB_{F}[|m|],\mathcal{H},L_{1}(\bar{F}))\leq K\left(\frac{\operatorname{diam}\Theta}{{\varepsilon}}\right)^{d},\quad\text{for every }0&lt;{\varepsilon}&lt;\operatorname{diam}\Theta.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.Thmlem3.p1.3" class="ltx_p"><span id="A1.Thmlem3.p1.3.1" class="ltx_text ltx_font_italic">Here, <math id="A1.Thmlem3.p1.m8" class="ltx_Math" alttext="N_{[\,]}({\varepsilon},\mathcal{H},L_{1}(F))" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mrow><mo rspace="0.170em" stretchy="false">[</mo><mo stretchy="false">]</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>,</mo><mrow><msub><mi>L</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">N_{[\,]}({\varepsilon},\mathcal{H},L_{1}(F))</annotation></semantics></math> is the bracketing number, which is the minimum number of <math id="A1.Thmlem3.p1.m9" class="ltx_Math" alttext="{\varepsilon}" display="inline" intent=":literal"><semantics><mi>ε</mi><annotation encoding="application/x-tex">{\varepsilon}</annotation></semantics></math>-brackets required to cover <math id="A1.Thmlem3.p1.m10" class="ltx_Math" alttext="\mathcal{H}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">\mathcal{H}</annotation></semantics></math> under <math id="A1.Thmlem3.p1.m11" class="ltx_Math" alttext="L_{1}(F)" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L_{1}(F)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A1.SS7.p2" class="ltx_para">
<p id="A1.SS7.p2.1" class="ltx_p"><span id="A1.SS7.p2.1.1" class="ltx_text">We will apply Lemma <a href="#A1.Thmlem3" title="Lemma A.3 (Example 19.7 in []). ‣ Proof of Lemma . ‣ A.7 Proof of Lemma ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.3</span></a> to bound the bracketing number of the function classes <math id="A1.SS7.p2.m1" class="ltx_Math" alttext="\mathcal{H}_{1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathcal{H}_{1}</annotation></semantics></math> and <math id="A1.SS7.p2.m2" class="ltx_Math" alttext="\mathcal{H}_{2}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\mathcal{H}_{2}</annotation></semantics></math> defined in (<a href="#A1.E20" title="Equation 20 ‣ Lemma A.2 (High probability concentration). ‣ Proof of Lemma . ‣ A.6.3 Proof of Lemma ‣ A.6 Analysis for the Optimal Estimator ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">20</span></a>). For these classes, the proportion <math id="A1.SS7.p2.m3" class="ltx_Math" alttext="{\varepsilon}" display="inline" intent=":literal"><semantics><mi>ε</mi><annotation encoding="application/x-tex">{\varepsilon}</annotation></semantics></math> serves as the parameter <math id="A1.SS7.p2.m4" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> with domain <math id="A1.SS7.p2.m5" class="ltx_Math" alttext="\Theta=[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Θ</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ε</mi><mi>min</mi></msub><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mi>min</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\Theta=[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]</annotation></semantics></math> and dimensionality <math id="A1.SS7.p2.m6" class="ltx_Math" alttext="d=1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d=1</annotation></semantics></math>.
The data distribution <math id="A1.SS7.p2.m7" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> is the mixture <math id="A1.SS7.p2.m8" class="ltx_Math" alttext="\bar{F}=(1-{\varepsilon}_{0})F_{0}+{\varepsilon}_{0}\bar{F}_{\bm{P}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><msub><mi>ε</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\bar{F}=(1-{\varepsilon}_{0})F_{0}+{\varepsilon}_{0}\bar{F}_{\bm{P}}</annotation></semantics></math>, where <math id="A1.SS7.p2.m9" class="ltx_Math" alttext="{\varepsilon}_{0}" display="inline" intent=":literal"><semantics><msub><mi>ε</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\varepsilon}_{0}</annotation></semantics></math> is the true proportion generating the observed samples. We define</span></p>
<table id="A1.Ex75" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex75.m1" class="ltx_Math" alttext="m(x):=\sup_{x\in{\mathcal{X}}}\left|\frac{\partial h_{\theta}(x)}{\partial\theta}\right|," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">:=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow></munder><mrow><mo>|</mo><mfrac><mrow><mo>∂</mo><mrow><msub><mi>h</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mi>θ</mi></mrow></mfrac><mo>|</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">m(x):=\sup_{x\in{\mathcal{X}}}\left|\frac{\partial h_{\theta}(x)}{\partial\theta}\right|,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS7.p2.2" class="ltx_p"><span id="A1.SS7.p2.2.1" class="ltx_text">which bounds the partial derivative of <math id="A1.SS7.p2.m10" class="ltx_Math" alttext="h_{\theta}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">h_{\theta}(x)</annotation></semantics></math> with respect to <math id="A1.SS7.p2.m11" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>. For <math id="A1.SS7.p2.m12" class="ltx_Math" alttext="\mathcal{H}_{1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathcal{H}_{1}</annotation></semantics></math> and <math id="A1.SS7.p2.m13" class="ltx_Math" alttext="\mathcal{H}_{2}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\mathcal{H}_{2}</annotation></semantics></math>, we explicitly compute:</span></p>
<table id="A1.Ex76" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex76.m1" class="ltx_Math" alttext="\text{For }\mathcal{H}_{1},\quad\frac{{\mathrm{d}}}{{\mathrm{d}}{\varepsilon}}\left(\frac{1-\widehat{g}(x)}{(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)}\right)=\frac{(-1+\widehat{g}(x))^{2}}{(1-{\varepsilon}+{\varepsilon}\widehat{g}(x))^{2}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mtext>For </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>1</mn></msub></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo>)</mo></mrow></mrow><mo>=</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>+</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\text{For }\mathcal{H}_{1},\quad\frac{{\mathrm{d}}}{{\mathrm{d}}{\varepsilon}}\left(\frac{1-\widehat{g}(x)}{(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)}\right)=\frac{(-1+\widehat{g}(x))^{2}}{(1-{\varepsilon}+{\varepsilon}\widehat{g}(x))^{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A1.Ex77" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex77.m1" class="ltx_Math" alttext="\text{For }\mathcal{H}_{2},\quad\frac{{\mathrm{d}}}{{\mathrm{d}}{\varepsilon}}\left(\frac{[1-\widehat{g}(x)]^{2}}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)]^{2}}\right)=\frac{2[1-\widehat{g}(x)]^{3}}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)]^{3}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mtext>For </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>2</mn></msub></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mfrac><mo>)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>3</mn></msup></mrow><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>3</mn></msup></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\text{For }\mathcal{H}_{2},\quad\frac{{\mathrm{d}}}{{\mathrm{d}}{\varepsilon}}\left(\frac{[1-\widehat{g}(x)]^{2}}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)]^{2}}\right)=\frac{2[1-\widehat{g}(x)]^{3}}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)]^{3}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS7.p2.3" class="ltx_p"><span id="A1.SS7.p2.3.1" class="ltx_text">With <math id="A1.SS7.p2.m14" class="ltx_Math" alttext="{\varepsilon}\in[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ε</mi><mi>min</mi></msub><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mi>min</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\varepsilon}\in[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]</annotation></semantics></math> and (<a href="#A1.E18" title="Equation 18 ‣ Proof of Lemma . ‣ A.6.3 Proof of Lemma ‣ A.6 Analysis for the Optimal Estimator ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>), we set <math id="A1.SS7.p2.m15" class="ltx_Math" alttext="m(x)\equiv\frac{2}{{\varepsilon}_{\min}^{3}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≡</mo><mfrac><mn>2</mn><msubsup><mi>ε</mi><mi>min</mi><mn>3</mn></msubsup></mfrac></mrow><annotation encoding="application/x-tex">m(x)\equiv\frac{2}{{\varepsilon}_{\min}^{3}}</annotation></semantics></math> as a uniform upper bound. Using Lemma <a href="#A1.Thmlem3" title="Lemma A.3 (Example 19.7 in []). ‣ Proof of Lemma . ‣ A.7 Proof of Lemma ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.3</span></a>, we conclude that:</span></p>
<table id="A1.Ex78" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex78.m1" class="ltx_Math" alttext="N_{[\,]}(\delta,\mathcal{H}_{1},L_{1}(\bar{F}))\vee N_{[\,]}(\delta,\mathcal{H}_{2},L_{1}(\bar{F}))\leq\frac{2K}{{\varepsilon}_{\min}^{3}}\cdot\frac{1}{\delta}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>N</mi><mrow><mo rspace="0.170em" stretchy="false">[</mo><mo stretchy="false">]</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>L</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∨</mo><mrow><msub><mi>N</mi><mrow><mo rspace="0.170em" stretchy="false">[</mo><mo stretchy="false">]</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>2</mn></msub><mo>,</mo><mrow><msub><mi>L</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><msubsup><mi>ε</mi><mi>min</mi><mn>3</mn></msubsup></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mn>1</mn><mi>δ</mi></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">N_{[\,]}(\delta,\mathcal{H}_{1},L_{1}(\bar{F}))\vee N_{[\,]}(\delta,\mathcal{H}_{2},L_{1}(\bar{F}))\leq\frac{2K}{{\varepsilon}_{\min}^{3}}\cdot\frac{1}{\delta}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS7.p3" class="ltx_para">
<p id="A1.SS7.p3.1" class="ltx_p"><span id="A1.SS7.p3.1.1" class="ltx_text">Next, consider <math id="A1.SS7.p3.m1" class="ltx_Math" alttext="\mathcal{H}_{k}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\mathcal{H}_{k}</annotation></semantics></math> for <math id="A1.SS7.p3.m2" class="ltx_Math" alttext="k=1,2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">k=1,2</annotation></semantics></math>. Define a finite set <math id="A1.SS7.p3.m3" class="ltx_Math" alttext="\mathcal{H}_{\mathrm{bracket}}=\{h_{1},h_{2},\dots,h_{n^{\prime}}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>bracket</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>h</mi><mn>1</mn></msub><mo>,</mo><msub><mi>h</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>h</mi><msup><mi>n</mi><mo>′</mo></msup></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{H}_{\mathrm{bracket}}=\{h_{1},h_{2},\dots,h_{n^{\prime}}\}</annotation></semantics></math> as a <math id="A1.SS7.p3.m4" class="ltx_Math" alttext="\frac{1}{n}" display="inline" intent=":literal"><semantics><mfrac><mn>1</mn><mi>n</mi></mfrac><annotation encoding="application/x-tex">\frac{1}{n}</annotation></semantics></math>-<math id="A1.SS7.p3.m5" class="ltx_Math" alttext="L_{1}(\bar{F})" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L_{1}(\bar{F})</annotation></semantics></math>-bracket of <math id="A1.SS7.p3.m6" class="ltx_Math" alttext="\mathcal{H}_{k}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\mathcal{H}_{k}</annotation></semantics></math>. By definition, for any <math id="A1.SS7.p3.m7" class="ltx_Math" alttext="h\in\mathcal{H}_{k}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">h\in\mathcal{H}_{k}</annotation></semantics></math>, there exists <math id="A1.SS7.p3.m8" class="ltx_Math" alttext="h_{i},h_{j}\in\mathcal{H}_{\mathrm{bracket}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>h</mi><mi>j</mi></msub><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>bracket</mi></msub></mrow></mrow><annotation encoding="application/x-tex">h_{i},h_{j}\in\mathcal{H}_{\mathrm{bracket}}</annotation></semantics></math> such that <math id="A1.SS7.p3.m9" class="ltx_Math" alttext="h_{i}\leq h\leq h_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mi>i</mi></msub><mo>≤</mo><mi>h</mi><mo>≤</mo><msub><mi>h</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">h_{i}\leq h\leq h_{j}</annotation></semantics></math> and <math id="A1.SS7.p3.m10" class="ltx_Math" alttext="|\EB_{\bar{F}}[h_{i}-h_{j}]|\leq\frac{1}{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>h</mi><mi>i</mi></msub><mo>−</mo><msub><mi>h</mi><mi>j</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow><annotation encoding="application/x-tex">|\EB_{\bar{F}}[h_{i}-h_{j}]|\leq\frac{1}{n}</annotation></semantics></math>. Using the bound on bracketing numbers, we have <math id="A1.SS7.p3.m11" class="ltx_Math" alttext="n^{\prime}\leq C_{1}n" display="inline" intent=":literal"><semantics><mrow><msup><mi>n</mi><mo>′</mo></msup><mo>≤</mo><mrow><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><annotation encoding="application/x-tex">n^{\prime}\leq C_{1}n</annotation></semantics></math>. Then:</span></p>
<table id="A1.Ex79" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex79.m1" class="ltx_Math" alttext="\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\leq\frac{1}{n}\sum_{t=1}^{n}h_{j}(Y_{t})-\EB_{\bar{F}}[h_{i}(Y)]\leq\frac{1}{n}\sum_{t=1}^{n}h_{j}(Y_{t})-\EB_{\bar{F}}[h_{j}(Y)]+\frac{1}{n}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msub><mi>h</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>h</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msub><mi>h</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>h</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>+</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\leq\frac{1}{n}\sum_{t=1}^{n}h_{j}(Y_{t})-\EB_{\bar{F}}[h_{i}(Y)]\leq\frac{1}{n}\sum_{t=1}^{n}h_{j}(Y_{t})-\EB_{\bar{F}}[h_{j}(Y)]+\frac{1}{n},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A1.Ex80" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex80.m1" class="ltx_Math" alttext="\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\geq\frac{1}{n}\sum_{t=1}^{n}h_{i}(Y_{t})-\EB_{\bar{F}}[h_{j}(Y)]\geq\frac{1}{n}\sum_{t=1}^{n}h_{i}(Y_{t})-\EB_{\bar{F}}[h_{i}(Y)]-\frac{1}{n}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>≥</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msub><mi>h</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>h</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>≥</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msub><mi>h</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>h</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\geq\frac{1}{n}\sum_{t=1}^{n}h_{i}(Y_{t})-\EB_{\bar{F}}[h_{j}(Y)]\geq\frac{1}{n}\sum_{t=1}^{n}h_{i}(Y_{t})-\EB_{\bar{F}}[h_{i}(Y)]-\frac{1}{n}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS7.p3.2" class="ltx_p"><span id="A1.SS7.p3.2.1" class="ltx_text">This implies that for any <math id="A1.SS7.p3.m12" class="ltx_Math" alttext="t\geq\frac{1}{n}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow><annotation encoding="application/x-tex">t\geq\frac{1}{n}</annotation></semantics></math>,</span></p>
<table id="A1.Ex81" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex81.m1" class="ltx_math_unparsed" alttext="\left\{\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|&gt;t\right\}\subseteq\left\{\exists h_{j}\in\mathcal{H}_{\mathrm{bracket}},~\left|\frac{1}{n}\sum_{t=1}^{n}h_{j}(Y_{t})-\EB_{\bar{F}}[h_{j}(Y)]\right|&gt;t-\frac{1}{n}\right\}." display="block" intent=":literal"><semantics><mrow><mrow><mo>{</mo><mo fence="false" rspace="0.167em">|</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mi>h</mi><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mrow><mo stretchy="false">[</mo><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo fence="false">|</mo><mo lspace="0.167em">&gt;</mo><mi>t</mi><mo>}</mo></mrow><mo>⊆</mo><mrow><mo>{</mo><mo rspace="0.167em">∃</mo><msub><mi>h</mi><mi>j</mi></msub><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>bracket</mi></msub><mo rspace="0.497em">,</mo><mo fence="false" rspace="0.167em">|</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><msub><mi>h</mi><mi>j</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mrow><mo stretchy="false">[</mo><msub><mi>h</mi><mi>j</mi></msub><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo fence="false">|</mo><mo lspace="0.167em">&gt;</mo><mi>t</mi><mo>−</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><mo>}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\{\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|&gt;t\right\}\subseteq\left\{\exists h_{j}\in\mathcal{H}_{\mathrm{bracket}},~\left|\frac{1}{n}\sum_{t=1}^{n}h_{j}(Y_{t})-\EB_{\bar{F}}[h_{j}(Y)]\right|&gt;t-\frac{1}{n}\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS7.p3.3" class="ltx_p"><span id="A1.SS7.p3.3.1" class="ltx_text">Thus,</span></p>
<table id="A1.Ex82" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex82.m1" class="ltx_Math" alttext="{\mathbb{P}}\left(\sup_{h\in\mathcal{H}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|&gt;t\right)\leq\sum_{h\in\mathcal{H}_{\mathrm{bracket}}}{\mathbb{P}}\left(\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|&gt;t-\frac{1}{n}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>h</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow></munder><mrow><mo>|</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>&gt;</mo><mi>t</mi></mrow><mo>)</mo></mrow></mrow><mo rspace="0.111em">≤</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>bracket</mi></msub></mrow></munder><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>|</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>&gt;</mo><mrow><mi>t</mi><mo>−</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathbb{P}}\left(\sup_{h\in\mathcal{H}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|&gt;t\right)\leq\sum_{h\in\mathcal{H}_{\mathrm{bracket}}}{\mathbb{P}}\left(\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|&gt;t-\frac{1}{n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<section id="A1.SS7.SSS1" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">A.7.1 </span>With Moment Conditions</h5>

<div id="A1.SS7.SSS1.p1" class="ltx_para">
<p id="A1.SS7.SSS1.p1.1" class="ltx_p">We first consider the case where the moment condition <math id="A1.SS7.SSS1.p1.m1" class="ltx_Math" alttext="\EB_{\bar{F}}[\widehat{g}]^{-2}&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">]</mo></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\EB_{\bar{F}}[\widehat{g}]^{-2}&lt;\infty</annotation></semantics></math> holds.
Recall that <math id="A1.SS7.SSS1.p1.m2" class="ltx_Math" alttext="\sup_{x}|\widehat{g}(x)|&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>sup</mo><mi>x</mi></msub><mrow><mo lspace="0em" stretchy="false">|</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\sup_{x}|\widehat{g}(x)|&lt;\infty</annotation></semantics></math>.
Under these conditions, any function in either <math id="A1.SS7.SSS1.p1.m3" class="ltx_Math" alttext="\mathcal{H}_{1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathcal{H}_{1}</annotation></semantics></math> or <math id="A1.SS7.SSS1.p1.m4" class="ltx_Math" alttext="\mathcal{H}_{2}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\mathcal{H}_{2}</annotation></semantics></math> has bounded variance, which is independent of—or at most weakly dependent on <math id="A1.SS7.SSS1.p1.m5" class="ltx_Math" alttext="\frac{1}{{\varepsilon}_{\min}}" display="inline" intent=":literal"><semantics><mfrac><mn>1</mn><msub><mi>ε</mi><mi>min</mi></msub></mfrac><annotation encoding="application/x-tex">\frac{1}{{\varepsilon}_{\min}}</annotation></semantics></math>.
We begin by analyzing the variance for functions in <math id="A1.SS7.SSS1.p1.m6" class="ltx_Math" alttext="\mathcal{H}_{1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathcal{H}_{1}</annotation></semantics></math>. To this end, we consider two cases:</p>
<ol id="A1.I3" class="ltx_enumerate">
<li id="A1.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A1.I3.i1.p1" class="ltx_para">
<p id="A1.I3.i1.p1.1" class="ltx_p">For <math id="A1.I3.i1.p1.m1" class="ltx_Math" alttext="{\varepsilon}\in[{\varepsilon}_{\min},\frac{1}{2}]" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ε</mi><mi>min</mi></msub><mo>,</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\varepsilon}\in[{\varepsilon}_{\min},\frac{1}{2}]</annotation></semantics></math>:</p>
<table id="A1.Ex83" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex83.m1" class="ltx_Math" alttext="\mathrm{Var}_{\bar{F}}\left(\frac{1-\widehat{g}}{[1-{\varepsilon})+{\varepsilon}\widehat{g}}\right)\leq\EB_{\bar{F}}\left(\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}]^{2}}\right)\leq\frac{\EB_{\bar{F}}{[1-\widehat{g}]^{2}}}{(1-{\varepsilon})^{2}}\leq 4\EB_{\bar{F}}{[1-\widehat{g}]^{2}}&lt;\infty." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>Var</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>−</mo><mi>ε</mi><mo stretchy="false">)</mo><mo>+</mo><mi>ε</mi><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow></mfrac><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo>(</mo><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>ε</mi><mo stretchy="false">)</mo><mo>+</mo><mi>ε</mi><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">]</mo><msup><mrow></mrow><mn>2</mn></msup></mrow></mfrac><mo>)</mo></mrow></mrow><mo>≤</mo><mfrac><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><mo>≤</mo><mrow><mn>4</mn><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Var}_{\bar{F}}\left(\frac{1-\widehat{g}}{[1-{\varepsilon})+{\varepsilon}\widehat{g}}\right)\leq\EB_{\bar{F}}\left(\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}]^{2}}\right)\leq\frac{\EB_{\bar{F}}{[1-\widehat{g}]^{2}}}{(1-{\varepsilon})^{2}}\leq 4\EB_{\bar{F}}{[1-\widehat{g}]^{2}}&lt;\infty.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A1.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A1.I3.i2.p1" class="ltx_para">
<p id="A1.I3.i2.p1.1" class="ltx_p">For <math id="A1.I3.i2.p1.m1" class="ltx_Math" alttext="{\varepsilon}\in[\frac{1}{2},1-{\varepsilon}_{\min}]" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mi>min</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\varepsilon}\in[\frac{1}{2},1-{\varepsilon}_{\min}]</annotation></semantics></math>:</p>
<table id="A1.Ex84" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex84.m1" class="ltx_Math" alttext="\mathrm{Var}_{\bar{F}}\left(\frac{1-\widehat{g}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}\right)\leq\EB_{\bar{F}}\left(\frac{[1-\widehat{g}(x)]^{2}}{[{\varepsilon}\widehat{g}(x)]^{2}}\right)\leq 4\EB_{\bar{F}}\left(\frac{[1-\widehat{g}(x)]^{2}}{[\widehat{g}(x)]^{2}}\right)&lt;\infty." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>Var</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow></mrow></mfrac><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo>(</mo><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><msup><mrow><mo stretchy="false">[</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mfrac><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mn>4</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo>(</mo><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><msup><mrow><mo stretchy="false">[</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mfrac><mo>)</mo></mrow></mrow></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Var}_{\bar{F}}\left(\frac{1-\widehat{g}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}\right)\leq\EB_{\bar{F}}\left(\frac{[1-\widehat{g}(x)]^{2}}{[{\varepsilon}\widehat{g}(x)]^{2}}\right)\leq 4\EB_{\bar{F}}\left(\frac{[1-\widehat{g}(x)]^{2}}{[\widehat{g}(x)]^{2}}\right)&lt;\infty.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
<p id="A1.SS7.SSS1.p1.2" class="ltx_p">Thus, the variance is bounded, and we define</p>
<table id="A1.Ex85" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex85.m1" class="ltx_Math" alttext="4\EB_{\bar{F}}{[1-\widehat{g}]^{2}}+\EB_{\bar{F}}\left(\frac{[1-\widehat{g}(x)]^{2}}{[\widehat{g}(x)]^{2}}\right)\leq 4\EB_{\bar{F}}\left[\widehat{g}-1/\widehat{g}\right]^{2}=:\frac{M}{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mn>4</mn><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo>(</mo><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><msup><mrow><mo stretchy="false">[</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mfrac><mo>)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mn>4</mn><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow></mrow><mo>]</mo></mrow><mn>2</mn></msup></mrow><mo>=</mo><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mfrac><mi>M</mi><mn>2</mn></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">4\EB_{\bar{F}}{[1-\widehat{g}]^{2}}+\EB_{\bar{F}}\left(\frac{[1-\widehat{g}(x)]^{2}}{[\widehat{g}(x)]^{2}}\right)\leq 4\EB_{\bar{F}}\left[\widehat{g}-1/\widehat{g}\right]^{2}=:\frac{M}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS7.SSS1.p1.3" class="ltx_p">Similarly, for the variance of functions in <math id="A1.SS7.SSS1.p1.m7" class="ltx_Math" alttext="\mathcal{H}_{2}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\mathcal{H}_{2}</annotation></semantics></math>, we have, for any <math id="A1.SS7.SSS1.p1.m8" class="ltx_Math" alttext="{\varepsilon}\in[{\varepsilon}{\min},1-{\varepsilon}_{\min}]" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>ε</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>min</mi></mrow><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mi>min</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\varepsilon}\in[{\varepsilon}{\min},1-{\varepsilon}_{\min}]</annotation></semantics></math>:</p>
<table id="A1.Ex86" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex86.m1" class="ltx_Math" alttext="\mathrm{Var}_{\bar{F}}\left(\frac{[1-\widehat{g}]^{2}}{[1-{\varepsilon})+{\varepsilon}\widehat{g}]^{2}}\right)\leq\EB_{\bar{F}}\left(\frac{[1-\widehat{g}]^{4}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}]^{4}}\right)\overset{\eqref{eq:fraction-bound}}{\leq}\frac{1}{{\varepsilon}_{\min}^{2}}\EB_{\bar{F}}\left(\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}]^{2}}\right)\leq\frac{M}{2{\varepsilon}_{\min}^{2}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>Var</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>−</mo><mi>ε</mi><mo stretchy="false">)</mo><mo>+</mo><mi>ε</mi><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">]</mo><msup><mrow></mrow><mn>2</mn></msup></mrow></mfrac><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo>(</mo><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mn>4</mn></msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>ε</mi><mo stretchy="false">)</mo><mo>+</mo><mi>ε</mi><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">]</mo><msup><mrow></mrow><mn>4</mn></msup></mrow></mfrac><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo>≤</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#A1.E18" title="Equation 18 ‣ Proof of Lemma . ‣ A.6.3 Proof of Lemma ‣ A.6 Analysis for the Optimal Estimator ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">18</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><msubsup><mi>ε</mi><mi>min</mi><mn>2</mn></msubsup></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo>(</mo><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>ε</mi><mo stretchy="false">)</mo><mo>+</mo><mi>ε</mi><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">]</mo><msup><mrow></mrow><mn>2</mn></msup></mrow></mfrac><mo>)</mo></mrow></mrow></mrow><mo>≤</mo><mfrac><mi>M</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mi>min</mi><mn>2</mn></msubsup></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Var}_{\bar{F}}\left(\frac{[1-\widehat{g}]^{2}}{[1-{\varepsilon})+{\varepsilon}\widehat{g}]^{2}}\right)\leq\EB_{\bar{F}}\left(\frac{[1-\widehat{g}]^{4}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}]^{4}}\right)\overset{\eqref{eq:fraction-bound}}{\leq}\frac{1}{{\varepsilon}_{\min}^{2}}\EB_{\bar{F}}\left(\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}]^{2}}\right)\leq\frac{M}{2{\varepsilon}_{\min}^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<section id="A1.SS7.SSS1.Px1" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">For <math id="A1.SS7.SSS1.Px1.m1" class="ltx_Math" alttext="\mathcal{H}_{1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathcal{H}_{1}</annotation></semantics></math>.</h6>

<div id="A1.SS7.SSS1.Px1.p1" class="ltx_para">
<p id="A1.SS7.SSS1.Px1.p1.1" class="ltx_p">Using Bernstein’s inequality, we have the following bound for any <math id="A1.SS7.SSS1.Px1.p1.m1" class="ltx_Math" alttext="h_{1}\in\mathcal{H}_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mn>1</mn></msub><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">h_{1}\in\mathcal{H}_{1}</annotation></semantics></math>,</p>
<table id="A1.Ex87" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex87.m1" class="ltx_Math" alttext="{\mathbb{P}}\left(\left|\frac{1}{n}\sum_{t=1}^{n}h_{1}(Y_{t})-\EB_{\bar{F}}[h_{1}(Y)]\right|&gt;t-\frac{1}{n}\right)\leq 2\exp\left(-\frac{n(t-\frac{1}{n})^{2}}{2\left(\frac{M}{2}+\frac{(t-\frac{1}{n})}{3n{\varepsilon}_{\min}}\right)}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>|</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msub><mi>h</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>h</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>&gt;</mo><mrow><mi>t</mi><mo>−</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mfrac><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><mi>M</mi><mn>2</mn></mfrac><mo>+</mo><mfrac><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ε</mi><mi>min</mi></msub></mrow></mfrac></mrow><mo>)</mo></mrow></mrow></mfrac></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathbb{P}}\left(\left|\frac{1}{n}\sum_{t=1}^{n}h_{1}(Y_{t})-\EB_{\bar{F}}[h_{1}(Y)]\right|&gt;t-\frac{1}{n}\right)\leq 2\exp\left(-\frac{n(t-\frac{1}{n})^{2}}{2\left(\frac{M}{2}+\frac{(t-\frac{1}{n})}{3n{\varepsilon}_{\min}}\right)}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS7.SSS1.Px1.p1.2" class="ltx_p">Let <math id="A1.SS7.SSS1.Px1.p1.m2" class="ltx_Math" alttext="t\geq\frac{1}{n}+\frac{C\log n}{n{\varepsilon}_{\min}}+\sqrt{\frac{CM\log n}{n}}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo>+</mo><mfrac><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ε</mi><mi>min</mi></msub></mrow></mfrac><mo>+</mo><msqrt><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mi>n</mi></mfrac></msqrt></mrow></mrow><annotation encoding="application/x-tex">t\geq\frac{1}{n}+\frac{C\log n}{n{\varepsilon}_{\min}}+\sqrt{\frac{CM\log n}{n}}</annotation></semantics></math> with any <math id="A1.SS7.SSS1.Px1.p1.m3" class="ltx_Math" alttext="C&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C&gt;0</annotation></semantics></math>. Then it follows that</p>
<table id="A1.Ex88" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex88.m1" class="ltx_Math" alttext="{\mathbb{P}}\left(\sup_{h\in\mathcal{H}_{1}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq\frac{C\log n}{n{\varepsilon}_{\min}}+\sqrt{\frac{CM\log n}{n}}\right)\leq\frac{4K}{{\varepsilon}_{\min}^{3}}\cdot\frac{1}{n^{C-1}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>1</mn></msub></mrow></munder><mrow><mo>|</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>≥</mo><mrow><mfrac><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ε</mi><mi>min</mi></msub></mrow></mfrac><mo>+</mo><msqrt><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mi>n</mi></mfrac></msqrt></mrow></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><msubsup><mi>ε</mi><mi>min</mi><mn>3</mn></msubsup></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mn>1</mn><msup><mi>n</mi><mrow><mi>C</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathbb{P}}\left(\sup_{h\in\mathcal{H}_{1}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq\frac{C\log n}{n{\varepsilon}_{\min}}+\sqrt{\frac{CM\log n}{n}}\right)\leq\frac{4K}{{\varepsilon}_{\min}^{3}}\cdot\frac{1}{n^{C-1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.SS7.SSS1.Px2" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">For <math id="A1.SS7.SSS1.Px2.m1" class="ltx_Math" alttext="\mathcal{H}_{2}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\mathcal{H}_{2}</annotation></semantics></math>.</h6>

<div id="A1.SS7.SSS1.Px2.p1" class="ltx_para">
<p id="A1.SS7.SSS1.Px2.p1.1" class="ltx_p">Using Bernstein’s inequality, we have the following bound for any <math id="A1.SS7.SSS1.Px2.p1.m1" class="ltx_Math" alttext="h_{2}\in\mathcal{H}_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mn>2</mn></msub><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">h_{2}\in\mathcal{H}_{2}</annotation></semantics></math>,</p>
<table id="A1.Ex89" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex89.m1" class="ltx_Math" alttext="{\mathbb{P}}\left(\left|\frac{1}{n}\sum_{t=1}^{n}h_{2}(Y_{t})-\EB_{\bar{F}}[h_{2}(Y)]\right|&gt;t-\frac{1}{n}\right)\leq 2\exp\left(-\frac{n(t-\frac{1}{n})^{2}}{2\left(\frac{M}{2{\varepsilon}_{\min}^{2}}+\frac{(t-\frac{1}{n})}{3n{\varepsilon}_{\min}^{2}}\right)}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>|</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msub><mi>h</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>h</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>&gt;</mo><mrow><mi>t</mi><mo>−</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mfrac><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><mi>M</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mi>min</mi><mn>2</mn></msubsup></mrow></mfrac><mo>+</mo><mfrac><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mi>min</mi><mn>2</mn></msubsup></mrow></mfrac></mrow><mo>)</mo></mrow></mrow></mfrac></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathbb{P}}\left(\left|\frac{1}{n}\sum_{t=1}^{n}h_{2}(Y_{t})-\EB_{\bar{F}}[h_{2}(Y)]\right|&gt;t-\frac{1}{n}\right)\leq 2\exp\left(-\frac{n(t-\frac{1}{n})^{2}}{2\left(\frac{M}{2{\varepsilon}_{\min}^{2}}+\frac{(t-\frac{1}{n})}{3n{\varepsilon}_{\min}^{2}}\right)}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS7.SSS1.Px2.p1.2" class="ltx_p">Let <math id="A1.SS7.SSS1.Px2.p1.m2" class="ltx_Math" alttext="t\geq\frac{1}{n}+\frac{C\log n}{n{\varepsilon}_{\min}^{2}}+\sqrt{\frac{CM\log n}{n{\varepsilon}_{\min}^{2}}}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo>+</mo><mfrac><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mi>min</mi><mn>2</mn></msubsup></mrow></mfrac><mo>+</mo><msqrt><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mi>min</mi><mn>2</mn></msubsup></mrow></mfrac></msqrt></mrow></mrow><annotation encoding="application/x-tex">t\geq\frac{1}{n}+\frac{C\log n}{n{\varepsilon}_{\min}^{2}}+\sqrt{\frac{CM\log n}{n{\varepsilon}_{\min}^{2}}}</annotation></semantics></math> with any <math id="A1.SS7.SSS1.Px2.p1.m3" class="ltx_Math" alttext="C&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C&gt;0</annotation></semantics></math>. Then it follows that</p>
<table id="A1.Ex90" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex90.m1" class="ltx_Math" alttext="{\mathbb{P}}\left(\sup_{h\in\mathcal{H}_{2}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq\frac{C\log n}{n{\varepsilon}_{\min}^{2}}+\sqrt{\frac{CM\log n}{n{\varepsilon}_{\min}^{2}}}\right)\leq\frac{4K}{{\varepsilon}_{\min}^{3}}\cdot\frac{1}{n^{C-1}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>2</mn></msub></mrow></munder><mrow><mo>|</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>≥</mo><mrow><mfrac><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mi>min</mi><mn>2</mn></msubsup></mrow></mfrac><mo>+</mo><msqrt><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mi>min</mi><mn>2</mn></msubsup></mrow></mfrac></msqrt></mrow></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><msubsup><mi>ε</mi><mi>min</mi><mn>3</mn></msubsup></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mn>1</mn><msup><mi>n</mi><mrow><mi>C</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathbb{P}}\left(\sup_{h\in\mathcal{H}_{2}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq\frac{C\log n}{n{\varepsilon}_{\min}^{2}}+\sqrt{\frac{CM\log n}{n{\varepsilon}_{\min}^{2}}}\right)\leq\frac{4K}{{\varepsilon}_{\min}^{3}}\cdot\frac{1}{n^{C-1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
</section>
<section id="A1.SS7.SSS2" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">A.7.2 </span>Without Moment Conditions</h5>

<div id="A1.SS7.SSS2.p1" class="ltx_para">
<p id="A1.SS7.SSS2.p1.1" class="ltx_p">Finally, if the moment condition <math id="A1.SS7.SSS2.p1.m1" class="ltx_Math" alttext="\EB_{\bar{F}}[\widehat{g}]^{-2}&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">]</mo></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\EB_{\bar{F}}[\widehat{g}]^{-2}&lt;\infty</annotation></semantics></math> does not hold, we instead apply Hoeffding’s inequality to bound the probability on the right-hand side for both <math id="A1.SS7.SSS2.p1.m2" class="ltx_Math" alttext="\mathcal{H}_{1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathcal{H}_{1}</annotation></semantics></math> and <math id="A1.SS7.SSS2.p1.m3" class="ltx_Math" alttext="\mathcal{H}_{2}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\mathcal{H}_{2}</annotation></semantics></math>, respectively.
As a result, the resulting concentration bound will depend on <math id="A1.SS7.SSS2.p1.m4" class="ltx_Math" alttext="\frac{1}{{\varepsilon}_{\min}^{2}}" display="inline" intent=":literal"><semantics><mfrac><mn>1</mn><msubsup><mi>ε</mi><mi>min</mi><mn>2</mn></msubsup></mfrac><annotation encoding="application/x-tex">\frac{1}{{\varepsilon}_{\min}^{2}}</annotation></semantics></math>.</p>
</div>
<section id="A1.SS7.SSS2.Px1" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">For <math id="A1.SS7.SSS2.Px1.m1" class="ltx_Math" alttext="\mathcal{H}_{1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathcal{H}_{1}</annotation></semantics></math>.</h6>

<div id="A1.SS7.SSS2.Px1.p1" class="ltx_para">
<p id="A1.SS7.SSS2.Px1.p1.1" class="ltx_p">For each <math id="A1.SS7.SSS2.Px1.p1.m1" class="ltx_Math" alttext="h\in\mathcal{H}_{1}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">h\in\mathcal{H}_{1}</annotation></semantics></math>, we have <math id="A1.SS7.SSS2.Px1.p1.m2" class="ltx_Math" alttext="\sup_{x}|h(x)|\leq\frac{1}{{\varepsilon}_{\min}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>sup</mo><mi>x</mi></msub><mrow><mo lspace="0em" stretchy="false">|</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>≤</mo><mfrac><mn>1</mn><msub><mi>ε</mi><mi>min</mi></msub></mfrac></mrow><annotation encoding="application/x-tex">\sup_{x}|h(x)|\leq\frac{1}{{\varepsilon}_{\min}}</annotation></semantics></math> due to <math id="A1.SS7.SSS2.Px1.p1.m3" class="ltx_Math" alttext="{\varepsilon}\in[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ε</mi><mi>min</mi></msub><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mi>min</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\varepsilon}\in[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]</annotation></semantics></math>. Applying Hoeffding’s inequality, we obtain:</p>
<table id="A1.Ex91" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex91.m1" class="ltx_Math" alttext="{\mathbb{P}}\left(\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|&gt;t-\frac{1}{n}\right)\leq 2\exp\left(-2n{\varepsilon}_{\min}^{2}\left(t-\frac{1}{n}\right)^{2}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>|</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>&gt;</mo><mrow><mi>t</mi><mo>−</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mi>min</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>t</mi><mo>−</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathbb{P}}\left(\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|&gt;t-\frac{1}{n}\right)\leq 2\exp\left(-2n{\varepsilon}_{\min}^{2}\left(t-\frac{1}{n}\right)^{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS7.SSS2.Px1.p1.2" class="ltx_p">Let <math id="A1.SS7.SSS2.Px1.p1.m4" class="ltx_Math" alttext="t\geq\frac{1}{n}+\frac{1}{{\varepsilon}_{\min}}\sqrt{\frac{C\log n}{2n}}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo>+</mo><mrow><mfrac><mn>1</mn><msub><mi>ε</mi><mi>min</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></msqrt></mrow></mrow></mrow><annotation encoding="application/x-tex">t\geq\frac{1}{n}+\frac{1}{{\varepsilon}_{\min}}\sqrt{\frac{C\log n}{2n}}</annotation></semantics></math> with any positive constant <math id="A1.SS7.SSS2.Px1.p1.m5" class="ltx_Math" alttext="C&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C&gt;0</annotation></semantics></math>. Then,</p>
<table id="A1.Ex92" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex92.m1" class="ltx_Math" alttext="{\mathbb{P}}\left(\sup_{h\in\mathcal{H}_{1}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq\frac{1}{{\varepsilon}_{\min}}\sqrt{\frac{C\log n}{2n}}\right)\leq\frac{4K}{{\varepsilon}_{\min}^{3}}\cdot\frac{1}{n^{C-1}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>1</mn></msub></mrow></munder><mrow><mo>|</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>≥</mo><mrow><mfrac><mn>1</mn><msub><mi>ε</mi><mi>min</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></msqrt></mrow></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><msubsup><mi>ε</mi><mi>min</mi><mn>3</mn></msubsup></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mn>1</mn><msup><mi>n</mi><mrow><mi>C</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathbb{P}}\left(\sup_{h\in\mathcal{H}_{1}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq\frac{1}{{\varepsilon}_{\min}}\sqrt{\frac{C\log n}{2n}}\right)\leq\frac{4K}{{\varepsilon}_{\min}^{3}}\cdot\frac{1}{n^{C-1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.SS7.SSS2.Px2" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">For <math id="A1.SS7.SSS2.Px2.m1" class="ltx_Math" alttext="\mathcal{H}_{2}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\mathcal{H}_{2}</annotation></semantics></math>.</h6>

<div id="A1.SS7.SSS2.Px2.p1" class="ltx_para">
<p id="A1.SS7.SSS2.Px2.p1.1" class="ltx_p">For each <math id="A1.SS7.SSS2.Px2.p1.m1" class="ltx_Math" alttext="h\in\mathcal{H}_{2}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">h\in\mathcal{H}_{2}</annotation></semantics></math>, we similarly have <math id="A1.SS7.SSS2.Px2.p1.m2" class="ltx_Math" alttext="\sup_{x}|h(x)|\leq\frac{1}{{\varepsilon}_{\min}^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>sup</mo><mi>x</mi></msub><mrow><mo lspace="0em" stretchy="false">|</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>≤</mo><mfrac><mn>1</mn><msubsup><mi>ε</mi><mi>min</mi><mn>2</mn></msubsup></mfrac></mrow><annotation encoding="application/x-tex">\sup_{x}|h(x)|\leq\frac{1}{{\varepsilon}_{\min}^{2}}</annotation></semantics></math> due to <math id="A1.SS7.SSS2.Px2.p1.m3" class="ltx_Math" alttext="{\varepsilon}\in[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ε</mi><mi>min</mi></msub><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mi>min</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\varepsilon}\in[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]</annotation></semantics></math>. Applying Hoeffding’s inequality, we obtain:</p>
<table id="A1.Ex93" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex93.m1" class="ltx_Math" alttext="{\mathbb{P}}\left(\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|&gt;t-\frac{1}{n}\right)\leq 2\exp\left(-2n{\varepsilon}_{\min}^{4}\left(t-\frac{1}{n}\right)^{2}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>|</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>&gt;</mo><mrow><mi>t</mi><mo>−</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mi>min</mi><mn>4</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>t</mi><mo>−</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathbb{P}}\left(\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|&gt;t-\frac{1}{n}\right)\leq 2\exp\left(-2n{\varepsilon}_{\min}^{4}\left(t-\frac{1}{n}\right)^{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS7.SSS2.Px2.p1.2" class="ltx_p">Let <math id="A1.SS7.SSS2.Px2.p1.m4" class="ltx_Math" alttext="t\geq\frac{1}{n}+\frac{1}{{\varepsilon}_{\min}^{2}}\sqrt{\frac{C\log n}{2n}}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo>+</mo><mrow><mfrac><mn>1</mn><msubsup><mi>ε</mi><mi>min</mi><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></msqrt></mrow></mrow></mrow><annotation encoding="application/x-tex">t\geq\frac{1}{n}+\frac{1}{{\varepsilon}_{\min}^{2}}\sqrt{\frac{C\log n}{2n}}</annotation></semantics></math> with any positive constant <math id="A1.SS7.SSS2.Px2.p1.m5" class="ltx_Math" alttext="C&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C&gt;0</annotation></semantics></math>. Then,</p>
<table id="A1.Ex94" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex94.m1" class="ltx_Math" alttext="{\mathbb{P}}\left(\sup_{h\in\mathcal{H}_{2}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq\frac{1}{{\varepsilon}_{\min}^{2}}\sqrt{\frac{C\log n}{2n}}\right)\leq\frac{4K}{{\varepsilon}_{\min}^{3}}\cdot\frac{1}{n^{C-1}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>2</mn></msub></mrow></munder><mrow><mo>|</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mover accent="true"><mi>F</mi><mo>¯</mo></mover></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>≥</mo><mrow><mfrac><mn>1</mn><msubsup><mi>ε</mi><mi>min</mi><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></msqrt></mrow></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><msubsup><mi>ε</mi><mi>min</mi><mn>3</mn></msubsup></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mn>1</mn><msup><mi>n</mi><mrow><mi>C</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathbb{P}}\left(\sup_{h\in\mathcal{H}_{2}}\left|\frac{1}{n}\sum_{t=1}^{n}h(Y_{t})-\EB_{\bar{F}}[h(Y)]\right|\geq\frac{1}{{\varepsilon}_{\min}^{2}}\sqrt{\frac{C\log n}{2n}}\right)\leq\frac{4K}{{\varepsilon}_{\min}^{3}}\cdot\frac{1}{n^{C-1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS7.SSS2.Px2.p2" class="ltx_para">
<p id="A1.SS7.SSS2.Px2.p2.1" class="ltx_p">∎</p>
</div>
</section>
</section>
</section>
<section id="A1.SS8" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.8 </span>Proof of Theorem <a href="#S4.Thmtheorem4" title="Theorem 4.4. ‣ 4.3 Minimax Lower Bounds ‣ 4 Theoretical Analysis ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.4</span></a></h4>

<div id="A1.SS8.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Theorem <a href="#S4.Thmtheorem4" title="Theorem 4.4. ‣ 4.3 Minimax Lower Bounds ‣ 4 Theoretical Analysis ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.4</span></a>.</h6>
<div id="A1.SS8.p1" class="ltx_para">
<p id="A1.SS8.p1.1" class="ltx_p"><span id="A1.SS8.p1.1.1" class="ltx_text">We will use Le Cam’s method to prove the minimax lower bound <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib34" title="" class="ltx_ref">34</a>, Chapter 15.2]</cite>. From Proposition 15.1 and (15.14) in <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib34" title="" class="ltx_ref">34</a>]</cite>, it follows that</span></p>
<table id="A1.EGx33" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E26.m1" class="ltx_Math" alttext="\displaystyle\inf_{\widehat{{\varepsilon}}\in{\mathcal{G}}}\sup_{{\varepsilon}_{0}\in{\mathcal{B}}({\varepsilon})}\EB|\widehat{{\varepsilon}}-{\varepsilon}_{0}|" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">inf</mo><mrow><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow></munder><mrow><munder><mo lspace="0.167em" movablelimits="false" rspace="0.167em">sup</mo><mrow><msub><mi>ε</mi><mn>0</mn></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mrow><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mo>−</mo><msub><mi>ε</mi><mn>0</mn></msub></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\inf_{\widehat{{\varepsilon}}\in{\mathcal{G}}}\sup_{{\varepsilon}_{0}\in{\mathcal{B}}({\varepsilon})}\EB|\widehat{{\varepsilon}}-{\varepsilon}_{0}|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E26.m2" class="ltx_Math" alttext="\displaystyle\geq\inf_{\widehat{{\varepsilon}}\in{\mathcal{G}}}\sup_{{\varepsilon}_{0}\in\{{\varepsilon}_{1},{\varepsilon}_{2}\}}\EB|\widehat{{\varepsilon}}-{\varepsilon}_{0}|\geq\frac{|{\varepsilon}_{1}-{\varepsilon}_{2}|}{2}\left(1-D_{\mathrm{TV}}(\rho_{1},\rho_{2})\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo rspace="0.1389em">≥</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.0835em">inf</mo><mrow><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow></munder><mrow><munder><mo lspace="0.0835em" movablelimits="false" rspace="0.167em">sup</mo><mrow><msub><mi>ε</mi><mn>0</mn></msub><mo>∈</mo><mrow><mo stretchy="false">{</mo><msub><mi>ε</mi><mn>1</mn></msub><mo>,</mo><msub><mi>ε</mi><mn>2</mn></msub><mo stretchy="false">}</mo></mrow></mrow></munder><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mrow><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mo>−</mo><msub><mi>ε</mi><mn>0</mn></msub></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow><mo>≥</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mrow><msub><mi>ε</mi><mn>1</mn></msub><mo>−</mo><msub><mi>ε</mi><mn>2</mn></msub></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>D</mi><mi>TV</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ρ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>ρ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq\inf_{\widehat{{\varepsilon}}\in{\mathcal{G}}}\sup_{{\varepsilon}_{0}\in\{{\varepsilon}_{1},{\varepsilon}_{2}\}}\EB|\widehat{{\varepsilon}}-{\varepsilon}_{0}|\geq\frac{|{\varepsilon}_{1}-{\varepsilon}_{2}|}{2}\left(1-D_{\mathrm{TV}}(\rho_{1},\rho_{2})\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
</table>
<p id="A1.SS8.p1.2" class="ltx_p"><span id="A1.SS8.p1.2.1" class="ltx_text">Here, <math id="A1.SS8.p1.m1" class="ltx_Math" alttext="{\varepsilon}_{i}" display="inline" intent=":literal"><semantics><msub><mi>ε</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\varepsilon}_{i}</annotation></semantics></math> for <math id="A1.SS8.p1.m2" class="ltx_Math" alttext="i=1,2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">i=1,2</annotation></semantics></math> are carefully chosen proportions within <math id="A1.SS8.p1.m3" class="ltx_Math" alttext="{\mathcal{B}}({\varepsilon})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{B}}({\varepsilon})</annotation></semantics></math>, and <math id="A1.SS8.p1.m4" class="ltx_Math" alttext="\rho_{i}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\rho_{i}</annotation></semantics></math> denotes the joint probability distribution of the considered functional of pivotal statistics in <math id="A1.SS8.p1.m5" class="ltx_Math" alttext="{\mathcal{G}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">{\mathcal{G}}</annotation></semantics></math> when the underlying proportion is <math id="A1.SS8.p1.m6" class="ltx_Math" alttext="{\varepsilon}_{i}" display="inline" intent=":literal"><semantics><msub><mi>ε</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\varepsilon}_{i}</annotation></semantics></math>. Recall that each <math id="A1.SS8.p1.m7" class="ltx_Math" alttext="Y_{t}|\bm{P}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mi>t</mi></msub><mo fence="false">|</mo><mi>𝑷</mi></mrow><annotation encoding="application/x-tex">Y_{t}|\bm{P}</annotation></semantics></math> is generated according to <math id="A1.SS8.p1.m8" class="ltx_Math" alttext="(1-{\varepsilon}_{i})\mu_{0}+{\varepsilon}_{i}\mu_{1,\bm{P}_{t}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><msub><mi>ε</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mrow><mn>1</mn><mo>,</mo><msub><mi>𝑷</mi><mi>t</mi></msub></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">(1-{\varepsilon}_{i})\mu_{0}+{\varepsilon}_{i}\mu_{1,\bm{P}_{t}}</annotation></semantics></math>, where <math id="A1.SS8.p1.m9" class="ltx_Math" alttext="\bm{P}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝑷</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\bm{P}_{t}</annotation></semantics></math> is independently and uniformly sampled from the set <math id="A1.SS8.p1.m10" class="ltx_Math" alttext="\{\bm{P}_{1},\ldots,\bm{P}_{n}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>𝑷</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝑷</mi><mi>n</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\bm{P}_{1},\ldots,\bm{P}_{n}\}</annotation></semantics></math>.
We explain the choice of <math id="A1.SS8.p1.m11" class="ltx_Math" alttext="{\varepsilon}_{i}" display="inline" intent=":literal"><semantics><msub><mi>ε</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\varepsilon}_{i}</annotation></semantics></math> as follows. Since <math id="A1.SS8.p1.m12" class="ltx_Math" alttext="{\mathcal{B}}({\varepsilon})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{B}}({\varepsilon})</annotation></semantics></math> is an open interval containing <math id="A1.SS8.p1.m13" class="ltx_Math" alttext="{\varepsilon}" display="inline" intent=":literal"><semantics><mi>ε</mi><annotation encoding="application/x-tex">{\varepsilon}</annotation></semantics></math>, we must have <math id="A1.SS8.p1.m14" class="ltx_Math" alttext="{\varepsilon}\in{\mathcal{B}}({\varepsilon})" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\varepsilon}\in{\mathcal{B}}({\varepsilon})</annotation></semantics></math> and <math id="A1.SS8.p1.m15" class="ltx_Math" alttext="{\varepsilon}+\Delta\in{\mathcal{B}}({\varepsilon})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ε</mi><mo>+</mo><mi mathvariant="normal">Δ</mi></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\varepsilon}+\Delta\in{\mathcal{B}}({\varepsilon})</annotation></semantics></math> for a sufficiently small <math id="A1.SS8.p1.m16" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>. We then select <math id="A1.SS8.p1.m17" class="ltx_Math" alttext="{\varepsilon}_{1}={\varepsilon}+\Delta" display="inline" intent=":literal"><semantics><mrow><msub><mi>ε</mi><mn>1</mn></msub><mo>=</mo><mrow><mi>ε</mi><mo>+</mo><mi mathvariant="normal">Δ</mi></mrow></mrow><annotation encoding="application/x-tex">{\varepsilon}_{1}={\varepsilon}+\Delta</annotation></semantics></math> and <math id="A1.SS8.p1.m18" class="ltx_Math" alttext="{\varepsilon}_{2}={\varepsilon}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ε</mi><mn>2</mn></msub><mo>=</mo><mi>ε</mi></mrow><annotation encoding="application/x-tex">{\varepsilon}_{2}={\varepsilon}</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS8.p2" class="ltx_para">
<p id="A1.SS8.p2.1" class="ltx_p"><span id="A1.SS8.p2.1.1" class="ltx_text">In the following, we discuss two classes of estimators and identify the minimax lower bound for their mean absolute error. The proof ideas are essentially the same.</span></p>
</div>
</div>
<section id="A1.SS8.SSS0.Px1" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">(a) Indicator functions.</h6>

<div id="A1.SS8.SSS0.Px1.p1" class="ltx_para">
<p id="A1.SS8.SSS0.Px1.p1.1" class="ltx_p">Let <math id="A1.SS8.SSS0.Px1.p1.m1" class="ltx_Math" alttext="{\mathcal{G}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">{\mathcal{G}}</annotation></semantics></math> collect all measurable functions of the <math id="A1.SS8.SSS0.Px1.p1.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-dimensional indicator functions <math id="A1.SS8.SSS0.Px1.p1.m3" class="ltx_math_unparsed" alttext="(\mathbf{1}\{Y_{1}\leq\delta\},\ldots,\mathbf{1}\{Y_{n}\leq\delta\})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>𝟏</mn><mrow><mo stretchy="false">{</mo><msub><mi>Y</mi><mn>1</mn></msub><mo>≤</mo><mi>δ</mi><mo stretchy="false">}</mo></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>𝟏</mn><mrow><mo stretchy="false">{</mo><msub><mi>Y</mi><mi>n</mi></msub><mo>≤</mo><mi>δ</mi><mo stretchy="false">}</mo></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbf{1}\{Y_{1}\leq\delta\},\ldots,\mathbf{1}\{Y_{n}\leq\delta\})</annotation></semantics></math>.
We first establish the lower bound for <math id="A1.SS8.SSS0.Px1.p1.m4" class="ltx_Math" alttext="\widehat{{\varepsilon}}\in{\mathcal{G}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow><annotation encoding="application/x-tex">\widehat{{\varepsilon}}\in{\mathcal{G}}</annotation></semantics></math>.
Given that the <math id="A1.SS8.SSS0.Px1.p1.m5" class="ltx_Math" alttext="Y_{t}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mi>t</mi></msub><annotation encoding="application/x-tex">Y_{t}</annotation></semantics></math>’s are generated independently and identically, the joint distribution <math id="A1.SS8.SSS0.Px1.p1.m6" class="ltx_Math" alttext="\rho_{i}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\rho_{i}</annotation></semantics></math> is the product of <math id="A1.SS8.SSS0.Px1.p1.m7" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> independent Bernoulli distributions:</p>
<table id="A1.Ex95" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex95.m1" class="ltx_Math" alttext="\rho_{i}=\mathrm{Ber}(p({\varepsilon}_{i}))^{\otimes n}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ρ</mi><mi>i</mi></msub><mo>=</mo><mrow><mi>Ber</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\rho_{i}=\mathrm{Ber}(p({\varepsilon}_{i}))^{\otimes n},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS8.SSS0.Px1.p1.2" class="ltx_p">where</p>
<table id="A1.Ex96" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex96.m1" class="ltx_Math" alttext="p({\varepsilon}_{i})=(1-{\varepsilon}_{i})F_{0}(\delta)+{\varepsilon}_{i}\bar{F}_{\bm{P}}(\delta)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>ε</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">p({\varepsilon}_{i})=(1-{\varepsilon}_{i})F_{0}(\delta)+{\varepsilon}_{i}\bar{F}_{\bm{P}}(\delta).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS8.SSS0.Px1.p1.3" class="ltx_p">By the relation (<a href="#S3.E2" title="Equation 2 ‣ 3.3 Estimation Methods ‣ 3 Proportion Estimation Methods ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>) and the choice that <math id="A1.SS8.SSS0.Px1.p1.m8" class="ltx_Math" alttext="{\varepsilon}_{2}={\varepsilon}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ε</mi><mn>2</mn></msub><mo>=</mo><mi>ε</mi></mrow><annotation encoding="application/x-tex">{\varepsilon}_{2}={\varepsilon}</annotation></semantics></math>, it follows that</p>
<table id="A1.E27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E27.m1" class="ltx_Math" alttext="\bar{F}(\delta)=(1-{\varepsilon})F_{0}(\delta)+{\varepsilon}\bar{F}_{\bm{P}}(\delta)=p({\varepsilon})=p({\varepsilon}_{2})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bar{F}(\delta)=(1-{\varepsilon})F_{0}(\delta)+{\varepsilon}\bar{F}_{\bm{P}}(\delta)=p({\varepsilon})=p({\varepsilon}_{2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(27)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS8.SSS0.Px1.p2" class="ltx_para">
<p id="A1.SS8.SSS0.Px1.p2.1" class="ltx_p">Next, we further upper bound the total variation distance <math id="A1.SS8.SSS0.Px1.p2.m1" class="ltx_Math" alttext="D_{\mathrm{TV}}(\rho_{1},\rho_{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>TV</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ρ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>ρ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D_{\mathrm{TV}}(\rho_{1},\rho_{2})</annotation></semantics></math> in (<a href="#A1.E26" title="Equation 26 ‣ Proof of Theorem . ‣ A.8 Proof of Theorem ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>) to simplify the expression.</p>
<table id="A1.EGx34" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex97"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex97.m1" class="ltx_Math" alttext="\displaystyle D_{\mathrm{TV}}(\rho_{1},\rho_{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>TV</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ρ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>ρ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle D_{\mathrm{TV}}(\rho_{1},\rho_{2})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex97.m2" class="ltx_Math" alttext="\displaystyle\overset{(a)}{\leq}\sqrt{\frac{1}{2}D_{\mathrm{KL}}(\rho_{1},\rho_{2})}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">a</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><mi>KL</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ρ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>ρ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(a)}{\leq}\sqrt{\frac{1}{2}D_{\mathrm{KL}}(\rho_{1},\rho_{2})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex98"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex98.m1" class="ltx_Math" alttext="\displaystyle\overset{(b)}{\leq}\sqrt{\frac{n}{2}D_{\mathrm{KL}}(\mathrm{Ber}(p({\varepsilon}_{1})),\mathrm{Ber}(p({\varepsilon}_{2})))}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">b</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mstyle displaystyle="true"><mfrac><mi>n</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><mi>KL</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Ber</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>Ber</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(b)}{\leq}\sqrt{\frac{n}{2}D_{\mathrm{KL}}(\mathrm{Ber}(p({\varepsilon}_{1})),\mathrm{Ber}(p({\varepsilon}_{2})))}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex99"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex99.m1" class="ltx_Math" alttext="\displaystyle\overset{(c)}{\leq}\sqrt{\frac{n|{\varepsilon}_{1}-{\varepsilon}_{2}|^{2}}{2}\frac{[F_{0}(\delta)-\bar{F}_{\bm{P}}(\delta)]^{2}}{p({\varepsilon}_{2})(1-p({\varepsilon}_{2}))}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">c</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mrow><msub><mi>ε</mi><mn>1</mn></msub><mo>−</mo><msub><mi>ε</mi><mn>2</mn></msub></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(c)}{\leq}\sqrt{\frac{n|{\varepsilon}_{1}-{\varepsilon}_{2}|^{2}}{2}\frac{[F_{0}(\delta)-\bar{F}_{\bm{P}}(\delta)]^{2}}{p({\varepsilon}_{2})(1-p({\varepsilon}_{2}))}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex100"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex100.m1" class="ltx_Math" alttext="\displaystyle\overset{(d)}{\leq}\frac{1}{\sqrt{2}}|F_{0}(\delta)-\bar{F}_{\bm{P}}(\delta)|\Delta\cdot\sqrt{\frac{n}{\bar{F}(\delta)(1-\bar{F}(\delta))}}" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">d</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mn>2</mn></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msqrt><mstyle displaystyle="true"><mfrac><mi>n</mi><mrow><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(d)}{\leq}\frac{1}{\sqrt{2}}|F_{0}(\delta)-\bar{F}_{\bm{P}}(\delta)|\Delta\cdot\sqrt{\frac{n}{\bar{F}(\delta)(1-\bar{F}(\delta))}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E28.m1" class="ltx_Math" alttext="\displaystyle\overset{(e)}{\leq}\sqrt{\frac{n}{2}}\frac{\Delta}{\sigma_{n}^{\star}}," display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">e</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mi>n</mi><mn>2</mn></mfrac></mstyle></msqrt><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi mathvariant="normal">Δ</mi><msubsup><mi>σ</mi><mi>n</mi><mo>⋆</mo></msubsup></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(e)}{\leq}\sqrt{\frac{n}{2}}\frac{\Delta}{\sigma_{n}^{\star}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
</table>
<p id="A1.SS8.SSS0.Px1.p2.2" class="ltx_p">where</p>
<ol id="A1.I4" class="ltx_enumerate">
<li id="A1.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><math id="A1.I4.i1.m1" class="ltx_Math" alttext="(a)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a)</annotation></semantics></math></span> 
<div id="A1.I4.i1.p1" class="ltx_para">
<p id="A1.I4.i1.p1.1" class="ltx_p">uses the Pinsker inequality, which allows us to upper bound the total variation distance by the square root of half the Kullback-Leibler (KL) divergence.</p>
</div></li>
<li id="A1.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><math id="A1.I4.i2.m1" class="ltx_Math" alttext="(b)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b)</annotation></semantics></math></span> 
<div id="A1.I4.i2.p1" class="ltx_para">
<p id="A1.I4.i2.p1.1" class="ltx_p">employs the decoupling property of KL divergences and the fact that <math id="A1.I4.i2.p1.m1" class="ltx_Math" alttext="\rho_{i}=\mathrm{Ber}(p({\varepsilon}_{i}))^{\otimes n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mi>i</mi></msub><mo>=</mo><mrow><mi>Ber</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\rho_{i}=\mathrm{Ber}(p({\varepsilon}_{i}))^{\otimes n}</annotation></semantics></math>, leading to</p>
<table id="A1.Ex101" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex101.m1" class="ltx_math_unparsed" alttext="D_{\mathrm{KL}}(\rho_{1}\|\rho_{2})=nD_{\mathrm{KL}}(\mathrm{Ber}(p({\varepsilon}_{1}))\|\mathrm{Ber}(p({\varepsilon}_{2})))." display="block" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>ρ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>ρ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>n</mi><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo stretchy="false">(</mo><mi>Ber</mi><mrow><mo stretchy="false">(</mo><mi>p</mi><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>Ber</mi><mrow><mo stretchy="false">(</mo><mi>p</mi><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">D_{\mathrm{KL}}(\rho_{1}\|\rho_{2})=nD_{\mathrm{KL}}(\mathrm{Ber}(p({\varepsilon}_{1}))\|\mathrm{Ber}(p({\varepsilon}_{2}))).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A1.I4.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><math id="A1.I4.i3.m1" class="ltx_Math" alttext="(c)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(c)</annotation></semantics></math></span> 
<div id="A1.I4.i3.p1" class="ltx_para">
<p id="A1.I4.i3.p1.1" class="ltx_p">utilizes the numerical inequality that</p>
<table id="A1.Ex102" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex102.m1" class="ltx_math_unparsed" alttext="D_{\mathrm{KL}}(\mathrm{Ber}(p)\|\mathrm{Ber}(q))=p\log\frac{p}{q}+(1-p)\log\frac{1-p}{1-q}\leq\frac{(p-q)^{2}}{q(1-q)}." display="block" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo stretchy="false">(</mo><mi>Ber</mi><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>Ber</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>p</mi><mi>log</mi><mfrac><mi>p</mi><mi>q</mi></mfrac><mo>+</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>p</mi><mo rspace="0.167em" stretchy="false">)</mo></mrow><mi>log</mi><mfrac><mrow><mn>1</mn><mo>−</mo><mi>p</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>q</mi></mrow></mfrac><mo>≤</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">D_{\mathrm{KL}}(\mathrm{Ber}(p)\|\mathrm{Ber}(q))=p\log\frac{p}{q}+(1-p)\log\frac{1-p}{1-q}\leq\frac{(p-q)^{2}}{q(1-q)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A1.I4.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><math id="A1.I4.i4.m1" class="ltx_Math" alttext="(d)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(d)</annotation></semantics></math></span> 
<div id="A1.I4.i4.p1" class="ltx_para">
<p id="A1.I4.i4.p1.1" class="ltx_p">uses the notation <math id="A1.I4.i4.p1.m1" class="ltx_Math" alttext="\Delta=|{\varepsilon}_{1}-{\varepsilon}_{2}|" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>=</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>ε</mi><mn>1</mn></msub><mo>−</mo><msub><mi>ε</mi><mn>2</mn></msub></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta=|{\varepsilon}_{1}-{\varepsilon}_{2}|</annotation></semantics></math>.</p>
</div></li>
<li id="A1.I4.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><math id="A1.I4.i5.m1" class="ltx_Math" alttext="(e)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(e)</annotation></semantics></math></span> 
<div id="A1.I4.i5.p1" class="ltx_para">
<p id="A1.I4.i5.p1.1" class="ltx_p">uses the definition of <math id="A1.I4.i5.p1.m1" class="ltx_Math" alttext="\sigma_{n}^{\star}" display="inline" intent=":literal"><semantics><msubsup><mi>σ</mi><mi>n</mi><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">\sigma_{n}^{\star}</annotation></semantics></math> that is <math id="A1.I4.i5.p1.m2" class="ltx_Math" alttext="[\sigma_{n}^{\star}]^{2}=\frac{\bar{F}({\varepsilon})(1-\bar{F}({\varepsilon}))}{[F_{0}(\delta)-\bar{F}_{\bm{P}}(\delta)]^{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">[</mo><msubsup><mi>σ</mi><mi>n</mi><mo>⋆</mo></msubsup><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mo>=</mo><mfrac><mrow><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">[\sigma_{n}^{\star}]^{2}=\frac{\bar{F}({\varepsilon})(1-\bar{F}({\varepsilon}))}{[F_{0}(\delta)-\bar{F}_{\bm{P}}(\delta)]^{2}}.</annotation></semantics></math></p>
</div></li>
</ol>
</div>
<div id="A1.SS8.SSS0.Px1.p3" class="ltx_para">
<p id="A1.SS8.SSS0.Px1.p3.1" class="ltx_p">Combining (<a href="#A1.E26" title="Equation 26 ‣ Proof of Theorem . ‣ A.8 Proof of Theorem ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>) and (<a href="#A1.E28" title="Equation 28 ‣ (a) Indicator functions. ‣ A.8 Proof of Theorem ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">28</span></a>), we obtain</p>
<table id="A1.Ex103" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex103.m1" class="ltx_Math" alttext="\inf_{\widehat{{\varepsilon}}\in{\mathcal{G}}}\sup_{{\varepsilon}_{0}\in{\mathcal{B}}({\varepsilon})}\EB|\widehat{{\varepsilon}}-{\varepsilon}_{0}|\geq\frac{\Delta}{2}\left(1-\frac{1}{\sqrt{2}}\frac{\sqrt{n}\Delta}{\sigma_{n}^{\star}}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">inf</mo><mrow><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow></munder><mrow><munder><mo lspace="0.167em" movablelimits="false" rspace="0.167em">sup</mo><mrow><msub><mi>ε</mi><mn>0</mn></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mrow><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mo>−</mo><msub><mi>ε</mi><mn>0</mn></msub></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow><mo>≥</mo><mrow><mfrac><mi mathvariant="normal">Δ</mi><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mfrac><mn>1</mn><msqrt><mn>2</mn></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msqrt><mi>n</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow><msubsup><mi>σ</mi><mi>n</mi><mo>⋆</mo></msubsup></mfrac></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\inf_{\widehat{{\varepsilon}}\in{\mathcal{G}}}\sup_{{\varepsilon}_{0}\in{\mathcal{B}}({\varepsilon})}\EB|\widehat{{\varepsilon}}-{\varepsilon}_{0}|\geq\frac{\Delta}{2}\left(1-\frac{1}{\sqrt{2}}\frac{\sqrt{n}\Delta}{\sigma_{n}^{\star}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS8.SSS0.Px1.p3.2" class="ltx_p">By setting <math id="A1.SS8.SSS0.Px1.p3.m1" class="ltx_Math" alttext="\Delta=\frac{\sigma_{n}^{\star}}{\sqrt{2n}}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>=</mo><mfrac><msubsup><mi>σ</mi><mi>n</mi><mo>⋆</mo></msubsup><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msqrt></mfrac></mrow><annotation encoding="application/x-tex">\Delta=\frac{\sigma_{n}^{\star}}{\sqrt{2n}}</annotation></semantics></math> and assuming that <math id="A1.SS8.SSS0.Px1.p3.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> is sufficiently large such that <math id="A1.SS8.SSS0.Px1.p3.m3" class="ltx_Math" alttext="{\varepsilon}+\Delta\in{\mathcal{B}}({\varepsilon})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ε</mi><mo>+</mo><mi mathvariant="normal">Δ</mi></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\varepsilon}+\Delta\in{\mathcal{B}}({\varepsilon})</annotation></semantics></math>, we obtain</p>
<table id="A1.Ex104" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex104.m1" class="ltx_Math" alttext="\inf_{\widehat{{\varepsilon}}\in{\mathcal{G}}}\sup_{{\varepsilon}_{0}\in{\mathcal{B}}({\varepsilon})}\EB|\widehat{{\varepsilon}}-{\varepsilon}_{0}|\geq\frac{\sigma_{n}^{\star}}{\sqrt{2n}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">inf</mo><mrow><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow></munder><mrow><munder><mo lspace="0.167em" movablelimits="false" rspace="0.167em">sup</mo><mrow><msub><mi>ε</mi><mn>0</mn></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mrow><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mo>−</mo><msub><mi>ε</mi><mn>0</mn></msub></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow><mo>≥</mo><mfrac><msubsup><mi>σ</mi><mi>n</mi><mo>⋆</mo></msubsup><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msqrt></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\inf_{\widehat{{\varepsilon}}\in{\mathcal{G}}}\sup_{{\varepsilon}_{0}\in{\mathcal{B}}({\varepsilon})}\EB|\widehat{{\varepsilon}}-{\varepsilon}_{0}|\geq\frac{\sigma_{n}^{\star}}{\sqrt{2n}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS8.SSS0.Px1.p3.3" class="ltx_p">This completes the proof of the first part.</p>
</div>
</section>
<section id="A1.SS8.SSS0.Px2" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">(b) General functions.</h6>

<div id="A1.SS8.SSS0.Px2.p1" class="ltx_para">
<p id="A1.SS8.SSS0.Px2.p1.1" class="ltx_p">Let <math id="A1.SS8.SSS0.Px2.p1.m1" class="ltx_Math" alttext="{\mathcal{G}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">{\mathcal{G}}</annotation></semantics></math> denote the set of all general measurable functions of the <math id="A1.SS8.SSS0.Px2.p1.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-dimensional random vector <math id="A1.SS8.SSS0.Px2.p1.m3" class="ltx_Math" alttext="(Y_{1},\ldots,Y_{n})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>Y</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(Y_{1},\ldots,Y_{n})</annotation></semantics></math>. We now establish the lower bound for any <math id="A1.SS8.SSS0.Px2.p1.m4" class="ltx_Math" alttext="\widehat{{\varepsilon}}\in{\mathcal{G}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow><annotation encoding="application/x-tex">\widehat{{\varepsilon}}\in{\mathcal{G}}</annotation></semantics></math> under this broader class of functions.
Given that the <math id="A1.SS8.SSS0.Px2.p1.m5" class="ltx_Math" alttext="Y_{t}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mi>t</mi></msub><annotation encoding="application/x-tex">Y_{t}</annotation></semantics></math>’s are generated independently, the joint distribution <math id="A1.SS8.SSS0.Px2.p1.m6" class="ltx_Math" alttext="\rho_{i}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\rho_{i}</annotation></semantics></math> is the product of <math id="A1.SS8.SSS0.Px2.p1.m7" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> independent mixture distributions:</p>
<table id="A1.Ex105" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex105.m1" class="ltx_Math" alttext="\rho_{i}=[(1-{\varepsilon}_{i})F_{0}+{\varepsilon}_{i}\bar{F}_{\bm{P}}]^{\otimes n}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ρ</mi><mi>i</mi></msub><mo>=</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><msub><mi>ε</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\rho_{i}=[(1-{\varepsilon}_{i})F_{0}+{\varepsilon}_{i}\bar{F}_{\bm{P}}]^{\otimes n}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS8.SSS0.Px2.p1.2" class="ltx_p">We similarly begin with (<a href="#A1.E26" title="Equation 26 ‣ Proof of Theorem . ‣ A.8 Proof of Theorem ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>) and aim to upper bound the total variation distance <math id="A1.SS8.SSS0.Px2.p1.m8" class="ltx_Math" alttext="D_{\mathrm{TV}}(\rho_{1},\rho_{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>TV</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ρ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>ρ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D_{\mathrm{TV}}(\rho_{1},\rho_{2})</annotation></semantics></math>. Since the proof closely resembles that of (<a href="#A1.E28" title="Equation 28 ‣ (a) Indicator functions. ‣ A.8 Proof of Theorem ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">28</span></a>), we focus only on the key differences below.</p>
<table id="A1.EGx35" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex106"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex106.m1" class="ltx_Math" alttext="\displaystyle D_{\mathrm{TV}}(\rho_{1},\rho_{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>TV</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ρ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>ρ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle D_{\mathrm{TV}}(\rho_{1},\rho_{2})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex106.m2" class="ltx_Math" alttext="\displaystyle\leq\sqrt{\frac{1}{2}D_{\mathrm{KL}}(\rho_{1},\rho_{2})}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><msqrt><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><mi>KL</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ρ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>ρ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sqrt{\frac{1}{2}D_{\mathrm{KL}}(\rho_{1},\rho_{2})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex107"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex107.m1" class="ltx_Math" alttext="\displaystyle=\sqrt{\frac{n}{2}D_{\mathrm{KL}}((1-{\varepsilon}_{1})F_{0}+{\varepsilon}_{1}\bar{F}_{\bm{P}},(1-{\varepsilon}_{2})F_{0}+{\varepsilon}_{2}\bar{F}_{\bm{P}})}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msqrt><mrow><mstyle displaystyle="true"><mfrac><mi>n</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><mi>KL</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><msub><mi>ε</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub></mrow></mrow><mo>,</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><msub><mi>ε</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle=\sqrt{\frac{n}{2}D_{\mathrm{KL}}((1-{\varepsilon}_{1})F_{0}+{\varepsilon}_{1}\bar{F}_{\bm{P}},(1-{\varepsilon}_{2})F_{0}+{\varepsilon}_{2}\bar{F}_{\bm{P}})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex108"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex108.m1" class="ltx_Math" alttext="\displaystyle\overset{(a)}{\leq}\sqrt{\frac{n}{2}D_{\chi^{2}}((1-{\varepsilon}_{1})F_{0}+{\varepsilon}_{1}\bar{F}_{\bm{P}},(1-{\varepsilon}_{2})F_{0}+{\varepsilon}_{2}\bar{F}_{\bm{P}})}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">a</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mstyle displaystyle="true"><mfrac><mi>n</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><msup><mi>χ</mi><mn>2</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><msub><mi>ε</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub></mrow></mrow><mo>,</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><msub><mi>ε</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(a)}{\leq}\sqrt{\frac{n}{2}D_{\chi^{2}}((1-{\varepsilon}_{1})F_{0}+{\varepsilon}_{1}\bar{F}_{\bm{P}},(1-{\varepsilon}_{2})F_{0}+{\varepsilon}_{2}\bar{F}_{\bm{P}})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex109"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex109.m1" class="ltx_Math" alttext="\displaystyle\overset{(b)}{\leq}\sqrt{\frac{|{\varepsilon}_{1}-{\varepsilon}_{2}|^{2}}{2}n\cdot\int\frac{({\mathrm{d}}F_{0}-{\mathrm{d}}\bar{F}_{\bm{P}})^{2}}{(1-{\varepsilon}){\mathrm{d}}F_{0}+{\varepsilon}{\mathrm{d}}\bar{F}_{\bm{P}}}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">b</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">|</mo><mrow><msub><mi>ε</mi><mn>1</mn></msub><mo>−</mo><msub><mi>ε</mi><mn>2</mn></msub></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub></mrow></mrow></mfrac></mrow></mstyle></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(b)}{\leq}\sqrt{\frac{|{\varepsilon}_{1}-{\varepsilon}_{2}|^{2}}{2}n\cdot\int\frac{({\mathrm{d}}F_{0}-{\mathrm{d}}\bar{F}_{\bm{P}})^{2}}{(1-{\varepsilon}){\mathrm{d}}F_{0}+{\varepsilon}{\mathrm{d}}\bar{F}_{\bm{P}}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex110"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex110.m1" class="ltx_Math" alttext="\displaystyle=\Delta\sqrt{\frac{n}{2}}\cdot\sqrt{\int\frac{({\mathrm{d}}F_{0}-{\mathrm{d}}\bar{F}_{\bm{P}})^{2}}{(1-{\varepsilon}){\mathrm{d}}F_{0}+{\varepsilon}{\mathrm{d}}\bar{F}_{\bm{P}}}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mi>n</mi><mn>2</mn></mfrac></mstyle></msqrt></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msqrt><mstyle displaystyle="true"><mrow><mo>∫</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub></mrow></mrow></mfrac></mrow></mstyle></msqrt></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\Delta\sqrt{\frac{n}{2}}\cdot\sqrt{\int\frac{({\mathrm{d}}F_{0}-{\mathrm{d}}\bar{F}_{\bm{P}})^{2}}{(1-{\varepsilon}){\mathrm{d}}F_{0}+{\varepsilon}{\mathrm{d}}\bar{F}_{\bm{P}}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E29.m1" class="ltx_Math" alttext="\displaystyle\overset{(c)}{=}\sqrt{\frac{n}{2}}\frac{\Delta}{\tau_{n}^{\star}}," display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mo>=</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">c</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mi>n</mi><mn>2</mn></mfrac></mstyle></msqrt><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi mathvariant="normal">Δ</mi><msubsup><mi>τ</mi><mi>n</mi><mo>⋆</mo></msubsup></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(c)}{=}\sqrt{\frac{n}{2}}\frac{\Delta}{\tau_{n}^{\star}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(29)</span></td></tr></tbody>
</table>
<p id="A1.SS8.SSS0.Px2.p1.3" class="ltx_p">where</p>
<ol id="A1.I5" class="ltx_enumerate">
<li id="A1.I5.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><math id="A1.I5.i1.m1" class="ltx_Math" alttext="(a)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a)</annotation></semantics></math></span> 
<div id="A1.I5.i1.p1" class="ltx_para">
<p id="A1.I5.i1.p1.1" class="ltx_p">uses the fact that the Kullback-Leibler (KL) divergence is always upper bounded by its Chi-square divergence:</p>
<table id="A1.Ex111" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex111.m1" class="ltx_Math" alttext="D_{\mathrm{KL}}(P,Q)=\int\log\frac{{\mathrm{d}}P}{{\mathrm{d}}Q}{\mathrm{d}}P\leq\int\frac{({\mathrm{d}}P-{\mathrm{d}}Q)^{2}}{{\mathrm{d}}Q}=D_{\chi^{2}}(P,Q)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>D</mi><mi>KL</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>,</mo><mi>Q</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo>∫</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow></mfrac></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>P</mi></mrow></mrow></mrow><mo rspace="0.111em">≤</mo><mrow><mo>∫</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow></mfrac></mrow><mo>=</mo><mrow><msub><mi>D</mi><msup><mi>χ</mi><mn>2</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>,</mo><mi>Q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">D_{\mathrm{KL}}(P,Q)=\int\log\frac{{\mathrm{d}}P}{{\mathrm{d}}Q}{\mathrm{d}}P\leq\int\frac{({\mathrm{d}}P-{\mathrm{d}}Q)^{2}}{{\mathrm{d}}Q}=D_{\chi^{2}}(P,Q).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A1.I5.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><math id="A1.I5.i2.m1" class="ltx_Math" alttext="(b)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b)</annotation></semantics></math></span> 
<div id="A1.I5.i2.p1" class="ltx_para">
<p id="A1.I5.i2.p1.1" class="ltx_p">uses the fact that</p>
<table id="A1.E30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E30.m1" class="ltx_Math" alttext="D_{\chi^{2}}((1-{\varepsilon}_{1})F_{0}+{\varepsilon}_{1}\bar{F}_{\bm{P}},(1-{\varepsilon}_{2})F_{0}+{\varepsilon}_{2}\bar{F}_{\bm{P}})=|{\varepsilon}_{1}-{\varepsilon}_{2}|^{2}\cdot\int\frac{({\mathrm{d}}F_{0}-{\mathrm{d}}\bar{F}_{\bm{P}})^{2}}{(1-{\varepsilon}){\mathrm{d}}F_{0}+{\varepsilon}{\mathrm{d}}\bar{F}_{\bm{P}}}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>D</mi><msup><mi>χ</mi><mn>2</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><msub><mi>ε</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub></mrow></mrow><mo>,</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><msub><mi>ε</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">|</mo><mrow><msub><mi>ε</mi><mn>1</mn></msub><mo>−</mo><msub><mi>ε</mi><mn>2</mn></msub></mrow><mo rspace="0.055em" stretchy="false">|</mo></mrow><mn>2</mn></msup><mo rspace="0.055em">⋅</mo><mrow><mo>∫</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub></mrow></mrow></mfrac></mrow></mrow></mrow><annotation encoding="application/x-tex">D_{\chi^{2}}((1-{\varepsilon}_{1})F_{0}+{\varepsilon}_{1}\bar{F}_{\bm{P}},(1-{\varepsilon}_{2})F_{0}+{\varepsilon}_{2}\bar{F}_{\bm{P}})=|{\varepsilon}_{1}-{\varepsilon}_{2}|^{2}\cdot\int\frac{({\mathrm{d}}F_{0}-{\mathrm{d}}\bar{F}_{\bm{P}})^{2}}{(1-{\varepsilon}){\mathrm{d}}F_{0}+{\varepsilon}{\mathrm{d}}\bar{F}_{\bm{P}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(30)</span></td></tr></tbody>
</table>
</div></li>
<li id="A1.I5.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><math id="A1.I5.i3.m1" class="ltx_Math" alttext="(c)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(c)</annotation></semantics></math></span> 
<div id="A1.I5.i3.p1" class="ltx_para">
<p id="A1.I5.i3.p1.1" class="ltx_p">uses the definition of <math id="A1.I5.i3.p1.m1" class="ltx_Math" alttext="\tau_{n}^{\star}" display="inline" intent=":literal"><semantics><msubsup><mi>τ</mi><mi>n</mi><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">\tau_{n}^{\star}</annotation></semantics></math>,, which is given by:</p>
<table id="A1.Ex112" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex112.m1" class="ltx_Math" alttext="[\tau_{n}^{\star}]^{2}=\left[\int\frac{({\mathrm{d}}F_{0}-{\mathrm{d}}\bar{F}_{\bm{P}})^{2}}{(1-{\varepsilon}){\mathrm{d}}F_{0}+{\varepsilon}{\mathrm{d}}\bar{F}_{\bm{P}}}\right]^{-1}=\left[\int\frac{(1-g(x))^{2}}{(1-{\varepsilon})+{\varepsilon}g(x)}{\mathrm{d}}F_{0}(x)\right]^{-1}~~\text{where}~~g(x)=\frac{{\mathrm{d}}\bar{F}_{\bm{P}}(x)}{{\mathrm{d}}F_{0}(x)}." display="block" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">[</mo><msubsup><mi>τ</mi><mi>n</mi><mo>⋆</mo></msubsup><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mo>=</mo><msup><mrow><mo>[</mo><mrow><mo lspace="0em">∫</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub></mrow></mrow></mfrac></mrow><mo>]</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>=</mo><mrow><msup><mrow><mo>[</mo><mrow><mo lspace="0em">∫</mo><mrow><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mtext>where</mtext><mo lspace="0.660em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">[\tau_{n}^{\star}]^{2}=\left[\int\frac{({\mathrm{d}}F_{0}-{\mathrm{d}}\bar{F}_{\bm{P}})^{2}}{(1-{\varepsilon}){\mathrm{d}}F_{0}+{\varepsilon}{\mathrm{d}}\bar{F}_{\bm{P}}}\right]^{-1}=\left[\int\frac{(1-g(x))^{2}}{(1-{\varepsilon})+{\varepsilon}g(x)}{\mathrm{d}}F_{0}(x)\right]^{-1}~~\text{where}~~g(x)=\frac{{\mathrm{d}}\bar{F}_{\bm{P}}(x)}{{\mathrm{d}}F_{0}(x)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
<p id="A1.SS8.SSS0.Px2.p1.4" class="ltx_p">The remaining argument follows the same reasoning as in part (a).
In this way, we will have</p>
<table id="A1.Ex113" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex113.m1" class="ltx_Math" alttext="\inf_{\widehat{{\varepsilon}}\in{\mathcal{G}}}\sup_{{\varepsilon}_{0}\in{\mathcal{B}}({\varepsilon})}\EB|\widehat{{\varepsilon}}-{\varepsilon}_{0}|\geq\frac{\tau_{n}^{\star}}{\sqrt{2n}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">inf</mo><mrow><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow></munder><mrow><munder><mo lspace="0.167em" movablelimits="false" rspace="0.167em">sup</mo><mrow><msub><mi>ε</mi><mn>0</mn></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mrow><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mo>−</mo><msub><mi>ε</mi><mn>0</mn></msub></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow><mo>≥</mo><mfrac><msubsup><mi>τ</mi><mi>n</mi><mo>⋆</mo></msubsup><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msqrt></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\inf_{\widehat{{\varepsilon}}\in{\mathcal{G}}}\sup_{{\varepsilon}_{0}\in{\mathcal{B}}({\varepsilon})}\EB|\widehat{{\varepsilon}}-{\varepsilon}_{0}|\geq\frac{\tau_{n}^{\star}}{\sqrt{2n}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.SS8.SSS0.Px3" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">(c) Final inequality.</h6>

<div id="A1.SS8.SSS0.Px3.p1" class="ltx_para">
<p id="A1.SS8.SSS0.Px3.p1.1" class="ltx_p">In the end, we prove the inequality that <math id="A1.SS8.SSS0.Px3.p1.m1" class="ltx_Math" alttext="\sigma_{n}^{\star}\geq\tau_{n}^{\star}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>σ</mi><mi>n</mi><mo>⋆</mo></msubsup><mo>≥</mo><msubsup><mi>τ</mi><mi>n</mi><mo>⋆</mo></msubsup></mrow><annotation encoding="application/x-tex">\sigma_{n}^{\star}\geq\tau_{n}^{\star}</annotation></semantics></math>. The data processing inequality <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib30" title="" class="ltx_ref">30</a>]</cite> states that any post-processing of two distributions reduces the value of the <math id="A1.SS8.SSS0.Px3.p1.m2" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>-divergence between them, including the Chi-square divergence.
Therefore, using the same choices of <math id="A1.SS8.SSS0.Px3.p1.m3" class="ltx_Math" alttext="{\varepsilon}_{1}" display="inline" intent=":literal"><semantics><msub><mi>ε</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\varepsilon}_{1}</annotation></semantics></math>, <math id="A1.SS8.SSS0.Px3.p1.m4" class="ltx_Math" alttext="{\varepsilon}_{2}" display="inline" intent=":literal"><semantics><msub><mi>ε</mi><mn>2</mn></msub><annotation encoding="application/x-tex">{\varepsilon}_{2}</annotation></semantics></math> as before, we have:</p>
<table id="A1.EGx36" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex114"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex114.m1" class="ltx_Math" alttext="\displaystyle D_{\chi^{2}}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><msup><mi>χ</mi><mn>2</mn></msup></msub><annotation encoding="application/x-tex">\displaystyle D_{\chi^{2}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex114.m2" class="ltx_Math" alttext="\displaystyle(\mathrm{Ber}(p({\varepsilon}_{1})),\mathrm{Ber}(p({\varepsilon}_{2})))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>Ber</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>Ber</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle(\mathrm{Ber}(p({\varepsilon}_{1})),\mathrm{Ber}(p({\varepsilon}_{2})))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex115"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex115.m1" class="ltx_Math" alttext="\displaystyle=D_{\chi^{2}}(\mathrm{Ber}((1-{\varepsilon}_{1})F_{0}(\delta)+{\varepsilon}_{1}\bar{F}_{\bm{P}}(\delta)),\mathrm{Ber}((1-{\varepsilon}_{2})F_{0}(\delta)+{\varepsilon}_{2}\bar{F}_{\bm{P}}(\delta)))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>D</mi><msup><mi>χ</mi><mn>2</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Ber</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>ε</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>Ber</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>ε</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=D_{\chi^{2}}(\mathrm{Ber}((1-{\varepsilon}_{1})F_{0}(\delta)+{\varepsilon}_{1}\bar{F}_{\bm{P}}(\delta)),\mathrm{Ber}((1-{\varepsilon}_{2})F_{0}(\delta)+{\varepsilon}_{2}\bar{F}_{\bm{P}}(\delta)))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E31.m1" class="ltx_Math" alttext="\displaystyle\leq D_{\chi^{2}}((1-{\varepsilon}_{1})F_{0}+{\varepsilon}_{1}\bar{F}_{\bm{P}},(1-{\varepsilon}_{2})F_{0}+{\varepsilon}_{2}\bar{F}_{\bm{P}})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>D</mi><msup><mi>χ</mi><mn>2</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><msub><mi>ε</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub></mrow></mrow><mo>,</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><msub><mi>ε</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq D_{\chi^{2}}((1-{\varepsilon}_{1})F_{0}+{\varepsilon}_{1}\bar{F}_{\bm{P}},(1-{\varepsilon}_{2})F_{0}+{\varepsilon}_{2}\bar{F}_{\bm{P}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(31)</span></td></tr></tbody>
</table>
<p id="A1.SS8.SSS0.Px3.p1.2" class="ltx_p">Note that, by definition, it follows that:</p>
<table id="A1.EGx37" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="A1.E32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E32.m1" class="ltx_Math" alttext="\displaystyle D_{\chi^{2}}(\mathrm{Ber}(p({\varepsilon}_{1})),\mathrm{Ber}(p({\varepsilon}_{2})))=\frac{[p({\varepsilon}_{1})-p({\varepsilon}_{2})]^{2}}{p({\varepsilon}_{2})(1-p({\varepsilon}_{2}))}=|{\varepsilon}_{1}-{\varepsilon}_{2}|^{2}\cdot\frac{[F_{0}(\delta)-\bar{F}_{\bm{P}}(\delta)]^{2}}{\bar{F}(\delta)(1-\bar{F}(\delta))}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>D</mi><msup><mi>χ</mi><mn>2</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Ber</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>Ber</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>=</mo><mrow><msup><mrow><mo stretchy="false">|</mo><mrow><msub><mi>ε</mi><mn>1</mn></msub><mo>−</mo><msub><mi>ε</mi><mn>2</mn></msub></mrow><mo rspace="0.055em" stretchy="false">|</mo></mrow><mn>2</mn></msup><mo rspace="0.222em">⋅</mo><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mrow><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle D_{\chi^{2}}(\mathrm{Ber}(p({\varepsilon}_{1})),\mathrm{Ber}(p({\varepsilon}_{2})))=\frac{[p({\varepsilon}_{1})-p({\varepsilon}_{2})]^{2}}{p({\varepsilon}_{2})(1-p({\varepsilon}_{2}))}=|{\varepsilon}_{1}-{\varepsilon}_{2}|^{2}\cdot\frac{[F_{0}(\delta)-\bar{F}_{\bm{P}}(\delta)]^{2}}{\bar{F}(\delta)(1-\bar{F}(\delta))},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(32)</span></td></tr></tbody>
<tbody id="A1.E33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E33.m1" class="ltx_Math" alttext="\displaystyle D_{\chi^{2}}((1-{\varepsilon}_{1})F_{0}+{\varepsilon}_{1}\bar{F}_{\bm{P}},(1-{\varepsilon}_{2})F_{0}+{\varepsilon}_{2}\bar{F}_{\bm{P}})=|{\varepsilon}_{1}-{\varepsilon}_{2}|^{2}\cdot\int\frac{({\mathrm{d}}F_{0}-{\mathrm{d}}\bar{F}_{\bm{P}})^{2}}{(1-{\varepsilon}){\mathrm{d}}F_{0}+{\varepsilon}{\mathrm{d}}\bar{F}_{\bm{P}}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>D</mi><msup><mi>χ</mi><mn>2</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><msub><mi>ε</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub></mrow></mrow><mo>,</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><msub><mi>ε</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">|</mo><mrow><msub><mi>ε</mi><mn>1</mn></msub><mo>−</mo><msub><mi>ε</mi><mn>2</mn></msub></mrow><mo rspace="0.055em" stretchy="false">|</mo></mrow><mn>2</mn></msup><mo rspace="0.055em">⋅</mo><mrow><mo>∫</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub></mrow></mrow></mfrac></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle D_{\chi^{2}}((1-{\varepsilon}_{1})F_{0}+{\varepsilon}_{1}\bar{F}_{\bm{P}},(1-{\varepsilon}_{2})F_{0}+{\varepsilon}_{2}\bar{F}_{\bm{P}})=|{\varepsilon}_{1}-{\varepsilon}_{2}|^{2}\cdot\int\frac{({\mathrm{d}}F_{0}-{\mathrm{d}}\bar{F}_{\bm{P}})^{2}}{(1-{\varepsilon}){\mathrm{d}}F_{0}+{\varepsilon}{\mathrm{d}}\bar{F}_{\bm{P}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(33)</span></td></tr></tbody>
</table>
<p id="A1.SS8.SSS0.Px3.p1.3" class="ltx_p">By combining (<a href="#A1.Ex114" title="In (c) Final inequality. ‣ A.8 Proof of Theorem ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">31</span></a>), (<a href="#A1.E32" title="Equation 32 ‣ (c) Final inequality. ‣ A.8 Proof of Theorem ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">32</span></a>), and (<a href="#A1.E33" title="Equation 33 ‣ (c) Final inequality. ‣ A.8 Proof of Theorem ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">33</span></a>), we have that</p>
<table id="A1.Ex116" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex116.m1" class="ltx_Math" alttext="\frac{1}{[\tau_{n}^{\star}]^{2}}=\int\frac{({\mathrm{d}}F_{0}-{\mathrm{d}}\bar{F}_{\bm{P}})^{2}}{(1-{\varepsilon}){\mathrm{d}}F_{0}+{\varepsilon}{\mathrm{d}}\bar{F}_{\bm{P}}}\geq\frac{[F_{0}(\delta)-\bar{F}_{\bm{P}}(\delta)]^{2}}{\bar{F}(\delta)(1-\bar{F}(\delta))}=\frac{1}{[\sigma_{n}^{\star}]^{2}}~~\implies~~\sigma_{n}^{\star}\geq\tau_{n}^{\star}." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">[</mo><msubsup><mi>τ</mi><mi>n</mi><mo>⋆</mo></msubsup><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mfrac><mo rspace="0.111em">=</mo><mrow><mo>∫</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub></mrow></mrow></mfrac></mrow><mo>≥</mo><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mrow><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>=</mo><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">[</mo><msubsup><mi>σ</mi><mi>n</mi><mo>⋆</mo></msubsup><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mfrac><mo lspace="0.938em" rspace="0.938em" stretchy="false">⟹</mo><msubsup><mi>σ</mi><mi>n</mi><mo>⋆</mo></msubsup><mo>≥</mo><msubsup><mi>τ</mi><mi>n</mi><mo>⋆</mo></msubsup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{1}{[\tau_{n}^{\star}]^{2}}=\int\frac{({\mathrm{d}}F_{0}-{\mathrm{d}}\bar{F}_{\bm{P}})^{2}}{(1-{\varepsilon}){\mathrm{d}}F_{0}+{\varepsilon}{\mathrm{d}}\bar{F}_{\bm{P}}}\geq\frac{[F_{0}(\delta)-\bar{F}_{\bm{P}}(\delta)]^{2}}{\bar{F}(\delta)(1-\bar{F}(\delta))}=\frac{1}{[\sigma_{n}^{\star}]^{2}}~~\implies~~\sigma_{n}^{\star}\geq\tau_{n}^{\star}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS8.SSS0.Px3.p1.4" class="ltx_p">∎</p>
</div>
</section>
</section>
<section id="A1.SS9" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.9 </span>Proof of Theorem <a href="#S4.Thmtheorem5" title="Theorem 4.5. ‣ 4.4 Inherent Bias Caused by Non-identifiability ‣ 4 Theoretical Analysis ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.5</span></a></h4>

<div id="A1.SS9.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Theorem <a href="#S4.Thmtheorem5" title="Theorem 4.5. ‣ 4.4 Inherent Bias Caused by Non-identifiability ‣ 4 Theoretical Analysis ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.5</span></a>.</h6>
<div id="A1.SS9.p1" class="ltx_para">
<p id="A1.SS9.p1.1" class="ltx_p"><span id="A1.SS9.p1.1.1" class="ltx_text">For clarity, let <math id="A1.SS9.p1.m1" class="ltx_Math" alttext="(\widehat{{\varepsilon}}_{\lambda},\widehat{\mu}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>λ</mi></msub><mo>,</mo><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\widehat{{\varepsilon}}_{\lambda},\widehat{\mu}_{\lambda})</annotation></semantics></math> denote the solution to the <math id="A1.SS9.p1.m2" class="ltx_Math" alttext="L_{2}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mn>2</mn></msub><annotation encoding="application/x-tex">L_{2}</annotation></semantics></math>-regularized maximum likelihood estimation (MLE) with regularization parameter <math id="A1.SS9.p1.m3" class="ltx_Math" alttext="\lambda&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda&gt;0</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS9.p2" class="ltx_para">
<p id="A1.SS9.p2.1" class="ltx_p"><span id="A1.SS9.p2.1.1" class="ltx_text">By definition, the <math id="A1.SS9.p2.m1" class="ltx_Math" alttext="L_{2}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mn>2</mn></msub><annotation encoding="application/x-tex">L_{2}</annotation></semantics></math>-regularized MLE is given by:</span></p>
<table id="A1.Ex117" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex117.m1" class="ltx_Math" alttext="(\widehat{{\varepsilon}}_{\lambda},\widehat{\mu}_{\lambda})=\arg\min_{{\varepsilon},\mu}\left\{-\log L({\varepsilon},\mu)+\lambda(\mu^{2}+{\varepsilon}^{2})\right\}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>λ</mi></msub><mo>,</mo><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><munder><mi>min</mi><mrow><mi>ε</mi><mo>,</mo><mi>μ</mi></mrow></munder></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>μ</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ε</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">(\widehat{{\varepsilon}}_{\lambda},\widehat{\mu}_{\lambda})=\arg\min_{{\varepsilon},\mu}\left\{-\log L({\varepsilon},\mu)+\lambda(\mu^{2}+{\varepsilon}^{2})\right\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS9.p2.2" class="ltx_p"><span id="A1.SS9.p2.2.1" class="ltx_text">where</span></p>
<table id="A1.Ex118" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex118.m1" class="ltx_Math" alttext="L({\varepsilon},\mu)=[(1-{\varepsilon})\gamma+{\varepsilon}\mu]^{\widehat{e}}\left[1-(1-{\varepsilon})\gamma-{\varepsilon}\mu\right]^{1-\widehat{e}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow><mo stretchy="false">]</mo></mrow><mover accent="true"><mi>e</mi><mo>^</mo></mover></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>−</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow><mo>]</mo></mrow><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>e</mi><mo>^</mo></mover></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">L({\varepsilon},\mu)=[(1-{\varepsilon})\gamma+{\varepsilon}\mu]^{\widehat{e}}\left[1-(1-{\varepsilon})\gamma-{\varepsilon}\mu\right]^{1-\widehat{e}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS9.p3" class="ltx_para">
<p id="A1.SS9.p3.1" class="ltx_p"><span id="A1.SS9.p3.1.1" class="ltx_text">The solution <math id="A1.SS9.p3.m1" class="ltx_Math" alttext="(\widehat{{\varepsilon}}_{\lambda},\widehat{\mu}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>λ</mi></msub><mo>,</mo><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\widehat{{\varepsilon}}_{\lambda},\widehat{\mu}_{\lambda})</annotation></semantics></math> has several key properties:</span></p>
<ol id="A1.I6" class="ltx_enumerate">
<li id="A1.I6.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><math id="A1.I6.i1.m1" class="ltx_Math" alttext="(a)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a)</annotation></semantics></math></span> 
<div id="A1.I6.i1.p1" class="ltx_para">
<p id="A1.I6.i1.p1.1" class="ltx_p"><span id="A1.I6.i1.p1.1.1" class="ltx_text ltx_font_bold">Existence and uniqueness</span>: The solution exists and is unique due to the strong convexity introduced by the <math id="A1.I6.i1.p1.m1" class="ltx_Math" alttext="L_{2}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mn>2</mn></msub><annotation encoding="application/x-tex">L_{2}</annotation></semantics></math>-regularization term.</p>
</div></li>
<li id="A1.I6.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><math id="A1.I6.i2.m1" class="ltx_Math" alttext="(b)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b)</annotation></semantics></math></span> 
<div id="A1.I6.i2.p1" class="ltx_para">
<p id="A1.I6.i2.p1.1" class="ltx_p"><span id="A1.I6.i2.p1.1.1" class="ltx_text ltx_font_bold">Domain restriction</span>: The condition <math id="A1.I6.i2.p1.m1" class="ltx_Math" alttext="(1-\widehat{{\varepsilon}}_{\lambda})\gamma+\widehat{{\varepsilon}}_{\lambda}\widehat{\mu}_{\lambda}\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>λ</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>λ</mi></msub></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(1-\widehat{{\varepsilon}}_{\lambda})\gamma+\widehat{{\varepsilon}}_{\lambda}\widehat{\mu}_{\lambda}\in(0,1)</annotation></semantics></math> must hold; otherwise, the optimization problem is ill-defined.</p>
</div></li>
<li id="A1.I6.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><math id="A1.I6.i3.m1" class="ltx_Math" alttext="(c)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(c)</annotation></semantics></math></span> 
<div id="A1.I6.i3.p1" class="ltx_para">
<p id="A1.I6.i3.p1.1" class="ltx_p"><span id="A1.I6.i3.p1.1.1" class="ltx_text ltx_font_bold">First-order conditions</span>: The solution <math id="A1.I6.i3.p1.m1" class="ltx_Math" alttext="(\widehat{{\varepsilon}}_{\lambda},\widehat{\mu}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>λ</mi></msub><mo>,</mo><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\widehat{{\varepsilon}}_{\lambda},\widehat{\mu}_{\lambda})</annotation></semantics></math> satisfies the following first-order conditions:</p>
<table id="A1.E34" class="ltx_equationgroup ltx_eqn_table">
<tbody><tr id="A1.EGx38" class="ltx_eqn_row"><td class="ltx_eqn_cell" colspan="5"></td></tr>
<tr id="A1.E34.1" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E34.1.m1" class="ltx_Math" alttext="\displaystyle 2\lambda{\varepsilon}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow><annotation encoding="application/x-tex">\displaystyle 2\lambda{\varepsilon}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E34.1.m2" class="ltx_Math" alttext="\displaystyle=(\mu-\gamma)\left[\frac{\widehat{e}}{(1-{\varepsilon})\gamma+{\varepsilon}\mu}-\frac{1-\widehat{e}}{1-(1-{\varepsilon})\gamma-{\varepsilon}\mu}\right]," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>μ</mi><mo>−</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mover accent="true"><mi>e</mi><mo>^</mo></mover><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>e</mi><mo>^</mo></mover></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>−</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=(\mu-\gamma)\left[\frac{\widehat{e}}{(1-{\varepsilon})\gamma+{\varepsilon}\mu}-\frac{1-\widehat{e}}{1-(1-{\varepsilon})\gamma-{\varepsilon}\mu}\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(34a)</span></td></tr>
<tr id="A1.E34.2" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E34.2.m1" class="ltx_Math" alttext="\displaystyle 2\lambda\mu" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow><annotation encoding="application/x-tex">\displaystyle 2\lambda\mu</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E34.2.m2" class="ltx_Math" alttext="\displaystyle={\varepsilon}\left[\frac{\widehat{e}}{(1-{\varepsilon})\gamma+{\varepsilon}\mu}-\frac{1-\widehat{e}}{1-(1-{\varepsilon})\gamma-{\varepsilon}\mu}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>ε</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mover accent="true"><mi>e</mi><mo>^</mo></mover><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>e</mi><mo>^</mo></mover></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>−</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle={\varepsilon}\left[\frac{\widehat{e}}{(1-{\varepsilon})\gamma+{\varepsilon}\mu}-\frac{1-\widehat{e}}{1-(1-{\varepsilon})\gamma-{\varepsilon}\mu}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(34b)</span></td></tr></tbody>
</table>
</div></li>
<li id="A1.I6.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><math id="A1.I6.i4.m1" class="ltx_Math" alttext="(d)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(d)</annotation></semantics></math></span> 
<div id="A1.I6.i4.p1" class="ltx_para">
<p id="A1.I6.i4.p1.1" class="ltx_p"><span id="A1.I6.i4.p1.1.1" class="ltx_text ltx_font_bold">Bound on the mixture</span>: We claim that <math id="A1.I6.i4.p1.m1" class="ltx_Math" alttext="(1-\widehat{{\varepsilon}}_{\lambda})\gamma+\widehat{{\varepsilon}}_{\lambda}\widehat{\mu}_{\lambda}&lt;\widehat{e}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>λ</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>λ</mi></msub></mrow></mrow><mo>&lt;</mo><mover accent="true"><mi>e</mi><mo>^</mo></mover></mrow><annotation encoding="application/x-tex">(1-\widehat{{\varepsilon}}_{\lambda})\gamma+\widehat{{\varepsilon}}_{\lambda}\widehat{\mu}_{\lambda}&lt;\widehat{e}</annotation></semantics></math>. To see this, suppose the equality <math id="A1.I6.i4.p1.m2" class="ltx_Math" alttext="(1-\widehat{{\varepsilon}}_{\lambda})\gamma+\widehat{{\varepsilon}}_{\lambda}\widehat{\mu}_{\lambda}=\widehat{e}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>λ</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>λ</mi></msub></mrow></mrow><mo>=</mo><mover accent="true"><mi>e</mi><mo>^</mo></mover></mrow><annotation encoding="application/x-tex">(1-\widehat{{\varepsilon}}_{\lambda})\gamma+\widehat{{\varepsilon}}_{\lambda}\widehat{\mu}_{\lambda}=\widehat{e}</annotation></semantics></math> holds. Then the first-order conditions imply <math id="A1.I6.i4.p1.m3" class="ltx_Math" alttext="\widehat{{\varepsilon}}_{\lambda}=\widehat{\mu}_{\lambda}=0" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>λ</mi></msub><mo>=</mo><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>λ</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\widehat{{\varepsilon}}_{\lambda}=\widehat{\mu}_{\lambda}=0</annotation></semantics></math>, which would force <math id="A1.I6.i4.p1.m4" class="ltx_Math" alttext="\widehat{e}=\gamma" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>e</mi><mo>^</mo></mover><mo>=</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">\widehat{e}=\gamma</annotation></semantics></math>. This is impossible when <math id="A1.I6.i4.p1.m5" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> is sufficiently large because <math id="A1.I6.i4.p1.m6" class="ltx_Math" alttext="\widehat{e}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>e</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{e}</annotation></semantics></math> converges almost surely to <math id="A1.I6.i4.p1.m7" class="ltx_Math" alttext="(1-{\varepsilon})\gamma+{\varepsilon}\mu&gt;\gamma" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow><mo>&gt;</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">(1-{\varepsilon})\gamma+{\varepsilon}\mu&gt;\gamma</annotation></semantics></math>, as <math id="A1.I6.i4.p1.m8" class="ltx_Math" alttext="\mu&gt;\gamma" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>&gt;</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">\mu&gt;\gamma</annotation></semantics></math> and <math id="A1.I6.i4.p1.m9" class="ltx_Math" alttext="1&gt;{\varepsilon}&gt;0" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>&gt;</mo><mi>ε</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">1&gt;{\varepsilon}&gt;0</annotation></semantics></math>. Furthermore, by (<a href="#A1.E34.2" title="Equation 34b ‣ Equation 34 ‣ Item 
                      
                        
                          
                          
                            (
                            c
                            ) ‣ Proof of Theorem . ‣ A.9 Proof of Theorem ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">34b</span></a>), the condition <math id="A1.I6.i4.p1.m10" class="ltx_Math" alttext="(1-\widehat{{\varepsilon}}_{\lambda})\gamma+\widehat{{\varepsilon}}_{\lambda}\widehat{\mu}_{\lambda}&gt;\widehat{e}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>λ</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>λ</mi></msub></mrow></mrow><mo>&gt;</mo><mover accent="true"><mi>e</mi><mo>^</mo></mover></mrow><annotation encoding="application/x-tex">(1-\widehat{{\varepsilon}}_{\lambda})\gamma+\widehat{{\varepsilon}}_{\lambda}\widehat{\mu}_{\lambda}&gt;\widehat{e}</annotation></semantics></math> would imply <math id="A1.I6.i4.p1.m11" class="ltx_Math" alttext="\widehat{\mu}_{\lambda}\widehat{{\varepsilon}}_{\lambda}&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>λ</mi></msub></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\widehat{\mu}_{\lambda}\widehat{{\varepsilon}}_{\lambda}&lt;0</annotation></semantics></math>, which is a contradiction.</p>
</div></li>
<li id="A1.I6.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><math id="A1.I6.i5.m1" class="ltx_Math" alttext="(e)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(e)</annotation></semantics></math></span> 
<div id="A1.I6.i5.p1" class="ltx_para">
<p id="A1.I6.i5.p1.1" class="ltx_p"><span id="A1.I6.i5.p1.1.1" class="ltx_text ltx_font_bold">Limits as <math id="A1.I6.i5.p1.m1" class="ltx_Math" alttext="\lambda\to 0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda\to 0</annotation></semantics></math></span>:
The following limits exist:</p>
<table id="A1.E35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E35.m1" class="ltx_Math" alttext="\widehat{{\varepsilon}}=\lim_{\lambda\to 0}\widehat{{\varepsilon}}_{\lambda},\quad\widehat{\mu}=\lim_{\lambda\to 0}\widehat{\mu}_{\lambda}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>λ</mi><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>λ</mi></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>λ</mi><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>λ</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{{\varepsilon}}=\lim_{\lambda\to 0}\widehat{{\varepsilon}}_{\lambda},\quad\widehat{\mu}=\lim_{\lambda\to 0}\widehat{\mu}_{\lambda}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(35)</span></td></tr></tbody>
</table>
<p id="A1.I6.i5.p1.2" class="ltx_p">This will be proven at the end of the proof.</p>
</div></li>
</ol>
</div>
<div id="A1.SS9.p4" class="ltx_para">
<p id="A1.SS9.p4.1" class="ltx_p"><span id="A1.SS9.p4.1.1" class="ltx_text">By dividing (<a href="#A1.E34.1" title="Equation 34a ‣ Equation 34 ‣ Item 
                      
                        
                          
                          
                            (
                            c
                            ) ‣ Proof of Theorem . ‣ A.9 Proof of Theorem ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">34a</span></a>) by (<a href="#A1.E34.2" title="Equation 34b ‣ Equation 34 ‣ Item 
                      
                        
                          
                          
                            (
                            c
                            ) ‣ Proof of Theorem . ‣ A.9 Proof of Theorem ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">34b</span></a>), we obtain</span></p>
<table id="A1.Ex1a" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex1a.m1" class="ltx_Math" alttext="\frac{\widehat{{\varepsilon}}_{\lambda}}{\widehat{\mu}_{\lambda}}=\frac{\widehat{\mu}_{\lambda}-\gamma}{\widehat{{\varepsilon}}_{\lambda}}," display="block" intent=":literal"><semantics><mrow><mrow><mfrac><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>λ</mi></msub><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>λ</mi></msub></mfrac><mo>=</mo><mfrac><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>λ</mi></msub><mo>−</mo><mi>γ</mi></mrow><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>λ</mi></msub></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{\widehat{{\varepsilon}}_{\lambda}}{\widehat{\mu}_{\lambda}}=\frac{\widehat{\mu}_{\lambda}-\gamma}{\widehat{{\varepsilon}}_{\lambda}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS9.p4.2" class="ltx_p"><span id="A1.SS9.p4.2.1" class="ltx_text">which simplifies to <math id="A1.SS9.p4.m1" class="ltx_Math" alttext="\widehat{{\varepsilon}}_{\lambda}^{2}=\widehat{\mu}_{\lambda}(\widehat{\mu}_{\lambda}-\gamma)" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>λ</mi><mn>2</mn></msubsup><mo>=</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>λ</mi></msub><mo>−</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widehat{{\varepsilon}}_{\lambda}^{2}=\widehat{\mu}_{\lambda}(\widehat{\mu}_{\lambda}-\gamma)</annotation></semantics></math>. Taking the limit as <math id="A1.SS9.p4.m2" class="ltx_Math" alttext="\lambda\to 0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda\to 0</annotation></semantics></math> and using (<a href="#A1.E35" title="Equation 35 ‣ Item 
                      
                        
                          
                          
                            (
                            e
                            ) ‣ Proof of Theorem . ‣ A.9 Proof of Theorem ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">35</span></a>), we have</span></p>
<table id="A1.E36" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E36.m1" class="ltx_Math" alttext="\widehat{{\varepsilon}}^{2}=\widehat{\mu}(\widehat{\mu}-\gamma)." display="block" intent=":literal"><semantics><mrow><mrow><msup><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mn>2</mn></msup><mo>=</mo><mrow><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mo>−</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{{\varepsilon}}^{2}=\widehat{\mu}(\widehat{\mu}-\gamma).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(36)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS9.p5" class="ltx_para">
<p id="A1.SS9.p5.1" class="ltx_p"><span id="A1.SS9.p5.1.1" class="ltx_text">We now claim that in the limit <math id="A1.SS9.p5.m1" class="ltx_Math" alttext="\lambda\to 0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda\to 0</annotation></semantics></math>,</span></p>
<table id="A1.E37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E37.m1" class="ltx_Math" alttext="(1-\widehat{{\varepsilon}})\gamma+\widehat{{\varepsilon}}\widehat{\mu}=\widehat{e}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>ε</mi><mo>^</mo></mover></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>+</mo><mrow><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>μ</mi><mo>^</mo></mover></mrow></mrow><mo>=</mo><mover accent="true"><mi>e</mi><mo>^</mo></mover></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(1-\widehat{{\varepsilon}})\gamma+\widehat{{\varepsilon}}\widehat{\mu}=\widehat{e}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(37)</span></td></tr></tbody>
</table>
<p id="A1.SS9.p5.2" class="ltx_p"><span id="A1.SS9.p5.2.1" class="ltx_text">This follows from the fact that <math id="A1.SS9.p5.m2" class="ltx_Math" alttext="\widehat{e}=\arg\max_{x\in(0,1)}x^{\widehat{e}}(1-x)^{1-\widehat{e}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>e</mi><mo>^</mo></mover><mo>=</mo><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><msub><mi>max</mi><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo lspace="0.167em" rspace="0em">​</mo><msup><mi>x</mi><mover accent="true"><mi>e</mi><mo>^</mo></mover></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>e</mi><mo>^</mo></mover></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\widehat{e}=\arg\max_{x\in(0,1)}x^{\widehat{e}}(1-x)^{1-\widehat{e}}</annotation></semantics></math>. Thus, any <math id="A1.SS9.p5.m3" class="ltx_Math" alttext="({\varepsilon},\mu)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\varepsilon},\mu)</annotation></semantics></math> maximizing <math id="A1.SS9.p5.m4" class="ltx_Math" alttext="L({\varepsilon},\mu)" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L({\varepsilon},\mu)</annotation></semantics></math> when <math id="A1.SS9.p5.m5" class="ltx_Math" alttext="\lambda=0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda=0</annotation></semantics></math> must satisfy (<a href="#A1.E37" title="Equation 37 ‣ Proof of Theorem . ‣ A.9 Proof of Theorem ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">37</span></a>).</span></p>
</div>
<div id="A1.SS9.p6" class="ltx_para">
<p id="A1.SS9.p6.1" class="ltx_p"><span id="A1.SS9.p6.1.1" class="ltx_text">Finally, we argue that <math id="A1.SS9.p6.m1" class="ltx_Math" alttext="\widehat{{\varepsilon}}&gt;0" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\widehat{{\varepsilon}}&gt;0</annotation></semantics></math> and <math id="A1.SS9.p6.m2" class="ltx_Math" alttext="\widehat{\mu}&gt;\gamma" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mo>&gt;</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">\widehat{\mu}&gt;\gamma</annotation></semantics></math> as long as <math id="A1.SS9.p6.m3" class="ltx_Math" alttext="{\varepsilon}&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\varepsilon}&gt;0</annotation></semantics></math>. If this were not true, then for sufficiently large <math id="A1.SS9.p6.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>, the strong law of large numbers implies <math id="A1.SS9.p6.m5" class="ltx_Math" alttext="\widehat{e}\overset{a.s.}{\to}(1-{\varepsilon})\gamma+{\varepsilon}\mu" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>e</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo stretchy="false">→</mo><mrow><mrow><mi mathsize="0.700em">a</mi><mo lspace="0em" mathsize="0.700em" rspace="0.167em">.</mo><mi mathsize="0.700em">s</mi></mrow><mo lspace="0em" mathsize="0.700em">.</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow><annotation encoding="application/x-tex">\widehat{e}\overset{a.s.}{\to}(1-{\varepsilon})\gamma+{\varepsilon}\mu</annotation></semantics></math>, which would contradict the inequality that <math id="A1.SS9.p6.m6" class="ltx_Math" alttext="\widehat{e}&gt;\gamma" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>e</mi><mo>^</mo></mover><mo>&gt;</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">\widehat{e}&gt;\gamma</annotation></semantics></math> from (<a href="#A1.E37" title="Equation 37 ‣ Proof of Theorem . ‣ A.9 Proof of Theorem ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">37</span></a>) when <math id="A1.SS9.p6.m7" class="ltx_Math" alttext="\widehat{{\varepsilon}}=0" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\widehat{{\varepsilon}}=0</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS9.p7" class="ltx_para">
<p id="A1.SS9.p7.1" class="ltx_p"><span id="A1.SS9.p7.1.1" class="ltx_text">Combining (<a href="#A1.E36" title="Equation 36 ‣ Proof of Theorem . ‣ A.9 Proof of Theorem ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">36</span></a>) and (<a href="#A1.E37" title="Equation 37 ‣ Proof of Theorem . ‣ A.9 Proof of Theorem ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">37</span></a>), and letting <math id="A1.SS9.p7.m1" class="ltx_Math" alttext="x=\sqrt{\widehat{\mu}-\gamma}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><msqrt><mrow><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mo>−</mo><mi>γ</mi></mrow></msqrt></mrow><annotation encoding="application/x-tex">x=\sqrt{\widehat{\mu}-\gamma}</annotation></semantics></math> (recall that <math id="A1.SS9.p7.m2" class="ltx_Math" alttext="\widehat{\mu}&gt;\gamma" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mo>&gt;</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">\widehat{\mu}&gt;\gamma</annotation></semantics></math> for <math id="A1.SS9.p7.m3" class="ltx_Math" alttext="{\varepsilon}&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\varepsilon}&gt;0</annotation></semantics></math>), we find:</span></p>
<table id="A1.Ex2a" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex2a.m1" class="ltx_Math" alttext="\widehat{{\varepsilon}}=x\sqrt{x^{2}+\gamma},\quad\widehat{\mu}=x^{2}+\gamma," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mo>=</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mi>γ</mi></mrow></msqrt></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mo>=</mo><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mi>γ</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\widehat{{\varepsilon}}=x\sqrt{x^{2}+\gamma},\quad\widehat{\mu}=x^{2}+\gamma,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS9.p7.2" class="ltx_p"><span id="A1.SS9.p7.2.1" class="ltx_text">where <math id="A1.SS9.p7.m4" class="ltx_Math" alttext="x&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">x&gt;0</annotation></semantics></math> satisfies</span></p>
<table id="A1.Ex3a" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex3a.m1" class="ltx_Math" alttext="x^{3}\sqrt{x^{2}+\gamma}=\widehat{e}-\gamma." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>x</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mi>γ</mi></mrow></msqrt></mrow><mo>=</mo><mrow><mover accent="true"><mi>e</mi><mo>^</mo></mover><mo>−</mo><mi>γ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">x^{3}\sqrt{x^{2}+\gamma}=\widehat{e}-\gamma.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS9.p7.3" class="ltx_p"><span id="A1.SS9.p7.3.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A1.SS9.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of the existence of limits in (<a href="#A1.E35" title="Equation 35 ‣ Item 
                      
                        
                          
                          
                            (
                            e
                            ) ‣ Proof of Theorem . ‣ A.9 Proof of Theorem ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">35</span></a>).</h6>
<div id="A1.SS9.p8" class="ltx_para">
<p id="A1.SS9.p8.1" class="ltx_p"><span id="A1.SS9.p8.1.1" class="ltx_text">Rearranging (<a href="#A1.E34.1" title="Equation 34a ‣ Equation 34 ‣ Item 
                      
                        
                          
                          
                            (
                            c
                            ) ‣ Proof of Theorem . ‣ A.9 Proof of Theorem ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">34a</span></a>), we obtain:</span></p>
<table id="A1.E38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E38.m1" class="ltx_Math" alttext="(\widehat{\mu}_{\lambda}-\gamma)[\widehat{e}-(1-\widehat{{\varepsilon}}_{\lambda})\gamma-\widehat{{\varepsilon}}_{\lambda}\widehat{\mu}_{\lambda}]=2\lambda\widehat{{\varepsilon}}_{\lambda}\cdot[(1-\widehat{{\varepsilon}}_{\lambda})\gamma+\widehat{{\varepsilon}}_{\lambda}\widehat{\mu}_{\lambda}][1-(1-\widehat{{\varepsilon}}_{\lambda})\gamma-\widehat{{\varepsilon}}_{\lambda}\widehat{\mu}_{\lambda}]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>λ</mi></msub><mo>−</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mover accent="true"><mi>e</mi><mo>^</mo></mover><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>λ</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>λ</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>λ</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>λ</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>λ</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>λ</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>λ</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(\widehat{\mu}_{\lambda}-\gamma)[\widehat{e}-(1-\widehat{{\varepsilon}}_{\lambda})\gamma-\widehat{{\varepsilon}}_{\lambda}\widehat{\mu}_{\lambda}]=2\lambda\widehat{{\varepsilon}}_{\lambda}\cdot[(1-\widehat{{\varepsilon}}_{\lambda})\gamma+\widehat{{\varepsilon}}_{\lambda}\widehat{\mu}_{\lambda}][1-(1-\widehat{{\varepsilon}}_{\lambda})\gamma-\widehat{{\varepsilon}}_{\lambda}\widehat{\mu}_{\lambda}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(38)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS9.p9" class="ltx_para">
<p id="A1.SS9.p9.1" class="ltx_p"><span id="A1.SS9.p9.1.1" class="ltx_text">Combining (<a href="#A1.E36" title="Equation 36 ‣ Proof of Theorem . ‣ A.9 Proof of Theorem ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">36</span></a>) and (<a href="#A1.E38" title="Equation 38 ‣ Proof of the existence of limits in (). ‣ A.9 Proof of Theorem ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">38</span></a>), and defining <math id="A1.SS9.p9.m1" class="ltx_Math" alttext="x_{\lambda}=\sqrt{\widehat{\mu}_{\lambda}-\gamma}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>λ</mi></msub><mo>=</mo><msqrt><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>λ</mi></msub><mo>−</mo><mi>γ</mi></mrow></msqrt></mrow><annotation encoding="application/x-tex">x_{\lambda}=\sqrt{\widehat{\mu}_{\lambda}-\gamma}</annotation></semantics></math>, we have:</span></p>
<table id="A1.Ex4a" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex4a.m1" class="ltx_Math" alttext="\widehat{{\varepsilon}}_{\lambda}=x_{\lambda}\sqrt{x_{\lambda}^{2}+\gamma},\quad\widehat{\mu}_{\lambda}=x_{\lambda}^{2}+\gamma," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>λ</mi></msub><mo>=</mo><mrow><msub><mi>x</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><msubsup><mi>x</mi><mi>λ</mi><mn>2</mn></msubsup><mo>+</mo><mi>γ</mi></mrow></msqrt></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>λ</mi></msub><mo>=</mo><mrow><msubsup><mi>x</mi><mi>λ</mi><mn>2</mn></msubsup><mo>+</mo><mi>γ</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\widehat{{\varepsilon}}_{\lambda}=x_{\lambda}\sqrt{x_{\lambda}^{2}+\gamma},\quad\widehat{\mu}_{\lambda}=x_{\lambda}^{2}+\gamma,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS9.p9.2" class="ltx_p"><span id="A1.SS9.p9.2.1" class="ltx_text">and</span></p>
<table id="A1.Ex5a" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex5a.m1" class="ltx_Math" alttext="x_{\lambda}^{5}\sqrt{x_{\lambda}^{2}+\gamma}\leq(\widehat{e}-\gamma)\cdot x_{\lambda}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>x</mi><mi>λ</mi><mn>5</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><msubsup><mi>x</mi><mi>λ</mi><mn>2</mn></msubsup><mo>+</mo><mi>γ</mi></mrow></msqrt></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>e</mi><mo>^</mo></mover><mo>−</mo><mi>γ</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>x</mi><mi>λ</mi><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">x_{\lambda}^{5}\sqrt{x_{\lambda}^{2}+\gamma}\leq(\widehat{e}-\gamma)\cdot x_{\lambda}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS9.p10" class="ltx_para">
<p id="A1.SS9.p10.1" class="ltx_p"><span id="A1.SS9.p10.1.1" class="ltx_text">The inequality above implies that <math id="A1.SS9.p10.m1" class="ltx_Math" alttext="x_{\lambda}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>λ</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">x_{\lambda}&gt;0</annotation></semantics></math> is uniformly bounded for any <math id="A1.SS9.p10.m2" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>. Consequently, as a function of <math id="A1.SS9.p10.m3" class="ltx_Math" alttext="x_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">x_{\lambda}</annotation></semantics></math>, both <math id="A1.SS9.p10.m4" class="ltx_Math" alttext="\widehat{{\varepsilon}}_{\lambda}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>λ</mi></msub><annotation encoding="application/x-tex">\widehat{{\varepsilon}}_{\lambda}</annotation></semantics></math> and <math id="A1.SS9.p10.m5" class="ltx_Math" alttext="\widehat{\mu}_{\lambda}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>λ</mi></msub><annotation encoding="application/x-tex">\widehat{\mu}_{\lambda}</annotation></semantics></math> are uniformly bounded for all <math id="A1.SS9.p10.m6" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>.
As <math id="A1.SS9.p10.m7" class="ltx_Math" alttext="\lambda\to 0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda\to 0</annotation></semantics></math>, we can extract a subsequence for which <math id="A1.SS9.p10.m8" class="ltx_Math" alttext="\widehat{{\varepsilon}}_{\lambda}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>λ</mi></msub><annotation encoding="application/x-tex">\widehat{{\varepsilon}}_{\lambda}</annotation></semantics></math> and <math id="A1.SS9.p10.m9" class="ltx_Math" alttext="\widehat{\mu}_{\lambda}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>λ</mi></msub><annotation encoding="application/x-tex">\widehat{\mu}_{\lambda}</annotation></semantics></math> converge to well-defined limits. For this particular subsequence, taking the limit <math id="A1.SS9.p10.m10" class="ltx_Math" alttext="\lambda\to 0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda\to 0</annotation></semantics></math> in (<a href="#A1.E38" title="Equation 38 ‣ Proof of the existence of limits in (). ‣ A.9 Proof of Theorem ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">38</span></a>) yields:</span></p>
<table id="A1.Ex6a" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex6a.m1" class="ltx_Math" alttext="\lim_{\lambda\to 0}x_{\lambda}^{5}\sqrt{x_{\lambda}^{2}+\gamma}-(\widehat{e}-\gamma)\cdot x_{\lambda}^{2}=0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>λ</mi><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mrow><msubsup><mi>x</mi><mi>λ</mi><mn>5</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><msubsup><mi>x</mi><mi>λ</mi><mn>2</mn></msubsup><mo>+</mo><mi>γ</mi></mrow></msqrt></mrow></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>e</mi><mo>^</mo></mover><mo>−</mo><mi>γ</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>x</mi><mi>λ</mi><mn>2</mn></msubsup></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lim_{\lambda\to 0}x_{\lambda}^{5}\sqrt{x_{\lambda}^{2}+\gamma}-(\widehat{e}-\gamma)\cdot x_{\lambda}^{2}=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS9.p11" class="ltx_para">
<p id="A1.SS9.p11.1" class="ltx_p"><span id="A1.SS9.p11.1.1" class="ltx_text">Since <math id="A1.SS9.p11.m1" class="ltx_Math" alttext="x_{\lambda}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>λ</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">x_{\lambda}&gt;0</annotation></semantics></math>, the above equation has only one nonzero solution. Therefore, the subsequential limit of <math id="A1.SS9.p11.m2" class="ltx_Math" alttext="x_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">x_{\lambda}</annotation></semantics></math> is unique. Consequently, all subsequences of <math id="A1.SS9.p11.m3" class="ltx_Math" alttext="\widehat{{\varepsilon}}_{\lambda}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>λ</mi></msub><annotation encoding="application/x-tex">\widehat{{\varepsilon}}_{\lambda}</annotation></semantics></math> and <math id="A1.SS9.p11.m4" class="ltx_Math" alttext="\widehat{\mu}_{\lambda}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>λ</mi></msub><annotation encoding="application/x-tex">\widehat{\mu}_{\lambda}</annotation></semantics></math> converge to the same limits.</span></p>
</div>
<div id="A1.SS9.p12" class="ltx_para">
<p id="A1.SS9.p12.1" class="ltx_p"><span id="A1.SS9.p12.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
</section>
<section id="A2" class="ltx_appendix">
<h3 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Simulation Study: Details and Results</h3>

<section id="A2.SS1" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.1 </span>Further Details</h4>

<section id="A2.SS1.SSS0.Px1" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">Evaluation of the fixed-point equation.</h6>

<div id="A2.SS1.SSS0.Px1.p1" class="ltx_para">
<p id="A2.SS1.SSS0.Px1.p1.1" class="ltx_p">Recall that we need to solve the following fixed-point equation</p>
<table id="A2.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex7.m1" class="ltx_Math" alttext="{\varepsilon}=\left[\frac{\int\widehat{v}_{\mathrm{opt}}({\varepsilon},x)\left[{\mathrm{d}}F_{0}(x)-{\mathrm{d}}\widehat{F}(x)\right]}{\int\widehat{v}_{\mathrm{opt}}({\varepsilon},x)\left[{\mathrm{d}}F_{0}(x)-{\mathrm{d}}\widehat{F}_{\bm{P}}(x)\right]}\right]_{[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]}" display="block" intent=":literal"><semantics><mrow><mi>ε</mi><mo>=</mo><msub><mrow><mo>[</mo><mfrac><mrow><mo>∫</mo><mrow><msub><mover accent="true"><mi>v</mi><mo>^</mo></mover><mi>opt</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>F</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mrow><mo>∫</mo><mrow><msub><mover accent="true"><mi>v</mi><mo>^</mo></mover><mi>opt</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mfrac><mo>]</mo></mrow><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ε</mi><mi>min</mi></msub><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mi>min</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></msub></mrow><annotation encoding="application/x-tex">{\varepsilon}=\left[\frac{\int\widehat{v}_{\mathrm{opt}}({\varepsilon},x)\left[{\mathrm{d}}F_{0}(x)-{\mathrm{d}}\widehat{F}(x)\right]}{\int\widehat{v}_{\mathrm{opt}}({\varepsilon},x)\left[{\mathrm{d}}F_{0}(x)-{\mathrm{d}}\widehat{F}_{\bm{P}}(x)\right]}\right]_{[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(<a href="#S3.E8" title="Equation 8 ‣ Optimal weight function. ‣ 3.3 Estimation Methods ‣ 3 Proportion Estimation Methods ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>)</span></td></tr></tbody>
</table>
<p id="A2.SS1.SSS0.Px1.p1.2" class="ltx_p">where <math id="A2.SS1.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\widehat{v}_{\mathrm{opt}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>v</mi><mo>^</mo></mover><mi>opt</mi></msub><annotation encoding="application/x-tex">\widehat{v}_{\mathrm{opt}}</annotation></semantics></math> is the estimated optimal weight function defined by:</p>
<table id="A2.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex8.m1" class="ltx_Math" alttext="\widehat{v}_{\mathrm{opt}}({\varepsilon},x)=\frac{1-\widehat{g}(x)}{(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)},~~\text{and}~~\widehat{g}(x)=\frac{{\mathrm{d}}\widehat{F}_{\bm{P}}(x)}{{\mathrm{d}}F_{0}(x)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mover accent="true"><mi>v</mi><mo>^</mo></mover><mi>opt</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mrow><mo rspace="0.827em">,</mo><mrow><mrow><mtext>and</mtext><mo lspace="0.660em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{v}_{\mathrm{opt}}({\varepsilon},x)=\frac{1-\widehat{g}(x)}{(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)},~~\text{and}~~\widehat{g}(x)=\frac{{\mathrm{d}}\widehat{F}_{\bm{P}}(x)}{{\mathrm{d}}F_{0}(x)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.SSS0.Px1.p1.3" class="ltx_p">We use the notation <math id="A2.SS1.SSS0.Px1.p1.m2" class="ltx_Math" alttext="[a]_{[b,c]}=\max\{\min\{a,c\},b\}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">[</mo><mi>a</mi><mo stretchy="false">]</mo></mrow><mrow><mo stretchy="false">[</mo><mi>b</mi><mo>,</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></msub><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>a</mi><mo>,</mo><mi>c</mi><mo stretchy="false">}</mo></mrow></mrow><mo>,</mo><mi>b</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">[a]_{[b,c]}=\max\{\min\{a,c\},b\}</annotation></semantics></math> to denote the projection of <math id="A2.SS1.SSS0.Px1.p1.m3" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> onto the interval <math id="A2.SS1.SSS0.Px1.p1.m4" class="ltx_Math" alttext="[b,c]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>b</mi><mo>,</mo><mi>c</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[b,c]</annotation></semantics></math>, ensuring that the result lies within the bounds of <math id="A2.SS1.SSS0.Px1.p1.m5" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> and <math id="A2.SS1.SSS0.Px1.p1.m6" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math>.</p>
</div>
<div id="A2.SS1.SSS0.Px1.p2" class="ltx_para">
<p id="A2.SS1.SSS0.Px1.p2.1" class="ltx_p">In our implementation, we first sample <math id="A2.SS1.SSS0.Px1.p2.m1" class="ltx_Math" alttext="n=10^{6}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><msup><mn>10</mn><mn>6</mn></msup></mrow><annotation encoding="application/x-tex">n=10^{6}</annotation></semantics></math> values, denoted as <math id="A2.SS1.SSS0.Px1.p2.m2" class="ltx_Math" alttext="Z_{1},\ldots,Z_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>Z</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">Z_{1},\ldots,Z_{n}</annotation></semantics></math>, from <math id="A2.SS1.SSS0.Px1.p2.m3" class="ltx_Math" alttext="F_{0}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mn>0</mn></msub><annotation encoding="application/x-tex">F_{0}</annotation></semantics></math> (which is <math id="A2.SS1.SSS0.Px1.p2.m4" class="ltx_Math" alttext="{U}(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{U}(0,1)</annotation></semantics></math> due to the probability integral transform) and approximate <math id="A2.SS1.SSS0.Px1.p2.m5" class="ltx_Math" alttext="\int\widehat{v}_{\mathrm{opt}}({\varepsilon},x){\mathrm{d}}F_{0}(x)" display="inline" intent=":literal"><semantics><mrow><mo>∫</mo><mrow><msub><mover accent="true"><mi>v</mi><mo>^</mo></mover><mi>opt</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\int\widehat{v}_{\mathrm{opt}}({\varepsilon},x){\mathrm{d}}F_{0}(x)</annotation></semantics></math> using the average over these samples: <math id="A2.SS1.SSS0.Px1.p2.m6" class="ltx_Math" alttext="\frac{1}{n}\sum_{t=1}^{n}\widehat{v}_{\mathrm{opt}}({\varepsilon},Z_{t})" display="inline" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mrow><msub><mover accent="true"><mi>v</mi><mo>^</mo></mover><mi>opt</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo>,</mo><msub><mi>Z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{1}{n}\sum_{t=1}^{n}\widehat{v}_{\mathrm{opt}}({\varepsilon},Z_{t})</annotation></semantics></math>.
We denote the empirical sum by <math id="A2.SS1.SSS0.Px1.p2.m7" class="ltx_Math" alttext="\int\widehat{v}_{\mathrm{opt}}({\varepsilon},x){\mathrm{d}}\widehat{F}_{0}(x)" display="inline" intent=":literal"><semantics><mrow><mo>∫</mo><mrow><msub><mover accent="true"><mi>v</mi><mo>^</mo></mover><mi>opt</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\int\widehat{v}_{\mathrm{opt}}({\varepsilon},x){\mathrm{d}}\widehat{F}_{0}(x)</annotation></semantics></math>.
Similarly, we collect the same number of pivotal statistics from <math id="A2.SS1.SSS0.Px1.p2.m8" class="ltx_Math" alttext="\bar{F}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>F</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{F}</annotation></semantics></math> or <math id="A2.SS1.SSS0.Px1.p2.m9" class="ltx_Math" alttext="\bar{F}_{\bm{P}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub><annotation encoding="application/x-tex">\bar{F}_{\bm{P}}</annotation></semantics></math> and compute <math id="A2.SS1.SSS0.Px1.p2.m10" class="ltx_Math" alttext="\int\widehat{v}_{\mathrm{opt}}({\varepsilon},x){\mathrm{d}}\widehat{F}(x)" display="inline" intent=":literal"><semantics><mrow><mo>∫</mo><mrow><msub><mover accent="true"><mi>v</mi><mo>^</mo></mover><mi>opt</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mover accent="true"><mi>F</mi><mo>^</mo></mover></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\int\widehat{v}_{\mathrm{opt}}({\varepsilon},x){\mathrm{d}}\widehat{F}(x)</annotation></semantics></math> or <math id="A2.SS1.SSS0.Px1.p2.m11" class="ltx_Math" alttext="\int\widehat{v}_{\mathrm{opt}}({\varepsilon},x){\mathrm{d}}\widehat{F}_{\bm{P}}(x)" display="inline" intent=":literal"><semantics><mrow><mo>∫</mo><mrow><msub><mover accent="true"><mi>v</mi><mo>^</mo></mover><mi>opt</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\int\widehat{v}_{\mathrm{opt}}({\varepsilon},x){\mathrm{d}}\widehat{F}_{\bm{P}}(x)</annotation></semantics></math> as their respective averages.</p>
</div>
</section>
<section id="A2.SS1.SSS0.Px2" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">Optimization for the refined estimator.</h6>

<div id="A2.SS1.SSS0.Px2.p1" class="ltx_para">
<p id="A2.SS1.SSS0.Px2.p1.1" class="ltx_p">To obtain the refined estimator <math id="A2.SS1.SSS0.Px2.p1.m1" class="ltx_Math" alttext="{\widehat{{\varepsilon}}_{\mathrm{opt}}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>opt</mi></msub><annotation encoding="application/x-tex">{\widehat{{\varepsilon}}_{\mathrm{opt}}}</annotation></semantics></math>, we use numerical methods to solve the following minimization problem:</p>
<table id="A2.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex9.m1" class="ltx_Math" alttext="{\widehat{{\varepsilon}}_{\mathrm{opt}}}=\arg\min_{{\varepsilon}\in[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]}{\mathcal{L}}({\varepsilon})," display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>opt</mi></msub><mo>=</mo><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mrow><munder><mi>min</mi><mrow><mi>ε</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ε</mi><mi>min</mi></msub><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mi>min</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></munder><mo lspace="0.167em">⁡</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\widehat{{\varepsilon}}_{\mathrm{opt}}}=\arg\min_{{\varepsilon}\in[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]}{\mathcal{L}}({\varepsilon}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.SSS0.Px2.p1.2" class="ltx_p">where <math id="A2.SS1.SSS0.Px2.p1.m2" class="ltx_Math" alttext="{\varepsilon}_{\min}=10^{-3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ε</mi><mi>min</mi></msub><mo>=</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>3</mn></mrow></msup></mrow><annotation encoding="application/x-tex">{\varepsilon}_{\min}=10^{-3}</annotation></semantics></math> is a small constant to avoid numerical issue,</p>
<table id="A2.E39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E39.m1" class="ltx_Math" alttext="{\mathcal{L}}({\varepsilon})=\left|{\varepsilon}-\widehat{{\mathcal{T}}}_{\mathrm{used}}({\varepsilon})\right|~~\text{and}~~\widehat{{\mathcal{T}}}_{\mathrm{used}}({\varepsilon})=\left[\frac{\int\widehat{v}_{\mathrm{opt}}({\varepsilon},x)\left[{\mathrm{d}}\widehat{F}_{0}(x)-{\mathrm{d}}\widehat{F}(x)\right]}{\int\widehat{v}_{\mathrm{opt}}({\varepsilon},x)\left[{\mathrm{d}}\widehat{F}_{0}(x)-{\mathrm{d}}\widehat{F}_{\bm{P}}(x)\right]}\right]_{[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo>|</mo><mrow><mi>ε</mi><mo>−</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>^</mo></mover><mi>used</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo lspace="0.660em" rspace="0em">​</mo><mtext>and</mtext><mo lspace="0.660em" rspace="0em">​</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>^</mo></mover><mi>used</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mrow><mo>[</mo><mfrac><mrow><mo>∫</mo><mrow><msub><mover accent="true"><mi>v</mi><mo>^</mo></mover><mi>opt</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>F</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mrow><mo>∫</mo><mrow><msub><mover accent="true"><mi>v</mi><mo>^</mo></mover><mi>opt</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mfrac><mo>]</mo></mrow><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ε</mi><mi>min</mi></msub><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mi>min</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{L}}({\varepsilon})=\left|{\varepsilon}-\widehat{{\mathcal{T}}}_{\mathrm{used}}({\varepsilon})\right|~~\text{and}~~\widehat{{\mathcal{T}}}_{\mathrm{used}}({\varepsilon})=\left[\frac{\int\widehat{v}_{\mathrm{opt}}({\varepsilon},x)\left[{\mathrm{d}}\widehat{F}_{0}(x)-{\mathrm{d}}\widehat{F}(x)\right]}{\int\widehat{v}_{\mathrm{opt}}({\varepsilon},x)\left[{\mathrm{d}}\widehat{F}_{0}(x)-{\mathrm{d}}\widehat{F}_{\bm{P}}(x)\right]}\right]_{[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(39)</span></td></tr></tbody>
</table>
<p id="A2.SS1.SSS0.Px2.p1.3" class="ltx_p">Here, <math id="A2.SS1.SSS0.Px2.p1.m3" class="ltx_Math" alttext="{\mathcal{L}}({\varepsilon})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{L}}({\varepsilon})</annotation></semantics></math> represents the deviation between <math id="A2.SS1.SSS0.Px2.p1.m4" class="ltx_Math" alttext="{\varepsilon}" display="inline" intent=":literal"><semantics><mi>ε</mi><annotation encoding="application/x-tex">{\varepsilon}</annotation></semantics></math> and the estimated operator <math id="A2.SS1.SSS0.Px2.p1.m5" class="ltx_Math" alttext="\widehat{{\mathcal{T}}}_{\mathrm{used}}({\varepsilon})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>^</mo></mover><mi>used</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{{\mathcal{T}}}_{\mathrm{used}}({\varepsilon})</annotation></semantics></math>, which is computed using the optimal weight function <math id="A2.SS1.SSS0.Px2.p1.m6" class="ltx_Math" alttext="\widehat{v}_{\mathrm{opt}}({\varepsilon},x)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>v</mi><mo>^</mo></mover><mi>opt</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{v}_{\mathrm{opt}}({\varepsilon},x)</annotation></semantics></math>. The terms <math id="A2.SS1.SSS0.Px2.p1.m7" class="ltx_Math" alttext="\widehat{F}_{0}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{F}_{0}(x)</annotation></semantics></math>, <math id="A2.SS1.SSS0.Px2.p1.m8" class="ltx_Math" alttext="\widehat{F}(x)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>F</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{F}(x)</annotation></semantics></math>, and <math id="A2.SS1.SSS0.Px2.p1.m9" class="ltx_Math" alttext="\widehat{F}_{\bm{P}}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{F}_{\bm{P}}(x)</annotation></semantics></math> denote the CDFs of the null, observed, and watermarked samples, respectively.</p>
</div>
<div id="A2.Thmtheorem1" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem1.2" class="ltx_text ltx_font_bold">Remark B.1</span></span><span id="A2.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem1.p1" class="ltx_para">
<p id="A2.Thmtheorem1.p1.1" class="ltx_p"><span id="A2.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">The only difference between <math id="A2.Thmtheorem1.p1.m1" class="ltx_Math" alttext="\widehat{{\mathcal{T}}}_{\mathrm{used}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>^</mo></mover><mi>used</mi></msub><annotation encoding="application/x-tex">\widehat{{\mathcal{T}}}_{\mathrm{used}}</annotation></semantics></math> and <math id="A2.Thmtheorem1.p1.m2" class="ltx_Math" alttext="\widehat{{\mathcal{T}}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{{\mathcal{T}}}</annotation></semantics></math> (defined in (<a href="#S3.E8" title="Equation 8 ‣ Optimal weight function. ‣ 3.3 Estimation Methods ‣ 3 Proportion Estimation Methods ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>)) is that the former approximates <math id="A2.Thmtheorem1.p1.m3" class="ltx_Math" alttext="\int\widehat{v}_{\mathrm{opt}}({\varepsilon},x){\mathrm{d}}F_{0}(x)" display="inline" intent=":literal"><semantics><mrow><mo>∫</mo><mrow><msub><mover accent="true"><mi>v</mi><mo>^</mo></mover><mi>opt</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\int\widehat{v}_{\mathrm{opt}}({\varepsilon},x){\mathrm{d}}F_{0}(x)</annotation></semantics></math> using finite samples, while the latter employs exact integration, primarily for theoretical analysis.</span></p>
</div>
</div>
<div id="A2.SS1.SSS0.Px2.p2" class="ltx_para">
<p id="A2.SS1.SSS0.Px2.p2.1" class="ltx_p">To solve this problem, we use the “scipy.optimize.minimize” function from the Python SciPy library <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib33" title="" class="ltx_ref">33</a>]</cite>. The objective function <math id="A2.SS1.SSS0.Px2.p2.m1" class="ltx_Math" alttext="{\mathcal{L}}({\varepsilon})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{L}}({\varepsilon})</annotation></semantics></math> is specified in (<a href="#A2.E39" title="Equation 39 ‣ Optimization for the refined estimator. ‣ B.1 Further Details ‣ Appendix B Simulation Study: Details and Results ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">39</span></a>), with bounds for <math id="A2.SS1.SSS0.Px2.p2.m2" class="ltx_Math" alttext="{\varepsilon}" display="inline" intent=":literal"><semantics><mi>ε</mi><annotation encoding="application/x-tex">{\varepsilon}</annotation></semantics></math> constrained to the interval <math id="A2.SS1.SSS0.Px2.p2.m3" class="ltx_Math" alttext="[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ε</mi><mi>min</mi></msub><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mi>min</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]</annotation></semantics></math>. We employ the default gradient-free optimization method, “L-BFGS-B”, to ensure robust and efficient convergence.
To identify a suitable initial point for the optimization, we iteratively compose the operator <math id="A2.SS1.SSS0.Px2.p2.m4" class="ltx_Math" alttext="\widehat{{\mathcal{T}}}_{\mathrm{used}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>^</mo></mover><mi>used</mi></msub><annotation encoding="application/x-tex">\widehat{{\mathcal{T}}}_{\mathrm{used}}</annotation></semantics></math>, starting from <math id="A2.SS1.SSS0.Px2.p2.m5" class="ltx_Math" alttext="0.9" display="inline" intent=":literal"><semantics><mn>0.9</mn><annotation encoding="application/x-tex">0.9</annotation></semantics></math>. Specifically, we compute <math id="A2.SS1.SSS0.Px2.p2.m6" class="ltx_math_unparsed" alttext="\widehat{{\mathcal{T}}}_{\mathrm{used}}\circ\cdots\circ\widehat{{\mathcal{T}}}_{\mathrm{used}}(0.9)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>^</mo></mover><mi>used</mi></msub><mo lspace="0.222em">∘</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">∘</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>^</mo></mover><mi>used</mi></msub><mrow><mo stretchy="false">(</mo><mn>0.9</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{{\mathcal{T}}}_{\mathrm{used}}\circ\cdots\circ\widehat{{\mathcal{T}}}_{\mathrm{used}}(0.9)</annotation></semantics></math> with 20 compositions, using the resulting value as the starting point.</p>
</div>
</section>
<section id="A2.SS1.SSS0.Px3" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">Construction of NTP distributions.</h6>

<div id="A2.SS1.SSS0.Px3.p1" class="ltx_para">
<p id="A2.SS1.SSS0.Px3.p1.1" class="ltx_p">We adopt a similar approach to <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib19" title="" class="ltx_ref">19</a>]</cite> for constructing NTP distributions, as detailed in Algorithm <a href="#alg1" title="Algorithm 1 ‣ Failure on green-red list watermarks. ‣ B.1 Further Details ‣ Appendix B Simulation Study: Details and Results ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>. The function <math id="A2.SS1.SSS0.Px3.p1.m1" class="ltx_Math" alttext="\text{Zipf}(a,b,k)" display="inline" intent=":literal"><semantics><mrow><mtext>Zipf</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{Zipf}(a,b,k)</annotation></semantics></math> generates a Zipf-like probability distribution over a specified support size <math id="A2.SS1.SSS0.Px3.p1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, where the probabilities are computed as <math id="A2.SS1.SSS0.Px3.p1.m3" class="ltx_Math" alttext="(i+b)^{-a}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mi>a</mi></mrow></msup><annotation encoding="application/x-tex">(i+b)^{-a}</annotation></semantics></math> for <math id="A2.SS1.SSS0.Px3.p1.m4" class="ltx_Math" alttext="i=1,\ldots,k" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">i=1,\ldots,k</annotation></semantics></math> and normalized to sum to 1.
The NTP distributions generated by Algorithm <a href="#alg1" title="Algorithm 1 ‣ Failure on green-red list watermarks. ‣ B.1 Further Details ‣ Appendix B Simulation Study: Details and Results ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> are parameterized by <math id="A2.SS1.SSS0.Px3.p1.m5" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>, which controls the dominance of the largest probability, ensuring it remains below <math id="A2.SS1.SSS0.Px3.p1.m6" class="ltx_Math" alttext="1-\Delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi mathvariant="normal">Δ</mi></mrow><annotation encoding="application/x-tex">1-\Delta</annotation></semantics></math> uniformly. The constructed distributions balance a dominant “head” component <math id="A2.SS1.SSS0.Px3.p1.m7" class="ltx_Math" alttext="{\bm{h}}" display="inline" intent=":literal"><semantics><mi>𝒉</mi><annotation encoding="application/x-tex">{\bm{h}}</annotation></semantics></math>, generated using the Zipf distribution, and a uniform “tail” component, ensuring the entire distribution sums to 1. For all simulation experiments, we set the vocabulary size to <math id="A2.SS1.SSS0.Px3.p1.m8" class="ltx_Math" alttext="|{{\mathcal{W}}}|=10^{3}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><msup><mn>10</mn><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">|{{\mathcal{W}}}|=10^{3}</annotation></semantics></math>.</p>
</div>
</section>
<section id="A2.SS1.SSS0.Px4" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">Failure on green-red list watermarks.</h6>

<div id="A2.SS1.SSS0.Px4.p1" class="ltx_para">
<p id="A2.SS1.SSS0.Px4.p1.1" class="ltx_p">As suggested by the original work <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib15" title="" class="ltx_ref">15</a>]</cite>, we set the parameters <math id="A2.SS1.SSS0.Px4.p1.m1" class="ltx_Math" alttext="(\gamma,\delta)=(0.5,2)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo>,</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>0.5</mn><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(\gamma,\delta)=(0.5,2)</annotation></semantics></math> for the green-red list watermarks, which strike a balance between watermark signal strength and data distortion.
As discussed in Sections <a href="#S4.SS1" title="4.1 Accuracy for Initial Attempts ‣ 4 Theoretical Analysis ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> and <a href="#S4.SS2" title="4.2 Accuracy for Refinements ‣ 4 Theoretical Analysis ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>, our estimators <span id="A2.SS1.SSS0.Px4.p1.1.1" class="ltx_text ltx_font_sansserif">INI</span> and <span id="A2.SS1.SSS0.Px4.p1.1.2" class="ltx_text ltx_font_sansserif">IND</span> are highly biased when NTP distributions <math id="A2.SS1.SSS0.Px4.p1.m2" class="ltx_math_unparsed" alttext="\bm{P}_{1:n}" display="inline" intent=":literal"><semantics><mrow><mi>𝑷</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\bm{P}_{1:n}</annotation></semantics></math> are inaccessible, likely producing estimates outside the feasible domain <math id="A2.SS1.SSS0.Px4.p1.m3" class="ltx_Math" alttext="[0,1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,1]</annotation></semantics></math>. To ensure meaningful comparison in Figure <a href="#S5.F1.sf4" title="Figure 1(d) ‣ Figure 1 ‣ How we obtain 𝑔̂. ‣ 5.1 Simulation Study ‣ 5 Experiments ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1(d)</span></a>, we plot the errors of projected estimators <math id="A2.SS1.SSS0.Px4.p1.m4" class="ltx_Math" alttext="[{\widehat{{\varepsilon}}_{\mathrm{ini}}}(\delta)]_{[0,1]}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">[</mo><mrow><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>ini</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msub><annotation encoding="application/x-tex">[{\widehat{{\varepsilon}}_{\mathrm{ini}}}(\delta)]_{[0,1]}</annotation></semantics></math> and <math id="A2.SS1.SSS0.Px4.p1.m5" class="ltx_Math" alttext="[{\widehat{{\varepsilon}}_{\mathrm{rfn}}}]_{[0,1]}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>ε</mi><mo>^</mo></mover><mi>rfn</mi></msub><mo stretchy="false">]</mo></mrow><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msub><annotation encoding="application/x-tex">[{\widehat{{\varepsilon}}_{\mathrm{rfn}}}]_{[0,1]}</annotation></semantics></math>, which guarantees that MAEs do not exceed 1.
One can easily show that the accuracy analysis for MAEs in Theorem <a href="#S4.Thmtheorem1" title="Theorem 4.1. ‣ 4.1 Accuracy for Initial Attempts ‣ 4 Theoretical Analysis ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> and <a href="#S4.Thmtheorem2" title="Theorem 4.2. ‣ 4.2 Accuracy for Refinements ‣ 4 Theoretical Analysis ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a> still applies due to the nonexpansiveness of the projection operator.</p>
</div>
<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> Generate NTP distributions</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
                  
                  
                 <span id="alg1.l1.2" class="ltx_text ltx_font_bold">Input:</span> Dominance parameter <math id="alg1.l1.m1" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>, vocabulary size <math id="alg1.l1.m2" class="ltx_Math" alttext="|{{\mathcal{W}}}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|{{\mathcal{W}}}|</annotation></semantics></math>.

</div>
<div id="alg1.l2" class="ltx_listingline">
                  
                  
                 Sample parameters <math id="alg1.l2.m1" class="ltx_Math" alttext="a\sim\text{Uniform}(0.95,1.5)" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∼</mo><mrow><mtext>Uniform</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0.95</mn><mo>,</mo><mn>1.5</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">a\sim\text{Uniform}(0.95,1.5)</annotation></semantics></math> and <math id="alg1.l2.m2" class="ltx_Math" alttext="b\sim\text{Uniform}(0.01,0.1)" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>∼</mo><mrow><mtext>Uniform</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0.01</mn><mo>,</mo><mn>0.1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">b\sim\text{Uniform}(0.01,0.1)</annotation></semantics></math>.

</div>
<div id="alg1.l3" class="ltx_listingline">
                  
                  
                 Sample the support size <math id="alg1.l3.m1" class="ltx_Math" alttext="k\sim\text{DiscreteUniform}[5,15]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∼</mo><mrow><mtext>DiscreteUniform</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mn>5</mn><mo>,</mo><mn>15</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">k\sim\text{DiscreteUniform}[5,15]</annotation></semantics></math>.

</div>
<div id="alg1.l4" class="ltx_listingline">
                  
                  
                 Generate a Zipf-like head vector: <math id="alg1.l4.m1" class="ltx_Math" alttext="{\bm{h}}=\text{Zipf}(a,b,k)" display="inline" intent=":literal"><semantics><mrow><mi>𝒉</mi><mo>=</mo><mrow><mtext>Zipf</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{h}}=\text{Zipf}(a,b,k)</annotation></semantics></math>, where <math id="alg1.l4.m2" class="ltx_Math" alttext="{\bm{h}}\in{\mathbb{R}}^{k}" display="inline" intent=":literal"><semantics><mrow><mi>𝒉</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>k</mi></msup></mrow><annotation encoding="application/x-tex">{\bm{h}}\in{\mathbb{R}}^{k}</annotation></semantics></math> is a probability vector.

</div>
<div id="alg1.l5" class="ltx_listingline">
                  
                  
                 Sample the random dominance parameter <math id="alg1.l5.m1" class="ltx_Math" alttext="\Delta_{\mathrm{used}}\sim\text{Uniform}(0,\Delta)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>used</mi></msub><mo>∼</mo><mrow><mtext>Uniform</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">Δ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta_{\mathrm{used}}\sim\text{Uniform}(0,\Delta)</annotation></semantics></math>.

</div>
<div id="alg1.l6" class="ltx_listingline">
                  
                  
                 Define the scaling factor <math id="alg1.l6.m1" class="ltx_Math" alttext="b=\frac{1-\Delta_{\mathrm{used}}}{\max_{i\in[k]}h_{i}}" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi mathvariant="normal">Δ</mi><mi>used</mi></msub></mrow><mrow><msub><mi>max</mi><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0.167em">⁡</mo><msub><mi>h</mi><mi>i</mi></msub></mrow></mfrac></mrow><annotation encoding="application/x-tex">b=\frac{1-\Delta_{\mathrm{used}}}{\max_{i\in[k]}h_{i}}</annotation></semantics></math>, where <math id="alg1.l6.m2" class="ltx_Math" alttext="{\bm{h}}=(h_{1},\ldots,h_{k})" display="inline" intent=":literal"><semantics><mrow><mi>𝒉</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>h</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{h}}=(h_{1},\ldots,h_{k})</annotation></semantics></math>.

</div>
<div id="alg1.l7" class="ltx_listingline">
                  
                  
                 Initialize <math id="alg1.l7.m1" class="ltx_Math" alttext="\bm{P}=\mathbf{0}_{|{{\mathcal{W}}}|}" display="inline" intent=":literal"><semantics><mrow><mi>𝑷</mi><mo>=</mo><msub><mn>𝟎</mn><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\bm{P}=\mathbf{0}_{|{{\mathcal{W}}}|}</annotation></semantics></math>.

</div>
<div id="alg1.l8" class="ltx_listingline">
                  
                  
                 <span id="alg1.l8.2" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l8.m1" class="ltx_Math" alttext="b\leq 1" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">b\leq 1</annotation></semantics></math> <span id="alg1.l8.3" class="ltx_text ltx_font_bold">then</span>



</div>
<div id="alg1.l9" class="ltx_listingline">
                  
                  
                  Assign the first <math id="alg1.l9.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> entries of <math id="alg1.l9.m2" class="ltx_Math" alttext="\bm{P}" display="inline" intent=":literal"><semantics><mi>𝑷</mi><annotation encoding="application/x-tex">\bm{P}</annotation></semantics></math> to <math id="alg1.l9.m3" class="ltx_Math" alttext="b\cdot{\bm{h}}" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>𝒉</mi></mrow><annotation encoding="application/x-tex">b\cdot{\bm{h}}</annotation></semantics></math>, and distribute the remaining probability uniformly:

<table id="A2.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex10.m1" class="ltx_math_unparsed" alttext="\bm{P}_{1:k}=b\cdot{\bm{h}},\quad\bm{P}_{(k+1):|{{\mathcal{W}}}|}=(1-b)\cdot\frac{\mathbf{1}_{|{{\mathcal{W}}}|-k}}{|{{\mathcal{W}}}|-k}." display="block" intent=":literal"><semantics><mrow><msub><mi>𝑷</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo>=</mo><mi>b</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>𝒉</mi><mo rspace="1.167em">,</mo><msub><mi>𝑷</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow></mrow></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>b</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mfrac><msub><mn>𝟏</mn><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><mo>−</mo><mi>k</mi></mrow></msub><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><mo>−</mo><mi>k</mi></mrow></mfrac><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bm{P}_{1:k}=b\cdot{\bm{h}},\quad\bm{P}_{(k+1):|{{\mathcal{W}}}|}=(1-b)\cdot\frac{\mathbf{1}_{|{{\mathcal{W}}}|-k}}{|{{\mathcal{W}}}|-k}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="alg1.l10" class="ltx_listingline">
                  
                  
                 <span id="alg1.l10.2" class="ltx_text ltx_font_bold">else</span>


</div>
<div id="alg1.l11" class="ltx_listingline">
                  
                  
                  Assign the first entry of <math id="alg1.l11.m1" class="ltx_Math" alttext="\bm{P}" display="inline" intent=":literal"><semantics><mi>𝑷</mi><annotation encoding="application/x-tex">\bm{P}</annotation></semantics></math> to <math id="alg1.l11.m2" class="ltx_Math" alttext="1-\Delta_{\mathrm{used}}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><msub><mi mathvariant="normal">Δ</mi><mi>used</mi></msub></mrow><annotation encoding="application/x-tex">1-\Delta_{\mathrm{used}}</annotation></semantics></math>, the next <math id="alg1.l11.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> entries to <math id="alg1.l11.m4" class="ltx_Math" alttext="\frac{\Delta_{\mathrm{used}}}{2}\cdot{\bm{h}}" display="inline" intent=":literal"><semantics><mrow><mfrac><msub><mi mathvariant="normal">Δ</mi><mi>used</mi></msub><mn>2</mn></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>𝒉</mi></mrow><annotation encoding="application/x-tex">\frac{\Delta_{\mathrm{used}}}{2}\cdot{\bm{h}}</annotation></semantics></math>, and distribute the remaining probability uniformly:

<table id="A2.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex11.m1" class="ltx_math_unparsed" alttext="P_{1}=1-\Delta_{\mathrm{used}},\quad P_{2:(k+1)}=\frac{\Delta_{\mathrm{used}}}{2}\cdot{\bm{h}},\quad\bm{P}_{(k+2):|{{\mathcal{W}}}|}=\frac{\Delta_{\mathrm{used}}}{2}\cdot\frac{\mathbf{1}_{|{{\mathcal{W}}}|-k-1}}{|{{\mathcal{W}}}|-k-1}." display="block" intent=":literal"><semantics><mrow><mi>P</mi><msub><mrow></mrow><mn>1</mn></msub><mo>=</mo><mn>1</mn><mo>−</mo><mi mathvariant="normal">Δ</mi><msub><mrow></mrow><mi>used</mi></msub><mo rspace="1.167em">,</mo><mi>P</mi><msub><mrow></mrow><mrow><mn>2</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mfrac><msub><mi mathvariant="normal">Δ</mi><mi>used</mi></msub><mn>2</mn></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>𝒉</mi><mo rspace="1.167em">,</mo><mi>𝑷</mi><msub><mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow></mrow></msub><mo>=</mo><mfrac><msub><mi mathvariant="normal">Δ</mi><mi>used</mi></msub><mn>2</mn></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><msub><mn>𝟏</mn><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P_{1}=1-\Delta_{\mathrm{used}},\quad P_{2:(k+1)}=\frac{\Delta_{\mathrm{used}}}{2}\cdot{\bm{h}},\quad\bm{P}_{(k+2):|{{\mathcal{W}}}|}=\frac{\Delta_{\mathrm{used}}}{2}\cdot\frac{\mathbf{1}_{|{{\mathcal{W}}}|-k-1}}{|{{\mathcal{W}}}|-k-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="alg1.l12" class="ltx_listingline">
                  
                  
                 <span id="alg1.l12.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l12.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l13" class="ltx_listingline">
                  
                  
                 <span id="alg1.l13.2" class="ltx_text ltx_font_bold">Return:</span> A randomly permuted version of <math id="alg1.l13.m1" class="ltx_Math" alttext="\bm{P}" display="inline" intent=":literal"><semantics><mi>𝑷</mi><annotation encoding="application/x-tex">\bm{P}</annotation></semantics></math>.

</div>
</div>
</figure>
</section>
</section>
<section id="A2.SS2" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.2 </span>Empirical CDFs of Mixture Distributions</h4>

<div id="A2.SS2.p1" class="ltx_para">
<p id="A2.SS2.p1.1" class="ltx_p">Figure <a href="#A2.F3" title="Figure 3 ‣ B.2 Empirical CDFs of Mixture Distributions ‣ Appendix B Simulation Study: Details and Results ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> illustrates the CDFs of the mixture distribution <math id="A2.SS2.p1.m1" class="ltx_Math" alttext="(1-{\varepsilon})F_{0}+{\varepsilon}\bar{F}_{\bm{P}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub></mrow></mrow><annotation encoding="application/x-tex">(1-{\varepsilon})F_{0}+{\varepsilon}\bar{F}_{\bm{P}}</annotation></semantics></math> for the Gumbel-max watermark, while Figure <a href="#A2.F4" title="Figure 4 ‣ B.2 Empirical CDFs of Mixture Distributions ‣ Appendix B Simulation Study: Details and Results ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> shows the corresponding CDFs for the inverse transform watermark.
The alternative CDF, corresponding to <math id="A2.SS2.p1.m2" class="ltx_Math" alttext="{\varepsilon}=1" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\varepsilon}=1</annotation></semantics></math>, is consistently stochastically larger than the null distribution, which corresponds to the case where <math id="A2.SS2.p1.m3" class="ltx_Math" alttext="{\varepsilon}=0" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\varepsilon}=0</annotation></semantics></math>. As <math id="A2.SS2.p1.m4" class="ltx_Math" alttext="{\varepsilon}" display="inline" intent=":literal"><semantics><mi>ε</mi><annotation encoding="application/x-tex">{\varepsilon}</annotation></semantics></math> increases, the mixture CDF becomes progressively more right-skewed.</p>
</div>
<div id="A2.SS2.p2" class="ltx_para">
<p id="A2.SS2.p2.1" class="ltx_p">In constructing the NTP distributions, we ensure that each <math id="A2.SS2.p2.m1" class="ltx_Math" alttext="\bm{P}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝑷</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\bm{P}_{t}</annotation></semantics></math> is <math id="A2.SS2.p2.m2" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>-regular, meaning the largest probability in <math id="A2.SS2.p2.m3" class="ltx_Math" alttext="\bm{P}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝑷</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\bm{P}_{t}</annotation></semantics></math> is strictly less than <math id="A2.SS2.p2.m4" class="ltx_Math" alttext="1-\Delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi mathvariant="normal">Δ</mi></mrow><annotation encoding="application/x-tex">1-\Delta</annotation></semantics></math>. Specifically, this largest probability is uniformly distributed within <math id="A2.SS2.p2.m5" class="ltx_Math" alttext="(0,1-\Delta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mn>1</mn><mo>−</mo><mi mathvariant="normal">Δ</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,1-\Delta)</annotation></semantics></math>. Consequently, a larger value of <math id="A2.SS2.p2.m6" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> induces a greater discrepancy between <math id="A2.SS2.p2.m7" class="ltx_Math" alttext="F_{0}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mn>0</mn></msub><annotation encoding="application/x-tex">F_{0}</annotation></semantics></math> and <math id="A2.SS2.p2.m8" class="ltx_Math" alttext="\bar{F}_{\bm{P}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi>𝑷</mi></msub><annotation encoding="application/x-tex">\bar{F}_{\bm{P}}</annotation></semantics></math>, leading to increased right-skewness in the mixture CDF.</p>
</div>
<figure id="A2.F3" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2">
