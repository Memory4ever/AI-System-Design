<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S5.F1.sf3.3" class="ltx_text" style="font-size:90%;">(c)</span> </span><span id="S5.F1.sf3.4" class="ltx_text" style="font-size:90%;">MAEs for inverse transform</span></figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_2">
