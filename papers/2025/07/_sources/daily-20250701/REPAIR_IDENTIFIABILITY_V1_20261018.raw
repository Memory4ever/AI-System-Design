mo>^</mo></mover></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∫</mo><mrow><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mn>3</mn></msup><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow></mrow><mrow><mo>∫</mo><mrow><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow></mrow></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\varepsilon}_{0}\left[\frac{\int\frac{[1-\widehat{g}]^{2}[1-g]}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}]^{2}}{\mathrm{d}}F_{0}}{\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}{F}_{0}}-\frac{\int\frac{[1-\widehat{g}]^{3}}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}]^{2}}{\mathrm{d}}F_{0}}{\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}{F}_{0}}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex30a"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex30a.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+{\varepsilon}_{0}\frac{\int\frac{[1-\widehat{g}]^{3}}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}]^{2}}{\mathrm{d}}{F}_{0}}{\left[\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}{F}_{0}\right]^{2}}\cdot\left[\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}F_{0}-\int\frac{[1-\widehat{g}][1-g]}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}F_{0}\right]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mi>ε</mi><mn>0</mn></msub><mstyle displaystyle="true"><mfrac><mrow><mo>∫</mo><mrow><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mn>3</mn></msup><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow></mrow><msup><mrow><mo>[</mo><mrow><mo lspace="0em">∫</mo><mrow><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow></mrow><mo>]</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow></mrow></mfrac></mstyle><mi>d</mi><msub><mi>F</mi><mn>0</mn></msub><mo>−</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mi>g</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow></mrow></mfrac></mstyle><mi>d</mi><msub><mi>F</mi><mn>0</mn></msub><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+{\varepsilon}_{0}\frac{\int\frac{[1-\widehat{g}]^{3}}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}]^{2}}{\mathrm{d}}{F}_{0}}{\left[\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}{F}_{0}\right]^{2}}\cdot\left[\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}F_{0}-\int\frac{[1-\widehat{g}][1-g]}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}F_{0}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E16.m1" class="ltx_Math" alttext="\displaystyle=\frac{{\varepsilon}_{0}\int\frac{[1-\widehat{g}]^{2}[\widehat{g}-g]}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}]^{2}}{\mathrm{d}}F_{0}}{\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}{F}_{0}}+\frac{{\varepsilon}_{0}\int\frac{[1-\widehat{g}]^{3}}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}]^{2}}{\mathrm{d}}{F}_{0}}{\left[\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}{F}_{0}\right]^{2}}\int\frac{[1-\widehat{g}][g-\widehat{g}]}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}F_{0}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ε</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∫</mo><mrow><mfrac><mrow><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo>−</mo><mi>g</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow></mrow></mrow><mrow><mo>∫</mo><mrow><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ε</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∫</mo><mrow><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mn>3</mn></msup><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow></mrow></mrow><msup><mrow><mo>[</mo><mrow><mo lspace="0em">∫</mo><mrow><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow></mrow><mo>]</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mfrac><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>g</mi><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow></mrow></mstyle></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{{\varepsilon}_{0}\int\frac{[1-\widehat{g}]^{2}[\widehat{g}-g]}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}]^{2}}{\mathrm{d}}F_{0}}{\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}{F}_{0}}+\frac{{\varepsilon}_{0}\int\frac{[1-\widehat{g}]^{3}}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}]^{2}}{\mathrm{d}}{F}_{0}}{\left[\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}{F}_{0}\right]^{2}}\int\frac{[1-\widehat{g}][g-\widehat{g}]}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}F_{0}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS6.SSS3.p3" class="ltx_para">
<p id="A1.SS6.SSS3.p3.1" class="ltx_p"><span id="A1.SS6.SSS3.p3.1.1" class="ltx_text">To proceed with the proof, we first derive individual bounds for each term in (<a href="#A1.E16" title="Equation 16 ‣ Proof of Lemma . ‣ A.6.3 Proof of Lemma ‣ A.6 Analysis for the Optimal Estimator ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>).
Let <math id="A1.SS6.SSS3.p3.m1" class="ltx_Math" alttext="C_{g}=\max\{1,\sup\limits_{x\in[0,1]}|\widehat{g}(x)|\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>g</mi></msub><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mo stretchy="false">|</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C_{g}=\max\{1,\sup\limits_{x\in[0,1]}|\widehat{g}(x)|\}</annotation></semantics></math>.
We also recall the definition of the total variation (TV) distance:</span></p>
<table id="A1.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E17.m1" class="ltx_Math" alttext="D_{\mathrm{TV}}(F_{0},\widehat{F}_{\bm{P}}):=\frac{1}{2}\int|1-\widehat{g}(x)|{\mathrm{d}}F_{0}(x)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>D</mi><mi>TV</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mn>0</mn></msub><mo>,</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">∫</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">D_{\mathrm{TV}}(F_{0},\widehat{F}_{\bm{P}}):=\frac{1}{2}\int|1-\widehat{g}(x)|{\mathrm{d}}F_{0}(x).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
</table>
<p id="A1.SS6.SSS3.p3.2" class="ltx_p"><span id="A1.SS6.SSS3.p3.2.1" class="ltx_text">Since <math id="A1.SS6.SSS3.p3.m2" class="ltx_Math" alttext="0\leq\widehat{g}(x)&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">0\leq\widehat{g}(x)&lt;\infty</annotation></semantics></math> and <math id="A1.SS6.SSS3.p3.m3" class="ltx_Math" alttext="{\varepsilon}\in[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ε</mi><mi>min</mi></msub><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ε</mi><mi>min</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\varepsilon}\in[{\varepsilon}_{\min},1-{\varepsilon}_{\min}]</annotation></semantics></math>, the following uniform bound holds:</span></p>
<table id="A1.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E18.m1" class="ltx_Math" alttext="-\frac{1}{{\varepsilon}_{\min}}\leq-\frac{1}{{\varepsilon}}\leq\frac{1-\widehat{g}(x)}{(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)}\leq\frac{1}{1-{\varepsilon}}\leq\frac{1}{{\varepsilon}_{\min}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><mfrac><mn>1</mn><msub><mi>ε</mi><mi>min</mi></msub></mfrac></mrow><mo>≤</mo><mrow><mo>−</mo><mfrac><mn>1</mn><mi>ε</mi></mfrac></mrow><mo>≤</mo><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo>≤</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow></mfrac><mo>≤</mo><mfrac><mn>1</mn><msub><mi>ε</mi><mi>min</mi></msub></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">-\frac{1}{{\varepsilon}_{\min}}\leq-\frac{1}{{\varepsilon}}\leq\frac{1-\widehat{g}(x)}{(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)}\leq\frac{1}{1-{\varepsilon}}\leq\frac{1}{{\varepsilon}_{\min}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS6.SSS3.p4" class="ltx_para">
<ol id="A1.I2" class="ltx_enumerate">
<li id="A1.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><math id="A1.I2.i1.m1" class="ltx_Math" alttext="(a)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a)</annotation></semantics></math></span> 
<div id="A1.I2.i1.p1" class="ltx_para">
<p id="A1.I2.i1.p1.1" class="ltx_p">Note that <math id="A1.I2.i1.p1.m1" class="ltx_Math" alttext="\frac{|\widehat{g}(x)-g(x)|}{\min\{1,\widehat{g}(x)\}}\leq\Delta_{g}" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><mo stretchy="false">|</mo><mrow><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mfrac><mo>≤</mo><msub><mi mathvariant="normal">Δ</mi><mi>g</mi></msub></mrow><annotation encoding="application/x-tex">\frac{|\widehat{g}(x)-g(x)|}{\min\{1,\widehat{g}(x)\}}\leq\Delta_{g}</annotation></semantics></math> for all <math id="A1.I2.i1.p1.m2" class="ltx_Math" alttext="x\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">x\in[0,1]</annotation></semantics></math>.
As a result, we have that
<math id="A1.I2.i1.p1.m3" class="ltx_Math" alttext="|\widehat{g}(x)-g(x)|\leq\Delta_{g}\cdot\min\{1,\widehat{g}(x)\}\leq\Delta_{g}[(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)]" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mi>g</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo>≤</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">|\widehat{g}(x)-g(x)|\leq\Delta_{g}\cdot\min\{1,\widehat{g}(x)\}\leq\Delta_{g}[(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)]</annotation></semantics></math> for any <math id="A1.I2.i1.p1.m4" class="ltx_Math" alttext="{\varepsilon},x\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ε</mi><mo>,</mo><mi>x</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\varepsilon},x\in[0,1]</annotation></semantics></math>.
Hence, the first term of (<a href="#A1.E16" title="Equation 16 ‣ Proof of Lemma . ‣ A.6.3 Proof of Lemma ‣ A.6 Analysis for the Optimal Estimator ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>) <math id="A1.I2.i1.p1.m5" class="ltx_Math" alttext="\leq{\varepsilon}_{0}\Delta_{g}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>ε</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>g</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\leq{\varepsilon}_{0}\Delta_{g}</annotation></semantics></math>.</p>
</div></li>
<li id="A1.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><math id="A1.I2.i2.m1" class="ltx_Math" alttext="(b)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b)</annotation></semantics></math></span> 
<div id="A1.I2.i2.p1" class="ltx_para">
<p id="A1.I2.i2.p1.1" class="ltx_p">By the bound in (<a href="#A1.E18" title="Equation 18 ‣ Proof of Lemma . ‣ A.6.3 Proof of Lemma ‣ A.6 Analysis for the Optimal Estimator ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>) and the definition of TV distance in (<a href="#A1.E17" title="Equation 17 ‣ Proof of Lemma . ‣ A.6.3 Proof of Lemma ‣ A.6 Analysis for the Optimal Estimator ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>), it follows that</p>
<table id="A1.Ex31a" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex31a.m1" class="ltx_Math" alttext="\int\frac{|1-\widehat{g}(x)|^{3}}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)]^{2}}{\mathrm{d}}{F}_{0}(x)\leq\frac{1}{{\varepsilon}_{\min}}\cdot\int\frac{[1-\widehat{g}(x)]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)}{\mathrm{d}}{F}_{0}(x)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>∫</mo><mrow><mfrac><msup><mrow><mo stretchy="false">|</mo><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mn>3</mn></msup><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mfrac><mn>1</mn><msub><mi>ε</mi><mi>min</mi></msub></mfrac><mo lspace="0.222em" rspace="0.055em">⋅</mo><mrow><mo>∫</mo><mrow><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\int\frac{|1-\widehat{g}(x)|^{3}}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)]^{2}}{\mathrm{d}}{F}_{0}(x)\leq\frac{1}{{\varepsilon}_{\min}}\cdot\int\frac{[1-\widehat{g}(x)]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)}{\mathrm{d}}{F}_{0}(x).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.I2.i2.p1.2" class="ltx_p">On the other hand, it follows that</p>
<table id="A1.EGx23" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex32a"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex32a.m1" class="ltx_Math" alttext="\displaystyle\int\frac{[1-\widehat{g}(x)]^{3}}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)]^{2}}{\mathrm{d}}{F}_{0}(x)" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>3</mn></msup><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mstyle><annotation encoding="application/x-tex">\displaystyle\int\frac{[1-\widehat{g}(x)]^{3}}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)]^{2}}{\mathrm{d}}{F}_{0}(x)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex32a.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq\int_{x:\widehat{g}(x)\leq 1}\frac{[1-\widehat{g}(x)]^{3}}{\min\{1,\widehat{g}(x)\}^{2}}{\mathrm{d}}{F}_{0}(x)" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><mi>x</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>1</mn></mrow></mrow></msub></mstyle><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>3</mn></msup><mrow><mi>min</mi><mo>⁡</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><mi>d</mi><msub><mi>F</mi><mn>0</mn></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\int_{x:\widehat{g}(x)\leq 1}\frac{[1-\widehat{g}(x)]^{3}}{\min\{1,\widehat{g}(x)\}^{2}}{\mathrm{d}}{F}_{0}(x)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex33a"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex33a.m1" class="ltx_math_unparsed" alttext="\displaystyle=\int_{x:\widehat{g}(x)\leq 1}\frac{1}{[\widehat{g}(x)]^{2}}{\mathrm{d}}{F}_{0}(x)\leq\int\frac{1}{[\widehat{g}(x)]^{2}}{\mathrm{d}}{F}_{0}(x)." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><mi>x</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>1</mn></mrow></mrow></msub></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">[</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mi>d</mi><msub><mi>F</mi><mn>0</mn></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>≤</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">[</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mi>d</mi><msub><mi>F</mi><mn>0</mn></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{x:\widehat{g}(x)\leq 1}\frac{1}{[\widehat{g}(x)]^{2}}{\mathrm{d}}{F}_{0}(x)\leq\int\frac{1}{[\widehat{g}(x)]^{2}}{\mathrm{d}}{F}_{0}(x).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.I2.i2.p1.3" class="ltx_p">For the other direction, it follows that</p>
<table id="A1.EGx24" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex34a"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex34a.m1" class="ltx_Math" alttext="\displaystyle\int\frac{[\widehat{g}(x)-1]^{3}}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)]^{2}}{\mathrm{d}}{F}_{0}(x)" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mn>3</mn></msup><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mstyle><annotation encoding="application/x-tex">\displaystyle\int\frac{[\widehat{g}(x)-1]^{3}}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)]^{2}}{\mathrm{d}}{F}_{0}(x)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex34a.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq\int_{x:\widehat{g}(x)\geq 1}\frac{[\widehat{g}(x)-1]^{3}}{\min\{1,\widehat{g}(x)\}^{2}}{\mathrm{d}}{F}_{0}(x)" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><mi>x</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>1</mn></mrow></mrow></msub></mstyle><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mn>3</mn></msup><mrow><mi>min</mi><mo>⁡</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><mi>d</mi><msub><mi>F</mi><mn>0</mn></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\int_{x:\widehat{g}(x)\geq 1}\frac{[\widehat{g}(x)-1]^{3}}{\min\{1,\widehat{g}(x)\}^{2}}{\mathrm{d}}{F}_{0}(x)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex35a"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex35a.m1" class="ltx_math_unparsed" alttext="\displaystyle=\int_{x:\widehat{g}(x)\geq 1}[\widehat{g}(x)]^{3}{\mathrm{d}}{F}_{0}(x)\leq\int[\widehat{g}(x)]^{3}{\mathrm{d}}{F}_{0}(x)." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><mi>x</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>1</mn></mrow></mrow></msub></mstyle><msup><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mn>3</mn></msup><mi>d</mi><msub><mi>F</mi><mn>0</mn></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>≤</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msup><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mn>3</mn></msup><mi>d</mi><msub><mi>F</mi><mn>0</mn></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{x:\widehat{g}(x)\geq 1}[\widehat{g}(x)]^{3}{\mathrm{d}}{F}_{0}(x)\leq\int[\widehat{g}(x)]^{3}{\mathrm{d}}{F}_{0}(x).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.I2.i2.p2" class="ltx_para">
<p id="A1.I2.i2.p2.1" class="ltx_p">Combining the above bounds, we have</p>
<table id="A1.Ex36a" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex36a.m1" class="ltx_Math" alttext="\left|\int\frac{[1-\widehat{g}(x)]^{3}{\mathrm{d}}{F}_{0}(x)}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)]^{2}}\right|\leq\min\left\{\frac{1}{{\varepsilon}_{\min}}\int\frac{[1-\widehat{g}(x)]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)}{\mathrm{d}}{F}_{0}(x),\EB_{F_{0}}[\widehat{g}]^{3}+\EB_{F_{0}}[\widehat{g}]^{-2}\right\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mo lspace="0em">∫</mo><mfrac><mrow><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mfrac></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><mfrac><mn>1</mn><msub><mi>ε</mi><mi>min</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∫</mo><mrow><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo><mrow><mrow><msub><mi>𝔼</mi><msub><mi>F</mi><mn>0</mn></msub></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">]</mo></mrow><mn>3</mn></msup></mrow><mo>+</mo><mrow><msub><mi>𝔼</mi><msub><mi>F</mi><mn>0</mn></msub></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">]</mo></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|\int\frac{[1-\widehat{g}(x)]^{3}{\mathrm{d}}{F}_{0}(x)}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)]^{2}}\right|\leq\min\left\{\frac{1}{{\varepsilon}_{\min}}\int\frac{[1-\widehat{g}(x)]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)}{\mathrm{d}}{F}_{0}(x),\EB_{F_{0}}[\widehat{g}]^{3}+\EB_{F_{0}}[\widehat{g}]^{-2}\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A1.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><math id="A1.I2.i3.m1" class="ltx_Math" alttext="(c)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(c)</annotation></semantics></math></span> 
<div id="A1.I2.i3.p1" class="ltx_para">
<p id="A1.I2.i3.p1.1" class="ltx_p">By the definition of <math id="A1.I2.i3.p1.m1" class="ltx_Math" alttext="C_{g}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>g</mi></msub><annotation encoding="application/x-tex">C_{g}</annotation></semantics></math>, we have that</p>
<table id="A1.EGx25" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E19.m1" class="ltx_Math" alttext="\displaystyle\int\frac{[1-\widehat{g}(x)]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)}{\mathrm{d}}{F}_{0}(x)" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mfrac><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mstyle><annotation encoding="application/x-tex">\displaystyle\int\frac{[1-\widehat{g}(x)]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)}{\mathrm{d}}{F}_{0}(x)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E19.m2" class="ltx_Math" alttext="\displaystyle\geq\frac{1}{C_{g}}\int[1-\widehat{g}(x)]^{2}{\mathrm{d}}{F}_{0}(x)=\frac{D_{\chi^{2}}(\widehat{F}_{\bm{P}},F_{0})}{C_{g}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>C</mi><mi>g</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><mrow><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mstyle></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>D</mi><msup><mi>χ</mi><mn>2</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><mo>,</mo><msub><mi>F</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><msub><mi>C</mi><mi>g</mi></msub></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\geq\frac{1}{C_{g}}\int[1-\widehat{g}(x)]^{2}{\mathrm{d}}{F}_{0}(x)=\frac{D_{\chi^{2}}(\widehat{F}_{\bm{P}},F_{0})}{C_{g}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
</table>
<p id="A1.I2.i3.p1.2" class="ltx_p">where <math id="A1.I2.i3.p1.m2" class="ltx_Math" alttext="D_{\chi^{2}}(\widehat{F}_{\bm{P}},F_{0}):=\int[1-\widehat{g}(x)]^{2}{\mathrm{d}}{F}_{0}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>D</mi><msup><mi>χ</mi><mn>2</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><mo>,</mo><msub><mi>F</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">:=</mo><mrow><mo rspace="0em">∫</mo><mrow><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">D_{\chi^{2}}(\widehat{F}_{\bm{P}},F_{0}):=\int[1-\widehat{g}(x)]^{2}{\mathrm{d}}{F}_{0}(x)</annotation></semantics></math> is the <math id="A1.I2.i3.p1.m3" class="ltx_Math" alttext="\chi^{2}" display="inline" intent=":literal"><semantics><msup><mi>χ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\chi^{2}</annotation></semantics></math>-divergence between <math id="A1.I2.i3.p1.m4" class="ltx_Math" alttext="\widehat{F}_{\bm{P}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><annotation encoding="application/x-tex">\widehat{F}_{\bm{P}}</annotation></semantics></math> and <math id="A1.I2.i3.p1.m5" class="ltx_Math" alttext="F_{0}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mn>0</mn></msub><annotation encoding="application/x-tex">F_{0}</annotation></semantics></math>.</p>
</div></li>
<li id="A1.I2.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><math id="A1.I2.i4.m1" class="ltx_Math" alttext="(d)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(d)</annotation></semantics></math></span> 
<div id="A1.I2.i4.p1" class="ltx_para">
<p id="A1.I2.i4.p1.1" class="ltx_p">The definition of <math id="A1.I2.i4.p1.m1" class="ltx_Math" alttext="D_{\mathrm{TV}}(F_{0},\widehat{F}_{\bm{P}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>TV</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mn>0</mn></msub><mo>,</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D_{\mathrm{TV}}(F_{0},\widehat{F}_{\bm{P}})</annotation></semantics></math> implies that</p>
<table id="A1.Ex37a" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex37a.m1" class="ltx_Math" alttext="\left|\int\frac{[1-\widehat{g}(x)][g(x)-\widehat{g}(x)]}{(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)}{\mathrm{d}}F_{0}(x)\right|\leq\Delta_{g}\cdot\int|1-\widehat{g}(x)|{\mathrm{d}}F_{0}(x)=2\Delta_{g}D_{\mathrm{TV}}(F_{0},\widehat{F}_{\bm{P}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mo lspace="0em">∫</mo><mrow><mfrac><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mi>g</mi></msub><mo lspace="0.222em" rspace="0.055em">⋅</mo><mrow><mo rspace="0em">∫</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><mi>TV</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mn>0</mn></msub><mo>,</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|\int\frac{[1-\widehat{g}(x)][g(x)-\widehat{g}(x)]}{(1-{\varepsilon})+{\varepsilon}\widehat{g}(x)}{\mathrm{d}}F_{0}(x)\right|\leq\Delta_{g}\cdot\int|1-\widehat{g}(x)|{\mathrm{d}}F_{0}(x)=2\Delta_{g}D_{\mathrm{TV}}(F_{0},\widehat{F}_{\bm{P}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
<div id="A1.SS6.SSS3.p5" class="ltx_para">
<p id="A1.SS6.SSS3.p5.1" class="ltx_p"><span id="A1.SS6.SSS3.p5.1.1" class="ltx_text">To establish (<a href="#A1.E15.2" title="Equation 15b ‣ Equation 15 ‣ Lemma A.1. ‣ A.6.1 Proof of Lemma ‣ A.6 Analysis for the Optimal Estimator ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15b</span></a>), we combine the bounds on the above four individual terms and apply them to the expression in (<a href="#A1.E16" title="Equation 16 ‣ Proof of Lemma . ‣ A.6.3 Proof of Lemma ‣ A.6 Analysis for the Optimal Estimator ‣ Appendix A Proofs of Theoretical Analysis ‣ Appendices ‣ Optimal Estimation of Watermark Proportions in Hybrid AI-Human Texts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>).
Note that <math id="A1.SS6.SSS3.p5.m1" class="ltx_Math" alttext="4D_{\mathrm{TV}}^{2}(F_{0},\widehat{F}_{\bm{P}})\leq D_{\chi^{2}}(\widehat{F}_{\bm{P}},F_{0})" display="inline" intent=":literal"><semantics><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>D</mi><mi>TV</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mn>0</mn></msub><mo>,</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>D</mi><msup><mi>χ</mi><mn>2</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><mo>,</mo><msub><mi>F</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">4D_{\mathrm{TV}}^{2}(F_{0},\widehat{F}_{\bm{P}})\leq D_{\chi^{2}}(\widehat{F}_{\bm{P}},F_{0})</annotation></semantics></math>, <math id="A1.SS6.SSS3.p5.m2" class="ltx_Math" alttext="C_{g}\geq 1" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>g</mi></msub><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">C_{g}\geq 1</annotation></semantics></math>, and <math id="A1.SS6.SSS3.p5.m3" class="ltx_Math" alttext="D_{\mathrm{TV}}(F_{0},\widehat{F}_{\bm{P}})\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>D</mi><mi>TV</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mn>0</mn></msub><mo>,</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">D_{\mathrm{TV}}(F_{0},\widehat{F}_{\bm{P}})\leq 1</annotation></semantics></math>.
We have that</span></p>
<table id="A1.EGx26" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex38a"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex38a.m1" class="ltx_Math" alttext="\displaystyle\left|\EB\frac{{\mathrm{d}}\widetilde{{\mathcal{T}}}({\varepsilon})}{{\mathrm{d}}{\varepsilon}}\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mi>𝔼</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow></mfrac></mstyle></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\EB\frac{{\mathrm{d}}\widetilde{{\mathcal{T}}}({\varepsilon})}{{\mathrm{d}}{\varepsilon}}\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex38a.m2" class="ltx_Math" alttext="\displaystyle\leq{\varepsilon}_{0}\Delta_{g}\left[1+\frac{C_{g}^{2}}{D_{\chi^{2}}(\widehat{F}_{\bm{P}},F_{0})}\min\left\{\frac{1}{{\varepsilon}_{\min}},\frac{\EB_{F_{0}}[\widehat{g}]^{3}+\EB_{F_{0}}[\widehat{g}]^{-2}}{\sqrt{D_{\chi^{2}}(\widehat{F}_{\bm{P}},F_{0})}}\right\}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>ε</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>C</mi><mi>g</mi><mn>2</mn></msubsup><mrow><msub><mi>D</mi><msup><mi>χ</mi><mn>2</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><mo>,</mo><msub><mi>F</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>ε</mi><mi>min</mi></msub></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi>𝔼</mi><msub><mi>F</mi><mn>0</mn></msub></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">]</mo></mrow><mn>3</mn></msup></mrow><mo>+</mo><mrow><msub><mi>𝔼</mi><msub><mi>F</mi><mn>0</mn></msub></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">]</mo></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow></mrow><msqrt><mrow><msub><mi>D</mi><msup><mi>χ</mi><mn>2</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><mo>,</mo><msub><mi>F</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></msqrt></mfrac></mstyle><mo>}</mo></mrow></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq{\varepsilon}_{0}\Delta_{g}\left[1+\frac{C_{g}^{2}}{D_{\chi^{2}}(\widehat{F}_{\bm{P}},F_{0})}\min\left\{\frac{1}{{\varepsilon}_{\min}},\frac{\EB_{F_{0}}[\widehat{g}]^{3}+\EB_{F_{0}}[\widehat{g}]^{-2}}{\sqrt{D_{\chi^{2}}(\widehat{F}_{\bm{P}},F_{0})}}\right\}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex39a"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex39a.m1" class="ltx_Math" alttext="\displaystyle\leq{\varepsilon}_{0}\Delta_{g}\left[1+\frac{C_{g}^{2}}{4D_{\mathrm{TV}}^{2}(F_{0},\widehat{F}_{\bm{P}})}\min\left\{\frac{1}{{\varepsilon}_{\min}},\frac{\EB_{F_{0}}[\widehat{g}]^{3}+\EB_{F_{0}}[\widehat{g}]^{-2}}{2D_{\mathrm{TV}}(F_{0},\widehat{F}_{\bm{P}})}\right\}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>ε</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>C</mi><mi>g</mi><mn>2</mn></msubsup><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>D</mi><mi>TV</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mn>0</mn></msub><mo>,</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>ε</mi><mi>min</mi></msub></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi>𝔼</mi><msub><mi>F</mi><mn>0</mn></msub></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">]</mo></mrow><mn>3</mn></msup></mrow><mo>+</mo><mrow><msub><mi>𝔼</mi><msub><mi>F</mi><mn>0</mn></msub></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">]</mo></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><mi>TV</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mn>0</mn></msub><mo>,</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>}</mo></mrow></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq{\varepsilon}_{0}\Delta_{g}\left[1+\frac{C_{g}^{2}}{4D_{\mathrm{TV}}^{2}(F_{0},\widehat{F}_{\bm{P}})}\min\left\{\frac{1}{{\varepsilon}_{\min}},\frac{\EB_{F_{0}}[\widehat{g}]^{3}+\EB_{F_{0}}[\widehat{g}]^{-2}}{2D_{\mathrm{TV}}(F_{0},\widehat{F}_{\bm{P}})}\right\}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex40a"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex40a.m1" class="ltx_Math" alttext="\displaystyle\leq{\varepsilon}_{0}\Delta_{g}\left[1+\frac{C_{g}^{2}}{4D_{\mathrm{TV}}^{3}(F_{0},\widehat{F}_{\bm{P}})}\min\left\{\frac{1}{{\varepsilon}_{\min}},\EB_{F_{0}}[\widehat{g}]^{3}+\EB_{F_{0}}[\widehat{g}]^{-2}\right\}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>ε</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>C</mi><mi>g</mi><mn>2</mn></msubsup><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>D</mi><mi>TV</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mn>0</mn></msub><mo>,</mo><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi>𝑷</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>ε</mi><mi>min</mi></msub></mfrac></mstyle><mo>,</mo><mrow><mrow><msub><mi>𝔼</mi><msub><mi>F</mi><mn>0</mn></msub></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">]</mo></mrow><mn>3</mn></msup></mrow><mo>+</mo><mrow><msub><mi>𝔼</mi><msub><mi>F</mi><mn>0</mn></msub></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">]</mo></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq{\varepsilon}_{0}\Delta_{g}\left[1+\frac{C_{g}^{2}}{4D_{\mathrm{TV}}^{3}(F_{0},\widehat{F}_{\bm{P}})}\min\left\{\frac{1}{{\varepsilon}_{\min}},\EB_{F_{0}}[\widehat{g}]^{3}+\EB_{F_{0}}[\widehat{g}]^{-2}\right\}\right].</annotation></semantics></math></td>
