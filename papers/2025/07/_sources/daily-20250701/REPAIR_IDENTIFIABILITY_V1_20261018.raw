<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex28a.m2" class="ltx_Math" alttext="\displaystyle\frac{{\mathrm{d}}\widetilde{{\mathcal{T}}}({\varepsilon})}{{\mathrm{d}}{\varepsilon}}={\varepsilon}_{0}\frac{\int\frac{[1-\widehat{g}]^{2}[1-g]}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}]^{2}}{\mathrm{d}}F_{0}}{\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}{F}_{0}}-{\varepsilon}_{0}\frac{\int\frac{[1-\widehat{g}]^{3}}{[(1-{\varepsilon})+{\varepsilon}\widehat{g}]^{2}}{\mathrm{d}}{F}_{0}}{\left[\int\frac{[1-\widehat{g}]^{2}}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}{F}_{0}\right]^{2}}\cdot\int\frac{[1-\widehat{g}][1-g]}{(1-{\varepsilon})+{\varepsilon}\widehat{g}}{\mathrm{d}}F_{0}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow></mfrac></mstyle><mo>=</mo><mrow><mrow><msub><mi>ε</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∫</mo><mrow><mfrac><mrow><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mi>g</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mf