  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2506.23384">arXiv:2506.23384</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.23384">pdf</a>, <a href="https://arxiv.org/ps/2506.23384">ps</a>, <a href="https://arxiv.org/format/2506.23384">other</a>]&nbsp;</span>
      </p>
      <div class="tags is-inline-block">
