        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.23227">pdf</a>, <a href="https://arxiv.org/ps/2506.23227">ps</a>, <a href="https://arxiv.org/format/2506.23227">other</a>]&nbsp;</span>
