        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.23460">pdf</a>, <a href="https://arxiv.org/ps/2506.23460">ps</a>, <a href="https://arxiv.org/format/2506.23460">other</a>]&nbsp;</span>
      </p>
      <div class="tags is-inline-block">
