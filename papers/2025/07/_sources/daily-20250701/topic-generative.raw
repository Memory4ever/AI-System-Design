        <span>&nbsp;[<a href="https://arxiv.org/pdf/2507.00079">pdf</a>, <a href="https://arxiv.org/ps/2507.00079">ps</a>, <a href="https://arxiv.org/format/2507.00079">other</a>]&nbsp;</span>
