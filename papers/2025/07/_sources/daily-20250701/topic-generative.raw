    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2506.22864">arXiv:2506.22864</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.22864">pdf</a>, <a href="https://arxiv.org/ps/2506.22864">ps</a>, <a href="https://arxiv.org/format/2506.22864">other</a>]&nbsp;</span>
