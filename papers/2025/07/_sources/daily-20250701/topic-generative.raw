        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.22593">pdf</a>, <a href="https://arxiv.org/ps/2506.22593">ps</a>, <a href="https://arxiv.org/format/2506.22593">other</a>]&nbsp;</span>
