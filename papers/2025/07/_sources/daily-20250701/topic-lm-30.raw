        <span>&nbsp;[<a href="https://arxiv.org/pdf/2403.10798">pdf</a>, <a href="https://arxiv.org/ps/2403.10798">ps</a>, <a href="https://arxiv.org/format/2403.10798">other</a>]&nbsp;</span>
