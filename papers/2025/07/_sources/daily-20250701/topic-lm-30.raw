      <a href="/search/?searchtype=author&amp;query=Chen%2C+T">Tianrong Chen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Bautista%2C+M+A">Miguel Angel Bautista</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Susskind%2C+J">Josh Susskind</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Jaitly%2C+N">Navdeep Jaitly</a>
      
