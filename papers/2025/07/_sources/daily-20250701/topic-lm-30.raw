        <span>&nbsp;[<a href="https://arxiv.org/pdf/2507.02978">pdf</a>, <a href="https://arxiv.org/ps/2507.02978">ps</a>, <a href="https://arxiv.org/format/2507.02978">other</a>]&nbsp;</span>
