      <a href="/search/?searchtype=author&amp;query=Shavrina%2C+T">Tatiana Shavrina</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Gagnon-Audet%2C+J">Jean-Christophe Gagnon-Audet</a>, 
      
