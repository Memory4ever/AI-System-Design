             <span id="alg1.l12.2" class="ltx_text ltx_font_bold">End Procedure</span>

</div>
<div id="alg1.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">13:</span>
              
              
             
</div>
<div id="alg1.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">14:</span>
              
              
             <span id="alg1.l14.2" class="ltx_text ltx_font_bold">Procedure</span> <span id="alg1.l14.3" class="ltx_text ltx_font_smallcaps">WeightEstimation</span>

</div>
<div id="alg1.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">15:</span>
              
              
             Calculate min and max influence from <math id="alg1.l15.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>

</div>
<div id="alg1.l16" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">16:</span>
              
              
             Compute scaled influence for each entry in <math id="alg1.l16.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>

</div>
<div id="alg1.l17" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">17:</span>
              
              
             Calculate total influence token product

</div>
<div id="alg1.l18" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">18:</span>
              
              
