<td id="S3.T1.2.1.6.8" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FFCCFF;"><span id="S3.T1.2.1.6.8.1" class="ltx_text" style="--ltx-bg-color:#FFCCFF;">95%</span></td>
<td id="S3.T1.2.1.6.9" class="ltx_td ltx_align_center" style="--ltx-bg-color:#CCFFCC;"><span id="S3.T1.2.1.6.9.1" class="ltx_text" style="--ltx-bg-color:#CCFFCC;">100%</span></td></tr>
