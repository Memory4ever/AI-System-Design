<tr id="S3.T1.2.1.3" class="ltx_tr">
<td id="S3.T1.2.1.3.1" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T1.2.1.3.1.1" class="ltx_text ltx_font_smallcaps">25M</span></td>
<td id="S3.T1.2.1.3.2" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#CCFFFF;"><span id="S3.T1.2.1.3.2.1" class="ltx_text" style="--ltx-bg-color:#CCFFFF;">81%</span></td>
<td id="S3.T1.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#FFE6CC;"><span id="S3.T1.2.1.3.3.1" class="ltx_text" style="--ltx-bg-color:#FFE6CC;">76%</span></td>
<td id="S3.T1.2.1.3.4" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#FFFFCC;"><span id="S3.T1.2.1.3.4.1" class="ltx_text" style="--ltx-bg-color:#FFFFCC;">10%</span></td>
<td id="S3.T1.2.1.3.5" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#CCFFCC;"><span id="S3.T1.2.1.3.5.1" class="ltx_text" style="--ltx-bg-color:#CCFFCC;">100%</span></td>
<td id="S3.T1.2.1.3.6" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#FFF2F2;"><span id="S3.T1.2.1.3.6.1" class="ltx_text" style="--ltx-bg-color:#FFF2F2;">56%</span></td>
