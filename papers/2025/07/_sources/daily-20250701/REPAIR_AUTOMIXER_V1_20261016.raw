<td id="S3.T1.2.1.4.7" class="ltx_td ltx_align_center" style="--ltx-bg-color:#CCFFCC;"><span id="S3.T1.2.1.4.7.1" class="ltx_text" style="--ltx-bg-color:#CCFFCC;">100%</span></td>
