<td id="S3.T1.2.1.5.8" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FFCCFF;"><span id="S3.T1.2.1.5.8.1" class="ltx_text" style="--ltx-bg-color:#FFCCFF;">95%</span></td>
<td id="S3.T1.2.1.5.9" class="ltx_td ltx_align_center" style="--ltx-bg-color:#CCFFCC;"><span id="S3.T1.2.1.5.9.1" class="ltx_text" style="--ltx-bg-color:#CCFFCC;">100%</span></td></tr>
<tr id="S3.T1.2.1.6" class="ltx_tr">
<td id="S3.T1.2.1.6.1" class="ltx_td ltx_align_center"><span id="S3.T1.2.1.6.1.1" class="ltx_text ltx_font_smallcaps">350M</span></td>
<td id="S3.T1.2.1.6.2" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FFCCFF;"><span id="S3.T1.2.1.6.2.1" class="ltx_text" style="--ltx-bg-color:#FFCCFF;">95%</span></td>
<td id="S3.T1.2.1.6.3" class="ltx_td ltx_align_center" style="--ltx-bg-color:#F2E6D9;"><span id="S3.T1.2.1.6.3.1" class="ltx_text" style="--ltx-bg-color:#F2E6D9;">70%</span></td>
<td id="S3.T1.2.1.6.4" class="ltx_td ltx_align_center" style="--ltx-bg-color:#F2FFCC;"><span id="S3.T1.2.1.6.4.1" class="ltx_text" style="--ltx-bg-color:#F2FFCC;">40%</span></td>
<td id="S3.T1.2.1.6.5" class="ltx_td ltx_align_center" style="--ltx-bg-color:#CCFFCC;"><span id="S3.T1.2.1.6.5.1" class="ltx_text" style="--ltx-bg-color:#CCFFCC;">100%</span></td>
<td id="S3.T1.2.1.6.6" class="ltx_td ltx_align_center" style="--ltx-bg-color:#E6CCE6;"><span id="S3.T1.2.1.6.6.1" class="ltx_text" style="--ltx-bg-color:#E6CCE6;">80%</span></td>
