<td id="S3.T1.2.1.3.8" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#FFE6CC;"><span id="S3.T1.2.1.3.8.1" class="ltx_text" style="--ltx-bg-color:#FFE6CC;">76%</span></td>
<td id="S3.T1.2.1.3.9" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#CCFFFF;"><span id="S3.T1.2.1.3.9.1" class="ltx_text" style="--ltx-bg-color:#CCFFFF;">81%</span></td></tr>
<tr id="S3.T1.2.1.4" class="ltx_tr">
<td id="S3.T1.2.1.4.1" class="ltx_td ltx_align_center"><span id="S3.T1.2.1.4.1.1" class="ltx_text ltx_font_smallcaps">50M</span></td>
<td id="S3.T1.2.1.4.2" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FFCCCC;"><span id="S3.T1.2.1.4.2.1" class="ltx_text" style="--ltx-bg-color:#FFCCCC;">85%</span></td>
<td id="S3.T1.2.1.4.3" class="ltx_td ltx_align_center" style="--ltx-bg-color:#CCCCFF;"><span id="S3.T1.2.1.4.3.1" class="ltx_text" style="--ltx-bg-color:#CCCCFF;">45%</span></td>
<td id="S3.T1.2.1.4.4" class="ltx_td ltx_align_center" style="--ltx-bg-color:#F2CCD9;"><span id="S3.T1.2.1.4.4.1" class="ltx_text" style="--ltx-bg-color:#F2CCD9;">65%</span></td>
<td id="S3.T1.2.1.4.5" class="ltx_td ltx_align_center" style="--ltx-bg-color:#E6CCE6;"><span id="S3.T1.2.1.4.5.1" class="ltx_text" style="--ltx-bg-color:#E6CCE6;">80%</span></td>
