<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S5.SS3" title="In V Experiment Result ‣ Embodied Domain Adaptation for Object Detection" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">V-C</span> </span><span class="ltx_text ltx_font_italic">Implementation Details</span></span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S5.SS4" title="In V Experiment Result ‣ Embodied Domain Adaptation for Object Detection" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">V-D</span> </span><span class="ltx_text ltx_font_italic">Comparison with the SFDA baselines</span></span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S5.SS5" title="In V Experiment Result ‣ Embodied Domain Adaptation for Object Detection" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">V-E</span> </span><span class="ltx_text ltx_font_italic">Ablation Study</span></span></a></li>
