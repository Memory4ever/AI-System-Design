        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.24123">pdf</a>, <a href="https://arxiv.org/ps/2506.24123">ps</a>, <a href="https://arxiv.org/format/2506.24123">other</a>]&nbsp;</span>
