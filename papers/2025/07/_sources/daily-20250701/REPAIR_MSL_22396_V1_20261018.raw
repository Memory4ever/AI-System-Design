<td id="A19.T11.2.1.5.2" class="ltx_td ltx_align_center">74.8%</td>
<td id="A19.T11.2.1.5.3" class="ltx_td ltx_align_center">705</td>
<td id="A19.T11.2.1.5.4" class="ltx_td ltx_nopad_r ltx_align_center">he, we, our</td></tr>
