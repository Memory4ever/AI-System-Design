<td id="A19.T11.2.1.7.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="A19.T11.2.1.7.2.1" class="ltx_text ltx_font_bold">18.5%</span></td>
<td id="A19.T11.2.1.7.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">9,710</td>
