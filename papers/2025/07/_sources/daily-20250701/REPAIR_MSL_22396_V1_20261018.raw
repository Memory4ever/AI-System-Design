<td id="A19.T11.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="A19.T11.2.1.2.2.1" class="ltx_text ltx_font_bold">91.4%</span></td>
<td id="A19.T11.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t">1,204</td>
<td id="A19.T11.2.1.2.4" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">the, this, those</td></tr>
<tr id="A19.T11.2.1.3" class="ltx_tr">
<td id="A19.T11.2.1.3.1" class="ltx_td ltx_align_left">Prepositions (IN)</td>
<td id="A19.T11.2.1.3.2" class="ltx_td ltx_align_center"><span id="A19.T11.2.1.3.2.1" class="ltx_text ltx_font_bold">87.2%</span></td>
<td id="A19.T11.2.1.3.3" class="ltx_td ltx_align_center">986</td>
<td id="A19.T11.2.1.3.4" class="ltx_td ltx_nopad_r ltx_align_center">in, on, over</td></tr>
<tr id="A19.T11.2.1.4" class="ltx_tr">
<td id="A19.T11.2.1.4.1" class="ltx_td ltx_align_left">Conjunctions (CC)</td>
<td id="A19.T11.2.1.4.2" class="ltx_td ltx_align_center"><span id="A19.T11.2.1.4.2.1" class="ltx_text ltx_font_bold">89.6%</span></td>
<td id="A19.T11.2.1.4.3" class="ltx_td ltx_align_center">412</td>
<td id="A19.T11.2.1.4.4" class="ltx_td ltx_nopad_r ltx_align_center">and, but, or</td></tr>
