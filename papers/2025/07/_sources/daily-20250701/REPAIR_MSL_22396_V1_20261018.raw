<th id="A14.T9.2.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t">–</th>
<td id="A14.T9.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t">18.2</td>
<td id="A14.T9.2.1.2.5" class="ltx_td ltx_align_center ltx_border_t">0.0%</td>
<td id="A14.T9.2.1.2.6" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">No compression</td></tr>
<tr id="A14.T9.2.1.3" class="ltx_tr">
<th id="A14.T9.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Uniform 8-bit</th>
