<th id="A14.T9.2.1.4.3" class="ltx_td ltx_align_center ltx_th ltx_th_row"><math id="A14.T9.m1" class="ltx_Math" alttext="\tau_{low}=1.0,\tau_{high}=2.3" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>τ</mi><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msub><mo>=</mo><mn>1.0</mn></mrow><mo>,</mo><mrow><msub><mi>τ</mi><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><mo>=</mo><mn>2.3</mn></mrow></mrow><annotation encoding="application/x-tex">\tau_{low}=1.0,\tau_{high}=2.3</annotation></semantics></math></th>
<td id="A14.T9.2.1.4.4" class="ltx_td ltx_align_center"><span id="A14.T9.2.1.4.4.1" class="ltx_text ltx_font_bold">18.3</span></td>
<td id="A14.T9.2.1.4.5" class="ltx_td ltx_align_center"><span id="A14.T9.2.1.4.5.1" class="ltx_text ltx_font_bold">39.6%</span></td>
<td id="A14.T9.2.1.4.6" class="ltx_td ltx_nopad_r ltx_align_center">Dynamic bitwidth</td></tr>
