<td id="A14.T9.2.1.5.4" class="ltx_td ltx_align_center">18.4</td>
<td id="A14.T9.2.1.5.5" class="ltx_td ltx_align_center">33.2%</td>
<td id="A14.T9.2.1.5.6" class="ltx_td ltx_nopad_r ltx_align_center">Conservative quant</td></tr>
