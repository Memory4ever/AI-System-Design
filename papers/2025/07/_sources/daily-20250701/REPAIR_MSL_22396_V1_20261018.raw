<td id="A14.T9.2.1.3.4" class="ltx_td ltx_align_center">18.3</td>
<td id="A14.T9.2.1.3.5" class="ltx_td ltx_align_center">26.4%</td>
<td id="A14.T9.2.1.3.6" class="ltx_td ltx_nopad_r ltx_align_center">Fixed quantization</td></tr>
<tr id="A14.T9.2.1.4" class="ltx_tr">
<th id="A14.T9.2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Entropy-Aware (Ours)</th>
