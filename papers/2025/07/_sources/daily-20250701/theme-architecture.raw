        <span>&nbsp;[<a href="https://arxiv.org/pdf/2507.02939">pdf</a>, <a href="https://arxiv.org/ps/2507.02939">ps</a>, <a href="https://arxiv.org/format/2507.02939">other</a>]&nbsp;</span>
