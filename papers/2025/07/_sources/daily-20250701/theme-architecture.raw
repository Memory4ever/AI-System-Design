        <span>&nbsp;[<a href="https://arxiv.org/pdf/2507.02959">pdf</a>, <a href="https://arxiv.org/ps/2507.02959">ps</a>, <a href="https://arxiv.org/format/2507.02959">other</a>]&nbsp;</span>
      </p>
      <div class="tags is-inline-block">
