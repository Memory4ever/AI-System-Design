        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.22712">pdf</a>, <a href="https://arxiv.org/ps/2506.22712">ps</a>, <a href="https://arxiv.org/format/2506.22712">other</a>]&nbsp;</span>
