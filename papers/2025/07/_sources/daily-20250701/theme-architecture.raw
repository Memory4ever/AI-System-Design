        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.22718">pdf</a>, <a href="https://arxiv.org/ps/2506.22718">ps</a>, <a href="https://arxiv.org/format/2506.22718">other</a>]&nbsp;</span>
      </p>
      <div class="tags is-inline-block">
