    <p class="title is-5 mathjax">
      
        Andrews-Curtis groups
      
    </p>
    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Gilman%2C+R+H">Robert H. Gilman</a>, 
      
