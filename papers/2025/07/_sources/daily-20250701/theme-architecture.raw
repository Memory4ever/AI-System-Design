      <a href="/search/?searchtype=author&amp;query=DeAndres-Tame%2C+I">Ivan DeAndres-Tame</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Tolosana%2C+R">Ruben Tolosana</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Vera-Rodriguez%2C+R">Ruben Vera-Rodriguez</a>, 
      
