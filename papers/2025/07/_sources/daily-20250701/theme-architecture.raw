        <span>&nbsp;[<a href="https://arxiv.org/pdf/2507.02942">pdf</a>, <a href="https://arxiv.org/ps/2507.02942">ps</a>, <a href="https://arxiv.org/format/2507.02942">other</a>]&nbsp;</span>
