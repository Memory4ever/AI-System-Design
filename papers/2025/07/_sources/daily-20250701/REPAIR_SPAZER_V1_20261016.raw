<tr id="S4.T2.4.1.12" class="ltx_tr" style="--ltx-bg-color:#DFE1FD;">
<th id="S4.T2.4.1.12.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S4.T2.4.1.12.1.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#DFE1FD;">SPAZER (Ours)</span></th>
<td id="S4.T2.4.1.12.2" class="ltx_td ltx_align_center"><span id="S4.T2.4.1.12.2.1" class="ltx_text" style="--ltx-bg-color:#DFE1FD;">✓</span></td>
