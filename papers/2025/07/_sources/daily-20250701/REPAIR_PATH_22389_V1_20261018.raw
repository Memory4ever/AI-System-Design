<div class="ltx_flex_cell ltx_flex_size_2">
<div id="A6.F27.2" class="ltx_block ltx_figure_panel"><img src="2506.22389v1/x1.png" id="A6.F27.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:224/165;" width="224" height="165" alt="Refer to caption"><span class="ltx_rule ltx_align_center" style="--ltx-bg-color:black;display:inline-block;"> </span>
</div></div><div class="ltx_flex_cell ltx_flex_size_2"><img src="2506.22389v1/LMs/split_appendix/zipf_split_top2.png" id="A6.F27.g2" class="ltx_graphics ltx_centering ltx_figure_panel ltx_img_landscape" style="aspect-ratio:224/150;" width="224" height="150" alt="Refer to caption"></div></div>
