<div class="ltx_flex_cell ltx_flex_size_2">
<div id="A6.F28.2" class="ltx_block ltx_figure_panel"><object type="image/svg+xml" data="2506.22389v1/14paths_tokens_split_top1.svg" id="A6.F28.g1" class="ltx_graphics ltx_centering ltx_img_portrait" style="aspect-ratio:238/298;" width="238" height="298"></object><span class="ltx_rule ltx_align_center" style="--ltx-bg-color:black;display:inline-block;"> </span>
