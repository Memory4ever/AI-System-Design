<th id="A1.T5.2.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t"><span id="A1.T5.2.7.1.1" class="ltx_text" style="font-size:70%;">GPT-2 (30<math id="A1.T5.m53" class="ltx_Math" alttext="\%" display="inline" intent=":literal"><semantics><mo mathsize="1.430em">%</mo><annotation encoding="application/x-tex">\%</annotation></semantics></math> shallower)</span></th>
<td id="A1.T5.2.7.2" class="ltx_td ltx_align_center ltx_border_t"><span id="A1.T5.2.7.2.1" class="ltx_text" style="font-size:70%;">-</span></td>
<td id="A1.T5.2.7.3" class="ltx_td ltx_align_center ltx_border_t"><math id="A1.T5.m54" class="ltx_Math" alttext="17" display="inline" intent=":literal"><semantics><mn mathsize="0.700em">17</mn><annotation encoding="application/x-tex">17</annotation></semantics></math></td>
<td id="A1.T5.2.7.4" class="ltx_td ltx_align_center ltx_border_t"><span id="A1.T5.2.7.4.1" class="ltx_text" style="font-size:70%;">-</span></td>
<td id="A1.T5.2.7.5" class="ltx_td ltx_align_center ltx_border_t"><math id="A1.T5.m55" class="ltx_Math" alttext="1024" display="inline" intent=":literal"><semantics><mn mathsize="0.700em">1024</mn><annotation encoding="application/x-tex">1024</annotation></semantics></math></td>
<td id="A1.T5.2.7.6" class="ltx_td ltx_align_center ltx_border_t"><math id="A1.T5.m56" class="ltx_Math" alttext="4096" display="inline" intent=":literal"><semantics><mn mathsize="0.700em">4096</mn><annotation encoding="application/x-tex">4096</annotation></semantics></math></td>
<td id="A1.T5.2.7.7" class="ltx_td ltx_align_center ltx_border_t"><math id="A1.T5.m57" class="ltx_Math" alttext="16" display="inline" intent=":literal"><semantics><mn mathsize="0.700em">16</mn><annotation encoding="application/x-tex">16</annotation></semantics></math></td>
<td id="A1.T5.2.7.8" class="ltx_td ltx_align_center ltx_border_t"><math id="A1.T5.m58" class="ltx_Math" alttext="313" display="inline" intent=":literal"><semantics><mn mathsize="0.700em">313</mn><annotation encoding="application/x-tex">313</annotation></semantics></math><span id="A1.T5.2.7.8.1" class="ltx_text" style="font-size:70%;">M</span></td>
<td id="A1.T5.2.7.9" class="ltx_td ltx_align_center ltx_border_t"><math id="A1.T5.m59" class="ltx_Math" alttext="313" display="inline" intent=":literal"><semantics><mn mathsize="0.700em">313</mn><annotation encoding="application/x-tex">313</annotation></semantics></math><span id="A1.T5.2.7.9.1" class="ltx_text" style="font-size:70%;">M</span></td></tr>
<tr id="A1.T5.2.8" class="ltx_tr">
<th id="A1.T5.2.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_r"><span id="A1.T5.2.8.1.1" class="ltx_text" style="font-size:70%;">top-<math id="A1.T5.m60" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> DNA (<math id="A1.T5.m61" class="ltx_Math" alttext="30\%" display="inline" intent=":literal"><semantics><mrow><mn>30</mn><mo mathsize="1.430em">%</mo></mrow><annotation encoding="application/x-tex">30\%</annotation></semantics></math> skip)</span></th>
<td id="A1.T5.2.8.2" class="ltx_td ltx_align_center ltx_border_bb"><math id="A1.T5.m62" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn mathsize="0.700em">1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math></td>
