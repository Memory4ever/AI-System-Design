<td id="A5.T7.2.5.2" class="ltx_td ltx_align_left"><a href="https://github.com/carla-simulator/carla" title="" class="ltx_ref ltx_href">Link</a></td>
<td id="A5.T7.2.5.3" class="ltx_td ltx_align_left">MIT license</td></tr>
