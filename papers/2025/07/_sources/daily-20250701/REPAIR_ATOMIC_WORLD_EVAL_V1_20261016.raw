<td id="S3.T2.3.1.22.12" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="padding:-1pt 1.4pt;">80.0</td>
<td id="S3.T2.3.1.22.13" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="padding:-1pt 1.4pt;">82.0</td>
