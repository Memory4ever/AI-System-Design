<td id="S3.T2.3.1.21.10" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding:-1pt 1.4pt;">25.0</td>
<td id="S3.T2.3.1.21.11" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding:-1pt 1.4pt;">25.0</td>
<td id="S3.T2.3.1.21.12" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding:-1pt 1.4pt;">25.0</td>
<td id="S3.T2.3.1.21.13" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding:-1pt 1.4pt;">25.0</td>
<td id="S3.T2.3.1.21.14" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding:-1pt 1.4pt;">25.0</td>
<td id="S3.T2.3.1.21.15" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding:-1pt 1.4pt;">25.0</td>
<td id="S3.T2.3.1.21.16" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding:-1pt 1.4pt;">25.0</td></tr>
<tr id="S3.T2.3.1.22" class="ltx_tr">
<td id="S3.T2.3.1.22.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_border_bb" style="padding:-1pt 1.4pt;"><span id="S3.T2.3.1.22.1.1" class="ltx_text ltx_font_bold">Human</span></td>
<td id="S3.T2.3.1.22.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="padding:-1pt 1.4pt;">98.0</td>
<td id="S3.T2.3.1.22.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="padding:-1pt 1.4pt;">98.0</td>
<td id="S3.T2.3.1.22.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="padding:-1pt 1.4pt;">100.0</td>
<td id="S3.T2.3.1.22.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="padding:-1pt 1.4pt;">98.0</td>
<td id="S3.T2.3.1.22.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="padding:-1pt 1.4pt;">86.0</td>
<td id="S3.T2.3.1.22.7" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="padding:-1pt 1.4pt;">100.0</td>
<td id="S3.T2.3.1.22.8" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="padding:-1pt 1.4pt;">100.0</td>
