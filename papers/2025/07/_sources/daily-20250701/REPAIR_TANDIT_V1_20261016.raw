<th id="S2.T1.6.1.1.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_column ltx_border_t"><span id="S2.T1.6.1.1.2.1" class="ltx_text ltx_font_bold">Image Type</span>    </th>
