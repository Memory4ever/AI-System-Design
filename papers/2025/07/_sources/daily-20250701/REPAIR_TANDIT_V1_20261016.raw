</thead>
<tbody class="ltx_tbody">
<tr id="S2.T1.6.1.2" class="ltx_tr">
<td id="S2.T1.6.1.2.1" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t">PanFusion <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib7" title="" class="ltx_ref">7</a>]</cite>    </td>
<td id="S2.T1.6.1.2.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_border_t">ERP    </td>
<td id="S2.T1.6.1.2.3" class="ltx_td ltx_nopad_r ltx_align_right ltx_border_t">1    </td>
