    <p class="title is-5 mathjax">
      
        Masked Gated Linear Unit
      
    </p>
    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Tajima%2C+Y">Yukito Tajima</a>, 
      
