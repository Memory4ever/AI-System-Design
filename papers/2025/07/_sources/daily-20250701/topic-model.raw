        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.23437">pdf</a>, <a href="https://arxiv.org/ps/2506.23437">ps</a>, <a href="https://arxiv.org/format/2506.23437">other</a>]&nbsp;</span>
