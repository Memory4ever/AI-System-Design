<th id="S4.T1.2.1.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" colspan="14">BASELINES</th></tr>
<tr id="S4.T1.2.1.5" class="ltx_tr">
<th id="S4.T1.2.1.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" colspan="2">LLaMA-2-70B-Chat</th>
<td id="S4.T1.2.1.5.2" class="ltx_td ltx_align_center ltx_border_t">82.7</td>
<td id="S4.T1.2.1.5.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">7.09</td>
