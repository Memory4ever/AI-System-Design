<td id="S4.T3.2.1.18.9" class="ltx_td ltx_align_center">+17.5</td></tr>
<tr id="S4.T3.2.1.19" class="ltx_tr">
<td id="S4.T3.2.1.19.1" class="ltx_td ltx_align_center">Code</td>
<td id="S4.T3.2.1.19.2" class="ltx_td ltx_align_center">50.0</td>
