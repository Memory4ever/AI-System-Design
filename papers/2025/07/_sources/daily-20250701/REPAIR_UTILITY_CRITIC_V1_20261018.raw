<span id="A2.T34.2.6.1.1.2" class="ltx_p">[{kind}]</span>
<span id="A2.T34.2.6.1.1.3" class="ltx_p">{prompt}</span>
</span></td></tr>
<tr id="A2.T34.2.7" class="ltx_tr">
