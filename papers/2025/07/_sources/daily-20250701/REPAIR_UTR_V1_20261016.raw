<th id="S3.T2.4.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="4"><span id="S3.T2.4.1.1.3.1" class="ltx_text ltx_font_bold" style="font-size:70%;">State</span></th></tr>
<tr id="S3.T2.4.1.2" class="ltx_tr">
<th id="S3.T2.4.1.2.1" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_t"><span id="S3.T2.4.1.2.1.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Min</span></th>
<th id="S3.T2.4.1.2.2" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_t"><span id="S3.T2.4.1.2.2.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Max</span></th>
<th id="S3.T2.4.1.2.3" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_t"><span id="S3.T2.4.1.2.3.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Avg</span></th>
<th id="S3.T2.4.1.2.4" class="ltx_td ltx_nopad_r ltx_align_right ltx_th ltx_th_column ltx_border_t"><span id="S3.T2.4.1.2.4.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Total</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S3.T2.4.1.3" class="ltx_tr">
<td id="S3.T2.4.1.3.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S3.T2.4.1.3.1.1" class="ltx_text" style="font-size:70%;">Mind2Web</span></td>
<td id="S3.T2.4.1.3.2" class="ltx_td ltx_align_right ltx_border_t"><span id="S3.T2.4.1.3.2.1" class="ltx_text" style="font-size:70%;">1,468</span></td>
<td id="S3.T2.4.1.3.3" class="ltx_td ltx_align_right ltx_border_t"><span id="S3.T2.4.1.3.3.1" class="ltx_text" style="font-size:70%;">2</span></td>
