<td id="S1.T1.2.1.3.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;" rowspan="2"><span id="S1.T1.2.1.3.1.1" class="ltx_text">1. <math id="S1.T1.m1" class="ltx_Math" alttext="(q,\tau)\to\tau^{\prime}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>,</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><msup><mi>τ</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">(q,\tau)\to\tau^{\prime}</annotation></semantics></math></span></td>
<td id="S1.T1.2.1.3.2" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"><math id="S1.T1.m2" class="ltx_math_unparsed" alttext="(q,\tau_{1:i})\to\tau_{i+1:n}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>,</mo><msub><mi>τ</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><msub><mi>τ</mi><mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">(q,\tau_{1:i})\to\tau_{i+1:n}</annotation></semantics></math></td>
<td id="S1.T1.2.1.3.3" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;">Apply the request to the previous web navigation steps to derive the next trajectory.</td>
