<td id="S1.T1.2.1.3.5" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;">40,748</td>
<td id="S1.T1.2.1.3.6" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;">2,523</td>
<td id="S1.T1.2.1.3.7" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;">2,665</td>
<td id="S1.T1.2.1.3.8" class="ltx_td ltx_nopad_r ltx_align_right ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;">45,936</td></tr>
<tr id="S1.T1.2.1.4" class="ltx_tr">
<td id="S1.T1.2.1.4.1" class="ltx_td ltx_align_left" style="padding-left:5.0pt;padding-right:5.0pt;"><math id="S1.T1.m3" class="ltx_math_unparsed" alttext="(q,\tau_{i+1:n})\to\tau_{1:i}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>,</mo><msub><mi>τ</mi><mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><msub><mi>τ</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub></mrow><annotation encoding="application/x-tex">(q,\tau_{i+1:n})\to\tau_{1:i}</annotation></semantics></math></td>
<td id="S1.T1.2.1.4.2" class="ltx_td ltx_align_left" style="padding-left:5.0pt;padding-right:5.0pt;">Find the previous web browsing trajectory based on the user input and the current trajectory.</td>
<td id="S1.T1.2.1.4.3" class="ltx_td ltx_align_right" style="padding-left:5.0pt;padding-right:5.0pt;">75,046</td>
<td id="S1.T1.2.1.4.4" class="ltx_td ltx_align_right" style="padding-left:5.0pt;padding-right:5.0pt;">40,748</td>
<td id="S1.T1.2.1.4.5" class="ltx_td ltx_align_right" style="padding-left:5.0pt;padding-right:5.0pt;">723</td>
