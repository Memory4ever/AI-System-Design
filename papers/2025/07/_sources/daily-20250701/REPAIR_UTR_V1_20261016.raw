<span id="A1.T7.15.3.2.1.1" class="ltx_p"><span id="A1.T7.15.3.2.1.1.1" class="ltx_text" style="font-size:70%;">Action </span><math id="A1.T7.m25" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math><span id="A1.T7.15.3.2.1.1.2" class="ltx_text" style="font-size:70%;">: {”operation”: ”type”, ”value”: ”Elon Musk”, ”target”: {”x”: 0.5704, ”y”: 0.2142, ”width”: 0.3678, ”height”: 0.0663}}</span></span>
