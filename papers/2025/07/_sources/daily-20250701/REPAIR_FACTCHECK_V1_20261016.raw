</figure>
<figure id="S3.F4" class="ltx_figure"><span class="ltx_inline-block"><svg id="S3.F4.pic1" class="ltx_picture" height="136.56" overflow="visible" version="1.1" viewBox="0 0 653.15 136.56" width="653.15"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,136.56) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#404040;" fill="#404040" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 130.66 C 0 133.92 2.64 136.56 5.91 136.56 L 647.24 136.56 C 650.51 136.56 653.15 133.92 653.15 130.66 L 653.15 5.91 C 653.15 2.64 650.51 0 647.24 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 130.66 C 1.97 132.83 3.73 134.6 5.91 134.6 L 647.24 134.6 C 649.42 134.6 651.18 132.83 651.18 130.66 L 651.18 5.91 C 651.18 3.73 649.42 1.97 647.24 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 33.07)"><foreignObject style="--ltx-fo-width:44.07em;--ltx-fo-height:6.48em;--ltx-fo-depth:1.39em;font-size:10pt;" height="109.01" overflow="visible" transform="matrix(1 0 0 -1 0 89.71)" width="609.8"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
