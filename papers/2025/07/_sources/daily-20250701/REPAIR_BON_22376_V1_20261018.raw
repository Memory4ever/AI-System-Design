<td id="S4.T1.5.1.4.10" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.5.1.4.10.1" class="ltx_text ltx_font_bold">22.5</span></td>
<td id="S4.T1.5.1.4.11" class="ltx_td ltx_align_center ltx_border_t">25304</td></tr>
