<td id="S5.T4.3.3.7" class="ltx_td ltx_align_right ltx_border_t">85.3</td></tr>
<tr id="S5.T4.3.4" class="ltx_tr">
<td id="S5.T4.3.4.1" class="ltx_td ltx_align_left ltx_border_r">EXAONE Deep 32B</td>
<td id="S5.T4.3.4.2" class="ltx_td ltx_align_right">62.5</td>
<td id="S5.T4.3.4.3" class="ltx_td ltx_align_right">22</td>
