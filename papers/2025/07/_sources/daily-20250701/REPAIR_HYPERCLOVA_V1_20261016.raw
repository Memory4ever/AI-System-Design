<td id="S5.T4.3.4.5" class="ltx_td ltx_align_right ltx_border_r"><span id="S5.T4.3.4.5.1" class="ltx_text ltx_font_bold">12.0</span></td>
<td id="S5.T4.3.4.6" class="ltx_td ltx_align_right">85.6</td>
<td id="S5.T4.3.4.7" class="ltx_td ltx_align_right">77.5</td></tr>
