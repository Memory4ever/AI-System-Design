<td id="S2.T1.3.2.2" class="ltx_td ltx_align_center ltx_border_tt">9.59%</td>
<td id="S2.T1.3.2.3" class="ltx_td ltx_align_center ltx_border_tt">1.36%</td></tr>
<tr id="S2.T1.3.3" class="ltx_tr">
<td id="S2.T1.3.3.1" class="ltx_td ltx_align_left ltx_border_t">Cafe</td>
<td id="S2.T1.3.3.2" class="ltx_td ltx_align_center ltx_border_t">57.74%</td>
<td id="S2.T1.3.3.3" class="ltx_td ltx_align_center ltx_border_t">19.84%</td></tr>
<tr id="S2.T1.3.4" class="ltx_tr">
<td id="S2.T1.3.4.1" class="ltx_td ltx_align_left">Blog</td>
<td id="S2.T1.3.4.2" class="ltx_td ltx_align_center">31.53%</td>
<td id="S2.T1.3.4.3" class="ltx_td ltx_align_center">2.35%</td></tr>
<tr id="S2.T1.3.5" class="ltx_tr">
