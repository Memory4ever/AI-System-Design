<td id="S5.T4.3.5.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_r ltx_border_t"><span id="S5.T4.3.5.1.1" class="ltx_text ltx_font_bold">HyperCLOVA X THINK</span></td>
<td id="S5.T4.3.5.2" class="ltx_td ltx_align_right ltx_border_bb ltx_border_t">74.5</td>
<td id="S5.T4.3.5.3" class="ltx_td ltx_align_right ltx_border_bb ltx_border_t">12.0</td>
<td id="S5.T4.3.5.4" class="ltx_td ltx_align_right ltx_border_bb ltx_border_t"><span id="S5.T4.3.5.4.1" class="ltx_text ltx_font_bold">4.5</span></td>
<td id="S5.T4.3.5.5" class="ltx_td ltx_align_right ltx_border_bb ltx_border_r ltx_border_t">9.0</td>
