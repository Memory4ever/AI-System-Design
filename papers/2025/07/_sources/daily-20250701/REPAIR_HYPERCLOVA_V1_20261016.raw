<span id="S4.T3.3.1.3.1.1" class="ltx_inline-block ltx_align_top" style="width:39.8pt;">
<span id="S4.T3.3.1.3.1.1.1" class="ltx_p"><span id="S4.T3.3.1.3.1.1.1.1" class="ltx_text"></span><span id="S4.T3.3.1.3.1.1.1.2" class="ltx_text" style="font-size:90%;"> </span><span id="S4.T3.3.1.3.1.1.1.3" class="ltx_text" style="font-size:90%;">
<span id="S4.T3.3.1.3.1.1.1.3.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T3.3.1.3.1.1.1.3.1.1" class="ltx_tr">
<span id="S4.T3.3.1.3.1.1.1.3.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-top:2.8pt;padding-bottom:2.8pt;">General</span></span>
<span id="S4.T3.3.1.3.1.1.1.3.1.2" class="ltx_tr">
<span id="S4.T3.3.1.3.1.1.1.3.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-top:2.8pt;padding-bottom:2.8pt;">Aptitude</span></span>
</span></span><span id="S4.T3.3.1.3.1.1.1.4" class="ltx_text"></span></span>
</span></td>
<td id="S4.T3.3.1.3.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-top:2.8pt;padding-bottom:2.8pt;">
<span id="S4.T3.3.1.3.2.1" class="ltx_inline-block ltx_align_top" style="width:56.9pt;">
