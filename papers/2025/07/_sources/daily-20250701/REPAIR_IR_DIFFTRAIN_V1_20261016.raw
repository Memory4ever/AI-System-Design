<figure id="alg5" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg5.3" class="ltx_text ltx_font_bold">Algorithm 5</span> </span> Our Diffusion Training Enhanced IR Framework</figcaption>
<div id="alg5.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg5.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
            <math id="alg5.l1.m1" class="ltx_Math" alttext="\mathcal{T}={\{t_{i}^{mat}\}}_{i=1}^{n}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>t</mi><mi>i</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{T}={\{t_{i}^{mat}\}}_{i=1}^{n}</annotation></semantics></math>, <math id="alg5.l1.m2" class="ltx_Math" alttext="\mathbf{x}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\mathbf{x}_{0}</annotation></semantics></math>, <math id="alg5.l1.m3" class="ltx_Math" alttext="\mathbf{x}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathbf{x}_{t}</annotation></semantics></math>, <math id="alg5.l1.m4" class="ltx_Math" alttext="\mathbf{x}_{T}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mi>T</mi></msub><annotation encoding="application/x-tex">\mathbf{x}_{T}</annotation></semantics></math>, <math id="alg5.l1.m5" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math>, <math id="alg5.l1.m6" class="ltx_Math" alttext="\mathbf{y}" display="inline" intent=":literal"><semantics><mi>𝐲</mi><annotation encoding="application/x-tex">\mathbf{y}</annotation></semantics></math>

</div>
<div id="alg5.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
            a image restoration network <math id="alg5.l2.m1" class="ltx_Math" alttext="r_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">r_{\theta}</annotation></semantics></math>, incremental training image restoration network <math id="alg5.l2.m2" class="ltx_Math" alttext="\{r_{\theta_{i}}\}_{1}^{n}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>r</mi><msub><mi>θ</mi><mi>i</mi></msub></msub><mo stretchy="false">}</mo></mrow><mn>1</mn><mi>n</mi></msubsup><annotation encoding="application/x-tex">\{r_{\theta_{i}}\}_{1}^{n}</annotation></semantics></math>

</div>
<div id="alg5.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
            a generative pre-trained image restoration network
<math id="alg5.l3.m1" class="ltx_Math" alttext="r_{\theta_{pre}}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><msub><mi>θ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></msub></msub><annotation encoding="application/x-tex">r_{\theta_{pre}}</annotation></semantics></math>

</div>
<div id="alg5.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
            a task-specific image restoration fine-tuning network <math id="alg5.l4.m1" class="ltx_Math" alttext="r_{\theta_{fine}}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><msub><mi>θ</mi><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></msub></msub><annotation encoding="application/x-tex">r_{\theta_{fine}}</annotation></semantics></math>

</div>
<div id="alg5.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
            generation training loss <math id="alg5.l5.m1" class="ltx_Math" alttext="\mathcal{L}_{g}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>g</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{g}</annotation></semantics></math>, fine-tuning training loss <math id="alg5.l5.m2" class="ltx_Math" alttext="\mathcal{L}_{fine}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{L}_{fine}</annotation></semantics></math>

</div>
<div id="alg5.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
              
              
            <math id="alg5.l6.m1" class="ltx_Math" alttext="\mathbf{x}_{0}\sim q(\mathbf{x}_{0})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><mn>0</mn></msub><mo>∼</mo><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}_{0}\sim q(\mathbf{x}_{0})</annotation></semantics></math>

</div>
<div id="alg5.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
              
              
            <math id="alg5.l7.m1" class="ltx_Math" alttext="\mathbf{x}_{T}\sim\mathcal{N}(\mathbf{0},\mathbf{I})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><mi>T</mi></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>𝟎</mn><mo>,</mo><mi>𝐈</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}_{T}\sim\mathcal{N}(\mathbf{0},\mathbf{I})</annotation></semantics></math>

</div>
<div id="alg5.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
              
              
            <math id="alg5.l8.m1" class="ltx_Math" alttext="\mathbf{y}\sim p(\mathbf{y})" display="inline" intent=":literal"><semantics><mrow><mi>𝐲</mi><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{y}\sim p(\mathbf{y})</annotation></semantics></math>

</div>
<div id="alg5.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
              
              
            <math id="alg5.l9.m1" class="ltx_Math" alttext="\mathbf{x}\sim{r_{\theta}}^{-1}(\mathbf{y})" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∼</mo><mrow><mmultiscripts><mi>r</mi><mi>θ</mi><mrow></mrow><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}\sim{r_{\theta}}^{-1}(\mathbf{y})</annotation></semantics></math>

</div>
<div id="alg5.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
              
              
            <math id="alg5.l10.m1" class="ltx_Math" alttext="t\sim\mathrm{Uniform}(\{1,\dotsc,T\})" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∼</mo><mrow><mi>Uniform</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><mo stretchy="false">}</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t\sim\mathrm{Uniform}(\{1,\dotsc,T\})</annotation></semantics></math>

</div>
<div id="alg5.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
              
              
            <math id="alg5.l11.m1" class="ltx_Math" alttext="i\sim\mathrm{Uniform}(\{1,\dotsc,n\})" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∼</mo><mrow><mi>Uniform</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi></mrow><mo stretchy="false">}</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">i\sim\mathrm{Uniform}(\{1,\dotsc,n\})</annotation></semantics></math>

</div>
<div id="alg5.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
              
              
            <span id="alg5.l12.3" class="ltx_text ltx_font_bold">repeat</span>
</div>
<div id="alg5.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
              
              
              Take gradient descent step on

</div>
<div id="alg5.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
              
              
            <math id="alg5.l14.m1" class="ltx_Math" alttext="\qquad\nabla_{\theta}\left\|\mathbf{\epsilon}-r_{\theta}(\sqrt{\bar{\alpha}_{t}}\mathbf{x}_{0}+\sqrt{1-\bar{\alpha}_{t}}\mathbf{\epsilon},t)\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msup><mrow><mo>‖</mo><mrow><mi>ϵ</mi><mo>−</mo><mrow><msub><mi>r</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msqrt><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\qquad\nabla_{\theta}\left\|\mathbf{\epsilon}-r_{\theta}(\sqrt{\bar{\alpha}_{t}}\mathbf{x}_{0}+\sqrt{1-\bar{\alpha}_{t}}\mathbf{\epsilon},t)\right\|^{2}</annotation></semantics></math>

</div>
<div id="alg5.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
              
              
            <span id="alg5.l15.3" class="ltx_text ltx_font_bold">until</span> converged

</div>
<div id="alg5.l16" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
              
              
            <span id="alg5.l16.3" class="ltx_text ltx_font_bold">for</span> <math id="alg5.l16.m1" class="ltx_Math" alttext="t=T,\dotsc,1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mi>T</mi></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=T,\dotsc,1</annotation></semantics></math> <span id="alg5.l16.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg5.l17" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l17.1" class="ltx_text" style="font-size:80%;">17:</span></span>
              
              
              <math id="alg5.l17.m1" class="ltx_Math" alttext="\mathbf{z}\sim\mathcal{N}(\mathbf{0},\mathbf{I})" display="inline" intent=":literal"><semantics><mrow><mi>𝐳</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>𝟎</mn><mo>,</mo><mi>𝐈</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{z}\sim\mathcal{N}(\mathbf{0},\mathbf{I})</annotation></semantics></math> <span id="alg5.l17.3" class="ltx_text ltx_font_bold">If</span> <math id="alg5.l17.m2" class="ltx_Math" alttext="t&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t&gt;1</annotation></semantics></math>, else <math id="alg5.l17.m3" class="ltx_Math" alttext="\mathbf{z}=\mathbf{0}" display="inline" intent=":literal"><semantics><mrow><mi>𝐳</mi><mo>=</mo><mn>𝟎</mn></mrow><annotation encoding="application/x-tex">\mathbf{z}=\mathbf{0}</annotation></semantics></math>

</div>
<div id="alg5.l18" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l18.1" class="ltx_text" style="font-size:80%;">18:</span></span>
              
              
              <math id="alg5.l18.m1" class="ltx_Math" alttext="\mathbf{x}_{t-1}=\frac{1}{\sqrt{\alpha_{t}}}\left(\mathbf{x}_{t}-\frac{1-\alpha_{t}}{\sqrt{1-\bar{\alpha}_{t}}}\mathbf{\epsilon}_{\theta}(\mathbf{x}_{t},t)\right)+\sigma_{t}\mathbf{z}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>𝐱</mi><mi>t</mi></msub><mo>−</mo><mrow><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>σ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐳</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}_{t-1}=\frac{1}{\sqrt{\alpha_{t}}}\left(\mathbf{x}_{t}-\frac{1-\alpha_{t}}{\sqrt{1-\bar{\alpha}_{t}}}\mathbf{\epsilon}_{\theta}(\mathbf{x}_{t},t)\right)+\sigma_{t}\mathbf{z}</annotation></semantics></math>

</div>
