<math id="alg4.l3.m1" class="ltx_Math" alttext="r_{\theta_{pre}}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><msub><mi>θ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></msub></msub><annotation encoding="application/x-tex">r_{\theta_{pre}}</annotation></semantics></math>

