                  <math id="alg4.l13.m1" class="ltx_Math" alttext="{\theta_{i}}\leftarrow{\theta_{i-1}}+\epsilon(\nabla_{\theta_{pre}}\mathcal{L}_{fine}+\nabla_{\theta_{i-1}}\mathcal{L}_{g})" display="inline" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mi>i</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi>θ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>+</mo><mrow><mi>ϵ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><msub><mi>θ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></msub></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></msub></mrow><mo>+</mo><mrow><msub><mo rspace="0.167em">∇</mo><msub><mi>θ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>g</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\theta_{i}}\leftarrow{\theta_{i-1}}+\epsilon(\nabla_{\theta_{pre}}\mathcal{L}_{fine}+\nabla_{\theta_{i-1}}\mathcal{L}_{g})</annotation></semantics></math>
        
