            <math id="alg1.l5.m1" class="ltx_Math" alttext="\mathbf{\epsilon}\sim\mathcal{N}(\mathbf{0},\mathbf{I})" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>𝟎</mn><mo>,</mo><mi>𝐈</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{\epsilon}\sim\mathcal{N}(\mathbf{0},\mathbf{I})</annotation></semantics></math>

