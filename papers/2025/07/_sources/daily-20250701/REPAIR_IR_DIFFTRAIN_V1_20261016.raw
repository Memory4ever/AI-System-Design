<td id="A8.T6.6.10.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="padding-left:20.0pt;padding-right:20.0pt;"><span id="A8.T6.6.10.3.1" class="ltx_text" style="--ltx-bg-color:#0000FF;">  <span id="A8.T6.6.10.3.1.1" class="ltx_text ltx_font_bold">0.971</span></span></td>
<td id="A8.T6.6.10.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:20.0pt;padding-right:20.0pt;"><span id="A8.T6.6.10.4.1" class="ltx_text" style="--ltx-bg-color:#0000FF;">  <span id="A8.T6.6.10.4.1.1" class="ltx_text ltx_font_bold">16.87 </span></span></td>
<td id="A8.T6.6.10.5" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:20.0pt;padding-right:20.0pt;"><span id="A8.T6.6.10.5.1" class="ltx_text" style="--ltx-bg-color:#0000FF;">  <span id="A8.T6.6.10.5.1.1" class="ltx_text ltx_font_bold">0.695</span></span></td></tr>
