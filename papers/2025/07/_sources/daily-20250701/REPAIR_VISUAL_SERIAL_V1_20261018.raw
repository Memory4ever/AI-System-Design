<td id="A1.T5.5.3.4" class="ltx_td ltx_align_center"><span id="A1.T5.5.3.4.1" class="ltx_text" style="font-size:90%;">0.73</span></td></tr>
<tr id="A1.T5.5.4" class="ltx_tr">
