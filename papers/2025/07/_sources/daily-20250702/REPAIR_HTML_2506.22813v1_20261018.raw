<td id="S3.T1.2.1.11.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T1.2.1.11.6.1" class="ltx_text ltx_font_bold">74.47<sub id="S3.T1.2.1.11.6.1.1" class="ltx_sub"><span id="S3.T1.2.1.11.6.1.1.1" class="ltx_text ltx_font_italic">18.4%</span></sub></span></td>
