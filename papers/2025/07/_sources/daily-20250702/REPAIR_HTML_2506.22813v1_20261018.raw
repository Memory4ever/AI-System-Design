<td id="S4.T8.2.1.3.2" class="ltx_td ltx_align_center ltx_border_t">54.20</td>
<td id="S4.T8.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t">60.31</td>
<td id="S4.T8.2.1.3.4" class="ltx_td ltx_align_center ltx_border_t">60.98</td>
