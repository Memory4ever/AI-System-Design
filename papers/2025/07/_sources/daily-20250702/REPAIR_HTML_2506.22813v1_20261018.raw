<td id="S3.T1.2.1.11.9" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T1.2.1.11.9.1" class="ltx_text ltx_underline">52.99</span><sub id="S3.T1.2.1.11.9.2" class="ltx_sub"><span id="S3.T1.2.1.11.9.2.1" class="ltx_text ltx_font_italic">6.7%</span></sub></td>
<td id="S3.T1.2.1.11.10" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T1.2.1.11.10.1" class="ltx_text ltx_font_bold">66.24<sub id="S3.T1.2.1.11.10.1.1" class="ltx_sub"><span id="S3.T1.2.1.11.10.1.1.1" class="ltx_text ltx_font_italic">8.70%</span></sub></span></td></tr>
