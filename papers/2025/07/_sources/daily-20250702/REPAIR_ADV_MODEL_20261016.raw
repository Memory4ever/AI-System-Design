    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Lee%2C+B+H">Byung Hyun Lee</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Lim%2C+S">Sungjin Lim</a>, 
      
