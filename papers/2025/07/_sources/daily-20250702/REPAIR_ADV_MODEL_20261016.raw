      <a href="/search/?searchtype=author&amp;query=Liu%2C+T">Tianhui Liu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Xi%2C+Y">Yanxin Xi</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Li%2C+Y">Yong Li</a>
      
