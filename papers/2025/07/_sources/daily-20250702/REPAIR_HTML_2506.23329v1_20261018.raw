</span>
<span id="lstnumberx36" class="ltx_listingline"><span id="lstnumberx36.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;">      </span><span id="lstnumberx36.2" class="ltx_text ltx_font_typewriter" style="font-size:70%;">"</span><span id="lstnumberx36.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">score</span><span id="lstnumberx36.4" class="ltx_text ltx_font_typewriter" style="font-size:70%;">":</span><span id="lstnumberx36.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx36.6" class="ltx_text ltx_font_typewriter" style="font-size:70%;">&lt;</span><span id="lstnumberx36.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">integer</span><span id="lstnumberx36.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx36.9" class="ltx_text ltx_font_typewriter" style="font-size:70%;">0-5&gt;,</span>
</span>
<span id="lstnumberx37" class="ltx_listingline"><span id="lstnumberx37.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;">      </span><span id="lstnumberx37.2" class="ltx_text ltx_font_typewriter" style="font-size:70%;">"</span><span id="lstnumberx37.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">justification</span><span id="lstnumberx37.4" class="ltx_text ltx_font_typewriter" style="font-size:70%;">":</span><span id="lstnumberx37.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx37.6" class="ltx_text ltx_font_typewriter" style="font-size:70%;">"&lt;</span><span id="lstnumberx37.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">string</span><span id="lstnumberx37.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx37.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">explanation</span><span id="lstnumberx37.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx37.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">of</span><span id="lstnumberx37.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx37.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">matching</span><span id="lstnumberx37.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx37.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">success</span><span id="lstnumberx37.16" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx37.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">and</span><span id="lstnumberx37.18" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx37.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">attribute</span><span id="lstnumberx37.20" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx37.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">accuracy</span><span id="lstnumberx37.22" class="ltx_text ltx_font_typewriter" style="font-size:70%;">,</span>
</span>
