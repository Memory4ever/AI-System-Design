<td id="S3.T2.3.1.2.4" class="ltx_td ltx_align_center ltx_border_t">C <math id="S3.T2.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="S3.T2.3.1.2.5" class="ltx_td ltx_align_center ltx_border_t">M <math id="S3.T2.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="S3.T2.3.1.2.6" class="ltx_td ltx_align_center ltx_border_t">R <math id="S3.T2.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="S3.T2.3.1.2.7" class="ltx_td ltx_align_center ltx_border_l ltx_border_t">gIoU</td></tr>
<tr id="S3.T2.3.1.3" class="ltx_tr">
<td id="S3.T2.3.1.3.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t"><span id="S3.T2.3.1.3.1.1" class="ltx_text" style="--ltx-fg-color:#969696;">ScanRefer  <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib4" title="" class="ltx_ref">4</a>]</cite></span></td>
<td id="S3.T2.3.1.3.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T2.3.1.3.2.1" class="ltx_text" style="--ltx-fg-color:#969696;">37.3</span></td>
<td id="S3.T2.3.1.3.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S3.T2.3.1.3.3.1" class="ltx_text" style="--ltx-fg-color:#969696;">24.3</span></td>
<td id="S3.T2.3.1.3.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T2.3.1.3.4.1" class="ltx_text" style="--ltx-fg-color:#969696;">–</span></td>
<td id="S3.T2.3.1.3.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T2.3.1.3.5.1" class="ltx_text" style="--ltx-fg-color:#969696;">–</span></td>
<td id="S3.T2.3.1.3.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T2.3.1.3.6.1" class="ltx_text" style="--ltx-fg-color:#969696;">–</span></td>
<td id="S3.T2.3.1.3.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S3.T2.3.1.3.7.1" class="ltx_text" style="--ltx-fg-color:#969696;">–</span></td>
<td id="S3.T2.3.1.3.8" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T2.3.1.3.8.1" class="ltx_text" style="--ltx-fg-color:#969696;">–</span></td></tr>
<tr id="S3.T2.3.1.4" class="ltx_tr">
<td id="S3.T2.3.1.4.1" class="ltx_td ltx_align_left ltx_border_r"><span id="S3.T2.3.1.4.1.1" class="ltx_text" style="--ltx-fg-color:#969696;">MVT  <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib21" title="" class="ltx_ref">21</a>]</cite></span></td>
<td id="S3.T2.3.1.4.2" class="ltx_td ltx_align_center"><span id="S3.T2.3.1.4.2.1" class="ltx_text" style="--ltx-fg-color:#969696;">40.8</span></td>
<td id="S3.T2.3.1.4.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S3.T2.3.1.4.3.1" class="ltx_text" style="--ltx-fg-color:#969696;">33.3</span></td>
<td id="S3.T2.3.1.4.4" class="ltx_td ltx_align_center"><span id="S3.T2.3.1.4.4.1" class="ltx_text" style="--ltx-fg-color:#969696;">–</span></td>
<td id="S3.T2.3.1.4.5" class="ltx_td ltx_align_center"><span id="S3.T2.3.1.4.5.1" class="ltx_text" style="--ltx-fg-color:#969696;">–</span></td>
