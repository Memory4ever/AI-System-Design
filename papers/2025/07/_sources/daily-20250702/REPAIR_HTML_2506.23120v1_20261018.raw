<div id="S4.T5.3" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:496.9pt;height:85.7pt;vertical-align:-39.4pt;"><span class="ltx_transformed_inner" style="transform:translate(69.8pt,-12.0pt) scale(1.39069953376374,1.39069953376374) ;">
<table id="S4.T5.3.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S4.T5.3.1.1" class="ltx_tr">
<th id="S4.T5.3.1.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt" rowspan="2"><span id="S4.T5.3.1.1.1.1" class="ltx_text"><math id="S4.T5.m1" class="ltx_Math" alttext="\lambda_{txt}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">\lambda_{txt}</annotation></semantics></math></span></th>
<th id="S4.T5.3.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt" colspan="2">ScanRefer</th>
<th id="S4.T5.3.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="4">ScanQA</th>
<th id="S4.T5.3.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_l ltx_border_tt">3D ReasonSeg</th></tr>
