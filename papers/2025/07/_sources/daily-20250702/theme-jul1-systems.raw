      <a href="/search/?searchtype=author&amp;query=Mishin%2C+D">Dmitry Mishin</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Gupta%2C+R+K">Rajesh K. Gupta</a>, 
      
