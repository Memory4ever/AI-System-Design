<th id="S4.T6.6.1.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt">FVD<sub id="S4.T6.6.1.1.2.1" class="ltx_sub"><span id="S4.T6.6.1.1.2.1.1" class="ltx_text ltx_font_italic">10</span></sub> ↓</th>
