<td id="S3.T1.6.1.2.2" class="ltx_td ltx_align_center ltx_border_t">73.4</td>
<td id="S3.T1.6.1.2.3" class="ltx_td ltx_align_center ltx_border_t">52.6</td>
<td id="S3.T1.6.1.2.4" class="ltx_td ltx_align_center ltx_border_t">27.6</td>
<td id="S3.T1.6.1.2.5" class="ltx_td ltx_align_center ltx_border_t">15.8</td>
<td id="S3.T1.6.1.2.6" class="ltx_td ltx_align_center ltx_border_t">15.4</td>
<td id="S3.T1.6.1.2.7" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T1.6.1.2.7.1" class="ltx_text ltx_font_bold">6.9</span></td>
<td id="S3.T1.6.1.2.8" class="ltx_td ltx_align_center ltx_border_t">7.4</td>
<td id="S3.T1.6.1.2.9" class="ltx_td ltx_align_center ltx_border_t">7.5</td></tr>
