<td id="S3.T1.6.1.3.2" class="ltx_td ltx_align_center">502.3</td>
<td id="S3.T1.6.1.3.3" class="ltx_td ltx_align_center">452.0</td>
<td id="S3.T1.6.1.3.4" class="ltx_td ltx_align_center">417.7</td>
<td id="S3.T1.6.1.3.5" class="ltx_td ltx_align_center">122.7</td>
<td id="S3.T1.6.1.3.6" class="ltx_td ltx_align_center">184.0</td>
<td id="S3.T1.6.1.3.7" class="ltx_td ltx_align_center">89.4</td>
<td id="S3.T1.6.1.3.8" class="ltx_td ltx_align_center">90.9</td>
<td id="S3.T1.6.1.3.9" class="ltx_td ltx_align_center"><span id="S3.T1.6.1.3.9.1" class="ltx_text ltx_font_bold">82.8</span></td></tr>
<tr id="S3.T1.6.1.4" class="ltx_tr">
