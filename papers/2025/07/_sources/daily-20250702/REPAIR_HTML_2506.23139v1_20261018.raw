{
  "Channel": {
  "name": "planning-SecurityForce-PM",
  "channelID": "ch-ix-pm-16b727"
  },
  "Message": {
    "User": {
      "userId": "eid_c8ebc4b0",
      "timestamp": "2026-04-28T10:21:00",
