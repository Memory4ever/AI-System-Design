<figure id="A1.T6" class="ltx_table">
<div id="A1.T6.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:82pt;vertical-align:-39.3pt;"><span class="ltx_transformed_inner" style="transform:translate(-83.3pt,19.8pt) scale(0.674332772799067,0.674332772799067) ;">
<table id="A1.T6.2.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="A1.T6.2.1.1" class="ltx_tr">
