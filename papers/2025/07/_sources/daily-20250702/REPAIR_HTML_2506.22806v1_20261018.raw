<tbody id="A2.Ex10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex10.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{h=1}^{H}\left[\|(f_{1}(\mathbf{\tilde{W}}_{v}^{h}\mathbf{E})-f_{1}(\mathbf{W}_{v}^{h}\mathbf{E}))f_{2}(\mathbf{\tilde{W}}_{k}^{h}\mathbf{E})+f_{1}(\mathbf{W}_{v}^{h}\mathbf{E})(f_{2}(\tilde{\mathbf{W}}_{k}^{h}\mathbf{E})-f_{2}(\mathbf{W}_{k}^{h}\mathbf{E}))\|_{2}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>H</mi></munderover></mstyle><mrow><mo>[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>𝐖</mi><mo>~</mo></mover><mi>v</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐖</mi><mi>v</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>𝐖</mi><mo>~</mo></mover><mi>k</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐖</mi><mi>v</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐄</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>𝐖</mi><mo>~</mo></mover><mi>k</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐖</mi><mi>k</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{h=1}^{H}\left[\|(f_{1}(\mathbf{\tilde{W}}_{v}^{h}\mathbf{E})-f_{1}(\mathbf{W}_{v}^{h}\mathbf{E}))f_{2}(\mathbf{\tilde{W}}_{k}^{h}\mathbf{E})+f_{1}(\mathbf{W}_{v}^{h}\mathbf{E})(f_{2}(\tilde{\mathbf{W}}_{k}^{h}\mathbf{E})-f_{2}(\mathbf{W}_{k}^{h}\mathbf{E}))\|_{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex11.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{h=1}^{H}\left[\|f_{2}(\mathbf{\tilde{W}}_{k}^{h}\mathbf{E})\|_{\infty}\|f_{1}(\mathbf{\tilde{W}}_{v}^{h}\mathbf{E})-f_{1}(\mathbf{W}_{v}^{h}\mathbf{E})\|_{2}+\|f_{1}(\mathbf{W}_{v}^{h}\mathbf{E})\|_{2}\|f_{2}(\tilde{\mathbf{W}}_{k}^{h}\mathbf{E})-f_{2}(\mathbf{W}_{k}^{h}\mathbf{E})\|_{2}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>H</mi></munderover></mstyle><mrow><mo>[</mo><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>𝐖</mi><mo>~</mo></mover><mi>k</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>𝐖</mi><mo>~</mo></mover><mi>v</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐖</mi><mi>v</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐖</mi><mi>v</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>𝐖</mi><mo>~</mo></mover><mi>k</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐖</mi><mi>k</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{h=1}^{H}\left[\|f_{2}(\mathbf{\tilde{W}}_{k}^{h}\mathbf{E})\|_{\infty}\|f_{1}(\mathbf{\tilde{W}}_{v}^{h}\mathbf{E})-f_{1}(\mathbf{W}_{v}^{h}\mathbf{E})\|_{2}+\|f_{1}(\mathbf{W}_{v}^{h}\mathbf{E})\|_{2}\|f_{2}(\tilde{\mathbf{W}}_{k}^{h}\mathbf{E})-f_{2}(\mathbf{W}_{k}^{h}\mathbf{E})\|_{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p3.1" class="ltx_p"><span id="A2.p3.1.1" class="ltx_text">We note that <math id="A2.p3.m1" class="ltx_Math" alttext="\|f_{2}(\mathbf{\tilde{W}}_{k}^{h}\mathbf{E})\|_{\infty}\leq 1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>𝐖</mi><mo>~</mo></mover><mi>k</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|f_{2}(\mathbf{\tilde{W}}_{k}^{h}\mathbf{E})\|_{\infty}\leq 1</annotation></semantics></math> because of the maximum value of softmax function is <math id="A2.p3.m2" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> and <math id="A2.p3.m3" class="ltx_Math" alttext="\|f_{1}(\mathbf{W}_{v}^{h}\mathbf{E})\|_{2}\leq L_{\mathbf{W}_{o}^{h}\mathbf{W}_{v}^{h}}||\mathbf{E}||_{2}\leq L_{\mathbf{W}_{o}^{i}\mathbf{W}_{v}^{i}}{M_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐖</mi><mi>v</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><msub><mi>L</mi><mrow><msubsup><mi>𝐖</mi><mi>o</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐖</mi><mi>v</mi><mi>h</mi></msubsup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝐄</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><mrow><msub><mi>L</mi><mrow><msubsup><mi>𝐖</mi><mi>o</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐖</mi><mi>v</mi><mi>i</mi></msubsup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\|f_{1}(\mathbf{W}_{v}^{h}\mathbf{E})\|_{2}\leq L_{\mathbf{W}_{o}^{h}\mathbf{W}_{v}^{h}}||\mathbf{E}||_{2}\leq L_{\mathbf{W}_{o}^{i}\mathbf{W}_{v}^{i}}{M_{1}}</annotation></semantics></math>.
We can also derive that</span></p>
<table id="A2.EGx19" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex12.m1" class="ltx_Math" alttext="\displaystyle\|f_{1}(\tilde{\mathbf{W}}_{v}^{h}\mathbf{E})-f_{1}(\mathbf{W}_{v}^{h}\mathbf{E})\|_{2}\leq L_{\mathbf{W}_{o}^{h}}\|\Delta\mathbf{W}_{v}^{h}\mathbf{E}\|_{F}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>𝐖</mi><mo>~</mo></mover><mi>v</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐖</mi><mi>v</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><msub><mi>L</mi><msubsup><mi>𝐖</mi><mi>o</mi><mi>h</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐖</mi><mi>v</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐄</mi></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\|f_{1}(\tilde{\mathbf{W}}_{v}^{h}\mathbf{E})-f_{1}(\mathbf{W}_{v}^{h}\mathbf{E})\|_{2}\leq L_{\mathbf{W}_{o}^{h}}\|\Delta\mathbf{W}_{v}^{h}\mathbf{E}\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p3.2" class="ltx_p"><span id="A2.p3.2.1" class="ltx_text">and</span></p>
<table id="A2.EGx20" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E2.m1" class="ltx_Math" alttext="\displaystyle\|f_{2}(\mathbf{\tilde{W}}_{k}^{h}\mathbf{E})-f_{2}(\mathbf{W}_{k}^{h}\mathbf{E})\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>𝐖</mi><mo>~</mo></mover><mi>k</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐖</mi><mi>k</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\|f_{2}(\mathbf{\tilde{W}}_{k}^{h}\mathbf{E})-f_{2}(\mathbf{W}_{k}^{h}\mathbf{E})\|_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E2.m2" class="ltx_Math" alttext="\displaystyle=\|\sigma\left(\frac{(\mathbf{\tilde{W}}_{k}^{h}\mathbf{E})^{T}\mathbf{W}_{q}^{h}\mathbf{z}}{\sqrt{m}}\right)-\sigma\left(\frac{(\mathbf{W}_{k}^{h}\mathbf{E})^{T}\mathbf{W}_{q}^{h}\mathbf{z}}{\sqrt{m}}\right)\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>𝐖</mi><mo>~</mo></mover><mi>k</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐄</mi></mrow><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐖</mi><mi>q</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐳</mi></mrow><msqrt><mi>m</mi></msqrt></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐖</mi><mi>k</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐄</mi></mrow><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐖</mi><mi>q</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐳</mi></mrow><msqrt><mi>m</mi></msqrt></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\|\sigma\left(\frac{(\mathbf{\tilde{W}}_{k}^{h}\mathbf{E})^{T}\mathbf{W}_{q}^{h}\mathbf{z}}{\sqrt{m}}\right)-\sigma\left(\frac{(\mathbf{W}_{k}^{h}\mathbf{E})^{T}\mathbf{W}_{q}^{h}\mathbf{z}}{\sqrt{m}}\right)\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(B.2)</span></td></tr></tbody>
<tbody id="A2.Ex13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex13.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{\sqrt{m-1}}{m\sqrt{m}}\|(\mathbf{\tilde{W}}_{k}^{h}\mathbf{E})^{T}\mathbf{W}_{q}^{h}\mathbf{z}-(\mathbf{W}_{k}^{h}\mathbf{E})^{T}\mathbf{W}_{q}^{i}\mathbf{z}\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><msqrt><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msqrt><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>m</mi></msqrt></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>𝐖</mi><mo>~</mo></mover><mi>k</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐄</mi></mrow><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐖</mi><mi>q</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐳</mi></mrow><mo>−</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐖</mi><mi>k</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐄</mi></mrow><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐖</mi><mi>q</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐳</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\sqrt{m-1}}{m\sqrt{m}}\|(\mathbf{\tilde{W}}_{k}^{h}\mathbf{E})^{T}\mathbf{W}_{q}^{h}\mathbf{z}-(\mathbf{W}_{k}^{h}\mathbf{E})^{T}\mathbf{W}_{q}^{i}\mathbf{z}\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex14.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{\sqrt{m-1}}{m\sqrt{m}}L_{\mathbf{W}_{q}^{h}}\|\mathbf{z}\|_{\infty}\|\mathbf{\tilde{W}}_{k}^{h}\mathbf{E}-\mathbf{W}_{k}^{h}\mathbf{E}\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><msqrt><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msqrt><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>m</mi></msqrt></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><msubsup><mi>𝐖</mi><mi>q</mi><mi>h</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝐳</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msubsup><mover accent="true"><mi>𝐖</mi><mo>~</mo></mover><mi>k</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐄</mi></mrow><mo>−</mo><mrow><msubsup><mi>𝐖</mi><mi>k</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐄</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\sqrt{m-1}}{m\sqrt{m}}L_{\mathbf{W}_{q}^{h}}\|\mathbf{z}\|_{\infty}\|\mathbf{\tilde{W}}_{k}^{h}\mathbf{E}-\mathbf{W}_{k}^{h}\mathbf{E}\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex15.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{M_{2}\sqrt{m-1}}{m\sqrt{m}}L_{\mathbf{W}_{q}^{h}}\|\Delta\mathbf{W}_{k}^{h}\mathbf{E}\|_{F}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>M</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msqrt></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>m</mi></msqrt></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><msubsup><mi>𝐖</mi><mi>q</mi><mi>h</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐖</mi><mi>k</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐄</mi></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{M_{2}\sqrt{m-1}}{m\sqrt{m}}L_{\mathbf{W}_{q}^{h}}\|\Delta\mathbf{W}_{k}^{h}\mathbf{E}\|_{F},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p3.3" class="ltx_p"><span id="A2.p3.3.1" class="ltx_text">where we use the fact that Lipschitz constant of the softmax function is <math id="A2.p3.m4" class="ltx_Math" alttext="\frac{\sqrt{m-1}}{m}" display="inline" intent=":literal"><semantics><mfrac><msqrt><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msqrt><mi>m</mi></mfrac><annotation encoding="application/x-tex">\frac{\sqrt{m-1}}{m}</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib58" title="" class="ltx_ref">Sener &amp; Savarese, 2018</a>)</cite> for the first inequality, and the spectral norm is equal to or smaller than the Frobenius norm for the last inequality in Equation (<a href="#A2.E2" title="In Proof. ‣ Appendix B Proofs of Theorems ‣ Concept Pinpoint Eraser for Text-to-image Diffusion Models via Residual Attention Gate" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a>) .
Finally we can conclude that the upper bound of the output of an attention layer due to the difference of key and value weights is:</span></p>
<table id="A2.EGx21" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex16.m1" class="ltx_math_unparsed" alttext="\displaystyle\|\tau" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><mi>τ</mi></mrow><annotation encoding="application/x-tex">\displaystyle\|\tau</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex16.m2" class="ltx_math_unparsed" alttext="\displaystyle(\mathbf{z},\mathbf{E};\tilde{\mathbf{W}}_{k}^{h},\tilde{\mathbf{W}}_{v}^{h})-\tau(\mathbf{z},\mathbf{E};\mathbf{W}_{k}^{h},\mathbf{W}_{v}^{h})\|_{2}\leq\sum_{h=1}^{H}\left[C_{1}^{h}\|\Delta\mathbf{W}_{k}^{h}\mathbf{E}\|_{F}+C_{2}^{h}\|\Delta\mathbf{W}_{v}^{h}\mathbf{E}\|_{F}\right]," display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo>,</mo><mi>𝐄</mi><mo>;</mo><msubsup><mover accent="true"><mi>𝐖</mi><mo>~</mo></mover><mi>k</mi><mi>h</mi></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>𝐖</mi><mo>~</mo></mover><mi>v</mi><mi>h</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>τ</mi><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo>,</mo><mi>𝐄</mi><mo>;</mo><msubsup><mi>𝐖</mi><mi>k</mi><mi>h</mi></msubsup><mo>,</mo><msubsup><mi>𝐖</mi><mi>v</mi><mi>h</mi></msubsup><mo stretchy="false">)</mo></mrow><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em">≤</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>H</mi></munderover></mstyle><mrow><mo>[</mo><msubsup><mi>C</mi><mn>1</mn><mi>h</mi></msubsup><mo lspace="0em" rspace="0.167em">∥</mo><mi mathvariant="normal">Δ</mi><msubsup><mi>𝐖</mi><mi>k</mi><mi>h</mi></msubsup><mi>𝐄</mi><msub><mo lspace="0em" rspace="0em">∥</mo><mi>F</mi></msub><mo lspace="0em">+</mo><msubsup><mi>C</mi><mn>2</mn><mi>h</mi></msubsup><mo lspace="0em" rspace="0.167em">∥</mo><mi mathvariant="normal">Δ</mi><msubsup><mi>𝐖</mi><mi>v</mi><mi>h</mi></msubsup><mi>𝐄</mi><msub><mo lspace="0em" rspace="0.167em">∥</mo><mi>F</mi></msub><mo>]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle(\mathbf{z},\mathbf{E};\tilde{\mathbf{W}}_{k}^{h},\tilde{\mathbf{W}}_{v}^{h})-\tau(\mathbf{z},\mathbf{E};\mathbf{W}_{k}^{h},\mathbf{W}_{v}^{h})\|_{2}\leq\sum_{h=1}^{H}\left[C_{1}^{h}\|\Delta\mathbf{W}_{k}^{h}\mathbf{E}\|_{F}+C_{2}^{h}\|\Delta\mathbf{W}_{v}^{h}\mathbf{E}\|_{F}\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p3.4" class="ltx_p"><span id="A2.p3.4.1" class="ltx_text">where <math id="A2.p3.m5" class="ltx_Math" alttext="C_{1}^{h}=\frac{{M_{1}}M_{2}\sqrt{m-1}}{m\sqrt{m}}L_{\mathbf{W}_{o}^{h}\mathbf{W}_{v}^{h}}L_{\mathbf{W}_{q}^{h}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>C</mi><mn>1</mn><mi>h</mi></msubsup><mo>=</mo><mrow><mfrac><mrow><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msqrt></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>m</mi></msqrt></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mrow><msubsup><mi>𝐖</mi><mi>o</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐖</mi><mi>v</mi><mi>h</mi></msubsup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><msubsup><mi>𝐖</mi><mi>q</mi><mi>h</mi></msubsup></msub></mrow></mrow><annotation encoding="application/x-tex">C_{1}^{h}=\frac{{M_{1}}M_{2}\sqrt{m-1}}{m\sqrt{m}}L_{\mathbf{W}_{o}^{h}\mathbf{W}_{v}^{h}}L_{\mathbf{W}_{q}^{h}}</annotation></semantics></math> and <math id="A2.p3.m6" class="ltx_Math" alttext="C_{2}^{h}=L_{\mathbf{W}_{o}^{h}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>C</mi><mn>2</mn><mi>h</mi></msubsup><mo>=</mo><msub><mi>L</mi><msubsup><mi>𝐖</mi><mi>o</mi><mi>h</mi></msubsup></msub></mrow><annotation encoding="application/x-tex">C_{2}^{h}=L_{\mathbf{W}_{o}^{h}}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="Thmtheorem2a" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem2a.2" class="ltx_text ltx_font_bold">Theorem 2</span></span><span id="Thmtheorem2a.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem2a.p1" class="ltx_para ltx_noindent">
<p id="Thmtheorem2a.p1.1" class="ltx_p"><span id="Thmtheorem2a.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmtheorem2a.p1.m1" class="ltx_Math" alttext="\mathbf{E}_{\textnormal{rem}}=[\mathbf{e}_{1},\cdots,\mathbf{e}_{i},\cdots,\mathbf{e}_{m}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐄</mi><mtext>rem</mtext></msub><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝐞</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>𝐞</mi><mi>i</mi></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>𝐞</mi><mi>m</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{E}_{\textnormal{rem}}=[\mathbf{e}_{1},\cdots,\mathbf{e}_{i},\cdots,\mathbf{e}_{m}]</annotation></semantics></math> where <math id="Thmtheorem2a.p1.m2" class="ltx_Math" alttext="\mathbf{e}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝐞</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathbf{e}_{i}</annotation></semantics></math> is a text embedding. Suppose that the embeddings for remaining concepts follow a mixed Gaussian distribution, that is, <math id="Thmtheorem2a.p1.m3" class="ltx_Math" alttext="p(\mathbf{e}_{i})=\sum_{r=1}^{R}\pi_{r}\mathcal{N}(\mathbf{e}_{i};\bm{\mu}_{r}^{i},\sigma_{r}^{2}\mathbf{I})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>R</mi></msubsup><mrow><msub><mi>π</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>𝛍</mi><mi>r</mi><mi>i</mi></msubsup><mo>,</mo><mrow><msubsup><mi>σ</mi><mi>r</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐈</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">p(\mathbf{e}_{i})=\sum_{r=1}^{R}\pi_{r}\mathcal{N}(\mathbf{e}_{i};\bm{\mu}_{r}^{i},\sigma_{r}^{2}\mathbf{I})</annotation></semantics></math> and <math id="Thmtheorem2a.p1.m4" class="ltx_Math" alttext="\sum_{r=1}^{R}\pi_{r}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>R</mi></msubsup><msub><mi>π</mi><mi>r</mi></msub></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\sum_{r=1}^{R}\pi_{r}=1</annotation></semantics></math>. With
<math id="Thmtheorem2a.p1.m5" class="ltx_Math" alttext="\bm{\mu}_{r}=[\bm{\mu}_{r}^{1},\bm{\mu}_{r}^{2},\cdots,\bm{\mu}_{r}^{m}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝛍</mi><mi>r</mi></msub><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝛍</mi><mi>r</mi><mn>1</mn></msubsup><mo>,</mo><msubsup><mi>𝛍</mi><mi>r</mi><mn>2</mn></msubsup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msubsup><mi>𝛍</mi><mi>r</mi><mi>m</mi></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{\mu}_{r}=[\bm{\mu}_{r}^{1},\bm{\mu}_{r}^{2},\cdots,\bm{\mu}_{r}^{m}]</annotation></semantics></math>, we can show that:</span></p>
</div>
<div id="Thmtheorem2a.p2" class="ltx_para">
<table id="A2.EGx22" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex17.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\mathbf{\mathbf{E}_{\textnormal{rem}}}}\left[\|\Delta\mathbf{W}\mathbf{E}_{\textnormal{rem}}\|_{F}^{2}\right]=C_{3}\|\Delta\mathbf{W}\|_{F}^{2}+\sum_{r=1}^{R}\pi_{r}\|\Delta\mathbf{W}\bm{\mu}_{r}\|_{F}^{2},\quad C_{3}=\sum_{r=1}^{R}\pi_{r}\sigma^{2}_{r}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>𝔼</mi><msub><mi>𝐄</mi><mtext>rem</mtext></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐖𝐄</mi><mtext>rem</mtext></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐖</mi></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>R</mi></munderover></mstyle><mrow><msub><mi>π</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐖</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>r</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup></mrow></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>C</mi><mn>3</mn></msub><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>R</mi></munderover></mstyle><mrow><msub><mi>π</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>r</mi><mn>2</mn></msubsup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\mathbf{\mathbf{E}_{\textnormal{rem}}}}\left[\|\Delta\mathbf{W}\mathbf{E}_{\textnormal{rem}}\|_{F}^{2}\right]=C_{3}\|\Delta\mathbf{W}\|_{F}^{2}+\sum_{r=1}^{R}\pi_{r}\|\Delta\mathbf{W}\bm{\mu}_{r}\|_{F}^{2},\quad C_{3}=\sum_{r=1}^{R}\pi_{r}\sigma^{2}_{r}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.p4" class="ltx_para ltx_noindent">
<p id="A2.p4.1" class="ltx_p"><span id="A2.p4.1.1" class="ltx_text">Assume that <math id="A2.p4.m1" class="ltx_Math" alttext="\mathbf{e}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝐞</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathbf{e}_{i}</annotation></semantics></math> is sampled from a mixed Gaussian distribution. Then,</span></p>
<table id="A2.EGx23" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E3.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\mathbf{E}_{\text{rem}}}\left[\|\Delta\mathbf{W}\mathbf{E}_{\text{rem}}\|_{F}^{2}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><msub><mi>𝐄</mi><mtext>rem</mtext></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐖𝐄</mi><mtext>rem</mtext></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\mathbf{E}_{\text{rem}}}\left[\|\Delta\mathbf{W}\mathbf{E}_{\text{rem}}\|_{F}^{2}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E3.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{\mathbf{E}_{\text{rem}}}\left[\|\Delta\mathbf{W}[\mathbf{e}_{1},\mathbf{e}_{2},\cdots,\mathbf{e}_{m}]\|_{F}^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><msub><mi>𝐄</mi><mtext>rem</mtext></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐖</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝐞</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝐞</mi><mn>2</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>𝐞</mi><mi>m</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\mathbf{E}_{\text{rem}}}\left[\|\Delta\mathbf{W}[\mathbf{e}_{1},\mathbf{e}_{2},\cdots,\mathbf{e}_{m}]\|_{F}^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(B.3)</span></td></tr></tbody>
<tbody id="A2.Ex18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex18.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{\mathbf{E}_{\text{rem}}}\left[\|\left[\Delta\mathbf{W}\mathbf{e}_{1},\Delta\mathbf{W}\mathbf{e}_{2},\cdots,\Delta\mathbf{W}\mathbf{e}_{m}\right]\|_{F}^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><msub><mi>𝐄</mi><mtext>rem</mtext></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mo>[</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐖𝐞</mi><mn>1</mn></msub></mrow><mo>,</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐖𝐞</mi><mn>2</mn></msub></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐖𝐞</mi><mi>m</mi></msub></mrow></mrow><mo>]</mo></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\mathbf{E}_{\text{rem}}}\left[\|\left[\Delta\mathbf{W}\mathbf{e}_{1},\Delta\mathbf{W}\mathbf{e}_{2},\cdots,\Delta\mathbf{W}\mathbf{e}_{m}\right]\|_{F}^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex19.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{\mathbf{E}_{\text{rem}}}\left[\sum_{i=1}^{m}\|\Delta\mathbf{W}\mathbf{e}_{i}\|_{2}^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><msub><mi>𝐄</mi><mtext>rem</mtext></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐖𝐞</mi><mi>i</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\mathbf{E}_{\text{rem}}}\left[\sum_{i=1}^{m}\|\Delta\mathbf{W}\mathbf{e}_{i}\|_{2}^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex20.m1" class="ltx_Math" alttext="\displaystyle=\sum_{i=1}^{m}\mathbb{E}_{\mathbf{e}_{i}}\left[\mathbf{e}_{i}^{T}\Delta\mathbf{W}^{T}\Delta\mathbf{W}\mathbf{e}_{i}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msub><mi>𝔼</mi><msub><mi>𝐞</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝐞</mi><mi>i</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐖</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐖𝐞</mi><mi>i</mi></msub></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=1}^{m}\mathbb{E}_{\mathbf{e}_{i}}\left[\mathbf{e}_{i}^{T}\Delta\mathbf{W}^{T}\Delta\mathbf{W}\mathbf{e}_{i}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E4.m1" class="ltx_Math" alttext="\displaystyle=\sum_{i=1}^{m}\pi_{r}\sum_{r=1}^{R}\mathbb{E}_{\mathbf{e}_{i}\sim\mathcal{N}(\bm{\mu}_{r}^{i},\sigma_{r}^{2}\mathbf{I})}\left[\mathbf{e}_{i}^{T}\Delta\mathbf{W}^{T}\Delta\mathbf{W}\mathbf{e}_{i}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msub><mi>π</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>R</mi></munderover></mstyle><mrow><msub><mi>𝔼</mi><mrow><msub><mi>𝐞</mi><mi>i</mi></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>r</mi><mi>i</mi></msubsup><mo>,</mo><mrow><msubsup><mi>σ</mi><mi>r</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐈</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝐞</mi><mi>i</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐖</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐖𝐞</mi><mi>i</mi></msub></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=1}^{m}\pi_{r}\sum_{r=1}^{R}\mathbb{E}_{\mathbf{e}_{i}\sim\mathcal{N}(\bm{\mu}_{r}^{i},\sigma_{r}^{2}\mathbf{I})}\left[\mathbf{e}_{i}^{T}\Delta\mathbf{W}^{T}\Delta\mathbf{W}\mathbf{e}_{i}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(B.4)</span></td></tr></tbody>
</table>
</div>
<div id="A2.p5" class="ltx_para">
<p id="A2.p5.1" class="ltx_p"><span id="A2.p5.1.1" class="ltx_text">It is known that the expectation of quadratic form <math id="A2.p5.m1" class="ltx_Math" alttext="\mathbf{e}_{i}^{T}\mathbf{B}\mathbf{e}_{i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐞</mi><mi>i</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐁𝐞</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\mathbf{e}_{i}^{T}\mathbf{B}\mathbf{e}_{i}</annotation></semantics></math> for a symmetric matrix <math id="A2.p5.m2" class="ltx_Math" alttext="\mathbf{B}" display="inline" intent=":literal"><semantics><mi>𝐁</mi><annotation encoding="application/x-tex">\mathbf{B}</annotation></semantics></math> is given <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib42" title="" class="ltx_ref">Mathai &amp; Provost, 1992</a>)</cite> by:</span></p>
<table id="A2.EGx24" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E5.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\mathbf{e}_{i}\sim\mathcal{N}(\bm{\mu}_{r}^{i},\sigma_{r}^{2}\mathbf{I})}\left[\mathbf{e}_{i}^{T}\mathbf{B}\mathbf{e}_{i}\right]=\sigma_{r}^{2}\text{tr}(\mathbf{B})+(\bm{\mu}_{r}^{i})^{T}\mathbf{B}\bm{\mu}_{r}^{i}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mrow><msub><mi>𝐞</mi><mi>i</mi></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>r</mi><mi>i</mi></msubsup><mo>,</mo><mrow><msubsup><mi>σ</mi><mi>r</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐈</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝐞</mi><mi>i</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐁𝐞</mi><mi>i</mi></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><msubsup><mi>σ</mi><mi>r</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mtext>tr</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐁</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>r</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝝁</mi><mi>r</mi><mi>i</mi></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\mathbf{e}_{i}\sim\mathcal{N}(\bm{\mu}_{r}^{i},\sigma_{r}^{2}\mathbf{I})}\left[\mathbf{e}_{i}^{T}\mathbf{B}\mathbf{e}_{i}\right]=\sigma_{r}^{2}\text{tr}(\mathbf{B})+(\bm{\mu}_{r}^{i})^{T}\mathbf{B}\bm{\mu}_{r}^{i}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(B.5)</span></td></tr></tbody>
</table>
<p id="A2.p5.2" class="ltx_p"><span id="A2.p5.2.1" class="ltx_text">Because of the assumption of mixture Gaussian model, we can easily see that from Equation (<a href="#A2.E4" title="In Proof. ‣ Appendix B Proofs of Theorems ‣ Concept Pinpoint Eraser for Text-to-image Diffusion Models via Residual Attention Gate" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.4</span></a>):</span></p>
<table id="A2.EGx25" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E6.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\mathbf{\mathbf{E}}}\left[\mathbf{e}_{i}^{T}\Delta\mathbf{W}^{T}\Delta\mathbf{W}\mathbf{e}_{i}\right]=\text{tr}(\Delta\mathbf{W}^{T}\Delta\mathbf{W})\sum_{r=1}^{R}\pi_{r}\sigma^{2}_{r}+\sum_{r=1}^{R}\pi_{r}(\bm{\mu}_{r}^{i})^{T}\Delta\mathbf{W}^{T}\Delta\mathbf{W}\bm{\mu}_{r}^{i}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mi>𝐄</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝐞</mi><mi>i</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐖</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐖𝐞</mi><mi>i</mi></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mtext>tr</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐖</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐖</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>R</mi></munderover></mstyle><mrow><msub><mi>π</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>r</mi><mn>2</mn></msubsup></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>R</mi></munderover></mstyle><mrow><msub><mi>π</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>r</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐖</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐖</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝝁</mi><mi>r</mi><mi>i</mi></msubsup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\mathbf{\mathbf{E}}}\left[\mathbf{e}_{i}^{T}\Delta\mathbf{W}^{T}\Delta\mathbf{W}\mathbf{e}_{i}\right]=\text{tr}(\Delta\mathbf{W}^{T}\Delta\mathbf{W})\sum_{r=1}^{R}\pi_{r}\sigma^{2}_{r}+\sum_{r=1}^{R}\pi_{r}(\bm{\mu}_{r}^{i})^{T}\Delta\mathbf{W}^{T}\Delta\mathbf{W}\bm{\mu}_{r}^{i}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(B.6)</span></td></tr></tbody>
</table>
<p id="A2.p5.3" class="ltx_p"><span id="A2.p5.3.1" class="ltx_text">By substituting Equation (<a href="#A2.E6" title="In Proof. ‣ Appendix B Proofs of Theorems ‣ Concept Pinpoint Eraser for Text-to-image Diffusion Models via Residual Attention Gate" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.6</span></a>) for Equation (<a href="#A2.E4" title="In Proof. ‣ Appendix B Proofs of Theorems ‣ Concept Pinpoint Eraser for Text-to-image Diffusion Models via Residual Attention Gate" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.4</span></a>), it is also straightforward that:</span></p>
<table id="A2.EGx26" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex21.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\mathbf{E}_{\text{rem}}}\left[\|\Delta\mathbf{W}\mathbf{E}_{\text{rem}}\|_{F}^{2}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><msub><mi>𝐄</mi><mtext>rem</mtext></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐖𝐄</mi><mtext>rem</mtext></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\mathbf{E}_{\text{rem}}}\left[\|\Delta\mathbf{W}\mathbf{E}_{\text{rem}}\|_{F}^{2}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex21.m2" class="ltx_Math" alttext="\displaystyle=\sum_{i=1}^{m}\mathbb{E}_{\mathbf{E}_{\text{rem}}}\left[\mathbf{e}_{i}^{T}\Delta\mathbf{W}^{T}\Delta\mathbf{W}\mathbf{e}_{i}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msub><mi>𝔼</mi><msub><mi>𝐄</mi><mtext>rem</mtext></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝐞</mi><mi>i</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐖</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐖𝐞</mi><mi>i</mi></msub></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=1}^{m}\mathbb{E}_{\mathbf{E}_{\text{rem}}}\left[\mathbf{e}_{i}^{T}\Delta\mathbf{W}^{T}\Delta\mathbf{W}\mathbf{e}_{i}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex22.m1" class="ltx_Math" alttext="\displaystyle=\text{tr}(\Delta\mathbf{W}^{T}\Delta\mathbf{W})\sum_{r=1}^{R}\pi_{r}\sigma^{2}_{r}+\sum_{r=1}^{R}\pi_{r}\sum_{i=1}^{m}(\bm{\mu}_{r}^{i})^{T}\Delta\mathbf{W}^{T}\Delta\mathbf{W}\bm{\mu}_{r}^{i}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mtext>tr</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐖</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐖</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>R</mi></munderover></mstyle><mrow><msub><mi>π</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>r</mi><mn>2</mn></msubsup></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>R</mi></munderover></mstyle><mrow><msub><mi>π</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>r</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐖</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐖</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝝁</mi><mi>r</mi><mi>i</mi></msubsup></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\text{tr}(\Delta\mathbf{W}^{T}\Delta\mathbf{W})\sum_{r=1}^{R}\pi_{r}\sigma^{2}_{r}+\sum_{r=1}^{R}\pi_{r}\sum_{i=1}^{m}(\bm{\mu}_{r}^{i})^{T}\Delta\mathbf{W}^{T}\Delta\mathbf{W}\bm{\mu}_{r}^{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex23.m1" class="ltx_Math" alttext="\displaystyle=C_{3}\|\Delta\mathbf{W}\|_{F}^{2}+\sum_{r=1}^{R}\pi_{r}\|\Delta\mathbf{W}\bm{\mu}_{r}\|_{F}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐖</mi></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>R</mi></munderover></mstyle><mrow><msub><mi>π</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐖</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>r</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=C_{3}\|\Delta\mathbf{W}\|_{F}^{2}+\sum_{r=1}^{R}\pi_{r}\|\Delta\mathbf{W}\bm{\mu}_{r}\|_{F}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p5.4" class="ltx_p"><span id="A2.p5.4.1" class="ltx_text">where <math id="A2.p5.m3" class="ltx_Math" alttext="C_{3}=m\sum_{r=1}^{R}\pi_{r}\sigma_{r}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>3</mn></msub><mo>=</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>R</mi></msubsup><mrow><msub><mi>π</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>r</mi><mn>2</mn></msubsup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">C_{3}=m\sum_{r=1}^{R}\pi_{r}\sigma_{r}^{2}</annotation></semantics></math> and <math id="A2.p5.m4" class="ltx_Math" alttext="\text{tr}(\Delta\mathbf{W}^{T}\Delta\mathbf{W})" display="inline" intent=":literal"><semantics><mrow><mtext>tr</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐖</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐖</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{tr}(\Delta\mathbf{W}^{T}\Delta\mathbf{W})</annotation></semantics></math> is same as the Frobenius norm.
∎</span></p>
</div>
</div>
<div id="Thmcorollary1a" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmcorollary1a.2" class="ltx_text ltx_font_bold">Corollary 1</span></span><span id="Thmcorollary1a.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmcorollary1a.p1" class="ltx_para">
<p id="Thmcorollary1a.p1.1" class="ltx_p"><span id="Thmcorollary1a.p1.1.1" class="ltx_text ltx_font_italic">Suppose we can detect the mode from which <math id="Thmcorollary1a.p1.m1" class="ltx_Math" alttext="\mathbf{E}" display="inline" intent=":literal"><semantics><mi>𝐄</mi><annotation encoding="application/x-tex">\mathbf{E}</annotation></semantics></math> is sampled.
Let <math id="Thmcorollary1a.p1.m2" class="ltx_Math" alttext="f(\mathbf{E})=\mathbf{V}_{r}\in\mathbb{R}^{m\times m}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐄</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>𝐕</mi><mi>r</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>m</mi></mrow></msup></mrow><annotation encoding="application/x-tex">f(\mathbf{E})=\mathbf{V}_{r}\in\mathbb{R}^{m\times m}</annotation></semantics></math> be an embedding-dependent projection adaptive to the mode of samples.
If we use <math id="Thmcorollary1a.p1.m3" class="ltx_Math" alttext="\Delta\mathbf{W}\mathbf{E}f(\mathbf{E})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐖𝐄</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐄</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta\mathbf{W}\mathbf{E}f(\mathbf{E})</annotation></semantics></math> instead of <math id="Thmcorollary1a.p1.m4" class="ltx_Math" alttext="\Delta\mathbf{W}\mathbf{E}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐖𝐄</mi></mrow><annotation encoding="application/x-tex">\Delta\mathbf{W}\mathbf{E}</annotation></semantics></math>,
Equation (<a href="#S3.E3" title="In Theorem 2. ‣ 3.1 Only Fine-tuning CA Layers May Not Preserve Remaining Concepts ‣ 3 Concept Pinpoint Eraser via Residual Attention Gate ‣ Concept Pinpoint Eraser for Text-to-image Diffusion Models via Residual Attention Gate" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>) for <math id="Thmcorollary1a.p1.m5" class="ltx_Math" alttext="\mathbf{E}_{\textnormal{rem}}" display="inline" intent=":literal"><semantics><msub><mi>𝐄</mi><mtext>rem</mtext></msub><annotation encoding="application/x-tex">\mathbf{E}_{\textnormal{rem}}</annotation></semantics></math> is modified to:</span></p>
<table id="A2.EGx27" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E7.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\mathbf{\mathbf{E}_{\textnormal{rem}}}}\left[\|\Delta\mathbf{W}\mathbf{E}_{\textnormal{rem}}f(\mathbf{E}_{\textnormal{rem}})\|_{F}^{2}\right]=\|\Delta\mathbf{W}\|_{F}^{2}\sum_{r=1}^{R}\pi_{r}\sigma^{2}_{r}\|\mathbf{V}_{r}\|_{F}^{2}+\sum_{r=1}^{R}\pi_{r}\|\Delta\mathbf{W}\bm{\mu}_{r}\mathbf{V}_{r}\|_{F}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><msub><mi>𝐄</mi><mtext>rem</mtext></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐖𝐄</mi><mtext>rem</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐄</mi><mtext>rem</mtext></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐖</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><mrow><mstyle displaystyle="true"><mmultiscripts><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>R</mi></munderover><mprescripts></mprescripts><mi>F</mi><mn>2</mn></mmultiscripts></mstyle><mo>⁡</mo><msub><mi>π</mi><mi>r</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>r</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐕</mi><mi>r</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>R</mi></munderover></mstyle><mrow><msub><mi>π</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐖</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐕</mi><mi>r</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\mathbf{\mathbf{E}_{\textnormal{rem}}}}\left[\|\Delta\mathbf{W}\mathbf{E}_{\textnormal{rem}}f(\mathbf{E}_{\textnormal{rem}})\|_{F}^{2}\right]=\|\Delta\mathbf{W}\|_{F}^{2}\sum_{r=1}^{R}\pi_{r}\sigma^{2}_{r}\|\mathbf{V}_{r}\|_{F}^{2}+\sum_{r=1}^{R}\pi_{r}\|\Delta\mathbf{W}\bm{\mu}_{r}\mathbf{V}_{r}\|_{F}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(B.7)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.p6" class="ltx_para">
<p id="A2.p6.1" class="ltx_p"><span id="A2.p6.1.1" class="ltx_text">With the assumption in Theorem. 2 and simliar derivation from Equation (<a href="#A2.E3" title="In Proof. ‣ Appendix B Proofs of Theorems ‣ Concept Pinpoint Eraser for Text-to-image Diffusion Models via Residual Attention Gate" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.3</span></a>)-(<a href="#A2.E4" title="In Proof. ‣ Appendix B Proofs of Theorems ‣ Concept Pinpoint Eraser for Text-to-image Diffusion Models via Residual Attention Gate" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.4</span></a>),</span></p>
<table id="A2.EGx28" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex24.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\mathbf{E}_{\text{rem}}}\left[\|\Delta\mathbf{W}\mathbf{E}_{\text{rem}}f(\mathbf{E}_{\text{rem}})\|_{F}^{2}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><msub><mi>𝐄</mi><mtext>rem</mtext></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐖𝐄</mi><mtext>rem</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐄</mi><mtext>rem</mtext></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\mathbf{E}_{\text{rem}}}\left[\|\Delta\mathbf{W}\mathbf{E}_{\text{rem}}f(\mathbf{E}_{\text{rem}})\|_{F}^{2}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex24.m2" class="ltx_Math" alttext="\displaystyle=\sum_{r=1}^{R}\pi_{r}\sum_{i=1}^{m}\mathbb{E}_{\mathbf{E}_{\text{rem}}\sim\mathcal{N}(\bm{\mu}_{r},\sigma_{r}^{2}I)}\left[(\mathbf{E}_{\text{rem}}\mathbf{V}_{r}^{i})^{T}\Delta\mathbf{W}^{T}\Delta\mathbf{W}\mathbf{E}_{\text{rem}}\mathbf{V}_{r}^{i}\right]," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>R</mi></munderover></mstyle><mrow><msub><mi>π</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msub><mi>𝔼</mi><mrow><msub><mi>𝐄</mi><mtext>rem</mtext></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝁</mi><mi>r</mi></msub><mo>,</mo><mrow><msubsup><mi>σ</mi><mi>r</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐄</mi><mtext>rem</mtext></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐕</mi><mi>r</mi><mi>i</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐖</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐖𝐄</mi><mtext>rem</mtext></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐕</mi><mi>r</mi><mi>i</mi></msubsup></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{r=1}^{R}\pi_{r}\sum_{i=1}^{m}\mathbb{E}_{\mathbf{E}_{\text{rem}}\sim\mathcal{N}(\bm{\mu}_{r},\sigma_{r}^{2}I)}\left[(\mathbf{E}_{\text{rem}}\mathbf{V}_{r}^{i})^{T}\Delta\mathbf{W}^{T}\Delta\mathbf{W}\mathbf{E}_{\text{rem}}\mathbf{V}_{r}^{i}\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p6.2" class="ltx_p"><span id="A2.p6.2.1" class="ltx_text">where <math id="A2.p6.m1" class="ltx_Math" alttext="\mathbf{V}_{r}^{i}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐕</mi><mi>r</mi><mi>i</mi></msubsup><annotation encoding="application/x-tex">\mathbf{V}_{r}^{i}</annotation></semantics></math> is the <math id="A2.p6.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th column of <math id="A2.p6.m3" class="ltx_Math" alttext="\mathbf{V}_{r}" display="inline" intent=":literal"><semantics><msub><mi>𝐕</mi><mi>r</mi></msub><annotation encoding="application/x-tex">\mathbf{V}_{r}</annotation></semantics></math>.
Since the distribution of <math id="A2.p6.m4" class="ltx_Math" alttext="\mathbf{E}_{\text{rem}}\mathbf{V}_{r}^{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐄</mi><mtext>rem</mtext></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐕</mi><mi>r</mi><mi>i</mi></msubsup></mrow><annotation encoding="application/x-tex">\mathbf{E}_{\text{rem}}\mathbf{V}_{r}^{i}</annotation></semantics></math> is <math id="A2.p6.m5" class="ltx_Math" alttext="\mathcal{N}(\bm{\mu}_{r}V_{r}^{i},\sigma_{r}^{2}\|\mathbf{V}_{r}^{i}\|_{2}^{2}I)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝝁</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>V</mi><mi>r</mi><mi>i</mi></msubsup></mrow><mo>,</mo><mrow><msubsup><mi>σ</mi><mi>r</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msubsup><mi>𝐕</mi><mi>r</mi><mi>i</mi></msubsup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}(\bm{\mu}_{r}V_{r}^{i},\sigma_{r}^{2}\|\mathbf{V}_{r}^{i}\|_{2}^{2}I)</annotation></semantics></math>,</span></p>
<table id="A2.EGx29" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E8.m1" class="ltx_Math" alttext="\displaystyle\sum_{i=1}^{m}\mathbb{E}_{\mathbf{E}_{\text{rem}}\sim\mathcal{N}(\bm{\mu}_{r},\sigma_{r}^{2}I)}\left[(\mathbf{E}_{\text{rem}}\mathbf{V}_{r}^{i})^{T}\Delta\mathbf{W}^{T}\Delta\mathbf{W}\mathbf{E}_{\text{rem}}\mathbf{V}_{r}^{i}\right]=\sigma_{r}^{2}\|\mathbf{V}_{r}\|_{F}^{2}\|\Delta\mathbf{W}\|_{F}^{2}+\|\Delta\mathbf{W}\bm{\mu}_{r}\mathbf{V}_{r}\|_{F}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msub><mi>𝔼</mi><mrow><msub><mi>𝐄</mi><mtext>rem</mtext></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝁</mi><mi>r</mi></msub><mo>,</mo><mrow><msubsup><mi>σ</mi><mi>r</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐄</mi><mtext>rem</mtext></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐕</mi><mi>r</mi><mi>i</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐖</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐖𝐄</mi><mtext>rem</mtext></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐕</mi><mi>r</mi><mi>i</mi></msubsup></mrow><mo>]</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><msubsup><mi>σ</mi><mi>r</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐕</mi><mi>r</mi></msub><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐖</mi></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup></mrow><mo>+</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐖</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐕</mi><mi>r</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=1}^{m}\mathbb{E}_{\mathbf{E}_{\text{rem}}\sim\mathcal{N}(\bm{\mu}_{r},\sigma_{r}^{2}I)}\left[(\mathbf{E}_{\text{rem}}\mathbf{V}_{r}^{i})^{T}\Delta\mathbf{W}^{T}\Delta\mathbf{W}\mathbf{E}_{\text{rem}}\mathbf{V}_{r}^{i}\right]=\sigma_{r}^{2}\|\mathbf{V}_{r}\|_{F}^{2}\|\Delta\mathbf{W}\|_{F}^{2}+\|\Delta\mathbf{W}\bm{\mu}_{r}\mathbf{V}_{r}\|_{F}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(B.8)</span></td></tr></tbody>
</table>
<p id="A2.p6.3" class="ltx_p"><span id="A2.p6.3.1" class="ltx_text">by applying Equation (<a href="#A2.E5" title="In Proof. ‣ Appendix B Proofs of Theorems ‣ Concept Pinpoint Eraser for Text-to-image Diffusion Models via Residual Attention Gate" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.5</span></a>). Therefore, considering the Gaussian mixture model gives us Equation (<a href="#A2.E7" title="In Corollary 1. ‣ Appendix B Proofs of Theorems ‣ Concept Pinpoint Eraser for Text-to-image Diffusion Models via Residual Attention Gate" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.7</span></a>) by summing the expectation computed by Equation (<a href="#A2.E8" title="In Proof. ‣ Appendix B Proofs of Theorems ‣ Concept Pinpoint Eraser for Text-to-image Diffusion Models via Residual Attention Gate" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.8</span></a>) across the modes.
∎</span></p>
</div>
</div>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Further Discussions on CPE</h2>

<section id="A3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.1 </span>Sampling method for anchoring concepts</h3>

<div id="A3.SS1.p1" class="ltx_para ltx_noindent">
<p id="A3.SS1.p1.1" class="ltx_p"><span id="A3.SS1.p1.1.1" class="ltx_text ltx_font_bold">Augmentation on anchor concepts.</span>  We found that augmenting anchor concepts can better protect the remaining concepts. We applied noise perturbation to the text embeddings of anchor concepts and utilized Mixup <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib71" title="" class="ltx_ref">Zhang et al., 2017</a>; <a href="#bib.bib36" title="" class="ltx_ref">Lim et al., 2022</a>)</cite>, which has already shown to enhance generalization performance and mitigate over-fitting with limited training samples. Specifically, we first perturb text embeddings <math id="A3.SS1.p1.m1" class="ltx_Math" alttext="(\mathbf{E}_{\text{anc}}^{1},\mathbf{E}_{\text{anc}}^{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐄</mi><mtext>anc</mtext><mn>1</mn></msubsup><mo>,</mo><msubsup><mi>𝐄</mi><mtext>anc</mtext><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbf{E}_{\text{anc}}^{1},\mathbf{E}_{\text{anc}}^{2})</annotation></semantics></math> of a pair of anchors with Gaussian additive noise:</p>
<table id="A3.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex25.m1" class="ltx_Math" alttext="\tilde{\mathbf{E}}_{\text{anc}}^{i}=\mathbf{E}_{\text{anc}}^{i}+\delta\xi,\quad\xi\sim\mathcal{N}(0,\mathbf{I})" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>𝐄</mi><mo>~</mo></mover><mtext>anc</mtext><mi>i</mi></msubsup><mo>=</mo><mrow><msubsup><mi>𝐄</mi><mtext>anc</mtext><mi>i</mi></msubsup><mo>+</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>ξ</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>𝐈</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{\mathbf{E}}_{\text{anc}}^{i}=\mathbf{E}_{\text{anc}}^{i}+\delta\xi,\quad\xi\sim\mathcal{N}(0,\mathbf{I})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p1.2" class="ltx_p">where <math id="A3.SS1.p1.m2" class="ltx_Math" alttext="i=1,2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">i=1,2</annotation></semantics></math> and <math id="A3.SS1.p1.m3" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> determines the noise scale. Then, we obtain the final anchor embedding for the attention anchoring loss by performing linear interpolation on the two perturbed text embeddings:</p>
<table id="A3.Ex26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex26.m1" class="ltx_Math" alttext="\tilde{\mathbf{E}}_{\text{anc}}=\zeta\tilde{\mathbf{E}}_{\text{anc}}^{1}+(1-\zeta)\tilde{\mathbf{E}}_{\text{anc}}^{2}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>𝐄</mi><mo>~</mo></mover><mtext>anc</mtext></msub><mo>=</mo><mrow><mrow><mi>ζ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝐄</mi><mo>~</mo></mover><mtext>anc</mtext><mn>1</mn></msubsup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ζ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝐄</mi><mo>~</mo></mover><mtext>anc</mtext><mn>2</mn></msubsup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\tilde{\mathbf{E}}_{\text{anc}}=\zeta\tilde{\mathbf{E}}_{\text{anc}}^{1}+(1-\zeta)\tilde{\mathbf{E}}_{\text{anc}}^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p1.3" class="ltx_p">where <math id="A3.SS1.p1.m4" class="ltx_Math" alttext="\zeta\sim Beta(\alpha,\beta)" display="inline" intent=":literal"><semantics><mrow><mi>ζ</mi><mo>∼</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\zeta\sim Beta(\alpha,\beta)</annotation></semantics></math>, <math id="A3.SS1.p1.m5" class="ltx_Math" alttext="Beta(\cdot,\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Beta(\cdot,\cdot)</annotation></semantics></math> is the beta distribution and we set <math id="A3.SS1.p1.m6" class="ltx_Math" alttext="\alpha=\beta=1.0" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mi>β</mi><mo>=</mo><mn>1.0</mn></mrow><annotation encoding="application/x-tex">\alpha=\beta=1.0</annotation></semantics></math> following the default setup from <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib71" title="" class="ltx_ref">Zhang et al. (2017)</a></cite>. Table <a href="#A3.T1" title="Table C.1 ‣ C.1 Sampling method for anchoring concepts ‣ Appendix C Further Discussions on CPE ‣ Concept Pinpoint Eraser for Text-to-image Diffusion Models via Residual Attention Gate" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.1</span></a> presents the effect of noise perturbation and Mixup for text embeddings on the erasing effectiveness on target concepts and the preservation performance on remaining concepts. We first note that even without using noise injection and Mixup, CPE already outperformed to the baselines in terms of both erasing effectiveness and preservation performance. Nevertheless, we observed that applying noise perturbation to the original anchor concepts helps better preserve the remaining concepts without impairing the erasing effectiveness. Furthermore we could protect the remaining concepts even more effectively by applying Mixup.</p>
</div>
<figure id="A3.T1" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table C.1: </span>Studies on the effect of noise injection and Mixup on anchor concepts. The row in <span id="A3.T1.3" class="ltx_text ltx_font_bold">bold</span> represents the results of the selected configurations for comparison to baselines.</figcaption>
<div id="A3.T1.4" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:397.5pt;height:74pt;vertical-align:-35.6pt;"><span class="ltx_transformed_inner" style="transform:translate(-162.2pt,30.2pt) scale(0.550649246109806,0.550649246109806) ;">
<table id="A3.T1.4.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="A3.T1.4.1.1" class="ltx_tr">
<th id="A3.T1.4.1.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_tt" rowspan="3"><span id="A3.T1.4.1.1.1.1" class="ltx_text">Mixup</span></th>
<th id="A3.T1.4.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_tt" rowspan="3"><span id="A3.T1.4.1.1.2.1" class="ltx_text">Noise Scale</span></th>
<th id="A3.T1.4.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="2">Target Concepts</th>
<th id="A3.T1.4.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="7">Remaining Concepts</th></tr>
<tr id="A3.T1.4.1.2" class="ltx_tr">
<th id="A3.T1.4.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" colspan="2">50 Celebrities</th>
<th id="A3.T1.4.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" colspan="3">100 Celebrities</th>
<th id="A3.T1.4.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" colspan="2">Artistic Styles</th>
<th id="A3.T1.4.1.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" colspan="2">COCO-1K</th></tr>
<tr id="A3.T1.4.1.3" class="ltx_tr">
