<td id="S8.T2.2.5.2" class="ltx_td ltx_nopad_r ltx_align_left"><span id="S8.T2.2.5.2.1" class="ltx_text" style="font-size:50%;">Dataset of 1000 structured fee schemes from financial networks</span></td></tr>
<tr id="S8.T2.2.6" class="ltx_tr">
<td id="S8.T2.2.6.1" class="ltx_td ltx_align_left"><span id="S8.T2.2.6.1.1" class="ltx_text ltx_font_typewriter" style="font-size:50%;">merchant_category_codes.csv</span></td>
<td id="S8.T2.2.6.2" class="ltx_td ltx_nopad_r ltx_align_left"><span id="S8.T2.2.6.2.1" class="ltx_text" style="font-size:50%;">Lookup table of Merchant Category Codes (MCCs)</span></td></tr>
