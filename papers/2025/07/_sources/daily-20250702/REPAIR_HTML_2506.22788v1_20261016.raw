<th id="S4.T4.5.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">MAE (mm)</th>
<th id="S4.T4.5.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">MSE (mm<sup id="S4.T4.5.1.4.1" class="ltx_sup">2</sup>)</th>
<th id="S4.T4.5.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">RMSE (mm)</th>
<th id="S4.T4.5.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="S4.T4.m1" class="ltx_Math" alttext="R^{2}" display="inline" intent=":literal"><semantics><msup><mi>R</mi><mn>2</mn></msup><annotation encoding="application/x-tex">R^{2}</annotation></semantics></math></th></tr>
</thead>
<tbody class="ltx_tbody">
