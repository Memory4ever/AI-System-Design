<td id="S4.T6.5.3.1" class="ltx_td ltx_align_center">Y</td>
<td id="S4.T6.5.3.2" class="ltx_td ltx_align_center">0.1799</td>
<td id="S4.T6.5.3.3" class="ltx_td ltx_align_center">0.0523</td>
