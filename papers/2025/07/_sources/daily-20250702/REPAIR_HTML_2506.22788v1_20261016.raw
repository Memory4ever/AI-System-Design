<td id="S3.T2.3.8.2" class="ltx_td ltx_align_center">0.159 <math id="S3.T2.m17" class="ltx_Math" alttext="mm" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">mm</annotation></semantics></math></td></tr>
