<td id="S4.T4.5.2.1" class="ltx_td ltx_align_center ltx_border_t" rowspan="4"><span id="S4.T4.5.2.1.1" class="ltx_text">DNN</span></td>
<td id="S4.T4.5.2.2" class="ltx_td ltx_align_center ltx_border_t">X</td>
<td id="S4.T4.5.2.3" class="ltx_td ltx_align_center ltx_border_t">0.1986</td>
<td id="S4.T4.5.2.4" class="ltx_td ltx_align_center ltx_border_t">0.0658</td>
<td id="S4.T4.5.2.5" class="ltx_td ltx_align_center ltx_border_t">0.2566</td>
<td id="S4.T4.5.2.6" class="ltx_td ltx_align_center ltx_border_t">0.9045</td></tr>
<tr id="S4.T4.5.3" class="ltx_tr">
<td id="S4.T4.5.3.1" class="ltx_td ltx_align_center">Y</td>
