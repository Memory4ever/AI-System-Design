<td id="S3.T2.3.5.2" class="ltx_td ltx_align_center">10.4<math id="S3.T2.m6" class="ltx_Math" alttext="m^{3}" display="inline" intent=":literal"><semantics><msup><mi>m</mi><mn>3</mn></msup><annotation encoding="application/x-tex">m^{3}</annotation></semantics></math> (3.5 <math id="S3.T2.m7" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>)</td>
<td id="S3.T2.3.5.3" class="ltx_td ltx_align_center">0.048 <math id="S3.T2.m8" class="ltx_Math" alttext="mm" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">mm</annotation></semantics></math></td></tr>
<tr id="S3.T2.3.6" class="ltx_tr">
<td id="S3.T2.3.6.1" class="ltx_td ltx_align_center">35<math id="S3.T2.m9" class="ltx_Math" alttext="m^{3}" display="inline" intent=":literal"><semantics><msup><mi>m</mi><mn>3</mn></msup><annotation encoding="application/x-tex">m^{3}</annotation></semantics></math> (5.3 <math id="S3.T2.m10" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>)</td>
<td id="S3.T2.3.6.2" class="ltx_td ltx_align_center">0.069 <math id="S3.T2.m11" class="ltx_Math" alttext="mm" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">mm</annotation></semantics></math></td></tr>
