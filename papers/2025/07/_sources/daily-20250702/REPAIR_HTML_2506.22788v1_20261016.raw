<td id="S4.T7.5.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S4.T7.5.2.2.1" class="ltx_inline-block ltx_align_top" style="width:170.7pt;">
<span id="S4.T7.5.2.2.1.1" class="ltx_p">All layers retained</span>
</span></td>
<td id="S4.T7.5.2.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S4.T7.5.2.3.1" class="ltx_inline-block ltx_align_top" style="width:170.7pt;">
<span id="S4.T7.5.2.3.1.1" class="ltx_p">Establish performance benchmark</span>
</span></td></tr>
<tr id="S4.T7.5.3" class="ltx_tr">
<th id="S4.T7.5.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">No Mask</th>
