<td id="S4.T1.4.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:1pt 2.0pt;">0.9655</td>
<td id="S4.T1.4.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:1pt 2.0pt;">0.8500</td></tr>
