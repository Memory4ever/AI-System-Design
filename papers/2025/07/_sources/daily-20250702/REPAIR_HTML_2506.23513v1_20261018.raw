S_{L_{i,j}}\cdot R_{-90}(W)+R_{90}(S_{B})_{i-n,j+n}\cdot Rot_{90}(W)\text{ , }(i,j)\in[n+1,r]\times[1,n]\\
\end{cases}" display="block" intent=":literal"><semantics><mrow><msub><mi>S</mi><msub><mi>L</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub></msub><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mrow><msub><mi>S</mi><msub><mi>L</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>R</mi><mn>90</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mrow><msub><mi>R</mi><mrow><mo>−</mo><mn>90</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>F</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mrow><mrow><mi>i</mi><mo>+</mo><mi>n</mi></mrow><mo>,</mo><mrow><mi>j</mi><mo>−</mo><mi>n</mi></mrow></mrow></msub></mrow><mo rspace="0.222em">⋅</mo><msub><mi>R</mi><mrow><mo>−</mo><mn>90</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext> , </mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mi>n</mi></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>r</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mrow><msub><mi>S</mi><msub><mi>L</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>R</mi><mrow><mo>−</mo><mn>90</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mrow><msub><mi>R</mi><mn>90</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>B</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mrow><mrow><mi>i</mi><mo>−</mo><mi>n</mi></mrow><mo>,</mo><mrow><mi>j</mi><mo>+</mo><mi>n</mi></mrow></mrow></msub></mrow><mo rspace="0.222em">⋅</mo><mi>R</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mn>90</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext> , </mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>r</mi></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mi>n</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mtd><mtd></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">S_{L_{i,j}}=\begin{cases}S_{L_{i,j}}\cdot R_{90}(W)+R_{-90}(S_{F})_{i+n,j-n}\cdot R_{-90}(W)\text{ , }(i,j)\in[1,n]\times[n+1,r]\\
S_{L_{i,j}}\cdot R_{-90}(W)+R_{90}(S_{B})_{i-n,j+n}\cdot Rot_{90}(W)\text{ , }(i,j)\in[n+1,r]\times[1,n]\\
\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
