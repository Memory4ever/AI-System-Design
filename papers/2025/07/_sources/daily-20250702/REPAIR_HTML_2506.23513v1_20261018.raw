<msub><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>R</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mrow><mrow><mi>i</mi><mo>−</mo><mi>n</mi></mrow><mo>,</mo><mrow><mi>j</mi><mo>−</mo><mi>n</mi></mrow></mrow></msub></mrow><mo rspace="0.222em">⋅</mo><mi>W</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mtext> , </mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>r</mi></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>r</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mtd><mtd></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">S_{F_{i,j}}=\begin{cases}S_{F_{i,j}}\cdot W+R_{90}(S_{L})_{i+n,j+n}\cdot R_{180}(W)\text{ , }(i,j)\in[1,n]\times[1,n]\\
