<td id="S5.T1.2.2.3" class="ltx_td ltx_align_center">SSIM (<math id="S5.T1.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>)</td></tr>
