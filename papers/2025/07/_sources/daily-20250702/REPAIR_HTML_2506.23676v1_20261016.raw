<th id="S5.T2.2.2.2" class="ltx_td ltx_align_right ltx_th ltx_th_row ltx_border_bb ltx_border_t"><span id="S5.T2.2.2.2.1" class="ltx_text ltx_font_bold">2740</span></th>
