<td id="S5.T6.5.1.4.5" class="ltx_td ltx_align_center"><math id="S5.T6.m11" class="ltx_Math" alttext="-1.028" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>1.028</mn></mrow><annotation encoding="application/x-tex">-1.028</annotation></semantics></math></td></tr>
<tr id="S5.T6.5.1.5" class="ltx_tr">
