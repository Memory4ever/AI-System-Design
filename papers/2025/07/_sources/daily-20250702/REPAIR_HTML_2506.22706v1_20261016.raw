<td id="S5.T6.5.1.5.2" class="ltx_td ltx_align_center ltx_border_bb"><math id="S5.T6.m12" class="ltx_Math" alttext="-1.202" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>1.202</mn></mrow><annotation encoding="application/x-tex">-1.202</annotation></semantics></math></td>
