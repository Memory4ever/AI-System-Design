ttext="a\in\{0,1\}^{(T,k)}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">a\in\{0,1\}^{(T,k)}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 27.5)"><g class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:11.12em;--ltx-fo-height:0.85em;--ltx-fo-depth:1em;font-size:10pt;" height="25.59" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="153.89"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F6.pic1.m10" class="ltx_Math" alttext="\sum_{j=1}^{k}a(i,j)=1\ \forall i\in[T]" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></msubsup><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo lspace="0.667em" rspace="0em">​</mo><mrow><mo rspace="0.167em">∀</mo><mi>i</mi></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\sum_{j=1}^{k}a(i,j)=1\ \forall i\in[T]</annotation></semantics></math></span></span></foreignObject></g></g></g></g><path style="fill:none" d="M 296.43 79.28 L 296.43 157.48 L 111.81 157.48"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-1.0 0.0 0.0 -1.0 115.15 157.48)"><path d="M 9.22 0 L 0.89 3.11 L 3.48 0 L 0.89 -3.11 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 262.04 165.83)"><foreignObject style="--ltx-fo-width:4.97em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.25em;font-size:10pt;" height="15.21" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="68.78"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F6.pic1.m11" class="ltx_Math" alttext="a_{0}\in\{0,1\}^{k_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mn>0</mn></msub><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><msub><mi>k</mi><mn>1</mn></msub></msup></mrow><annotation encoding="application/x-tex">a_{0}\in\{0,1\}^{k_{1}}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 355.48 79.28 L 355.48 236.22 L 237.97 236.22"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-1.0 0.0 0.0 -1.0 241.31 236.22)"><path d="M 9.22 0 L 0.89 3.11 L 3.48 0 L 0.89 -3.11 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.0 1.0 -1.0 0.0 372.12 120.98)"><foreignObject style="--ltx-fo-width:5.31em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.25em;font-size:10pt;" height="15.21" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="73.54"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F6.pic1.m12" class="ltx_Math" alttext="a_{T}\in\{0,1\}^{k_{T}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>T</mi></msub><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><msub><mi>k</mi><mi>T</mi></msub></msup></mrow><annotation encoding="application/x-tex">a_{T}\in\{0,1\}^{k_{T}}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 0 126.06 L 0 79.84"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 0 79.56)"><path style="fill:none" d="M -5.45 6.02 C -4.46 2.41 -2.24 0.7 0 0 C -2.24 -0.7 -4.46 -2.41 -5.45 -6.02"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -41.12 98.98)"><foreignObject style="--ltx-fo-width:2.62em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="36.23"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F6.pic1.m13" class="ltx_Math" alttext="R_{0}\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mn>0</mn></msub><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">R_{0}\in\mathbb{R}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 127.95 204.8 L 127.95 65.17 L 183.87 65.17"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 184.15 65.17)"><path style="fill:none" d="M -5.45 6.02 C -4.46 2.41 -2.24 0.7 0 0 C -2.24 -0.7 -4.46 -2.41 -5.45 -6.02"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 84.32 100.58)"><foreignObject style="--ltx-fo-width:2.8em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="38.74"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F6.pic1.m14" class="ltx_Math" alttext="R_{T}\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>T</mi></msub><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">R_{T}\in\mathbb{R}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M -29.53 51.06 L -29.53 2.4"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 -29.53 2.12)"><path style="fill:none" d="M -5.45 6.02 C -4.46 2.41 -2.24 0.7 0 0 C -2.24 -0.7 -4.46 -2.41 -5.45 -6.02"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -70.65 22.29)"><foreignObject style="--ltx-fo-width:2.62em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.15em;font-size:10pt;" height="12.48" overflow="visible" transform="matrix(1 0 0 -1 0 10.4)" width="36.23"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F6.pic1.m15" class="ltx_Math" alttext="R_{0}^{\prime}\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>R</mi><mn>0</mn><mo>′</mo></msubsup><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">R_{0}^{\prime}\in\mathbb{R}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 29.53 51.06 L 29.53 2.4"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 29.53 2.12)"><path style="fill:none" d="M -5.45 6.02 C -4.46 2.41 -2.24 0.7 0 0 C -2.24 -0.7 -4.46 -2.41 -5.45 -6.02"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 34.42 22.29)"><foreignObject style="--ltx-fo-width:2.8em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.15em;font-size:10pt;" height="12.48" overflow="visible" transform="matrix(1 0 0 -1 0 10.4)" width="38.74"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F6.pic1.m16" class="ltx_Math" alttext="R_{T}^{\prime}\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>R</mi><mi>T</mi><mo>′</mo></msubsup><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">R_{T}^{\prime}\in\mathbb{R}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M -105.18 157.48 L -157.61 157.48"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-1.0 0.0 0.0 -1.0 -154.28 157.48)"><path d="M 9.22 0 L 0.89 3.11 L 3.48 0 L 0.89 -3.11 Z"></path></g><path style="fill:none" d="M 83.61 236.22 L -67.25 236.22"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-1.0 0.0 0.0 -1.0 -63.91 236.22)"><path d="M 9.22 0 L 0.89 3.11 L 3.48 0 L 0.89 -3.11 Z"></path></g><path style="fill:none" d="M -224.49 126.75 L -224.49 21.66"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 -1.0 1.0 0.0 -224.49 25)"><path d="M 9.22 0 L 0.89 3.11 L 3.48 0 L 0.89 -3.11 Z"></path></g><path style="fill:none" d="M -194.38 236.22 L -496.75 236.22 L -496.75 21.66"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 -1.0 1.0 0.0 -496.75 25)"><path d="M 9.22 0 L 0.89 3.11 L 3.48 0 L 0.89 -3.11 Z"></path></g><path style="fill:none" d="M -300.31 -19.69 L -272.45 -19.69"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 -275.79 -19.69)"><path d="M 9.22 0 L 0.89 3.11 L 3.48 0 L 0.89 -3.11 Z"></path></g></g></g></svg></span>
</span></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S4.F6.9" class="ltx_text" style="font-size:90%;">Figure 6</span>: </span><span id="S4.F6.10" class="ltx_text" style="font-size:90%;">Illustration of the single-agent multi-task setting in which the <span id="S4.F6.10.1" class="ltx_text ltx_font_smallcaps">gacd</span> agent is trained. We randomly sample a set of environments, Scenario <math id="S4.F6.m7" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> through Scenario <math id="S4.F6.m8" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, by varying the topology using the <span id="S4.F6.10.2" class="ltx_text ltx_font_smallcaps">psg</span> – see <a href="#alg1" title="In Appendix C Procedural scenario generator algorithm ‣ General Autonomous Cybersecurity Defense:Learning Robust Policies for Dynamic Topologies and Diverse Attackers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Algorithm</span> <span class="ltx_text ltx_ref_tag">1</span></a>. The environment’s observations are represented as graphs that are aggregated into a batched observation <math id="S4.F6.m9" class="ltx_Math" alttext="\mathbf{G}" display="inline" intent=":literal"><semantics><mi>𝐆</mi><annotation encoding="application/x-tex">\mathbf{G}</annotation></semantics></math> that is fed to the blue agent. The agent consists of a <span id="S4.F6.10.3" class="ltx_text ltx_font_smallcaps">gnn</span> encoder and an <span id="S4.F6.10.4" class="ltx_text ltx_font_smallcaps">ot</span> map that projects the graph onto the domain <math id="S4.F6.m10" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math> from which an action network predicts a distribution of actions for each environment, with each having <math id="S4.F6.m11" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> possible actions. The predicted actions are distributed to each environment as appropriate. Rewards, <math id="S4.F6.m12" class="ltx_Math" alttext="R_{i}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>i</mi></msub><annotation encoding="application/x-tex">R_{i}</annotation></semantics></math>, for the different environments are normalized to the baseline <span id="S4.F6.10.5" class="ltx_text ltx_font_smallcaps">cc2</span> range prior to being fed to the agent.</span></figcaption>
</figure>
</section>
</section>
</section>
<section id="S5" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">5 </span>Experiments</h2>

<div id="S5.p1" class="ltx_para">
<p id="S5.p1.1" class="ltx_p">We evaluate<span id="footnote3" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">3</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">3</sup>
            <span class="ltx_tag ltx_tag_note">3</span>
            
            
            
            
            
            
            
          A Python implementation is available. Please contact AR for access.</span></span></span> the <span id="S5.p1.1.1" class="ltx_text ltx_font_smallcaps">gacd</span> models in a series of experiments:</p>
<ul id="S5.I1" class="ltx_itemize">
<li id="S5.I1.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><a href="#S5.SS1" title="5.1 Model scalability ‣ 5 Experiments ‣ General Autonomous Cybersecurity Defense:Learning Robust Policies for Dynamic Topologies and Diverse Attackers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">5.1</span></a></span> 
<div id="S5.I1.ix1.p1" class="ltx_para">
<p id="S5.I1.ix1.p1.1" class="ltx_p">Evaluate the scalability and generalizability of the model.</p>
</div></li>
<li id="S5.I1.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><a href="#S5.SS2" title="5.2 Ablation study ‣ 5 Experiments ‣ General Autonomous Cybersecurity Defense:Learning Robust Policies for Dynamic Topologies and Diverse Attackers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">5.2</span></a></span> 
<div id="S5.I1.ix2.p1" class="ltx_para">
<p id="S5.I1.ix2.p1.1" class="ltx_p">Ablation study.</p>
</div></li>
<li id="S5.I1.ix3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><a href="#S5.SS3" title="5.3 Scaling to larger networks ‣ 5 Experiments ‣ General Autonomous Cybersecurity Defense:Learning Robust Policies for Dynamic Topologies and Diverse Attackers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">5.3</span></a></span> 
<div id="S5.I1.ix3.p1" class="ltx_para">
<p id="S5.I1.ix3.p1.1" class="ltx_p">We increase the size of the <span id="S5.I1.ix3.p1.1.1" class="ltx_text ltx_font_smallcaps">cc2</span> network and evaluate performance.</p>
</div></li>
<li id="S5.I1.ix4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><a href="#S5.SS4" title="5.4 Novel attack patterns ‣ 5 Experiments ‣ General Autonomous Cybersecurity Defense:Learning Robust Policies for Dynamic Topologies and Diverse Attackers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">5.4</span></a></span> 
<div id="S5.I1.ix4.p1" class="ltx_para">
<p id="S5.I1.ix4.p1.1" class="ltx_p">We study novel attack patterns.</p>
</div></li>
<li id="S5.I1.ix5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><a href="#S5.SS5" title="5.5 Comparison against other gnn models ‣ 5 Experiments ‣ General Autonomous Cybersecurity Defense:Learning Robust Policies for Dynamic Topologies and Diverse Attackers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">5.5</span></a></span> 
<div id="S5.I1.ix5.p1" class="ltx_para">
<p id="S5.I1.ix5.p1.1" class="ltx_p">Compare <span id="S5.I1.ix5.p1.1.1" class="ltx_text ltx_font_smallcaps">gacd</span>’s performance against the <span id="S5.I1.ix5.p1.1.2" class="ltx_text ltx_font_smallcaps">mpnn</span> model from <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib14" title="" class="ltx_ref">Nyberg &amp; Johnson (2024)</a></cite>.</p>
</div></li>
<li id="S5.I1.ix6" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><a href="#S5.SS6" title="5.6 Comparing information representations ‣ 5 Experiments ‣ General Autonomous Cybersecurity Defense:Learning Robust Policies for Dynamic Topologies and Diverse Attackers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">5.6</span></a></span> 
<div id="S5.I1.ix6.p1" class="ltx_para">
<p id="S5.I1.ix6.p1.1" class="ltx_p">Compare performance against the <span id="S5.I1.ix6.p1.1.1" class="ltx_text ltx_font_smallcaps">sota</span> <span id="S5.I1.ix6.p1.1.2" class="ltx_text ltx_font_smallcaps">ppo</span> variant of the model under varying observation conditions.</p>
</div></li>
<li id="S5.I1.ix7" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><a href="#S5.SS7" title="5.7 Model adaptability to environment dynamics ‣ 5 Experiments ‣ General Autonomous Cybersecurity Defense:Learning Robust Policies for Dynamic Topologies and Diverse Attackers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">5.7</span></a></span> 
<div id="S5.I1.ix7.p1" class="ltx_para">
<p id="S5.I1.ix7.p1.1" class="ltx_p">Evaluate the performance of the model in a setting where the network topology is altered midway through the episode.</p>
</div></li>
<li id="S5.I1.ix8" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><a href="#S5.SS8" title="5.8 Optimal transport utility ‣ 5 Experiments ‣ General Autonomous Cybersecurity Defense:Learning Robust Policies for Dynamic Topologies and Diverse Attackers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">5.8</span></a></span> 
<div id="S5.I1.ix8.p1" class="ltx_para">
<p id="S5.I1.ix8.p1.1" class="ltx_p">Finally we remove the <span id="S5.I1.ix8.p1.1.1" class="ltx_text ltx_font_smallcaps">ot</span> layer to measure its overall utility.</p>
</div></li>
</ul>
</div>
<section id="S5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.1 </span>Model scalability</h3>

<div id="S5.SS1.p1" class="ltx_para">
<p id="S5.SS1.p1.1" class="ltx_p">We evaluate <math id="S5.SS1.p1.m1" class="ltx_Math" alttext="\{\mathcal{M}_{i}\}_{i=1}^{3}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mn>3</mn></msubsup><annotation encoding="application/x-tex">\{\mathcal{M}_{i}\}_{i=1}^{3}</annotation></semantics></math> against a varying number of network topologies, ranging from 4 to 1024, randomly sampled from the <span id="S5.SS1.p1.1.1" class="ltx_text ltx_font_smallcaps">psg</span>. For model <math id="S5.SS1.p1.m2" class="ltx_Math" alttext="\mathcal{M}_{3}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>3</mn></msub><annotation encoding="application/x-tex">\mathcal{M}_{3}</annotation></semantics></math>, we sample 10 episodes of 50 steps for each other network topology to create the different graph representations of the network to pre-train the <span id="S5.SS1.p1.1.2" class="ltx_text ltx_font_smallcaps">grl</span> agent. Each model is trained on these environments against a randomly sampled red agent, choosing from either the B-Line or the Meander agent from the <span id="S5.SS1.p1.1.3" class="ltx_text ltx_font_smallcaps">cc2</span> environment. The performance of the <span id="S5.SS1.p1.1.4" class="ltx_text ltx_font_smallcaps">gacd</span> agents are illustrated in <a href="#S5.F7" title="In 5.1 Model scalability ‣ 5 Experiments ‣ General Autonomous Cybersecurity Defense:Learning Robust Policies for Dynamic Topologies and Diverse Attackers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">7</span></a>. We observe that the performance of the <span id="S5.SS1.p1.1.5" class="ltx_text ltx_font_smallcaps">gacd</span> agent degrades with an increasing number of topologies. Next, the use of a <span id="S5.SS1.p1.1.6" class="ltx_text ltx_font_smallcaps">gtm</span> improves the performance compared to <math id="S5.SS1.p1.m3" class="ltx_Math" alttext="\mathcal{M}_{1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathcal{M}_{1}</annotation></semantics></math>, with the use of <span id="S5.SS1.p1.1.7" class="ltx_text ltx_font_smallcaps">gtm</span> in the auto-encoding setup performing the best. <math id="S5.SS1.p1.m4" class="ltx_Math" alttext="\mathcal{M}_{1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathcal{M}_{1}</annotation></semantics></math> shows poor scaling with the number of topologies, compared with <math id="S5.SS1.p1.m5" class="ltx_Math" alttext="\mathcal{M}_{2}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\mathcal{M}_{2}</annotation></semantics></math> and <math id="S5.SS1.p1.m6" class="ltx_Math" alttext="\mathcal{M}_{3}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>3</mn></msub><annotation encoding="application/x-tex">\mathcal{M}_{3}</annotation></semantics></math>. <math id="S5.SS1.p1.m7" class="ltx_Math" alttext="\mathcal{M}_{2}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\mathcal{M}_{2}</annotation></semantics></math> and <math id="S5.SS1.p1.m8" class="ltx_Math" alttext="\mathcal{M}_{3}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>3</mn></msub><annotation encoding="application/x-tex">\mathcal{M}_{3}</annotation></semantics></math> that use the <span id="S5.SS1.p1.1.8" class="ltx_text ltx_font_smallcaps">gtm</span> architecture achieve performance comparable to the <span id="S5.SS1.p1.1.9" class="ltx_text ltx_font_smallcaps">sota</span> <span id="S5.SS1.p1.1.10" class="ltx_text ltx_font_smallcaps">ppo</span> model, from Cardiff University <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib24" title="" class="ltx_ref">Vyas et al., 2023</a>)</cite>, for up to 128 topologies, while the <math id="S5.SS1.p1.m9" class="ltx_Math" alttext="\mathcal{M}_{1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathcal{M}_{1}</annotation></semantics></math> only shows performance comparable to the <span id="S5.SS1.p1.1.11" class="ltx_text ltx_font_smallcaps">sota</span> on 16 topologies.</p>
</div>
<figure id="S5.F7" class="ltx_figure">
