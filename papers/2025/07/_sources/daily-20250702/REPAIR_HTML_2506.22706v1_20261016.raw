            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l19a.1" class="ltx_text" style="font-size:80%;">19:</span></span>
            
            
           

</div>
<div id="alg1.l20" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l20.1" class="ltx_text" style="font-size:80%;">20:</span></span>
            
            
           Number of subnets: <math id="alg1.l20.m1" class="ltx_Math" alttext="NS\sim\mathcal{U}[{NS}_{l},{NS}_{u}]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>l</mi></msub></mrow><mo>,</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>u</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">NS\sim\mathcal{U}[{NS}_{l},{NS}_{u}]</annotation></semantics></math>

</div>
