37)"><foreignObject style="--ltx-fo-width:4em;--ltx-fo-height:0.58em;--ltx-fo-depth:0em;font-size:10.5pt;" height="8.46" overflow="visible" transform="matrix(1 0 0 -1 0 8.46)" width="58.12"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.sf2.pic1.9" class="ltx_text ltx_font_typewriter">Defender</span></span></span></foreignObject></g><path style="fill:none" d="M -149.12 -113.89 L -182.93 -101.3"></path><path style="fill:none" d="M -149.12 -122.33 L -182.93 -134.92"></path><path style="fill:none" d="M -126.47 -113.89 L -92.66 -101.3"></path><path style="fill:none" d="M -126.47 -122.33 L -92.66 -134.92"></path><g style="--ltx-stroke-color:#0000FF;--ltx-fill-color:#0000FF;--ltx-fg-color:#0000FF;" color="#0000FF" fill="#0000FF" stroke="#0000FF" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><path style="fill:none" d="M -210.63 -157.48 h 145.67 v 78.74 h -145.67 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -191.24 -172.53)"><foreignObject style="--ltx-fo-width:7.75em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="107.28"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.sf2.pic1.10" class="ltx_text">Enterprise subnet</span></span></span></foreignObject></g><path style="fill:none" d="M 149.61 -118.11 C 149.61 -111.59 144.32 -106.3 137.8 -106.3 C 131.27 -106.3 125.98 -111.59 125.98 -118.11 C 125.98 -124.63 131.27 -129.92 137.8 -129.92 C 144.32 -129.92 149.61 -124.63 149.61 -118.11 Z M 137.8 -118.11"></path><path style="fill:none" d="M 93.14 -97.08 C 93.14 -90.56 87.85 -85.27 81.33 -85.27 C 74.81 -85.27 69.52 -90.56 69.52 -97.08 C 69.52 -103.6 74.81 -108.89 81.33 -108.89 C 87.85 -108.89 93.14 -103.6 93.14 -97.08 Z M 81.33 -97.08"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 24.1 -101.31)"><foreignObject style="--ltx-fo-width:2.5em;--ltx-fo-height:0.58em;--ltx-fo-depth:0em;font-size:10.5pt;" height="8.46" overflow="visible" transform="matrix(1 0 0 -1 0 8.46)" width="36.32"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.sf2.pic1.11" class="ltx_text ltx_font_typewriter">User0</span></span></span></foreignObject></g><path style="fill:none" d="M 93.14 -139.14 C 93.14 -132.62 87.85 -127.33 81.33 -127.33 C 74.81 -127.33 69.52 -132.62 69.52 -139.14 C 69.52 -145.67 74.81 -150.95 81.33 -150.95 C 87.85 -150.95 93.14 -145.67 93.14 -139.14 Z M 81.33 -139.14"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 24.1 -143.37)"><foreignObject style="--ltx-fo-width:2.5em;--ltx-fo-height:0.58em;--ltx-fo-depth:0em;font-size:10.5pt;" height="8.46" overflow="visible" transform="matrix(1 0 0 -1 0 8.46)" width="36.32"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.sf2.pic1.12" class="ltx_text ltx_font_typewriter">User1</span></span></span></foreignObject></g><path style="fill:none" d="M 206.07 -97.08 C 206.07 -90.56 200.78 -85.27 194.26 -85.27 C 187.74 -85.27 182.45 -90.56 182.45 -97.08 C 182.45 -103.6 187.74 -108.89 194.26 -108.89 C 200.78 -108.89 206.07 -103.6 206.07 -97.08 Z M 194.26 -97.08"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 215.17 -101.31)"><foreignObject style="--ltx-fo-width:2.5em;--ltx-fo-height:0.58em;--ltx-fo-depth:0em;font-size:10.5pt;" height="8.46" overflow="visible" transform="matrix(1 0 0 -1 0 8.46)" width="36.32"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.sf2.pic1.13" class="ltx_text ltx_font_typewriter">User2</span></span></span></foreignObject></g><path style="fill:none" d="M 206.07 -139.14 C 206.07 -132.62 200.78 -127.33 194.26 -127.33 C 187.74 -127.33 182.45 -132.62 182.45 -139.14 C 182.45 -145.67 187.74 -150.95 194.26 -150.95 C 200.78 -150.95 206.07 -145.67 206.07 -139.14 Z M 194.26 -139.14"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 215.17 -143.37)"><foreignObject style="--ltx-fo-width:2.5em;--ltx-fo-height:0.58em;--ltx-fo-depth:0em;font-size:10.5pt;" height="8.46" overflow="visible" transform="matrix(1 0 0 -1 0 8.46)" width="36.32"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.sf2.pic1.14" class="ltx_text ltx_font_typewriter">User3</span></span></span></foreignObject></g><path style="fill:none" d="M 149.61 -161.97 C 149.61 -155.45 144.32 -150.16 137.8 -150.16 C 131.27 -150.16 125.98 -155.45 125.98 -161.97 C 125.98 -168.49 131.27 -173.78 137.8 -173.78 C 144.32 -173.78 149.61 -168.49 149.61 -161.97 Z M 137.8 -161.97"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 154.77 -166.2)"><foreignObject style="--ltx-fo-width:2.5em;--ltx-fo-height:0.58em;--ltx-fo-depth:0em;font-size:10.5pt;" height="8.46" overflow="visible" transform="matrix(1 0 0 -1 0 8.46)" width="36.32"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.sf2.pic1.15" class="ltx_text ltx_font_typewriter">User4</span></span></span></foreignObject></g><path style="fill:none" d="M 126.47 -113.89 L 92.66 -101.3"></path><path style="fill:none" d="M 126.47 -122.33 L 92.66 -134.92"></path><path style="fill:none" d="M 149.12 -113.89 L 182.93 -101.3"></path><path style="fill:none" d="M 149.12 -122.33 L 182.93 -134.92"></path><path style="fill:none" d="M 137.8 -130.2 L 137.8 -149.88"></path><g style="--ltx-stroke-color:#FF0000;--ltx-fill-color:#FF0000;--ltx-fg-color:#FF0000;" color="#FF0000" fill="#FF0000" stroke="#FF0000" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><path style="fill:none" d="M 64.96 -179.13 h 145.67 v 98.43 h -145.67 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 101.76 -194.19)"><foreignObject style="--ltx-fo-width:5.21em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="72.07"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.sf2.pic1.16" class="ltx_text">User subnet</span></span></span></foreignObject></g><g stroke-width="0.8pt"><path style="fill:none" d="M 9.18 -7.87 L 121.75 -104.36"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.75926 -0.65079 0.65079 0.75926 118.22 -101.33)"><path d="M 12.22 0 L 1.79 3.89 L 4.93 0 L 1.79 -3.89 Z"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M -9.18 -7.87 L -128.62 -110.24"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -125.71 -118.11 L 125.71 -118.11"></path></g><g style="--ltx-fill-color:#808080;" fill="#808080"><path d="M 181.1 23.62 C 181.1 30.15 175.81 35.43 169.29 35.43 C 162.77 35.43 157.48 30.15 157.48 23.62 C 157.48 17.1 162.77 11.81 169.29 11.81 C 175.81 11.81 181.1 17.1 181.1 23.62 Z M 169.29 23.62"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 186.27 20.93)"><foreignObject style="--ltx-fo-width:2.5em;--ltx-fo-height:0.58em;--ltx-fo-depth:0.21em;font-size:10.5pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 8.46)" width="36.32"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.sf2.pic1.17" class="ltx_text ltx_font_typewriter">Decoy</span></span></span></foreignObject></g><path style="fill:none" d="M 67.7 -16.58 L 151.89 16.74"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.92982 0.368 -0.368 0.92982 148.79 15.51)"><path d="M 9.22 0 L 0.89 3.11 L 3.48 0 L 0.89 -3.11 Z"></path></g><path style="fill:none" d="M 171.74 11.79 L 190.47 -78.76"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.20258 -0.97926 0.97926 0.20258 189.79 -75.49)"><path d="M 9.22 0 L 0.89 3.11 L 3.48 0 L 0.89 -3.11 Z"></path></g></g></svg></span>
</span></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S2.F2.sf2.5" class="ltx_text" style="font-size:90%;">(b)</span> </span><span id="S2.F2.sf2.6" class="ltx_text" style="font-size:90%;">Graph representation <math id="S2.F2.sf2.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> of the <span id="S2.F2.sf2.6.1" class="ltx_text ltx_font_smallcaps">cc2</span> network – see reference state in <a href="#S2.F2.sf1" title="In Figure 2 ‣ 2 Preliminaries ‣ General Autonomous Cybersecurity Defense:Learning Robust Policies for Dynamic Topologies and Diverse Attackers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">2(a)</span></a> – as observed by the blue agent. Each node in the graph is attributed with 7 features, described in Sec. <a href="#S4.SS1" title="4.1 Embedding observations ‣ 4 Method ‣ General Autonomous Cybersecurity Defense:Learning Robust Policies for Dynamic Topologies and Diverse Attackers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>, that is used as a representation of the state of the host and subnet by the model. Dashed colored boxes correspond to those shown in <a href="#S1.F1" title="In 1 Introduction ‣ General Autonomous Cybersecurity Defense:Learning Robust Policies for Dynamic Topologies and Diverse Attackers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">1</span></a>.</span></figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S2.F2.5" class="ltx_text" style="font-size:90%;">Figure 2</span>: </span><span id="S2.F2.6" class="ltx_text" style="font-size:90%;">Tabular and graphical representation of the <span id="S2.F2.6.1" class="ltx_text ltx_font_smallcaps">cc2</span> network environment. In <a href="#S2.F2.sf2" title="In Figure 2 ‣ 2 Preliminaries ‣ General Autonomous Cybersecurity Defense:Learning Robust Policies for Dynamic Topologies and Diverse Attackers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">2(b)</span></a> the graph representation <math id="S2.F2.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> illustrates the network topology as seen by the <span id="S2.F2.6.2" class="ltx_text ltx_font_smallcaps">gacd</span> agent, where nodes represent devices, subnets and decoys, and edges denote network interfaces.
In <a href="#S2.F2.sf1" title="In Figure 2 ‣ 2 Preliminaries ‣ General Autonomous Cybersecurity Defense:Learning Robust Policies for Dynamic Topologies and Diverse Attackers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">2(a)</span></a> the corresponding state <math id="S2.F2.m4" class="ltx_Math" alttext="s_{t}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mi>t</mi></msub><annotation encoding="application/x-tex">s_{t}</annotation></semantics></math> of the network is presented in tabular form, detailing the subnets, IP addresses, hostnames, activities and compromise status of each node in the environment.</span></figcaption>
</figure>
<div id="S2.p1" class="ltx_para">
<p id="S2.p1.1" class="ltx_p">We treat the <span id="S2.p1.1.1" class="ltx_text ltx_font_smallcaps">acd</span> scenario as a reinforcement learning (<span id="S2.p1.1.2" class="ltx_text ltx_font_smallcaps">rl</span>) problem where we model the interaction between the blue agent and an environment (e.g. <a href="#S1.F1" title="In 1 Introduction ‣ General Autonomous Cybersecurity Defense:Learning Robust Policies for Dynamic Topologies and Diverse Attackers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">1</span></a>) as a Markov decision process (<span id="S2.p1.1.3" class="ltx_text ltx_font_smallcaps">mdp</span>).</p>
</div>
<div id="S2.Thmtheorem1" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmtheorem1.2" class="ltx_text ltx_font_bold">Definition 2.1</span></span><span id="S2.Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(Markov decision process)<span id="S2.Thmtheorem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmtheorem1.p1" class="ltx_para">
<p id="S2.Thmtheorem1.p1.1" class="ltx_p">An <span id="S2.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_smallcaps">mdp</span> is a tuple <math id="S2.Thmtheorem1.p1.m1" class="ltx_Math" alttext="M=\langle\mathcal{S},\mathcal{A},P,R,\alpha\rangle" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><mrow><mo stretchy="false">⟨</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi>P</mi><mo>,</mo><mi>R</mi><mo>,</mo><mi>α</mi></mrow><mo stretchy="false">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">M=\langle\mathcal{S},\mathcal{A},P,R,\alpha\rangle</annotation></semantics></math> where: <math id="S2.Thmtheorem1.p1.m2" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math> is the set of states, representing all possible configurations of the environment; <math id="S2.Thmtheorem1.p1.m3" class="ltx_Math" alttext="\mathcal{A}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">\mathcal{A}</annotation></semantics></math> is the set of actions available to the agent; <math id="S2.Thmtheorem1.p1.m4" class="ltx_Math" alttext="P:\mathcal{S}\times\mathcal{A}\times\mathcal{S}\to[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P:\mathcal{S}\times\mathcal{A}\times\mathcal{S}\to[0,1]</annotation></semantics></math> is the transition probability function, where <math id="S2.Thmtheorem1.p1.m5" class="ltx_Math" alttext="P(s^{\prime}\mid s,a)" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>s</mi><mo>′</mo></msup><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>s</mi><mo>,</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P(s^{\prime}\mid s,a)</annotation></semantics></math> represents the probability of transitioning to state <math id="S2.Thmtheorem1.p1.m6" class="ltx_Math" alttext="s^{\prime}\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><msup><mi>s</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s^{\prime}\in\mathcal{S}</annotation></semantics></math> from state <math id="S2.Thmtheorem1.p1.m7" class="ltx_Math" alttext="s\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s\in\mathcal{S}</annotation></semantics></math> after taking action <math id="S2.Thmtheorem1.p1.m8" class="ltx_Math" alttext="a\in\mathcal{A}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow><annotation encoding="application/x-tex">a\in\mathcal{A}</annotation></semantics></math>; <math id="S2.Thmtheorem1.p1.m9" class="ltx_Math" alttext="R:\mathcal{S}\times\mathcal{A}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">R:\mathcal{S}\times\mathcal{A}\to\mathbb{R}</annotation></semantics></math> is the reward function, where <math id="S2.Thmtheorem1.p1.m10" class="ltx_Math" alttext="R(s,a)" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R(s,a)</annotation></semantics></math> is the expected reward received after taking action <math id="S2.Thmtheorem1.p1.m11" class="ltx_Math" alttext="a\in\mathcal{A}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow><annotation encoding="application/x-tex">a\in\mathcal{A}</annotation></semantics></math> in state <math id="S2.Thmtheorem1.p1.m12" class="ltx_Math" alttext="s\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s\in\mathcal{S}</annotation></semantics></math>; <math id="S2.Thmtheorem1.p1.m13" class="ltx_Math" alttext="\alpha\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha\in[0,1]</annotation></semantics></math> is the discount factor, which determines the importance of future rewards relative to immediate rewards.</p>
</div>
</div>
<div id="S2.p2" class="ltx_para">
<p id="S2.p2.1" class="ltx_p">In the <span id="S2.p2.1.1" class="ltx_text ltx_font_smallcaps">rl</span> setting, a blue agent interacts with an environment over a sequence of time steps <math id="S2.p2.m1" class="ltx_Math" alttext="\{0,\ldots,T\}\triangleq[T]" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><mo stretchy="false">}</mo></mrow><mo>≜</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\{0,\ldots,T\}\triangleq[T]</annotation></semantics></math>. At each time step <math id="S2.p2.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, the agent observes the state of the environment <math id="S2.p2.m3" class="ltx_Math" alttext="s_{t}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mi>t</mi></msub><annotation encoding="application/x-tex">s_{t}</annotation></semantics></math> and selects an action <math id="S2.p2.m4" class="ltx_Math" alttext="a_{t}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>t</mi></msub><annotation encoding="application/x-tex">a_{t}</annotation></semantics></math> according to a policy <math id="S2.p2.m5" class="ltx_Math" alttext="\pi_{\theta}(a_{t}\mid s_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{\theta}(a_{t}\mid s_{t})</annotation></semantics></math>, parameterized by <math id="S2.p2.m6" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>. The policy <math id="S2.p2.m7" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> is a function that determines the appropriate action to take given the current state. Here, the state <math id="S2.p2.m8" class="ltx_Math" alttext="s_{t}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mi>t</mi></msub><annotation encoding="application/x-tex">s_{t}</annotation></semantics></math> encapsulates all relevant environmental information at time <math id="S2.p2.m9" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> and its distribution is governed by the network topology.</p>
</div>
<div id="S2.p3" class="ltx_para">
<p id="S2.p3.1" class="ltx_p">After executing the action <math id="S2.p3.m1" class="ltx_Math" alttext="a_{t}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>t</mi></msub><annotation encoding="application/x-tex">a_{t}</annotation></semantics></math>, the agent receives a reward <math id="S2.p3.m2" class="ltx_Math" alttext="r_{t}=R(s_{t},a_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>t</mi></msub><mo>=</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r_{t}=R(s_{t},a_{t})</annotation></semantics></math> from the environment, which quantifies the quality or desirability of the state-action pair <math id="S2.p3.m3" class="ltx_Math" alttext="(s_{t},a_{t})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(s_{t},a_{t})</annotation></semantics></math>. The agent’s objective is to learn a policy that maximizes the expected sum of discounted rewards over trajectories generated by the policy. A policy <math id="S2.p3.m4" class="ltx_Math" alttext="\pi^{*}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\pi^{*}</annotation></semantics></math> solves the <span id="S2.p3.1.1" class="ltx_text ltx_font_smallcaps">rl</span> <em id="S2.p3.1.2" class="ltx_emph ltx_font_italic">problem</em> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib19" title="" class="ltx_ref">Sutton, 2018</a>)</cite> by maximizing the expected cumulative reward in an <span id="S2.p3.1.3" class="ltx_text ltx_font_smallcaps">mdp</span> over a finite horizon <math id="S2.p3.m5" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>:</p>
<table id="S2.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E1.m1" class="ltx_Math" alttext="\pi^{*}=\argmax_{\pi}\mathbb{E}\left[\sum_{t=0}^{T}\alpha^{t}r_{t+1}\right]." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>π</mi><mo>∗</mo></msup><mo rspace="0.1389em">=</mo><mrow><mrow><msub><mo lspace="0.1389em" rspace="0.167em">argmax</mo><mi>π</mi></msub><mi>𝔼</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mi>T</mi></munderover><mrow><msup><mi>α</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\pi^{*}=\argmax_{\pi}\mathbb{E}\left[\sum_{t=0}^{T}\alpha^{t}r_{t+1}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(1)</span></td></tr></tbody>
</table>
<p id="S2.p3.2" class="ltx_p">An <span id="S2.p3.2.1" class="ltx_text ltx_font_smallcaps">rl</span> <em id="S2.p3.2.2" class="ltx_emph ltx_font_italic">algorithm</em> provides a method to compute or approximate <math id="S2.p3.m6" class="ltx_Math" alttext="\pi^{*}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\pi^{*}</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib7" title="" class="ltx_ref">Hammar &amp; Stadler, 2020</a>)</cite>. A widely used example of such an algorithm is <span id="S2.p3.2.3" class="ltx_text ltx_font_smallcaps">ppo</span>.</p>
</div>
<div id="S2.p4" class="ltx_para">
<p id="S2.p4.1" class="ltx_p">An example of the environmental state at time <math id="S2.p4.m1" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> is shown in <a href="#S2.F2.sf1" title="In Figure 2 ‣ 2 Preliminaries ‣ General Autonomous Cybersecurity Defense:Learning Robust Policies for Dynamic Topologies and Diverse Attackers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">2(a)</span></a>. Therein the ‘activity’ column gives us a high-level description (or indirect observation) of the red and green agents’ actions, but the ‘activity’ does not fully represent the explicit actions of all the interacting agents. Consequently, the true actions of the agents remain unobserved. As such we need to treat the problem as a partially observed <span id="S2.p4.1.1" class="ltx_text ltx_font_smallcaps">mdp</span> (<span id="S2.p4.1.2" class="ltx_text ltx_font_smallcaps">pomdp</span>) which is an extension of the <span id="S2.p4.1.3" class="ltx_text ltx_font_smallcaps">mdp</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib3" title="" class="ltx_ref">Åström, 1965</a>)</cite>. In the <span id="S2.p4.1.4" class="ltx_text ltx_font_smallcaps">pomdp</span> setting the agent does not directly observe <math id="S2.p4.m2" class="ltx_Math" alttext="s\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s\in\mathcal{S}</annotation></semantics></math> but instead the agent receives observations <math id="S2.p4.m3" class="ltx_Math" alttext="o\in\mathcal{O}" display="inline" intent=":literal"><semantics><mrow><mi>o</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi></mrow><annotation encoding="application/x-tex">o\in\mathcal{O}</annotation></semantics></math> that provide partial or noisy information about the state. Formally, a <span id="S2.p4.1.5" class="ltx_text ltx_font_smallcaps">pomdp</span> is a tuple <math id="S2.p4.m4" class="ltx_Math" alttext="\langle\mathcal{S},\mathcal{A},P,R,\mathcal{O},\Lambda,\alpha\rangle" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟨</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi>P</mi><mo>,</mo><mi>R</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>,</mo><mi mathvariant="normal">Λ</mi><mo>,</mo><mi>α</mi></mrow><mo stretchy="false">⟩</mo></mrow><annotation encoding="application/x-tex">\langle\mathcal{S},\mathcal{A},P,R,\mathcal{O},\Lambda,\alpha\rangle</annotation></semantics></math> where <math id="S2.p4.m5" class="ltx_Math" alttext="\Lambda:\mathcal{S}\times\mathcal{A}\times\mathcal{O}\to[0,1]" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Lambda:\mathcal{S}\times\mathcal{A}\times\mathcal{O}\to[0,1]</annotation></semantics></math> is the observation probability function, where <math id="S2.p4.m6" class="ltx_Math" alttext="\Lambda(o\mid s^{\prime},a)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msup><mi>s</mi><mo>′</mo></msup><mo>,</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Lambda(o\mid s^{\prime},a)</annotation></semantics></math> represents the probability of observing <math id="S2.p4.m7" class="ltx_Math" alttext="o\in\mathcal{O}" display="inline" intent=":literal"><semantics><mrow><mi>o</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi></mrow><annotation encoding="application/x-tex">o\in\mathcal{O}</annotation></semantics></math> given that the environment transitions to state <math id="S2.p4.m8" class="ltx_Math" alttext="s^{\prime}\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><msup><mi>s</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s^{\prime}\in\mathcal{S}</annotation></semantics></math> after taking action <math id="S2.p4.m9" class="ltx_Math" alttext="a\in\mathcal{A}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow><annotation encoding="application/x-tex">a\in\mathcal{A}</annotation></semantics></math>.</p>
</div>
<section id="S2.SS0.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Treating <span id="S2.SS0.SSS0.Px1.1" class="ltx_text ltx_font_smallcaps">it</span> infrastructure as a graph</h5>

<div id="S2.SS0.SSS0.Px1.p1" class="ltx_para">
<p id="S2.SS0.SSS0.Px1.p1.1" class="ltx_p">An <span id="S2.SS0.SSS0.Px1.p1.1.1" class="ltx_text ltx_font_smallcaps">it</span> infrastructure is naturally represented as a graph, where nodes correspond to network elements (e.g. servers, routers and end-points) and edges capture their connections. Attributes like firewall strength, bandwidth and security levels are encoded as node or edge features, enabling a structured and interpretable analysis. The directed nature of the graph aligns with real-world <span id="S2.SS0.SSS0.Px1.p1.1.2" class="ltx_text ltx_font_smallcaps">it</span> systems, reflecting directional relationships such as data flow and access controls imposed by network administrators. Consequently, let <math id="S2.SS0.SSS0.Px1.p1.m1" class="ltx_Math" alttext="G=(\mathbf{V},\mathbf{E})" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>𝐕</mi><mo>,</mo><mi>𝐄</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G=(\mathbf{V},\mathbf{E})</annotation></semantics></math> denote a graph with a set of vertices <math id="S2.SS0.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\mathbf{V}=\{V_{1},\ldots,V_{N}\},N=|\mathbf{V}|" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐕</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>V</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>V</mi><mi>N</mi></msub><mo stretchy="false">}</mo></mrow></mrow><mo>,</mo><mrow><mi>N</mi><mo>=</mo><mrow><mo stretchy="false">|</mo><mi>𝐕</mi><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{V}=\{V_{1},\ldots,V_{N}\},N=|\mathbf{V}|</annotation></semantics></math> and a set of directed edges <math id="S2.SS0.SSS0.Px1.p1.m3" class="ltx_Math" alttext="\mathbf{E}\subseteq\mathbf{V}\times\mathbf{V}" display="inline" intent=":literal"><semantics><mrow><mi>𝐄</mi><mo>⊆</mo><mrow><mi>𝐕</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝐕</mi></mrow></mrow><annotation encoding="application/x-tex">\mathbf{E}\subseteq\mathbf{V}\times\mathbf{V}</annotation></semantics></math>. Let the feature vector associated with node <math id="S2.SS0.SSS0.Px1.p1.m4" class="ltx_Math" alttext="V_{i}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>i</mi></msub><annotation encoding="application/x-tex">V_{i}</annotation></semantics></math> be <math id="S2.SS0.SSS0.Px1.p1.m5" class="ltx_Math" alttext="\mathbf{x}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathbf{x}_{i}</annotation></semantics></math> which appears as a row in the node feature matrix <math id="S2.SS0.SSS0.Px1.p1.m6" class="ltx_Math" alttext="\mathbf{X}\in\mathbb{R}^{N\times m}" display="inline" intent=":literal"><semantics><mrow><mi>𝐗</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>m</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{X}\in\mathbb{R}^{N\times m}</annotation></semantics></math>, where there are <math id="S2.SS0.SSS0.Px1.p1.m7" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> features per node. The blue agent thus observes <math id="S2.SS0.SSS0.Px1.p1.m8" class="ltx_Math" alttext="o\in\mathcal{O}=(\mathbf{V},\mathbf{E},\mathbf{X})" display="inline" intent=":literal"><semantics><mrow><mi>o</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>𝐕</mi><mo>,</mo><mi>𝐄</mi><mo>,</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">o\in\mathcal{O}=(\mathbf{V},\mathbf{E},\mathbf{X})</annotation></semantics></math> at each round.</p>
</div>
<div id="S2.SS0.SSS0.Px1.p2" class="ltx_para">
<p id="S2.SS0.SSS0.Px1.p2.1" class="ltx_p">As an example, consider the <span id="S2.SS0.SSS0.Px1.p2.1.1" class="ltx_text ltx_font_smallcaps">cc2</span> environment, shown in <a href="#S1.F1" title="In 1 Introduction ‣ General Autonomous Cybersecurity Defense:Learning Robust Policies for Dynamic Topologies and Diverse Attackers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">1</span></a>, with its state represented by <a href="#S2.F2.sf1" title="In Figure 2 ‣ 2 Preliminaries ‣ General Autonomous Cybersecurity Defense:Learning Robust Policies for Dynamic Topologies and Diverse Attackers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">2(a)</span></a>. We transform this state into a graph representation where the vertices of the graph are the hosts and subnets and the edges in the graph represent the interfaces between the subnets. The resultant graph is shown in <a href="#S2.F2.sf2" title="In Figure 2 ‣ 2 Preliminaries ‣ General Autonomous Cybersecurity Defense:Learning Robust Policies for Dynamic Topologies and Diverse Attackers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">2(b)</span></a>.</p>
</div>
</section>
<section id="S2.SS0.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Non-stationary <span id="S2.SS0.SSS0.Px2.1" class="ltx_text ltx_font_smallcaps">it</span> infrastructure</h5>

<div id="S2.SS0.SSS0.Px2.p1" class="ltx_para">
<p id="S2.SS0.SSS0.Px2.p1.1" class="ltx_p">An environment evolves as a consequence of agent actions, hence <math id="S2.SS0.SSS0.Px2.p1.m1" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> and <math id="S2.SS0.SSS0.Px2.p1.m2" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> model non-stationary distributions. <math id="S2.SS0.SSS0.Px2.p1.m3" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> and <math id="S2.SS0.SSS0.Px2.p1.m4" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> are fully determined by the connectivity of the network i.e. the topology of <math id="S2.SS0.SSS0.Px2.p1.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>. Due to the non-stationary nature of <math id="S2.SS0.SSS0.Px2.p1.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, we adopt the following definition to describe a dynamic graph. The (static) graph representation of the <span id="S2.SS0.SSS0.Px2.p1.1.1" class="ltx_text ltx_font_smallcaps">cc2</span> network is shown in <a href="#S2.F2.sf2" title="In Figure 2 ‣ 2 Preliminaries ‣ General Autonomous Cybersecurity Defense:Learning Robust Policies for Dynamic Topologies and Diverse Attackers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">2(b)</span></a>. Throughout we will use ‘graph’ and ‘network’ interchangeably to refer to the same object.</p>
</div>
<div id="S2.Thmtheorem2" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmtheorem2.2" class="ltx_text ltx_font_bold">Definition 2.2</span></span><span id="S2.Thmtheorem2.3" class="ltx_text ltx_font_bold"> </span>(Non-stationary graph)<span id="S2.Thmtheorem2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmtheorem2.p1" class="ltx_para">
<p id="S2.Thmtheorem2.p1.1" class="ltx_p">A non-stationary graph is a graph whose topology or properties change over time. Let <math id="S2.Thmtheorem2.p1.m1" class="ltx_Math" alttext="G_{t}=(\mathbf{V}_{t},\mathbf{E}_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>t</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐕</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝐄</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G_{t}=(\mathbf{V}_{t},\mathbf{E}_{t})</annotation></semantics></math> represent the graph at time <math id="S2.Thmtheorem2.p1.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, where: <math id="S2.Thmtheorem2.p1.m3" class="ltx_Math" alttext="\mathbf{V}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝐕</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathbf{V}_{t}</annotation></semantics></math> is the set of vertices (or nodes) at time <math id="S2.Thmtheorem2.p1.m4" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> and <math id="S2.Thmtheorem2.p1.m5" class="ltx_Math" alttext="\mathbf{E}_{t}\subseteq\mathbf{V}_{t}\times\mathbf{V}_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐄</mi><mi>t</mi></msub><mo>⊆</mo><mrow><msub><mi>𝐕</mi><mi>t</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝐕</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\mathbf{E}_{t}\subseteq\mathbf{V}_{t}\times\mathbf{V}_{t}</annotation></semantics></math> is the set of edges (or links) at time <math id="S2.Thmtheorem2.p1.m6" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>.
A non-stationary graph is then a time-dependent sequence of graphs <math id="S2.Thmtheorem2.p1.m7" class="ltx_Math" alttext="\mathbf{G}\triangleq\{G_{t}\}_{t\in[T]}" display="inline" intent=":literal"><semantics><mrow><mi>𝐆</mi><mo>≜</mo><msub><mrow><mo stretchy="false">{</mo><msub><mi>G</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbf{G}\triangleq\{G_{t}\}_{t\in[T]}</annotation></semantics></math>, where <math id="S2.Thmtheorem2.p1.m8" class="ltx_Math" alttext="t\in[T]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[T]</annotation></semantics></math> is the time domain and the following properties may change with time:</p>
<ol id="S2.I1" class="ltx_enumerate">
<li id="S2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="S2.I1.i1.p1" class="ltx_para">
<p id="S2.I1.i1.p1.1" class="ltx_p">Vertices <math id="S2.I1.i1.p1.m1" class="ltx_Math" alttext="\mathbf{V}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝐕</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathbf{V}_{t}</annotation></semantics></math>: nodes can appear, disappear or have attributes that change over time.</p>
</div></li>
<li id="S2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="S2.I1.i2.p1" class="ltx_para">
<p id="S2.I1.i2.p1.1" class="ltx_p">Edges <math id="S2.I1.i2.p1.m1" class="ltx_Math" alttext="\mathbf{E}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝐄</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathbf{E}_{t}</annotation></semantics></math>: edges can be created, removed or modified over time.</p>
</div></li>
</ol>
<p id="S2.Thmtheorem2.p1.2" class="ltx_p">The non-stationary nature of the topology refers to the dependence of the graph’s structure and properties on time, such that <math id="S2.Thmtheorem2.p1.m9" class="ltx_Math" alttext="G_{t}\neq G_{t^{\prime}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>t</mi></msub><mo>≠</mo><msub><mi>G</mi><msup><mi>t</mi><mo>′</mo></msup></msub></mrow><annotation encoding="application/x-tex">G_{t}\neq G_{t^{\prime}}</annotation></semantics></math> necessarily for some <math id="S2.Thmtheorem2.p1.m10" class="ltx_Math" alttext="t,t^{\prime}\in[T]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>,</mo><msup><mi>t</mi><mo>′</mo></msup></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t,t^{\prime}\in[T]</annotation></semantics></math>.</p>
</div>
</div>
<div id="S2.SS0.SSS0.Px2.p2" class="ltx_para">
<p id="S2.SS0.SSS0.Px2.p2.1" class="ltx_p">We seek a model which addresses two key challenges:</p>
<dl id="S2.I2" class="ltx_description">
<dt id="S2.I2.ix1" class="ltx_item"><span class="ltx_tag ltx_tag_item"><span id="S2.I2.ix1.1" class="ltx_text ltx_font_bold">Unpredictable topology changes</span></span></dt>
<dd class="ltx_item">
<div id="S2.I2.ix1.p1" class="ltx_para">
<p id="S2.I2.ix1.p1.1" class="ltx_p">Real-world <span id="S2.I2.ix1.p1.1.1" class="ltx_text ltx_font_smallcaps">it</span>/<span id="S2.I2.ix1.p1.1.2" class="ltx_text ltx_font_smallcaps">ot</span> networks experience constant topological shifts due to host activity, adversarial attacks and defensive actions. These changes create unpredictable dynamics that make training <span id="S2.I2.ix1.p1.1.3" class="ltx_text ltx_font_smallcaps">acd</span> agents difficult, as existing methods rely on fixed observation spaces or predefined defensive strategies.</p>
</div></dd>
<dt id="S2.I2.ix2" class="ltx_item"><span class="ltx_tag ltx_tag_item"><span id="S2.I2.ix2.1" class="ltx_text ltx_font_bold">Graph-based adaptation challenges</span></span></dt>
<dd class="ltx_item">
<div id="S2.I2.ix2.p1" class="ltx_para">
<p id="S2.I2.ix2.p1.1" class="ltx_p">While graph representation learning techniques encode network states as graph embeddings for decision-making, they struggle with out-of-distribution generalization. Large, unforeseen topology shifts –such as subnet isolation due to attacks or defensive actions– can significantly degrade agent performance.</p>
</div></dd>
</dl>
</div>
</section>
</section>
<section id="S3" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">3 </span>Related work</h2>

<div id="S3.p1" class="ltx_para">
<p id="S3.p1.1" class="ltx_p">We focus on research that studies <em id="S3.p1.1.1" class="ltx_emph ltx_font_italic">general</em> <span id="S3.p1.1.2" class="ltx_text ltx_font_smallcaps">acd</span> (<span id="S3.p1.1.3" class="ltx_text ltx_font_smallcaps">gacd</span>). There is a great deal of work that focuses on task-specific models, but few which can be carried between task in the general sense. To draw upon an analogy; we seek a model which, much like any software (e.g. antivirus), can be installed on any host or server and, with regular updates, requires minimal maintenance and can act autonomously to defend the target node. A model like that can handle dynamic network changes and a variety of attackers.</p>
</div>
<div id="S3.p2" class="ltx_para">
<p id="S3.p2.1" class="ltx_p">There exist many excellent review articles of recent <span id="S3.p2.1.1" class="ltx_text ltx_font_smallcaps">acd</span> efforts, see e.g. the paper by <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib24" title="" class="ltx_ref">Vyas et al. (2023)</a></cite> but they are silent on the types of work we describe above. Recent work by <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib14" title="" class="ltx_ref">Nyberg &amp; Johnson (2024)</a></cite> explores relational agent learning for automated incident response, where a message-passing neural network (<span id="S3.p2.1.2" class="ltx_text ltx_font_smallcaps">mpnn</span>) agent learns relationships between network elements rather than specific network structures, allowing them to adapt to network changes without retraining. Their model cannot handle a diversity of red agents and is only trained against one type (‘Meander’ from <span id="S3.p2.1.3" class="ltx_text ltx_font_smallcaps">cc2</span>) contrasting with the <span id="S3.p2.1.4" class="ltx_text ltx_font_smallcaps">gacd</span> approach which is designed to handle multiple types of red agents. To our knowledge, this is the only other work that explores <span id="S3.p2.1.5" class="ltx_text ltx_font_smallcaps">gacd</span>.</p>
</div>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4 </span>Method</h2>

<div id="S4.p1" class="ltx_para">
<p id="S4.p1.1" class="ltx_p">We introduce the key components of our <em id="S4.p1.1.1" class="ltx_emph ltx_font_italic">single-agent, multi-task</em> approach for <span id="S4.p1.1.2" class="ltx_text ltx_font_smallcaps">gacd</span> – an agent designed to defend against diverse attackers on previously unseen graph topologies. Three different variants of <span id="S4.p1.1.3" class="ltx_text ltx_font_smallcaps">gacd</span> are presented: <math id="S4.p1.m1" class="ltx_Math" alttext="\mathcal{M}_{1},\mathcal{M}_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>1</mn></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\mathcal{M}_{1},\mathcal{M}_{2}</annotation></semantics></math> and <math id="S4.p1.m2" class="ltx_Math" alttext="\mathcal{M}_{3}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>3</mn></msub><annotation encoding="application/x-tex">\mathcal{M}_{3}</annotation></semantics></math>.</p>
</div>
<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.1 </span>Embedding observations</h3>

<div id="S4.SS1.p1" class="ltx_para">
<p id="S4.SS1.p1.1" class="ltx_p">Given a set of graph observations <math id="S4.SS1.p1.m1" class="ltx_Math" alttext="\{G_{t}\}_{t\in[T]}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi>G</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\{G_{t}\}_{t\in[T]}</annotation></semantics></math>, we assume that topologies and states lie on a <math id="S4.SS1.p1.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>-dimensional manifold, allowing projections into lower-dimensional spaces. This aligns with the manifold distribution hypothesis (<span id="S4.SS1.p1.1.1" class="ltx_text ltx_font_smallcaps">mdh</span>), which states that natural data distributions are concentrated on a low-dimensional manifold within a high-dimensional space <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib11" title="" class="ltx_ref">Lei et al., 2019</a>; <a href="#bib.bib20" title="" class="ltx_ref">Tenenbaum et al., 2000</a>)</cite>. Learning this mapping enhances both understanding and reconstruction of the observation distribution. Once <math id="S4.SS1.p1.m3" class="ltx_Math" alttext="\mathbf{G}" display="inline" intent=":literal"><semantics><mi>𝐆</mi><annotation encoding="application/x-tex">\mathbf{G}</annotation></semantics></math> has been successfully embedded, a blue agent can use this latent manifold as its state representation <math id="S4.SS1.p1.m4" class="ltx_Math" alttext="s\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s\in\mathcal{S}</annotation></semantics></math>, facilitating the development of a policy that accounts for transitions between different regions of the state space in response to changes in network topology.</p>
</div>
<div id="S4.SS1.p2" class="ltx_para">
<p id="S4.SS1.p2.1" class="ltx_p">We design the space such that all variants associated with this topology (i.e. the different states associated with it) lie in its neighborhood and can be clustered together, represented by modes of different color (or high-density ‘blobs’) as shown in <a href="#S4.F3" title="In 4.1 Embedding observations ‣ 4 Method ‣ General Autonomous Cybersecurity Defense:Learning Robust Policies for Dynamic Topologies and Diverse Attackers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">3</span></a>. Similarly, a different network topology can be projected onto a different region of the space such that all similar topologies are clustered around this region and so on and so forth.</p>
</div>
