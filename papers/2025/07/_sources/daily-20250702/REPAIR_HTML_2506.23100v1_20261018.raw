              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.7.26.4" class="ltx_text ltx_font_bold" style="font-size:80%;">23</span></span>
            <span id="alg1.7.26.5" class="ltx_text" style="font-size:80%;">queryInput </span><math id="alg1.m14" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo mathsize="0.800em" stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math><span id="alg1.7.26.6" class="ltx_text" style="font-size:80%;"> concatenateInfo(bugCode, rootCause)</span>
</div>
<div id="alg1.7.27" class="ltx_listingline"><span id="alg1.7.27.1" class="ltx_text" style="font-size:80%;">  </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.7.27.2" class="ltx_text" style="font-size:80%;">    </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.7.27.3" class="ltx_text" style="font-size:80%;">  </span>
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.7.27.4" class="ltx_text ltx_font_bold" style="font-size:80%;">24</span></span>
            <span id="alg1.7.27.5" class="ltx_text" style="font-size:80%;">repairPattern </span><math id="alg1.m15" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo mathsize="0.800em" stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math><span id="alg1.7.27.6" class="ltx_text" style="font-size:80%;"> repair_pattern_retrieval_tool(queryInput)</span>
</div>
<div id="alg1.7.28" class="ltx_listingline"><span id="alg1.7.28.1" class="ltx_text" style="font-size:80%;">  </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.7.28.2" class="ltx_text" style="font-size:80%;">    </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.7.28.3" class="ltx_text" style="font-size:80%;">  </span>
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.7.28.4" class="ltx_text ltx_font_bold" style="font-size:80%;">25</span></span>
            <span id="alg1.7.28.5" class="ltx_text" style="font-size:80%;">repairsSuggestions </span><math id="alg1.m16" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo mathsize="0.800em" stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math><span id="alg1.7.28.6" class="ltx_text" style="font-size:80%;"> giveRepairSuggestions(bugCode, rootCause, repairPattern)</span>
</div>
