              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.7.25.3" class="ltx_text ltx_font_bold" style="font-size:80%;">22</span></span>
            <span id="alg1.7.25.4" class="ltx_text ltx_font_bold" style="font-size:80%;">Start</span><span id="alg1.7.25.5" class="ltx_text" style="font-size:80%;"> </span><em id="alg1.7.25.6" class="ltx_emph ltx_font_italic" style="font-size:80%;">Solution Phase</em><span id="alg1.7.25.7" class="ltx_text ltx_font_bold" style="font-size:80%;">:</span>
</div>
