<td id="S5.T5.4.1.4.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">❷ <span id="S5.T5.4.1.4.1.1" class="ltx_text ltx_font_smallcaps">ReinFix<sub id="S5.T5.4.1.4.1.1.1" class="ltx_sub"><span id="S5.T5.4.1.4.1.1.1.1" class="ltx_text ltx_font_italic">DN</span></sub></span></td>
