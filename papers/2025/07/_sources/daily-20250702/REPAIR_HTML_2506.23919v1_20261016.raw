<th id="S4.T2.5.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><span id="S4.T2.5.3.1.1" class="ltx_text ltx_font_bold">Grasping+Planning</span></th>
<td id="S4.T2.5.3.2" class="ltx_td ltx_align_center ltx_border_bb">10 / 50</td>
