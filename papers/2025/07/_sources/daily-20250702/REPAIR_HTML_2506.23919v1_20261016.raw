</table>
</figure>
<figure id="S4.T2" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="S4.T2.3" class="ltx_text" style="font-size:90%;">Table 2</span>: </span><span id="S4.T2.4" class="ltx_text" style="font-size:90%;">Zero-shot low-level policy evaluation results in simulation</span></figcaption>
<table id="S4.T2.5" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S4.T2.5.1" class="ltx_tr">
<th id="S4.T2.5.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt">Method</th>
<th id="S4.T2.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Task1</th>
<th id="S4.T2.5.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Task2</th>
<th id="S4.T2.5.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Task3</th>
<th id="S4.T2.5.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Task4</th>
<th id="S4.T2.5.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Average Success Rate</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T2.5.2" class="ltx_tr">
<th id="S4.T2.5.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Octo</th>
<td id="S4.T2.5.2.2" class="ltx_td ltx_align_center ltx_border_t">0 / 50</td>
<td id="S4.T2.5.2.3" class="ltx_td ltx_align_center ltx_border_t">0 / 50</td>
<td id="S4.T2.5.2.4" class="ltx_td ltx_align_center ltx_border_t">0 / 50</td>
<td id="S4.T2.5.2.5" class="ltx_td ltx_align_center ltx_border_t">0 / 50</td>
<td id="S4.T2.5.2.6" class="ltx_td ltx_align_center ltx_border_t">0%</td></tr>
