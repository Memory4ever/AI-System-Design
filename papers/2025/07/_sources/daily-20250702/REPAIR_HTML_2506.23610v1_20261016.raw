<th id="S4.T1.2.1.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">GPT-4o</th>
<th id="S4.T1.2.1.10.2" class="ltx_td ltx_align_left ltx_th ltx_th_row">Expanded</th>
<th id="S4.T1.2.1.10.3" class="ltx_td ltx_align_center ltx_th ltx_th_row">0.7</th>
<td id="S4.T1.2.1.10.4" class="ltx_td ltx_align_center">24</td>
