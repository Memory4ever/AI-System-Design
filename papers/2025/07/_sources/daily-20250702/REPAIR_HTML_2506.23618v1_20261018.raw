<td id="S4.T3.3.16.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T3.3.16.2.1" class="ltx_text" style="font-size:80%;">141</span></td>
<td id="S4.T3.3.16.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S4.T3.3.16.3.1" class="ltx_text" style="font-size:80%;">91</span></td>
