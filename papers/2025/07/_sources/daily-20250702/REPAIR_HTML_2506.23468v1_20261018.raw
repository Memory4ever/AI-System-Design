<td id="S3.T1.7.1.2.12" class="ltx_td ltx_align_center" style="--ltx-bg-color:#DFDFDF;"><span id="S3.T1.7.1.2.12.1" class="ltx_text" style="--ltx-bg-color:#DFDFDF;">SPL</span></td>
<td id="S3.T1.7.1.2.13" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FFBFBF;"><span id="S3.T1.7.1.2.13.1" class="ltx_text" style="--ltx-bg-color:#FFBFBF;">TL <math id="S3.T1.m5" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#FFBFBF;" mathbackground="#FFBFBF" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S3.T1.7.1.2.14" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FFBFBF;"><span id="S3.T1.7.1.2.14.1" class="ltx_text" style="--ltx-bg-color:#FFBFBF;">NE <math id="S3.T1.m6" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#FFBFBF;" mathbackground="#FFBFBF" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S3.T1.7.1.2.15" class="ltx_td ltx_align_center" style="--ltx-bg-color:#DFDFDF;"><span id="S3.T1.7.1.2.15.1" class="ltx_text" style="--ltx-bg-color:#DFDFDF;">OSR</span></td>
<td id="S3.T1.7.1.2.16" class="ltx_td ltx_align_center" style="--ltx-bg-color:#DFDFDF;"><span id="S3.T1.7.1.2.16.1" class="ltx_text" style="--ltx-bg-color:#DFDFDF;">SR</span></td>
