<td id="S3.T1.7.1.2.3" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FFBFBF;"><span id="S3.T1.7.1.2.3.1" class="ltx_text" style="--ltx-bg-color:#FFBFBF;">TL <math id="S3.T1.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#FFBFBF;" mathbackground="#FFBFBF" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S3.T1.7.1.2.4" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FFBFBF;"><span id="S3.T1.7.1.2.4.1" class="ltx_text" style="--ltx-bg-color:#FFBFBF;">NE <math id="S3.T1.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#FFBFBF;" mathbackground="#FFBFBF" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
