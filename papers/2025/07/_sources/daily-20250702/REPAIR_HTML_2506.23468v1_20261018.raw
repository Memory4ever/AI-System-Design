<td id="S3.T1.7.1.2.10" class="ltx_td ltx_align_center" style="--ltx-bg-color:#DFDFDF;"><span id="S3.T1.7.1.2.10.1" class="ltx_text" style="--ltx-bg-color:#DFDFDF;">OSR</span></td>
