<td id="S4.T1.5.1.7.7" class="ltx_td ltx_align_right">0.83</td>
<td id="S4.T1.5.1.7.8" class="ltx_td ltx_align_right">0.57</td>
<td id="S4.T1.5.1.7.9" class="ltx_td ltx_align_right">0.56</td>
