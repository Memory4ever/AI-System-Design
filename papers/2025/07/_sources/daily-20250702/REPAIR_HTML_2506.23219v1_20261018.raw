<td id="S12.T9.5.1.3.3" class="ltx_td ltx_align_center">0.1876</td>
<td id="S12.T9.5.1.3.4" class="ltx_td ltx_align_center">0.6833<math id="S12.T9.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="S12.T9.5.1.3.5" class="ltx_td ltx_align_center">0.4800<math id="S12.T9.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="S12.T9.5.1.3.6" class="ltx_td ltx_align_center">0.3800<math id="S12.T9.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td></tr>
<tr id="S12.T9.5.1.4" class="ltx_tr">
