<div id="S9.T6.11" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:496.9pt;height:122.9pt;vertical-align:-60.2pt;"><span class="ltx_transformed_inner" style="transform:translate(-146.2pt,36.2pt) scale(0.629540006953135,0.629540006953135) ;">
