<td id="S2.T1.6.1.7.3" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;">Geo+SS</td>
<td id="S2.T1.6.1.7.4" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;">Accuracy</td>
<td id="S2.T1.6.1.7.5" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;">200</td>
<td id="S2.T1.6.1.7.6" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;">UrBench</td></tr>
