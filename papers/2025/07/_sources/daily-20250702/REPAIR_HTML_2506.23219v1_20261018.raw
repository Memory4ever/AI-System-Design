</figure>
<figure id="S15.F26" class="ltx_figure"><span class="ltx_inline-block"><svg id="S15.F26.pic1" class="ltx_picture ltx_centering" height="1508.45" overflow="visible" version="1.1" viewBox="0 0 687.5 1508.45" width="687.5"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,1508.45) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#404040;" fill="#404040" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 1502.54 C 0 1505.81 2.64 1508.45 5.91 1508.45 L 681.59 1508.45 C 684.86 1508.45 687.5 1505.81 687.5 1502.54 L 687.5 5.91 C 687.5 2.64 684.86 0 681.59 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#F2F2F2;" fill="#F2F2F2" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 1502.54 C 1.97 1504.72 3.73 1506.48 5.91 1506.48 L 681.59 1506.48 C 683.77 1506.48 685.53 1504.72 685.53 1502.54 L 685.53 5.91 C 685.53 3.73 683.77 1.97 681.59 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g style="--ltx-stroke-color:#404040;--ltx-fill-color:#404040;--ltx-fg-color:#404040;" color="#404040" fill="#404040" stroke="#404040" stroke-dasharray="2.84528pt,2.84528pt" stroke-dashoffset="1.42264pt" stroke-opacity="1.0"><path style="fill:none" d="M 1.97 1340.41 L 685.53 1340.41"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 1352.23)"><foreignObject style="--ltx-fo-width:46.56em;--ltx-fo-height:10.29em;--ltx-fo-depth:0em;font-size:10pt;" height="142.45" overflow="visible" transform="matrix(1 0 0 -1 0 142.45)" width="644.26"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
