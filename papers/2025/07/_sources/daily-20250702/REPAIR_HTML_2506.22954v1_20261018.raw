<td id="S2.T2.4.3.7" class="ltx_td ltx_align_center"><span id="S2.T2.4.3.7.1" class="ltx_text" style="font-size:70%;">5</span></td>
<td id="S2.T2.4.3.8" class="ltx_td ltx_align_center"><span id="S2.T2.4.3.8.1" class="ltx_text" style="font-size:70%;">3</span></td>
