<td id="S5.T6.11.1.4.3" class="ltx_td ltx_align_center"><span id="S5.T6.11.1.4.3.1" class="ltx_text" style="font-size:144%;">35.09</span></td>
<td id="S5.T6.11.1.4.4" class="ltx_td ltx_align_center"><span id="S5.T6.11.1.4.4.1" class="ltx_text" style="font-size:144%;">46.83</span></td>
<td id="S5.T6.11.1.4.5" class="ltx_td ltx_align_center"><span id="S5.T6.11.1.4.5.1" class="ltx_text" style="font-size:144%;">70.58</span></td>
<td id="S5.T6.11.1.4.6" class="ltx_td ltx_align_center"><span id="S5.T6.11.1.4.6.1" class="ltx_text" style="font-size:144%;">48.50</span></td>
<td id="S5.T6.11.1.4.7" class="ltx_td ltx_align_center"><span id="S5.T6.11.1.4.7.1" class="ltx_text" style="font-size:144%;">57.16</span></td></tr>
<tr id="S5.T6.11.1.5" class="ltx_tr">
<th id="S5.T6.11.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S5.T6.11.1.5.1.1" class="ltx_text" style="font-size:144%;">FT </span><math id="S5.T6.m14" class="ltx_Math" alttext="[V_{p},\mathcal{F}_{\text{mask}},P_{0}]" display="inline" intent=":literal"><semantics><mrow><mo maxsize="1.440em" minsize="1.440em">[</mo><mrow><msub><mi mathsize="1.440em">V</mi><mi mathsize="1.440em">p</mi></msub><mo mathsize="1.440em">,</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="1.440em">ℱ</mi><mtext mathsize="1.440em">mask</mtext></msub><mo mathsize="1.440em">,</mo><msub><mi mathsize="1.440em">P</mi><mn mathsize="1.440em">0</mn></msub></mrow><mo maxsize="1.440em" minsize="1.440em">]</mo></mrow><annotation encoding="application/x-tex">[V_{p},\mathcal{F}_{\text{mask}},P_{0}]</annotation></semantics></math></th>
