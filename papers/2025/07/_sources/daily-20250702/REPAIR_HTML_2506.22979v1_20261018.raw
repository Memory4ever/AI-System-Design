<th id="S5.T2.8.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="3"><span id="S5.T2.8.1.1.2.1" class="ltx_text ltx_font_bold" style="font-size:144%;">1-shot</span></th>
<th id="S5.T2.8.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="3"><span id="S5.T2.8.1.1.3.1" class="ltx_text ltx_font_bold" style="font-size:144%;">5-shot</span></th></tr>
<tr id="S5.T2.8.1.2" class="ltx_tr">
<th id="S5.T2.8.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="S5.T2.m1" class="ltx_Math" alttext="\emph{m}\text{IoU}_{\mathcal{B}}" display="inline" intent=":literal"><semantics><mrow><mrow></mrow><mo lspace="0em" rspace="0.222em">​</mo><mi mathsize="1.440em">m</mi><mo lspace="0em" rspace="0em">​</mo><msub><mtext class="ltx_mathvariant_bold" mathsize="1.440em">IoU</mtext><mi class="ltx_font_mathcaligraphic" mathsize="1.440em">ℬ</mi></msub></mrow><annotation encoding="application/x-tex">\emph{m}\text{IoU}_{\mathcal{B}}</annotation></semantics></math></th>
