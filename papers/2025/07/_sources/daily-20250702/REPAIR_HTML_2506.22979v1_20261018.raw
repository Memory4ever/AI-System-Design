<th id="S5.T5.8.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_tt" rowspan="2"><span id="S5.T5.8.1.1.2.1" class="ltx_text ltx_font_bold" style="font-size:144%;">Text</span></th>
<th id="S5.T5.8.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="3"><span id="S5.T5.8.1.1.3.1" class="ltx_text ltx_font_bold" style="font-size:144%;">1-shot</span></th>
<th id="S5.T5.8.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="3"><span id="S5.T5.8.1.1.4.1" class="ltx_text ltx_font_bold" style="font-size:144%;">5-shot</span></th></tr>
