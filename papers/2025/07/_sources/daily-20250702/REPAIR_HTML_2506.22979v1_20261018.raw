<td id="S5.T6.11.1.6.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T6.11.1.6.2.1" class="ltx_text ltx_font_bold" style="font-size:144%;--ltx-bg-color:#E6E6E6;">76.68</span></td>
<td id="S5.T6.11.1.6.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T6.11.1.6.3.1" class="ltx_text ltx_font_bold" style="font-size:144%;--ltx-bg-color:#E6E6E6;">52.70</span></td>
