<td id="S5.T6.11.1.6.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T6.11.1.6.5.1" class="ltx_text ltx_font_bold" style="font-size:144%;--ltx-bg-color:#E6E6E6;">76.31</span></td>
