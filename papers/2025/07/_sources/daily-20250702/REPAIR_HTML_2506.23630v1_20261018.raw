              </XMath>
            </Math></foreignObject></g></g><g transform="translate(323.91,150.31)"><g transform="translate(0,7.70) scale(1,-1)"><foreignObject width="21.78" height="7.70" overflow="visible"><Math mode="inline" tex="6-1" text="6 - 1" xml:id="S4.F7.pic1.m6">
              <XMath xml:id="S4.F7.pic1.m6.1">
