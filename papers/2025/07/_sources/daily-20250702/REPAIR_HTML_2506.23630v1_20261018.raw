                </XMApp>
              </XMath>
            </Math></foreignObject></g></g><g transform="translate(274.37,150.31)"><g transform="translate(0,7.70) scale(1,-1)"><foreignObject width="21.78" height="7.70" overflow="visible"><Math mode="inline" tex="5-2" text="5 - 2" xml:id="S4.F7.pic1.m5">
              <XMath xml:id="S4.F7.pic1.m5.1">
                <XMApp xml:id="S4.F7.pic1.m5.1.1">
