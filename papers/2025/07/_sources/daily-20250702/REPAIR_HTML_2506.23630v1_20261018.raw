            </Math></foreignObject></g></g><g transform="translate(226.1,446.94)"><g transform="scale(1,-1)"><text fontsize="90%" xml:id="S7.F14.pic1.4">()</text></g><g transform="translate(0,12.09) scale(1,-1)"><foreignObject width="21.52" height="9.03" overflow="visible"><Math mode="inline" tex="\text{a}_{2}" text="[a] _ 2" xml:id="S7.F14.pic1.m2">
