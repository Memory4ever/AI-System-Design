              </XMath>
            </Math></foreignObject></g></g><g transform="translate(224.41,150.31)"><g transform="translate(0,7.70) scale(1,-1)"><foreignObject width="21.78" height="7.70" overflow="visible"><Math mode="inline" tex="4-3" text="4 - 3" xml:id="S4.F7.pic1.m4">
