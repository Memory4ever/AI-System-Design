            </Math></foreignObject></g></g><g transform="translate(126.18,150.31)"><g transform="translate(0,7.70) scale(1,-1)"><foreignObject width="21.78" height="7.70" overflow="visible"><Math mode="inline" tex="2-5" text="2 - 5" xml:id="S4.F7.pic1.m2">
