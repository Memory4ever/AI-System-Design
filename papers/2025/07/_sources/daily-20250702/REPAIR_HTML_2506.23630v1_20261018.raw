<th id="S7.T3.4.31.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><math id="S7.T3.m49" class="ltx_Math" alttext="{\texttt{UNET}}&lt;{\texttt{TEXTUAL}}" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">UNET</mtext><mo>&lt;</mo><mtext class="ltx_mathvariant_monospace">TEXTUAL</mtext></mrow><annotation encoding="application/x-tex">{\texttt{UNET}}&lt;{\texttt{TEXTUAL}}</annotation></semantics></math></th>
