            </Math></foreignObject></g></g><g transform="translate(-0.53,365.44)"><g transform="scale(1,-1)"><text fontsize="90%" xml:id="S7.F14.pic1.5">(b)</text></g></g><g transform="translate(226.1,391.73)"><g transform="scale(1,-1)"><text fontsize="90%" xml:id="S7.F14.pic1.6">()</text></g><g transform="translate(0,12.09) scale(1,-1)"><foreignObject width="22.18" height="9.03" overflow="visible"><Math mode="inline" tex="\text{b}_{1}" text="[b] _ 1" xml:id="S7.F14.pic1.m3">
              <XMath xml:id="S7.F14.pic1.m3.1">
                <XMApp xml:id="S7.F14.pic1.m3.1.1">
