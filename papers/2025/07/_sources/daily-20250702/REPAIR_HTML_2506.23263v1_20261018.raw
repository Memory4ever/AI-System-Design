<th id="S5.T5.3.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt" colspan="2"><span id="S5.T5.3.1.1.2.1" class="ltx_text ltx_font_bold" style="font-size:70%;">N2A</span><span id="S5.T5.3.1.1.2.2" class="ltx_text" style="font-size:70%;"> (BDD-A(2000))</span></th>
