<th id="A1.T7.2.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" style="padding-bottom: 3.87498pt;"><span id="A1.T7.2.1.2.1.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">Parameters</span></th>
<td id="A1.T7.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-bottom: 3.87498pt;"><math id="A1.T7.m1" class="ltx_Math" alttext="D(L(4HD_{h}+2D_{FF})+V)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">D</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mi mathsize="0.900em">L</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mn mathsize="0.900em">4</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">D</mi><mi mathsize="0.900em">h</mi></msub></mrow><mo mathsize="0.900em">+</mo><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">D</mi><mrow><mi mathsize="0.900em">F</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">F</mi></mrow></msub></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mi mathsize="0.900em">V</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(L(4HD_{h}+2D_{FF})+V)</annotation></semantics></math></td>
<td id="A1.T7.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-bottom: 3.87498pt;"><math id="A1.T7.m2" class="ltx_Math" alttext="R(2D_{k}(3L+1)+D_{v}(2LD_{FF}+V+N))" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">R</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">D</mi><mi mathsize="0.900em">k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mn mathsize="0.900em">3</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi></mrow><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><msub><mi mathsize="0.900em">D</mi><mi mathsize="0.900em">v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">D</mi><mrow><mi mathsize="0.900em">F</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">F</mi></mrow></msub></mrow><mo mathsize="0.900em">+</mo><mi mathsize="0.900em">V</mi><mo mathsize="0.900em">+</mo><mi mathsize="0.900em">N</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">R(2D_{k}(3L+1)+D_{v}(2LD_{FF}+V+N))</annotation></semantics></math></td></tr>
<tr id="A1.T7.2.1.3" class="ltx_tr">
<th id="A1.T7.2.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb"><span id="A1.T7.2.1.3.1.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">FLOPS</span></th>
<td id="A1.T7.2.1.3.2" class="ltx_td ltx_align_center ltx_border_bb"><math id="A1.T7.m3" class="ltx_Math" alttext="4N(V+LD(2D_{h}H+D_{FF})+L(ND_{h}H+\frac{3}{4}NH))" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">4</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">V</mi><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">D</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">D</mi><mi mathsize="0.900em">h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">H</mi></mrow><mo mathsize="0.900em">+</mo><msub><mi mathsize="0.900em">D</mi><mrow><mi mathsize="0.900em">F</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">F</mi></mrow></msub></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">L</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mi mathsize="0.900em">N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">D</mi><mi mathsize="0.900em">h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">H</mi></mrow><mo mathsize="0.900em">+</mo><mrow><mfrac><mn mathsize="0.900em">3</mn><mn mathsize="0.900em">4</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">N</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">H</mi></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">4N(V+LD(2D_{h}H+D_{FF})+L(ND_{h}H+\frac{3}{4}NH))</annotation></semantics></math></td>
<td id="A1.T7.2.1.3.3" class="ltx_td ltx_align_center ltx_border_bb"><math id="A1.T7.m4" class="ltx_Math" alttext="6NRD_{K}D_{v}(1+L)+NR(4VD_{v}+L(4ND_{v}+3N+4D_{v}D_{FF}))" display="inline" intent=":literal"><semantics><mrow><mrow><mn mathsize="0.900em">6</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">N</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">R</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">D</mi><mi mathsize="0.900em">K</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">D</mi><mi mathsize="0.900em">v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">+</mo><mi mathsize="0.900em">L</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">N</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">R</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mn mathsize="0.900em">4</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">V</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">D</mi><mi mathsize="0.900em">v</mi></msub></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">L</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mn mathsize="0.900em">4</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">D</mi><mi mathsize="0.900em">v</mi></msub></mrow><mo mathsize="0.900em">+</mo><mrow><mn mathsize="0.900em">3</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">N</mi></mrow><mo mathsize="0.900em">+</mo><mrow><mn mathsize="0.900em">4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">D</mi><mi mathsize="0.900em">v</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">D</mi><mrow><mi mathsize="0.900em">F</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">F</mi></mrow></msub></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">6NRD_{K}D_{v}(1+L)+NR(4VD_{v}+L(4ND_{v}+3N+4D_{v}D_{FF}))</annotation></semantics></math></td></tr>
</tbody>
</table>
</span></div>
</figure>
</section>
</section>
<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Moment Propagation Derivation</h2>

<div id="A2.p1" class="ltx_para">
<p id="A2.p1.1" class="ltx_p">Here we modify the derivations from <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib31" title="" class="ltx_ref">Kedia et al., 2024</a>)</cite> to derive the mean and variance propagation equations for the RMT’s storage and retrival operations.</p>
</div>
<section id="A2.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.1 </span>Storage</h3>

<div id="A2.SS1.p1" class="ltx_para">
<p id="A2.SS1.p1.1" class="ltx_p">For <math id="A2.SS1.p1.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> input data vectors <math id="A2.SS1.p1.m2" class="ltx_Math" alttext="{\bm{x}}_{\textrm{in}}^{(h)}\in\mathbb{R}^{D_{v}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝒙</mi><mtext>in</mtext><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>D</mi><mi>v</mi></msub></msup></mrow><annotation encoding="application/x-tex">{\bm{x}}_{\textrm{in}}^{(h)}\in\mathbb{R}^{D_{v}}</annotation></semantics></math> and an output matrix <math id="A2.SS1.p1.m3" class="ltx_Math" alttext="{\bm{X}}_{\textrm{out}}\in\mathbb{R}^{D_{k}\times D_{v}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑿</mi><mtext>out</mtext></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>D</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>D</mi><mi>v</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{X}}_{\textrm{out}}\in\mathbb{R}^{D_{k}\times D_{v}}</annotation></semantics></math>, the forward pass operation for a single token is defined as follows.</p>
<table id="A2.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex5.m1" class="ltx_Math" alttext="\displaystyle\displaystyle{\bm{X}}_{\textrm{out}}" display="inline" intent=":literal"><semantics><msub><mi>𝑿</mi><mtext>out</mtext></msub><annotation encoding="application/x-tex">\displaystyle\displaystyle{\bm{X}}_{\textrm{out}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex5.m2" class="ltx_Math" alttext="\displaystyle=\sum^{R}_{h=1}{\bm{w}}^{(h)}\otimes{\bm{x}}_{\textrm{in}}^{(h)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>R</mi></munderover></mstyle><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>𝒙</mi><mtext>in</mtext><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum^{R}_{h=1}{\bm{w}}^{(h)}\otimes{\bm{x}}_{\textrm{in}}^{(h)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex6.m1" class="ltx_Math" alttext="\displaystyle=\sum^{R}_{h=1}{\bm{w}}^{(h)}{\bm{x}}_{\textrm{in}}^{(h)T}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>R</mi></munderover></mstyle><mrow><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒙</mi><mtext>in</mtext><mrow><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum^{R}_{h=1}{\bm{w}}^{(h)}{\bm{x}}_{\textrm{in}}^{(h)T}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p1.2" class="ltx_p">The backward pass operation is then defined as follows.</p>
<table id="A2.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex7.m1" class="ltx_Math" alttext="\displaystyle\displaystyle{\bm{g}}_{\textrm{in}}^{(h)}" display="inline" intent=":literal"><semantics><msubsup><mi>𝒈</mi><mtext>in</mtext><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\displaystyle\displaystyle{\bm{g}}_{\textrm{in}}^{(h)}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex7.m2" class="ltx_Math" alttext="\displaystyle={\bm{w}}^{(h)T}{\bm{G}}_{out}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>𝒘</mi><mrow><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑮</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\bm{w}}^{(h)T}{\bm{G}}_{out}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p1.3" class="ltx_p">For the expected value of the forward pass, we have,</p>
<table id="A2.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex8.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathbb{E}[{\bm{X}}_{\textrm{out}_{ij}}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>𝑿</mi><msub><mtext>out</mtext><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathbb{E}[{\bm{X}}_{\textrm{out}_{ij}}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex8.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}[\sum^{R}_{h=1}{\bm{w}}^{(h)}_{i}{\bm{x}}_{\textrm{in}_{j}}^{(h)}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>R</mi></munderover></mstyle><mrow><msubsup><mi>𝒘</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒙</mi><msub><mtext>in</mtext><mi>j</mi></msub><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[\sum^{R}_{h=1}{\bm{w}}^{(h)}_{i}{\bm{x}}_{\textrm{in}_{j}}^{(h)}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex9.m1" class="ltx_Math" alttext="\displaystyle=\sum^{R}_{h=1}\mathbb{E}[{\bm{w}}^{(h)}_{i}{\bm{x}}_{\textrm{in}_{j}}^{(h)}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>R</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝒘</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒙</mi><msub><mtext>in</mtext><mi>j</mi></msub><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum^{R}_{h=1}\mathbb{E}[{\bm{w}}^{(h)}_{i}{\bm{x}}_{\textrm{in}_{j}}^{(h)}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex10.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum^{R}_{h=1}\mathbb{E}[{\bm{w}}^{(h)}_{i}]\mathbb{E}[{\bm{x}}_{\textrm{in}_{j}}^{(h)}]\quad\textrm{(by ind.)}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>R</mi></munderover></mstyle><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msubsup><mi>𝒘</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">]</mo></mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msubsup><mi>𝒙</mi><msub><mtext>in</mtext><mi>j</mi></msub><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">]</mo></mrow><mtext>(by ind.)</mtext></mrow><annotation encoding="application/x-tex">\displaystyle=\sum^{R}_{h=1}\mathbb{E}[{\bm{w}}^{(h)}_{i}]\mathbb{E}[{\bm{x}}_{\textrm{in}_{j}}^{(h)}]\quad\textrm{(by ind.)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex11.m1" class="ltx_Math" alttext="\displaystyle=\sum^{R}_{h=1}\mathbb{E}[{\bm{w}}^{(h)}_{i}]\mathbb{E}[{\bm{x}}_{\textrm{in}_{j}}^{(h)}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>R</mi></munderover></mstyle><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>𝒘</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>𝒙</mi><msub><mtext>in</mtext><mi>j</mi></msub><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum^{R}_{h=1}\mathbb{E}[{\bm{w}}^{(h)}_{i}]\mathbb{E}[{\bm{x}}_{\textrm{in}_{j}}^{(h)}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex12.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum^{R}_{h=1}0\times\mathbb{E}[{\bm{x}}_{\textrm{in}_{j}}^{(h)}]\quad\textrm{(w is initialized with mean 0)}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>R</mi></munderover></mstyle><mn>0</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msubsup><mi>𝒙</mi><msub><mtext>in</mtext><mi>j</mi></msub><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">]</mo></mrow><mtext>(w is initialized with mean 0)</mtext></mrow><annotation encoding="application/x-tex">\displaystyle=\sum^{R}_{h=1}0\times\mathbb{E}[{\bm{x}}_{\textrm{in}_{j}}^{(h)}]\quad\textrm{(w is initialized with mean 0)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex13.m1" class="ltx_Math" alttext="\displaystyle=0" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p1.4" class="ltx_p">For the variance of the forward pass we have,</p>
<table id="A2.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex14.m1" class="ltx_Math" alttext="\displaystyle\displaystyle{\textnormal{Var}}({\bm{X}}_{\textrm{out}_{ij}})" display="inline" intent=":literal"><semantics><mrow><mtext>Var</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><msub><mtext>out</mtext><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle{\textnormal{Var}}({\bm{X}}_{\textrm{out}_{ij}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex14.m2" class="ltx_Math" alttext="\displaystyle={\textnormal{Var}}(\sum^{R}_{h=1}{\bm{w}}^{(h)}_{i}{\bm{x}}_{\textrm{in}_{j}}^{(h)})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mtext>Var</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>R</mi></munderover></mstyle><mrow><msubsup><mi>𝒘</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒙</mi><msub><mtext>in</mtext><mi>j</mi></msub><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\textnormal{Var}}(\sum^{R}_{h=1}{\bm{w}}^{(h)}_{i}{\bm{x}}_{\textrm{in}_{j}}^{(h)})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex15.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum^{R}_{h=1}{\textnormal{Var}}({\bm{w}}^{(h)}_{i}{\bm{x}}_{\textrm{in}_{j}}^{(h)})\quad\textrm{(by ind. of weights from each other)}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>R</mi></munderover></mstyle><mtext>Var</mtext><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒘</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><msubsup><mi>𝒙</mi><msub><mtext>in</mtext><mi>j</mi></msub><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mtext>(by ind. of weights from each other)</mtext></mrow><annotation encoding="application/x-tex">\displaystyle=\sum^{R}_{h=1}{\textnormal{Var}}({\bm{w}}^{(h)}_{i}{\bm{x}}_{\textrm{in}_{j}}^{(h)})\quad\textrm{(by ind. of weights from each other)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex16.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum^{R}_{h=1}((\sigma^{2}_{x_{\textrm{in}}}+\mu^{2}_{x_{\textrm{in}}})(\sigma^{2}_{w}+\mu^{2}_{w})-\mu^{2}_{x_{\textrm{in}}}\mu^{2}_{w})\quad\textrm{(by ind. of weights and inputs)}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>R</mi></munderover></mstyle><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>σ</mi><msub><mi>x</mi><mtext>in</mtext></msub><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>μ</mi><msub><mi>x</mi><mtext>in</mtext></msub><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>σ</mi><mi>w</mi><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>μ</mi><mi>w</mi><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msubsup><mi>μ</mi><msub><mi>x</mi><mtext>in</mtext></msub><mn>2</mn></msubsup><msubsup><mi>μ</mi><mi>w</mi><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow><mtext>(by ind. of weights and inputs)</mtext></mrow><annotation encoding="application/x-tex">\displaystyle=\sum^{R}_{h=1}((\sigma^{2}_{x_{\textrm{in}}}+\mu^{2}_{x_{\textrm{in}}})(\sigma^{2}_{w}+\mu^{2}_{w})-\mu^{2}_{x_{\textrm{in}}}\mu^{2}_{w})\quad\textrm{(by ind. of weights and inputs)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex17.m1" class="ltx_Math" alttext="\displaystyle=\sum^{R}_{h=1}(\sigma^{2}_{x_{\textrm{in}}}+\mu^{2}_{x_{\textrm{in}}})\sigma^{2}_{w}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>R</mi></munderover></mstyle><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>σ</mi><msub><mi>x</mi><mtext>in</mtext></msub><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>μ</mi><msub><mi>x</mi><mtext>in</mtext></msub><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>w</mi><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum^{R}_{h=1}(\sigma^{2}_{x_{\textrm{in}}}+\mu^{2}_{x_{\textrm{in}}})\sigma^{2}_{w}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex18.m1" class="ltx_Math" alttext="\displaystyle=R(\sigma^{2}_{x_{\textrm{in}}}+\mu^{2}_{x_{\textrm{in}}})\sigma^{2}_{w}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>σ</mi><msub><mi>x</mi><mtext>in</mtext></msub><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>μ</mi><msub><mi>x</mi><mtext>in</mtext></msub><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>w</mi><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=R(\sigma^{2}_{x_{\textrm{in}}}+\mu^{2}_{x_{\textrm{in}}})\sigma^{2}_{w}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p1.5" class="ltx_p">For the expected value of the backward pass we have,</p>
<table id="A2.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex19.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathbb{E}[{\bm{g}}_{\textrm{in}_{j}}^{(h)}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>𝒈</mi><msub><mtext>in</mtext><mi>j</mi></msub><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathbb{E}[{\bm{g}}_{\textrm{in}_{j}}^{(h)}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex19.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}[\sum^{D_{k}}_{i=1}{\bm{w}}^{(h)}_{i}{\bm{G}}_{\textrm{out}_{ij}}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>D</mi><mi>k</mi></msub></munderover></mstyle><mrow><msubsup><mi>𝒘</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑮</mi><msub><mtext>out</mtext><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[\sum^{D_{k}}_{i=1}{\bm{w}}^{(h)}_{i}{\bm{G}}_{\textrm{out}_{ij}}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex20.m1" class="ltx_Math" alttext="\displaystyle=\sum^{D_{k}}_{i=1}\mathbb{E}[{\bm{w}}^{(h)}_{i}{\bm{G}}_{\textrm{out}_{ij}}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>D</mi><mi>k</mi></msub></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝒘</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑮</mi><msub><mtext>out</mtext><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum^{D_{k}}_{i=1}\mathbb{E}[{\bm{w}}^{(h)}_{i}{\bm{G}}_{\textrm{out}_{ij}}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex21.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum^{D_{k}}_{i=1}\mathbb{E}[{\bm{w}}^{(h)}_{i}]\mathbb{E}[{\bm{G}}_{\textrm{out}_{ij}}]\quad\textrm{(by ind.)}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>D</mi><mi>k</mi></msub></munderover></mstyle><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msubsup><mi>𝒘</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">]</mo></mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>𝑮</mi><msub><mtext>out</mtext><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></msub><mo stretchy="false">]</mo></mrow><mtext>(by ind.)</mtext></mrow><annotation encoding="application/x-tex">\displaystyle=\sum^{D_{k}}_{i=1}\mathbb{E}[{\bm{w}}^{(h)}_{i}]\mathbb{E}[{\bm{G}}_{\textrm{out}_{ij}}]\quad\textrm{(by ind.)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex22.m1" class="ltx_Math" alttext="\displaystyle=0" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p1.6" class="ltx_p">And for the variance of the backwards path we have,</p>
<table id="A2.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex23.m1" class="ltx_Math" alttext="\displaystyle\displaystyle{\textnormal{Var}}({\bm{g}}_{\textrm{in}_{j}}^{(h)})" display="inline" intent=":literal"><semantics><mrow><mtext>Var</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒈</mi><msub><mtext>in</mtext><mi>j</mi></msub><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle{\textnormal{Var}}({\bm{g}}_{\textrm{in}_{j}}^{(h)})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex23.m2" class="ltx_Math" alttext="\displaystyle={\textnormal{Var}}(\sum^{D_{k}}_{i=1}{\bm{w}}^{(h)}_{i}{\bm{G}}_{\textrm{out}_{ij}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mtext>Var</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>D</mi><mi>k</mi></msub></munderover></mstyle><mrow><msubsup><mi>𝒘</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑮</mi><msub><mtext>out</mtext><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\textnormal{Var}}(\sum^{D_{k}}_{i=1}{\bm{w}}^{(h)}_{i}{\bm{G}}_{\textrm{out}_{ij}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex24.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum^{D_{k}}_{i=1}{\textnormal{Var}}({\bm{w}}^{(h)}_{i}{\bm{G}}_{\textrm{out}_{ij}})\quad\textrm{(by ind. of weights from each other)}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>D</mi><mi>k</mi></msub></munderover></mstyle><mtext>Var</mtext><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒘</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><msub><mi>𝑮</mi><msub><mtext>out</mtext><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></msub><mo stretchy="false">)</mo></mrow><mtext>(by ind. of weights from each other)</mtext></mrow><annotation encoding="application/x-tex">\displaystyle=\sum^{D_{k}}_{i=1}{\textnormal{Var}}({\bm{w}}^{(h)}_{i}{\bm{G}}_{\textrm{out}_{ij}})\quad\textrm{(by ind. of weights from each other)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex25.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum^{D_{k}}_{i=1}((\sigma^{2}_{G_{\textrm{out}}}+\mu^{2}_{G_{\textrm{out}}})(\sigma^{2}_{w}+\mu^{2}_{w})-\mu^{2}_{G_{\textrm{out}}}\mu^{2}_{w})\quad\textrm{(by ind. of weights and inputs)}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>D</mi><mi>k</mi></msub></munderover></mstyle><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>σ</mi><msub><mi>G</mi><mtext>out</mtext></msub><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>μ</mi><msub><mi>G</mi><mtext>out</mtext></msub><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>σ</mi><mi>w</mi><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>μ</mi><mi>w</mi><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msubsup><mi>μ</mi><msub><mi>G</mi><mtext>out</mtext></msub><mn>2</mn></msubsup><msubsup><mi>μ</mi><mi>w</mi><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow><mtext>(by ind. of weights and inputs)</mtext></mrow><annotation encoding="application/x-tex">\displaystyle=\sum^{D_{k}}_{i=1}((\sigma^{2}_{G_{\textrm{out}}}+\mu^{2}_{G_{\textrm{out}}})(\sigma^{2}_{w}+\mu^{2}_{w})-\mu^{2}_{G_{\textrm{out}}}\mu^{2}_{w})\quad\textrm{(by ind. of weights and inputs)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex26.m1" class="ltx_Math" alttext="\displaystyle=\sum^{D_{k}}_{i=1}(\sigma^{2}_{G_{\textrm{out}}}+\mu^{2}_{G_{\textrm{out}}})\sigma^{2}_{w}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>D</mi><mi>k</mi></msub></munderover></mstyle><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>σ</mi><msub><mi>G</mi><mtext>out</mtext></msub><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>μ</mi><msub><mi>G</mi><mtext>out</mtext></msub><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>w</mi><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum^{D_{k}}_{i=1}(\sigma^{2}_{G_{\textrm{out}}}+\mu^{2}_{G_{\textrm{out}}})\sigma^{2}_{w}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex27.m1" class="ltx_Math" alttext="\displaystyle=D_{k}(\sigma^{2}_{G_{\textrm{out}}}+\mu^{2}_{G_{\textrm{out}}})\sigma^{2}_{w}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>D</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>σ</mi><msub><mi>G</mi><mtext>out</mtext></msub><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>μ</mi><msub><mi>G</mi><mtext>out</mtext></msub><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>w</mi><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=D_{k}(\sigma^{2}_{G_{\textrm{out}}}+\mu^{2}_{G_{\textrm{out}}})\sigma^{2}_{w}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.2 </span>Retrieval</h3>

<div id="A2.SS2.p1" class="ltx_para">
<p id="A2.SS2.p1.1" class="ltx_p">For <math id="A2.SS2.p1.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> input matrix <math id="A2.SS2.p1.m2" class="ltx_Math" alttext="{\bm{X}}_{\textrm{in}}=\in\mathbb{R}^{D_{k}\times D_{v}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑿</mi><mtext>in</mtext></msub><mo>=</mo><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>D</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>D</mi><mi>v</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{X}}_{\textrm{in}}=\in\mathbb{R}^{D_{k}\times D_{v}}</annotation></semantics></math> and an output data vectors <math id="A2.SS2.p1.m3" class="ltx_Math" alttext="{\bm{x}}_{\textrm{out}}^{(h)}\in\mathbb{R}^{D_{v}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝒙</mi><mtext>out</mtext><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>D</mi><mi>v</mi></msub></msup></mrow><annotation encoding="application/x-tex">{\bm{x}}_{\textrm{out}}^{(h)}\in\mathbb{R}^{D_{v}}</annotation></semantics></math>, the forward pass operation for a single token is defined as follows.</p>
<table id="A2.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex28.m1" class="ltx_Math" alttext="\displaystyle\displaystyle{\bm{x}}_{\textrm{out}}^{(h)}" display="inline" intent=":literal"><semantics><msubsup><mi>𝒙</mi><mtext>out</mtext><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\displaystyle\displaystyle{\bm{x}}_{\textrm{out}}^{(h)}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex28.m2" class="ltx_Math" alttext="\displaystyle={\bm{w}}^{(h)}\cdot_{1}{\bm{X}}_{\textrm{in}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msup><msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>1</mn></msub><msub><mi>𝑿</mi><mtext>in</mtext></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\bm{w}}^{(h)}\cdot_{1}{\bm{X}}_{\textrm{in}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex29.m1" class="ltx_Math" alttext="\displaystyle={\bm{w}}^{(h)T}{\bm{X}}_{\textrm{in}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>𝒘</mi><mrow><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑿</mi><mtext>in</mtext></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\bm{w}}^{(h)T}{\bm{X}}_{\textrm{in}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p1.2" class="ltx_p">And for the backward pass we have,</p>
<table id="A2.EGx10" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex31.m1" class="ltx_Math" alttext="\displaystyle\displaystyle{\bm{G}}_{\textrm{in}}" display="inline" intent=":literal"><semantics><msub><mi>𝑮</mi><mtext>in</mtext></msub><annotation encoding="application/x-tex">\displaystyle\displaystyle{\bm{G}}_{\textrm{in}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex31.m2" class="ltx_Math" alttext="\displaystyle=\sum^{R}_{h=1}{\bm{w}}^{(h)}{\bm{g}}_{\textrm{out}}^{T}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>R</mi></munderover></mstyle><mrow><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒈</mi><mtext>out</mtext><mi>T</mi></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum^{R}_{h=1}{\bm{w}}^{(h)}{\bm{g}}_{\textrm{out}}^{T}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p1.3" class="ltx_p">Notice that the forward equation for retrieval is the same as the backward table for storage, and vice versa. Then we can follow the exact same derivations as in §<a href="#A2.SS1" title="B.1 Storage ‣ Appendix B Moment Propagation Derivation ‣ Residual Matrix Transformers: Scaling the Size of the Residual Stream" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1</span></a> to get,</p>
<table id="A2.EGx11" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex32.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathbb{E}[{\bm{x}}_{\textrm{out}}^{(h)}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>𝒙</mi><mtext>out</mtext><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathbb{E}[{\bm{x}}_{\textrm{out}}^{(h)}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex32.m2" class="ltx_Math" alttext="\displaystyle=0" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A2.EGx12" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex33.m1" class="ltx_Math" alttext="\displaystyle\displaystyle{\textnormal{Var}}({\bm{x}}_{\textrm{out}}^{(h)})" display="inline" intent=":literal"><semantics><mrow><mtext>Var</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒙</mi><mtext>out</mtext><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle{\textnormal{Var}}({\bm{x}}_{\textrm{out}}^{(h)})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex33.m2" class="ltx_Math" alttext="\displaystyle=d_{k}\sigma_{w}^{2}(\sigma_{X_{in}}^{2}+\mu_{X_{in}}^{2})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>d</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>w</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>σ</mi><msub><mi>X</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>μ</mi><msub><mi>X</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=d_{k}\sigma_{w}^{2}(\sigma_{X_{in}}^{2}+\mu_{X_{in}}^{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A2.EGx13" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex34.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathbb{E}[{\bm{G}}_{\textrm{in}}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>𝑮</mi><mtext>in</mtext></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathbb{E}[{\bm{G}}_{\textrm{in}}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex34.m2" class="ltx_Math" alttext="\displaystyle=0" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A2.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex35.m1" class="ltx_Math" alttext="\displaystyle\displaystyle{\textnormal{Var}}({\bm{G}}_{\textrm{in}})" display="inline" intent=":literal"><semantics><mrow><mtext>Var</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑮</mi><mtext>in</mtext></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle{\textnormal{Var}}({\bm{G}}_{\textrm{in}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex35.m2" class="ltx_Math" alttext="\displaystyle=R\sigma_{w}^{2}(\sigma_{g_{out}}^{2}+\mu_{g_{out}}^{2})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>w</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>σ</mi><msub><mi>g</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>μ</mi><msub><mi>g</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=R\sigma_{w}^{2}(\sigma_{g_{out}}^{2}+\mu_{g_{out}}^{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Experimental Setup</h2>

<section id="A3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.1 </span>Training Details</h3>

<div id="A3.SS1.p1" class="ltx_para">
<p id="A3.SS1.p1.1" class="ltx_p">All of our models are trained on the OpenWebText dataset and we use HuggingFace’s GPT2 tokenizer. The vocab size is therefore set to <math id="A3.SS1.p1.m1" class="ltx_Math" alttext="50257" display="inline" intent=":literal"><semantics><mn>50257</mn><annotation encoding="application/x-tex">50257</annotation></semantics></math> for all models. Learned positional embeddings are used, and unless otherwise specified, models are trained with a sequence length of 512 tokens. We use pre-LayerNorm with the epsilon parameter set to <math id="A3.SS1.p1.m2" class="ltx_Math" alttext="1e^{-6}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mn>6</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1e^{-6}</annotation></semantics></math>. We do not use any bias terms, nor do we use weight-tying for embedding and unembedding layers. In both models we include Mistral’s GPT2 stability tweeks (attention upcasting and inverse layer scaling), as well as inverse layer scaling on layer outputs from GPT2. The loss function used is z-loss with its coefficient set to <math id="A3.SS1.p1.m3" class="ltx_Math" alttext="1e^{-4}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1e^{-4}</annotation></semantics></math>. When we report loss values, we report them without the z-loss term which is equivalent to normal cross-entropy loss. All models are trained with the AdamW optimizer, with <math id="A3.SS1.p1.m4" class="ltx_Math" alttext="\beta_{1}=0.9" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>=</mo><mn>0.9</mn></mrow><annotation encoding="application/x-tex">\beta_{1}=0.9</annotation></semantics></math>, <math id="A3.SS1.p1.m5" class="ltx_Math" alttext="\beta_{2}=0.95" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>2</mn></msub><mo>=</mo><mn>0.95</mn></mrow><annotation encoding="application/x-tex">\beta_{2}=0.95</annotation></semantics></math>, and <math id="A3.SS1.p1.m6" class="ltx_Math" alttext="\epsilon=1e^{-8}" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>=</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mn>8</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\epsilon=1e^{-8}</annotation></semantics></math>. We use decoupled weight decay with a scaling factor of <math id="A3.SS1.p1.m7" class="ltx_Math" alttext="1e^{-4}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1e^{-4}</annotation></semantics></math>. Layernorm, embedding, and unembedding weights are excluded when weight decay is applied. We use linear warmup for <math id="A3.SS1.p1.m8" class="ltx_Math" alttext="5\%" display="inline" intent=":literal"><semantics><mrow><mn>5</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">5\%</annotation></semantics></math> of the total training tokens, and cosine decay for the remaining tokens that decays to <math id="A3.SS1.p1.m9" class="ltx_Math" alttext="10\%" display="inline" intent=":literal"><semantics><mrow><mn>10</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">10\%</annotation></semantics></math> of the max learning rate. In addition, gradient checkpoint is used with all models.</p>
</div>
<div id="A3.SS1.p2" class="ltx_para">
<p id="A3.SS1.p2.1" class="ltx_p">All training experiments are implemented using JAX <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib6" title="" class="ltx_ref">Bradbury et al., 2018</a>)</cite>, Equionx <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib32" title="" class="ltx_ref">Kidger &amp; Garcia, 2021</a>)</cite>, and Haliax <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib25" title="" class="ltx_ref">Hall et al., 2024</a>)</cite>.</p>
</div>
</section>
<section id="A3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.2 </span>RMT vs Transformer Experiments</h3>

<div id="A3.SS2.p1" class="ltx_para">
<p id="A3.SS2.p1.1" class="ltx_p">Table <a href="#A3.T8" title="Table 8 ‣ C.2.1 𝜇Param ‣ C.2 RMT vs Transformer Experiments ‣ Appendix C Experimental Setup ‣ Residual Matrix Transformers: Scaling the Size of the Residual Stream" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a> and Table <a href="#A3.T9" title="Table 9 ‣ C.2.1 𝜇Param ‣ C.2 RMT vs Transformer Experiments ‣ Appendix C Experimental Setup ‣ Residual Matrix Transformers: Scaling the Size of the Residual Stream" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a> show the hyperparameters used for the experiments in §<a href="#S4.SS2" title="4.2 RMT vs Transformer ‣ 4 Experiments ‣ Residual Matrix Transformers: Scaling the Size of the Residual Stream" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>.</p>
</div>
<section id="A3.SS2.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">C.2.1 </span><math id="A3.SS2.SSS1.m1" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math>Param</h4>

<div id="A3.SS2.SSS1.p1" class="ltx_para">
<p id="A3.SS2.SSS1.p1.1" class="ltx_p">The ”Parameterization Lottery” refers to how new architectures can appear to be successful or not successful based on their compatibility with existing hyperparameters. Furthermore, the typical hyperparameters used when training standard transformers are the product of years of tuning done by the machine learning community. To help mitigate biases associated with hyperparameter selection, we perform our own hyperparameter tuning on both the transformer and RMT’s using <math id="A3.SS2.SSS1.p1.m1" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math>Transfer. For each model type we perform 100 hyperparameter searches that follow suggestions from the <math id="A3.SS2.SSS1.p1.m2" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math>Transfer paper. We sample from a loguniform distribution: learning rate on the interval <math id="A3.SS2.SSS1.p1.m3" class="ltx_Math" alttext="[1e^{-4},1e^{-1}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><mo>,</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[1e^{-4},1e^{-1}]</annotation></semantics></math>, input alpha on the interval <math id="A3.SS2.SSS1.p1.m4" class="ltx_math_unparsed" alttext="[1e^{-1},1.]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>1</mn><msup><mi>e</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><mn>1</mn><mo lspace="0em" rspace="0.167em">.</mo><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[1e^{-1},1.]</annotation></semantics></math>, attention alpha on the interval <math id="A3.SS2.SSS1.p1.m5" class="ltx_math_unparsed" alttext="[1e^{-1},1.]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>1</mn><msup><mi>e</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><mn>1</mn><mo lspace="0em" rspace="0.167em">.</mo><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[1e^{-1},1.]</annotation></semantics></math>, output alpha on the interval <math id="A3.SS2.SSS1.p1.m6" class="ltx_math_unparsed" alttext="[1e^{-1},1.]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>1</mn><msup><mi>e</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><mn>1</mn><mo lspace="0em" rspace="0.167em">.</mo><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[1e^{-1},1.]</annotation></semantics></math>, and initialization standard deviation on the interval <math id="A3.SS2.SSS1.p1.m7" class="ltx_math_unparsed" alttext="[1e^{-1},1.]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>1</mn><msup><mi>e</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><mn>1</mn><mo lspace="0em" rspace="0.167em">.</mo><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[1e^{-1},1.]</annotation></semantics></math>. Our trail models have sequence length 128, 4 layers, 8 attention heads, head dimension 32, and 1024 feed-forward neurons. The embed size of the standard transformer is set to 256, and for the RMT the residual key and value dimensions are both set to 32, and the layer rank <math id="A3.SS2.SSS1.p1.m8" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> is set to 8. These models are all trained on Nvida GTX 1080 Ti gpus with a batch size of 32, train over 5K steps. We select the hyperparameters of the best performing run from each model type. For the standard transformer we have <math id="A3.SS2.SSS1.p1.m9" class="ltx_Math" alttext="\textrm{lr}=6.5e^{-3}" display="inline" intent=":literal"><semantics><mrow><mtext>lr</mtext><mo>=</mo><mrow><mn>6.5</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mn>3</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\textrm{lr}=6.5e^{-3}</annotation></semantics></math>, <math id="A3.SS2.SSS1.p1.m10" class="ltx_Math" alttext="\textrm{input alpha}=9.76" display="inline" intent=":literal"><semantics><mrow><mtext>input alpha</mtext><mo>=</mo><mn>9.76</mn></mrow><annotation encoding="application/x-tex">\textrm{input alpha}=9.76</annotation></semantics></math>, <math id="A3.SS2.SSS1.p1.m11" class="ltx_Math" alttext="\textrm{attention alpha}=0.25" display="inline" intent=":literal"><semantics><mrow><mtext>attention alpha</mtext><mo>=</mo><mn>0.25</mn></mrow><annotation encoding="application/x-tex">\textrm{attention alpha}=0.25</annotation></semantics></math>, <math id="A3.SS2.SSS1.p1.m12" class="ltx_Math" alttext="\textrm{output alpha}=5.52" display="inline" intent=":literal"><semantics><mrow><mtext>output alpha</mtext><mo>=</mo><mn>5.52</mn></mrow><annotation encoding="application/x-tex">\textrm{output alpha}=5.52</annotation></semantics></math>, and <math id="A3.SS2.SSS1.p1.m13" class="ltx_Math" alttext="\textrm{init std}=0.15" display="inline" intent=":literal"><semantics><mrow><mtext>init std</mtext><mo>=</mo><mn>0.15</mn></mrow><annotation encoding="application/x-tex">\textrm{init std}=0.15</annotation></semantics></math>.</p>
</div>
