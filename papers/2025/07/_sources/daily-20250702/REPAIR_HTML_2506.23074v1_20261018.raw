<td id="S4.T1.7.1.5.5" class="ltx_td ltx_align_center"><span id="S4.T1.7.1.5.5.1" class="ltx_text" style="--ltx-fg-color:#808080;">94.94</span></td>
<td id="S4.T1.7.1.5.6" class="ltx_td ltx_align_center"><span id="S4.T1.7.1.5.6.1" class="ltx_text" style="--ltx-fg-color:#808080;">97.91</span></td>
<td id="S4.T1.7.1.5.7" class="ltx_td ltx_align_center"><span id="S4.T1.7.1.5.7.1" class="ltx_text" style="--ltx-fg-color:#808080;">95.87</span></td>
