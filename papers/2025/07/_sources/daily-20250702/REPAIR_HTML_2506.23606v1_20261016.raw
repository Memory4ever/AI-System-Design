<th id="S5.T5.3.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T5.3.1.1.2.1" class="ltx_text ltx_font_bold" style="font-size:120%;">Latent Diffusion</span></th>
