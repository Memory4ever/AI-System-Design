<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Algorithm</h2>

<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> Guided Inference Intervention</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">1:</span>
            
            
           <span id="alg1.l1.2" class="ltx_text ltx_font_bold">Input:</span> Problem <math id="alg1.l1.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, Model <math id="alg1.l1.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, Max reasoning steps <math id="alg1.l1.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>

</div>
<div id="alg1.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">2:</span>
            
            
           <span id="alg1.l2.2" class="ltx_text ltx_font_bold">Output:</span> Enhanced solution <math id="alg1.l2.m1" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math>

</div>
<div id="alg1.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">3:</span>
            
            
           <math id="alg1.l3.m1" class="ltx_Math" alttext="g\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">g\leftarrow\emptyset</annotation></semantics></math> {Initialize generation}

</div>
<div id="alg1.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">4:</span>
            
            
           <math id="alg1.l4.m1" class="ltx_Math" alttext="t\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo stretchy="false">←</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t\leftarrow 0</annotation></semantics></math> {Initialize step counter}

</div>
<div id="alg1.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">5:</span>
            
            
           <span id="alg1.l5.2" class="ltx_text ltx_font_bold">while</span> <math id="alg1.l5.m1" class="ltx_Math" alttext="t&lt;T" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&lt;</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t&lt;T</annotation></semantics></math>  and <math id="alg1.l5.m2" class="ltx_Math" alttext="\text{IsReasoningComplete}(g)=\text{False}" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>IsReasoningComplete</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mtext>False</mtext></mrow><annotation encoding="application/x-tex">\text{IsReasoningComplete}(g)=\text{False}</annotation></semantics></math> <span id="alg1.l5.3" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg1.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">6:</span>
            
            
            <math id="alg1.l6.m1" class="ltx_Math" alttext="g\leftarrow g\oplus M(x\oplus g)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo stretchy="false">←</mo><mrow><mi>g</mi><mo>⊕</mo><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>⊕</mo><mi>g</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">g\leftarrow g\oplus M(x\oplus g)</annotation></semantics></math> {Continue generation}

</div>
<div id="alg1.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">7:</span>
            
            
            <math id="alg1.l7.m1" class="ltx_Math" alttext="t\leftarrow t+1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo stretchy="false">←</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">t\leftarrow t+1</annotation></semantics></math>

</div>
<div id="alg1.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">8:</span>
            
            
            <span id="alg1.l8.2" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l8.m1" class="ltx_Math" alttext="\text{IsTerminating}(g)=\text{True}" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>IsTerminating</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mtext>True</mtext></mrow><annotation encoding="application/x-tex">\text{IsTerminating}(g)=\text{True}</annotation></semantics></math> <span id="alg1.l8.3" class="ltx_text ltx_font_bold">then</span>



</div>
<div id="alg1.l9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">9:</span>
            
            
             <math id="alg1.l9.m1" class="ltx_Math" alttext="s\leftarrow\text{DetectReasoningState}(g)" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo stretchy="false">←</mo><mrow><mtext>DetectReasoningState</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s\leftarrow\text{DetectReasoningState}(g)</annotation></semantics></math>

</div>
<div id="alg1.l10" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">10:</span>
            
            
             <span id="alg1.l10.2" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l10.m1" class="ltx_Math" alttext="s=\text{PARTIAL}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>=</mo><mtext>PARTIAL</mtext></mrow><annotation encoding="application/x-tex">s=\text{PARTIAL}</annotation></semantics></math> <span id="alg1.l10.3" class="ltx_text ltx_font_bold">then</span>



</div>
<div id="alg1.l11" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">11:</span>
            
            
              <math id="alg1.l11.m1" class="ltx_Math" alttext="g\leftarrow g\oplus" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo stretchy="false">←</mo><mrow><mi>g</mi><mo>⊕</mo></mrow></mrow><annotation encoding="application/x-tex">g\leftarrow g\oplus</annotation></semantics></math> "Wait, let me think further."

</div>
<div id="alg1.l12" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">12:</span>
            
            
             <span id="alg1.l12.2" class="ltx_text ltx_font_bold">else</span> <span id="alg1.l12.3" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l12.m1" class="ltx_Math" alttext="s=\text{UNCERTAIN}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>=</mo><mtext>UNCERTAIN</mtext></mrow><annotation encoding="application/x-tex">s=\text{UNCERTAIN}</annotation></semantics></math> <span id="alg1.l12.4" class="ltx_text ltx_font_bold">then</span>



</div>
<div id="alg1.l13" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">13:</span>
            
            
              <math id="alg1.l13.m1" class="ltx_Math" alttext="g\leftarrow g\oplus" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo stretchy="false">←</mo><mrow><mi>g</mi><mo>⊕</mo></mrow></mrow><annotation encoding="application/x-tex">g\leftarrow g\oplus</annotation></semantics></math> "Let me try a different approach."

</div>
<div id="alg1.l14" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">14:</span>
            
            
             <span id="alg1.l14.2" class="ltx_text ltx_font_bold">else</span> <span id="alg1.l14.3" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l14.m1" class="ltx_Math" alttext="s=\text{UNVERIFIED}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>=</mo><mtext>UNVERIFIED</mtext></mrow><annotation encoding="application/x-tex">s=\text{UNVERIFIED}</annotation></semantics></math> <span id="alg1.l14.4" class="ltx_text ltx_font_bold">then</span>



</div>
<div id="alg1.l15" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">15:</span>
            
            
              <math id="alg1.l15.m1" class="ltx_Math" alttext="g\leftarrow g\oplus" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo stretchy="false">←</mo><mrow><mi>g</mi><mo>⊕</mo></mrow></mrow><annotation encoding="application/x-tex">g\leftarrow g\oplus</annotation></semantics></math> "Let me verify this solution."

</div>
<div id="alg1.l16" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">16:</span>
            
            
             <span id="alg1.l16.2" class="ltx_text ltx_font_bold">else</span>


</div>
<div id="alg1.l17" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">17:</span>
            
            
              <span id="alg1.l17.2" class="ltx_text ltx_font_bold">break</span>

</div>
<div id="alg1.l18" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">18:</span>
            
            
             <span id="alg1.l18.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l18.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l19" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">19:</span>
            
            
            <span id="alg1.l19.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l19.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l20" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">20:</span>
            
            
           <span id="alg1.l20.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l20.3" class="ltx_text ltx_font_bold">while</span>
</div>
<div id="alg1.l21" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">21:</span>
            
            
           <math id="alg1.l21.m1" class="ltx_Math" alttext="y\leftarrow\text{ExtractSolution}(g)" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo stretchy="false">←</mo><mrow><mtext>ExtractSolution</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">y\leftarrow\text{ExtractSolution}(g)</annotation></semantics></math>

</div>
<div id="alg1.l22" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">22:</span>
            
            
           <span id="alg1.l22.2" class="ltx_text ltx_font_bold">return</span> <math id="alg1.l22.m1" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math>

</div>
</div>
</figure>
<figure id="alg2" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.3" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> Strategic Data Curation for Reason1K</figcaption>
<div id="alg2.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">1:</span>
            
            
           <span id="alg2.l1.2" class="ltx_text ltx_font_bold">Input:</span> Initial pool <math id="alg2.l1.m1" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> of problem-reasoning-solution triplets

</div>
<div id="alg2.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">2:</span>
            
            
           <span id="alg2.l2.2" class="ltx_text ltx_font_bold">Output:</span> Reason1K dataset with 1,000 selected triplets

</div>
<div id="alg2.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">3:</span>
            
            
           <math id="alg2.l3.m1" class="ltx_Math" alttext="P_{quality}\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">P_{quality}\leftarrow\emptyset</annotation></semantics></math> {Initialize quality-filtered pool}

</div>
<div id="alg2.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">4:</span>
            
            
           <span id="alg2.l4.2" class="ltx_text ltx_font_bold">for all</span> <math id="alg2.l4.m1" class="ltx_Math" alttext="(p,r,s)\in P" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>r</mi><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">(p,r,s)\in P</annotation></semantics></math> <span id="alg2.l4.3" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg2.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">5:</span>
            
            
            <span id="alg2.l5.2" class="ltx_text ltx_font_bold">if</span> <math id="alg2.l5.m1" class="ltx_Math" alttext="\text{HasFormattingIssues}(p,r,s)=\text{False}" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>HasFormattingIssues</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>r</mi><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mtext>False</mtext></mrow><annotation encoding="application/x-tex">\text{HasFormattingIssues}(p,r,s)=\text{False}</annotation></semantics></math>  and <math id="alg2.l5.m2" class="ltx_Math" alttext="\text{IsWellStructured}(r)=\text{True}" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>IsWellStructured</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mtext>True</mtext></mrow><annotation encoding="application/x-tex">\text{IsWellStructured}(r)=\text{True}</annotation></semantics></math> <span id="alg2.l5.3" class="ltx_text ltx_font_bold">then</span>



</div>
<div id="alg2.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">6:</span>
            
            
             <math id="alg2.l6.m1" class="ltx_Math" alttext="P_{quality}\leftarrow P_{quality}\cup\{(p,r,s)\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub><mo stretchy="false">←</mo><mrow><msub><mi>P</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub><mo>∪</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>r</mi><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P_{quality}\leftarrow P_{quality}\cup\{(p,r,s)\}</annotation></semantics></math>

</div>
<div id="alg2.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">7:</span>
            
            
            <span id="alg2.l7.2" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l7.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg2.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">8:</span>
            
            
           <span id="alg2.l8.2" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l8.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg2.l9" class="ltx_listingline">
