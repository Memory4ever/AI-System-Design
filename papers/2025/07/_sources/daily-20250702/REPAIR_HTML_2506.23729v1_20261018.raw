<th id="S4.T1.8.1.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.45pt 14.2pt;"><span id="S4.T1.8.1.1.1.1" class="ltx_text" style="font-size:80%;">Method</span></th>
<th id="S4.T1.8.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.45pt 14.2pt;"><span id="S4.T1.8.1.1.2.1" class="ltx_text" style="font-size:80%;">FaceSim-Cur <math id="S4.T1.m5" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></th>
<th id="S4.T1.8.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.45pt 14.2pt;"><span id="S4.T1.8.1.1.3.1" class="ltx_text" style="font-size:80%;">FaceSim-Arc <math id="S4.T1.m6" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></th>
<th id="S4.T1.8.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.45pt 14.2pt;"><span id="S4.T1.8.1.1.4.1" class="ltx_text" style="font-size:80%;">FID <math id="S4.T1.m7" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></th>
<th id="S4.T1.8.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.45pt 14.2pt;"><span id="S4.T1.8.1.1.5.1" class="ltx_text" style="font-size:80%;">CLIPScore <math id="S4.T1.m8" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></th>
<th id="S4.T1.8.1.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.45pt 14.2pt;"><span id="S4.T1.8.1.1.6.1" class="ltx_text" style="font-size:80%;">Motion Amplitude <math id="S4.T1.m9" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T1.8.1.2" class="ltx_tr">
<td id="S4.T1.8.1.2.1" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.45pt 14.2pt;"><span id="S4.T1.8.1.2.1.1" class="ltx_text" style="font-size:80%;">ID-Animator <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib13" title="" class="ltx_ref">13</a>]</cite></span></td>
<td id="S4.T1.8.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.45pt 14.2pt;"><span id="S4.T1.8.1.2.2.1" class="ltx_text" style="font-size:80%;">0.365</span></td>
<td id="S4.T1.8.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.45pt 14.2pt;"><span id="S4.T1.8.1.2.3.1" class="ltx_text" style="font-size:80%;">0.351</span></td>
