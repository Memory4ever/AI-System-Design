<td id="S4.T1.32.18.7" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S4.T1.32.18.7.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#32CD32;">-<math id="S4.T1.m224" class="ltx_Math" alttext="20.8" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#32CD32;" mathcolor="#32CD32">20.8</mn><annotation encoding="application/x-tex">20.8</annotation></semantics></math></span></td>
<td id="S4.T1.32.18.8" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S4.T1.32.18.8.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#32CD32;">-<math id="S4.T1.m225" class="ltx_Math" alttext="22.2" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#32CD32;" mathcolor="#32CD32">22.2</mn><annotation encoding="application/x-tex">22.2</annotation></semantics></math></span></td>
<td id="S4.T1.32.18.9" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S4.T1.32.18.9.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#32CD32;">-<math id="S4.T1.m226" class="ltx_Math" alttext="0.4" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#32CD32;" mathcolor="#32CD32">0.4</mn><annotation encoding="application/x-tex">0.4</annotation></semantics></math></span></td>
<td id="S4.T1.32.18.10" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S4.T1.32.18.10.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#32CD32;">-<math id="S4.T1.m227" class="ltx_Math" alttext="1.1" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#32CD32;" mathcolor="#32CD32">1.1</mn><annotation encoding="application/x-tex">1.1</annotation></semantics></math></span></td>
<td id="S4.T1.32.18.11" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S4.T1.32.18.11.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#32CD32;">-<math id="S4.T1.m228" class="ltx_Math" alttext="2.1" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#32CD32;" mathcolor="#32CD32">2.1</mn><annotation encoding="application/x-tex">2.1</annotation></semantics></math></span></td>
<td id="S4.T1.32.18.12" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S4.T1.32.18.12.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#32CD32;">-<math id="S4.T1.m229" class="ltx_Math" alttext="3.1" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#32CD32;" mathcolor="#32CD32">3.1</mn><annotation encoding="application/x-tex">3.1</annotation></semantics></math></span></td>
<td id="S4.T1.32.18.13" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S4.T1.32.18.13.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#32CD32;">-<math id="S4.T1.m230" class="ltx_Math" alttext="4.5" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#32CD32;" mathcolor="#32CD32">4.5</mn><annotation encoding="application/x-tex">4.5</annotation></semantics></math></span></td>
<td id="S4.T1.32.18.14" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S4.T1.32.18.14.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#32CD32;">-<math id="S4.T1.m231" class="ltx_Math" alttext="5.1" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#32CD32;" mathcolor="#32CD32">5.1</mn><annotation encoding="application/x-tex">5.1</annotation></semantics></math></span></td>
<td id="S4.T1.32.18.15" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:5.0pt;padding-right:5.0pt;"><math id="S4.T1.m232" class="ltx_Math" alttext="220" display="inline" intent=":literal"><semantics><mn mathsize="0.700em">220</mn><annotation encoding="application/x-tex">220</annotation></semantics></math></td></tr>
