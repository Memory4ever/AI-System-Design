<td id="S4.T2.2.3.5" class="ltx_td ltx_align_right">0.12 <math id="S4.T2.m10" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.07</td>
