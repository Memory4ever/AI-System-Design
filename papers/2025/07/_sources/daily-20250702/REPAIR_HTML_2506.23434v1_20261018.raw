<tr id="A4.T14.1.1.6" class="ltx_tr">
<td id="A4.T14.1.1.6.1" class="ltx_td ltx_align_left ltx_border_t"><math id="A4.m5" class="ltx_Math" alttext="\bm{o}_{v}" display="inline" intent=":literal"><semantics><msub><mi>𝒐</mi><mi>v</mi></msub><annotation encoding="application/x-tex">\bm{o}_{v}</annotation></semantics></math></td>
