<td id="S4.T2.5.1.11.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T2.5.1.11.2.1" class="ltx_text" style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F2F2;">✓</span></td>
