<td id="A4.T14.1.1.5.1" class="ltx_td ltx_align_left"><math id="A4.m4" class="ltx_Math" alttext="\varnothing" display="inline" intent=":literal"><semantics><mi mathvariant="normal">∅</mi><annotation encoding="application/x-tex">\varnothing</annotation></semantics></math></td>
<td id="A4.T14.1.1.5.2" class="ltx_td ltx_align_left">25% KITTI</td>
<td id="A4.T14.1.1.5.3" class="ltx_td ltx_align_center">88.66</td>
