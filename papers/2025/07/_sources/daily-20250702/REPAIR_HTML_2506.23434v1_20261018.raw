<td id="A4.T14.1.1.3.1" class="ltx_td ltx_align_left"><math id="A4.m2" class="ltx_Math" alttext="\varnothing" display="inline" intent=":literal"><semantics><mi mathvariant="normal">∅</mi><annotation encoding="application/x-tex">\varnothing</annotation></semantics></math></td>
