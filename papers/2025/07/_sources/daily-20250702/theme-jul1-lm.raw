      <a href="/search/?searchtype=author&amp;query=Kashyap%2C+G+S">Gautam Siddharth Kashyap</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Gao%2C+J">Jiechao Gao</a>, 
      
