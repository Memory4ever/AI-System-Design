      <a href="/search/?searchtype=author&amp;query=Azeez%2C+M+A">Mohammad Anas Azeez</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Ali%2C+R">Rafiq Ali</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Shabbir%2C+E">Ebad Shabbir</a>, 
      
