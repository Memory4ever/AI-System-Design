        <span>&nbsp;[<a href="https://arxiv.org/pdf/2507.01999">pdf</a>, <a href="https://arxiv.org/ps/2507.01999">ps</a>, <a href="https://arxiv.org/format/2507.01999">other</a>]&nbsp;</span>
