<th id="A2.T8.2.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="A2.T8.2.1.2.3.1" class="ltx_text" style="font-size:90%;">Student</span></th>
<th id="A2.T8.2.1.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="A2.T8.2.1.2.4.1" class="ltx_text" style="font-size:90%;">Teacher</span></th>
