<td id="A2.T9.2.1.4.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="A2.T9.2.1.4.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">78.8</span></td>
<td id="A2.T9.2.1.4.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="A2.T9.2.1.4.5.1" class="ltx_text" style="font-size:90%;">88.5</span></td>
<td id="A2.T9.2.1.4.6" class="ltx_td ltx_align_center ltx_border_bb"><span id="A2.T9.2.1.4.6.1" class="ltx_text ltx_font_bold" style="font-size:90%;">67.6</span></td>
<td id="A2.T9.2.1.4.7" class="ltx_td ltx_align_center ltx_border_bb"><span id="A2.T9.2.1.4.7.1" class="ltx_text" style="font-size:90%;">76.5</span></td>
<td id="A2.T9.2.1.4.8" class="ltx_td ltx_align_center ltx_border_bb"><span id="A2.T9.2.1.4.8.1" class="ltx_text ltx_font_bold" style="font-size:90%;">43.0</span></td>
<td id="A2.T9.2.1.4.9" class="ltx_td ltx_align_center ltx_border_bb"><span id="A2.T9.2.1.4.9.1" class="ltx_text" style="font-size:90%;">59.1</span></td>
<td id="A2.T9.2.1.4.10" class="ltx_td ltx_align_center ltx_border_bb"><span id="A2.T9.2.1.4.10.1" class="ltx_text ltx_font_bold" style="font-size:90%;">90.7</span></td>
<td id="A2.T9.2.1.4.11" class="ltx_td ltx_align_center ltx_border_bb"><span id="A2.T9.2.1.4.11.1" class="ltx_text" style="font-size:90%;">90.6</span></td>
<td id="A2.T9.2.1.4.12" class="ltx_td ltx_align_center ltx_border_bb"><span id="A2.T9.2.1.4.12.1" class="ltx_text ltx_font_bold" style="font-size:90%;">46.4</span></td>
<td id="A2.T9.2.1.4.13" class="ltx_td ltx_align_center ltx_border_bb"><span id="A2.T9.2.1.4.13.1" class="ltx_text" style="font-size:90%;">69.6</span></td></tr>
