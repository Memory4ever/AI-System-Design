<th id="A2.T8.2.1.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="A2.T8.2.1.2.7.1" class="ltx_text" style="font-size:90%;">Student</span></th>
<th id="A2.T8.2.1.2.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="A2.T8.2.1.2.8.1" class="ltx_text" style="font-size:90%;">Teacher</span></th>
<th id="A2.T8.2.1.2.9" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="A2.T8.2.1.2.9.1" class="ltx_text" style="font-size:90%;">Student</span></th>
<th id="A2.T8.2.1.2.10" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="A2.T8.2.1.2.10.1" class="ltx_text" style="font-size:90%;">Teacher</span></th>
<th id="A2.T8.2.1.2.11" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="A2.T8.2.1.2.11.1" class="ltx_text" style="font-size:90%;">Student</span></th>
<th id="A2.T8.2.1.2.12" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="A2.T8.2.1.2.12.1" class="ltx_text" style="font-size:90%;">Teacher</span></th></tr>
</thead>
<tbody class="ltx_tbody">
