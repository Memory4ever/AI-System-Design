<td id="A6.T6.2.10.3" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FFF0F0;"><span id="A6.T6.2.10.3.1" class="ltx_text" style="--ltx-bg-color:#FFF0F0;">295</span></td>
