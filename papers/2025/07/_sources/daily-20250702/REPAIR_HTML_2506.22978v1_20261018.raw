<td id="S3.T1.2.17.3" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FFA0A0;"><span id="S3.T1.2.17.3.1" class="ltx_text" style="--ltx-bg-color:#FFA0A0;">51.9</span></td></tr>
