<td id="S5.T2.2.8.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_r"><math id="S5.T2.m3" class="ltx_Math" alttext="10^{9}" display="inline" intent=":literal"><semantics><msup><mn>10</mn><mn>9</mn></msup><annotation encoding="application/x-tex">10^{9}</annotation></semantics></math> elements</td>
