        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.21967">pdf</a>, <a href="https://arxiv.org/ps/2506.21967">ps</a>, <a href="https://arxiv.org/format/2506.21967">other</a>]&nbsp;</span>
