      <a href="/search/?searchtype=author&amp;query=Fran%C3%A7ois%2C+C">Camille François</a>, 
      
      <a href="/search/?searchtype=author&amp;query=P%C3%A9ran%2C+L">Ludovic Péran</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Bdeir%2C+A">Ayah Bdeir</a>, 
      
