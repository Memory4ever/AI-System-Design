      <a href="/search/?searchtype=author&amp;query=Qi%2C+J">Ji Qi</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Ji%2C+J">Junhui Ji</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Pan%2C+L">Lihang Pan</a>, 
      
