<td id="S4.T2.6.1.4.6" class="ltx_td ltx_align_left">69.36</td></tr>
<tr id="S4.T2.6.1.5" class="ltx_tr">
<th id="S4.T2.6.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">Footpath (Lit)</th>
<th id="S4.T2.6.1.5.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">70</th>
<td id="S4.T2.6.1.5.3" class="ltx_td ltx_align_left ltx_border_r">32.20</td>
