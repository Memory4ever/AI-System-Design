<div id="S4.T2.6" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:109pt;vertical-align:-52.0pt;"><span class="ltx_transformed_inner" style="transform:translate(-0.4pt,0.1pt) scale(0.997752775668903,0.997752775668903) ;">
<table id="S4.T2.6.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
