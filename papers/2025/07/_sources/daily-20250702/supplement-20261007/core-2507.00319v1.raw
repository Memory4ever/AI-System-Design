<td id="S4.T2.6.1.2.3" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">23.71</td>
<td id="S4.T2.6.1.2.4" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">0.78</td>
<td id="S4.T2.6.1.2.5" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">0.20</td>
<td id="S4.T2.6.1.2.6" class="ltx_td ltx_align_left ltx_border_t">63.55</td></tr>
