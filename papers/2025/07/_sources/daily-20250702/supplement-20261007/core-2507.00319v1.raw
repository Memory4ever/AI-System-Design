<div id="S4.T4.6" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:70.7pt;vertical-align:-33.5pt;"><span class="ltx_transformed_inner" style="transform:translate(-64.7pt,13.3pt) scale(0.727237779033053,0.727237779033053) ;">
