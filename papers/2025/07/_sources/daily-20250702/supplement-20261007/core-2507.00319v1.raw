<td id="S4.T2.6.1.3.4" class="ltx_td ltx_align_left ltx_border_r">0.74</td>
<td id="S4.T2.6.1.3.5" class="ltx_td ltx_align_left ltx_border_r">0.32</td>
<td id="S4.T2.6.1.3.6" class="ltx_td ltx_align_left">61.96</td></tr>
<tr id="S4.T2.6.1.4" class="ltx_tr">
<th id="S4.T2.6.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">AuE Lab</th>
<th id="S4.T2.6.1.4.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">545</th>
<td id="S4.T2.6.1.4.3" class="ltx_td ltx_align_left ltx_border_r">35.10</td>
<td id="S4.T2.6.1.4.4" class="ltx_td ltx_align_left ltx_border_r">0.97</td>
