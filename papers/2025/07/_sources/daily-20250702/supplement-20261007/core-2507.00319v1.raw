<td id="S4.T2.6.1.5.5" class="ltx_td ltx_align_left ltx_border_r">0.09</td>
<td id="S4.T2.6.1.5.6" class="ltx_td ltx_align_left">66.09</td></tr>
<tr id="S4.T2.6.1.6" class="ltx_tr">
<th id="S4.T2.6.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">Footpath (Unlit)</th>
<th id="S4.T2.6.1.6.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">263</th>
