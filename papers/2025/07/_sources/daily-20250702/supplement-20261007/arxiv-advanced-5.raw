    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2507.03993">arXiv:2507.03993</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2507.03993">pdf</a>, <a href="https://arxiv.org/ps/2507.03993">ps</a>, <a href="https://arxiv.org/format/2507.03993">other</a>]&nbsp;</span>
