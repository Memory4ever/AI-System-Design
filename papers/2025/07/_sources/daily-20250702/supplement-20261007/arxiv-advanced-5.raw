        <span>&nbsp;[<a href="https://arxiv.org/pdf/2507.03477">pdf</a>, <a href="https://arxiv.org/ps/2507.03477">ps</a>, <a href="https://arxiv.org/format/2507.03477">other</a>]&nbsp;</span>
