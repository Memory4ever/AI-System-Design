        <span>&nbsp;[<a href="https://arxiv.org/pdf/2507.01424">pdf</a>, <a href="https://arxiv.org/ps/2507.01424">ps</a>, <a href="https://arxiv.org/format/2507.01424">other</a>]&nbsp;</span>
