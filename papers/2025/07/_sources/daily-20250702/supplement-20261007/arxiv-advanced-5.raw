        <span>&nbsp;[<a href="https://arxiv.org/pdf/2507.05257">pdf</a>, <a href="https://arxiv.org/ps/2507.05257">ps</a>, <a href="https://arxiv.org/format/2507.05257">other</a>]&nbsp;</span>
      </p>
      <div class="tags is-inline-block">
        <span class="tag is-small is-link tooltip is-tooltip-top" data-tooltip="Computation and Language">cs.CL</span>
        
          
