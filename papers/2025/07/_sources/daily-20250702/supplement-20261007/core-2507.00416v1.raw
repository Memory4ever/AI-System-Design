<td id="S4.T1.2.2.2" class="ltx_td ltx_align_center ltx_border_t">59.33%</td>
<td id="S4.T1.2.2.3" class="ltx_td ltx_align_center ltx_border_t">20.00%</td>
<td id="S4.T1.2.2.4" class="ltx_td ltx_align_center ltx_border_t">13.30%</td>
<td id="S4.T1.2.2.5" class="ltx_td ltx_align_center ltx_border_t">20.00%</td>
<td id="S4.T1.2.2.6" class="ltx_td ltx_align_center ltx_border_t">30.00%</td>
<td id="S4.T1.2.2.7" class="ltx_td ltx_align_center ltx_border_t">28.53%</td></tr>
<tr id="S4.T1.2.3" class="ltx_tr">
