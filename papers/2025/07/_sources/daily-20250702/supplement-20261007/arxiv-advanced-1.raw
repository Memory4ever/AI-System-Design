  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2507.00004">arXiv:2507.00004</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2507.00004">pdf</a>, <a href="https://arxiv.org/ps/2507.00004">ps</a>, <a href="https://arxiv.org/format/2507.00004">other</a>]&nbsp;</span>
