      <a href="/search/?searchtype=author&amp;query=Yang%2C+J">Jiange Yang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Fang%2C+H">Hao-Shu Fang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=He%2C+T">Tong He</a>
      
