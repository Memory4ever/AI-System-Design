      <a href="/search/?searchtype=author&amp;query=Liu%2C+C">Chang Liu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Ye%2C+Q">Qingwen Ye</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Yang%2C+M">Ming-Hsuan Yang</a>, 
      
