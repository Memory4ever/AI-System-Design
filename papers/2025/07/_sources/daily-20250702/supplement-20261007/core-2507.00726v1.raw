<thead class="ltx_thead">
<tr id="A2.T3.2.1" class="ltx_tr">
<th id="A2.T3.2.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="A2.T3.2.1.1.1" class="ltx_text ltx_font_bold">Hyperparameter</span></th>
<th id="A2.T3.2.1.2" class="ltx_td ltx_nopad_l ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="A2.T3.2.1.2.1" class="ltx_text ltx_font_bold">Value</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A2.T3.2.2" class="ltx_tr">
