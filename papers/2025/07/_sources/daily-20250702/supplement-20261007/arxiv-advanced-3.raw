        <span>&nbsp;[<a href="https://arxiv.org/pdf/2507.02264">pdf</a>, <a href="https://arxiv.org/ps/2507.02264">ps</a>, <a href="https://arxiv.org/format/2507.02264">other</a>]&nbsp;</span>
