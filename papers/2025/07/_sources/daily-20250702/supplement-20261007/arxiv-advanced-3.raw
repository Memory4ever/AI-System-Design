        <span>&nbsp;[<a href="https://arxiv.org/pdf/2507.05651">pdf</a>, <a href="https://arxiv.org/ps/2507.05651">ps</a>, <a href="https://arxiv.org/format/2507.05651">other</a>]&nbsp;</span>
