        <span>&nbsp;[<a href="https://arxiv.org/pdf/2507.04123">pdf</a>, <a href="https://arxiv.org/ps/2507.04123">ps</a>, <a href="https://arxiv.org/format/2507.04123">other</a>]&nbsp;</span>
