      <a href="/search/?searchtype=author&amp;query=Khan%2C+S+U">Samee U. Khan</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Safro%2C+I">Ilya Safro</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Luu%2C+K">Khoa Luu</a>
      
