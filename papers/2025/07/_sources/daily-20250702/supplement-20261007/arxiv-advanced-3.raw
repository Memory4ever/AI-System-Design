        <span>&nbsp;[<a href="https://arxiv.org/pdf/2507.04870">pdf</a>, <a href="https://arxiv.org/ps/2507.04870">ps</a>, <a href="https://arxiv.org/format/2507.04870">other</a>]&nbsp;</span>
