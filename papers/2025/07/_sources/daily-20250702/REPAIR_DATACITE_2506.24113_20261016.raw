{"data":{"id":"10.48550/arxiv.2506.24113","type":"dois","attributes":{"doi":"10.48550/arxiv.2506.24113","prefix":"10.48550","suffix":"arxiv.2506.24113","identifiers":[{"identifier":"2506.24113","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2506.24113"}],"creators":[{"name":"Zhang, Kaiwen","nameType":"Personal","givenName":"Kaiwen","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Tang, Zhenyu","nameType":"Personal","givenName":"Zhenyu","familyName":"Tang","affiliation":[],"nameIdentifiers":[]},{"name":"Hu, Xiaotao","nameType":"Personal","givenName":"Xiaotao","familyName":"Hu","affiliation":[],"nameIdentifiers":[]},{"name":"Pan, Xingang","nameType":"Personal","givenName":"Xingang","familyName":"Pan","affiliation":[],"nameIdentifiers":[]},{"name":"Guo, Xiaoyang","nameType":"Personal","givenName":"Xiaoyang","familyName":"Guo","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Yuan","nameType":"Personal","givenName":"Yuan","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Huang, Jingwei","nameType":"Personal","givenName":"Jingwei","familyName":"Huang","affiliation":[],"nameIdentifiers":[]},{"name":"Yuan, Li","nameType":"Personal","givenName":"Li","familyName":"Yuan","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Qian","nameType":"Personal","givenName":"Qian","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Long, Xiao-Xiao","nameType":"Personal","givenName":"Xiao-Xiao","familyName":"Long","affiliation":[],"nameIdentifiers":[]},{"name":"Cao, Xun","nameType":"Personal","givenName":"Xun","familyName":"Cao","affiliation":[],"nameIdentifiers":[]},{"name":"Yin, Wei","nameType":"Personal","givenName":"Wei","familyName":"Yin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Epona: Autoregressive Diffusion World Model for Autonomous Driving"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-06-30T17:56:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-07-01T01:34:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-06","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Diffusion models have demonstrated exceptional visual quality in video generation, making them promising for autonomous driving world modeling. However, existing video diffusion-based world models struggle with flexible-length, long-horizon predictions and integrating trajectory planning. This is because conventional video diffusion models rely on global joint distribution modeling of fixed-length frame sequences rather than sequentially constructing localized distributions at each timestep. In this work, we propose Epona, an autoregressive diffusion world model that enables localized spatiotemporal distribution modeling through two key innovations: 1) Decoupled spatiotemporal factorization that separates temporal dynamics modeling from fine-grained future world generation, and 2) Modular trajectory and video prediction that seamlessly integrate motion planning with visual modeling in an end-to-end framework. Our architecture enables high-resolution, long-duration generation while introducing a novel chain-of-forward training strategy to address error accumulation in autoregressive loops. Experimental results demonstrate state-of-the-art performance with 7.4\\% FVD improvement and minutes longer prediction duration compared to prior works. The learned world model further serves as a real-time motion planner, outperforming strong end-to-end planners on NAVSIM benchmarks. Code will be publicly available at \\href{https://github.com/Kevin-thu/Epona/}{https://github.com/Kevin-thu/Epona/}.","descriptionType":"Abstract"},{"description":"ICCV2025, Project Page: https://kevin-thu.github.io/Epona/","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2506.24113","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-07-01T03:02:15.000Z","registered":"2025-07-01T03:02:16.000Z","published":"2025","updated":"2025-07-01T03:02:16.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2506.24113","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}