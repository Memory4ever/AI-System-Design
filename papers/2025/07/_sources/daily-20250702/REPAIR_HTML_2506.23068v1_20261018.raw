<td id="A1.T3.9.3.5" class="ltx_td ltx_align_center"><math id="A1.T3.m15" class="ltx_Math" alttext="[0,1,0,0]^{\top}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>0</mn></mrow><mo stretchy="false">]</mo></mrow><mo>⊤</mo></msup><annotation encoding="application/x-tex">[0,1,0,0]^{\top}</annotation></semantics></math></td></tr>
