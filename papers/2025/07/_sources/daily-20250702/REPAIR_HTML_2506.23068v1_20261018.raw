<th id="A1.T3.9.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_tt"><math id="A1.T3.m6" class="ltx_Math" alttext="x_{2}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>2</mn></msub><annotation encoding="application/x-tex">x_{2}</annotation></semantics></math></th>
<th id="A1.T3.9.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A1.T3.m7" class="ltx_Math" alttext="z_{1}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mn>1</mn></msub><annotation encoding="application/x-tex">z_{1}</annotation></semantics></math></th>
