<th id="A1.T3.9.5.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bbbb"><span id="A1.T3.9.5.2.1" class="ltx_text ltx_font_italic">1</span></th>
<td id="A1.T3.9.5.3" class="ltx_td ltx_align_center ltx_border_bbbb"><math id="A1.T3.m19" class="ltx_Math" alttext="[0,1]^{\top}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mo>⊤</mo></msup><annotation encoding="application/x-tex">[0,1]^{\top}</annotation></semantics></math></td>
<td id="A1.T3.9.5.4" class="ltx_td ltx_align_center ltx_border_bbbb"><math id="A1.T3.m20" class="ltx_Math" alttext="[0,1]^{\top}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mo>⊤</mo></msup><annotation encoding="application/x-tex">[0,1]^{\top}</annotation></semantics></math></td>
<td id="A1.T3.9.5.5" class="ltx_td ltx_align_center ltx_border_bbbb"><math id="A1.T3.m21" class="ltx_Math" alttext="[0,0,0,1]^{\top}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mo>⊤</mo></msup><annotation encoding="application/x-tex">[0,0,0,1]^{\top}</annotation></semantics></math></td></tr>
