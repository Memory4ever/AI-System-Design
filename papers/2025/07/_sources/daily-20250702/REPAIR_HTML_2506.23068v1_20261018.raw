<td id="A1.T3.9.4.3" class="ltx_td ltx_align_center"><math id="A1.T3.m16" class="ltx_Math" alttext="[1,0]^{\top}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mn>0</mn></mrow><mo stretchy="false">]</mo></mrow><mo>⊤</mo></msup><annotation encoding="application/x-tex">[1,0]^{\top}</annotation></semantics></math></td>
