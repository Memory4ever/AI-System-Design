<th id="A1.T3.9.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A1.T3.m9" class="ltx_Math" alttext="z=z_{1}\otimes z_{2}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>=</mo><mrow><msub><mi>z</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>z</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">z=z_{1}\otimes z_{2}</annotation></semantics></math></th></tr>
