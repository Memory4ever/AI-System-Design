<td id="A1.T3.9.2.5" class="ltx_td ltx_align_center ltx_border_t"><math id="A1.T3.m12" class="ltx_Math" alttext="[1,0,0,0]^{\top}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>0</mn></mrow><mo stretchy="false">]</mo></mrow><mo>⊤</mo></msup><annotation encoding="application/x-tex">[1,0,0,0]^{\top}</annotation></semantics></math></td></tr>
