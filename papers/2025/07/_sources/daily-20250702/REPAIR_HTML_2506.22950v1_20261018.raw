<tr id="S5.T1.6.10" class="ltx_tr">
<th id="S5.T1.6.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">Dynamic-slot</th>
<td id="S5.T1.6.10.2" class="ltx_td ltx_align_center">1395 (x0.20)</td>
