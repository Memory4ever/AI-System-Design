<td id="S5.T1.6.10.4" class="ltx_td ltx_align_center">1626 (x0.32)</td>
<td id="S5.T1.6.10.5" class="ltx_td ltx_align_center">172 (x0.43)</td></tr>
<tr id="S5.T1.6.11" class="ltx_tr">
<th id="S5.T1.6.11.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">Infinite-sampling *</th>
<td id="S5.T1.6.11.2" class="ltx_td ltx_align_center">5126 (x0.73)</td>
<td id="S5.T1.6.11.3" class="ltx_td ltx_align_center ltx_border_r">602 (x1.00)</td>
<td id="S5.T1.6.11.4" class="ltx_td ltx_align_center">3492 (x0.69)</td>
<td id="S5.T1.6.11.5" class="ltx_td ltx_align_center">395 (x1.00)</td></tr>
<tr id="S5.T1.6.12" class="ltx_tr">
