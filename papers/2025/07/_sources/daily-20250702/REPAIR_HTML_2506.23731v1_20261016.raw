<th id="A4.T9.8.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt" style="padding-left:2.0pt;padding-right:2.0pt;" colspan="6"><span id="A4.T9.8.1.1.2.1" class="ltx_text" style="font-size:70%;">FID</span></th>
<th id="A4.T9.8.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:2.0pt;padding-right:2.0pt;" colspan="5"><span id="A4.T9.8.1.1.3.1" class="ltx_text" style="font-size:70%;">TPR@FPR=1%</span></th></tr>
<tr id="A4.T9.8.1.2" class="ltx_tr">
<th id="A4.T9.8.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_column" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="A4.T9.8.1.2.1.1" class="ltx_text" style="font-size:70%;">Model</span></th>
<th id="A4.T9.8.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column" style="padding-left:2.0pt;padding-right:2.0pt;"><math id="A4.T9.m1" class="ltx_Math" alttext="\delta=0" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.700em">δ</mi><mo mathsize="0.700em">=</mo><mn mathsize="0.700em">0</mn></mrow><annotation encoding="application/x-tex">\delta=0</annotation></semantics></math></th>
