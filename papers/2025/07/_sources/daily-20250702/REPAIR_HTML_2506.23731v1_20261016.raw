<td id="S5.T2.10.16.3" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T2.10.16.3.1" class="ltx_text" style="font-size:70%;">WIAR</span></td>
<td id="S5.T2.10.16.4" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S5.T2.m33" class="ltx_Math" alttext="100" display="inline" intent=":literal"><semantics><mn mathsize="0.700em">100</mn><annotation encoding="application/x-tex">100</annotation></semantics></math></td>
<td id="S5.T2.10.16.5" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S5.T2.m34" class="ltx_Math" alttext="100" display="inline" intent=":literal"><semantics><mn mathsize="0.700em">100</mn><annotation encoding="application/x-tex">100</annotation></semantics></math></td></tr>
<tr id="S5.T2.10.17" class="ltx_tr">
<td id="S5.T2.10.17.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T2.10.17.1.1" class="ltx_text" style="font-size:70%;">VAR-<span id="S5.T2.10.17.1.1.1" class="ltx_text ltx_font_italic">d</span>16</span></td>
<td id="S5.T2.10.17.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T2.10.17.2.1" class="ltx_text" style="font-size:70%;">RAR-B</span></td>
<td id="S5.T2.10.17.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T2.10.17.3.1" class="ltx_text" style="font-size:70%;">WIAR</span></td>
<td id="S5.T2.10.17.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S5.T2.m35" class="ltx_Math" alttext="100" display="inline" intent=":literal"><semantics><mn mathsize="0.700em">100</mn><annotation encoding="application/x-tex">100</annotation></semantics></math></td>
