<th id="S5.F5.sf2.3.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.F5.sf2.3.1.2.1" class="ltx_text" style="font-size:70%;">Avg. Token Overlap</span></th></tr>
