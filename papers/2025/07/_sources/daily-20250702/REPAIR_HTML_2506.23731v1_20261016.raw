</div>
<div id="algorithm1.6.14" class="ltx_listingline"><span id="algorithm1.6.14.1" class="ltx_text" style="font-size:90%;"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>   <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  </span>
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.14.2" class="ltx_text ltx_font_bold" style="font-size:90%;">13</span></span>
              <math id="algorithm1.m23" class="ltx_Math" alttext="x_{j}=\text{Sample}(p_{j})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">x</mi><mi mathsize="0.900em">j</mi></msub><mo mathsize="0.900em">=</mo><mrow><mtext mathsize="0.900em">Sample</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">p</mi><mi mathsize="0.900em">j</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x_{j}=\text{Sample}(p_{j})</annotation></semantics></math><span id="algorithm1.6.14.3" class="ltx_text" style="font-size:90%;">;</span>
</div>
<div id="algorithm1.6.15" class="ltx_listingline"><span id="algorithm1.6.15.1" class="ltx_text" style="font-size:90%;"> </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm1.6.15.2" class="ltx_text" style="font-size:90%;">  </span>
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.15.3" class="ltx_text ltx_font_bold" style="font-size:90%;">14</span></span>
              <math id="algorithm1.m24" class="ltx_Math" alttext="u_{i}=(x_{1},\dots,x_{t_{i}})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">u</mi><mi mathsize="0.900em">i</mi></msub><mo mathsize="0.900em">=</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">x</mi><mn mathsize="0.900em">1</mn></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em" mathvariant="normal">…</mi><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">x</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">u_{i}=(x_{1},\dots,x_{t_{i}})</annotation></semantics></math><span id="algorithm1.6.15.4" class="ltx_text" style="font-size:90%;">;</span>
</div>
<div id="algorithm1.6.16" class="ltx_listingline"><span id="algorithm1.6.16.1" class="ltx_text" style="font-size:90%;"> </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm1.6.16.2" class="ltx_text" style="font-size:90%;">  </span>
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.16.3" class="ltx_text ltx_font_bold" style="font-size:90%;">15</span></span>
              <math id="algorithm1.m25" class="ltx_Math" alttext="z_{i}=\text{lookup}(V,u_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">z</mi><mi mathsize="0.900em">i</mi></msub><mo mathsize="0.900em">=</mo><mrow><mtext mathsize="0.900em">lookup</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">V</mi><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">u</mi><mi mathsize="0.900em">i</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z_{i}=\text{lookup}(V,u_{i})</annotation></semantics></math><span id="algorithm1.6.16.4" class="ltx_text" style="font-size:90%;">;</span>
</div>
<div id="algorithm1.6.17" class="ltx_listingline"><span id="algorithm1.6.17.1" class="ltx_text" style="font-size:90%;"> </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm1.6.17.2" class="ltx_text" style="font-size:90%;">  </span>
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.17.3" class="ltx_text ltx_font_bold" style="font-size:90%;">16</span></span>
              <math id="algorithm1.m26" class="ltx_Math" alttext="z_{i}=\text{interpolate}(z_{i},h_{K},w_{K})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">z</mi><mi mathsize="0.900em">i</mi></msub><mo mathsize="0.900em">=</mo><mrow><mtext mathsize="0.900em">interpolate</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">z</mi><mi mathsize="0.900em">i</mi></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">h</mi><mi mathsize="0.900em">K</mi></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">w</mi><mi mathsize="0.900em">K</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z_{i}=\text{interpolate}(z_{i},h_{K},w_{K})</annotation></semantics></math><span id="algorithm1.6.17.4" class="ltx_text" style="font-size:90%;">;</span>
</div>
<div id="algorithm1.6.18" class="ltx_listingline"><span id="algorithm1.6.18.1" class="ltx_text" style="font-size:90%;"> </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm1.6.18.2" class="ltx_text" style="font-size:90%;">  </span>
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.18.3" class="ltx_text ltx_font_bold" style="font-size:90%;">17</span></span>
              <math id="algorithm1.m27" class="ltx_Math" alttext="e=e+\phi_{i}(z_{i})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">e</mi><mo mathsize="0.900em">=</mo><mrow><mi mathsize="0.900em">e</mi><mo mathsize="0.900em">+</mo><mrow><msub><mi mathsize="0.900em">ϕ</mi><mi mathsize="0.900em">i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">z</mi><mi mathsize="0.900em">i</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">e=e+\phi_{i}(z_{i})</annotation></semantics></math><span id="algorithm1.6.18.4" class="ltx_text" style="font-size:90%;">;</span>
</div>
<div id="algorithm1.6.19" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.19.1" class="ltx_text ltx_font_bold" style="font-size:90%;">18</span></span>
              <math id="algorithm1.m28" class="ltx_Math" alttext="im=\mathcal{D}(e)" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">m</mi></mrow><mo mathsize="0.900em">=</mo><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒟</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">e</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">im=\mathcal{D}(e)</annotation></semantics></math><span id="algorithm1.6.19.2" class="ltx_text" style="font-size:90%;">;</span>
</div>
<div id="algorithm1.6.20" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.20.1" class="ltx_text ltx_font_bold" style="font-size:90%;">19</span></span>
              <span id="algorithm1.6.20.2" class="ltx_text ltx_font_bold" style="font-size:90%;">Return: </span><span id="algorithm1.6.20.3" class="ltx_text" style="font-size:90%;"> </span><span id="algorithm1.6.20.4" class="ltx_text" style="font-size:90%;--ltx-fg-color:#0000FF;">watermarked image im;</span>
</div>
<div id="algorithm1.6.21" class="ltx_listingline">
</div>
</div>
</figure>
</section>
<section id="S3.SS1.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Generating the Watermarked Image.</h4>

<div id="S3.SS1.SSS0.Px2.p1" class="ltx_para">
<p id="S3.SS1.SSS0.Px2.p1.1" class="ltx_p">After the token selection, the image generation follows the standard IAR procedure, <em id="S3.SS1.SSS0.Px2.p1.1.1" class="ltx_emph ltx_font_italic">i.e</em>.<span id="S3.SS1.SSS0.Px2.p1.1.2" class="ltx_text"></span>, we query the vocabulary of tokens <math id="S3.SS1.SSS0.Px2.p1.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> to obtain their representations <math id="S3.SS1.SSS0.Px2.p1.m2" class="ltx_Math" alttext="z_{i}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mi>i</mi></msub><annotation encoding="application/x-tex">z_{i}</annotation></semantics></math> per each token index <math id="S3.SS1.SSS0.Px2.p1.m3" class="ltx_Math" alttext="x_{j}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>j</mi></msub><annotation encoding="application/x-tex">x_{j}</annotation></semantics></math> (line 15), interpolate to the full resolution <math id="S3.SS1.SSS0.Px2.p1.m4" class="ltx_Math" alttext="(h_{K},w_{K})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><mi>K</mi></msub><mo>,</mo><msub><mi>w</mi><mi>K</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(h_{K},w_{K})</annotation></semantics></math> (line 16), and project with <math id="S3.SS1.SSS0.Px2.p1.m5" class="ltx_Math" alttext="\phi_{i}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\phi_{i}</annotation></semantics></math> to the embedding space of image encoding. The embeddings are aggregated across all the resolutions. The final embedding is decoded (line 18) to the watermarked image <math id="S3.SS1.SSS0.Px2.p1.m6" class="ltx_Math" alttext="im" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">im</annotation></semantics></math> and returned (line 19).</p>
</div>
</section>
</section>
<section id="S3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.2 </span>Watermark Detection</h3>

<div id="S3.SS2.p1" class="ltx_para">
<p id="S3.SS2.p1.1" class="ltx_p">Our watermark detection then relies on taking a suspect image, <em id="S3.SS2.p1.1.1" class="ltx_emph ltx_font_italic">i.e</em>.<span id="S3.SS2.p1.1.2" class="ltx_text"></span>, an image where we want to detect whether a watermark was embedded. This suspect image is then encoded into tokens, and we check whether these tokens stem (mainly) from the <math id="S3.SS2.p1.m1" class="ltx_Math" alttext="green" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">green</annotation></semantics></math> list (and not from the <math id="S3.SS2.p1.m2" class="ltx_Math" alttext="red" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">red</annotation></semantics></math> list). Intuitively, images that consists (mainly) of tokens from the <math id="S3.SS2.p1.m3" class="ltx_Math" alttext="green" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">green</annotation></semantics></math> list are marked as watermarks.
To perform detection, we do not require access to the IAR model.</p>
</div>
<section id="S3.SS2.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Detecting the Watermark.</h4>

<div id="S3.SS2.SSS0.Px1.p1" class="ltx_para">
<p id="S3.SS2.SSS0.Px1.p1.1" class="ltx_p"><a href="#algorithm2" title="In Detecting the Watermark. ‣ 3.2 Watermark Detection ‣ 3 Watermarking Method for IARs ‣ Radioactive Watermarks in Diffusion and AutoregressiveImage Generative Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Algorithm</span> <span class="ltx_text ltx_ref_tag">2</span></a> presents our WIAR watermark detection algorithm where we again color-code the <span id="S3.SS2.SSS0.Px1.p1.1.1" class="ltx_text" style="--ltx-fg-color:#0000FF;">lines responsible for the watermark</span> detection in blue. Lines 3 to 7 mainly follow the standard encoding from IARs to obtain <math id="S3.SS2.SSS0.Px1.p1.m1" class="ltx_Math" alttext="u_{i}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>i</mi></msub><annotation encoding="application/x-tex">u_{i}</annotation></semantics></math>, which is the integer representation of tokens for the current resolution <math id="S3.SS2.SSS0.Px1.p1.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.
The counter <math id="S3.SS2.SSS0.Px1.p1.m3" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>, defined in line 5, acts as an accumulator and denotes the number of times that tokens from the <math id="S3.SS2.SSS0.Px1.p1.m4" class="ltx_Math" alttext="green" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">green</annotation></semantics></math> list <math id="S3.SS2.SSS0.Px1.p1.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> are selected to represent the input image <math id="S3.SS2.SSS0.Px1.p1.m6" class="ltx_Math" alttext="im" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">im</annotation></semantics></math>. Note that the more times the selected tokens come from the <math id="S3.SS2.SSS0.Px1.p1.m7" class="ltx_Math" alttext="green" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">green</annotation></semantics></math> list <math id="S3.SS2.SSS0.Px1.p1.m8" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, the higher the probability that a watermark was embedded in the image <math id="S3.SS2.SSS0.Px1.p1.m9" class="ltx_Math" alttext="im" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">im</annotation></semantics></math>. In line 6, we iterate over the resolutions <math id="S3.SS2.SSS0.Px1.p1.m10" class="ltx_Math" alttext="i=1,\dots,K" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">i=1,\dots,K</annotation></semantics></math>.
Next, in a similar vein to watermark embedding from <a href="#algorithm1" title="In Embedding a Watermark. ‣ 3.1 Watermark Embedding ‣ 3 Watermarking Method for IARs ‣ Radioactive Watermarks in Diffusion and AutoregressiveImage Generative Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Algorithm</span> <span class="ltx_text ltx_ref_tag">1</span></a>, we obtain a random seed from the previous autoregressive unit <math id="S3.SS2.SSS0.Px1.p1.m11" class="ltx_Math" alttext="u_{i-1}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">u_{i-1}</annotation></semantics></math>. The intuition is that if we pick the same initial seed during encoding and decoding with the same pseudo random generator, and if the encoded previous autoregressive unit in the encoded image is the same as during the generation process, we will obtain the same seed and be able to divide the vocabulary into the same <math id="S3.SS2.SSS0.Px1.p1.m12" class="ltx_Math" alttext="green" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">green</annotation></semantics></math> and <math id="S3.SS2.SSS0.Px1.p1.m13" class="ltx_Math" alttext="red" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">red</annotation></semantics></math> lists.
The remaining steps follow standard IAR encoding.
Eventually, to detect the watermark, we analyze whether its tokens stem from the <math id="S3.SS2.SSS0.Px1.p1.m14" class="ltx_Math" alttext="green" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">green</annotation></semantics></math> or <math id="S3.SS2.SSS0.Px1.p1.m15" class="ltx_Math" alttext="red" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">red</annotation></semantics></math> lists.
We note that the autoregressive model <math id="S3.SS2.SSS0.Px1.p1.m16" class="ltx_Math" alttext="f_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">f_{\theta}</annotation></semantics></math> is not used for the watermark detection. Given the input image <math id="S3.SS2.SSS0.Px1.p1.m17" class="ltx_Math" alttext="im" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">im</annotation></semantics></math>, we only require the access to the image encoder <math id="S3.SS2.SSS0.Px1.p1.m18" class="ltx_Math" alttext="\mathcal{E}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">\mathcal{E}</annotation></semantics></math>, the quantizer <math id="S3.SS2.SSS0.Px1.p1.m19" class="ltx_Math" alttext="\mathcal{Q}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒬</mi><annotation encoding="application/x-tex">\mathcal{Q}</annotation></semantics></math>, and the pseudorandom generator <math id="S3.SS2.SSS0.Px1.p1.m20" class="ltx_Math" alttext="PRG" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">PRG</annotation></semantics></math>.</p>
</div>
<figure id="algorithm2" class="ltx_float ltx_algorithm ltx_align_center ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="algorithm2.4" class="ltx_text ltx_font_bold">Algorithm 2</span> </span><span id="algorithm2.5" class="ltx_text" style="font-size:90%;"> Image Encoding for IARs with WIAR <span id="algorithm2.5.1" class="ltx_text" style="--ltx-fg-color:#0000FF;">Watermark Detection</span></span></figcaption>
<div id="algorithm2.6" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="algorithm2.6.1" class="ltx_listingline">
<span id="algorithm2.6.1.1" class="ltx_text" style="font-size:90%;">
<span id="algorithm2.6.1.1.1" class="ltx_text ltx_font_bold">Inputs: </span> raw image <math id="algorithm2.m1" class="ltx_Math" alttext="im" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">im</annotation></semantics></math>, image encoder <math id="algorithm2.m2" class="ltx_Math" alttext="\mathcal{E}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">\mathcal{E}</annotation></semantics></math>, quantizer <math id="algorithm2.m3" class="ltx_Math" alttext="\mathcal{Q}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒬</mi><annotation encoding="application/x-tex">\mathcal{Q}</annotation></semantics></math> to the vocabulary <math id="algorithm2.m4" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> (codebook);</span>
</div>
<div id="algorithm2.6.2" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">1</span></span>
              <span id="algorithm2.6.2.2" class="ltx_text ltx_font_bold" style="font-size:90%;">Hyperparameters: </span><span id="algorithm2.6.2.3" class="ltx_text" style="font-size:90%;"> steps </span><math id="algorithm2.m5" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math><span id="algorithm2.6.2.4" class="ltx_text" style="font-size:90%;">, resolutions </span><math id="algorithm2.m6" class="ltx_Math" alttext="(h_{i},w_{i})_{i=1}^{K}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">h</mi><mi mathsize="0.900em">i</mi></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">w</mi><mi mathsize="0.900em">i</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">1</mn></mrow><mi mathsize="0.900em">K</mi></msubsup><annotation encoding="application/x-tex">(h_{i},w_{i})_{i=1}^{K}</annotation></semantics></math><span id="algorithm2.6.2.5" class="ltx_text" style="font-size:90%;">, </span><span id="algorithm2.6.2.6" class="ltx_text" style="font-size:90%;--ltx-fg-color:#0000FF;">the scaling ratio <math id="algorithm2.m7" class="ltx_Math" alttext="\gamma\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">γ</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">∈</mo><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">0</mn><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">,</mo><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma\in(0,1)</annotation></semantics></math> for the size of the <span id="algorithm2.6.2.6.1" class="ltx_text ltx_font_italic">Green</span> list</span><span id="algorithm2.6.2.7" class="ltx_text" style="font-size:90%;">;</span>
</div>
