<td id="S5.T2.10.14.4" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S5.T2.m29" class="ltx_Math" alttext="100" display="inline" intent=":literal"><semantics><mn mathsize="0.700em">100</mn><annotation encoding="application/x-tex">100</annotation></semantics></math></td>
<td id="S5.T2.10.14.5" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S5.T2.m30" class="ltx_Math" alttext="100" display="inline" intent=":literal"><semantics><mn mathsize="0.700em">100</mn><annotation encoding="application/x-tex">100</annotation></semantics></math></td></tr>
