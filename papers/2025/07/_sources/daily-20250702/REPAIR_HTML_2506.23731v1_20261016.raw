<td id="S5.T1.8.3.5" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S5.T1.m8" class="ltx_Math" alttext="80.39" display="inline" intent=":literal"><semantics><mn mathsize="0.700em">80.39</mn><annotation encoding="application/x-tex">80.39</annotation></semantics></math></td></tr>
<tr id="S5.T1.8.4" class="ltx_tr">
<td id="S5.T1.8.4.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T1.8.4.1.1" class="ltx_text" style="font-size:70%;">LDM</span></td>
<td id="S5.T1.8.4.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T1.8.4.2.1" class="ltx_text" style="font-size:70%;">LDM</span></td>
<td id="S5.T1.8.4.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T1.8.4.3.1" class="ltx_text" style="font-size:70%;">Recipe</span></td>
<td id="S5.T1.8.4.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S5.T1.m9" class="ltx_Math" alttext="0.32" display="inline" intent=":literal"><semantics><mn mathsize="0.700em">0.32</mn><annotation encoding="application/x-tex">0.32</annotation></semantics></math></td>
