<th id="S5.T1.8.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T1.8.1.5.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Output of <math id="S5.T1.m4" class="ltx_Math" alttext="M_{2}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mn>2</mn></msub><annotation encoding="application/x-tex">M_{2}</annotation></semantics></math></span></th></tr>
