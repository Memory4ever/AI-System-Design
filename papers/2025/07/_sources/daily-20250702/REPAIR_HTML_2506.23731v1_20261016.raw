              <math id="algorithm2.m8" class="ltx_Math" alttext="e=\mathcal{E}(im)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">e</mi><mo mathsize="0.900em">=</mo><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℰ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">m</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">e=\mathcal{E}(im)</annotation></semantics></math><span id="algorithm2.6.3.2" class="ltx_text" style="font-size:90%;">;</span>
