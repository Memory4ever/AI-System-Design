              <math id="algorithm2.m14" class="ltx_Math" alttext="\text{rand}=PRG(\text{seed})" display="inline" intent=":literal"><semantics><mrow><mtext style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" mathsize="0.900em">rand</mtext><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" mathsize="0.900em">=</mo><mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" mathsize="0.900em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" mathsize="0.900em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" mathsize="0.900em">G</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" maxsize="0.900em" minsize="0.900em">(</mo><mtext style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" mathsize="0.900em">seed</mtext><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{rand}=PRG(\text{seed})</annotation></semantics></math><span id="algorithm2.6.9.4" class="ltx_text" style="font-size:90%;--ltx-fg-color:#0000FF;">;</span>
