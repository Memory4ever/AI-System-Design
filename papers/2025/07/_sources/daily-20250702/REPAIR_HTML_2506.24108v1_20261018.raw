<td id="S6.T2.3.2.2" class="ltx_td ltx_align_center ltx_border_t">26.40</td>
<td id="S6.T2.3.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T2.3.2.3.1" class="ltx_text ltx_font_bold">32.29</span></td>
<td id="S6.T2.3.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T2.3.2.4.1" class="ltx_text ltx_font_bold">0.898</span></td></tr>
<tr id="S6.T2.3.3" class="ltx_tr">
<td id="S6.T2.3.3.1" class="ltx_td ltx_align_left">w/o <math id="S6.T2.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math></td>
<td id="S6.T2.3.3.2" class="ltx_td ltx_align_center">26.86</td>
