<td id="S1.F2.3.4.3" class="ltx_td ltx_align_center" style="padding-bottom: -2.0pt;"><img src="2506.24108v1/images/trajectories_new/two_dogs_one_cat_1/anneal_figure_ours.jpg" id="S1.F2.g7" class="ltx_graphics ltx_img_square" style="aspect-ratio:153/153;" width="153" height="153" alt="Refer to caption"></td></tr>
