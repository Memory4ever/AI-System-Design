    <arxiv:primary_category term="astro-ph.CO"/>
    <author>
      <name>Leander Thiele</name>
    </author>
    <author>
      <name>Adrian E. Bayer</name>
    </author>
    <author>
      <name>Naoya Takeishi</name>
