<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(c) </span> <math id="S5.F3.sf3.m2" class="ltx_Math" alttext="\text{HotpotQA}^{*}" display="inline" intent=":literal"><semantics><msup><mtext>HotpotQA</mtext><mo>∗</mo></msup><annotation encoding="application/x-tex">\text{HotpotQA}^{*}</annotation></semantics></math>/EM</figcaption>
