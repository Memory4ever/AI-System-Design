<span id="S5.T5.2.1.1.1.23.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding:-0.25pt 7.5pt;"><span id="S5.T5.2.1.1.1.23.2.1" class="ltx_text ltx_font_bold">66.2</span></span>
