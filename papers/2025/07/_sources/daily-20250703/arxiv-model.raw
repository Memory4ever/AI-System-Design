      <name>Roberto Maiolino</name>
    </author>
    <author>
      <name>Camilo Casimiro</name>
    </author>
    <author>
      <name>Thomas Pinto Franco</name>
    </author>
    <author>
      <name>Nicolas Cea</name>
    </author>
    <arxiv:doi>10.1051/0004-6361/202554702</arxiv:doi>
