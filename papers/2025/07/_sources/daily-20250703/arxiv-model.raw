      <name>Monowar Hasan</name>
      <arxiv:affiliation>Washington State University</arxiv:affiliation>
    </author>
    <author>
      <name>Santu Karmaker</name>
      <arxiv:affiliation>University of Central Florida</arxiv:affiliation>
    </author>
