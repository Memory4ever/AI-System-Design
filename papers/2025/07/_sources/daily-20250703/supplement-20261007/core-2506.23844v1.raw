<span id="S1.T1.2.5.2.1.1" class="ltx_p ltx_align_center"><span id="S1.T1.2.5.2.1.1.1" class="ltx_text" style="--ltx-bg-color:#CCFFCC;">Passive outputs</span></span>
</span></td>
<td id="S1.T1.2.5.3" class="ltx_td ltx_align_left ltx_align_middle ltx_border_r ltx_border_t" style="--ltx-bg-color:#FFFFBF;padding-top:2pt;padding-bottom:2pt;">
