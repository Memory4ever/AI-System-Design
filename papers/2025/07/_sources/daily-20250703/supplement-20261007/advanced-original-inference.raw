              <span class="tag is-dark is-size-7">doi</span>
              <span class="tag is-light is-size-7"><a class="" href="https://doi.org/10.1145/3649601.3698722">10.1145/3649601.3698722 <i class="fa fa-external-link" aria-hidden="true"></i></a></span>
            </div>
