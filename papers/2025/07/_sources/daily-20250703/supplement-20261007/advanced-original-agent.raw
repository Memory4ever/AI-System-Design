        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.23689">pdf</a>, <a href="https://arxiv.org/ps/2506.23689">ps</a>, <a href="https://arxiv.org/format/2506.23689">other</a>]&nbsp;</span>
