<table id="A2.T12.2" class="ltx_tabular ltx_centering ltx_align_middle">
<tr id="A2.T12.2.1" class="ltx_tr">
<td id="A2.T12.2.1.1" class="ltx_td ltx_align_left ltx_border_tt"><span id="A2.T12.2.1.1.1" class="ltx_text" style="font-size:90%;">Prompt type</span></td>
<td id="A2.T12.2.1.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_tt">
<span id="A2.T12.2.1.2.1" class="ltx_inline-block ltx_align_top" style="width:364.2pt;">
<span id="A2.T12.2.1.2.1.1" class="ltx_p"><span id="A2.T12.2.1.2.1.1.1" class="ltx_text" style="font-size:90%;">Prompt template</span></span>
</span></td></tr>
<tr id="A2.T12.2.2" class="ltx_tr">
<td id="A2.T12.2.2.1" class="ltx_td ltx_align_left ltx_border_t"><span id="A2.T12.2.2.1.1" class="ltx_text" style="font-size:90%;">Verbalized</span></td>
<td id="A2.T12.2.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t"><span id="A2.T12.2.2.2.1" class="ltx_inline-logical-block ltx_align_top" style="width:364.2pt;">
<span id="A2.T12.p1" class="ltx_para ltx_noindent">
<span id="A2.T12.p1.1" class="ltx_p"><span id="A2.T12.p1.1.1" class="ltx_text"></span><span id="A2.T12.p1.1.2" class="ltx_text" style="font-size:90%;">
<span id="A2.T12.p1.1.2.1" class="ltx_tabular ltx_align_middle">
<span id="A2.T12.p1.1.2.1.1" class="ltx_tr">
<span id="A2.T12.p1.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left">What percentage of people would respond with {answer choices} to the following question?</span></span>
<span id="A2.T12.p1.1.2.1.2" class="ltx_tr">
<span id="A2.T12.p1.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_left">Question: ‘{q}’</span></span>
<span id="A2.T12.p1.1.2.1.3" class="ltx_tr">
<span id="A2.T12.p1.1.2.1.3.1" class="ltx_td ltx_nopad_r ltx_align_left">Respond with a list of {l} numbers which represent the percentages for {answer choices}</span></span>
<span id="A2.T12.p1.1.2.1.4" class="ltx_tr">
<span id="A2.T12.p1.1.2.1.4.1" class="ltx_td ltx_nopad_r ltx_align_left">in that order.</span></span>
<span id="A2.T12.p1.1.2.1.5" class="ltx_tr">
<span id="A2.T12.p1.1.2.1.5.1" class="ltx_td ltx_nopad_r ltx_align_left">Expected response format: [, , , ,]</span></span>
<span id="A2.T12.p1.1.2.1.6" class="ltx_tr">
<span id="A2.T12.p1.1.2.1.6.1" class="ltx_td ltx_nopad_r ltx_align_left">Response:</span></span>
</span></span><span id="A2.T12.p1.1.3" class="ltx_text"></span></span>
</span></span></td></tr>
<tr id="A2.T12.2.3" class="ltx_tr">
<td id="A2.T12.2.3.1" class="ltx_td ltx_align_left"><span id="A2.T12.2.3.1.1" class="ltx_text" style="font-size:90%;">Log probabilities</span></td>
<td id="A2.T12.2.3.2" class="ltx_td ltx_align_left ltx_align_top"><span id="A2.T12.2.3.2.1" class="ltx_inline-logical-block ltx_align_top" style="width:364.2pt;">
<span id="A2.T12.p2" class="ltx_para ltx_noindent">
<span id="A2.T12.p2.1" class="ltx_p"><span id="A2.T12.p2.1.1" class="ltx_text"></span><span id="A2.T12.p2.1.2" class="ltx_text" style="font-size:90%;">
<span id="A2.T12.p2.1.2.1" class="ltx_tabular ltx_align_middle">
<span id="A2.T12.p2.1.2.1.1" class="ltx_tr">
<span id="A2.T12.p2.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left">Would you respond with {answer choices} to the following question?</span></span>
<span id="A2.T12.p2.1.2.1.2" class="ltx_tr">
<span id="A2.T12.p2.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_left">Question: ‘{q}’</span></span>
<span id="A2.T12.p2.1.2.1.3" class="ltx_tr">
