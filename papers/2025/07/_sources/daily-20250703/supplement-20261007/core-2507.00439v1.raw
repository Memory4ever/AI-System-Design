<td id="S6.T3.2.2.5" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.3pt;padding-right:4.3pt;"><span id="S6.T3.2.2.5.1" class="ltx_text" style="font-size:80%;">79.4</span></td>
<td id="S6.T3.2.2.6" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.3pt;padding-right:4.3pt;"><span id="S6.T3.2.2.6.1" class="ltx_text" style="font-size:80%;">1.6</span></td></tr>
