<td id="S3.T1.2.2.12" class="ltx_td ltx_align_right" style="padding-left:3.4pt;padding-right:3.4pt;"><math id="S3.T1.m11" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math></td>
<td id="S3.T1.2.2.13" class="ltx_td ltx_align_right" style="padding-left:3.4pt;padding-right:3.4pt;"><span id="S3.T1.2.2.13.1" class="ltx_text" style="font-size:80%;">​<math id="S3.T1.m12" class="ltx_Math" alttext="V_{C}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>C</mi></msub><annotation encoding="application/x-tex">V_{C}</annotation></semantics></math></span></td></tr>
<tr id="S3.T1.2.3" class="ltx_tr">
<td id="S3.T1.2.3.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.4pt;padding-right:3.4pt;" rowspan="5"><span id="S3.T1.2.3.1.1" class="ltx_text" style="font-size:80%;">
<span id="S3.T1.2.3.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:5.5pt;height:23.2pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:23.2pt;transform:translate(-8.9pt,-8.9pt) rotate(-90deg) ;">
<span id="S3.T1.2.3.1.1.1.1" class="ltx_p">WGM</span>
</span></span></span></td>
