<td id="S3.T1.2.2.10" class="ltx_td ltx_align_right" style="padding-left:3.4pt;padding-right:3.4pt;"><math id="S3.T1.m9" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math></td>
