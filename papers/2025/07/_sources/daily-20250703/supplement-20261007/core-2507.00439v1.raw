<td id="S3.T1.2.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-left:3.4pt;padding-right:3.4pt;" rowspan="2"><span id="S3.T1.2.1.2.1" class="ltx_text" style="font-size:80%;">Model</span></td>
<td id="S3.T1.2.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.4pt;padding-right:3.4pt;" colspan="6"><span id="S3.T1.2.1.3.1" class="ltx_text" style="font-size:80%;">Base prompt</span></td>
