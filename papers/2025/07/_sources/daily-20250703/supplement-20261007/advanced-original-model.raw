        <span>&nbsp;[<a href="https://arxiv.org/pdf/2507.02989">pdf</a>, <a href="https://arxiv.org/ps/2507.02989">ps</a>, <a href="https://arxiv.org/format/2507.02989">other</a>]&nbsp;</span>
