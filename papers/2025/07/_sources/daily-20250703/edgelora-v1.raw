            <span id="algorithm1.4.4.2" class="ltx_text ltx_font_bold">return</span> <math id="algorithm1.m9" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> ;  <span id="algorithm1.4.4.3" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm1.4.4.4" class="ltx_text ltx_font_typewriter">Bypass adaptive selection</span>
