              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.3.1" class="ltx_text ltx_font_bold">1</span></span>
            <span id="algorithm1.4.3.2" class="ltx_text ltx_font_bold">if</span> <em id="algorithm1.4.3.3" class="ltx_emph ltx_font_italic">Adapter <math id="algorithm1.m7" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> is explicitly specified for request <math id="algorithm1.m8" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math></em> <span id="algorithm1.4.3.4" class="ltx_text ltx_font_bold">then</span>
