<th id="S5.T8.7.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T8.7.1.3.1" class="ltx_text ltx_font_sansserif">EdgeLoRA</span></th></tr>
