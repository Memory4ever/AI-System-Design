</ul>
</div></li>
<li id="A4.I2.i3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="A4.I2.i3.I1.i2.1" class="ltx_text ltx_font_bold">–</span></span> 
<div id="A4.I2.i3.I1.i2.p1" class="ltx_para">
<p id="A4.I2.i3.I1.i2.p1.1" class="ltx_p">High quality images:</p>
<ul id="A4.I2.i3.I1.i2.I1" class="ltx_itemize">
<li id="A4.I2.i3.I1.i2.I1.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"></span>
<div id="A4.I2.i3.I1.i2.I1.ix1.p1" class="ltx_para">
<p id="A4.I2.i3.I1.i2.I1.ix1.p1.1" class="ltx_p"><math id="A4.I2.i3.I1.i2.I1.ix1.p1.m1" class="ltx_Math" alttext="c^{+}=" display="inline" intent=":literal"><semantics><mrow><msup><mi>c</mi><mo>+</mo></msup><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">c^{+}=</annotation></semantics></math> <span id="A4.I2.i3.I1.i2.I1.ix1.p1.1.1" class="ltx_text ltx_font_typewriter">"high detail, 8k, intricate, detailed, high resolution, high res, high quality, hyper realistic"</span></p>
</div></li>
<li id="A4.I2.i3.I1.i2.I1.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"></span>
<div id="A4.I2.i3.I1.i2.I1.ix2.p1" class="ltx_para">
<p id="A4.I2.i3.I1.i2.I1.ix2.p1.1" class="ltx_p"><math id="A4.I2.i3.I1.i2.I1.ix2.p1.m1" class="ltx_Math" alttext="c^{-}=" display="inline" intent=":literal"><semantics><mrow><msup><mi>c</mi><mo>−</mo></msup><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">c^{-}=</annotation></semantics></math> <span id="A4.I2.i3.I1.i2.I1.ix2.p1.1.1" class="ltx_text ltx_font_typewriter">"blurry, boring, fuzzy, low detail, low resolution, low res, low quality"</span></p>
</div></li>
<li id="A4.I2.i3.I1.i2.I1.ix3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"></span>
<div id="A4.I2.i3.I1.i2.I1.ix3.p1" class="ltx_para">
<p id="A4.I2.i3.I1.i2.I1.ix3.p1.1" class="ltx_p"><math id="A4.I2.i3.I1.i2.I1.ix3.p1.m1" class="ltx_Math" alttext="c=" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">c=</annotation></semantics></math> <span id="A4.I2.i3.I1.i2.I1.ix3.p1.1.1" class="ltx_text ltx_font_typewriter">""</span></p>
</div></li>
</ul>
</div></li>
</ul>
</div></li>
<li id="A4.I2.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I2.i4.p1" class="ltx_para">
<p id="A4.I2.i4.p1.1" class="ltx_p"><span id="A4.I2.i4.p1.1.1" class="ltx_text ltx_font_bold">Concept learning</span>:</p>
<ul id="A4.I2.i4.I1" class="ltx_itemize">
<li id="A4.I2.i4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="A4.I2.i4.I1.i1.1" class="ltx_text ltx_font_bold">–</span></span> 
<div id="A4.I2.i4.I1.i1.p1" class="ltx_para">
<p id="A4.I2.i4.I1.i1.p1.1" class="ltx_p">Hug:</p>
<ul id="A4.I2.i4.I1.i1.I1" class="ltx_itemize">
<li id="A4.I2.i4.I1.i1.I1.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"></span>
<div id="A4.I2.i4.I1.i1.I1.ix1.p1" class="ltx_para">
<p id="A4.I2.i4.I1.i1.I1.ix1.p1.1" class="ltx_p"><math id="A4.I2.i4.I1.i1.I1.ix1.p1.m1" class="ltx_Math" alttext="c^{+}=" display="inline" intent=":literal"><semantics><mrow><msup><mi>c</mi><mo>+</mo></msup><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">c^{+}=</annotation></semantics></math> <span id="A4.I2.i4.I1.i1.I1.ix1.p1.1.1" class="ltx_text ltx_font_typewriter">"people hug each other"</span></p>
</div></li>
<li id="A4.I2.i4.I1.i1.I1.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"></span>
<div id="A4.I2.i4.I1.i1.I1.ix2.p1" class="ltx_para">
<p id="A4.I2.i4.I1.i1.I1.ix2.p1.1" class="ltx_p"><math id="A4.I2.i4.I1.i1.I1.ix2.p1.m1" class="ltx_Math" alttext="c^{-}=" display="inline" intent=":literal"><semantics><mrow><msup><mi>c</mi><mo>−</mo></msup><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">c^{-}=</annotation></semantics></math> <span id="A4.I2.i4.I1.i1.I1.ix2.p1.1.1" class="ltx_text ltx_font_typewriter">"people"</span></p>
</div></li>
<li id="A4.I2.i4.I1.i1.I1.ix3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"></span>
<div id="A4.I2.i4.I1.i1.I1.ix3.p1" class="ltx_para">
<p id="A4.I2.i4.I1.i1.I1.ix3.p1.1" class="ltx_p"><math id="A4.I2.i4.I1.i1.I1.ix3.p1.m1" class="ltx_Math" alttext="c=" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">c=</annotation></semantics></math> <span id="A4.I2.i4.I1.i1.I1.ix3.p1.1.1" class="ltx_text ltx_font_typewriter">"people"</span></p>
</div></li>
</ul>
</div></li>
<li id="A4.I2.i4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="A4.I2.i4.I1.i2.1" class="ltx_text ltx_font_bold">–</span></span> 
<div id="A4.I2.i4.I1.i2.p1" class="ltx_para">
<p id="A4.I2.i4.I1.i2.p1.1" class="ltx_p">Shake hands:</p>
<ul id="A4.I2.i4.I1.i2.I1" class="ltx_itemize">
<li id="A4.I2.i4.I1.i2.I1.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"></span>
<div id="A4.I2.i4.I1.i2.I1.ix1.p1" class="ltx_para">
<p id="A4.I2.i4.I1.i2.I1.ix1.p1.1" class="ltx_p"><math id="A4.I2.i4.I1.i2.I1.ix1.p1.m1" class="ltx_Math" alttext="c^{+}=" display="inline" intent=":literal"><semantics><mrow><msup><mi>c</mi><mo>+</mo></msup><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">c^{+}=</annotation></semantics></math> <span id="A4.I2.i4.I1.i2.I1.ix1.p1.1.1" class="ltx_text ltx_font_typewriter">"people shake their hands"</span></p>
</div></li>
<li id="A4.I2.i4.I1.i2.I1.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"></span>
<div id="A4.I2.i4.I1.i2.I1.ix2.p1" class="ltx_para">
<p id="A4.I2.i4.I1.i2.I1.ix2.p1.1" class="ltx_p"><math id="A4.I2.i4.I1.i2.I1.ix2.p1.m1" class="ltx_Math" alttext="c^{-}=" display="inline" intent=":literal"><semantics><mrow><msup><mi>c</mi><mo>−</mo></msup><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">c^{-}=</annotation></semantics></math> <span id="A4.I2.i4.I1.i2.I1.ix2.p1.1.1" class="ltx_text ltx_font_typewriter">"people"</span></p>
</div></li>
<li id="A4.I2.i4.I1.i2.I1.ix3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"></span>
<div id="A4.I2.i4.I1.i2.I1.ix3.p1" class="ltx_para">
<p id="A4.I2.i4.I1.i2.I1.ix3.p1.1" class="ltx_p"><math id="A4.I2.i4.I1.i2.I1.ix3.p1.m1" class="ltx_Math" alttext="c=" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">c=</annotation></semantics></math> <span id="A4.I2.i4.I1.i2.I1.ix3.p1.1.1" class="ltx_text ltx_font_typewriter">"people"</span></p>
</div></li>
</ul>
</div></li>
</ul>
</div></li>
</ul>
</div>
<section id="A4.SS2.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Note on Model debugging</h4>

<div id="A4.SS2.SSS0.Px1.p1" class="ltx_para">
<p id="A4.SS2.SSS0.Px1.p1.1" class="ltx_p">For the model debugging study, we perform bidirectional attribution by swapping <math id="A4.SS2.SSS0.Px1.p1.m1" class="ltx_Math" alttext="c^{+}" display="inline" intent=":literal"><semantics><msup><mi>c</mi><mo>+</mo></msup><annotation encoding="application/x-tex">c^{+}</annotation></semantics></math> and <math id="A4.SS2.SSS0.Px1.p1.m2" class="ltx_Math" alttext="c^{-}" display="inline" intent=":literal"><semantics><msup><mi>c</mi><mo>−</mo></msup><annotation encoding="application/x-tex">c^{-}</annotation></semantics></math> to identify both positive and negative influences. This allows us to trace training samples that contribute to both problematic and desirable generation.</p>
</div>
</section>
</section>
</section>
<section id="A5" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix E </span>Algorithm</h2>

<div id="A5.p1" class="ltx_para">
<p id="A5.p1.1" class="ltx_p">In this section, we provide detailed algorithms for computing training gradients using DPS-loss (Algorithm <a href="#alg1" title="Algorithm 1 ‣ Appendix E Algorithm ‣ Concept-TRAK: Understanding how diffusion models learn concepts through concept-level attribution" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>) and utility gradients using Reward-DPS-loss (Algorithm <a href="#alg2" title="Algorithm 2 ‣ Appendix E Algorithm ‣ Concept-TRAK: Understanding how diffusion models learn concepts through concept-level attribution" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>) used in <span id="A5.p1.1.1" class="ltx_text ltx_font_italic">Concept-TRAK</span>. The key computational steps highlighted in red show the guidance terms that distinguish our approach from standard methods.</p>
</div>
<figure id="A5.fig1" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2">
<figure id="alg1" class="ltx_float ltx_figure_panel ltx_float_algorithm ltx_minipage ltx_align_center ltx_align_top ltx_framed ltx_framed_top" style="width:169.1pt;">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.4" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> <span id="alg1.5" class="ltx_text ltx_font_bold">DPS-Loss</span></figcaption>
<div id="alg1.6" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
            <math id="alg1.l1.m1" class="ltx_Math" alttext="x_{0}^{i}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mn>0</mn><mi>i</mi></msubsup><annotation encoding="application/x-tex">x_{0}^{i}</annotation></semantics></math>, <math id="alg1.l1.m2" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>, <math id="alg1.l1.m3" class="ltx_Math" alttext="\{\bar{\alpha}_{t}\}_{t=0}^{T}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mi>T</mi></msubsup><annotation encoding="application/x-tex">\{\bar{\alpha}_{t}\}_{t=0}^{T}</annotation></semantics></math>

</div>
<div id="alg1.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
            <span id="alg1.l2.3" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l2.m1" class="ltx_Math" alttext="n=1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n=1</annotation></semantics></math> <span id="alg1.l2.4" class="ltx_text ltx_font_bold">to</span> <math id="alg1.l2.m2" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> <span id="alg1.l2.5" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
              <math id="alg1.l3.m1" class="ltx_math_unparsed" alttext="x_{t}^{i}\leftarrow\text{DDIMinv}(x_{0}^{i},0\rightarrow\frac{nT}{N}),t\leftarrow\frac{nT}{N}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>x</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">←</mo><mtext>DDIMinv</mtext><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mn>0</mn><mi>i</mi></msubsup><mo>,</mo><mn>0</mn><mo stretchy="false">→</mo><mfrac><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mi>N</mi></mfrac><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>t</mi><mo stretchy="false">←</mo><mfrac><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mi>N</mi></mfrac></mrow><annotation encoding="application/x-tex">x_{t}^{i}\leftarrow\text{DDIMinv}(x_{0}^{i},0\rightarrow\frac{nT}{N}),t\leftarrow\frac{nT}{N}</annotation></semantics></math>

</div>
<div id="alg1.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
              <math id="alg1.l4.m1" class="ltx_Math" alttext="\hat{x}_{0}^{i}\leftarrow\frac{1}{\sqrt{\bar{\alpha}_{t}}}\left(x_{t}^{i}-\sqrt{1-\bar{\alpha}_{t}}\,\epsilon_{\theta}(x_{t}^{i})\right)" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mn>0</mn><mi>i</mi></msubsup><mo stretchy="false">←</mo><mrow><mfrac><mn>1</mn><msqrt><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>x</mi><mi>t</mi><mi>i</mi></msubsup><mo>−</mo><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></msqrt><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{x}_{0}^{i}\leftarrow\frac{1}{\sqrt{\bar{\alpha}_{t}}}\left(x_{t}^{i}-\sqrt{1-\bar{\alpha}_{t}}\,\epsilon_{\theta}(x_{t}^{i})\right)</annotation></semantics></math>

</div>
<div id="alg1.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
              <math id="alg1.l5.m1" class="ltx_Math" alttext="\delta_{\text{DPS}}\leftarrow-\nabla_{x_{t}}\|\hat{x}_{0}^{i}-x_{0}^{i}\|^{2}_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">δ</mi><mtext style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">DPS</mtext></msub><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">←</mo><mrow><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" rspace="0.167em">−</mo><mrow><msub><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">∇</mo><msub><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">x</mi><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">t</mi></msub></msub><msubsup><mrow><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">‖</mo><mrow><msubsup><mover accent="true"><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">x</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">^</mo></mover><mn style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">0</mn><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">i</mi></msubsup><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">−</mo><msubsup><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">x</mi><mn style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">0</mn><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">i</mi></msubsup></mrow><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">‖</mo></mrow><mn style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">2</mn><mn style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta_{\text{DPS}}\leftarrow-\nabla_{x_{t}}\|\hat{x}_{0}^{i}-x_{0}^{i}\|^{2}_{2}</annotation></semantics></math>

</div>
<div id="alg1.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
              
              
              <math id="alg1.l6.m1" class="ltx_Math" alttext="\tilde{\epsilon}_{\theta}(x_{t}^{i})\leftarrow\text{sg}[\epsilon_{\theta}(x_{t}^{i})-{\color[rgb]{1,0,0}\delta_{\text{DPS}}}]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>ϵ</mi><mo>~</mo></mover><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mtext>sg</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">δ</mi><mtext style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">DPS</mtext></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{\epsilon}_{\theta}(x_{t}^{i})\leftarrow\text{sg}[\epsilon_{\theta}(x_{t}^{i})-{\color[rgb]{1,0,0}\delta_{\text{DPS}}}]</annotation></semantics></math>

</div>
<div id="alg1.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
              
              
              <math id="alg1.l7.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{DPS}}\leftarrow\|\tilde{\epsilon}_{\theta}(x_{t}^{i})-\epsilon_{\theta}(x_{t}^{i})\|^{2}_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>DPS</mtext></msub><mo stretchy="false">←</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mover accent="true"><mi>ϵ</mi><mo>~</mo></mover><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{DPS}}\leftarrow\|\tilde{\epsilon}_{\theta}(x_{t}^{i})-\epsilon_{\theta}(x_{t}^{i})\|^{2}_{2}</annotation></semantics></math>

</div>
<div id="alg1.l8" class="ltx_listingline">
