<td id="S6.T2.2.1.2.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S6.T2.2.1.2.1.1" class="ltx_text ltx_font_bold">Direct SFT Forward</span></td>
<td id="S6.T2.2.1.2.2" class="ltx_td ltx_align_right ltx_border_t">4k</td>
