<tr id="S4.T1.2.1.3" class="ltx_tr" style="--ltx-bg-color:#D9D9D9;">
<th id="S4.T1.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" colspan="15"><span id="S4.T1.2.1.3.1.1" class="ltx_text ltx_font_italic">General Visual Language Models</span></th></tr>
<tr id="S4.T1.2.1.4" class="ltx_tr">
<th id="S4.T1.2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">LLaVA-v1.6-7B <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib23" title="" class="ltx_ref">Liu et al., 2023</a>)</cite></th>
<td id="S4.T1.2.1.4.2" class="ltx_td ltx_align_right">67.67</td>
<td id="S4.T1.2.1.4.3" class="ltx_td ltx_align_right">63.97</td>
<td id="S4.T1.2.1.4.4" class="ltx_td ltx_align_right">17.92</td>
<td id="S4.T1.2.1.4.5" class="ltx_td ltx_align_right">0.00</td>
