<div id="A2.T5.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:26.1pt;vertical-align:-12.0pt;"><span class="ltx_transformed_inner" style="transform:translate(-238.8pt,18.1pt) scale(0.419374813995668,0.419374813995668) ;">
