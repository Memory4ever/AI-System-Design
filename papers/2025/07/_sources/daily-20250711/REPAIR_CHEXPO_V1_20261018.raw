<td id="S6.T2.2.1.3.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="S6.T2.2.1.3.1.1" class="ltx_text ltx_font_bold">Retrieval + Forward</span></td>
<td id="S6.T2.2.1.3.2" class="ltx_td ltx_align_right ltx_border_bb">1.8k</td>
<td id="S6.T2.2.1.3.3" class="ltx_td ltx_align_right ltx_border_bb"><math id="S6.T2.m2" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo>∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math>55%</td>
<td id="S6.T2.2.1.3.4" class="ltx_td ltx_align_right ltx_border_bb">2700</td>
