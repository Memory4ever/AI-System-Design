<td id="S4.T1.8.1.7.2" class="ltx_td ltx_align_center"><span id="S4.T1.8.1.7.2.1" class="ltx_text" style="font-size:120%;">0</span></td>
<td id="S4.T1.8.1.7.3" class="ltx_td ltx_align_center"><span id="S4.T1.8.1.7.3.1" class="ltx_text" style="font-size:120%;">10</span></td>
<td id="S4.T1.8.1.7.4" class="ltx_td ltx_align_center"><span id="S4.T1.8.1.7.4.1" class="ltx_text" style="font-size:120%;">0.237</span></td></tr>
<tr id="S4.T1.8.1.8" class="ltx_tr">
<td id="S4.T1.8.1.8.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T1.8.1.8.1.1" class="ltx_text ltx_font_smallcaps">3D-Generalist</span> ablations</td>
<td id="S4.T1.8.1.8.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.8.1.8.2.1" class="ltx_text" style="font-size:120%;">3</span></td>
<td id="S4.T1.8.1.8.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.8.1.8.3.1" class="ltx_text" style="font-size:120%;">3</span></td>
<td id="S4.T1.8.1.8.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.8.1.8.4.1" class="ltx_text" style="font-size:120%;">0.254</span></td></tr>
<tr id="S4.T1.8.1.9" class="ltx_tr">
<td id="S4.T1.8.1.9.1" class="ltx_td"></td>
<td id="S4.T1.8.1.9.2" class="ltx_td ltx_align_center"><span id="S4.T1.8.1.9.2.1" class="ltx_text" style="font-size:120%;">2</span></td>
<td id="S4.T1.8.1.9.3" class="ltx_td ltx_align_center"><span id="S4.T1.8.1.9.3.1" class="ltx_text" style="font-size:120%;">3</span></td>
