<td id="S4.T1.8.1.5.3" class="ltx_td ltx_align_center"><span id="S4.T1.8.1.5.3.1" class="ltx_text" style="font-size:120%;">10</span></td>
<td id="S4.T1.8.1.5.4" class="ltx_td ltx_align_center"><span id="S4.T1.8.1.5.4.1" class="ltx_text ltx_font_bold" style="font-size:120%;">0.275</span></td></tr>
