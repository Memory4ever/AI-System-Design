<td id="S4.T1.8.1.6.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.8.1.6.2.1" class="ltx_text" style="font-size:120%;">0</span></td>
<td id="S4.T1.8.1.6.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.8.1.6.3.1" class="ltx_text" style="font-size:120%;">10</span></td>
<td id="S4.T1.8.1.6.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.8.1.6.4.1" class="ltx_text" style="font-size:120%;">0.252</span></td></tr>
