<th id="S4.T5.5.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T5.5.1.1.2.1" class="ltx_text ltx_font_bold"># Labels</span></th>
<th id="S4.T5.5.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T5.5.1.1.3.1" class="ltx_text ltx_font_bold">ImageNet-1K Top 1 <math id="S4.T5.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo class="ltx_mathvariant_bold" mathvariant="bold" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></th></tr>
