<td id="S4.T1.8.1.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T1.8.1.1.2.1" class="ltx_text ltx_font_bold"># Training Runs</span></td>
<td id="S4.T1.8.1.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T1.8.1.1.3.1" class="ltx_text ltx_font_bold"># Actions</span></td>
<td id="S4.T1.8.1.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T1.8.1.1.4.1" class="ltx_text ltx_font_bold">CLIP Score</span></td></tr>
