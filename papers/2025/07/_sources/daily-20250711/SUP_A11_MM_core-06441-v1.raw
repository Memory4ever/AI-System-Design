<table id="S5.T3.5" class="ltx_tabular ltx_centering ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="S5.T3.5.1" class="ltx_tr">
<td id="S5.T3.5.1.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" rowspan="2"><span id="S5.T3.5.1.1.1" class="ltx_text">Traffic Density</span></td>
<td id="S5.T3.5.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" colspan="3"><span id="S5.T3.5.1.2.1" class="ltx_text ltx_font_bold">Without Safety Layer</span></td>
<td id="S5.T3.5.1.3" class="ltx_td ltx_align_center ltx_border_t" colspan="3"><span id="S5.T3.5.1.3.1" class="ltx_text ltx_font_bold">With Safety Layer</span></td></tr>
<tr id="S5.T3.5.2" class="ltx_tr">
<td id="S5.T3.5.2.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">
<span id="S5.T3.5.2.1.1" class="ltx_inline-block">
<span id="S5.T3.5.2.1.1.1" class="ltx_p"><span id="S5.T3.5.2.1.1.1.1" class="ltx_text ltx_font_bold">Method</span></span>
<span id="S5.T3.5.2.1.1.2" class="ltx_p"><span id="S5.T3.5.2.1.1.2.1" class="ltx_text ltx_font_bold">name</span></span>
</span></td>
<td id="S5.T3.5.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">
