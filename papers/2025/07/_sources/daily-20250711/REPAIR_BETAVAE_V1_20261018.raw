<th id="S6.T2.9.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S6.T2.9.2.6.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#000000;">MIG</span></th>
<th id="S6.T2.9.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S6.T2.9.2.7.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#000000;">DCI</span></th></tr>
