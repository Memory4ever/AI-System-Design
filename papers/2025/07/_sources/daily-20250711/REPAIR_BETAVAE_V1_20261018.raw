<th id="A3.T4.8.11.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r"><span id="A3.T4.8.11.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Embedding dim</span></th>
