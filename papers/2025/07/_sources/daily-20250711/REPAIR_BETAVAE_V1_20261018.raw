<tr id="A3.T4.8.10" class="ltx_tr">
<th id="A3.T4.8.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r"><span id="A3.T4.8.10.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Double </span><math id="A3.T4.m3" class="ltx_Math" alttext="\bm{z}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒛</mi><annotation encoding="application/x-tex">\bm{z}</annotation></semantics></math></th>
<td id="A3.T4.8.10.2" class="ltx_td ltx_align_center ltx_border_r"><span id="A3.T4.8.10.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">False</span></td></tr>
