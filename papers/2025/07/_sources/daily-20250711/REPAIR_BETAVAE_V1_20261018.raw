<td id="S6.T2.9.3.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T2.9.3.5.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#000000;">0.611 <math id="S6.T2.m8" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.127</span></td>
<td id="S6.T2.9.3.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T2.9.3.6.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#000000;">0.098 <math id="S6.T2.m9" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.027</span></td>
<td id="S6.T2.9.3.7" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T2.9.3.7.1" class="ltx_text ltx_underline" style="font-size:70%;--ltx-fg-color:#000000;">0.246</span><span id="S6.T2.9.3.7.2" class="ltx_text" style="font-size:70%;--ltx-fg-color:#000000;"> <math id="S6.T2.m10" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.066</span></td></tr>
<tr id="S6.T2.9.4" class="ltx_tr">
<th id="S6.T2.9.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="S6.T2.m11" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math><span id="S6.T2.9.4.1.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#000000;">-TCVAE</span></th>
<td id="S6.T2.9.4.2" class="ltx_td ltx_align_center"><span id="S6.T2.9.4.2.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#000000;">0.080 <math id="S6.T2.m12" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.024</span></td>
<td id="S6.T2.9.4.3" class="ltx_td ltx_align_center"><span id="S6.T2.9.4.3.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#000000;">0.140 <math id="S6.T2.m13" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.020</span></td>
