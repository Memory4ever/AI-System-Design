<tr id="S6.T2.9.2" class="ltx_tr">
<th id="S6.T2.9.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row"><span id="S6.T2.9.2.1.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#000000;">Method</span></th>
<th id="S6.T2.9.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S6.T2.9.2.2.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#000000;">MIG<math id="S6.T2.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></th>
