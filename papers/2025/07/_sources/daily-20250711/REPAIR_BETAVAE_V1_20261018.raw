<th id="S6.T2.9.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="2"><span id="S6.T2.9.1.3.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#000000;">Shapes3D</span></th>
