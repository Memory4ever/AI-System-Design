<td id="S5.T2.2.4.2" class="ltx_td ltx_align_center">87.5</td>
<td id="S5.T2.2.4.3" class="ltx_td ltx_align_center">0.0264</td>
<td id="S5.T2.2.4.4" class="ltx_td ltx_align_center">0.978</td>
<td id="S5.T2.2.4.5" class="ltx_td ltx_align_center">1.3</td></tr>
<tr id="S5.T2.2.5" class="ltx_tr">
<th id="S5.T2.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Qwen2.5-VL-3B</th>
<td id="S5.T2.2.5.2" class="ltx_td ltx_align_center">84.4</td>
<td id="S5.T2.2.5.3" class="ltx_td ltx_align_center">0.0329</td>
<td id="S5.T2.2.5.4" class="ltx_td ltx_align_center">0.973</td>
<td id="S5.T2.2.5.5" class="ltx_td ltx_align_center"><span id="S5.T2.2.5.5.1" class="ltx_text ltx_font_bold">1.2</span></td></tr>
<tr id="S5.T2.2.6" class="ltx_tr">
<th id="S5.T2.2.6.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" colspan="5"><span id="S5.T2.2.6.1.1" class="ltx_text ltx_font_italic">Test Dataset (218 handwritten samples)</span></th></tr>
<tr id="S5.T2.2.7" class="ltx_tr">
<th id="S5.T2.2.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">LLaMA-3.2-11B</th>
<td id="S5.T2.2.7.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T2.2.7.2.1" class="ltx_text ltx_font_bold">93.1</span></td>
<td id="S5.T2.2.7.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T2.2.7.3.1" class="ltx_text ltx_font_bold">0.0219</span></td>
<td id="S5.T2.2.7.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T2.2.7.4.1" class="ltx_text ltx_font_bold">0.983</span></td>
<td id="S5.T2.2.7.5" class="ltx_td ltx_align_center ltx_border_t">8.9</td></tr>
<tr id="S5.T2.2.8" class="ltx_tr">
