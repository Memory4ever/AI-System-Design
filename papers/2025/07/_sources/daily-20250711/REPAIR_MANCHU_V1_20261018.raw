</thead>
<tbody class="ltx_tbody">
<tr id="S5.T2.2.3" class="ltx_tr">
<th id="S5.T2.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">LLaMA-3.2-11B</th>
<td id="S5.T2.2.3.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T2.2.3.2.1" class="ltx_text ltx_font_bold">98.3</span></td>
<td id="S5.T2.2.3.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T2.2.3.3.1" class="ltx_text ltx_font_bold">0.0024</span></td>
<td id="S5.T2.2.3.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T2.2.3.4.1" class="ltx_text ltx_font_bold">0.998</span></td>
<td id="S5.T2.2.3.5" class="ltx_td ltx_align_center ltx_border_t">14.7</td></tr>
<tr id="S5.T2.2.4" class="ltx_tr">
