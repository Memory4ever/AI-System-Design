<tbody class="ltx_tbody">
<tr id="S4.T4.4.2" class="ltx_tr">
<td id="S4.T4.4.2.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S4.T4.4.2.1.1" class="ltx_inline-block ltx_align_top" style="width:85.4pt;">
<span id="S4.T4.4.2.1.1.1" class="ltx_p ltx_align_left"><span id="S4.T4.4.2.1.1.1.1" class="ltx_text" style="font-size:80%;">GPT-4o-mini</span></span>
</span></td>
<td id="S4.T4.4.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S4.T4.4.2.2.1" class="ltx_inline-block ltx_align_top" style="width:56.9pt;">
<span id="S4.T4.4.2.2.1.1" class="ltx_p ltx_align_left"><span id="S4.T4.4.2.2.1.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#FF0000;">✓</span></span>
