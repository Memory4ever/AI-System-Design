<span id="S4.T1.4.4.3.1" class="ltx_inline-block ltx_align_top" style="width:71.1pt;">
<span id="S4.T1.4.4.3.1.1" class="ltx_p ltx_align_left"><span id="S4.T1.4.4.3.1.1.1" class="ltx_text" style="font-size:80%;">GPT-4.1</span></span>
</span></td></tr>
<tr id="S4.T1.4.5" class="ltx_tr">
<td id="S4.T1.4.5.1" class="ltx_td ltx_align_left ltx_align_top">
<span id="S4.T1.4.5.1.1" class="ltx_inline-block ltx_align_top" style="width:56.9pt;">
<span id="S4.T1.4.5.1.1.1" class="ltx_p ltx_align_left"><span id="S4.T1.4.5.1.1.1.1" class="ltx_text" style="font-size:80%;">Anthropic</span></span>
</span></td>
<td id="S4.T1.4.5.2" class="ltx_td ltx_align_left ltx_align_top">
<span id="S4.T1.4.5.2.1" class="ltx_inline-block ltx_align_top" style="width:71.1pt;">
