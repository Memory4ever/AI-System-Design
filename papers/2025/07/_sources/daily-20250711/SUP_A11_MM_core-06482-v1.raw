<td id="A3.T13.3.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" colspan="7"><span id="A3.T13.3.1.1.2.1" class="ltx_text ltx_font_bold">different time-steps <math id="A3.T13.m1" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math></span></td></tr>
<tr id="A3.T13.3.1.2" class="ltx_tr" style="--ltx-bg-color:#F8F8F9;">
<td id="A3.T13.3.1.2.1" class="ltx_td ltx_align_left"><span id="A3.T13.3.1.2.1.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F8F8F9;">Datasets</span></td>
<td id="A3.T13.3.1.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="A3.T13.m2" class="ltx_Math" style="--ltx-bg-color:#F8F8F9;" alttext="t" display="inline" intent=":literal"><semantics><mi style="--ltx-bg-color:#F8F8F9;" mathbackground="#F8F8F9">t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math><span id="A3.T13.3.1.2.2.1" class="ltx_text" style="--ltx-bg-color:#F8F8F9;">=100</span></td>
