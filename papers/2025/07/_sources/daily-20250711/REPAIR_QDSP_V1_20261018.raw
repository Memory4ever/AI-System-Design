18" class="ltx_text ltx_lst_emph4 ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#006699;">rand</span><span id="lstnumberx27.19" class="ltx_text ltx_font_typewriter" style="font-size:80%;">()</span><span id="lstnumberx27.20" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx27.21" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#E600E6;">-</span><span id="lstnumberx27.22" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx27.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">0</span><span id="lstnumberx27.24" class="ltx_text ltx_font_typewriter" style="font-size:80%;">.</span><span id="lstnumberx27.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">5</span><span id="lstnumberx27.26" class="ltx_text ltx_font_typewriter" style="font-size:80%;">)</span>
