<div id="lstnumberx350" class="ltx_listingline"><span id="lstnumberx350.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;">        </span><span id="lstnumberx350.2" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold" style="font-size:80%;--ltx-fg-color:#E600E6;">return</span><span id="lstnumberx350.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx350.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">angle</span>
</div>
