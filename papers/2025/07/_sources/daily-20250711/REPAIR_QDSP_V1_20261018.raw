text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx344.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">new_x</span><span id="lstnumberx344.19" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#E600E6;">[</span><span id="lstnumberx344.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">3</span><span id="lstnumberx344.21" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#E600E6;">]</span><span id="lstnumberx344.22" class="ltx_text ltx_font_typewriter" style="font-size:80%;">)</span><span id="lstnumberx344.23" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#E600E6;">*</span><span id="lstnumberx344.24" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#E600E6;">*</span><span id="lstnumberx344.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">2</span><span id="lstnumberx344.26" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx344.27" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#E600E6;">+</span><span id="lstnumberx344.28" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx344.29" class="ltx_text ltx_font_typewriter" style="font-size:80%;">(</span><span id="lstnumberx344.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">x</span><span id="lstnumberx344.31" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#E600E6;">[</span><span id="lstnumberx344.32" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">1</span><span id="lstnumberx344.33" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#E600E6;">]</span><span id="lstnumberx344.34" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx344.35" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#E600E6;">-</span><span id="lstnumberx344.36" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx344.37" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">new_x</span><span id="lstnumberx344.38" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#E600E6;">[</span><span id="lstnumberx344.39" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">4</span><span id="lstnumberx344.40" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#E600E6;">]</span><span id="lstnumberx344.41" class="ltx_text ltx_font_typewriter" style="font-size:80%;">)</span><span id="lstnumberx344.42" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#E600E6;">*</span><span id="lstnumberx344.43" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#E600E6;">*</span><span id="lstnumberx344.44" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">2</span><span id="lstnumberx344.45" class="ltx_text ltx_font_typewriter" style="font-size:80%;">)</span><span id="lstnumberx344.46" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;">  </span><span id="lstnumberx344.47" class="ltx_text ltx_lst_comment ltx_font_typewriter ltx_font_slanted" style="font-size:80%;--ltx-fg-color:#008000;">#<span id="lstnumberx344.47.1" class="ltx_text ltx_lst_space"> </span>Negative<span id="lstnumberx344.47.2" class="ltx_text ltx_lst_space"> </span>distance<span id="lstnumberx344.47.3" class="ltx_text ltx_lst_space"> </span>to<span id="lstnumberx344.47.4" class="ltx_text ltx_lst_space"> </span>pursuer</span>
</div>
<div id="lstnumberx345" class="ltx_listingline">
</div>
<div id="lstnumberx346" class="ltx_listingline"><span id="lstnumberx346.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;">        </span><span id="lstnumberx346.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">self</span><span id="lstnumberx346.3" class="ltx_text ltx_font_typewriter" style="font-size:80%;">.</span><span id="lstnumberx346.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">update_q_table</span><span id="lstnumberx346.5" class="ltx_text ltx_font_typewriter" style="font-size:80%;">(</span><span id="lstnumberx346.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">reward</span><span id="lstnumberx346.7" class="ltx_text ltx_font_typewriter" style="font-size:80%;">,</span><span id="lstnumberx346.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx346.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">new_state</span><span id="lstnumberx346.10" class="ltx_text ltx_font_typewriter" style="font-size:80%;">)</span>
</div>
<div id="lstnumberx347" class="ltx_listingline"><span id="lstnumberx347.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;">        </span><span id="lstnumberx347.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">self</span><span id="lstnumberx347.3" class="ltx_text ltx_font_typewriter" style="font-size:80%;">.</span><span id="lstnumberx347.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">prev_state</span><span id="lstnumberx347.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx347.6" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#E600E6;">=</span><span id="lstnumberx347.7" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx347.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">current_state</span>
</div>
<div id="lstnumberx348" class="ltx_listingline"><span id="lstnumberx348.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;">        </span><span id="lstnumberx348.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">self</span><span id="lstnumberx348.3" class="ltx_text ltx_font_typewriter" style="font-size:80%;">.</span><span id="lstnumberx348.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">prev_action</span><span id="lstnumberx348.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx348.6" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#E600E6;">=</span><span id="lstnumberx348.7" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx348.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">action</span>
</div>
