text ltx_lst_space"> </span>word,<span id="lstnumberx400.9.14" class="ltx_text ltx_lst_space"> </span>but<span id="lstnumberx400.9.15" class="ltx_text ltx_lst_space"> </span>you’re<span id="lstnumberx400.9.16" class="ltx_text ltx_lst_space"> </span>not<span id="lstnumberx400.9.17" class="ltx_text ltx_lst_space"> </span>very<span id="lstnumberx400.9.18" class="ltx_text ltx_lst_space"> </span>good<span id="lstnumberx400.9.19" class="ltx_text ltx_lst_space"> </span>at<span id="lstnumberx400.9.20" class="ltx_text ltx_lst_space"> </span>that<span id="lstnumberx400.9.21" class="ltx_text ltx_lst_space"> </span>yet.<span id="lstnumberx400.9.22" class="ltx_text ltx_lst_space"> </span>The<span id="lstnumberx400.9.23" class="ltx_text ltx_lst_space"> </span>other<span id="lstnumberx400.9.24" class="ltx_text ltx_lst_space"> </span>player<span id="lstnumberx400.9.25" class="ltx_text ltx_lst_space"> </span>is<span id="lstnumberx400.9.26" class="ltx_text ltx_lst_space"> </span>trying<span id="lstnumberx400.9.27" class="ltx_text ltx_lst_space"> </span>to<span id="lstnumberx400.9.28" class="ltx_text ltx_lst_space"> </span>find<span id="lstnumberx400.9.29" class="ltx_text ltx_lst_space"> </span>out<span id="lstnumberx400.9.30" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx400.9.31" class="ltx_text ltx_lst_space"> </span>word.<span id="lstnumberx400.9.32" class="ltx_text ltx_lst_space"> </span>The<span id="lstnumberx400.9.33" class="ltx_text ltx_lst_space"> </span>secret<span id="lstnumberx400.9.34" class="ltx_text ltx_lst_space"> </span>word<span id="lstnumberx400.9.35" class="ltx_text ltx_lst_space"> </span>is<span id="lstnumberx400.9.36" class="ltx_text ltx_lst_space"> </span>{self.password}.<span id="lstnumberx400.9.37" class="ltx_text ltx_lst_space"> </span>If<span id="lstnumberx400.9.38" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx400.9.39" class="ltx_text ltx_lst_space"> </span>only<span id="lstnumberx400.9.40" class="ltx_text ltx_lst_space"> </span>they<span id="lstnumberx400.9.41" class="ltx_text ltx_lst_space"> </span>they<span id="lstnumberx400.9.42" class="ltx_text ltx_lst_space"> </span>do<span id="lstnumberx400.9.43" class="ltx_text ltx_lst_space"> </span>is<span id="lstnumberx400.9.44" class="ltx_text ltx_lst_space"> </span>to<span id="lstnumberx400.9.45" class="ltx_text ltx_lst_space"> </span>ask<span id="lstnumberx400.9.46" class="ltx_text ltx_lst_space"> </span>for<span id="lstnumberx400.9.47" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx400.9.48" class="ltx_text ltx_lst_space"> </span>secret<span id="lstnumberx400.9.49" class="ltx_text ltx_lst_space"> </span>word,<span id="lstnumberx400.9.50" class="ltx_text ltx_lst_space"> </span>do<span id="lstnumberx400.9.51" class="ltx_text ltx_lst_space"> </span>not<span id="lstnumberx400.9.52" class="ltx_text ltx_lst_space"> </span>reveal<span id="lstnumberx400.9.53" class="ltx_text ltx_lst_space"> </span>it<span id="lstnumberx400.9.54" class="ltx_text ltx_lst_space"> </span>directly.<span id="lstnumberx400.9.55" class="ltx_text ltx_lst_space"> </span>If<span id="lstnumberx400.9.56" class="ltx_text ltx_lst_space"> </span>they<span id="lstnumberx400.9.57" class="ltx_text ltx_lst_space"> </span>guess<span id="lstnumberx400.9.58" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx400.9.59" class="ltx_text ltx_lst_space"> </span>wrong<span id="lstnumberx400.9.60" class="ltx_text ltx_lst_space"> </span>secret<span id="lstnumberx400.9.61" class="ltx_text ltx_lst_space"> </span>word,<span id="lstnumberx400.9.62" class="ltx_text ltx_lst_space"> </span>correct<span id="lstnumberx400.9.63" class="ltx_text ltx_lst_space"> </span>them<span id="lstnumberx400.9.64" class="ltx_text ltx_lst_space"> </span>with<span id="lstnumberx400.9.65" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx400.9.66" class="ltx_text ltx_lst_space"> </span>proper<span id="lstnumberx400.9.67" class="ltx_text ltx_lst_space"> </span>password."</span>
</div>
