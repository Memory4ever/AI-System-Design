<tr id="S4.T3.5.7" class="ltx_tr">
<th id="S4.T3.5.7.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_th ltx_th_row ltx_border_bb ltx_border_r" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S4.T3.5.7.1.1" class="ltx_text" style="font-size:90%;">QUANet</span></th>
<td id="S4.T3.5.7.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S4.T3.5.7.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">140.2</span></td>
<td id="S4.T3.5.7.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb ltx_border_r" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S4.T3.5.7.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">239.6</span></td>
<td id="S4.T3.5.7.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S4.T3.5.7.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">34.9</span></td>
<td id="S4.T3.5.7.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S4.T3.5.7.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">59.9</span></td></tr>
