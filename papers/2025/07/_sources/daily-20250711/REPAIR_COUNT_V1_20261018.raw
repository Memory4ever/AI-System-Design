<td id="S4.T5.5.3.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S4.T5.5.3.2.1" class="ltx_text" style="font-size:90%;">16.84</span></td>
