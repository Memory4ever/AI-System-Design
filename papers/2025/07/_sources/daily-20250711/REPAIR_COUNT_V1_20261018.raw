<td id="S4.T9.5.6.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S4.T9.5.6.2.1" class="ltx_text" style="font-size:90%;">773.4</span></td>
