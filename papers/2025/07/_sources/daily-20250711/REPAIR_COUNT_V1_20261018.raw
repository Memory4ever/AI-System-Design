<tr id="S4.T8.5.7" class="ltx_tr">
<th id="S4.T8.5.7.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_th ltx_th_row ltx_border_r" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S4.T8.5.7.1.1" class="ltx_text" style="font-size:90%;">QUANet(<math id="S4.T8.m9" class="ltx_Math" alttext="L_{rank}\rightarrow L_{srank}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi>L</mi><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub></mrow><annotation encoding="application/x-tex">L_{rank}\rightarrow L_{srank}</annotation></semantics></math>)</span></th>
