<td id="S5.T5.2.1.18.4" class="ltx_td ltx_align_left ltx_border_bb"><math id="S5.T5.m78" class="ltx_Math" alttext="2.79" display="inline" intent=":literal"><semantics><mn mathsize="1.200em">2.79</mn><annotation encoding="application/x-tex">2.79</annotation></semantics></math></td>
