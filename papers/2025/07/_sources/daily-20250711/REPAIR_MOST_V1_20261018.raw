<th id="S5.T4.2.1.4.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t" rowspan="5"><span id="S5.T4.2.1.4.2.1" class="ltx_text">HumanML3D</span></th>
<td id="S5.T4.2.1.4.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T4.m12" class="ltx_Math" alttext="3.55" display="inline" intent=":literal"><semantics><mn>3.55</mn><annotation encoding="application/x-tex">3.55</annotation></semantics></math></td>
<td id="S5.T4.2.1.4.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T4.m13" class="ltx_Math" alttext="3.89" display="inline" intent=":literal"><semantics><mn>3.89</mn><annotation encoding="application/x-tex">3.89</annotation></semantics></math></td>
<td id="S5.T4.2.1.4.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="S5.T4.m14" class="ltx_Math" alttext="21.02" display="inline" intent=":literal"><semantics><mn>21.02</mn><annotation encoding="application/x-tex">21.02</annotation></semantics></math></td>
<td id="S5.T4.2.1.4.6" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T4.m15" class="ltx_Math" alttext="2.36" display="inline" intent=":literal"><semantics><mn>2.36</mn><annotation encoding="application/x-tex">2.36</annotation></semantics></math></td>
