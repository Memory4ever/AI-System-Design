<td id="S5.T2.2.4.7" class="ltx_td ltx_align_center" style="padding-left:3.5pt;padding-right:3.5pt;"><math id="S5.T2.m14" class="ltx_Math" alttext="80.1\pm 2.95" display="inline" intent=":literal"><semantics><mrow><mn>80.1</mn><mo>±</mo><mn>2.95</mn></mrow><annotation encoding="application/x-tex">80.1\pm 2.95</annotation></semantics></math></td>
<td id="S5.T2.2.4.8" class="ltx_td ltx_align_center" style="padding-left:3.5pt;padding-right:3.5pt;"><math id="S5.T2.m15" class="ltx_Math" alttext="89.5\pm 0.27" display="inline" intent=":literal"><semantics><mrow><mn>89.5</mn><mo>±</mo><mn>0.27</mn></mrow><annotation encoding="application/x-tex">89.5\pm 0.27</annotation></semantics></math></td>
<td id="S5.T2.2.4.9" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:3.5pt;padding-right:3.5pt;"><math id="S5.T2.m16" class="ltx_Math" alttext="77.9\pm 12.26" display="inline" intent=":literal"><semantics><mrow><mn>77.9</mn><mo>±</mo><mn>12.26</mn></mrow><annotation encoding="application/x-tex">77.9\pm 12.26</annotation></semantics></math></td></tr>
