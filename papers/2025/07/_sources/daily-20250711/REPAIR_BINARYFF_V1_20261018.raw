<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex20.m1" class="ltx_Math" alttext="\displaystyle+\underbrace{NC^{(\ell)}H^{(\ell)}W^{(\ell)}C^{(\ell-1)}K^{2}}_{\text{Algorithm \ref{alg:backprop-arbitrary-layer}, Line \ref{alg:backprop-BP:compute_dL_dW}}}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><munder><munder accentunder="true"><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mn>2</mn></msup></mrow><mo stretchy="true">⏟</mo></munder><mrow><mtext>Algorithm </mtext><mtext><a href="#alg2" title="Algorithm 2 ‣ B-A2 Backward Pass ‣ B-A Backpropagation: Number of multiplications and memory accesses ‣ Appendix B Energy consumption: a comparison of multiplication and memory operations ‣ Energy-Efficient Supervised Learning with aBinary Stochastic Forward-Forward Algorithm" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">2</span></a></mtext><mtext>, Line </mtext><mtext><a href="#alg2.l15" title="In Algorithm 2 ‣ B-A2 Backward Pass ‣ B-A Backpropagation: Number of multiplications and memory accesses ‣ Appendix B Energy consumption: a comparison of multiplication and memory operations ‣ Energy-Efficient Supervised Learning with aBinary Stochastic Forward-Forward Algorithm" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">15</span></a></mtext></mrow></munder></mrow><annotation encoding="application/x-tex">\displaystyle+\underbrace{NC^{(\ell)}H^{(\ell)}W^{(\ell)}C^{(\ell-1)}K^{2}}_{\text{Algorithm \ref{alg:backprop-arbitrary-layer}, Line \ref{alg:backprop-BP:compute_dL_dW}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
