<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex58.m2" class="ltx_Math" alttext="\displaystyle\underbrace{\sum_{\ell}NC^{(\ell)}H^{(\ell)}W^{(\ell)}}_{\begin{subarray}{c}\text{Algo \ref{alg:compute-gradient-BSN}},\text{Line~\ref{alg:compute-gradient-BSN:read-Delta-l}}\end{subarray}}" display="inline" intent=":literal"><semantics><munder><munder accentunder="true"><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi mathvariant="normal">ℓ</mi></munder></mstyle><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo stretchy="true">⏟</mo></munder><mtable><mtr><mtd><mrow><mrow><mtext>Algo </mtext><mtext><a href="#alg6" title="Algorithm 6 ‣ M-tiled units ‣ B-C Forward Forward Algorithm (BSN): Number of Multiplications and Memory Accesses ‣ Appendix B Energy consumption: a comparison of multiplication and memory operations ‣ Energy-Efficient Supervised Learning with aBinary Stochastic Forward-Forward Algorithm" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">6</span></a></mtext></mrow><mo>,</mo><mrow><mtext>Line </mtext><mtext><a href="#alg6.l12" title="In Algorithm 6 ‣ M-tiled units ‣ B-C Forward Forward Algorithm (BSN): Number of Multiplications and Memory Accesses ‣ Appendix B Energy consumption: a comparison of multiplication and memory operations ‣ Energy-Efficient Supervised Learning with aBinary Stochastic Forward-Forward Algorithm" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">12</span></a></mtext></mrow></mrow></mtd></mtr></mtable></munder><annotation encoding="application/x-tex">\displaystyle\underbrace{\sum_{\ell}NC^{(\ell)}H^{(\ell)}W^{(\ell)}}_{\begin{subarray}{c}\text{Algo \ref{alg:compute-gradient-BSN}},\text{Line~\ref{alg:compute-gradient-BSN:read-Delta-l}}\end{subarray}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex59"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex59.m1" class="ltx_Math" alttext="\displaystyle+" display="inline" intent=":literal"><semantics><mo>+</mo><annotation encoding="application/x-tex">\displaystyle+</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex59.m2" class="ltx_Math" alttext="\displaystyle\;\underbrace{\sum_{\ell=2}NC^{(\ell-1)}C^{(\ell)}H^{(\ell-1)}W^{(\ell-1)}/32}_{\begin{subarray}{c}\text{Algo \ref{alg:compute-gradient-BSN}},\text{Line~\ref{alg:compute-gradient-BSN:read-tilde-u-l-1}}\end{subarray}}" display="inline" intent=":literal"><semantics><munder><munder accentunder="true"><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>2</mn></mrow></munder></mstyle><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo>/</mo><mn>32</mn></mrow><mo stretchy="true">⏟</mo></munder><mtable><mtr><mtd><mrow><mrow><mtext>Algo </mtext><mtext><a href="#alg6" title="Algorithm 6 ‣ M-tiled units ‣ B-C Forward Forward Algorithm (BSN): Number of Multiplications and Memory Accesses ‣ Appendix B Energy consumption: a comparison of multiplication and memory operations ‣ Energy-Efficient Supervised Learning with aBinary Stochastic Forward-Forward Algorithm" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">6</span></a></mtext></mrow><mo>,</mo><mrow><mtext>Line </mtext><mtext><a href="#alg6.l19" title="In Algorithm 6 ‣ M-tiled units ‣ B-C Forward Forward Algorithm (BSN): Number of Multiplications and Memory Accesses ‣ Appendix B Energy consumption: a comparison of multiplication and memory operations ‣ Energy-Efficient Supervised Learning with aBinary Stochastic Forward-Forward Algorithm" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">19</span></a></mtext></mrow></mrow></mtd></mtr></mtable></munder><annotation encoding="application/x-tex">\displaystyle\;\underbrace{\sum_{\ell=2}NC^{(\ell-1)}C^{(\ell)}H^{(\ell-1)}W^{(\ell-1)}/32}_{\begin{subarray}{c}\text{Algo \ref{alg:compute-gradient-BSN}},\text{Line~\ref{alg:compute-gradient-BSN:read-tilde-u-l-1}}\end{subarray}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex60"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex60.m1" class="ltx_Math" alttext="\displaystyle+" display="inline" intent=":literal"><semantics><mo>+</mo><annotation encoding="application/x-tex">\displaystyle+</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex60.m2" class="ltx_Math" alttext="\displaystyle\underbrace{NC^{(\ell-1)}C^{(\ell)}H^{(\ell-1)}W^{(\ell-1)}}_{\begin{subarray}{c}\text{Algo \ref{alg:compute-gradient-BSN}},\text{Line~\ref{alg:compute-gradient-BSN:read-input-c-l-1}}\end{subarray}}" display="inline" intent=":literal"><semantics><munder><munder accentunder="true"><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="true">⏟</mo></munder><mtable><mtr><mtd><mrow><mrow><mtext>Algo </mtext><mtext><a href="#alg6" title="Algorithm 6 ‣ M-tiled units ‣ B-C Forward Forward Algorithm (BSN): Number of Multiplications and Memory Accesses ‣ Appendix B Energy consumption: a comparison of multiplication and memory operations ‣ Energy-Efficient Supervised Learning with aBinary Stochastic Forward-Forward Algorithm" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">6</span></a></mtext></mrow><mo>,</mo><mrow><mtext>Line </mtext><mtext><a href="#alg6.l16" title="In Algorithm 6 ‣ M-tiled units ‣ B-C Forward Forward Algorithm (BSN): Number of Multiplications and Memory Accesses ‣ Appendix B Energy consumption: a comparison of multiplication and memory operations ‣ Energy-Efficient Supervised Learning with aBinary Stochastic Forward-Forward Algorithm" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">16</span></a></mtext></mrow></mrow></mtd></mtr></mtable></munder><annotation encoding="application/x-tex">\displaystyle\underbrace{NC^{(\ell-1)}C^{(\ell)}H^{(\ell-1)}W^{(\ell-1)}}_{\begin{subarray}{c}\text{Algo \ref{alg:compute-gradient-BSN}},\text{Line~\ref{alg:compute-gradient-BSN:read-input-c-l-1}}\end{subarray}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ul>
</div>
</section>
<section id="A2.SS3.SSSx2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_font_bold ltx_title_subsubsection">No–BatchNorm Case</h4>

<div id="A2.SS3.SSSx2.p1" class="ltx_para">
<p id="A2.SS3.SSSx2.p1.1" class="ltx_p">Above pseudocode assumes BatchNorm. Without BatchNorm, one can compute the gradient for each sample independently and then average, removing the need to reread inputs for every output channel. Under the local‑memory constraint (only a tensor of shape <math id="A2.SS3.SSSx2.p1.m1" class="ltx_Math" alttext="NHW" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">NHW</annotation></semantics></math> or <math id="A2.SS3.SSSx2.p1.m2" class="ltx_Math" alttext="CHW" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">CHW</annotation></semantics></math> may reside in fast memory), this per‑sample independence reduces the dominant storage term
<math id="A2.SS3.SSSx2.p1.m3" class="ltx_Math" alttext="NC^{2}HW\;\longrightarrow\;NCHW" display="inline" intent=":literal"><semantics><mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><mo lspace="0.558em" rspace="0.558em" stretchy="false">⟶</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow></mrow><annotation encoding="application/x-tex">NC^{2}HW\;\longrightarrow\;NCHW</annotation></semantics></math>. Moreover, in the <span id="A2.SS3.SSSx2.p1.1.1" class="ltx_text ltx_font_bold">BGBSFF</span> variant, all gradient tensors are binary,hence eliminating the <math id="A2.SS3.SSSx2.p1.m4" class="ltx_Math" alttext="2CK^{2}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">2CK^{2}</annotation></semantics></math> real‑valued multiplications per channel. In fact since gradient tensors <math id="A2.SS3.SSSx2.p1.m5" class="ltx_Math" alttext="\frac{\partial G_{j}}{\partial u[c^{(\ell)}]}" display="inline" intent=":literal"><semantics><mfrac><mrow><mo>∂</mo><msub><mi>G</mi><mi>j</mi></msub></mrow><mrow><mo>∂</mo><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>c</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo></mrow></mrow></mrow></mfrac><annotation encoding="application/x-tex">\frac{\partial G_{j}}{\partial u[c^{(\ell)}]}</annotation></semantics></math> and <math id="A2.SS3.SSSx2.p1.m6" class="ltx_Math" alttext="\frac{\partial L^{(\ell)}}{\partial G_{j}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mo>∂</mo><msup><mi>L</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mrow><mo>∂</mo><msub><mi>G</mi><mi>j</mi></msub></mrow></mfrac><annotation encoding="application/x-tex">\frac{\partial L^{(\ell)}}{\partial G_{j}}</annotation></semantics></math> are binary, even for first layer despite being input full precision all multiplications are turned into indexing and addition giving further orders of saving.</p>
</div>
<figure id="A2.F4" class="ltx_figure"><img src="2507.06461v1/compute_arch.png" id="A2.F4.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/268;" width="476" height="268" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Fig. 4: </span>Simple computation model used in Appendix <a href="#A2" title="Appendix B Energy consumption: a comparison of multiplication and memory operations ‣ Energy-Efficient Supervised Learning with aBinary Stochastic Forward-Forward Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a>.</figcaption>
</figure>
</section>
</section>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Supplementary:</h2>

<section id="A3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="A3.SS1.6" class="ltx_text">C-A</span> </span><span id="A3.SS1.7" class="ltx_text ltx_font_bold">Code Availability</span></h3>

<div id="A3.SS1.p1" class="ltx_para">
<p id="A3.SS1.p1.1" class="ltx_p">The code used in our experiments can be accessed at <a href="https://anonymous.4open.science/r/CWCC_BSFF-3DF8/README.md" title="" class="ltx_ref ltx_href">this repository</a>.</p>
</div>
</section>
<section id="A3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="A3.SS2.6" class="ltx_text">C-B</span> </span><span id="A3.SS2.7" class="ltx_text ltx_font_bold">Architecture Details</span></h3>

<div id="A3.SS2.p1" class="ltx_para ltx_noindent">
<p id="A3.SS2.p1.1" class="ltx_p">The same architectures are used as in the <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib31" title="" class="ltx_ref">31</a>]</cite> paper.</p>
</div>
</section>
<section id="A3.SSx1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection">For MNIST, FMNIST, and CIFAR‑10</h3>

<div id="A3.SSx1.p1" class="ltx_para">
<ul id="A3.I1" class="ltx_itemize">
<li id="A3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A3.I1.i1.p1" class="ltx_para">
<p id="A3.I1.i1.p1.1" class="ltx_p"><span id="A3.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Layer1</span>: <span id="A3.I1.i1.p1.1.2" class="ltx_text ltx_font_typewriter">Conv2D (Out Channels = 20)</span> <math id="A3.I1.i1.p1.m1" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math> <span id="A3.I1.i1.p1.1.3" class="ltx_text ltx_font_typewriter">BSN</span> <math id="A3.I1.i1.p1.m2" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math> <span id="A3.I1.i1.p1.1.4" class="ltx_text ltx_font_typewriter">BatchNorm2D</span></p>
</div></li>
<li id="A3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A3.I1.i2.p1" class="ltx_para">
<p id="A3.I1.i2.p1.1" class="ltx_p"><span id="A3.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Layer2</span>: <span id="A3.I1.i2.p1.1.2" class="ltx_text ltx_font_typewriter">GroupConv2D (Out Channels = 80)</span> <math id="A3.I1.i2.p1.m1" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math> <span id="A3.I1.i2.p1.1.3" class="ltx_text ltx_font_typewriter">BSN</span> <math id="A3.I1.i2.p1.m2" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math> <span id="A3.I1.i2.p1.1.4" class="ltx_text ltx_font_typewriter">MaxPool</span> <math id="A3.I1.i2.p1.m3" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math> <span id="A3.I1.i2.p1.1.5" class="ltx_text ltx_font_typewriter">BatchNorm2D</span></p>
</div></li>
<li id="A3.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A3.I1.i3.p1" class="ltx_para">
<p id="A3.I1.i3.p1.1" class="ltx_p"><span id="A3.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">Layer3</span>: <span id="A3.I1.i3.p1.1.2" class="ltx_text ltx_font_typewriter">Conv2D (Out Channels = 240)</span> <math id="A3.I1.i3.p1.m1" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math> <span id="A3.I1.i3.p1.1.3" class="ltx_text ltx_font_typewriter">BSN</span> <math id="A3.I1.i3.p1.m2" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math> <span id="A3.I1.i3.p1.1.4" class="ltx_text ltx_font_typewriter">BatchNorm2D</span></p>
</div></li>
<li id="A3.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A3.I1.i4.p1" class="ltx_para">
<p id="A3.I1.i4.p1.1" class="ltx_p"><span id="A3.I1.i4.p1.1.1" class="ltx_text ltx_font_bold">Layer4</span>: <span id="A3.I1.i4.p1.1.2" class="ltx_text ltx_font_typewriter">GroupConv2D (Out Channels = 480)</span> <math id="A3.I1.i4.p1.m1" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math> <span id="A3.I1.i4.p1.1.3" class="ltx_text ltx_font_typewriter">BSN</span> <math id="A3.I1.i4.p1.m2" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math> <span id="A3.I1.i4.p1.1.4" class="ltx_text ltx_font_typewriter">MaxPool</span></p>
