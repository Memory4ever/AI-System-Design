<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex12.m1" class="ltx_Math" alttext="\displaystyle+" display="inline" intent=":literal"><semantics><mo>+</mo><annotation encoding="application/x-tex">\displaystyle+</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex12.m2" class="ltx_Math" alttext="\displaystyle\;\underbrace{NC^{(\ell)}H^{(\ell)}W^{(\ell)}}_{\begin{subarray}{c}\text{Maxpool output store, Algorithm~\ref{alg:forward-pass-layer},}\\
\text{Line~\ref{alg:Maxpool-store}}\end{subarray}}" display="inline" intent=":literal"><semantics><munder><munder accentunder="true"><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="true">⏟</mo></munder><mtable rowspacing="0pt"><mtr><mtd><mrow><mtext>Maxpool output store, Algorithm </mtext><mtext><a href="#alg1" title="Algorithm 1 ‣ B-A1 Forward Pass(layer ℓ) ‣ B-A Backpropagation: Number of multiplications and memory accesses ‣ Appendix B Energy consumption: a comparison of multiplication and memory operations ‣ Energy-Efficient Supervised Learning with aBinary Stochastic Forward-Forward Algorithm" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">1</span></a></mtext><mtext>,</mtext></mrow></mtd></mtr><mtr><mtd><mrow><mtext>Line </mtext><mtext><a href="#alg1.l12" title="In Algorithm 1 ‣ B-A1 Forward Pass(layer ℓ) ‣ B-A Backpropagation: Number of multiplications and memory accesses ‣ Appendix B Energy consumption: a comparison of multiplication and memory operations ‣ Energy-Efficient Supervised Learning with aBinary Stochastic Forward-Forward Algorithm" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">12</span></a></mtext></mrow></mtd></mtr></mtable></munder><annotation encoding="application/x-tex">\displaystyle\;\underbrace{NC^{(\ell)}H^{(\ell)}W^{(\ell)}}_{\begin{subarray}{c}\text{Maxpool output store, Algorithm~\ref{alg:forward-pass-layer},}\\
\text{Line~\ref{alg:Maxpool-store}}\end{subarray}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex13.m1" class="ltx_Math" alttext="\displaystyle+" display="inline" intent=":literal"><semantics><mo>+</mo><annotation encoding="application/x-tex">\displaystyle+</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex13.m2" class="ltx_Math" alttext="\displaystyle\;\underbrace{NC^{(\ell)}H^{(\ell)}W^{(\ell)}}_{\begin{subarray}{c}\text{Maxpool output read for BatchNorm, }\\
\text{Algorithm~\ref{alg:forward-pass-layer},}\text{Line~\ref{alg:Maxpool-read}}\end{subarray}}" display="inline" intent=":literal"><semantics><munder><munder accentunder="true"><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="true">⏟</mo></munder><mtable rowspacing="0pt"><mtr><mtd><mtext>Maxpool output read for BatchNorm, </mtext></mtd></mtr><mtr><mtd><mrow><mrow><mtext>Algorithm </mtext><mtext><a href="#alg1" title="Algorithm 1 ‣ B-A1 Forward Pass(layer ℓ) ‣ B-A Backpropagation: Number of multiplications and memory accesses ‣ Appendix B Energy consumption: a comparison of multiplication and memory operations ‣ Energy-Efficient Supervised Learning with aBinary Stochastic Forward-Forward Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a></mtext><mtext>,</mtext></mrow><mrow><mtext>Line </mtext><mtext><a href="#alg1.l20" title="In Algorithm 1 ‣ B-A1 Forward Pass(layer ℓ) ‣ B-A Backpropagation: Number of multiplications and memory accesses ‣ Appendix B Energy consumption: a comparison of multiplication and memory operations ‣ Energy-Efficient Supervised Learning with aBinary Stochastic Forward-Forward Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">20</span></a></mtext></mrow></mrow></mtd></mtr></mtable></munder><annotation encoding="application/x-tex">\displaystyle\;\underbrace{NC^{(\ell)}H^{(\ell)}W^{(\ell)}}_{\begin{subarray}{c}\text{Maxpool output read for BatchNorm, }\\
\text{Algorithm~\ref{alg:forward-pass-layer},}\text{Line~\ref{alg:Maxpool-read}}\end{subarray}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex14.m1" class="ltx_Math" alttext="\displaystyle+" display="inline" intent=":literal"><semantics><mo>+</mo><annotation encoding="application/x-tex">\displaystyle+</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex14.m2" class="ltx_Math" alttext="\displaystyle\;\underbrace{NC^{(\ell)}H^{(\ell)}W^{(\ell)}}_{\begin{subarray}{c}\text{BatchNorm output store, Algorithm~\ref{alg:forward-pass-layer},}\\
\text{Line~\ref{alg:BatchNorm-store}}\end{subarray}}" display="inline" intent=":literal"><semantics><munder><munder accentunder="true"><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="true">⏟</mo></munder><mtable rowspacing="0pt"><mtr><mtd><mrow><mtext>BatchNorm output store, Algorithm </mtext><mtext><a href="#alg1" title="Algorithm 1 ‣ B-A1 Forward Pass(layer ℓ) ‣ B-A Backpropagation: Number of multiplications and memory accesses ‣ Appendix B Energy consumption: a comparison of multiplication and memory operations ‣ Energy-Efficient Supervised Learning with aBinary Stochastic Forward-Forward Algorithm" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">1</span></a></mtext><mtext>,</mtext></mrow></mtd></mtr><mtr><mtd><mrow><mtext>Line </mtext><mtext><a href="#alg1.l21" title="In Algorithm 1 ‣ B-A1 Forward Pass(layer ℓ) ‣ B-A Backpropagation: Number of multiplications and memory accesses ‣ Appendix B Energy consumption: a comparison of multiplication and memory operations ‣ Energy-Efficient Supervised Learning with aBinary Stochastic Forward-Forward Algorithm" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">21</span></a></mtext></mrow></mtd></mtr></mtable></munder><annotation encoding="application/x-tex">\displaystyle\;\underbrace{NC^{(\ell)}H^{(\ell)}W^{(\ell)}}_{\begin{subarray}{c}\text{BatchNorm output store, Algorithm~\ref{alg:forward-pass-layer},}\\
\text{Line~\ref{alg:BatchNorm-store}}\end{subarray}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ul>
</div>
</section>
<section id="A2.SS1.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection"><span id="A2.SS1.SSS2.6" class="ltx_text">B-A</span>2 </span>Backward Pass</h4>

<div id="A2.SS1.SSS2.p1" class="ltx_para">
<p id="A2.SS1.SSS2.p1.1" class="ltx_p">To compute the weight gradient <math id="A2.SS1.SSS2.p1.m1" class="ltx_Math" alttext="\frac{\partial L}{\partial W^{(\ell)}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mo>∂</mo><mi>L</mi></mrow><mrow><mo>∂</mo><msup><mi>W</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac><annotation encoding="application/x-tex">\frac{\partial L}{\partial W^{(\ell)}}</annotation></semantics></math> for any layer <math id="A2.SS1.SSS2.p1.m2" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>, the following steps are followed. The gradient of the Maxpool operation involves only an indexing operation through the maximum element in each patch. Therefore, for simplicity, we combine the BatchNorm Jacobian and <math id="A2.SS1.SSS2.p1.m3" class="ltx_Math" alttext="\frac{\partial u^{(\ell)}}{\partial\tilde{u}^{(\ell)}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mo>∂</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mrow><mo>∂</mo><msup><mover accent="true"><mi>u</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac><annotation encoding="application/x-tex">\frac{\partial u^{(\ell)}}{\partial\tilde{u}^{(\ell)}}</annotation></semantics></math> with the Maxpool Jacobian <math id="A2.SS1.SSS2.p1.m4" class="ltx_Math" alttext="\frac{\partial\tilde{u}^{(\ell)}}{\partial a^{(\ell)}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mo>∂</mo><msup><mover accent="true"><mi>u</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mrow><mo>∂</mo><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac><annotation encoding="application/x-tex">\frac{\partial\tilde{u}^{(\ell)}}{\partial a^{(\ell)}}</annotation></semantics></math>, and directly express <math id="A2.SS1.SSS2.p1.m5" class="ltx_Math" alttext="\frac{\partial u^{(\ell)}}{\partial a^{(\ell)}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mo>∂</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mrow><mo>∂</mo><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac><annotation encoding="application/x-tex">\frac{\partial u^{(\ell)}}{\partial a^{(\ell)}}</annotation></semantics></math>, as this does not affect our analysis of the number of multiplications and memory accesses.</p>
</div>
<div id="A2.SS1.SSS2.p2" class="ltx_para">
<ol id="A2.I3" class="ltx_enumerate">
<li id="A2.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A2.I3.i1.p1" class="ltx_para">
<p id="A2.I3.i1.p1.1" class="ltx_p"><span id="A2.I3.i1.p1.1.1" class="ltx_text ltx_font_bold">Initialize for the last layer:</span></p>
<table id="A2.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex15.m1" class="ltx_Math" alttext="\begin{split}\Delta^{(L)}[c,h,w]&amp;=\frac{\partial L}{\partial u^{(L)}[c,h,w]}\,\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msup><mi mathvariant="normal">Δ</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>c</mi><mo>,</mo><mi>h</mi><mo>,</mo><mi>w</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mfrac><mrow><mo>∂</mo><mi>L</mi></mrow><mrow><mo>∂</mo><mrow><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>c</mi><mo>,</mo><mi>h</mi><mo>,</mo><mi>w</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mfrac></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\Delta^{(L)}[c,h,w]&amp;=\frac{\partial L}{\partial u^{(L)}[c,h,w]}\,\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.I3.i1.p1.2" class="ltx_p">for each channel <math id="A2.I3.i1.p1.m1" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> and spatial location <math id="A2.I3.i1.p1.m2" class="ltx_Math" alttext="(h,w)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(h,w)</annotation></semantics></math>.</p>
</div></li>
<li id="A2.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A2.I3.i2.p1" class="ltx_para">
<p id="A2.I3.i2.p1.1" class="ltx_p"><span id="A2.I3.i2.p1.1.1" class="ltx_text ltx_font_bold">Backward pass for layers <math id="A2.I3.i2.p1.m1" class="ltx_Math" alttext="\ell=L" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">\ell=L</annotation></semantics></math> down to <math id="A2.I3.i2.p1.m2" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>:</span></p>
<ol id="A2.I3.i2.I1" class="ltx_enumerate">
<li id="A2.I3.i2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="A2.I3.i2.I1.i1.p1" class="ltx_para">
<p id="A2.I3.i2.I1.i1.p1.1" class="ltx_p"><span id="A2.I3.i2.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Compute the gradient w.r.t. pre-activation <math id="A2.I3.i2.I1.i1.p1.m1" class="ltx_Math" alttext="z^{(\ell)}" display="inline" intent=":literal"><semantics><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">z^{(\ell)}</annotation></semantics></math>:</span></p>
<table id="A2.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex16.m1" class="ltx_Math" alttext="\begin{split}\frac{\partial L}{\partial z^{(\ell)}[c,h,w]}&amp;=\;\Delta^{(\ell)}[c,h,w]\;\cdot\;\Bigl[\underbrace{\frac{\partial u^{(\ell)}[c,h,w]}{\partial\tilde{u}^{(\ell)}[c,h,w]}}_{\text{BN derivative}}\\
&amp;\;\cdot\;\underbrace{\frac{\partial a^{(\ell)}[c,h,w]}{\partial z^{(\ell)}[c,h,w]}}_{\text{ReLU or BSN derivative}}\Bigr]\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mfrac><mrow><mo>∂</mo><mi>L</mi></mrow><mrow><mo>∂</mo><mrow><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>c</mi><mo>,</mo><mi>h</mi><mo>,</mo><mi>w</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mfrac></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo rspace="0.838em">=</mo><mi mathvariant="normal">Δ</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">[</mo><mi>c</mi><mo>,</mo><mi>h</mi><mo>,</mo><mi>w</mi><mo rspace="0.615em" stretchy="false">]</mo><mo rspace="0.782em">⋅</mo><mo maxsize="1.600em" minsize="1.600em">[</mo><munder accentunder="true"><mfrac><mrow><mo>∂</mo><mrow><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>c</mi><mo>,</mo><mi>h</mi><mo>,</mo><mi>w</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mrow><msup><mover accent="true"><mi>u</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>c</mi><mo>,</mo><mi>h</mi><mo>,</mo><mi>w</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mfrac><mo stretchy="true">⏟</mo></munder><msub><mrow></mrow><mtext>BN derivative</mtext></msub></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo rspace="0.502em">⋅</mo><munder accentunder="true"><mfrac><mrow><mo>∂</mo><mrow><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>c</mi><mo>,</mo><mi>h</mi><mo>,</mo><mi>w</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mrow><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>c</mi><mo>,</mo><mi>h</mi><mo>,</mo><mi>w</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mfrac><mo stretchy="true">⏟</mo></munder><msub><mrow></mrow><mtext>ReLU or BSN derivative</mtext></msub><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\frac{\partial L}{\partial z^{(\ell)}[c,h,w]}&amp;=\;\Delta^{(\ell)}[c,h,w]\;\cdot\;\Bigl[\underbrace{\frac{\partial u^{(\ell)}[c,h,w]}{\partial\tilde{u}^{(\ell)}[c,h,w]}}_{\text{BN derivative}}\\
&amp;\;\cdot\;\underbrace{\frac{\partial a^{(\ell)}[c,h,w]}{\partial z^{(\ell)}[c,h,w]}}_{\text{ReLU or BSN derivative}}\Bigr]\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.I3.i2.I1.i1.p1.2" class="ltx_p">Here, <math id="A2.I3.i2.I1.i1.p1.m2" class="ltx_Math" alttext="\Delta^{(\ell)}[\,c,\,h,\,w\,]" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Δ</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0.170em" stretchy="false">[</mo><mrow><mi>c</mi><mo rspace="0.337em">,</mo><mi>h</mi><mo rspace="0.337em">,</mo><mi>w</mi></mrow><mo lspace="0.170em" stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta^{(\ell)}[\,c,\,h,\,w\,]</annotation></semantics></math> is the upstream gradient from the “goodness” function or from higher layers.</p>
</div></li>
<li id="A2.I3.i2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(b)</span> 
<div id="A2.I3.i2.I1.i2.p1" class="ltx_para">
<p id="A2.I3.i2.I1.i2.p1.1" class="ltx_p"><span id="A2.I3.i2.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Compute the weight gradient:</span></p>
<table id="A2.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex17.m1" class="ltx_Math" alttext="\begin{split}\frac{\partial L}{\partial W^{(\ell)}[\,c,\;c^{\prime},\;k_{1},\;k_{2}\,]}\;=\;\sum_{h=1}^{H^{(\ell)}}\;\sum_{w=1}^{W^{(\ell)}}\;\frac{\partial L}{\partial z^{(\ell)}[\,c,\,h,\,w\,]}\\
\;\cdot\;u^{(\ell-1)}\bigl[c^{\prime},\,\text{fold}(h,k_{1}),\,\text{fold}(w,k_{2})\bigr]\end{split}" display="block" intent=":literal"><semantics><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mfrac><mrow><mo>∂</mo><mi>L</mi></mrow><mrow><mo>∂</mo><mrow><msup><mi>W</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0.170em" stretchy="false">[</mo><mrow><mi>c</mi><mo rspace="0.447em">,</mo><msup><mi>c</mi><mo>′</mo></msup><mo rspace="0.447em">,</mo><msub><mi>k</mi><mn>1</mn></msub><mo rspace="0.447em">,</mo><msub><mi>k</mi><mn>2</mn></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mfrac><mo lspace="0.838em" rspace="0.671em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0.280em">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>H</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup></munderover><mrow><munderover><mo movablelimits="false" rspace="0.447em">∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>W</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup></munderover><mfrac><mrow><mo>∂</mo><mi>L</mi></mrow><mrow><mo>∂</mo><mrow><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0.170em" stretchy="false">[</mo><mrow><mi>c</mi><mo rspace="0.337em">,</mo><mi>h</mi><mo rspace="0.337em">,</mo><mi>w</mi></mrow><mo lspace="0.170em" stretchy="false">]</mo></mrow></mrow></mrow></mfrac></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mphantom></mphantom><mo lspace="0.502em" rspace="0.782em">⋅</mo><mrow><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msup><mi>c</mi><mo>′</mo></msup><mo rspace="0.507em">,</mo><mrow><mtext>fold</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo mathsize="1.200em">,</mo><msub><mi>k</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.507em">,</mo><mrow><mtext>fold</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo mathsize="1.200em">,</mo><msub><mi>k</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\frac{\partial L}{\partial W^{(\ell)}[\,c,\;c^{\prime},\;k_{1},\;k_{2}\,]}\;=\;\sum_{h=1}^{H^{(\ell)}}\;\sum_{w=1}^{W^{(\ell)}}\;\frac{\partial L}{\partial z^{(\ell)}[\,c,\,h,\,w\,]}\\
\;\cdot\;u^{(\ell-1)}\bigl[c^{\prime},\,\text{fold}(h,k_{1}),\,\text{fold}(w,k_{2})\bigr]\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.I3.i2.I1.i2.p1.2" class="ltx_p">where <math id="A2.I3.i2.I1.i2.p1.m1" class="ltx_Math" alttext="(k_{1},k_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo>,</mo><msub><mi>k</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(k_{1},k_{2})</annotation></semantics></math> index the kernel offsets (size <math id="A2.I3.i2.I1.i2.p1.m2" class="ltx_Math" alttext="K\times K" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">K\times K</annotation></semantics></math>), and <math id="A2.I3.i2.I1.i2.p1.m3" class="ltx_Math" alttext="\text{fold}(\cdot)" display="inline" intent=":literal"><semantics><mrow><mtext>fold</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{fold}(\cdot)</annotation></semantics></math> indicates the spatial mapping back to the correct location in <math id="A2.I3.i2.I1.i2.p1.m4" class="ltx_Math" alttext="u^{(\ell-1)}" display="inline" intent=":literal"><semantics><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">u^{(\ell-1)}</annotation></semantics></math> (depending on stride and padding).
In practice, you sum over <span id="A2.I3.i2.I1.i2.p1.2.1" class="ltx_text ltx_font_italic">all</span> spatial locations <math id="A2.I3.i2.I1.i2.p1.m5" class="ltx_Math" alttext="(h,w)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(h,w)</annotation></semantics></math> of <math id="A2.I3.i2.I1.i2.p1.m6" class="ltx_Math" alttext="z^{(\ell)}" display="inline" intent=":literal"><semantics><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">z^{(\ell)}</annotation></semantics></math> that overlap with the kernel position <math id="A2.I3.i2.I1.i2.p1.m7" class="ltx_Math" alttext="(k_{1},k_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo>,</mo><msub><mi>k</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(k_{1},k_{2})</annotation></semantics></math> on channel <math id="A2.I3.i2.I1.i2.p1.m8" class="ltx_Math" alttext="c^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>c</mi><mo>′</mo></msup><annotation encoding="application/x-tex">c^{\prime}</annotation></semantics></math> of <math id="A2.I3.i2.I1.i2.p1.m9" class="ltx_Math" alttext="u^{(\ell-1)}" display="inline" intent=":literal"><semantics><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">u^{(\ell-1)}</annotation></semantics></math>.</p>
</div></li>
<li id="A2.I3.i2.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(c)</span> 
<div id="A2.I3.i2.I1.i3.p1" class="ltx_para">
<p id="A2.I3.i2.I1.i3.p1.1" class="ltx_p"><span id="A2.I3.i2.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">Compute the upstream gradient for layer <math id="A2.I3.i2.I1.i3.p1.m1" class="ltx_Math" alttext="\ell-1" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\ell-1</annotation></semantics></math>:</span></p>
<table id="A2.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex18.m1" class="ltx_Math" alttext="\begin{split}\Delta^{(\ell-1)}[\,c^{\prime},\,h^{\prime},\,w^{\prime}\,]=\sum_{c=1}^{C^{(\ell)}}\;\sum_{k_{1}=1}^{K}\;\sum_{k_{2}=1}^{K}\;\frac{\partial L}{\partial z^{(\ell)}[\,c,\;h,\;w\,]}\\
\;\cdot\;W^{(\ell)}[\,c,\;c^{\prime},\;k_{1},\;k_{2}\,].\end{split}" display="block" intent=":literal"><semantics><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><msup><mi mathvariant="normal">Δ</mi><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0.170em" stretchy="false">[</mo><mrow><msup><mi>c</mi><mo>′</mo></msup><mo rspace="0.507em">,</mo><msup><mi>h</mi><mo>′</mo></msup><mo rspace="0.507em">,</mo><msup><mi>w</mi><mo>′</mo></msup></mrow><mo lspace="0.170em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0.280em">∑</mo><mrow><mi>c</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>C</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup></munderover><mrow><munderover><mo movablelimits="false" rspace="0.280em">∑</mo><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover><mrow><munderover><mo movablelimits="false" rspace="0.447em">∑</mo><mrow><msub><mi>k</mi><mn>2</mn></msub><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover><mfrac><mrow><mo>∂</mo><mi>L</mi></mrow><mrow><mo>∂</mo><mrow><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0.170em" stretchy="false">[</mo><mrow><mi>c</mi><mo rspace="0.447em">,</mo><mi>h</mi><mo rspace="0.447em">,</mo><mi>w</mi></mrow><mo lspace="0.170em" stretchy="false">]</mo></mrow></mrow></mrow></mfrac></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mphantom></mphantom><mo lspace="0.502em" rspace="0.782em">⋅</mo><mrow><mrow><msup><mi>W</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0.170em" stretchy="false">[</mo><mrow><mi>c</mi><mo rspace="0.727em">,</mo><msup><mi>c</mi><mo>′</mo></msup><mo rspace="0.727em">,</mo><msub><mi>k</mi><mn>1</mn></msub><mo rspace="0.727em">,</mo><msub><mi>k</mi><mn>2</mn></msub></mrow><mo lspace="0.170em" stretchy="false">]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\Delta^{(\ell-1)}[\,c^{\prime},\,h^{\prime},\,w^{\prime}\,]=\sum_{c=1}^{C^{(\ell)}}\;\sum_{k_{1}=1}^{K}\;\sum_{k_{2}=1}^{K}\;\frac{\partial L}{\partial z^{(\ell)}[\,c,\;h,\;w\,]}\\
\;\cdot\;W^{(\ell)}[\,c,\;c^{\prime},\;k_{1},\;k_{2}\,].\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.I3.i2.I1.i3.p1.2" class="ltx_p">Only those elements of <math id="A2.I3.i2.I1.i3.p1.m2" class="ltx_Math" alttext="W^{(\ell)}" display="inline" intent=":literal"><semantics><msup><mi>W</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">W^{(\ell)}</annotation></semantics></math> that map <math id="A2.I3.i2.I1.i3.p1.m3" class="ltx_Math" alttext="(h^{\prime},w^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>h</mi><mo>′</mo></msup><mo>,</mo><msup><mi>w</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(h^{\prime},w^{\prime})</annotation></semantics></math> in <math id="A2.I3.i2.I1.i3.p1.m4" class="ltx_Math" alttext="u^{(\ell-1)}" display="inline" intent=":literal"><semantics><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">u^{(\ell-1)}</annotation></semantics></math> to <math id="A2.I3.i2.I1.i3.p1.m5" class="ltx_Math" alttext="(h,w)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(h,w)</annotation></semantics></math> in <math id="A2.I3.i2.I1.i3.p1.m6" class="ltx_Math" alttext="z^{(\ell)}" display="inline" intent=":literal"><semantics><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">z^{(\ell)}</annotation></semantics></math> will be nonzero in this summation (i.e., <math id="A2.I3.i2.I1.i3.p1.m7" class="ltx_Math" alttext="C^{(\ell-1)}\times K^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>C</mi><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>K</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">C^{(\ell-1)}\times K^{2}</annotation></semantics></math> effective connections per output channel, if stride=1).</p>
</div></li>
</ol>
</div></li>
</ol>
<ul id="A2.I4" class="ltx_itemize">
<li id="A2.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
