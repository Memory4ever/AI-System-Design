</div>
</section>
</section>
<section id="A2.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="A2.SS3.6" class="ltx_text">B-C</span> </span><span id="A2.SS3.7" class="ltx_text ltx_font_bold">Forward Forward Algorithm (BSN): Number of Multiplications and Memory Accesses</span></h3>

<section id="A2.SS3.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection"><span id="A2.SS3.SSS1.6" class="ltx_text">B-C</span>1 </span>Forward Pass (layer <math id="A2.SS3.SSS1.m1" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>)</h4>

<div id="A2.SS3.SSS1.p1" class="ltx_para">
<table id="A2.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E31.m1" class="ltx_Math" alttext="\displaystyle z^{(\ell)}[c]\;" display="inline" intent=":literal"><semantics><mrow><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle z^{(\ell)}[c]\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E31.m2" class="ltx_Math" alttext="\displaystyle=\;w^{(\ell)}[c,\cdot]\;\ast\;u^{(\ell-1)}[\cdot]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.558em">=</mo><mrow><mrow><mrow><msup><mi>w</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>c</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo></mrow><mo rspace="0.335em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.502em">∗</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\;w^{(\ell)}[c,\cdot]\;\ast\;u^{(\ell-1)}[\cdot]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(31)</span></td></tr></tbody>
<tbody id="A2.E32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E32.m1" class="ltx_Math" alttext="\displaystyle p^{(\ell)}[c,i]\;" display="inline" intent=":literal"><semantics><mrow><msup><mi>p</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>c</mi><mo>,</mo><mi>i</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle p^{(\ell)}[c,i]\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E32.m2" class="ltx_Math" alttext="\displaystyle=\;\sigma\!\Bigl(z^{(\ell)}[c,i]\Bigr)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.558em">=</mo><mrow><mpadded style="width:0.437em;" width="0.437em"><mi>σ</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>c</mi><mo>,</mo><mi>i</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\;\sigma\!\Bigl(z^{(\ell)}[c,i]\Bigr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(32)</span></td></tr></tbody>
<tbody id="A2.E33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E33.m1" class="ltx_Math" alttext="\displaystyle a^{(\ell)}[c,i]\;" display="inline" intent=":literal"><semantics><mrow><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>c</mi><mo>,</mo><mi>i</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle a^{(\ell)}[c,i]\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E33.m2" class="ltx_math_unparsed" alttext="\displaystyle\sim\;\mathrm{Bernoulli}\Bigl(p^{(\ell)}[c,i]\Bigr)\quad\forall\,c,\,i" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.558em">∼</mo><mi>Bernoulli</mi><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msup><mi>p</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">[</mo><mi>c</mi><mo>,</mo><mi>i</mi><mo stretchy="false">]</mo></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.167em">)</mo></mrow><mo rspace="0.337em">∀</mo><mi>c</mi><mo rspace="0.337em">,</mo><mi>i</mi></mrow><annotation encoding="application/x-tex">\displaystyle\sim\;\mathrm{Bernoulli}\Bigl(p^{(\ell)}[c,i]\Bigr)\quad\forall\,c,\,i</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(33)</span></td></tr></tbody>
<tbody id="A2.E34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E34.m1" class="ltx_Math" alttext="\displaystyle\tilde{u}^{(\ell)}[c]\;" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>u</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{u}^{(\ell)}[c]\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E34.m2" class="ltx_Math" alttext="\displaystyle=\;\mathrm{max\_pool}\bigl(a^{(\ell)}[c]\bigr)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.558em">=</mo><mrow><mi>max</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>pool</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\;\mathrm{max\_pool}\bigl(a^{(\ell)}[c]\bigr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(34)</span></td></tr></tbody>
<tbody id="A2.E35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E35.m1" class="ltx_Math" alttext="\displaystyle u^{(\ell)}[c]\;" display="inline" intent=":literal"><semantics><mrow><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle u^{(\ell)}[c]\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E35.m2" class="ltx_Math" alttext="\displaystyle=\;\mathrm{BN}\Bigl(\tilde{u}^{(\ell)}[c]\Bigr)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.558em">=</mo><mrow><mi>BN</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msup><mover accent="true"><mi>u</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\;\mathrm{BN}\Bigl(\tilde{u}^{(\ell)}[c]\Bigr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(35)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS3.SSS1.p2" class="ltx_para">
<p id="A2.SS3.SSS1.p2.1" class="ltx_p">Because the BSN activation outputs are in the set <math id="A2.SS3.SSS1.p2.m1" class="ltx_Math" alttext="\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{0,1\}</annotation></semantics></math></p>
<table id="A2.Ex40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex40.m1" class="ltx_Math" alttext="u^{(\ell)}[c]\;\in\;\Bigl\{\tfrac{-\,\mu[c]}{\sqrt{\sigma^{2}[c]}},\;\tfrac{1-\mu[c]}{\sqrt{\sigma^{2}[c]}}\Bigr\}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo rspace="0.280em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.558em">∈</mo><mrow><mo stretchy="false">{</mo><mstyle displaystyle="false"><mfrac><mrow><mo>−</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><msqrt><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow></msqrt></mfrac></mstyle><mo rspace="0.447em">,</mo><mstyle displaystyle="false"><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><msqrt><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow></msqrt></mfrac></mstyle><mo stretchy="false">}</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">u^{(\ell)}[c]\;\in\;\Bigl\{\tfrac{-\,\mu[c]}{\sqrt{\sigma^{2}[c]}},\;\tfrac{1-\mu[c]}{\sqrt{\sigma^{2}[c]}}\Bigr\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS1.p2.2" class="ltx_p">each channel <math id="A2.SS3.SSS1.p2.m2" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> of <math id="A2.SS3.SSS1.p2.m3" class="ltx_Math" alttext="u^{(\ell)}" display="inline" intent=":literal"><semantics><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">u^{(\ell)}</annotation></semantics></math> can be written using two constants <math id="A2.SS3.SSS1.p2.m4" class="ltx_Math" alttext="\alpha^{(\ell)}[c]" display="inline" intent=":literal"><semantics><mrow><msup><mi>α</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha^{(\ell)}[c]</annotation></semantics></math> and <math id="A2.SS3.SSS1.p2.m5" class="ltx_Math" alttext="\delta^{(\ell)}[c]" display="inline" intent=":literal"><semantics><mrow><msup><mi>δ</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\delta^{(\ell)}[c]</annotation></semantics></math>, namely:</p>
</div>
<div id="A2.SS3.SSS1.p3" class="ltx_para">
<table id="A2.Ex41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex41.m1" class="ltx_Math" alttext="u^{(\ell)}[c]\;=\;\alpha^{(\ell)}[c]\,\tilde{u}^{(\ell)}[c]\;+\;\delta^{(\ell)}[c]," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo rspace="0.280em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.558em">=</mo><mrow><mrow><msup><mi>α</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mover accent="true"><mi>u</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo rspace="0.280em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.502em">+</mo><mrow><msup><mi>δ</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">u^{(\ell)}[c]\;=\;\alpha^{(\ell)}[c]\,\tilde{u}^{(\ell)}[c]\;+\;\delta^{(\ell)}[c],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS1.p3.1" class="ltx_p">where</p>
<table id="A2.Ex42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex42.m1" class="ltx_Math" alttext="\alpha^{(\ell)}[c]\;=\;\frac{1}{\sqrt{\bigl(\sigma^{(\ell)}[c]\bigr)^{2}}}\quad\text{and}\quad\delta^{(\ell)}[c]\;=\;\frac{-\,\mu^{(\ell)}[c]}{\sqrt{\bigl(\sigma^{(\ell)}[c]\bigr)^{2}}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msup><mi>α</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo rspace="0.280em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.558em">=</mo><mfrac><mn>1</mn><msqrt><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msup><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup></msqrt></mfrac></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><msup><mi>δ</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo rspace="0.280em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.558em">=</mo><mfrac><mrow><mo>−</mo><mrow><msup><mi>μ</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><msqrt><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msup><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup></msqrt></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\alpha^{(\ell)}[c]\;=\;\frac{1}{\sqrt{\bigl(\sigma^{(\ell)}[c]\bigr)^{2}}}\quad\text{and}\quad\delta^{(\ell)}[c]\;=\;\frac{-\,\mu^{(\ell)}[c]}{\sqrt{\bigl(\sigma^{(\ell)}[c]\bigr)^{2}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS3.SSS1.p4" class="ltx_para">
<p id="A2.SS3.SSS1.p4.1" class="ltx_p">Rewriting the pre-activation <math id="A2.SS3.SSS1.p4.m1" class="ltx_Math" alttext="z^{(\ell)}[c]" display="inline" intent=":literal"><semantics><mrow><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">z^{(\ell)}[c]</annotation></semantics></math> to highlight these terms:</p>
</div>
<div id="A2.SS3.SSS1.p5" class="ltx_para">
<table id="A2.E36" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E36.m1" class="ltx_Math" alttext="\begin{split}z^{(\ell)}[c]&amp;=\sum_{c^{(\ell-1)}=1}^{C^{(\ell-1)}}\Bigl(w^{(\ell)}[c,\,c^{(\ell-1)}]\,\alpha^{(\ell-1)}[c^{(\ell-1)}]\\
&amp;\ast u^{(\ell-1)}[c^{(\ell-1)}]\;+\;w^{(\ell)}[c,\,c^{(\ell-1)}]\,\delta^{(\ell-1)}[c^{(\ell-1)}]\Bigr).\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><msup><mi>c</mi><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mn>1</mn></mrow><msup><mi>C</mi><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></munderover><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msup><mi>w</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>c</mi><mo rspace="0.507em">,</mo><msup><mi>c</mi><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0.340em" rspace="0em">​</mo><msup><mi>α</mi><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mi>c</mi><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo rspace="0.222em">∗</mo><mi>u</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">[</mo><mi>c</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo rspace="0.560em" stretchy="false">]</mo><mo rspace="0.782em">+</mo><mi>w</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">[</mo><mi>c</mi><mo rspace="0.507em">,</mo><mi>c</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo rspace="0.340em" stretchy="false">]</mo><mi>δ</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">[</mo><mi>c</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo><mo maxsize="1.600em" minsize="1.600em">)</mo><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}z^{(\ell)}[c]&amp;=\sum_{c^{(\ell-1)}=1}^{C^{(\ell-1)}}\Bigl(w^{(\ell)}[c,\,c^{(\ell-1)}]\,\alpha^{(\ell-1)}[c^{(\ell-1)}]\\
&amp;\ast u^{(\ell-1)}[c^{(\ell-1)}]\;+\;w^{(\ell)}[c,\,c^{(\ell-1)}]\,\delta^{(\ell-1)}[c^{(\ell-1)}]\Bigr).\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(36)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS3.SSS1.p6" class="ltx_para">
<p id="A2.SS3.SSS1.p6.1" class="ltx_p">This equation shows in practice we do not need to calculate BatchNorm; we can just calculate these constants and store them in local memory.
Whenever we need the BatchNorm output, we simply multiply with the Maxpool output first, which is a binary tensor.
Per channel, this amounts to <math id="A2.SS3.SSS1.p6.m1" class="ltx_Math" alttext="2K^{2}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">2K^{2}</annotation></semantics></math> multiplications, where <math id="A2.SS3.SSS1.p6.m2" class="ltx_Math" alttext="K\times K" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">K\times K</annotation></semantics></math> is the kernel size.
<br class="ltx_break"></p>
</div>
</section>
<section id="A2.SS3.SSSx1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_font_bold ltx_title_subsubsection">M-<em id="A2.SS3.SSSx1.1" class="ltx_emph ltx_font_italic">tiled</em> units</h4>

<div id="A2.SS3.SSSx1.p1" class="ltx_para">
<p id="A2.SS3.SSSx1.p1.1" class="ltx_p">If we use <math id="A2.SS3.SSSx1.p1.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> <em id="A2.SS3.SSSx1.p1.1.1" class="ltx_emph ltx_font_italic">tiled</em> units instead of binary units, then the batch‑normalized outputs take values</p>
<table id="A2.EGx16" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex43.m1" class="ltx_Math" alttext="\displaystyle u^{(\ell)}[c]" display="inline" intent=":literal"><semantics><mrow><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle u^{(\ell)}[c]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex43.m2" class="ltx_math_unparsed" alttext="\displaystyle\;\in\;\Bigl\{\tfrac{i-\mu[c]}{\sqrt{\sigma^{2}[c]}}\;\Big|\;i=0,1,\dots,M\Bigr\}," display="inline" intent=":literal"><semantics><mrow><mo rspace="0.558em">∈</mo><mrow><mo stretchy="false">{</mo><mfrac><mrow><mi>i</mi><mo>−</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><msqrt><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow></msqrt></mfrac><mo fence="false" lspace="0.280em" maxsize="1.600em" minsize="1.600em" rspace="0.447em" stretchy="true">|</mo><mi>i</mi><mo>=</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>M</mi><mo stretchy="false">}</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\;\in\;\Bigl\{\tfrac{i-\mu[c]}{\sqrt{\sigma^{2}[c]}}\;\Big|\;i=0,1,\dots,M\Bigr\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSSx1.p1.2" class="ltx_p">where <math id="A2.SS3.SSSx1.p1.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> is an integer representable in <math id="A2.SS3.SSSx1.p1.m3" class="ltx_Math" alttext="\log_{2}M" display="inline" intent=":literal"><semantics><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\log_{2}M</annotation></semantics></math> bits. Therefore,</p>
<table id="A2.EGx17" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex44"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex44.m1" class="ltx_Math" alttext="\displaystyle w[c]\,\frac{i-\mu[c]}{\sqrt{\sigma^{2}[c]}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>i</mi><mo>−</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><msqrt><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow></msqrt></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle w[c]\,\frac{i-\mu[c]}{\sqrt{\sigma^{2}[c]}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex44.m2" class="ltx_Math" alttext="\displaystyle=i\,\frac{w[c]}{\sqrt{\sigma^{2}[c]}}\;-\;\mu[c]\,\frac{w[c]}{\sqrt{\sigma^{2}[c]}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>i</mi><mo lspace="0.170em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow><msqrt><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow></msqrt></mfrac></mstyle></mrow><mo lspace="0.502em" rspace="0.502em">−</mo><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow><msqrt><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow></msqrt></mfrac></mstyle></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=i\,\frac{w[c]}{\sqrt{\sigma^{2}[c]}}\;-\;\mu[c]\,\frac{w[c]}{\sqrt{\sigma^{2}[c]}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSSx1.p1.3" class="ltx_p">Naïvely, this adds <math id="A2.SS3.SSSx1.p1.m4" class="ltx_Math" alttext="MK^{2}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">MK^{2}</annotation></semantics></math> extra multiplications per input–output channel kernel of size <math id="A2.SS3.SSSx1.p1.m5" class="ltx_Math" alttext="K\times K" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">K\times K</annotation></semantics></math>, but since energy and area scale roughly with the square of operand bit‑width, a multiply between the 32‑bit constant <math id="A2.SS3.SSSx1.p1.m6" class="ltx_Math" alttext="\tfrac{w[c]}{\sqrt{\sigma^{2}[c]}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow><msqrt><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow></msqrt></mfrac><annotation encoding="application/x-tex">\tfrac{w[c]}{\sqrt{\sigma^{2}[c]}}</annotation></semantics></math> and the <math id="A2.SS3.SSSx1.p1.m7" class="ltx_Math" alttext="\log_{2}M" display="inline" intent=":literal"><semantics><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\log_{2}M</annotation></semantics></math>-bit integer <math id="A2.SS3.SSSx1.p1.m8" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> uses far fewer gates and switching activity than a full <math id="A2.SS3.SSSx1.p1.m9" class="ltx_Math" alttext="32\times 32" display="inline" intent=":literal"><semantics><mrow><mn>32</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>32</mn></mrow><annotation encoding="application/x-tex">32\times 32</annotation></semantics></math>-bit multiply—making the <math id="A2.SS3.SSSx1.p1.m10" class="ltx_Math" alttext="MK^{2}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">MK^{2}</annotation></semantics></math> extra operations negligible compared to the usual <math id="A2.SS3.SSSx1.p1.m11" class="ltx_Math" alttext="2K^{2}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">2K^{2}</annotation></semantics></math> full‑width multiplies per channel for smaller values of <math id="A2.SS3.SSSx1.p1.m12" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>.</p>
</div>
<figure id="alg5" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg5.3" class="ltx_text ltx_font_bold">Algorithm 5</span> </span> ForwardForwardOneLayer (BSN)</figcaption>
<div id="alg5.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg5.l0" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l0.1" class="ltx_text" style="font-size:80%;">0:</span></span>
                
                
               
Layer index <math id="alg5.l0.m1" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>, batch size <math id="alg5.l0.m2" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>
 

</div>
<div id="alg5.l0a" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l0a.1" class="ltx_text" style="font-size:80%;">0:</span></span>
                
                
               
Updated weights <math id="alg5.l0a.m1" class="ltx_Math" alttext="W^{(\ell)}" display="inline" intent=":literal"><semantics><msup><mi>W</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">W^{(\ell)}</annotation></semantics></math> and batch-normalized outputs <math id="alg5.l0a.m2" class="ltx_Math" alttext="u^{(\ell)}" display="inline" intent=":literal"><semantics><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">u^{(\ell)}</annotation></semantics></math>
 
{First Pass: Accumulate Mean &amp; Variance for BN}


</div>
<div id="alg5.l1" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
                
                
               sum <math id="alg5.l1.m1" class="ltx_Math" alttext="\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo stretchy="false">←</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\leftarrow 0</annotation></semantics></math>,  sumSq <math id="alg5.l1.m2" class="ltx_Math" alttext="\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo stretchy="false">←</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\leftarrow 0</annotation></semantics></math>


</div>
<div id="alg5.l2" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
                
                
               <span id="alg5.l2.3" class="ltx_text ltx_font_bold">readFromMainMemory<math id="alg5.l2.m1" class="ltx_Math" alttext="(W^{(\ell)})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(W^{(\ell)})</annotation></semantics></math></span>


</div>
<div id="alg5.l3" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
                
                
               <span id="alg5.l3.3" class="ltx_text ltx_font_bold">for</span> <math id="alg5.l3.m1" class="ltx_Math" alttext="n\leftarrow 1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">←</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n\leftarrow 1</annotation></semantics></math> to <math id="alg5.l3.m2" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> <span id="alg5.l3.4" class="ltx_text ltx_font_bold">do</span>




</div>
<div id="alg5.l4" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
                
                
                <span id="alg5.l4.3" class="ltx_text ltx_font_bold">if</span> <math id="alg5.l4.m1" class="ltx_Math" alttext="\ell=1" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\ell=1</annotation></semantics></math> <span id="alg5.l4.4" class="ltx_text ltx_font_bold">then</span>




</div>
<div id="alg5.l5" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
                
                
                 <span id="alg5.l5.3" class="ltx_text ltx_font_bold">readFromMainMemory<math id="alg5.l5.m1" class="ltx_Math" alttext="(\textit{input}_{n})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mtext class="ltx_mathvariant_italic">input</mtext><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\textit{input}_{n})</annotation></semantics></math></span>


</div>
<div id="alg5.l6" class="ltx_listingline">
