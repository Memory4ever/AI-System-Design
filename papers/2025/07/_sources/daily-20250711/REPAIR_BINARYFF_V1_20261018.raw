<td id="S4.T1.fig1.2.4.3" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_bb"><math id="S4.T1.m16" class="ltx_Math" alttext="2NC_{\text{in}}CK^{2}HW+4NC^{2}K^{2}(L-1)" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mtext>in</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">2NC_{\text{in}}CK^{2}HW+4NC^{2}K^{2}(L-1)</annotation></semantics></math></td></tr>
