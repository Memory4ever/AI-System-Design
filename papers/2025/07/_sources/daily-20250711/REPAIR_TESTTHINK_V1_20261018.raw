<td id="S6.T2.10.1.26.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding-top:0.75pt;padding-bottom:0.75pt;"><span id="S6.T2.10.1.26.1.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">      <math id="S6.T2.m29" class="ltx_math_unparsed" alttext="{\Delta}_{grpo\dagger}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-bg-color:#E6E6E6;" mathbackground="#E6E6E6" mathvariant="normal">Δ</mi><msub><mrow></mrow><mrow><mi style="--ltx-bg-color:#E6E6E6;" mathbackground="#E6E6E6">g</mi><mi style="--ltx-bg-color:#E6E6E6;" mathbackground="#E6E6E6">r</mi><mi style="--ltx-bg-color:#E6E6E6;" mathbackground="#E6E6E6">p</mi><mi style="--ltx-bg-color:#E6E6E6;" mathbackground="#E6E6E6">o</mi><mo style="--ltx-bg-color:#E6E6E6;" lspace="0.222em" mathbackground="#E6E6E6">†</mo></mrow></msub></mrow><annotation encoding="application/x-tex">{\Delta}_{grpo\dagger}</annotation></semantics></math></span></td>
<td id="S6.T2.10.1.26.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.75pt;padding-bottom:0.75pt;"><math id="S6.T2.m30" class="ltx_Math" style="--ltx-bg-color:#E6E6E6;" alttext="+" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#E6E6E6;" mathbackground="#E6E6E6">+</mo><annotation encoding="application/x-tex">+</annotation></semantics></math><span id="S6.T2.10.1.26.2.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">5.3</span></td>
<td id="S6.T2.10.1.26.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.75pt;padding-bottom:0.75pt;"><math id="S6.T2.m31" class="ltx_Math" style="--ltx-bg-color:#E6E6E6;" alttext="+" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#E6E6E6;" mathbackground="#E6E6E6">+</mo><annotation encoding="application/x-tex">+</annotation></semantics></math><span id="S6.T2.10.1.26.3.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">4.7</span></td>
