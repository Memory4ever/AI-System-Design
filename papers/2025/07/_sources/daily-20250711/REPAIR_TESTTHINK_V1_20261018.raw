<td id="S6.T3.6.1.6.7" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">34.2</td></tr>
<tr id="S6.T3.6.1.7" class="ltx_tr" style="--ltx-bg-color:#E6E6E6;">
