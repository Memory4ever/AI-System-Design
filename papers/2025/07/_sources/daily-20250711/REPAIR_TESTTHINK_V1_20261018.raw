<td id="S6.T3.6.1.7.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="padding-top:1.5pt;padding-bottom:1.5pt;"><math id="S6.T3.m13" class="ltx_Math" style="--ltx-bg-color:#E6E6E6;" alttext="+" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#E6E6E6;" mathbackground="#E6E6E6">+</mo><annotation encoding="application/x-tex">+</annotation></semantics></math><span id="S6.T3.6.1.7.3.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">0.3</span></td>
