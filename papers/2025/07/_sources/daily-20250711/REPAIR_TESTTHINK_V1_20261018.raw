<td id="S6.T3.6.1.7.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="padding-top:1.5pt;padding-bottom:1.5pt;"><math id="S6.T3.m16" class="ltx_Math" style="--ltx-bg-color:#E6E6E6;" alttext="+" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#E6E6E6;" mathbackground="#E6E6E6">+</mo><annotation encoding="application/x-tex">+</annotation></semantics></math><span id="S6.T3.6.1.7.6.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">8.4</span></td>
<td id="S6.T3.6.1.7.7" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="padding-top:1.5pt;padding-bottom:1.5pt;"><math id="S6.T3.m17" class="ltx_Math" style="--ltx-bg-color:#E6E6E6;" alttext="+" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#E6E6E6;" mathbackground="#E6E6E6">+</mo><annotation encoding="application/x-tex">+</annotation></semantics></math><span id="S6.T3.6.1.7.7.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">3.1</span></td></tr>
