"></path></g><g style="--ltx-fill-color:url(#pgfupat2);" fill="url(#pgfupat2)"></g><g style="--ltx-fill-color:#98DF8A;" fill="#98DF8A" fill-opacity="0.9" stroke-opacity="1"><path d="M -10.38 0 h 9.69 v 102.54 h -9.69 Z M 40.47 0 h 9.69 v 92.21 h -9.69 Z M 91.32 0 h 9.69 v 174.09 h -9.69 Z"></path><defs><pattern height="4" id="pgfpat4" patternUnits="userSpaceOnUse" width="4"><symbol id="pgfsym4"><g stroke-width="0.4pt"><path style="fill:none" d="M 0 4.15 L 4.29 -0.14"></path></g><g></g><defs><pattern id="pgfupat3" href="#pgfpat4"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000"><use href="#pgfsym4"></use></g></pattern></defs><g style="--ltx-fill-color:#98DF8A;" fill="#98DF8A"><path d="M -10.38 0 h 9.69 v 102.54 h -9.69 Z M 40.47 0 h 9.69 v 92.21 h -9.69 Z M 91.32 0 h 9.69 v 174.09 h -9.69 Z"></path></g><g style="--ltx-fill-color:url(#pgfupat3);" fill="url(#pgfupat3)"></g><g style="--ltx-fill-color:#FF9896;" fill="#FF9896" fill-opacity="0.9" stroke-opacity="1"><path d="M 0.69 0 h 9.69 v 163.95 h -9.69 Z M 51.54 0 h 9.69 v 123.01 h -9.69 Z M 102.39 0 h 9.69 v 184.42 h -9.69 Z"></path><defs><pattern height="4" id="pgfpat1" patternUnits="userSpaceOnUse" width="138"><symbol id="pgfsym1"><g stroke-width="0.4pt"><path style="fill:none" d="M 0 0.69 L 138.37 0.69"></path></g><g></g><defs><pattern id="pgfupat4" href="#pgfpat1"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000"><use href="#pgfsym1"></use></g></pattern></defs><g style="--ltx-fill-color:#FF9896;" fill="#FF9896"><path d="M 0.69 0 h 9.69 v 163.95 h -9.69 Z M 51.54 0 h 9.69 v 123.01 h -9.69 Z M 102.39 0 h 9.69 v 184.42 h -9.69 Z"></path></g><g style="--ltx-fill-color:url(#pgfupat4);" fill="url(#pgfupat4)"></g><g style="--ltx-fill-color:#C5B0D5;" fill="#C5B0D5" fill-opacity="0.9" stroke-opacity="1"><path d="M 11.76 0 h 9.69 v 162.84 h -9.69 Z M 62.61 0 h 9.69 v 112.68 h -9.69 Z M 113.46 0 h 9.69 v 92.21 h -9.69 Z"></path><defs