<td id="S4.T5.2.19.2" class="ltx_td ltx_align_center"><span id="S4.T5.2.19.2.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#FF8000;">●</span></td>
<td id="S4.T5.2.19.3" class="ltx_td ltx_align_center"><span id="S4.T5.2.19.3.1" class="ltx_text" style="font-size:90%;">●</span></td>
