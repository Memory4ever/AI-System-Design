<tbody class="ltx_tbody">
<tr id="S4.T6.4.2" class="ltx_tr">
<td id="S4.T6.4.2.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S4.T6.4.2.1.1" class="ltx_inline-block ltx_align_top" style="width:85.4pt;">
<span id="S4.T6.4.2.1.1.1" class="ltx_p ltx_align_left"><span id="S4.T6.4.2.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Smaller than 70B</span></span>
</span></td>
<td id="S4.T6.4.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
