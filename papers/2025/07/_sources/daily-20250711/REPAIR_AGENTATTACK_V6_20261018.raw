<p id="S4.I5.i1.p1.1" class="ltx_p"><span id="S4.I5.i1.p1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Small</span><span id="S4.I5.i1.p1.1.2" class="ltx_text" style="font-size:90%;">: qwen3:14b, devstral:24b, Mistral-small, qwen3:30b</span></p>
</div></li>
<li id="S4.I5.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I5.i2.p1" class="ltx_para">
<p id="S4.I5.i2.p1.1" class="ltx_p"><span id="S4.I5.i2.p1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Large</span><span id="S4.I5.i2.p1.1.2" class="ltx_text" style="font-size:90%;">: MFDoom/deepseek-r1-tool-calling:70b, llama3.3:70b, llama4:16x17b</span></p>
</div></li>
<li id="S4.I5.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
