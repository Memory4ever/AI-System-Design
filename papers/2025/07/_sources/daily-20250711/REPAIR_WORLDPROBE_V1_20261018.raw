<td id="A8.T8.3.3.4" class="ltx_td ltx_align_center ltx_border_t">0.580 (0.029)</td>
<td id="A8.T8.3.3.5" class="ltx_td ltx_align_center ltx_border_t">0.845 (0.019)</td></tr>
<tr id="A8.T8.3.4" class="ltx_tr">
