<th id="A8.T8.3.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A8.T8.m4" class="ltx_Math" alttext="\text{D-IB}_{q\neq}" display="inline" intent=":literal"><semantics><msub><mtext>D-IB</mtext><mrow><mi>q</mi><mo>≠</mo><mphantom></mphantom></mrow></msub><annotation encoding="application/x-tex">\text{D-IB}_{q\neq}</annotation></semantics></math></th></tr>
