<div id="lstnumberx17" class="ltx_listingline"><span id="lstnumberx17.1" class="ltx_text ltx_lst_identifier">You</span><span id="lstnumberx17.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.3" class="ltx_text ltx_lst_identifier">can</span><span id="lstnumberx17.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.5" class="ltx_text ltx_lst_identifier">reason</span><span id="lstnumberx17.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.7" class="ltx_text ltx_lst_identifier">all</span><span id="lstnumberx17.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.9" class="ltx_text ltx_lst_identifier">you</span>’<span id="lstnumberx17.10" class="ltx_text ltx_lst_identifier">d</span><span id="lstnumberx17.11" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.12" class="ltx_text ltx_lst_identifier">like</span>,<span id="lstnumberx17.13" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.14" class="ltx_text ltx_lst_identifier">but</span><span id="lstnumberx17.15" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.16" class="ltx_text ltx_lst_identifier">your</span><span id="lstnumberx17.17" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.18" class="ltx_text ltx_lst_identifier">answer</span><span id="lstnumberx17.19" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.20" class="ltx_text ltx_lst_identifier">should</span><span id="lstnumberx17.21" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.22" class="ltx_text ltx_lst_identifier">end</span><span id="lstnumberx17.23" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.24" class="ltx_text ltx_lst_identifier">with</span><span id="lstnumberx17.25" class="ltx_text ltx_lst_space"> </span>”<span id="lstnumberx17.26" class="ltx_text ltx_lst_identifier">ANSWER</span>:<span id="lstnumberx17.27" class="ltx_text ltx_lst_space"> </span>”<span id="lstnumberx17.28" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.29" class="ltx_text ltx_lst_identifier">followed</span><span id="lstnumberx17.30" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.31" class="ltx_text ltx_lst_identifier">by</span><span id="lstnumberx17.32" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.33" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx17.34" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.35" class="ltx_text ltx_lst_identifier">predicted</span><span id="lstnumberx17.36" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.37" class="ltx_text ltx_lst_identifier">outcomes</span><span id="lstnumberx17.38" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.39" class="ltx_text ltx_lst_identifier">for</span><span id="lstnumberx17.40" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.41" class="ltx_text ltx_lst_identifier">all</span><span id="lstnumberx17.42" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.43" class="ltx_text ltx_lst_identifier">of</span><span id="lstnumberx17.44" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.45" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx17.46" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.47" class="ltx_text ltx_lst_identifier">timesteps</span>,<span id="lstnumberx17.48" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.49" class="ltx_text ltx_lst_identifier">even</span><span id="lstnumberx17.50" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.51" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx17.52" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.53" class="ltx_text ltx_lst_identifier">unknown</span><span id="lstnumberx17.54" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.55" class="ltx_text ltx_lst_identifier">ones</span>.<span id="lstnumberx17.56" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.57" class="ltx_text ltx_lst_identifier">You</span><span id="lstnumberx17.58" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.59" class="ltx_text ltx_lst_identifier">should</span><span id="lstnumberx17.60" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.61" class="ltx_text ltx_lst_identifier">structure</span><span id="lstnumberx17.62" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.63" class="ltx_text ltx_lst_identifier">your</span><span id="lstnumberx17.64" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.65" class="ltx_text ltx_lst_identifier">predictions</span><span id="lstnumberx17.66" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.67" class="ltx_text ltx_lst_identifier">as</span><span id="lstnumberx17.68" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.69" class="ltx_text ltx_lst_identifier">a</span><span id="lstnumberx17.70" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.71" class="ltx_text ltx_lst_identifier">dict</span>,<span id="lstnumberx17.72" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.73" class="ltx_text ltx_lst_identifier">where</span><span id="lstnumberx17.74" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.75" class="ltx_text ltx_lst_identifier">each</span><span id="lstnumberx17.76" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.77" class="ltx_text ltx_lst_identifier">key</span><span id="lstnumberx17.78" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.79" class="ltx_text ltx_lst_identifier">is</span><span id="lstnumberx17.80" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.81" class="ltx_text ltx_lst_identifier">a</span><span id="lstnumberx17.82" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.83" class="ltx_text ltx_lst_identifier">timestep</span><span id="lstnumberx17.84" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.85" class="ltx_text ltx_lst_identifier">and</span><span id="lstnumberx17.86" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.87" class="ltx_text ltx_lst_identifier">each</span><span id="lstnumberx17.88" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.89" class="ltx_text ltx_lst_identifier">value</span><span id="lstnumberx17.90" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.91" class="ltx_text ltx_lst_identifier">is</span><span id="lstnumberx17.92" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.93" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx17.94" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.95" class="ltx_text ltx_lst_identifier">prediction</span>.<span id="lstnumberx17.96" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.97" class="ltx_text ltx_lst_identifier">You</span><span id="lstnumberx17.98" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.99" class="ltx_text ltx_lst_identifier">should</span><span id="lstnumberx17.100" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.101" class="ltx_text ltx_lst_identifier">make</span><span id="lstnumberx17.102" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.103" class="ltx_text ltx_lst_identifier">predictions</span><span id="lstnumberx17.104" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.105" class="ltx_text ltx_lst_identifier">for</span><span id="lstnumberx17.106" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.107" class="ltx_text ltx_lst_identifier">all</span><span id="lstnumberx17.108" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.109" class="ltx_text ltx_lst_identifier">of</span><span id="lstnumberx17.110" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.111" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx17.112" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.113" class="ltx_text ltx_lst_identifier">timesteps</span>,<span id="lstnumberx17.114" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.115" class="ltx_text ltx_lst_identifier">even</span><span id="lstnumberx17.116" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.117" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx17.118" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.119" class="ltx_text ltx_lst_identifier">ones</span><span id="lstnumberx17.120" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.121" class="ltx_text ltx_lst_identifier">that</span><span id="lstnumberx17.122" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.123" class="ltx_text ltx_lst_identifier">are</span><span id="lstnumberx17.124" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.125" class="ltx_text ltx_lst_identifier">known</span>.
