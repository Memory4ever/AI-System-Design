            <span id="alg0.l2.3" class="ltx_text" style="font-size:90%;">Set training batch size </span><math id="alg0.l2.m1" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math><span id="alg0.l2.4" class="ltx_text" style="font-size:90%;">, off-policy data portion </span><math id="alg0.l2.m2" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math><span id="alg0.l2.5" class="ltx_text" style="font-size:90%;">, UTD ratio </span><math id="alg0.l2.m3" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math><span id="alg0.l2.6" class="ltx_text" style="font-size:90%;">, historical policy window size </span><math id="alg0.l2.m4" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math><span id="alg0.l2.7" class="ltx_text" style="font-size:90%;">, policy reincarnation step point </span><math id="alg0.l2.m5" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math><span id="alg0.l2.8" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg0.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg0.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
            <span id="alg0.l3.3" class="ltx_text" style="font-size:90%;">Init the model </span><math id="alg0.l3.m1" class="ltx_Math" alttext="\pi_{\theta}=\pi_{\text{base}}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">π</mi><mi mathsize="0.900em">θ</mi></msub><mo mathsize="0.900em">=</mo><msub><mi mathsize="0.900em">π</mi><mtext mathsize="0.900em">base</mtext></msub></mrow><annotation encoding="application/x-tex">\pi_{\theta}=\pi_{\text{base}}</annotation></semantics></math><span id="alg0.l3.4" class="ltx_text" style="font-size:90%;"> and the historical policy set </span><math id="alg0.l3.m2" class="ltx_Math" alttext="\mathbb{H}=\emptyset" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">ℍ</mi><mo mathsize="0.900em">=</mo><mi mathsize="0.900em" mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\mathbb{H}=\emptyset</annotation></semantics></math><span id="alg0.l3.5" class="ltx_text" style="font-size:90%;">
</span>
