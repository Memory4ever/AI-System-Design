<td id="S4.T4.3.1.4.2" class="ltx_td ltx_align_center">10.00</td>
<td id="S4.T4.3.1.4.3" class="ltx_td ltx_align_center"><span id="S4.T4.3.1.4.3.1" class="ltx_text ltx_underline">49.4</span></td>
<td id="S4.T4.3.1.4.4" class="ltx_td ltx_align_center">75.00</td>
<td id="S4.T4.3.1.4.5" class="ltx_td ltx_align_center">21.32</td>
<td id="S4.T4.3.1.4.6" class="ltx_td ltx_align_center ltx_border_r">34.22</td>
<td id="S4.T4.3.1.4.7" class="ltx_td ltx_align_center">37.99<sub id="S4.T4.3.1.4.7.1" class="ltx_sub"><span id="S4.T4.3.1.4.7.1.1" class="ltx_text" style="--ltx-fg-color:#006600;">↓14.15</span></sub></td></tr>
<tr id="S4.T4.3.1.5" class="ltx_tr">
<td id="S4.T4.3.1.5.1" class="ltx_td ltx_align_left ltx_border_r">PPO (500 Steps)</td>
