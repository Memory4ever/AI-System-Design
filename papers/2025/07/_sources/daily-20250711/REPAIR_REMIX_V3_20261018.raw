<td id="S4.T4.3.1.5.3" class="ltx_td ltx_align_center">48.19</td>
<td id="S4.T4.3.1.5.4" class="ltx_td ltx_align_center"><span id="S4.T4.3.1.5.4.1" class="ltx_text ltx_underline">77.60</span></td>
<td id="S4.T4.3.1.5.5" class="ltx_td ltx_align_center"><span id="S4.T4.3.1.5.5.1" class="ltx_text ltx_underline">25.00</span></td>
<td id="S4.T4.3.1.5.6" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T4.3.1.5.6.1" class="ltx_text ltx_underline">38.96</span></td>
<td id="S4.T4.3.1.5.7" class="ltx_td ltx_align_center"><span id="S4.T4.3.1.5.7.1" class="ltx_text ltx_underline">41.95</span><sub id="S4.T4.3.1.5.7.2" class="ltx_sub"><span id="S4.T4.3.1.5.7.2.1" class="ltx_text" style="--ltx-fg-color:#006600;">↓7.61</span></sub></td></tr>
