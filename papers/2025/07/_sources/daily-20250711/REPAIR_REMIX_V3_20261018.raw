<td id="A3.T7.3.1.6.4" class="ltx_td ltx_align_center">16</td>
<td id="A3.T7.3.1.6.5" class="ltx_td ltx_align_center">16k</td>
<td id="A3.T7.3.1.6.6" class="ltx_td ltx_align_center">8</td></tr>
