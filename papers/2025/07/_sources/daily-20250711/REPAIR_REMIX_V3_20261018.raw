<td id="S4.T4.3.1.3.3" class="ltx_td ltx_align_center ltx_border_t">37.35</td>
<td id="S4.T4.3.1.3.4" class="ltx_td ltx_align_center ltx_border_t">60.40</td>
<td id="S4.T4.3.1.3.5" class="ltx_td ltx_align_center ltx_border_t">13.24</td>
<td id="S4.T4.3.1.3.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">22.37</td>
<td id="S4.T4.3.1.3.7" class="ltx_td ltx_align_center ltx_border_t">30.67<sub id="S4.T4.3.1.3.7.1" class="ltx_sub"><span id="S4.T4.3.1.3.7.1.1" class="ltx_text" style="--ltx-fg-color:#006600;">↓6.91</span></sub></td></tr>
