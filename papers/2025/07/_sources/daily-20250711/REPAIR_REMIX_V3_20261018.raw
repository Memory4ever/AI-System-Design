            <span id="alg0.l6.3" class="ltx_text" style="font-size:90%;">  Sample a batch of questions </span><math id="alg0.l6.m1" class="ltx_Math" alttext="q\sim\mathcal{D}_{0}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">q</mi><mo mathsize="0.900em">∼</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒟</mi><mn mathsize="0.900em">0</mn></msub></mrow><annotation encoding="application/x-tex">q\sim\mathcal{D}_{0}</annotation></semantics></math><span id="alg0.l6.4" class="ltx_text" style="font-size:90%;"> with size </span><math id="alg0.l6.m2" class="ltx_Math" alttext="(1-p)B" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">p</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">B</mi></mrow><annotation encoding="application/x-tex">(1-p)B</annotation></semantics></math><span id="alg0.l6.5" class="ltx_text" style="font-size:90%;"> and generate fresh responses according to </span><math id="alg0.l6.m3" class="ltx_Math" alttext="\pi_{\theta}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">π</mi><mi mathsize="0.900em">θ</mi></msub><annotation encoding="application/x-tex">\pi_{\theta}</annotation></semantics></math><span id="alg0.l6.6" class="ltx_text" style="font-size:90%;"> and </span><math id="alg0.l6.m4" class="ltx_Math" alttext="\mathbb{A}" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">𝔸</mi><annotation encoding="application/x-tex">\mathbb{A}</annotation></semantics></math><span id="alg0.l6.7" class="ltx_text" style="font-size:90%;">
