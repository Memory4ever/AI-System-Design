<td id="A3.T7.3.1.5.2" class="ltx_td ltx_align_center">-</td>
<td id="A3.T7.3.1.5.3" class="ltx_td ltx_align_center"><span id="A3.T7.3.1.5.3.1" class="ltx_text ltx_font_italic">1024</span></td>
<td id="A3.T7.3.1.5.4" class="ltx_td ltx_align_center"><span id="A3.T7.3.1.5.4.1" class="ltx_text ltx_font_italic">5</span></td>
<td id="A3.T7.3.1.5.5" class="ltx_td ltx_align_center">32k</td>
<td id="A3.T7.3.1.5.6" class="ltx_td ltx_align_center"><span id="A3.T7.3.1.5.6.1" class="ltx_text ltx_font_italic">8</span></td></tr>
<tr id="A3.T7.3.1.6" class="ltx_tr">
