{"data":{"id":"10.48550/arxiv.2507.07562","type":"dois","attributes":{"doi":"10.48550/arxiv.2507.07562","prefix":"10.48550","suffix":"arxiv.2507.07562","identifiers":[{"identifier":"2507.07562","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2507.07562"}],"creators":[{"name":"Chen, Jierun","nameType":"Personal","givenName":"Jierun","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Yu, Tiezheng","nameType":"Personal","givenName":"Tiezheng","familyName":"Yu","affiliation":[],"nameIdentifiers":[]},{"name":"Bai, Haoli","nameType":"Personal","givenName":"Haoli","familyName":"Bai","affiliation":[],"nameIdentifiers":[]},{"name":"Yao, Lewei","nameType":"Personal","givenName":"Lewei","familyName":"Yao","affiliation":[],"nameIdentifiers":[]},{"name":"Wu, Jiannan","nameType":"Personal","givenName":"Jiannan","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Kaican","nameType":"Personal","givenName":"Kaican","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Mi, Fei","nameType":"Personal","givenName":"Fei","familyName":"Mi","affiliation":[],"nameIdentifiers":[]},{"name":"Tao, Chaofan","nameType":"Personal","givenName":"Chaofan","familyName":"Tao","affiliation":[],"nameIdentifiers":[]},{"name":"Zhu, Lei","nameType":"Personal","givenName":"Lei","familyName":"Zhu","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Manyi","nameType":"Personal","givenName":"Manyi","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Xiaohui","nameType":"Personal","givenName":"Xiaohui","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Hou, Lu","nameType":"Personal","givenName":"Lu","familyName":"Hou","affiliation":[],"nameIdentifiers":[]},{"name":"Shang, Lifeng","nameType":"Personal","givenName":"Lifeng","familyName":"Shang","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Qun","nameType":"Personal","givenName":"Qun","familyName":"Liu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Synergy Dilemma of Long-CoT SFT and RL: Investigating Post-Training Techniques for Reasoning VLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-07-10T09:05:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-07-11T00:24:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-07","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Large vision-language models (VLMs) increasingly adopt post-training techniques such as long chain-of-thought (CoT) supervised fine-tuning (SFT) and reinforcement learning (RL) to elicit sophisticated reasoning. While these methods exhibit synergy in language-only models, their joint effectiveness in VLMs remains uncertain. We present a systematic investigation into the distinct roles and interplay of long-CoT SFT and RL across multiple multimodal reasoning benchmarks. We find that SFT improves performance on difficult questions by in-depth, structured reasoning, but introduces verbosity and degrades performance on simpler ones. In contrast, RL promotes generalization and brevity, yielding consistent improvements across all difficulty levels, though the improvements on the hardest questions are less prominent compared to SFT. Surprisingly, combining them through two-staged, interleaved, or progressive training strategies, as well as data mixing and model merging, all fails to produce additive benefits, instead leading to trade-offs in accuracy, reasoning style, and response length. This ``synergy dilemma'' highlights the need for more seamless and adaptive approaches to unlock the full potential of combined post-training techniques for reasoning VLMs.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2507.07562","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-07-11T01:30:07.000Z","registered":"2025-07-11T01:30:08.000Z","published":"2025","updated":"2025-07-11T01:30:08.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2507.07562","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}