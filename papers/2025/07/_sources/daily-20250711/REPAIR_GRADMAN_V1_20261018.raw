</figure>
<figure id="A5.F10" class="ltx_figure"><img src="2507.06656v1/More_visual/gaussian.jpg" id="A5.F10.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:471/562;" width="471" height="562" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A5.F10.4" class="ltx_text" style="font-size:90%;">Figure 10</span>. </span><span id="A5.F10.5" class="ltx_text" style="font-size:90%;">Qualitative visual comparison of <span id="A5.F10.5.1" class="ltx_text ltx_font_bold">Gaussian deblurring</span> on FFHQ (top rows) and ImageNet (bottom rows).</span></figcaption>
</figure>
