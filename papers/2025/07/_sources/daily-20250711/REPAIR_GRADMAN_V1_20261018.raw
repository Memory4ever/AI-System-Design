11.53)" width="67.73"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F4.pic1.6" class="ltx_text" style="font-size:120%;">RED-Diff</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 368.8 268.25)"><foreignObject style="--ltx-fo-width:2.12em;--ltx-fo-height:0.7em;--ltx-fo-depth:0em;font-size:11.75pt;" height="11.35" overflow="visible" transform="matrix(1 0 0 -1 0 11.35)" width="34.41"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F4.pic1.7" class="ltx_text" style="font-size:120%;">Ours</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 412.32 268.16)"><foreignObject style="--ltx-fo-width:4.21em;--ltx-fo-height:0.71em;--ltx-fo-depth:0em;font-size:11.75pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 11.53)" width="68.42"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F4.pic1.8" class="ltx_text" style="font-size:120%;">Reference</span></span></span></foreignObject></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S4.F4.3" class="ltx_text" style="font-size:90%;">Figure 4</span>. </span><span id="S4.F4.4" class="ltx_text" style="font-size:90%;">Image restoration results with <math id="S4.F4.m3" class="ltx_Math" alttext="\sigma_{y}=0.01" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi>y</mi></msub><mo>=</mo><mn>0.01</mn></mrow><annotation encoding="application/x-tex">\sigma_{y}=0.01</annotation></semantics></math>. Row 1: random inpainting, Row 2: SR (<math id="S4.F4.m4" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>4), Row 3: Gaussian deblurring.</span></figcaption>
</figure>
<figure id="S4.T1" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="S4.T1.5" class="ltx_text" style="font-size:90%;">Table 1</span>. </span><span id="S4.T1.6" class="ltx_text" style="font-size:90%;">Quantitative evaluation of image restoration tasks on FFHQ 256<math id="S4.T1.m4" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>256 and ImageNet 256<math id="S4.T1.m5" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>256 with <math id="S4.T1.m6" class="ltx_Math" alttext="\sigma_{y}=0.01" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi>y</mi></msub><mo>=</mo><mn>0.01</mn></mrow><annotation encoding="application/x-tex">\sigma_{y}=0.01</annotation></semantics></math>.Best results are marked in <span id="S4.T1.6.1" class="ltx_text ltx_font_bold">bold</span>, and second-best results are <span id="S4.T1.6.2" class="ltx_text ltx_underline">underlined</span>.
</span></figcaption>
