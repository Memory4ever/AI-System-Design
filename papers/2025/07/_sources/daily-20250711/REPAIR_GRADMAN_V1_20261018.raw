<th id="S5.T3.5.5.2" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="S5.T3.m13" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>=10</th>
