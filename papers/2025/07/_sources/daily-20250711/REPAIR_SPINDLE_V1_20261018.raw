<td id="S4.T3.2.1.2" class="ltx_td ltx_align_left ltx_border_tt"><span id="S4.T3.2.1.2.1" class="ltx_text ltx_font_bold">Value</span></td></tr>
<tr id="S4.T3.2.2" class="ltx_tr">
<td id="S4.T3.2.2.1" class="ltx_td ltx_align_center ltx_border_t">Key Threshold (<math id="S4.T3.m1" class="ltx_Math" alttext="\theta_{K}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mi>K</mi></msub><annotation encoding="application/x-tex">\theta_{K}</annotation></semantics></math>)</td>
<td id="S4.T3.2.2.2" class="ltx_td ltx_align_left ltx_border_t">0.98</td></tr>
