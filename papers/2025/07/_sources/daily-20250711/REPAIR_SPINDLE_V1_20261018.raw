<td id="S4.T3.2.3.2" class="ltx_td ltx_align_left">0.95</td></tr>
<tr id="S4.T3.2.4" class="ltx_tr">
<td id="S4.T3.2.4.1" class="ltx_td ltx_align_center"><math id="S4.T3.m3" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math></td>
<td id="S4.T3.2.4.2" class="ltx_td ltx_align_left">0.05</td></tr>
