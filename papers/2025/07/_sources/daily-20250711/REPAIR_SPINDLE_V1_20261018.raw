<td id="S3.T1.2.1.1.8" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:3pt;padding-bottom:3pt;" colspan="2"><span id="S3.T1.2.1.1.8.1" class="ltx_text ltx_font_bold">Code</span></td>
<td id="S3.T1.2.1.1.9" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:3pt;padding-bottom:3pt;" rowspan="2"><span id="S3.T1.2.1.1.9.1" class="ltx_text ltx_font_bold">AVG.</span></td></tr>
<tr id="S3.T1.2.1.2" class="ltx_tr">
<td id="S3.T1.2.1.2.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:3pt;padding-bottom:3pt;">Na.QA</td>
<td id="S3.T1.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:3pt;padding-bottom:3pt;">Qasp</td>
<td id="S3.T1.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:3pt;padding-bottom:3pt;">Mu.QA</td>
