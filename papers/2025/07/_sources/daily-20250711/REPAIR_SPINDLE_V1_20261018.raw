<td id="S3.T1.2.1.2.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:3pt;padding-bottom:3pt;">QMSm</td>
<td id="S3.T1.2.1.2.9" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:3pt;padding-bottom:3pt;">M.New</td>
<td id="S3.T1.2.1.2.10" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:3pt;padding-bottom:3pt;">TREC</td>
<td id="S3.T1.2.1.2.11" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:3pt;padding-bottom:3pt;">Tr.QA</td>
<td id="S3.T1.2.1.2.12" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:3pt;padding-bottom:3pt;">SASm</td>
<td id="S3.T1.2.1.2.13" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:3pt;padding-bottom:3pt;">PCnt</td>
<td id="S3.T1.2.1.2.14" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:3pt;padding-bottom:3pt;">Pa.Rt</td>
<td id="S3.T1.2.1.2.15" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:3pt;padding-bottom:3pt;">Lcc</td>
