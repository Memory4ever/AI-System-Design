<section id="A3.SS0.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Top Model Outputs</h4>

<div id="A3.SS0.SSS0.Px1.p1" class="ltx_para">
<p id="A3.SS0.SSS0.Px1.p1.1" class="ltx_p">Below are the top 5 most frequently produced generations by GPT-4o in each category of epistemic marker, for each language.</p>
</div>
<figure id="A3.T6" class="ltx_table ltx_align_center">
<table id="A3.T6.3" class="ltx_tabular">
<tr id="A3.T6.3.1" class="ltx_tr">
<td id="A3.T6.3.1.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_tt">
<span id="A3.T6.3.1.1.1" class="ltx_inline-block ltx_align_top" style="width:216.8pt;">
<span id="A3.T6.3.1.1.1.1" class="ltx_p"><span id="A3.T6.3.1.1.1.1.1" class="ltx_text ltx_font_bold">Expression</span></span>
</span></td>
<td id="A3.T6.3.1.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_tt">
<span id="A3.T6.3.1.2.1" class="ltx_inline-block ltx_align_top" style="width:72.3pt;">
