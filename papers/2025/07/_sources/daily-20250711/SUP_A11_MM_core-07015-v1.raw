<td id="S3.T1.8.1.6" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:-1.5pt;padding-bottom:-1.5pt;" colspan="2"><span id="S3.T1.8.1.6.1" class="ltx_text ltx_font_bold">VGGSound-50k</span></td>
<td id="S3.T1.8.1.7" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:-1.5pt;padding-bottom:-1.5pt;" colspan="2"><span id="S3.T1.8.1.7.1" class="ltx_text ltx_font_bold">CrisisMMD-V2</span></td></tr>
<tr id="S3.T1.8.2" class="ltx_tr">
<td id="S3.T1.8.2.1" class="ltx_td ltx_align_center" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">Image</td>
<td id="S3.T1.8.2.2" class="ltx_td ltx_align_center" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">Audio</td>
<td id="S3.T1.8.2.3" class="ltx_td ltx_align_center" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">Visual</td>
<td id="S3.T1.8.2.4" class="ltx_td ltx_align_center" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">Audio</td>
<td id="S3.T1.8.2.5" class="ltx_td ltx_align_center" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">Visual</td>
<td id="S3.T1.8.2.6" class="ltx_td ltx_align_center" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">Audio</td>
<td id="S3.T1.8.2.7" class="ltx_td ltx_align_center" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">Image</td>
