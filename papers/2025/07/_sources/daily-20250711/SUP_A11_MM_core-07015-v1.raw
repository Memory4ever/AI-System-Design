<span id="S4.T3.4.1.1.1.8.8.1.1" class="ltx_p ltx_align_center"><span id="S4.T3.4.1.1.1.8.8.1.1.1" class="ltx_text ltx_ulem_uline" style="--ltx-fg-color:#CD5C5C;">0.5481</span></span>
