<span id="S4.T3.4.1.1.1.8.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:-0.9pt;padding-bottom:-0.9pt;"><span id="S4.T3.4.1.1.1.8.2.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">✓</span></span>
