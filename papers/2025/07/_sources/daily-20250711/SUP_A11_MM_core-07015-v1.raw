              Compute student logits <math id="alg1.l19.m1" class="ltx_Math" alttext="Z_{\text{out}}=f_{m_{t}}(x_{t};\theta_{m_{t}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mtext>out</mtext></msub><mo>=</mo><mrow><msub><mi>f</mi><msub><mi>m</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>θ</mi><msub><mi>m</mi><mi>t</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Z_{\text{out}}=f_{m_{t}}(x_{t};\theta_{m_{t}})</annotation></semantics></math>

</div>
