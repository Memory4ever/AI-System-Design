<tr id="S3.T1.8.3" class="ltx_tr">
<td id="S3.T1.8.3.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">—</td>
<td id="S3.T1.8.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">w/o KD</td>
<td id="S3.T1.8.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">—</td>
<td id="S3.T1.8.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">0.6322</td>
<td id="S3.T1.8.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">0.4372</td>
<td id="S3.T1.8.3.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">0.7472</td>
<td id="S3.T1.8.3.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">0.6694</td>
<td id="S3.T1.8.3.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">0.4080</td>
<td id="S3.T1.8.3.9" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">0.5818</td>
<td id="S3.T1.8.3.10" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">0.5524</td>
<td id="S3.T1.8.3.11" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">0.5405</td></tr>
<tr id="S3.T1.8.4" class="ltx_tr">
<td id="S3.T1.8.4.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-1.5pt;padding-bottom:-1.5pt;" rowspan="4"><span id="S3.T1.8.4.1.1" class="ltx_text">Response-Based</span></td>
<td id="S3.T1.8.4.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-1.5pt;padding-bottom:-1.5pt;" rowspan="2"><span id="S3.T1.8.4.2.1" class="ltx_text">KD</span></td>
<td id="S3.T1.8.4.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">MM</td>
<td id="S3.T1.8.4.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">0.6322</td>
<td id="S3.T1.8.4.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-1.5pt;padding-bottom:-1.5pt;"><span id="S3.T1.8.4.5.1" class="ltx_text" style="--ltx-fg-color:#4682B4;">0.4383</span></td>
<td id="S3.T1.8.4.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-1.5pt;padding-bottom:-1.5pt;"><span id="S3.T1.8.4.6.1" class="ltx_text" style="--ltx-fg-color:#4682B4;">0.7521</span></td>
<td id="S3.T1.8.4.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-1.5pt;padding-bottom:-1.5pt;"><span id="S3.T1.8.4.7.1" class="ltx_text" style="--ltx-fg-color:#4682B4;">0.6979</span></td>
<td id="S3.T1.8.4.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-1.5pt;padding-bottom:-1.5pt;"><span id="S3.T1.8.4.8.1" class="ltx_text" style="--ltx-fg-color:#4682B4;">0.4248</span></td>
<td id="S3.T1.8.4.9" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">0.5786</td>
<td id="S3.T1.8.4.10" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">0.5505</td>
<td id="S3.T1.8.4.11" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">0.5367</td></tr>
<tr id="S3.T1.8.5" class="ltx_tr">
<td id="S3.T1.8.5.1" class="ltx_td ltx_align_center" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">CM</td>
<td id="S3.T1.8.5.2" class="ltx_td ltx_align_center" style="padding-top:-1.5pt;padding-bottom:-1.5pt;"><span id="S3.T1.8.5.2.1" class="ltx_text" style="--ltx-fg-color:#4682B4;">0.6328</span></td>
<td id="S3.T1.8.5.3" class="ltx_td ltx_align_center" style="padding-top:-1.5pt;padding-bottom:-1.5pt;"><span id="S3.T1.8.5.3.1" class="ltx_text" style="--ltx-fg-color:#4682B4;">0.4377</span></td>
<td id="S3.T1.8.5.4" class="ltx_td ltx_align_center" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">0.7035</td>
