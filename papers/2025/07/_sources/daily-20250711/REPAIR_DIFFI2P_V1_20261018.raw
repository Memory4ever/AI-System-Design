</span><span id="S4.T1.7.1.3.1.2" class="ltx_text" style="font-size:120%;">   </span></th>
<th id="S4.T1.7.1.3.2" class="ltx_td ltx_nopad_l ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="S4.T1.7.1.3.2.1" class="ltx_text" style="font-size:120%;">34.2</span></th>
<td id="S4.T1.7.1.3.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.7.1.3.3.1" class="ltx_text" style="font-size:120%;">32.8</span></td>
<td id="S4.T1.7.1.3.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.7.1.3.4.1" class="ltx_text" style="font-size:120%;">14.8</span></td>
<td id="S4.T1.7.1.3.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.7.1.3.5.1" class="ltx_text" style="font-size:120%;">26.0</span></td>
<td id="S4.T1.7.1.3.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.7.1.3.6.1" class="ltx_text" style="font-size:120%;">23.3</span></td>
