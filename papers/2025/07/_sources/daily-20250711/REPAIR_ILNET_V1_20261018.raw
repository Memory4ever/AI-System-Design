<th id="S4.T1.8.1.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r" style="padding-top:0.9pt;padding-bottom:0.9pt;">Macformer <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib59" title="" class="ltx_ref">59</a>]</cite></th>
<td id="S4.T1.8.1.7.2" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:0.9pt;padding-bottom:0.9pt;">RAL 2023</td>
