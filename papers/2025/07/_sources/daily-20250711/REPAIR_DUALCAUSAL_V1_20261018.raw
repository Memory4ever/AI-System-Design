<tr id="S3.T1.2.1.3" class="ltx_tr">
<td id="S3.T1.2.1.3.1" class="ltx_td ltx_align_left ltx_border_tt" style="--ltx-bg-color:#F5F5F5;padding-top:-1pt;padding-bottom:-1pt;" colspan="10"><span id="S3.T1.2.1.3.1.1" class="ltx_text ltx_font_italic">Methods without pretrained VLMs</span></td></tr>
<tr id="S3.T1.2.1.4" class="ltx_tr">
<td id="S3.T1.2.1.4.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:-1pt;padding-bottom:-1pt;">I3D <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib3" title="" class="ltx_ref">Carreira and Zisserman, 2017</a>)</cite></td>
