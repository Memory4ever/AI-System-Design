<td id="S3.T1.2.1.1.3" class="ltx_td ltx_align_right ltx_border_tt" style="padding-top:-1pt;padding-bottom:-1pt;" rowspan="2"><span id="S3.T1.2.1.1.3.1" class="ltx_text">Pre-training</span></td>
