<th id="S4.T1.1.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><math id="S4.T1.m2" class="ltx_Math" alttext="\text{FFN}_{\text{Down}}" display="inline" intent=":literal"><semantics><msub><mtext>FFN</mtext><mtext>Down</mtext></msub><annotation encoding="application/x-tex">\text{FFN}_{\text{Down}}</annotation></semantics></math></th>
