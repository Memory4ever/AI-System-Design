<tr id="S4.T2.1.1.2" class="ltx_tr">
<td id="S4.T2.1.1.2.1" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.1.1.2.1.1" class="ltx_text ltx_font_bold">GPT-Large</span></td>
