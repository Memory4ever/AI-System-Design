<td id="S5.T4.2.5.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T4.2.5.4.1" class="ltx_text ltx_font_bold">63.0</span></td></tr>
