<th id="A3.T7.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">15 K</th>
<th id="A3.T7.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">20 K</th>
<th id="A3.T7.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">25 K</th></tr>
</thead>
