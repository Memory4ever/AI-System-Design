<tr id="S5.T3.2.5" class="ltx_tr">
<th id="S5.T3.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r" style="padding-left:4.0pt;padding-right:4.0pt;">+ Self-Reflection</th>
<td id="S5.T3.2.5.2" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;">64.4</td>
