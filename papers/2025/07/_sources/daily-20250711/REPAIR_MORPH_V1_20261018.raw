<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Full Statistical Results</h2>

<div id="A3.p1" class="ltx_para">
<p id="A3.p1.1" class="ltx_p">Tables <a href="#A3.T8" title="Table 8 ‣ Appendix C Full Statistical Results ‣ Evaluating Morphological Alignment of Tokenizers in 70 Languages" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a> and <a href="#A3.T9" title="Table 9 ‣ Appendix C Full Statistical Results ‣ Evaluating Morphological Alignment of Tokenizers in 70 Languages" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a> report the results of the linear mixed effects models described in Section <a href="#S4" title="4 Correlation with Language Model Performance ‣ Evaluating Morphological Alignment of Tokenizers in 70 Languages" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>.</p>
</div>
<figure id="A3.T8" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 8: </span>Precision</figcaption>
<table id="A3.T8.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="A3.T8.2.1" class="ltx_tr">
<th id="A3.T8.2.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="A3.T8.2.1.1.1" class="ltx_text ltx_font_bold">Variable</span></th>
<th id="A3.T8.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A3.T8.2.1.2.1" class="ltx_text ltx_font_bold">Coef.</span></th>
<th id="A3.T8.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A3.T8.2.1.3.1" class="ltx_text ltx_font_bold">Std. Err.</span></th>
<th id="A3.T8.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A3.T8.2.1.4.1" class="ltx_text ltx_font_bold">z</span></th>
<th id="A3.T8.2.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A3.T8.2.1.5.1" class="ltx_text ltx_font_bold">p-value</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A3.T8.2.2" class="ltx_tr">
<th id="A3.T8.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Intercept</th>
<td id="A3.T8.2.2.2" class="ltx_td ltx_align_center ltx_border_t">0.169</td>
