<th id="T1.5.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:0.75pt;padding-bottom:0.75pt;"><math id="T1.m12" class="ltx_Math" alttext="I_{ij}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">I_{ij}</annotation></semantics></math></th>
<td id="T1.5.7.2" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-top:0.75pt;padding-bottom:0.75pt;">
