<th id="T1.5.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding-top:0.75pt;padding-bottom:0.75pt;"><math id="T1.m21" class="ltx_Math" alttext="U_{j}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>j</mi></msub><annotation encoding="application/x-tex">U_{j}</annotation></semantics></math></th>
<td id="T1.5.9.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_bb" style="padding-top:0.75pt;padding-bottom:0.75pt;">
<span id="T1.5.9.2.1" class="ltx_inline-block ltx_align_top">
<span id="T1.5.9.2.1.1" class="ltx_p">Switches <math id="T1.m22" class="ltx_Math" alttext="B_{j}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>j</mi></msub><annotation encoding="application/x-tex">B_{j}</annotation></semantics></math> with the corresponding probability, otherwise leaves it unchanged.</span>
</span></td></tr>
