<span id="T1.5.7.2.1.1" class="ltx_p">Contradiction if <math id="T1.m13" class="ltx_Math" alttext="B_{i}\neq B_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>i</mi></msub><mo>≠</mo><msub><mi>B</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">B_{i}\neq B_{j}</annotation></semantics></math>.</span>
</span></td></tr>
