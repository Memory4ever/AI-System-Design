<span id="T1.5.6.2.1.1" class="ltx_p">Message containing <math id="T1.m11" class="ltx_Math" alttext="B_{i}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>i</mi></msub><annotation encoding="application/x-tex">B_{i}</annotation></semantics></math>.</span>
</span></td></tr>
