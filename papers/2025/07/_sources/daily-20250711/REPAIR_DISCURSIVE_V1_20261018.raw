<th id="T1.5.1.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_th ltx_th_column ltx_border_tt" style="padding-top:0.75pt;padding-bottom:0.75pt;">
<span id="T1.5.1.2.1" class="ltx_inline-block ltx_align_top">
<span id="T1.5.1.2.1.1" class="ltx_p"><span id="T1.5.1.2.1.1.1" class="ltx_text ltx_font_bold">Instantiation in single-network model</span></span>
</span></th></tr>
</thead>
<tbody class="ltx_tbody">
