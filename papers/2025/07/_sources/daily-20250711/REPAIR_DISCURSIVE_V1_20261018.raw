<th id="T2.7.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:0.75pt;padding-bottom:0.75pt;"><math id="T2.m20" class="ltx_Math" alttext="P_{ij}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">P_{ij}</annotation></semantics></math></th>
<td id="T2.7.8.2" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-top:0.75pt;padding-bottom:0.75pt;">
<span id="T2.7.8.2.1" class="ltx_inline-block ltx_align_top">
<span id="T2.7.8.2.1.1" class="ltx_p">Spontaneous flips: <math id="T2.m21" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> for <math id="T2.m22" class="ltx_Math" alttext="r\!\to\!f" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo lspace="0.108em" rspace="0.108em" stretchy="false">→</mo><mi>f</mi></mrow><annotation encoding="application/x-tex">r\!\to\!f</annotation></semantics></math> (appears in <math id="T2.m23" class="ltx_Math" alttext="Z(t)" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z(t)</annotation></semantics></math>), <math id="T2.m24" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> for <math id="T2.m25" class="ltx_Math" alttext="f\!\to\!r" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.108em" rspace="0.108em" stretchy="false">→</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">f\!\to\!r</annotation></semantics></math> (appears in <math id="T2.m26" class="ltx_Math" alttext="W(t)" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">W(t)</annotation></semantics></math>).</span>
</span></td></tr>
<tr id="T2.7.9" class="ltx_tr">
<th id="T2.7.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:0.75pt;padding-bottom:0.75pt;"><math id="T2.m27" class="ltx_Math" alttext="U_{j}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>j</mi></msub><annotation encoding="application/x-tex">U_{j}</annotation></semantics></math></th>
<td id="T2.7.9.2" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-top:0.75pt;padding-bottom:0.75pt;">
<span id="T2.7.9.2.1" class="ltx_inline-block ltx_align_top">
<span id="T2.7.9.2.1.1" class="ltx_p">Update rule applying the three hazards:</span>
</span></td></tr>
<tr id="T2.7.10" class="ltx_tr">
<th id="T2.7.10.1" class="ltx_td ltx_th ltx_th_row" style="padding-top:0.75pt;padding-bottom:0.75pt;"></th>
<td id="T2.7.10.2" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-top:0.75pt;padding-bottom:0.75pt;">
<span id="T2.7.10.2.1" class="ltx_inline-block ltx_align_top">
<span id="T2.7.10.2.1.1" class="ltx_p"><math id="T2.m28" class="ltx_Math" alttext="X(t)\sim\mathrm{Poisson}(\lambda T(t))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∼</mo><mrow><mi>Poisson</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X(t)\sim\mathrm{Poisson}(\lambda T(t))</annotation></semantics></math> (fabrications)</span>
</span></td></tr>
<tr id="T2.7.11" class="ltx_tr">
<th id="T2.7.11.1" class="ltx_td ltx_th ltx_th_row" style="padding-top:0.75pt;padding-bottom:0.75pt;"></th>
<td id="T2.7.11.2" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-top:0.75pt;padding-bottom:0.75pt;">
<span id="T2.7.11.2.1" class="ltx_inline-block ltx_align_top">
<span id="T2.7.11.2.1.1" class="ltx_p"><math id="T2.m29" class="ltx_Math" alttext="Z(t)\sim\mathrm{Binomial}(T(t),p)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∼</mo><mrow><mi>Binomial</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Z(t)\sim\mathrm{Binomial}(T(t),p)</annotation></semantics></math> (truth → false)</span>
</span></td></tr>
<tr id="T2.7.12" class="ltx_tr">
<th id="T2.7.12.1" class="ltx_td ltx_th ltx_th_row ltx_border_bb" style="padding-top:0.75pt;padding-bottom:0.75pt;"></th>
<td id="T2.7.12.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_bb" style="padding-top:0.75pt;padding-bottom:0.75pt;">
<span id="T2.7.12.2.1" class="ltx_inline-block ltx_align_top">
<span id="T2.7.12.2.1.1" class="ltx_p"><math id="T2.m30" class="ltx_Math" alttext="W(t)\sim\mathrm{Binomial}(F(t),q)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>W</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∼</mo><mrow><mi>Binomial</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">W(t)\sim\mathrm{Binomial}(F(t),q)</annotation></semantics></math> (false → true)</span>
</span></td></tr>
</tbody>
</table>
</figure>
<div id="S2.Thmlemma2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmlemma2.2" class="ltx_text ltx_font_bold">Lemma 2.2</span></span><span id="S2.Thmlemma2.3" class="ltx_text ltx_font_bold"> </span>(Single-network invalidation with fabrication)<span id="S2.Thmlemma2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmlemma2.p1" class="ltx_para">
<p id="S2.Thmlemma2.p1.1" class="ltx_p">Let the single-network proportion state evolve according to</p>
<table id="S2.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex12.m1" class="ltx_Math" alttext="\boldsymbol{\pi}(t+1)=T_{\lambda}\,\boldsymbol{\pi}(t),\qquad T_{\lambda}=\begin{pmatrix}1-(p+\lambda)&amp;q\\
p+\lambda&amp;1-q\end{pmatrix},\qquad\boldsymbol{\pi}(t)=\begin{pmatrix}\pi_{r}(t)\\[2.0pt]
\pi_{f}(t)\end{pmatrix},\;\pi_{r}(t)+\pi_{f}(t)=1," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝝅</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>T</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝝅</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>T</mi><mi>λ</mi></msub><mo>=</mo><mrow><mo>(</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>+</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mi>q</mi></mtd></mtr><mtr><mtd><mrow><mi>p</mi><mo>+</mo><mi>λ</mi></mrow></mtd><mtd><mrow><mn>1</mn><mo>−</mo><mi>q</mi></mrow></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>𝝅</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><msub><mi>π</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><msub><mi>π</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo rspace="0.447em">,</mo><mrow><mrow><mrow><msub><mi>π</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>π</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>1</mn></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\boldsymbol{\pi}(t+1)=T_{\lambda}\,\boldsymbol{\pi}(t),\qquad T_{\lambda}=\begin{pmatrix}1-(p+\lambda)&amp;q\\
p+\lambda&amp;1-q\end{pmatrix},\qquad\boldsymbol{\pi}(t)=\begin{pmatrix}\pi_{r}(t)\\[2.0pt]
\pi_{f}(t)\end{pmatrix},\;\pi_{r}(t)+\pi_{f}(t)=1,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.Thmlemma2.p1.2" class="ltx_p">where
<math id="S2.Thmlemma2.p1.m1" class="ltx_Math" alttext="p,q\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p,q\in(0,1)</annotation></semantics></math> are the intrinsic flip probabilities,
<math id="S2.Thmlemma2.p1.m2" class="ltx_Math" alttext="\lambda\in\bigl(0,1-p\bigr)" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>∈</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mn>0</mn><mo>,</mo><mrow><mn>1</mn><mo>−</mo><mi>p</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda\in\bigl(0,1-p\bigr)</annotation></semantics></math> is the per-statement fabrication probability
(<math id="S2.Thmlemma2.p1.m3" class="ltx_Math" alttext="r\!\to\!f" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo lspace="0.108em" rspace="0.108em" stretchy="false">→</mo><mi>f</mi></mrow><annotation encoding="application/x-tex">r\!\to\!f</annotation></semantics></math>), and <math id="S2.Thmlemma2.p1.m4" class="ltx_Math" alttext="p+\lambda+q&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>+</mo><mi>λ</mi><mo>+</mo><mi>q</mi></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p+\lambda+q&lt;1</annotation></semantics></math>.
Then:</p>
</div>
<div id="S2.Thmlemma2.p2" class="ltx_para">
<p id="S2.Thmlemma2.p2.1" class="ltx_p">1. The system has a unique fixed point</p>
<table id="S2.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex13.m1" class="ltx_Math" alttext="\boldsymbol{\pi}^{*}=\begin{pmatrix}\dfrac{q}{p+\lambda+q}\\[6.0pt]
\dfrac{p+\lambda}{p+\lambda+q}\end{pmatrix}." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>𝝅</mi><mo>∗</mo></msup><mo>=</mo><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><mfrac><mi>q</mi><mrow><mi>p</mi><mo>+</mo><mi>λ</mi><mo>+</mo><mi>q</mi></mrow></mfrac></mtd></mtr><mtr><mtd><mfrac><mrow><mi>p</mi><mo>+</mo><mi>λ</mi></mrow><mrow><mi>p</mi><mo>+</mo><mi>λ</mi><mo>+</mo><mi>q</mi></mrow></mfrac></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\boldsymbol{\pi}^{*}=\begin{pmatrix}\dfrac{q}{p+\lambda+q}\\[6.0pt]
\dfrac{p+\lambda}{p+\lambda+q}\end{pmatrix}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S2.Thmlemma2.p3" class="ltx_para">
<p id="S2.Thmlemma2.p3.1" class="ltx_p">2. The second eigenvalue of <math id="S2.Thmlemma2.p3.m1" class="ltx_Math" alttext="T_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">T_{\lambda}</annotation></semantics></math> is <math id="S2.Thmlemma2.p3.m2" class="ltx_Math" alttext="1-(p+\lambda+q)" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>+</mo><mi>λ</mi><mo>+</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">1-(p+\lambda+q)</annotation></semantics></math>, whose
modulus is strictly smaller than <math id="S2.Thmlemma2.p3.m3" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>; hence the Markov chain converges
geometrically to <math id="S2.Thmlemma2.p3.m4" class="ltx_Math" alttext="\boldsymbol{\pi}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝝅</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\boldsymbol{\pi}^{*}</annotation></semantics></math> from any initial distribution.</p>
</div>
</div>
<div id="S2.SS3.SSS2.Px5.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.SS3.SSS2.Px5.p3" class="ltx_para">
<p id="S2.SS3.SSS2.Px5.p3.1" class="ltx_p"><span id="S2.SS3.SSS2.Px5.p3.1.1" class="ltx_text">A fixed point satisfies <math id="S2.SS3.SSS2.Px5.p3.m1" class="ltx_Math" alttext="\boldsymbol{\pi}=T_{\lambda}\,\boldsymbol{\pi}" display="inline" intent=":literal"><semantics><mrow><mi>𝝅</mi><mo>=</mo><mrow><msub><mi>T</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝝅</mi></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\pi}=T_{\lambda}\,\boldsymbol{\pi}</annotation></semantics></math>.
Writing <math id="S2.SS3.SSS2.Px5.p3.m2" class="ltx_Math" alttext="\boldsymbol{\pi}^{\mathsf{T}}=(\pi_{r},\pi_{f})" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝝅</mi><mi>𝖳</mi></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>r</mi></msub><mo>,</mo><msub><mi>π</mi><mi>f</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\pi}^{\mathsf{T}}=(\pi_{r},\pi_{f})</annotation></semantics></math> and expanding gives</span></p>
<table id="S2.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex14.m1" class="ltx_Math" alttext="\displaystyle\pi_{r}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>r</mi></msub><annotation encoding="application/x-tex">\displaystyle\pi_{r}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex14.m2" class="ltx_Math" alttext="\displaystyle=(1-p-\lambda)\,\pi_{r}+q\,\pi_{f}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>p</mi><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>π</mi><mi>r</mi></msub></mrow><mo>+</mo><mrow><mi>q</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>π</mi><mi>f</mi></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=(1-p-\lambda)\,\pi_{r}+q\,\pi_{f},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex15.m1" class="ltx_Math" alttext="\displaystyle\pi_{f}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>f</mi></msub><annotation encoding="application/x-tex">\displaystyle\pi_{f}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex15.m2" class="ltx_Math" alttext="\displaystyle=(p+\lambda)\,\pi_{r}+(1-q)\,\pi_{f}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>+</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>π</mi><mi>r</mi></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>π</mi><mi>f</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=(p+\lambda)\,\pi_{r}+(1-q)\,\pi_{f}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS3.SSS2.Px5.p3.2" class="ltx_p"><span id="S2.SS3.SSS2.Px5.p3.2.1" class="ltx_text">Because <math id="S2.SS3.SSS2.Px5.p3.m3" class="ltx_Math" alttext="\pi_{f}=1-\pi_{r}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>f</mi></msub><mo>=</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>π</mi><mi>r</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\pi_{f}=1-\pi_{r}</annotation></semantics></math>, the first line reduces to
<math id="S2.SS3.SSS2.Px5.p3.m4" class="ltx_Math" alttext="(p+\lambda)\,\pi_{r}=q\,(1-\pi_{r})," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>+</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>π</mi><mi>r</mi></msub></mrow><mo>=</mo><mrow><mi>q</mi><mo lspace="0.170em">⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>π</mi><mi>r</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">(p+\lambda)\,\pi_{r}=q\,(1-\pi_{r}),</annotation></semantics></math>
which yields the fixed point in the statement.
The characteristic polynomial of <math id="S2.SS3.SSS2.Px5.p3.m5" class="ltx_Math" alttext="T_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">T_{\lambda}</annotation></semantics></math> is
<math id="S2.SS3.SSS2.Px5.p3.m6" class="ltx_Math" alttext="\lambda^{2}-(2-p-\lambda-q)\lambda+(1-p-\lambda-q)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>λ</mi><mn>2</mn></msup><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>−</mo><mi>p</mi><mo>−</mo><mi>λ</mi><mo>−</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>p</mi><mo>−</mo><mi>λ</mi><mo>−</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda^{2}-(2-p-\lambda-q)\lambda+(1-p-\lambda-q)=0</annotation></semantics></math>,
with roots <math id="S2.SS3.SSS2.Px5.p3.m7" class="ltx_Math" alttext="\lambda_{1}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\lambda_{1}=1</annotation></semantics></math> and
<math id="S2.SS3.SSS2.Px5.p3.m8" class="ltx_Math" alttext="\lambda_{2}=1-(p+\lambda+q)" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mn>2</mn></msub><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>+</mo><mi>λ</mi><mo>+</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{2}=1-(p+\lambda+q)</annotation></semantics></math>.
Since <math id="S2.SS3.SSS2.Px5.p3.m9" class="ltx_Math" alttext="p+\lambda+q&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>+</mo><mi>λ</mi><mo>+</mo><mi>q</mi></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p+\lambda+q&lt;1</annotation></semantics></math>, we have <math id="S2.SS3.SSS2.Px5.p3.m10" class="ltx_Math" alttext="|\lambda_{2}|&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">|\lambda_{2}|&lt;1</annotation></semantics></math>; therefore
<math id="S2.SS3.SSS2.Px5.p3.m11" class="ltx_Math" alttext="T_{\lambda}^{\,t}\to\boldsymbol{\pi}^{*}\mathbf{1}^{\mathsf{T}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>T</mi><mi>λ</mi><mi>t</mi></msubsup><mo stretchy="false">→</mo><mrow><msup><mi>𝝅</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>𝟏</mn><mi>𝖳</mi></msup></mrow></mrow><annotation encoding="application/x-tex">T_{\lambda}^{\,t}\to\boldsymbol{\pi}^{*}\mathbf{1}^{\mathsf{T}}</annotation></semantics></math> as
<math id="S2.SS3.SSS2.Px5.p3.m12" class="ltx_Math" alttext="t\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">t\to\infty</annotation></semantics></math>, so every trajectory converges to <math id="S2.SS3.SSS2.Px5.p3.m13" class="ltx_Math" alttext="\boldsymbol{\pi}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝝅</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\boldsymbol{\pi}^{*}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="S2.SS3.SSS2.Px6" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Interpretation.</h5>

<div id="S2.SS3.SSS2.Px6.p1" class="ltx_para">
<p id="S2.SS3.SSS2.Px6.p1.1" class="ltx_p">The fabrication term <math id="S2.SS3.SSS2.Px6.p1.m1" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> simply augments the ordinary truth-to-false
hazard <math id="S2.SS3.SSS2.Px6.p1.m2" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>. Consequently the equilibrium share of false believers rises
from <math id="S2.SS3.SSS2.Px6.p1.m3" class="ltx_Math" alttext="p/(p+q)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>+</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p/(p+q)</annotation></semantics></math> (when <math id="S2.SS3.SSS2.Px6.p1.m4" class="ltx_Math" alttext="\lambda=0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda=0</annotation></semantics></math>) to <math id="S2.SS3.SSS2.Px6.p1.m5" class="ltx_Math" alttext="(p+\lambda)/(p+\lambda+q)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>+</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>+</mo><mi>λ</mi><mo>+</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(p+\lambda)/(p+\lambda+q)</annotation></semantics></math>, while
the speed of convergence slows as the spectral gap
<math id="S2.SS3.SSS2.Px6.p1.m6" class="ltx_Math" alttext="1-\lvert 1-(p+\lambda+q)\rvert" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">|</mo><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>+</mo><mi>λ</mi><mo>+</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">1-\lvert 1-(p+\lambda+q)\rvert</annotation></semantics></math> narrows.
Fabrication raises the inflow into the false state
by <math id="S2.SS3.SSS2.Px6.p1.m7" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>, while internal invalidation <math id="S2.SS3.SSS2.Px6.p1.m8" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> is unchanged. If <math id="S2.SS3.SSS2.Px6.p1.m9" class="ltx_Math" alttext="\lambda&gt;q" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>&gt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">\lambda&gt;q</annotation></semantics></math> the
system becomes “invalidation-dominant,” mimicking an LLM that generates more new errors than it self-repairs, an empirical regime reported in LLMs (cf. Section <a href="#S3" title="3 Results ‣ The Flaws of Others: An LLM-driven Framework for Scientific Knowledge Production" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>).</p>
</div>
</section>
</section>
<section id="S2.SS3.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">2.3.3 </span>Cross-Network Invalidation-Detection Model</h4>

<div id="S2.SS3.SSS3.p1" class="ltx_para">
<p id="S2.SS3.SSS3.p1.1" class="ltx_p">Now that we have studied single networks with and without spontaneous invalidaiton emergence, the next natural question is how to reduce invalidations. As we will see, using multiple discursive networks reduces invalidations.</p>
</div>
<div id="S2.SS3.SSS3.p2" class="ltx_para">
<p id="S2.SS3.SSS3.p2.1" class="ltx_p">Let the two discursive networks be
<math id="S2.SS3.SSS3.p2.m1" class="ltx_Math" alttext="N_{1}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mn>1</mn></msub><annotation encoding="application/x-tex">N_{1}</annotation></semantics></math> and <math id="S2.SS3.SSS3.p2.m2" class="ltx_Math" alttext="N_{2}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mn>2</mn></msub><annotation encoding="application/x-tex">N_{2}</annotation></semantics></math> with actor sets
<math id="S2.SS3.SSS3.p2.m3" class="ltx_Math" alttext="A_{1}=\{a_{11},\dots,a_{1n_{1}}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mn>1</mn></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>a</mi><mn>11</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mn>1</mn></msub></mrow></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">A_{1}=\{a_{11},\dots,a_{1n_{1}}\}</annotation></semantics></math> and
<math id="S2.SS3.SSS3.p2.m4" class="ltx_Math" alttext="A_{2}=\{a_{21},\dots,a_{2n_{2}}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mn>2</mn></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>a</mi><mn>21</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mn>2</mn></msub></mrow></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">A_{2}=\{a_{21},\dots,a_{2n_{2}}\}</annotation></semantics></math>; write <math id="S2.SS3.SSS3.p2.m5" class="ltx_Math" alttext="n_{k}=|A_{k}|" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mi>k</mi></msub><mo>=</mo><mrow><mo stretchy="false">|</mo><msub><mi>A</mi><mi>k</mi></msub><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">n_{k}=|A_{k}|</annotation></semantics></math>.</p>
</div>
<div id="S2.Thmdefinition4" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmdefinition4.2" class="ltx_text ltx_font_bold">Definition 2.4</span></span><span id="S2.Thmdefinition4.3" class="ltx_text ltx_font_bold"> </span>(Normalised state)<span id="S2.Thmdefinition4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmdefinition4.p1" class="ltx_para">
<p id="S2.Thmdefinition4.p1.1" class="ltx_p">For each network <math id="S2.Thmdefinition4.p1.m1" class="ltx_Math" alttext="N_{k}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>k</mi></msub><annotation encoding="application/x-tex">N_{k}</annotation></semantics></math> the proportion state at time <math id="S2.Thmdefinition4.p1.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> is</p>
<table id="S2.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex16.m1" class="ltx_Math" alttext="\boldsymbol{\pi}_{k}(t)=\bigl(\pi_{T,k}(t),\;\pi_{F,k}(t)\bigr),\qquad\pi_{T,k}(t)=\frac{T_{k}(t)}{n_{k}},\;\pi_{F,k}(t)=\frac{F_{k}(t)}{n_{k}},\;\pi_{T,k}(t)+\pi_{F,k}(t)=1," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>𝝅</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>π</mi><mrow><mi>T</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.447em">,</mo><mrow><msub><mi>π</mi><mrow><mi>F</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><msub><mi>π</mi><mrow><mi>T</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><msub><mi>T</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><msub><mi>n</mi><mi>k</mi></msub></mfrac></mrow><mo rspace="0.447em">,</mo><mrow><mrow><msub><mi>π</mi><mrow><mi>F</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><msub><mi>F</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><msub><mi>n</mi><mi>k</mi></msub></mfrac></mrow><mo rspace="0.447em">,</mo><mrow><mrow><mrow><msub><mi>π</mi><mrow><mi>T</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>π</mi><mrow><mi>F</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>1</mn></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\boldsymbol{\pi}_{k}(t)=\bigl(\pi_{T,k}(t),\;\pi_{F,k}(t)\bigr),\qquad\pi_{T,k}(t)=\frac{T_{k}(t)}{n_{k}},\;\pi_{F,k}(t)=\frac{F_{k}(t)}{n_{k}},\;\pi_{T,k}(t)+\pi_{F,k}(t)=1,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.Thmdefinition4.p1.2" class="ltx_p">where <math id="S2.Thmdefinition4.p1.m3" class="ltx_Math" alttext="T_{k}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T_{k}(t)</annotation></semantics></math> and <math id="S2.Thmdefinition4.p1.m4" class="ltx_Math" alttext="F_{k}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>F</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F_{k}(t)</annotation></semantics></math> are the counts of true and false
statements, respectively.</p>
</div>
</div>
<section id="S2.SS3.SSS3.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Stochastic primitives.</h5>

<div id="S2.SS3.SSS3.Px1.p1" class="ltx_para">
<p id="S2.SS3.SSS3.Px1.p1.1" class="ltx_p">All events are now specified so that their <em id="S2.SS3.SSS3.Px1.p1.1.1" class="ltx_emph ltx_font_italic">rates are comparable across networks regardless of size</em>. In particular, fabrication is scaled by the 
<br class="ltx_break">emphcurrent stock of true statements.</p>
</div>
</section>
<section id="S2.SS3.SSS3.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Falsehood generation (fabrication).</h5>

<div id="S2.SS3.SSS3.Px2.p1" class="ltx_para">
<p id="S2.SS3.SSS3.Px2.p1.1" class="ltx_p">Each currently true statement in <math id="S2.SS3.SSS3.Px2.p1.m1" class="ltx_Math" alttext="N_{k}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>k</mi></msub><annotation encoding="application/x-tex">N_{k}</annotation></semantics></math> is independently falsified during <math id="S2.SS3.SSS3.Px2.p1.m2" class="ltx_math_unparsed" alttext="[t,t+1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>t</mi><mo>,</mo><mi>t</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">[t,t+1)</annotation></semantics></math>.
The total number of such events is</p>
<table id="S2.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex17.m1" class="ltx_Math" alttext="X_{k}(t)\;\sim\;\text{Poisson}\bigl(\lambda_{k}\,T_{k}(t)\bigr)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>X</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">∼</mo><mrow><mtext>Poisson</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">X_{k}(t)\;\sim\;\text{Poisson}\bigl(\lambda_{k}\,T_{k}(t)\bigr),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS3.SSS3.Px2.p1.2" class="ltx_p">where <math id="S2.SS3.SSS3.Px2.p1.m3" class="ltx_Math" alttext="\lambda_{k}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\lambda_{k}</annotation></semantics></math> is the <em id="S2.SS3.SSS3.Px2.p1.2.1" class="ltx_emph ltx_font_italic">per-statement</em> fabrication hazard.</p>
</div>
</section>
<section id="S2.SS3.SSS3.Px3" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Cross-network detection.</h5>

<div id="S2.SS3.SSS3.Px3.p1" class="ltx_para">
<p id="S2.SS3.SSS3.Px3.p1.1" class="ltx_p">Each false statement in <math id="S2.SS3.SSS3.Px3.p1.m1" class="ltx_Math" alttext="N_{k}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>k</mi></msub><annotation encoding="application/x-tex">N_{k}</annotation></semantics></math> is noticed by <math id="S2.SS3.SSS3.Px3.p1.m2" class="ltx_Math" alttext="N_{j}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>j</mi></msub><annotation encoding="application/x-tex">N_{j}</annotation></semantics></math> with probability <math id="S2.SS3.SSS3.Px3.p1.m3" class="ltx_Math" alttext="d_{jk}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">d_{jk}</annotation></semantics></math>, so
<math id="S2.SS3.SSS3.Px3.p1.m4" class="ltx_Math" alttext="Y_{jk}(t)\sim\mathrm{Binomial}\!\bigl(F_{k}(t),d_{jk}\bigr)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>Y</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∼</mo><mrow><mpadded style="width:4.137em;" width="4.137em"><mi>Binomial</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>F</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>d</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Y_{jk}(t)\sim\mathrm{Binomial}\!\bigl(F_{k}(t),d_{jk}\bigr).</annotation></semantics></math></p>
</div>
</section>
<section id="S2.SS3.SSS3.Px4" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Internal flips.</h5>

<div id="S2.SS3.SSS3.Px4.p1" class="ltx_para">
<p id="S2.SS3.SSS3.Px4.p1.1" class="ltx_p">True statements spontaneously become false with probability <math id="S2.SS3.SSS3.Px4.p1.m1" class="ltx_Math" alttext="p_{k}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>k</mi></msub><annotation encoding="application/x-tex">p_{k}</annotation></semantics></math>, and false statements self-correct with probability <math id="S2.SS3.SSS3.Px4.p1.m2" class="ltx_Math" alttext="q_{k}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi>k</mi></msub><annotation encoding="application/x-tex">q_{k}</annotation></semantics></math>:</p>
<table id="S2.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex18.m1" class="ltx_Math" alttext="Z_{k}(t)\sim\mathrm{Binomial}\!\bigl(T_{k}(t),p_{k}\bigr),\quad W_{k}(t)\sim\mathrm{Binomial}\!\bigl(F_{k}(t),q_{k}\bigr)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>Z</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∼</mo><mrow><mpadded style="width:4.137em;" width="4.137em"><mi>Binomial</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>T</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>p</mi><mi>k</mi></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><msub><mi>W</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∼</mo><mrow><mpadded style="width:4.137em;" width="4.137em"><mi>Binomial</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>F</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>q</mi><mi>k</mi></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Z_{k}(t)\sim\mathrm{Binomial}\!\bigl(T_{k}(t),p_{k}\bigr),\quad W_{k}(t)\sim\mathrm{Binomial}\!\bigl(F_{k}(t),q_{k}\bigr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="S2.SS3.SSS3.Px5" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Normalised update equations.</h5>

<div id="S2.SS3.SSS3.Px5.p1" class="ltx_para">
<p id="S2.SS3.SSS3.Px5.p1.1" class="ltx_p">Let <math id="S2.SS3.SSS3.Px5.p1.m1" class="ltx_Math" alttext="\Delta T_{k}(t)=-Z_{k}(t)+W_{k}(t)" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo>−</mo><mrow><msub><mi>Z</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>W</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta T_{k}(t)=-Z_{k}(t)+W_{k}(t)</annotation></semantics></math> and
<math id="S2.SS3.SSS3.Px5.p1.m2" class="ltx_Math" alttext="\Delta F_{k}(t)=X_{k}(t)+Z_{k}(t)-W_{k}(t)-Y_{jk}(t)" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><msub><mi>X</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>Z</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>W</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>Y</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta F_{k}(t)=X_{k}(t)+Z_{k}(t)-W_{k}(t)-Y_{jk}(t)</annotation></semantics></math>.
Dividing by <math id="S2.SS3.SSS3.Px5.p1.m3" class="ltx_Math" alttext="n_{k}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mi>k</mi></msub><annotation encoding="application/x-tex">n_{k}</annotation></semantics></math> gives the proportion dynamics</p>
<table id="S2.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.E5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.E5.m1" class="ltx_Math" alttext="\displaystyle\pi_{T,k}(t+1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mrow><mi>T</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\pi_{T,k}(t+1)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E5.m2" class="ltx_Math" alttext="\displaystyle=\pi_{T,k}(t)+\frac{\Delta T_{k}(t)}{n_{k}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>π</mi><mrow><mi>T</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><msub><mi>n</mi><mi>k</mi></msub></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\pi_{T,k}(t)+\frac{\Delta T_{k}(t)}{n_{k}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5)</span></td></tr></tbody>
<tbody id="S2.E6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.E6.m1" class="ltx_Math" alttext="\displaystyle\pi_{F,k}(t+1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mrow><mi>F</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\pi_{F,k}(t+1)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E6.m2" class="ltx_Math" alttext="\displaystyle=\pi_{F,k}(t)+\frac{\Delta F_{k}(t)}{n_{k}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>π</mi><mrow><mi>F</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><msub><mi>n</mi><mi>k</mi></msub></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\pi_{F,k}(t)+\frac{\Delta F_{k}(t)}{n_{k}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6)</span></td></tr></tbody>
</table>
<p id="S2.SS3.SSS3.Px5.p1.2" class="ltx_p">with <math id="S2.SS3.SSS3.Px5.p1.m4" class="ltx_Math" alttext="\pi_{T,k}(t+1)+\pi_{F,k}(t+1)=1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>π</mi><mrow><mi>T</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>π</mi><mrow><mi>F</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\pi_{T,k}(t+1)+\pi_{F,k}(t+1)=1</annotation></semantics></math> preserved automatically.</p>
</div>
<div id="S2.SS3.SSS3.Px5.p2" class="ltx_para">
<p id="S2.SS3.SSS3.Px5.p2.1" class="ltx_p">The mapping of this model to Definition <a href="#S2.Thmdefinition2" title="Definition 2.2. ‣ 2.2 Discursive Network Formalization ‣ 2 Methods ‣ The Flaws of Others: An LLM-driven Framework for Scientific Knowledge Production" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.2</span></a> is provided in Table <a href="#T3" title="Table 3 ‣ Normalised update equations. ‣ 2.3.3 Cross-Network Invalidation-Detection Model ‣ 2.3 Modeling Discursive Networks ‣ 2 Methods ‣ The Flaws of Others: An LLM-driven Framework for Scientific Knowledge Production" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>.</p>
</div>
<figure id="T3" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="T3.5" class="ltx_text" style="font-size:90%;">Table 3</span>: </span><span id="T3.6" class="ltx_text" style="font-size:90%;">Mapping of discursive-network elements to the <em id="T3.6.1" class="ltx_emph ltx_font_italic">cross-network
invalidation-detection</em> model. All hazard rates are <em id="T3.6.2" class="ltx_emph ltx_font_italic">per statement</em>.</span></figcaption>
<table id="T3.7" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="T3.7.1" class="ltx_tr">
<th id="T3.7.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt" style="padding-top:0.75pt;padding-bottom:0.75pt;"><span id="T3.7.1.1.1" class="ltx_text ltx_font_bold">Element in <math id="T3.m1" class="ltx_Math" alttext="N_{1}\cup N_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mn>1</mn></msub><mo>∪</mo><msub><mi>N</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">N_{1}\cup N_{2}</annotation></semantics></math></span></th>
<th id="T3.7.1.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_th ltx_th_column ltx_border_tt" style="padding-top:0.75pt;padding-bottom:0.75pt;">
<span id="T3.7.1.2.1" class="ltx_inline-block ltx_align_top">
<span id="T3.7.1.2.1.1" class="ltx_p"><span id="T3.7.1.2.1.1.1" class="ltx_text ltx_font_bold">Instantiation in the model</span></span>
</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="T3.7.2" class="ltx_tr">
<th id="T3.7.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-bottom: 2.0pt;padding-top:0.75pt;padding-bottom:0.75pt;"><math id="T3.m2" class="ltx_Math" alttext="A_{k}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>k</mi></msub><annotation encoding="application/x-tex">A_{k}</annotation></semantics></math></th>
<td id="T3.7.2.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t" style="padding-bottom: 2.0pt;padding-top:0.75pt;padding-bottom:0.75pt;">
<span id="T3.7.2.2.1" class="ltx_inline-block ltx_align_top">
<span id="T3.7.2.2.1.1" class="ltx_p">Two disjoint actor sets <math id="T3.m3" class="ltx_Math" alttext="A_{1},A_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mn>1</mn></msub><mo>,</mo><msub><mi>A</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">A_{1},A_{2}</annotation></semantics></math>; proportions refer to <math id="T3.m4" class="ltx_Math" alttext="n_{k}=\lvert A_{k}\rvert" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mi>k</mi></msub><mo>=</mo><mrow><mo stretchy="false">|</mo><msub><mi>A</mi><mi>k</mi></msub><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">n_{k}=\lvert A_{k}\rvert</annotation></semantics></math>.</span>
</span></td></tr>
<tr id="T3.7.3" class="ltx_tr">
<th id="T3.7.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-bottom: 2.0pt;padding-top:0.75pt;padding-bottom:0.75pt;"><math id="T3.m5" class="ltx_Math" alttext="S=\{r,f\}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>r</mi><mo>,</mo><mi>f</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">S=\{r,f\}</annotation></semantics></math></th>
<td id="T3.7.3.2" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-bottom: 2.0pt;padding-top:0.75pt;padding-bottom:0.75pt;">
<span id="T3.7.3.2.1" class="ltx_inline-block ltx_align_top">
<span id="T3.7.3.2.1.1" class="ltx_p">Binary statements shared by both networks (<math id="T3.m6" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> = true, <math id="T3.m7" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> = false).</span>
</span></td></tr>
<tr id="T3.7.4" class="ltx_tr">
<th id="T3.7.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-bottom: 2.0pt;padding-top:0.75pt;padding-bottom:0.75pt;"><math id="T3.m8" class="ltx_Math" alttext="B_{ij}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">B_{ij}</annotation></semantics></math></th>
<td id="T3.7.4.2" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-bottom: 2.0pt;padding-top:0.75pt;padding-bottom:0.75pt;">
<span id="T3.7.4.2.1" class="ltx_inline-block ltx_align_top">
<span id="T3.7.4.2.1.1" class="ltx_p">Belief of actor <math id="T3.m9" class="ltx_Math" alttext="a_{ij}\in A_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>∈</mo><msub><mi>A</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">a_{ij}\in A_{k}</annotation></semantics></math>: <math id="T3.m10" class="ltx_Math" alttext="\{r\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>r</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{r\}</annotation></semantics></math> or <math id="T3.m11" class="ltx_Math" alttext="\{f\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>f</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{f\}</annotation></semantics></math>.</span>
</span></td></tr>
<tr id="T3.7.5" class="ltx_tr">
<th id="T3.7.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-bottom: 2.0pt;padding-top:0.75pt;padding-bottom:0.75pt;"><math id="T3.m12" class="ltx_Math" alttext="G_{ij}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">G_{ij}</annotation></semantics></math></th>
<td id="T3.7.5.2" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-bottom: 2.0pt;padding-top:0.75pt;padding-bottom:0.75pt;">
<span id="T3.7.5.2.1" class="ltx_inline-block ltx_align_top">
<span id="T3.7.5.2.1.1" class="ltx_p">Goal: persuade every other actor (within and across networks) to adopt <math id="T3.m13" class="ltx_Math" alttext="B_{ij}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">B_{ij}</annotation></semantics></math>.</span>
</span></td></tr>
<tr id="T3.7.6" class="ltx_tr">
<th id="T3.7.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-bottom: 2.0pt;padding-top:0.75pt;padding-bottom:0.75pt;"><math id="T3.m14" class="ltx_Math" alttext="C_{ij}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">C_{ij}</annotation></semantics></math></th>
<td id="T3.7.6.2" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-bottom: 2.0pt;padding-top:0.75pt;padding-bottom:0.75pt;">
<span id="T3.7.6.2.1" class="ltx_inline-block ltx_align_top">
<span id="T3.7.6.2.1.1" class="ltx_p">Message sent from <math id="T3.m15" class="ltx_Math" alttext="a_{i}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>i</mi></msub><annotation encoding="application/x-tex">a_{i}</annotation></semantics></math> to <math id="T3.m16" class="ltx_Math" alttext="a_{j}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>j</mi></msub><annotation encoding="application/x-tex">a_{j}</annotation></semantics></math> carrying <math id="T3.m17" class="ltx_Math" alttext="B_{ij}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">B_{ij}</annotation></semantics></math>. Communication enables both persuasion and detection.</span>
</span></td></tr>
<tr id="T3.7.7" class="ltx_tr">
<th id="T3.7.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-bottom: 4.0pt;padding-top:0.75pt;padding-bottom:0.75pt;"><math id="T3.m18" class="ltx_Math" alttext="I_{ij}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">I_{ij}</annotation></semantics></math></th>
<td id="T3.7.7.2" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-bottom: 4.0pt;padding-top:0.75pt;padding-bottom:0.75pt;">
<span id="T3.7.7.2.1" class="ltx_inline-block ltx_align_top">
<span id="T3.7.7.2.1.1" class="ltx_p"><span id="T3.7.7.2.1.1.1" class="ltx_text ltx_font_bold">Cross-network invalidation</span>: if <math id="T3.m19" class="ltx_Math" alttext="B_{ij}=\{f\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>f</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">B_{ij}=\{f\}</annotation></semantics></math> and the receiver belongs to the other network, the statement is detected and flipped with probability <math id="T3.m20" class="ltx_Math" alttext="d_{jk}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">d_{jk}</annotation></semantics></math> (realised through the random variable <math id="T3.m21" class="ltx_Math" alttext="Y_{jk}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Y_{jk}(t)</annotation></semantics></math>).</span>
</span></td></tr>
<tr id="T3.7.8" class="ltx_tr">
<th id="T3.7.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-bottom: 6.0pt;padding-top:0.75pt;padding-bottom:0.75pt;"><math id="T3.m22" class="ltx_Math" alttext="P_{ij}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">P_{ij}</annotation></semantics></math></th>
<td id="T3.7.8.2" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-bottom: 6.0pt;padding-top:0.75pt;padding-bottom:0.75pt;">
<span id="T3.7.8.2.1" class="ltx_inline-block ltx_align_top">
<span id="T3.7.8.2.1.1" class="ltx_p"><span id="T3.7.8.2.1.1.1" class="ltx_text ltx_font_bold">Persuasion function</span>. Within each network <math id="T3.m23" class="ltx_Math" alttext="N_{k}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>k</mi></msub><annotation encoding="application/x-tex">N_{k}</annotation></semantics></math> it reduces to constant flip probabilities:
 <math id="T3.m24" class="ltx_Math" alttext="p_{k}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>k</mi></msub><annotation encoding="application/x-tex">p_{k}</annotation></semantics></math> for <math id="T3.m25" class="ltx_Math" alttext="r\!\to\!f" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo lspace="0.108em" rspace="0.108em" stretchy="false">→</mo><mi>f</mi></mrow><annotation encoding="application/x-tex">r\!\to\!f</annotation></semantics></math> (used in <math id="T3.m26" class="ltx_Math" alttext="Z_{k}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z_{k}(t)</annotation></semantics></math>),
 <math id="T3.m27" class="ltx_Math" alttext="q_{k}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi>k</mi></msub><annotation encoding="application/x-tex">q_{k}</annotation></semantics></math> for <math id="T3.m28" class="ltx_Math" alttext="f\!\to\!r" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.108em" rspace="0.108em" stretchy="false">→</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">f\!\to\!r</annotation></semantics></math> (used in <math id="T3.m29" class="ltx_Math" alttext="W_{k}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">W_{k}(t)</annotation></semantics></math>).
Across networks, persuasion acts only via <math id="T3.m30" class="ltx_Math" alttext="I_{ij}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">I_{ij}</annotation></semantics></math> with success probability <math id="T3.m31" class="ltx_Math" alttext="d_{jk}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">d_{jk}</annotation></semantics></math>.</span>
</span></td></tr>
<tr id="T3.7.9" class="ltx_tr">
<th id="T3.7.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding-bottom: 2.0pt;padding-top:0.75pt;padding-bottom:0.75pt;"><math id="T3.m32" class="ltx_Math" alttext="U_{j}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>j</mi></msub><annotation encoding="application/x-tex">U_{j}</annotation></semantics></math></th>
<td id="T3.7.9.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_bb" style="padding-bottom: 2.0pt;padding-top:0.75pt;padding-bottom:0.75pt;">
<span id="T3.7.9.2.1" class="ltx_inline-block ltx_align_top">
<span id="T3.7.9.2.1.1" class="ltx_p"><span id="T3.7.9.2.1.1.1" class="ltx_text ltx_font_bold">Update rule</span> for actor <math id="T3.m33" class="ltx_Math" alttext="a_{j}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>j</mi></msub><annotation encoding="application/x-tex">a_{j}</annotation></semantics></math> that applies in the following order
(i) fabrication <math id="T3.m34" class="ltx_Math" alttext="X_{k}(t)\sim\mathrm{Poisson}(\lambda_{k}T_{k}(t))" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>X</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∼</mo><mrow><mi>Poisson</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X_{k}(t)\sim\mathrm{Poisson}(\lambda_{k}T_{k}(t))</annotation></semantics></math>,
(ii) internal flips <math id="T3.m35" class="ltx_Math" alttext="Z_{k}(t),W_{k}(t)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Z</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>W</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Z_{k}(t),W_{k}(t)</annotation></semantics></math> using <math id="T3.m36" class="ltx_Math" alttext="p_{k},q_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>k</mi></msub><mo>,</mo><msub><mi>q</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">p_{k},q_{k}</annotation></semantics></math>,
(iii) cross-network detection <math id="T3.m37" class="ltx_Math" alttext="Y_{jk}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Y_{jk}(t)</annotation></semantics></math> using <math id="T3.m38" class="ltx_Math" alttext="d_{jk}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">d_{jk}</annotation></semantics></math>. The parameter <math id="T3.m39" class="ltx_Math" alttext="\lambda_{k}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\lambda_{k}</annotation></semantics></math> therefore lives inside <math id="T3.m40" class="ltx_Math" alttext="U_{j}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>j</mi></msub><annotation encoding="application/x-tex">U_{j}</annotation></semantics></math>.</span>
</span></td></tr>
</tbody>
</table>
</figure>
<div id="S2.Thmlemma3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmlemma3.2" class="ltx_text ltx_font_bold">Lemma 2.3</span></span><span id="S2.Thmlemma3.3" class="ltx_text ltx_font_bold"> </span>(Dual-network invalidation propagation)<span id="S2.Thmlemma3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmlemma3.p1" class="ltx_para">
<p id="S2.Thmlemma3.p1.1" class="ltx_p">Let the proportion dynamics of Eqs. (<a href="#S2.E5" title="In Normalised update equations. ‣ 2.3.3 Cross-Network Invalidation-Detection Model ‣ 2.3 Modeling Discursive Networks ‣ 2 Methods ‣ The Flaws of Others: An LLM-driven Framework for Scientific Knowledge Production" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>)-(<a href="#S2.E6" title="In Normalised update equations. ‣ 2.3.3 Cross-Network Invalidation-Detection Model ‣ 2.3 Modeling Discursive Networks ‣ 2 Methods ‣ The Flaws of Others: An LLM-driven Framework for Scientific Knowledge Production" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>) be
driven by parameters
<math id="S2.Thmlemma3.p1.m1" class="ltx_Math" alttext="\lambda_{k},d_{jk},p_{k},q_{k}\in(0,1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo>,</mo><msub><mi>d</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo>,</mo><msub><mi>p</mi><mi>k</mi></msub><mo>,</mo><mrow><msub><mi>q</mi><mi>k</mi></msub><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{k},d_{jk},p_{k},q_{k}\in(0,1)</annotation></semantics></math>.
Assume the per-actor falsehood-generation rate satisfies the consistency
condition</p>
<table id="S2.E7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E7.m1" class="ltx_Math" alttext="\lambda_{k}\;=\;d_{jk}\,\frac{p_{k}}{p_{k}+q_{k}}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0.558em" rspace="0.558em">=</mo><mrow><msub><mi>d</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><msub><mi>p</mi><mi>k</mi></msub><mrow><msub><mi>p</mi><mi>k</mi></msub><mo>+</mo><msub><mi>q</mi><mi>k</mi></msub></mrow></mfrac></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\lambda_{k}\;=\;d_{jk}\,\frac{p_{k}}{p_{k}+q_{k}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7)</span></td></tr></tbody>
</table>
<p id="S2.Thmlemma3.p1.2" class="ltx_p">which guarantees that the expected proportions sum to one.
Then the Markov process has the mean fixed point</p>
<table id="S2.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex19.m1" class="ltx_Math" alttext="\pi_{F,k}^{*}=\frac{\lambda_{k}}{d_{jk}},\qquad\pi_{T,k}^{*}=\frac{\lambda_{k}\,q_{k}}{d_{jk}\,p_{k}},\qquad\pi_{T,k}^{*}+\pi_{F,k}^{*}=1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>π</mi><mrow><mi>F</mi><mo>,</mo><mi>k</mi></mrow><mo>∗</mo></msubsup><mo>=</mo><mfrac><msub><mi>λ</mi><mi>k</mi></msub><msub><mi>d</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub></mfrac></mrow><mo rspace="2.167em">,</mo><mrow><msubsup><mi>π</mi><mrow><mi>T</mi><mo>,</mo><mi>k</mi></mrow><mo>∗</mo></msubsup><mo>=</mo><mfrac><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>q</mi><mi>k</mi></msub></mrow><mrow><msub><mi>d</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>p</mi><mi>k</mi></msub></mrow></mfrac></mrow><mo rspace="2.167em">,</mo><mrow><mrow><msubsup><mi>π</mi><mrow><mi>T</mi><mo>,</mo><mi>k</mi></mrow><mo>∗</mo></msubsup><mo>+</mo><msubsup><mi>π</mi><mrow><mi>F</mi><mo>,</mo><mi>k</mi></mrow><mo>∗</mo></msubsup></mrow><mo>=</mo><mn>1</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\pi_{F,k}^{*}=\frac{\lambda_{k}}{d_{jk}},\qquad\pi_{T,k}^{*}=\frac{\lambda_{k}\,q_{k}}{d_{jk}\,p_{k}},\qquad\pi_{T,k}^{*}+\pi_{F,k}^{*}=1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S2.SS3.SSS3.Px5.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.SS3.SSS3.Px5.p3" class="ltx_para">
<p id="S2.SS3.SSS3.Px5.p3.1" class="ltx_p"><span id="S2.SS3.SSS3.Px5.p3.1.1" class="ltx_text">At equilibrium the expected changes vanish,
so <math id="S2.SS3.SSS3.Px5.p3.m1" class="ltx_Math" alttext="E[\Delta T_{k}]=E[\Delta F_{k}]=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>k</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>k</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">E[\Delta T_{k}]=E[\Delta F_{k}]=0</annotation></semantics></math>.
Using the distributional means</span></p>
<table id="S2.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex20.m1" class="ltx_Math" alttext="\displaystyle E[X_{k}]" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>X</mi><mi>k</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle E[X_{k}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex20.m2" class="ltx_math_unparsed" alttext="\displaystyle=\lambda_{k}\quad\text{(Poisson distribution)}," display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>λ</mi><msub><mrow></mrow><mi>k</mi></msub><mtext>(Poisson distribution)</mtext><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\lambda_{k}\quad\text{(Poisson distribution)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex21.m1" class="ltx_Math" alttext="\displaystyle E[Y_{jk}]" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>Y</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle E[Y_{jk}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex21.m2" class="ltx_math_unparsed" alttext="\displaystyle=F_{k}d_{jk}\quad\text{(Binomial distribution)}," display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>F</mi><msub><mrow></mrow><mi>k</mi></msub><mi>d</mi><msub><mrow></mrow><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mtext>(Binomial distribution)</mtext><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=F_{k}d_{jk}\quad\text{(Binomial distribution)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex22.m1" class="ltx_Math" alttext="\displaystyle E[Z_{k}]" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>Z</mi><mi>k</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle E[Z_{k}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex22.m2" class="ltx_math_unparsed" alttext="\displaystyle=T_{k}p_{k}\quad\text{(Binomial distribution)}," display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>T</mi><msub><mrow></mrow><mi>k</mi></msub><mi>p</mi><msub><mrow></mrow><mi>k</mi></msub><mtext>(Binomial distribution)</mtext><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=T_{k}p_{k}\quad\text{(Binomial distribution)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex23.m1" class="ltx_Math" alttext="\displaystyle E[W_{k}]" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle E[W_{k}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex23.m2" class="ltx_math_unparsed" alttext="\displaystyle=F_{k}q_{k}\quad\text{(Binomial distribution)}," display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>F</mi><msub><mrow></mrow><mi>k</mi></msub><mi>q</mi><msub><mrow></mrow><mi>k</mi></msub><mtext>(Binomial distribution)</mtext><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=F_{k}q_{k}\quad\text{(Binomial distribution)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS3.SSS3.Px5.p3.2" class="ltx_p"><span id="S2.SS3.SSS3.Px5.p3.2.1" class="ltx_text">and dividing by <math id="S2.SS3.SSS3.Px5.p3.m2" class="ltx_Math" alttext="n_{k}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mi>k</mi></msub><annotation encoding="application/x-tex">n_{k}</annotation></semantics></math> to convert counts to proportions gives</span></p>
<table id="S2.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.E8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.E8.m1" class="ltx_Math" alttext="\displaystyle\pi_{T,k}p_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mrow><mi>T</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\pi_{T,k}p_{k}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E8.m2" class="ltx_Math" alttext="\displaystyle=\pi_{F,k}q_{k}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>π</mi><mrow><mi>F</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>k</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\pi_{F,k}q_{k},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(8)</span></td></tr></tbody>
<tbody id="S2.E9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.E9.m1" class="ltx_Math" alttext="\displaystyle\lambda_{k}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\displaystyle\lambda_{k}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E9.m2" class="ltx_Math" alttext="\displaystyle=\pi_{F,k}d_{jk}+\pi_{F,k}q_{k}-\pi_{T,k}p_{k}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><msub><mi>π</mi><mrow><mi>F</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>π</mi><mrow><mi>F</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>k</mi></msub></mrow></mrow><mo>−</mo><mrow><msub><mi>π</mi><mrow><mi>T</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>k</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\pi_{F,k}d_{jk}+\pi_{F,k}q_{k}-\pi_{T,k}p_{k}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
<p id="S2.SS3.SSS3.Px5.p3.3" class="ltx_p"><span id="S2.SS3.SSS3.Px5.p3.3.1" class="ltx_text">Equation (<a href="#S2.E8" title="In Proof. ‣ Normalised update equations. ‣ 2.3.3 Cross-Network Invalidation-Detection Model ‣ 2.3 Modeling Discursive Networks ‣ 2 Methods ‣ The Flaws of Others: An LLM-driven Framework for Scientific Knowledge Production" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>) yields
<math id="S2.SS3.SSS3.Px5.p3.m3" class="ltx_Math" alttext="\pi_{F,k}=\pi_{T,k}p_{k}/q_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mrow><mi>F</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>=</mo><mrow><mrow><msub><mi>π</mi><mrow><mi>T</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>k</mi></msub></mrow><mo>/</mo><msub><mi>q</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\pi_{F,k}=\pi_{T,k}p_{k}/q_{k}</annotation></semantics></math>.
Insert this into the normalization
<math id="S2.SS3.SSS3.Px5.p3.m4" class="ltx_Math" alttext="\pi_{T,k}+\pi_{F,k}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mrow><mi>T</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>+</mo><msub><mi>π</mi><mrow><mi>F</mi><mo>,</mo><mi>k</mi></mrow></msub></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\pi_{T,k}+\pi_{F,k}=1</annotation></semantics></math> to obtain
<math id="S2.SS3.SSS3.Px5.p3.m5" class="ltx_Math" alttext="\pi_{T,k}=q_{k}/(p_{k}+q_{k})" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mrow><mi>T</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>=</mo><mrow><msub><mi>q</mi><mi>k</mi></msub><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>p</mi><mi>k</mi></msub><mo>+</mo><msub><mi>q</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{T,k}=q_{k}/(p_{k}+q_{k})</annotation></semantics></math> and
<math id="S2.SS3.SSS3.Px5.p3.m6" class="ltx_Math" alttext="\pi_{F,k}=p_{k}/(p_{k}+q_{k})" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mrow><mi>F</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>=</mo><mrow><msub><mi>p</mi><mi>k</mi></msub><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>p</mi><mi>k</mi></msub><mo>+</mo><msub><mi>q</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{F,k}=p_{k}/(p_{k}+q_{k})</annotation></semantics></math>.
Finally, setting <math id="S2.SS3.SSS3.Px5.p3.m7" class="ltx_Math" alttext="\pi_{F,k}=\lambda_{k}/d_{jk}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mrow><mi>F</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>=</mo><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo>/</mo><msub><mi>d</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\pi_{F,k}=\lambda_{k}/d_{jk}</annotation></semantics></math> from
(<a href="#S2.E9" title="In Proof. ‣ Normalised update equations. ‣ 2.3.3 Cross-Network Invalidation-Detection Model ‣ 2.3 Modeling Discursive Networks ‣ 2 Methods ‣ The Flaws of Others: An LLM-driven Framework for Scientific Knowledge Production" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>) gives the constraint
(<a href="#S2.E7" title="In Lemma 2.3 (Dual-network invalidation propagation). ‣ Normalised update equations. ‣ 2.3.3 Cross-Network Invalidation-Detection Model ‣ 2.3 Modeling Discursive Networks ‣ 2 Methods ‣ The Flaws of Others: An LLM-driven Framework for Scientific Knowledge Production" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>) and the stated fixed point.
∎</span></p>
</div>
</div>
</section>
<section id="S2.SS3.SSS3.Px6" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Interpretation of Lemma <a href="#S2.Thmlemma3" title="Lemma 2.3 (Dual-network invalidation propagation). ‣ Normalised update equations. ‣ 2.3.3 Cross-Network Invalidation-Detection Model ‣ 2.3 Modeling Discursive Networks ‣ 2 Methods ‣ The Flaws of Others: An LLM-driven Framework for Scientific Knowledge Production" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.3</span></a>.</h5>

<div id="S2.SS3.SSS3.Px6.p1" class="ltx_para">
<p id="S2.SS3.SSS3.Px6.p1.1" class="ltx_p">The equilibrium proportions reveal clear causal roles for each parameter.
The false-statement share in network <math id="S2.SS3.SSS3.Px6.p1.m1" class="ltx_Math" alttext="N_{k}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>k</mi></msub><annotation encoding="application/x-tex">N_{k}</annotation></semantics></math> is</p>
<table id="S2.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex24.m1" class="ltx_Math" alttext="\pi_{F,k}^{*}=\frac{\lambda_{k}}{d_{jk}}," display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>π</mi><mrow><mi>F</mi><mo>,</mo><mi>k</mi></mrow><mo>∗</mo></msubsup><mo>=</mo><mfrac><msub><mi>λ</mi><mi>k</mi></msub><msub><mi>d</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\pi_{F,k}^{*}=\frac{\lambda_{k}}{d_{jk}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS3.SSS3.Px6.p1.2" class="ltx_p">so it scales <em id="S2.SS3.SSS3.Px6.p1.2.1" class="ltx_emph ltx_font_italic">directly</em> with the per-actor error-generation rate
<math id="S2.SS3.SSS3.Px6.p1.m2" class="ltx_Math" alttext="\lambda_{k}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\lambda_{k}</annotation></semantics></math> and <em id="S2.SS3.SSS3.Px6.p1.2.2" class="ltx_emph ltx_font_italic">inversely</em> with the cross-network detection
probability <math id="S2.SS3.SSS3.Px6.p1.m3" class="ltx_Math" alttext="d_{jk}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">d_{jk}</annotation></semantics></math>. More prolific error creation or weaker
cross-scrutiny raises the long-run fraction of false statements.</p>
</div>
<div id="S2.SS3.SSS3.Px6.p2" class="ltx_para">
<p id="S2.SS3.SSS3.Px6.p2.1" class="ltx_p">The true-statement share is</p>
<table id="S2.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex25.m1" class="ltx_Math" alttext="\pi_{T,k}^{*}=\pi_{F,k}^{*}\,\frac{q_{k}}{p_{k}}=\frac{\lambda_{k}\,q_{k}}{d_{jk}\,p_{k}}," display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>π</mi><mrow><mi>T</mi><mo>,</mo><mi>k</mi></mrow><mo>∗</mo></msubsup><mo>=</mo><mrow><msubsup><mi>π</mi><mrow><mi>F</mi><mo>,</mo><mi>k</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mfrac><msub><mi>q</mi><mi>k</mi></msub><msub><mi>p</mi><mi>k</mi></msub></mfrac></mrow><mo>=</mo><mfrac><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>q</mi><mi>k</mi></msub></mrow><mrow><msub><mi>d</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>p</mi><mi>k</mi></msub></mrow></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\pi_{T,k}^{*}=\pi_{F,k}^{*}\,\frac{q_{k}}{p_{k}}=\frac{\lambda_{k}\,q_{k}}{d_{jk}\,p_{k}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS3.SSS3.Px6.p2.2" class="ltx_p">hence it grows with the internal correction probability <math id="S2.SS3.SSS3.Px6.p2.m1" class="ltx_Math" alttext="q_{k}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi>k</mi></msub><annotation encoding="application/x-tex">q_{k}</annotation></semantics></math> and falls
with the internal corruption probability <math id="S2.SS3.SSS3.Px6.p2.m2" class="ltx_Math" alttext="p_{k}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>k</mi></msub><annotation encoding="application/x-tex">p_{k}</annotation></semantics></math>. A network that corrects
errors efficiently (<math id="S2.SS3.SSS3.Px6.p2.m3" class="ltx_Math" alttext="q_{k}\!\uparrow" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>k</mi></msub><mo lspace="0.108em" stretchy="false">↑</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">q_{k}\!\uparrow</annotation></semantics></math>) or seldom corrupts truths
(<math id="S2.SS3.SSS3.Px6.p2.m4" class="ltx_Math" alttext="p_{k}\!\downarrow" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>k</mi></msub><mo lspace="0.108em" stretchy="false">↓</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">p_{k}\!\downarrow</annotation></semantics></math>) achieves a higher equilibrium truth proportion.</p>
</div>
<div id="S2.SS3.SSS3.Px6.p3" class="ltx_para">
<p id="S2.SS3.SSS3.Px6.p3.1" class="ltx_p">Finally, Eq. (<a href="#S2.E7" title="In Lemma 2.3 (Dual-network invalidation propagation). ‣ Normalised update equations. ‣ 2.3.3 Cross-Network Invalidation-Detection Model ‣ 2.3 Modeling Discursive Networks ‣ 2 Methods ‣ The Flaws of Others: An LLM-driven Framework for Scientific Knowledge Production" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>) couples <math id="S2.SS3.SSS3.Px6.p3.m1" class="ltx_Math" alttext="\lambda_{k}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\lambda_{k}</annotation></semantics></math> to the flip
parameters: if within-network corruption outpaces correction
(<math id="S2.SS3.SSS3.Px6.p3.m2" class="ltx_Math" alttext="p_{k}&gt;q_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>k</mi></msub><mo>&gt;</mo><msub><mi>q</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">p_{k}&gt;q_{k}</annotation></semantics></math>), the consistency condition forces a higher <math id="S2.SS3.SSS3.Px6.p3.m3" class="ltx_Math" alttext="\lambda_{k}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\lambda_{k}</annotation></semantics></math>,
pushing <math id="S2.SS3.SSS3.Px6.p3.m4" class="ltx_Math" alttext="\pi_{F,k}^{*}" display="inline" intent=":literal"><semantics><msubsup><mi>π</mi><mrow><mi>F</mi><mo>,</mo><mi>k</mi></mrow><mo>∗</mo></msubsup><annotation encoding="application/x-tex">\pi_{F,k}^{*}</annotation></semantics></math> upward unless the partner network compensates with
stronger detection (<math id="S2.SS3.SSS3.Px6.p3.m5" class="ltx_Math" alttext="d_{jk}\!\uparrow" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0.108em" stretchy="false">↑</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">d_{jk}\!\uparrow</annotation></semantics></math>). Thus the model quantifies an
intuitive trade-off: falsehood prevalence is driven by the <em id="S2.SS3.SSS3.Px6.p3.1.1" class="ltx_emph ltx_font_italic">ratio</em> of
error creation to error removal, internally via <math id="S2.SS3.SSS3.Px6.p3.m6" class="ltx_Math" alttext="(p_{k},q_{k})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>k</mi></msub><mo>,</mo><msub><mi>q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(p_{k},q_{k})</annotation></semantics></math> and externally
via <math id="S2.SS3.SSS3.Px6.p3.m7" class="ltx_Math" alttext="d_{jk}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">d_{jk}</annotation></semantics></math>.</p>
</div>
</section>
</section>
</section>
<section id="S2.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">2.4 </span>Single- vs. Cross-Network Models with Invalidation</h3>

<section id="S2.SS4.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Stationary false-statement shares.</h5>

<div id="S2.SS4.SSS0.Px1.p1" class="ltx_para">
<p id="S2.SS4.SSS0.Px1.p1.1" class="ltx_p">The <em id="S2.SS4.SSS0.Px1.p1.1.1" class="ltx_emph ltx_font_italic">single-network emergent-invalidation</em> model
(Lemma <a href="#S2.Thmlemma2" title="Lemma 2.2 (Single-network invalidation with fabrication). ‣ Update equations. ‣ 2.3.2 Single-Network Emergent Invalidation Model ‣ 2.3 Modeling Discursive Networks ‣ 2 Methods ‣ The Flaws of Others: An LLM-driven Framework for Scientific Knowledge Production" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.2</span></a>) stabilizes at</p>
<table id="S2.Ex26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex26.m1" class="ltx_Math" alttext="\pi_{f}^{\mathrm{single}}\;=\;\frac{p+\lambda}{p+\lambda+q},\qquad\pi_{r}^{\mathrm{single}}\;=\;\frac{q}{p+\lambda+q}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>π</mi><mi>f</mi><mi>single</mi></msubsup><mo lspace="0.558em" rspace="0.558em">=</mo><mfrac><mrow><mi>p</mi><mo>+</mo><mi>λ</mi></mrow><mrow><mi>p</mi><mo>+</mo><mi>λ</mi><mo>+</mo><mi>q</mi></mrow></mfrac></mrow><mo rspace="2.167em">,</mo><mrow><msubsup><mi>π</mi><mi>r</mi><mi>single</mi></msubsup><mo rspace="0.558em">=</mo><mfrac><mi>q</mi><mrow><mi>p</mi><mo>+</mo><mi>λ</mi><mo>+</mo><mi>q</mi></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\pi_{f}^{\mathrm{single}}\;=\;\frac{p+\lambda}{p+\lambda+q},\qquad\pi_{r}^{\mathrm{single}}\;=\;\frac{q}{p+\lambda+q}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S2.SS4.SSS0.Px1.p2" class="ltx_para">
<p id="S2.SS4.SSS0.Px1.p2.1" class="ltx_p">For a given network <math id="S2.SS4.SSS0.Px1.p2.m1" class="ltx_Math" alttext="N_{k}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>k</mi></msub><annotation encoding="application/x-tex">N_{k}</annotation></semantics></math> engaged in <em id="S2.SS4.SSS0.Px1.p2.1.1" class="ltx_emph ltx_font_italic">cross-network detection</em>
with partner <math id="S2.SS4.SSS0.Px1.p2.m2" class="ltx_Math" alttext="N_{j}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>j</mi></msub><annotation encoding="application/x-tex">N_{j}</annotation></semantics></math> (Lemma <a href="#S2.Thmlemma3" title="Lemma 2.3 (Dual-network invalidation propagation). ‣ Normalised update equations. ‣ 2.3.3 Cross-Network Invalidation-Detection Model ‣ 2.3 Modeling Discursive Networks ‣ 2 Methods ‣ The Flaws of Others: An LLM-driven Framework for Scientific Knowledge Production" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.3</span></a>) the
corresponding steady state is</p>
<table id="S2.Ex27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex27.m1" class="ltx_Math" alttext="\pi_{f}^{\mathrm{cross}}\;=\;\frac{\lambda}{d},\qquad\pi_{r}^{\mathrm{cross}}\;=\;\frac{\lambda\,q}{d\,p}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>π</mi><mi>f</mi><mi>cross</mi></msubsup><mo lspace="0.558em" rspace="0.558em">=</mo><mfrac><mi>λ</mi><mi>d</mi></mfrac></mrow><mo rspace="2.167em">,</mo><mrow><msubsup><mi>π</mi><mi>r</mi><mi>cross</mi></msubsup><mo rspace="0.558em">=</mo><mfrac><mrow><mi>λ</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mi>d</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>p</mi></mrow></mfrac></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\pi_{f}^{\mathrm{cross}}\;=\;\frac{\lambda}{d},\qquad\pi_{r}^{\mathrm{cross}}\;=\;\frac{\lambda\,q}{d\,p},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS4.SSS0.Px1.p2.2" class="ltx_p">where <math id="S2.SS4.SSS0.Px1.p2.m3" class="ltx_Math" alttext="p,q,\lambda" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>,</mo><mi>q</mi><mo>,</mo><mi>λ</mi></mrow><annotation encoding="application/x-tex">p,q,\lambda</annotation></semantics></math> now abbreviate <math id="S2.SS4.SSS0.Px1.p2.m4" class="ltx_Math" alttext="p_{k},q_{k},\lambda_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>k</mi></msub><mo>,</mo><msub><mi>q</mi><mi>k</mi></msub><mo>,</mo><msub><mi>λ</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">p_{k},q_{k},\lambda_{k}</annotation></semantics></math> and
<math id="S2.SS4.SSS0.Px1.p2.m5" class="ltx_Math" alttext="d=d_{jk}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><msub><mi>d</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub></mrow><annotation encoding="application/x-tex">d=d_{jk}</annotation></semantics></math>.</p>
</div>
<div id="S2.SS4.SSS0.Px1.p3" class="ltx_para ltx_noindent">
<p id="S2.SS4.SSS0.Px1.p3.1" class="ltx_p">Here</p>
<table id="S2.SS4.SSS0.Px1.p3.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="S2.SS4.SSS0.Px1.p3.2.1" class="ltx_tr">
<th id="S2.SS4.SSS0.Px1.p3.2.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="S2.SS4.SSS0.Px1.p3.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math></th>
<td id="S2.SS4.SSS0.Px1.p3.2.1.2" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;">intrinsic <math id="S2.SS4.SSS0.Px1.p3.m2" class="ltx_Math" alttext="r\!\to\!f" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo lspace="0.108em" rspace="0.108em" stretchy="false">→</mo><mi>f</mi></mrow><annotation encoding="application/x-tex">r\!\to\!f</annotation></semantics></math> flip probability in <math id="S2.SS4.SSS0.Px1.p3.m3" class="ltx_Math" alttext="N_{k}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>k</mi></msub><annotation encoding="application/x-tex">N_{k}</annotation></semantics></math>;</td></tr>
<tr id="S2.SS4.SSS0.Px1.p3.2.2" class="ltx_tr">
<th id="S2.SS4.SSS0.Px1.p3.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="S2.SS4.SSS0.Px1.p3.m4" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math></th>
<td id="S2.SS4.SSS0.Px1.p3.2.2.2" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;">intrinsic <math id="S2.SS4.SSS0.Px1.p3.m5" class="ltx_Math" alttext="f\!\to\!r" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.108em" rspace="0.108em" stretchy="false">→</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">f\!\to\!r</annotation></semantics></math> flip probability in <math id="S2.SS4.SSS0.Px1.p3.m6" class="ltx_Math" alttext="N_{k}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>k</mi></msub><annotation encoding="application/x-tex">N_{k}</annotation></semantics></math>;</td></tr>
<tr id="S2.SS4.SSS0.Px1.p3.2.3" class="ltx_tr">
<th id="S2.SS4.SSS0.Px1.p3.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="S2.SS4.SSS0.Px1.p3.m7" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math></th>
<td id="S2.SS4.SSS0.Px1.p3.2.3.2" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;">fabrication hazard per true statement in <math id="S2.SS4.SSS0.Px1.p3.m8" class="ltx_Math" alttext="N_{k}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>k</mi></msub><annotation encoding="application/x-tex">N_{k}</annotation></semantics></math>;</td></tr>
<tr id="S2.SS4.SSS0.Px1.p3.2.4" class="ltx_tr">
<th id="S2.SS4.SSS0.Px1.p3.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="S2.SS4.SSS0.Px1.p3.m9" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math></th>
<td id="S2.SS4.SSS0.Px1.p3.2.4.2" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;">probability a false statement in <math id="S2.SS4.SSS0.Px1.p3.m10" class="ltx_Math" alttext="N_{k}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>k</mi></msub><annotation encoding="application/x-tex">N_{k}</annotation></semantics></math> is detected by <math id="S2.SS4.SSS0.Px1.p3.m11" class="ltx_Math" alttext="N_{j}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>j</mi></msub><annotation encoding="application/x-tex">N_{j}</annotation></semantics></math>.</td></tr>
</tbody>
</table>
</div>
<div id="S2.Thmlemma4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmlemma4.2" class="ltx_text ltx_font_bold">Lemma 2.4</span></span><span id="S2.Thmlemma4.3" class="ltx_text ltx_font_bold"> </span>(Cross-network detection lowers falsehood prevalence)<span id="S2.Thmlemma4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmlemma4.p1" class="ltx_para">
<p id="S2.Thmlemma4.p1.1" class="ltx_p">If</p>
<table id="S2.Ex28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex28.m1" class="ltx_Math" alttext="\frac{\lambda}{d}\;&lt;\;\frac{p+\lambda}{p+\lambda+q}," display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mi>λ</mi><mi>d</mi></mfrac><mo lspace="0.558em" rspace="0.558em">&lt;</mo><mfrac><mrow><mi>p</mi><mo>+</mo><mi>λ</mi></mrow><mrow><mi>p</mi><mo>+</mo><mi>λ</mi><mo>+</mo><mi>q</mi></mrow></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{\lambda}{d}\;&lt;\;\frac{p+\lambda}{p+\lambda+q},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.Thmlemma4.p1.2" class="ltx_p">then
<math id="S2.Thmlemma4.p1.m1" class="ltx_Math" alttext="\pi_{f}^{\mathrm{cross}}&lt;\pi_{f}^{\mathrm{single}}," display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>π</mi><mi>f</mi><mi>cross</mi></msubsup><mo>&lt;</mo><msubsup><mi>π</mi><mi>f</mi><mi>single</mi></msubsup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\pi_{f}^{\mathrm{cross}}&lt;\pi_{f}^{\mathrm{single}},</annotation></semantics></math>
i.e. coupling <math id="S2.Thmlemma4.p1.m2" class="ltx_Math" alttext="N_{k}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>k</mi></msub><annotation encoding="application/x-tex">N_{k}</annotation></semantics></math> to an external detector <math id="S2.Thmlemma4.p1.m3" class="ltx_Math" alttext="N_{j}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>j</mi></msub><annotation encoding="application/x-tex">N_{j}</annotation></semantics></math> <em id="S2.Thmlemma4.p1.2.1" class="ltx_emph ltx_font_italic">reduces</em> the
steady-state prevalence of false statements.</p>
</div>
</div>
<div id="S2.SS4.SSS0.Px1.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.SS4.SSS0.Px1.p4" class="ltx_para">
<p id="S2.SS4.SSS0.Px1.p4.1" class="ltx_p"><span id="S2.SS4.SSS0.Px1.p4.1.1" class="ltx_text">Subtract the two stationary shares:</span></p>
<table id="S2.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex29.m1" class="ltx_math_unparsed" alttext="\pi_{f}^{\mathrm{single}}\;-\;\pi_{f}^{\mathrm{cross}}\;=\;\frac{p+\lambda}{p+\lambda+q}\;-\;\frac{\lambda}{d}\;&gt;\;0\quad\Longleftrightarrow\quad\frac{\lambda}{d}&lt;\frac{p+\lambda}{p+\lambda+q}." display="block" intent=":literal"><semantics><mrow><mi>π</mi><msub><mrow></mrow><mi>f</mi></msub><msup><mrow></mrow><mi>single</mi></msup><mo rspace="0.502em">−</mo><mi>π</mi><msub><mrow></mrow><mi>f</mi></msub><msup><mrow></mrow><mi>cross</mi></msup><mo rspace="0.558em">=</mo><mfrac><mrow><mi>p</mi><mo>+</mo><mi>λ</mi></mrow><mrow><mi>p</mi><mo>+</mo><mi>λ</mi><mo>+</mo><mi>q</mi></mrow></mfrac><mo lspace="0.502em" rspace="0.502em">−</mo><mfrac><mi>λ</mi><mi>d</mi></mfrac><mo lspace="0.558em">&gt;</mo><mn> 0</mn><mo stretchy="false">⟺</mo><mfrac><mi>λ</mi><mi>d</mi></mfrac><mo>&lt;</mo><mfrac><mrow><mi>p</mi><mo>+</mo><mi>λ</mi></mrow><mrow><mi>p</mi><mo>+</mo><mi>λ</mi><mo>+</mo><mi>q</mi></mrow></mfrac><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\pi_{f}^{\mathrm{single}}\;-\;\pi_{f}^{\mathrm{cross}}\;=\;\frac{p+\lambda}{p+\lambda+q}\;-\;\frac{\lambda}{d}\;&gt;\;0\quad\Longleftrightarrow\quad\frac{\lambda}{d}&lt;\frac{p+\lambda}{p+\lambda+q}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS4.SSS0.Px1.p4.2" class="ltx_p"><span id="S2.SS4.SSS0.Px1.p4.2.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="S2.SS4.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Interpretation.</h5>

<div id="S2.SS4.SSS0.Px2.p1" class="ltx_para">
<p id="S2.SS4.SSS0.Px2.p1.1" class="ltx_p">External scrutiny (<math id="S2.SS4.SSS0.Px2.p1.m1" class="ltx_Math" alttext="d\!\uparrow" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo lspace="0.108em" stretchy="false">↑</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">d\!\uparrow</annotation></semantics></math>) or lighter fabrication
pressure (<math id="S2.SS4.SSS0.Px2.p1.m2" class="ltx_Math" alttext="\lambda\!\downarrow" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo lspace="0.108em" stretchy="false">↓</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\lambda\!\downarrow</annotation></semantics></math>) pushes invalidations in the cross-network system below the single-network benchmark. Conversely, when
<math id="S2.SS4.SSS0.Px2.p1.m3" class="ltx_Math" alttext="\lambda/d\geq(p+\lambda)/(p+\lambda+q)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>λ</mi><mo>/</mo><mi>d</mi></mrow><mo>≥</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>+</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>+</mo><mi>λ</mi><mo>+</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda/d\geq(p+\lambda)/(p+\lambda+q)</annotation></semantics></math>, fabrications outrun
detections and the dual system sustains the same or a higher falsehood share than isolation.</p>
</div>
</section>
</section>
<section id="S2.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">2.5 </span>FOO Algorithm</h3>

<div id="S2.SS5.p1" class="ltx_para">
<p id="S2.SS5.p1.1" class="ltx_p">The <em id="S2.SS5.p1.1.1" class="ltx_emph ltx_font_italic">Flaws-of-Others</em> (FOO) algorithm instantiates the detection
hazard <math id="S2.SS5.p1.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> of Lemma <a href="#S2.Thmlemma4" title="Lemma 2.4 (Cross-network detection lowers falsehood prevalence). ‣ Stationary false-statement shares. ‣ 2.4 Single- vs. Cross-Network Models with Invalidation ‣ 2 Methods ‣ The Flaws of Others: An LLM-driven Framework for Scientific Knowledge Production" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.4</span></a> in software. It couples
an <em id="S2.SS5.p1.1.2" class="ltx_emph ltx_font_italic">arbitrary</em> ensemble of large-language-model agents—each defined
by a back-end model, decoding temperature, and free-text
instructions—to a lightweight consensus loop (Algorithm <a href="#alg1" title="Algorithm 1 ‣ 2.5 FOO Algorithm ‣ 2 Methods ‣ The Flaws of Others: An LLM-driven Framework for Scientific Knowledge Production" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>
and Fig. <a href="#S2.F2" title="Figure 2 ‣ 2.5 FOO Algorithm ‣ 2 Methods ‣ The Flaws of Others: An LLM-driven Framework for Scientific Knowledge Production" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>). Neither the number of agents nor
their prompts are fixed: both are read at run time from a simple JSON
configuration, so the same engine can mediate anything from a
two-model A/B test to a dozen specialised critics.</p>
</div>
<div id="S2.SS5.p2" class="ltx_para">
<p id="S2.SS5.p2.1" class="ltx_p">The protocol has four phases:</p>
</div>
<div id="S2.SS5.p3" class="ltx_para">
<p id="S2.SS5.p3.1" class="ltx_p">1. <em id="S2.SS5.p3.1.1" class="ltx_emph ltx_font_italic">Broadcast</em>: an initial user task is broadcast to every
active agent. Each agent returns a first-pass answer.</p>
</div>
<div id="S2.SS5.p4" class="ltx_para">
<p id="S2.SS5.p4.1" class="ltx_p">2. <em id="S2.SS5.p4.1.1" class="ltx_emph ltx_font_italic">Cross-examination (FOO step)</em>: every agent receives the instruction
<em id="S2.SS5.p4.1.2" class="ltx_emph ltx_font_italic">“find the flaws in …”</em> followed by <em id="S2.SS5.p4.1.3" class="ltx_emph ltx_font_italic">all</em> peer answers
except its own, and produces a critique.
This implements the cross-detection hazard: an error overlooked by
one model is likely to be flagged by at least one other.</p>
</div>
<div id="S2.SS5.p5" class="ltx_para">
<p id="S2.SS5.p5.1" class="ltx_p">3. <em id="S2.SS5.p5.1.1" class="ltx_emph ltx_font_italic">Harmonization</em>: one or more agents are flagged as
<em id="S2.SS5.p5.1.2" class="ltx_emph ltx_font_italic">harmonisers</em>. They aggregate the entire set of critiques,
separate agreements from contradictions, and emit a structured
“judgement.” Harmonisers can use any rubric—majority vote, weighted
confidence, specialist veto—to convert divergent feedback into a
common set of observations.</p>
</div>
<div id="S2.SS5.p6" class="ltx_para">
<p id="S2.SS5.p6.1" class="ltx_p">4. <em id="S2.SS5.p6.1.1" class="ltx_emph ltx_font_italic">Revision and loop</em>: every non-harmoniser ingests the judgement and
regenerates its answer, optionally rebutting points it believes to be
wrong. The cycle repeats until a termination condition is met
(identical outputs, bounded edit distance, or a maximum number of
rounds). The final harmoniser synthesis is returned to the user.</p>
</div>
<div id="S2.SS5.p7" class="ltx_para">
<p id="S2.SS5.p7.1" class="ltx_p">Because the agents; instructions; stopping rule; and comparison metric
are all configurable, the same code base supports tasks as different as
mathematical proof sketching, literature surveying, or code review. The
FOO loop thus acts as a <em id="S2.SS5.p7.1.1" class="ltx_emph ltx_font_italic">versatile wrapper</em> that upgrades solitary
generation into a networked, self-auditing process, realising in
practice the external detection hazard that pushes the system into the
truth-dominant regime predicted by the theory.</p>
</div>
<figure id="S2.F2" class="ltx_figure"><span class="ltx_inline-block"><svg id="S2.F2.pic1" class="ltx_picture ltx_centering" height="599.54" overflow="visible" version="1.1" viewBox="0 0 326.46 599.54" width="326.46"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,599.54) matrix(1 0 0 -1 0 0) translate(157.42,0) translate(0,575.37)"><g stroke-width="0.8pt"><path style="fill:none" d="M 23.23 23.62 L -23.23 23.62 C -26.29 23.62 -28.77 21.14 -28.77 18.09 L -28.77 -18.09 C -28.77 -21.14 -26.29 -23.62 -23.23 -23.62 L 23.23 -23.62 C 26.29 -23.62 28.77 -21.14 28.77 -18.09 L 28.77 18.09 C 28.77 21.14 26.29 23.62 23.23 23.62 Z M -28.77 -23.62"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -24.16 -3.38)"><foreignObject style="--ltx-fo-width:3.49em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.15" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="48.31"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.pic1.1" class="ltx_text">Request</span></span></span></foreignObject></g><path style="fill:none" d="M 29.79 -55.12 L -29.79 -55.12 C -32.84 -55.12 -35.32 -57.6 -35.32 -60.65 L -35.32 -96.83 C -35.32 -99.88 -32.84 -102.36 -29.79 -102.36 L 29.79 -102.36 C 32.84 -102.36 35.32 -99.88 35.32 -96.83 L 35.32 -60.65 C 35.32 -57.6 32.84 -55.12 29.79 -55.12 Z M -35.32 -102.36"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -30.71 -83.54)"><foreignObject style="--ltx-fo-width:4.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="61.42"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.pic1.2" class="ltx_text">Distribute</span