<span id="T1.5.8.2.1.1" class="ltx_p"><math id="T1.m15" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> if <math id="T1.m16" class="ltx_Math" alttext="B_{j}=\{r\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>j</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>r</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">B_{j}=\{r\}</annotation></semantics></math> and <math id="T1.m17" class="ltx_Math" alttext="B_{i}=\{f\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>i</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>f</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">B_{i}=\{f\}</annotation></semantics></math>; 
<math id="T1.m18" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> if <math id="T1.m19" class="ltx_Math" alttext="B_{j}=\{f\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>j</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>f</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">B_{j}=\{f\}</annotation></semantics></math> and <math id="T1.m20" class="ltx_Math" alttext="B_{i}=\{r\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>i</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>r</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">B_{i}=\{r\}</annotation></semantics></math>.</span>
</span></td></tr>
