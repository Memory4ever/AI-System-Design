<span id="T2.7.6.2.1.1" class="ltx_p">Message from <math id="T2.m14" class="ltx_Math" alttext="a_{i}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>i</mi></msub><annotation encoding="application/x-tex">a_{i}</annotation></semantics></math> to <math id="T2.m15" class="ltx_Math" alttext="a_{j}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>j</mi></msub><annotation encoding="application/x-tex">a_{j}</annotation></semantics></math> containing <math id="T2.m16" class="ltx_Math" alttext="B_{i}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>i</mi></msub><annotation encoding="application/x-tex">B_{i}</annotation></semantics></math>.</span>
</span></td></tr>
