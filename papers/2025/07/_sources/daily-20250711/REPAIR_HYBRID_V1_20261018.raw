<p class="ltx_p" id="S3.SS2.SSS0.Px3.p1.3">Because the projector <math alttext="\mathbf{I}-\beta_{t}{\bm{k}}_{t}{\bm{k}}_{t}^{\!\top}" class="ltx_Math" display="inline" id="S3.SS2.SSS0.Px3.p1.1.m1.1"><semantics id="S3.SS2.SSS0.Px3.p1.1.m1.1a"><mrow id="S3.SS2.SSS0.Px3.p1.1.m1.1.1" xref="S3.SS2.SSS0.Px3.p1.1.m1.1.1.cmml"><mi id="S3.SS2.SSS0.Px3.p1.1.m1.1.1.2" xref="S3.SS2.SSS0.Px3.p1.1.m1.1.1.2.cmml">𝐈</mi><mo id="S3.SS2.SSS0.Px3.p1.1.m1.1.1.1" xref="S3.SS2.SSS0.Px3.p1.1.m1.1.1.1.cmml">−</mo><mrow id="S3.SS2.SSS0.Px3.p1.1.m1.1.1.3" xref="S3.SS2.SSS0.Px3.p1.1.m1.1.1.3.cmml"><msub id="S3.SS2.SSS0.Px3.p1.1.m1.1.1.3.2" xref="S3.SS2.SSS0.Px3.p1.1.m1.1.1.3.2.cmml"><mi id="S3.SS2.SSS0.Px3.p1.1.m1.1.1.3.2.2" xref="S3.SS2.SSS0.Px3.p1.1.m1.1.1.3.2.2.cmml">β</mi><mi id="S3.SS2.SSS0.Px3.p1.1.m1.1.1.3.2.3" xref="S3.SS2.SSS0.Px3.p1.1.m1.1.1.3.2.3.cmml">t</mi></msub><mo id="S3.SS2.SSS0.Px3.p1.1.m1.1.1.3.1" xref="S3.SS2.SSS0.Px3.p1.1.m1.1.1.3.1.cmml">⁢</mo><msub id="S3.SS2.SSS0.Px3.p1.1.m1.1.1.3.3" xref="S3.SS2.SSS0.Px3.p1.1.m1.1.1.3.3.cmml"><mi id="S3.SS2.SSS0.Px3.p1.1.m1.1.1.3.3.2" xref="S3.SS2.SSS0.Px3.p1.1.m1.1.1.3.3.2.cmml">𝒌</mi><mi id="S3.SS2.SSS0.Px3.p1.1.m1.1.1.3.3.3" xref="S3.SS2.SSS0.Px3.p1.1.m1.1.1.3.3.3.cmml">t</mi></msub><mo id="S3.SS2.SSS0.Px3.p1.1.m1.1.1.3.1a" xref="S3.SS2.SSS0.Px3.p1.1.m1.1.1.3.1.cmml">⁢</mo><msubsup id="S3.SS2.SSS0.Px3.p1.1.m1.1.1.3.4" xref="S3.SS2.SSS0.Px3.p1.1.m1.1.1.3.4.cmml"><mi id="S3.SS2.SSS0.Px3.p1.1.m1.1.1.3.4.2.2" xref="S3.SS2.SSS0.Px3.p1.1.m1.1.1.3.4.2.2.cmml">𝒌</mi><mi id="S3.SS2.SSS0.Px3.p1.1.m1.1.1.3.4.2.3" xref="S3.SS2.SSS0.Px3.p1.1.m1.1.1.3.4.2.3.cmml">t</mi><mo id="S3.SS2.SSS0.Px3.p1.1.m1.1.1.3.4.3" xref="S3.SS2.SSS0.Px3.p1.1.m1.1.1.3.4.3.cmml">⊤</mo></msubsup></mrow></mrow><annotation-xml encoding="MathML-Content" id="S3.SS2.SSS0.Px3.p1.1.m1.1b"><apply id="S3.SS2.SSS0.Px3.p1.1.m1.1.1.cmml" xref="S3.SS2.SSS0.Px3.p1.1.m1.1.1"><minus id="S3.SS2.SSS0.Px3.p1.1.m1.1.1.1.cmml" xref="S3.SS2.SSS0.Px3.p1.1.m1.1.1.1"></minus><ci id="S3.SS2.SS