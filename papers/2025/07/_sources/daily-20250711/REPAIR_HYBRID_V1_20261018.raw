<p class="ltx_p" id="A1.SS0.SSS0.Px4.p1.6">Hence adding more heads <em class="ltx_emph ltx_font_italic" id="A1.SS0.SSS0.Px4.p1.6.1">reduces</em> the cost of these mixers at fixed <math alttext="d_{\mathrm{model}}" class="ltx_Math" display="inline" id="A1.SS0.SSS0.Px4.p1.4.m1.1"><semantics id="A1.SS0.SSS0.Px4.p1.4.m1.1a"><msub id="A1.SS0.SSS0.Px4.p1.4.m1.1.1" xref="A1.SS0.SSS0.Px4.p1.4.m1.1.1.cmml"><mi id="A1.SS0.SSS0.Px4.p1.4.m1.1.1.2" xref="A1.SS0.SSS0.Px4.p1.4.m1.1.1.2.cmml">d</mi><mi id="A1.SS0.SSS0.Px4.p1.4.m1.1.1.3" xref="A1.SS0.SSS0.Px4.p1.4.m1.1.1.3.cmml">model</mi></msub><annotation-xml encoding="MathML-Content" id="A1.SS0.SSS0.Px4.p1.4.m1.1b"><apply id="A1.SS0.SSS0.Px4.p1.4.m1.1.1.cmml" xref="A1.SS0.SSS0.Px4.p1.4.m1.1.1"><csymbol cd="ambiguous" id="A1.SS0.SSS0.Px4.p1.4.m1.1.1.1.cmml" xref="A1.SS0.SSS0.Px4.p1.4.m1.1.1">subscript</csymbol><ci id="A1.SS0.SSS0.Px4.p1.4.m1.1.1.2.cmml" xref="A1.SS0.SSS0.Px4.p1.4.m1.1.1.2">𝑑</ci><ci id="A1.SS0.SSS0.Px4.p1.4.m1.1.1.3.cmml" xref="A1.SS0.SSS0.Px4.p1.4.m1.1.1.3">model</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="A1.SS0.SSS0.Px4.p1.4.m1.1c">d_{\mathrm{model}}</annotation><annotation encoding="application/x-llamapun" id="A1.SS0.SSS0.Px4.p1.4.m1.1d">italic_d start_POSTSUBSCRIPT roman_model end_POSTSUBSCRIPT</annotation></semantics></math>.
