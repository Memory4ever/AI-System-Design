(or the model-specific variant from Table <a class="ltx_ref" href="https://arxiv.org/html/2507.06457v1#S3.T1" title="Table 1 ‣ 3.1 Linear Attention and its variants ‣ 3 Method ‣ A Systematic Analysis of Hybrid Linear Attention"><span class="ltx_text ltx_ref_tag">1</span></a>).
Because <math alttext="\mathbf{S}_{t}" class="ltx_Math" display="inline" id="S3.I2.i1.p1.3.m3.1"><semantics id="S3.I2.i1.p1.3.m3.1a"><msub id="S3.I2.i1.p1.3.m3.1.1" xref="S3.I2.i1.p1.3.m3.1.1.cmml"><mi id="S3.I2.i1.p1.3.m3.1.1.2" xref="S3.I2.i1.p1.3.m3.1.1.2.cmml">𝐒</mi><mi id="S3.I2.i1.p1.3.m3.1.1.3" xref="S3.I2.i1.p1.3.m3.1.1.3.cmml">t</mi></msub><annotation-xml encoding="MathML-Content" id="S3.I2.i1.p1.3.m3.1b"><apply id="S3.I2.i1.p1.3.m3.1.1.cmml" xref="S3.I2.i1.p1.3.m3.1.1"><csymbol cd="ambiguous" id="S3.I2.i1.p1.3.m3.1.1.1.cmml" xref="S3.I2.i1.p1.3.m3.1.1">subscript</csymbol><ci id="S3.I2.i1.p1.3.m3.1.1.2.cmml" xref="S3.I2.i1.p1.3.m3.1.1.2">𝐒</ci><ci id="S3.I2.i1.p1.3.m3.1.1.3.cmml" xref="S3.I2.i1.p1.3.m3.1.1.3">𝑡</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.I2.i1.p1.3.m3.1c">\mathbf{S}_{t}</annotation><annotation encoding="application/x-llamapun" id="S3.I2.i1.p1.3.m3.1d">bold_S start_POSTSUBSCRIPT italic_t end_POSTSUBSCRIPT</annotation></semantics></math> does not grow with the sequence, these layers add <math alttext="\mathcal{O}(Ld)" class="ltx_Math" display="inline" id="S3.I2.i1.p1.4.m4.1"><semantics id="S3.I2.i1.p1.4.m4.1a"><mrow id="S3.I2.i1.p1.4.m4.1.1" xref="S3.I2.i1.p1.4.m4.1.1.cmml"><mi class="ltx_font_mathcaligraphic" id="S3.I2.i1.p1.4.m4.1.1.3" xref="S3.I2.i1.p1.4.m4.1.1.3.cmml">𝒪</mi><mo id="S3.I2.i1.p1.4.m4.1.1.2" xref="S3.I2.i1.p1.4.m4.1.1.2.cmml">⁢</mo><mrow id="S3.I2.i1.p1.4.m4.1.1.1.1" xref="S3.I2.i1.p1.4.m4.1.1.1.1.1.cmml"><mo id="S3.I2.i1.p1.4.m4.1.1.1.1.2" stretchy="false" xref="S3.I2.i1.p1.4.m4.1.1.1.1.1.cmml">(</mo><mrow id="S3.I2.i1.p1.4.m4.1.1.1.1.1" xref="S3.I2.i1.p1.4.m4.1.1.1.1.1.cmml"><mi id="S3.I2.i1.p1.4.m4.1.1.1.1.1.2" xref="S3.I2.i1.p1.4.m4.1.1.1.1.1.2.cmml">L</mi><mo id="S3.I2.i1.p1.4.m4.1.1.1.1.1.1" xref="S3.I2.i1.p1.4.m4.1.1.1.1.1.1.cmml">⁢</mo><mi id="S3.I2.i1.p1.4.m4.1.1.1.1.1.3" xref="S3.I2.i1.p1.4.m4.1.1.1.1.1.3.cmml">d</mi></mrow><mo id="S3.I2.i1.p1.4.m4.1.1.1.1.3" stretchy="false" xref="