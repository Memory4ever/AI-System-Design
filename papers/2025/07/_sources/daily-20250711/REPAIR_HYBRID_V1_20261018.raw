<section class="ltx_paragraph" id="A1.SS0.SSS0.Px4">
<h4 class="ltx_title ltx_title_paragraph">Matrix-state mixers (outer-product family)</h4>
<div class="ltx_para" id="A1.SS0.SSS0.Px4.p1">
<p class="ltx_p" id="A1.SS0.SSS0.Px4.p1.3">Each head carries a dense state <math alttext="S_{t}\in\mathbb{R}^{d_{\mathrm{head}}\times d_{\mathrm{head}}}" class="ltx_Math" display="inline" id="A1.SS0.SSS0.Px4.p1.1.m1.1"><semantics id="A1.SS0.SSS0.Px4.p1.1.m1.1a"><mrow id="A1.SS0.SSS0.Px4.p1.1.m1.1.1" xref="A1.SS0.SSS0.Px4.p1.1.m1.1.1.cmml"><msub id="A1.SS0.SSS0.Px4.p1.1.m1.1.1.2" xref="A1.SS0.SSS0.Px4.p1.1.m1.1.1.2.cmml"><mi id="A1.SS0.SSS0.Px4.p1.1.m1.1.1.2.2" xref="A1.SS0.SSS0.Px4.p1.1.m1.1.1.2.2.cmml">S</mi><mi id="A1.SS0.SSS0.Px4.p1.1.m1.1.1.2.3" xref="A1.SS0.SSS0.Px4.p1.1.m1.1.1.2.3.cmml">t</mi></msub><mo id="A1.SS0.SSS0.Px4.p1.1.m1.1.1.1" xref="A1.SS0.SSS0.Px4.p1.1.m1.1.1.1.cmml">∈</mo><msup id="A1.SS0.SSS0.Px4.p1.1.m1.1.1.3" xref="A1.SS0.SSS0.Px4.p1.1.m1.1.1.3.cmml"><mi id="A1.SS0.SSS0.Px4.p1.1.m1.1.1.3.2" xref="A1.SS0.SSS0.Px4.p1.1.m1.1.1.3.2.cmml">ℝ</mi><mrow id="A1.SS0.SSS0.Px4.p1.1.m1.1.1.3.3" xref="A1.SS0.SSS0.Px4.p1.1.m1.1.1.3.3.cmml"><msub id="A1.SS0.SSS0.Px4.p1.1.m1.1.1.3.3.2" xref="A1.SS0.SSS0.Px4.p1.1.m1.1.1.3.3.2.cmml"><mi id="A1.SS0.SSS0.Px4.p1.1.m1.1.1.3.3.2.2" xref="A1.SS0.SSS0.Px4.p1.1.m1.1.1.3.3.2.2.cmml">d</mi><mi id="A1.SS0.SSS0.Px4.p1.1.m1.1.1.3.3.2.3" xref="A1.SS0.SSS0.Px4.p1.1.m1.1.1.3.3.2.3.cmml">head</mi></msub><mo id="A1.SS0.SSS0.Px4.p1.1.m1.1.1.3.3.1" lspace="0.222em" rspace="0.222em" xref="A1.SS0.SSS0.Px4.p1.1.m1.1.1.3.3.1.cmml">×</mo><msub id="A1.SS0.SSS0.Px4.p1.1.m1.1.1.3.3.3" xref="A1.SS0.SSS0.Px4.p1.1.m1.1.1.3.3.3.cmml"><mi id="A1.SS0.SSS0.Px4.p1.1.m1.1.1.3.3.3.2" xref="A1.SS0.SSS0.Px4.p1.1.m1.1.1.3.3.3.2.cmml">d</mi><mi id="A1.SS0.SSS0.Px4.p1.1.m1.1.1.3.3.3.3" xref="A1.SS0.SSS0.Px4.p1.1.m1.1.1.3.3.3.3.cmml">head</mi></msub></mrow></msup></mrow><annotation-xml encoding="MathML-Content" id="A1.SS0.SSS0.Px4.p1.1.m1.1b"><apply id="A1.SS0.SSS0.Px4.p1.1.m1.1.1.cmml" xref="A1.SS0.SSS0.Px4.p1.1.m1.1.1"><in id="A1.SS0.SSS0.Px4.p1.1.m1.1.1.1.cmml" xref="A1.SS0.SSS0.Px4.p1.1.m1.1.1.1"></in><apply id="A1.SS0.SSS0.Px4.p1.1.m1.1.1.2.cmml" xref