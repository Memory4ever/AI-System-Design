notation-xml><annotation encoding="application/x-tex" id="A1.SS0.SSS0.Px4.p1.5.m2.1c">d_{\mathrm{head}}\times d_{\mathrm{head}}</annotation><annotation encoding="application/x-llamapun" id="A1.SS0.SSS0.Px4.p1.5.m2.1d">italic_d start_POSTSUBSCRIPT roman_head end_POSTSUBSCRIPT × italic_d start_POSTSUBSCRIPT roman_head end_POSTSUBSCRIPT</annotation></semantics></math> matrix either multiplies all entries or adds a rank–1 outer product, each costing <math alttext="d_{\mathrm{head}}^{2}" class="ltx_Math" display="inline" id="A1.SS0.SSS0.Px4.p1.6.m3.1"><semantics id="A1.SS0.SSS0.Px4.p1.6.m3.1a"><msubsup id="A1.SS0.SSS0.Px4.p1.6.m3.1.1" xref="A1.SS0.SSS0.Px4.p1.6.m3.1.1.cmml"><mi id="A1.SS0.SSS0.Px4.p1.6.m3.1.1.2.2" xref="A1.SS0.SSS0.Px4.p1.6.m3.1.1.2.2.cmml">d</mi><mi id="A1.SS0.SSS0.Px4.p1.6.m3.1.1.2.3" xref="A1.SS0.SSS0.Px4.p1.6.m3.1.1.2.3.cmml">head</mi><mn id="A1.SS0.SSS0.Px4.p1.6.m3.1.1.3" xref="A1.SS0.SSS0.Px4.p1.6.m3.1.1.3.cmml">2</mn></msubsup><annotation-xml encoding="MathML-Content" id="A1.SS0.SSS0.Px4.p1.6.m3.1b"><apply id="A1.SS0.SSS0.Px4.p1.6.m3.1.1.cmml" xref="A1.SS0.SSS0.Px4.p1.6.m3.1.1"><csymbol cd="ambiguous" id="A1.SS0.SSS0.Px4.p1.6.m3.1.1.1.cmml" xref="A1.SS0.SSS0.Px4.p1.6.m3.1.1">superscript</csymbol><apply id="A1.SS0.SSS0.Px4.p1.6.m3.1.1.2.cmml" xref="A1.SS0.SSS0.Px4.p1.6.m3.1.1"><csymbol cd="ambiguous" id="A1.SS0.SSS0.Px4.p1.6.m3.1.1.2.1.cmml" xref="A1.SS0.SSS0.Px4.p1.6.m3.1.1">subscript</csymbol><ci id="A1.SS0.SSS0.Px4.p1.6.m3.1.1.2.2.cmml" xref="A1.SS0.SSS0.Px4.p1.6.m3.1.1.2.2">𝑑</ci><ci id="A1.SS0.SSS0.Px4.p1.6.m3.1.1.2.3.cmml" xref="A1.SS0.SSS0.Px4.p1.6.m3.1.1.2.3">head</ci></apply><cn id="A1.SS0.SSS0.Px4.p1.6.m3.1.1.3.cmml" type="integer" xref="A1.SS0.SSS0.Px4.p1.6.m3.1.1.3">2</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="A1.SS0.SSS0.Px4.p1.6.m3.1c">d_{\mathrm{head}}^{2}</annotation><annotation encoding="application/x-llamapun" id="A1.SS0.SSS0.Px4.p1.6.m3.1d">italic_d start_POSTSUBSCRIPT roman_head end_POSTSUBSCRIPT start_POSTSUPERSCRIPT 2 end_POSTSUPERSCRIPT</annotation></semantics></math> FLOPs. Summing the passes per token per head gives:</p>
