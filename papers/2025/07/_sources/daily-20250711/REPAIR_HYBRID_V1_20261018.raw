<div class="ltx_para" id="A1.I2.i1.p1">
<p class="ltx_p" id="A1.I2.i1.p1.1"><span class="ltx_text ltx_font_italic" id="A1.I2.i1.p1.1.1">RetNet / Mamba–2</span>: five passes <math alttext="\Rightarrow" class="ltx_Math" display="inline" id="A1.I2.i1.p1.1.m1.1"><semantics id="A1.I2.i1.p1.1.m1.1a"><mo id="A1.I2.i1.p1.1.m1.1.1" stretchy="false" xref="A1.I2.i1.p1.1.m1.1.1.cmml">⇒</mo><annotation-xml encoding="MathML-Content" id="A1.I2.i1.p1.1.m1.1b"><ci id="A1.I2.i1.p1.1.m1.1.1.cmml" xref="A1.I2.i1.p1.1.m1.1.1">⇒</ci></annotation-xml><annotation encoding="application/x-tex" id="A1.I2.i1.p1.1.m1.1c">\Rightarrow</annotation><annotation encoding="application/x-llamapun" id="A1.I2.i1.p1.1.m1.1d">⇒</annotation></semantics></math> k=5.</p>
