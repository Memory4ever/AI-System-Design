<td class="ltx_td ltx_align_left ltx_border_r" id="S4.T5.2.5.4.1" style="padding-top:1pt;padding-bottom:1pt;"><span class="ltx_text" id="S4.T5.2.5.4.1.1" style="font-size:80%;">3:1</span></td>
<td class="ltx_td ltx_align_center" id="S4.T5.2.5.4.2" style="padding-top:1pt;padding-bottom:1pt;"><span class="ltx_text ltx_font_bold" id="S4.T5.2.5.4.2.1" style="font-size:80%;">0.426</span></td>
<td class="ltx_td ltx_align_center ltx_border_r" id="S4.T5.2.5.4.3" style="padding-top:1pt;padding-bottom:1pt;"><span class="ltx_text ltx_font_bold" id="S4.T5.2.5.4.3.1" style="font-size:80%;">0.436</span></td>
<td class="ltx_td ltx_align_center" id="S4.T5.2.5.4.4" style="padding-top:1pt;padding-bottom:1pt;"><span class="ltx_text ltx_font_bold" id="S4.T5.2.5.4.4.1" style="font-size:80%;">0.332</span></td>
<td class="ltx_td ltx_align_center ltx_border_r" id="S4.T5.2.5.4.5" style="padding-top:1pt;padding-bottom:1pt;"><span class="ltx_text" id="S4.T5.2.5.4.5.1" style="font-size:80%;">0.395</span></td>
<td class="ltx_td ltx_align_center" id="S4.T5.2.5.4.6" style="padding-top:1pt;padding-bottom:1pt;"><span class="ltx_text ltx_font_bold" id="S4.T5.2.5.4.6.1" style="font-size:80%;">0.397</span></td>
</tr>
<tr class="ltx_tr" id="S4.T5.2.6.5">
<td class="ltx_td ltx_align_left ltx_border_bb ltx_border_r" id="S4.T5.2.6.5.1" style="padding-top:1pt;padding-bottom:1pt;"><span class="ltx_text" id="S4.T5.2.6.5.1.1" style="font-size:80%;">Pure</span></td>
<td class="ltx_td ltx_align_center ltx_border_bb" id="S4.T5.2.6.5.2" style="padding-top:1pt;padding-bottom:1pt;"><span class="ltx_text" id="S4.T5.2.6.5.2.1" style="font-size:80%;">0.320</span></td>
