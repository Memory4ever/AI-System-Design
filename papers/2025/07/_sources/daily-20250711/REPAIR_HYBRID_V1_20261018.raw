<p class="ltx_p" id="A1.SS0.SSS0.Px3.p1.5">For HGRN-1 and Hawk, the reference implementation is single-head; we therefore take <math alttext="H=1" class="ltx_Math" display="inline" id="A1.SS0.SSS0.Px3.p1.4.m1.1"><semantics id="A1.SS0.SSS0.Px3.p1.4.m1.1a"><mrow id="A1.SS0.SSS0.Px3.p1.4.m1.1.1" xref="A1.SS0.SSS0.Px3.p1.4.m1.1.1.cmml"><mi id="A1.SS0.SSS0.Px3.p1.4.m1.1.1.2" xref="A1.SS0.SSS0.Px3.p1.4.m1.1.1.2.cmml">H</mi><mo id="A1.SS0.SSS0.Px3.p1.4.m1.1.1.1" xref="A1.SS0.SSS0.Px3.p1.4.m1.1.1.1.cmml">=</mo><mn id="A1.SS0.SSS0.Px3.p1.4.m1.1.1.3" xref="A1.SS0.SSS0.Px3.p1.4.m1.1.1.3.cmml">1</mn></mrow><annotation-xml encoding="MathML-Content" id="A1.SS0.SSS0.Px3.p1.4.m1.1b"><apply id="A1.SS0.SSS0.Px3.p1.4.m1.1.1.cmml" xref="A1.SS0.SSS0.Px3.p1.4.m1.1.1"><eq id="A1.SS0.SSS0.Px3.p1.4.m1.1.1.1.cmml" xref="A1.SS0.SSS0.Px3.p1.4.m1.1.1.1"></eq><ci id="A1.SS0.SSS0.Px3.p1.4.m1.1.1.2.cmml" xref="A1.SS0.SSS0.Px3.p1.4.m1.1.1.2">𝐻</ci><cn id="A1.SS0.SSS0.Px3.p1.4.m1.1.1.3.cmml" type="integer" xref="A1.SS0.SSS0.Px3.p1.4.m1.1.1.3">1</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="A1.SS0.SSS0.Px3.p1.4.m1.1c">H=1</annotation><annotation encoding="application/x-llamapun" id="A1.SS0.SSS0.Px3.p1.4.m1.1d">italic_H = 1</annotation></semantics></math> and <math alttext="d_{\mathrm{head}}=d_{\mathrm{model}}" class="ltx_Math" display="inline" id="A1.SS0.SSS0.Px3.p1.5.m2.1"><semantics id="A1.SS0.SSS0.Px3.p1.5.m2.1a"><mrow id="A1.SS0.SSS0.Px3.p1.5.m2.1.1" xref="A1.SS0.SSS0.Px3.p1.5.m2.1.1.cmml"><msub id="A1.SS0.SSS0.Px3.p1.5.m2.1.1.2" xref="A1.SS0.SSS0.Px3.p1.5.m2.1.1.2.cmml"><mi id="A1.SS0.SSS0.Px3.p1.5.m2.1.1.2.2" xref="A1.SS0.SSS0.Px3.p1.5.m2.1.1.2.2.cmml">d</mi><mi id="A1.SS0.SSS0.Px3.p1.5.m2.1.1.2.3" xref="A1.SS0.SSS0.Px3.p1.5.m2.1.1.2.3.cmml">head</mi></msub><mo id="A1.SS0.SSS0.Px3.p1.5.m2.1.1.1" xref="A1.SS0.SSS0.Px3.p1.5.m2.1.1.1.cmml">=</mo><msub id="A1.SS0.SSS0.Px3.p1.5.m2.1.1.3" xref="A1.SS0.SSS0.Px3.p1.5.m2.1.1.3.cmml"><mi id="A1.SS0.SSS0.Px3.p1.5.m2.1.1.3.2" xref="A1.SS0.SSS0.Px3.p1.5.m2.1.1.3.2.cmml">d</mi><mi id="A1.SS0.SSS0.Px3.p1.5.m2.1.1.3.3" xref="A1.SS0.SSS0.Px3.p1.5.m2.1.1.3.3.cmml">model</mi></msub></mrow><annotation-xml encoding="MathML-Content" id="A1.SS0.SSS0.Px3.p1.5.m2.1b"><apply id="A1.SS0.SSS0.Px3.p1.5.m2.1.1.cmml" xref="A1.SS0.SSS0.Px3.p1.5.m2.1.1"><eq id="A1.SS0.SSS0.Px3.p1.5.m2.1.1.1.cmml" xref="A1.SS0.SSS0.Px3.p1.5.m2.1.1.1"></eq><apply id="A1.SS0.SSS0.Px3.p1.5.m2.1.1.2.cmml" xref="A1.SS0.SSS0.Px3.p1.5.m2.1.1.2"><csymbol cd="ambiguous" id="A1.SS0.SSS0.Px3.p1.5.m2.1.1.2.1.cmml" xref="A1.SS0.SSS0.Px3.p1.5.m2.1.1.2">subscript</csymbol><ci id="A1.SS0.SSS0.Px3.p1.5.m2.1.1.2.2.cmml" xref="A1.SS0.SSS0.Px3.p1.5.m2.1.1.2.2">𝑑</ci><ci id="A1.SS0.SSS0.Px3.p1.5.m2.1.1.2.3.cmml" xref="A1.SS0.SSS0.Px3.p1.5.m2.1.1.2.3">head</ci></apply><apply id="A1.SS0.SSS0.Px3.p1.5.m2.1.1.3.cmml" xref="A1.SS0.SSS0.Px3.p1.5.m2.1.1.3"><csymbol cd="ambiguous" id="A1.SS0.SSS0.Px3.p1.5.m2.1.1.3.1.cmml" xref="A1.SS0.SSS0.Px3.p1.5.m2.1.1.3">subscript</csymbol><ci id="A1.SS0.SSS0.Px3.p1.5.m2.1.1.3.2.cmml" xref="A1.SS0.SSS0.Px3.p1.5.m2.1.1.3.2">𝑑</ci><ci id="A1.SS0.SSS0.Px3.p1.5.m2.1.1.3.3.cmml" xref="A1.SS0.SSS0.Px3.p1.5.m2.1.1.3.3">model</ci></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="A1.SS0.SSS0.Px3.p1.5.m2.1c">d_{\mathrm{head}}=d_{\mathrm{model}}</annotation><annotation encoding="application/x-llamapun" id="A1.SS0.SSS0.Px3.p1.5.m2.1d">italic_d start_POSTSUBSCRIPT roman_head end_POSTSUBSCRIPT = italic_d start_POSTSUBSCRIPT roman_model end_POSTSUBSCRIPT</annotation></semantics></math>.</p>
