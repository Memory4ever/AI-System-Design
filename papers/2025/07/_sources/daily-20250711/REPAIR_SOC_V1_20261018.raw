<th id="S5.T4.2.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column"><span id="S5.T4.2.2.3.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">Functional</span></th>
<th id="S5.T4.2.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column"><span id="S5.T4.2.2.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">Syntax</span></th>
<th id="S5.T4.2.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column"><span id="S5.T4.2.2.5.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">Functional</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T4.2.3" class="ltx_tr">
