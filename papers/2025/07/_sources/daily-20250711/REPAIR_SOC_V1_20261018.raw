<td id="S5.T4.2.3.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T4.2.3.5.1" class="ltx_text ltx_font_bold">50%</span></td></tr>
<tr id="S5.T4.2.4" class="ltx_tr" style="--ltx-bg-color:#E6E6E6;">
<th id="S5.T4.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S5.T4.2.4.1.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">o3-mini-high</span></th>
<td id="S5.T4.2.4.2" class="ltx_td ltx_align_center"><span id="S5.T4.2.4.2.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">100<span id="S5.T4.2.4.2.1.1" class="ltx_text ltx_font_medium">%</span></span></td>
<td id="S5.T4.2.4.3" class="ltx_td ltx_align_center"><span id="S5.T4.2.4.3.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">10%</span></td>
<td id="S5.T4.2.4.4" class="ltx_td ltx_align_center"><span id="S5.T4.2.4.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">100%</span></td>
<td id="S5.T4.2.4.5" class="ltx_td ltx_align_center"><span id="S5.T4.2.4.5.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">20%</span></td></tr>
<tr id="S5.T4.2.5" class="ltx_tr">
