<th id="Sx6.T4.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">CogVideoX1.5</th>
<th id="Sx6.T4.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">HunyuanVideo</th>
