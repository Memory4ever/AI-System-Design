<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(a) </span>Visual Quality</figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S0.F1.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2507.06739v1/score-end.png" id="S0.F1.sf2.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:698/574;" width="698" height="574" alt="Refer to caption">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(b) </span>Numerical Scores</figcaption>
