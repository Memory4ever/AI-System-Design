<td id="S5.T2.7.14.2" class="ltx_td ltx_align_right ltx_border_bb" style="padding-left:2.3pt;padding-right:2.3pt;"><span id="S5.T2.7.14.2.1" class="ltx_text ltx_font_bold">70.8</span></td>
