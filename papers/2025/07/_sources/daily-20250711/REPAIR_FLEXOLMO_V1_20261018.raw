<td id="A1.F5.5.2.2" class="ltx_td ltx_align_right ltx_border_t"><math id="A1.F5.m1" class="ltx_Math" alttext="2.37\times 10^{3}" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.800em">2.37</mn><mo lspace="0.222em" mathsize="0.800em" rspace="0.222em">×</mo><msup><mn mathsize="0.800em">10</mn><mn mathsize="0.800em">3</mn></msup></mrow><annotation encoding="application/x-tex">2.37\times 10^{3}</annotation></semantics></math></td></tr>
