<td id="p1.1.1.3" class="ltx_td ltx_align_left" style="padding-bottom: 1.84995pt;"><a href="https://huggingface.co/allenai/FlexOlmo-7x7B-1T" title="" class="ltx_ref ltx_href" style="font-size:90%;"><span class="ltx_ref ltx_nolink ltx_path ltx_font_typewriter">hf.co/allenai/FlexOlmo-7x7B-1T</span></a></td></tr>
<tr id="p1.1.2" class="ltx_tr">
<td id="p1.1.2.1" class="ltx_td ltx_align_right" style="padding-bottom: 1.84995pt;"><span id="p1.1.2.1.1" class="ltx_text" style="font-size:90%;position:relative; bottom:-1.5pt;"><object type="image/svg+xml" data="2507.07024v1/github-logo.svg" id="g2" class="ltx_graphics ltx_img_square" style="aspect-ratio:14/14;" width="14" height="14"></object></span></td>
