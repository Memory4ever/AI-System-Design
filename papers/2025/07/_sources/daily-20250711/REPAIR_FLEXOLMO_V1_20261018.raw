<td id="S5.T2.7.13.4" class="ltx_td ltx_align_right" style="padding-left:2.3pt;padding-right:2.3pt;">58.8</td>
<td id="S5.T2.7.13.5" class="ltx_td ltx_align_right" style="padding-left:2.3pt;padding-right:2.3pt;"><span id="S5.T2.7.13.5.1" class="ltx_text ltx_font_bold">34.0</span></td>
<td id="S5.T2.7.13.6" class="ltx_td ltx_align_right" style="padding-left:2.3pt;padding-right:2.3pt;">43.4</td>
<td id="S5.T2.7.13.7" class="ltx_td ltx_align_right" style="padding-left:2.3pt;padding-right:2.3pt;">42.1</td>
