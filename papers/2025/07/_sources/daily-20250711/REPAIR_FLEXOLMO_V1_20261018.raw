<td id="A3.T4.9.7.4" class="ltx_td ltx_nopad_l ltx_align_left" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="A3.T4.9.7.4.1" class="ltx_text ltx_font_smallcaps">SciRIFF<sup id="A3.T4.9.7.4.1.1" class="ltx_sup"><span id="A3.T4.9.7.4.1.1.1" class="ltx_text ltx_font_italic">†</span></sup></span></td>
<td id="A3.T4.9.7.5" class="ltx_td ltx_align_left" style="padding-left:2.5pt;padding-right:2.5pt;">—</td>
<td id="A3.T4.9.7.6" class="ltx_td ltx_align_left" style="padding-left:2.5pt;padding-right:2.5pt;"><cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib96" title="" class="ltx_ref">96</a>]</cite></td></tr>
<tr id="A3.T4.9.8" class="ltx_tr">
<td id="A3.T4.9.8.1" class="ltx_td ltx_align_left" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="A3.T4.9.8.1.1" class="ltx_text ltx_font_smallcaps">OpenBookQA</span></td>
