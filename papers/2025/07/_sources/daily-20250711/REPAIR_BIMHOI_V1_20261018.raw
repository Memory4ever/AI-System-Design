<th id="A8.T4.5.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;">Unseen</th>
<th id="A8.T4.5.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;">Seen</th>
<th id="A8.T4.5.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;">Full</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A8.T4.5.1.2" class="ltx_tr">
<th id="A8.T4.5.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_tt" style="padding-left:5.0pt;padding-right:5.0pt;">EF+LSG w/o (<math id="A8.T4.m1" class="ltx_Math" alttext="\bm{A}_{\text{f}}" display="inline" intent=":literal"><semantics><msub><mi>𝑨</mi><mtext>f</mtext></msub><annotation encoding="application/x-tex">\bm{A}_{\text{f}}</annotation></semantics></math> and LLM)</th>
<td id="A8.T4.5.1.2.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:5.0pt;padding-right:5.0pt;">30.38</td>
<td id="A8.T4.5.1.2.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:5.0pt;padding-right:5.0pt;">32.71</td>
<td id="A8.T4.5.1.2.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:5.0pt;padding-right:5.0pt;">32.10</td></tr>
<tr id="A8.T4.5.1.3" class="ltx_tr">
<th id="A8.T4.5.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r" style="padding-left:5.0pt;padding-right:5.0pt;">EF+LSG w/o <math id="A8.T4.m2" class="ltx_Math" alttext="\bm{A}_{\text{f}}" display="inline" intent=":literal"><semantics><msub><mi>𝑨</mi><mtext>f</mtext></msub><annotation encoding="application/x-tex">\bm{A}_{\text{f}}</annotation></semantics></math></th>
<td id="A8.T4.5.1.3.2" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;">30.62</td>
<td id="A8.T4.5.1.3.3" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;">33.10</td>
<td id="A8.T4.5.1.3.4" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;">32.57</td></tr>
