<td id="S4.T1.7.1.1.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:15.0pt;padding-right:15.0pt;">  Seen</td>
<td id="S4.T1.7.1.1.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:15.0pt;padding-right:15.0pt;">  Full</td></tr>
