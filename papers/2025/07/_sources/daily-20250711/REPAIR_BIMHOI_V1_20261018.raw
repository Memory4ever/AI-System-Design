<div id="S2.F2.3.2" class="ltx_block ltx_minipage ltx_align_middle" style="width:482.0pt;"><img src="2507.06510v1/vit_layer_attn.png" id="S2.F2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:665/99;" width="665" height="99" alt="Refer to caption">
</div>
