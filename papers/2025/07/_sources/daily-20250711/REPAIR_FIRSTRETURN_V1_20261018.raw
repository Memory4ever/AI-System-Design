<td class="ltx_eqn_cell ltx_align_center"><math alttext="V(S_{j})=\frac{1}{M}\sum_{m=1}^{M}r_{j,m}" class="ltx_Math" display="block" id="S4.E13.m1.3"><semantics id="S4.E13.m1.3a"><mrow id="S4.E13.m1.3.3" xref="S4.E13.m1.3.3.cmml"><mrow id="S4.E13.m1.3.3.1" xref="S4.E13.m1.3.3.1.cmml"><mi id="S4.E13.m1.3.3.1.3" xref="S4.E13.m1.3.3.1.3.cmml">V</mi><mo id="S4.E13.m1.3.3.1.2" xref="S4.E13.m1.3.3.1.2.cmml">⁢</mo><mrow id="S4.E13.m1.3.3.1.1.1" xref="S4.E13.m1.3.3.1.1.1.1.cmml"><mo id="S4.E13.m1.3.3.1.1.1.2" stretchy="false" xref="S4.E13.m1.3.3.1.1.1.1.cmml">(</mo><msub id="S4.E13.m1.3.3.1.1.1.1" xref="S4.E13.m1.3.3.1.1.1.1.cmml"><mi id="S4.E13.m1.3.3.1.1.1.1.2" xref="S4.E13.m1.3.3.1.1.1.1.2.cmml">S</mi><mi id="S4.E13.m1.3.3.1.1.1.1.3" xref="S4.E13.m1.3.3.1.1.1.1.3.cmml">j</mi></msub><mo id="S4.E13.m1.3.3.1.1.1.3" stretchy="false" xref="S4.E13.m1.3.3.1.1.1.1.cmml">)</mo></mrow></mrow><mo id="S4.E13.m1.3.3.2" xref="S4.E13.m1.3.3.2.cmml">=</mo><mrow id="S4.E13.m1.3.3.3" xref="S4.E13.m1.3.3.3.cmml"><mfrac id="S4.E13.m1.3.3.3.2" xref="S4.E13.m1.3.3.3.2.cmml"><mn id="S4.E13.m1.3.3.3.2.2" xref="S4.E13.m1.3.3.3.2.2.cmml">1</mn><mi id="S4.E13.m1.3.3.3.2.3" xref="S4.E13.m1.3.3.3.2.3.cmml">M</mi></mfrac><mo id="S4.E13.m1.3.3.3.1" xref="S4.E13.m1.3.3.3.1.cmml">⁢</mo><mrow id="S4.E13.m1.3.3.3.3" xref="S4.E13.m1.3.3.3.3.cmml"><munderover id="S4.E13.m1.3.3.3.3.1" xref="S4.E13.m1.3.3.3.3.1.cmml"><mo id="S4.E13.m1.3.3.3.3.1.2.2" movablelimits="false" xref="S4.E13.m1.3.3.3.3.1.2.2.cmml">∑</mo><mrow id="S4.E13.m1.3.3.3.3.1.2.3" xref="S4.E13.m1.3.3.3.3.1.2.3.cmml"><mi id="S4.E13.m1.3.3.3.3.1.2.3.2" xref="S4.E13.m1.3.3.3.3.1.2.3.2.cmml">m</mi><mo id="S4.E13.m1.3.3.3.3.1.2.3.1" xref="S4.E13.m1.3.3.3.3.1.2.3.1.cmml">=</mo><mn id="S4.E13.m1.3.3.3.3.1.2.3.3" xref="S4.E13.m1.3.3.3.3.1.2.3.3.cmml">1</mn></mrow><mi id="S4.E13.m1.3.3.3.3.1.3" xref="S4.E13.m1.3.3.3.3.1.3.cmml">M</mi></munderover><msub id="S4.E13.m1.3.3.3.3.2" xref="S4.E13.m1.3.3.3.3.2.cmml"><mi id="S4.E13.m1.3.3.3.3.2.2" xref="S4.E13.