<p class="ltx_p" id="S4.SS3.p3.4">The advantage modulation factor functions as a dynamic feedback controller during training. When <math alttext="V(S_{j})&gt;V(S_{j-1})" class="ltx_Math" display="inline" id="S4.SS3.p3.1.m1.2"><semantics id="S4.SS3.p3.1.m1.2a"><mrow id="S4.SS3.p3.1.m1.2.2" xref="S4.SS3.p3.1.m1.2.2.cmml"><mrow id="S4.SS3.p3.1.m1.1.1.1" xref="S4.SS3.p3.1.m1.1.1.1.cmml"><mi id="S4.SS3.p3.1.m1.1.1.1.3" xref="S4.SS3.p3.1.m1.1.1.1.3.cmml">V</mi><mo id="S4.SS3.p3.1.m1.1.1.1.2" xref="S4.SS3.p3.1.m1.1.1.1.2.cmml">⁢</mo><mrow id="S4.SS3.p3.1.m1.1.1.1.1.1" xref="S4.SS3.p3.1.m1.1.1.1.1.1.1.cmml"><mo id="S4.SS3.p3.1.m1.1.1.1.1.1.2" stretchy="false" xref="S4.SS3.p3.1.m1.1.1.1.1.1.1.cmml">(</mo><msub id="S4.SS3.p3.1.m1.1.1.1.1.1.1" xref="S4.SS3.p3.1.m1.1.1.1.1.1.1.cmml"><mi id="S4.SS3.p3.1.m1.1.1.1.1.1.1.2" xref="S4.SS3.p3.1.m1.1.1.1.1.1.1.2.cmml">S</mi><mi id="S4.SS3.p3.1.m1.1.1.1.1.1.1.3" xref="S4.SS3.p3.1.m1.1.1.1.1.1.1.3.cmml">j</mi></msub><mo id="S4.SS3.p3.1.m1.1.1.1.1.1.3" stretchy="false" xref="S4.SS3.p3.1.m1.1.1.1.1.1.1.cmml">)</mo></mrow></mrow><mo id="S4.SS3.p3.1.m1.2.2.3" xref="S4.SS3.p3.1.m1.2.2.3.cmml">&gt;</mo><mrow id="S4.SS3.p3.1.m1.2.2.2" xref="S4.SS3.p3.1.m1.2.2.2.cmml"><mi id="S4.SS3.p3.1.m1.2.2.2.3" xref="S4.SS3.p3.1.m1.2.2.2.3.cmml">V</mi><mo id="S4.SS3.p3.1.m1.2.2.2.2" xref="S4.SS3.p3.1.m1.2.2.2.2.cmml">⁢</mo><mrow id="S4.SS3.p3.1.m1.2.2.2.1.1" xref="S4.SS3.p3.1.m1.2.2.2.1.1.1.cmml"><mo id="S4.SS3.p3.1.m1.2.2.2.1.1.2" stretchy="false" xref="S4.SS3.p3.1.m1.2.2.2.1.1.1.cmml">(</mo><msub id="S4.SS3.p3.1.m1.2.2.2.1.1.1" xref="S4.SS3.p3.1.m1.2.2.2.1.1.1.cmml"><mi id="S4.SS3.p3.1.m1.2.2.2.1.1.1.2" xref="S4.SS3.p3.1.m1.2.2.2.1.1.1.2.cmml">S</mi><mrow id="S4.SS3.p3.1.m1.2.2.2.1.1.1.3" xref="S4.SS3.p3.1.m1.2.2.2.1.1.1.3.cmml"><mi id="S4.SS3.p3.1.m1.2.2.2.1.1.1.3.2" xref="S4.SS3.p3.1.m1.2.2.2.1.1.1.3.2.cmml">j</mi><mo id="S4.SS3.p3.1.m1.2.2.2.1.1.1.3.1" xref="S4.SS3.p3.1.m1.2.2.2.1.1.1.3.1.cmml">−</mo><mn id="S4.SS3.p3.1.m1.2.2.2.1.1.1.3.3" xref="S4.SS3