/x-llamapun" id="S4.SS3.p3.1.m1.2d">italic_V ( italic_S start_POSTSUBSCRIPT italic_j end_POSTSUBSCRIPT ) &gt; italic_V ( italic_S start_POSTSUBSCRIPT italic_j - 1 end_POSTSUBSCRIPT )</annotation></semantics></math>, indicating a positive progression in reasoning quality, <math alttext="\alpha_{j}&lt;1" class="ltx_Math" display="inline" id="S4.SS3.p3.2.m2.1"><semantics id="S4.SS3.p3.2.m2.1a"><mrow id="S4.SS3.p3.2.m2.1.1" xref="S4.SS3.p3.2.m2.1.1.cmml"><msub id="S4.SS3.p3.2.m2.1.1.2" xref="S4.SS3.p3.2.m2.1.1.2.cmml"><mi id="S4.SS3.p3.2.m2.1.1.2.2" xref="S4.SS3.p3.2.m2.1.1.2.2.cmml">α</mi><mi id="S4.SS3.p3.2.m2.1.1.2.3" xref="S4.SS3.p3.2.m2.1.1.2.3.cmml">j</mi></msub><mo id="S4.SS3.p3.2.m2.1.1.1" xref="S4.SS3.p3.2.m2.1.1.1.cmml">&lt;</mo><mn id="S4.SS3.p3.2.m2.1.1.3" xref="S4.SS3.p3.2.m2.1.1.3.cmml">1</mn></mrow><annotation-xml encoding="MathML-Content" id="S4.SS3.p3.2.m2.1b"><apply id="S4.SS3.p3.2.m2.1.1.cmml" xref="S4.SS3.p3.2.m2.1.1"><lt id="S4.SS3.p3.2.m2.1.1.1.cmml" xref="S4.SS3.p3.2.m2.1.1.1"></lt><apply id="S4.SS3.p3.2.m2.1.1.2.cmml" xref="S4.SS3.p3.2.m2.1.1.2"><csymbol cd="ambiguous" id="S4.SS3.p3.2.m2.1.1.2.1.cmml" xref="S4.SS3.p3.2.m2.1.1.2">subscript</csymbol><ci id="S4.SS3.p3.2.m2.1.1.2.2.cmml" xref="S4.SS3.p3.2.m2.1.1.2.2">𝛼</ci><ci id="S4.SS3.p3.2.m2.1.1.2.3.cmml" xref="S4.SS3.p3.2.m2.1.1.2.3">𝑗</ci></apply><cn id="S4.SS3.p3.2.m2.1.1.3.cmml" type="integer" xref="S4.SS3.p3.2.m2.1.1.3">1</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.SS3.p3.2.m2.1c">\alpha_{j}&lt;1</annotation><annotation encoding="application/x-llamapun" id="S4.SS3.p3.2.m2.1d">italic_α start_POSTSUBSCRIPT italic_j end_POSTSUBSCRIPT &lt; 1</annotation></semantics></math>. This reduces the influence of the advantage signal for successful paths, preventing premature convergence and preserving exploration diversity. Conversely, when <math alttext="V(S_{j})\leq V(S_{j-1})" class="ltx_Math" display="inline" id="S4.SS3.p3.3.m3.2"><semantics id="S4.SS3.p3.3.m3.2a"><mrow id="S4.SS3.p3.3.m3.2.2" xref="S4.SS3.p3.3.m3.2.2.cmml"><mrow id="S4.SS3.p3.3.m3.1.1.1" xref="S4.SS3.p3.3.m3.1.1.1.cmml"><mi id="S4.SS3.p3.3.m3.1.1.1.3" xref="S4.SS3.p3.3.m3.1.1.1.3.cmml">V</mi><mo id="S4.SS3.p3.3.m3.1.1.1.2" xref="S4.SS3.p3.3.m3.1.1.1.2.cmml">⁢</mo><mrow id="S4.SS3.p3.3.m3.1.1.1.1.1" xref="S4.SS3.p3.3.m3.1.1.1.1.1.1.cmml"><mo id="S4.SS3.p3.3.m3.1.1.1.1.1.2" stretchy="false" xref="S4.SS3.p3.3.m3.1.1.1.1.1.1.cmml">(</mo><msub id="S4.SS3.p3.3.m3.1.1.1.1.1.1" xref="S4.SS3.p3.3.m3.1.1.1.1.1.1.cmml"><mi id="S4.SS3.p3.3.m3.1.1.1.1.1.1.2" xref="S4.SS3.p3.3.m3.1.1.1.1.1.1.2.cmml">S</mi><mi id="S4.SS3.p3.3.m3.1.1.1.1.1.1.3" xref="S4.SS3.p3.3.m3.1.1.1.1.1.1.3.cmml">j</mi></msub><mo id="S4.SS3.p3.3.m3.1.1.1.1.1.3" stretchy="false" xref="S4.SS3.p3.3.m3.1.1.1.1.1.1.cmml">)</mo></mrow></mrow><mo id="S4.SS3.p3.3.m3.2.2.3" xref="S4.SS3.p3.3.m3.2.2.3.cmml">≤</mo><mrow id="S4.SS3.p3.3.m3.2.2.2" xref="S4.SS3.p3.3.m3.2.2.2.cmml"><mi id="S4.SS3.p3.3.m3.2.2.2.3" xref="S4.SS3.p3.3.m3.2.2.2.3.cmml">V</mi><mo id="S4.SS3.p3.3.m3.2.2.2.2" xref="S4.SS3.p3.3.m3.2.2.2.2.cmml">⁢</mo><mrow id="S4.SS3.p3.3.m3.2.2.2.1.1" xref="S4.SS3.p3.3.m3.2.2.2.1.1.1.cmml"><mo id="S4.SS3.p3.3.m3.2.2.2.1.1.2" stretchy="false" xref="S4.SS3.p3.3.m3.2.2.2.1.1.1.cmml">(</mo><msub id="S4.SS3.p3.3.m3.2.2.2.1.1.1" xref="S4.SS3.p3.3.m3.2.2.2.1.1.1.cmml"><mi id="S4.SS3.p3.3.m3.2.2.2.1.1.1.2" xref="S4.SS3.p3.3.m3.2.2.2.1.1.1.2.cmml">S</mi><mrow id="S4.SS3.p3.3.m3.2.2.2.1.1.1.3" xref="S4.SS3.p3.3.m3.2.2.2.1.1.1.3.cmml"><mi id="S4.SS3.p3.3.m3.2.2.2.1.1.1.3.2" xref="S4.SS3.p3.3.m3.2.2.2.1.1.1.3.2.cmml">j</mi><mo id="S4.SS3.p3.3.m3.2.2.2.1.1.1.3.1" xref="S4.SS3.p3.3.m3.2.2.2.1.1.1.3.1.cmml">−</mo><mn id="S4.SS3.p3.3.m3.2.2.2.1.1.1.3.3" xref="S4.SS3.p3.3.m3.2.2.2.1.1.1.3.3.cmml">1</mn></mrow></msub><mo id="S4.SS3.p3.3.m3.2.2.2.1.1.3" stretchy="false" xref="S4.SS3.p3.3.m3.2.2.2.1.1.1.cmml">)</mo></mrow></mrow></mrow><annotation-xml encoding="MathML-Content" id="S4.SS3.p3.3.m3.2b"><apply id="S4.SS3.p3.3.m3.2.2.cmml" xref="S4.SS3.p3.3.m3.2.2"><leq id="S4.SS3.p3.3.m3.2.2.3.cmml" xref="S4.SS3.p3.3.m3.2.2.3"></leq><apply id="S4.SS3.p3.3.m3.1.1.1.cmml" xref="S4.SS3.p3.3.m3.1.1.1"><times id="S4.SS3.p3.3.m3.1.1.1.2.cmml" xref="S4.SS3.p3.3.m3.1.1.1.2"></times><ci id="S4.SS3.p3.3.m3.1.1.1.3.cmml" xref="S4.SS3.p3.3.m3.1.1.1.3">𝑉</ci><apply id="S4.SS3.p3.3.m3.1.1.1.1.1.1.cmml" xref="S4.SS3.p3.3.m3.1.1.1.1.1"><csymbol cd="ambiguous" id="S4.SS3.p3.3.m3.1.1.1.1.1.1.1.cmml" xref="S4.SS3.p3.3.m3.1.1.1.1.1">subscript</csymbol><ci id="S4.SS3.p3.3.m3.1.1.1.1.1.1.2.cmml" xref="S4.SS3.p3.3.m3.1.1.1.1.1.1.2">𝑆</ci><ci id="S4.SS3.p3.3.m3.1.1.1.1.1.1.3.cmml" xref="S4.SS3.p3.3.m3.1.1.1.1.1.1.3">𝑗</ci></apply></apply><apply id="S4.SS3.p3.3.m3.2.2.2.cmml" xref="S4.SS3.p3.3.m3.2.2.2"><times id="S4.SS3.p3.3.m3.2.2.2.2.cmml" xref="S4.SS3.p3.3.m3.2.2.2.2"></times><ci id="S4.SS3.p3.3.m3.2.2.2.3.cmml" xref="S4.SS3.p3.3.m3.2.2.2.3">𝑉</ci><apply id="S4.SS3.p3.3.m3.2.2.2.1.1.1.cmml" xref="S4.SS3.p3.3.m3.2.2.2.1.1"><csymbol cd="ambiguous" id="S4.SS3.p3.3.m3.2.2.2.1.1.1.1.cmml" xref="S4.SS3.p3.3.m3.2.2.2.1.1">subscript</csymbol><ci id="S4.SS3.p3.3.m3.2.2.2.1.1.1.2.cmml" xref="S4.SS3.p3.3.m3.2.2.2.1.1.1.2">𝑆</ci><apply id="S4.SS3.p3.3.m3.2.2.2.1.1.1.3.cmml" xref="S4.SS3.p3.3.m3.2.2.2.1.1.1.3"><minus id="S4.SS3.p3.3.m3.2.2.2.1.1.1.3.1.cmml" xref="S4.SS3.p3.3.m3.2.2.2.1.1.1.3.1"></minus><ci id="S4.SS3.p3.3.m3.2.2.2.1.1.1.3.2.cmml" xref="S4.SS3.p3.3.m3.2.2.2.1.1.1.3.2">𝑗</ci><cn id="S4.SS3.p3.3.m3.2.2.2.1.1.1.3.3.cmml" type="integer" xref="S4.SS3.p3.3.m3.2.2.2.1.1.1.3.3">1</cn></apply></apply></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.SS3.p3.3.m3.2c">V(S_{j})\leq V(S_{j-1})</annotation><annotation encoding="application/x-llamapun" id="S4.SS3.p3.3.m3.2d">italic_V ( italic_S start_POSTSUBSCRIPT italic_j end_POSTSUBSCRIPT ) ≤ italic_V ( italic_S start_POSTSUBSCRIPT italic_j - 1 end_POSTSUBSCRIPT )</annotation></semantics></math>, signaling stagnation or degradation in performance, <math alttext="\alpha_{j}\geq 1" class="ltx_Math" display="inline" id="S4.SS3.p3.4.m4.1"><semantics id="S4.SS3.p3.4.m4.1a"><mrow id="S4.SS3.p3.4.m4.1.1" xref="S4.SS3.p3.4.m4.1.1.cmml"><msub id="S4.SS3.p3.4.m4.1.1.2" xref="S4.SS3.p3.4.m4.1.1.2.cmml"><mi id="S4.SS3.p3.4.m4.1.1.2.2" xref="S4.SS3.p3.4.m4.1.1.2.2.cmml">α</mi><mi id="S4.SS3.p3.4.m4.1.1.2.3" xref="S4.SS3.p3.4.m4.1.1.2.3.cmml">j</mi></msub><mo id="S4.SS3.p3.4.m4.1.1.1" xref="S4.SS3.p3.4.m4.1.1.1.cmml">≥</mo><mn id="S4.SS3.p3.4.m4.1.1.3" xref="S4.SS3.p3.4.m4.1.1.3.cmml">1</mn></mrow><annotation-xml encoding="MathML-Content" id="S4.SS3.p3.4.m4.1b"><apply id="S4.SS3.p3.4.m4.1.1.cmml" xref="S4.SS3.p3.4.m4.1.1"><geq id="S4.SS3.p3.4.m4.1.1.1.cmml" xref="S4.SS3.p3.4.m4.1.1.1"></geq><apply id="S4.SS3.p3.4.m4.1.1.2.cmml" xref="S4.SS3.p3.4.m4.1.1.2"><csymbol cd="ambiguous" id="S4.SS3.p3.4.m4.1.1.2.1.cmml" xref="S4.SS3.p3.4.m4.1.1.2">subscript</csymbol><ci id="S4.SS3.p3.4.m4.1.1.2.2.cmml" xref="S4.SS3.p3.4.m4.1.1.2.2">𝛼</ci><ci id="S4.SS3.p3.4.m4.1.1.2.3.cmml" xref="S4.SS3.p3.4.m4.1.1.2.3">𝑗</ci></apply><cn id="S4.SS3.p3.4.m4.1.1.3.cmml" type="integer" xref="S4.SS3.p3.4.m4.1.1.3">1</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.SS3.p3.4.m4.1c">\alpha_{j}\geq 1</annotation><annotation encoding="application/x-llamapun" id="S4.SS3.p3.4.m4.1d">italic_α start_POSTSUBSCRIPT italic_j end_POSTSUBSCRIPT ≥ 1</annotation></semantics></math>. This amplifies the learning signal, encouraging more aggressive exploration to overcome reasoning bottlenecks.</p>
</div>
<div class="ltx_para" id="S4.SS3.p4">
<p class="ltx_p" id="S4.SS3.p4.4">Under the idealized assumption that all trajectories within a block have identical length, the average of the modulated advantage across the entire batch is exactly zero:</p>
<table class="ltx_equation ltx_eqn_table" id="S4.E16">
<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
