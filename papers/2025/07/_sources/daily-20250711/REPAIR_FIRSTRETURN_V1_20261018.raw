5.2.m1.6.6.4.4.7" xref="S3.SS1.p5.2.m1.6.6.4.5.cmml">,</mo><msub id="S3.SS1.p5.2.m1.4.4.2.2.2" xref="S3.SS1.p5.2.m1.4.4.2.2.2.cmml"><mi id="S3.SS1.p5.2.m1.4.4.2.2.2.2" xref="S3.SS1.p5.2.m1.4.4.2.2.2.2.cmml">x</mi><mi id="S3.SS1.p5.2.m1.4.4.2.2.2.3" xref="S3.SS1.p5.2.m1.4.4.2.2.2.3.cmml">m</mi></msub><mo id="S3.SS1.p5.2.m1.6.6.4.4.8" xref="S3.SS1.p5.2.m1.6.6.4.5.cmml">,</mo><msub id="S3.SS1.p5.2.m1.5.5.3.3.3" xref="S3.SS1.p5.2.m1.5.5.3.3.3.cmml"><mi id="S3.SS1.p5.2.m1.5.5.3.3.3.2" xref="S3.SS1.p5.2.m1.5.5.3.3.3.2.cmml">y</mi><mn id="S3.SS1.p5.2.m1.5.5.3.3.3.3" xref="S3.SS1.p5.2.m1.5.5.3.3.3.3.cmml">0</mn></msub><mo id="S3.SS1.p5.2.m1.6.6.4.4.9" xref="S3.SS1.p5.2.m1.6.6.4.5.cmml">,</mo><mi id="S3.SS1.p5.2.m1.2.2" mathvariant="normal" xref="S3.SS1.p5.2.m1.2.2.cmml">…</mi><mo id="S3.SS1.p5.2.m1.6.6.4.4.10" xref="S3.SS1.p5.2.m1.6.6.4.5.cmml">,</mo><msub id="S3.SS1.p5.2.m1.6.6.4.4.4" xref="S3.SS1.p5.2.m1.6.6.4.4.4.cmml"><mi id="S3.SS1.p5.2.m1.6.6.4.4.4.2" xref="S3.SS1.p5.2.m1.6.6.4.4.4.2.cmml">y</mi><mrow id="S3.SS1.p5.2.m1.6.6.4.4.4.3" xref="S3.SS1.p5.2.m1.6.6.4.4.4.3.cmml"><mi id="S3.SS1.p5.2.m1.6.6.4.4.4.3.2" xref="S3.SS1.p5.2.m1.6.6.4.4.4.3.2.cmml">t</mi><mo id="S3.SS1.p5.2.m1.6.6.4.4.4.3.1" xref="S3.SS1.p5.2.m1.6.6.4.4.4.3.1.cmml">+</mo><mn id="S3.SS1.p5.2.m1.6.6.4.4.4.3.3" xref="S3.SS1.p5.2.m1.6.6.4.4.4.3.3.cmml">1</mn></mrow></msub><mo id="S3.SS1.p5.2.m1.6.6.4.4.11" stretchy="false" xref="S3.SS1.p5.2.m1.6.6.4.5.cmml">)</mo></mrow></mrow><annotation-xml encoding="MathML-Content" id="S3.SS1.p5.2.m1.6b"><apply id="S3.SS1.p5.2.m1.6.6.cmml" xref="S3.SS1.p5.2.m1.6.6"><eq id="S3.SS1.p5.2.m1.6.6.5.cmml" xref="S3.SS1.p5.2.m1.6.6.5"></eq><apply id="S3.SS1.p5.2.m1.6.6.6.cmml" xref="S3.SS1.p5.2.m1.6.6.6"><csymbol cd="ambiguous" id="S3.SS1.p5.2.m1.6.6.6.1.cmml" xref="S3.SS1.p5.2.m1.6.6.6">subscript</csymbol><ci id="S3.SS1.p5.2.m1.6.6.6.2.cmml" xref="S3.SS1.p5.2.m1.6.6.6.2">𝑠</ci><apply id="S3.SS1.p5.2.m1.6.6.6.3.cmml" xref="S3.SS1.p5.2.m1.6.6.6.3"><plus id="S3.SS1.p5.2.m1.6.6.6.3.1.cmml" xref="S3.SS1.p5.2.m1.6.6.6.3.1"></plus><ci id="S3.SS1.p5.2.m1.6.6.6.3.2.cmml" xref="S3.SS1.p5.2.m1.6.6.6.3.2">𝑡</ci><cn id="S3.SS1.p5.2.m1.6.6.6.3.3.cmml" type="integer" xref="S3.SS1.p5.2.m1.6.6.6.3.3">1</cn></apply></apply><vector id="S3.SS1.p5.2.m1.6.6.4.5.cmml" xref="S3.SS1.p5.2.m1.6.6.4.4"><apply id="S3.SS1.p5.2.m1.3.3.1.1.1.cmml" xref="S3.SS1.p5.2.m1.3.3.1.1.1"><csymbol cd="ambiguous" id="S3.SS1.p5.2.m1.3.3.1.1.1.1.cmml" xref="S3.SS1.p5.2.m1.3.3.1.1.1">subscript</csymbol><ci id="S3.SS1.p5.2.m1.3.3.1.1.1.2.cmml" xref="S3.SS1.p5.2.m1.3.3.1.1.1.2">𝑥</ci><cn id="S3.SS1.p5.2.m1.3.3.1.1.1.3.cmml" type="integer" xref="S3.SS1.p5.2.m1.3.3.1.1.1.3">0</cn></apply><ci id="S3.SS1.p5.2.m1.1.1.cmml" xref="S3.SS1.p5.2.m1.1.1">…</ci><apply id="S3.SS1.p5.2.m1.4.4.2.2.2.cmml" xref="S3.SS1.p5.2.m1.4.4.2.2.2"><csymbol cd="ambiguous" id="S3.SS1.p5.2.m1.4.4.2.2.2.1.cmml" xref="S3.SS1.p5.2.m1.4.4.2.2.2">subscript</csymbol><ci id="S3.SS1.p5.2.m1.4.4.2.2.2.2.cmml" xref="S3.SS1.p5.2.m1.4.4.2.2.2.2">𝑥</ci><ci id="S3.SS1.p5.2.m1.4.4.2.2.2.3.cmml" xref="S3.SS1.p5.2.m1.4.4.2.2.2.3">𝑚</ci></apply><apply id="S3.SS1.p5.2.m1.5.5.3.3.3.cmml" xref="S3.SS1.p5.2.m1.5.5.3.3.3"><csymbol cd="ambiguous" id="S3.SS1.p5.2.m1.5.5.3.3.3.1.cmml" xref="S3.SS1.p5.2.m1.5.5.3.3.3">subscript</csymbol><ci id="S3.SS1.p5.2.m1.5.5.3.3.3.2.cmml" xref="S3.SS1.p5.2.m1.5.5.3.3.3.2">𝑦</ci><cn id="S3.SS1.p5.2.m1.5.5.3.3.3.3.cmml" type="integer" xref="S3.SS1.p5.2.m1.5.5.3.3.3.3">0</cn></apply><ci id="S3.SS1.p5.2.m1.2.2.cmml" xref="S3.SS1.p5.2.m1.2.2">…</ci><apply id="S3.SS1.p5.2.m1.6.6.4.4.4.cmml" xref="S3.SS1.p5.2.m1.6.6.4.4.4"><csymbol cd="ambiguous" id="S3.SS1.p5.2.m1.6.6.4.4.4.1.cmml" xref="S3.SS1.p5.2.m1.6.6.4.4.4">subscript</csymbol><ci id="S3.SS1.p5.2.m1.6.6.4.4.4.2.cmml" xref="S3.SS1.p5.2.m1.6.6.4.4.4.2">𝑦</ci><apply id="S3.SS1.p5.2.m1.6.6.4.4.4.3.cmml" xref="S3.SS1.p5.2.m1.6.6.4.4.4.3"><plus id="S3.SS1.p5.2.m1.6.6.4.4.4.3.1.cmml" xref="S3.SS1.p5.2.m1.6.6.4.4.4.3.1"></plus><ci id="S3.SS1.p5.2.m1.6.6.4.4.4.3.2.cmml" xref="S3.SS1.p5.2.m1.6.6.4.4.4.3.2">𝑡</ci><cn id="S3.SS1.p5.2.m1.6.6.4.4.4.3.3.cmml" type="integer" xref="S3.SS1.p5.2.m1.6.6.4.4.4.3.3">1</cn></apply></apply></vector></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.SS1.p5.2.m1.6c">s_{t+1}=(x_{0},\dots,x_{m},y_{0},\dots,y_{t+1})</annotation><annotation encoding="application/x-llamapun" id="S3.SS1.p5.2.m1.6d">italic_s start_POSTSUBSCRIPT italic_t + 1 end_POSTSUBSCRIPT = ( italic_x start_POSTSUBSCRIPT 0 end_POSTSUBSCRIPT , … , italic_x start_POSTSUBSCRIPT italic_m end_POSTSUBSCRIPT , italic_y start_POSTSUBSCRIPT 0 end_POSTSUBSCRIPT , … , italic_y start_POSTSUBSCRIPT italic_t + 1 end_POSTSUBSCRIPT )</annotation></semantics></math>.</p>
</div>
<div class="ltx_para" id="S3.SS1.p6">
<p class="ltx_p" id="S3.SS1.p6.1"><span class="ltx_text ltx_font_bold" id="S3.SS1.p6.1.1">Reward (<math alttext="r" class="ltx_Math" display="inline" id="S3.SS1.p6.1.1.m1.1"><semantics id="S3.SS1.p6.1.1.m1.1a"><mi id="S3.SS1.p6.1.1.m1.1.1" xref="S3.SS1.p6.1.1.m1.1.1.cmml">r</mi><annotation-xml encoding="MathML-Content" id="S3.SS1.p6.1.1.m1.1b"><ci id="S3.SS1.p6.1.1.m1.1.1.cmml" xref="S3.SS1.p6.1.1.m1.1.1">𝑟</ci></annotation-xml><annotation encoding="application/x-tex" id="S3.SS1.p6.1.1.m1.1c">r</annotation><annotation encoding="application/x-llamapun" id="S3.SS1.p6.1.1.m1.1d">italic_r</annotation></semantics></math>):</span> Rewards are typically sparse, provided only at the end of a complete rollout, limiting intermediate feedback and posing challenges for effective exploration <cite class="ltx_cite ltx_citemacro_citep">[<a class="ltx_ref" href="https://arxiv.org/html/2507.07017v1#bib.bib25" title="">25</a>]</cite>.</p>
</div>
</section>
<section class="ltx_subsection" id="S3.SS2">
<h3 class="ltx_title ltx_title_subsection">
<span class="ltx_tag ltx_tag_subsection">3.2 </span>Rejection Sampling</h3>
<div class="ltx_para" id="S3.SS2.p1">
<p class="ltx_p" id="S3.SS2.p1.1">In the stage of advantage estimating, when a prompt consistently yields trajectories with identical rewards, either all correct (reward = 1) or all incorrect (reward = 0), the corresponding advantage estimates become zero. This leads to vanishing policy gradients and results in reduced sample efficiency. As training progresses, more prompts fall into this degenerate category, causing the effective batch size to shrink and increasing the variance of gradient estimates.</p>
</div>
<div class="ltx_para" id="S3.SS2.p2">
<p class="ltx_p" id="S3.SS2.p2.1">To mitigate this issue during our <span class="ltx_text ltx_font_italic" id="S3.SS2.p2.1.1">entropy finding</span> phase—which aims to identify uncertain reasoning positions for structured exploration—we employ <span class="ltx_text ltx_font_italic" id="S3.SS2.p2.1.2">rejection sampling</span> <cite class="ltx_cite ltx_citemacro_citep">[<a class="ltx_ref" href="https://arxiv.org/html/2507.07017v1#bib.bib36" title="">36</a>, <a class="ltx_ref" href="https://arxiv.org/html/2507.07017v1#bib.bib39" title="">39</a>]</cite>. Specifically, for each prompt, we perform multiple rollouts and compute their corresponding binary rewards. If all rollouts yield the same reward (i.e., either all 0s or all 1s), the prompt is considered degenerate and is rejected from the current batch. This ensures that the entropy-finding process operates on diverse and informative reasoning trajectories, rather than being misled by degenerate cases with no variation in reward.</p>
</div>
</section>
<section class="ltx_subsection" id="S3.SS3">
<h3 class="ltx_title ltx_title_subsection">
<span class="ltx_tag ltx_tag_subsection">3.3 </span>Clip-Higher</h3>
<div class="ltx_para" id="S3.SS3.p1">
<p class="ltx_p" id="S3.SS3.p1.2">Standard PPO-based reinforcement learning constrains policy updates using symmetric clipping bounds, typically limiting the probability ratio <math alttext="r_{i,t}(\theta)" class="ltx_Math" display="inline" id="S3.SS3.p1.1.m1.3"><semantics id="S3.SS3.p1.1.m1.3a"><mrow id="S3.SS3.p1.1.m1.3.4" xref="S3.SS3.p1.1.m1.3.4.cmml"><msub id="S3.SS3.p1.1.m1.3.4.2" xref="S3.SS3.p1.1.m1.3.4.2.cmml"><mi id="S3.SS3.p1.1.m1.3.4.2.2" xref="S3.SS3.p1.1.m1.3.4.2.2.cmml">r</mi><mrow id="S3.SS3.p1.1.m1.2.2.2.4" xref="S3.SS3.p1.1.m1.2.2.2.3.cmml"><mi id="S3.SS3.p1.1.m1.1.1.1.1" xref="S3.SS3.p1.1.m1.1.1.1.1.cmml">i</mi><mo id="S3.SS3.p1.1.m1.2.2.2.4.1" xref="S3.SS3.p1.1.m1.2.2.2.3.cmml">,</mo><mi id="S3.SS3.p1.1.m1.2.2.2.2" xref="S3.SS3.p1.1.m1.2.2.2.2.cmml">t</mi></mrow></msub><mo id="S3.SS3.p1.1.m1.3.4.1" xref="S3.SS3.p1.1.m1.3.4.1.cmml">⁢</mo><mrow id="S3.SS3.p1.1.m1.3.4.3.2" xref="S3.SS3.p1.1.m1.3.4.cmml"><mo id="S3.SS3.p1.1.m1.3.4.3.2.1" stretchy="false" xref="S3.SS3.p1.1.m1.3.4.cmml">(</mo><mi id="S3.SS3.p1.1.m1.3.3" xref="S3.SS3.p1.1.m1.3.3.cmml">θ</mi><mo id="S3.SS3.p1.1.m1.3.4.3.2.2" stretchy="false" xref="S3.SS3.p1.1.m1.3.4.cmml">)</mo></mrow></mrow><annotation-xml encoding="MathML-Content" id="S3.SS3.p1.1.m1.3b"><apply id="S3.SS3.p1.1.m1.3.4.cmml" xref="S3.SS3.p1.1.m1.3.4"><times id="S3.SS3.p1.1.m1.3.4.1.cmml" xref="S3.SS3.p1.1.m1.3.4.1"></times><apply id="S3.SS3.p1.1.m1.3.4.2.cmml" xref="S3.SS3.p1.1.m1.3.4.2"><csymbol cd="ambiguous" id="S3.SS3.p1.1.m1.3.4.2.1.cmml" xref="S3.SS3.p1.1.m1.3.4.2">subscript</csymbol><ci id="S3.SS3.p1.1.m1.3.4.2.2.cmml" xref="S3.SS3.p1.1.m1.3.4.2.2">𝑟</ci><list id="S3.SS3.p1.1.m1.2.2.2.3.cmml" xref="S3.SS3.p1.1.m1.2.2.2.4"><ci id="S3.SS3.p1.1.m1.1.1.1.1.cmml" xref="S3.SS3.p1.1.m1.1.1.1.1">𝑖</ci><ci id="S3.SS3.p1.1.m1.2.2.2.2.cmml" xref="S3.SS3.p1.1.m1.2.2.2.2">𝑡</ci></list></apply><ci id="S3.SS3.p1.1.m1.3.3.cmml" xref="S3.SS3.p1.1.m1.3.3">𝜃</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.SS3.p1.1.m1.3c">r_{i,t}(\theta)</annotation><annotation encoding="application/x-llamapun" id="S3.SS3.p1.1.m1.3d">italic_r start_POSTSUBSCRIPT italic_i , italic_t end_POSTSUBSCRIPT ( italic_θ )</annotation></semantics></math> within <math alttext="[0.8,1.2]" class="ltx_Math" display="inline" id="S3.SS3.p1.2.m2.2"><semantics id="S3.SS3.p1.2.m2.2a"><mrow id="S3.SS3.p1.2.m2.2.3.2" xref="S3.SS3.p1.2.m2.2.3.1.cmml"><mo id="S3.SS3.p1.2.m2.2.3.2.1" stretchy="false" xref="S3.SS3.p1.2.m2.2.3.1.cmml">[</mo><mn id="S3.SS3.p1.2.m2.1.1" xref="S3.SS3.p1.2.m2.1.1.cmml">0.8</mn><mo id="S3.SS3.p1.2.m2.2.3.2.2" xref="S3.SS3.p1.2.m2.2.3.1.cmml">,</mo><mn id="S3.SS3.p1.2.m2.2.2" xref="S3.SS3.p1.2.m2.2.2.cmml">1.2</mn><mo id="S3.SS3.p1.2.m2.2.3.2.3" stretchy="false" xref="S3.SS3.p1.2.m2.2.3.1.cmml">]</mo></mrow><annotation-xml encoding="MathML-Content" id="S3.SS3.p1.2.m2.2b"><interval closure="closed" id="S3.SS3.p1.2.m2.2.3.1.cmml" xref="S3.SS3.p1.2.m2.2.3.2"><cn id="S3.SS3.p1.2.m2.1.1.cmml" type="float" xref="S3.SS3.p1.2.m2.1.1">0.8</cn><cn id="S3.SS3.p1.2.m2.2.2.cmml" type="float" xref="S3.SS3.p1.2.m2.2.2">1.2</cn></interval></annotation-xml><annotation encoding="application/x-tex" id="S3.SS3.p1.2.m2.2c">[0.8,1.2]</annotation><annotation encoding="application/x-llamapun" id="S3.SS3.p1.2.m2.2d">[ 0.8 , 1.2 ]</annotation></semantics></math> to prevent unstable updates. However, this symmetric structure also suppresses the probability growth of low-confidence tokens, which hinders exploration and can lead to <span class="ltx_text ltx_font_italic" id="S3.SS3.p1.2.1">entropy collapse</span>—a state where the policy becomes overly deterministic and loses action diversity.</p>
</div>
<div class="ltx_para" id="S3.SS3.p2">
<p class="ltx_p" id="S3.SS3.p2.2">To address this issue and explicitly encourage exploration, we adopt the <span class="ltx_text ltx_font_italic" id="S3.SS3.p2.2.1">Clip-Higher</span> mechanism <cite class="ltx_cite ltx_citemacro_citep">[<a class="ltx_ref" href="https://arxiv.org/html/2507.07017v1#bib.bib37" title="">37</a>]</cite>, which replaces symmetric clipping with asymmetric bounds that permit more substantial increases in the probability of underexplored but potentially valuable reasoning paths, while still limiting overly aggressive decreases. This asymmetry encourages the policy to better explore less probable trajectories without sacrificing training stability. Empirical validation in our setting shows that this design improves both exploration efficiency and learning robustness. We use <math alttext="\epsilon_{\text{low}}=0.22" class="ltx_Math" display="inline" id="S3.SS3.p2.1.m1.1"><semantics id="S3.SS3.p2.1.m1.1a"><mrow id="S3.SS3.p2.1.m1.1.1" xref="S3.SS3.p2.1.m1.1.1.cmml"><msub id="S3.SS3.p2.1.m1.1.1.2" xref="S3.SS3.p2.1.m1.1.1.2.cmml"><mi id="S3.SS3.p2.1.m1.1.1.2.2" xref="S3.SS3.p2.1.m1.1.1.2.2.cmml">ϵ</mi><mtext id="S3.SS3.p2.1.m1.1.1.2.3" xref="S3.SS3.p2.1.m1.1.1.2.3a.cmml">low</mtext></msub><mo id="S3.SS3.p2.1.m1.1.1.1" xref="S3.SS3.p2.1.m1.1.1.1.cmml">=</mo><mn id="S3.SS3.p2.1.m1.1.1.3" xref="S3.SS3.p2.1.m1.1.1.3.cmml">0.22</mn></mrow><annotation-xml encoding="MathML-Content" id="S3.SS3.p2.1.m1.1b"><apply id="S3.SS3.p2.1.m1.1.1.cmml" xref="S3.SS3.p2.1.m1.1.1"><eq id="S3.SS3.p2.1.m1.1.1.1.cmml" xref="S3.SS3.p2.1.m1.1.1.1"></eq><apply id="S3.SS3.p2.1.m1.1.1.2.cmml" xref="S3.SS3.p2.1.m1.1.1.2"><csymbol cd="ambiguous" id="S3.SS3.p2.1.m1.1.1.2.1.cmml" xref="S3.SS3.p2.1.m1.1.1.2">subscript</csymbol><ci id="S3.SS3.p2.1.m1.1.1.2.2.cmml" xref="S3.SS3.p2.1.m1.1.1.2.2">italic-ϵ</ci><ci id="S3.SS3.p2.1.m1.1.1.2.3a.cmml" xref="S3.SS3.p2.1.m1.1.1.2.3"><mtext id="S3.SS3.p2.1.m1.1.1.2.3.cmml" mathsize="70%" xref="S3.SS3.p2.1.m1.1.1.2.3">low</mtext></ci></apply><cn id="S3.SS3.p2.1.m1.1.1.3.cmml" type="float" xref="S3.SS3.p2.1.m1.1.1.3">0.22</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.SS3.p2.1.m1.1c">\epsilon_{\text{low}}=0.22</annotation><annotation encoding="application/x-llamapun" id="S3.SS3.p2.1.m1.1d">italic_ϵ start_POSTSUBSCRIPT low end_POSTSUBSCRIPT = 0.22</annotation></semantics></math> and <math alttext="\epsilon_{\text{high}}=0.28" class="ltx_Math" display="inline" id="S3.SS3.p2.2.m2.1"><semantics id="S3.SS3.p2.2.m2.1a"><mrow id="S3.SS3.p2.2.m2.1.1" xref="S3.SS3.p2.2.m2.1.1.cmml"><msub id="S3.SS3.p2.2.m2.1.1.2" xref="S3.SS3.p2.2.m2.1.1.2.cmml"><mi id="S3.SS3.p2.2.m2.1.1.2.2" xref="S3.SS3.p2.2.m2.1.1.2.2.cmml">ϵ</mi><mtext id="S3.SS3.p2.2.m2.1.1.2.3" xref="S3.SS3.p2.2.m2.1.1.2.3a.cmml">high</mtext></msub><mo id="S3.SS3.p2.2.m2.1.1.1" xref="S3.SS3.p2.2.m2.1.1.1.cmml">=</mo><mn id="S3.SS3.p2.2.m2.1.1.3" xref="S3.SS3.p2.2.m2.1.1.3.cmml">0.28</mn></mrow><annotation-xml encoding="MathML-Content" id="S3.SS3.p2.2.m2.1b"><apply id="S3.SS3.p2.2.m2.1.1.cmml" xref="S3.SS3.p2.2.m2.1.1"><eq id="S3.SS3.p2.2.m2.1.1.1.cmml" xref="S3.SS3.p2.2.m2.1.1.1"></eq><apply id="S3.SS3.p2.2.m2.1.1.2.cmml" xref="S3.SS3.p2.2.m2.1.1.2"><csymbol cd="ambiguous" id="S3.SS3.p2.2.m2.1.1.2.1.cmml" xref="S3.SS3.p2.2.m2.1.1.2">subscript</csymbol><ci id="S3.SS3.p2.2.m2.1.1.2.2.cmml" xref="S3.SS3.p2.2.m2.1.1.2.2">italic-ϵ</ci><ci id="S3.SS3.p2.2.m2.1.1.2.3a.cmml" xref="S3.SS3.p2.2.m2.1.1.2.3"><mtext id="S3.SS3.p2.2.m2.1.1.2.3.cmml" mathsize="70%" xref="S3.SS3.p2.2.m2.1.1.2.3">high</mtext></ci></apply><cn id="S3.SS3.p2.2.m2.1.1.3.cmml" type="float" xref="S3.SS3.p2.2.m2.1.1.3">0.28</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.SS3.p2.2.m2.1c">\epsilon_{\text{high}}=0.28</annotation><annotation encoding="application/x-llamapun" id="S3.SS3.p2.2.m2.1d">italic_ϵ start_POSTSUBSCRIPT high end_POSTSUBSCRIPT = 0.28</annotation></semantics></math>, yielding the objective:</p>
<table class="ltx_equation ltx_eqn_table" id="S3.E2">
<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math alttext="\mathcal{L}_{\text{PPO}}(\theta)=-\frac{1}{\sum_{i=1}^{G}|o_{i}|}\sum_{i=1}^{G%
}\sum_{t=1}^{|o_{i}|}\min\left(r_{i,t}(\theta)\hat{A}_{i,t},\leavevmode%
\nobreak\ \text{clip}(r_{i,t}(\theta),1-\epsilon_{\text{low}},1+\epsilon_{%
\text{high}})\hat{A}_{i,t}\right)" class="ltx_Math" display="block" id="S3.E2.m1.16"><semantics id="S3.E2.m1.16a"><mrow id="S3.E2.m1.16.16" xref="S3.E2.m1.16.16.cmml"><mrow id="S3.E2.m1.16.16.4" xref="S3.E2.m1.16.16.4.cmml"><msub id="S3.E2.m1.16.16.4.2" xref="S3.E2.m1.16.16.4.2.cmml"><mi class="ltx_font_mathcaligraphic" id="S3.E2.m1.16.16.4.2.2" xref="S3.E2.m1.16.16.4.2.2.cmml">ℒ</mi><mtext id="S3.E2.m1.16.16.4.2.3" xref="S3.E2.m1.16.16.4.2.3a.cmml">PPO</mtext></msub><mo id="S3.E2.m1.16.16.4.1" xref="S3.E2.m1.16.16.4.1.cmml">⁢</mo><mrow id="S3.E2.m1.16.16.4.3.2" xref="S3.E2.m1.16.16.4.cmml"><mo id="S3.E2.m1.16.16.4.3.2.1" stretchy="false" xref="S3.E2.m1.16.16.4.cmml">(</mo><mi id="S3.E2.m1.11.11" xref="S3.E2.m1.11.11.cmml">θ</mi><mo id="S3.E2.m1.16.16.4.3.2.2" stretchy="false" xref="S3.E2.m1.16.16.4.cmml">)</mo></mrow></mrow><mo id="S3.E2.m1.16.16.3" xref="S3.E2.m1.16.16.3.cmml">=</mo><mrow id="S3.E2.m1.16.16.2" xref="S3.E2.m1.16.16.2.cmml"><mo id="S3.E2.m1.16.16.2a" xref="S3.E2.m1.16.16.2.cmml">−</mo><mrow id="S3.E2.m1.16.16.2.2" xref="S3.E2.m1.16.16.2.2.cmml"><mfrac id="S3.E2.m1.1.1" xref="S3.E2.m1.1.1.cmml"><mn id="S3.E2.m1.1.1.3" xref="S3.E2.m1.1.1.3.cmml">1</mn><mrow id="S3.E2.m1.1.1.1" xref="S3.E2.m1.1.1.1.cmml"><msubsup id="S3.E2.m1.1.1.1.2" xref="S3.E2.m1.1.1.1.2.cmml"><mo id="S3.E2.m1.1.1.1.2.2.2" xref="S3.E2.m1.1.1.1.2.2.2.cmml">∑</mo><mrow id="S3.E2.m1.1.1.1.2.2.3" xref="S3.E2.m1.1.1.1.2.2.3.cmml"><mi id="S3.E2.m1.1.1.1.2.2.3.2" xref="S3.E2.m1.1.1.1.2.2.3.2.cmml">i</mi><mo id="S3.E2.m1.1.1.1.2.2.3.1" xref="S3.E2.m1.1.1.1.2.2.3.1.cmml">=</mo><mn id="S3.E2.m1.1.1.1.2.2.3.3" xref="S3.E2.m1.1.1.1.2.2.3.3.cmml">1</mn></mrow><mi id="S3.E2.m1.1.1.1.2.3" xref="S3.E2.m1.1.1.1.2.3.cmml">G</mi></msubsup><mrow id="S3.E2.m1.1.1.1.1.1" xref="S3.E2.m1.1.1.1.1.2.cmml"><mo id="S3.E2.m1.1.1.1.1.1.2" lspace="0em" stretchy="false" xref="S3.E2.m1.1.1.1.1.2.1.cmml">|</mo><msub id="S3.E2.m1.1.1.1.1.1.1" xref="S3.E2.m1.1.1.1.1.1.1.cmml"><mi id="S3.E2.m1.1.1.1.1.1.1.2" xref="S3.E