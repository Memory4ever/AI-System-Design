</figure>
<figure id="S4.F6" class="ltx_figure"><img src="2507.06710v1/hyper.png" id="S4.F6.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:685/294;" width="685" height="294" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S4.F6.4" class="ltx_text" style="font-size:90%;">Figure 6</span>: </span><span id="S4.F6.5" class="ltx_text ltx_font_bold" style="font-size:90%;">Hyperparameter analysis of DP4.<span id="S4.F6.5.1" class="ltx_text ltx_font_medium"> The effects of <math id="S4.F6.m3" class="ltx_Math" alttext="\lambda_{\text{3D}}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mtext>3D</mtext></msub><annotation encoding="application/x-tex">\lambda_{\text{3D}}</annotation></semantics></math> and <math id="S4.F6.m4" class="ltx_Math" alttext="\lambda_{\text{4D}}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mtext>4D</mtext></msub><annotation encoding="application/x-tex">\lambda_{\text{4D}}</annotation></semantics></math> on success rates, respectively.
</span></span></figcaption>
</figure>
<figure id="S4.T5" class="ltx_table">
<table id="S4.T5.3" class="ltx_tabular ltx_centering ltx_align_middle">
<tr id="S4.T5.3.1" class="ltx_tr">
<td id="S4.T5.3.1.1" class="ltx_td ltx_align_left ltx_border_tt" style="padding-left:7.2pt;padding-right:7.2pt;"><span id="S4.T5.3.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Method</span></td>
<td id="S4.T5.3.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:7.2pt;padding-right:7.2pt;"><span id="S4.T5.3.1.2.1" class="ltx_text"></span><span id="S4.T5.3.1.2.2" class="ltx_text" style="font-size:90%;"> <span id="S4.T5.3.1.2.2.1" class="ltx_text">
<span id="S4.T5.3.1.2.2.1.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T5.3.1.2.2.1.1.1" class="ltx_tr">
<span id="S4.T5.3.1.2.2.1.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:7.2pt;padding-right:7.2pt;"><span id="S4.T5.3.1.2.2.1.1.1.1.1" class="ltx_text ltx_font_italic">Grasping</span></span></span>
