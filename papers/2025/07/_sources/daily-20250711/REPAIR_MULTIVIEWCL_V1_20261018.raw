<td id="S5.T5.5.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S5.T5.5.1.4.1" class="ltx_text ltx_font_bold">256</span></td>
<td id="S5.T5.5.1.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S5.T5.5.1.5.1" class="ltx_text ltx_font_bold">Deviation</span></td></tr>
