<div id="S5.F3.fig4.1" class="ltx_inline-block ltx_transformed_outer" style="width:82.8pt;height:69.3pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="transform:translate(-273.6pt,229.1pt) scale(0.131449449951234,0.131449449951234) ;"><object type="image/svg+xml" data="2507.06979v1/x4.svg" id="S5.F3.g8" class="ltx_graphics ltx_img_square" style="width:62.991em; height:52.757em;aspect-ratio:837/701;" width="837" height="701"></object>
</span></div>
<figcaption class="ltx_caption">(d) Alignment</figcaption>
