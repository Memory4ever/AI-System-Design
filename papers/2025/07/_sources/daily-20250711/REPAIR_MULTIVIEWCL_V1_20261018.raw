<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ax1.E18.m1" class="ltx_Math" alttext="\begin{split}L_{\textnormal{MV-DHEL}}(\bm{\mathsfit{U}})&amp;=\frac{1}{M}\sum_{i\in[M]}-\log{\sum_{l\in[N]\atop{\color[rgb]{0.1328,0.5469,0.1328}l^{\prime}\in[N]\setminus l}}K(\bm{\mathsfit{U}}_{i,l,:}^{\top}\bm{\mathsfit{U}}_{i,{\color[rgb]{0.1328,0.5469,0.1328}l^{\prime}},:})}+\frac{1}{M}\sum_{l\in[N]\atop i\in[M]}\log{\sum_{{\color[rgb]{0.6992,0.1328,0.1328}j\in[M]\setminus i}}K(\bm{\mathsfit{U}}_{i,l,:}^{\top}\bm{\mathsfit{U}}_{{\color[rgb]{0.6992,0.1328,0.1328}j,l},:})}\\
&amp;=\frac{1}{M}\sum_{i=1}^{M}-\log\left(\frac{\sum_{l\in[N]\atop{\color[rgb]{0.1328,0.5469,0.1328}l^{\prime}\in[N]\setminus l}}^{N}e^{\bm{\mathsfit{U}}_{i,l,:}^{\top}\bm{\mathsfit{U}}_{i,{\color[rgb]{0.1328,0.5469,0.1328}l^{\prime}},:}{/\tau}}}{\prod_{l\in[N]}\sum_{{{\color[rgb]{0.6992,0.1328,0.1328}j\in[M]}}}e^{\bm{\mathsfit{U}}_{i,l,:}^{\top}\bm{\mathsfit{U}}_{{\color[rgb]{0.6992,0.1328,0.1328}j,m,}:}{/\tau}}}\right)\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msub><mi>L</mi><mtext>MV-DHEL</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑼</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>=</mo><mfrac><mn>1</mn><mi>M</mi></mfrac><mo movablelimits="false" rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0em">−</mo><mi>log</mi><mo movablelimits="false">∑</mo><msub><mrow></mrow><mfrac linethickness="0pt"><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mrow><msup><mi style="--ltx-fg-color:#228B22;" mathcolor="#228B22">l</mi><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">′</mo></msup><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">∈</mo><mrow><mrow><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22" stretchy="false">[</mo><mi style="--ltx-fg-color:#228B22;" mathcolor="#228B22">N</mi><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22" stretchy="false">]</mo></mrow><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">∖</mo><mi style="--ltx-fg-color:#228B22;" mathcolor="#228B22">l</mi></mrow></mrow></mfrac></msub><mi>K</mi><mo stretchy="false">(</mo><mi>𝑼</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>l</mi><mo>,</mo><mo>:</mo></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝑼</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi style="--ltx-fg-color:#228B22;" mathcolor="#228B22">l</mi><msup><mrow></mrow><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">′</mo></msup><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">)</mo><mo>+</mo><mfrac><mn>1</mn><mi>M</mi></mfrac><mo movablelimits="false">∑</mo><msub><mrow></mrow><mfrac linethickness="0pt"><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></mfrac></msub><mi>log</mi><mo movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">j</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222">∈</mo><mrow><mrow><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222" stretchy="false">[</mo><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">M</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222" stretchy="false">]</mo></mrow><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222">∖</mo><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">i</mi></mrow></mrow></msub><mi>K</mi><mo stretchy="false">(</mo><mi>𝑼</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>l</mi><mo>,</mo><mo>:</mo></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝑼</mi><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">j</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222">,</mo><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">l</mi><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>=</mo><mfrac><mn>1</mn><mi>M</mi></mfrac><mo movablelimits="false" rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>M</mi></msup><mo lspace="0em">−</mo><mi>log</mi><mo>(</mo><mfrac><mrow><mo>∑</mo><msub><mrow></mrow><mfrac linethickness="0pt"><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mrow><msup><mi style="--ltx-fg-color:#228B22;" mathcolor="#228B22">l</mi><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">′</mo></msup><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">∈</mo><mrow><mrow><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22" stretchy="false">[</mo><mi style="--ltx-fg-color:#228B22;" mathcolor="#228B22">N</mi><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22" stretchy="false">]</mo></mrow><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">∖</mo><mi style="--ltx-fg-color:#228B22;" mathcolor="#228B22">l</mi></mrow></mrow></mfrac></msub><msup><mrow></mrow><mi>N</mi></msup><mi>e</mi><msup><mrow></mrow><mrow><mi>𝑼</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>l</mi><mo>,</mo><mo>:</mo></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝑼</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi style="--ltx-fg-color:#228B22;" mathcolor="#228B22">l</mi><msup><mrow></mrow><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">′</mo></msup><mo>,</mo><mo>:</mo></mrow></msub><mo>/</mo><mi>τ</mi></mrow></msup></mrow><mrow><mo rspace="0em">∏</mo><msub><mrow></mrow><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo>∑</mo><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">j</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222">∈</mo><mrow><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222" stretchy="false">[</mo><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">M</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222" stretchy="false">]</mo></mrow></mrow></msub><mi>e</mi><msup><mrow></mrow><mrow><mi>𝑼</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>l</mi><mo>,</mo><mo>:</mo></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝑼</mi><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">j</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222">,</mo><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">m</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222">,</mo><mo>:</mo></mrow></msub><mo>/</mo><mi>τ</mi></mrow></msup></mrow></mfrac><mo>)</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}L_{\textnormal{MV-DHEL}}(\bm{\mathsfit{U}})&amp;=\frac{1}{M}\sum_{i\in[M]}-\log{\sum_{l\in[N]\atop{\color[rgb]{0.1328,0.5469,0.1328}l^{\prime}\in[N]\setminus l}}K(\bm{\mathsfit{U}}_{i,l,:}^{\top}\bm{\mathsfit{U}}_{i,{\color[rgb]{0.1328,0.5469,0.1328}l^{\prime}},:})}+\frac{1}{M}\sum_{l\in[N]\atop i\in[M]}\log{\sum_{{\color[rgb]{0.6992,0.1328,0.1328}j\in[M]\setminus i}}K(\bm{\mathsfit{U}}_{i,l,:}^{\top}\bm{\mathsfit{U}}_{{\color[rgb]{0.6992,0.1328,0.1328}j,l},:})}\\
&amp;=\frac{1}{M}\sum_{i=1}^{M}-\log\left(\frac{\sum_{l\in[N]\atop{\color[rgb]{0.1328,0.5469,0.1328}l^{\prime}\in[N]\setminus l}}^{N}e^{\bm{\mathsfit{U}}_{i,l,:}^{\top}\bm{\mathsfit{U}}_{i,{\color[rgb]{0.1328,0.5469,0.1328}l^{\prime}},:}{/\tau}}}{\prod_{l\in[N]}\sum_{{{\color[rgb]{0.6992,0.1328,0.1328}j\in[M]}}}e^{\bm{\mathsfit{U}}_{i,l,:}^{\top}\bm{\mathsfit{U}}_{{\color[rgb]{0.6992,0.1328,0.1328}j,m,}:}{/\tau}}}\right)\end{split}</annotation></semantics></math></td>
