<td id="S3.T1.8.1.2.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t"><math id="S3.T1.m5" class="ltx_Math" alttext="\displaystyle\frac{2}{N(N-1)M}\sum_{\begin{subarray}{c}{\color[rgb]{0,0.3906,0.7852}l\in[N]}\\
m\in[N],m&gt;{\color[rgb]{0,0.3906,0.7852}l}\\
i\in[M]\end{subarray}}\log\left(\frac{e^{\bm{\mathsfit{U}}_{i,{\color[rgb]{0,0.3906,0.7852}l}}^{\top}\bm{\mathsfit{U}}_{i,{\color[rgb]{0.1328,0.5469,0.1328}m}}/\tau}}{\sum_{{\color[rgb]{0.6992,0.1328,0.1328}j\in[M]}}e^{\bm{\mathsfit{U}}_{i,{\color[rgb]{0,0.3906,0.7852}l}}^{\top}\bm{\mathsfit{U}}_{{\color[rgb]{0.6992,0.1328,0.1328}j,m}}/\tau}}\right)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mrow><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi style="--ltx-fg-color:#0064C8;" mathcolor="#0064C8">l</mi><mo style="--ltx-fg-color:#0064C8;" mathcolor="#0064C8">∈</mo><mrow><mo style="--ltx-fg-color:#0064C8;" mathcolor="#0064C8" stretchy="false">[</mo><mi style="--ltx-fg-color:#0064C8;" mathcolor="#0064C8">N</mi><mo style="--ltx-fg-color:#0064C8;" mathcolor="#0064C8" stretchy="false">]</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">m</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">m</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&gt;</mo><mi style="--ltx-fg-color:#0064C8;" mathcolor="#0064C8">l</mi></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></mtd></mtr></mtable></munder></mstyle><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mrow><msubsup><mi>𝑼</mi><mrow><mi>i</mi><mo>,</mo><mi style="--ltx-fg-color:#0064C8;" mathcolor="#0064C8">l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑼</mi><mrow><mi>i</mi><mo>,</mo><mi style="--ltx-fg-color:#228B22;" mathcolor="#228B22">m</mi></mrow></msub></mrow><mo>/</mo><mi>τ</mi></mrow></msup><mrow><msub><mo>∑</mo><mrow><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">j</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222">∈</mo><mrow><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222" stretchy="false">[</mo><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">M</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222" stretchy="false">]</mo></mrow></mrow></msub><msup><mi>e</mi><mrow><mrow><msubsup><mi>𝑼</mi><mrow><mi>i</mi><mo>,</mo><mi style="--ltx-fg-color:#0064C8;" mathcolor="#0064C8">l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑼</mi><mrow><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">j</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222">,</mo><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">m</mi></mrow></msub></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{2}{N(N-1)M}\sum_{\begin{subarray}{c}{\color[rgb]{0,0.3906,0.7852}l\in[N]}\\
m\in[N],m&gt;{\color[rgb]{0,0.3906,0.7852}l}\\
i\in[M]\end{subarray}}\log\left(\frac{e^{\bm{\mathsfit{U}}_{i,{\color[rgb]{0,0.3906,0.7852}l}}^{\top}\bm{\mathsfit{U}}_{i,{\color[rgb]{0.1328,0.5469,0.1328}m}}/\tau}}{\sum_{{\color[rgb]{0.6992,0.1328,0.1328}j\in[M]}}e^{\bm{\mathsfit{U}}_{i,{\color[rgb]{0,0.3906,0.7852}l}}^{\top}\bm{\mathsfit{U}}_{{\color[rgb]{0.6992,0.1328,0.1328}j,m}}/\tau}}\right)</annotation></semantics></math></td>
<td id="S3.T1.8.1.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="S3.T1.m6" class="ltx_Math" alttext="\mathcal{O}(M^{2}N^{2})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>M</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(M^{2}N^{2})</annotation></semantics></math></td>
