<td id="S3.T1.8.1.3.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t"><math id="S3.T1.m8" class="ltx_Math" alttext="\displaystyle\frac{-1}{(N-1)M}\sum_{\begin{subarray}{c}{\color[rgb]{0,0.3906,0.7852}l\in[N]}\\
{\color[rgb]{0.1328,0.5469,0.1328}l^{\prime}\in[N]\setminus{\color[rgb]{0,0.3906,0.7852}l}}\\
i\in[M]\end{subarray}}\log\left(\frac{e^{\bm{\mathsfit{U}}_{i,{\color[rgb]{0,0.3906,0.7852}l}}^{\top}\bm{\mathsfit{U}}_{i,{\color[rgb]{0.1328,0.5469,0.1328}l^{\prime}}}/\tau}}{e^{\bm{\mathsfit{U}}_{i,{\color[rgb]{0,0.3906,0.7852}l}}^{\top}\bm{\mathsfit{U}}_{i,{\color[rgb]{0.1328,0.5469,0.1328}l^{\prime}}}/\tau}+\sum_{\begin{subarray}{c}{\color[rgb]{0.6992,0.1328,0.1328}m\in[N]}\\
{\color[rgb]{0.6992,0.1328,0.1328}j\in[M]\setminus i}\end{subarray}}e^{\bm{\mathsfit{U}}_{i,{\color[rgb]{0,0.3906,0.7852}l}}^{\top}\bm{\mathsfit{U}}_{{\color[rgb]{0.6992,0.1328,0.1328}j,m}}/\tau}}\right)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi style="--ltx-fg-color:#0064C8;" mathcolor="#0064C8">l</mi><mo style="--ltx-fg-color:#0064C8;" mathcolor="#0064C8">∈</mo><mrow><mo style="--ltx-fg-color:#0064C8;" mathcolor="#0064C8" stretchy="false">[</mo><mi style="--ltx-fg-color:#0064C8;" mathcolor="#0064C8">N</mi><mo style="--ltx-fg-color:#0064C8;" mathcolor="#0064C8" stretchy="false">]</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><msup><mi style="--ltx-fg-color:#228B22;" mathcolor="#228B22">l</mi><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">′</mo></msup><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">∈</mo><mrow><mrow><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22" stretchy="false">[</mo><mi style="--ltx-fg-color:#228B22;" mathcolor="#228B22">N</mi><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22" stretchy="false">]</mo></mrow><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">∖</mo><mi style="--ltx-fg-color:#0064C8;" mathcolor="#0064C8">l</mi></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></mtd></mtr></mtable></munder></mstyle><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mrow><msubsup><mi>𝑼</mi><mrow><mi>i</mi><mo>,</mo><mi style="--ltx-fg-color:#0064C8;" mathcolor="#0064C8">l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑼</mi><mrow><mi>i</mi><mo>,</mo><msup><mi style="--ltx-fg-color:#228B22;" mathcolor="#228B22">l</mi><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">′</mo></msup></mrow></msub></mrow><mo>/</mo><mi>τ</mi></mrow></msup><mrow><msup><mi>e</mi><mrow><mrow><msubsup><mi>𝑼</mi><mrow><mi>i</mi><mo>,</mo><mi style="--ltx-fg-color:#0064C8;" mathcolor="#0064C8">l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑼</mi><mrow><mi>i</mi><mo>,</mo><msup><mi style="--ltx-fg-color:#228B22;" mathcolor="#228B22">l</mi><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">′</mo></msup></mrow></msub></mrow><mo>/</mo><mi>τ</mi></mrow></msup><mo rspace="0.055em">+</mo><mrow><msub><mo>∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">m</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222">∈</mo><mrow><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222" stretchy="false">[</mo><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">N</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222" stretchy="false">]</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">j</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222">∈</mo><mrow><mrow><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222" stretchy="false">[</mo><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">M</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222" stretchy="false">]</mo></mrow><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222">∖</mo><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">i</mi></mrow></mrow></mtd></mtr></mtable></msub><msup><mi>e</mi><mrow><mrow><msubsup><mi>𝑼</mi><mrow><mi>i</mi><mo>,</mo><mi style="--ltx-fg-color:#0064C8;" mathcolor="#0064C8">l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑼</mi><mrow><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">j</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222">,</mo><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">m</mi></mrow></msub></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{-1}{(N-1)M}\sum_{\begin{subarray}{c}{\color[rgb]{0,0.3906,0.7852}l\in[N]}\\
{\color[rgb]{0.1328,0.5469,0.1328}l^{\prime}\in[N]\setminus{\color[rgb]{0,0.3906,0.7852}l}}\\
i\in[M]\end{subarray}}\log\left(\frac{e^{\bm{\mathsfit{U}}_{i,{\color[rgb]{0,0.3906,0.7852}l}}^{\top}\bm{\mathsfit{U}}_{i,{\color[rgb]{0.1328,0.5469,0.1328}l^{\prime}}}/\tau}}{e^{\bm{\mathsfit{U}}_{i,{\color[rgb]{0,0.3906,0.7852}l}}^{\top}\bm{\mathsfit{U}}_{i,{\color[rgb]{0.1328,0.5469,0.1328}l^{\prime}}}/\tau}+\sum_{\begin{subarray}{c}{\color[rgb]{0.6992,0.1328,0.1328}m\in[N]}\\
{\color[rgb]{0.6992,0.1328,0.1328}j\in[M]\setminus i}\end{subarray}}e^{\bm{\mathsfit{U}}_{i,{\color[rgb]{0,0.3906,0.7852}l}}^{\top}\bm{\mathsfit{U}}_{{\color[rgb]{0.6992,0.1328,0.1328}j,m}}/\tau}}\right)</annotation></semantics></math></td>
