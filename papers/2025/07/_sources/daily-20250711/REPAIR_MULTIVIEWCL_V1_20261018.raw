</div>
<div id="Ax1.SS2.p5" class="ltx_para">
<p id="Ax1.SS2.p5.1" class="ltx_p">Here, in order to properly compare our functions, we further define two more multi-view contrastive losses two different losses which are obtained by using the alignment to <a href="#S4.E7" title="In IV-A2 Multi-view Alignment ‣ IV-A A Framework for Multi-View Contrastive Losses ‣ IV Multi-View Contrastive Objectives ‣ A Principled Framework for Multi-View Contrastive Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">7</span></a>, the uniformity to <a href="#S4.E9" title="In IV-A3 Multi-view Uniformity ‣ IV-A A Framework for Multi-View Contrastive Losses ‣ IV Multi-View Contrastive Objectives ‣ A Principled Framework for Multi-View Contrastive Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">9</span></a> and the negative index sets based on the corresponding sets of MV-InfoNCE and MV-DHEL respectively.</p>
</div>
<div id="Ax1.SS2.p6" class="ltx_para">
<table id="Ax1.E19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ax1.E19.m1" class="ltx_Math" alttext="\begin{split}L_{\textnormal{MV-CL1}}(\bm{\mathsfit{U}})&amp;=\frac{1}{NM}\sum_{l\in[N]\atop i\in[M]}-\log{\sum_{{\color[rgb]{0.1328,0.5469,0.1328}l^{\prime}\in[N]\setminus l}}K(\bm{\mathsfit{U}}_{i,l,:}^{\top}\bm{\mathsfit{U}}_{i,{\color[rgb]{0.1328,0.5469,0.1328}l^{\prime}},:})}+\frac{1}{NM}\sum_{l\in[N]\atop i\in[M]}\log{\sum_{{{\color[rgb]{0.6992,0.1328,0.1328}j\in[M]\atop m\in[N]\setminus l}}}K(\bm{\mathsfit{U}}_{i,l,:}^{\top}\bm{\mathsfit{U}}_{{\color[rgb]{0.6992,0.1328,0.1328}j,l},:})}\\
&amp;=\frac{1}{M}\sum_{l\in[N]\atop i\in[M]}-\log\left(\frac{\sum_{{\color[rgb]{0.1328,0.5469,0.1328}l^{\prime}\in[N]\setminus l}}^{N}e^{\bm{\mathsfit{U}}_{i,l,:}^{\top}\bm{\mathsfit{U}}_{i,{\color[rgb]{0.1328,0.5469,0.1328}l^{\prime}},:}{/\tau}}}{\sum_{{{\color[rgb]{0.6992,0.1328,0.1328}j\in[M]\atop m\in[N]\setminus l}}}e^{\bm{\mathsfit{U}}_{i,l,:}^{\top}\bm{\mathsfit{U}}_{{\color[rgb]{0.6992,0.1328,0.1328}j,m,}:}{/\tau}}}\right)\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msub><mi>L</mi><mtext>MV-CL1</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑼</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>=</mo><mfrac><mn>1</mn><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mfrac><mo movablelimits="false" rspace="0em">∑</mo><msub><mrow></mrow><mfrac linethickness="0pt"><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></mfrac></msub><mo lspace="0em">−</mo><mi>log</mi><mo movablelimits="false">∑</mo><msub><mrow></mrow><mrow><msup><mi style="--ltx-fg-color:#228B22;" mathcolor="#228B22">l</mi><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">′</mo></msup><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">∈</mo><mrow><mrow><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22" stretchy="false">[</mo><mi style="--ltx-fg-color:#228B22;" mathcolor="#228B22">N</mi><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22" stretchy="false">]</mo></mrow><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">∖</mo><mi style="--ltx-fg-color:#228B22;" mathcolor="#228B22">l</mi></mrow></mrow></msub><mi>K</mi><mo stretchy="false">(</mo><mi>𝑼</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>l</mi><mo>,</mo><mo>:</mo></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝑼</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi style="--ltx-fg-color:#228B22;" mathcolor="#228B22">l</mi><msup><mrow></mrow><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">′</mo></msup><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">)</mo><mo>+</mo><mfrac><mn>1</mn><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mfrac><mo movablelimits="false">∑</mo><msub><mrow></mrow><mfrac linethickness="0pt"><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></mfrac></msub><mi>log</mi><mo movablelimits="false">∑</mo><msub><mrow></mrow><mfrac style="--ltx-fg-color:#B22222;" linethickness="0pt" mathcolor="#B22222"><mrow><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">j</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222">∈</mo><mrow><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222" stretchy="false">[</mo><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">M</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222" stretchy="false">]</mo></mrow></mrow><mrow><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">m</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222">∈</mo><mrow><mrow><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222" stretchy="false">[</mo><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">N</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222" stretchy="false">]</mo></mrow><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222">∖</mo><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">l</mi></mrow></mrow></mfrac></msub><mi>K</mi><mo stretchy="false">(</mo><mi>𝑼</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>l</mi><mo>,</mo><mo>:</mo></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝑼</mi><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">j</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222">,</mo><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">l</mi><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>=</mo><mfrac><mn>1</mn><mi>M</mi></mfrac><mo movablelimits="false" rspace="0em">∑</mo><msub><mrow></mrow><mfrac linethickness="0pt"><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></mfrac></msub><mo lspace="0em">−</mo><mi>log</mi><mo>(</mo><mfrac><mrow><mo>∑</mo><msub><mrow></mrow><mrow><msup><mi style="--ltx-fg-color:#228B22;" mathcolor="#228B22">l</mi><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">′</mo></msup><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">∈</mo><mrow><mrow><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22" stretchy="false">[</mo><mi style="--ltx-fg-color:#228B22;" mathcolor="#228B22">N</mi><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22" stretchy="false">]</mo></mrow><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">∖</mo><mi style="--ltx-fg-color:#228B22;" mathcolor="#228B22">l</mi></mrow></mrow></msub><msup><mrow></mrow><mi>N</mi></msup><mi>e</mi><msup><mrow></mrow><mrow><mi>𝑼</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>l</mi><mo>,</mo><mo>:</mo></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝑼</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi style="--ltx-fg-color:#228B22;" mathcolor="#228B22">l</mi><msup><mrow></mrow><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">′</mo></msup><mo>,</mo><mo>:</mo></mrow></msub><mo>/</mo><mi>τ</mi></mrow></msup></mrow><mrow><mo>∑</mo><msub><mrow></mrow><mfrac style="--ltx-fg-color:#B22222;" linethickness="0pt" mathcolor="#B22222"><mrow><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">j</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222">∈</mo><mrow><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222" stretchy="false">[</mo><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">M</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222" stretchy="false">]</mo></mrow></mrow><mrow><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">m</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222">∈</mo><mrow><mrow><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222" stretchy="false">[</mo><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">N</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222" stretchy="false">]</mo></mrow><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222">∖</mo><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">l</mi></mrow></mrow></mfrac></msub><mi>e</mi><msup><mrow></mrow><mrow><mi>𝑼</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>l</mi><mo>,</mo><mo>:</mo></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝑼</mi><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">j</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222">,</mo><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">m</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222">,</mo><mo>:</mo></mrow></msub><mo>/</mo><mi>τ</mi></mrow></msup></mrow></mfrac><mo>)</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}L_{\textnormal{MV-CL1}}(\bm{\mathsfit{U}})&amp;=\frac{1}{NM}\sum_{l\in[N]\atop i\in[M]}-\log{\sum_{{\color[rgb]{0.1328,0.5469,0.1328}l^{\prime}\in[N]\setminus l}}K(\bm{\mathsfit{U}}_{i,l,:}^{\top}\bm{\mathsfit{U}}_{i,{\color[rgb]{0.1328,0.5469,0.1328}l^{\prime}},:})}+\frac{1}{NM}\sum_{l\in[N]\atop i\in[M]}\log{\sum_{{{\color[rgb]{0.6992,0.1328,0.1328}j\in[M]\atop m\in[N]\setminus l}}}K(\bm{\mathsfit{U}}_{i,l,:}^{\top}\bm{\mathsfit{U}}_{{\color[rgb]{0.6992,0.1328,0.1328}j,l},:})}\\
&amp;=\frac{1}{M}\sum_{l\in[N]\atop i\in[M]}-\log\left(\frac{\sum_{{\color[rgb]{0.1328,0.5469,0.1328}l^{\prime}\in[N]\setminus l}}^{N}e^{\bm{\mathsfit{U}}_{i,l,:}^{\top}\bm{\mathsfit{U}}_{i,{\color[rgb]{0.1328,0.5469,0.1328}l^{\prime}},:}{/\tau}}}{\sum_{{{\color[rgb]{0.6992,0.1328,0.1328}j\in[M]\atop m\in[N]\setminus l}}}e^{\bm{\mathsfit{U}}_{i,l,:}^{\top}\bm{\mathsfit{U}}_{{\color[rgb]{0.6992,0.1328,0.1328}j,m,}:}{/\tau}}}\right)\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
</table>
</div>
<div id="Ax1.SS2.p7" class="ltx_para">
<table id="Ax1.E20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ax1.E20.m1" class="ltx_Math" alttext="\begin{split}L_{\textnormal{MV-CL2}}(\bm{\mathsfit{U}})&amp;=\frac{1}{NM}\sum_{l\in[N]\atop i\in[M]}-\log{\sum_{{\color[rgb]{0.1328,0.5469,0.1328}l^{\prime}\in[N]\setminus l}}K(\bm{\mathsfit{U}}_{i,l,:}^{\top}\bm{\mathsfit{U}}_{i,{\color[rgb]{0.1328,0.5469,0.1328}l^{\prime}},:})}+\frac{1}{NM}\sum_{l\in[N]\atop i\in[M]}\log{\sum_{{\color[rgb]{0.6992,0.1328,0.1328}j\in[M]\setminus i}}K(\bm{\mathsfit{U}}_{i,l,:}^{\top}\bm{\mathsfit{U}}_{{\color[rgb]{0.6992,0.1328,0.1328}j,l},:})}.\\
&amp;=\frac{1}{M}\sum_{l\in[N]\atop i\in[M]}-\log\left(\frac{\sum_{{\color[rgb]{0.1328,0.5469,0.1328}l^{\prime}\in[N]\setminus l}}^{N}e^{\bm{\mathsfit{U}}_{i,l,:}^{\top}\bm{\mathsfit{U}}_{i,{\color[rgb]{0.1328,0.5469,0.1328}l^{\prime}},:}{/\tau}}}{\sum_{{{\color[rgb]{0.6992,0.1328,0.1328}j\in[M]}}}e^{\bm{\mathsfit{U}}_{i,l,:}^{\top}\bm{\mathsfit{U}}_{{\color[rgb]{0.6992,0.1328,0.1328}j,m,}:}{/\tau}}}\right)\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msub><mi>L</mi><mtext>MV-CL2</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑼</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>=</mo><mfrac><mn>1</mn><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mfrac><mo movablelimits="false" rspace="0em">∑</mo><msub><mrow></mrow><mfrac linethickness="0pt"><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></mfrac></msub><mo lspace="0em">−</mo><mi>log</mi><mo movablelimits="false">∑</mo><msub><mrow></mrow><mrow><msup><mi style="--ltx-fg-color:#228B22;" mathcolor="#228B22">l</mi><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">′</mo></msup><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">∈</mo><mrow><mrow><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22" stretchy="false">[</mo><mi style="--ltx-fg-color:#228B22;" mathcolor="#228B22">N</mi><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22" stretchy="false">]</mo></mrow><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">∖</mo><mi style="--ltx-fg-color:#228B22;" mathcolor="#228B22">l</mi></mrow></mrow></msub><mi>K</mi><mo stretchy="false">(</mo><mi>𝑼</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>l</mi><mo>,</mo><mo>:</mo></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝑼</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi style="--ltx-fg-color:#228B22;" mathcolor="#228B22">l</mi><msup><mrow></mrow><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">′</mo></msup><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">)</mo><mo>+</mo><mfrac><mn>1</mn><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mfrac><mo movablelimits="false">∑</mo><msub><mrow></mrow><mfrac linethickness="0pt"><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></mfrac></msub><mi>log</mi><mo movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">j</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222">∈</mo><mrow><mrow><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222" stretchy="false">[</mo><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">M</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222" stretchy="false">]</mo></mrow><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222">∖</mo><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">i</mi></mrow></mrow></msub><mi>K</mi><mo stretchy="false">(</mo><mi>𝑼</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>l</mi><mo>,</mo><mo>:</mo></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝑼</mi><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">j</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222">,</mo><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">l</mi><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">)</mo><mo lspace="0em">.</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>=</mo><mfrac><mn>1</mn><mi>M</mi></mfrac><mo movablelimits="false" rspace="0em">∑</mo><msub><mrow></mrow><mfrac linethickness="0pt"><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></mfrac></msub><mo lspace="0em">−</mo><mi>log</mi><mo>(</mo><mfrac><mrow><mo>∑</mo><msub><mrow></mrow><mrow><msup><mi style="--ltx-fg-color:#228B22;" mathcolor="#228B22">l</mi><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">′</mo></msup><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">∈</mo><mrow><mrow><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22" stretchy="false">[</mo><mi style="--ltx-fg-color:#228B22;" mathcolor="#228B22">N</mi><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22" stretchy="false">]</mo></mrow><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">∖</mo><mi style="--ltx-fg-color:#228B22;" mathcolor="#228B22">l</mi></mrow></mrow></msub><msup><mrow></mrow><mi>N</mi></msup><mi>e</mi><msup><mrow></mrow><mrow><mi>𝑼</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>l</mi><mo>,</mo><mo>:</mo></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝑼</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi style="--ltx-fg-color:#228B22;" mathcolor="#228B22">l</mi><msup><mrow></mrow><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">′</mo></msup><mo>,</mo><mo>:</mo></mrow></msub><mo>/</mo><mi>τ</mi></mrow></msup></mrow><mrow><mo>∑</mo><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">j</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222">∈</mo><mrow><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222" stretchy="false">[</mo><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">M</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222" stretchy="false">]</mo></mrow></mrow></msub><mi>e</mi><msup><mrow></mrow><mrow><mi>𝑼</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>l</mi><mo>,</mo><mo>:</mo></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝑼</mi><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">j</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222">,</mo><mi style="--ltx-fg-color:#B22222;" mathcolor="#B22222">m</mi><mo style="--ltx-fg-color:#B22222;" mathcolor="#B22222">,</mo><mo>:</mo></mrow></msub><mo>/</mo><mi>τ</mi></mrow></msup></mrow></mfrac><mo>)</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}L_{\textnormal{MV-CL2}}(\bm{\mathsfit{U}})&amp;=\frac{1}{NM}\sum_{l\in[N]\atop i\in[M]}-\log{\sum_{{\color[rgb]{0.1328,0.5469,0.1328}l^{\prime}\in[N]\setminus l}}K(\bm{\mathsfit{U}}_{i,l,:}^{\top}\bm{\mathsfit{U}}_{i,{\color[rgb]{0.1328,0.5469,0.1328}l^{\prime}},:})}+\frac{1}{NM}\sum_{l\in[N]\atop i\in[M]}\log{\sum_{{\color[rgb]{0.6992,0.1328,0.1328}j\in[M]\setminus i}}K(\bm{\mathsfit{U}}_{i,l,:}^{\top}\bm{\mathsfit{U}}_{{\color[rgb]{0.6992,0.1328,0.1328}j,l},:})}.\\
&amp;=\frac{1}{M}\sum_{l\in[N]\atop i\in[M]}-\log\left(\frac{\sum_{{\color[rgb]{0.1328,0.5469,0.1328}l^{\prime}\in[N]\setminus l}}^{N}e^{\bm{\mathsfit{U}}_{i,l,:}^{\top}\bm{\mathsfit{U}}_{i,{\color[rgb]{0.1328,0.5469,0.1328}l^{\prime}},:}{/\tau}}}{\sum_{{{\color[rgb]{0.6992,0.1328,0.1328}j\in[M]}}}e^{\bm{\mathsfit{U}}_{i,l,:}^{\top}\bm{\mathsfit{U}}_{{\color[rgb]{0.6992,0.1328,0.1328}j,m,}:}{/\tau}}}\right)\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="Ax1.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="Ax1.SS3.6" class="ltx_text">-C</span> </span><span id="Ax1.SS3.7" class="ltx_text ltx_font_italic">Expectations of Mini-Batch Objectives</span></h3>

<div id="Ax1.SS3.p1" class="ltx_para">
<p id="Ax1.SS3.p1.1" class="ltx_p">We will denote the pushforward measures induced by <math id="Ax1.SS3.p1.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> (encoder) with <math id="Ax1.SS3.p1.m2" class="ltx_Math" alttext="f_{\#}p" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">f_{\#}p</annotation></semantics></math>. Additionally, we denote with <math id="Ax1.SS3.p1.m3" class="ltx_Math" alttext="p_{\text{trans}}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mtext>trans</mtext></msub><annotation encoding="application/x-tex">p_{\text{trans}}</annotation></semantics></math> the distribution of a datapoint sampled by <math id="Ax1.SS3.p1.m4" class="ltx_Math" alttext="p_{\text{init}}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mtext>init</mtext></msub><annotation encoding="application/x-tex">p_{\text{init}}</annotation></semantics></math> and then transformed by a single transformation sampled by <math id="Ax1.SS3.p1.m5" class="ltx_Math" alttext="\mathcal{T}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒯</mi><annotation encoding="application/x-tex">\mathcal{T}</annotation></semantics></math>.
By sampling a tensor of <math id="Ax1.SS3.p1.m6" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> datapoints of <math id="Ax1.SS3.p1.m7" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> positive views from the pushforward measure induced by <math id="Ax1.SS3.p1.m8" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> on the <math id="Ax1.SS3.p1.m9" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>-view distribution, <em id="Ax1.SS3.p1.1.1" class="ltx_emph ltx_font_italic">i.e.</em> <math id="Ax1.SS3.p1.m10" class="ltx_Math" alttext="\mathbf{U}_{j}=(\mathbf{u}_{1},\dots,\mathbf{u}_{N})\overset{\text{i.i.d}}{\sim}f_{\#}p" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐔</mi><mi>j</mi></msub><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><msub><mi>𝐮</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝐮</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo>∼</mo><mtext mathsize="0.700em">i.i.d</mtext></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></mrow><annotation encoding="application/x-tex">\mathbf{U}_{j}=(\mathbf{u}_{1},\dots,\mathbf{u}_{N})\overset{\text{i.i.d}}{\sim}f_{\#}p</annotation></semantics></math>, <math id="Ax1.SS3.p1.m11" class="ltx_Math" alttext="j\in[M]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[M]</annotation></semantics></math>. The the mini-batch objectives are estimators of the following expectations:</p>
</div>
<div id="Ax1.SS3.p2" class="ltx_para">
<table id="Ax1.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ax1.E21.m1" class="ltx_Math" alttext="\begin{split}&amp;E_{\text{PVC}}=\underset{\mathbf{U}_{j}\overset{\text{i.i.d}}{\sim}f_{\#}p^{M}}{\E}\left[\sum_{l\in[N]\atop{l^{\prime}\in[N]\setminus l}}-\log\left(\frac{e^{\bm{\mathsfit{U}}_{1,l,:}^{\top}\bm{\mathsfit{U}}_{1,l^{\prime},:}/\tau}}{e^{\bm{\mathsfit{U}}_{1,l,:}^{\top}\bm{\mathsfit{U}}_{1,l^{\prime},:}/\tau}+\sum_{{j\in[M]\setminus i\atop{m\in[N]}}}e^{\bm{\mathsfit{U}}_{1,l,:}^{\top}\bm{\mathsfit{U}}_{j,m,:}/\tau}}\right)\right]\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>E</mi><msub><mrow></mrow><mtext>PVC</mtext></msub><mo>=</mo><munder accentunder="true"><mi>𝔼</mi><mrow><msub><mi mathsize="0.700em">𝐔</mi><mi mathsize="0.710em">j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo mathsize="0.700em">∼</mo><mtext mathsize="0.500em">i.i.d</mtext></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.700em">f</mi><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.700em">p</mi><mi mathsize="0.710em">M</mi></msup></mrow></munder><mo>[</mo><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><msub><mrow></mrow><mfrac linethickness="0pt"><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mrow><msup><mi>l</mi><mo>′</mo></msup><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><mi>l</mi></mrow></mrow></mfrac></msub><mo lspace="0em">−</mo><mi>log</mi><mo>(</mo><mfrac><mrow><mi>e</mi><msup><mrow></mrow><mrow><mi>𝑼</mi><msub><mrow></mrow><mrow><mn>1</mn><mo>,</mo><mi>l</mi><mo>,</mo><mo>:</mo></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝑼</mi><msub><mrow></mrow><mrow><mn>1</mn><mo>,</mo><mi>l</mi><msup><mrow></mrow><mo>′</mo></msup><mo>,</mo><mo>:</mo></mrow></msub><mo>/</mo><mi>τ</mi></mrow></msup></mrow><mrow><mi>e</mi><msup><mrow></mrow><mrow><mi>𝑼</mi><msub><mrow></mrow><mrow><mn>1</mn><mo>,</mo><mi>l</mi><mo>,</mo><mo>:</mo></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝑼</mi><msub><mrow></mrow><mrow><mn>1</mn><mo>,</mo><mi>l</mi><msup><mrow></mrow><mo>′</mo></msup><mo>,</mo><mo>:</mo></mrow></msub><mo>/</mo><mi>τ</mi></mrow></msup><mo rspace="0.055em">+</mo><mo>∑</mo><msub><mrow></mrow><mfrac linethickness="0pt"><mrow><mi>j</mi><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><mi>i</mi></mrow></mrow><mrow><mi>m</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow></mfrac></msub><mi>e</mi><msup><mrow></mrow><mrow><mi>𝑼</mi><msub><mrow></mrow><mrow><mn>1</mn><mo>,</mo><mi>l</mi><mo>,</mo><mo>:</mo></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝑼</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>,</mo><mi>m</mi><mo>,</mo><mo>:</mo></mrow></msub><mo>/</mo><mi>τ</mi></mrow></msup></mrow></mfrac><mo>)</mo><mo>]</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}&amp;E_{\text{PVC}}=\underset{\mathbf{U}_{j}\overset{\text{i.i.d}}{\sim}f_{\#}p^{M}}{\E}\left[\sum_{l\in[N]\atop{l^{\prime}\in[N]\setminus l}}-\log\left(\frac{e^{\bm{\mathsfit{U}}_{1,l,:}^{\top}\bm{\mathsfit{U}}_{1,l^{\prime},:}/\tau}}{e^{\bm{\mathsfit{U}}_{1,l,:}^{\top}\bm{\mathsfit{U}}_{1,l^{\prime},:}/\tau}+\sum_{{j\in[M]\setminus i\atop{m\in[N]}}}e^{\bm{\mathsfit{U}}_{1,l,:}^{\top}\bm{\mathsfit{U}}_{j,m,:}/\tau}}\right)\right]\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
</div>
<div id="Ax1.SS3.p3" class="ltx_para">
<table id="Ax1.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ax1.E22.m1" class="ltx_Math" alttext="\begin{split}&amp;E_{\text{MV-InfoNCE}}=\underset{\mathbf{U}_{j}\overset{\text{i.i.d}}{\sim}f_{\#}p^{M}}{\E}\left[-\log\left(\frac{\sum_{l\in[N],\atop l^{\prime}\in[N]\setminus l}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{1,l^{\prime}}{/\tau}}}{\sum_{l\in[N]\atop{j\in[M]\atop m\in[N]\setminus l}}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{j,m}{/\tau}}}\right)\right]\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>E</mi><mtext>MV-InfoNCE</mtext></msub><mo>=</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><msub><mi mathsize="0.700em">𝐔</mi><mi mathsize="0.710em">j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo mathsize="0.700em">∼</mo><mtext mathsize="0.500em">i.i.d</mtext></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.700em">f</mi><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.700em">p</mi><mi mathsize="0.710em">M</mi></msup></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msub><mo>∑</mo><mfrac linethickness="0pt"><mrow><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo></mrow><mrow><msup><mi>l</mi><mo>′</mo></msup><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><mi>l</mi></mrow></mrow></mfrac></msub><msup><mi>e</mi><mrow><mrow><msubsup><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><msup><mi>l</mi><mo>′</mo></msup></mrow></msub></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow><mrow><msub><mo>∑</mo><mfrac linethickness="0pt"><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mfrac linethickness="0pt"><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow><mrow><mi>m</mi><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><mi>l</mi></mrow></mrow></mfrac></mfrac></msub><msup><mi>e</mi><mrow><mrow><msubsup><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐔</mi><mrow><mi>j</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow></mfrac><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}&amp;E_{\text{MV-InfoNCE}}=\underset{\mathbf{U}_{j}\overset{\text{i.i.d}}{\sim}f_{\#}p^{M}}{\E}\left[-\log\left(\frac{\sum_{l\in[N],\atop l^{\prime}\in[N]\setminus l}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{1,l^{\prime}}{/\tau}}}{\sum_{l\in[N]\atop{j\in[M]\atop m\in[N]\setminus l}}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{j,m}{/\tau}}}\right)\right]\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
</table>
<table id="Ax1.E23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ax1.E23.m1" class="ltx_Math" alttext="\begin{split}&amp;E_{\text{MV-DHEL}}=\underset{\mathbf{U}_{j}\overset{\text{i.i.d}}{\sim}f_{\#}p^{M}}{\E}\left[-\log\left(\frac{\sum_{l\in[N],\atop l^{\prime}\in[N]\setminus l}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{1,l^{\prime}}{/\tau}}}{\prod_{l\in[N]}\sum_{{j\in[M-1]}}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{j,l}{/\tau}}}\right)\right]\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>E</mi><mtext>MV-DHEL</mtext></msub><mo>=</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><msub><mi mathsize="0.700em">𝐔</mi><mi mathsize="0.710em">j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo mathsize="0.700em">∼</mo><mtext mathsize="0.500em">i.i.d</mtext></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.700em">f</mi><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.700em">p</mi><mi mathsize="0.710em">M</mi></msup></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msub><mo>∑</mo><mfrac linethickness="0pt"><mrow><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo></mrow><mrow><msup><mi>l</mi><mo>′</mo></msup><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><mi>l</mi></mrow></mrow></mfrac></msub><msup><mi>e</mi><mrow><mrow><msubsup><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><msup><mi>l</mi><mo>′</mo></msup></mrow></msub></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow><mrow><msub><mo>∏</mo><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mrow><msub><mo lspace="0.167em">∑</mo><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></msub><msup><mi>e</mi><mrow><mrow><msubsup><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐔</mi><mrow><mi>j</mi><mo>,</mo><mi>l</mi></mrow></msub></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow></mrow></mfrac><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}&amp;E_{\text{MV-DHEL}}=\underset{\mathbf{U}_{j}\overset{\text{i.i.d}}{\sim}f_{\#}p^{M}}{\E}\left[-\log\left(\frac{\sum_{l\in[N],\atop l^{\prime}\in[N]\setminus l}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{1,l^{\prime}}{/\tau}}}{\prod_{l\in[N]}\sum_{{j\in[M-1]}}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{j,l}{/\tau}}}\right)\right]\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
</table>
</div>
</section>
</section>
<section id="Ax2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix">Proof of Theorem 4.1</h2>

<div id="Ax2.p1" class="ltx_para ltx_noindent">
<p id="Ax2.p1.1" class="ltx_p"><span id="Ax2.p1.1.1" class="ltx_text ltx_font_bold">Theorem 4.1.</span> The expectations of the following batch-level contrastive loss functions: <math id="Ax2.p1.m1" class="ltx_Math" alttext="L_{\textnormal{InfoNCE}}(\cdot,\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mtext>InfoNCE</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L_{\textnormal{InfoNCE}}(\cdot,\cdot)</annotation></semantics></math>, <math id="Ax2.p1.m2" class="ltx_Math" alttext="L_{\textnormal{MV-InfoNCE}}(\cdot,\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mtext>MV-InfoNCE</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L_{\textnormal{MV-InfoNCE}}(\cdot,\cdot)</annotation></semantics></math>, <math id="Ax2.p1.m3" class="ltx_Math" alttext="L_{\textnormal{MV-DHEL}}(\cdot,\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mtext>MV-DHEL</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L_{\textnormal{MV-DHEL}}(\cdot,\cdot)</annotation></semantics></math>, have the <span id="Ax2.p1.1.2" class="ltx_text ltx_font_bold">same asymptotic behaviour</span> when normalized by appropriate normalizing constants.</p>
</div>
<div id="Ax2.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="Ax2.p2" class="ltx_para">
<p id="Ax2.p2.1" class="ltx_p"><span id="Ax2.p2.1.1" class="ltx_text">For convenience we repeat the expected values that are going to analyse subtracting the appropriate normalising constants:</span></p>
<table id="Ax2.E24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ax2.E24.m1" class="ltx_Math" alttext="\begin{split}&amp;E_{1}=\underset{\mathbf{U}_{j}\overset{\text{i.i.d}}{\sim}f_{\#}p^{M}}{\E}\left[-\log\left(\frac{\sum_{l\in[N],\atop l^{\prime}\in[N]\setminus l}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{1,l^{\prime}}{/\tau}}}{\sum_{l\in[N]\atop{j\in[M]\atop m\in[N]\setminus l}}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{j,m}{/\tau}}}\right)\right]-\log(M-1)+\log(N(N-1))\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>E</mi><mn>1</mn></msub><mo>=</mo><mrow><mrow><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><msub><mi mathsize="0.700em">𝐔</mi><mi mathsize="0.710em">j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo mathsize="0.700em">∼</mo><mtext mathsize="0.500em">i.i.d</mtext></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.700em">f</mi><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.700em">p</mi><mi mathsize="0.710em">M</mi></msup></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msub><mo>∑</mo><mfrac linethickness="0pt"><mrow><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo></mrow><mrow><msup><mi>l</mi><mo>′</mo></msup><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><mi>l</mi></mrow></mrow></mfrac></msub><msup><mi>e</mi><mrow><mrow><msubsup><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><msup><mi>l</mi><mo>′</mo></msup></mrow></msub></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow><mrow><msub><mo>∑</mo><mfrac linethickness="0pt"><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mfrac linethickness="0pt"><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow><mrow><mi>m</mi><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><mi>l</mi></mrow></mrow></mfrac></mfrac></msub><msup><mi>e</mi><mrow><mrow><msubsup><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐔</mi><mrow><mi>j</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow></mfrac><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}&amp;E_{1}=\underset{\mathbf{U}_{j}\overset{\text{i.i.d}}{\sim}f_{\#}p^{M}}{\E}\left[-\log\left(\frac{\sum_{l\in[N],\atop l^{\prime}\in[N]\setminus l}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{1,l^{\prime}}{/\tau}}}{\sum_{l\in[N]\atop{j\in[M]\atop m\in[N]\setminus l}}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{j,m}{/\tau}}}\right)\right]-\log(M-1)+\log(N(N-1))\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
<table id="Ax2.E25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ax2.E25.m1" class="ltx_Math" alttext="\begin{split}&amp;E_{2}=\underset{\mathbf{U}_{j}\overset{\text{i.i.d}}{\sim}f_{\#}p^{M}}{\E}\left[-\log\left(\frac{\sum_{l\in[N],\atop l^{\prime}\in[N]\setminus l}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{1,l^{\prime}}{/\tau}}}{\prod_{l\in[N]}\sum_{{j\in[M-1]}}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{j,l}{/\tau}}}\right)\right]-\log(M-1)+\log(N(N-1))\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>E</mi><mn>2</mn></msub><mo>=</mo><mrow><mrow><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><msub><mi mathsize="0.700em">𝐔</mi><mi mathsize="0.710em">j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo mathsize="0.700em">∼</mo><mtext mathsize="0.500em">i.i.d</mtext></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.700em">f</mi><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.700em">p</mi><mi mathsize="0.710em">M</mi></msup></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msub><mo>∑</mo><mfrac linethickness="0pt"><mrow><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo></mrow><mrow><msup><mi>l</mi><mo>′</mo></msup><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><mi>l</mi></mrow></mrow></mfrac></msub><msup><mi>e</mi><mrow><mrow><msubsup><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><msup><mi>l</mi><mo>′</mo></msup></mrow></msub></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow><mrow><msub><mo>∏</mo><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mrow><msub><mo lspace="0.167em">∑</mo><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></msub><msup><mi>e</mi><mrow><mrow><msubsup><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐔</mi><mrow><mi>j</mi><mo>,</mo><mi>l</mi></mrow></msub></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow></mrow></mfrac><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}&amp;E_{2}=\underset{\mathbf{U}_{j}\overset{\text{i.i.d}}{\sim}f_{\#}p^{M}}{\E}\left[-\log\left(\frac{\sum_{l\in[N],\atop l^{\prime}\in[N]\setminus l}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{1,l^{\prime}}{/\tau}}}{\prod_{l\in[N]}\sum_{{j\in[M-1]}}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{j,l}{/\tau}}}\right)\right]-\log(M-1)+\log(N(N-1))\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
</div>
<div id="Ax2.p3" class="ltx_para">
<p id="Ax2.p3.1" class="ltx_p"><span id="Ax2.p3.1.1" class="ltx_text">Following, set:</span></p>
<table id="Ax2.E26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ax2.E26.m1" class="ltx_Math" alttext="\begin{split}A&amp;=-\underset{(\mathbf{U}_{1,1},...\mathbf{U}_{1,N})\sim f_{\#}p}{\E}\left[\log\left({\sum_{l\in[N]\atop l^{\prime}\in[N]\setminus l}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{1,l^{\prime}}{/\tau}}}\right)\right]+\log(N(N-1))\\
B&amp;=\underset{\mathbf{U}_{j}\overset{\text{i.i.d}}{\sim}f_{\#}p^{M}}{\E}\left[\log\left({\sum_{l\in[N]\atop{j\in[M]\atop m\in[N]\setminus l}}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{j,m}{/\tau}}}\right)\right]-\log(M-1)\\
\Gamma&amp;=\underset{\mathbf{U}_{j}\overset{\text{i.i.d}}{\sim}f_{\#}p^{M}}{\E}\left[\log\left({\prod_{l\in[N]}\sum_{{j\in[M-1]}}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{j,l}{/\tau}}}\right)\right]+N\log(M-1),\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mi>A</mi></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo rspace="0.167em">−</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">𝐔</mi><mrow><mn mathsize="0.710em">1</mn><mo mathsize="0.710em">,</mo><mn mathsize="0.710em">1</mn></mrow></msub><mo mathsize="0.700em">,</mo><mrow><mi mathsize="0.700em" mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.700em">𝐔</mi><mrow><mn mathsize="0.710em">1</mn><mo mathsize="0.710em">,</mo><mi mathsize="0.710em">N</mi></mrow></msub></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.700em">∼</mo><mrow><msub><mi mathsize="0.700em">f</mi><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">p</mi></mrow></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mfrac linethickness="0pt"><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mrow><msup><mi>l</mi><mo>′</mo></msup><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><mi>l</mi></mrow></mrow></mfrac></munder><msup><mi>e</mi><mrow><mrow><msubsup><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><msup><mi>l</mi><mo>′</mo></msup></mrow></msub></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mi>B</mi></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><msub><mi mathsize="0.700em">𝐔</mi><mi mathsize="0.710em">j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo mathsize="0.700em">∼</mo><mtext mathsize="0.500em">i.i.d</mtext></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.700em">f</mi><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.700em">p</mi><mi mathsize="0.710em">M</mi></msup></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mfrac linethickness="0pt"><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mfrac linethickness="0pt"><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow><mrow><mi>m</mi><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><mi>l</mi></mrow></mrow></mfrac></mfrac></munder><msup><mi>e</mi><mrow><mrow><msubsup><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐔</mi><mrow><mi>j</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mi mathvariant="normal">Γ</mi></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><msub><mi mathsize="0.700em">𝐔</mi><mi mathsize="0.710em">j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo mathsize="0.700em">∼</mo><mtext mathsize="0.500em">i.i.d</mtext></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.700em">f</mi><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.700em">p</mi><mi mathsize="0.710em">M</mi></msup></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">∏</mo><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></munder><msup><mi>e</mi><mrow><mrow><msubsup><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐔</mi><mrow><mi>j</mi><mo>,</mo><mi>l</mi></mrow></msub></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mi>N</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}A&amp;=-\underset{(\mathbf{U}_{1,1},...\mathbf{U}_{1,N})\sim f_{\#}p}{\E}\left[\log\left({\sum_{l\in[N]\atop l^{\prime}\in[N]\setminus l}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{1,l^{\prime}}{/\tau}}}\right)\right]+\log(N(N-1))\\
B&amp;=\underset{\mathbf{U}_{j}\overset{\text{i.i.d}}{\sim}f_{\#}p^{M}}{\E}\left[\log\left({\sum_{l\in[N]\atop{j\in[M]\atop m\in[N]\setminus l}}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{j,m}{/\tau}}}\right)\right]-\log(M-1)\\
\Gamma&amp;=\underset{\mathbf{U}_{j}\overset{\text{i.i.d}}{\sim}f_{\#}p^{M}}{\E}\left[\log\left({\prod_{l\in[N]}\sum_{{j\in[M-1]}}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{j,l}{/\tau}}}\right)\right]+N\log(M-1),\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
</table>
<p id="Ax2.p3.2" class="ltx_p"><span id="Ax2.p3.2.1" class="ltx_text">such that <math id="Ax2.p3.m1" class="ltx_Math" alttext="E_{1}=A+B" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mn>1</mn></msub><mo>=</mo><mrow><mi>A</mi><mo>+</mo><mi>B</mi></mrow></mrow><annotation encoding="application/x-tex">E_{1}=A+B</annotation></semantics></math> and <math id="Ax2.p3.m2" class="ltx_Math" alttext="E_{2}=A+\Gamma" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mn>2</mn></msub><mo>=</mo><mrow><mi>A</mi><mo>+</mo><mi mathvariant="normal">Γ</mi></mrow></mrow><annotation encoding="application/x-tex">E_{2}=A+\Gamma</annotation></semantics></math>. Now we expand each term as follows:</span></p>
</div>
<div id="Ax2.p4" class="ltx_para">
<p id="Ax2.p4.1" class="ltx_p"><span id="Ax2.p4.1.1" class="ltx_text ltx_underline ltx_font_bold">Regarding A</span><span id="Ax2.p4.1.2" class="ltx_text">: Using Jensen’s Inequality
we get:</span></p>
<table id="Ax2.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ax2.Ex1.m1" class="ltx_Math" alttext="\begin{split}-A&amp;=\underset{(\mathbf{U}_{1,1},...\mathbf{U}_{1,N})\sim f_{\#}p}{\E}\left[\log\left(\frac{\sum_{l\in[N]\atop l^{\prime}\in[N]\setminus l}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{1,l^{\prime}}{/\tau}}}{N(N-1)}\right)\right]\\
&amp;\leq\underset{(\mathbf{U}_{1,1},...\mathbf{U}_{1,N})\sim f_{\#}p}{\E}\left[\left(\frac{\sum_{l\in[N]\atop l^{\prime}\in[N]\setminus l}\log e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{1,l^{\prime}}{/\tau}}}{N(N-1)}\right)\right]\\
&amp;=\underset{(\mathbf{U}_{1,1},...\mathbf{U}_{1,N})\sim f_{\#}p}{\E}\left[\left(\frac{\sum_{l\in[N]\atop l^{\prime}\in[N]\setminus l}\mathbf{U}_{1,l}^{\top}\mathbf{U}_{1,l^{\prime}}{/\tau}}{N(N-1)}\right)\right]\\
&amp;\leq\underset{(\mathbf{U}_{1,1},...\mathbf{U}_{1,N})\sim f_{\#}p}{\E}\left[\left(\frac{\sum_{l\in[N]\atop l^{\prime}\in[N]\setminus l}1{/\tau}}{N(N-1)}\right)\right]\\
&amp;={1/\tau},\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo>−</mo><mi>A</mi></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">𝐔</mi><mrow><mn mathsize="0.710em">1</mn><mo mathsize="0.710em">,</mo><mn mathsize="0.710em">1</mn></mrow></msub><mo mathsize="0.700em">,</mo><mrow><mi mathsize="0.700em" mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.700em">𝐔</mi><mrow><mn mathsize="0.710em">1</mn><mo mathsize="0.710em">,</mo><mi mathsize="0.710em">N</mi></mrow></msub></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.700em">∼</mo><mrow><msub><mi mathsize="0.700em">f</mi><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">p</mi></mrow></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msub><mo>∑</mo><mfrac linethickness="0pt"><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mrow><msup><mi>l</mi><mo>′</mo></msup><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><mi>l</mi></mrow></mrow></mfrac></msub><msup><mi>e</mi><mrow><mrow><msubsup><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><msup><mi>l</mi><mo>′</mo></msup></mrow></msub></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>≤</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">𝐔</mi><mrow><mn mathsize="0.710em">1</mn><mo mathsize="0.710em">,</mo><mn mathsize="0.710em">1</mn></mrow></msub><mo mathsize="0.700em">,</mo><mrow><mi mathsize="0.700em" mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.700em">𝐔</mi><mrow><mn mathsize="0.710em">1</mn><mo mathsize="0.710em">,</mo><mi mathsize="0.710em">N</mi></mrow></msub></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.700em">∼</mo><mrow><msub><mi mathsize="0.700em">f</mi><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">p</mi></mrow></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mo>(</mo><mfrac><mrow><msub><mo>∑</mo><mfrac linethickness="0pt"><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mrow><msup><mi>l</mi><mo>′</mo></msup><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><mi>l</mi></mrow></mrow></mfrac></msub><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msup><mi>e</mi><mrow><mrow><msubsup><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><msup><mi>l</mi><mo>′</mo></msup></mrow></msub></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow></mrow><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>)</mo></mrow><mo>]</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">𝐔</mi><mrow><mn mathsize="0.710em">1</mn><mo mathsize="0.710em">,</mo><mn mathsize="0.710em">1</mn></mrow></msub><mo mathsize="0.700em">,</mo><mrow><mi mathsize="0.700em" mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.700em">𝐔</mi><mrow><mn mathsize="0.710em">1</mn><mo mathsize="0.710em">,</mo><mi mathsize="0.710em">N</mi></mrow></msub></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.700em">∼</mo><mrow><msub><mi mathsize="0.700em">f</mi><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">p</mi></mrow></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mo>(</mo><mfrac><mrow><mrow><msub><mo>∑</mo><mfrac linethickness="0pt"><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mrow><msup><mi>l</mi><mo>′</mo></msup><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><mi>l</mi></mrow></mrow></mfrac></msub><mrow><msubsup><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><msup><mi>l</mi><mo>′</mo></msup></mrow></msub></mrow></mrow><mo>/</mo><mi>τ</mi></mrow><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>)</mo></mrow><mo>]</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>≤</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">𝐔</mi><mrow><mn mathsize="0.710em">1</mn><mo mathsize="0.710em">,</mo><mn mathsize="0.710em">1</mn></mrow></msub><mo mathsize="0.700em">,</mo><mrow><mi mathsize="0.700em" mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.700em">𝐔</mi><mrow><mn mathsize="0.710em">1</mn><mo mathsize="0.710em">,</mo><mi mathsize="0.710em">N</mi></mrow></msub></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.700em">∼</mo><mrow><msub><mi mathsize="0.700em">f</mi><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">p</mi></mrow></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mo>(</mo><mfrac><mrow><mrow><msub><mo>∑</mo><mfrac linethickness="0pt"><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mrow><msup><mi>l</mi><mo>′</mo></msup><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><mi>l</mi></mrow></mrow></mfrac></msub><mn>1</mn></mrow><mo>/</mo><mi>τ</mi></mrow><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>)</mo></mrow><mo>]</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>1</mn><mo>/</mo><mi>τ</mi></mrow></mrow><mo>,</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}-A&amp;=\underset{(\mathbf{U}_{1,1},...\mathbf{U}_{1,N})\sim f_{\#}p}{\E}\left[\log\left(\frac{\sum_{l\in[N]\atop l^{\prime}\in[N]\setminus l}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{1,l^{\prime}}{/\tau}}}{N(N-1)}\right)\right]\\
&amp;\leq\underset{(\mathbf{U}_{1,1},...\mathbf{U}_{1,N})\sim f_{\#}p}{\E}\left[\left(\frac{\sum_{l\in[N]\atop l^{\prime}\in[N]\setminus l}\log e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{1,l^{\prime}}{/\tau}}}{N(N-1)}\right)\right]\\
&amp;=\underset{(\mathbf{U}_{1,1},...\mathbf{U}_{1,N})\sim f_{\#}p}{\E}\left[\left(\frac{\sum_{l\in[N]\atop l^{\prime}\in[N]\setminus l}\mathbf{U}_{1,l}^{\top}\mathbf{U}_{1,l^{\prime}}{/\tau}}{N(N-1)}\right)\right]\\
&amp;\leq\underset{(\mathbf{U}_{1,1},...\mathbf{U}_{1,N})\sim f_{\#}p}{\E}\left[\left(\frac{\sum_{l\in[N]\atop l^{\prime}\in[N]\setminus l}1{/\tau}}{N(N-1)}\right)\right]\\
&amp;={1/\tau},\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Ax2.p4.2" class="ltx_p"><span id="Ax2.p4.2.1" class="ltx_text">where in the last step we used the fact that inner products are maximised when the angle between the two vectors is zero, and since all vectors have unit norm then <math id="Ax2.p4.m1" class="ltx_Math" alttext="\mathbf{U}_{1,l}^{\top}\mathbf{U}_{1,l^{\prime}}\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><msup><mi>l</mi><mo>′</mo></msup></mrow></msub></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\mathbf{U}_{1,l}^{\top}\mathbf{U}_{1,l^{\prime}}\leq 1</annotation></semantics></math>. Therefore, the maximisation of the last term happens when <math id="Ax2.p4.m2" class="ltx_Math" alttext="\mathbf{U}_{1,l}=\mathbf{U}_{1,l^{\prime}},\forall l\neq l^{\prime}\in\{1,N\}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow></msub><mo>=</mo><msub><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><msup><mi>l</mi><mo>′</mo></msup></mrow></msub></mrow><mo>,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>l</mi></mrow><mo>≠</mo><msup><mi>l</mi><mo>′</mo></msup><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi>N</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{U}_{1,l}=\mathbf{U}_{1,l^{\prime}},\forall l\neq l^{\prime}\in\{1,N\}</annotation></semantics></math>. Now, observe that in this case, Jensen’s holds with equality since all summands are equal to <math id="Ax2.p4.m3" class="ltx_Math" alttext="e^{1/\tau}" display="inline" intent=":literal"><semantics><msup><mi>e</mi><mrow><mn>1</mn><mo>/</mo><mi>τ</mi></mrow></msup><annotation encoding="application/x-tex">e^{1/\tau}</annotation></semantics></math>. Therefore, maximisation of <math id="Ax2.p4.m4" class="ltx_Math" alttext="-A-\log\big(N(N-1)\big)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mi>A</mi></mrow><mo>−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">-A-\log\big(N(N-1)\big)</annotation></semantics></math> happens when there exists an encoder <math id="Ax2.p4.m5" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> such that whenever we sample from the pushforward <math id="Ax2.p4.m6" class="ltx_Math" alttext="f_{\#}p" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">f_{\#}p</annotation></semantics></math> we obtain <math id="Ax2.p4.m7" class="ltx_Math" alttext="\mathbf{U}_{1,l}=\mathbf{U}_{1,l^{\prime}},\forall l\neq l^{\prime}\in\{1,N\}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow></msub><mo>=</mo><msub><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><msup><mi>l</mi><mo>′</mo></msup></mrow></msub></mrow><mo>,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>l</mi></mrow><mo>≠</mo><msup><mi>l</mi><mo>′</mo></msup><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi>N</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{U}_{1,l}=\mathbf{U}_{1,l^{\prime}},\forall l\neq l^{\prime}\in\{1,N\}</annotation></semantics></math>, <em id="Ax2.p4.2.1.1" class="ltx_emph ltx_font_italic">i.e.</em>, when there is perfect alignment between <math id="Ax2.p4.m8" class="ltx_Math" alttext="\mathbf{U}_{1,l}" display="inline" intent=":literal"><semantics><msub><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{U}_{1,l}</annotation></semantics></math> and <math id="Ax2.p4.m9" class="ltx_Math" alttext="\mathbf{U}_{1,l^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><msup><mi>l</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">\mathbf{U}_{1,l^{\prime}}</annotation></semantics></math> for all <math id="Ax2.p4.m10" class="ltx_Math" alttext="l,l^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>,</mo><msup><mi>l</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">l,l^{\prime}</annotation></semantics></math> <em id="Ax2.p4.2.1.2" class="ltx_emph ltx_font_italic">i.e.</em> across views.</span></p>
</div>
<div id="Ax2.p5" class="ltx_para">
<p id="Ax2.p5.1" class="ltx_p"><span id="Ax2.p5.1.1" class="ltx_text ltx_underline ltx_font_bold">Regarding B:</span><span id="Ax2.p5.1.2" class="ltx_text"></span></p>
</div>
<div id="Ax2.p6" class="ltx_para">
<p id="Ax2.p6.1" class="ltx_p"><span id="Ax2.p6.1.1" class="ltx_text">For fixed <math id="Ax2.p6.m1" class="ltx_Math" alttext="\mathbf{U}_{1,1},...,\mathbf{U}_{1,N}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>N</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbf{U}_{1,1},...,\mathbf{U}_{1,N}</annotation></semantics></math>, dividing by <math id="Ax2.p6.m2" class="ltx_Math" alttext="M-1" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">M-1</annotation></semantics></math>, and due to the law of the large numbers we have:</span></p>
</div>
<div id="Ax2.p7" class="ltx_para">
<table id="Ax2.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ax2.Ex2.m1" class="ltx_Math" alttext="\begin{split}&amp;\lim_{M\to\infty}\frac{1}{M-1}\left(\sum_{l\in[N]}\sum_{m\in[N]\setminus l}\sum_{j\in[M]\setminus 1}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{j,m}{/\tau}}+\sum_{l\in[N]}\sum_{m\in[N]\setminus l}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{1,m}{/\tau}}\right)\\
&amp;=\underset{(\mathbf{u}_{1},...\mathbf{u}_{n})\sim p}{\E}\left[\sum_{l\in[N]\atop m\in[N]\setminus l}e^{\mathbf{U}_{1,l}^{\top}\mathbf{u}_{m}{/\tau}}\right]\\
&amp;=\sum_{m\in[N]\setminus l}\underset{{y\sim p_{init}}\atop{(T_{m})\sim\mathcal{T}^{N}}}{\E}\left[\sum_{l\in[N]}e^{\mathbf{U}_{1,l}^{\top}f(T_{m}(y)){/\tau}}\right]\\
&amp;=(N-1)\cdot\underset{{y\sim p_{init}}\atop{(T_{m})\sim\mathcal{T}^{N}}}{\E}\left[\sum_{l\in[N]}e^{\mathbf{U}_{1,l}^{\top}f(T_{m}(y)){/\tau}}\right]\\
&amp;=(N-1)\cdot\underset{\mathbf{u}\sim p_{trans}}{\E}\left[\sum_{l\in[N]}e^{\mathbf{U}_{1,l}^{\top}\mathbf{u}{/\tau}}\right]\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><mfrac><mn>1</mn><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>m</mi><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><mi>l</mi></mrow></mrow></munder><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><mn>1</mn></mrow></mrow></munder><msup><mi>e</mi><mrow><mrow><msubsup><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐔</mi><mrow><mi>j</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow></mrow></mrow><mo rspace="0.055em">+</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><mi>l</mi></mrow></mrow></munder><msup><mi>e</mi><mrow><mrow><msubsup><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>m</mi></mrow></msub></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">𝐮</mi><mn mathsize="0.710em">1</mn></msub><mo mathsize="0.700em">,</mo><mrow><mi mathsize="0.700em" mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.700em">𝐮</mi><mi mathsize="0.710em">n</mi></msub></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.700em">∼</mo><mi mathsize="0.700em">p</mi></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mfrac linethickness="0pt"><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mrow><mi>m</mi><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><mi>l</mi></mrow></mrow></mfrac></munder><msup><mi>e</mi><mrow><mrow><msubsup><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐮</mi><mi>m</mi></msub></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow><mo>]</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><mi>l</mi></mrow></mrow></munder><mrow><munder accentunder="true"><mi>𝔼</mi><mstyle displaystyle="false" scriptlevel="+1"><mfrac linethickness="0pt"><mrow><mi>y</mi><mo>∼</mo><msub><mi>p</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow><mrow><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mo>∼</mo><msup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>N</mi></msup></mrow></mfrac></mstyle></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow></munder><msup><mi>e</mi><mrow><mrow><msubsup><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><munder accentunder="true"><mi>𝔼</mi><mstyle displaystyle="false" scriptlevel="+1"><mfrac linethickness="0pt"><mrow><mi>y</mi><mo>∼</mo><msub><mi>p</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow><mrow><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mo>∼</mo><msup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>N</mi></msup></mrow></mfrac></mstyle></munder></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow></munder><msup><mi>e</mi><mrow><mrow><msubsup><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow><mo>]</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">𝐮</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">p</mi><mrow><mi mathsize="0.710em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">s</mi></mrow></msub></mrow></munder></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow></munder><msup><mi>e</mi><mrow><mrow><msubsup><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐮</mi></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow><mo>]</mo></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}&amp;\lim_{M\to\infty}\frac{1}{M-1}\left(\sum_{l\in[N]}\sum_{m\in[N]\setminus l}\sum_{j\in[M]\setminus 1}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{j,m}{/\tau}}+\sum_{l\in[N]}\sum_{m\in[N]\setminus l}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{1,m}{/\tau}}\right)\\
&amp;=\underset{(\mathbf{u}_{1},...\mathbf{u}_{n})\sim p}{\E}\left[\sum_{l\in[N]\atop m\in[N]\setminus l}e^{\mathbf{U}_{1,l}^{\top}\mathbf{u}_{m}{/\tau}}\right]\\
&amp;=\sum_{m\in[N]\setminus l}\underset{{y\sim p_{init}}\atop{(T_{m})\sim\mathcal{T}^{N}}}{\E}\left[\sum_{l\in[N]}e^{\mathbf{U}_{1,l}^{\top}f(T_{m}(y)){/\tau}}\right]\\
&amp;=(N-1)\cdot\underset{{y\sim p_{init}}\atop{(T_{m})\sim\mathcal{T}^{N}}}{\E}\left[\sum_{l\in[N]}e^{\mathbf{U}_{1,l}^{\top}f(T_{m}(y)){/\tau}}\right]\\
&amp;=(N-1)\cdot\underset{\mathbf{u}\sim p_{trans}}{\E}\left[\sum_{l\in[N]}e^{\mathbf{U}_{1,l}^{\top}\mathbf{u}{/\tau}}\right]\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="Ax2.p8" class="ltx_para">
<p id="Ax2.p8.1" class="ltx_p"><span id="Ax2.p8.1.1" class="ltx_text">Now, the same limit holds for the <math id="Ax2.p8.m1" class="ltx_Math" alttext="\log" display="inline" intent=":literal"><semantics><mi>log</mi><annotation encoding="application/x-tex">\log</annotation></semantics></math> due to the Continuous Mapping theorem, thus:</span></p>
</div>
<div id="Ax2.p9" class="ltx_para">
<table id="Ax2.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ax2.Ex3.m1" class="ltx_Math" alttext="\lim_{M\to\infty}\log\left({\sum_{l\in[N]\atop{j\in[M]\atop m\in[N]\setminus l}}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{j,m}{/\tau}}}\right)=\log\left((N-1)\cdot\underset{\mathbf{u}\sim p_{trans}}{\E}\left[\sum_{l\in[N]}e^{\mathbf{U}_{1,l}^{\top}\mathbf{u}{/\tau}}\right]\right)" display="block" intent=":literal"><semantics><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mfrac linethickness="0pt"><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mfrac linethickness="0pt"><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow><mrow><mi>m</mi><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><mi>l</mi></mrow></mrow></mfrac></mfrac></munder><msup><mi>e</mi><mrow><mrow><msubsup><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐔</mi><mrow><mi>j</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">𝐮</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">p</mi><mrow><mi mathsize="0.710em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">s</mi></mrow></msub></mrow></munder></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow></munder><msup><mi>e</mi><mrow><mrow><msubsup><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐮</mi></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow><mo>]</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lim_{M\to\infty}\log\left({\sum_{l\in[N]\atop{j\in[M]\atop m\in[N]\setminus l}}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{j,m}{/\tau}}}\right)=\log\left((N-1)\cdot\underset{\mathbf{u}\sim p_{trans}}{\E}\left[\sum_{l\in[N]}e^{\mathbf{U}_{1,l}^{\top}\mathbf{u}{/\tau}}\right]\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="Ax2.p10" class="ltx_para">
<p id="Ax2.p10.1" class="ltx_p"><span id="Ax2.p10.1.1" class="ltx_text">Due to the Dominated Convergence Theorem:</span></p>
<table id="Ax2.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ax2.Ex4.m1" class="ltx_Math" alttext="\begin{split}\lim_{M\to\infty}B&amp;=\underset{\mathbf{U}_{j}\overset{\text{i.i.d}}{\sim}f_{\#}p^{M}}{\E}\left[\lim_{M\to\infty}\log\left(\frac{1}{M-1}{\sum_{l\in[N]\atop{j\in[M]\atop m\in[N]\setminus l}}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{j,m}{/\tau}}}\right)\right]\\
&amp;=\underset{(\mathbf{U}_{1,1},...\mathbf{U}_{1,N})\sim f_{\#}p}{\E}\left[\log\left((N-1)\cdot\underset{\mathbf{u}\sim p_{trans}}{\E}\left[\sum_{l=1}^{N}e^{\mathbf{U}_{1,l}^{\top}\mathbf{u}{/\tau}}\right]\right)\right]\\
&amp;=\underset{(\mathbf{U}_{1,1},...\mathbf{U}_{1,N})\sim f_{\#}p}{\E}\left[\log\left((N-1)\cdot\sum_{l=1}^{N}\underset{\mathbf{u}\sim p_{trans}}{\E}\left[e^{\mathbf{U}_{1,l}^{\top}\mathbf{u}{/\tau}}\right]\right)\right]\\
&amp;=\underset{{x\sim p_{init}}\atop(T_{l})\sim\mathcal{T}^{N}}{\E}\left[\log\left((N-1)\cdot\sum_{l=1}^{N}\underset{\mathbf{u}\sim p_{trans}}{\E}\left[e^{f(T_{l}(x))^{\top}\mathbf{u}{/\tau}}\right]\right)\right]\\
&amp;=\underset{{\mathbf{v}\sim p_{trans}}}{\E}\left[\log\left(N(N-1)\cdot\underset{\mathbf{u}\sim p_{trans}}{\E}\left[e^{\mathbf{v}^{\top}\mathbf{u}{/\tau}}\right]\right)\right]\\
&amp;=\underset{{\mathbf{v}\sim p_{trans}}}{\E}\left[\log\left(\underset{\mathbf{u}\sim p_{trans}}{\E}\left[e^{\mathbf{v}^{\top}\mathbf{u}{/\tau}}\right]\right)\right]+\log N(N-1)\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mi>B</mi></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><msub><mi mathsize="0.700em">𝐔</mi><mi mathsize="0.710em">j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo mathsize="0.700em">∼</mo><mtext mathsize="0.500em">i.i.d</mtext></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.700em">f</mi><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.700em">p</mi><mi mathsize="0.710em">M</mi></msup></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mfrac linethickness="0pt"><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mfrac linethickness="0pt"><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow><mrow><mi>m</mi><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><mi>l</mi></mrow></mrow></mfrac></mfrac></munder><msup><mi>e</mi><mrow><mrow><msubsup><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐔</mi><mrow><mi>j</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">𝐔</mi><mrow><mn mathsize="0.710em">1</mn><mo mathsize="0.710em">,</mo><mn mathsize="0.710em">1</mn></mrow></msub><mo mathsize="0.700em">,</mo><mrow><mi mathsize="0.700em" mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.700em">𝐔</mi><mrow><mn mathsize="0.710em">1</mn><mo mathsize="0.710em">,</mo><mi mathsize="0.710em">N</mi></mrow></msub></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.700em">∼</mo><mrow><msub><mi mathsize="0.700em">f</mi><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">p</mi></mrow></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">𝐮</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">p</mi><mi mathsize="0.710em">trans</mi></msub></mrow></munder></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><msup><mi>e</mi><mrow><mrow><msubsup><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐮</mi></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow><mo>]</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">𝐔</mi><mrow><mn mathsize="0.710em">1</mn><mo mathsize="0.710em">,</mo><mn mathsize="0.710em">1</mn></mrow></msub><mo mathsize="0.700em">,</mo><mrow><mi mathsize="0.700em" mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.700em">𝐔</mi><mrow><mn mathsize="0.710em">1</mn><mo mathsize="0.710em">,</mo><mi mathsize="0.710em">N</mi></mrow></msub></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.700em">∼</mo><mrow><msub><mi mathsize="0.700em">f</mi><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">p</mi></mrow></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.055em">⋅</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">𝐮</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">p</mi><mi mathsize="0.710em">trans</mi></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mi>e</mi><mrow><mrow><msubsup><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐮</mi></mrow><mo>/</mo><mi>τ</mi></mrow></msup><mo>]</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mstyle displaystyle="false" scriptlevel="+1"><mfrac linethickness="0pt"><mrow><mi>x</mi><mo>∼</mo><msub><mi>p</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow><mrow><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow><mo>∼</mo><msup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>N</mi></msup></mrow></mfrac></mstyle></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.055em">⋅</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">𝐮</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">p</mi><mi mathsize="0.710em">trans</mi></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mi>e</mi><mrow><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐮</mi></mrow><mo>/</mo><mi>τ</mi></mrow></msup><mo>]</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">𝐯</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">p</mi><mrow><mi mathsize="0.710em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">s</mi></mrow></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">𝐮</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">p</mi><mi mathsize="0.710em">trans</mi></msub></mrow></munder></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mi>e</mi><mrow><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐮</mi></mrow><mo>/</mo><mi>τ</mi></mrow></msup><mo>]</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">𝐯</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">p</mi><mrow><mi mathsize="0.710em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">s</mi></mrow></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">𝐮</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">p</mi><mi mathsize="0.710em">trans</mi></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mi>e</mi><mrow><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐮</mi></mrow><mo>/</mo><mi>τ</mi></mrow></msup><mo>]</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\lim_{M\to\infty}B&amp;=\underset{\mathbf{U}_{j}\overset{\text{i.i.d}}{\sim}f_{\#}p^{M}}{\E}\left[\lim_{M\to\infty}\log\left(\frac{1}{M-1}{\sum_{l\in[N]\atop{j\in[M]\atop m\in[N]\setminus l}}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{j,m}{/\tau}}}\right)\right]\\
&amp;=\underset{(\mathbf{U}_{1,1},...\mathbf{U}_{1,N})\sim f_{\#}p}{\E}\left[\log\left((N-1)\cdot\underset{\mathbf{u}\sim p_{trans}}{\E}\left[\sum_{l=1}^{N}e^{\mathbf{U}_{1,l}^{\top}\mathbf{u}{/\tau}}\right]\right)\right]\\
&amp;=\underset{(\mathbf{U}_{1,1},...\mathbf{U}_{1,N})\sim f_{\#}p}{\E}\left[\log\left((N-1)\cdot\sum_{l=1}^{N}\underset{\mathbf{u}\sim p_{trans}}{\E}\left[e^{\mathbf{U}_{1,l}^{\top}\mathbf{u}{/\tau}}\right]\right)\right]\\
&amp;=\underset{{x\sim p_{init}}\atop(T_{l})\sim\mathcal{T}^{N}}{\E}\left[\log\left((N-1)\cdot\sum_{l=1}^{N}\underset{\mathbf{u}\sim p_{trans}}{\E}\left[e^{f(T_{l}(x))^{\top}\mathbf{u}{/\tau}}\right]\right)\right]\\
&amp;=\underset{{\mathbf{v}\sim p_{trans}}}{\E}\left[\log\left(N(N-1)\cdot\underset{\mathbf{u}\sim p_{trans}}{\E}\left[e^{\mathbf{v}^{\top}\mathbf{u}{/\tau}}\right]\right)\right]\\
&amp;=\underset{{\mathbf{v}\sim p_{trans}}}{\E}\left[\log\left(\underset{\mathbf{u}\sim p_{trans}}{\E}\left[e^{\mathbf{v}^{\top}\mathbf{u}{/\tau}}\right]\right)\right]+\log N(N-1)\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="Ax2.p11" class="ltx_para">
<p id="Ax2.p11.1" class="ltx_p"><span id="Ax2.p11.1.1" class="ltx_text">which, based on result 2 of Theorem 1 in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib1" title="" class="ltx_ref">1</a>]</cite>, if perfectly uniform encoders exist, they form the exact minimizers of <math id="Ax2.p11.m1" class="ltx_Math" alttext="\lim_{M\to\infty}B" display="inline" intent=":literal"><semantics><mrow><msub><mo>lim</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mi>B</mi></mrow><annotation encoding="application/x-tex">\lim_{M\to\infty}B</annotation></semantics></math>.</span></p>
</div>
<div id="Ax2.p12" class="ltx_para">
<p id="Ax2.p12.1" class="ltx_p"><span id="Ax2.p12.1.1" class="ltx_text ltx_underline ltx_font_bold">Regarding <math id="Ax2.p12.m1" class="ltx_Math" alttext="\Gamma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\Gamma</annotation></semantics></math></span><span id="Ax2.p12.1.2" class="ltx_text">: We deconstruct it via our sampling mechanism as follows:</span></p>
</div>
<div id="Ax2.p13" class="ltx_para">
<table id="Ax2.E27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ax2.E27.m1" class="ltx_Math" alttext="\begin{split}\Gamma+N\log(M-1)=&amp;\underset{\mathbf{U}_{j}\overset{\text{i.i.d}}{\sim}f_{\#}p^{M}}{\E}\left[\log\left({\prod_{l\in[N]}\sum_{{j\in[M-1]}}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{j,l}{/\tau}}}\right)\right]\\
=&amp;\underset{\mathbf{x}\sim p_{init}\atop(\mathbf{y}_{1},\dots,\mathbf{y}_{M-1})\sim p_{init}^{M-1}}{\E}\underset{(T_{l,j})\sim\mathcal{T}^{NM}}{\E}\left[\sum_{l=1}^{N}\log\left(\sum_{j=1}^{M-1}e^{f\big(T_{l,M}(\mathbf{x})\big)^{\top}f\big(T_{l,j}(\mathbf{y}_{j})\big){/\tau}}\right)\right]\\
=&amp;\underset{\mathbf{x}\sim p_{init}\atop(\mathbf{y}_{1},\dots,\mathbf{y}_{M-1})\sim p_{init}^{M-1}}{\E}\left[\sum_{l=1}^{N}\underset{(T_{l,j})\sim\mathcal{T}^{MN}}{\E}\left[\log\left(\sum_{j=1}^{M-1}e^{f\big(T_{l,M}(\mathbf{x})\big)^{\top}f\big(T_{l,j}(\mathbf{y}_{j})\big){/\tau}}\right)\right]\right]\\
=&amp;\underset{\mathbf{x}\sim p_{init}\atop(\mathbf{y}_{1},\dots,\mathbf{y}_{M-1})\sim p_{init}^{M-1}}{\E}\left[\sum_{l=1}^{N}\underset{(T_{j})\sim\mathcal{T}^{M}}{\E}\left[\log\left(\sum_{j=1}^{M-1}e^{f\big(T_{M}(\mathbf{x})\big)^{\top}f\big(T_{j}(\mathbf{y}_{j})\big){/\tau}}\right)\right]\right]\\
=&amp;\underset{\mathbf{x}\sim p_{init}\atop(\mathbf{y}_{1},\dots,\mathbf{y}_{M-1})\sim p_{init}^{M-1}}{\E}\left[N\underset{(T_{j})\sim\mathcal{T}^{M}}{\E}\left[\log\left(\sum_{j=1}^{M-1}e^{f\big(T_{M}(\mathbf{x})\big)^{\top}f\big(T_{j}(\mathbf{y}_{j})\big){/\tau}}\right)\right]\right]\\
=&amp;N\underset{\mathbf{v}\sim f_{\#}{p_{\text{trans}}}\atop\mathbf{u}_{j}\overset{\text{i.i.d}}{\sim}f_{\#}{p_{\text{trans}}}^{M-1}}{\E}\left[\log\left(\sum_{j=1}^{M-1}e^{\mathbf{v}^{\top}\mathbf{u}_{j}{/\tau}}\right)\right],\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mi mathvariant="normal">Γ</mi><mo>+</mo><mrow><mi>N</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><msub><mi mathsize="0.700em">𝐔</mi><mi mathsize="0.710em">j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo mathsize="0.700em">∼</mo><mtext mathsize="0.500em">i.i.d</mtext></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.700em">f</mi><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.700em">p</mi><mi mathsize="0.710em">M</mi></msup></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">∏</mo><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></munder><msup><mi>e</mi><mrow><mrow><msubsup><mi>𝐔</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐔</mi><mrow><mi>j</mi><mo>,</mo><mi>l</mi></mrow></msub></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><munder accentunder="true"><mi>𝔼</mi><mstyle displaystyle="false" scriptlevel="+1"><mfrac linethickness="0pt"><mrow><mi>𝐱</mi><mo>∼</mo><msub><mi>p</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow><mrow><mrow><mo stretchy="false">(</mo><msub><mi>𝐲</mi><mn>1</mn></msub><mo mathsize="1.400em">,</mo><mi mathvariant="normal">…</mi><mo mathsize="1.400em">,</mo><msub><mi>𝐲</mi><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo>∼</mo><msubsup><mi>p</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mfrac></mstyle></munder><mo lspace="0.167em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">T</mi><mrow><mi mathsize="0.710em">l</mi><mo mathsize="0.710em">,</mo><mi mathsize="0.710em">j</mi></mrow></msub><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.700em">∼</mo><msup><mi class="ltx_font_mathcaligraphic" mathsize="0.700em">𝒯</mi><mi mathsize="0.710em">NM</mi></msup></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow></munderover><msup><mi>e</mi><mrow><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.710em" minsize="1.710em">(</mo><mrow><msub><mi>T</mi><mrow><mi>l</mi><mo>,</mo><mi>M</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.710em" minsize="1.710em">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.710em" minsize="1.710em">(</mo><mrow><msub><mi>T</mi><mrow><mi>l</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐲</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.710em" minsize="1.710em">)</mo></mrow></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><munder accentunder="true"><mi>𝔼</mi><mstyle displaystyle="false" scriptlevel="+1"><mfrac linethickness="0pt"><mrow><mi>𝐱</mi><mo>∼</mo><msub><mi>p</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow><mrow><mrow><mo stretchy="false">(</mo><msub><mi>𝐲</mi><mn>1</mn></msub><mo mathsize="1.400em">,</mo><mi mathvariant="normal">…</mi><mo mathsize="1.400em">,</mo><msub><mi>𝐲</mi><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo>∼</mo><msubsup><mi>p</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mfrac></mstyle></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">T</mi><mrow><mi mathsize="0.710em">l</mi><mo mathsize="0.710em">,</mo><mi mathsize="0.710em">j</mi></mrow></msub><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.700em">∼</mo><msup><mi class="ltx_font_mathcaligraphic" mathsize="0.700em">𝒯</mi><mi mathsize="0.710em">MN</mi></msup></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow></munderover><msup><mi>e</mi><mrow><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.710em" minsize="1.710em">(</mo><mrow><msub><mi>T</mi><mrow><mi>l</mi><mo>,</mo><mi>M</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.710em" minsize="1.710em">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.710em" minsize="1.710em">(</mo><mrow><msub><mi>T</mi><mrow><mi>l</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐲</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.710em" minsize="1.710em">)</mo></mrow></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><munder accentunder="true"><mi>𝔼</mi><mstyle displaystyle="false" scriptlevel="+1"><mfrac linethickness="0pt"><mrow><mi>𝐱</mi><mo>∼</mo><msub><mi>p</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow><mrow><mrow><mo stretchy="false">(</mo><msub><mi>𝐲</mi><mn>1</mn></msub><mo mathsize="1.400em">,</mo><mi mathvariant="normal">…</mi><mo mathsize="1.400em">,</mo><msub><mi>𝐲</mi><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo>∼</mo><msubsup><mi>p</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mfrac></mstyle></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">T</mi><mi mathsize="0.710em">j</mi></msub><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.700em">∼</mo><msup><mi class="ltx_font_mathcaligraphic" mathsize="0.700em">𝒯</mi><mi mathsize="0.710em">M</mi></msup></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow></munderover><msup><mi>e</mi><mrow><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.710em" minsize="1.710em">(</mo><mrow><msub><mi>T</mi><mi>M</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.710em" minsize="1.710em">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.710em" minsize="1.710em">(</mo><mrow><msub><mi>T</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐲</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.710em" minsize="1.710em">)</mo></mrow></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><munder accentunder="true"><mi>𝔼</mi><mstyle displaystyle="false" scriptlevel="+1"><mfrac linethickness="0pt"><mrow><mi>𝐱</mi><mo>∼</mo><msub><mi>p</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow><mrow><mrow><mo stretchy="false">(</mo><msub><mi>𝐲</mi><mn>1</mn></msub><mo mathsize="1.400em">,</mo><mi mathvariant="normal">…</mi><mo mathsize="1.400em">,</mo><msub><mi>𝐲</mi><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo>∼</mo><msubsup><mi>p</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mfrac></mstyle></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>N</mi><mo lspace="0.167em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">T</mi><mi mathsize="0.710em">j</mi></msub><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.700em">∼</mo><msup><mi class="ltx_font_mathcaligraphic" mathsize="0.700em">𝒯</mi><mi mathsize="0.710em">M</mi></msup></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow></munderover><msup><mi>e</mi><mrow><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.710em" minsize="1.710em">(</mo><mrow><msub><mi>T</mi><mi>M</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.710em" minsize="1.710em">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.710em" minsize="1.710em">(</mo><mrow><msub><mi>T</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐲</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.710em" minsize="1.710em">)</mo></mrow></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>]</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>N</mi><mo lspace="0.167em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mstyle displaystyle="false" scriptlevel="+1"><mfrac linethickness="0pt"><mrow><mi>𝐯</mi><mo>∼</mo><mrow><msub><mi>f</mi><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mtext>trans</mtext></msub></mrow></mrow><mrow><msub><mi>𝐮</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo>∼</mo><mtext>i.i.d</mtext></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>p</mi><mtext>trans</mtext><mrow></mrow><mrow></mrow><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow></mmultiscripts></mrow></mfrac></mstyle></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow></munderover><msup><mi>e</mi><mrow><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐮</mi><mi>j</mi></msub></mrow><mo>/</mo><mi>τ</mi></mrow></msup></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>,</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\Gamma+N\log(M-1)=&amp;\underset{\mathbf{U}_{j}\overset{\text{i.i.d}}{\sim}f_{\#}p^{M}}{\E}\left[\log\left({\prod_{l\in[N]}\sum_{{j\in[M-1]}}e^{\mathbf{U}_{1,l}^{\top}\mathbf{U}_{j,l}{/\tau}}}\right)\right]\\
=&amp;\underset{\mathbf{x}\sim p_{init}\atop(\mathbf{y}_{1},\dots,\mathbf{y}_{M-1})\sim p_{init}^{M-1}}{\E}\underset{(T_{l,j})\sim\mathcal{T}^{NM}}{\E}\left[\sum_{l=1}^{N}\log\left(\sum_{j=1}^{M-1}e^{f\big(T_{l,M}(\mathbf{x})\big)^{\top}f\big(T_{l,j}(\mathbf{y}_{j})\big){/\tau}}\right)\right]\\
=&amp;\underset{\mathbf{x}\sim p_{init}\atop(\mathbf{y}_{1},\dots,\mathbf{y}_{M-1})\sim p_{init}^{M-1}}{\E}\left[\sum_{l=1}^{N}\underset{(T_{l,j})\sim\mathcal{T}^{MN}}{\E}\left[\log\left(\sum_{j=1}^{M-1}e^{f\big(T_{l,M}(\mathbf{x})\big)^{\top}f\big(T_{l,j}(\mathbf{y}_{j})\big){/\tau}}\right)\right]\right]\\
=&amp;\underset{\mathbf{x}\sim p_{init}\atop(\mathbf{y}_{1},\dots,\mathbf{y}_{M-1})\sim p_{init}^{M-1}}{\E}\left[\sum_{l=1}^{N}\underset{(T_{j})\sim\mathcal{T}^{M}}{\E}\left[\log\left(\sum_{j=1}^{M-1}e^{f\big(T_{M}(\mathbf{x})\big)^{\top}f\big(T_{j}(\mathbf{y}_{j})\big){/\tau}}\right)\right]\right]\\
=&amp;\underset{\mathbf{x}\sim p_{init}\atop(\mathbf{y}_{1},\dots,\mathbf{y}_{M-1})\sim p_{init}^{M-1}}{\E}\left[N\underset{(T_{j})\sim\mathcal{T}^{M}}{\E}\left[\log\left(\sum_{j=1}^{M-1}e^{f\big(T_{M}(\mathbf{x})\big)^{\top}f\big(T_{j}(\mathbf{y}_{j})\big){/\tau}}\right)\right]\right]\\
=&amp;N\underset{\mathbf{v}\sim f_{\#}{p_{\text{trans}}}\atop\mathbf{u}_{j}\overset{\text{i.i.d}}{\sim}f_{\#}{p_{\text{trans}}}^{M-1}}{\E}\left[\log\left(\sum_{j=1}^{M-1}e^{\mathbf{v}^{\top}\mathbf{u}_{j}{/\tau}}\right)\right],\end{split}</annotation></semantics></math></td>
