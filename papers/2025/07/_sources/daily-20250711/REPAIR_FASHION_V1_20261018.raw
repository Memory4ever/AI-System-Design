<td id="S5.T2.3.1.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T2.3.1.1.2.1" class="ltx_text"></span> <span id="S5.T2.3.1.1.2.2" class="ltx_text">
