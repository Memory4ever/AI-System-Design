<td id="S3.T1.3.1.4.2" class="ltx_td ltx_align_center ltx_border_tttt"><span id="S3.T1.3.1.4.2.1" class="ltx_text ltx_font_bold">Failure</span> (<math id="S3.T1.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math>)</td></tr>
