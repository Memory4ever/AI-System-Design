<tr id="S3.T1.3.1.8" class="ltx_tr">
<td id="S3.T1.3.1.8.1" class="ltx_td ltx_align_left">ImageReward <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib32" title="" class="ltx_ref">32</a>]</cite></td>
