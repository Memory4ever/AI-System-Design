<td id="S3.T1.3.1.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="S3.T1.3.1.1.2.1" class="ltx_text ltx_font_bold">Agreement</span> (<math id="S3.T1.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>)</td></tr>
<tr id="S3.T1.3.1.2" class="ltx_tr">
