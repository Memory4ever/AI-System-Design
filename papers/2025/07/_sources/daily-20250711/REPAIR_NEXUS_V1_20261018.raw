<tr id="S5.T1.3.2" class="ltx_tr">
<td id="S5.T1.3.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;" rowspan="2"><span id="S5.T1.3.2.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Long Data Collections</span></td>
<td id="S5.T1.3.2.2" class="ltx_td ltx_nopad_l ltx_align_left ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S5.T1.3.2.2.1" class="ltx_text" style="font-size:90%;">In</span></td>
<td id="S5.T1.3.2.3" class="ltx_td ltx_align_right ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S5.T1.3.2.3.1" class="ltx_text" style="font-size:90%;">5905</span></td>
<td id="S5.T1.3.2.4" class="ltx_td ltx_align_right ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S5.T1.3.2.4.1" class="ltx_text" style="font-size:90%;">5461</span></td>
<td id="S5.T1.3.2.5" class="ltx_td ltx_align_right ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S5.T1.3.2.5.1" class="ltx_text" style="font-size:90%;">9292</span></td>
<td id="S5.T1.3.2.6" class="ltx_td ltx_align_right ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S5.T1.3.2.6.1" class="ltx_text" style="font-size:90%;">9817</span></td></tr>
<tr id="S5.T1.3.3" class="ltx_tr">
<td id="S5.T1.3.3.1" class="ltx_td ltx_nopad_l ltx_align_left" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S5.T1.3.3.1.1" class="ltx_text" style="font-size:90%;">Out</span></td>
<td id="S5.T1.3.3.2" class="ltx_td ltx_align_right" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S5.T1.3.3.2.1" class="ltx_text" style="font-size:90%;">180</span></td>
<td id="S5.T1.3.3.3" class="ltx_td ltx_align_right" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S5.T1.3.3.3.1" class="ltx_text" style="font-size:90%;">159</span></td>
<td id="S5.T1.3.3.4" class="ltx_td ltx_align_right" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S5.T1.3.3.4.1" class="ltx_text" style="font-size:90%;">339</span></td>
<td id="S5.T1.3.3.5" class="ltx_td ltx_align_right" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S5.T1.3.3.5.1" class="ltx_text" style="font-size:90%;">454</span></td></tr>
<tr id="S5.T1.3.4" class="ltx_tr">
