<figure id="S3.F4.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2507.06608v1/plots/motivation1/motivation1_chunk_prefill_op_breakdown.png" id="S3.F4.sf2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/70;" width="476" height="70" alt="Refer to caption">
