            <span id="alg2.l11.3" class="ltx_text" style="font-size:90%;">  </span><span id="alg2.l11.4" class="ltx_text ltx_font_bold" style="font-size:90%;">for</span><span id="alg2.l11.5" class="ltx_text" style="font-size:90%;"> </span><math id="alg2.l11.m1" class="ltx_Math" alttext="r\in Q_{\text{sorted}}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">r</mi><mo mathsize="0.900em">∈</mo><msub><mi mathsize="0.900em">Q</mi><mtext mathsize="0.900em">sorted</mtext></msub></mrow><annotation encoding="application/x-tex">r\in Q_{\text{sorted}}</annotation></semantics></math><span id="alg2.l11.6" class="ltx_text" style="font-size:90%;"> </span><span id="alg2.l11.7" class="ltx_text ltx_font_bold" style="font-size:90%;">do</span><span id="alg2.l11.8" class="ltx_text" style="font-size:90%;">
</span>
</div>
