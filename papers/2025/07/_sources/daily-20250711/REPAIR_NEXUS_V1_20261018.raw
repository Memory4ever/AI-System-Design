<td id="S5.T1.3.4.2" class="ltx_td ltx_nopad_l ltx_align_left ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S5.T1.3.4.2.1" class="ltx_text" style="font-size:90%;">In</span></td>
<td id="S5.T1.3.4.3" class="ltx_td ltx_align_right ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S5.T1.3.4.3.1" class="ltx_text" style="font-size:90%;">3832</span></td>
<td id="S5.T1.3.4.4" class="ltx_td ltx_align_right ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S5.T1.3.4.4.1" class="ltx_text" style="font-size:90%;">3575</span></td>
<td id="S5.T1.3.4.5" class="ltx_td ltx_align_right ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S5.T1.3.4.5.1" class="ltx_text" style="font-size:90%;">6460</span></td>
<td id="S5.T1.3.4.6" class="ltx_td ltx_align_right ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S5.T1.3.4.6.1" class="ltx_text" style="font-size:90%;">6894</span></td></tr>
<tr id="S5.T1.3.5" class="ltx_tr">
<td id="S5.T1.3.5.1" class="ltx_td ltx_nopad_l ltx_align_left" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S5.T1.3.5.1.1" class="ltx_text" style="font-size:90%;">Out</span></td>
<td id="S5.T1.3.5.2" class="ltx_td ltx_align_right" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S5.T1.3.5.2.1" class="ltx_text" style="font-size:90%;">200</span></td>
<td id="S5.T1.3.5.3" class="ltx_td ltx_align_right" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S5.T1.3.5.3.1" class="ltx_text" style="font-size:90%;">181</span></td>
<td id="S5.T1.3.5.4" class="ltx_td ltx_align_right" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S5.T1.3.5.4.1" class="ltx_text" style="font-size:90%;">357</span></td>
<td id="S5.T1.3.5.5" class="ltx_td ltx_align_right" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S5.T1.3.5.5.1" class="ltx_text" style="font-size:90%;">443</span></td></tr>
<tr id="S5.T1.3.6" class="ltx_tr">
<td id="S5.T1.3.6.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;" rowspan="2"><span id="S5.T1.3.6.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">ShareGPT</span></td>
<td id="S5.T1.3.6.2" class="ltx_td ltx_nopad_l ltx_align_left ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S5.T1.3.6.2.1" class="ltx_text" style="font-size:90%;">In</span></td>
<td id="S5.T1.3.6.3" class="ltx_td ltx_align_right ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S5.T1.3.6.3.1" class="ltx_text" style="font-size:90%;">496</span></td>
<td id="S5.T1.3.6.4" class="ltx_td ltx_align_right ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S5.T1.3.6.4.1" class="ltx_text" style="font-size:90%;">432</span></td>
<td id="S5.T1.3.6.5" class="ltx_td ltx_align_right ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S5.T1.3.6.5.1" class="ltx_text" style="font-size:90%;">970</span></td>
<td id="S5.T1.3.6.6" class="ltx_td ltx_align_right ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S5.T1.3.6.6.1" class="ltx_text" style="font-size:90%;">1367</span></td></tr>
<tr id="S5.T1.3.7" class="ltx_tr">
<td id="S5.T1.3.7.1" class="ltx_td ltx_nopad_l ltx_align_left ltx_border_bb" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S5.T1.3.7.1.1" class="ltx_text" style="font-size:90%;">Out</span></td>
<td id="S5.T1.3.7.2" class="ltx_td ltx_align_right ltx_border_bb" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S5.T1.3.7.2.1" class="ltx_text" style="font-size:90%;">97</span></td>
<td id="S5.T1.3.7.3" class="ltx_td ltx_align_right ltx_border_bb" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S5.T1.3.7.3.1" class="ltx_text" style="font-size:90%;">37</span></td>
<td id="S5.T1.3.7.4" class="ltx_td ltx_align_right ltx_border_bb" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S5.T1.3.7.4.1" class="ltx_text" style="font-size:90%;">383</span></td>
<td id="S5.T1.3.7.5" class="ltx_td ltx_align_right ltx_border_bb" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S5.T1.3.7.5.1" class="ltx_text" style="font-size:90%;">474</span></td></tr>
