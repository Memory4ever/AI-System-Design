<div class="ltx_flex_cell ltx_flex_size_1">
<figure id="A1.F6.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2507.06528v1/invest_alpha0.6_theta7_glm_notation.svg" id="A1.F6.sf1.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:167/126;" width="167" height="126"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(a) </span>Figure <a href="#S3.F2" title="Figure 2 ‣ 3.3 Validation of Pre-SFT LLMs &amp; the Theoretical Solution ‣ 3 Problem Simplification &amp; Real-User Data Verification ‣ InvestAlign: Overcoming Data Scarcity in Aligning Large Language Models with Investor Decision-Making Processes under Herd Behavior" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a></figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<figure id="A1.F6.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2507.06528v1/grad_norm_glm.svg" id="A1.F6.sf2.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:167/125;" width="167" height="125"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(b) </span>Figure <a href="#S4.F3" title="Figure 3 ‣ 4.2 Analysis of Parameter Convergence Rates ‣ 4 Methodology: InvestAlign ‣ InvestAlign: Overcoming Data Scarcity in Aligning Large Language Models with Investor Decision-Making Processes under Herd Behavior" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a></figcaption>
