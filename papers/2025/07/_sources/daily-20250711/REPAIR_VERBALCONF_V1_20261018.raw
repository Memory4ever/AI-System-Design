</span></span></span></td>
<td id="S5.T5.2.1.3.3" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding:-1pt 2.5pt;"><span id="S5.T5.2.1.3.3.1" class="ltx_text ltx_font_italic">Base</span></td>
