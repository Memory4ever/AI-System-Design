</span>
</div>
<div id="alg3.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
            <span id="alg3.l3.3" class="ltx_text" style="font-size:90%;">SplitPoint = Choose random integer between 0 and m-2
</span>
</div>
<div id="alg3.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
            <math id="alg3.l4.m1" class="ltx_Math" alttext="\mathbf{C}_{1}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">𝐂</mi><mn mathsize="0.900em">1</mn></msub><annotation encoding="application/x-tex">\mathbf{C}_{1}</annotation></semantics></math><span id="alg3.l4.3" class="ltx_text" style="font-size:90%;"> = </span><math id="alg3.l4.m2" class="ltx_math_unparsed" alttext="\mathbf{P}_{1}[:SplitPoint]+\mathbf{P}_{2}[SplitPoint:]" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">𝐏</mi><mn mathsize="0.900em">1</mn></msub><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mo mathsize="0.900em" rspace="0.278em">:</mo><mi mathsize="0.900em">S</mi><mi mathsize="0.900em">p</mi><mi mathsize="0.900em">l</mi><mi mathsize="0.900em">i</mi><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">P</mi><mi mathsize="0.900em">o</mi><mi mathsize="0.900em">i</mi><mi mathsize="0.900em">n</mi><mi mathsize="0.900em">t</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mo mathsize="0.900em">+</mo><msub><mi mathsize="0.900em">𝐏</mi><mn mathsize="0.900em">2</mn></msub><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">S</mi><mi mathsize="0.900em">p</mi><mi mathsize="0.900em">l</mi><mi mathsize="0.900em">i</mi><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">P</mi><mi mathsize="0.900em">o</mi><mi mathsize="0.900em">i</mi><mi mathsize="0.900em">n</mi><mi mathsize="0.900em">t</mi><mo lspace="0.278em" mathsize="0.900em" rspace="0em">:</mo><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{P}_{1}[:SplitPoint]+\mathbf{P}_{2}[SplitPoint:]</annotation></semantics></math><span id="alg3.l4.4" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg3.l5" class="ltx_listingline">
