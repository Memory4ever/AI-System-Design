            <span id="alg1.l1.3" class="ltx_text ltx_font_bold" style="font-size:80%;">Input:</span><span id="alg1.l1.4" class="ltx_text" style="font-size:80%;"> Set of confidence estimation methods </span><math id="alg1.l1.m1" class="ltx_Math" alttext="\mathbf{Z}" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">𝐙</mi><annotation encoding="application/x-tex">\mathbf{Z}</annotation></semantics></math><span id="alg1.l1.5" class="ltx_text" style="font-size:80%;">, Set of training prompts </span><math id="alg1.l1.m2" class="ltx_Math" alttext="\mathbf{X}" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">𝐗</mi><annotation encoding="application/x-tex">\mathbf{X}</annotation></semantics></math><span id="alg1.l1.6" class="ltx_text" style="font-size:80%;">, # generations </span><math id="alg1.l1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math><span id="alg1.l1.7" class="ltx_text" style="font-size:80%;">, # prompts </span><math id="alg1.l1.m4" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math><span id="alg1.l1.8" class="ltx_text" style="font-size:80%;">, # tokens per prompt </span><math id="alg1.l1.m5" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math><span id="alg1.l1.9" class="ltx_text" style="font-size:80%;">, # samples for initial estimation </span><math id="alg1.l1.m6" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math><span id="alg1.l1.10" class="ltx_text" style="font-size:80%;">, # training samples per it