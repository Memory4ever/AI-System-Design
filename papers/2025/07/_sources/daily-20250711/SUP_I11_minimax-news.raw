":\"https://www.minimax.io/#logo\",\"url\":\"https://filecdn.minimax.chat/public/58eca777-e31f-448a-9823-e2220e49b426.png\",\"contentUrl\":\"https://filecdn.minimax.chat/public/58eca777-e31f-448a-9823-e2220e49b426.png\",\"caption\":\"MiniMax\",\"width\":512,\"height\":512},\"slogan\":\"Intelligence with Everyone\",\"foundingDate\":\"2021-12\",\"description\":\"Building AGI with our mission Intelligence with Everyone. Global leader in multi-modal models and AI-native products with over 200 million users.\",\"email\":\"api@minimax.io\",\"contactPoint\":{\"@type\":\"ContactPoint\",\"contactType\":\"customer service\",\"email\":\"api@minimax.io\",\"areaServed\":\"Global\",\"availableLanguage\":[\"en\",\"zh\"]},\"sameAs\":[\"https://github.com/MiniMax-AI\",\"https://x.com/MiniMax__AI\",\"https://www.linkedin.com/company/minimax-ai/\",\"https://huggingface.co/MiniMaxAI\",\"https://minimax.io/discord\",\"https://en.wikipedia.org/wiki/MiniMax_(company)\"]},{\"@type\":\"Brand\",\"@id\":\"https://www.minimax.io/#brand\",\"name\":\"MiniMax\",\"url\":\"https://www.minimax.io\",\"logo\":\"https://filecdn.minimax.chat/public/58eca777-e31f-448a-9823-e2220e49b426.png\",\"description\":\"Building AGI with our mission Intelligence with Everyone. Global leader in multi-modal models and AI-native products with over 200 million users.\",\"slogan\":\"Intelligence with Everyone\"},{\"@type\":\"WebSite\",\"@id\":\"https://www.minimax.io/#website\",\"url\":\"https://www.minimax.io\",\"name\":\"MiniMax\",\"description\":\"Building AGI with our mission Intelligence with Everyone. Global leader in multi-modal models and AI-native products with over 200 million users.\",\"publisher\":{\"@id\":\"https://www.minimax.io/#organization\"},\"inLanguage\":\"en-US\",\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https://www.minimax.io/news\"}}},{\"@type\":\"NewsArticle\",\"@id\":\"https://www.minimax.io/news/ai-education-for-underprivileged-youth-in-hk#article\",\"headline\":\"Empowering the Next Generation: MiniMax Supports AI Education for Underprivileged Youth in Hong Kong\",\"description\":\"MiniMax partners with Hong Kong government to provide free AI education for underprivileged youth. Unlimited Hailuo Video access, GenAI workshops, empowering next generation creators.\",\"image\":[],\"author\":{\"@id\":\"https://www.minimax.io/#organization\"},\"publisher\":{\"@id\":\"https://www.minimax.io/#organization\"},\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://www.minimax.io/news/ai-education-for-underprivileged-youth-in-hk\"},\"articleSection\":\"News\",\"inLanguage\":\"en-US\",\"isAccessibleForFree\":true,\"copyrightYear\":2026,\"copyrightHolder\":{\"@id\":\"https://www.minimax.io/#organization\"}},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://www.minimax.io/news/ai-education-for-underprivileged-youth-in-hk#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.minimax.io\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"What's New\",\"item\":\"https://www.minimax.io/news\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Empowering the Next Generation: MiniMax Supports AI Education for Underprivileged Youth in Hong Kong\",\"item\":\"https://www.minimax.io/news/ai-education-for-underprivileged-youth-in-hk\"}]}]}"])</script><script>self.__next_f.push([1,"7:[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$19\"}}],[\"$\",\"$L1a\",null,{\"data\":{\"base_resp\":{\"status_code\":0,\"status_msg\":\"success\"},\"title\":\"AI Education for Underprivileged Youth in HK\",\"summary\":\"MiniMax partners with Hong Kong government to provide free AI education for underprivileged youth. Unlimited Hailuo Video access, GenAI workshops, empowering next generation creators.\",\"content\":[{\"id\":\"f9e16757-bbee-46cc-b0e6-2773f2bcdfbb\",\"type\":\"ArticleTitle\",\"props\":{\"date\":\"July 10, 2025 \",\"title\":\"Empowering the Next Generation: MiniMax Supports AI Education for Underprivileged Youth in Hong Kong\",\"buttons\":[]},\"children\":[]},{\"id\":\"40af376b-bbaf-4537-9752-c70d2cf66284\",\"type\":\"ArticleParagraph\",\"props\":{\"content\":\"MiniMax is honored to serve as the \u003cstrong\u003eOfficial AI Service Partner\u003c/strong\u003e for the \u003cstrong\u003e\\\"Star Mentors Event: GenAI Workshop Series（星級導師活動：生成式人工智能工作坊）\\\" \u003c/strong\u003epart of the third cohort of the \u003cstrong\u003eStrive and Rise Programme（共創明『Teen』計劃）\u003c/strong\u003e, led by the Chief Secretary for Administration of the HKSAR Government（香港區政府政務司司長） in collaboration with \u003cstrong\u003eHKITDA \u003c/strong\u003e(Hong Kong Innovative Technology Development Association, 香港創科發展協會).\"},\"children\":[]},{\"id\":\"d07da679-d142-45a0-823d-f196bb20aadd\",\"type\":\"ArticleImage\",\"props\":{\"src\":\"https://filecdn.minimax.chat/public/99080256-d1b1-4d7e-b13d-64eaac7b5d47.png\"},\"children\":[]},{\"id\":\"142d2759-0230-4f46-9384-a9cb86cbf857\",\"type\":\"ArticleHeader\",\"props\":{\"level\":\"h3\",\"content\":\"About the Strive and Rise Programme（關於共創明『Teen』計劃）\"},\"children\":[]},{\"id\":\"ffd6fbf9-67d4-4c49-8813-46f86583351d\",\"type\":\"ArticleParagraph\",\"props\":{\"content\":\"The Strive and Rise Programme in Hong Kong is a large-scale mentorship initiative designed to uplift \u003cstrong\u003eunderprivileged junior secondary school students\u003c/strong\u003e across Hong Kong. Through structured guidance, personal development, and access to new technologies, the programme nurtures students’ potential and helps pave more inclusive pathways to success.\u003c/br\u003e\\nNow in its third cohort, the programme has added a future-focused component: introducing students to \u003cstrong\u003egenerative AI\u003c/strong\u003e and its creative potential.\"},\"children\":[]},{\"id\":\"0786a122-ddc9-4aaf-8ecd-a43280521d9b\",\"type\":\"ArticleImage\",\"props\":{\"src\":\"https://filecdn.minimax.chat/public/ade26881-4027-4524-9a62-c1c17fd86aee.PNG\",\"aspectRatio\":\"2:3.366\"},\"children\":[]},{\"id\":\"255c7140-8dc5-48a4-b240-f63bfad1d0b2\",\"type\":\"ArticleHeader\",\"props\":{\"level\":\"h3\",\"content\":\"Lowering Barriers to Innovation: Making AI Accessible to All\"},\"children\":[]},{\"id\":\"cb88c0bc-bb97-42f2-97e4-242ba1c459ca\",\"type\":\"ArticleParagraph\",\"props\":{\"content\":\"To support this impactful initiative, MiniMax is providing two months of complimentary, unlimited access to Hailuo Video for all participating students and educators.\u003c/br\u003e\\nThe first \u003cstrong\u003eGenAI workshop\u003c/strong\u003e, held on \u003cstrong\u003eJuly 5\u003c/strong\u003e, gave students hands-on experience in transforming their ideas into complete, AI-generated videos. Led by a team of dedicated mentors — including our \u003cstrong\u003eStar Creator, Kai Wing\u003c/strong\u003e — the session showcased how intuitive, low-barrier tools can unlock creative potential and build confidence, regardless of prior technical experience.\"},\"children\":[]},{\"id\":\"4689a4f9-dbff-45fe-9b35-f9f00c469395\",\"type\":\"ArticleImage\",\"props\":{\"caption\":\"\",\"src\":\"https://filecdn.minimax.chat/public/c13c69c3-fd2a-41b9-8d59-4230ecca980d.PNG\"},\"children\":[]},{\"id\":\"cf54f717-7a19-4546-ba80-fb355dc2343c\",\"type\":\"ArticleHeader\",\"props\":{\"level\":\"h3\",\"content\":\"Looking Ahead: Building Lasting Impact\"},\"children\":[]},{\"id\":\"902c0fcb-76a4-4b5e-8301-8d3a07be587d\",\"type\":\"ArticleParagraph\",\"props\":{\"content\":\"With \u003cstrong\u003etwo more workshop sessions scheduled in the coming week\u003c/strong\u003e, we are excited to continue supporting students as they explore the boundaries of storytelling, design, and AI-powered creation. These sessions aim not just to teach tools, but to inspire confidence — showing that with the right access and encouragement, \u003cstrong\u003einnovation belongs to everyone\u003c/strong\u003e.\"},\"children\":[]},{\"id\":\"ae255528-584d-4a4c-a15c-d812ce7ec1b9\",\"type\":\"ArticleImage\",\"props\":{\"src\":\"https://filecdn.minimax.chat/public/0d795ced-7c65-4c69-a2cd-bc859857b3c1.png\",\"aspectRatio\":\"4.000000 : 1.456747\"},\"children\":[]},{\"id\":\"570fc95f-629e-40b6-ae84-6e5d232f689c\",\"type\":\"ArticleHeader\",\"props\":{\"level\":\"h3\",\"content\":\"Stay Tuned\"},\"children\":[]},{\"id\":\"50de6e3f-95b8-4abf-b0de-47d02390a52d\",\"type\":\"ArticleParagraph\",\"props\":{\"content\":\"We’re incredibly proud of these young creators and can't wait to see what they’ll build next. MiniMax will continue to explore partnerships that align with our values — \u003cstrong\u003eIntelligence with Everyone\u003c/strong\u003e.\"},\"children\":[]}],\"slug\":\"ai-education-for-underprivileged-youth-in-hk\"}}]]\n"])</script></body></html>