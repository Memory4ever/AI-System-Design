ding-[24px] font-[400] no-underline flex items-center justify-between text-[#181E25]" href="https://ir.minimax.io/"><div class="flex items-center gap-[8px]"><span>Investor Relations</span></div></a></div></div></div></div></div></div><div class="mt-[24px] pt-[24px] border-t border-[#F2F3F5]"><div class="h-[44px] rounded-[32px] bg-[#F5F5F5] animate-pulse"></div></div></div></div></div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://www.minimax.io/#organization","name":"MiniMax","legalName":"MiniMax","url":"https://www.minimax.io","logo":{"@type":"ImageObject","@id":"https://www.minimax.io/#logo","url":"https://filecdn.minimax.chat/public/58eca777-e31f-448a-9823-e2220e49b426.png","contentUrl":"https://filecdn.minimax.chat/public/58eca777-e31f-448a-9823-e2220e49b426.png","caption":"MiniMax","width":512,"height":512},"slogan":"Intelligence with Everyone","foundingDate":"2021-12","description":"Building AGI with our mission Intelligence with Everyone. Global leader in multi-modal models and AI-native products with over 200 million users.","email":"api@minimax.io","contactPoint":{"@type":"ContactPoint","contactType":"customer service","email":"api@minimax.io","areaServed":"Global","availableLanguage":["en","zh"]},"sameAs":["https://github.com/MiniMax-AI","https://x.com/MiniMax__AI","https://www.linkedin.com/company/minimax-ai/","https://huggingface.co/MiniMaxAI","https://minimax.io/discord","https://en.wikipedia.org/wiki/MiniMax_(company)"]},{"@type":"Brand","@id":"https://www.minimax.io/#brand","name":"MiniMax","url":"https://www.minimax.io","logo":"https://filecdn.minimax.chat/public/58eca777-e31f-448a-9823-e2220e49b426.png","description":"Building AGI with our mission Intelligence with Everyone. Global leader in multi-modal models and AI-native products with over 200 million users.","slogan":"Intelligence with Everyone"},{"@type":"WebSite","@id":"https://www.minimax.io/#website","url":"https://www.minimax.io","name":"MiniMax","description":"Building AGI with our mission Intelligence with Everyone. Global leader in multi-modal models and AI-native products with over 200 million users.","publisher":{"@id":"https://www.minimax.io/#organization"},"inLanguage":"en-US","potentialAction":{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https://www.minimax.io/news"}}},{"@type":"NewsArticle","@id":"https://www.minimax.io/news/ai-education-for-underprivileged-youth-in-hk#article","headline":"Empowering the Next Generation: MiniMax Supports AI Education for Underprivileged Youth in Hong Kong","description":"MiniMax partners with Hong Kong government to provide free AI education for underprivileged youth. Unlimited Hailuo Video access, GenAI workshops, empowering next generation creators.","image":[],"author":{"@id":"https://www.minimax.io/#organization"},"publisher":{"@id":"https://www.minimax.io/#organization"},"mainEntityOfPage":{"@type":"WebPage","@id":"https://www.minimax.io/news/ai-education-for-underprivileged-youth-in-hk"},"articleSection":"News","inLanguage":"en-US","isAccessibleForFree":true,"copyrightYear":2026,"copyrightHolder":{"@id":"https://www.minimax.io/#organization"}},{"@type":"BreadcrumbList","@id":"https://www.minimax.io/news/ai-education-for-underprivileged-youth-in-hk#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.minimax.io"},{"@type":"ListItem","position":2,"name":"What's New","item":"https://www.minimax.io/news"},{"@type":"ListItem","position":3,"name":"Empowering the Next Generation: MiniMax Supports AI Education for Underprivileged Youth in Hong Kong","item":"https://www.minimax.io/news/ai-education-for-underprivileged-youth-in-hk"}]}]}</script><main class="flex flex-col items-center w-full overflow-y-auto flex-1 pb-[160px] min-h-screen"><div class="px-[20px] lg:px-0 lg:w-[1000px] flex flex-col items-center mt-[80px]"><div class="text-brand-1 text-[14px] font-[400] leading-[21px] mb-[24px]">July 10, 2025 </div><h1 class="m-0 p-0 text-center text-brand-1 text-[54px] font-[500] leading-[86.4px] pb-[36px]">Empowering the Next Generation: MiniMax Supports AI Education for Underprivileged Youth in Hong Kong</h1></div><div class="w-full px-[20px] lg:px-0 lg:w-[768px] m-0 p-0 text-brand-1 text-[16px] font-[300] leading-[28.8px] [&amp;&gt;strong]:font-[500] [&amp;&gt;b]:font-[500] [&amp;&gt;a]:text-col-brand-00 [&amp;&gt;a]:no-underline [&amp;&gt;a:hover]:underline">MiniMax is honored to serve as the <strong>Official AI Service Partner</strong> for the <strong>"Star Mentors Event: GenAI Workshop Series（星級導師活動：生成式人工智能工作坊）" </strong>part of the third cohort of the <strong>Strive and Rise Programme（共創明『Teen』計劃）</strong>, led by the Chief Secretary for Administration of the HKSAR Government（香港區政府政務司司長） in collaboration with <strong>HKITDA </strong>(Hong Kong Innovative Technology Development Association, 香港創科發展協會).</div><div class="w-full px-[20px] lg:px-0 lg:w-[768px] py-[48px]"><div class="flex justify-center"><div class="relative max-w-full overflow-hidden" style="width:768px;height:576px"><img alt="" fetchPriority="high" decoding="async" data-nimg="fill" class="rounded-[12px] object-contain object-top" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="100vw" srcSet="/_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2F99080256-d1b1-4d7e-b13d-64eaac7b5d47.png&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2F99080256-d1b1-4d7e-b13d-64eaac7b5d47.png&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2F99080256-d1b1-4d7e-b13d-64eaac7b5d47.png&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2F99080256-d1b1-4d7e-b13d-64eaac7b5d47.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2F99080256-d1b1-4d7e-b13d-64eaac7b5d47.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2F99080256-d1b1-4d7e-b13d-64eaac7b5d47.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2F99080256-d1b1-4d7e-b13d-64eaac7b5d47.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2F99080256-d1b1-4d7e-b13d-64eaac7b5d47.png&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2F99080256-d1b1-4d7e-b13d-64eaac7b5d47.png&amp;w=3840&amp;q=75"/></div></div></div><h3 class="w-full px-[20px] lg:px-0 lg:w-[768px] m-0 p-0 text-brand-1 text-[24px] font-[500] leading-[36px] mb-[16px]">About the Strive and Rise Programme（關於共創明『Teen』計劃）</h3><div class="w-full px-[20px] lg:px-0 lg:w-[768px] m-0 p-0 text-brand-1 text-[16px] font-[300] leading-[28.8px] [&amp;&gt;strong]:font-[500] [&amp;&gt;b]:font-[500] [&amp;&gt;a]:text-col-brand-00 [&amp;&gt;a]:no-underline [&amp;&gt;a:hover]:underline">The Strive and Rise Programme in Hong Kong is a large-scale mentorship initiative designed to uplift <strong>underprivileged junior secondary school students</strong> across Hong Kong. Through structured guidance, personal development, and access to new technologies, the programme nurtures students’ potential and helps pave more inclusive pathways to success.</br>
Now in its third cohort, the programme has added a future-focused component: introducing students to <strong>generative AI</strong> and its creative potential.</div><div class="w-full px-[20px] lg:px-0 lg:w-[768px] py-[48px]"><div class="flex justify-center"><div class="relative max-w-full overflow-hidden" style="width:384px;height:646.272px"><img alt="" fetchPriority="high" decoding="async" data-nimg="fill" class="rounded-[12px] object-contain object-top" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="100vw" srcSet="/_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2Fade26881-4027-4524-9a62-c1c17fd86aee.PNG&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2Fade26881-4027-4524-9a62-c1c17fd86aee.PNG&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2Fade26881-4027-4524-9a62-c1c17fd86aee.PNG&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2Fade26881-4027-4524-9a62-c1c17fd86aee.PNG&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2Fade26881-4027-4524-9a62-c1c17fd86aee.PNG&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2Fade26881-4027-4524-9a62-c1c17fd86aee.PNG&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2Fade26881-4027-4524-9a62-c1c17fd86aee.PNG&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2Fade26881-4027-4524-9a62-c1c17fd86aee.PNG&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2Fade26881-4027-4524-9a62-c1c17fd86aee.PNG&amp;w=3840&amp;q=75"/></div></div></div><h3 class="w-full px-[20px] lg:px-0 lg:w-[768px] m-0 p-0 text-brand-1 text-[24px] font-[500] leading-[36px] mb-[16px]">Lowering Barriers to Innovation: Making AI Accessible to All</h3><div class="w-full px-[20px] lg:px-0 lg:w-[768px] m-0 p-0 text-brand-1 text-[16px] font-[300] leading-[28.8px] [&amp;&gt;strong]:font-[500] [&amp;&gt;b]:font-[500] [&amp;&gt;a]:text-col-brand-00 [&amp;&gt;a]:no-underline [&amp;&gt;a:hover]:underline">To support this impactful initiative, MiniMax is providing two months of complimentary, unlimited access to Hailuo Video for all participating students and educators.</br>
The first <strong>GenAI workshop</strong>, held on <strong>July 5</strong>, gave students hands-on experience in transforming their ideas into complete, AI-generated videos. Led by a team of dedicated mentors — including our <strong>Star Creator, Kai Wing</strong> — the session showcased how intuitive, low-barrier tools can unlock creative potential and build confidence, regardless of prior technical experience.</div><div class="w-full px-[20px] lg:px-0 lg:w-[768px] py-[48px]"><div class="flex justify-center"><div class="relative max-w-full overflow-hidden" style="width:768px;height:576px"><img alt="" fetchPriority="high" decoding="async" data-nimg="fill" class="rounded-[12px] object-contain object-top" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="100vw" srcSet="/_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2Fc13c69c3-fd2a-41b9-8d59-4230ecca980d.PNG&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2Fc13c69c3-fd2a-41b9-8d59-4230ecca980d.PNG&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2Fc13c69c3-fd2a-41b9-8d59-4230ecca980d.PNG&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2Fc13c69c3-fd2a-41b9-8d59-4230ecca980d.PNG&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2Fc13c69c3-fd2a-41b9-8d59-4230ecca980d.PNG&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2Fc13c69c3-fd2a-41b9-8d59-4230ecca980d.PNG&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2Fc13c69c3-fd2a-41b9-8d59-4230ecca980d.PNG&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2Fc13c69c3-fd2a-41b9-8d59-4230ecca980d.PNG&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2Fc13c69c3-fd2a-41b9-8d59-4230ecca980d.PNG&amp;w=3840&amp;q=75"/></div></div></div><h3 class="w-full px-[20px] lg:px-0 lg:w-[768px] m-0 p-0 text-brand-1 text-[24px] font-[500] leading-[36px] mb-[16px]">Looking Ahead: Building Lasting Impact</h3><div class="w-full px-[20px] lg:px-0 lg:w-[768px] m-0 p-0 text-brand-1 text-[16px] font-[300] leading-[28.8px] [&amp;&gt;strong]:font-[500] [&amp;&gt;b]:font-[500] [&amp;&gt;a]:text-col-brand-00 [&amp;&gt;a]:no-underline [&amp;&gt;a:hover]:underline">With <strong>two more workshop sessions scheduled in the coming week</strong>, we are excited to continue supporting students as they explore the boundaries of storytelling, design, and AI-powered creation. These sessions aim not just to teach tools, but to inspire confidence — showing that with the right access and encouragement, <strong>innovation belongs to everyone</strong>.</div><div class="w-full px-[20px] lg:px-0 lg:w-[768px] py-[48px]"><div class="flex justify-center"><div class="relative max-w-full overflow-hidden" style="width:768px;height:279.695424px"><img alt="" fetchPriority="high" decoding="async" data-nimg="fill" class="rounded-[12px] object-contain object-top" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="100vw" srcSet="/_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2F0d795ced-7c65-4c69-a2cd-bc859857b3c1.png&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2F0d795ced-7c65-4c69-a2cd-bc859857b3c1.png&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2F0d795ced-7c65-4c69-a2cd-bc859857b3c1.png&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2F0d795ced-7c65-4c69-a2cd-bc859857b3c1.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2F0d795ced-7c65-4c69-a2cd-bc859857b3c1.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2F0d795ced-7c65-4c69-a2cd-bc859857b3c1.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2F0d795ced-7c65-4c69-a2cd-bc859857b3c1.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2F0d795ced-7c65-4c69-a2cd-bc859857b3c1.png&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Ffilecdn.minimax.chat%2Fpublic%2F0d795ced-7c65-4c69-a2cd-bc859857b3c1.png&amp;w=3840&amp;q=75"/></div></div></div><h3 class="w-full px-[20px] lg:px-0 lg:w-[768px] m-0 p-0 text-brand-1 text-[24px] font-[500] leading-[36px] mb-[16px]">Stay Tuned</h3><div class="w-full px-[20px] lg:px-0 lg:w-[768px] m-0 p-0 text-brand-1 text-[16px] font-[300] leading-[28.8px] [&amp;&gt;strong]:font-[500] [&amp;&gt;b]:font-[500] [&amp;&gt;a]:text-col-brand-00 [&amp;&gt;a]:no-underline [&amp;&gt;a:hover]:underline">We’re incredibly proud of these young creators and can't wait to see what they’ll build next. MiniMax will continue to explore partnerships that align with our values — <strong>Intelligence with Everyone</strong>.</div></main><footer class="bg-black px-6 md:px-[60px] pt-20 pb-10"><div class="max-w-[1920px] mx-auto"></div></footer><script src="https://file.cdn.minimax.io/open_platform_web/prod-en-minimax-0.1.92/_next/static/chunks/webpack-d12ed500995eea27.js" async=""></script><script>(self.__next_f=self.__next_f||[]).push([0]);self.__next_f.push([2,null])</script><script>self.__next_f.push([1,"1:HL[\"https://file.cdn.minimax.io/open_platform_web/prod-en-minimax-0.1.92/_next/static/css/3c3a8b1e2c34daf6.css\",\"style\"]\n2:HL[\"https://file.cdn.minimax.io/open_platform_web/prod-en-minimax-0.1.92/_next/static/css/d8e3b3484e561eab.css\",\"style\"]\n3:HL[\"https://file.cdn.minimax.io/open_platform_web/prod-en-minimax-0.1.92/_next/static/css/0b3795b5632a5dce.css\",\"style\"]\n4:HL[\"https://file.cdn.minimax.io/open_platform_web/prod-en-minimax-0.1.92/_next/static/css/5cc4a1b41a53e6d7.css\",\"style\"]\n"])</script><script>self.__next_f.push([1,"5:I[73650,[],\"\"]\n8:I[714