<tr id="A3.T2.3.1.4" class="ltx_tr">
<th id="A3.T2.3.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><span id="A3.T2.3.1.4.1.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">PERK</span><span id="A3.T2.3.1.4.1.2" class="ltx_text" style="font-size:90%;"> 4 Steps</span></th>
<td id="A3.T2.3.1.4.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="A3.T2.3.1.4.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">100</span></td>
