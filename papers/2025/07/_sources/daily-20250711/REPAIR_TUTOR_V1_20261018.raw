<td id="A2.T7.2.1.14.2" class="ltx_td ltx_align_left ltx_border_r">giving_instruction</td>
<td id="A2.T7.2.1.14.3" class="ltx_td ltx_align_center ltx_border_r">65</td>
<td id="A2.T7.2.1.14.4" class="ltx_td ltx_align_left ltx_border_r">giving_instruction</td>
<td id="A2.T7.2.1.14.5" class="ltx_td ltx_align_left ltx_border_r">confirmatory_feedback</td>
<td id="A2.T7.2.1.14.6" class="ltx_td ltx_align_center ltx_border_r">54</td></tr>
<tr id="A2.T7.2.1.15" class="ltx_tr">
<td id="A2.T7.2.1.15.1" class="ltx_td ltx_align_left ltx_border_b ltx_border_l ltx_border_r">questioning</td>
<td id="A2.T7.2.1.15.2" class="ltx_td ltx_align_left ltx_border_b ltx_border_r">giving_explanation</td>
<td id="A2.T7.2.1.15.3" class="ltx_td ltx_align_center ltx_border_b ltx_border_r">61</td>
<td id="A2.T7.2.1.15.4" class="ltx_td ltx_align_left ltx_border_b ltx_border_r">questioning</td>
<td id="A2.T7.2.1.15.5" class="ltx_td ltx_align_left ltx_border_b ltx_border_r">giving_instruction</td>
