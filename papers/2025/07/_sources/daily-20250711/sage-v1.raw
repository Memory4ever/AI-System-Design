<td id="S5.T3.5.2.3" class="ltx_td ltx_align_center ltx_border_t">0.62</td>
<td id="S5.T3.5.2.4" class="ltx_td ltx_align_center ltx_border_t">1.25</td>
<td id="S5.T3.5.2.5" class="ltx_td ltx_align_center ltx_border_t">3.48</td></tr>
