<td id="S3.T1.5.7.8" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S3.T1.5.7.8.1" class="ltx_text ltx_font_bold">64.7</span>/58.1</td>
