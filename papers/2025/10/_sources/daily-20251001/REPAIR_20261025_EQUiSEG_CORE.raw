<td id="S3.T3.2.1.3.4" class="ltx_td ltx_align_center ltx_border_t">8.25</td>
<td id="S3.T3.2.1.3.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">11.35</td>
<td id="S3.T3.2.1.3.6" class="ltx_td ltx_align_center ltx_border_t">41.54 (-3.23)</td></tr>
