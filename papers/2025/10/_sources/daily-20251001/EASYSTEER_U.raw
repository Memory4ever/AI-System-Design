{"data":{"id":"10.48550/arxiv.2509.25175","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.25175","prefix":"10.48550","suffix":"arxiv.2509.25175","identifiers":[{"identifier":"2509.25175","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.25175"}],"creators":[{"name":"Xu, Haolei","nameType":"Personal","givenName":"Haolei","familyName":"Xu","affiliation":[],"nameIdentifiers":[]},{"name":"Mei, Xinyu","nameType":"Personal","givenName":"Xinyu","familyName":"Mei","affiliation":[],"nameIdentifiers":[]},{"name":"Yan, Yuchen","nameType":"Personal","givenName":"Yuchen","familyName":"Yan","affiliation":[],"nameIdentifiers":[]},{"name":"Zhou, Rui","nameType":"Personal","givenName":"Rui","familyName":"Zhou","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Wenqi","nameType":"Personal","givenName":"Wenqi","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Lu, Weiming","nameType":"Personal","givenName":"Weiming","familyName":"Lu","affiliation":[],"nameIdentifiers":[]},{"name":"Zhuang, Yueting","nameType":"Personal","givenName":"Yueting","familyName":"Zhuang","affiliation":[],"nameIdentifiers":[]},{"name":"Shen, Yongliang","nameType":"Personal","givenName":"Yongliang","familyName":"Shen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"EasySteer: A Unified Framework for High-Performance and Extensible LLM Steering"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-29T17:59:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-30T02:23:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-02T07:38:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T02:46:41Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-09-03T17:38:01Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-09-04T01:10:07Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Large language model (LLM) steering has emerged as a promising paradigm for controlling model behavior at inference time through targeted manipulation of hidden states, offering a lightweight alternative to expensive retraining. However, existing steering frameworks suffer from critical limitations: computational inefficiency, limited extensibility, and restricted functionality that hinder both research progress and practical deployment. We present EasySteer, a unified framework for high-performance, extensible LLM steering built on vLLM. Our system features modular architecture with pluggable interfaces for both analysis-based and learning-based methods, fine-grained parameter control, pre-computed steering vectors for eight application domains, and an interactive demonstration system. Through deep integration with vLLM's optimized inference engine, EasySteer achieves 10.8-22.3$\\times$ speedup over existing frameworks. Extensive experiments demonstrate its effectiveness in overthinking mitigation, hallucination reduction, and other key applications. EasySteer transforms steering from research technique to production-ready capability, establishing critical infrastructure for deployable, controllable language models.","descriptionType":"Abstract"},{"description":"EMNLP 2026 System Demonstrations. Code: https://github.com/ZJU-REAL/EasySteer Demo: https://www.youtube.com/watch?v=3rRGzZmhrXg","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.25175","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-30T04:34:18.000Z","registered":"2025-09-30T04:34:19.000Z","published":"2025","updated":"2026-09-04T02:37:32.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.25175","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}