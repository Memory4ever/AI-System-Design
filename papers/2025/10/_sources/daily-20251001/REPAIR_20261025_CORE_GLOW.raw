<figure id="alg3" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg3.3" class="ltx_text ltx_font_bold">Algorithm 3</span> </span> Go-Explore-based Algorithms</figcaption>
<div id="alg3.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg3.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">1:</span>
            
            
          <span id="alg3.l1.2" class="ltx_text ltx_font_bold">procedure</span> <span id="alg3.l1.3" class="ltx_text ltx_font_smallcaps">Go-Explore-Family</span>(<math id="alg3.l1.m1" class="ltx_Math" alttext="s_{0}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mn>0</mn></msub><annotation encoding="application/x-tex">s_{0}</annotation></semantics></math>, <math id="alg3.l1.m2" class="ltx_Math" alttext="n_{iter}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">n_{iter}</annotation></semantics></math>)

</div>
<div id="alg3.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">2:</span>
            
            
            <math id="alg3.l2.m1" class="ltx_Math" alttext="\mathcal{A}\leftarrow\{(s_{0},\text{score}_{0})\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>0</mn></msub><mo>,</mo><msub><mtext>score</mtext><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{A}\leftarrow\{(s_{0},\text{score}_{0})\}</annotation></semantics></math> <span id="alg3.l2.2" class="ltx_text" style="float:right;"><math id="alg3.l2.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Archive
</span>
</div>
<div id="alg3.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">3:</span>
            
            
            <span id="alg3.l3.2" class="ltx_text ltx_font_bold">for</span> <math id="alg3.l3.m1" class="ltx_Math" alttext="i=1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i=1</annotation></semantics></math> to <math id="alg3.l3.m2" class="ltx_Math" alttext="n_{iter}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">n_{iter}</annotation></semantics></math> <span id="alg3.l3.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg3.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">4:</span>
            
            
             <span id="alg3.l4.2" class="ltx_text ltx_font_italic">— Go Phase (State Selection) —</span>

</div>
<div id="alg3.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">5:</span>
            
            
             <span id="alg3.l5.2" class="ltx_text ltx_font_bold">Go-Explore A:</span> <math id="alg3.l5.m1" class="ltx_Math" alttext="s_{next}\sim\text{Uniform}(\mathcal{A})" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo>∼</mo><mrow><mtext>Uniform</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s_{next}\sim\text{Uniform}(\mathcal{A})</annotation></semantics></math> <span id="alg3.l5.3" class="ltx_text" style="float:right;"><math id="alg3.l5.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Random sampling
</span>
</div>
<div id="alg3.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">6:</span>
            
            
             <span id="alg3.l6.2" class="ltx_text ltx_font_bold">Go-Explore B:</span> <math id="alg3.l6.m1" class="ltx_Math" alttext="s_{next}\sim P(s)\propto\frac{1}{\text{visits}(s)^{\alpha}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo>∼</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∝</mo><mfrac><mn>1</mn><mrow><mtext>visits</mtext><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mi>α</mi></msup></mrow></mfrac></mrow><annotation encoding="application/x-tex">s_{next}\sim P(s)\propto\frac{1}{\text{visits}(s)^{\alpha}}</annotation></semantics></math> <span id="alg3.l6.3" class="ltx_text" style="float:right;"><math id="alg3.l6.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Novelty
</span>
</div>
<div id="alg3.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">7:</span>
            
            
             <span id="alg3.l7.2" class="ltx_text ltx_font_bold">Go-Explore C:</span> <math id="alg3.l7.m1" class="ltx_Math" alttext="s_{next}\sim P(s)\propto\text{domain}(s)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo>∼</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∝</mo><mrow><mtext>domain</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s_{next}\sim P(s)\propto\text{domain}(s)</annotation></semantics></math> <span id="alg3.l7.3" class="ltx_text" style="float:right;"><math id="alg3.l7.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Domain heuristics
</span>
</div>
<div id="alg3.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">8:</span>
            
            
             <span id="alg3.l8.2" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#BF0040;">XTX:<span id="alg3.l8.2.1" class="ltx_text ltx_font_medium"> <math id="alg3.l8.m1" class="ltx_Math" alttext="s_{next}\leftarrow\text{ImitationLearning}(\mathcal{T})" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040">s</mi><mrow><mi style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040">n</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040">e</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040">x</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040">t</mi></mrow></msub><mo style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040" stretchy="false">←</mo><mrow><mtext style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040">ImitationLearning</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040" stretchy="false">(</mo><mi style="--ltx-fg-color:#BF0040;" class="ltx_font_mathcaligraphic" mathcolor="#BF0040">𝒯</mi><mo style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s_{next}\leftarrow\text{ImitationLearning}(\mathcal{T})</annotation></semantics></math> <span id="alg3.l8.2.1.1" class="ltx_text" style="float:right;"><math id="alg3.l8.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040">⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Imitation learning<span id="alg3.l8.2.1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">
</span></span></span></span>
</div>
<div id="alg3.l9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">9:</span>
            
            
             <span id="alg3.l9.2" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF8000;">IGE:<span id="alg3.l9.2.1" class="ltx_text ltx_font_medium"> <math id="alg3.l9.m1" class="ltx_Math" alttext="s_{next}\leftarrow\text{LLM.SelectPromising}(\mathcal{A})" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">s</mi><mrow><mi style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">n</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">e</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">x</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">t</mi></mrow></msub><mo style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000" stretchy="false">←</mo><mrow><mtext style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">LLM.SelectPromising</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000" stretchy="false">(</mo><mi style="--ltx-fg-color:#FF8000;" class="ltx_font_mathcaligraphic" mathcolor="#FF8000">𝒜</mi><mo style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s_{next}\leftarrow\text{LLM.SelectPromising}(\mathcal{A})</annotation></semantics></math> <span id="alg3.l9.2.1.1" class="ltx_text" style="float:right;"><math id="alg3.l9.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Ill-defined promising-ness<span id="alg3.l9.2.1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">
</span></span></span></span>
</div>
<div id="alg3.l10" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">10:</span>
            
            
