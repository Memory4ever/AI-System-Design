<td id="S4.T1.2.1.2.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;"><span id="S4.T1.2.1.2.8.1" class="ltx_text ltx_font_bold">Reflexion</span></td>
