{"data":{"id":"10.48550/arxiv.2509.25050","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.25050","prefix":"10.48550","suffix":"arxiv.2509.25050","identifiers":[{"identifier":"2509.25050","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.25050"}],"creators":[{"name":"Xue, Shuchen","nameType":"Personal","givenName":"Shuchen","familyName":"Xue","affiliation":[],"nameIdentifiers":[]},{"name":"Ge, Chongjian","nameType":"Personal","givenName":"Chongjian","familyName":"Ge","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Shilong","nameType":"Personal","givenName":"Shilong","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Yichen","nameType":"Personal","givenName":"Yichen","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Ma, Zhi-Ming","nameType":"Personal","givenName":"Zhi-Ming","familyName":"Ma","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Advantage Weighted Matching: Aligning RL with Pretraining in Diffusion Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-29T17:02:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-30T02:18:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-09-01T07:08:38Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-09-02T00:40:39Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Reinforcement Learning (RL) has emerged as a central paradigm for advancing Large Language Models (LLMs), where both pre-training and RL post-training stages are grounded in the same log-likelihood formulation. In contrast, recent RL approaches for diffusion models, most notably Denoising Diffusion Policy Optimization (DDPO), optimize an objective different from the pretraining objectives--score/flow matching loss. In this work, we establish a novel theoretical analysis: DDPO is an implicit form of score/flow matching with noisy targets, which increases variance and slows convergence. Building on this analysis, we introduce Advantage Weighted Matching (AWM), a policy-gradient method for diffusion. It uses the score/flow-matching loss and reweights each sample by its advantage. In effect, AWM raises the influence of high-reward samples and suppresses low-reward ones while keeping the modeling objective identical to pretraining. This simple yet effective design yields substantial benefits: on the GenEval, OCR, and PickScore benchmarks, AWM delivers up to a $34\\times$ speedup over Flow-GRPO (which builds on DDPO), when applied to Stable Diffusion 3.5 Medium and FLUX, without compromising generation quality. Code is available at https://github.com/scxue/advantage_weighted_matching","descriptionType":"Abstract"},{"description":"Accepted at ICML 2026; updated to the camera-ready version","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.25050","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-30T04:31:17.000Z","registered":"2025-09-30T04:31:18.000Z","published":"2025","updated":"2026-09-02T02:59:31.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.25050","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}