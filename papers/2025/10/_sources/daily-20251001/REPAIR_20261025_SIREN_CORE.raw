<td id="S4.T1.2.1.6.13" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FFFFFF;"><span id="S4.T1.2.1.6.13.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">43.0</span></td></tr>
<tr id="S4.T1.2.1.7" class="ltx_tr">
<td id="S4.T1.2.1.7.1" class="ltx_td ltx_align_left">KL-Cov</td>
