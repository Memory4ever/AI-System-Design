<span class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex32.m1" class="ltx_Math" alttext="=2026-9=2017" display="block" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2026</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2017</mn></mrow><annotation encoding="application/x-tex">=2026-9=2017</annotation></semantics></math></span>
