            <span id="alg1.l5.3" class="ltx_text" style="font-size:70%;">   </span><span id="alg1.l5.4" class="ltx_text ltx_font_bold" style="font-size:70%;">for</span><span id="alg1.l5.5" class="ltx_text" style="font-size:70%;"> </span><math id="alg1.l5.m1" class="ltx_Math" alttext="b=0,...,\frac{L_{\text{gen}}}{s}-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.700em">b</mi><mo mathsize="0.700em">=</mo><mn mathsize="0.700em">0</mn></mrow><mo mathsize="0.700em">,</mo><mi mathsize="0.700em" mathvariant="normal">…</mi><mo mathsize="0.700em">,</mo><mrow><mfrac><msub><mi mathsize="0.700em">L</mi><mtext mathsize="0.700em">gen</mtext></msub><mi mathsize="0.700em">s</mi></mfrac><mo mathsize="0.700em">−</mo><mn mathsize="0.700em">1</mn></mrow></mrow><annotation encoding="application/x-tex">b=0,...,\frac{L_{\text{gen}}}{s}-1</annotation></semantics></math><span id="alg1.l5.6" class="ltx_text" style="font-size:70%;"> </span><span id="alg1.l5.7" class="ltx_text ltx_font_bold" style="font-size:70%;">do</span><span id="alg1.l5.8" class="ltx_text" style="font-size:70%;">
