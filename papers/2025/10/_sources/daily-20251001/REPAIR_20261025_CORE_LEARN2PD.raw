</div>
<div id="alg1.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
            <span id="alg1.l3.3" class="ltx_text" style="font-size:70%;">   </span><math id="alg1.l3.m1" class="ltx_Math" alttext="x_{i}\in x_{\text{prompt}}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.700em">x</mi><mi mathsize="0.700em">i</mi></msub><mo mathsize="0.700em">∈</mo><msub><mi mathsize="0.700em">x</mi><mtext mathsize="0.700em">prompt</mtext></msub></mrow><annotation encoding="application/x-tex">x_{i}\in x_{\text{prompt}}</annotation></semantics></math><span id="alg1.l3.4" class="ltx_text" style="font-size:70%;">, </span><math id="alg1.l3.m2" class="ltx_Math" alttext="r_{i}\in x_{\text{reference}}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.700em">r</mi><mi mathsize="0.700em">i</mi></msub><mo mathsize="0.700em">∈</mo><msub><mi mathsize="0.700em">x</mi><mtext mathsize="0.700em">reference</mtext></msub></mrow><annotation encoding="application/x-tex">r_{i}\in x_{\text{reference}}</annotation></semantics></math><span id="alg1.l3.5" class="ltx_text" style="font-size:70%;">, </span><math id="alg1.l3.m3" class="ltx_Math" alttext="l_{i}=length(x_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.700em">l</mi><mi mathsize="0.700em">i</mi></msub><mo mathsize="0.700em">=</mo><mrow><mi mathsize="0.700em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">g</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">h</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">x</mi><mi mathsize="0.700em">i</mi></msub><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">l_{i}=length(x_{i})</annotation></semantics></math><span id="alg1.l3.6" class="ltx_text" style="font-size:70%;">
</span>
