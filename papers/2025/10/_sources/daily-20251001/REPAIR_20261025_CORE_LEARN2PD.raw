            <span id="alg1.l9.3" class="ltx_text" style="font-size:70%;">      </span><span id="alg1.l9.4" class="ltx_text ltx_font_bold" style="font-size:70%;">if</span><span id="alg1.l9.5" class="ltx_text" style="font-size:70%;"> </span><math id="alg1.l9.m1" class="ltx_Math" alttext="pre_{t,j}=r_{i,j}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.700em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">r</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.700em">e</mi><mrow><mi mathsize="0.700em">t</mi><mo mathsize="0.700em">,</mo><mi mathsize="0.700em">j</mi></mrow></msub></mrow><mo mathsize="0.700em">=</mo><msub><mi mathsize="0.700em">r</mi><mrow><mi mathsize="0.700em">i</mi><mo mathsize="0.700em">,</mo><mi mathsize="0.700em">j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">pre_{t,j}=r_{i,j}</annotation></semantics></math><span id="alg1.l9.6" class="ltx_text" style="font-size:70%;"> </span><span id="alg1.l9.7" class="ltx_text ltx_font_bold" style="font-size:70%;">then</span><span id="alg1.l9.8" class="ltx_text" style="font-size:70%;">
</span>
</div>
<div id="alg1.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
              
              
            <span id="alg1.l10.3" class="ltx_text" style="font-size:70%;">        </span><math id="alg1.l10.m1" class="ltx_Math" alttext="\hat{y_{j}}\leftarrow 1" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><msub><mi mathsize="0.700em">y</mi><mi mathsize="0.700em">j</mi></msub><mo>^</mo></mover><mo mathsize="0.700em" stretchy="false">←</mo><mn mathsize="0.700em">1</mn></mrow><annotation encoding="application/x-tex">\hat{y_{j}}\leftarrow 1</annotation></semantics></math><span id="alg1.l10.4" class="ltx_text" style="font-size:70%;">, </span><math id="alg1.l10.m2" class="ltx_Math" alttext="\mathcal{M}\leftarrow\mathcal{M}\setminus\{j\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.700em">ℳ</mi><mo mathsize="0.700em" stretchy="false">←</mo><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.700em">ℳ</mi><mo mathsize="0.700em">∖</mo><mrow><mo stretchy="false">{</mo><mi mathsize="0.700em">j</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{M}\leftarrow\mathcal{M}\setminus\{j\}</annotation></semantics></math><span id="alg1.l10.5" class="ltx_text" style="font-size:70%;">
</span>
</div>
<div id="alg1.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
              
              
            <span id="alg1.l11.3" class="ltx_text" style="font-size:70%;">        </span><math id="alg1.l11.m1" class="ltx_Math" alttext="X_{l_{i}+b\cdot s+j}\leftarrow pre_{t,j}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.700em">X</mi><mrow><msub><mi mathsize="0.700em">l</mi><mi mathsize="0.700em">i</mi></msub><mo mathsize="0.700em">+</mo><mrow><mi mathsize="0.700em">b</mi><mo lspace="0.222em" mathsize="0.700em" rspace="0.222em">⋅</mo><mi mathsize="0.700em">s</mi></mrow><mo mathsize="0.700em">+</mo><mi mathsize="0.700em">j</mi></mrow></msub><mo mathsize="0.700em" stretchy="false">←</mo><mrow><mi mathsize="0.700em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">r</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.700em">e</mi><mrow><mi mathsize="0.700em">t</mi><mo mathsize="0.700em">,</mo><mi mathsize="0.700em">j</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">X_{l_{i}+b\cdot s+j}\leftarrow pre_{t,j}</annotation></semantics></math><span id="alg1.l11.4" class="ltx_text" style="font-size:70%;">
</span>
</div>
<div id="alg1.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
              
              
            <span id="alg1.l12.3" class="ltx_text" style="font-size:70%;">      </span><span id="alg1.l12.4" class="ltx_text ltx_font_bold" style="font-size:70%;">else</span>
</div>
<div id="alg1.l13" class="ltx_listingline">
