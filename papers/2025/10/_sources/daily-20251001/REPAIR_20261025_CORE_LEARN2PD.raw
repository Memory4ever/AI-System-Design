            <span id="alg2.l1.3" class="ltx_text" style="font-size:70%;">Diffusion large language model </span><math id="alg2.l1.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math><span id="alg2.l1.4" class="ltx_text" style="font-size:70%;">, filter model </span><math id="alg2.l1.m2" class="ltx_Math" alttext="f_{\theta}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">f</mi><mi mathsize="0.700em">θ</mi></msub><annotation encoding="application/x-tex">f_{\theta}</annotation></semantics></math><span id="alg2.l1.5" class="ltx_text" style="font-size:70%;">, prompt set </span><math id="alg2.l1.m3" class="ltx_Math" alttext="x_{\text{prompt}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">x</mi><mtext mathsize="0.700em">prompt</mtext></msub><annotation encoding="application/x-tex">x_{\text{prompt}}</annotation></semantics></math><span id="alg2.l1.6" class="ltx_text" style="font-size:70%;">, generation length </span><math id="alg2.l1.m4" class="ltx_Math" alttext="L_{\text{gen}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">L</mi><mtext mathsize="0.700em">gen</mtext></msub><annotation encoding="application/x-tex">L_{\text{gen}}</annotation></semantics></math><span id="alg2.l1.7" class="ltx_text" style="font-size:70%;">, block size </span><math id="alg2.l1.m5" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math><span id="alg2.l1.8" class="ltx_text" style="font-size:70%;">, filter threshold </span><math id="alg2.l1.m6" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math><span id="alg2.l1.9" class="ltx_text" styl