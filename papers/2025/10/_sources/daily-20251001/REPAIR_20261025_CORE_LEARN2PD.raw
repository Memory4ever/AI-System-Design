<th id="S4.T3.fig2.3.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t"><span id="S4.T3.fig2.3.3.1.1" class="ltx_text" style="font-size:80%;">Two-layer</span></th>
<td id="S4.T3.fig2.3.3.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="S4.T3.m13" class="ltx_Math" alttext="{14.07}" display="inline" intent=":literal"><semantics><mn mathsize="0.800em">14.07</mn><annotation encoding="application/x-tex">{14.07}</annotation></semantics></math></td>
