ng="application/x-tex">\eta</annotation></semantics></math><span id="alg1.l1.9" class="ltx_text" style="font-size:70%;">, block size </span><math id="alg1.l1.m7" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math><span id="alg1.l1.10" class="ltx_text" style="font-size:70%;">
</span>
</div>
<div id="alg1.l2" class="ltx_listingline">
