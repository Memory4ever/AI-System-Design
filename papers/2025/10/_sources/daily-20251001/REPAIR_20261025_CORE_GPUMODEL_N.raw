<td id="S3.T2.5.2.2" class="ltx_td ltx_align_right ltx_border_r ltx_border_t"><math id="S3.T2.m1" class="ltx_Math" alttext="[v/|mp|,d]" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mrow><mi mathsize="0.900em">v</mi><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">p</mi></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo></mrow></mrow><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">d</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><annotation encoding="application/x-tex">[v/|mp|,d]</annotation></semantics></math></td></tr>
