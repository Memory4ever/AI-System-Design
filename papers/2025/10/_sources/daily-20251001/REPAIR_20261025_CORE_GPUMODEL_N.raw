<td id="S3.T2.5.4.2" class="ltx_td ltx_align_right ltx_border_r"><math id="S3.T2.m3" class="ltx_Math" alttext="[d,3d/|mp|],[3d/|mp|]" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mrow><mi mathsize="0.900em">d</mi><mo mathsize="0.900em">,</mo><mrow><mrow><mn mathsize="0.900em">3</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">d</mi></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">p</mi></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo></mrow></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mo mathsize="0.900em">,</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mrow><mrow><mn mathsize="0.900em">3</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">d</mi></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">p</mi></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><annotation encoding="application/x-tex">[d,3d/|mp|],[3d/|mp|]</annotation></semantics></math></td></tr>
<tr id="S3.T2.5.5" class="ltx_tr">
<th id="S3.T2.5.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r"><span id="S3.T2.5.5.1.1" class="ltx_text" style="font-size:90%;">Linear2</span></th>
<td id="S3.T2.5.5.2" class="ltx_td ltx_align_right ltx_border_r"><math id="S3.T2.m4" class="ltx_Math" alttext="[d/|mp|,d],[d]" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mrow><mrow><mi mathsize="0.900em">d</mi><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">p</mi></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo></mrow></mrow><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">d</mi></mrow><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mo mathsize="0.900em">,</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">d</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><annotation encoding="application/x-tex">[d/|mp|,d],[d]</annotation></semantics></math></td></tr>
