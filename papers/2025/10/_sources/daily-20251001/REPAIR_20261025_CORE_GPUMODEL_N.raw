<td id="S3.T2.5.8.2" class="ltx_td ltx_align_right ltx_border_r"><math id="S3.T2.m7" class="ltx_Math" alttext="[4d/|mp|,d],[d]" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mrow><mrow><mrow><mn mathsize="0.900em">4</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">d</mi></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">p</mi></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo></mrow></mrow><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">d</mi></mrow><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mo mathsize="0.900em">,</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">d</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><annotation encoding="application/x-tex">[4d/|mp|,d],[d]</annotation></semantics></math></td></tr>
<tr id="S3.T2.5.9" class="ltx_tr">
<th id="S3.T2.5.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t"><span id="S3.T2.5.9.1.1" class="ltx_text" style="font-size:90%;">LayerNorm</span></th>
<td id="S3.T2.5.9.2" class="ltx_td ltx_align_right ltx_border_r ltx_border_t"><math id="S3.T2.m8" class="ltx_Math" alttext="[d],[d]" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">d</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mo mathsize="0.900em">,</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">d</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><annotation encoding="application/x-tex">[d],[d]</annotation></semantics></math></td></tr>
<tr id="S3.T2.5.10" class="ltx_tr">
<th id="S3.T2.5.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b ltx_border_l ltx_border_r"><span id="S3.T2.5.10.1.1" class="ltx_text" style="font-size:90%;">Final_Linear</span></th>
<td id="S3.T2.5.10.2" class="ltx_td ltx_align_right ltx_border_b ltx_border_r"><math id="S3.T2.m9" class="ltx_Math" alttext="[d,v/|mp|]" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">d</mi><mo mathsize="0.900em">,</mo><mrow><mi mathsize="0.900em">v</mi><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">p</mi></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><annotation encoding="application/x-tex">[d,v/|mp|]</annotation></semantics></math></td></tr>
</tbody>
</table>
</figure>
<figure id="S3.T3" class="ltx_table">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_table"><span id="S3.T3.3" class="ltx_text" style="font-size:90%;">Table III</span>: </span><span id="S3.T3.4" class="ltx_text" style="font-size:90%;">Distribution of parameters across pipeline parallel stages in a model parallel setting. The table quantifies parameter count for the first, middle, and last stages, where v represents vocabulary size, d hidden dimension, mp model parallel degree, and n the number of encoder layers per stage.</span></figcaption>
<table id="S3.T3.5" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
