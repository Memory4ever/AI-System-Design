<td id="S3.T2.5.3.2" class="ltx_td ltx_align_right ltx_border_r ltx_border_t"><math id="S3.T2.m2" class="ltx_Math" alttext="[d],[d]" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">d</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mo mathsize="0.900em">,</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">d</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><annotation encoding="application/x-tex">[d],[d]</annotation></semantics></math></td></tr>
<tr id="S3.T2.5.4" class="ltx_tr">
