<table id="A3.T8.2.1" class="ltx_tabular ltx_align_middle">
<tr id="A3.T8.2.1.1" class="ltx_tr" style="--ltx-bg-color:#E6E6E6;">
<td id="A3.T8.2.1.1.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_tt">
