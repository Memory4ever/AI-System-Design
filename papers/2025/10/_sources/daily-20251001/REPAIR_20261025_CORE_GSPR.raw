<td id="S1.T1.2.7.2" class="ltx_td ltx_align_center ltx_border_bb">Flexible</td>
<td id="S1.T1.2.7.3" class="ltx_td ltx_align_center ltx_border_bb">167</td>
<td id="S1.T1.2.7.4" class="ltx_td ltx_align_center ltx_border_bb">✓</td>
