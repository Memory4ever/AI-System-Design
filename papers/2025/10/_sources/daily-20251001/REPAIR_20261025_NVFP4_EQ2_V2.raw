<td id="S2.T1.5.3.6" class="ltx_td ltx_align_center ltx_border_t">2<math id="S2.T1.m2" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td></tr>
