<tr id="S4.T1.2.7" class="ltx_tr">
<th id="S4.T1.2.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="S4.T1.2.7.1.1" class="ltx_text ltx_font_bold">TTFT (s)</span></th>
<td id="S4.T1.2.7.2" class="ltx_td ltx_border_t" style="padding-top:0.6pt;padding-bottom:0.6pt;"></td>
<td id="S4.T1.2.7.3" class="ltx_td ltx_border_t" style="padding-top:0.6pt;padding-bottom:0.6pt;"></td>
<td id="S4.T1.2.7.4" class="ltx_td ltx_border_t" style="padding-top:0.6pt;padding-bottom:0.6pt;"></td>
<td id="S4.T1.2.7.5" class="ltx_td ltx_border_t" style="padding-top:0.6pt;padding-bottom:0.6pt;"></td>
