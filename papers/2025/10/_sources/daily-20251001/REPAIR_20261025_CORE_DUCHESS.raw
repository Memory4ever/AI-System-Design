<td id="S4.T1.2.9.9" class="ltx_td ltx_align_left" style="padding-top:0.6pt;padding-bottom:0.6pt;"><math id="S4.T1.m44" class="ltx_Math" alttext="10.8" display="inline" intent=":literal"><semantics><mn>10.8</mn><annotation encoding="application/x-tex">10.8</annotation></semantics></math></td>
<td id="S4.T1.2.9.10" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-top:0.6pt;padding-bottom:0.6pt;"><math id="S4.T1.m45" class="ltx_Math" alttext="142.1" display="inline" intent=":literal"><semantics><mn>142.1</mn><annotation encoding="application/x-tex">142.1</annotation></semantics></math></td></tr>
<tr id="S4.T1.2.10" class="ltx_tr">
<th id="S4.T1.2.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding-top:0.6pt;padding-bottom:0.6pt;">DUCHESS</th>
<td id="S4.T1.2.10.2" class="ltx_td ltx_align_left ltx_border_bb" style="padding-top:0.6pt;padding-bottom:0.6pt;"><math id="S4.T1.m46" class="ltx_Math" alttext="2.8" display="inline" intent=":literal"><semantics><mn>2.8</mn><annotation encoding="application/x-tex">2.8</annotation></semantics></math></td>
