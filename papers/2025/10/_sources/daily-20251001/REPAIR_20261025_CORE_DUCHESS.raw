<td id="S4.T1.2.10.4" class="ltx_td ltx_align_left ltx_border_bb" style="padding-top:0.6pt;padding-bottom:0.6pt;"><math id="S4.T1.m48" class="ltx_Math" alttext="14.4" display="inline" intent=":literal"><semantics><mn>14.4</mn><annotation encoding="application/x-tex">14.4</annotation></semantics></math></td>
