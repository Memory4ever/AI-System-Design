                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.15.1" class="ltx_text ltx_font_bold">13</span></span>
              <math id="algorithm1.m19" class="ltx_Math" alttext="T^{*}\leftarrow T_{\text{cand}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑻</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo class="ltx_mathvariant_bold" mathvariant="bold" stretchy="false">←</mo><msub><mi>𝑻</mi><mtext>cand</mtext></msub></mrow><annotation encoding="application/x-tex">T^{*}\leftarrow T_{\text{cand}}</annotation></semantics></math>
