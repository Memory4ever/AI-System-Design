                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.14.1" class="ltx_text ltx_font_bold">12</span></span>
              <span id="algorithm1.4.14.2" class="ltx_text ltx_font_bold">if</span> <em id="algorithm1.4.14.3" class="ltx_emph ltx_font_italic"><math id="algorithm1.m18" class="ltx_Math" alttext="T_{\text{cand}}&lt;T^{*}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐓</mi><mtext class="ltx_mathvariant_italic">cand</mtext></msub><mo class="ltx_mathvariant_bold" mathvariant="bold">&lt;</mo><msup><mi>𝐓</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup></mrow><annotation encoding="application/x-tex">T_{\text{cand}}&lt;T^{*}</annotation></semantics></math></em> <span id="algorithm1.4.14.4" class="ltx_text ltx_font_bold">then</span>
</div>
