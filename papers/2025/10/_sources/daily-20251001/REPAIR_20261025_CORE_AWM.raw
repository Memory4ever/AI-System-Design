<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E14Xe.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E14Xe.m3" class="ltx_Math" alttext="\displaystyle\nabla_{\bm{\theta}}\mathbb{E}_{{\bm{x}}_{t}}\left[\left\|{\bm{s}}_{\bm{\theta}}({\bm{x}}_{t},t)\right\|^{2}\right]-2\nabla_{\bm{\theta}}\int_{{\bm{x}}_{t}}\langle{\bm{s}}_{\bm{\theta}}({\bm{x}}_{t},t),\nabla_{{\bm{x}}_{t}}\int_{{\bm{x}}_{s}}p({\bm{x}}_{t}|{\bm{x}}_{s})p({\bm{x}}_{s})\mathrm{d}{\bm{x}}_{s}\rangle\mathrm{d}{\bm{x}}_{t}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∇</mo><msub><mrow></mrow><mi>𝜽</mi></msub><mi>𝔼</mi><msub><mrow></mrow><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo>[</mo><mo>‖</mo><mi>𝒔</mi><msub><mrow></mrow><mi>𝜽</mi></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo><mo>‖</mo><msup><mrow></mrow><mn>2</mn></msup><mo>]</mo><mo>−</mo><mn>2</mn><mo lspace="0.167em" rspace="0.167em">∇</mo><msub><mrow></mrow><mi>𝜽</mi></msub><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo stretchy="false">⟨</mo><mi>𝒔</mi><msub><mrow></mrow><mi>𝜽</mi></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo><mo>,</mo><mo rspace="0.167em">∇</mo><msub><mrow></mrow><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><msub><mi>𝒙</mi><mi>s</mi></msub></msub><mi>p</mi><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">)</mo><mi>p</mi><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">)</mo><mi>d</mi><mi>𝒙</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">⟩</mo><mi>d</mi><mi>𝒙</mi><msub><mrow></mrow><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{\bm{\theta}}\mathbb{E}_{{\bm{x}}_{t}}\left[\left\|{\bm{s}}_{\bm{\theta}}({\bm{x}}_{t},t)\right\|^{2}\right]-2\nabla_{\bm{\theta}}\int_{{\bm{x}}_{t}}\langle{\bm{s}}_{\bm{\theta}}({\bm{x}}_{t},t),\nabla_{{\bm{x}}_{t}}\int_{{\bm{x}}_{s}}p({\bm{x}}_{t}|{\bm{x}}_{s})p({\bm{x}}_{s})\mathrm{d}{\bm{x}}_{s}\rangle\mathrm{d}{\bm{x}}_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A2.E14Xf" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E14Xf.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E14Xf.m3" class="ltx_Math" alttext="\displaystyle\nabla_{\bm{\theta}}\mathbb{E}_{{\bm{x}}_{t}}\left[\left\|{\bm{s}}_{\bm{\theta}}({\bm{x}}_{t},t)\right\|^{2}\right]-2\nabla_{\bm{\theta}}\int_{{\bm{x}}_{t}}\langle{\bm{s}}_{\bm{\theta}}({\bm{x}}_{t},t),\nabla_{{\bm{x}}_{t}}p({\bm{x}}_{t})\rangle\mathrm{d}{\bm{x}}_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∇</mo><mi>𝜽</mi></msub><msub><mi>𝔼</mi><msub><mi>𝒙</mi><mi>t</mi></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msub><mi>𝒔</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo mathsize="0.700em">,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><msub><mo>∇</mo><mi>𝜽</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub></mstyle><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝒔</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo mathsize="0.700em">,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mi>p</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{\bm{\theta}}\mathbb{E}_{{\bm{x}}_{t}}\left[\left\|{\bm{s}}_{\bm{\theta}}({\bm{x}}_{t},t)\right\|^{2}\right]-2\nabla_{\bm{\theta}}\int_{{\bm{x}}_{t}}\langle{\bm{s}}_{\bm{\theta}}({\bm{x}}_{t},t),\nabla_{{\bm{x}}_{t}}p({\bm{x}}_{t})\rangle\mathrm{d}{\bm{x}}_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A2.E14Xg" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E14Xg.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E14Xg.m3" class="ltx_Math" alttext="\displaystyle\nabla_{\bm{\theta}}\mathbb{E}_{{\bm{x}}_{t}}\left[\left\|{\bm{s}}_{\bm{\theta}}({\bm{x}}_{t},t)\right\|^{2}\right]-2\nabla_{\bm{\theta}}\int_{{\bm{x}}_{t}}\langle{\bm{s}}_{\bm{\theta}}({\bm{x}}_{t},t),\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t})\rangle p({\bm{x}}_{t})\mathrm{d}{\bm{x}}_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∇</mo><mi>𝜽</mi></msub><msub><mi>𝔼</mi><msub><mi>𝒙</mi><mi>t</mi></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msub><mi>𝒔</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo mathsize="0.700em">,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><msub><mo>∇</mo><mi>𝜽</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub></mstyle><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝒔</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo mathsize="0.700em">,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{\bm{\theta}}\mathbb{E}_{{\bm{x}}_{t}}\left[\left\|{\bm{s}}_{\bm{\theta}}({\bm{x}}_{t},t)\right\|^{2}\right]-2\nabla_{\bm{\theta}}\int_{{\bm{x}}_{t}}\langle{\bm{s}}_{\bm{\theta}}({\bm{x}}_{t},t),\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t})\rangle p({\bm{x}}_{t})\mathrm{d}{\bm{x}}_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A2.E14Xh" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E14Xh.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E14Xh.m3" class="ltx_Math" alttext="\displaystyle\nabla_{\bm{\theta}}\mathbb{E}_{{\bm{x}}_{t}}\left[\left\|{\bm{s}}_{\bm{\theta}}({\bm{x}}_{t},t)\right\|^{2}\right]-2\nabla_{\bm{\theta}}\mathbb{E}_{{\bm{x}}_{t}}\left[\langle{\bm{s}}_{\bm{\theta}}({\bm{x}}_{t},t),\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t})\rangle\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∇</mo><mi>𝜽</mi></msub><msub><mi>𝔼</mi><msub><mi>𝒙</mi><mi>t</mi></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msub><mi>𝒔</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>𝜽</mi></msub><msub><mi>𝔼</mi><msub><mi>𝒙</mi><mi>t</mi></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝒔</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{\bm{\theta}}\mathbb{E}_{{\bm{x}}_{t}}\left[\left\|{\bm{s}}_{\bm{\theta}}({\bm{x}}_{t},t)\right\|^{2}\right]-2\nabla_{\bm{\theta}}\mathbb{E}_{{\bm{x}}_{t}}\left[\langle{\bm{s}}_{\bm{\theta}}({\bm{x}}_{t},t),\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t})\rangle\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A2.E14Xi" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E14Xi.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E14Xi.m3" class="ltx_Math" alttext="\displaystyle\nabla_{\bm{\theta}}\mathbb{E}_{{\bm{x}}_{t}}\left[\left\|{\bm{s}}_{\bm{\theta}}({\bm{x}}_{t},t)-\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t})\right\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><mi>𝜽</mi></msub><msub><mi>𝔼</mi><msub><mi>𝒙</mi><mi>t</mi></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><mrow><msub><mi>𝒔</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{\bm{\theta}}\mathbb{E}_{{\bm{x}}_{t}}\left[\left\|{\bm{s}}_{\bm{\theta}}({\bm{x}}_{t},t)-\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t})\right\|^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p1.2" class="ltx_p"><span id="A2.SS1.p1.2.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.2 </span>Proof of <a href="#Thmtheorem1" title="Theorem 1 (DDPO is Secretly Doing Denoising Score Matching with Noisy Data). ‣ 3.3 Denoising Score Matching with Noisy Data ‣ 3 DDPO Is Secretly Doing Score Matching ‣ Advantage Weighted Matching: Aligning RL with Pretraining in Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">1</span></a></h3>

<div id="A2.SS2.p1" class="ltx_para ltx_noindent">
<p id="A2.SS2.p1.1" class="ltx_p">Our analysis builds upon a foundational theorem regarding the time reversal of diffusion processes from Haussmann and Pardoux <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib16" title="" class="ltx_ref">Haussmann &amp; Pardoux, 1986</a>)</cite>.</p>
</div>
<div id="Thmlemma2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma2.2" class="ltx_text ltx_font_bold">Lemma 2</span></span><span id="Thmlemma2.3" class="ltx_text ltx_font_bold"> </span>(Time Reversal of Diffusions <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib16" title="" class="ltx_ref">Haussmann &amp; Pardoux, 1986</a>)</cite>)<span id="Thmlemma2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma2.p1" class="ltx_para ltx_noindent">
<p id="Thmlemma2.p1.1" class="ltx_p"><span id="Thmlemma2.p1.1.1" class="ltx_text ltx_font_italic">Let the forward process <math id="Thmlemma2.p1.m1" class="ltx_Math" alttext="\{{\bm{x}}_{t}\}_{t\in[0,1]}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\{{\bm{x}}_{t}\}_{t\in[0,1]}</annotation></semantics></math> be defined by the stochastic differential equation (SDE):</span></p>
<table id="A2.E15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E15.m1" class="ltx_Math" alttext="\mathrm{d}{\bm{x}}_{t}=-\frac{1}{1-t}{\bm{x}}_{t},\mathrm{d}t+\sqrt{\frac{2t}{1-t}},\mathrm{d}{\bm{w}}_{t}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow><mo>=</mo><mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow></mrow></mrow><mo>,</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><msqrt><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></msqrt></mrow><mo>,</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒘</mi><mi>t</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathrm{d}{\bm{x}}_{t}=-\frac{1}{1-t}{\bm{x}}_{t},\mathrm{d}t+\sqrt{\frac{2t}{1-t}},\mathrm{d}{\bm{w}}_{t},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15)</span></td></tr></tbody>
</table>
<p id="Thmlemma2.p1.2" class="ltx_p"><span id="Thmlemma2.p1.2.1" class="ltx_text ltx_font_italic">Then, the corresponding reverse process, where time flows from 1 to 0, satisfies the SDE:</span></p>
<table id="A2.E16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E16.m1" class="ltx_Math" alttext="\mathrm{d}{\bm{x}}_{t}=\left[{\bm{v}}_{\bm{\theta}}({\bm{x}}_{t},t)+\frac{1}{1-t}\left({\bm{x}}_{t}+(1-t){\bm{v}}_{\bm{\theta}}({\bm{x}}_{t},t)\right)\right]\mathrm{d}t+\sqrt{\frac{2t}{1-t}},\mathrm{d}{\bm{w}}_{t}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow><mo>=</mo><mrow><mrow><mrow><mo>[</mo><mrow><mrow><msub><mi>𝒗</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><msqrt><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></msqrt></mrow></mrow><mo>,</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒘</mi><mi>t</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{d}{\bm{x}}_{t}=\left[{\bm{v}}_{\bm{\theta}}({\bm{x}}_{t},t)+\frac{1}{1-t}\left({\bm{x}}_{t}+(1-t){\bm{v}}_{\bm{\theta}}({\bm{x}}_{t},t)\right)\right]\mathrm{d}t+\sqrt{\frac{2t}{1-t}},\mathrm{d}{\bm{w}}_{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.SS2.p2" class="ltx_para ltx_noindent">
<p id="A2.SS2.p2.1" class="ltx_p">A direct consequence of this theorem is that the marginal distribution of <math id="A2.SS2.p2.m1" class="ltx_Math" alttext="{\bm{x}}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝒙</mi><mi>t</mi></msub><annotation encoding="application/x-tex">{\bm{x}}_{t}</annotation></semantics></math> is identical for the forward and reverse processes. Furthermore, a stronger corollary holds: the joint distribution of <math id="A2.SS2.p2.m2" class="ltx_Math" alttext="({\bm{x}}_{s},{\bm{x}}_{t})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>s</mi></msub><mo>,</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\bm{x}}_{s},{\bm{x}}_{t})</annotation></semantics></math> is also identical for both processes. This allows us to connect the forward-process-based score matching objective to the reverse-process-based DDPO objective.</p>
</div>
<div id="A2.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS2.p3" class="ltx_para ltx_noindent">
<p id="A2.SS2.p3.1" class="ltx_p"><span id="A2.SS2.p3.1.1" class="ltx_text">Our goal is to demonstrate that minimizing the Denoising Score Matching loss is equivalent to maximizing the DDPO log-likelihood objective. We begin with the Denoising Score Matching loss at <math id="A2.SS2.p3.m1" class="ltx_Math" alttext="{\bm{x}}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝒙</mi><mi>t</mi></msub><annotation encoding="application/x-tex">{\bm{x}}_{t}</annotation></semantics></math> conditioned on noisy data <math id="A2.SS2.p3.m2" class="ltx_Math" alttext="{\bm{x}}_{t-\Delta t}" display="inline" intent=":literal"><semantics><msub><mi>𝒙</mi><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><annotation encoding="application/x-tex">{\bm{x}}_{t-\Delta t}</annotation></semantics></math> from the forward process:</span></p>
<table id="A2.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E17.m1" class="ltx_Math" alttext="\mathbb{E}_{{\bm{x}}_{t-\Delta t},{\bm{x}}_{t}}\left[\left\|{\bm{s}}_{\bm{\theta}}({\bm{x}}_{t},t)-\nabla\log p({\bm{x}}_{t}|{\bm{x}}_{t-\Delta t})\right\|^{2}\right]." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mrow><msub><mi>𝒙</mi><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mo>,</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><mrow><msub><mi>𝒔</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>log</mi></mrow><mo lspace="0.167em">⁡</mo><mi>p</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}_{{\bm{x}}_{t-\Delta t},{\bm{x}}_{t}}\left[\left\|{\bm{s}}_{\bm{\theta}}({\bm{x}}_{t},t)-\nabla\log p({\bm{x}}_{t}|{\bm{x}}_{t-\Delta t})\right\|^{2}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p3.2" class="ltx_p"><span id="A2.SS2.p3.2.1" class="ltx_text">Note that <math id="A2.SS2.p3.m3" class="ltx_Math" alttext="{\bm{x}}_{t}|{\bm{x}}_{t-\Delta t}~\sim\mathcal{N}\left(\frac{1-t}{1-(t-\Delta t)}{\bm{x}}_{t-\Delta t},\left(t^{2}-\frac{(1-t)^{2}}{(1-(t-\Delta t))^{2}}(t-\Delta t)^{2}\right)\bm{I}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo fence="false">|</mo><mrow><msub><mi>𝒙</mi><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub></mrow><mo>,</mo><mrow><mrow><mo>(</mo><mrow><msup><mi>t</mi><mn>2</mn></msup><mo>−</mo><mrow><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝑰</mi></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{x}}_{t}|{\bm{x}}_{t-\Delta t}~\sim\mathcal{N}\left(\frac{1-t}{1-(t-\Delta t)}{\bm{x}}_{t-\Delta t},\left(t^{2}-\frac{(1-t)^{2}}{(1-(t-\Delta t))^{2}}(t-\Delta t)^{2}\right)\bm{I}\right)</annotation></semantics></math>, thus we have that the above denoising score matching loss is:</span></p>
<table id="A2.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E18.m1" class="ltx_Math" alttext="\mathbb{E}_{{\bm{x}}_{t-\Delta t},{\bm{x}}_{t}}\left[\left\|{\bm{s}}_{\bm{\theta}}({\bm{x}}_{t},t)+\frac{{\bm{x}}_{t}-\frac{1-t}{1-(t-\Delta t)}{\bm{x}}_{t-\Delta t}}{t^{2}-\frac{(1-t)^{2}}{(1-(t-\Delta t))^{2}}(t-\Delta t)^{2}}\right\|^{2}\right]." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mrow><msub><mi>𝒙</mi><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mo>,</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><mrow><msub><mi>𝒔</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mfrac><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>−</mo><mrow><mfrac><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub></mrow></mrow><mrow><msup><mi>t</mi><mn>2</mn></msup><mo>−</mo><mrow><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mfrac></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}_{{\bm{x}}_{t-\Delta t},{\bm{x}}_{t}}\left[\left\|{\bm{s}}_{\bm{\theta}}({\bm{x}}_{t},t)+\frac{{\bm{x}}_{t}-\frac{1-t}{1-(t-\Delta t)}{\bm{x}}_{t-\Delta t}}{t^{2}-\frac{(1-t)^{2}}{(1-(t-\Delta t))^{2}}(t-\Delta t)^{2}}\right\|^{2}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p3.3" class="ltx_p"><span id="A2.SS2.p3.3.1" class="ltx_text">Also, note that <math id="A2.SS2.p3.m4" class="ltx_Math" alttext="{\bm{s}}_{\bm{\theta}}({\bm{x}}_{t},t)=-\frac{(1-t){\bm{v}}_{\bm{\theta}}({\bm{x}}_{t},t)+{\bm{x}}_{t}}{t}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝒔</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mfrac><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow><mi>t</mi></mfrac></mrow></mrow><annotation encoding="application/x-tex">{\bm{s}}_{\bm{\theta}}({\bm{x}}_{t},t)=-\frac{(1-t){\bm{v}}_{\bm{\theta}}({\bm{x}}_{t},t)+{\bm{x}}_{t}}{t}</annotation></semantics></math>, we have</span></p>
<table id="A2.E19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E19.m1" class="ltx_Math" alttext="\mathbb{E}_{{\bm{x}}_{t-\Delta t},{\bm{x}}_{t}}\left[\left\|-\frac{(1-t){\bm{v}}_{\bm{\theta}}({\bm{x}}_{t},t)+{\bm{x}}_{t}}{t}+\frac{{\bm{x}}_{t}-\frac{1-t}{1-(t-\Delta t)}{\bm{x}}_{t-\Delta t}}{t^{2}-\frac{(1-t)^{2}}{(1-(t-\Delta t))^{2}}(t-\Delta t)^{2}}\right\|^{2}\right]." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mrow><msub><mi>𝒙</mi><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mo>,</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><mrow><mo>−</mo><mfrac><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow><mi>t</mi></mfrac></mrow><mo>+</mo><mfrac><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>−</mo><mrow><mfrac><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub></mrow></mrow><mrow><msup><mi>t</mi><mn>2</mn></msup><mo>−</mo><mrow><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mfrac></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}_{{\bm{x}}_{t-\Delta t},{\bm{x}}_{t}}\left[\left\|-\frac{(1-t){\bm{v}}_{\bm{\theta}}({\bm{x}}_{t},t)+{\bm{x}}_{t}}{t}+\frac{{\bm{x}}_{t}-\frac{1-t}{1-(t-\Delta t)}{\bm{x}}_{t-\Delta t}}{t^{2}-\frac{(1-t)^{2}}{(1-(t-\Delta t))^{2}}(t-\Delta t)^{2}}\right\|^{2}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p3.4" class="ltx_p"><span id="A2.SS2.p3.4.1" class="ltx_text">Simplifying the above equation, and let the coefficient of <math id="A2.SS2.p3.m5" class="ltx_Math" alttext="{\bm{x}}_{t-\Delta t}" display="inline" intent=":literal"><semantics><msub><mi>𝒙</mi><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><annotation encoding="application/x-tex">{\bm{x}}_{t-\Delta t}</annotation></semantics></math> to be <math id="A2.SS2.p3.m6" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, we have:</span></p>
<table id="A2.EGx2" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex10.m2" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}_{{\bm{x}}_{t-\Delta t},{\bm{x}}_{t}}\Bigg[\bigg\|{\bm{x}}_{t-\Delta t}-\left((1-(t-\Delta t))+\frac{(1-t)(t-\Delta t)^{2}}{t(1-(t-\Delta t))}\right){\bm{x}}_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><msub><mi>𝒙</mi><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mo>,</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow></msub><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mo lspace="0em" mathsize="2.100em" rspace="0.167em">∥</mo><msub><mi>𝒙</mi><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mo>−</mo><mrow><mo>(</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>−</mo><mi mathvariant="normal">Δ</mi><mi>t</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><msub><mi>𝒙</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{{\bm{x}}_{t-\Delta t},{\bm{x}}_{t}}\Bigg[\bigg\|{\bm{x}}_{t-\Delta t}-\left((1-(t-\Delta t))+\frac{(1-t)(t-\Delta t)^{2}}{t(1-(t-\Delta t))}\right){\bm{x}}_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E20.m1" class="ltx_math_unparsed" alttext="\displaystyle+\frac{1-(t-\Delta t)}{t}\left(t^{2}-\frac{(1-t)^{2}}{(1-(t-\Delta t))^{2}}(t-\Delta t)^{2}\right){\bm{v}}_{\bm{\theta}}({\bm{x}}_{t},t)\bigg\|^{2}\Bigg]." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>t</mi></mfrac></mstyle><mrow><mo>(</mo><msup><mi>t</mi><mn>2</mn></msup><mo>−</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>−</mo><mi mathvariant="normal">Δ</mi><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>)</mo></mrow><msub><mi>𝒗</mi><mi>𝜽</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msup><mo lspace="0em" mathsize="2.100em" rspace="0.167em">∥</mo><mn>2</mn></msup><mo maxsize="2.600em" minsize="2.600em">]</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{1-(t-\Delta t)}{t}\left(t^{2}-\frac{(1-t)^{2}}{(1-(t-\Delta t))^{2}}(t-\Delta t)^{2}\right){\bm{v}}_{\bm{\theta}}({\bm{x}}_{t},t)\bigg\|^{2}\Bigg].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS2.p4" class="ltx_para ltx_noindent">
<p id="A2.SS2.p4.1" class="ltx_p"><span id="A2.SS2.p4.1.1" class="ltx_text">Now, let’s consider the DDPO objective, which is the log-likelihood of one step of the reverse process. We consider the Euler-Maruyama discretization with Exponential Integrator of the diffusion SDE <a href="#S3.E1" title="In 3.1 Background on Diffusion and Flow Matching ‣ 3 DDPO Is Secretly Doing Score Matching ‣ Advantage Weighted Matching: Aligning RL with Pretraining in Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">1</span></a>:</span></p>
<table id="A2.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E21.m1" class="ltx_Math" alttext="\mathrm{d}{\bm{x}}_{t}=\left[{\bm{v}}_{\bm{\theta}}({\bm{x}}_{t},t)+\frac{1}{1-t}\left({\bm{x}}_{t}+(1-t){\bm{v}}_{\bm{\theta}}({\bm{x}}_{t},t)\right)\right]\mathrm{d}t+\sqrt{\frac{2t}{1-t}}\mathrm{d}{\bm{w}}_{t}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow><mo>=</mo><mrow><mrow><mrow><mo>[</mo><mrow><mrow><msub><mi>𝒗</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mrow><msqrt><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒘</mi><mi>t</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{d}{\bm{x}}_{t}=\left[{\bm{v}}_{\bm{\theta}}({\bm{x}}_{t},t)+\frac{1}{1-t}\left({\bm{x}}_{t}+(1-t){\bm{v}}_{\bm{\theta}}({\bm{x}}_{t},t)\right)\right]\mathrm{d}t+\sqrt{\frac{2t}{1-t}}\mathrm{d}{\bm{w}}_{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p4.2" class="ltx_p"><span id="A2.SS2.p4.2.1" class="ltx_text">According to the results in <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib59" title="" class="ltx_ref">Xue et al., 2023</a>)</cite>,</span></p>
<table id="A2.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex11.m1" class="ltx_Math" alttext="\displaystyle{\bm{x}}_{t-\Delta t}=\frac{(1-t)(t-\Delta t)^{2}}{(1-(t-\Delta t))t^{2}}{\bm{x}}_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒙</mi><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{x}}_{t-\Delta t}=\frac{(1-t)(t-\Delta t)^{2}}{(1-(t-\Delta t))t^{2}}{\bm{x}}_{t}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex11.m2" class="ltx_Math" alttext="\displaystyle+\frac{1-(t-\Delta t)}{t^{2}}(t^{2}-\frac{(1-t)^{2}}{(1-(t-\Delta t))^{2}}(t-\Delta t)^{2}){\bm{x}}_{\bm{\theta}}({\bm{x}}_{t},t)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><msup><mi>t</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>t</mi><mn>2</mn></msup><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{1-(t-\Delta t)}{t^{2}}(t^{2}-\frac{(1-t)^{2}}{(1-(t-\Delta t))^{2}}(t-\Delta t)^{2}){\bm{x}}_{\bm{\theta}}({\bm{x}}_{t},t)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E22.m1" class="ltx_Math" alttext="\displaystyle+\sqrt{t^{2}-\frac{(1-t)^{2}}{(1-(t-\Delta t))^{2}}(t-\Delta t)^{2}}\frac{t-\Delta t}{t}\bm{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><msqrt><mrow><msup><mi>t</mi><mn>2</mn></msup><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mi>t</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\sqrt{t^{2}-\frac{(1-t)^{2}}{(1-(t-\Delta t))^{2}}(t-\Delta t)^{2}}\frac{t-\Delta t}{t}\bm{\epsilon}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p4.3" class="ltx_p"><span id="A2.SS2.p4.3.1" class="ltx_text">Subtitute that <math id="A2.SS2.p4.m1" class="ltx_Math" alttext="{\bm{x}}_{\bm{\theta}}={\bm{x}}_{t}-t{\bm{v}}_{\bm{\theta}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒙</mi><mi>𝜽</mi></msub><mo>=</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>−</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>𝜽</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{x}}_{\bm{\theta}}={\bm{x}}_{t}-t{\bm{v}}_{\bm{\theta}}</annotation></semantics></math>, we have that</span></p>
<table id="A2.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E23.m1" class="ltx_Math" alttext="\displaystyle{\bm{x}}_{t-\Delta t}" display="inline" intent=":literal"><semantics><msub><mi>𝒙</mi><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><annotation encoding="application/x-tex">\displaystyle{\bm{x}}_{t-\Delta t}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E23.m2" class="ltx_Math" alttext="\displaystyle=\left((1-(t-\Delta t))+\frac{(1-t)(t-\Delta t)^{2}}{t(1-(t-\Delta t))}\right){\bm{x}}_{t}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left((1-(t-\Delta t))+\frac{(1-t)(t-\Delta t)^{2}}{t(1-(t-\Delta t))}\right){\bm{x}}_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
<tbody id="A2.Ex12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex12.m1" class="ltx_Math" alttext="\displaystyle-\frac{1-(t-\Delta t)}{t}(t^{2}-\frac{(1-t)^{2}}{(1-(t-\Delta t))^{2}}(t-\Delta t)^{2}){\bm{v}}_{\bm{\theta}}({\bm{x}}_{t},t)" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>t</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>t</mi><mn>2</mn></msup><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{1-(t-\Delta t)}{t}(t^{2}-\frac{(1-t)^{2}}{(1-(t-\Delta t))^{2}}(t-\Delta t)^{2}){\bm{v}}_{\bm{\theta}}({\bm{x}}_{t},t)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E24.m1" class="ltx_Math" alttext="\displaystyle+\sqrt{t^{2}-\frac{(1-t)^{2}}{(1-(t-\Delta t))^{2}}(t-\Delta t)^{2}}\frac{t-\Delta t}{t}\bm{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><msqrt><mrow><msup><mi>t</mi><mn>2</mn></msup><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mi>t</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\sqrt{t^{2}-\frac{(1-t)^{2}}{(1-(t-\Delta t))^{2}}(t-\Delta t)^{2}}\frac{t-\Delta t}{t}\bm{\epsilon}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p4.4" class="ltx_p"><span id="A2.SS2.p4.4.1" class="ltx_text">If we omit the discretization error induced by Euler-Maruyama discretization, according to <a href="#Thmlemma2" title="Lemma 2 (Time Reversal of Diffusions ( , )). ‣ B.2 Proof of ‣ Appendix B Proofs ‣ Advantage Weighted Matching: Aligning RL with Pretraining in Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">2</span></a>, the joint distribution of <math id="A2.SS2.p4.m2" class="ltx_Math" alttext="({\bm{x}}_{t-\Delta t},{\bm{x}}_{t})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mo>,</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\bm{x}}_{t-\Delta t},{\bm{x}}_{t})</annotation></semantics></math> in the reverse process is identical to <math id="A2.SS2.p4.m3" class="ltx_Math" alttext="({\bm{x}}_{t-\Delta t},{\bm{x}}_{t})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mo>,</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\bm{x}}_{t-\Delta t},{\bm{x}}_{t})</annotation></semantics></math> in the forward process. Then we have that maximizing <math id="A2.SS2.p4.m4" class="ltx_Math" alttext="\log p_{\bm{\theta}}({\bm{x}}_{t-\Delta t}|{\bm{x}}_{t})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>𝜽</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\log p_{\bm{\theta}}({\bm{x}}_{t-\Delta t}|{\bm{x}}_{t})</annotation></semantics></math> is equivalent to minimizing:</span></p>
<table id="A2.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex13.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}_{{\bm{x}}_{t-\Delta t},{\bm{x}}_{t}}\Bigg[\bigg\|{\bm{x}}_{t-\Delta t}-\left((1-(t-\Delta t))+\frac{(1-t)(t-\Delta t)^{2}}{t(1-(t-\Delta t))}\right){\bm{x}}_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><msub><mi>𝒙</mi><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mo>,</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow></msub><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mo lspace="0em" mathsize="2.100em" rspace="0.167em">∥</mo><msub><mi>𝒙</mi><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mo>−</mo><mrow><mo>(</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>−</mo><mi mathvariant="normal">Δ</mi><mi>t</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><msub><mi>𝒙</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{{\bm{x}}_{t-\Delta t},{\bm{x}}_{t}}\Bigg[\bigg\|{\bm{x}}_{t-\Delta t}-\left((1-(t-\Delta t))+\frac{(1-t)(t-\Delta t)^{2}}{t(1-(t-\Delta t))}\right){\bm{x}}_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E25.m1" class="ltx_math_unparsed" alttext="\displaystyle+\frac{1-(t-\Delta t)}{t}\left(t^{2}-\frac{(1-t)^{2}}{(1-(t-\Delta t))^{2}}(t-\Delta t)^{2}\right){\bm{v}}_{\bm{\theta}}({\bm{x}}_{t},t)\bigg\|^{2}\Bigg]," display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>t</mi></mfrac></mstyle><mrow><mo>(</mo><msup><mi>t</mi><mn>2</mn></msup><mo>−</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>−</mo><mi mathvariant="normal">Δ</mi><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>)</mo></mrow><msub><mi>𝒗</mi><mi>𝜽</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msup><mo lspace="0em" mathsize="2.100em" rspace="0.167em">∥</mo><mn>2</mn></msup><mo maxsize="2.600em" minsize="2.600em">]</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{1-(t-\Delta t)}{t}\left(t^{2}-\frac{(1-t)^{2}}{(1-(t-\Delta t))^{2}}(t-\Delta t)^{2}\right){\bm{v}}_{\bm{\theta}}({\bm{x}}_{t},t)\bigg\|^{2}\Bigg],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p4.5" class="ltx_p"><span id="A2.SS2.p4.5.1" class="ltx_text">which is identical to <a href="#A2.Ex10" title="In Proof. ‣ B.2 Proof of ‣ Appendix B Proofs ‣ Advantage Weighted Matching: Aligning RL with Pretraining in Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">20</span></a>, thus identical to the noisy DSM loss <a href="#A2.E17" title="In Proof. ‣ B.2 Proof of ‣ Appendix B Proofs ‣ Advantage Weighted Matching: Aligning RL with Pretraining in Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">17</span></a>.
∎</span></p>
</div>
</div>
</section>
<section id="A2.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.3 </span>Proof of <a href="#Thmtheorem2" title="Theorem 2 (Variance of Denoising Score Matching Target with Noisy Data is Larger). ‣ 3.3 Denoising Score Matching with Noisy Data ‣ 3 DDPO Is Secretly Doing Score Matching ‣ Advantage Weighted Matching: Aligning RL with Pretraining in Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">2</span></a></h3>

<div id="A2.SS3.p1" class="ltx_para ltx_noindent">
<p id="A2.SS3.p1.1" class="ltx_p">We first give a more detailed version of <a href="#Thmtheorem2" title="Theorem 2 (Variance of Denoising Score Matching Target with Noisy Data is Larger). ‣ 3.3 Denoising Score Matching with Noisy Data ‣ 3 DDPO Is Secretly Doing Score Matching ‣ Advantage Weighted Matching: Aligning RL with Pretraining in Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">2</span></a></p>
</div>
<div id="Thmtheorem2a" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem2a.2" class="ltx_text ltx_font_bold">Theorem 2</span></span><span id="Thmtheorem2a.3" class="ltx_text ltx_font_bold"> </span>(Detailed version of <a href="#Thmtheorem2" title="Theorem 2 (Variance of Denoising Score Matching Target with Noisy Data is Larger). ‣ 3.3 Denoising Score Matching with Noisy Data ‣ 3 DDPO Is Secretly Doing Score Matching ‣ Advantage Weighted Matching: Aligning RL with Pretraining in Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">2</span></a> in the main body)<span id="Thmtheorem2a.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem2a.p1" class="ltx_para ltx_noindent">
<p id="Thmtheorem2a.p1.1" class="ltx_p"><math id="Thmtheorem2a.p1.m1" class="ltx_Math" alttext="{\bm{x}}_{t},{\bm{x}}_{s}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝒙</mi><mi>s</mi></msub></mrow><annotation encoding="application/x-tex">{\bm{x}}_{t},{\bm{x}}_{s}</annotation></semantics></math><span id="Thmtheorem2a.p1.1.1" class="ltx_text ltx_font_italic"> satisfies</span></p>
<table id="A2.E26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E26.m1" class="ltx_math_unparsed" alttext="{\bm{x}}_{t}|{\bm{x}}_{s}\sim\mathcal{N}\!\big(\alpha(t,s)\,{\bm{x}}_{s},\ \sigma^{2}(t,s)\,I\big),\qquad\alpha(t,s)=\frac{1-t}{1-s},\quad\sigma^{2}(t,s)=t^{2}-\frac{(1-t)^{2}}{(1-s)^{2}}s^{2}," display="block" intent=":literal"><semantics><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝒙</mi><mi>s</mi></msub><mo>∼</mo><mpadded style="width:0.798em;" width="0.798em"><mi class="ltx_font_mathcaligraphic">𝒩</mi></mpadded><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>s</mi><mo rspace="0.170em" stretchy="false">)</mo></mrow><msub><mi>𝒙</mi><mi>s</mi></msub><mo rspace="0.667em">,</mo><msup><mi>σ</mi><mn>2</mn></msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>s</mi><mo rspace="0.170em" stretchy="false">)</mo></mrow><mi>I</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo rspace="2.167em">,</mo><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mfrac><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></mfrac><mo rspace="1.167em">,</mo><msup><mi>σ</mi><mn>2</mn></msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msup><mi>t</mi><mn>2</mn></msup><mo>−</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><msup><mi>s</mi><mn>2</mn></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">{\bm{x}}_{t}|{\bm{x}}_{s}\sim\mathcal{N}\!\big(\alpha(t,s)\,{\bm{x}}_{s},\ \sigma^{2}(t,s)\,I\big),\qquad\alpha(t,s)=\frac{1-t}{1-s},\quad\sigma^{2}(t,s)=t^{2}-\frac{(1-t)^{2}}{(1-s)^{2}}s^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
</table>
<p id="Thmtheorem2a.p1.2" class="ltx_p"><span id="Thmtheorem2a.p1.2.1" class="ltx_text ltx_font_italic">for all <math id="Thmtheorem2a.p1.m2" class="ltx_Math" alttext="0\leq s&lt;t\leq 1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>s</mi><mo>&lt;</mo><mi>t</mi><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0\leq s&lt;t\leq 1</annotation></semantics></math>, so that</span></p>
<table id="A2.E27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E27.m1" class="ltx_Math" alttext="\sigma^{2}(t,s)+\alpha^{2}(t,s)\,s^{2}\;=\;t^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>s</mi><mn>2</mn></msup></mrow></mrow><mo rspace="0.558em">=</mo><msup><mi>t</mi><mn>2</mn></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sigma^{2}(t,s)+\alpha^{2}(t,s)\,s^{2}\;=\;t^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(27)</span></td></tr></tbody>
</table>
<p id="Thmtheorem2a.p1.3" class="ltx_p"><span id="Thmtheorem2a.p1.3.1" class="ltx_text ltx_font_italic">Let <math id="Thmtheorem2a.p1.m3" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> be the data dimension. Then, for the two conditional scores</span></p>
<table id="A2.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex14.m1" class="ltx_Math" alttext="\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s}),\qquad\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{0})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s}),\qquad\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{0}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem2a.p1.4" class="ltx_p"><span id="Thmtheorem2a.p1.4.1" class="ltx_text ltx_font_italic">and for any fixed <math id="Thmtheorem2a.p1.m4" class="ltx_Math" alttext="{\bm{x}}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mi>t</mi></msub><annotation encoding="application/x-tex">{\bm{x}}_{t}</annotation></semantics></math> and any <math id="Thmtheorem2a.p1.m5" class="ltx_Math" alttext="s\in[0,t)" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s\in[0,t)</annotation></semantics></math>, each is an unbiased estimator of the true score <math id="Thmtheorem2a.p1.m6" class="ltx_Math" alttext="\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><msub><mi>𝐱</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t})</annotation></semantics></math>:</span></p>
<table id="A2.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex15.m1" class="ltx_Math" alttext="\mathbb{E}\!\left[\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})\,\middle|\,{\bm{x}}_{t}\right]=\mathbb{E}\!\left[\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{0})\,\middle|\,{\bm{x}}_{t}\right]=\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>]</mo></mrow></mrow><mo>=</mo><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\!\left[\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})\,\middle|\,{\bm{x}}_{t}\right]=\mathbb{E}\!\left[\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{0})\,\middle|\,{\bm{x}}_{t}\right]=\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem2a.p1.5" class="ltx_p"><span id="Thmtheorem2a.p1.5.1" class="ltx_text ltx_font_italic">Moreover, their conditional covariances satisfy</span></p>
<table id="A2.E28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E28.m1" class="ltx_Math" alttext="\operatorname{Cov}\!\left(\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})\,\middle|\,{\bm{x}}_{t}\right)=\operatorname{Cov}\!\left(\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{0})\,\middle|\,{\bm{x}}_{t}\right)+\kappa(s,t)\,I\ \succeq\ \operatorname{Cov}\!\left(\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{0})\,\middle|\,{\bm{x}}_{t}\right)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mpadded style="width:1.622em;" width="1.622em"><mi>Cov</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mpadded style="width:1.622em;" width="1.622em"><mi>Cov</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo lspace="0.778em" rspace="0.778em">⪰</mo><mrow><mpadded style="width:1.622em;" width="1.622em"><mi>Cov</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\operatorname{Cov}\!\left(\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})\,\middle|\,{\bm{x}}_{t}\right)=\operatorname{Cov}\!\left(\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{0})\,\middle|\,{\bm{x}}_{t}\right)+\kappa(s,t)\,I\ \succeq\ \operatorname{Cov}\!\left(\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{0})\,\middle|\,{\bm{x}}_{t}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
</table>
<p id="Thmtheorem2a.p1.6" class="ltx_p"><span id="Thmtheorem2a.p1.6.1" class="ltx_text ltx_font_italic">where</span></p>
<table id="A2.E29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E29.m1" class="ltx_Math" alttext="\kappa(s,t)\;=\;\frac{(1-t)^{2}\,s^{2}}{t^{2}\Big(t^{2}(1-s)^{2}-s^{2}(1-t)^{2}\Big)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">=</mo><mfrac><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>s</mi><mn>2</mn></msup></mrow><mrow><msup><mi>t</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msup><mi>t</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><mrow><msup><mi>s</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\kappa(s,t)\;=\;\frac{(1-t)^{2}\,s^{2}}{t^{2}\Big(t^{2}(1-s)^{2}-s^{2}(1-t)^{2}\Big)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(29)</span></td></tr></tbody>
</table>
<p id="Thmtheorem2a.p1.7" class="ltx_p"><span id="Thmtheorem2a.p1.7.1" class="ltx_text ltx_font_italic">In particular,</span></p>
<table id="A2.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex16.m1" class="ltx_Math" alttext="\operatorname{Tr}\operatorname{Cov}\!\left(\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})\,\middle|\,{\bm{x}}_{t}\right)=\operatorname{Tr}\operatorname{Cov}\!\left(\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{0})\,\middle|\,{\bm{x}}_{t}\right)+d\,\kappa(s,t)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Tr</mi><mo lspace="0.167em">⁡</mo><mrow><mpadded style="width:1.622em;" width="1.622em"><mi>Cov</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mi>Tr</mi><mo lspace="0.167em">⁡</mo><mrow><mpadded style="width:1.622em;" width="1.622em"><mi>Cov</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>d</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{Tr}\operatorname{Cov}\!\left(\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})\,\middle|\,{\bm{x}}_{t}\right)=\operatorname{Tr}\operatorname{Cov}\!\left(\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{0})\,\middle|\,{\bm{x}}_{t}\right)+d\,\kappa(s,t).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem2a.p1.8" class="ltx_p"><span id="Thmtheorem2a.p1.8.1" class="ltx_text ltx_font_italic">The map <math id="Thmtheorem2a.p1.m7" class="ltx_Math" alttext="s\mapsto\kappa(s,t)" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo stretchy="false">↦</mo><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s\mapsto\kappa(s,t)</annotation></semantics></math> is strictly increasing on <math id="Thmtheorem2a.p1.m8" class="ltx_Math" alttext="[0,t)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">[0,t)</annotation></semantics></math>, with <math id="Thmtheorem2a.p1.m9" class="ltx_Math" alttext="\kappa(0,t)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\kappa(0,t)=0</annotation></semantics></math> and <math id="Thmtheorem2a.p1.m10" class="ltx_Math" alttext="\kappa(s,t)\to\infty" display="inline" intent=":literal"><semantics><mrow><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\kappa(s,t)\to\infty</annotation></semantics></math> as <math id="Thmtheorem2a.p1.m11" class="ltx_Math" alttext="s\uparrow t" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo stretchy="false">↑</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">s\uparrow t</annotation></semantics></math>.</span></p>
</div>
<div id="Thmtheorem2a.p2" class="ltx_para">
<p id="Thmtheorem2a.p2.1" class="ltx_p"><span id="Thmtheorem2a.p2.1.1" class="ltx_text ltx_font_italic">Moreover, for any predictor <math id="Thmtheorem2a.p2.m1" class="ltx_Math" alttext="a=a({\bm{x}}_{t},t)\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>=</mo><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">a=a({\bm{x}}_{t},t)\in\mathbb{R}^{d}</annotation></semantics></math> (e.g. <math id="Thmtheorem2a.p2.m2" class="ltx_Math" alttext="a={\bm{s}}_{\theta}({\bm{x}}_{t},t)" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>=</mo><mrow><msub><mi>𝐬</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">a={\bm{s}}_{\theta}({\bm{x}}_{t},t)</annotation></semantics></math>):</span></p>
<table id="A2.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E30.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\!\Big[\big\|a-\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})\big\|^{2}\,\Big|\,{\bm{x}}_{t}\Big]=\mathbb{E}\!\Big[\big\|a-\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{0})\big\|^{2}\,\Big|\,{\bm{x}}_{t}\Big]+d\,\kappa(s,t)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><msup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mi>a</mi><mo>−</mo><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>2</mn></msup><mo fence="false" maxsize="1.600em" minsize="1.600em" rspace="0.337em" stretchy="true">|</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><msup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mi>a</mi><mo>−</mo><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>2</mn></msup><mo fence="false" maxsize="1.600em" minsize="1.600em" rspace="0.337em" stretchy="true">|</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><mo>+</mo><mrow><mi>d</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\!\Big[\big\|a-\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})\big\|^{2}\,\Big|\,{\bm{x}}_{t}\Big]=\mathbb{E}\!\Big[\big\|a-\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{0})\big\|^{2}\,\Big|\,{\bm{x}}_{t}\Big]+d\,\kappa(s,t),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(30)</span></td></tr></tbody>
<tbody id="A2.Ex17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex17.m1" class="ltx_Math" alttext="\displaystyle\mathrm{Var}\!\Big(\big\|a-\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})\big\|^{2}\,\Big|\,{\bm{x}}_{t}\Big)=\mathrm{Var}\!\Big(\big\|a-\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{0})\big\|^{2}\,\Big|\,{\bm{x}}_{t}\Big)+2d\,\kappa(s,t)^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mi>a</mi><mo>−</mo><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" mathsize="1.600em" rspace="0.170em">|</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mi>a</mi><mo>−</mo><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" mathsize="1.600em" rspace="0.170em">|</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{Var}\!\Big(\big\|a-\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})\big\|^{2}\,\Big|\,{\bm{x}}_{t}\Big)=\mathrm{Var}\!\Big(\big\|a-\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{0})\big\|^{2}\,\Big|\,{\bm{x}}_{t}\Big)+2d\,\kappa(s,t)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E31.m1" class="ltx_Math" alttext="\displaystyle\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad+4\,\kappa(s,t)\,\mathbb{E}\!\Big[\big\|a-\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{0})\big\|^{2}\,\Big|\,{\bm{x}}_{t}\Big]." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0.170em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><msup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mi>a</mi><mo>−</mo><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>2</mn></msup><mo fence="false" maxsize="1.600em" minsize="1.600em" rspace="0.337em" stretchy="true">|</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad+4\,\kappa(s,t)\,\mathbb{E}\!\Big[\big\|a-\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{0})\big\|^{2}\,\Big|\,{\bm{x}}_{t}\Big].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(31)</span></td></tr></tbody>
</table>
<p id="Thmtheorem2a.p2.2" class="ltx_p"><span id="Thmtheorem2a.p2.2.1" class="ltx_text ltx_font_italic">Hence both the conditional risk and the conditional objective variance are minimized at <math id="Thmtheorem2a.p2.m3" class="ltx_Math" alttext="s=0" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">s=0</annotation></semantics></math> and strictly increase with <math id="Thmtheorem2a.p2.m4" class="ltx_Math" alttext="s\in(0,t)" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s\in(0,t)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A2.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS3.p2" class="ltx_para ltx_noindent">
<p id="A2.SS3.p2.1" class="ltx_p"><span id="A2.SS3.p2.1.1" class="ltx_text">Under <a href="#A2.E26" title="In Theorem 2 (Detailed version of in the main body). ‣ B.3 Proof of ‣ Appendix B Proofs ‣ Advantage Weighted Matching: Aligning RL with Pretraining in Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">26</span></a>,</span></p>
<table id="A2.E32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E32.m1" class="ltx_Math" alttext="\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})=-\frac{1}{\sigma^{2}(t,s)}\big({\bm{x}}_{t}-\alpha(t,s)\,{\bm{x}}_{s}\big),\qquad\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{0})=-\frac{1}{t^{2}}\big({\bm{x}}_{t}-(1-t)\,{\bm{x}}_{0}\big)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>−</mo><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>s</mi></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mrow><mfrac><mn>1</mn><msup><mi>t</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>𝒙</mi><mn>0</mn></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})=-\frac{1}{\sigma^{2}(t,s)}\big({\bm{x}}_{t}-\alpha(t,s)\,{\bm{x}}_{s}\big),\qquad\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{0})=-\frac{1}{t^{2}}\big({\bm{x}}_{t}-(1-t)\,{\bm{x}}_{0}\big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(32)</span></td></tr></tbody>
</table>
</div>
</div>
<section id="A2.SS3.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Auxiliary Lemma 1</h5>

<div id="A2.SS3.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px1.p1.1" class="ltx_p">For fixed <math id="A2.SS3.SSS0.Px1.p1.m1" class="ltx_Math" alttext="{\bm{x}}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝒙</mi><mi>t</mi></msub><annotation encoding="application/x-tex">{\bm{x}}_{t}</annotation></semantics></math> and any <math id="A2.SS3.SSS0.Px1.p1.m2" class="ltx_Math" alttext="s\in[0,t)" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s\in[0,t)</annotation></semantics></math>, there exists a zero-mean Gaussian vector
<math id="A2.SS3.SSS0.Px1.p1.m3" class="ltx_Math" alttext="\bm{\eta}" display="inline" intent=":literal"><semantics><mi>𝜼</mi><annotation encoding="application/x-tex">\bm{\eta}</annotation></semantics></math> such that</p>
<table id="A2.E33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E33.m1" class="ltx_Math" alttext="\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})\;=\;\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{0})\;+\;\bm{\eta},\qquad\bm{\eta}\ \perp\ ({\bm{x}}_{0}|{\bm{x}}_{t}),\qquad\bm{\eta}\sim\mathcal{N}\!\big(\mathbf{0},\ \kappa(s,t)\,I\big)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mi>s</mi></msub><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">=</mo><mrow><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.502em">+</mo><mi>𝜼</mi></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>𝜼</mi><mo lspace="0.778em" rspace="0.778em">⟂</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>𝜼</mi><mo>∼</mo><mrow><mpadded style="width:0.798em;" width="0.798em"><mi class="ltx_font_mathcaligraphic">𝒩</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mn>𝟎</mn><mo>,</mo><mrow><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>I</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})\;=\;\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{0})\;+\;\bm{\eta},\qquad\bm{\eta}\ \perp\ ({\bm{x}}_{0}|{\bm{x}}_{t}),\qquad\bm{\eta}\sim\mathcal{N}\!\big(\mathbf{0},\ \kappa(s,t)\,I\big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(33)</span></td></tr></tbody>
</table>
<p id="A2.SS3.SSS0.Px1.p1.2" class="ltx_p">with <math id="A2.SS3.SSS0.Px1.p1.m4" class="ltx_Math" alttext="\kappa(s,t)" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\kappa(s,t)</annotation></semantics></math> given by <a href="#A2.E29" title="In Theorem 2 (Detailed version of in the main body). ‣ B.3 Proof of ‣ Appendix B Proofs ‣ Advantage Weighted Matching: Aligning RL with Pretraining in Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">29</span></a>.</p>
</div>
<div id="A2.SS3.SSS0.Px1.p2" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px1.p2.1" class="ltx_p"><em id="A2.SS3.SSS0.Px1.p2.1.1" class="ltx_emph ltx_font_italic">Proof of Aux. Lemma 1.</em>
Conditioned on <math id="A2.SS3.SSS0.Px1.p2.m1" class="ltx_Math" alttext="({\bm{x}}_{t},{\bm{x}}_{0})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\bm{x}}_{t},{\bm{x}}_{0})</annotation></semantics></math>, the posterior of <math id="A2.SS3.SSS0.Px1.p2.m2" class="ltx_Math" alttext="{\bm{x}}_{s}" display="inline" intent=":literal"><semantics><msub><mi>𝒙</mi><mi>s</mi></msub><annotation encoding="application/x-tex">{\bm{x}}_{s}</annotation></semantics></math> is Gaussian with mean
<math id="A2.SS3.SSS0.Px1.p2.m3" class="ltx_Math" alttext="\frac{\sigma^{2}(t,s)(1-s){\bm{x}}_{0}+\alpha(t,s)s^{2}{\bm{x}}_{t}}{t^{2}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow></mrow><msup><mi>t</mi><mn>2</mn></msup></mfrac><annotation encoding="application/x-tex">\frac{\sigma^{2}(t,s)(1-s){\bm{x}}_{0}+\alpha(t,s)s^{2}{\bm{x}}_{t}}{t^{2}}</annotation></semantics></math>
and covariance
<math id="A2.SS3.SSS0.Px1.p2.m4" class="ltx_Math" alttext="\frac{s^{2}\sigma^{2}(t,s)}{t^{2}}" display="inline" intent=":literal"><semantics><mfrac><mrow><msup><mi>s</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><msup><mi>t</mi><mn>2</mn></msup></mfrac><annotation encoding="application/x-tex">\frac{s^{2}\sigma^{2}(t,s)}{t^{2}}</annotation></semantics></math>
Using equation <a href="#A2.E32" title="Equation 32 ‣ Proof. ‣ B.3 Proof of ‣ Appendix B Proofs ‣ Advantage Weighted Matching: Aligning RL with Pretraining in Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">32</span></a>, define</p>
<table id="A2.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex18.m1" class="ltx_math_unparsed" alttext="\bm{\eta}\coloneqq\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})-\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{0})=\frac{\alpha(t,s)}{\sigma^{2}(t,s)}\!\left({\bm{x}}_{s}-\mathbb{E}[{\bm{x}}_{s}|{\bm{x}}_{t},{\bm{x}}_{0}]\right)." display="block" intent=":literal"><semantics><mrow><mi>𝜼</mi><mo>≔</mo><msub><mo rspace="0.167em">∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mi>log</mi><mi>p</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝒙</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mo rspace="0.167em">∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mi>log</mi><mi>p</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mfrac><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mrow><mo>(</mo><msub><mi>𝒙</mi><mi>s</mi></msub><mo>−</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>𝒙</mi><mi>s</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">]</mo></mrow><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bm{\eta}\coloneqq\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})-\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{0})=\frac{\alpha(t,s)}{\sigma^{2}(t,s)}\!\left({\bm{x}}_{s}-\mathbb{E}[{\bm{x}}_{s}|{\bm{x}}_{t},{\bm{x}}_{0}]\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS0.Px1.p2.2" class="ltx_p">Then <math id="A2.SS3.SSS0.Px1.p2.m5" class="ltx_Math" alttext="\bm{\eta}|({\bm{x}}_{t},{\bm{x}}_{0})" display="inline" intent=":literal"><semantics><mrow><mi>𝜼</mi><mo fence="false">|</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{\eta}|({\bm{x}}_{t},{\bm{x}}_{0})</annotation></semantics></math> is zero-mean Gaussian with covariance</p>
<table id="A2.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex19.m1" class="ltx_Math" alttext="\frac{\alpha^{2}}{\sigma^{4}}\frac{s^{2}\sigma^{2}}{t^{2}}\!I=\frac{\alpha^{2}s^{2}}{\sigma^{2}t^{2}}\,I=\kappa(s,t)\,I." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><msup><mi>α</mi><mn>2</mn></msup><msup><mi>σ</mi><mn>4</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msup><mi>s</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><msup><mi>t</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo>=</mo><mrow><mfrac><mrow><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mn>2</mn></msup></mrow><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mn>2</mn></msup></mrow></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mi>I</mi></mrow><mo>=</mo><mrow><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\alpha^{2}}{\sigma^{4}}\frac{s^{2}\sigma^{2}}{t^{2}}\!I=\frac{\alpha^{2}s^{2}}{\sigma^{2}t^{2}}\,I=\kappa(s,t)\,I.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS0.Px1.p2.3" class="ltx_p">The residual
<math id="A2.SS3.SSS0.Px1.p2.m6" class="ltx_math_unparsed" alttext="{\bm{x}}_{s}-\mathbb{E}[{\bm{x}}_{s}|{\bm{x}}_{t},{\bm{x}}_{0}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒙</mi><mi>s</mi></msub><mo>−</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>𝒙</mi><mi>s</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{x}}_{s}-\mathbb{E}[{\bm{x}}_{s}|{\bm{x}}_{t},{\bm{x}}_{0}]</annotation></semantics></math> is independent of <math id="A2.SS3.SSS0.Px1.p2.m7" class="ltx_Math" alttext="({\bm{x}}_{t},{\bm{x}}_{0})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\bm{x}}_{t},{\bm{x}}_{0})</annotation></semantics></math>, hence <math id="A2.SS3.SSS0.Px1.p2.m8" class="ltx_Math" alttext="\bm{\eta}\perp({\bm{x}}_{0}|{\bm{x}}_{t})" display="inline" intent=":literal"><semantics><mrow><mi>𝜼</mi><mo>⟂</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{\eta}\perp({\bm{x}}_{0}|{\bm{x}}_{t})</annotation></semantics></math>.
 <math id="A2.SS3.SSS0.Px1.p2.m9" class="ltx_Math" alttext="\square" display="inline" intent=":literal"><semantics><mi mathvariant="normal">□</mi><annotation encoding="application/x-tex">\square</annotation></semantics></math></p>
</div>
<div id="A2.SS3.SSS0.Px1.p3" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px1.p3.1" class="ltx_p">By the score identity,
<math id="A2.SS3.SSS0.Px1.p3.m1" class="ltx_Math" alttext="\mathbb{E}[\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})|{\bm{x}}_{t}]=\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})|{\bm{x}}_{t}]=\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t})</annotation></semantics></math>
for every <math id="A2.SS3.SSS0.Px1.p3.m2" class="ltx_Math" alttext="s\in[0,t)" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s\in[0,t)</annotation></semantics></math>; in particular this equals
<math id="A2.SS3.SSS0.Px1.p3.m3" class="ltx_Math" alttext="\mathbb{E}[\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{0})|{\bm{x}}_{t}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{0})|{\bm{x}}_{t}]</annotation></semantics></math>.
From equation <a href="#A2.E33" title="Equation 33 ‣ Auxiliary Lemma 1 ‣ B.3 Proof of ‣ Appendix B Proofs ‣ Advantage Weighted Matching: Aligning RL with Pretraining in Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">33</span></a> and <math id="A2.SS3.SSS0.Px1.p3.m4" class="ltx_Math" alttext="\bm{\eta}\perp({\bm{x}}_{0}|{\bm{x}}_{t})" display="inline" intent=":literal"><semantics><mrow><mi>𝜼</mi><mo>⟂</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{\eta}\perp({\bm{x}}_{0}|{\bm{x}}_{t})</annotation></semantics></math>,</p>
<table id="A2.Ex20" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex20X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex20X.m2" class="ltx_Math" alttext="\displaystyle\operatorname{Cov}\!\left(\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})\,\middle|\,{\bm{x}}_{t}\right)" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:1.622em;" width="1.622em"><mi>Cov</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{Cov}\!\left(\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})\,\middle|\,{\bm{x}}_{t}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex20X.m3" class="ltx_Math" alttext="\displaystyle=\operatorname{Cov}\!\left(\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{0})\,\middle|\,{\bm{x}}_{t}\right)+\operatorname{Cov}(\bm{\eta}|{\bm{x}}_{t})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mpadded style="width:1.622em;" width="1.622em"><mi>Cov</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝜼</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\operatorname{Cov}\!\left(\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{0})\,\middle|\,{\bm{x}}_{t}\right)+\operatorname{Cov}(\bm{\eta}|{\bm{x}}_{t})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex20Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex20Xa.m2" class="ltx_Math" alttext="\displaystyle=\operatorname{Cov}\!\left(\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{0})\,\middle|\,{\bm{x}}_{t}\right)+\kappa(s,t)\,I," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mpadded style="width:1.622em;" width="1.622em"><mi>Cov</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>I</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\operatorname{Cov}\!\left(\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{0})\,\middle|\,{\bm{x}}_{t}\right)+\kappa(s,t)\,I,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS3.SSS0.Px1.p4" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px1.p4.1" class="ltx_p">which proves <a href="#S3.Ex5" title="Theorem 2 (Variance of Denoising Score Matching Target with Noisy Data is Larger). ‣ 3.3 Denoising Score Matching with Noisy Data ‣ 3 DDPO Is Secretly Doing Score Matching ‣ Advantage Weighted Matching: Aligning RL with Pretraining in Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">2</span></a> and the trace statement.</p>
</div>
</section>
<section id="A2.SS3.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Auxiliary Lemma 2 (Monotonicity of <math id="A2.SS3.SSS0.Px2.m1" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>).</h5>

<div id="A2.SS3.SSS0.Px2.p1" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px2.p1.1" class="ltx_p">For fixed <math id="A2.SS3.SSS0.Px2.p1.m1" class="ltx_Math" alttext="t\in(0,1]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in(0,1]</annotation></semantics></math>, <math id="A2.SS3.SSS0.Px2.p1.m2" class="ltx_Math" alttext="s\mapsto\kappa(s,t)" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo stretchy="false">↦</mo><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s\mapsto\kappa(s,t)</annotation></semantics></math> in <a href="#A2.E29" title="In Theorem 2 (Detailed version of in the main body). ‣ B.3 Proof of ‣ Appendix B Proofs ‣ Advantage Weighted Matching: Aligning RL with Pretraining in Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">29</span></a> is strictly increasing on <math id="A2.SS3.SSS0.Px2.p1.m3" class="ltx_Math" alttext="[0,t)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">[0,t)</annotation></semantics></math>, with <math id="A2.SS3.SSS0.Px2.p1.m4" class="ltx_Math" alttext="\kappa(0,t)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\kappa(0,t)=0</annotation></semantics></math> and <math id="A2.SS3.SSS0.Px2.p1.m5" class="ltx_Math" alttext="\kappa(s,t)\to\infty" display="inline" intent=":literal"><semantics><mrow><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\kappa(s,t)\to\infty</annotation></semantics></math> as <math id="A2.SS3.SSS0.Px2.p1.m6" class="ltx_Math" alttext="s\uparrow t" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo stretchy="false">↑</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">s\uparrow t</annotation></semantics></math>.</p>
</div>
<div id="A2.SS3.SSS0.Px2.p2" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px2.p2.1" class="ltx_p"><em id="A2.SS3.SSS0.Px2.p2.1.1" class="ltx_emph ltx_font_italic">Proof of Aux. Lemma 2.</em>
Using <a href="#A2.E27" title="In Theorem 2 (Detailed version of in the main body). ‣ B.3 Proof of ‣ Appendix B Proofs ‣ Advantage Weighted Matching: Aligning RL with Pretraining in Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">27</span></a>, write
<math id="A2.SS3.SSS0.Px2.p2.m1" class="ltx_Math" alttext="\kappa(s,t)=\frac{q(s)}{t^{2}\big(t^{2}-q(s)\big)}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msup><mi>t</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.710em" minsize="1.710em">(</mo><mrow><msup><mi>t</mi><mn>2</mn></msup><mo>−</mo><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.710em" minsize="1.710em">)</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">\kappa(s,t)=\frac{q(s)}{t^{2}\big(t^{2}-q(s)\big)}</annotation></semantics></math>
with
<math id="A2.SS3.SSS0.Px2.p2.m2" class="ltx_Math" alttext="q(s)\coloneqq\alpha^{2}(t,s)s^{2}=\frac{(1-t)^{2}s^{2}}{(1-s)^{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mn>2</mn></msup></mrow><mo>=</mo><mfrac><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mn>2</mn></msup></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">q(s)\coloneqq\alpha^{2}(t,s)s^{2}=\frac{(1-t)^{2}s^{2}}{(1-s)^{2}}.</annotation></semantics></math>
On <math id="A2.SS3.SSS0.Px2.p2.m3" class="ltx_Math" alttext="[0,t)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">[0,t)</annotation></semantics></math>, <math id="A2.SS3.SSS0.Px2.p2.m4" class="ltx_Math" alttext="q(s)" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q(s)</annotation></semantics></math> is strictly increasing and takes values in <math id="A2.SS3.SSS0.Px2.p2.m5" class="ltx_Math" alttext="[0,t^{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><msup><mi>t</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">[0,t^{2})</annotation></semantics></math>, while
<math id="A2.SS3.SSS0.Px2.p2.m6" class="ltx_Math" alttext="q\mapsto\frac{q}{t^{2}(t^{2}-q)}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo stretchy="false">↦</mo><mfrac><mi>q</mi><mrow><msup><mi>t</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>t</mi><mn>2</mn></msup><mo>−</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">q\mapsto\frac{q}{t^{2}(t^{2}-q)}</annotation></semantics></math> is strictly increasing on <math id="A2.SS3.SSS0.Px2.p2.m7" class="ltx_Math" alttext="[0,t^{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><msup><mi>t</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">[0,t^{2})</annotation></semantics></math>. Limits follow from <math id="A2.SS3.SSS0.Px2.p2.m8" class="ltx_Math" alttext="q(0)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">q(0)=0</annotation></semantics></math> and <math id="A2.SS3.SSS0.Px2.p2.m9" class="ltx_Math" alttext="q(s)\uparrow t^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">↑</mo><msup><mi>t</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">q(s)\uparrow t^{2}</annotation></semantics></math> as <math id="A2.SS3.SSS0.Px2.p2.m10" class="ltx_Math" alttext="s\uparrow t" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo stretchy="false">↑</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">s\uparrow t</annotation></semantics></math>.
 <math id="A2.SS3.SSS0.Px2.p2.m11" class="ltx_Math" alttext="\square" display="inline" intent=":literal"><semantics><mi mathvariant="normal">□</mi><annotation encoding="application/x-tex">\square</annotation></semantics></math></p>
</div>
<div id="A2.SS3.SSS0.Px2.p3" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px2.p3.1" class="ltx_p">For any <math id="A2.SS3.SSS0.Px2.p3.m1" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>,</p>
<table id="A2.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex21.m1" class="ltx_Math" alttext="\mathbb{E}\!\Big[\big\|a-\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})\big\|^{2}\,\Big|\,{\bm{x}}_{t}\Big]=\Big\|a-\mathbb{E}\!\big[\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})|{\bm{x}}_{t}\big]\Big\|^{2}+\operatorname{Tr}\operatorname{Cov}\!\left(\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})\,\middle|\,{\bm{x}}_{t}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><msup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mi>a</mi><mo>−</mo><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>2</mn></msup><mo fence="false" maxsize="1.600em" minsize="1.600em" rspace="0.337em" stretchy="true">|</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mi>a</mi><mo>−</mo><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow><mi>Tr</mi><mo lspace="0.167em">⁡</mo><mrow><mpadded style="width:1.622em;" width="1.622em"><mi>Cov</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\!\Big[\big\|a-\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})\big\|^{2}\,\Big|\,{\bm{x}}_{t}\Big]=\Big\|a-\mathbb{E}\!\big[\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})|{\bm{x}}_{t}\big]\Big\|^{2}+\operatorname{Tr}\operatorname{Cov}\!\left(\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})\,\middle|\,{\bm{x}}_{t}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS0.Px2.p3.2" class="ltx_p">Insert unbiasedness and <a href="#A2.E28" title="In Theorem 2 (Detailed version of in the main body). ‣ B.3 Proof of ‣ Appendix B Proofs ‣ Advantage Weighted Matching: Aligning RL with Pretraining in Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">28</span></a>, then subtract the same identity with <math id="A2.SS3.SSS0.Px2.p3.m2" class="ltx_Math" alttext="s=0" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">s=0</annotation></semantics></math> to obtain the increment <math id="A2.SS3.SSS0.Px2.p3.m3" class="ltx_Math" alttext="d\,\kappa(s,t)" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">d\,\kappa(s,t)</annotation></semantics></math>.</p>
</div>
<div id="A2.SS3.SSS0.Px2.p4" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px2.p4.1" class="ltx_p">To prove <a href="#A2.E31" title="In Theorem 2 (Detailed version of in the main body). ‣ B.3 Proof of ‣ Appendix B Proofs ‣ Advantage Weighted Matching: Aligning RL with Pretraining in Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">31</span></a>,
let <math id="A2.SS3.SSS0.Px2.p4.m1" class="ltx_Math" alttext="\bm{\delta}({\bm{x}}_{0})\coloneqq a-\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{0})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝜹</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><mi>a</mi><mo>−</mo><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\delta}({\bm{x}}_{0})\coloneqq a-\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{0})</annotation></semantics></math>.
From <a href="#A2.E33" title="In Auxiliary Lemma 1 ‣ B.3 Proof of ‣ Appendix B Proofs ‣ Advantage Weighted Matching: Aligning RL with Pretraining in Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">33</span></a>,</p>
<table id="A2.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex22.m1" class="ltx_Math" alttext="\big\|a-\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})\big\|^{2}=\|\bm{\delta}-\bm{\eta}\|^{2}=\|\bm{\delta}\|^{2}+\|\bm{\eta}\|^{2}-2\langle\bm{\delta},\bm{\eta}\rangle." display="block" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mi>a</mi><mo>−</mo><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>2</mn></msup><mo>=</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mi>𝜹</mi><mo>−</mo><mi>𝜼</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>=</mo><mrow><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>𝜹</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝜼</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><mi>𝜹</mi><mo>,</mo><mi>𝜼</mi></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\big\|a-\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})\big\|^{2}=\|\bm{\delta}-\bm{\eta}\|^{2}=\|\bm{\delta}\|^{2}+\|\bm{\eta}\|^{2}-2\langle\bm{\delta},\bm{\eta}\rangle.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS0.Px2.p4.2" class="ltx_p">Conditioned on <math id="A2.SS3.SSS0.Px2.p4.m2" class="ltx_Math" alttext="({\bm{x}}_{t},{\bm{x}}_{0})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\bm{x}}_{t},{\bm{x}}_{0})</annotation></semantics></math>, <math id="A2.SS3.SSS0.Px2.p4.m3" class="ltx_Math" alttext="\bm{\eta}\sim\mathcal{N}(\mathbf{0},\kappa I)" display="inline" intent=":literal"><semantics><mrow><mi>𝜼</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>𝟎</mn><mo>,</mo><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\eta}\sim\mathcal{N}(\mathbf{0},\kappa I)</annotation></semantics></math> is independent of <math id="A2.SS3.SSS0.Px2.p4.m4" class="ltx_Math" alttext="\bm{\delta}" display="inline" intent=":literal"><semantics><mi>𝜹</mi><annotation encoding="application/x-tex">\bm{\delta}</annotation></semantics></math>.
Gaussian moment identities yield, coordinatewise,</p>
<table id="A2.Ex23" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex23X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex23X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\|\bm{\eta}\|^{2}|{\bm{x}}_{t},{\bm{x}}_{0}]=d\,\kappa,\quad\mathrm{Var}(\|\bm{\eta}\|^{2}|{\bm{x}}_{t},{\bm{x}}_{0})=2d\,\kappa^{2},\quad" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo stretchy="false">[</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝜼</mi><mo lspace="0em" rspace="0.167em">∥</mo><msup><mrow></mrow><mn>2</mn></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><msub><mrow></mrow><mi>t</mi></msub><mo>,</mo><mi>𝒙</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">]</mo><mo>=</mo><mi>d</mi><mi>κ</mi><mo rspace="1.167em">,</mo><mi>Var</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝜼</mi><mo lspace="0em" rspace="0.167em">∥</mo><msup><mrow></mrow><mn>2</mn></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><msub><mrow></mrow><mi>t</mi></msub><mo>,</mo><mi>𝒙</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo>=</mo><mn>2</mn><mi>d</mi><mi>κ</mi><msup><mrow></mrow><mn>2</mn></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\|\bm{\eta}\|^{2}|{\bm{x}}_{t},{\bm{x}}_{0}]=d\,\kappa,\quad\mathrm{Var}(\|\bm{\eta}\|^{2}|{\bm{x}}_{t},{\bm{x}}_{0})=2d\,\kappa^{2},\quad</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex23Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex23Xa.m2" class="ltx_Math" alttext="\displaystyle\mathrm{Var}(\langle\bm{\delta},\bm{\eta}\rangle|{\bm{x}}_{t},{\bm{x}}_{0})=\kappa\,\|\bm{\delta}\|^{2},\quad\mathrm{Cov}(\|\bm{\eta}\|^{2},\langle\bm{\delta},\bm{\eta}\rangle|{\bm{x}}_{t},{\bm{x}}_{0})=0." display="inline" intent=":literal"><semantics><mrow><mi>Var</mi><mo stretchy="false">(</mo><mo stretchy="false">⟨</mo><mi>𝜹</mi><mo>,</mo><mi>𝜼</mi><mo stretchy="false">⟩</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><msub><mrow></mrow><mi>t</mi></msub><mo>,</mo><mi>𝒙</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo>=</mo><mi>κ</mi><mo lspace="0.170em" rspace="0.167em">∥</mo><mi>𝜹</mi><mo lspace="0em" rspace="0.167em">∥</mo><msup><mrow></mrow><mn>2</mn></msup><mo rspace="1.167em">,</mo><mi>Cov</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝜼</mi><mo lspace="0em" rspace="0.167em">∥</mo><msup><mrow></mrow><mn>2</mn></msup><mo>,</mo><mo stretchy="false">⟨</mo><mi>𝜹</mi><mo>,</mo><mi>𝜼</mi><mo stretchy="false">⟩</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><msub><mrow></mrow><mi>t</mi></msub><mo>,</mo><mi>𝒙</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo>=</mo><mn>0</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{Var}(\langle\bm{\delta},\bm{\eta}\rangle|{\bm{x}}_{t},{\bm{x}}_{0})=\kappa\,\|\bm{\delta}\|^{2},\quad\mathrm{Cov}(\|\bm{\eta}\|^{2},\langle\bm{\delta},\bm{\eta}\rangle|{\bm{x}}_{t},{\bm{x}}_{0})=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS0.Px2.p4.3" class="ltx_p">Therefore,</p>
<table id="A2.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex24.m1" class="ltx_Math" alttext="\mathrm{Var}\!\Big(\big\|a-\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})\big\|^{2}\,\Big|\,{\bm{x}}_{t},{\bm{x}}_{0}\Big)=\mathrm{Var}\!\big(\|\bm{\eta}\|^{2}-2\langle\bm{\delta},\bm{\eta}\rangle|{\bm{x}}_{t},{\bm{x}}_{0}\big)=2d\,\kappa^{2}+4\kappa\,\|\bm{\delta}\|^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mi>a</mi><mo>−</mo><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" mathsize="1.600em" rspace="0.170em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝒙</mi><mn>0</mn></msub></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>=</mo><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>𝜼</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><mi>𝜹</mi><mo>,</mo><mi>𝜼</mi></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝒙</mi><mn>0</mn></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝜹</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Var}\!\Big(\big\|a-\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})\big\|^{2}\,\Big|\,{\bm{x}}_{t},{\bm{x}}_{0}\Big)=\mathrm{Var}\!\big(\|\bm{\eta}\|^{2}-2\langle\bm{\delta},\bm{\eta}\rangle|{\bm{x}}_{t},{\bm{x}}_{0}\big)=2d\,\kappa^{2}+4\kappa\,\|\bm{\delta}\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS0.Px2.p4.4" class="ltx_p">Law of total variance yields <a href="#A2.E31" title="In Theorem 2 (Detailed version of in the main body). ‣ B.3 Proof of ‣ Appendix B Proofs ‣ Advantage Weighted Matching: Aligning RL with Pretraining in Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">31</span></a>.
Monotonicity in <math id="A2.SS3.SSS0.Px2.p4.m5" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> follows from Aux. Lemma 2; strictness for <math id="A2.SS3.SSS0.Px2.p4.m6" class="ltx_Math" alttext="s\in(0,t)" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s\in(0,t)</annotation></semantics></math> follows since <math id="A2.SS3.SSS0.Px2.p4.m7" class="ltx_Math" alttext="\kappa(s,t)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\kappa(s,t)&gt;0</annotation></semantics></math>.
∎</p>
