hy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{\bm{\theta}}\mathbb{E}_{{\bm{x}}_{t}}\left[\left\|{\bm{s}}_{\bm{\theta}}({\bm{x}}_{t},t)\right\|^{2}\right]-2\nabla_{\bm{\theta}}\int_{{\bm{x}}_{t}}\int_{{\bm{x}}_{s}}\langle{\bm{s}}_{\bm{\theta}}({\bm{x}}_{t},t),\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}}_{s})\rangle p({\bm{x}}_{t}|{\bm{x}}_{s})p({\bm{x}}_{s})\mathrm{d}{\bm{x}}_{s}\mathrm{d}{\bm{x}}_{t}</annotation></semantics></math></td>
