<td id="A4.T7.6.15.5" class="ltx_td ltx_align_center"><span id="A4.T7.6.15.5.1" class="ltx_text" style="font-size:90%;">83.59</span></td>
<td id="A4.T7.6.15.6" class="ltx_td ltx_align_center"><span id="A4.T7.6.15.6.1" class="ltx_text" style="font-size:90%;">5.98</span></td>
<td id="A4.T7.6.15.7" class="ltx_td ltx_align_center"><span id="A4.T7.6.15.7.1" class="ltx_text" style="font-size:90%;">74.55</span></td></tr>
<tr id="A4.T7.6.16" class="ltx_tr">
<td id="A4.T7.6.16.1" class="ltx_td ltx_align_left"><span id="A4.T7.6.16.1.1" class="ltx_text ltx_font_typewriter ltx_font_bold" style="font-size:90%;">MemGen</span><span id="A4.T7.6.16.1.2" class="ltx_text" style="font-size:90%;"> <sub id="A4.T7.6.16.1.2.1" class="ltx_sub">SFT</sub></span></td>
<td id="A4.T7.6.16.2" class="ltx_td ltx_align_center"><span id="A4.T7.6.16.2.1" class="ltx_text" style="font-size:90%;">7.56</span></td>
<td id="A4.T7.6.16.3" class="ltx_td ltx_align_center"><span id="A4.T7.6.16.3.1" class="ltx_text" style="font-size:90%;">66.15</span></td>
<td id="A4.T7.6.16.4" class="ltx_td ltx_align_center"><span id="A4.T7.6.16.4.1" class="ltx_text" style="font-size:90%;">20.08</span></td>
<td id="A4.T7.6.16.5" class="ltx_td ltx_align_center"><span id="A4.T7.6.16.5.1" class="ltx_text" style="font-size:90%;">85.82</span></td>
