<span id="lstnumberx225" class="ltx_listingline"><span id="lstnumberx225.1" class="ltx_text ltx_font_typewriter ltx_font_bold" style="font-size:70%;--ltx-fg-color:#0000FF;">[-login.]</span><span id="lstnumberx225.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">There</span><span id="lstnumberx225.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx225.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">were</span><span id="lstnumberx225.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx225.6" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">175</span><span id="lstnumberx225.7" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx225.8" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">+</span><span id="lstnumberx225.9" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx225.10" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">140</span><span id="lstnumberx225.11" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx225.12" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">+</span><span id="lstnumberx225.13" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx225.14" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">280</span><span id="lstnumberx225.15" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx225.16" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">=</span><span id="lstnumberx225.17" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx225.18" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">&lt;&lt;175+140+280=595&gt;&gt;595</span><span id="lstnumberx225.19" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx225.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">gems</span><span id="lstnumberx225.21" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx225.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">in</span><span id="lstnumberx225.23" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx225.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">the</span><span id="lstnumberx225.25" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx225.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">chest</span><span id="lstnumberx225.27" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">.</span>
