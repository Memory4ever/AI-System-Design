<td id="A4.T5.4.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.9pt 10.0pt;"><span id="A4.T5.4.2.4.1" class="ltx_text" style="font-size:90%;">63.55</span></td></tr>
