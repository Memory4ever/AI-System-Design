<tr id="A4.T7.6.17" class="ltx_tr">
<td id="A4.T7.6.17.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="A4.T7.6.17.1.1" class="ltx_text" style="font-size:90%;">Improvement over Vanilla</span></td>
<td id="A4.T7.6.17.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="A4.T7.6.17.2.1" class="ltx_text" style="font-size:90%;">-</span></td>
<td id="A4.T7.6.17.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="A4.T7.6.17.3.1" class="ltx_text" style="font-size:90%;">+17.05</span></td>
