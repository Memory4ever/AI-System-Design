<tr id="S4.T3.2.3" class="ltx_tr" style="--ltx-bg-color:#E6E6E6;">
<td id="S4.T3.2.3.1" class="ltx_td ltx_nopad_l ltx_align_left ltx_border_t" style="padding-left:1.5pt;padding-right:1.5pt;" colspan="3"><span id="S4.T3.2.3.1.1" class="ltx_text ltx_font_bold">Methods with comparable (<math id="S4.T3.m2" class="ltx_math_unparsed" alttext="2\times" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-bg-color:#E6E6E6;" mathbackground="#E6E6E6">2</mn><mo style="--ltx-bg-color:#E6E6E6;" lspace="0.222em" mathbackground="#E6E6E6">×</mo></mrow><annotation encoding="application/x-tex">2\times</annotation></semantics></math>) inference FLOPs</span></td>
<td id="S4.T3.2.3.2" class="ltx_td ltx_border_t" style="padding-left:1.5pt;padding-right:1.5pt;"></td>
