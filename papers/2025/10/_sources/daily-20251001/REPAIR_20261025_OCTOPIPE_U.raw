{"data":{"id":"10.48550/arxiv.2509.23722","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.23722","prefix":"10.48550","suffix":"arxiv.2509.23722","identifiers":[{"identifier":"2509.23722","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.23722"}],"creators":[{"name":"Guo, Jihu","nameType":"Personal","givenName":"Jihu","familyName":"Guo","affiliation":[],"nameIdentifiers":[]},{"name":"Ma, Tenghui","nameType":"Personal","givenName":"Tenghui","familyName":"Ma","affiliation":[],"nameIdentifiers":[]},{"name":"Gao, Wei","nameType":"Personal","givenName":"Wei","familyName":"Gao","affiliation":[],"nameIdentifiers":[]},{"name":"Sun, Peng","nameType":"Personal","givenName":"Peng","familyName":"Sun","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Xun","nameType":"Personal","givenName":"Xun","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Jiaxing","nameType":"Personal","givenName":"Jiaxing","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Ye, Zhisheng","nameType":"Personal","givenName":"Zhisheng","familyName":"Ye","affiliation":[],"nameIdentifiers":[]},{"name":"Jin, Yuyang","nameType":"Personal","givenName":"Yuyang","familyName":"Jin","affiliation":[],"nameIdentifiers":[]},{"name":"Lin, Dahua","nameType":"Personal","givenName":"Dahua","familyName":"Lin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"OctoPipe: Reducing Pipeline Bubbles for Heterogeneous Models via Co-Optimizing Partitioning, Placement, and Scheduling"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-28T08:05:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-30T01:00:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-03T02:44:15Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-07T00:17:27Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-09-02T03:07:45Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-09-03T00:22:40Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Pipeline parallelism is widely used to train large language models (LLMs). However, increasing heterogeneity in model architectures exacerbates pipeline bubbles, thereby reducing training efficiency. Prior approaches typically optimize a single phase of the pipeline schedule (i.e., partitioning, placement, or scheduling), leaving substantial pipeline bubbles. While promising, co-optimization poses three key challenges: (1) complex performance modeling, (2) a combinatorial search space, and (3) irregular execution orders. To address these challenges, we propose OctoPipe, a pipeline parallelism system to jointly optimize partitioning, placement, and scheduling. First, we build a graph-based pipeline simulator to model heterogeneous pipeline execution for co-optimization. Second, on top of the simulator, we develop an iterative bubble-aware tuner to efficiently explore the combinatorial search space. Third, we implement a unified pipeline executor that dynamically orchestrates computation and communication to support irregular execution orders without deadlocks while maximizing communication-computation overlap. Experiments show that OctoPipe achieves 1.09--1.49$\\times$ throughput improvement over the state-of-the-art pipeline parallelism approaches across various heterogeneous model configurations and GPU cluster scales.","descriptionType":"Abstract"},{"description":"14 pages, 13 Figures; Accepted by SC'26;","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.23722","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-30T03:58:59.000Z","registered":"2025-09-30T03:58:59.000Z","published":"2025","updated":"2026-09-03T02:35:14.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.23722","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}