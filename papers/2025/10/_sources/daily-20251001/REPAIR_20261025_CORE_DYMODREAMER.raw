<td id="A5.T2.5.1.3.6" class="ltx_td ltx_align_right ltx_border_r ltx_border_tt">744</td>
<td id="A5.T2.5.1.3.7" class="ltx_td ltx_align_right ltx_border_tt"><span id="A5.T2.5.1.3.7.1" class="ltx_text ltx_font_bold">1118</span></td>
<td id="A5.T2.5.1.3.8" class="ltx_td ltx_align_right ltx_border_tt">890</td>
<td id="A5.T2.5.1.3.9" class="ltx_td ltx_align_right ltx_border_tt">971</td></tr>
<tr id="A5.T2.5.1.4" class="ltx_tr">
<td id="A5.T2.5.1.4.1" class="ltx_td ltx_align_left">Amidar</td>
<td id="A5.T2.5.1.4.2" class="ltx_td ltx_align_right">6</td>
<td id="A5.T2.5.1.4.3" class="ltx_td ltx_align_right ltx_border_r">1720</td>
<td id="A5.T2.5.1.4.4" class="ltx_td ltx_align_right">205</td>
<td id="A5.T2.5.1.4.5" class="ltx_td ltx_align_right">163</td>
<td id="A5.T2.5.1.4.6" class="ltx_td ltx_align_right ltx_border_r"><span id="A5.T2.5.1.4.6.1" class="ltx_text ltx_font_bold">226</span></td>
<td id="A5.T2.5.1.4.7" class="ltx_td ltx_align_right">97</td>
<td id="A5.T2.5.1.4.8" class="ltx_td ltx_align_right">141</td>
<td id="A5.T2.5.1.4.9" class="ltx_td ltx_align_right">154.2</td></tr>
<tr id="A5.T2.5.1.5" class="ltx_tr">
<td id="A5.T2.5.1.5.1" class="ltx_td ltx_align_left">Assault</td>
<td id="A5.T2.5.1.5.2" class="ltx_td ltx_align_right">222</td>
<td id="A5.T2.5.1.5.3" class="ltx_td ltx_align_right ltx_border_r">742</td>
<td id="A5.T2.5.1.5.4" class="ltx_td ltx_align_right">801</td>
<td id="A5.T2.5.1.5.5" class="ltx_td ltx_align_right">1270</td>
<td id="A5.T2.5.1.5.6" class="ltx_td ltx_align_right ltx_border_r"><span id="A5.T2.5.1.5.6.1" class="ltx_text ltx_font_bold">1526</span></td>
