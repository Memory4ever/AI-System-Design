<td id="S3.T2.7.14.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T2.7.14.2.1" class="ltx_text" style="font-size:80%;position:relative; bottom:-1.4pt;"><span class="ltx_inline-block"><svg id="S3.T2.pic53" class="ltx_picture" height="9.53" overflow="visible" version="1.1" viewBox="0 0 9.53 9.53" width="9.53"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,9.53) matrix(1 0 0 -1 0 0) translate(4.77,0) translate(0,4.77)"><path style="stroke:none" d="M 0 0 M 4.77 0 C 4.77 2.63 2.63 4.77 0 4.77 C -2.63 4.77 -4.77 2.63 -4.77 0 C -4.77 -2.63 -2.63 -4.77 0 -4.77 C 2.63 -4.77 4.77 -2.63 4.77 0 Z M 0 0"></path></g></svg></span></span></td>
<td id="S3.T2.7.14.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T2.7.14.3.1" class="ltx_text" style="font-size:80%;position:relative; bottom:-1.4pt;"><span class="ltx_inline-block"><svg id="S3.T2.pic54" class="ltx_picture" height="9.53" overflow="visible" version="1.1" viewBox="0 0 9.53 9.53" width="9.53"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,9.53) matrix(1 0 0 -1 0 0) translate(4.77,0) translate(0,4.77)"><path style="stroke:none" d="M 0 0 M 4.77 0 C 4.77 2.63 2.63 4.77 0 4.77 C -2.63 4.77 -4.77 2.63 -4.77 0 C -4.77 -2.63 -2.63 -4.77 0 -4.77 C 2.63 -4.77 4.77 -2.63 4.77 0 Z M 0 0"></path></g></svg></span></span></td>
