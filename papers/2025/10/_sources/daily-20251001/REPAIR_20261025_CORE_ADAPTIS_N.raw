</div>
<div id="alg1.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
              
              
            <span id="alg1.l14.3" class="ltx_text ltx_font_bold">for</span> each device <math id="alg1.l14.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> <span id="alg1.l14.4" class="ltx_text ltx_font_bold">do</span> <span id="alg1.l14.5" class="ltx_text" style="float:right;"><math id="alg1.l14.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <span id="alg1.l14.5.1" class="ltx_text ltx_font_italic">Workload Scheduling</span>
</span>
</div>
<div id="alg1.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
              
              
              <math id="alg1.l15.m1" class="ltx_Math" alttext="T_{d}\leftarrow C_{d}+\text{BubbleTime}(d)-\text{OverlapTime}(d)" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>d</mi></msub><mo stretchy="false">←</mo><mrow><mrow><msub><mi>C</mi><mi>d</mi></msub><mo>+</mo><mrow><mtext>BubbleTime</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mtext>OverlapTime</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">T_{d}\leftarrow C_{d}+\text{BubbleTime}(d)-\text{OverlapTime}(d)</annotation></semantics></math>

</div>
