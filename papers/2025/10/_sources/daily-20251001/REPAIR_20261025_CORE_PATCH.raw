<td id="A3.T14.2.1.6" class="ltx_td ltx_align_center ltx_border_tt"><span id="A3.T14.2.1.6.1" class="ltx_text ltx_font_bold">Random</span></td></tr>
<tr id="A3.T14.2.2" class="ltx_tr">
<td id="A3.T14.2.2.1" class="ltx_td ltx_align_left ltx_border_t">45%</td>
<td id="A3.T14.2.2.2" class="ltx_td ltx_align_center ltx_border_t">14.80</td>
