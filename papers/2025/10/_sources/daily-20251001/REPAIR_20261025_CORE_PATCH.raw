<td id="S5.T5.8.1.3.3" class="ltx_td ltx_align_center">17.29</td>
<td id="S5.T5.8.1.3.4" class="ltx_td ltx_align_center">17.96</td>
<td id="S5.T5.8.1.3.5" class="ltx_td ltx_align_center ltx_border_r">19.90</td>
