<td id="A3.T14.2.2.4" class="ltx_td ltx_align_center ltx_border_t">14.50</td>
<td id="A3.T14.2.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="A3.T14.2.2.5.1" class="ltx_text ltx_font_bold">14.48</span></td>
<td id="A3.T14.2.2.6" class="ltx_td ltx_align_center ltx_border_t">14.51</td></tr>
