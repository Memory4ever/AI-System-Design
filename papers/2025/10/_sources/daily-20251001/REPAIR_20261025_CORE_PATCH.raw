<td id="S5.T5.8.1.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T5.8.1.2.2.1" class="ltx_text ltx_font_bold">15.06</span></td>
<td id="S5.T5.8.1.2.3" class="ltx_td ltx_align_center ltx_border_t">21.84</td>
<td id="S5.T5.8.1.2.4" class="ltx_td ltx_align_center ltx_border_t">21.83</td>
