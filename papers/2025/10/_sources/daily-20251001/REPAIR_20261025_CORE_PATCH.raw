<td id="A2.T13.4.1.11.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A2.T13.4.1.11.4.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">25.45</span></td>
