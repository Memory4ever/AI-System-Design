</span></span><span id="S5.T5.8.1.1.3.3" class="ltx_text"></span></td>
<td id="S5.T5.8.1.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T5.8.1.1.4.1" class="ltx_text ltx_font_bold">Wanda</span></td>
<td id="S5.T5.8.1.1.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S5.T5.8.1.1.5.1" class="ltx_text ltx_font_bold">Magnitude</span></td>
<td id="S5.T5.8.1.1.6" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T5.8.1.1.6.1" class="ltx_text ltx_font_bold ltx_font_smallcaps">PATCH<math id="S5.T5.m9" class="ltx_Math" alttext="{}^{\text{Joint}}" display="inline" intent=":literal"><semantics><msup><mrow></mrow><mtext>Joint</mtext></msup><annotation encoding="application/x-tex">{}^{\text{Joint}}</annotation></semantics></math></span></td></tr>
<tr id="S5.T5.8.1.2" class="ltx_tr">
