<td id="S5.T1.4.1.2.3" class="ltx_td" style="padding-left:3.0pt;padding-right:3.0pt;"></td>
<td id="S5.T1.4.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T1.4.1.2.4.1" class="ltx_text ltx_font_bold">Acc (% <math id="S5.T1.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>)</span></td>
<td id="S5.T1.4.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T1.4.1.2.5.1" class="ltx_text ltx_font_bold">PPL (<math id="S5.T1.m4" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math>)</span></td>
<td id="S5.T1.4.1.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T1.4.1.2.6.1" class="ltx_text ltx_font_bold">Acc (% <math id="S5.T1.m5" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>)</span></td>
<td id="S5.T1.4.1.2.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T1.4.1.2.7.1" class="ltx_text ltx_font_bold">PPL (<math id="S5.T1.m6" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math>)</span></td>
<td id="S5.T1.4.1.2.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T1.4.1.2.8.1" class="ltx_text ltx_font_bold">Acc (% <math id="S5.T1.m7" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>)</span></td>
<td id="S5.T1.4.1.2.9" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T1.4.1.2.9.1" class="ltx_text ltx_font_bold">PPL (<math id="S5.T1.m8" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math>)</span></td></tr>
<tr id="S5.T1.4.1.3" class="ltx_tr">
<td id="S5.T1.4.1.3.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">0%</td>
<td id="S5.T1.4.1.3.2" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">Dense</td>
<td id="S5.T1.4.1.3.3" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">-</td>
