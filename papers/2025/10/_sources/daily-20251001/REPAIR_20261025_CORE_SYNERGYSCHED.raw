            <math id="algorithm1.m28" class="ltx_Math" alttext="S_{high}\leftarrow S_{mid}-1" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">S</mi><mrow><mi mathsize="0.900em">h</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">g</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">h</mi></mrow></msub><mo mathsize="0.900em" stretchy="false">←</mo><mrow><msub><mi mathsize="0.900em">S</mi><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">d</mi></mrow></msub><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></mrow><annotation encoding="application/x-tex">S_{high}\leftarrow S_{mid}-1</annotation></semantics></math><span id="algorithm1.6.21.6" class="ltx_text" style="font-size:90%;">;</span>
</div>
