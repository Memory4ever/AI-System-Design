><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#A6A6A6;" mathcolor="#A6A6A6">a</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#A6A6A6;" mathcolor="#A6A6A6">t</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#A6A6A6;" mathcolor="#A6A6A6">i</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#A6A6A6;" mathcolor="#A6A6A6">o</mi></mrow></msub><annotation encoding="application/x-tex">\varepsilon_{ratio}</annotation></semantics></math> </span>
