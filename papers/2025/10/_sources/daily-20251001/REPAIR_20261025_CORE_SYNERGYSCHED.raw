            <math id="algorithm1.m34" class="ltx_Math" alttext="\mathcal{A}^{\star}\leftarrow\mathcal{A}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒜</mi><mo mathsize="0.900em">⋆</mo></msup><mo mathsize="0.900em" stretchy="false">←</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒜</mi></mrow><annotation encoding="application/x-tex">\mathcal{A}^{\star}\leftarrow\mathcal{A}</annotation></semantics></math><span id="algorithm1.6.28.5" class="ltx_text" style="font-size:90%;">;</span>
</div>
