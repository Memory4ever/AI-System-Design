              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.8.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#0000FF;">7:</span></span>
            <math id="algorithm1.m13" class="ltx_Math" alttext="\mathcal{A}^{\star}\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒜</mi><mo mathsize="0.900em">⋆</mo></msup><mo mathsize="0.900em" stretchy="false">←</mo><mi mathsize="0.900em" mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\mathcal{A}^{\star}\leftarrow\emptyset</annotation></semantics></math><span id="algorithm1.6.8.2" class="ltx_text" style="font-size:90%;">;</span>
