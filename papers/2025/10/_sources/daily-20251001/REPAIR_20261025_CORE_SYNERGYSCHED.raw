<span id="S7.T2.5.1.1.1.6.2" class="ltx_td ltx_align_center ltx_border_b">8936</span>
<span id="S7.T2.5.1.1.1.6.3" class="ltx_td ltx_align_center ltx_border_b">10171</span>
