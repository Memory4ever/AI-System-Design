            <math id="algorithm1.m12" class="ltx_Math" alttext="T_{\mathrm{adaptive}}\leftarrow\textsc{TargetLatency}\bigl(Q_{i}^{\mathrm{wait}}\cup Q_{i}^{\mathrm{run}},\;\mathrm{SLOs}\bigr)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">T</mi><mi mathsize="0.900em">adaptive</mi></msub><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps" mathsize="0.900em">TargetLatency</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mi mathsize="0.900em">Q</mi><mi mathsize="0.900em">i</mi><mi mathsize="0.900em">wait</mi></msubsup><mo mathsize="0.900em">∪</mo><msubsup><mi mathsize="0.900em">Q</mi><mi mathsize="0.900em">i</mi><mi mathsize="0.900em">run</mi></msubsup></mrow><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">SLOs</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T_{\mathrm{adaptive}}\leftarrow\textsc{TargetLatency}\bigl(Q_{i}^{\mathrm{wait}}\cup Q_{i}^{\mathrm{run}},\;\mathrm{SLOs}\bigr)</annotation></semantics></math><span id="algorithm1.6.7.2" class="ltx_text" style="font-size:90%;">;</span>
</div>
