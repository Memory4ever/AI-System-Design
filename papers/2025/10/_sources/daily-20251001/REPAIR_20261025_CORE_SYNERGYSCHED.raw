            <span id="algorithm1.6.6.4" class="ltx_text ltx_font_bold" style="font-size:90%;">return</span><span id="algorithm1.6.6.5" class="ltx_text" style="font-size:90%;"> </span><math id="algorithm1.m11" class="ltx_Math" alttext="\emptyset" display="inline" intent=":literal"><semantics><mi mathsize="0.900em" mathvariant="normal">∅</mi><annotation encoding="application/x-tex">\emptyset</annotation></semantics></math><span id="algorithm1.6.6.6" class="ltx_text" style="font-size:90%;">;</span>
