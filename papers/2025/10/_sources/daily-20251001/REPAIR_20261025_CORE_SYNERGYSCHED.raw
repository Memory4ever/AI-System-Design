            <math id="algorithm1.m14" class="ltx_Math" alttext="\mathrm{min\_error}\leftarrow\infty" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.900em">min</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">_</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">error</mi></mrow><mo mathsize="0.900em" stretchy="false">←</mo><mi mathsize="0.900em" mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\mathrm{min\_error}\leftarrow\infty</annotation></semantics></math><span id="algorithm1.6.9.2" class="ltx_text" style="font-size:90%;">;</span>
</div>
<div id="algorithm1.6.10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.10.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#0000FF;">9:</span></span>
