              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#0000FF;">3:</span></span>
            <span id="algorithm1.6.5.2" class="ltx_text ltx_font_bold" style="font-size:90%;">if</span><span id="algorithm1.6.5.3" class="ltx_text" style="font-size:90%;"> </span><em id="algorithm1.6.5.4" class="ltx_emph ltx_font_italic" style="font-size:90%;"><math id="algorithm1.m10" class="ltx_Math" alttext="Q_{i}^{\mathrm{wait}}=\emptyset\land Q_{i}^{\mathrm{run}}=\emptyset" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Q</mi><mi>i</mi><mi>wait</mi></msubsup><mo>=</mo><mrow><mi mathvariant="normal">∅</mi><mo>∧</mo><msubsup><mi>Q</mi><mi>i</mi><mi>run</mi></msubsup></mrow><mo>=</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">Q_{i}^{\mathrm{wait}}=\emptyset\land Q_{i}^{\mathrm{run}}=\emptyset</annotation></semantics></math></em><span id="algorithm1.6.5.5" class="ltx_text" style="font-size:90%;"> </span><span id="algorithm1.6.5.6" class="ltx_text ltx_font_bold" style="font-size:90%;">then</span>
