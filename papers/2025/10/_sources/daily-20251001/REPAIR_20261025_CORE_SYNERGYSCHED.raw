<span id="S7.T2.5.1.1.1.4" class="ltx_tr">
<span id="S7.T2.5.1.1.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">Coding</span>
<span id="S7.T2.5.1.1.1.4.2" class="ltx_td ltx_align_center">440</span>
<span id="S7.T2.5.1.1.1.4.3" class="ltx_td ltx_align_center">1131</span>
<span id="S7.T2.5.1.1.1.4.4" class="ltx_td ltx_align_center ltx_border_r">214</span>
