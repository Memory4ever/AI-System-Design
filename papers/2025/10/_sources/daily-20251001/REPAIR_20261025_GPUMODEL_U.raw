{"data":{"id":"10.48550/arxiv.2509.22832","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.22832","prefix":"10.48550","suffix":"arxiv.2509.22832","identifiers":[{"identifier":"2509.22832","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.22832"}],"creators":[{"name":"Zhang, Biyao","nameType":"Personal","givenName":"Biyao","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Zheng, Mingkai","nameType":"Personal","givenName":"Mingkai","familyName":"Zheng","affiliation":[],"nameIdentifiers":[]},{"name":"Ganguly, Debargha","nameType":"Personal","givenName":"Debargha","familyName":"Ganguly","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Xuecen","nameType":"Personal","givenName":"Xuecen","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Singh, Vikash","nameType":"Personal","givenName":"Vikash","familyName":"Singh","affiliation":[],"nameIdentifiers":[]},{"name":"Chaudhary, Vipin","nameType":"Personal","givenName":"Vipin","familyName":"Chaudhary","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Zhao","nameType":"Personal","givenName":"Zhao","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Efficient Fine-Grained GPU Performance Modeling for Distributed Deep Learning of LLM"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-26T18:38:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-30T00:05:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Training Large Language Models(LLMs) is one of the most compute-intensive tasks in high-performance computing. Predicting end-to-end training time for multi-billion parameter models distributed across hundreds of GPUs remains challenging due to complex interactions between transformer components, parallelism strategies(data, model, pipeline, tensor), and multi-tier communication. Learned models require costly sampling, while analytical models often struggle with real-world network and hardware complexities. We address this by decomposing LLMs into core computational primitives and modeling them with: (1) operator-level decomposition for fine-grained analysis; (2) lightweight sampling based hardware-aware prediction models for key operations; (3) an end-to-end prediction system integrating these components across complex parallelization strategies. Crucially, our methodology has been validated on two large-scale HPC systems. Our framework achieves low average prediction errors-4.98\\% on Perlmutter(A100) and 9.38\\% on Vista(GH200)-for models up to 20B parameters across 128 GPUs. Importantly, it runs entirely on CPUs, enabling rapid iteration over hardware configurations and training strategies without costly on-cluster experimentation.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.22832","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-30T03:32:42.000Z","registered":"2025-09-30T03:32:42.000Z","published":"2025","updated":"2025-09-30T03:32:42.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.22832","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}