<div id="A1.T1.2.1.9.1" class="ltx_inline-block ltx_transformed_outer" style="width:22.4pt;height:20.4pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:23.5pt;transform:translate(-0.5pt,-6.8pt) rotate(-40deg) ;">
