<td id="A1.T3.2.4.2" class="ltx_td ltx_align_center"><span id="A1.T3.2.4.2.1" class="ltx_text ltx_font_typewriter">sprint</span>, <span id="A1.T3.2.4.2.2" class="ltx_text ltx_font_typewriter">sneak</span>, <span id="A1.T3.2.4.2.3" class="ltx_text ltx_font_typewriter">null</span></td></tr>
