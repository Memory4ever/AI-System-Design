<td id="A1.T5.2.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">2730</td>
<td id="A1.T5.2.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">16</td>
<td id="A1.T5.2.2.5" class="ltx_td ltx_align_center ltx_border_t">16</td></tr>
<tr id="A1.T5.2.3" class="ltx_tr">
<td id="A1.T5.2.3.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_r">774M</td>
<td id="A1.T5.2.3.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r">1536</td>
<td id="A1.T5.2.3.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r">4096</td>
<td id="A1.T5.2.3.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r">24</td>
