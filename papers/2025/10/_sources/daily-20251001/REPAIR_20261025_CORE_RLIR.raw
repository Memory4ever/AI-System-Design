<td id="S6.T2.1.1.7.5" class="ltx_td ltx_align_center" style="--ltx-bg-color:#EAFAEA;"><span id="S6.T2.1.1.7.5.1" class="ltx_text" style="--ltx-bg-color:#EAFAEA;">0.645</span></td></tr>
