<td id="S5.T1.2.1.11.1" class="ltx_td ltx_align_left ltx_border_r" style="--ltx-bg-color:#E6F2FF;"><span id="S5.T1.2.1.11.1.1" class="ltx_text" style="--ltx-bg-color:#E6F2FF;">w/ RLIR</span></td>
<td id="S5.T1.2.1.11.2" class="ltx_td ltx_align_center" style="--ltx-bg-color:#E6F2FF;"><span id="S5.T1.2.1.11.2.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6F2FF;">0.83</span></td>
<td id="S5.T1.2.1.11.3" class="ltx_td ltx_align_center" style="--ltx-bg-color:#E6F2FF;"><span id="S5.T1.2.1.11.3.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6F2FF;">0.83</span></td>
<td id="S5.T1.2.1.11.4" class="ltx_td ltx_align_center" style="--ltx-bg-color:#E6F2FF;"><span id="S5.T1.2.1.11.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6F2FF;">0.85</span></td>
<td id="S5.T1.2.1.11.5" class="ltx_td ltx_align_center" style="--ltx-bg-color:#E6F2FF;"><span id="S5.T1.2.1.11.5.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6F2FF;">180</span></td>
<td id="S5.T1.2.1.11.6" class="ltx_td ltx_align_center" style="--ltx-bg-color:#E6F2FF;"><span id="S5.T1.2.1.11.6.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6F2FF;">17.48</span></td>
<td id="S5.T1.2.1.11.7" class="ltx_td ltx_align_center" style="--ltx-bg-color:#E6F2FF;"><span id="S5.T1.2.1.11.7.1" class="ltx_text" style="--ltx-bg-color:#E6F2FF;">0.688</span></td>
<td id="S5.T1.2.1.11.8" class="ltx_td ltx_align_center" style="--ltx-bg-color:#E6F2FF;"><span id="S5.T1.2.1.11.8.1" class="ltx_text" style="--ltx-bg-color:#E6F2FF;">1.00</span></td></tr>
<tr id="S5.T1.2.1.12" class="ltx_tr">
<td id="S5.T1.2.1.12.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S5.T1.2.1.12.1.1" class="ltx_text ltx_font_bold">GT</span></td>
<td id="S5.T1.2.1.12.2" class="ltx_td ltx_align_left ltx_border_bb ltx_border_r ltx_border_t">———–</td>
<td id="S5.T1.2.1.12.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">0.87</td>
<td id="S5.T1.2.1.12.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">0.86</td>
<td id="S5.T1.2.1.12.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">0.88</td>
