<td id="A1.T4.2.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="A1.T4.2.1.2.1" class="ltx_text ltx_font_bold">Hidden Dim.</span></td>
<td id="A1.T4.2.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="A1.T4.2.1.3.1" class="ltx_text ltx_font_bold">MLP Dim.</span></td>
<td id="A1.T4.2.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="A1.T4.2.1.4.1" class="ltx_text ltx_font_bold">Num. Heads</span></td>
