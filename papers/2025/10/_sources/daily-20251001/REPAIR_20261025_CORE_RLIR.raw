<td id="S6.T2.1.1.1.3" class="ltx_td ltx_align_center ltx_border_tt">F1<math id="S6.SS1.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="S6.T2.1.1.1.4" class="ltx_td ltx_align_center ltx_border_tt">FVD<math id="S6.SS1.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td>
<td id="S6.T2.1.1.1.5" class="ltx_td ltx_align_center ltx_border_tt">PSNR<math id="S6.SS1.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="S6.T2.1.1.1.6" class="ltx_td ltx_align_center ltx_border_tt">IQ<math id="S6.SS1.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td></tr>
<tr id="S6.T2.1.1.2" class="ltx_tr">
<td id="S6.T2.1.1.2.1" class="ltx_td ltx_align_center ltx_border_t" rowspan="4"><span id="S6.T2.1.1.2.1.1" class="ltx_text"><span id="S6.T2.1.1.2.1.1.1" class="ltx_text"></span><span id="S6.T2.1.1.2.1.1.2" class="ltx_text ltx_font_bold"> <span id="S6.T2.1.1.2.1.1.2.1" class="ltx_text">
<span id="S6.T2.1.1.2.1.1.2.1.1" class="ltx_tabular ltx_align_middle">
<span id="S6.T2.1.1.2.1.1.2.1.1.1" class="ltx_tr">
<span id="S6.T2.1.1.2.1.1.2.1.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">Mine-</span></span>
<span id="S6.T2.1.1.2.1.1.2.1.1.2" class="ltx_tr">
<span id="S6.T2.1.1.2.1.1.2.1.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">World</span></span>
</span></span><span id="S6.T2.1.1.2.1.1.2.2" class="ltx_text"></span></span></span></td>
<td id="S6.T2.1.1.2.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">Baseline</td>
<td id="S6.T2.1.1.2.3" class="ltx_td ltx_align_center ltx_border_t">0.70</td>
<td id="S6.T2.1.1.2.4" class="ltx_td ltx_align_center ltx_border_t">231</td>
<td id="S6.T2.1.1.2.5" class="ltx_td ltx_align_center ltx_border_t">15.32</td>
<td id="S6.T2.1.1.2.6" class="ltx_td ltx_align_center ltx_border_t">0.677</td></tr>
<tr id="S6.T2.1.1.3" class="ltx_tr">
<td id="S6.T2.1.1.3.1" class="ltx_td ltx_align_left ltx_border_r" style="--ltx-bg-color:#EAFAEA;"><span id="S6.T2.1.1.3.1.1" class="ltx_text" style="--ltx-bg-color:#EAFAEA;">w/ <math id="S6.SS1.m5" class="ltx_Math" alttext="L_{1}+\mathrm{LPIPS}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-bg-color:#EAFAEA;" mathbackground="#EAFAEA">L</mi><mn style="--ltx-bg-color:#EAFAEA;" mathbackground="#EAFAEA">1</mn></msub><mo style="--ltx-bg-color:#EAFAEA;" mathbackground="#EAFAEA">+</mo><mi style="--ltx-bg-color:#EAFAEA;" mathbackground="#EAFAEA">LPIPS</mi></mrow><annotation encoding="application/x-tex">L_{1}+\mathrm{LPIPS}</annotation></semantics></math></span></td>
<td id="S6.T2.1.1.3.2" class="ltx_td ltx_align_center" style="--ltx-bg-color:#EAFAEA;"><span id="S6.T2.1.1.3.2.1" class="ltx_text" style="--ltx-bg-color:#EAFAEA;">0.71</span></td>
<td id="S6.T2.1.1.3.3" class="ltx_td ltx_align_center" style="--ltx-bg-color:#EAFAEA;"><span id="S6.T2.1.1.3.3.1" class="ltx_text" style="--ltx-bg-color:#EAFAEA;">228</span></td>
<td id="S6.T2.1.1.3.4" class="ltx_td ltx_align_center" style="--ltx-bg-color:#EAFAEA;"><span id="S6.T2.1.1.3.4.1" class="ltx_text" style="--ltx-bg-color:#EAFAEA;">15.47</span></td>
<td id="S6.T2.1.1.3.5" class="ltx_td ltx_align_center" style="--ltx-bg-color:#EAFAEA;"><span id="S6.T2.1.1.3.5.1" class="ltx_text" style="--ltx-bg-color:#EAFAEA;">0.673</span></td></tr>
<tr id="S6.T2.1.1.4" class="ltx_tr">
<td id="S6.T2.1.1.4.1" class="ltx_td ltx_align_left ltx_border_r" style="--ltx-bg-color:#FFF0E2;"><span id="S6.T2.1.1.4.1.1" class="ltx_text" style="--ltx-bg-color:#FFF0E2;">w/ VideoAlign</span></td>
