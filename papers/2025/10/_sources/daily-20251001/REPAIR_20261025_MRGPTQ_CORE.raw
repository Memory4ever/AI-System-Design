<td id="S5.T1.2.1.7.5" class="ltx_td ltx_align_center">73.48</td>
<td id="S5.T1.2.1.7.6" class="ltx_td ltx_align_center">74.05</td>
<td id="S5.T1.2.1.7.7" class="ltx_td ltx_align_center">93.82</td></tr>
