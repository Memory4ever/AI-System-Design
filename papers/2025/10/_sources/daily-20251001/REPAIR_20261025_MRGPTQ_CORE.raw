<span id="S5.SS2.p1.p2.1.1.1.1.1.1.1.12.6" class="ltx_td ltx_align_left" style="padding:-0.75pt 4.0pt;"><math id="S5.SS2.p1.p2.m62" class="ltx_Math" alttext="95.2" display="inline" intent=":literal"><semantics><mn>95.2</mn><annotation encoding="application/x-tex">95.2</annotation></semantics></math></span>
<span id="S5.SS2.p1.p2.1.1.1.1.1.1.1.12.7" class="ltx_td ltx_align_left" style="padding:-0.75pt 4.0pt;"><math id="S5.SS2.p1.p2.m63" class="ltx_Math" alttext="97.3" display="inline" intent=":literal"><semantics><mn>97.3</mn><annotation encoding="application/x-tex">97.3</annotation></semantics></math></span>
<span id="S5.SS2.p1.p2.1.1.1.1.1.1.1.12.8" class="ltx_td ltx_align_left" style="padding:-0.75pt 4.0pt;"><math id="S5.SS2.p1.p2.m64" class="ltx_Math" alttext="95.6" display="inline" intent=":literal"><semantics><mn>95.6</mn><annotation encoding="application/x-tex">95.6</annotation></semantics></math></span></span>
<span id="S5.SS2.p1.p2.1.1.1.1.1.1.1.13" class="ltx_tr">
<span id="S5.SS2.p1.p2.1.1.1.1.1.1.1.13.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:-0.75pt 4.0pt;">QAT</span>
<span id="S5.SS2.p1.p2.1.1.1.1.1.1.1.13.2" class="ltx_td ltx_align_left" style="padding:-0.75pt 4.0pt;"><math id="S5.SS2.p1.p2.m65" class="ltx_Math" alttext="68.2" display="inline" intent=":literal"><semantics><mn>68.2</mn><annotation encoding="application/x-tex">68.2</annotation></semantics></math></span>
