<span id="S5.SS2.p1.p2.1.1.1.1.1.1.1.2.4" class="ltx_td ltx_align_left ltx_th ltx_th_column" style="padding:-0.75pt 4.0pt;">3B</span>
<span id="S5.SS2.p1.p2.1.1.1.1.1.1.1.2.5" class="ltx_td ltx_align_left ltx_th ltx_th_column" style="padding:-0.75pt 4.0pt;">8B</span>
<span id="S5.SS2.p1.p2.1.1.1.1.1.1.1.2.6" class="ltx_td ltx_align_left ltx_th ltx_th_column" style="padding:-0.75pt 4.0pt;">70B</span>
<span id="S5.SS2.p1.p2.1.1.1.1.1.1.1.2.7" class="ltx_td ltx_align_left ltx_th ltx_th_column" style="padding:-0.75pt 4.0pt;">8B</span>
<span id="S5.SS2.p1.p2.1.1.1.1.1.1.1.2.8" class="ltx_td ltx_align_left ltx_th ltx_th_column" style="padding:-0.75pt 4.0pt;">14B</span>
