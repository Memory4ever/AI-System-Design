{"data":{"id":"10.48550/arxiv.2509.25140","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.25140","prefix":"10.48550","suffix":"arxiv.2509.25140","identifiers":[{"identifier":"2509.25140","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.25140"}],"creators":[{"name":"Ouyang, Siru","nameType":"Personal","givenName":"Siru","familyName":"Ouyang","affiliation":[],"nameIdentifiers":[]},{"name":"Yan, Jun","nameType":"Personal","givenName":"Jun","familyName":"Yan","affiliation":[],"nameIdentifiers":[]},{"name":"Hsu, I-Hung","nameType":"Personal","givenName":"I-Hung","familyName":"Hsu","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Yanfei","nameType":"Personal","givenName":"Yanfei","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Jiang, Ke","nameType":"Personal","givenName":"Ke","familyName":"Jiang","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Zifeng","nameType":"Personal","givenName":"Zifeng","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Han, Rujun","nameType":"Personal","givenName":"Rujun","familyName":"Han","affiliation":[],"nameIdentifiers":[]},{"name":"Le, Long T.","nameType":"Personal","givenName":"Long T.","familyName":"Le","affiliation":[],"nameIdentifiers":[]},{"name":"Daruki, Samira","nameType":"Personal","givenName":"Samira","familyName":"Daruki","affiliation":[],"nameIdentifiers":[]},{"name":"Tang, Xiangru","nameType":"Personal","givenName":"Xiangru","familyName":"Tang","affiliation":[],"nameIdentifiers":[]},{"name":"Tirumalashetty, Vishy","nameType":"Personal","givenName":"Vishy","familyName":"Tirumalashetty","affiliation":[],"nameIdentifiers":[]},{"name":"Lee, George","nameType":"Personal","givenName":"George","familyName":"Lee","affiliation":[],"nameIdentifiers":[]},{"name":"Rofouei, Mahsan","nameType":"Personal","givenName":"Mahsan","familyName":"Rofouei","affiliation":[],"nameIdentifiers":[]},{"name":"Lin, Hangfei","nameType":"Personal","givenName":"Hangfei","familyName":"Lin","affiliation":[],"nameIdentifiers":[]},{"name":"Han, Jiawei","nameType":"Personal","givenName":"Jiawei","familyName":"Han","affiliation":[],"nameIdentifiers":[]},{"name":"Lee, Chen-Yu","nameType":"Personal","givenName":"Chen-Yu","familyName":"Lee","affiliation":[],"nameIdentifiers":[]},{"name":"Pfister, Tomas","nameType":"Personal","givenName":"Tomas","familyName":"Pfister","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ReasoningBank: Scaling Agent Self-Evolving with Reasoning Memory"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-29T17:51:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-30T02:22:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-16T20:49:28Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-18T00:14:07Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"With the growing adoption of large language model agents in persistent real-world roles, they naturally encounter continuous streams of tasks. A key limitation, however, is their failure to learn from the accumulated interaction history, forcing them to discard valuable insights and repeat past errors. We propose ReasoningBank, a novel memory framework that distills generalizable reasoning strategies from an agent's self-judged successful and failed experiences. At test time, an agent retrieves relevant memories from ReasoningBank to inform its interaction and then integrates new learnings back, enabling it to become more capable over time. Building on this powerful experience learner, we further introduce memory-aware test-time scaling (MaTTS), which accelerates and diversifies this learning process by scaling up the agent's interaction experience. By allocating more compute to each task, the agent generates abundant, diverse experiences that provide rich contrastive signals for synthesizing higher-quality memory. The better memory in turn guides more effective scaling, establishing a powerful synergy between memory and test-time scaling. Across web browsing and software engineering benchmarks, ReasoningBank consistently outperforms existing memory mechanisms that store raw trajectories or only successful task routines, improving both effectiveness and efficiency; MaTTS further amplifies these gains. These findings establish memory-driven experience scaling as a new scaling dimension, enabling agents to self-evolve with emergent behaviors naturally arise. Our code can be found at https://github.com/google-research/reasoning-bank.","descriptionType":"Abstract"},{"description":"Accepted to ICLR 2026; Code: https://github.com/google-research/reasoning-bank","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.25140","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-30T04:33:28.000Z","registered":"2025-09-30T04:33:29.000Z","published":"2025","updated":"2026-03-18T02:49:10.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.25140","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}