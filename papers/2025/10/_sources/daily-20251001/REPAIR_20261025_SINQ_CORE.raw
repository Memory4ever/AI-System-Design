<td id="A1.T6.2.10.7" class="ltx_td ltx_align_center ltx_border_bbbb" style="--ltx-bg-color:#DBEFF9;padding-left:6.5pt;padding-right:6.5pt;"><span id="A1.T6.2.10.7.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#DBEFF9;">68.30</span></td></tr>
