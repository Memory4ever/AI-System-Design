<td id="A1.T9.6.2.2" class="ltx_td ltx_align_left ltx_border_t">HQQ</td>
<td id="A1.T9.6.2.3" class="ltx_td ltx_align_center ltx_border_t">5.38</td></tr>
<tr id="A1.T9.6.3" class="ltx_tr">
<td id="A1.T9.6.3.1" class="ltx_td ltx_border_bbbb"></td>
<td id="A1.T9.6.3.2" class="ltx_td ltx_align_left ltx_border_bbbb" style="--ltx-bg-color:#DBEFF9;"><span id="A1.T9.6.3.2.1" class="ltx_text" style="--ltx-bg-color:#DBEFF9;">SINQ</span></td>
