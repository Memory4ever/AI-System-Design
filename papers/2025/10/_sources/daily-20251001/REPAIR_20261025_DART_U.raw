{"data":{"id":"10.48550/arxiv.2509.23866","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.23866","prefix":"10.48550","suffix":"arxiv.2509.23866","identifiers":[{"identifier":"2509.23866","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.23866"}],"creators":[{"name":"Li, Pengxiang","nameType":"Personal","givenName":"Pengxiang","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Hu, Zechen","nameType":"Personal","givenName":"Zechen","familyName":"Hu","affiliation":[],"nameIdentifiers":[]},{"name":"Shang, Zirui","nameType":"Personal","givenName":"Zirui","familyName":"Shang","affiliation":[],"nameIdentifiers":[]},{"name":"Wu, Jingrong","nameType":"Personal","givenName":"Jingrong","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Yang","nameType":"Personal","givenName":"Yang","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Hui","nameType":"Personal","givenName":"Hui","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Gao, Zhi","nameType":"Personal","givenName":"Zhi","familyName":"Gao","affiliation":[],"nameIdentifiers":[]},{"name":"Shi, Chenrui","nameType":"Personal","givenName":"Chenrui","familyName":"Shi","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Bofei","nameType":"Personal","givenName":"Bofei","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Zihao","nameType":"Personal","givenName":"Zihao","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Shi, Xiaochuan","nameType":"Personal","givenName":"Xiaochuan","familyName":"Shi","affiliation":[],"nameIdentifiers":[]},{"name":"YU, Zedong","nameType":"Personal","givenName":"Zedong","familyName":"YU","affiliation":[],"nameIdentifiers":[]},{"name":"Wu, Yuwei","nameType":"Personal","givenName":"Yuwei","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Wu, Xinxiao","nameType":"Personal","givenName":"Xinxiao","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Jia, Yunde","nameType":"Personal","givenName":"Yunde","familyName":"Jia","affiliation":[],"nameIdentifiers":[]},{"name":"Xiang, Liuyu","nameType":"Personal","givenName":"Liuyu","familyName":"Xiang","affiliation":[],"nameIdentifiers":[]},{"name":"He, Zhaofeng","nameType":"Personal","givenName":"Zhaofeng","familyName":"He","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Qing","nameType":"Personal","givenName":"Qing","familyName":"Li","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Efficient Multi-turn RL for GUI Agents via Decoupled Training and Adaptive Data Curation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-28T13:19:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-30T01:09:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-nc-nd-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Vision-language model (VLM) based GUI agents show promise for automating complex desktop and mobile tasks, but face significant challenges in applying reinforcement learning (RL): (1) slow multi-turn interactions with GUI environments for policy rollout, and (2) insufficient high-quality agent-environment interactions for policy learning. To address these challenges, we propose DART, a Decoupled Agentic RL Training framework for GUI agents, which coordinates heterogeneous modules in a highly decoupled manner. DART separates the training system into four asynchronous modules: environment cluster, rollout service, data manager, and trainer. This design enables non-blocking communication, asynchronous training, rollout-wise trajectory sampling, and per-worker model synchronization, significantly improving the system efficiency: 1.6*GPU utilization for rollout, 1.9* training throughput, and 5.5* environment utilization. To facilitate effective learning from abundant samples, we introduce an adaptive data curation scheme: (1) pre-collecting successful trajectories for challenging tasks to supplement sparse success in online sampling; (2) dynamically adjusting rollout numbers and trajectory lengths based on task difficulty; (3) training selectively on high-entropy steps to prioritize critical decisions; (4) stabilizing learning via truncated importance sampling for policy mismatch between policy rollout and updating. On the OSWorld benchmark, DART-GUI-7B achieves a 42.13% task success rate, a 14.61% absolute gain over the base model, and 7.34% higher than open-source SOTA. We will fully open-source our training framework, data, and model checkpoints via computer-use-agents.github.io/dart-gui, which we believe is a timely contribution to the open-source community of agentic RL training.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.23866","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-30T04:02:33.000Z","registered":"2025-09-30T04:02:33.000Z","published":"2025","updated":"2025-09-30T04:02:33.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.23866","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}