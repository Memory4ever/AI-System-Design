               <math id="alg1.l4.m1" class="ltx_Math" alttext="req\leftarrow" display="inline" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">req\leftarrow</annotation></semantics></math> Dequeue(<math id="alg1.l4.m2" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>) <span id="alg1.l4.3" class="ltx_text" style="float:right;"><math id="alg1.l4.m3" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> First come, first served
</span>
