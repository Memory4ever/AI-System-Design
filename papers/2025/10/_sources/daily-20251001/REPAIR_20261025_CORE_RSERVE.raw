<figure id="S3.F13.sf2" class="ltx_figure ltx_figure_panel"><object type="image/svg+xml" data="2509.24381v1/throughput-2K-mmmu.svg" id="S3.F13.sf2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/135;" width="476" height="135"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F13.sf2.3" class="ltx_text" style="font-size:90%;">(b)</span> </span><span id="S3.F13.sf2.4" class="ltx_text" style="font-size:90%;">Qwen2.5-VL-72B, 2K resolution.</span></figcaption>
