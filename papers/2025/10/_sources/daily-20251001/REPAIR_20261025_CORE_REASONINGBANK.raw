<td id="S5.T4.8.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.5pt;padding-right:4.5pt;"><span id="S5.T4.8.2.6.1" class="ltx_text ltx_font_italic" style="font-size:90%;">Failed</span></td>
