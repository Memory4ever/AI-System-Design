<td id="S5.T4.8.3.9" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.5pt;padding-right:4.5pt;"><span id="S5.T4.8.3.9.1" class="ltx_text" style="font-size:90%;">7.6</span></td></tr>
<tr id="S5.T4.8.4" class="ltx_tr">
<td id="S5.T4.8.4.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding-left:4.5pt;padding-right:4.5pt;"><span id="S5.T4.8.4.1.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">ReasoningBank</span></td>
