<td id="S5.T4.8.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.5pt;padding-right:4.5pt;"><span id="S5.T4.8.3.3.1" class="ltx_text" style="font-size:90%;">8.7</span></td>
<td id="S5.T4.8.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.5pt;padding-right:4.5pt;"><span id="S5.T4.8.3.4.1" class="ltx_text" style="font-size:90%;">8.4</span></td>
<td id="S5.T4.8.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.5pt;padding-right:4.5pt;"><span id="S5.T4.8.3.5.1" class="ltx_text" style="font-size:90%;">10.4</span></td>
