<td id="S5.T4.8.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:4.5pt;padding-right:4.5pt;" colspan="2"><span id="S5.T4.8.1.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Gitlab</span></td>
<td id="S5.T4.8.1.5" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:4.5pt;padding-right:4.5pt;" colspan="2"><span id="S5.T4.8.1.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Reddit</span></td></tr>
