<td id="S5.T2.2.1.4.6" class="ltx_td ltx_align_left" style="padding:-1.25pt 8.0pt;">83.3<span id="S5.T2.2.1.4.6.1" class="ltx_text" style="position:relative; bottom:0.5pt;"><math id="S5.T2.m13" class="ltx_Math" alttext="\blacktriangle" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#FF1A3D;" mathcolor="#FF1A3D" mathvariant="normal">▲</mi><annotation encoding="application/x-tex">\blacktriangle</annotation></semantics></math><math id="S5.T2.m14" class="ltx_Math" alttext="16.6" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#FF1A3D;" mathcolor="#FF1A3D">16.6</mn><annotation encoding="application/x-tex">16.6</annotation></semantics></math></span></td>
<td id="S5.T2.2.1.4.7" class="ltx_td ltx_align_left" style="padding:-1.25pt 8.0pt;">9.5<span id="S5.T2.2.1.4.7.1" class="ltx_text" style="position:relative; bottom:0.5pt;"><math id="S5.T2.m15" class="ltx_Math" alttext="\blacktriangle" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#FF1A3D;" mathcolor="#FF1A3D" mathvariant="normal">▲</mi><annotation encoding="application/x-tex">\blacktriangle</annotation></semantics></math><math id="S5.T2.m16" class="ltx_Math" alttext="4.7" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#FF1A3D;" mathcolor="#FF1A3D">4.7</mn><annotation encoding="application/x-tex">4.7</annotation></semantics></math></span></td>
