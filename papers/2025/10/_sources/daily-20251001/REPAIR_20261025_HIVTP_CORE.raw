              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.3.1" class="ltx_text ltx_font_bold" style="font-size:80%;"> 1.</span></span>
            <span id="algorithm2.6.3.2" class="ltx_text ltx_font_italic" style="font-size:80%;">/* Stage1 Global Retaining */</span><span id="algorithm2.6.3.3" class="ltx_text" style="font-size:80%;"> </span>
