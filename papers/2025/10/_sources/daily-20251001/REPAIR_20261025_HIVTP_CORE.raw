            <span id="algorithm2.6.4.2" class="ltx_text" style="font-size:80%;">Reshape :</span><math id="algorithm2.m4" class="ltx_Math" alttext="\mathbf{Z}^{\prime}_{v}\in\mathbb{R}^{n\times n\times d_{v}}\xleftarrow{}\mathbf{Z}_{v}\in\mathbb{R}^{N\times d_{v}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.800em">𝐙</mi><mi mathsize="0.800em">v</mi><mo mathsize="0.800em">′</mo></msubsup><mo mathsize="0.800em">∈</mo><msup><mi mathsize="0.800em">ℝ</mi><mrow><mi mathsize="0.800em">n</mi><mo lspace="0.222em" mathsize="0.800em" rspace="0.222em">×</mo><mi mathsize="0.800em">n</mi><mo lspace="0.222em" mathsize="0.800em" rspace="0.222em">×</mo><msub><mi mathsize="0.800em">d</mi><mi mathsize="0.800em">v</mi></msub></mrow></msup><mover accent="true"><mo>←</mo><mphantom></mphantom></mover><msub><mi mathsize="0.800em">𝐙</mi><mi mathsize="0.800em">v</mi></msub><mo mathsize="0.800em">∈</mo><msup><mi mathsize="0.800em">ℝ</mi><mrow><mi mathsize="0.800em">N</mi><mo lspace="0.222em" mathsize="0.800em" rspace="0.222em">×</mo><msub><mi mathsize="0.800em">d</mi><mi mathsize="0.800em">v</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{Z}^{\prime}_{v}\in\mathbb{R}^{n\times n\times d_{v}}\xleftarrow{}\mathbf{Z}_{v}\in\mathbb{R}^{N\times d_{v}}</annotation></semantics></math><span id="algorithm2.6.4.3" class="ltx_text" style="font-size:80%;">;</span>
</div>
<div id="algorithm2.6.5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.5.1" class="ltx_text ltx_font_bold" style="font-size:80%;"> 3.</span></span>
            <span id="algorithm2.6.5.2" class="ltx_text" style="font-size:80%;">Region Division : </span><math id="algorithm2.m5" class="ltx_Math" alttext="\{\mathcal{R}_{i}\}_{i=1}^{r^{2}}\xleftarrow{}\mathbf{Z}^{\prime}_{v}" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">{</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">ℛ</mi><mi mathsize="0.800em">i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi mathsize="0.800em">i</mi><mo mathsize="0.800em">=</mo><mn mathsize="0.800em">1</mn></mrow><msup><mi mathsize="0.800em">r</mi><mn mathsize="0.800em">2</mn></msup></msubsup><mover accent="true"><mo>←</mo><mphantom></mphantom></mover><msubsup><mi mathsize="0.800em">𝐙</mi><mi mathsize="0.800em">v</mi><mo mathsize="0.800em">′</mo></msubsup></mrow><annotation encoding="application/x-tex">\{\mathcal{R}_{i}\}_{i=1}^{r^{2}}\xleftarrow{}\mathbf{Z}^{\prime}_{v}</annotation></semantics></math><span id="algorithm2.6.5.3" class="ltx_text" style="font-size:80%;">;</span>
</div>
