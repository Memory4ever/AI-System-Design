      <a href="/search/?searchtype=author&amp;query=Lin%2C+Y">Yu-Jung Lin</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Chen%2C+Y">Yu-Ling Chen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Chen%2C+Z">Zih-Yu Chen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Tsai%2C+I">I-Ning Tsai</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Wang%2C+H">Hsiu-Hsuan Wang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Chung%2C+H">Ho-Lam Chung</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Lu%2C+K">Ke-Han Lu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Lee%2C+H">Hung-yi Lee</a>
      
