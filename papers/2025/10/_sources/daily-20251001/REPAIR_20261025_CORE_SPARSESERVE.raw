              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.16.1" class="ltx_text ltx_font_bold">15</span></span>
            <span id="algorithm1.4.16.2" class="ltx_text ltx_font_bold">return</span> <em id="algorithm1.4.16.3" class="ltx_emph ltx_font_italic"><math id="algorithm1.m37" class="ltx_Math" alttext="\mathcal{B}_{res}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{B}_{res}</annotation></semantics></math></em>

