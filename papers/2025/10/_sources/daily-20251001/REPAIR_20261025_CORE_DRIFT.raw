<th id="S6.T6.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:-2.5pt 5.0pt;"><span id="S6.T6.2.1.2.1" class="ltx_text ltx_font_bold">Timestep</span></th>
<th id="S6.T6.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:-2.5pt 5.0pt;"><span id="S6.T6.2.1.3.1" class="ltx_text ltx_font_bold">Latency</span></th>
<th id="S6.T6.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:-2.5pt 5.0pt;"><span id="S6.T6.2.1.4.1" class="ltx_text ltx_font_bold">Memory</span></th></tr>
<tr id="S6.T6.2.2" class="ltx_tr">
