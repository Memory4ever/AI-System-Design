                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.4.1" class="ltx_text ltx_font_bold">2</span></span>
              <span id="algorithm1.4.4.2" class="ltx_text ltx_font_bold">for</span> <em id="algorithm1.4.4.3" class="ltx_emph ltx_font_italic">epoch <math id="algorithm1.m11" class="ltx_Math" alttext="=1,\dots,E" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>E</mi></mrow><annotation encoding="application/x-tex">=1,\dots,E</annotation></semantics></math></em> <span id="algorithm1.4.4.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.4.5" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.5.1" class="ltx_text ltx_font_bold">3</span></span>
              <span id="algorithm1.4.5.2" class="ltx_text ltx_font_bold">for</span> <em id="algorithm1.4.5.3" class="ltx_emph ltx_font_italic">batch <math id="algorithm1.m12" class="ltx_Math" alttext="(x,y)\sim\mathcal{D}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow><annotation encoding="application/x-tex">(x,y)\sim\mathcal{D}</annotation></semantics></math></em> <span id="algorithm1.4.5.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.4.6" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.6.1" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm1.4.6.2" class="ltx_text ltx_font_typewriter">(i) Clean CE across filters </span>
</div>
<div id="algorithm1.4.7" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.7.1" class="ltx_text ltx_font_bold">4</span></span>
