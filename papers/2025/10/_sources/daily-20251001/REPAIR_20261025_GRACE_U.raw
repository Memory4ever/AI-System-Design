{"data":{"id":"10.48550/arxiv.2509.25041","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.25041","prefix":"10.48550","suffix":"arxiv.2509.25041","identifiers":[{"identifier":"2509.25041","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.25041"}],"creators":[{"name":"Han, Yu","nameType":"Personal","givenName":"Yu","familyName":"Han","affiliation":[],"nameIdentifiers":[]},{"name":"Pan, Lehan","nameType":"Personal","givenName":"Lehan","familyName":"Pan","affiliation":[],"nameIdentifiers":[]},{"name":"Peng, Jie","nameType":"Personal","givenName":"Jie","familyName":"Peng","affiliation":[],"nameIdentifiers":[]},{"name":"Tao, Ziyang","nameType":"Personal","givenName":"Ziyang","familyName":"Tao","affiliation":[],"nameIdentifiers":[]},{"name":"Zhu, Hanqi","nameType":"Personal","givenName":"Hanqi","familyName":"Zhu","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Wuyang","nameType":"Personal","givenName":"Wuyang","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Yanyong","nameType":"Personal","givenName":"Yanyong","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GRACE-MoE: Grouping and Replication with Locality-Aware Routing for Efficient Distributed MoE Inference"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-29T16:57:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-30T02:17:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-20T05:56:44Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-21T01:10:34Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-01-24T22:37:20Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-01-27T01:39:17Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-05-06T06:43:02Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-05-07T00:27:25Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Sparse Mixture of Experts (SMoE) enables scalable parameter growth in large language models (LLMs) by selectively activating a subset of experts, and its large parameter count necessitates distributed deployment for inference. However, distributed inference faces a critical dilemma: although communication overhead constitutes the primary bottleneck, reducing it often exacerbates computational load imbalance, leading to resource waste. In this paper, we present GRACE-MoE, which stands for Grouping and Replication with Locality-Aware Routing for SMoE inference. GRACE-MoE is a lossless co-optimization framework that integrates expert grouping to reduce communication and dynamic replication to correct load skew, together with locality-aware routing to resolve replica selection. To underpin this coordinated optimization in multi-node settings, GRACE-MoE adopts a hierarchical sparse communication design that reduces cross-node traffic while implicitly aligning execution across nodes, thereby mitigating synchronization overhead. Experiments on diverse models and multi-node, multi-GPU environments demonstrate that GRACE-MoE efficiently reduces end-to-end inference latency, achieving up to 4.66x speedup over existing systems, and the code will be released upon acceptance.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.25041","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-30T04:31:05.000Z","registered":"2025-09-30T04:31:05.000Z","published":"2025","updated":"2026-05-07T02:18:52.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.25041","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}