<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Muon algorithms</h2>

<div id="A2.p1" class="ltx_para ltx_noindent">
<p id="A2.p1.1" class="ltx_p">Algos <a href="#alg1" title="Algorithm 1 ‣ Appendix B Muon algorithms ‣ Effective Quantization of Muon Optimizer States" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, <a href="#alg2" title="Algorithm 2 ‣ Appendix B Muon algorithms ‣ Effective Quantization of Muon Optimizer States" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> and <a href="#alg3" title="Algorithm 3 ‣ Appendix B Muon algorithms ‣ Effective Quantization of Muon Optimizer States" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> represent vanilla Muon <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib24" title="" class="ltx_ref">Jordan et al., 2024</a>)</cite>, Muon <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib30" title="" class="ltx_ref">Liu et al., 2025</a>)</cite> and Quantized Muon. <span id="A2.p1.1.1" class="ltx_text ltx_font_bold">Note</span> The algos use small-case vector notation.</p>
</div>
<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> Vanilla Muon (using <math id="alg1.m2" class="ltx_Math" alttext="\bm{\theta},\mathbf{g},\mathbf{m}" display="inline" intent=":literal"><semantics><mrow><mi>𝜽</mi><mo>,</mo><mi>𝐠</mi><mo>,</mo><mi>𝐦</mi></mrow><annotation encoding="application/x-tex">\bm{\theta},\mathbf{g},\mathbf{m}</annotation></semantics></math>; NS-orthogonalized momentum for 2D hidden-layer params)</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">1:</span>
            
            
          <span id="alg1.l1.2" class="ltx_text ltx_font_bold">Input:</span> step size <math id="alg1.l1.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>, momentum <math id="alg1.l1.m2" class="ltx_Math" alttext="\beta\in[0,1)" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\beta\in[0,1)</annotation></semantics></math>, NS steps <math id="alg1.l1.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> (default <math id="alg1.l1.m4" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math>), <math id="alg1.l1.m5" class="ltx_Math" alttext="\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon&gt;0</annotation></semantics></math>

</div>
<div id="alg1.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">2:</span>
            
            
          <span id="alg1.l2.2" class="ltx_text ltx_font_bold">Initialize:</span> <math id="alg1.l2.m1" class="ltx_Math" alttext="\bm{\theta}^{(0)}" display="inline" intent=":literal"><semantics><msup><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\bm{\theta}^{(0)}</annotation></semantics></math>, <math id="alg1.l2.m2" class="ltx_Math" alttext="\tilde{\mathbf{m}}^{(0)}=\mathbf{0}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>𝐦</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mn>𝟎</mn></mrow><annotation encoding="application/x-tex">\tilde{\mathbf{m}}^{(0)}=\mathbf{0}</annotation></semantics></math>

</div>
<div id="alg1.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">3:</span>
            
            
          <span id="alg1.l3.2" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l3.m1" class="ltx_Math" alttext="t=1,2,\dots" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">t=1,2,\dots</annotation></semantics></math> <span id="alg1.l3.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">4:</span>
            
            
            <math id="alg1.l4.m1" class="ltx_Math" alttext="\mathbf{g}^{(t)}\leftarrow\nabla f_{t}(\bm{\theta}^{(t-1)})" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐠</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">←</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{g}^{(t)}\leftarrow\nabla f_{t}(\bm{\theta}^{(t-1)})</annotation></semantics></math>

</div>
<div id="alg1.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">5:</span>
            
            
            <math id="alg1.l5.m1" class="ltx_Math" alttext="\tilde{\mathbf{m}}^{(t)}\leftarrow\beta\tilde{\mathbf{m}}^{(t-1)}+(1-\beta)\,\mathbf{g}^{(t)}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>𝐦</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">←</mo><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐦</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>𝐠</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{\mathbf{m}}^{(t)}\leftarrow\beta\tilde{\mathbf{m}}^{(t-1)}+(1-\beta)\,\mathbf{g}^{(t)}</annotation></semantics></math> <span id="alg1.l5.2" class="ltx_text" style="float:right;"><math id="alg1.l5.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> SGD-style momentum <em id="alg1.l5.2.1" class="ltx_emph ltx_font_italic">before</em> orthogonalization
</span>
</div>
<div id="alg1.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">6:</span>
            
            
            <span id="alg1.l6.2" class="ltx_text ltx_font_bold">for</span> <span id="alg1.l6.3" class="ltx_text ltx_font_bold">each</span> 2D hidden-layer parameter block <math id="alg1.l6.m1" class="ltx_Math" alttext="\theta\subset\bm{\theta}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>⊂</mo><mi>𝜽</mi></mrow><annotation encoding="application/x-tex">\theta\subset\bm{\theta}</annotation></semantics></math> <span id="alg1.l6.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">7:</span>
            
            
             <math id="alg1.l7.m1" class="ltx_Math" alttext="\Delta\leftarrow\textsc{NS}(\tilde{\mathbf{m}}^{(t)}[\theta],\,T,\,\epsilon)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">NS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>𝐦</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>θ</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mi>T</mi><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta\leftarrow\textsc{NS}(\tilde{\mathbf{m}}^{(t)}[\theta],\,T,\,\epsilon)</annotation></semantics></math> <span id="alg1.l7.2" class="ltx_text" style="float:right;"><math id="alg1.l7.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Orthogonalize update
</span>
</div>
<div id="alg1.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">8:</span>
            
            
             <math id="alg1.l8.m1" class="ltx_Math" alttext="\theta\leftarrow\theta-\alpha\,\Delta" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo stretchy="false">←</mo><mrow><mi>θ</mi><mo>−</mo><mrow><mi>α</mi><mo lspace="0.170em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta\leftarrow\theta-\alpha\,\Delta</annotation></semantics></math>

</div>
<div id="alg1.l9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">9:</span>
            
            
            <span id="alg1.l9.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l9.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l10" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">10:</span>
            
            
          <span id="alg1.l10.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l10.3" class="ltx_text ltx_font_bold">for</span>
</div>
</div>
</figure>
<figure id="alg2" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.3" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> Muon (using <math id="alg2.m2" class="ltx_Math" alttext="\bm{\theta},\mathbf{g},\mathbf{m}" display="inline" intent=":literal"><semantics><mrow><mi>𝜽</mi><mo>,</mo><mi>𝐠</mi><mo>,</mo><mi>𝐦</mi></mrow><annotation encoding="application/x-tex">\bm{\theta},\mathbf{g},\mathbf{m}</annotation></semantics></math>; NS-orthogonalized momentum for 2D hidden-layer params)</figcaption>
<div id="alg2.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">1:</span>
            
            
          <span id="alg2.l1.2" class="ltx_text ltx_font_bold">Input:</span> step size <math id="alg2.l1.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>, momentum <math id="alg2.l1.m2" class="ltx_Math" alttext="\beta\in[0,1)" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\beta\in[0,1)</annotation></semantics></math>, weight decay <math id="alg2.l1.m3" class="ltx_Math" alttext="\lambda\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda\geq 0</annotation></semantics></math>, NS steps <math id="alg2.l1.m4" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> (default <math id="alg2.l1.m5" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math>), <math id="alg2.l1.m6" class="ltx_Math" alttext="\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon&gt;0</annotation></semantics></math>

</div>
<div id="alg2.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">2:</span>
            
            
          <span id="alg2.l2.2" class="ltx_text ltx_font_bold">Initialize:</span> <math id="alg2.l2.m1" class="ltx_Math" alttext="\bm{\theta}^{(0)}" display="inline" intent=":literal"><semantics><msup><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\bm{\theta}^{(0)}</annotation></semantics></math>, <math id="alg2.l2.m2" class="ltx_Math" alttext="\tilde{\mathbf{m}}^{(0)}=\mathbf{0}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>𝐦</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mn>𝟎</mn></mrow><annotation encoding="application/x-tex">\tilde{\mathbf{m}}^{(0)}=\mathbf{0}</annotation></semantics></math>

</div>
<div id="alg2.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">3:</span>
            
            
          <span id="alg2.l3.2" class="ltx_text ltx_font_bold">for</span> <math id="alg2.l3.m1" class="ltx_Math" alttext="t=1,2,\dots" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">t=1,2,\dots</annotation></semantics></math> <span id="alg2.l3.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg2.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">4:</span>
            
            
            <math id="alg2.l4.m1" class="ltx_Math" alttext="\mathbf{g}^{(t)}\leftarrow\nabla f_{t}(\bm{\theta}^{(t-1)})" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐠</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">←</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{g}^{(t)}\leftarrow\nabla f_{t}(\bm{\theta}^{(t-1)})</annotation></semantics></math>

</div>
<div id="alg2.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">5:</span>
            
            
            <math id="alg2.l5.m1" class="ltx_Math" alttext="\tilde{\mathbf{m}}^{(t)}\leftarrow\beta\tilde{\mathbf{m}}^{(t-1)}+(1-\beta)\,\mathbf{g}^{(t)}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>𝐦</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">←</mo><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐦</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>𝐠</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{\mathbf{m}}^{(t)}\leftarrow\beta\tilde{\mathbf{m}}^{(t-1)}+(1-\beta)\,\mathbf{g}^{(t)}</annotation></semantics></math> <span id="alg2.l5.2" class="ltx_text" style="float:right;"><math id="alg2.l5.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> SGD-style momentum <em id="alg2.l5.2.1" class="ltx_emph ltx_font_italic">before</em> orthogonalization
</span>
</div>
<div id="alg2.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">6:</span>
            
            
            <span id="alg2.l6.2" class="ltx_text ltx_font_bold">for</span> <span id="alg2.l6.3" class="ltx_text ltx_font_bold">each</span> 2D hidden-layer parameter block <math id="alg2.l6.m1" class="ltx_Math" alttext="\theta\subset\bm{\theta}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>⊂</mo><mi>𝜽</mi></mrow><annotation encoding="application/x-tex">\theta\subset\bm{\theta}</annotation></semantics></math> (with dimensions <math id="alg2.l6.m2" class="ltx_Math" alttext="m,n" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>,</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">m,n</annotation></semantics></math>) <span id="alg2.l6.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg2.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">7:</span>
            
            
             <math id="alg2.l7.m1" class="ltx_Math" alttext="\Delta\leftarrow\textsc{NS}(\tilde{\mathbf{m}}^{(t)}[\theta],\,T,\,\epsilon)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">NS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>𝐦</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>θ</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mi>T</mi><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta\leftarrow\textsc{NS}(\tilde{\mathbf{m}}^{(t)}[\theta],\,T,\,\epsilon)</annotation></semantics></math> <span id="alg2.l7.2" class="ltx_text" style="float:right;"><math id="alg2.l7.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Orthogonalize update
</span>
</div>
<div id="alg2.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">8:</span>
            
            
             <math id="alg2.l8.m1" class="ltx_Math" alttext="\theta\leftarrow(1-\alpha\lambda)\theta-0.2\alpha\sqrt{\max(m,n)}\,\Delta" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo stretchy="false">←</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo>−</mo><mrow><mn>0.2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo lspace="0.170em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta\leftarrow(1-\alpha\lambda)\theta-0.2\alpha\sqrt{\max(m,n)}\,\Delta</annotation></semantics></math>

</div>
<div id="alg2.l9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">9:</span>
            
            
            <span id="alg2.l9.2" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l9.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg2.l10" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">10:</span>
            
            
          <span id="alg2.l10.2" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l10.3" class="ltx_text ltx_font_bold">for</span>
</div>
</div>
</figure>
<figure id="alg3" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg3.3" class="ltx_text ltx_font_bold">Algorithm 3</span> </span> Quantized Muon (using <math id="alg3.m2" class="ltx_Math" alttext="\bm{\theta},\mathbf{g},\mathbf{m}" display="inline" intent=":literal"><semantics><mrow><mi>𝜽</mi><mo>,</mo><mi>𝐠</mi><mo>,</mo><mi>𝐦</mi></mrow><annotation encoding="application/x-tex">\bm{\theta},\mathbf{g},\mathbf{m}</annotation></semantics></math>; NS-orthogonalized momentum for 2D hidden-layer params)</figcaption>
<div id="alg3.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg3.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">1:</span>
            
            
          <span id="alg3.l1.2" class="ltx_text ltx_font_bold">Input:</span> step size <math id="alg3.l1.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>, momentum <math id="alg3.l1.m2" class="ltx_Math" alttext="\beta\in[0,1)" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\beta\in[0,1)</annotation></semantics></math>, weight decay <math id="alg3.l1.m3" class="ltx_Math" alttext="\lambda\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda\geq 0</annotation></semantics></math>, NS steps <math id="alg3.l1.m4" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, <math id="alg3.l1.m5" class="ltx_Math" alttext="\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon&gt;0</annotation></semantics></math>, quantization params (mode, bits <math id="alg3.l1.m6" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>)

</div>
<div id="alg3.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">2:</span>
            
            
          <span id="alg3.l2.2" class="ltx_text ltx_font_bold">Initialize:</span> <math id="alg3.l2.m1" class="ltx_Math" alttext="\bm{\theta}^{(0)}" display="inline" intent=":literal"><semantics><msup><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\bm{\theta}^{(0)}</annotation></semantics></math>, quantized momentum state <math id="alg3.l2.m2" class="ltx_Math" alttext="(\mathbf{z}^{(0)},\mathbf{s}^{(0)})=(\mathbf{0},\mathbf{0})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msup><mi>𝐳</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝐬</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>𝟎</mn><mo>,</mo><mn>𝟎</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(\mathbf{z}^{(0)},\mathbf{s}^{(0)})=(\mathbf{0},\mathbf{0})</annotation></semantics></math>

</div>
<div id="alg3.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">3:</span>
            
            
          <span id="alg3.l3.2" class="ltx_text ltx_font_bold">for</span> <math id="alg3.l3.m1" class="ltx_Math" alttext="t=1,2,\dots" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">t=1,2,\dots</annotation></semantics></math> <span id="alg3.l3.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg3.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">4:</span>
            
            
            <math id="alg3.l4.m1" class="ltx_Math" alttext="\mathbf{g}^{(t)}\leftarrow\nabla f_{t}(\bm{\theta}^{(t-1)})" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐠</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">←</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{g}^{(t)}\leftarrow\nabla f_{t}(\bm{\theta}^{(t-1)})</annotation></semantics></math>

</div>
<div id="alg3.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">5:</span>
            
            
            <span id="alg3.l5.2" class="ltx_text ltx_font_bold">for</span> <span id="alg3.l5.3" class="ltx_text ltx_font_bold">each</span> 2D hidden-layer parameter block <math id="alg3.l5.m1" class="ltx_Math" alttext="\theta\subset\bm{\theta}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>⊂</mo><mi>𝜽</mi></mrow><annotation encoding="application/x-tex">\theta\subset\bm{\theta}</annotation></semantics></math> (with dimensions <math id="alg3.l5.m2" class="ltx_Math" alttext="m,n" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>,</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">m,n</annotation></semantics></math>) <span id="alg3.l5.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg3.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">6:</span>
            
            
             <math id="alg3.l6.m1" class="ltx_Math" alttext="\tilde{\mathbf{m}}^{(t-1)}\leftarrow\textsc{Dequantize}(\mathbf{z}^{(t-1)}[\theta],\mathbf{s}^{(t-1)}[\theta])" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>𝐦</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">Dequantize</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐳</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>θ</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>𝐬</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>θ</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{\mathbf{m}}^{(t-1)}\leftarrow\textsc{Dequantize}(\mathbf{z}^{(t-1)}[\theta],\mathbf{s}^{(t-1)}[\theta])</annotation></semantics></math> <span id="alg3.l6.2" class="ltx_text" style="float:right;"><math id="alg3.l6.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Dequantize saved momentum state
</span>
</div>
<div id="alg3.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">7:</span>
            
            
             <math id="alg3.l7.m1" class="ltx_Math" alttext="\mathbf{m}^{(t)}\leftarrow\beta\,\tilde{\mathbf{m}}^{(t-1)}+\mathbf{g}^{(t)}[\theta]" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐦</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">←</mo><mrow><mrow><mi>β</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐦</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><mo>+</mo><mrow><msup><mi>𝐠</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>θ</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{m}^{(t)}\leftarrow\beta\,\tilde{\mathbf{m}}^{(t-1)}+\mathbf{g}^{(t)}[\theta]</annotation></semantics></math> <span id="alg3.l7.2" class="ltx_text" style="float:right;"><math id="alg3.l7.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Update momentum with current gradient
</span>
</div>
<div id="alg3.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">8:</span>
            
            
             <math id="alg3.l8.m1" class="ltx_Math" alttext="\mathbf{u}^{(t)}\leftarrow\textsc{NS}(\mathbf{m}^{(t)},T,\epsilon)" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐮</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">NS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐦</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>T</mi><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{u}^{(t)}\leftarrow\textsc{NS}(\mathbf{m}^{(t)},T,\epsilon)</annotation></semantics></math> <span id="alg3.l8.2" class="ltx_text" style="float:right;"><math id="alg3.l8.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Orthogonalize momentum for the update
</span>
</div>
<div id="alg3.l9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">9:</span>
            
            
             <math id="alg3.l9.m1" class="ltx_Math" alttext="\theta\leftarrow(1-\alpha\lambda)\theta-0.2\alpha\sqrt{\max(m,n)}\,\mathbf{u}^{(t)}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo stretchy="false">←</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo>−</mo><mrow><mn>0.2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>𝐮</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta\leftarrow(1-\alpha\lambda)\theta-0.2\alpha\sqrt{\max(m,n)}\,\mathbf{u}^{(t)}</annotation></semantics></math> <span id="alg3.l9.2" class="ltx_text" style="float:right;"><math id="alg3.l9.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Update parameters
</span>
</div>
<div id="alg3.l10" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">10:</span>
            
            
             <math id="alg3.l10.m1" class="ltx_Math" alttext="(\mathbf{z}^{(t)}[\theta],\mathbf{s}^{(t)}[\theta])\leftarrow\textsc{Quantize}(\mathbf{m}^{(t)})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐳</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>θ</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>𝐬</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>θ</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">Quantize</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐦</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(\mathbf{z}^{(t)}[\theta],\mathbf{s}^{(t)}[\theta])\leftarrow\textsc{Quantize}(\mathbf{m}^{(t)})</annotation></semantics></math> <span id="alg3.l10.2" class="ltx_text" style="float:right;"><math id="alg3.l10.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Quantize and save new momentum state
</span>
</div>
<div id="alg3.l11" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">11:</span>
            
            
            <span id="alg3.l11.2" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l11.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg3.l12" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">12:</span>
            
            
          <span id="alg3.l12.2" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l12.3" class="ltx_text ltx_font_bold">for</span>
</div>
</div>
</figure>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Quantization Error Bounds</h2>

<div id="A3.p1" class="ltx_para ltx_noindent">
<p id="A3.p1.1" class="ltx_p">In this appendix we formalize the 8-bit linear quantization operator and provide detailed proofs of the error bounds for Adam and SGD with momentum under quantization. We adopt the same notation as in Algorithm <a href="#alg4" title="Algorithm 4 ‣ C.3 Adam algorithm ‣ Appendix C Quantization Error Bounds ‣ Effective Quantization of Muon Optimizer States" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>: <math id="A3.p1.m1" class="ltx_Math" alttext="\mathbf{g}" display="inline" intent=":literal"><semantics><mi>𝐠</mi><annotation encoding="application/x-tex">\mathbf{g}</annotation></semantics></math> is the stochastic gradient, <math id="A3.p1.m2" class="ltx_Math" alttext="\mathbf{m}" display="inline" intent=":literal"><semantics><mi>𝐦</mi><annotation encoding="application/x-tex">\mathbf{m}</annotation></semantics></math> and <math id="A3.p1.m3" class="ltx_Math" alttext="\mathbf{v}" display="inline" intent=":literal"><semantics><mi>𝐯</mi><annotation encoding="application/x-tex">\mathbf{v}</annotation></semantics></math> are the first- and second-moment accumulators, <math id="A3.p1.m4" class="ltx_Math" alttext="\mathbf{g}^{2}" display="inline" intent=":literal"><semantics><msup><mi>𝐠</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\mathbf{g}^{2}</annotation></semantics></math> denotes the entrywise square, <math id="A3.p1.m5" class="ltx_Math" alttext="\sqrt{\mathbf{v}}" display="inline" intent=":literal"><semantics><msqrt><mi>𝐯</mi></msqrt><annotation encoding="application/x-tex">\sqrt{\mathbf{v}}</annotation></semantics></math> denotes the entrywise square root, and <math id="A3.p1.m6" class="ltx_Math" alttext="\operatorname{vec}(\mathbf{M})" display="inline" intent=":literal"><semantics><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐌</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{vec}(\mathbf{M})</annotation></semantics></math> denotes the vectorization of <math id="A3.p1.m7" class="ltx_Math" alttext="\mathbf{M}" display="inline" intent=":literal"><semantics><mi>𝐌</mi><annotation encoding="application/x-tex">\mathbf{M}</annotation></semantics></math>.</p>
</div>
<section id="A3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.1 </span>Quantization Operator</h3>

<div id="Thmdefinition1" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmdefinition1.2" class="ltx_text ltx_font_bold">Definition 1</span></span></h6>
<div id="Thmdefinition1.p1" class="ltx_para">
<p id="Thmdefinition1.p1.1" class="ltx_p"><span id="Thmdefinition1.p1.1.1" class="ltx_text ltx_font_italic">(Linear quantization). For a given vector <math id="Thmdefinition1.p1.m1" class="ltx_Math" alttext="\mathbf{x}\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathbf{x}\in\mathbb{R}^{d}</annotation></semantics></math> denoting the optimizer state of some algorithm, the 8-bit linear quantization is denoted by <math id="Thmdefinition1.p1.m2" class="ltx_Math" alttext="Q:\mathbb{R}^{d}\rightarrow\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mi>d</mi></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">Q:\mathbb{R}^{d}\rightarrow\mathbb{R}^{d}</annotation></semantics></math>, where:</span></p>
<table id="A3.EGx5" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="A3.Ex6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex6.m1" class="ltx_Math" alttext="\displaystyle[Q(\mathbf{x})]_{i}=\frac{\|\mathbf{x}\|_{\infty}}{127}\cdot\operatorname{round}\left(\frac{127\cdot\mathbf{x}_{i}}{\|\mathbf{x}\|_{\infty}}\right)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">[</mo><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow><mi>i</mi></msub><mo>=</mo><mrow><mfrac><msub><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mn>127</mn></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>round</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><mn>127</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝐱</mi><mi>i</mi></msub></mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle[Q(\mathbf{x})]_{i}=\frac{\|\mathbf{x}\|_{\infty}}{127}\cdot\operatorname{round}\left(\frac{127\cdot\mathbf{x}_{i}}{\|\mathbf{x}\|_{\infty}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A3.SS1.p1" class="ltx_para ltx_noindent">
<p id="A3.SS1.p1.1" class="ltx_p">That is, each coordinate of <math id="A3.SS1.p1.m1" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math> is mapped to the nearest grid point in a uniform partition of <math id="A3.SS1.p1.m2" class="ltx_Math" alttext="[-\|\mathbf{x}\|_{\infty},\|\mathbf{x}\|_{\infty}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo>,</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[-\|\mathbf{x}\|_{\infty},\|\mathbf{x}\|_{\infty}]</annotation></semantics></math> into <math id="A3.SS1.p1.m3" class="ltx_Math" alttext="256" display="inline" intent=":literal"><semantics><mn>256</mn><annotation encoding="application/x-tex">256</annotation></semantics></math> representable levels (corresponding to signed 8-bit integers from <math id="A3.SS1.p1.m4" class="ltx_Math" alttext="-128" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>128</mn></mrow><annotation encoding="application/x-tex">-128</annotation></semantics></math> to <math id="A3.SS1.p1.m5" class="ltx_Math" alttext="127" display="inline" intent=":literal"><semantics><mn>127</mn><annotation encoding="application/x-tex">127</annotation></semantics></math>), then rescaled back to floating point. This is the standard max-abs scaling scheme used in prior 8-bit quantization work. Note that, although we work over the reals, this definition effectively models the quantization and de-quantization steps applied to optimizer states between iterations.</p>
</div>
</section>
<section id="A3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.2 </span>Proofs</h3>

<section id="A3.SS2.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">C.2.1 </span>Proof of Theorem <a href="#Thmtheorem1" title="Theorem 1 ‣ 4.1 Why is 8-bit AdamW unstable under linear quantization? ‣ 4 Methods ‣ Effective Quantization of Muon Optimizer States" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a></h4>

<div id="A3.SS2.SSS1.p1" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS1.p1.1" class="ltx_p"><span id="A3.SS2.SSS1.p1.1.1" class="ltx_text ltx_font_bold">Proof </span></p>
</div>
<div id="A3.SS2.SSS1.p2" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS1.p2.1" class="ltx_p">As stated in the theorem, we work at the first step (<math id="A3.SS2.SSS1.p2.m1" class="ltx_Math" alttext="t=1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=1</annotation></semantics></math>) and suppress iterate superscripts for notational clarity. By the moment definitions in Algorithm <a href="#alg4" title="Algorithm 4 ‣ C.3 Adam algorithm ‣ Appendix C Quantization Error Bounds ‣ Effective Quantization of Muon Optimizer States" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, we have <math id="A3.SS2.SSS1.p2.m2" class="ltx_Math" alttext="\mathbf{m}=\mathbf{g}" display="inline" intent=":literal"><semantics><mrow><mi>𝐦</mi><mo>=</mo><mi>𝐠</mi></mrow><annotation encoding="application/x-tex">\mathbf{m}=\mathbf{g}</annotation></semantics></math> and <math id="A3.SS2.SSS1.p2.m3" class="ltx_Math" alttext="\mathbf{v}=\mathbf{g}^{2}" display="inline" intent=":literal"><semantics><mrow><mi>𝐯</mi><mo>=</mo><msup><mi>𝐠</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\mathbf{v}=\mathbf{g}^{2}</annotation></semantics></math> (entry-wise), so for each coordinate <math id="A3.SS2.SSS1.p2.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> we have <math id="A3.SS2.SSS1.p2.m5" class="ltx_Math" alttext="\sqrt{\mathbf{v}_{i}}=|\mathbf{g}_{i}|" display="inline" intent=":literal"><semantics><mrow><msqrt><msub><mi>𝐯</mi><mi>i</mi></msub></msqrt><mo>=</mo><mrow><mo stretchy="false">|</mo><msub><mi>𝐠</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">\sqrt{\mathbf{v}_{i}}=|\mathbf{g}_{i}|</annotation></semantics></math>. We first lower bound the per-coordinate deviation <math id="A3.SS2.SSS1.p2.m6" class="ltx_Math" alttext="\left|\frac{\mathbf{m}_{i}}{\sqrt{\mathbf{v}_{i}}+\epsilon}-\frac{Q(\mathbf{m}_{i})}{\sqrt{Q(\mathbf{v}_{i})}+\epsilon}\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mfrac><msub><mi>𝐦</mi><mi>i</mi></msub><mrow><msqrt><msub><mi>𝐯</mi><mi>i</mi></msub></msqrt><mo>+</mo><mi>ϵ</mi></mrow></mfrac><mo>−</mo><mfrac><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐦</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msqrt><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\left|\frac{\mathbf{m}_{i}}{\sqrt{\mathbf{v}_{i}}+\epsilon}-\frac{Q(\mathbf{m}_{i})}{\sqrt{Q(\mathbf{v}_{i})}+\epsilon}\right|</annotation></semantics></math> and then sum over <math id="A3.SS2.SSS1.p2.m7" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.</p>
</div>
<div id="A3.SS2.SSS1.p3" class="ltx_para ltx_noindent">
<table id="A3.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex7.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}\left(\left(\frac{\mathbf{m}_{i}}{\sqrt{\mathbf{v}_{i}}+\epsilon}-\frac{Q(\mathbf{m}_{i})}{\sqrt{Q(\mathbf{v}_{i})}+\epsilon}\right)^{2}\geq t^{2}\right)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>𝐦</mi><mi>i</mi></msub><mrow><msqrt><msub><mi>𝐯</mi><mi>i</mi></msub></msqrt><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐦</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msqrt><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo>≥</mo><msup><mi>t</mi><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\left(\left(\frac{\mathbf{m}_{i}}{\sqrt{\mathbf{v}_{i}}+\epsilon}-\frac{Q(\mathbf{m}_{i})}{\sqrt{Q(\mathbf{v}_{i})}+\epsilon}\right)^{2}\geq t^{2}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex7.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{P}\left(\left|\frac{\mathbf{m}_{i}}{\sqrt{\mathbf{v}_{i}}+\epsilon}-\frac{Q(\mathbf{m}_{i})}{\sqrt{Q(\mathbf{v}_{i})}+\epsilon}\right|\geq t\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>𝐦</mi><mi>i</mi></msub><mrow><msqrt><msub><mi>𝐯</mi><mi>i</mi></msub></msqrt><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐦</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msqrt><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mstyle></mrow><mo>|</mo></mrow><mo>≥</mo><mi>t</mi></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{P}\left(\left|\frac{\mathbf{m}_{i}}{\sqrt{\mathbf{v}_{i}}+\epsilon}-\frac{Q(\mathbf{m}_{i})}{\sqrt{Q(\mathbf{v}_{i})}+\epsilon}\right|\geq t\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex8.m1" class="ltx_Math" alttext="\displaystyle\geq\mathbb{P}\left(\frac{|\mathbf{g}_{i}|-\|\mathbf{g}\|_{\infty}/127}{\sqrt{Q(\mathbf{v}_{i})}+\epsilon}-\frac{|\mathbf{g}_{i}|}{\sqrt{\mathbf{v}_{i}}+\epsilon}\geq t~\text{and}~\mathbf{v}_{i}\geq Q(\mathbf{v}_{i})\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><msub><mi>𝐠</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>−</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝐠</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>/</mo><mn>127</mn></mrow></mrow><mrow><msqrt><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><msub><mi>𝐠</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mrow><msqrt><msub><mi>𝐯</mi><mi>i</mi></msub></msqrt><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mstyle></mrow><mo>≥</mo><mrow><mi>t</mi><mo lspace="0.330em" rspace="0em">​</mo><mtext>and</mtext><mo lspace="0.330em" rspace="0em">​</mo><msub><mi>𝐯</mi><mi>i</mi></msub></mrow><mo>≥</mo><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\mathbb{P}\left(\frac{|\mathbf{g}_{i}|-\|\mathbf{g}\|_{\infty}/127}{\sqrt{Q(\mathbf{v}_{i})}+\epsilon}-\frac{|\mathbf{g}_{i}|}{\sqrt{\mathbf{v}_{i}}+\epsilon}\geq t~\text{and}~\mathbf{v}_{i}\geq Q(\mathbf{v}_{i})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS2.SSS1.p4" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS1.p4.1" class="ltx_p">Note that <math id="A3.SS2.SSS1.p4.m1" class="ltx_Math" alttext="\sqrt{\mathbf{v}_{i}}=\sqrt{\mathbf{g}_{i}^{2}}=|\mathbf{g}_{i}|" display="inline" intent=":literal"><semantics><mrow><msqrt><msub><mi>𝐯</mi><mi>i</mi></msub></msqrt><mo>=</mo><msqrt><msubsup><mi>𝐠</mi><mi>i</mi><mn>2</mn></msubsup></msqrt><mo>=</mo><mrow><mo stretchy="false">|</mo><msub><mi>𝐠</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">\sqrt{\mathbf{v}_{i}}=\sqrt{\mathbf{g}_{i}^{2}}=|\mathbf{g}_{i}|</annotation></semantics></math> and <math id="A3.SS2.SSS1.p4.m2" class="ltx_Math" alttext="Q(\mathbf{v}_{i})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">Q(\mathbf{v}_{i})=0</annotation></semantics></math> implies <math id="A3.SS2.SSS1.p4.m3" class="ltx_Math" alttext="\mathbf{v}_{i}\geq Q(\mathbf{v}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐯</mi><mi>i</mi></msub><mo>≥</mo><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{v}_{i}\geq Q(\mathbf{v}_{i})</annotation></semantics></math>. Hence, following from above,</p>
<table id="A3.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex9.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}\left(\left(\frac{\mathbf{m}_{i}}{\sqrt{\mathbf{v}_{i}}+\epsilon}-\frac{Q(\mathbf{m}_{i})}{\sqrt{Q(\mathbf{v}_{i})}+\epsilon}\right)^{2}\geq t^{2}\right)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>𝐦</mi><mi>i</mi></msub><mrow><msqrt><msub><mi>𝐯</mi><mi>i</mi></msub></msqrt><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐦</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msqrt><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo>≥</mo><msup><mi>t</mi><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\left(\left(\frac{\mathbf{m}_{i}}{\sqrt{\mathbf{v}_{i}}+\epsilon}-\frac{Q(\mathbf{m}_{i})}{\sqrt{Q(\mathbf{v}_{i})}+\epsilon}\right)^{2}\geq t^{2}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex9.m2" class="ltx_Math" alttext="\displaystyle\geq\mathbb{P}\left(\frac{|\mathbf{g}_{i}|-\|\mathbf{g}\|_{\infty}/127}{\epsilon}-\frac{|\mathbf{g}_{i}|}{|\mathbf{g}_{i}|+\epsilon}\geq t~\text{and}~Q(\mathbf{v}_{i})=0\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><msub><mi>𝐠</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>−</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝐠</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>/</mo><mn>127</mn></mrow></mrow><mi>ϵ</mi></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><msub><mi>𝐠</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mrow><mrow><mo stretchy="false">|</mo><msub><mi>𝐠</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mstyle></mrow><mo>≥</mo><mrow><mi>t</mi><mo lspace="0.330em" rspace="0em">​</mo><mtext>and</mtext><mo lspace="0.330em" rspace="0em">​</mo><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\mathbb{P}\left(\frac{|\mathbf{g}_{i}|-\|\mathbf{g}\|_{\infty}/127}{\epsilon}-\frac{|\mathbf{g}_{i}|}{|\mathbf{g}_{i}|+\epsilon}\geq t~\text{and}~Q(\mathbf{v}_{i})=0\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex10.m1" class="ltx_Math" alttext="\displaystyle\geq\mathbb{P}\left(\frac{|\mathbf{g}_{i}|-\|\mathbf{g}\|_{\infty}/127}{\epsilon}-1\geq t~\text{and}~Q(\mathbf{v}_{i})=0\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><msub><mi>𝐠</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>−</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝐠</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>/</mo><mn>127</mn></mrow></mrow><mi>ϵ</mi></mfrac></mstyle><mo>−</mo><mn>1</mn></mrow><mo>≥</mo><mrow><mi>t</mi><mo lspace="0.330em" rspace="0em">​</mo><mtext>and</mtext><mo lspace="0.330em" rspace="0em">​</mo><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\mathbb{P}\left(\frac{|\mathbf{g}_{i}|-\|\mathbf{g}\|_{\infty}/127}{\epsilon}-1\geq t~\text{and}~Q(\mathbf{v}_{i})=0\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS2.SSS1.p5" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS1.p5.1" class="ltx_p">Define the event
<math id="A3.SS2.SSS1.p5.m1" class="ltx_math_unparsed" alttext="E_{i}:=\{\tfrac{\|\mathbf{g}\|_{\infty}}{60}&lt;|\mathbf{g}_{i}|\leq\tfrac{\|\mathbf{g}\|_{\infty}}{16}\}." display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mi>i</mi></msub><mo>:=</mo><mrow><mo stretchy="false">{</mo><mfrac><msub><mrow><mo stretchy="false">‖</mo><mi>𝐠</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mn>60</mn></mfrac><mo rspace="0em">&lt;</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝐠</mi><mi>i</mi></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">≤</mo><mfrac><msub><mrow><mo stretchy="false">‖</mo><mi>𝐠</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mn>16</mn></mfrac><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">E_{i}:=\{\tfrac{\|\mathbf{g}\|_{\infty}}{60}&lt;|\mathbf{g}_{i}|\leq\tfrac{\|\mathbf{g}\|_{\infty}}{16}\}.</annotation></semantics></math>
By the assumption of the theorem, <math id="A3.SS2.SSS1.p5.m2" class="ltx_Math" alttext="\mathbb{P}(E_{i})\geq\nu" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mi>ν</mi></mrow><annotation encoding="application/x-tex">\mathbb{P}(E_{i})\geq\nu</annotation></semantics></math>, and on <math id="A3.SS2.SSS1.p5.m3" class="ltx_Math" alttext="E_{i}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>i</mi></msub><annotation encoding="application/x-tex">E_{i}</annotation></semantics></math> we have both <math id="A3.SS2.SSS1.p5.m4" class="ltx_Math" alttext="Q(\mathbf{v}_{i})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">Q(\mathbf{v}_{i})=0</annotation></semantics></math> and</p>
<table id="A3.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex11.m1" class="ltx_Math" alttext="\displaystyle\frac{|\mathbf{g}_{i}|-\|\mathbf{g}\|_{\infty}/127}{\epsilon}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><msub><mi>𝐠</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>−</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝐠</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>/</mo><mn>127</mn></mrow></mrow><mi>ϵ</mi></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{|\mathbf{g}_{i}|-\|\mathbf{g}\|_{\infty}/127}{\epsilon}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex11.m2" class="ltx_Math" alttext="\displaystyle\geq\frac{\|\mathbf{g}\|_{\infty}/60-\|\mathbf{g}\|_{\infty}/127}{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝐠</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>/</mo><mn>60</mn></mrow><mo>−</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝐠</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>/</mo><mn>127</mn></mrow></mrow><mi>ϵ</mi></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\geq\frac{\|\mathbf{g}\|_{\infty}/60-\|\mathbf{g}\|_{\infty}/127}{\epsilon}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex12.m1" class="ltx_Math" alttext="\displaystyle\geq\frac{\|\mathbf{g}\|_{\infty}}{128\epsilon}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≥</mo><mstyle displaystyle="true"><mfrac><msub><mrow><mo stretchy="false">‖</mo><mi>𝐠</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mrow><mn>128</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq\frac{\|\mathbf{g}\|_{\infty}}{128\epsilon}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS2.SSS1.p6" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS1.p6.1" class="ltx_p">Since <math id="A3.SS2.SSS1.p6.m1" class="ltx_Math" alttext="\|\mathbf{g}\|_{\infty}\geq g_{\infty}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝐠</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≥</mo><msub><mi>g</mi><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\|\mathbf{g}\|_{\infty}\geq g_{\infty}</annotation></semantics></math> almost surely and <math id="A3.SS2.SSS1.p6.m2" class="ltx_Math" alttext="g_{\infty}\geq 256\epsilon" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi mathvariant="normal">∞</mi></msub><mo>≥</mo><mrow><mn>256</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow><annotation encoding="application/x-tex">g_{\infty}\geq 256\epsilon</annotation></semantics></math>,</p>
<table id="A3.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex13.m1" class="ltx_Math" alttext="\displaystyle\frac{\|\mathbf{g}\|_{\infty}}{128\epsilon}-1" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><msub><mrow><mo stretchy="false">‖</mo><mi>𝐠</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mrow><mn>128</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\|\mathbf{g}\|_{\infty}}{128\epsilon}-1</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex13.m2" class="ltx_Math" alttext="\displaystyle\geq\frac{g_{\infty}}{128\epsilon}-1" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>g</mi><mi mathvariant="normal">∞</mi></msub><mrow><mn>128</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\frac{g_{\infty}}{128\epsilon}-1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex14.m1" class="ltx_Math" alttext="\displaystyle\geq\frac{1}{2}\cdot\frac{g_{\infty}}{128\epsilon}=\frac{g_{\infty}}{256\epsilon}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≥</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><msub><mi>g</mi><mi mathvariant="normal">∞</mi></msub><mrow><mn>128</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><msub><mi>g</mi><mi mathvariant="normal">∞</mi></msub><mrow><mn>256</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq\frac{1}{2}\cdot\frac{g_{\infty}}{128\epsilon}=\frac{g_{\infty}}{256\epsilon}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.p6.2" class="ltx_p">Set <math id="A3.SS2.SSS1.p6.m3" class="ltx_Math" alttext="\tau_{0}:=\frac{g_{\infty}}{256\epsilon}" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mn>0</mn></msub><mo>:=</mo><mfrac><msub><mi>g</mi><mi mathvariant="normal">∞</mi></msub><mrow><mn>256</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">\tau_{0}:=\frac{g_{\infty}}{256\epsilon}</annotation></semantics></math>. Then, for <math id="A3.SS2.SSS1.p6.m4" class="ltx_Math" alttext="t=\tau_{0}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><msub><mi>τ</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">t=\tau_{0}</annotation></semantics></math>,</p>
<table id="A3.EGx10" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex15.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}\left(\left|\frac{\mathbf{m}_{i}}{\sqrt{\mathbf{v}_{i}}+\epsilon}-\frac{Q(\mathbf{m}_{i})}{\sqrt{Q(\mathbf{v}_{i})}+\epsilon}\right|\geq t\right)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>𝐦</mi><mi>i</mi></msub><mrow><msqrt><msub><mi>𝐯</mi><mi>i</mi></msub></msqrt><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐦</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msqrt><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mstyle></mrow><mo>|</mo></mrow><mo>≥</mo><mi>t</mi></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\left(\left|\frac{\mathbf{m}_{i}}{\sqrt{\mathbf{v}_{i}}+\epsilon}-\frac{Q(\mathbf{m}_{i})}{\sqrt{Q(\mathbf{v}_{i})}+\epsilon}\right|\geq t\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex15.m2" class="ltx_Math" alttext="\displaystyle\geq\mathbb{P}(E_{i})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\mathbb{P}(E_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex16.m1" class="ltx_Math" alttext="\displaystyle\geq\nu." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≥</mo><mi>ν</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq\nu.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.p6.3" class="ltx_p">Therefore, using <math id="A3.SS2.SSS1.p6.m5" class="ltx_Math" alttext="\mathbb{E}[X^{2}]\geq t^{2}\mathbb{P}(X\geq t)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>X</mi><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>≥</mo><mrow><msup><mi>t</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>≥</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[X^{2}]\geq t^{2}\mathbb{P}(X\geq t)</annotation></semantics></math> for nonnegative <math id="A3.SS2.SSS1.p6.m6" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>,</p>
<table id="A3.EGx11" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex17.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\left(\frac{\mathbf{m}_{i}}{\sqrt{\mathbf{v}_{i}}+\epsilon}-\frac{Q(\mathbf{m}_{i})}{\sqrt{Q(\mathbf{v}_{i})}+\epsilon}\right)^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>𝐦</mi><mi>i</mi></msub><mrow><msqrt><msub><mi>𝐯</mi><mi>i</mi></msub></msqrt><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐦</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msqrt><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\left(\frac{\mathbf{m}_{i}}{\sqrt{\mathbf{v}_{i}}+\epsilon}-\frac{Q(\mathbf{m}_{i})}{\sqrt{Q(\mathbf{v}_{i})}+\epsilon}\right)^{2}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex17.m2" class="ltx_Math" alttext="\displaystyle\geq\nu\,\tau_{0}^{2}=\nu\frac{g_{\infty}^{2}}{(256\epsilon)^{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≥</mo><mrow><mi>ν</mi><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>τ</mi><mn>0</mn><mn>2</mn></msubsup></mrow><mo>=</mo><mrow><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>g</mi><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>256</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq\nu\,\tau_{0}^{2}=\nu\frac{g_{\infty}^{2}}{(256\epsilon)^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.p6.4" class="ltx_p">Summing over <math id="A3.SS2.SSS1.p6.m7" class="ltx_Math" alttext="i=1,\dots,d" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">i=1,\dots,d</annotation></semantics></math> and using
<math id="A3.SS2.SSS1.p6.m8" class="ltx_Math" alttext="\bm{\theta}^{(1)}-\tilde{\bm{\theta}}^{(1)}=\alpha\!\left(\frac{\mathbf{m}}{\sqrt{\mathbf{v}}+\epsilon}-\frac{Q(\mathbf{m})}{\sqrt{Q(\mathbf{v})}+\epsilon}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mover accent="true"><mi>𝜽</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo>=</mo><mrow><mpadded style="width:0.473em;" width="0.473em"><mi>α</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mi>𝐦</mi><mrow><msqrt><mi>𝐯</mi></msqrt><mo>+</mo><mi>ϵ</mi></mrow></mfrac><mo>−</mo><mfrac><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐦</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msqrt><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐯</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\theta}^{(1)}-\tilde{\bm{\theta}}^{(1)}=\alpha\!\left(\frac{\mathbf{m}}{\sqrt{\mathbf{v}}+\epsilon}-\frac{Q(\mathbf{m})}{\sqrt{Q(\mathbf{v})}+\epsilon}\right)</annotation></semantics></math>,</p>
<table id="A3.EGx12" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex18.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\|\bm{\theta}^{(1)}-\tilde{\bm{\theta}}^{(1)}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mover accent="true"><mi>𝜽</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\|\bm{\theta}^{(1)}-\tilde{\bm{\theta}}^{(1)}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex18.m2" class="ltx_Math" alttext="\displaystyle\geq\alpha^{2}d\nu\frac{g_{\infty}^{2}}{(256\epsilon)^{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≥</mo><mrow><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>g</mi><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>256</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq\alpha^{2}d\nu\frac{g_{\infty}^{2}}{(256\epsilon)^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div><span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
</section>
<section id="A3.SS2.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">C.2.2 </span>Proof of Theorem <a href="#Thmtheorem2" title="Theorem 2 ‣ 4.2 The curious case of 8-bit SGD with momentum ‣ 4 Methods ‣ Effective Quantization of Muon Optimizer States" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a></h4>

<div id="A3.SS2.SSS2.p1" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS2.p1.1" class="ltx_p"><span id="A3.SS2.SSS2.p1.1.1" class="ltx_text ltx_font_bold">Proof </span>
We compare the two updates and isolate the effect of quantizing the momentum. The gradient terms cancel, leaving</p>
<table id="A3.EGx13" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex19.m1" class="ltx_Math" alttext="\displaystyle\tilde{\bm{\theta}}^{(t+1)}-\bm{\theta}^{(t+1)}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>𝜽</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{\bm{\theta}}^{(t+1)}-\bm{\theta}^{(t+1)}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex19.m2" class="ltx_Math" alttext="\displaystyle=-\eta(\mathbf{g}^{(t)}+\rho Q(\mathbf{m}^{(t)}))+\eta(\mathbf{g}^{(t)}+\rho\mathbf{m}^{(t)})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐠</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>+</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐦</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐠</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>+</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐦</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\eta(\mathbf{g}^{(t)}+\rho Q(\mathbf{m}^{(t)}))+\eta(\mathbf{g}^{(t)}+\rho\mathbf{m}^{(t)})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex20.m1" class="ltx_Math" alttext="\displaystyle=-\eta\rho\,(Q(\mathbf{m}^{(t)})-\mathbf{m}^{(t)})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐦</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi>𝐦</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=-\eta\rho\,(Q(\mathbf{m}^{(t)})-\mathbf{m}^{(t)}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS2.p1.2" class="ltx_p">Taking squared norms and expanding coordinatewise yields</p>
<table id="A3.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex21.m1" class="ltx_Math" alttext="\displaystyle\|\tilde{\bm{\theta}}^{(t+1)}-\bm{\theta}^{(t+1)}\|_{2}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝜽</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><annotation encoding="application/x-tex">\displaystyle\|\tilde{\bm{\theta}}^{(t+1)}-\bm{\theta}^{(t+1)}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex21.m2" class="ltx_Math" alttext="\displaystyle=\eta^{2}\rho^{2}\sum_{i=1}^{d}\left(Q(\mathbf{m}^{(t)})_{i}-\mathbf{m}_{i}^{(t)}\right)^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><msup><mrow><mo>(</mo><mrow><mrow><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msup><mi>𝐦</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mi>i</mi></msub></mrow><mo>−</mo><msubsup><mi>𝐦</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\eta^{2}\rho^{2}\sum_{i=1}^{d}\left(Q(\mathbf{m}^{(t)})_{i}-\mathbf{m}_{i}^{(t)}\right)^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS2.p1.3" class="ltx_p">By Definition <a href="#Thmdefinition1" title="Definition 1 ‣ C.1 Quantization Operator ‣ Appendix C Quantization Error Bounds ‣ Effective Quantization of Muon Optimizer States" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, each coordinate is perturbed by at most <math id="A3.SS2.SSS2.p1.m1" class="ltx_Math" alttext="\|\mathbf{m}^{(t)}\|_{\infty}/127" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mi>𝐦</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>/</mo><mn>127</mn></mrow><annotation encoding="application/x-tex">\|\mathbf{m}^{(t)}\|_{\infty}/127</annotation></semantics></math>, i.e., <math id="A3.SS2.SSS2.p1.m2" class="ltx_Math" alttext="|Q(\mathbf{m}^{(t)})_{i}-\mathbf{m}_{i}^{(t)}|\leq\|\mathbf{m}^{(t)}\|_{\infty}/127" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msup><mi>𝐦</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mi>i</mi></msub></mrow><mo>−</mo><msubsup><mi>𝐦</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mi>𝐦</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>/</mo><mn>127</mn></mrow></mrow><annotation encoding="application/x-tex">|Q(\mathbf{m}^{(t)})_{i}-\mathbf{m}_{i}^{(t)}|\leq\|\mathbf{m}^{(t)}\|_{\infty}/127</annotation></semantics></math>. Applying this inside the sum gives</p>
<table id="A3.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex22.m1" class="ltx_Math" alttext="\displaystyle\|\tilde{\bm{\theta}}^{(t+1)}-\bm{\theta}^{(t+1)}\|_{2}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝜽</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><annotation encoding="application/x-tex">\displaystyle\|\tilde{\bm{\theta}}^{(t+1)}-\bm{\theta}^{(t+1)}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex22.m2" class="ltx_Math" alttext="\displaystyle\leq\eta^{2}\rho^{2}\sum_{i=1}^{d}\left(\|\mathbf{m}^{(t)}\|_{\infty}/127\right)^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><msup><mrow><mo>(</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mi>𝐦</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>/</mo><mn>127</mn></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\eta^{2}\rho^{2}\sum_{i=1}^{d}\left(\|\mathbf{m}^{(t)}\|_{\infty}/127\right)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex23.m1" class="ltx_Math" alttext="\displaystyle=d\,\eta^{2}\rho^{2}\left(\|\mathbf{m}^{(t)}\|_{\infty}/127\right)^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>d</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mi>𝐦</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>/</mo><mn>127</mn></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=d\,\eta^{2}\rho^{2}\left(\|\mathbf{m}^{(t)}\|_{\infty}/127\right)^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS2.p1.4" class="ltx_p">which is the claimed bound.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
</section>
<section id="A3.SS2.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">C.2.3 </span>Proof of Theorem <a href="#Thmtheorem3" title="Theorem 3 ‣ 4.3 The 8-bit Muon algorithm ‣ 4 Methods ‣ Effective Quantization of Muon Optimizer States" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a></h4>

<div id="A3.SS2.SSS3.p1" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS3.p1.1" class="ltx_p"><span id="A3.SS2.SSS3.p1.1.1" class="ltx_text ltx_font_bold">Proof </span>
From the two updates,</p>
<table id="A3.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex24.m1" class="ltx_Math" alttext="\widetilde{\mathbf{W}}^{(t)}-\mathbf{W}^{(t)}\;=\;-\alpha\big(\widetilde{\mathbf{O}}^{(t)}-\mathbf{O}^{(t)}\big)\quad\Rightarrow\quad\|\widetilde{\mathbf{W}}^{(t)}-\mathbf{W}^{(t)}\|_{\mathrm{F}}\;=\;\alpha\,\|\widetilde{\mathbf{O}}^{(t)}-\mathbf{O}^{(t)}\|_{\mathrm{F}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msup><mover accent="true"><mi>𝐖</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝐖</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo rspace="0.558em">=</mo><mrow><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msup><mover accent="true"><mi>𝐎</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝐎</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mo stretchy="false">⇒</mo><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝐖</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝐖</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo rspace="0.558em">=</mo><mrow><mi>α</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝐎</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝐎</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widetilde{\mathbf{W}}^{(t)}-\mathbf{W}^{(t)}\;=\;-\alpha\big(\widetilde{\mathbf{O}}^{(t)}-\mathbf{O}^{(t)}\big)\quad\Rightarrow\quad\|\widetilde{\mathbf{W}}^{(t)}-\mathbf{W}^{(t)}\|_{\mathrm{F}}\;=\;\alpha\,\|\widetilde{\mathbf{O}}^{(t)}-\mathbf{O}^{(t)}\|_{\mathrm{F}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS3.p1.2" class="ltx_p">The momentum matrices <math id="A3.SS2.SSS3.p1.m1" class="ltx_Math" alttext="\mathbf{M}^{(t)}" display="inline" intent=":literal"><semantics><msup><mi>𝐌</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\mathbf{M}^{(t)}</annotation></semantics></math> and <math id="A3.SS2.SSS3.p1.m2" class="ltx_Math" alttext="\widetilde{\mathbf{M}}^{(t)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝐌</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\widetilde{\mathbf{M}}^{(t)}</annotation></semantics></math> are assumed to be full column rank with
<math id="A3.SS2.SSS3.p1.m3" class="ltx_Math" alttext="\sigma_{\min}(\mathbf{M}^{(t)}),\sigma_{\min}(\widetilde{\mathbf{M}}^{(t)})\geq s&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>σ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐌</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mrow><msub><mi>σ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐌</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mi>s</mi><mo>&gt;</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">\sigma_{\min}(\mathbf{M}^{(t)}),\sigma_{\min}(\widetilde{\mathbf{M}}^{(t)})\geq s&gt;0</annotation></semantics></math>.
For full-column-rank matrices, the (rectangular) polar-factor map satisfies</p>
<table id="A3.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex25.m1" class="ltx_Math" alttext="\|\widetilde{\mathbf{O}}^{(t)}-\mathbf{O}^{(t)}\|_{\mathrm{F}}\;\leq\;\frac{2}{\sigma_{\min}(\mathbf{M}^{(t)})+\sigma_{\min}(\widetilde{\mathbf{M}}^{(t)})}\,\|\widetilde{\mathbf{M}}^{(t)}-\mathbf{M}^{(t)}\|_{\mathrm{F}}\;\leq\;\frac{1}{s}\,\|\widetilde{\mathbf{M}}^{(t)}-\mathbf{M}^{(t)}\|_{\mathrm{F}}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝐎</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝐎</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo lspace="0.558em" rspace="0.558em">≤</mo><mrow><mfrac><mn>2</mn><mrow><mrow><msub><mi>σ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐌</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>σ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐌</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝐌</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝐌</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow><mo rspace="0.558em">≤</mo><mrow><mfrac><mn>1</mn><mi>s</mi></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝐌</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝐌</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\|\widetilde{\mathbf{O}}^{(t)}-\mathbf{O}^{(t)}\|_{\mathrm{F}}\;\leq\;\frac{2}{\sigma_{\min}(\mathbf{M}^{(t)})+\sigma_{\min}(\widetilde{\mathbf{M}}^{(t)})}\,\|\widetilde{\mathbf{M}}^{(t)}-\mathbf{M}^{(t)}\|_{\mathrm{F}}\;\leq\;\frac{1}{s}\,\|\widetilde{\mathbf{M}}^{(t)}-\mathbf{M}^{(t)}\|_{\mathrm{F}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS3.p1.3" class="ltx_p">(see <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib7" title="" class="ltx_ref">Bhatia, 2013</a>, Thm. VII.5.1(a))</cite> and its extension to full column
rank in <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib28" title="" class="ltx_ref">Li, 1995</a>, Thm. 2)</cite>). Hence</p>
<table id="A3.Ex26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex26.m1" class="ltx_Math" alttext="\|\widetilde{\mathbf{W}}^{(t)}-\mathbf{W}^{(t)}\|_{\mathrm{F}}\;\leq\;\alpha\,\frac{1}{s}\,\|\widetilde{\mathbf{M}}^{(t)}-\mathbf{M}^{(t)}\|_{\mathrm{F}}\;=\;\alpha\,\frac{\beta}{s}\,\|Q(\mathbf{M}^{(t-1)})-\mathbf{M}^{(t-1)}\|_{\mathrm{F}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝐖</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝐖</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo lspace="0.558em" rspace="0.558em">≤</mo><mrow><mi>α</mi><mo lspace="0.170em" rspace="0em">​</mo><mfrac><mn>1</mn><mi>s</mi></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝐌</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝐌</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow><mo rspace="0.558em">=</mo><mrow><mi>α</mi><mo lspace="0.170em" rspace="0em">​</mo><mfrac><mi>β</mi><mi>s</mi></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐌</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi>𝐌</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\widetilde{\mathbf{W}}^{(t)}-\mathbf{W}^{(t)}\|_{\mathrm{F}}\;\leq\;\alpha\,\frac{1}{s}\,\|\widetilde{\mathbf{M}}^{(t)}-\mathbf{M}^{(t)}\|_{\mathrm{F}}\;=\;\alpha\,\frac{\beta}{s}\,\|Q(\mathbf{M}^{(t-1)})-\mathbf{M}^{(t-1)}\|_{\mathrm{F}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS3.p1.4" class="ltx_p">By Definition <a href="#Thmdefinition1" title="Definition 1 ‣ C.1 Quantization Operator ‣ Appendix C Quantization Error Bounds ‣ Effective Quantization of Muon Optimizer States" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>,
each entry changes by at most <math id="A3.SS2.SSS3.p1.m4" class="ltx_Math" alttext="\|\operatorname{vec}(\mathbf{M}^{(t-1)})\|_{\infty}/127" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐌</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>/</mo><mn>127</mn></mrow><annotation encoding="application/x-tex">\|\operatorname{vec}(\mathbf{M}^{(t-1)})\|_{\infty}/127</annotation></semantics></math>, so
<math id="A3.SS2.SSS3.p1.m5" class="ltx_Math" alttext="\|Q(\mathbf{M}^{(t-1)})-\mathbf{M}^{(t-1)}\|_{\mathrm{F}}^{2}\leq d\big(\|\operatorname{vec}(\mathbf{M}^{(t-1)})\|_{\infty}/127\big)^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐌</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi>𝐌</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo>≤</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐌</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>/</mo><mn>127</mn></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|Q(\mathbf{M}^{(t-1)})-\mathbf{M}^{(t-1)}\|_{\mathrm{F}}^{2}\leq d\big(\|\operatorname{vec}(\mathbf{M}^{(t-1)})\|_{\infty}/127\big)^{2}.</annotation></semantics></math>
Squaring both sides completes the proof.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
</section>
</section>
<section id="A3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.3 </span>Adam algorithm</h3>

<div id="A3.SS3.p1" class="ltx_para ltx_noindent">
<p id="A3.SS3.p1.1" class="ltx_p">For completeness, we reproduce the base Adam algorithm below (Algorithm 1 in <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib26" title="" class="ltx_ref">Kingma (2014)</a></cite>).</p>
</div>
<figure id="alg4" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg4.3" class="ltx_text ltx_font_bold">Algorithm 4</span> </span> Adam (using <math id="alg4.m2" class="ltx_Math" alttext="\bm{\theta},\mathbf{g},\mathbf{m},\mathbf{v}" display="inline" intent=":literal"><semantics><mrow><mi>𝜽</mi><mo>,</mo><mi>𝐠</mi><mo>,</mo><mi>𝐦</mi><mo>,</mo><mi>𝐯</mi></mrow><annotation encoding="application/x-tex">\bm{\theta},\mathbf{g},\mathbf{m},\mathbf{v}</annotation></semantics></math>)</figcaption>
<div id="alg4.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg4.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">1:</span>
              
              
            <span id="alg4.l1.2" class="ltx_text ltx_font_bold">Input:</span> step size <math id="alg4.l1.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>, decay rates <math id="alg4.l1.m2" class="ltx_Math" alttext="\beta_{1},\beta_{2}\in[0,1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta_{1},\beta_{2}\in[0,1)</annotation></semantics></math>, <math id="alg4.l1.m3" class="ltx_Math" alttext="\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon&gt;0</annotation></semantics></math>

</div>
<div id="alg4.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">2:</span>
              
              
            <span id="alg4.l2.2" class="ltx_text ltx_font_bold">Initialize:</span> <math id="alg4.l2.m1" class="ltx_Math" alttext="\bm{\theta}^{(0)}" display="inline" intent=":literal"><semantics><msup><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\bm{\theta}^{(0)}</annotation></semantics></math>, <math id="alg4.l2.m2" class="ltx_Math" alttext="\tilde{\mathbf{m}}^{(0)}=\mathbf{0}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>𝐦</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mn>𝟎</mn></mrow><annotation encoding="application/x-tex">\tilde{\mathbf{m}}^{(0)}=\mathbf{0}</annotation></semantics></math>, <math id="alg4.l2.m3" class="ltx_Math" alttext="\tilde{\mathbf{v}}^{(0)}=\mathbf{0}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>𝐯</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mn>𝟎</mn></mrow><annotation encoding="application/x-tex">\tilde{\mathbf{v}}^{(0)}=\mathbf{0}</annotation></semantics></math>

</div>
<div id="alg4.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">3:</span>
              
              
            <span id="alg4.l3.2" class="ltx_text ltx_font_bold">for</span> <math id="alg4.l3.m1" class="ltx_Math" alttext="t=1,2,\dots" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">t=1,2,\dots</annotation></semantics></math> <span id="alg4.l3.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg4.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">4:</span>
              
              
              <math id="alg4.l4.m1" class="ltx_Math" alttext="\mathbf{g}^{(t)}\leftarrow\nabla f_{t}(\bm{\theta}^{(t-1)})" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐠</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">←</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{g}^{(t)}\leftarrow\nabla f_{t}(\bm{\theta}^{(t-1)})</annotation></semantics></math>

</div>
<div id="alg4.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">5:</span>
              
              
              <math id="alg4.l5.m1" class="ltx_Math" alttext="\tilde{\mathbf{m}}^{(t)}\leftarrow\beta_{1}\tilde{\mathbf{m}}^{(t-1)}+(1-\beta_{1})\mathbf{g}^{(t)}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>𝐦</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">←</mo><mrow><mrow><msub><mi>β</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐦</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐠</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{\mathbf{m}}^{(t)}\leftarrow\beta_{1}\tilde{\mathbf{m}}^{(t-1)}+(1-\beta_{1})\mathbf{g}^{(t)}</annotation></semantics></math>

</div>
<div id="alg4.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">6:</span>
              
              
              <math id="alg4.l6.m1" class="ltx_Math" alttext="\tilde{\mathbf{v}}^{(t)}\leftarrow\beta_{2}\tilde{\mathbf{v}}^{(t-1)}+(1-\beta_{2})\,(\mathbf{g}^{(t)})^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>𝐯</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">←</mo><mrow><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐯</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐠</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{\mathbf{v}}^{(t)}\leftarrow\beta_{2}\tilde{\mathbf{v}}^{(t-1)}+(1-\beta_{2})\,(\mathbf{g}^{(t)})^{2}</annotation></semantics></math>

</div>
<div id="alg4.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">7:</span>
              
              
              <math id="alg4.l7.m1" class="ltx_Math" alttext="\mathbf{m}^{(t)}\leftarrow\tilde{\mathbf{m}}^{(t)}/(1-\beta_{1}^{t})" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐦</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">←</mo><mrow><msup><mover accent="true"><mi>𝐦</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msubsup><mi>β</mi><mn>1</mn><mi>t</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{m}^{(t)}\leftarrow\tilde{\mathbf{m}}^{(t)}/(1-\beta_{1}^{t})</annotation></semantics></math>

</div>
<div id="alg4.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">8:</span>
              
              
              <math id="alg4.l8.m1" class="ltx_Math" alttext="\mathbf{v}^{(t)}\leftarrow\tilde{\mathbf{v}}^{(t)}/(1-\beta_{2}^{t})" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐯</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">←</mo><mrow><msup><mover accent="true"><mi>𝐯</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msubsup><mi>β</mi><mn>2</mn><mi>t</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{v}^{(t)}\leftarrow\tilde{\mathbf{v}}^{(t)}/(1-\beta_{2}^{t})</annotation></semantics></math>

</div>
<div id="alg4.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">9:</span>
              
              
              <math id="alg4.l9.m1" class="ltx_Math" alttext="\bm{\theta}^{(t)}\leftarrow\bm{\theta}^{(t-1)}-\alpha\,\mathbf{m}^{(t)}\big/(\sqrt{\mathbf{v}^{(t)}}+\epsilon)" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">←</mo><mrow><msup><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mrow><mrow><mi>α</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>𝐦</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true" symmetric="true">/</mo><mrow><mo stretchy="false">(</mo><mrow><msqrt><msup><mi>𝐯</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></msqrt><mo>+</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\theta}^{(t)}\leftarrow\bm{\theta}^{(t-1)}-\alpha\,\mathbf{m}^{(t)}\big/(\sqrt{\mathbf{v}^{(t)}}+\epsilon)</annotation></semantics></math>

</div>
<div id="alg4.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">10:</span>
              
              
            <span id="alg4.l10.2" class="ltx_text ltx_font_bold">end</span> <span id="alg4.l10.3" class="ltx_text ltx_font_bold">for</span>
</div>
</div>
</figure>
</section>
<section id="A3.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.4 </span>Exact Muon optimizer</h3>

<div id="A3.SS4.p1" class="ltx_para ltx_noindent">
<p id="A3.SS4.p1.1" class="ltx_p">For completeness, we provide the update formula for the exact Muon algorithm (without weight decay) here. As opposed to eqn. (<a href="#S3.E1" title="In 3.2 The Muon algorithm ‣ 3 Background ‣ Effective Quantization of Muon Optimizer States" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>), this formula uses the exact polar factor <math id="A3.SS4.p1.m1" class="ltx_Math" alttext="\mathbf{O}=\mathbf{U}^{(t)}\mathbf{V}^{(t)\top}" display="inline" intent=":literal"><semantics><mrow><mi>𝐎</mi><mo>=</mo><mrow><msup><mi>𝐔</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐕</mi><mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{O}=\mathbf{U}^{(t)}\mathbf{V}^{(t)\top}</annotation></semantics></math></p>
</div>
<div id="A3.SS4.p2" class="ltx_para ltx_noindent">
<table id="A3.E4" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A3.E4X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E4X.m2" class="ltx_Math" alttext="\displaystyle\mathbf{M}^{(t)}" display="inline" intent=":literal"><semantics><msup><mi>𝐌</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\displaystyle\mathbf{M}^{(t)}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E4X.m3" class="ltx_Math" alttext="\displaystyle:=\beta\,\mathbf{M}^{(t-1)}+\mathbf{G}_{t}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>β</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>𝐌</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><mo>+</mo><msub><mi>𝐆</mi><mi>t</mi></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\beta\,\mathbf{M}^{(t-1)}+\mathbf{G}_{t},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(4)</span></td></tr>
<tr id="A3.E4Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E4Xa.m2" class="ltx_Math" alttext="\displaystyle\mathbf{M}^{(t)}" display="inline" intent=":literal"><semantics><msup><mi>𝐌</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\displaystyle\mathbf{M}^{(t)}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E4Xa.m3" class="ltx_Math" alttext="\displaystyle=\mathbf{U}^{(t)}\mathbf{S}^{(t)}\mathbf{V}^{(t)\!\top}\ \text{(thin SVD)}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>𝐔</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐒</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐕</mi><mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.102em">⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mtext>(thin SVD)</mtext></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbf{U}^{(t)}\mathbf{S}^{(t)}\mathbf{V}^{(t)\!\top}\ \text{(thin SVD)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A3.E4Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E4Xb.m2" class="ltx_Math" alttext="\displaystyle\mathbf{O}^{(t)}" display="inline" intent=":literal"><semantics><msup><mi>𝐎</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\displaystyle\mathbf{O}^{(t)}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E4Xb.m3" class="ltx_Math" alttext="\displaystyle:=\mathbf{U}^{(t)}\mathbf{V}^{(t)\!\top}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>𝐔</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐕</mi><mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.102em">⊤</mo></mrow></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\mathbf{U}^{(t)}\mathbf{V}^{(t)\!\top},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A3.E4Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E4Xc.m2" class="ltx_Math" alttext="\displaystyle\mathbf{W}^{(t)}" display="inline" intent=":literal"><semantics><msup><mi>𝐖</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\displaystyle\mathbf{W}^{(t)}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E4Xc.m3" class="ltx_Math" alttext="\displaystyle=\mathbf{W}^{(t-1)}-\alpha\,\mathbf{O}^{(t)}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>𝐖</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mrow><mi>α</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>𝐎</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbf{W}^{(t-1)}-\alpha\,\mathbf{O}^{(t)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS4.p3" class="ltx_para ltx_noindent">
<p id="A3.SS4.p3.2" class="ltx_p">In the quantized variant, only the previous momentum is quantized and then de-quantized, leading to the following updates where <math id="A3.SS4.p3.m1" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> is defined in Definition <a href="#Thmdefinition1" title="Definition 1 ‣ C.1 Quantization Operator ‣ Appendix C Quantization Error Bounds ‣ Effective Quantization of Muon Optimizer States" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>:</p>
<table id="A3.E5" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A3.E5X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E5X.m2" class="ltx_Math" alttext="\displaystyle\widetilde{\mathbf{M}}^{(t)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝐌</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\displaystyle\widetilde{\mathbf{M}}^{(t)}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E5X.m3" class="ltx_Math" alttext="\displaystyle:=\beta\,Q\!\big(\mathbf{M}^{(t-1)}\big)+\mathbf{G}_{t}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>β</mi><mo lspace="0.170em" rspace="0em">​</mo><mpadded style="width:0.621em;" width="0.621em"><mi>Q</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msup><mi>𝐌</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>+</mo><msub><mi>𝐆</mi><mi>t</mi></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\beta\,Q\!\big(\mathbf{M}^{(t-1)}\big)+\mathbf{G}_{t},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(5)</span></td></tr>
<tr id="A3.E5Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E5Xa.m2" class="ltx_Math" alttext="\displaystyle\widetilde{\mathbf{M}}^{(t)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝐌</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\displaystyle\widetilde{\mathbf{M}}^{(t)}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E5Xa.m3" class="ltx_Math" alttext="\displaystyle=\widetilde{\mathbf{U}}^{(t)}\widetilde{\mathbf{S}}^{(t)}\widetilde{\mathbf{V}}^{(t)\!\top}\ \text{(thin SVD)}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mover accent="true"><mi>𝐔</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐒</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐕</mi><mo>~</mo></mover><mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.102em">⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mtext>(thin SVD)</mtext></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\widetilde{\mathbf{U}}^{(t)}\widetilde{\mathbf{S}}^{(t)}\widetilde{\mathbf{V}}^{(t)\!\top}\ \text{(thin SVD)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A3.E5Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
