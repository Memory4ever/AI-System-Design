<tr id="S4.T2.2.8" class="ltx_tr">
<td id="S4.T2.2.8.1" class="ltx_td ltx_align_center ltx_border_r">Step</td>
<td id="S4.T2.2.8.2" class="ltx_td ltx_align_right">42.39</td>
<td id="S4.T2.2.8.3" class="ltx_td ltx_align_right">40.95</td>
