<td id="S4.T3.3.7.6" class="ltx_td ltx_align_right">0.075</td>
<td id="S4.T3.3.7.7" class="ltx_td ltx_align_right">0.077</td>
<td id="S4.T3.3.7.8" class="ltx_td ltx_align_right">0.078</td></tr>
<tr id="S4.T3.3.8" class="ltx_tr">
<td id="S4.T3.3.8.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">Pass%</td>
<td id="S4.T3.3.8.2" class="ltx_td ltx_align_right ltx_border_t">59</td>
<td id="S4.T3.3.8.3" class="ltx_td ltx_align_right ltx_border_t">62</td>
<td id="S4.T3.3.8.4" class="ltx_td ltx_align_right ltx_border_t">65</td>
<td id="S4.T3.3.8.5" class="ltx_td ltx_align_right ltx_border_r ltx_border_t">66</td>
<td id="S4.T3.3.8.6" class="ltx_td ltx_align_right ltx_border_t">64</td>
<td id="S4.T3.3.8.7" class="ltx_td ltx_align_right ltx_border_t">65</td>
<td id="S4.T3.3.8.8" class="ltx_td ltx_align_right ltx_border_t">65</td></tr>
<tr id="S4.T3.3.9" class="ltx_tr">
<td id="S4.T3.3.9.1" class="ltx_td ltx_align_center ltx_border_r">Step</td>
<td id="S4.T3.3.9.2" class="ltx_td ltx_align_right">44.94</td>
<td id="S4.T3.3.9.3" class="ltx_td ltx_align_right">39.13</td>
<td id="S4.T3.3.9.4" class="ltx_td ltx_align_right">38.90</td>
<td id="S4.T3.3.9.5" class="ltx_td ltx_align_right ltx_border_r">40.25</td>
<td id="S4.T3.3.9.6" class="ltx_td ltx_align_right">40.31</td>
<td id="S4.T3.3.9.7" class="ltx_td ltx_align_right">38.90</td>
<td id="S4.T3.3.9.8" class="ltx_td ltx_align_right">39.32</td></tr>
<tr id="S4.T3.3.10" class="ltx_tr">
<td id="S4.T3.3.10.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r">PStep</td>
<td id="S4.T3.3.10.2" class="ltx_td ltx_align_right ltx_border_bb">43.59</td>
<td id="S4.T3.3.10.3" class="ltx_td ltx_align_right ltx_border_bb">37.73</td>
<td id="S4.T3.3.10.4" class="ltx_td ltx_align_right ltx_border_bb">37.34</td>
<td id="S4.T3.3.10.5" class="ltx_td ltx_align_right ltx_border_bb ltx_border_r">40.06</td>
