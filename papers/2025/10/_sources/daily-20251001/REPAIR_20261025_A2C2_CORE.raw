<td id="A1.T6.2.7.2" class="ltx_td ltx_align_center"><math id="A1.T6.m6" class="ltx_Math" alttext="8" display="inline" intent=":literal"><semantics><mn>8</mn><annotation encoding="application/x-tex">8</annotation></semantics></math></td></tr>
<tr id="A1.T6.2.8" class="ltx_tr">
