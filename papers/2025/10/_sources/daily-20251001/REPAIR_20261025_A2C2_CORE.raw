<td id="A1.T6.2.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="A1.T6.m1" class="ltx_Math" alttext="1\times 10^{-5}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>5</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1\times 10^{-5}</annotation></semantics></math> (constant)</td></tr>
<tr id="A1.T6.2.3" class="ltx_tr">
<th id="A1.T6.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Batch size</th>
<td id="A1.T6.2.3.2" class="ltx_td ltx_align_center"><math id="A1.T6.m2" class="ltx_Math" alttext="64" display="inline" intent=":literal"><semantics><mn>64</mn><annotation encoding="application/x-tex">64</annotation></semantics></math></td></tr>
<tr id="A1.T6.2.4" class="ltx_tr">
