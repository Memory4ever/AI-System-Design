<td id="S4.T1.2.1.2.1" class="ltx_td ltx_border_r"></td>
<td id="S4.T1.2.1.2.2" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T1.2.1.2.2.1" class="ltx_text ltx_font_italic">Models</span></td>
<td id="S4.T1.2.1.2.3" class="ltx_td ltx_align_center">val (U)</td>
<td id="S4.T1.2.1.2.4" class="ltx_td ltx_align_center">test (U)</td>
<td id="S4.T1.2.1.2.5" class="ltx_td ltx_align_center ltx_border_r">val (G)</td>
<td id="S4.T1.2.1.2.6" class="ltx_td ltx_align_center">val</td>
<td id="S4.T1.2.1.2.7" class="ltx_td ltx_align_center">testA</td>
<td id="S4.T1.2.1.2.8" class="ltx_td ltx_align_center ltx_border_r">testB</td>
<td id="S4.T1.2.1.2.9" class="ltx_td ltx_align_center">val</td>
<td id="S4.T1.2.1.2.10" class="ltx_td ltx_align_center">testA</td>
