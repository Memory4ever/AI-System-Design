<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(a) </span>Exit Layer</figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S4.F9.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.23098v1/threshold_vitb16.svg" id="S4.F9.sf2.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:548/466;" width="548" height="466"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(b) </span>Threshold</figcaption>
