<td id="A3.T7.2.1.17.6" class="ltx_td ltx_align_center ltx_border_bb"><span id="A3.T7.2.1.17.6.1" class="ltx_text" style="--ltx-bg-color:#E6FFFF;">55.95</span></td>
<td id="A3.T7.2.1.17.7" class="ltx_td ltx_align_center ltx_border_bb"><span id="A3.T7.2.1.17.7.1" class="ltx_text" style="--ltx-bg-color:#E6FFFF;">65.45</span></td>
