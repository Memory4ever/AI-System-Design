<span id="S3.p5.1.2.3.3" class="ltx_td ltx_align_center ltx_border_r">3.146 (3.00)</span>
<span id="S3.p5.1.2.3.4" class="ltx_td ltx_align_center ltx_border_r"><math id="S3.p5.m5" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo>∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math>15G</span>
<span id="S3.p5.1.2.3.5" class="ltx_td ltx_align_center ltx_border_r"><math id="S3.p5.m6" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo>∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math>73G</span>
<span id="S3.p5.1.2.3.6" class="ltx_td ltx_align_center ltx_border_r"><math id="S3.p5.m7" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo>∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math>18 hours</span>
<span id="S3.p5.1.2.3.7" class="ltx_td ltx_align_center ltx_border_r"><math id="S3.p5.m8" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo>∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math>70k/s</span></span>
