<td id="S5.T4.2.1.2.4" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">37.60</td></tr>
<tr id="S5.T4.2.1.3" class="ltx_tr">
<th id="S5.T4.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S5.T4.2.1.3.1.1" class="ltx_text ltx_font_bold">AdvChain (Ours)</span></th>
