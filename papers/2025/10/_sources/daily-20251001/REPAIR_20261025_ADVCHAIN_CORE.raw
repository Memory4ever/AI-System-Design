<td id="S5.T4.2.1.3.3" class="ltx_td ltx_align_center">49.33</td>
<td id="S5.T4.2.1.3.4" class="ltx_td ltx_nopad_r ltx_align_center">36.50</td></tr>
<tr id="S5.T4.2.1.4" class="ltx_tr">
