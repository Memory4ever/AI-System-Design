<span id="A10.SS2.p4.pic1.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A10.SS2.p4.pic1.p1.pic1" class="ltx_picture" color="#000000" height="83.2" overflow="visible" version="1.1" viewBox="0 0 497.96 83.2" width="497.96"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,83.2) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#BFBFBF;" fill="#BFBFBF" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 77.3 C 0 80.56 2.64 83.2 5.91 83.2 L 492.06 83.2 C 495.32 83.2 497.96 80.56 497.96 77.3 L 497.96 5.91 C 497.96 2.64 495.32 0 492.06 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 39.33 L 495.99 39.33 L 495.99 5.91 C 495.99 3.73 494.23 1.97 492.06 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 24.63 48.22)"><foreignObject style="--ltx-fo-width:28.2em;--ltx-fo-height:1.89em;--ltx-fo-depth:0em;font-size:10pt;" height="26.1" overflow="visible" transform="matrix(1 0 0 -1 0 26.1)" width="390.21"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
