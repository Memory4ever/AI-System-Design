<td id="S4.T1.10.1.8.11" class="ltx_td ltx_align_center ltx_border_b" style="padding:1pt 5.0pt;"><span id="S4.T1.10.1.8.11.1" class="ltx_text ltx_font_bold">0.99</span></td>
<td id="S4.T1.10.1.8.12" class="ltx_td ltx_align_center ltx_border_b" style="padding:1pt 5.0pt;">2.15</td>
