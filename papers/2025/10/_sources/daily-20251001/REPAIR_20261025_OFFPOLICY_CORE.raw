<td id="A2.T1.5.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:-0.25pt 4.5pt;">Learning rate</td>
<td id="A2.T1.5.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.25pt 4.5pt;"><math id="A2.T1.m1" class="ltx_Math" alttext="1\!\times\!10^{-6}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>6</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1\!\times\!10^{-6}</annotation></semantics></math></td>
<td id="A2.T1.5.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.25pt 4.5pt;"><math id="A2.T1.m2" class="ltx_Math" alttext="1\!\times\!10^{-6}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>6</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1\!\times\!10^{-6}</annotation></semantics></math></td>
<td id="A2.T1.5.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.25pt 4.5pt;"><math id="A2.T1.m3" class="ltx_Math" alttext="1\!\times\!10^{-6}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>6</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1\!\times\!10^{-6}</annotation></semantics></math></td>
<td id="A2.T1.5.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.25pt 4.5pt;"><math id="A2.T1.m4" class="ltx_Math" alttext="5\!\times\!10^{-7}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>7</mn></mrow></msup></mrow><annotation encoding="application/x-tex">5\!\times\!10^{-7}</annotation></semantics></math></td></tr>
<tr id="A2.T1.5.3" class="ltx_tr">
<td id="A2.T1.5.3.1" class="ltx_td ltx_align_left" style="padding:-0.25pt 4.5pt;">Batch size</td>
<td id="A2.T1.5.3.2" class="ltx_td ltx_align_center" style="padding:-0.25pt 4.5pt;">96</td>
<td id="A2.T1.5.3.3" class="ltx_td ltx_align_center" style="padding:-0.25pt 4.5pt;">96</td>
<td id="A2.T1.5.3.4" class="ltx_td ltx_align_center" style="padding:-0.25pt 4.5pt;">64</td>
<td id="A2.T1.5.3.5" class="ltx_td ltx_align_center" style="padding:-0.25pt 4.5pt;">64</td></tr>
<tr id="A2.T1.5.4" class="ltx_tr">
<td id="A2.T1.5.4.1" class="ltx_td ltx_align_left" style="padding:-0.25pt 4.5pt;"><math id="A2.T1.m5" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math></td>
<td id="A2.T1.5.4.2" class="ltx_td ltx_align_center" style="padding:-0.25pt 4.5pt;">8</td>
<td id="A2.T1.5.4.3" class="ltx_td ltx_align_center" style="padding:-0.25pt 4.5pt;">8</td>
<td id="A2.T1.5.4.4" class="ltx_td ltx_align_center" style="padding:-0.25pt 4.5pt;">16</td>
<td id="A2.T1.5.4.5" class="ltx_td ltx_align_center" style="padding:-0.25pt 4.5pt;">16</td></tr>
<tr id="A2.T1.5.5" class="ltx_tr">
<td id="A2.T1.5.5.1" class="ltx_td ltx_align_left" style="padding:-0.25pt 4.5pt;">Weight decay</td>
<td id="A2.T1.5.5.2" class="ltx_td ltx_align_center" style="padding:-0.25pt 4.5pt;">0.01</td>
