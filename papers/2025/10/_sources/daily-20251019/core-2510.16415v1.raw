<td id="S5.T2.4.1.3.3" class="ltx_td ltx_align_left ltx_border_t"><math id="S5.T2.m1" class="ltx_Math" alttext="438.06" display="inline" intent=":literal"><semantics><mn>438.06</mn><annotation encoding="application/x-tex">438.06</annotation></semantics></math>k</td>
<td id="S5.T2.4.1.3.4" class="ltx_td ltx_align_left ltx_border_t"><math id="S5.T2.m2" class="ltx_Math" alttext="428.90" display="inline" intent=":literal"><semantics><mn>428.90</mn><annotation encoding="application/x-tex">428.90</annotation></semantics></math>k</td>
<td id="S5.T2.4.1.3.5" class="ltx_td ltx_align_left ltx_border_t"><math id="S5.T2.m3" class="ltx_Math" alttext="421.45" display="inline" intent=":literal"><semantics><mn>421.45</mn><annotation encoding="application/x-tex">421.45</annotation></semantics></math>k</td>
<td id="S5.T2.4.1.3.6" class="ltx_td ltx_align_left ltx_border_t"><math id="S5.T2.m4" class="ltx_Math" alttext="407.22" display="inline" intent=":literal"><semantics><mn>407.22</mn><annotation encoding="application/x-tex">407.22</annotation></semantics></math>k</td>
<td id="S5.T2.4.1.3.7" class="ltx_td ltx_align_center ltx_border_t">2.09</td>
<td id="S5.T2.4.1.3.8" class="ltx_td ltx_align_center ltx_border_t">3.79</td>
<td id="S5.T2.4.1.3.9" class="ltx_td ltx_align_center ltx_border_t">7.04</td></tr>
<tr id="S5.T2.4.1.4" class="ltx_tr">
<td id="S5.T2.4.1.4.1" class="ltx_td ltx_align_left">Oobleck</td>
<td id="S5.T2.4.1.4.2" class="ltx_td ltx_align_left"><math id="S5.T2.m5" class="ltx_Math" alttext="703.73" display="inline" intent=":literal"><semantics><mn>703.73</mn><annotation encoding="application/x-tex">703.73</annotation></semantics></math>k</td>
<td id="S5.T2.4.1.4.3" class="ltx_td ltx_align_left"><math id="S5.T2.m6" class="ltx_Math" alttext="674.15" display="inline" intent=":literal"><semantics><mn>674.15</mn><annotation encoding="application/x-tex">674.15</annotation></semantics></math>k</td>
<td id="S5.T2.4.1.4.4" class="ltx_td ltx_align_left"><math id="S5.T2.m7" class="ltx_Math" alttext="662.93" display="inline" intent=":literal"><semantics><mn>662.93</mn><annotation encoding="application/x-tex">662.93</annotation></semantics></math>k</td>
<td id="S5.T2.4.1.4.5" class="ltx_td ltx_align_left"><math id="S5.T2.m8" class="ltx_Math" alttext="632.40" display="inline" intent=":literal"><semantics><mn>632.40</mn><annotation encoding="application/x-tex">632.40</annotation></semantics></math>k</td>
<td id="S5.T2.4.1.4.6" class="ltx_td ltx_align_center">4.20</td>
<td id="S5.T2.4.1.4.7" class="ltx_td ltx_align_center">5.80</td>
<td id="S5.T2.4.1.4.8" class="ltx_td ltx_align_center">10.14</td></tr>
