<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex22.m2" class="ltx_Math" alttext="\displaystyle 3\mathbb{E}[\|\overline{\bm{g}}^{(t)}-\overline{\bm{g}}_{\star}^{(t)}\|_{2}^{2}]+3\mathbb{E}[\|\overline{\bm{g}}_{\star}^{(t)}-\nabla f(\bm{w}^{(t)})\|_{2}^{2}]+3\mathbb{E}[\|\nabla f(\bm{w}^{(t)})-\mathbb{E}[\overline{\bm{g}}^{(t)}]\|_{2}^{2}]" display="inline" intent=":literal"><semantics><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒈</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mover accent="true"><mi>𝒈</mi><mo stretchy="true">¯</mo></mover><mo>⋆</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mover accent="true"><mi>𝒈</mi><mo stretchy="true">¯</mo></mover><mo>⋆</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mover accent="true"><mi>𝒈</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 3\mathbb{E}[\|\overline{\bm{g}}^{(t)}-\overline{\bm{g}}_{\star}^{(t)}\|_{2}^{2}]+3\mathbb{E}[\|\overline{\bm{g}}_{\star}^{(t)}-\nabla f(\bm{w}^{(t)})\|_{2}^{2}]+3\mathbb{E}[\|\nabla f(\bm{w}^{(t)})-\mathbb{E}[\overline{\bm{g}}^{(t)}]\|_{2}^{2}]</annotation></semantics></math></td>
