<td id="S4.T1.4.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T1.4.1.2.1" class="ltx_text ltx_font_bold">Failure Interval</span></td>
<td id="S4.T1.4.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T1.4.1.3.1" class="ltx_text ltx_font_bold">Node Recovery Time</span></td></tr>
