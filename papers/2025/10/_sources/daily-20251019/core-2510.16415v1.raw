<tr id="S5.T2.4.1.3" class="ltx_tr">
<td id="S5.T2.4.1.3.1" class="ltx_td ltx_align_left ltx_border_t" rowspan="3"><span id="S5.T2.4.1.3.1.1" class="ltx_text">LLaMA-350M</span></td>
