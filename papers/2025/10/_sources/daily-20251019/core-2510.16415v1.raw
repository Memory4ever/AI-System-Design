<p id="Thmlemma2.p1.2" class="ltx_p"><span id="Thmlemma2.p1.2.1" class="ltx_text ltx_font_italic">where <math id="Thmlemma2.p1.m1" class="ltx_Math" alttext="\Delta_{1}:=\|\bm{m}^{(0)}-\nabla f(\bm{w}^{(0)})\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><mo>:=</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝐦</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐰</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\Delta_{1}:=\|\bm{m}^{(0)}-\nabla f(\bm{w}^{(0)})\|_{2}^{2}</annotation></semantics></math>.</span></p>
