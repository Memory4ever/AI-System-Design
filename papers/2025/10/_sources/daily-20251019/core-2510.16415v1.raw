<td id="A4.T11.4.1.4" class="ltx_td ltx_align_center ltx_border_tt">Heads</td>
<td id="A4.T11.4.1.5" class="ltx_td ltx_align_center ltx_border_tt">Layers</td>
<td id="A4.T11.4.1.6" class="ltx_td ltx_align_center ltx_border_tt">Steps</td>
<td id="A4.T11.4.1.7" class="ltx_td ltx_align_center ltx_border_tt">Batch Size</td>
<td id="A4.T11.4.1.8" class="ltx_td ltx_align_center ltx_border_tt">Learning Rate</td></tr>
<tr id="A4.T11.4.2" class="ltx_tr">
<td id="A4.T11.4.2.1" class="ltx_td ltx_align_left ltx_border_t">LLaMA-350M</td>
<td id="A4.T11.4.2.2" class="ltx_td ltx_align_center ltx_border_t">1024</td>
<td id="A4.T11.4.2.3" class="ltx_td ltx_align_center ltx_border_t">2736</td>
<td id="A4.T11.4.2.4" class="ltx_td ltx_align_center ltx_border_t">16</td>
<td id="A4.T11.4.2.5" class="ltx_td ltx_align_center ltx_border_t">24</td>
<td id="A4.T11.4.2.6" class="ltx_td ltx_align_center ltx_border_t">6k</td>
<td id="A4.T11.4.2.7" class="ltx_td ltx_align_center ltx_border_t">8192</td>
<td id="A4.T11.4.2.8" class="ltx_td ltx_align_center ltx_border_t"><math id="A4.T11.m1" class="ltx_Math" alttext="8\times 10^{-4}" display="inline" intent=":literal"><semantics><mrow><mn>8</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">8\times 10^{-4}</annotation></semantics></math></td></tr>
<tr id="A4.T11.4.3" class="ltx_tr">
<td id="A4.T11.4.3.1" class="ltx_td ltx_align_left">LLaMA-1B</td>
<td id="A4.T11.4.3.2" class="ltx_td ltx_align_center">2048</td>
<td id="A4.T11.4.3.3" class="ltx_td ltx_align_center">5461</td>
<td id="A4.T11.4.3.4" class="ltx_td ltx_align_center">32</td>
<td id="A4.T11.4.3.5" class="ltx_td ltx_align_center">24</td>
<td id="A4.T11.4.3.6" class="ltx_td ltx_align_center">20k</td>
<td id="A4.T11.4.3.7" class="ltx_td ltx_align_center">4096</td>
<td id="A4.T11.4.3.8" class="ltx_td ltx_align_center"><math id="A4.T11.m2" class="ltx_Math" alttext="6\times 10^{-4}" display="inline" intent=":literal"><semantics><mrow><mn>6</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">6\times 10^{-4}</annotation></semantics></math></td></tr>
<tr id="A4.T11.4.4" class="ltx_tr">
<td id="A4.T11.4.4.1" class="ltx_td ltx_align_left ltx_border_bb">LLaMA-7B</td>
<td id="A4.T11.4.4.2" class="ltx_td ltx_align_center ltx_border_bb">4096</td>
<td id="A4.T11.4.4.3" class="ltx_td ltx_align_center ltx_border_bb">11008</td>
