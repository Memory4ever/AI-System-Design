{"data":{"id":"10.48550/arxiv.2601.05254","type":"dois","attributes":{"doi":"10.48550/arxiv.2601.05254","prefix":"10.48550","suffix":"arxiv.2601.05254","identifiers":[{"identifier":"2601.05254","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2601.05254"}],"creators":[{"name":"Tao, Wenbiao","nameType":"Personal","givenName":"Wenbiao","familyName":"Tao","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Xinyuan","nameType":"Personal","givenName":"Xinyuan","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Lan, Yunshi","nameType":"Personal","givenName":"Yunshi","familyName":"Lan","affiliation":[],"nameIdentifiers":[]},{"name":"Qian, Weining","nameType":"Personal","givenName":"Weining","familyName":"Qian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TagRAG: Tag-guided Hierarchical Knowledge Graph Retrieval-Augmented Generation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Information Retrieval (cs.IR)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-18T08:24:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-01-12T01:00:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-12T05:32:52Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-13T02:05:22Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-02T13:19:46Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-05T00:32:53Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-01","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Retrieval-Augmented Generation enhances language models by retrieving external knowledge to support informed and grounded responses. However, traditional RAG methods rely on fragment-level retrieval, limiting their ability to address query-focused summarization queries. GraphRAG introduces a graph-based paradigm for global knowledge reasoning, yet suffers from inefficiencies in information extraction, costly resource consumption, and poor adaptability to incremental updates. To overcome these limitations, we propose TagRAG, a tag-guided hierarchical knowledge graph RAG framework designed for efficient global reasoning and scalable graph maintenance. TagRAG introduces two key components: (1) Tag Knowledge Graph Construction, which extracts object tags and their relationships from documents and organizes them into hierarchical domain tag chains for structured knowledge representation, and (2) Tag-Guided Retrieval-Augmented Generation, which retrieves domain-centric tag chains to localize and synthesize relevant knowledge during inference. This design significantly adapts to smaller language models, improves retrieval granularity, and supports efficient knowledge increment. Extensive experiments on UltraDomain datasets spanning Agriculture, Computer Science, Law, and cross-domain settings demonstrate that TagRAG achieves an average winning rate of 78.36% against baselines while maintaining about 14.6x construction and 1.9x retrieval efficiency compared with GraphRAG.","descriptionType":"Abstract"},{"description":"Accepted by ACL 2026 Findings","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2601.05254","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-01-12T02:17:00.000Z","registered":"2026-01-12T02:17:01.000Z","published":"2026","updated":"2026-05-05T04:05:16.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2601.05254","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}