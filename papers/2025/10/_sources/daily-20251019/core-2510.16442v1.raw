<td id="S4.T1.2.1.4.4" class="ltx_td ltx_align_center"><span id="S4.T1.2.1.4.4.1" class="ltx_text" style="font-size:90%;">56.53</span></td>
<td id="S4.T1.2.1.4.5" class="ltx_td ltx_align_center"><span id="S4.T1.2.1.4.5.1" class="ltx_text" style="font-size:90%;">52.38</span></td></tr>
