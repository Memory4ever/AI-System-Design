<td id="S6.T5.2.3.2" class="ltx_td ltx_align_center ltx_border_t">4.60</td>
<td id="S6.T5.2.3.3" class="ltx_td ltx_align_center ltx_border_t">0.59 <span id="S6.T5.2.3.3.1" class="ltx_text ltx_font_bold">(-87%)***</span></td>
