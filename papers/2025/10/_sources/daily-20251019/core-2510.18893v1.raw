<td id="S6.T5.2.7.3" class="ltx_td ltx_align_center">1.91 <span id="S6.T5.2.7.3.1" class="ltx_text ltx_font_bold">(-68%)*</span></td>
<td id="S6.T5.2.7.4" class="ltx_td ltx_align_left">19,194</td>
<td id="S6.T5.2.7.5" class="ltx_td ltx_align_center">37,922 <span id="S6.T5.2.7.5.1" class="ltx_text ltx_font_bold">(+98%***)</span></td></tr>
<tr id="S6.T5.2.8" class="ltx_tr">
<td id="S6.T5.2.8.1" class="ltx_td ltx_align_left ltx_border_bb">Visualizer</td>
