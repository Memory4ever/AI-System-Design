<td id="S6.T5.2.6.3" class="ltx_td ltx_align_center">4.04 <span id="S6.T5.2.6.3.1" class="ltx_text ltx_font_bold">(+24%)</span></td>
<td id="S6.T5.2.6.4" class="ltx_td ltx_align_left">18,285</td>
<td id="S6.T5.2.6.5" class="ltx_td ltx_align_center">16,028 (-12%)***</td></tr>
<tr id="S6.T5.2.7" class="ltx_tr">
