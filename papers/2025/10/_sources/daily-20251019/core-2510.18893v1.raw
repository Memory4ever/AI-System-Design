<th id="S7.T6.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S7.T6.2.1.2.1" class="ltx_text ltx_font_bold">1–3</span></th>
<th id="S7.T6.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S7.T6.2.1.3.1" class="ltx_text ltx_font_bold">5–10</span></th>
<th id="S7.T6.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S7.T6.2.1.4.1" class="ltx_text ltx_font_bold">20–30</span></th>
<th id="S7.T6.2.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S7.T6.2.1.5.1" class="ltx_text ltx_font_bold">50+</span></th></tr>
