<th id="S6.T5.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="2"><span id="S6.T5.2.1.2.1" class="ltx_text ltx_font_bold">TS Errors/1k chars</span></th>
<th id="S6.T5.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="2"><span id="S6.T5.2.1.3.1" class="ltx_text ltx_font_bold">Code Length (chars)</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S6.T5.2.2" class="ltx_tr">
<td id="S6.T5.2.2.1" class="ltx_td"></td>
