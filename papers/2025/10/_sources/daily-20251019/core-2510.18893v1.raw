<td id="S6.T5.2.5.4" class="ltx_td ltx_align_left">14,952</td>
<td id="S6.T5.2.5.5" class="ltx_td ltx_align_center">27,195 <span id="S6.T5.2.5.5.1" class="ltx_text ltx_font_bold">(+82%***)</span></td></tr>
