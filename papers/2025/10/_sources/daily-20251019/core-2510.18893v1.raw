<td id="S6.T5.2.4.3" class="ltx_td ltx_align_center">2.27 <span id="S6.T5.2.4.3.1" class="ltx_text ltx_font_bold">(-47%)*</span></td>
<td id="S6.T5.2.4.4" class="ltx_td ltx_align_left">17,196</td>
<td id="S6.T5.2.4.5" class="ltx_td ltx_align_center">18,885 (+10%)***</td></tr>
