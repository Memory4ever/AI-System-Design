<td id="S7.T6.2.5.3" class="ltx_td ltx_align_center">1.2–1.4<math id="S7.T6.m3" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td>
<td id="S7.T6.2.5.4" class="ltx_td ltx_align_center">1.0–1.2<math id="S7.T6.m4" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td>
<td id="S7.T6.2.5.5" class="ltx_td ltx_align_center"><math id="S7.T6.m5" class="ltx_Math" alttext="&lt;" display="inline" intent=":literal"><semantics><mo>&lt;</mo><annotation encoding="application/x-tex">&lt;</annotation></semantics></math>1.0<math id="S7.T6.m6" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td></tr>
