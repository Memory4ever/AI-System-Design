<th id="S6.T5.2.2.4" class="ltx_td ltx_align_left ltx_th ltx_th_column"><span id="S6.T5.2.2.4.1" class="ltx_text ltx_font_bold">Seq</span></th>
<th id="S6.T5.2.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column"><span id="S6.T5.2.2.5.1" class="ltx_text ltx_font_bold">Par (<math id="S6.T5.m8" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>%)</span></th></tr>
<tr id="S6.T5.2.3" class="ltx_tr">
