      <a href="/search/?searchtype=author&amp;query=Wu%2C+D">Di Wu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Cheng%2C+L">Lin Cheng</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Gong%2C+S">Shengping Gong</a>
      
