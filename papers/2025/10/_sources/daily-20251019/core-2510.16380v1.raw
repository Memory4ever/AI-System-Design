<span id="A6.SS3.p2.pic1.2.1.1.1" class="ltx_inline-block ltx_align_middle" style="width:213.3pt;">
<span id="A6.SS3.p2.pic1.2.1.1.1.1" class="ltx_p"><span id="A6.SS3.p2.pic1.2.1.1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Criteria</span></span>
</span></td>
<td id="A6.SS3.p2.pic1.2.1.2" class="ltx_td ltx_align_left ltx_align_middle">
<span id="A6.SS3.p2.pic1.2.1.2.1" class="ltx_inline-block ltx_align_middle" style="width:28.4pt;">
