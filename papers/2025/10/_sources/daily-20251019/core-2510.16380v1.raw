<td id="S4.T2.4.1.18.4" class="ltx_td ltx_align_center">54.5</td>
<td id="S4.T2.4.1.18.5" class="ltx_td ltx_align_center">55.1</td>
<td id="S4.T2.4.1.18.6" class="ltx_td ltx_align_center">74.5</td></tr>
<tr id="S4.T2.4.1.19" class="ltx_tr">
<td id="S4.T2.4.1.19.1" class="ltx_td ltx_align_left"><span id="S4.T2.4.1.19.1.1" class="ltx_text ltx_font_bold">DeepSeek</span></td>
