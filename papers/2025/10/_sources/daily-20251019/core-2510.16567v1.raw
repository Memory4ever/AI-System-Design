<td id="A1.T5.2.1.9.1" class="ltx_td ltx_align_center ltx_border_t" colspan="4"><span id="A1.T5.2.1.9.1.1" class="ltx_text ltx_font_italic">Encoder-Transducer Models</span></td></tr>
<tr id="A1.T5.2.1.10" class="ltx_tr">
