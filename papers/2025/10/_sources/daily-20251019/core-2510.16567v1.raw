<td id="A2.T6.2.1.5.7" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:1pt;padding-bottom:1pt;" colspan="2"><math id="A2.T6.m50" class="ltx_Math" alttext="\mathbf{PF}" display="inline" intent=":literal"><semantics><mi>𝐏𝐅</mi><annotation encoding="application/x-tex">\mathbf{PF}</annotation></semantics></math></td></tr>
