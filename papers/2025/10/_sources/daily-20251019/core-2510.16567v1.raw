<td id="A1.T5.2.1.7.3" class="ltx_td ltx_align_left">1.5B</td>
<td id="A1.T5.2.1.7.4" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_middle">
<span id="A1.T5.2.1.7.4.1" class="ltx_inline-block ltx_align_middle" style="width:170.7pt;">
<span id="A1.T5.2.1.7.4.1.1" class="ltx_p">5M+ hours training data; enhanced generalization capabilities</span>
</span></td></tr>
<tr id="A1.T5.2.1.8" class="ltx_tr">
<td id="A1.T5.2.1.8.1" class="ltx_td ltx_align_left">Canary <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib44" title="" class="ltx_ref">Puvvada et al. (2024)</a></cite></td>
<td id="A1.T5.2.1.8.2" class="ltx_td ltx_align_left">Encoder-decoder</td>
<td id="A1.T5.2.1.8.3" class="ltx_td ltx_align_left">1B</td>
<td id="A1.T5.2.1.8.4" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_middle">
