</span></td></tr>
<tr id="A1.T5.2.1.5" class="ltx_tr">
<td id="A1.T5.2.1.5.1" class="ltx_td ltx_align_center ltx_border_t" colspan="4"><span id="A1.T5.2.1.5.1.1" class="ltx_text ltx_font_italic">Encoder-Decoder Transformers</span></td></tr>
<tr id="A1.T5.2.1.6" class="ltx_tr">
<td id="A1.T5.2.1.6.1" class="ltx_td ltx_align_left ltx_border_t">Whisper-Large-v2 <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib45" title="" class="ltx_ref">Radford et al. (2023a)</a></cite></td>
<td id="A1.T5.2.1.6.2" class="ltx_td ltx_align_left ltx_border_t">Encoder-decoder</td>
<td id="A1.T5.2.1.6.3" class="ltx_td ltx_align_left ltx_border_t">1.5B</td>
<td id="A1.T5.2.1.6.4" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_middle ltx_border_t">
