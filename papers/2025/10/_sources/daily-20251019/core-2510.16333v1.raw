<span id="A2.T2.3.1.2.11.1" class="ltx_inline-block ltx_align_top" style="width:45.0pt;--ltx-bg-color:#E6E6E6;">
<span id="A2.T2.3.1.2.11.1.1" class="ltx_p ltx_align_center"><span id="A2.T2.3.1.2.11.1.1.1" class="ltx_text" style="font-size:70%;">Knowledge.</span></span>
</span></td></tr>
<tr id="A2.T2.3.1.3" class="ltx_tr">
