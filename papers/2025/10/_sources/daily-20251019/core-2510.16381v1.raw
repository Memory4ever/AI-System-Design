<td id="S4.T2.7.3.3" class="ltx_td ltx_align_center">83.53²</td>
<td id="S4.T2.7.3.4" class="ltx_td ltx_align_center">76.50²</td></tr>
<tr id="S4.T2.7.4" class="ltx_tr">
<th id="S4.T2.7.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S4.T2.7.4.1.1" class="ltx_text ltx_font_typewriter">gpt-4.1</span></th>
<td id="S4.T2.7.4.2" class="ltx_td ltx_align_center">70.24¹</td>
<td id="S4.T2.7.4.3" class="ltx_td ltx_align_center">80.25¹</td>
<td id="S4.T2.7.4.4" class="ltx_td ltx_align_center">63.53¹</td></tr>
<tr id="S4.T2.7.5" class="ltx_tr">
<th id="S4.T2.7.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S4.T2.7.5.1.1" class="ltx_text ltx_font_typewriter">gpt-5</span></th>
<td id="S4.T2.7.5.2" class="ltx_td ltx_align_center">70.59²</td>
<td id="S4.T2.7.5.3" class="ltx_td ltx_align_center">84.71²</td>
