<td id="S4.T2.7.2.2" class="ltx_td ltx_align_center ltx_border_t">72.94¹</td>
<td id="S4.T2.7.2.3" class="ltx_td ltx_align_center ltx_border_t">87.17¹</td>
<td id="S4.T2.7.2.4" class="ltx_td ltx_align_center ltx_border_t">65.88²</td></tr>
