<span id="S5.T2.2.1.1.2.1.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S5.T2.2.1.1.2.1.1.1.1.1" class="ltx_text ltx_font_bold">Token</span></span></span>
<span id="S5.T2.2.1.1.2.1.1.2" class="ltx_tr">
<span id="S5.T2.2.1.1.2.1.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S5.T2.2.1.1.2.1.1.2.1.1" class="ltx_text ltx_font_bold">Attribution</span></span></span>
<span id="S5.T2.2.1.1.2.1.1.3" class="ltx_tr">
<span id="S5.T2.2.1.1.2.1.1.3.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S5.T2.2.1.1.2.1.1.3.1.1" class="ltx_text ltx_font_bold">Method</span></span></span>
</span></span></th>
<th id="S5.T2.2.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_tt" rowspan="4"><span id="S5.T2.2.1.1.3.1" class="ltx_text"><math id="S5.T2.m1" class="ltx_Math" alttext="k\%" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>%</mo></mrow><annotation encoding="application/x-tex">k\%</annotation></semantics></math></span></th>
<td id="S5.T2.2.1.1.4" class="ltx_td ltx_align_center ltx_border_tt" colspan="10"><span id="S5.T2.2.1.1.4.1" class="ltx_text ltx_font_bold">Tasks</span></td></tr>
<tr id="S5.T2.2.1.2" class="ltx_tr">
