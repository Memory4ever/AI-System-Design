{"data":{"id":"10.48550/arxiv.2510.16439","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.16439","prefix":"10.48550","suffix":"arxiv.2510.16439","identifiers":[{"identifier":"2510.16439","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.16439"}],"creators":[{"name":"Raiyan, Syed Rifat","nameType":"Personal","givenName":"Syed Rifat","familyName":"Raiyan","affiliation":[],"nameIdentifiers":[]},{"name":"Ishmam, Md Farhan","nameType":"Personal","givenName":"Md Farhan","familyName":"Ishmam","affiliation":[],"nameIdentifiers":[]},{"name":"Imran, Abdullah Al","nameType":"Personal","givenName":"Abdullah Al","familyName":"Imran","affiliation":[],"nameIdentifiers":[]},{"name":"Moni, Mohammad Ali","nameType":"Personal","givenName":"Mohammad Ali","familyName":"Moni","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FrugalPrompt: Reducing Contextual Overhead in Large Language Models via Token Attribution"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-18T10:22:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-21T00:26:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-22T04:39:03Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-23T00:21:24Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02-22T22:10:01Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-02-24T02:01:09Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-03-12T12:06:44Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-03-13T00:44:37Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-09-05T20:45:00Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-09-09T00:44:57Z","dateType":"Updated","dateInformation":"v5"},{"date":"2026-09-19T06:23:37Z","dateType":"Submitted","dateInformation":"v6"},{"date":"2026-09-22T00:30:38Z","dateType":"Updated","dateInformation":"v6"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"6","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Human communication heavily relies on laconism and inferential pragmatics, allowing listeners to successfully reconstruct rich meaning from sparse, telegraphic speech. In contrast, large language models (LLMs) owe much of their stellar performance to expansive input contexts, yet such verbosity inflates monetary costs, carbon footprint, and inference-time latency. This overhead manifests from the redundant low-utility tokens present in typical prompts, as only a fraction of tokens typically carries the majority of the semantic weight. Inspired by the aforementioned cognitive psycholinguistic processes, we address this inefficiency by introducing FrugalPrompt, a novel prompt compression framework for LLMs, which retains only the most semantically significant tokens. Leveraging two state-of-the-art token attribution methods, GlobEnc and DecompX, we assign salience scores to every token in an input sequence, rank them to retain the top-k% tokens, and obtain a sparse frugalized prompt. We establish the theoretical stability of our approach and provide strong empirical results across a suite of four NLP tasks to study the trade-off between the portion of retained tokens and performance. Experimental findings across retention settings reveal asymmetric performance patterns that suggest potential task contamination effects. We posit that our work contributes to a more nuanced understanding of LLM behavior in performance-efficiency trade-offs and delineates the boundary between tasks tolerant of contextual sparsity and those requiring exhaustive context.","descriptionType":"Abstract"},{"description":"Accepted in Proceedings of the 3rd LUHME Workshop at EMNLP 2026, 16 pages, 3 figures, 4 tables","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.16439","contentUrl":null,"metadataVersion":5,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-21T02:51:50.000Z","registered":"2025-10-21T02:51:51.000Z","published":"2025","updated":"2026-09-22T04:43:34.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.16439","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}