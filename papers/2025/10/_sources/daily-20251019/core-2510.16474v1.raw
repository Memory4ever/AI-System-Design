<td id="S4.T2.1.3.1" class="ltx_td ltx_align_center" style="padding:1pt 12.0pt;">LASSO</td>
<td id="S4.T2.1.3.2" class="ltx_td ltx_align_center" style="padding:1pt 12.0pt;">0.6500</td>
<td id="S4.T2.1.3.3" class="ltx_td ltx_align_center" style="padding:1pt 12.0pt;">0.6800</td>
<td id="S4.T2.1.3.4" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:1pt 12.0pt;">0.6600</td></tr>
<tr id="S4.T2.1.4" class="ltx_tr">
<td id="S4.T2.1.4.1" class="ltx_td ltx_align_center" style="padding:1pt 12.0pt;">PLS</td>
