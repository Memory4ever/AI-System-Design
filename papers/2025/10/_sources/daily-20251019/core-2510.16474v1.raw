<td id="S4.T2.1.6.1" class="ltx_td ltx_align_center" style="padding:1pt 12.0pt;">AttentionPLS <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib28" title="" class="ltx_ref">28</a>]</cite></td>
<td id="S4.T2.1.6.2" class="ltx_td ltx_align_center" style="padding:1pt 12.0pt;">0.0240</td>
<td id="S4.T2.1.6.3" class="ltx_td ltx_align_center" style="padding:1pt 12.0pt;">0.0118</td>
