<td id="S4.T2.1.4.4" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:1pt 12.0pt;">0.7930</td></tr>
<tr id="S4.T2.1.5" class="ltx_tr">
<td id="S4.T2.1.5.1" class="ltx_td ltx_align_center" style="padding:1pt 12.0pt;">IKPLS <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib21" title="" class="ltx_ref">21</a>]</cite></td>
