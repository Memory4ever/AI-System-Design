<td id="S4.T2.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:1pt 12.0pt;">0.7125</td>
<td id="S4.T2.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:1pt 12.0pt;">0.8125</td>
