      <a href="/search/?searchtype=author&amp;query=Choi%2C+Y">Yejin Choi</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Gordon%2C+M+L">Mitchell L Gordon</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Levine%2C+S">Sydney Levine</a>
      
