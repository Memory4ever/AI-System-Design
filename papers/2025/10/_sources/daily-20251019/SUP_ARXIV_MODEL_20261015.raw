    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Ravfogel%2C+S">Shauli Ravfogel</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Yehudai%2C+G">Gilad Yehudai</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Linzen%2C+T">Tal Linzen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Bruna%2C+J">Joan Bruna</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Bietti%2C+A">Alberto Bietti</a>
      
