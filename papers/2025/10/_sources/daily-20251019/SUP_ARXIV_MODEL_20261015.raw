      <a href="/search/?searchtype=author&amp;query=Lo%2C+D">David Lo</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Bissyand%C3%A9%2C+T+F">Tegawendé F. Bissyandé</a>
      
