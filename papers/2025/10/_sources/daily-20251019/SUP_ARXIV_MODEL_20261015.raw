        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.16091">pdf</a>, <a href="https://arxiv.org/ps/2510.16091">ps</a>, <a href="https://arxiv.org/format/2510.16091">other</a>]&nbsp;</span>
