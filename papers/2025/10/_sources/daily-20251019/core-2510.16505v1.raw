<th id="S4.T2.2.1.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">Gemini 2.5 Pro<math id="S4.T2.m3" class="ltx_Math" alttext="{}^{\textbf{R}}" display="inline" intent=":literal"><semantics><msup><mrow></mrow><mtext class="ltx_mathvariant_bold">R</mtext></msup><annotation encoding="application/x-tex">{}^{\textbf{R}}</annotation></semantics></math></th>
<td id="S4.T2.2.1.7.2" class="ltx_td ltx_align_center ltx_border_bb">70.1</td>
<td id="S4.T2.2.1.7.3" class="ltx_td ltx_align_center ltx_border_bb">37.3</td>
<td id="S4.T2.2.1.7.4" class="ltx_td ltx_align_center ltx_border_bb">81.6</td>
<td id="S4.T2.2.1.7.5" class="ltx_td ltx_align_center ltx_border_bb">65.8</td>
<td id="S4.T2.2.1.7.6" class="ltx_td ltx_align_center ltx_border_bb">83.8</td>
<td id="S4.T2.2.1.7.7" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_bb">37.8</td></tr>
