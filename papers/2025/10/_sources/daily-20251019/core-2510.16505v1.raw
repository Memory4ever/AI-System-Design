<tbody class="ltx_tbody">
<tr id="S4.T2.2.1.4" class="ltx_tr">
<th id="S4.T2.2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">InternVL3.5 8B<math id="S4.T2.m1" class="ltx_Math" alttext="{}^{\textbf{R}}" display="inline" intent=":literal"><semantics><msup><mrow></mrow><mtext class="ltx_mathvariant_bold">R</mtext></msup><annotation encoding="application/x-tex">{}^{\textbf{R}}</annotation></semantics></math></th>
<td id="S4.T2.2.1.4.2" class="ltx_td ltx_align_center ltx_border_t">49.3</td>
<td id="S4.T2.2.1.4.3" class="ltx_td ltx_align_center ltx_border_t">28.4</td>
