<th id="S4.T2.2.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">InternVL3.5 38B<math id="S4.T2.m2" class="ltx_Math" alttext="{}^{\textbf{R}}" display="inline" intent=":literal"><semantics><msup><mrow></mrow><mtext class="ltx_mathvariant_bold">R</mtext></msup><annotation encoding="application/x-tex">{}^{\textbf{R}}</annotation></semantics></math></th>
<td id="S4.T2.2.1.5.2" class="ltx_td ltx_align_center">53.7</td>
