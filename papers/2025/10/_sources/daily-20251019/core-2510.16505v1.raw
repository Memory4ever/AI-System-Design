<th id="S4.T2.2.1.3.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">77.5</th>
<th id="S4.T2.2.1.3.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">—</th>
