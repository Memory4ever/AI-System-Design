<td id="S6.T3.5.3.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T3.5.3.4.1" class="ltx_text" style="font-size:90%;">0.0061</span></td>
<td id="S6.T3.5.3.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T3.5.3.5.1" class="ltx_text" style="font-size:90%;">0.157</span></td></tr>
<tr id="S6.T3.5.4" class="ltx_tr">
<th id="S6.T3.5.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S6.T3.5.4.1.1" class="ltx_text" style="font-size:90%;">VL-MIA: img_Flickr</span></th>
<td id="S6.T3.5.4.2" class="ltx_td ltx_align_center"><span id="S6.T3.5.4.2.1" class="ltx_text" style="font-size:90%;">0.949</span></td>
<td id="S6.T3.5.4.3" class="ltx_td ltx_align_center"><span id="S6.T3.5.4.3.1" class="ltx_text" style="font-size:90%;">0.813</span></td>
<td id="S6.T3.5.4.4" class="ltx_td ltx_align_center"><span id="S6.T3.5.4.4.1" class="ltx_text" style="font-size:90%;">0.0188</span></td>
<td id="S6.T3.5.4.5" class="ltx_td ltx_align_center"><span id="S6.T3.5.4.5.1" class="ltx_text" style="font-size:90%;">0.428</span></td></tr>
<tr id="S6.T3.5.5" class="ltx_tr">
<th id="S6.T3.5.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="S6.T3.5.5.1.1" class="ltx_text" style="font-size:90%;">OpenLVLM-MIA: Vision Encoder</span></th>
<td id="S6.T3.5.5.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T3.5.5.2.1" class="ltx_text" style="font-size:90%;">0.554</span></td>
<td id="S6.T3.5.5.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T3.5.5.3.1" class="ltx_text" style="font-size:90%;">0.063</span></td>
<td id="S6.T3.5.5.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T3.5.5.4.1" class="ltx_text" style="font-size:90%;">0.0018</span></td>
<td id="S6.T3.5.5.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T3.5.5.5.1" class="ltx_text" style="font-size:90%;">0.142</span></td></tr>
<tr id="S6.T3.5.6" class="ltx_tr">
<th id="S6.T3.5.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S6.T3.5.6.1.1" class="ltx_text" style="font-size:90%;">OpenLVLM-MIA: Projector</span></th>
<td id="S6.T3.5.6.2" class="ltx_td ltx_align_center"><span id="S6.T3.5.6.2.1" class="ltx_text" style="font-size:90%;">0.583</span></td>
<td id="S6.T3.5.6.3" class="ltx_td ltx_align_center"><span id="S6.T3.5.6.3.1" class="ltx_text" style="font-size:90%;">0.095</span></td>
<td id="S6.T3.5.6.4" class="ltx_td ltx_align_center"><span id="S6.T3.5.6.4.1" class="ltx_text" style="font-size:90%;">0.0022</span></td>
<td id="S6.T3.5.6.5" class="ltx_td ltx_align_center"><span id="S6.T3.5.6.5.1" class="ltx_text" style="font-size:90%;">0.152</span></td></tr>
