<tr id="S6.T3.5.1" class="ltx_tr">
<th id="S6.T3.5.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_tt" rowspan="2"><span id="S6.T3.5.1.1.1" class="ltx_text" style="font-size:90%;">Dataset</span></th>
<td id="S6.T3.5.1.2" class="ltx_td ltx_align_center ltx_border_tt" colspan="2"><span id="S6.T3.5.1.2.1" class="ltx_text" style="font-size:90%;">C2ST Performance</span></td>
<td id="S6.T3.5.1.3" class="ltx_td ltx_align_center ltx_border_tt" colspan="2"><span id="S6.T3.5.1.3.1" class="ltx_text" style="font-size:90%;">Distribution Metrics</span></td></tr>
<tr id="S6.T3.5.2" class="ltx_tr">
<td id="S6.T3.5.2.1" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T3.5.2.1.1" class="ltx_text" style="font-size:90%;">AUROC<math id="S6.T3.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S6.T3.5.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T3.5.2.2.1" class="ltx_text" style="font-size:90%;">TPR@0.05FPR<math id="S6.T3.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S6.T3.5.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T3.5.2.3.1" class="ltx_text" style="font-size:90%;">MMD<math id="S6.T3.m3" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S6.T3.5.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T3.5.2.4.1" class="ltx_text" style="font-size:90%;">FID<math id="S6.T3.m4" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td></tr>
<tr id="S6.T3.5.3" class="ltx_tr">
<th id="S6.T3.5.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="S6.T3.5.3.1.1" class="ltx_text" style="font-size:90%;">VL-MIA: img_Dalle</span></th>
<td id="S6.T3.5.3.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T3.5.3.2.1" class="ltx_text" style="font-size:90%;">0.729</span></td>
