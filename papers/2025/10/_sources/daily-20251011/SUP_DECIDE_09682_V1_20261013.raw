<tr id="S3.SS1.tab1.1.3" class="ltx_tr">
<td id="S3.SS1.tab1.1.3.1" class="ltx_td ltx_align_left">No re-training or fine-tuning needed</td>
<td id="S3.SS1.tab1.1.3.2" class="ltx_td ltx_align_center"><span class="ltx_inline-block"><svg id="S3.SS1.pic5" class="ltx_picture" height="7.7" overflow="visible" version="1.1" viewBox="0 0 7.7 7.7" width="7.7"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" stroke-width="0.4pt" transform="translate(0,7.7) matrix(1 0 0 -1 0 0) translate(3.85,0) translate(0,3.85)"><path d="M 0 0 M 3.57 0 C 3.57 1.97 1.97 3.57 0 3.57 C -1.97 3.57 -3.57 1.97 -3.57 0 C -3.57 -1.97 -1.97 -3.57 0 -3.57 C 1.97 -3.57 3.57 -1.97 3.57 0 Z M 0 0"></path></g></svg></span></td>
<td id="S3.SS1.tab1.1.3.3" class="ltx_td ltx_align_center"><span class="ltx_inline-block"><svg id="S3.SS1.pic6" class="ltx_picture" height="7.7" overflow="visible" version="1.1" viewBox="0 0 7.7 7.7" width="7.7"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" stroke-width="0.4pt" transform="translate(0,7.7) matrix(1 0 0 -1 0 0) translate(3.85,0) translate(0,3.85)"><path d="M 0 0 M 3.57 0 C 3.57 1.97 1.97 3.57 0 3.57 C -1.97 3.57 -3.57 1.97 -3.57 0 C -3.57 -1.97 -1.97 -3.57 0 -3.57 C 1.97 -3.57 3.57 -1.97 3.57 0 Z M 0 0"></path></g></svg></span></td>
<td id="S3.SS1.tab1.1.3.4" class="ltx_td ltx_align_center"><span class="ltx_inline-block"><svg id="S3.SS1.pic7" class="ltx_picture" height="7.7" overflow="visible" version="1.1" viewBox="0 0 7.7 7.7" width="7.7"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,7.7) matrix(1 0 0 -1 0 0) translate(3.85,0) translate(0,3.85)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000"><path d="M 0 0 M 3.57 0 C 3.57 1.97 1.97 3.57 0 3.57 C -1.97 3.57 -3.57 1.97 -3.57 0 C -3.57 -1.97 -1.97 -3.57 0 -3.57 C 1.97 -3.57 3.57 -1.97 3.57 0 Z M 0 0"></path></g><clipPath id="pgfcp3"><path d="M -3.57 -3.57 M -3.57 -3.57 L -3.57 3.57 L 0 3.57 L 0 -3.57 Z M 0 3.57"></path></clipPath><g clip-path="url(#pgfcp3)"><g><path style="stroke:none" d="M 0 0 M 3.57 0 C 3.57 1.97 1.97 3.57 0 3.57 C -1.97 3.57 -3.57 1.97 -3.57 0 C -3.57 -1.97 -1.97 -3.57 0 -3.57 C 1.97 -3.57 3.57 -1.97 3.57 0 Z M 0 0"></path></g></g></g></svg></span></td>
<td id="S3.SS1.tab1.1.3.5" class="ltx_td ltx_align_center"><span class="ltx_inline-block"><svg id="S3.SS1.pic8" class="ltx_picture" height="7.7" overflow="visible" version="1.1" viewBox="0 0 7.7 7.7" width="7.7"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,7.7) matrix(1 0 0 -1 0 0) translate(3.85,0) translate(0,3.85)"><path d="M 0 0 M 3.57 0 C 3.57 1.97 1.97 3.57 0 3.57 C -1.97 3.57 -3.57 1.97 -3.57 0 C -3.57 -1.97 -1.97 -3.57 0 -3.57 C 1.97 -3.57 3.57 -1.97 3.57 0 Z M 0 0"></path></g></svg></span></td></tr>
<tr id="S3.SS1.tab1.1.4" class="ltx_tr">
<td id="S3.SS1.tab1.1.4.1" class="ltx_td ltx_align_left">No vulnerability dataset required</td>
<td id="S3.SS1.tab1.1.4.2" class="ltx_td ltx_align_center"><span class="ltx_inline-block"><svg id="S3.SS1.pic9" class="ltx_picture" height="7.7" overflow="visible" version="1.1" viewBox="0 0 7.7 7.7" width="7.7"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" stroke-width="0.4pt" transform="translate(0,7.7) matrix(1 0 0 -1 0 0) translate(3.85,0) translate(0,3.85)"><path d="M 0 0 M 3.57 0 C 3.57 1.97 1.97 3.57 0 3.57 C -1.97 3.57 -3.57 1.97 -3.57 0 C -3.57 -1.97 -1.97 -3.57 0 -3.57 C 1.97 -3.57 3.57 -1.97 3.57 0 Z M 0 0"></path></g></svg></span></td>
