<span id="S4.F3.2.1.5.1.1.1" class="ltx_text" style="font-size:70%;">

<span id="S4.F3.2.1.5.1.1.1.1" class="ltx_tabular ltx_align_middle">
<span id="S4.F3.2.1.5.1.1.1.1.1" class="ltx_tr">
<span id="S4.F3.2.1.5.1.1.1.1.1.1" class="ltx_td ltx_align_left ltx_align_middle ltx_border_l ltx_border_t" style="padding:5pt 3.0pt;">
