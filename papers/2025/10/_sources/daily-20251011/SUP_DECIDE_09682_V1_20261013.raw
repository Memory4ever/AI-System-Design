                       relevant <math id="alg1.l17.m1" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> relevant <math id="alg1.l17.m2" class="ltx_Math" alttext="\cup\{v\}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∪</mo><mrow><mo stretchy="false">{</mo><mi>v</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\cup\{v\}</annotation></semantics></math>

