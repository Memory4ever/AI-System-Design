<th id="S5.T3.4.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_r ltx_border_tt" rowspan="2"><span id="S5.T3.4.1.2.1" class="ltx_text">SR</span></th>
<th id="S5.T3.4.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="5">secure-pass@k</th></tr>
<tr id="S5.T3.4.2" class="ltx_tr">
