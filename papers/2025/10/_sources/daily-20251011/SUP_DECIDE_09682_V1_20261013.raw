                    <math id="alg1.l25.m1" class="ltx_Math" alttext="c_{f}\leftarrow\text{ReviseCode}(c_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>f</mi></msub><mo stretchy="false">←</mo><mrow><mtext>ReviseCode</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c_{f}\leftarrow\text{ReviseCode}(c_{i})</annotation></semantics></math>

</div>
