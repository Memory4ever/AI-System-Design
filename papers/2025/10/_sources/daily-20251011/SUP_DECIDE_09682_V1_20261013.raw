<td id="S5.T2.2.13.4" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S5.T2.2.13.4.1" class="ltx_text ltx_font_bold">0.87</span></td></tr>
<tr id="S5.T2.2.14" class="ltx_tr">
<td id="S5.T2.2.14.1" class="ltx_td ltx_align_center" rowspan="2"><span id="S5.T2.2.14.1.1" class="ltx_text">Gemini</span></td>
<td id="S5.T2.2.14.2" class="ltx_td ltx_align_center ltx_border_t">Base</td>
