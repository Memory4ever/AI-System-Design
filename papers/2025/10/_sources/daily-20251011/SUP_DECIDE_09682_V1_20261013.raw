<tr id="S5.T2.2.13" class="ltx_tr">
<td id="S5.T2.2.13.1" class="ltx_td ltx_align_center"><span id="S5.T2.2.13.1.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">GRASP</span></td>
<td id="S5.T2.2.13.2" class="ltx_td ltx_align_center">149</td>
