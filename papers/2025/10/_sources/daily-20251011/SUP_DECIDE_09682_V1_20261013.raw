                       <span id="alg1.l18.3" class="ltx_text ltx_font_bold">for</span> each child in <math id="alg1.l18.m1" class="ltx_Math" alttext="G_{SCP}[v].\text{children}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>G</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>v</mi><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">.</mo><mtext>children</mtext></mrow><annotation encoding="application/x-tex">G_{SCP}[v].\text{children}</annotation></semantics></math> <span id="alg1.l18.4" class="ltx_text ltx_font_bold">do</span>

