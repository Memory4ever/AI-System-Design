<span id="S4.T2.2.1.1.7.2.1.2" class="ltx_tr">
<span id="S4.T2.2.1.1.7.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">Design</span></span>
</span></span><span id="S4.T2.2.1.1.7.3" class="ltx_text"></span></td></tr>
<tr id="S4.T2.2.1.2" class="ltx_tr">
<td id="S4.T2.2.1.2.1" class="ltx_td ltx_align_left ltx_border_t">78M</td>
<td id="S4.T2.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t">0.39 ± 0.17</td>
<td id="S4.T2.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t">0.46 ± 0.24</td>
<td id="S4.T2.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t">0.59 ± 0.06</td>
<td id="S4.T2.2.1.2.5" class="ltx_td ltx_align_center ltx_border_t">0.57 ± 0.31</td>
<td id="S4.T2.2.1.2.6" class="ltx_td ltx_align_center ltx_border_t">0.73 ± 0.03</td>
<td id="S4.T2.2.1.2.7" class="ltx_td ltx_align_center ltx_border_t">0.62 ± 0.13</td></tr>
<tr id="S4.T2.2.1.3" class="ltx_tr">
<td id="S4.T2.2.1.3.1" class="ltx_td ltx_align_left">311M</td>
<td id="S4.T2.2.1.3.2" class="ltx_td ltx_align_center">0.40 ± 0.17</td>
<td id="S4.T2.2.1.3.3" class="ltx_td ltx_align_center">0.46 ± 0.23</td>
<td id="S4.T2.2.1.3.4" class="ltx_td ltx_align_center">0.63 ± 0.06</td>
<td id="S4.T2.2.1.3.5" class="ltx_td ltx_align_center">0.53 ± 0.27</td>
<td id="S4.T2.2.1.3.6" class="ltx_td ltx_align_center">0.75 ± 0.04</td>
<td id="S4.T2.2.1.3.7" class="ltx_td ltx_align_center">0.62 ± 0.14</td></tr>
<tr id="S4.T2.2.1.4" class="ltx_tr">
<td id="S4.T2.2.1.4.1" class="ltx_td ltx_align_left ltx_border_bb">739M</td>
<td id="S4.T2.2.1.4.2" class="ltx_td ltx_align_center ltx_border_bb">0.44 ± 0.21</td>
<td id="S4.T2.2.1.4.3" class="ltx_td ltx_align_center ltx_border_bb">0.54 ± 0.23</td>
<td id="S4.T2.2.1.4.4" class="ltx_td ltx_align_center ltx_border_bb">0.56 ± 0.33</td>
<td id="S4.T2.2.1.4.5" class="ltx_td ltx_align_center ltx_border_bb">0.79 ± 0.11</td>
<td id="S4.T2.2.1.4.6" class="ltx_td ltx_align_center ltx_border_bb">0.78 ± 0.05</td>
