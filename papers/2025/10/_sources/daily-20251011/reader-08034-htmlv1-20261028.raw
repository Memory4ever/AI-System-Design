<td id="Sx4.T6.3.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="Sx4.T6.3.2.2.1" class="ltx_text ltx_font_bold">69.3</span></td>
<td id="Sx4.T6.3.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="Sx4.T6.3.2.3.1" class="ltx_text ltx_font_bold">93.5</span></td>
<td id="Sx4.T6.3.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="Sx4.T6.3.2.4.1" class="ltx_text ltx_font_bold">86.4</span></td>
<td id="Sx4.T6.3.2.5" class="ltx_td ltx_align_center ltx_border_t">91.8</td></tr>
<tr id="Sx4.T6.3.3" class="ltx_tr">
<th id="Sx4.T6.3.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row"><math id="Sx4.T6.m3" class="ltx_Math" alttext="r_{q}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>q</mi></msub><annotation encoding="application/x-tex">r_{q}</annotation></semantics></math>=16</th>
<td id="Sx4.T6.3.3.2" class="ltx_td ltx_align_center">62.1</td>
