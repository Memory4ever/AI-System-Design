<td id="Sx4.T2.3.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="Sx4.T2.3.2.4.1" class="ltx_text ltx_font_bold">94.4</span></td></tr>
<tr id="Sx4.T2.3.3" class="ltx_tr">
<td id="Sx4.T2.3.3.1" class="ltx_td ltx_align_center">PiSSA</td>
