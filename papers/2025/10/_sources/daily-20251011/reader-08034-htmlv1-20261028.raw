<th id="Sx4.T2.3.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="Sx4.T2.3.1.2.1" class="ltx_text ltx_font_bold">Method</span></th>
<th id="Sx4.T2.3.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="Sx4.T2.3.1.3.1" class="ltx_text ltx_font_bold">EM</span></th>
<th id="Sx4.T2.3.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="Sx4.T2.3.1.4.1" class="ltx_text ltx_font_bold">F1</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="Sx4.T2.3.2" class="ltx_tr">
