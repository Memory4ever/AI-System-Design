<td id="S4.T1.2.27.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;" colspan="6"><span id="S4.T1.2.27.1.1" class="ltx_text ltx_font_bold">Auxiliary objective functions</span></td></tr>
<tr id="S4.T1.2.28" class="ltx_tr">
