<span id="S4.T1.2.28.3.1" class="ltx_inline-block ltx_align_top" style="width:53.5pt;">
<span id="S4.T1.2.28.3.1.1" class="ltx_p ltx_align_center">54.35</span>
</span></td>
<td id="S4.T1.2.28.4" class="ltx_td ltx_align_left ltx_align_top" style="padding-left:4.0pt;padding-right:4.0pt;">
<span id="S4.T1.2.28.4.1" class="ltx_inline-block ltx_align_top" style="width:53.5pt;">
<span id="S4.T1.2.28.4.1.1" class="ltx_p ltx_align_center">51.45</span>
</span></td>
<td id="S4.T1.2.28.5" class="ltx_td ltx_align_left ltx_align_top" style="padding-left:4.0pt;padding-right:4.0pt;">
<span id="S4.T1.2.28.5.1" class="ltx_inline-block ltx_align_top" style="width:53.5pt;">
<span id="S4.T1.2.28.5.1.1" class="ltx_p ltx_align_center">51.47</span>
</span></td>
<td id="S4.T1.2.28.6" class="ltx_td ltx_align_left ltx_align_top" style="padding-left:4.0pt;padding-right:4.0pt;">
<span id="S4.T1.2.28.6.1" class="ltx_inline-block ltx_align_top" style="width:53.5pt;">
<span id="S4.T1.2.28.6.1.1" class="ltx_p ltx_align_center">47.72</span>
</span></td></tr>
<tr id="S4.T1.2.29" class="ltx_tr">
<td id="S4.T1.2.29.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;">
<span id="S4.T1.2.29.1.1" class="ltx_inline-block ltx_align_top" style="width:139.4pt;">
<span id="S4.T1.2.29.1.1.1" class="ltx_p">NTP + LCG</span>
</span></td>
<td id="S4.T1.2.29.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;">
<span id="S4.T1.2.29.2.1" class="ltx_inline-block ltx_align_top" style="width:53.5pt;">
<span id="S4.T1.2.29.2.1.1" class="ltx_p ltx_align_center">70.27</span>
</span></td>
<td id="S4.T1.2.29.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;">
<span id="S4.T1.2.29.3.1" class="ltx_inline-block ltx_align_top" style="width:53.5pt;">
<span id="S4.T1.2.29.3.1.1" class="ltx_p ltx_align_center">56.91</span>
</span></td>
<td id="S4.T1.2.29.4" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;">
<span id="S4.T1.2.29.4.1" class="ltx_inline-block ltx_align_top" style="width:53.5pt;">
<span id="S4.T1.2.29.4.1.1" class="ltx_p ltx_align_center">49.74</span>
</span></td>
<td id="S4.T1.2.29.5" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;">
<span id="S4.T1.2.29.5.1" class="ltx_inline-block ltx_align_top" style="width:53.5pt;">
<span id="S4.T1.2.29.5.1.1" class="ltx_p ltx_align_center">50.00</span>
</span></td>
<td id="S4.T1.2.29.6" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;">
<span id="S4.T1.2.29.6.1" class="ltx_inline-block ltx_align_top" style="width:53.5pt;">
