<td id="A9.T6.2.2.2" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.25pt 4.0pt;">Base model (§<a href="#S3.SS2" title="3.2 Base Architecture ‣ 3 Method ‣ Looking to Learn: Token-wise Dynamic Gating for Low-Resource Vision-Language Modelling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>)</td>
<td id="A9.T6.2.2.3" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.25pt 4.0pt;">Default<sup id="A9.T6.2.2.3.1" class="ltx_sup">a</sup></td>
<td id="A9.T6.2.2.4" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t" style="padding:0.25pt 4.0pt;">Default<sup id="A9.T6.2.2.4.1" class="ltx_sup">b</sup></td></tr>
<tr id="A9.T6.2.3" class="ltx_tr">
<td id="A9.T6.2.3.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.25pt 4.0pt;" colspan="4"><span id="A9.T6.2.3.1.1" class="ltx_text ltx_font_bold">Dynamic Gating</span></td></tr>
<tr id="A9.T6.2.4" class="ltx_tr">
