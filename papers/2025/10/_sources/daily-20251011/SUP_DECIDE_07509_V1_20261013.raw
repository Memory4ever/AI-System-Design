</div>
<div id="alg1.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">10:</span>
              
              
               <span id="alg1.l10.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l10.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">11:</span>
              
              
              <span id="alg1.l11.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l11.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">12:</span>
              
              
              For each <math id="alg1.l12.m1" class="ltx_Math" alttext="v\in\{1,2\}" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">v\in\{1,2\}</annotation></semantics></math>, select top<span id="alg1.l12.2" class="ltx_text">-</span><math id="alg1.l12.m2" class="ltx_Math" alttext="k_{\mathrm{pseudo}}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>pseudo</mi></msub><annotation encoding="application/x-tex">k_{\mathrm{pseudo}}</annotation></semantics></math> by confidence in <math id="alg1.l12.m3" class="ltx_Math" alttext="\mathcal{P}_{v}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>v</mi></msub><annotation encoding="application/x-tex">\mathcal{P}_{v}</annotation></semantics></math> as <math id="alg1.l12.m4" class="ltx_Math" alttext="\mathcal{L}_{\mathrm{pseudo}}^{(v)}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>pseudo</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\mathcal{L}_{\mathrm{pseudo}}^{(v)}</annotation></semantics></math>

</div>
<div id="alg1.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">13:</span>
              
              
              <math id="alg1.l13.m1" class="ltx_math_unparsed" alttext="\mathcal{D}^{(v)}\leftarrow\mathcal{L}\cup\{(x,y)\mid(x,y,\cdot)\in\mathcal{L}_{\mathrm{pseudo}}^{(v)}\}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">←</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>pseudo</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{D}^{(v)}\leftarrow\mathcal{L}\cup\{(x,y)\mid(x,y,\cdot)\in\mathcal{L}_{\mathrm{pseudo}}^{(v)}\}</annotation></semantics></math>

</div>
