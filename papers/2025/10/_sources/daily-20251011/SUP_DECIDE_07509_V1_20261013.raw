<span id="S3.T1.2.1.6.1.1" class="ltx_p ltx_align_left ltx_align_center" style="--ltx-bg-color:#F8FAFD;"><span id="S3.T1.2.1.6.1.1.1" class="ltx_text ltx_font_bold">Primary Assumptions</span></span>
