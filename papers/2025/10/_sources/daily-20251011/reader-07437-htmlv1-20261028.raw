<td id="S0.T1.2.7.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S0.T1.2.7.2.1" class="ltx_text">"sundar with a bindu" vs "sundar with a half na"</span></td>
<td id="S0.T1.2.7.3" class="ltx_td ltx_align_center ltx_border_l ltx_border_t"><span id="S0.T1.2.7.3.1" class="ltx_text">No penalty</span></td></tr>
<tr id="S0.T1.2.8" class="ltx_tr">
<th id="S0.T1.2.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t"><span id="S0.T1.2.8.1.1" class="ltx_text">Proper nouns</span></th>
<td id="S0.T1.2.8.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S0.T1.2.8.2.1" class="ltx_text">"Priya" vs "Pria" vs "Preeya" vs "Preya"</span></td>
<td id="S0.T1.2.8.3" class="ltx_td ltx_align_center ltx_border_l ltx_border_t"><span id="S0.T1.2.8.3.1" class="ltx_text">No penalty</span></td></tr>
