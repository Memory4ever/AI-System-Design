<td id="S4.T2.2.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T2.2.2.4.1" class="ltx_text">32</span></td>
