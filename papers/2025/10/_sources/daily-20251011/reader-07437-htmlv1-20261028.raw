<td id="S0.T1.2.3.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S0.T1.2.3.2.1" class="ltx_text">"ATM" vs "Ay Ti Em" vs "Ay tee yum"</span></td>
<td id="S0.T1.2.3.3" class="ltx_td ltx_align_center ltx_border_l ltx_border_t"><span id="S0.T1.2.3.3.1" class="ltx_text">No penalty</span></td></tr>
