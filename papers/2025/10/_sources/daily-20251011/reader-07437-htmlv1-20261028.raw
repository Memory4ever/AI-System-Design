<th id="S0.T1.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t"><span id="S0.T1.2.6.1.1" class="ltx_text">Actual transliterations</span></th>
<td id="S0.T1.2.6.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S0.T1.2.6.2.1" class="ltx_text">"ice cream" vs "ayskrim" or "aaiskrim"</span></td>
<td id="S0.T1.2.6.3" class="ltx_td ltx_align_center ltx_border_l ltx_border_t"><span id="S0.T1.2.6.3.1" class="ltx_text">No penalty</span></td></tr>
<tr id="S0.T1.2.7" class="ltx_tr">
