<td id="S0.T1.2.4.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S0.T1.2.4.2.1" class="ltx_text">"bhajan sangraha" vs "bhajansangraha"</span></td>
<td id="S0.T1.2.4.3" class="ltx_td ltx_align_center ltx_border_l ltx_border_t"><span id="S0.T1.2.4.3.1" class="ltx_text">No penalty</span></td></tr>
<tr id="S0.T1.2.5" class="ltx_tr">
<th id="S0.T1.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t"><span id="S0.T1.2.5.1.1" class="ltx_text">Transliterations (Native spellings)</span></th>
<td id="S0.T1.2.5.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S0.T1.2.5.2.1" class="ltx_text">"ayskreem" vs "aaiskrim" or "skul" vs "skool"</span></td>
<td id="S0.T1.2.5.3" class="ltx_td ltx_align_center ltx_border_l ltx_border_t"><span id="S0.T1.2.5.3.1" class="ltx_text">No penalty</span></td></tr>
