<tbody class="ltx_tbody">
<tr id="A2.T6.6.2" class="ltx_tr">
<th id="A2.T6.6.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Zero-shot CLIP</th>
<td id="A2.T6.6.2.2" class="ltx_td ltx_align_center ltx_border_t">74.34</td>
<td id="A2.T6.6.2.3" class="ltx_td ltx_align_center ltx_border_t">60.97</td>
