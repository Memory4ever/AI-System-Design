<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S4.F3.sf1.3" class="ltx_text" style="font-size:90%;">(a)</span> </span><math id="S4.F3.sf1.m2" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math></figcaption>
