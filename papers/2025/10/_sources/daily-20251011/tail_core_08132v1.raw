<th id="A2.T6.6.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A2.T6.6.1.2.1" class="ltx_text ltx_font_italic">art</span></th>
<th id="A2.T6.6.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A2.T6.6.1.3.1" class="ltx_text ltx_font_italic">clipart</span></th>
<th id="A2.T6.6.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A2.T6.6.1.4.1" class="ltx_text ltx_font_italic">product</span></th>
<th id="A2.T6.6.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A2.T6.6.1.5.1" class="ltx_text ltx_font_italic">real</span></th></tr>
