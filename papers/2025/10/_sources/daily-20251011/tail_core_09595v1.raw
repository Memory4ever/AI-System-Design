<span id="A1.SS5.p2.pic1.1.12.8.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_r"><span id="A1.SS5.p2.pic1.1.12.8.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">18</span></span>
<span id="A1.SS5.p2.pic1.1.12.8.3" class="ltx_td ltx_align_left ltx_border_b ltx_border_r"><span id="A1.SS5.p2.pic1.1.12.8.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">No additional constraints.</span></span></span>
