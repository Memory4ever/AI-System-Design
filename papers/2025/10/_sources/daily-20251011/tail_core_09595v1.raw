<td id="A1.T2.2.4.5" class="ltx_td ltx_align_center"><math id="A1.T2.m12" class="ltx_Math" alttext="19" display="inline" intent=":literal"><semantics><mn>19</mn><annotation encoding="application/x-tex">19</annotation></semantics></math></td></tr>
