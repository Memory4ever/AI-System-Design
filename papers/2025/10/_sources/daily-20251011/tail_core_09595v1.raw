<tr id="S4.T2.2.1.19" class="ltx_tr">
<td id="S4.T2.2.1.19.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T2.2.1.19.1.1" class="ltx_text" style="position:relative; bottom:-2.2pt;"><img src="2510.09595v1/figures/logos/deepseek.png" id="S4.T2.g21" class="ltx_graphics ltx_img_square" style="aspect-ratio:17/17;" width="17" height="17" alt="[Uncaptioned image]"></span>  DeepSeek-V3</td>
<td id="S4.T2.2.1.19.2" class="ltx_td ltx_align_center ltx_border_t">4.17</td>
<td id="S4.T2.2.1.19.3" class="ltx_td ltx_align_center ltx_border_t">34.72</td>
