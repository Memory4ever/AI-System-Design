mathcolor="#000000">i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> such that <math id="A1.SS5.p2.pic1.m46" class="ltx_Math" alttext="0\leq i&lt;N" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow><annotation encoding="application/x-tex">0\leq i&lt;N</annotation></semantics></math></span></span></span>
