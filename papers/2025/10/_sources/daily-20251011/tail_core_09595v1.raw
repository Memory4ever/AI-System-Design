<td id="A1.T2.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="A1.T2.m2" class="ltx_Math" alttext="15.78" display="inline" intent=":literal"><semantics><mn>15.78</mn><annotation encoding="application/x-tex">15.78</annotation></semantics></math></td>
<td id="A1.T2.2.2.4" class="ltx_td ltx_align_center ltx_border_t"><math id="A1.T2.m3" class="ltx_Math" alttext="13.76" display="inline" intent=":literal"><semantics><mn>13.76</mn><annotation encoding="application/x-tex">13.76</annotation></semantics></math></td>
<td id="A1.T2.2.2.5" class="ltx_td ltx_align_center ltx_border_t"><math id="A1.T2.m4" class="ltx_Math" alttext="17" display="inline" intent=":literal"><semantics><mn>17</mn><annotation encoding="application/x-tex">17</annotation></semantics></math></td></tr>
