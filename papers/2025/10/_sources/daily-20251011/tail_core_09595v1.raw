<td id="A1.T2.2.3.4" class="ltx_td ltx_align_center"><math id="A1.T2.m7" class="ltx_Math" alttext="18.05" display="inline" intent=":literal"><semantics><mn>18.05</mn><annotation encoding="application/x-tex">18.05</annotation></semantics></math></td>
