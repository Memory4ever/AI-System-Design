<span id="A1.SS5.p2.pic1.1.12.6.2" class="ltx_td ltx_align_center ltx_border_r"><span id="A1.SS5.p2.pic1.1.12.6.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">20</span></span>
