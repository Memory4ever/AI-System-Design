r"> </span><span id="lstnumberx5.25" class="ltx_text ltx_font_typewriter">+</span><span id="lstnumberx5.26" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx5.27" class="ltx_text ltx_lst_identifier ltx_font_typewriter">nn</span><span id="lstnumberx5.28" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx5.29" class="ltx_text ltx_lst_identifier ltx_font_typewriter">tanh</span><span id="lstnumberx5.30" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx5.31" class="ltx_text ltx_lst_identifier ltx_font_typewriter">pre_stds</span><span id="lstnumberx5.32" class="ltx_text ltx_font_typewriter">))</span>
