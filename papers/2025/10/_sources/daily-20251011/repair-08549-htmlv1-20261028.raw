<td id="S5.T3.4.1.10.3" class="ltx_td ltx_align_center"><span id="S5.T3.4.1.10.3.1" class="ltx_text ltx_font_bold">15.2</span></td>
<td id="S5.T3.4.1.10.4" class="ltx_td ltx_align_center"><span id="S5.T3.4.1.10.4.1" class="ltx_text ltx_font_bold">63.8</span></td>
