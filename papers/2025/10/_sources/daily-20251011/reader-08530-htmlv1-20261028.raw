<tr id="S7.T8.1.2" class="ltx_tr">
<td id="S7.T8.1.2.1" class="ltx_td ltx_align_center ltx_border_t" style="padding:2.15pt 2.5pt;"><span id="S7.T8.1.2.1.1" class="ltx_text" style="font-size:80%;">No-Ref</span></td>
<td id="S7.T8.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:2.15pt 2.5pt;"><span id="S7.T8.1.2.2.1" class="ltx_text" style="font-size:80%;">8.0562</span></td>
<td id="S7.T8.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:2.15pt 2.5pt;"><span id="S7.T8.1.2.3.1" class="ltx_text" style="font-size:80%;">69.3828</span></td>
<td id="S7.T8.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:2.15pt 2.5pt;"><span id="S7.T8.1.2.4.1" class="ltx_text" style="font-size:80%;">22.6641</span></td>
<td id="S7.T8.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:2.15pt 2.5pt;"><span id="S7.T8.1.2.5.1" class="ltx_text" style="font-size:80%;">1.0115</span></td>
<td id="S7.T8.1.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:2.15pt 2.5pt;"><span id="S7.T8.1.2.6.1" class="ltx_text" style="font-size:80%;">1.08s</span></td></tr>
<tr id="S7.T8.1.3" class="ltx_tr">
<td id="S7.T8.1.3.1" class="ltx_td ltx_align_center ltx_border_t" style="padding:2.15pt 2.5pt;"><span id="S7.T8.1.3.1.1" class="ltx_text" style="font-size:80%;">Ref-First</span></td>
<td id="S7.T8.1.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:2.15pt 2.5pt;"><span id="S7.T8.1.3.2.1" class="ltx_text" style="font-size:80%;">5.2770</span></td>
<td id="S7.T8.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:2.15pt 2.5pt;"><span id="S7.T8.1.3.3.1" class="ltx_text" style="font-size:80%;">42.4124</span></td>
<td id="S7.T8.1.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:2.15pt 2.5pt;"><span id="S7.T8.1.3.4.1" class="ltx_text" style="font-size:80%;">26.2617</span></td>
<td id="S7.T8.1.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:2.15pt 2.5pt;"><span id="S7.T8.1.3.5.1" class="ltx_text" style="font-size:80%;">1.0165</span></td>
<td id="S7.T8.1.3.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:2.15pt 2.5pt;"><span id="S7.T8.1.3.6.1" class="ltx_text" style="font-size:80%;">1.20s</span></td></tr>
<tr id="S7.T8.1.4" class="ltx_tr">
<td id="S7.T8.1.4.1" class="ltx_td ltx_align_center" style="padding:2.15pt 2.5pt;"><span id="S7.T8.1.4.1.1" class="ltx_text" style="font-size:80%;">Ref-Keyframe</span></td>
<td id="S7.T8.1.4.2" class="ltx_td ltx_align_center" style="padding:2.15pt 2.5pt;"><span id="S7.T8.1.4.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;">1.9937</span></td>
