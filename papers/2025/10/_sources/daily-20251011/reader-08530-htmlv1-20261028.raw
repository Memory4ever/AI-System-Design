<td id="S6.T7.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2.15pt;padding-bottom:2.15pt;"><span id="S6.T7.1.2.4.1" class="ltx_text" style="font-size:80%;">21.5126</span></td>
