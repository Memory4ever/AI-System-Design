<td id="S6.T7.1.3.1" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:2.15pt;padding-bottom:2.15pt;"><span id="S6.T7.1.3.1.1" class="ltx_text" style="font-size:80%;">Recursive (Ours)</span></td>
<td id="S6.T7.1.3.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:2.15pt;padding-bottom:2.15pt;"><span id="S6.T7.1.3.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;">8.0562</span></td>
