<span id="S6.T5.1.5.1.2.1.1" class="ltx_tabular ltx_align_middle">
<span id="S6.T5.1.5.1.2.1.1.1" class="ltx_tr">
<span id="S6.T5.1.5.1.2.1.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:2.15pt 2.0pt;">Masked</span></span>
