<td id="S3.T1.1.5.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding:2.55pt 4.0pt;"><span id="S3.T1.1.5.4.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#00FF00;">✓</span></td>
<td id="S3.T1.1.5.5" class="ltx_td ltx_align_center ltx_border_bb" style="padding:2.55pt 4.0pt;"><span id="S3.T1.1.5.5.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#00FF00;">✓</span></td>
