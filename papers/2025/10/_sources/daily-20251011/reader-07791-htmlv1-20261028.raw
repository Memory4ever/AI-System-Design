<td id="S5.T4.2.1.3.1" class="ltx_td ltx_align_left ltx_border_t" colspan="17"><span id="S5.T4.2.1.3.1.1" class="ltx_text ltx_font_bold ltx_font_italic" style="--ltx-fg-color:#000000;">Proprietary Models (API)</span></td></tr>
<tr id="S5.T4.2.1.4" class="ltx_tr">
<td id="S5.T4.2.1.4.1" class="ltx_td ltx_align_left">Claude-3-7-Sonnet</td>
<td id="S5.T4.2.1.4.2" class="ltx_td ltx_align_center">7</td>
<td id="S5.T4.2.1.4.3" class="ltx_td ltx_align_center">53.33</td>
