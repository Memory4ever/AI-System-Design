<td id="S4.T3.2.5.6" class="ltx_td ltx_align_center" style="padding:1pt 4.0pt;"><span id="S4.T3.2.5.6.1" class="ltx_text ltx_font_bold">98.7</span></td></tr>
<tr id="S4.T3.2.6" class="ltx_tr">
