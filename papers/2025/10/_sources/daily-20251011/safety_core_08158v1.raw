<td id="S4.T3.2.3.6" class="ltx_td ltx_align_center" style="padding:1pt 4.0pt;"><span id="S4.T3.2.3.6.1" class="ltx_text ltx_font_bold">97.5</span></td></tr>
<tr id="S4.T3.2.4" class="ltx_tr">
<td id="S4.T3.2.4.1" class="ltx_td ltx_border_r" style="padding:1pt 4.0pt;"></td>
<td id="S4.T3.2.4.2" class="ltx_td ltx_align_left" style="padding:1pt 4.0pt;">Llama-3-8B</td>
