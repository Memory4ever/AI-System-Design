<td id="S4.T3.2.1.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" colspan="2"><span id="S4.T3.2.1.1.3.1" class="ltx_text ltx_font_bold">VisualEnc</span></td>
<td id="S4.T3.2.1.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" colspan="2"><span id="S4.T3.2.1.1.4.1" class="ltx_text ltx_font_bold">FusionStage</span></td>
<td id="S4.T3.2.1.1.5" class="ltx_td ltx_align_center ltx_border_tt" colspan="2"><span id="S4.T3.2.1.1.5.1" class="ltx_text ltx_font_bold">PatchSize STD</span></td></tr>
