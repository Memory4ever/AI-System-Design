<th id="S5.T3.4.1.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column">MAE <math id="S5.T3.m6" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></th></tr>
</thead>
