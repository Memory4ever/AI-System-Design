<td id="S5.T1.6.1.2.3" class="ltx_td ltx_align_center"><math id="S5.T1.m6" class="ltx_Math" alttext="r_{s}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>s</mi></msub><annotation encoding="application/x-tex">r_{s}</annotation></semantics></math> <math id="S5.T1.m7" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
