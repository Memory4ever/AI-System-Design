<td id="S5.T1.6.1.2.8" class="ltx_td ltx_align_center ltx_border_r">MAE <math id="S5.T1.m14" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td>
