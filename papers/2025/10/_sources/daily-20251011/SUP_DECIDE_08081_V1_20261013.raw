<td id="S5.T1.6.1.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" colspan="2"><span id="S5.T1.6.1.1.2.1" class="ltx_text ltx_font_bold">Meituan</span></td>
<td id="S5.T1.6.1.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" colspan="2"><span id="S5.T1.6.1.1.3.1" class="ltx_text ltx_font_bold">Cell Phones</span></td>
<td id="S5.T1.6.1.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" colspan="2"><span id="S5.T1.6.1.1.4.1" class="ltx_text ltx_font_bold">Office Products</span></td>
