<td id="S5.T4.2.1.8.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T4.m33" class="ltx_Math" alttext="-\textbf{0.2340}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mtext class="ltx_mathvariant_bold">0.2340</mtext></mrow><annotation encoding="application/x-tex">-\textbf{0.2340}</annotation></semantics></math></td>
