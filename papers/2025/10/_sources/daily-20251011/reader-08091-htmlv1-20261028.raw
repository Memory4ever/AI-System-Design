<td id="A1.T5.2.3.6" class="ltx_td ltx_align_center ltx_border_t"><math id="A1.T5.m5" class="ltx_Math" alttext="-\textbf{0.0074}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mtext class="ltx_mathvariant_bold">0.0074</mtext></mrow><annotation encoding="application/x-tex">-\textbf{0.0074}</annotation></semantics></math></td>
<td id="A1.T5.2.3.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="A1.T5.m6" class="ltx_Math" alttext="-0.0023" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>0.0023</mn></mrow><annotation encoding="application/x-tex">-0.0023</annotation></semantics></math></td></tr>
