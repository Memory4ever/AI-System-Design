<td id="A1.T5.2.4.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="A1.T5.m9" class="ltx_Math" alttext="-\textbf{0.0113}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mtext class="ltx_mathvariant_bold">0.0113</mtext></mrow><annotation encoding="application/x-tex">-\textbf{0.0113}</annotation></semantics></math></td>
<td id="A1.T5.2.4.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r ltx_border_t"><math id="A1.T5.m10" class="ltx_Math" alttext="-\textbf{0.0046}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mtext class="ltx_mathvariant_bold">0.0046</mtext></mrow><annotation encoding="application/x-tex">-\textbf{0.0046}</annotation></semantics></math></td>
