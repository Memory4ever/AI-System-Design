<td id="A1.T5.2.4.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_l ltx_border_r ltx_border_t">CQA</td>
<td id="A1.T5.2.4.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="A1.T5.m7" class="ltx_Math" alttext="-0.0042" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>0.0042</mn></mrow><annotation encoding="application/x-tex">-0.0042</annotation></semantics></math></td>
