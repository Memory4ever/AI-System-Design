<td id="A1.T5.2.3.4" class="ltx_td ltx_align_center ltx_border_t"><math id="A1.T5.m3" class="ltx_Math" alttext="-\textbf{0.0068}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mtext class="ltx_mathvariant_bold">0.0068</mtext></mrow><annotation encoding="application/x-tex">-\textbf{0.0068}</annotation></semantics></math></td>
