<tr id="S4.T2.2.5" class="ltx_tr">
<td id="S4.T2.2.5.1" class="ltx_td ltx_align_left">MACD</td>
<td id="S4.T2.2.5.2" class="ltx_td ltx_align_left ltx_border_r">N/A</td>
