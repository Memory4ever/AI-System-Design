<td id="S4.T2.2.1.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" rowspan="2"><span id="S4.T2.2.1.2.1" class="ltx_text ltx_font_bold">Prompting</span></td>
<td id="S4.T2.2.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" colspan="3"><span id="S4.T2.2.1.3.1" class="ltx_text ltx_font_bold">XOM</span></td>
