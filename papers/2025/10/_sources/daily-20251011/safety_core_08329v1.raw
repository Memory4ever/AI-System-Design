<td id="A16.T12.3.1.3.2" class="ltx_td ltx_align_center" style="padding-top:0.45pt;padding-bottom:0.45pt;"><span id="A16.T12.3.1.3.2.1" class="ltx_text" style="font-size:90%;">1.20</span></td>
<td id="A16.T12.3.1.3.3" class="ltx_td ltx_align_center" style="padding-top:0.45pt;padding-bottom:0.45pt;"><span id="A16.T12.3.1.3.3.1" class="ltx_text" style="font-size:90%;">5.40</span></td>
<td id="A16.T12.3.1.3.4" class="ltx_td ltx_align_center" style="padding-top:0.45pt;padding-bottom:0.45pt;"><span id="A16.T12.3.1.3.4.1" class="ltx_text" style="font-size:90%;">31.90</span></td>
<td id="A16.T12.3.1.3.5" class="ltx_td ltx_align_center" style="padding-top:0.45pt;padding-bottom:0.45pt;"><span id="A16.T12.3.1.3.5.1" class="ltx_text" style="font-size:90%;">24.00</span></td>
<td id="A16.T12.3.1.3.6" class="ltx_td ltx_align_center" style="padding-top:0.45pt;padding-bottom:0.45pt;"><span id="A16.T12.3.1.3.6.1" class="ltx_text" style="font-size:90%;">48.10</span></td>
<td id="A16.T12.3.1.3.7" class="ltx_td ltx_align_center" style="padding-top:0.45pt;padding-bottom:0.45pt;"><span id="A16.T12.3.1.3.7.1" class="ltx_text" style="font-size:90%;">74.98</span></td>
<td id="A16.T12.3.1.3.8" class="ltx_td ltx_align_center" style="padding-top:0.45pt;padding-bottom:0.45pt;"><span id="A16.T12.3.1.3.8.1" class="ltx_text" style="font-size:90%;">81.46</span></td></tr>
