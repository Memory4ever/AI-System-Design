<td id="A15.T11.3.1.2.5" class="ltx_td ltx_align_center ltx_border_t">0.2604</td>
<td id="A15.T11.3.1.2.6" class="ltx_td ltx_align_center ltx_border_t">0.3696</td>
<td id="A15.T11.3.1.2.7" class="ltx_td ltx_align_center ltx_border_t">0.4103</td></tr>
<tr id="A15.T11.3.1.3" class="ltx_tr">
<th id="A15.T11.3.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_r">ReNellm</th>
<td id="A15.T11.3.1.3.2" class="ltx_td ltx_align_center ltx_border_bb">0.7465</td>
