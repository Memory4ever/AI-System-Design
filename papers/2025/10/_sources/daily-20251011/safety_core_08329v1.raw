<th id="A15.T11.3.1.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A15.T11.3.1.1.7.1" class="ltx_text ltx_font_bold">Qwen2.5-72B</span></th></tr>
