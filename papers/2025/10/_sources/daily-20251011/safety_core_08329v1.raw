<td id="A16.T12.3.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.45pt;padding-bottom:0.45pt;"><span id="A16.T12.3.1.2.4.1" class="ltx_text" style="font-size:90%;">36.75</span></td>
<td id="A16.T12.3.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.45pt;padding-bottom:0.45pt;"><span id="A16.T12.3.1.2.5.1" class="ltx_text" style="font-size:90%;">42.59</span></td>
<td id="A16.T12.3.1.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.45pt;padding-bottom:0.45pt;"><span id="A16.T12.3.1.2.6.1" class="ltx_text" style="font-size:90%;">53.15</span></td>
<td id="A16.T12.3.1.2.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.45pt;padding-bottom:0.45pt;"><span id="A16.T12.3.1.2.7.1" class="ltx_text" style="font-size:90%;">77.67</span></td>
<td id="A16.T12.3.1.2.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.45pt;padding-bottom:0.45pt;"><span id="A16.T12.3.1.2.8.1" class="ltx_text" style="font-size:90%;">81.83</span></td></tr>
