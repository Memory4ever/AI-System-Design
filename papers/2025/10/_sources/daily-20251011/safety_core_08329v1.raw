<tbody class="ltx_tbody">
<tr id="A15.T11.3.1.2" class="ltx_tr">
<th id="A15.T11.3.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t">AutoRed</th>
<td id="A15.T11.3.1.2.2" class="ltx_td ltx_align_center ltx_border_t">0.8344</td>
