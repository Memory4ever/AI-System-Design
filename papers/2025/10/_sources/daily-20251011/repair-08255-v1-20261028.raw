<th id="A1.T8.6.12.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Mini Batch Size</th>
<td id="A1.T8.6.12.2" class="ltx_td ltx_align_left"><math id="A1.T8.m10" class="ltx_Math" alttext="10" display="inline" intent=":literal"><semantics><mn>10</mn><annotation encoding="application/x-tex">10</annotation></semantics></math></td></tr>
