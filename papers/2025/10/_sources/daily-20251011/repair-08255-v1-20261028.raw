<td id="S6.T3.2.4.2" class="ltx_td ltx_align_center ltx_border_bb"><math id="S6.T3.m11" class="ltx_Math" alttext="1.30\pm 0.52" display="inline" intent=":literal"><semantics><mrow><mn>1.30</mn><mo>±</mo><mn>0.52</mn></mrow><annotation encoding="application/x-tex">1.30\pm 0.52</annotation></semantics></math></td>
<td id="S6.T3.2.4.3" class="ltx_td ltx_align_center ltx_border_bb"><math id="S6.T3.m12" class="ltx_Math" alttext="1.30\pm 0.52" display="inline" intent=":literal"><semantics><mrow><mn>1.30</mn><mo>±</mo><mn>0.52</mn></mrow><annotation encoding="application/x-tex">1.30\pm 0.52</annotation></semantics></math></td>
<td id="S6.T3.2.4.4" class="ltx_td ltx_align_center ltx_border_bb"><math id="S6.T3.m13" class="ltx_Math" alttext="3.96\pm 0.02" display="inline" intent=":literal"><semantics><mrow><mn>3.96</mn><mo>±</mo><mn>0.02</mn></mrow><annotation encoding="application/x-tex">3.96\pm 0.02</annotation></semantics></math></td>
<td id="S6.T3.2.4.5" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_bb"><math id="S6.T3.m14" class="ltx_Math" alttext="3.96\pm 0.02" display="inline" intent=":literal"><semantics><mrow><mn>3.96</mn><mo>±</mo><mn>0.02</mn></mrow><annotation encoding="application/x-tex">3.96\pm 0.02</annotation></semantics></math></td></tr>
