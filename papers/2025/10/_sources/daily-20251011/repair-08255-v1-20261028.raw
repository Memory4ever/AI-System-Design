<td id="S5.T2.2.3.6" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T2.m12" class="ltx_Math" alttext="3.98\pm 0.02" display="inline" intent=":literal"><semantics><mrow><mn>3.98</mn><mo>±</mo><mn>0.02</mn></mrow><annotation encoding="application/x-tex">3.98\pm 0.02</annotation></semantics></math></td>
<td id="S5.T2.2.3.7" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t"><math id="S5.T2.m13" class="ltx_Math" alttext="0.07\pm 0.07" display="inline" intent=":literal"><semantics><mrow><mn>0.07</mn><mo>±</mo><mn>0.07</mn></mrow><annotation encoding="application/x-tex">0.07\pm 0.07</annotation></semantics></math></td></tr>
