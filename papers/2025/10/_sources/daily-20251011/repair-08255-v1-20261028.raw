<th id="A1.T15.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="2"><span id="A1.T15.2.1.3.1" class="ltx_text ltx_font_bold">IMP</span></th>
