<td id="S5.T2.2.4.2" class="ltx_td ltx_align_center"><math id="S5.T2.m14" class="ltx_Math" alttext="0.96\pm 0.02" display="inline" intent=":literal"><semantics><mrow><mn>0.96</mn><mo>±</mo><mn>0.02</mn></mrow><annotation encoding="application/x-tex">0.96\pm 0.02</annotation></semantics></math></td>
<td id="S5.T2.2.4.3" class="ltx_td ltx_align_center"><math id="S5.T2.m15" class="ltx_Math" alttext="-0.96\pm 0.02" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mn>0.96</mn></mrow><mo>±</mo><mn>0.02</mn></mrow><annotation encoding="application/x-tex">-0.96\pm 0.02</annotation></semantics></math></td>
<td id="S5.T2.2.4.4" class="ltx_td ltx_align_center"><math id="S5.T2.m16" class="ltx_Math" alttext="0.99\pm 0.01" display="inline" intent=":literal"><semantics><mrow><mn>0.99</mn><mo>±</mo><mn>0.01</mn></mrow><annotation encoding="application/x-tex">0.99\pm 0.01</annotation></semantics></math></td>
<td id="S5.T2.2.4.5" class="ltx_td ltx_align_center"><math id="S5.T2.m17" class="ltx_Math" alttext="-0.99\pm 0.01" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mn>0.99</mn></mrow><mo>±</mo><mn>0.01</mn></mrow><annotation encoding="application/x-tex">-0.99\pm 0.01</annotation></semantics></math></td>
<td id="S5.T2.2.4.6" class="ltx_td ltx_align_center"><math id="S5.T2.m18" class="ltx_Math" alttext="0.99\pm 0.01" display="inline" intent=":literal"><semantics><mrow><mn>0.99</mn><mo>±</mo><mn>0.01</mn></mrow><annotation encoding="application/x-tex">0.99\pm 0.01</annotation></semantics></math></td>
