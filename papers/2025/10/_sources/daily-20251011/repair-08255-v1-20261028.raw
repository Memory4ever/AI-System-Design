<td id="A1.T8.6.13.2" class="ltx_td ltx_align_left"><math id="A1.T8.m11" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> (default)</td></tr>
<tr id="A1.T8.6.14" class="ltx_tr">
<th id="A1.T8.6.14.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">PPO epochs</th>
<td id="A1.T8.6.14.2" class="ltx_td ltx_align_left"><math id="A1.T8.m12" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math></td></tr>
