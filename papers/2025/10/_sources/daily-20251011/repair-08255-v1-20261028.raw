<th id="S6.T3.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="2"><span id="S6.T3.2.1.3.1" class="ltx_text ltx_font_bold">One Shaper</span></th></tr>
<tr id="S6.T3.2.2" class="ltx_tr">
