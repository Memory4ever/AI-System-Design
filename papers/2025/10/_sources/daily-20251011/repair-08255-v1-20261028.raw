<td id="A1.T8.6.10.2" class="ltx_td ltx_align_left"><math id="A1.T8.m8" class="ltx_Math" alttext="0.2" display="inline" intent=":literal"><semantics><mn>0.2</mn><annotation encoding="application/x-tex">0.2</annotation></semantics></math> (default)</td></tr>
