</thead>
<tbody class="ltx_tbody">
<tr id="S6.T3.2.3" class="ltx_tr">
<th id="S6.T3.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">C-IPD</th>
<td id="S6.T3.2.3.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S6.T3.m7" class="ltx_Math" alttext="1.00\pm 0.00" display="inline" intent=":literal"><semantics><mrow><mn>1.00</mn><mo>±</mo><mn>0.00</mn></mrow><annotation encoding="application/x-tex">1.00\pm 0.00</annotation></semantics></math></td>
<td id="S6.T3.2.3.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S6.T3.m8" class="ltx_Math" alttext="1.00\pm 0.00" display="inline" intent=":literal"><semantics><mrow><mn>1.00</mn><mo>±</mo><mn>0.00</mn></mrow><annotation encoding="application/x-tex">1.00\pm 0.00</annotation></semantics></math></td>
<td id="S6.T3.2.3.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S6.T3.m9" class="ltx_Math" alttext="5.88\pm 0.03" display="inline" intent=":literal"><semantics><mrow><mn>5.88</mn><mo>±</mo><mn>0.03</mn></mrow><annotation encoding="application/x-tex">5.88\pm 0.03</annotation></semantics></math></td>
<td id="S6.T3.2.3.5" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t"><math id="S6.T3.m10" class="ltx_Math" alttext="2.86\pm 0.02" display="inline" intent=":literal"><semantics><mrow><mn>2.86</mn><mo>±</mo><mn>0.02</mn></mrow><annotation encoding="application/x-tex">2.86\pm 0.02</annotation></semantics></math></td></tr>
<tr id="S6.T3.2.4" class="ltx_tr">
