<td id="A2.T7.2.1.3.14" class="ltx_td ltx_align_center ltx_border_t">19.2%</td></tr>
<tr id="A2.T7.2.1.4" class="ltx_tr">
<th id="A2.T7.2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Setting 2</th>
<th id="A2.T7.2.1.4.2" class="ltx_td ltx_align_left ltx_th ltx_th_row">GPT<math id="A2.T7.m1" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math>GPT (zero)</th>
<td id="A2.T7.2.1.4.3" class="ltx_td ltx_align_center">.863</td>
