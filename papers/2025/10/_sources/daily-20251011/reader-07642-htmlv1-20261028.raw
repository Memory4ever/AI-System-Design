<span id="S3.T1.2.2.1.1" class="ltx_inline-block ltx_align_top">
<span id="S3.T1.2.2.1.1.1" class="ltx_p"><span id="S3.T1.2.2.1.1.1.1" class="ltx_text ltx_font_typewriter">Spider-ACL</span></span>
</span></td>
<td id="S3.T1.2.2.2" class="ltx_td ltx_align_center ltx_border_t">153</td>
<td id="S3.T1.2.2.3" class="ltx_td ltx_align_center ltx_border_t">612</td>
<td id="S3.T1.2.2.4" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">19.6k</td></tr>
<tr id="S3.T1.2.3" class="ltx_tr">
<td id="S3.T1.2.3.1" class="ltx_td ltx_align_left ltx_border_bb">
<span id="S3.T1.2.3.1.1" class="ltx_inline-block ltx_align_top">
<span id="S3.T1.2.3.1.1.1" class="ltx_p"><span id="S3.T1.2.3.1.1.1.1" class="ltx_text ltx_font_typewriter">BIRD-ACL</span></span>
</span></td>
<td id="S3.T1.2.3.2" class="ltx_td ltx_align_center ltx_border_bb">80</td>
