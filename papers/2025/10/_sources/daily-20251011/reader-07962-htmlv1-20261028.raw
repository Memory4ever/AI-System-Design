<tr id="S3.T4.4.6" class="ltx_tr">
<td id="S3.T4.4.6.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding:0.5pt 2.0pt;">Independent inference</td>
<td id="S3.T4.4.6.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.5pt 2.0pt;"><math id="S3.T4.m8" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#009900;" mathcolor="#009900" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
