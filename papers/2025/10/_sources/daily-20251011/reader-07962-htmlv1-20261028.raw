<td id="S3.T3.4.5.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.5pt 3.5pt;"><span id="S3.T3.4.5.4.1" class="ltx_text" style="--ltx-fg-color:#009900;">✓</span></td></tr>
