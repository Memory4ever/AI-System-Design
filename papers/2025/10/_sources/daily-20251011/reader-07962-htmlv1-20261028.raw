<tbody class="ltx_tbody">
<tr id="S3.T4.4.3" class="ltx_tr">
<td id="S3.T4.4.3.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.5pt 2.0pt;">Size-based contrast</td>
<td id="S3.T4.4.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.5pt 2.0pt;"><math id="S3.T4.m5" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td>
<td id="S3.T4.4.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.5pt 2.0pt;"><span id="S3.T4.4.3.3.1" class="ltx_text" style="--ltx-fg-color:#009900;">✓</span></td>
<td id="S3.T4.4.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.5pt 2.0pt;"><span id="S3.T4.4.3.4.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">✗</span></td></tr>
<tr id="S3.T4.4.4" class="ltx_tr">
<td id="S3.T4.4.4.1" class="ltx_td ltx_align_left" style="padding:0.5pt 2.0pt;">Expertise contrast</td>
<td id="S3.T4.4.4.2" class="ltx_td ltx_align_center" style="padding:0.5pt 2.0pt;"><math id="S3.T4.m6" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#009900;" mathcolor="#009900" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="S3.T4.4.4.3" class="ltx_td ltx_align_center" style="padding:0.5pt 2.0pt;"><span id="S3.T4.4.4.3.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">✗</span></td>
<td id="S3.T4.4.4.4" class="ltx_td ltx_align_center" style="padding:0.5pt 2.0pt;"><span id="S3.T4.4.4.4.1" class="ltx_text" style="--ltx-fg-color:#009900;">✓</span></td></tr>
