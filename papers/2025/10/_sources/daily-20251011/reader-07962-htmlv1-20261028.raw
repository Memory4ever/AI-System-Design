<td id="S3.T4.4.5.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.5pt 2.0pt;"><math id="S3.T4.m7" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#009900;" mathcolor="#009900" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="S3.T4.4.5.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.5pt 2.0pt;"><span id="S3.T4.4.5.3.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">✗</span></td>
