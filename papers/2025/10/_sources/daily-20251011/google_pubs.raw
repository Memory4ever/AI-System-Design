          <a class="row-card__heading glue-link" href=https://research.google/pubs/agentic-coding-needs-proactivity-not-just-autonomy/ >
            
              Agentic Coding Needs Proactivity, Not Just Autonomy
            
          </a>
        
        <div class="row-card__subheading">
          
            
              
                
                  
                    <div class="row-card__subheading__item small-text">
                      
                        <a class="row-card__small-link" href="/people/nghibui/">
                          Nghi Bui
                        </a>
                      
                    </div>
                
              
            
              
                
                  
