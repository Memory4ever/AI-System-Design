<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Algorithm</h2>

<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> Guided Topology Diffusion (GTD) Generation</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">1:</span>
            
            
          <span id="alg1.l1.2" class="ltx_text ltx_font_bold">Input:</span> Task condition <math id="alg1.l1.m1" class="ltx_Math" alttext="C_{\text{new}}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mtext>new</mtext></msub><annotation encoding="application/x-tex">C_{\text{new}}</annotation></semantics></math>, trained models <math id="alg1.l1.m2" class="ltx_Math" alttext="\mathcal{G}_{\theta^{*}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><annotation encoding="application/x-tex">\mathcal{G}_{\theta^{*}}</annotation></semantics></math>, <math id="alg1.l1.m3" class="ltx_Math" alttext="\mathcal{P}_{\phi^{*}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><msup><mi>ϕ</mi><mo>∗</mo></msup></msub><annotation encoding="application/x-tex">\mathcal{P}_{\phi^{*}}</annotation></semantics></math>, weights <math id="alg1.l1.m4" class="ltx_Math" alttext="w_{u},w_{c}" display="inline" intent=":literal"><semantics><mrow><msub><mi>w</mi><mi>u</mi></msub><mo>,</mo><msub><mi>w</mi><mi>c</mi></msub></mrow><annotation encoding="application/x-tex">w_{u},w_{c}</annotation></semantics></math>.

</div>
<div id="alg1.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">2:</span>
            
            
          Sample <math id="alg1.l2.m1" class="ltx_Math" alttext="A_{T}\sim\mathcal{N}(0,\mathbf{I})" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>T</mi></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>𝐈</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A_{T}\sim\mathcal{N}(0,\mathbf{I})</annotation></semantics></math>.

</div>
<div id="alg1.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">3:</span>
            
            
          <span id="alg1.l3.2" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l3.m1" class="ltx_Math" alttext="t=T,\dots,1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mi>T</mi></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=T,\dots,1</annotation></semantics></math> <span id="alg1.l3.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">4:</span>
            
            
            Predict the unguided clean graph: <math id="alg1.l4.m1" class="ltx_Math" alttext="\hat{A}_{0}^{(t)}=\mathcal{G}_{\theta^{*}}(A_{t},C_{\text{new}},t)" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>A</mi><mo>^</mo></mover><mn>0</mn><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mi>t</mi></msub><mo>,</mo><msub><mi>C</mi><mtext>new</mtext></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{A}_{0}^{(t)}=\mathcal{G}_{\theta^{*}}(A_{t},C_{\text{new}},t)</annotation></semantics></math>.

</div>
<div id="alg1.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">5:</span>
            
            
            Generate <math id="alg1.l5.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> candidates: <math id="alg1.l5.m2" class="ltx_Math" alttext="\{A_{0,k}^{(t)}\}_{k=1}^{K}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>A</mi><mrow><mn>0</mn><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></msubsup><annotation encoding="application/x-tex">\{A_{0,k}^{(t)}\}_{k=1}^{K}</annotation></semantics></math>, where <math id="alg1.l5.m3" class="ltx_Math" alttext="A_{0,k}^{(t)}\sim\text{Bernoulli}(\text{sigmoid}(\hat{A}_{0}^{(t)}))" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>A</mi><mrow><mn>0</mn><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>∼</mo><mrow><mtext>Bernoulli</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>sigmoid</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>A</mi><mo>^</mo></mover><mn>0</mn><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A_{0,k}^{(t)}\sim\text{Bernoulli}(\text{sigmoid}(\hat{A}_{0}^{(t)}))</annotation></semantics></math>.

</div>
<div id="alg1.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">6:</span>
            
            
            Evaluate candidates: For <math id="alg1.l6.m1" class="ltx_Math" alttext="k=1\dots K" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow><annotation encoding="application/x-tex">k=1\dots K</annotation></semantics></math>, compute <math id="alg1.l6.m2" class="ltx_Math" alttext="[\hat{u}_{k},\hat{c}_{k}]^{T}=\mathcal{P}_{\phi^{*}}(A_{0,k}^{(t)},C_{\text{new}})" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">[</mo><mrow><msub><mover accent="true"><mi>u</mi><mo>^</mo></mover><mi>k</mi></msub><mo>,</mo><msub><mover accent="true"><mi>c</mi><mo>^</mo></mover><mi>k</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mi>T</mi></msup><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><msup><mi>ϕ</mi><mo>∗</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>A</mi><mrow><mn>0</mn><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msub><mi>C</mi><mtext>new</mtext></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">[\hat{u}_{k},\hat{c}_{k}]^{T}=\mathcal{P}_{\phi^{*}}(A_{0,k}^{(t)},C_{\text{new}})</annotation></semantics></math>.

</div>
<div id="alg1.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">7:</span>
            
            
            Select best candidate via ZO: <math id="alg1.l7.m1" class="ltx_Math" alttext="A_{0,\text{best}}^{(t)}=\arg\max_{A_{0,k}^{(t)}}(w_{u}\cdot\hat{u}_{k}-w_{c}\cdot\hat{c}_{k})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>A</mi><mrow><mn>0</mn><mo>,</mo><mtext>best</mtext></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mrow><msub><mi>max</mi><msubsup><mi>A</mi><mrow><mn>0</mn><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>w</mi><mi>u</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mover accent="true"><mi>u</mi><mo>^</mo></mover><mi>k</mi></msub></mrow><mo>−</mo><mrow><msub><mi>w</mi><mi>c</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mover accent="true"><mi>c</mi><mo>^</mo></mover><mi>k</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">A_{0,\text{best}}^{(t)}=\arg\max_{A_{0,k}^{(t)}}(w_{u}\cdot\hat{u}_{k}-w_{c}\cdot\hat{c}_{k})</annotation></semantics></math>.

</div>
<div id="alg1.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">8:</span>
            
            
            Compute posterior mean <math id="alg1.l8.m1" class="ltx_Math" alttext="\bm{\mu}_{\text{post}}" display="inline" intent=":literal"><semantics><msub><mi>𝝁</mi><mtext>post</mtext></msub><annotation encoding="application/x-tex">\bm{\mu}_{\text{post}}</annotation></semantics></math> and variance <math id="alg1.l8.m2" class="ltx_Math" alttext="\bm{\Sigma}_{\text{post}}" display="inline" intent=":literal"><semantics><msub><mi>𝚺</mi><mtext>post</mtext></msub><annotation encoding="application/x-tex">\bm{\Sigma}_{\text{post}}</annotation></semantics></math> for <math id="alg1.l8.m3" class="ltx_Math" alttext="q(A_{t-1}|A_{t},A_{0,\text{best}}^{(t)})" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>A</mi><mi>t</mi></msub><mo>,</mo><msubsup><mi>A</mi><mrow><mn>0</mn><mo>,</mo><mtext>best</mtext></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q(A_{t-1}|A_{t},A_{0,\text{best}}^{(t)})</annotation></semantics></math>.

</div>
<div id="alg1.l9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">9:</span>
            
            
            Sample the next state: <math id="alg1.l9.m1" class="ltx_Math" alttext="A_{t-1}\sim\mathcal{N}(\bm{\mu}_{\text{post}},\bm{\Sigma}_{\text{post}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝁</mi><mtext>post</mtext></msub><mo>,</mo><msub><mi>𝚺</mi><mtext>post</mtext></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A_{t-1}\sim\mathcal{N}(\bm{\mu}_{\text{post}},\bm{\Sigma}_{\text{post}})</annotation></semantics></math>.

</div>
<div id="alg1.l10" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">10:</span>
            
            
          <span id="alg1.l10.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l10.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l11" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">11:</span>
            
            
          <span id="alg1.l11.2" class="ltx_text ltx_font_bold">Output:</span> The final graph <math id="alg1.l11.m1" class="ltx_Math" alttext="A_{0}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>0</mn></msub><annotation encoding="application/x-tex">A_{0}</annotation></semantics></math>.

</div>
</div>
</figure>
</section>
