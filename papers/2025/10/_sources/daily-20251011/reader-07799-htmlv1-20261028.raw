<td id="S4.T1.2.1.19.6" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;"><span id="S4.T1.2.1.19.6.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6FF;">84.58<span id="S4.T1.2.1.19.6.1.1" class="ltx_text ltx_font_medium"> <math id="S4.T1.m118" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#FF0000;--ltx-bg-color:#E6E6FF;" mathbackground="#E6E6FF" mathcolor="#FF0000" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math><span id="S4.T1.2.1.19.6.1.1.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">2.44</span></span></span></td>
<td id="S4.T1.2.1.19.7" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;"><span id="S4.T1.2.1.19.7.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6FF;">91.33<span id="S4.T1.2.1.19.7.1.1" class="ltx_text ltx_font_medium"> <math id="S4.T1.m119" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#FF0000;--ltx-bg-color:#E6E6FF;" mathbackground="#E6E6FF" mathcolor="#FF0000" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math><span id="S4.T1.2.1.19.7.1.1.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">4.66</span></span></span></td>
<td id="S4.T1.2.1.19.8" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_bb ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;"><span id="S4.T1.2.1.19.8.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6FF;">85.74<span id="S4.T1.2.1.19.8.1.1" class="ltx_text ltx_font_medium"> <math id="S4.T1.m120" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#FF0000;--ltx-bg-color:#E6E6FF;" mathbackground="#E6E6FF" mathcolor="#FF0000" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math><span id="S4.T1.2.1.19.8.1.1.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">3.99</span></span></span></td></tr>
</tbody>
</table>
</span></div>
