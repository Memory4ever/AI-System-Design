<th id="S4.T1.2.1.19.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;"><span id="S4.T1.2.1.19.1.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6FF;">GTD (Ours)</span></th>
