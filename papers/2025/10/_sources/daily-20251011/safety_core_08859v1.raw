-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 17.72 860.68)"><foreignObject style="--ltx-fo-width:34.71em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.49" overflow="visible" transform="matrix(1 0 0 -1 0 9.49)" width="480.29"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
