</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 17.72 17.72)"><foreignObject style="--ltx-fo-width:39.92em;--ltx-fo-height:55.87em;--ltx-fo-depth:0em;font-size:10pt;" height="773.09" overflow="visible" transform="matrix(1 0 0 -1 0 773.09)" width="552.38"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A6.F23.pic1.2" class="ltx_inline-logical-block ltx_minipage ltx_align_bottom" style="width:39.92em;">
