<th id="A4.T3.2.1.1.5" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="A4.T3.2.1.1.5.1" class="ltx_text ltx_font_bold">J (<math id="A4.T3.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>)</span></th></tr>
</thead>
