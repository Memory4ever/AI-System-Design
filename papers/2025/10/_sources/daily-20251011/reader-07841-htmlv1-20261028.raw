<td id="A4.T3.2.1.2.2" class="ltx_td ltx_align_left ltx_border_t"><math id="A4.T3.m5" class="ltx_Math" alttext="44.16" display="inline" intent=":literal"><semantics><mn>44.16</mn><annotation encoding="application/x-tex">44.16</annotation></semantics></math></td>
<td id="A4.T3.2.1.2.3" class="ltx_td ltx_align_left ltx_border_t"><math id="A4.T3.m6" class="ltx_Math" alttext="43.78" display="inline" intent=":literal"><semantics><mn>43.78</mn><annotation encoding="application/x-tex">43.78</annotation></semantics></math></td>
<td id="A4.T3.2.1.2.4" class="ltx_td ltx_align_left ltx_border_t"><math id="A4.T3.m7" class="ltx_Math" alttext="33.01" display="inline" intent=":literal"><semantics><mn>33.01</mn><annotation encoding="application/x-tex">33.01</annotation></semantics></math></td>
<td id="A4.T3.2.1.2.5" class="ltx_td ltx_align_left ltx_border_t"><math id="A4.T3.m8" class="ltx_Math" alttext="0.38" display="inline" intent=":literal"><semantics><mn>0.38</mn><annotation encoding="application/x-tex">0.38</annotation></semantics></math></td></tr>
