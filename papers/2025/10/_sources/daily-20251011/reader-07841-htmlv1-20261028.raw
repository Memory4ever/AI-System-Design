<td id="S4.T1.2.1.3.4" class="ltx_td ltx_align_center">74.34<math id="S4.T1.m8" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>1.89</td>
