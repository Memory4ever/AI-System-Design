<td id="A4.T3.2.1.3.4" class="ltx_td ltx_align_left"><math id="A4.T3.m11" class="ltx_Math" alttext="41.51" display="inline" intent=":literal"><semantics><mn>41.51</mn><annotation encoding="application/x-tex">41.51</annotation></semantics></math></td>
<td id="A4.T3.2.1.3.5" class="ltx_td ltx_align_left"><math id="A4.T3.m12" class="ltx_Math" alttext="0.00" display="inline" intent=":literal"><semantics><mn>0.00</mn><annotation encoding="application/x-tex">0.00</annotation></semantics></math></td></tr>
