</span></td>
<td id="S4.T2.6.1.1.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_tt">
<span id="S4.T2.6.1.1.3.1" class="ltx_inline-block ltx_align_top" style="width:34.1pt;">
<span id="S4.T2.6.1.1.3.1.1" class="ltx_p ltx_align_center"><math id="S4.T2.m2" class="ltx_Math" alttext="\text{BLEnD}_{\text{test}}" display="inline" intent=":literal"><semantics><msub><mtext class="ltx_mathvariant_bold">BLEnD</mtext><mtext class="ltx_mathvariant_bold">test</mtext></msub><annotation encoding="application/x-tex">\text{BLEnD}_{\text{test}}</annotation></semantics></math></span>
</span></td>
<td id="S4.T2.6.1.1.4" class="ltx_td ltx_align_left ltx_align_top ltx_border_tt">
<span id="S4.T2.6.1.1.4.1" class="ltx_inline-block ltx_align_top" style="width:34.1pt;">
<span id="S4.T2.6.1.1.4.1.1" class="ltx_p ltx_align_center"><span id="S4.T2.6.1.1.4.1.1.1" class="ltx_text ltx_font_bold">CultB</span></span>
</span></td>
<td id="S4.T2.6.1.1.5" class="ltx_td ltx_align_left ltx_align_top ltx_border_tt">
<span id="S4.T2.6.1.1.5.1" class="ltx_inline-block ltx_align_top" style="width:34.1pt;">
<span id="S4.T2.6.1.1.5.1.1" class="ltx_p ltx_align_center"><span id="S4.T2.6.1.1.5.1.1.1" class="ltx_text ltx_font_bold">NormAd</span></span>
</span></td>
<td id="S4.T2.6.1.1.6" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_tt">
<span id="S4.T2.6.1.1.6.1" class="ltx_inline-block ltx_align_top" style="width:39.8pt;">
<span id="S4.T2.6.1.1.6.1.1" class="ltx_p ltx_align_center"><span id="S4.T2.6.1.1.6.1.1.1" class="ltx_text ltx_font_bold">WVB</span></span>
</span></td>
<td id="S4.T2.6.1.1.7" class="ltx_td ltx_align_left ltx_align_top ltx_border_tt">
<span id="S4.T2.6.1.1.7.1" class="ltx_inline-block ltx_align_top" style="width:34.1pt;">
<span id="S4.T2.6.1.1.7.1.1" class="ltx_p ltx_align_center"><span id="S4.T2.6.1.1.7.1.1.1" class="ltx_text ltx_font_bold">ComQA</span></span>
</span></td>
<td id="S4.T2.6.1.1.8" class="ltx_td ltx_align_left ltx_align_top ltx_border_tt">
<span id="S4.T2.6.1.1.8.1" class="ltx_inline-block ltx_align_top" style="width:34.1pt;">
<span id="S4.T2.6.1.1.8.1.1" class="ltx_p ltx_align_center"><span id="S4.T2.6.1.1.8.1.1.1" class="ltx_text ltx_font_bold">QNLI</span></span>
</span></td>
<td id="S4.T2.6.1.1.9" class="ltx_td ltx_align_left ltx_align_top ltx_border_tt">
<span id="S4.T2.6.1.1.9.1" class="ltx_inline-block ltx_align_top" style="width:34.1pt;">
<span id="S4.T2.6.1.1.9.1.1" class="ltx_p ltx_align_center"><span id="S4.T2.6.1.1.9.1.1.1" class="ltx_text ltx_font_bold">MRPC</span></span>
</span></td></tr>
