<span id="S4.T2.6.1.19.10.1.1" class="ltx_p ltx_align_center">78.43</span>
</span></td></tr>
<tr id="S4.T2.6.1.20" class="ltx_tr">
<td id="S4.T2.6.1.20.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb"></td>
<td id="S4.T2.6.1.20.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r">rand</td>
<td id="S4.T2.6.1.20.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_r">
<span id="S4.T2.6.1.20.3.1" class="ltx_inline-block ltx_align_top" style="width:34.1pt;">
<span id="S4.T2.6.1.20.3.1.1" class="ltx_p ltx_align_center">9,282</span>
</span></td>
