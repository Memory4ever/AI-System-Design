<span id="S4.T2.6.1.20.6.1" class="ltx_inline-block ltx_align_top" style="width:34.1pt;">
<span id="S4.T2.6.1.20.6.1.1" class="ltx_p ltx_align_center">54.06(1.39)</span>
</span></td>
<td id="S4.T2.6.1.20.7" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_r">
<span id="S4.T2.6.1.20.7.1" class="ltx_inline-block ltx_align_top" style="width:39.8pt;">
