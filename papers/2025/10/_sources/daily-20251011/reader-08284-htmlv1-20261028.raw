</figure>
<figure id="A3.F9" class="ltx_figure"><img src="2510.08284v1/images/phi-4_all_blend_max_heatmap.png" id="A3.F9.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:494/148;" width="494" height="148" alt="Refer to caption">
