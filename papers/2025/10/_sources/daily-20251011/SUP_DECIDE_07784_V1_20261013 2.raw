<td id="A1.T7.5.3.2" class="ltx_td ltx_align_center"><math id="A1.T7.m2" class="ltx_Math" alttext="1\times 10^{-4}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1\times 10^{-4}</annotation></semantics></math></td>
<td id="A1.T7.5.3.3" class="ltx_td ltx_align_left">0.5x Saturate HBM</td></tr>
<tr id="A1.T7.5.4" class="ltx_tr">
<td id="A1.T7.5.4.1" class="ltx_td ltx_align_left">C</td>
