<td id="A1.T7.5.4.3" class="ltx_td ltx_align_left">Saturate HBM</td></tr>
<tr id="A1.T7.5.5" class="ltx_tr">
<td id="A1.T7.5.5.1" class="ltx_td ltx_align_left ltx_border_bb">D</td>
<td id="A1.T7.5.5.2" class="ltx_td ltx_align_center ltx_border_bb"><math id="A1.T7.m4" class="ltx_Math" alttext="5\times 10^{-5}" display="inline" intent=":literal"><semantics><mrow><mn>5</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>5</mn></mrow></msup></mrow><annotation encoding="application/x-tex">5\times 10^{-5}</annotation></semantics></math></td>
