<th id="S3.T6.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T6.5.1.2.1" class="ltx_text ltx_font_bold">Learning Rate</span></th>
<th id="S3.T6.5.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T6.5.1.3.1" class="ltx_text ltx_font_bold">Global Batch Size</span></th></tr>
