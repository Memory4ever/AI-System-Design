<div id="A6.SS1.p7" class="ltx_para">
<p id="A6.SS1.p7.1" class="ltx_p"><span id="A6.SS1.p7.1.1" class="ltx_text">Summing over <math id="A6.SS1.p7.m1" class="ltx_Math" alttext="1\leq i&lt;j\leq n-1" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>&lt;</mo><mi>j</mi><mo>≤</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">1\leq i&lt;j\leq n-1</annotation></semantics></math> and reindexing,</span></p>
<table id="A6.Ex73" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A6.Ex73X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex73X.m2" class="ltx_Math" alttext="\displaystyle\sum_{1\leq i&lt;j\leq n-1}\mdmathbb E[x_{n}^{2}x_{i}x_{i+1}x_{j}x_{j+1}]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>&lt;</mo><mi>j</mi><mo>≤</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow></munder></mstyle><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>x</mi><mi>n</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{1\leq i&lt;j\leq n-1}\mdmathbb E[x_{n}^{2}x_{i}x_{i+1}x_{j}x_{j+1}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex73Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex73Xa.m2" class="ltx_Math" alttext="\displaystyle=\sigma^{6}\Bigl(\binom{n-1}{2}\rho^{2}+2\sum_{k=1}^{n-1}(n-1-k)\rho^{2k}+6\sum_{i=1}^{n-1}(n-1-i)\rho^{2(n-i)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="2.278em">=</mo><mrow><msup><mi mathvariant="normal">�</mi><mn>6</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">�</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">�</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup></mrow></mrow></mrow><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn><mo>−</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">�</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sigma^{6}\Bigl(\binom{n-1}{2}\rho^{2}+2\sum_{k=1}^{n-1}(n-1-k)\rho^{2k}+6\sum_{i=1}^{n-1}(n-1-i)\rho^{2(n-i)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex73Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex73Xb.m2" class="ltx_Math" alttext="\displaystyle+4\sum_{i=1}^{n-1}(n-1-i)\rho^{2(n-1-i)}+2\sum_{k=1}^{n-2}(n-1-k)\rho^{2k}\Bigr)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>4</mn><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">(</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo>−</mo><mi>i</mi><mo stretchy="false">)</mo><mi mathvariant="normal">�</mi><msup><mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn><mo>−</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo>+</mo><mn>2</mn><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></msup><mo stretchy="false">(</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo>−</mo><mi>k</mi><mo stretchy="false">)</mo><mi mathvariant="normal">�</mi><msup><mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle+4\sum_{i=1}^{n-1}(n-1-i)\rho^{2(n-1-i)}+2\sum_{k=1}^{n-2}(n-1-k)\rho^{2k}\Bigr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex73Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex73Xc.m2" class="ltx_Math" alttext="\displaystyle=\sigma^{6}\Bigl(\binom{n-1}{2}\rho^{2}+(2n-8)K_{n-1}+4H_{n-1}+2(n-1)K_{n-2}+2H_{n-2}\Bigr)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="2.278em">=</mo><mrow><msup><mi mathvariant="normal">�</mi><mn>6</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">�</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>8</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>K</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>K</mi><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></msub></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sigma^{6}\Bigl(\binom{n-1}{2}\rho^{2}+(2n-8)K_{n-1}+4H_{n-1}+2(n-1)K_{n-2}+2H_{n-2}\Bigr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.SS1.p8" class="ltx_para">
<p id="A6.SS1.p8.1" class="ltx_p"><span id="A6.SS1.p8.1.1" class="ltx_text">Finally, we obtain the final expression of <math id="A6.SS1.p8.m1" class="ltx_Math" alttext="D_{n}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>n</mi></msub><annotation encoding="application/x-tex">D_{n}</annotation></semantics></math></span></p>
<table id="A6.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex74"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex74.m1" class="ltx_Math" alttext="\displaystyle D_{n}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\displaystyle D_{n}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex74.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{n^{2}}\sum_{i=1}^{n-1}\sum_{j=1}^{n-1}\mdmathbb{E}[x_{n}^{2}x_{i}x_{i+1}x_{j}x_{j+1}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>n</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>x</mi><mi>n</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{n^{2}}\sum_{i=1}^{n-1}\sum_{j=1}^{n-1}\mdmathbb{E}[x_{n}^{2}x_{i}x_{i+1}x_{j}x_{j+1}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex75"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex75.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{n^{2}}\sum_{1\leq i=j\leq n-1}\mdmathbb E[x_{n}^{2}x_{i}x_{i+1}x_{j}x_{j+1}]+\frac{2}{n^{2}}\sum_{1\leq i&lt;j\leq n-1}\mdmathbb E[x_{n}^{2}x_{i}x_{i+1}x_{j}x_{j+1}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>n</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>=</mo><mi>j</mi><mo>≤</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow></munder></mstyle><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>x</mi><mi>n</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><msup><mi>n</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>&lt;</mo><mi>j</mi><mo>≤</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow></munder></mstyle><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>x</mi><mi>n</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{n^{2}}\sum_{1\leq i=j\leq n-1}\mdmathbb E[x_{n}^{2}x_{i}x_{i+1}x_{j}x_{j+1}]+\frac{2}{n^{2}}\sum_{1\leq i&lt;j\leq n-1}\mdmathbb E[x_{n}^{2}x_{i}x_{i+1}x_{j}x_{j+1}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex76"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex76.m1" class="ltx_Math" alttext="\displaystyle=\frac{\sigma^{6}}{n^{2}}\Bigl((n-1)+2\rho^{2}(n-1)+2K_{n-2}+10K_{n-1}\Bigr)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi mathvariant="normal">�</mi><mn>6</mn></msup><msup><mi>n</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">�</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>K</mi><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></msub></mrow><mo>+</mo><mrow><mn>10</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>K</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\sigma^{6}}{n^{2}}\Bigl((n-1)+2\rho^{2}(n-1)+2K_{n-2}+10K_{n-1}\Bigr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex77"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex77.m1" class="ltx_Math" alttext="\displaystyle\quad+\frac{2\sigma^{6}}{n^{2}}\Bigl(\binom{n-1}{2}\rho^{2}+(2n-8)K_{n-1}+4H_{n-1}+2(n-1)K_{n-2}+2H_{n-2}\Bigr)." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">�</mi><mn>6</mn></msup></mrow><msup><mi>n</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">�</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>8</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>K</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>K</mi><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></msub></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\frac{2\sigma^{6}}{n^{2}}\Bigl(\binom{n-1}{2}\rho^{2}+(2n-8)K_{n-1}+4H_{n-1}+2(n-1)K_{n-2}+2H_{n-2}\Bigr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex78"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex78.m1" class="ltx_Math" alttext="\displaystyle=\frac{\sigma^{6}}{n^{2}}\Bigl[(n-1)n\,\rho^{2}+(n-1)+\left(4(n-1)-2\right)K_{n-1}+\left(4(n-1)+2\right)K_{n-2}+8H_{n-1}+4H_{n-2}\Big]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi mathvariant="normal">�</mi><mn>6</mn></msup><msup><mi>n</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi mathvariant="normal">�</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mn>2</mn></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>K</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>2</mn></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>K</mi><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></msub></mrow><mo>+</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></msub></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\sigma^{6}}{n^{2}}\Bigl[(n-1)n\,\rho^{2}+(n-1)+\left(4(n-1)-2\right)K_{n-1}+\left(4(n-1)+2\right)K_{n-2}+8H_{n-1}+4H_{n-2}\Big].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.SS1.p9" class="ltx_para">
<p id="A6.SS1.p9.1" class="ltx_p"><span id="A6.SS1.p9.1.1" class="ltx_text">Adding the diagonal part and multiplying by <math id="A6.SS1.p9.m1" class="ltx_Math" alttext="1/n^{2}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><msup><mi>n</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">1/n^{2}</annotation></semantics></math> yields (<a href="#A6.E3" title="Equation 3 ‣ Proposition F.1 (AR(1) warm start along the asymptotic ray). ‣ F.1 Warm Up via AR(1) ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>).</span></p>
</div>
<div id="A6.SS1.p10" class="ltx_para">
<p id="A6.SS1.p10.1" class="ltx_p"><span id="A6.SS1.p10.1.1" class="ltx_text ltx_font_bold">Step 3: Limit and conclusion.<span id="A6.SS1.p10.1.1.1" class="ltx_text ltx_font_medium">
Since <math id="A6.SS1.p10.m1" class="ltx_Math" alttext="D_{n}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>n</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">D_{n}&gt;0</annotation></semantics></math>, <math id="A6.SS1.p10.m2" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math> is strictly convex, so the minimizer and value follow. As <math id="A6.SS1.p10.m3" class="ltx_Math" alttext="S_{n}\to\mdmathbb E[x_{t}x_{t+1}]=\rho\sigma^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>n</mi></msub><mo stretchy="false">→</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>x</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi mathvariant="normal">�</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">�</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">S_{n}\to\mdmathbb E[x_{t}x_{t+1}]=\rho\sigma^{2}</annotation></semantics></math> almost surely and <math id="A6.SS1.p10.m4" class="ltx_Math" alttext="x_{n}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mi>n</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">x_{n}^{2}</annotation></semantics></math> is integrable,
<math id="A6.SS1.p10.m5" class="ltx_Math" alttext="\alpha^{*}\to 1/\sigma^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">�</mi><mo>∗</mo></msup><mo stretchy="false">→</mo><mrow><mn>1</mn><mo>/</mo><msup><mi mathvariant="normal">�</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\alpha^{*}\to 1/\sigma^{2}</annotation></semantics></math> and <math id="A6.SS1.p10.m6" class="ltx_Math" alttext="\min_{\alpha}\mathcal{L}(\alpha)\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>min</mi><mi mathvariant="normal">�</mi></msub><mo lspace="0.167em">⁡</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">�</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\min_{\alpha}\mathcal{L}(\alpha)\to 0</annotation></semantics></math>.
∎</span></span></p>
</div>
</div>
<div id="A6.Thmtheorem2" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A6.Thmtheorem2.2" class="ltx_text ltx_font_bold">Remark F.2</span></span><span id="A6.Thmtheorem2.3" class="ltx_text ltx_font_bold"> </span>(Warm start vs. global optimum)<span id="A6.Thmtheorem2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A6.Thmtheorem2.p1" class="ltx_para">
<p id="A6.Thmtheorem2.p1.1" class="ltx_p"><span id="A6.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">The optimization above is restricted to the asymptotic ray <math id="A6.Thmtheorem2.p1.m1" class="ltx_Math" alttext="b=[0,1]^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">b=[0,1]^{\top}</annotation></semantics></math>, <math id="A6.Thmtheorem2.p1.m2" class="ltx_Math" alttext="A=[\alpha,0]^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>=</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">�</mi><mo>,</mo><mn>0</mn></mrow><mo stretchy="false">]</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">A=[\alpha,0]^{\top}</annotation></semantics></math>. It serves as a computational warm-up to practice Isserlis-based moment calculations and to quantify the finite-sample gap. The global optimum over all <math id="A6.Thmtheorem2.p1.m3" class="ltx_Math" alttext="(b,A)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b,A)</annotation></semantics></math> may differ, but this warm start already converges to the linear-regression limit as <math id="A6.Thmtheorem2.p1.m4" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math>.</span></p>
</div>
</div>
<section id="A6.SS1.SSSx1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection">Auxiliary lemmas used in <a href="#A6.SS1" title="F.1 Warm Up via AR(1) ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">F.1</span></a></h4>

<div id="A6.Thmtheorem3" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A6.Thmtheorem3.2" class="ltx_text ltx_font_bold">Theorem F.3</span></span><span id="A6.Thmtheorem3.3" class="ltx_text ltx_font_bold"> </span>(Isserlis’ Theorem (Wick’s Formula) <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib44" title="" class="ltx_ref">44</a>]</cite>)<span id="A6.Thmtheorem3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A6.Thmtheorem3.p1" class="ltx_para">
<p id="A6.Thmtheorem3.p1.1" class="ltx_p"><span id="A6.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A6.Thmtheorem3.p1.m1" class="ltx_Math" alttext="(X_{1},\dots,X_{n})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>X</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(X_{1},\dots,X_{n})</annotation></semantics></math> be a zero-mean multivariate normal random vector.</span></p>
<ul id="A6.I1" class="ltx_itemize">
<li id="A6.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I1.i1.p1" class="ltx_para">
<p id="A6.I1.i1.p1.1" class="ltx_p"><span id="A6.I1.i1.p1.1.1" class="ltx_text ltx_font_italic">If </span><math id="A6.I1.i1.p1.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math><span id="A6.I1.i1.p1.1.2" class="ltx_text ltx_font_italic"> is odd, i.e., </span><math id="A6.I1.i1.p1.m2" class="ltx_Math" alttext="n=2m+1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">n=2m+1</annotation></semantics></math><span id="A6.I1.i1.p1.1.3" class="ltx_text ltx_font_italic">, then</span></p>
<table id="A6.Ex79" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex79.m1" class="ltx_math_unparsed" alttext="\E[X_{1}X_{2}\cdots X_{2m+1}]=0." display="block" intent=":literal"><semantics><mrow><mo rspace="0em">E</mo><mrow><mo stretchy="false">[</mo><msub><mi>X</mi><mn>1</mn></msub><msub><mi>X</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>X</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><mn>0</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\E[X_{1}X_{2}\cdots X_{2m+1}]=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A6.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I1.i2.p1" class="ltx_para">
<p id="A6.I1.i2.p1.1" class="ltx_p"><span id="A6.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">If </span><math id="A6.I1.i2.p1.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math><span id="A6.I1.i2.p1.1.2" class="ltx_text ltx_font_italic"> is even, i.e., </span><math id="A6.I1.i2.p1.m2" class="ltx_Math" alttext="n=2m" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mrow><annotation encoding="application/x-tex">n=2m</annotation></semantics></math><span id="A6.I1.i2.p1.1.3" class="ltx_text ltx_font_italic">, then</span></p>
<table id="A6.Ex80" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex80.m1" class="ltx_math_unparsed" alttext="\E[X_{1}X_{2}\cdots X_{2m}]=\sum_{p\in\mathcal{P}_{n}}\prod_{\{i,j\}\in p}\E[X_{i}X_{j}]," display="block" intent=":literal"><semantics><mrow><mo rspace="0em">E</mo><mrow><mo stretchy="false">[</mo><msub><mi>X</mi><mn>1</mn></msub><msub><mi>X</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>X</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mo stretchy="false">]</mo></mrow><mo rspace="0.111em">=</mo><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>p</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>n</mi></msub></mrow></munder><munder><mo movablelimits="false">∏</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo stretchy="false">}</mo></mrow><mo>∈</mo><mi>p</mi></mrow></munder><mo lspace="0em" rspace="0em">E</mo><mrow><mo stretchy="false">[</mo><msub><mi>X</mi><mi>i</mi></msub><msub><mi>X</mi><mi>j</mi></msub><mo stretchy="false">]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\E[X_{1}X_{2}\cdots X_{2m}]=\sum_{p\in\mathcal{P}_{n}}\prod_{\{i,j\}\in p}\E[X_{i}X_{j}],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.I1.i2.p1.2" class="ltx_p"><span id="A6.I1.i2.p1.2.1" class="ltx_text ltx_font_italic">where </span><math id="A6.I1.i2.p1.m3" class="ltx_Math" alttext="\mathcal{P}_{n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathcal{P}_{n}</annotation></semantics></math><span id="A6.I1.i2.p1.2.2" class="ltx_text ltx_font_italic"> denotes the set of all possible pairwise partitions (perfect matchings) of </span><math id="A6.I1.i2.p1.m4" class="ltx_Math" alttext="\{1,2,\dots,2m\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{1,2,\dots,2m\}</annotation></semantics></math><span id="A6.I1.i2.p1.2.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ul>
</div>
</div>
</section>
</section>
<section id="A6.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">F.2 </span>A finite-sample optimality gap for one-layer LSA</h3>

<section id="A6.SS2.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Goal.</h5>

<div id="A6.SS2.SSS0.Px1.p1" class="ltx_para">
<p id="A6.SS2.SSS0.Px1.p1.1" class="ltx_p">We prove that for any fixed sample size <math id="A6.SS2.SSS0.Px1.p1.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>, the best one-layer LSA readout on Hankel inputs <em id="A6.SS2.SSS0.Px1.p1.1.1" class="ltx_emph ltx_font_italic">cannot</em> match linear regression on the last <math id="A6.SS2.SSS0.Px1.p1.m2" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> lags. The argument rewrites the readout as a quadratic form in a Kronecker–lifted feature, solves the induced convex problem in closed form, and identifies a strictly positive Schur–complement gap. In other words, this section provides the first rigorous separation between LSA and linear regression: the gap is not an artifact of optimization, but a structural property of the linear self attention.</p>
</div>
</section>
<section id="A6.SS2.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Setup (recalled).</h5>

<div id="A6.SS2.SSS0.Px2.p1" class="ltx_para">
<p id="A6.SS2.SSS0.Px2.p1.1" class="ltx_p">Let <math id="A6.SS2.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\{x_{t}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{x_{t}\}</annotation></semantics></math> be a zero-mean stationary AR(<math id="A6.SS2.SSS0.Px2.p1.m2" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>) process as in Definition <a href="#S2.Thmtheorem2" title="Definition 2.2 (AR(𝑝) Process []). ‣ 2.1 Time Series ‣ 2 Preliminaries ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.2</span></a>.
For <math id="A6.SS2.SSS0.Px2.p1.m3" class="ltx_Math" alttext="n\geq p" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">n\geq p</annotation></semantics></math>, let <math id="A6.SS2.SSS0.Px2.p1.m4" class="ltx_Math" alttext="H_{n}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mi>n</mi></msub><annotation encoding="application/x-tex">H_{n}</annotation></semantics></math> be the Hankel matrix from Definition <a href="#S2.Thmtheorem5" title="Definition 2.5 (Hankel Matrix). ‣ 2.3 In-Context Time Series Forecasting ‣ 2 Preliminaries ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.5</span></a> and put</p>
<table id="A6.Ex81" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex81.m1" class="ltx_Math" alttext="G\;:=\;\frac{1}{n}\,H_{n}MH_{n}^{\top}=\frac{1}{n}\sum_{i=1}^{n-p}x^{(i)}x^{(i)\top}\in\mdmathbb R^{(p+1)\times(p+1)},\qquad M:=\mathrm{diag}(I_{\,n-p},0)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>G</mi><mo lspace="0.558em" rspace="0.558em">:=</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>H</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>H</mi><mi>n</mi><mo>⊤</mo></msubsup></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></munderover><mrow><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msup></mrow></mrow></mrow><mo>∈</mo><msup><mi>R</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo rspace="2.167em">,</mo><mrow><mi>M</mi><mo>:=</mo><mrow><mi>diag</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>I</mi><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></msub><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">G\;:=\;\frac{1}{n}\,H_{n}MH_{n}^{\top}=\frac{1}{n}\sum_{i=1}^{n-p}x^{(i)}x^{(i)\top}\in\mdmathbb R^{(p+1)\times(p+1)},\qquad M:=\mathrm{diag}(I_{\,n-p},0).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.SSS0.Px2.p1.2" class="ltx_p">Denote the prediction window <math id="A6.SS2.SSS0.Px2.p1.m5" class="ltx_math_unparsed" alttext="x:=x_{\,n-p+1:n}\in\mdmathbb R^{p}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>:=</mo><mi>x</mi><msub><mrow></mrow><mrow><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo>∈</mo><mi>R</mi><msup><mrow></mrow><mi>p</mi></msup></mrow><annotation encoding="application/x-tex">x:=x_{\,n-p+1:n}\in\mdmathbb R^{p}</annotation></semantics></math> and <math id="A6.SS2.SSS0.Px2.p1.m6" class="ltx_Math" alttext="y:=x_{n+1}=\rho^{\top}x+\varepsilon_{n+1}" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>:=</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><mrow><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><msub><mi mathvariant="normal">"</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">y:=x_{n+1}=\rho^{\top}x+\varepsilon_{n+1}</annotation></semantics></math> with <math id="A6.SS2.SSS0.Px2.p1.m7" class="ltx_Math" alttext="\mdmathbb E[\varepsilon_{n+1}]=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi mathvariant="normal">"</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mdmathbb E[\varepsilon_{n+1}]=0</annotation></semantics></math>, <math id="A6.SS2.SSS0.Px2.p1.m8" class="ltx_Math" alttext="\mdmathbb E[\varepsilon_{n+1}^{2}]=\sigma_{\varepsilon}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi mathvariant="normal">"</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><msubsup><mi mathvariant="normal">�</mi><mi mathvariant="normal">"</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\mdmathbb E[\varepsilon_{n+1}^{2}]=\sigma_{\varepsilon}^{2}</annotation></semantics></math> and <math id="A6.SS2.SSS0.Px2.p1.m9" class="ltx_Math" alttext="\varepsilon_{n+1}\perp(G,x)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">"</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>⟂</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\varepsilon_{n+1}\perp(G,x)</annotation></semantics></math>.
Given parameters <math id="A6.SS2.SSS0.Px2.p1.m10" class="ltx_Math" alttext="b\in\mdmathbb R^{p+1}" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>∈</mo><msup><mi>R</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">b\in\mdmathbb R^{p+1}</annotation></semantics></math> and <math id="A6.SS2.SSS0.Px2.p1.m11" class="ltx_Math" alttext="A\in\mdmathbb R^{(p+1)\times p}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>∈</mo><msup><mi>R</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>p</mi></mrow></msup></mrow><annotation encoding="application/x-tex">A\in\mdmathbb R^{(p+1)\times p}</annotation></semantics></math>, the one-layer LSA readout at the prediction slot is</p>
<table id="A6.E4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.E4.m1" class="ltx_Math" alttext="\widehat{x}_{n+1}(b,A)\;=\;b^{\top}GAx." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><mi>A</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">=</mo><mrow><msup><mi>b</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{x}_{n+1}(b,A)\;=\;b^{\top}GAx.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A6.SS2.SSS0.Px3" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Kronecker reparameterization.</h5>

<div id="A6.SS2.SSS0.Px3.p1" class="ltx_para">
<p id="A6.SS2.SSS0.Px3.p1.1" class="ltx_p">Let <math id="A6.SS2.SSS0.Px3.p1.m1" class="ltx_Math" alttext="D_{p+1}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">D_{p+1}</annotation></semantics></math> be the <math id="A6.SS2.SSS0.Px3.p1.m2" class="ltx_Math" alttext="(p{+}1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(p{+}1)</annotation></semantics></math>-dimensional duplication matrix so that <math id="A6.SS2.SSS0.Px3.p1.m3" class="ltx_Math" alttext="\vect(G)=D_{p+1}\vech(G)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>D</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>vech</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\vect(G)=D_{p+1}\vech(G)</annotation></semantics></math>. Using <math id="A6.SS2.SSS0.Px3.p1.m4" class="ltx_Math" alttext="\vect(AXB)=(B^{\top}\otimes A)\vect(X)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>X</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>B</mi><mo>⊤</mo></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>A</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\vect(AXB)=(B^{\top}\otimes A)\vect(X)</annotation></semantics></math> and the mixed–product rule,</p>
<table id="A6.Ex82" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex82.m1" class="ltx_Math" alttext="x^{\top}(A^{\top}Gb)=\bigl((\vech G)^{\top}D_{p+1}^{\top}\otimes x^{\top}\bigr)\,(b\otimes\vect(A^{\top}))=\bigl((\vech G)^{\top}\otimes x^{\top}\bigr)\,\widetilde{\eta}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>x</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>A</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>vech</mi><mo lspace="0.167em">⁡</mo><mi>G</mi></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>D</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi>x</mi><mo>⊤</mo></msup></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>vech</mi><mo lspace="0.167em">⁡</mo><mi>G</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo rspace="0.222em">⊗</mo><msup><mi>x</mi><mo>⊤</mo></msup></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mover accent="true"><mi mathvariant="normal">�</mi><mo>~</mo></mover></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">x^{\top}(A^{\top}Gb)=\bigl((\vech G)^{\top}D_{p+1}^{\top}\otimes x^{\top}\bigr)\,(b\otimes\vect(A^{\top}))=\bigl((\vech G)^{\top}\otimes x^{\top}\bigr)\,\widetilde{\eta},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.SSS0.Px3.p1.2" class="ltx_p">where</p>
<table id="A6.Ex83" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex83.m1" class="ltx_Math" alttext="\widetilde{\eta}:=(D_{p+1}^{\top}\otimes I_{p})\,(b\otimes\vect(A^{\top}))\in\mdmathbb R^{qp},\qquad q:=\tfrac{(p+1)(p+2)}{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mi mathvariant="normal">�</mi><mo>~</mo></mover><mo>:=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>D</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>I</mi><mi>p</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>R</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msup></mrow><mo rspace="2.167em">,</mo><mrow><mi>q</mi><mo>:=</mo><mstyle displaystyle="false"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widetilde{\eta}:=(D_{p+1}^{\top}\otimes I_{p})\,(b\otimes\vect(A^{\top}))\in\mdmathbb R^{qp},\qquad q:=\tfrac{(p+1)(p+2)}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.SSS0.Px3.p1.3" class="ltx_p">Introduce the lifted feature and its moments</p>
<table id="A6.Ex84" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex84.m1" class="ltx_Math" alttext="Z:=(\vech G)\otimes x\in\mdmathbb R^{qp},\qquad\widetilde{S}:=\mdmathbb E[ZZ^{\top}],\qquad\widetilde{r}:=\mdmathbb E[Zx^{\top}],\qquad\Gamma_{p}:=\mdmathbb E[xx^{\top}]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Z</mi><mo>:=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>vech</mi><mo lspace="0.167em">⁡</mo><mi>G</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊗</mo><mi>x</mi></mrow><mo>∈</mo><msup><mi>R</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msup></mrow><mo rspace="2.167em">,</mo><mrow><mover accent="true"><mi>S</mi><mo>~</mo></mover><mo>:=</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>Z</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>Z</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mover accent="true"><mi>r</mi><mo>~</mo></mover><mo>:=</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>Z</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo>:=</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Z:=(\vech G)\otimes x\in\mdmathbb R^{qp},\qquad\widetilde{S}:=\mdmathbb E[ZZ^{\top}],\qquad\widetilde{r}:=\mdmathbb E[Zx^{\top}],\qquad\Gamma_{p}:=\mdmathbb E[xx^{\top}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.SSS0.Px3.p1.4" class="ltx_p">Then the mean–squared error decomposes as a strictly convex quadratic in <math id="A6.SS2.SSS0.Px3.p1.m5" class="ltx_Math" alttext="\widetilde{\eta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi mathvariant="normal">�</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{\eta}</annotation></semantics></math>:</p>
<table id="A6.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex85"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex85.m1" class="ltx_Math" alttext="\displaystyle\mathcal{L}(b,A)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}(b,A)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex85.m2" class="ltx_Math" alttext="\displaystyle:=\mdmathbb E\big[(\widehat{x}_{n+1}(b,A)-y)^{2}\big]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle:=\mdmathbb E\big[(\widehat{x}_{n+1}(b,A)-y)^{2}\big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.E5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E5.m1" class="ltx_Math" alttext="\displaystyle=\sigma_{\varepsilon}^{2}+\rho^{\top}\Gamma_{p}\rho+\widetilde{\eta}^{\top}\widetilde{S}\,\widetilde{\eta}-2\,\widetilde{\eta}^{\top}\widetilde{r}\,\rho." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msubsup><mi mathvariant="normal">�</mi><mi mathvariant="normal">"</mi><mn>2</mn></msubsup><mo>+</mo><mrow><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">�</mi></mrow><mo>+</mo><mrow><msup><mover accent="true"><mi mathvariant="normal">�</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>S</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi mathvariant="normal">�</mi><mo>~</mo></mover></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0.170em" rspace="0em">​</mo><msup><mover accent="true"><mi mathvariant="normal">�</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>r</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">�</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sigma_{\varepsilon}^{2}+\rho^{\top}\Gamma_{p}\rho+\widetilde{\eta}^{\top}\widetilde{S}\,\widetilde{\eta}-2\,\widetilde{\eta}^{\top}\widetilde{r}\,\rho.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A6.SS2.SSS0.Px4" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Two technical facts we will establish and use.</h5>

<div id="A6.SS2.SSS0.Px4.p1" class="ltx_para">
<ol id="A6.I2" class="ltx_enumerate">
<li id="A6.I2.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(F1)</span> 
<div id="A6.I2.ix1.p1" class="ltx_para">
<p id="A6.I2.ix1.p1.1" class="ltx_p">The block second-moment matrix</p>
<table id="A6.Ex86" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex86.m1" class="ltx_Math" alttext="\Sigma^{\otimes}:=\mdmathbb E\left[\begin{pmatrix}Z\\
x\end{pmatrix}\begin{pmatrix}Z\\
x\end{pmatrix}^{\top}\right]=\begin{pmatrix}\widetilde{S}&amp;\widetilde{r}\\[2.0pt]
\widetilde{r}^{\top}&amp;\Gamma_{p}\end{pmatrix}\quad\text{is \emph{strictly} positive definite.}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">�</mi><mo>⊗</mo></msup><mo>:=</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><mi>Z</mi></mtd></mtr><mtr><mtd><mi>x</mi></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><mi>Z</mi></mtd></mtr><mtr><mtd><mi>x</mi></mtd></mtr></mtable><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mo>(</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mover accent="true"><mi>S</mi><mo>~</mo></mover></mtd><mtd><mover accent="true"><mi>r</mi><mo>~</mo></mover></mtd></mtr><mtr><mtd><msup><mover accent="true"><mi>r</mi><mo>~</mo></mover><mo>⊤</mo></msup></mtd><mtd><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mtext>is </mtext><mtext class="ltx_mathvariant_italic"><em class="ltx_emph ltx_font_italic">strictly</em></mtext><mtext> positive definite.</mtext></mrow></mrow><annotation encoding="application/x-tex">\Sigma^{\otimes}:=\mdmathbb E\left[\begin{pmatrix}Z\\
x\end{pmatrix}\begin{pmatrix}Z\\
x\end{pmatrix}^{\top}\right]=\begin{pmatrix}\widetilde{S}&amp;\widetilde{r}\\[2.0pt]
\widetilde{r}^{\top}&amp;\Gamma_{p}\end{pmatrix}\quad\text{is \emph{strictly} positive definite.}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.I2.ix1.p1.2" class="ltx_p">Equivalently, <math id="A6.I2.ix1.p1.m1" class="ltx_Math" alttext="\widetilde{S}\succ 0" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>S</mi><mo>~</mo></mover><mo>≻</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\widetilde{S}\succ 0</annotation></semantics></math> and the Schur complement
<math id="A6.I2.ix1.p1.m2" class="ltx_Math" alttext="\Gamma_{p}-\widetilde{r}^{\top}\widetilde{S}^{-1}\widetilde{r}\succ 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo>−</mo><mrow><msup><mover accent="true"><mi>r</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>r</mi><mo>~</mo></mover></mrow></mrow><mo>≻</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Gamma_{p}-\widetilde{r}^{\top}\widetilde{S}^{-1}\widetilde{r}\succ 0</annotation></semantics></math>.</p>
</div></li>
<li id="A6.I2.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(F2)</span> 
<div id="A6.I2.ix2.p1" class="ltx_para">
<p id="A6.I2.ix2.p1.1" class="ltx_p">The unconstrained minimizer of (<a href="#A6.E5" title="Equation 5 ‣ Kronecker reparameterization. ‣ F.2 A finite-sample optimality gap for one-layer LSA ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>) is
<math id="A6.I2.ix2.p1.m1" class="ltx_Math" alttext="\widetilde{\eta}^{*}=\widetilde{S}^{-1}\widetilde{r}\,\rho" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi mathvariant="normal">�</mi><mo>~</mo></mover><mo>∗</mo></msup><mo>=</mo><mrow><msup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>r</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">�</mi></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\eta}^{*}=\widetilde{S}^{-1}\widetilde{r}\,\rho</annotation></semantics></math> with minimum value</p>
<table id="A6.Ex87" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex87.m1" class="ltx_Math" alttext="\mathcal{L}_{\min}=\sigma_{\varepsilon}^{2}+\rho^{\top}\Gamma_{p}\rho-\rho^{\top}\widetilde{r}^{\top}\widetilde{S}^{-1}\widetilde{r}\,\rho." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>min</mi></msub><mo>=</mo><mrow><mrow><msubsup><mi mathvariant="normal">�</mi><mi mathvariant="normal">"</mi><mn>2</mn></msubsup><mo>+</mo><mrow><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">�</mi></mrow></mrow><mo>−</mo><mrow><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>r</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>r</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">�</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\min}=\sigma_{\varepsilon}^{2}+\rho^{\top}\Gamma_{p}\rho-\rho^{\top}\widetilde{r}^{\top}\widetilde{S}^{-1}\widetilde{r}\,\rho.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.I2.ix2.p1.2" class="ltx_p">Because the original parameters <math id="A6.I2.ix2.p1.m2" class="ltx_Math" alttext="(b,A)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b,A)</annotation></semantics></math> satisfy the rank-one Kronecker constraint
<math id="A6.I2.ix2.p1.m3" class="ltx_Math" alttext="\widetilde{\eta}=(D_{p+1}^{\top}\otimes I_{p})(b\otimes\vect(A^{\top}))" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi mathvariant="normal">�</mi><mo>~</mo></mover><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>D</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>I</mi><mi>p</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\eta}=(D_{p+1}^{\top}\otimes I_{p})(b\otimes\vect(A^{\top}))</annotation></semantics></math>, their achievable risk is <em id="A6.I2.ix2.p1.2.1" class="ltx_emph ltx_font_italic">no smaller</em> than <math id="A6.I2.ix2.p1.m4" class="ltx_Math" alttext="\mathcal{L}_{\min}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>min</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{\min}</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
<div id="A6.SS2.SSS0.Px4.p2" class="ltx_para">
<p id="A6.SS2.SSS0.Px4.p2.1" class="ltx_p">The core of the proof is thus (F1); (F2) is elementary convex optimization once (F1) holds.</p>
</div>
</section>
<section id="A6.SS2.SSSx1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection">Step 1: strict positive definiteness of a basic block</h4>

<div id="A6.SS2.SSSx1.p1" class="ltx_para">
<p id="A6.SS2.SSSx1.p1.1" class="ltx_p">We begin by showing that the basic statistics at time <math id="A6.SS2.SSSx1.p1.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> already enjoy strict nondegeneracy.</p>
</div>
<div id="A6.Thmtheorem4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A6.Thmtheorem4.2" class="ltx_text ltx_font_bold">Lemma F.4</span></span><span id="A6.Thmtheorem4.3" class="ltx_text ltx_font_bold"> </span>(Strict covariance of <math id="A6.Thmtheorem4.m1" class="ltx_Math" alttext="\bigl(\vech G,\,x\bigr)" display="inline" intent=":literal"><semantics><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>vech</mi><mo lspace="0.167em">⁡</mo><mi>G</mi></mrow><mo rspace="0.337em">,</mo><mi>x</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><annotation encoding="application/x-tex">\bigl(\vech G,\,x\bigr)</annotation></semantics></math>)<span id="A6.Thmtheorem4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A6.Thmtheorem4.p1" class="ltx_para">
<p id="A6.Thmtheorem4.p1.1" class="ltx_p"><span id="A6.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A6.Thmtheorem4.p1.m1" class="ltx_Math" alttext="g:=\vech G\in\mdmathbb R^{q}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>:=</mo><mrow><mi>vech</mi><mo lspace="0.167em">⁡</mo><mi>G</mi></mrow><mo>∈</mo><msup><mi>R</mi><mi>q</mi></msup></mrow><annotation encoding="application/x-tex">g:=\vech G\in\mdmathbb R^{q}</annotation></semantics></math> and <math id="A6.Thmtheorem4.p1.m2" class="ltx_math_unparsed" alttext="x:=x_{\,n-p+1:n}\in\mdmathbb R^{p}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>:=</mo><mi>x</mi><msub><mrow></mrow><mrow><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo>∈</mo><mi>R</mi><msup><mrow></mrow><mi>p</mi></msup></mrow><annotation encoding="application/x-tex">x:=x_{\,n-p+1:n}\in\mdmathbb R^{p}</annotation></semantics></math>.
Then the covariance matrix</span></p>
<table id="A6.Ex88" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex88.m1" class="ltx_Math" alttext="\Cov\bigl([\,g^{\top},\,x^{\top}\,]^{\top}\bigr)\ \succ\ 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0em">Cov</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msup><mrow><mo rspace="0.170em" stretchy="false">[</mo><mrow><msup><mi>g</mi><mo>⊤</mo></msup><mo rspace="0.337em">,</mo><msup><mi>x</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">]</mo></mrow><mo>⊤</mo></msup><mo maxsize="1.200em" minsize="1.200em" rspace="0.500em">)</mo></mrow></mrow><mo>≻</mo><mn> 0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Cov\bigl([\,g^{\top},\,x^{\top}\,]^{\top}\bigr)\ \succ\ 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A6.SS2.SSSx1.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A6.SS2.SSSx1.p2" class="ltx_para">
<p id="A6.SS2.SSSx1.p2.1" class="ltx_p"><span id="A6.SS2.SSSx1.p2.1.1" class="ltx_text">Write
<math id="A6.SS2.SSSx1.p2.m1" class="ltx_Math" alttext="Z_{0}:=[\,g^{\top},\,x^{\top}\,]^{\top}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mn>0</mn></msub><mo>:=</mo><msup><mrow><mo rspace="0.170em" stretchy="false">[</mo><mrow><msup><mi>g</mi><mo>⊤</mo></msup><mo rspace="0.337em">,</mo><msup><mi>x</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">]</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">Z_{0}:=[\,g^{\top},\,x^{\top}\,]^{\top}</annotation></semantics></math> and suppose, for contradiction,
that there exists a nonzero vector <math id="A6.SS2.SSSx1.p2.m2" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> with <math id="A6.SS2.SSSx1.p2.m3" class="ltx_Math" alttext="\var(v^{\top}Z_{0})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">Var</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>v</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>Z</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\var(v^{\top}Z_{0})=0</annotation></semantics></math>.
We will force all coordinates of <math id="A6.SS2.SSSx1.p2.m4" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> to be zero by an <em id="A6.SS2.SSSx1.p2.1.1.1" class="ltx_emph ltx_font_italic">innovation-by-innovation</em> elimination.
Let <math id="A6.SS2.SSSx1.p2.m5" class="ltx_math_unparsed" alttext="\mathcal{F}_{t}:=\sigma(\varepsilon_{s}:s\leq t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>t</mi></msub><mo>:=</mo><mi mathvariant="normal">�</mi><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">"</mi><mi>s</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mi>s</mi><mo>≤</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}_{t}:=\sigma(\varepsilon_{s}:s\leq t)</annotation></semantics></math>. Proceed by traversing the rearranged vector <math id="A6.SS2.SSSx1.p2.m6" class="ltx_Math" alttext="Z_{0}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mn>0</mn></msub><annotation encoding="application/x-tex">Z_{0}</annotation></semantics></math> as shown below, in a <em id="A6.SS2.SSSx1.p2.1.1.2" class="ltx_emph ltx_font_italic">row–wise from bottom to top</em>, eliminating coefficients accordingly.</span></p>
</div>
<div id="A6.SS2.SSSx1.p3" class="ltx_para">
<table id="A6.Ex89" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex89.m1" class="ltx_Math" alttext="\widetilde{Z}_{0}=\left[\begin{array}[]{cccccc|c}\displaystyle\sum_{m=1}^{n-p}x_{m}^{2}&amp;&amp;&amp;&amp;&amp;&amp;\\[2.0pt]
\displaystyle\sum_{m=1}^{n-p}x_{m}x_{m+1}&amp;\displaystyle\sum_{m=1}^{n-p}x_{m+1}^{2}&amp;&amp;&amp;&amp;&amp;x_{\,n-p+1}\\[2.0pt]
\displaystyle\sum_{m=1}^{n-p}x_{m}x_{m+2}&amp;\displaystyle\sum_{m=1}^{n-p}x_{m+1}x_{m+2}&amp;\displaystyle\sum_{m=1}^{n-p}x_{m+2}^{2}&amp;&amp;&amp;&amp;x_{\,n-p+2}\\[2.0pt]
\vdots&amp;\vdots&amp;\vdots&amp;\ddots&amp;&amp;&amp;\vdots\\[2.0pt]
\displaystyle\sum_{m=1}^{n-p}x_{m}x_{m+p}&amp;\displaystyle\sum_{m=1}^{n-p}x_{m+1}x_{m+p}&amp;\displaystyle\sum_{m=1}^{n-p}x_{m+2}x_{m+p}&amp;\cdots&amp;\displaystyle\sum_{m=1}^{n-p}x_{m+p}^{2}&amp;&amp;x_{\,n}\end{array}\right]" display="block" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>Z</mi><mo>~</mo></mover><mn>0</mn></msub><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="3.0pt"><mtr><mtd><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></munderover><msubsup><mi>x</mi><mi>m</mi><mn>2</mn></msubsup></mrow></mtd><mtd></mtd><mtd></mtd><mtd></mtd><mtd></mtd><mtd class="ltx_border_r"></mtd><mtd></mtd></mtr><mtr><mtd><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></munderover><mrow><msub><mi>x</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow></mtd><mtd><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></munderover><msubsup><mi>x</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mtd><mtd></mtd><mtd></mtd><mtd></mtd><mtd class="ltx_border_r"></mtd><mtd><msub><mi>x</mi><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub></mtd></mtr><mtr><mtd><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></munderover><mrow><msub><mi>x</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mi>m</mi><mo>+</mo><mn>2</mn></mrow></msub></mrow></mrow></mtd><mtd><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></munderover><mrow><msub><mi>x</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mi>m</mi><mo>+</mo><mn>2</mn></mrow></msub></mrow></mrow></mtd><mtd><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></munderover><msubsup><mi>x</mi><mrow><mi>m</mi><mo>+</mo><mn>2</mn></mrow><mn>2</mn></msubsup></mrow></mtd><mtd></mtd><mtd></mtd><mtd class="ltx_border_r"></mtd><mtd><msub><mi>x</mi><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mn>2</mn></mrow></msub></mtd></mtr><mtr><mtd><mi mathvariant="normal">⋮</mi></mtd><mtd><mi mathvariant="normal">⋮</mi></mtd><mtd><mi mathvariant="normal">⋮</mi></mtd><mtd><mi mathvariant="normal">⋱</mi></mtd><mtd></mtd><mtd class="ltx_border_r"></mtd><mtd><mi mathvariant="normal">⋮</mi></mtd></mtr><mtr><mtd><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></munderover><mrow><msub><mi>x</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mi>m</mi><mo>+</mo><mi>p</mi></mrow></msub></mrow></mrow></mtd><mtd><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></munderover><mrow><msub><mi>x</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mi>m</mi><mo>+</mo><mi>p</mi></mrow></msub></mrow></mrow></mtd><mtd><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></munderover><mrow><msub><mi>x</mi><mrow><mi>m</mi><mo>+</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mi>m</mi><mo>+</mo><mi>p</mi></mrow></msub></mrow></mrow></mtd><mtd><mo>⋯</mo></mtd><mtd><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></munderover><msubsup><mi>x</mi><mrow><mi>m</mi><mo>+</mo><mi>p</mi></mrow><mn>2</mn></msubsup></mrow></mtd><mtd class="ltx_border_r"></mtd><mtd><msub><mi>x</mi><mi>n</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{Z}_{0}=\left[\begin{array}[]{cccccc|c}\displaystyle\sum_{m=1}^{n-p}x_{m}^{2}&amp;&amp;&amp;&amp;&amp;&amp;\\[2.0pt]
\displaystyle\sum_{m=1}^{n-p}x_{m}x_{m+1}&amp;\displaystyle\sum_{m=1}^{n-p}x_{m+1}^{2}&amp;&amp;&amp;&amp;&amp;x_{\,n-p+1}\\[2.0pt]
\displaystyle\sum_{m=1}^{n-p}x_{m}x_{m+2}&amp;\displaystyle\sum_{m=1}^{n-p}x_{m+1}x_{m+2}&amp;\displaystyle\sum_{m=1}^{n-p}x_{m+2}^{2}&amp;&amp;&amp;&amp;x_{\,n-p+2}\\[2.0pt]
\vdots&amp;\vdots&amp;\vdots&amp;\ddots&amp;&amp;&amp;\vdots\\[2.0pt]
\displaystyle\sum_{m=1}^{n-p}x_{m}x_{m+p}&amp;\displaystyle\sum_{m=1}^{n-p}x_{m+1}x_{m+p}&amp;\displaystyle\sum_{m=1}^{n-p}x_{m+2}x_{m+p}&amp;\cdots&amp;\displaystyle\sum_{m=1}^{n-p}x_{m+p}^{2}&amp;&amp;x_{\,n}\end{array}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.SS2.SSSx1.p4" class="ltx_para">
<p id="A6.SS2.SSSx1.p4.1" class="ltx_p"><em id="A6.SS2.SSSx1.p4.1.1" class="ltx_emph ltx_font_italic">Bottom block (involving <math id="A6.SS2.SSSx1.p4.m1" class="ltx_Math" alttext="x_{n}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>n</mi></msub><annotation encoding="application/x-tex">x_{n}</annotation></semantics></math>).</em><span id="A6.SS2.SSSx1.p4.1.2" class="ltx_text">
The last row of the Hankel Gram contributes, among others, the terms
<math id="A6.SS2.SSSx1.p4.m2" class="ltx_Math" alttext="\sum_{m=1}^{n-p}x_{m+p}^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></msubsup><msubsup><mi>x</mi><mrow><mi>m</mi><mo>+</mo><mi>p</mi></mrow><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\sum_{m=1}^{n-p}x_{m+p}^{2}</annotation></semantics></math> and <math id="A6.SS2.SSSx1.p4.m3" class="ltx_Math" alttext="\sum_{m=1}^{n-p}x_{m+p-1}x_{m+p}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></msubsup><mrow><msub><mi>x</mi><mrow><mrow><mi>m</mi><mo>+</mo><mi>p</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mi>m</mi><mo>+</mo><mi>p</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\sum_{m=1}^{n-p}x_{m+p-1}x_{m+p}</annotation></semantics></math>, whose final summands are <math id="A6.SS2.SSSx1.p4.m4" class="ltx_Math" alttext="x_{n}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mi>n</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">x_{n}^{2}</annotation></semantics></math> and <math id="A6.SS2.SSSx1.p4.m5" class="ltx_Math" alttext="x_{n-1}x_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">x_{n-1}x_{n}</annotation></semantics></math>.
Collecting the coefficients in <math id="A6.SS2.SSSx1.p4.m6" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> that multiply <math id="A6.SS2.SSSx1.p4.m7" class="ltx_Math" alttext="\{x_{n}^{2},\,x_{n-1}x_{n},\,\dots,\,x_{n-p}x_{n},\,x_{n}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><msubsup><mi>x</mi><mi>n</mi><mn>2</mn></msubsup><mo rspace="0.337em">,</mo><mrow><msub><mi>x</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>n</mi></msub></mrow><mo rspace="0.337em">,</mo><mi mathvariant="normal">…</mi><mo rspace="0.337em">,</mo><mrow><msub><mi>x</mi><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>n</mi></msub></mrow><mo rspace="0.337em">,</mo><msub><mi>x</mi><mi>n</mi></msub></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{x_{n}^{2},\,x_{n-1}x_{n},\,\dots,\,x_{n-p}x_{n},\,x_{n}\}</annotation></semantics></math>, we can write</span></p>
<table id="A6.Ex90" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex90.m1" class="ltx_math_unparsed" alttext="v^{\top}Z_{0}=\text{(terms $\mathcal{F}_{n-1}$-measurable)}+\bigl(u^{\top}x_{n-p:n-1}+a\,x_{n}+c\bigr)\,x_{n}," display="block" intent=":literal"><semantics><mrow><msup><mi>v</mi><mo>⊤</mo></msup><msub><mi>Z</mi><mn>0</mn></msub><mo>=</mo><mrow><mtext>(terms </mtext><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mtext>-measurable)</mtext></mrow><mo>+</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msup><mi>u</mi><mo>⊤</mo></msup><msub><mi>x</mi><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>+</mo><mi>a</mi><msub><mi>x</mi><mi>n</mi></msub><mo>+</mo><mi>c</mi><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">)</mo></mrow><msub><mi>x</mi><mi>n</mi></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">v^{\top}Z_{0}=\text{(terms $\mathcal{F}_{n-1}$-measurable)}+\bigl(u^{\top}x_{n-p:n-1}+a\,x_{n}+c\bigr)\,x_{n},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.SSSx1.p4.2" class="ltx_p"><span id="A6.SS2.SSSx1.p4.2.1" class="ltx_text">for some reals <math id="A6.SS2.SSSx1.p4.m8" class="ltx_Math" alttext="a,c" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>,</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">a,c</annotation></semantics></math> and a vector <math id="A6.SS2.SSSx1.p4.m9" class="ltx_Math" alttext="u\in\mdmathbb R^{p}" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>∈</mo><msup><mi>R</mi><mi>p</mi></msup></mrow><annotation encoding="application/x-tex">u\in\mdmathbb R^{p}</annotation></semantics></math> determined by <math id="A6.SS2.SSSx1.p4.m10" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math>.
Since <math id="A6.SS2.SSSx1.p4.m11" class="ltx_math_unparsed" alttext="x_{n}=\rho^{\top}x_{n-p:n-1}+\varepsilon_{n}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><msub><mrow></mrow><mi>n</mi></msub><mo>=</mo><mi mathvariant="normal">�</mi><msup><mrow></mrow><mo>⊤</mo></msup><mi>x</mi><msub><mrow></mrow><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>+</mo><mi mathvariant="normal">"</mi><msub><mrow></mrow><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">x_{n}=\rho^{\top}x_{n-p:n-1}+\varepsilon_{n}</annotation></semantics></math> with <math id="A6.SS2.SSSx1.p4.m12" class="ltx_Math" alttext="\varepsilon_{n}\perp\mathcal{F}_{n-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">"</mi><mi>n</mi></msub><mo>⟂</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\varepsilon_{n}\perp\mathcal{F}_{n-1}</annotation></semantics></math> and <math id="A6.SS2.SSSx1.p4.m13" class="ltx_Math" alttext="\varepsilon_{n}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">"</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\varepsilon_{n}</annotation></semantics></math> independent of all earlier innovations, the conditional variance is</span></p>
<table id="A6.Ex91" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex91.m1" class="ltx_math_unparsed" alttext="\var\bigl(v^{\top}Z_{0}\mid\mathcal{F}_{n-1}\bigr)=\var\bigl((u^{\top}x_{n-p:n-1}+c)\varepsilon_{n}+a\,\varepsilon_{n}^{2}\ \big|\ \mathcal{F}_{n-1}\bigr)." display="block" intent=":literal"><semantics><mrow><mo rspace="0em">Var</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msup><mi>v</mi><mo>⊤</mo></msup><msub><mi>Z</mi><mn>0</mn></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo rspace="0.1389em">=</mo><mo lspace="0.1389em" rspace="0em">Var</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mo>⊤</mo></msup><msub><mi>x</mi><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>+</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><msub><mi mathvariant="normal">"</mi><mi>n</mi></msub><mo>+</mo><mi>a</mi><msubsup><mi mathvariant="normal">"</mi><mi>n</mi><mn>2</mn></msubsup><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.667em" stretchy="true">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\var\bigl(v^{\top}Z_{0}\mid\mathcal{F}_{n-1}\bigr)=\var\bigl((u^{\top}x_{n-p:n-1}+c)\varepsilon_{n}+a\,\varepsilon_{n}^{2}\ \big|\ \mathcal{F}_{n-1}\bigr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.SSSx1.p4.3" class="ltx_p"><span id="A6.SS2.SSSx1.p4.3.1" class="ltx_text">If <math id="A6.SS2.SSSx1.p4.m14" class="ltx_Math" alttext="a\neq 0" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a\neq 0</annotation></semantics></math> on a set of positive probability and <math id="A6.SS2.SSSx1.p4.m15" class="ltx_Math" alttext="\varepsilon_{n}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">"</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\varepsilon_{n}</annotation></semantics></math> has finite fourth moment (true e.g. for Gaussian innovations), then this conditional variance is <math id="A6.SS2.SSSx1.p4.m16" class="ltx_Math" alttext="&gt;0" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">&gt;0</annotation></semantics></math> on that set; hence <math id="A6.SS2.SSSx1.p4.m17" class="ltx_Math" alttext="\var(v^{\top}Z_{0})&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">Var</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>v</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>Z</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\var(v^{\top}Z_{0})&gt;0</annotation></semantics></math>, a contradiction.
Thus <math id="A6.SS2.SSSx1.p4.m18" class="ltx_Math" alttext="a=0" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a=0</annotation></semantics></math> a.s.
With <math id="A6.SS2.SSSx1.p4.m19" class="ltx_Math" alttext="a=0" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a=0</annotation></semantics></math>, the conditional variance reduces to
<math id="A6.SS2.SSSx1.p4.m20" class="ltx_math_unparsed" alttext="\var\bigl((u^{\top}x_{n-p:n-1}+c)\varepsilon_{n}\mid\mathcal{F}_{n-1}\bigr)=(u^{\top}x_{n-p:n-1}+c)^{2}\sigma_{\varepsilon}^{2}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">Var</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mo>⊤</mo></msup><msub><mi>x</mi><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>+</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><msub><mi mathvariant="normal">"</mi><mi>n</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mo>⊤</mo></msup><msub><mi>x</mi><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>+</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msubsup><mi mathvariant="normal">�</mi><mi mathvariant="normal">"</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\var\bigl((u^{\top}x_{n-p:n-1}+c)\varepsilon_{n}\mid\mathcal{F}_{n-1}\bigr)=(u^{\top}x_{n-p:n-1}+c)^{2}\sigma_{\varepsilon}^{2}</annotation></semantics></math>,
forcing <math id="A6.SS2.SSSx1.p4.m21" class="ltx_math_unparsed" alttext="u^{\top}x_{n-p:n-1}+c=0" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><msup><mrow></mrow><mo>⊤</mo></msup><mi>x</mi><msub><mrow></mrow><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>+</mo><mi>c</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">u^{\top}x_{n-p:n-1}+c=0</annotation></semantics></math> a.s.
By Lemma <a href="#A6.Thmtheorem10" title="Lemma F.10 (No non-trivial zero-variance combination of consecutive samples). ‣ Auxiliary lemmas used in ‣ F.2 A finite-sample optimality gap for one-layer LSA ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.10</span></a>, this implies <math id="A6.SS2.SSSx1.p4.m22" class="ltx_Math" alttext="u=0" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">u=0</annotation></semantics></math> and <math id="A6.SS2.SSSx1.p4.m23" class="ltx_Math" alttext="c=0" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c=0</annotation></semantics></math>.
Hence <em id="A6.SS2.SSSx1.p4.3.1.1" class="ltx_emph ltx_font_italic">all</em> coefficients of <math id="A6.SS2.SSSx1.p4.m24" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> that touch <math id="A6.SS2.SSSx1.p4.m25" class="ltx_Math" alttext="x_{n}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>n</mi></msub><annotation encoding="application/x-tex">x_{n}</annotation></semantics></math> vanish.</span></p>
</div>
<div id="A6.SS2.SSSx1.p5" class="ltx_para">
<p id="A6.SS2.SSSx1.p5.1" class="ltx_p"><em id="A6.SS2.SSSx1.p5.1.1" class="ltx_emph ltx_font_italic">Induction upward.</em><span id="A6.SS2.SSSx1.p5.1.2" class="ltx_text">
Assume we have eliminated all coefficients attached to <math id="A6.SS2.SSSx1.p5.m1" class="ltx_Math" alttext="x_{n},x_{n-1},\dots,x_{n-r+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>n</mi></msub><mo>,</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mrow><mrow><mi>n</mi><mo>−</mo><mi>r</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">x_{n},x_{n-1},\dots,x_{n-r+1}</annotation></semantics></math> and to every Gram entry that involves these variables (this means we have removed the last <math id="A6.SS2.SSSx1.p5.m2" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> block-rows of the lower-triangular tableau of the sums defining <math id="A6.SS2.SSSx1.p5.m3" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math>).
Focus on the remaining first time that appears, <math id="A6.SS2.SSSx1.p5.m4" class="ltx_Math" alttext="x_{n-r}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mrow><mi>n</mi><mo>−</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">x_{n-r}</annotation></semantics></math>.
Exactly the same conditioning on <math id="A6.SS2.SSSx1.p5.m5" class="ltx_Math" alttext="\mathcal{F}_{n-r-1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>n</mi><mo>−</mo><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\mathcal{F}_{n-r-1}</annotation></semantics></math>, writing <math id="A6.SS2.SSSx1.p5.m6" class="ltx_math_unparsed" alttext="x_{n-r}=\phi^{\top}x_{n-r-p:n-r-1}+\varepsilon_{n-r}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>−</mo><mi>r</mi></mrow></msub><mo>=</mo><mi mathvariant="normal">�</mi><msup><mrow></mrow><mo>⊤</mo></msup><mi>x</mi><msub><mrow></mrow><mrow><mrow><mi>n</mi><mo>−</mo><mi>r</mi><mo>−</mo><mi>p</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>n</mi><mo>−</mo><mi>r</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>+</mo><mi mathvariant="normal">"</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>−</mo><mi>r</mi></mrow></msub></mrow><annotation encoding="application/x-tex">x_{n-r}=\phi^{\top}x_{n-r-p:n-r-1}+\varepsilon_{n-r}</annotation></semantics></math>, shows that the coefficient of <math id="A6.SS2.SSSx1.p5.m7" class="ltx_Math" alttext="x_{n-r}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mrow><mi>n</mi><mo>−</mo><mi>r</mi></mrow><mn>2</mn></msubsup><annotation encoding="application/x-tex">x_{n-r}^{2}</annotation></semantics></math> must be <math id="A6.SS2.SSSx1.p5.m8" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>, and then the linear coefficient of <math id="A6.SS2.SSSx1.p5.m9" class="ltx_Math" alttext="x_{n-r}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mrow><mi>n</mi><mo>−</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">x_{n-r}</annotation></semantics></math> must be <math id="A6.SS2.SSSx1.p5.m10" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>.
By Lemma <a href="#A6.Thmtheorem10" title="Lemma F.10 (No non-trivial zero-variance combination of consecutive samples). ‣ Auxiliary lemmas used in ‣ F.2 A finite-sample optimality gap for one-layer LSA ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.10</span></a> again, <em id="A6.SS2.SSSx1.p5.1.2.1" class="ltx_emph ltx_font_italic">all</em> coefficients in <math id="A6.SS2.SSSx1.p5.m11" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> that touch <math id="A6.SS2.SSSx1.p5.m12" class="ltx_Math" alttext="x_{n-r}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mrow><mi>n</mi><mo>−</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">x_{n-r}</annotation></semantics></math> vanish.</span></p>
</div>
<div id="A6.SS2.SSSx1.p6" class="ltx_para">
<p id="A6.SS2.SSSx1.p6.1" class="ltx_p"><span id="A6.SS2.SSSx1.p6.1.1" class="ltx_text">Proceeding for <math id="A6.SS2.SSSx1.p6.m1" class="ltx_Math" alttext="r=1,\dots,p" display="inline" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">r=1,\dots,p</annotation></semantics></math> removes all entries of <math id="A6.SS2.SSSx1.p6.m2" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> associated with <math id="A6.SS2.SSSx1.p6.m3" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> and with the last <math id="A6.SS2.SSSx1.p6.m4" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> block-rows of <math id="A6.SS2.SSSx1.p6.m5" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math>.
Finally, the block that involves no recent <math id="A6.SS2.SSSx1.p6.m6" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>’s also collapses by the same argument (conditioning on <math id="A6.SS2.SSSx1.p6.m7" class="ltx_Math" alttext="\mathcal{F}_{t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{t}</annotation></semantics></math> at the appropriate times).
We conclude <math id="A6.SS2.SSSx1.p6.m8" class="ltx_Math" alttext="v=0" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">v=0</annotation></semantics></math>, contradicting the assumption.
Therefore <math id="A6.SS2.SSSx1.p6.m9" class="ltx_Math" alttext="\Cov(Z_{0})\succ 0" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">Cov</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≻</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Cov(Z_{0})\succ 0</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A6.Thmtheorem5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A6.Thmtheorem5.2" class="ltx_text ltx_font_bold">Lemma F.5</span></span><span id="A6.Thmtheorem5.3" class="ltx_text ltx_font_bold"> </span>(Two linear–algebra tools)<span id="A6.Thmtheorem5.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A6.Thmtheorem5.p1" class="ltx_para">
<p id="A6.Thmtheorem5.p1.1" class="ltx_p"><span id="A6.Thmtheorem5.p1.1.1" class="ltx_text ltx_font_italic">(i) If <math id="A6.Thmtheorem5.p1.m1" class="ltx_Math" alttext="\Sigma=\begin{pmatrix}\Sigma_{AA}&amp;\Sigma_{AB}\\
\Sigma_{BA}&amp;\Sigma_{BB}\end{pmatrix}\in\mdmathbb{R}^{(m+n)\times(m+n)}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">�</mi><mo>=</mo><mrow><mo>(</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><msub><mi mathvariant="normal">�</mi><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub></mtd><mtd><msub><mi mathvariant="normal">�</mi><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi mathvariant="normal">�</mi><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub></mtd><mtd><msub><mi mathvariant="normal">�</mi><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo>∈</mo><msup><mi>R</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\Sigma=\begin{pmatrix}\Sigma_{AA}&amp;\Sigma_{AB}\\
\Sigma_{BA}&amp;\Sigma_{BB}\end{pmatrix}\in\mdmathbb{R}^{(m+n)\times(m+n)}</annotation></semantics></math> is positive definite, then the Schur complement
<math id="A6.Thmtheorem5.p1.m2" class="ltx_Math" alttext="\Sigma_{AA}-\Sigma_{AB}\Sigma_{BB}^{-1}\Sigma_{BA}\succ 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">�</mi><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub><mo>−</mo><mrow><msub><mi mathvariant="normal">�</mi><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">�</mi><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">�</mi><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub></mrow></mrow><mo>≻</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Sigma_{AA}-\Sigma_{AB}\Sigma_{BB}^{-1}\Sigma_{BA}\succ 0</annotation></semantics></math>.
(ii) If <math id="A6.Thmtheorem5.p1.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is square–integrable with <math id="A6.Thmtheorem5.p1.m4" class="ltx_Math" alttext="\Cov(X)\succ 0" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">Cov</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≻</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Cov(X)\succ 0</annotation></semantics></math> then, for every nonzero <math id="A6.Thmtheorem5.p1.m5" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math>, <math id="A6.Thmtheorem5.p1.m6" class="ltx_Math" alttext="\var(v^{\top}X)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">Var</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi mathvariant="normal">v</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">X</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\var(v^{\top}X)&gt;0</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A6.SS2.SSSx1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A6.SS2.SSSx1.p7" class="ltx_para">
<p id="A6.SS2.SSSx1.p7.1" class="ltx_p"><span id="A6.SS2.SSSx1.p7.1.1" class="ltx_text">(i) is standard; see, e.g., any matrix analysis text. (ii) is immediate from <math id="A6.SS2.SSSx1.p7.m1" class="ltx_math_unparsed" alttext="v^{\top}\Cov(X)v=\var(v^{\top}X)" display="inline" intent=":literal"><semantics><mrow><msup><mi>v</mi><mo>⊤</mo></msup><mo lspace="0.167em" rspace="0em">Cov</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>v</mi><mo rspace="0.1389em">=</mo><mo lspace="0.1389em" rspace="0em">Var</mo><mrow><mo stretchy="false">(</mo><msup><mi>v</mi><mo>⊤</mo></msup><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">v^{\top}\Cov(X)v=\var(v^{\top}X)</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="A6.SS2.SSSx2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection">Step 2: lifting to the Kronecker level</h4>

<div id="A6.SS2.SSSx2.p1" class="ltx_para">
<p id="A6.SS2.SSSx2.p1.1" class="ltx_p">We now show that the lift <math id="A6.SS2.SSSx2.p1.m1" class="ltx_Math" alttext="Z=(\vech G)\otimes x" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>vech</mi><mo lspace="0.167em">⁡</mo><mi>G</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊗</mo><mi>x</mi></mrow></mrow><annotation encoding="application/x-tex">Z=(\vech G)\otimes x</annotation></semantics></math> is also strictly nondegenerate in the block sense.</p>
</div>
<div id="A6.Thmtheorem6" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A6.Thmtheorem6.2" class="ltx_text ltx_font_bold">Lemma F.6</span></span><span id="A6.Thmtheorem6.3" class="ltx_text ltx_font_bold"> </span>(Strict PD of the Kronecker–lifted block)<span id="A6.Thmtheorem6.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A6.Thmtheorem6.p1" class="ltx_para">
<p id="A6.Thmtheorem6.p1.1" class="ltx_p"><span id="A6.Thmtheorem6.p1.1.1" class="ltx_text ltx_font_italic">With <math id="A6.Thmtheorem6.p1.m1" class="ltx_Math" alttext="g:=\vech G" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>:=</mo><mrow><mi>vech</mi><mo lspace="0.167em">⁡</mo><mi>G</mi></mrow></mrow><annotation encoding="application/x-tex">g:=\vech G</annotation></semantics></math>, <math id="A6.Thmtheorem6.p1.m2" class="ltx_math_unparsed" alttext="x:=x_{\,n-p+1:n}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>:=</mo><mi>x</mi><msub><mrow></mrow><mrow><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">x:=x_{\,n-p+1:n}</annotation></semantics></math> and <math id="A6.Thmtheorem6.p1.m3" class="ltx_Math" alttext="Z:=g\otimes x" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>:=</mo><mrow><mi>g</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>x</mi></mrow></mrow><annotation encoding="application/x-tex">Z:=g\otimes x</annotation></semantics></math>,</span></p>
<table id="A6.Ex92" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex92.m1" class="ltx_Math" alttext="\Sigma^{\otimes}=\begin{pmatrix}\widetilde{S}&amp;\widetilde{r}\\
\widetilde{r}^{\top}&amp;\Gamma_{p}\end{pmatrix}=\mdmathbb E\left[\begin{pmatrix}Z\\
x\end{pmatrix}\begin{pmatrix}Z\\
x\end{pmatrix}^{\top}\right]\ \succ\ 0." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">�</mi><mo>⊗</mo></msup><mo>=</mo><mrow><mo>(</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mover accent="true"><mi>S</mi><mo>~</mo></mover></mtd><mtd><mover accent="true"><mi>r</mi><mo>~</mo></mover></mtd></mtr><mtr><mtd><msup><mover accent="true"><mi>r</mi><mo>~</mo></mover><mo>⊤</mo></msup></mtd><mtd><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo>=</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><mi>Z</mi></mtd></mtr><mtr><mtd><mi>x</mi></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><mi>Z</mi></mtd></mtr><mtr><mtd><mi>x</mi></mtd></mtr></mtable><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo rspace="0.500em">]</mo></mrow></mrow><mo>≻</mo><mn> 0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Sigma^{\otimes}=\begin{pmatrix}\widetilde{S}&amp;\widetilde{r}\\
\widetilde{r}^{\top}&amp;\Gamma_{p}\end{pmatrix}=\mdmathbb E\left[\begin{pmatrix}Z\\
x\end{pmatrix}\begin{pmatrix}Z\\
x\end{pmatrix}^{\top}\right]\ \succ\ 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A6.SS2.SSSx2.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A6.SS2.SSSx2.p2" class="ltx_para">
<p id="A6.SS2.SSSx2.p2.1" class="ltx_p"><span id="A6.SS2.SSSx2.p2.1.1" class="ltx_text">Take any <math id="A6.SS2.SSSx2.p2.m1" class="ltx_Math" alttext="(u,w)\neq(0,0)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo>≠</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(u,w)\neq(0,0)</annotation></semantics></math> with <math id="A6.SS2.SSSx2.p2.m2" class="ltx_Math" alttext="u\in\mdmathbb R^{qp}" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>∈</mo><msup><mi>R</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msup></mrow><annotation encoding="application/x-tex">u\in\mdmathbb R^{qp}</annotation></semantics></math>, <math id="A6.SS2.SSSx2.p2.m3" class="ltx_Math" alttext="w\in\mdmathbb R^{p}" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>∈</mo><msup><mi>R</mi><mi>p</mi></msup></mrow><annotation encoding="application/x-tex">w\in\mdmathbb R^{p}</annotation></semantics></math>, and reshape <math id="A6.SS2.SSSx2.p2.m4" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> into a matrix <math id="A6.SS2.SSSx2.p2.m5" class="ltx_Math" alttext="U\in\mdmathbb R^{q\times p}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>∈</mo><msup><mi>R</mi><mrow><mi>q</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>p</mi></mrow></msup></mrow><annotation encoding="application/x-tex">U\in\mdmathbb R^{q\times p}</annotation></semantics></math> so that <math id="A6.SS2.SSSx2.p2.m6" class="ltx_Math" alttext="u=\vect(U)" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>=</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u=\vect(U)</annotation></semantics></math>.
Consider the scalar</span></p>
<table id="A6.Ex93" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex93.m1" class="ltx_Math" alttext="Y\;:=\;u^{\top}Z+w^{\top}x\;=\;\sum_{s=1}^{p}x_{s}\Bigl(w_{s}+\sum_{\ell=1}^{q}U_{\ell s}\,g_{\ell}\Bigr)\;=\;x^{\top}\bigl(w+Ug\bigr)." display="block" intent=":literal"><semantics><mrow><mrow><mi>Y</mi><mo lspace="0.558em" rspace="0.558em">:=</mo><mrow><mrow><msup><mi>u</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>Z</mi></mrow><mo>+</mo><mrow><msup><mi>w</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><mo lspace="0.558em" rspace="0.391em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>p</mi></munderover><mrow><msub><mi>x</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msub><mi>w</mi><mi>s</mi></msub><mo rspace="0.055em">+</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>q</mi></munderover><mrow><msub><mi>U</mi><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.280em">)</mo></mrow></mrow></mrow><mo rspace="0.558em">=</mo><mrow><msup><mi>x</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>w</mi><mo>+</mo><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Y\;:=\;u^{\top}Z+w^{\top}x\;=\;\sum_{s=1}^{p}x_{s}\Bigl(w_{s}+\sum_{\ell=1}^{q}U_{\ell s}\,g_{\ell}\Bigr)\;=\;x^{\top}\bigl(w+Ug\bigr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.SSSx2.p2.2" class="ltx_p"><span id="A6.SS2.SSSx2.p2.2.1" class="ltx_text">Condition on <math id="A6.SS2.SSSx2.p2.m7" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>. Using the tower property,</span></p>
<table id="A6.Ex94" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex94.m1" class="ltx_Math" alttext="\var(Y)=\mdmathbb E\bigl[\var(Y\mid x)\bigr]+\var\bigl(\mdmathbb E[Y\mid x]\bigr)\;\geq\;\mdmathbb E\bigl[\var\bigl(x^{\top}(Ug)\mid x\bigr)\bigr]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0em">Var</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mo lspace="0em" rspace="0em">Var</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo>+</mo><mrow><mo lspace="0em" rspace="0em">Var</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>Y</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.280em">)</mo></mrow></mrow></mrow><mo rspace="0.558em">≥</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mo lspace="0em" rspace="0em">Var</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msup><mi>x</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Ug</mi><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\var(Y)=\mdmathbb E\bigl[\var(Y\mid x)\bigr]+\var\bigl(\mdmathbb E[Y\mid x]\bigr)\;\geq\;\mdmathbb E\bigl[\var\bigl(x^{\top}(Ug)\mid x\bigr)\bigr].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.SSSx2.p2.3" class="ltx_p"><span id="A6.SS2.SSSx2.p2.3.1" class="ltx_text">Given <math id="A6.SS2.SSSx2.p2.m8" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, <math id="A6.SS2.SSSx2.p2.m9" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> is a deterministic vector and <math id="A6.SS2.SSSx2.p2.m10" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> is still random. Hence</span></p>
<table id="A6.Ex95" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex95.m1" class="ltx_math_unparsed" alttext="\var\bigl(x^{\top}(Ug)\mid x\bigr)=x^{\top}\,U\,\Cov(g\mid x)\,U^{\top}x." display="block" intent=":literal"><semantics><mrow><mo rspace="0em">Var</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msup><mi>x</mi><mo>⊤</mo></msup><mrow><mo stretchy="false">(</mo><mi>Ug</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>=</mo><msup><mi>x</mi><mo>⊤</mo></msup><mi>U</mi><mo lspace="0.337em" rspace="0em">Cov</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo rspace="0.170em" stretchy="false">)</mo></mrow><msup><mi>U</mi><mo>⊤</mo></msup><mi>x</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\var\bigl(x^{\top}(Ug)\mid x\bigr)=x^{\top}\,U\,\Cov(g\mid x)\,U^{\top}x.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.SSSx2.p2.4" class="ltx_p"><span id="A6.SS2.SSSx2.p2.4.1" class="ltx_text">By Lemma <a href="#A6.Thmtheorem4" title="Lemma F.4 (Strict covariance of (vech𝐺,𝑥)). ‣ Step 1: strict positive definiteness of a basic block ‣ F.2 A finite-sample optimality gap for one-layer LSA ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.4</span></a> and the Schur–complement Lemma <a href="#A6.Thmtheorem5" title="Lemma F.5 (Two linear–algebra tools). ‣ Step 1: strict positive definiteness of a basic block ‣ F.2 A finite-sample optimality gap for one-layer LSA ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.5</span></a>(i),</span></p>
<table id="A6.Ex96" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex96.m1" class="ltx_math_unparsed" alttext="\Cov(g\mid x)=\Cov(g)-\Cov(g,x)\,\Gamma_{p}^{-1}\Cov(x,g)\ \succ\ 0." display="block" intent=":literal"><semantics><mrow><mo rspace="0em">Cov</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.1389em">=</mo><mo lspace="0.1389em" rspace="0em">Cov</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mo lspace="0em" rspace="0em">Cov</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mi>x</mi><mo rspace="0.170em" stretchy="false">)</mo></mrow><msubsup><mi mathvariant="normal">�</mi><mi>p</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0.167em" rspace="0em">Cov</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>g</mi><mo rspace="0.500em" stretchy="false">)</mo></mrow><mo>≻</mo><mn> 0</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Cov(g\mid x)=\Cov(g)-\Cov(g,x)\,\Gamma_{p}^{-1}\Cov(x,g)\ \succ\ 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.SSSx2.p2.5" class="ltx_p"><span id="A6.SS2.SSSx2.p2.5.1" class="ltx_text">Therefore, for any <math id="A6.SS2.SSSx2.p2.m11" class="ltx_Math" alttext="U\neq 0" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">U\neq 0</annotation></semantics></math>, <math id="A6.SS2.SSSx2.p2.m12" class="ltx_math_unparsed" alttext="x^{\top}U\,\Cov(g\mid x)\,U^{\top}x&gt;0" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mo>⊤</mo></msup><mi>U</mi><mo lspace="0.337em" rspace="0em">Cov</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo rspace="0.170em" stretchy="false">)</mo></mrow><msup><mi>U</mi><mo>⊤</mo></msup><mi>x</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">x^{\top}U\,\Cov(g\mid x)\,U^{\top}x&gt;0</annotation></semantics></math> on a set of positive probability (because <math id="A6.SS2.SSSx2.p2.m13" class="ltx_Math" alttext="\Gamma_{p}\succ 0" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo>≻</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Gamma_{p}\succ 0</annotation></semantics></math> and <math id="A6.SS2.SSSx2.p2.m14" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> is non-degenerate); taking expectations yields <math id="A6.SS2.SSSx2.p2.m15" class="ltx_Math" alttext="\var(Y)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">Var</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\var(Y)&gt;0</annotation></semantics></math>.
If instead <math id="A6.SS2.SSSx2.p2.m16" class="ltx_Math" alttext="U=0" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">U=0</annotation></semantics></math> then <math id="A6.SS2.SSSx2.p2.m17" class="ltx_Math" alttext="u=0" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">u=0</annotation></semantics></math> and <math id="A6.SS2.SSSx2.p2.m18" class="ltx_Math" alttext="Y=w^{\top}x" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo>=</mo><mrow><msup><mi>w</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><annotation encoding="application/x-tex">Y=w^{\top}x</annotation></semantics></math>; since <math id="A6.SS2.SSSx2.p2.m19" class="ltx_Math" alttext="\Gamma_{p}\succ 0" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo>≻</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Gamma_{p}\succ 0</annotation></semantics></math>, Lemma <a href="#A6.Thmtheorem5" title="Lemma F.5 (Two linear–algebra tools). ‣ Step 1: strict positive definiteness of a basic block ‣ F.2 A finite-sample optimality gap for one-layer LSA ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.5</span></a>(ii) implies <math id="A6.SS2.SSSx2.p2.m20" class="ltx_Math" alttext="\var(Y)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">Var</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\var(Y)&gt;0</annotation></semantics></math> unless <math id="A6.SS2.SSSx2.p2.m21" class="ltx_Math" alttext="w=0" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">w=0</annotation></semantics></math>.
Thus no nonzero <math id="A6.SS2.SSSx2.p2.m22" class="ltx_Math" alttext="(u,w)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u,w)</annotation></semantics></math> can make <math id="A6.SS2.SSSx2.p2.m23" class="ltx_Math" alttext="\var(Y)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">Var</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\var(Y)=0</annotation></semantics></math>, which proves <math id="A6.SS2.SSSx2.p2.m24" class="ltx_Math" alttext="\Sigma^{\otimes}\succ 0" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">�</mi><mo>⊗</mo></msup><mo>≻</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Sigma^{\otimes}\succ 0</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="A6.SS2.SSSx3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection">Step 3: the gap via a Schur complement</h4>

<div id="A6.SS2.SSSx3.p1" class="ltx_para">
<p id="A6.SS2.SSSx3.p1.1" class="ltx_p">We are ready to state and prove the main result.</p>
</div>
<div id="A6.Thmtheorem7" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A6.Thmtheorem7.2" class="ltx_text ltx_font_bold">Theorem F.7</span></span><span id="A6.Thmtheorem7.3" class="ltx_text ltx_font_bold"> </span>(Finite-sample optimality gap of one-layer LSA)<span id="A6.Thmtheorem7.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A6.Thmtheorem7.p1" class="ltx_para">
<p id="A6.Thmtheorem7.p1.1" class="ltx_p"><span id="A6.Thmtheorem7.p1.1.1" class="ltx_text ltx_font_italic">Let the setup above hold. Define</span></p>
<table id="A6.Ex97" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex97.m1" class="ltx_Math" alttext="\Delta\;:=\;\Gamma_{p}-\widetilde{r}^{\top}\widetilde{S}^{-1}\widetilde{r}." display="block" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">�</mi><mo lspace="0.558em" rspace="0.558em">:=</mo><mrow><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo>−</mo><mrow><msup><mover accent="true"><mi>r</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>r</mi><mo>~</mo></mover></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Delta\;:=\;\Gamma_{p}-\widetilde{r}^{\top}\widetilde{S}^{-1}\widetilde{r}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmtheorem7.p1.2" class="ltx_p"><span id="A6.Thmtheorem7.p1.2.1" class="ltx_text ltx_font_italic">Then</span></p>
<table id="A6.Ex98" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex98.m1" class="ltx_Math" alttext="\min_{b,A}\ \mdmathbb E\big[(\widehat{x}_{n+1}(b,A)-x_{n+1})^{2}\big]\ \geq\ \sigma_{\varepsilon}^{2}\;+\;\rho^{\top}\Delta\,\rho,\qquad\Delta\ \succ\ 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munder><mi>min</mi><mrow><mi>b</mi><mo>,</mo><mi>A</mi></mrow></munder><mo lspace="0.667em">⁡</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em" rspace="0.500em">]</mo></mrow></mrow></mrow><mo rspace="0.778em">≥</mo><mrow><msubsup><mi mathvariant="normal">�</mi><mi mathvariant="normal">"</mi><mn>2</mn></msubsup><mo rspace="0.502em">+</mo><mrow><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">�</mi><mo lspace="0.170em" rspace="0em">​</mo><mi mathvariant="normal">�</mi></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi mathvariant="normal">�</mi><mo lspace="0.778em">≻</mo><mn> 0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\min_{b,A}\ \mdmathbb E\big[(\widehat{x}_{n+1}(b,A)-x_{n+1})^{2}\big]\ \geq\ \sigma_{\varepsilon}^{2}\;+\;\rho^{\top}\Delta\,\rho,\qquad\Delta\ \succ\ 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmtheorem7.p1.3" class="ltx_p"><span id="A6.Thmtheorem7.p1.3.1" class="ltx_text ltx_font_italic">Equivalently,</span></p>
<table id="A6.Ex99" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex99.m1" class="ltx_Math" alttext="\min_{b,A}\ \mdmathbb E\big[(\widehat{x}_{n+1}(b,A)-x_{n+1})^{2}\big]\;\geq\;\min_{w}\ \mdmathbb E\big[(w^{\top}x-x_{n+1})^{2}\big]\;+\;\rho^{\top}\Delta\,\rho," display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mi>min</mi><mrow><mi>b</mi><mo>,</mo><mi>A</mi></mrow></munder><mo lspace="0.667em">⁡</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em" rspace="0.280em">]</mo></mrow></mrow></mrow><mo rspace="0.558em">≥</mo><mrow><mrow><munder><mi>min</mi><mi>w</mi></munder><mo lspace="0.167em">⁡</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>w</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>−</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em" rspace="0.280em">]</mo></mrow></mrow></mrow><mo rspace="0.502em">+</mo><mrow><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">�</mi><mo lspace="0.170em" rspace="0em">​</mo><mi mathvariant="normal">�</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\min_{b,A}\ \mdmathbb E\big[(\widehat{x}_{n+1}(b,A)-x_{n+1})^{2}\big]\;\geq\;\min_{w}\ \mdmathbb E\big[(w^{\top}x-x_{n+1})^{2}\big]\;+\;\rho^{\top}\Delta\,\rho,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmtheorem7.p1.4" class="ltx_p"><span id="A6.Thmtheorem7.p1.4.1" class="ltx_text ltx_font_italic">so one-layer LSA has a strictly positive excess risk over linear regression for any finite <math id="A6.Thmtheorem7.p1.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A6.SS2.SSSx3.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A6.SS2.SSSx3.p2" class="ltx_para">
<p id="A6.SS2.SSSx3.p2.1" class="ltx_p"><span id="A6.SS2.SSSx3.p2.1.1" class="ltx_text">By Lemma <a href="#A6.Thmtheorem6" title="Lemma F.6 (Strict PD of the Kronecker–lifted block). ‣ Step 2: lifting to the Kronecker level ‣ F.2 A finite-sample optimality gap for one-layer LSA ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.6</span></a>, <math id="A6.SS2.SSSx3.p2.m1" class="ltx_Math" alttext="\widetilde{S}\succ 0" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>S</mi><mo>~</mo></mover><mo>≻</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\widetilde{S}\succ 0</annotation></semantics></math> and its Schur complement in <math id="A6.SS2.SSSx3.p2.m2" class="ltx_Math" alttext="\Sigma^{\otimes}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">�</mi><mo>⊗</mo></msup><annotation encoding="application/x-tex">\Sigma^{\otimes}</annotation></semantics></math> is
<math id="A6.SS2.SSSx3.p2.m3" class="ltx_Math" alttext="\Gamma_{p}-\widetilde{r}^{\top}\widetilde{S}^{-1}\widetilde{r}\succ 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo>−</mo><mrow><msup><mover accent="true"><mi>r</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>r</mi><mo>~</mo></mover></mrow></mrow><mo>≻</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Gamma_{p}-\widetilde{r}^{\top}\widetilde{S}^{-1}\widetilde{r}\succ 0</annotation></semantics></math>.
Minimizing (<a href="#A6.E5" title="Equation 5 ‣ Kronecker reparameterization. ‣ F.2 A finite-sample optimality gap for one-layer LSA ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>) over <math id="A6.SS2.SSSx3.p2.m4" class="ltx_Math" alttext="\widetilde{\eta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi mathvariant="normal">�</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{\eta}</annotation></semantics></math> gives
<math id="A6.SS2.SSSx3.p2.m5" class="ltx_Math" alttext="\widetilde{\eta}^{*}=\widetilde{S}^{-1}\widetilde{r}\,\rho" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi mathvariant="normal">�</mi><mo>~</mo></mover><mo>∗</mo></msup><mo>=</mo><mrow><msup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>r</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">�</mi></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\eta}^{*}=\widetilde{S}^{-1}\widetilde{r}\,\rho</annotation></semantics></math> and</span></p>
<table id="A6.Ex100" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex100.m1" class="ltx_Math" alttext="\min_{\widetilde{\eta}}\mathcal{L}=\sigma_{\varepsilon}^{2}+\rho^{\top}\Gamma_{p}\rho-\rho^{\top}\widetilde{r}^{\top}\widetilde{S}^{-1}\widetilde{r}\,\rho=\sigma_{\varepsilon}^{2}+\rho^{\top}\Delta\rho." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mi>min</mi><mover accent="true"><mi mathvariant="normal">�</mi><mo>~</mo></mover></munder><mo lspace="0.167em">⁡</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo>=</mo><mrow><mrow><msubsup><mi mathvariant="normal">�</mi><mi mathvariant="normal">"</mi><mn>2</mn></msubsup><mo>+</mo><mrow><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">�</mi></mrow></mrow><mo>−</mo><mrow><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>r</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>r</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">�</mi></mrow></mrow><mo>=</mo><mrow><msubsup><mi mathvariant="normal">�</mi><mi mathvariant="normal">"</mi><mn>2</mn></msubsup><mo>+</mo><mrow><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">�</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">�</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\min_{\widetilde{\eta}}\mathcal{L}=\sigma_{\varepsilon}^{2}+\rho^{\top}\Gamma_{p}\rho-\rho^{\top}\widetilde{r}^{\top}\widetilde{S}^{-1}\widetilde{r}\,\rho=\sigma_{\varepsilon}^{2}+\rho^{\top}\Delta\rho.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.SSSx3.p2.2" class="ltx_p"><span id="A6.SS2.SSSx3.p2.2.1" class="ltx_text">Because <math id="A6.SS2.SSSx3.p2.m6" class="ltx_Math" alttext="(b,A)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b,A)</annotation></semantics></math> can realize only the rank–one Kronecker set of <math id="A6.SS2.SSSx3.p2.m7" class="ltx_Math" alttext="\widetilde{\eta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi mathvariant="normal">�</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{\eta}</annotation></semantics></math>,
<math id="A6.SS2.SSSx3.p2.m8" class="ltx_Math" alttext="\min_{b,A}\mathcal{L}\geq\min_{\widetilde{\eta}}\mathcal{L}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>min</mi><mrow><mi>b</mi><mo>,</mo><mi>A</mi></mrow></msub><mo lspace="0.167em">⁡</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo>≥</mo><mrow><msub><mi>min</mi><mover accent="true"><mi mathvariant="normal">�</mi><mo>~</mo></mover></msub><mo lspace="0.167em">⁡</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow></mrow><annotation encoding="application/x-tex">\min_{b,A}\mathcal{L}\geq\min_{\widetilde{\eta}}\mathcal{L}</annotation></semantics></math>, proving the bound.
Strict positivity of the excess term follows from <math id="A6.SS2.SSSx3.p2.m9" class="ltx_Math" alttext="\Delta\succ 0" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">�</mi><mo>≻</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta\succ 0</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A6.Thmtheorem8" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A6.Thmtheorem8.2" class="ltx_text ltx_font_bold">Remark F.8</span></span><span id="A6.Thmtheorem8.3" class="ltx_text ltx_font_bold"> </span>(Population limit and order of limits)<span id="A6.Thmtheorem8.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A6.Thmtheorem8.p1" class="ltx_para">
<p id="A6.Thmtheorem8.p1.1" class="ltx_p"><span id="A6.Thmtheorem8.p1.1.1" class="ltx_text ltx_font_italic">If <math id="A6.Thmtheorem8.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is replaced by the population covariance <math id="A6.Thmtheorem8.p1.m2" class="ltx_Math" alttext="\Gamma_{p+1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">�</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\Gamma_{p+1}</annotation></semantics></math>, then <math id="A6.Thmtheorem8.p1.m3" class="ltx_Math" alttext="g=\vech(\Gamma_{p+1})" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><mrow><mi>vech</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">g=\vech(\Gamma_{p+1})</annotation></semantics></math> is deterministic. Writing <math id="A6.Thmtheorem8.p1.m4" class="ltx_Math" alttext="u:=g" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>:=</mo><mi>g</mi></mrow><annotation encoding="application/x-tex">u:=g</annotation></semantics></math>,</span></p>
<table id="A6.Ex101" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex101.m1" class="ltx_math_unparsed" alttext="\widetilde{S}=(uu^{\top})\otimes\Gamma_{p},\qquad\widetilde{r}=u\otimes\Gamma_{p}\quad\Longrightarrow\quad\widetilde{r}^{\top}\widetilde{S}^{+}\widetilde{r}=\Gamma_{p}," display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi>S</mi><mo>~</mo></mover><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><msup><mi>u</mi><mo>⊤</mo></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊗</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo rspace="2.167em">,</mo><mover accent="true"><mi>r</mi><mo>~</mo></mover><mo>=</mo><mi>u</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo stretchy="false">⟹</mo><msup><mover accent="true"><mi>r</mi><mo>~</mo></mover><mo>⊤</mo></msup><msup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mo>+</mo></msup><mover accent="true"><mi>r</mi><mo>~</mo></mover><mo>=</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">\widetilde{S}=(uu^{\top})\otimes\Gamma_{p},\qquad\widetilde{r}=u\otimes\Gamma_{p}\quad\Longrightarrow\quad\widetilde{r}^{\top}\widetilde{S}^{+}\widetilde{r}=\Gamma_{p},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmtheorem8.p1.2" class="ltx_p"><span id="A6.Thmtheorem8.p1.2.1" class="ltx_text ltx_font_italic">so <math id="A6.Thmtheorem8.p1.m5" class="ltx_Math" alttext="\Delta=0" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">�</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta=0</annotation></semantics></math> and the gap vanishes. For finite <math id="A6.Thmtheorem8.p1.m6" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>, <math id="A6.Thmtheorem8.p1.m7" class="ltx_Math" alttext="\widetilde{S}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>S</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{S}</annotation></semantics></math> is strictly PD and <math id="A6.Thmtheorem8.p1.m8" class="ltx_Math" alttext="\Delta\succ 0" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">�</mi><mo>≻</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta\succ 0</annotation></semantics></math>; taking <math id="A6.Thmtheorem8.p1.m9" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math> <em id="A6.Thmtheorem8.p1.2.1.1" class="ltx_emph ltx_font_upright">before</em> inverting collapses the gap, illustrating an order-of-limits effect. As shown in  <a href="#A5.Thmtheorem14" title="Proposition E.14 (Asymptotic exact recovery: a constructive parameter choice). ‣ Setup. ‣ E.3 Nested Transformer Feature Spaces and Risk Monotonicity in Time Series Prediction ‣ Appendix E Transformers Expressivity for TSF ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">E.14</span></a>, in the asymptotic regime we can indeed prove that the one-layer LSA readout exactly recovers the Bayes-optimal linear
predictor in the limit.</span></p>
</div>
</div>
<div id="A6.Thmtheorem9" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A6.Thmtheorem9.2" class="ltx_text ltx_font_bold">Theorem F.9</span></span><span id="A6.Thmtheorem9.3" class="ltx_text ltx_font_bold"> </span>(Uniform excess-risk over a parameter family)<span id="A6.Thmtheorem9.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A6.Thmtheorem9.p1" class="ltx_para">
<p id="A6.Thmtheorem9.p1.1" class="ltx_p"><span id="A6.Thmtheorem9.p1.1.1" class="ltx_text ltx_font_italic">Fix <math id="A6.Thmtheorem9.p1.m1" class="ltx_Math" alttext="0&lt;r&lt;R" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>r</mi><mo>&lt;</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">0&lt;r&lt;R</annotation></semantics></math> and <math id="A6.Thmtheorem9.p1.m2" class="ltx_Math" alttext="\mathcal{R}:=\{\rho\in\mdmathbb R^{p}:r&lt;\|\rho\|_{2}&lt;R\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>:=</mo><mrow><mo stretchy="false">{</mo><mrow><mi mathvariant="normal">�</mi><mo>∈</mo><msup><mi>R</mi><mi>p</mi></msup></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>r</mi><mo>&lt;</mo><msub><mrow><mo stretchy="false">‖</mo><mi mathvariant="normal">�</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>&lt;</mo><mi>R</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{R}:=\{\rho\in\mdmathbb R^{p}:r&lt;\|\rho\|_{2}&lt;R\}</annotation></semantics></math>.
Set <math id="A6.Thmtheorem9.p1.m3" class="ltx_Math" alttext="\lambda_{\min}:=\inf_{\rho\in\mathcal{R}}\lambda_{\min}(\Delta(\rho))" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">�</mi><mi>min</mi></msub><mo rspace="0.1389em">:=</mo><mrow><msub><mo lspace="0.1389em" rspace="0.167em">inf</mo><mrow><mi mathvariant="normal">�</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi></mrow></msub><mrow><msub><mi mathvariant="normal">�</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">�</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">�</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{\min}:=\inf_{\rho\in\mathcal{R}}\lambda_{\min}(\Delta(\rho))</annotation></semantics></math>.
Then, uniformly for all <math id="A6.Thmtheorem9.p1.m4" class="ltx_Math" alttext="\rho\in\mathcal{R}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">�</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi></mrow><annotation encoding="application/x-tex">\rho\in\mathcal{R}</annotation></semantics></math>,</span></p>
<table id="A6.Ex102" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex102.m1" class="ltx_Math" alttext="\min_{b,A}\ \mdmathbb E\big[(\widehat{x}_{n+1}(b,A)-x_{n+1})^{2}\big]\ \geq\ \sigma_{\varepsilon}^{2}+\lambda_{\min}\,r^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mi>min</mi><mrow><mi>b</mi><mo>,</mo><mi>A</mi></mrow></munder><mo lspace="0.667em">⁡</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em" rspace="0.500em">]</mo></mrow></mrow></mrow><mo rspace="0.778em">≥</mo><mrow><msubsup><mi mathvariant="normal">�</mi><mi mathvariant="normal">"</mi><mn>2</mn></msubsup><mo>+</mo><mrow><msub><mi mathvariant="normal">�</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mn>2</mn></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\min_{b,A}\ \mdmathbb E\big[(\widehat{x}_{n+1}(b,A)-x_{n+1})^{2}\big]\ \geq\ \sigma_{\varepsilon}^{2}+\lambda_{\min}\,r^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A6.SS2.SSSx3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A6.SS2.SSSx3.p3" class="ltx_para">
<p id="A6.SS2.SSSx3.p3.1" class="ltx_p"><span id="A6.SS2.SSSx3.p3.1.1" class="ltx_text">By Theorem <a href="#A6.Thmtheorem7" title="Theorem F.7 (Finite-sample optimality gap of one-layer LSA). ‣ Step 3: the gap via a Schur complement ‣ F.2 A finite-sample optimality gap for one-layer LSA ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.7</span></a>, the excess is <math id="A6.SS2.SSSx3.p3.m1" class="ltx_Math" alttext="\rho^{\top}\Delta(\rho)\rho" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">�</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">�</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">�</mi></mrow><annotation encoding="application/x-tex">\rho^{\top}\Delta(\rho)\rho</annotation></semantics></math> with <math id="A6.SS2.SSSx3.p3.m2" class="ltx_Math" alttext="\Delta(\rho)\succ 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">�</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">�</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≻</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta(\rho)\succ 0</annotation></semantics></math> for each <math id="A6.SS2.SSSx3.p3.m3" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi mathvariant="normal">�</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>.
Continuity of <math id="A6.SS2.SSSx3.p3.m4" class="ltx_Math" alttext="\rho\mapsto\Delta(\rho)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">�</mi><mo stretchy="false">↦</mo><mrow><mi mathvariant="normal">�</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">�</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho\mapsto\Delta(\rho)</annotation></semantics></math> and compactness of <math id="A6.SS2.SSSx3.p3.m5" class="ltx_Math" alttext="\overline{\mathcal{R}}=\{\rho:r\leq\|\rho\|_{2}\leq R\}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo stretchy="true">¯</mo></mover><mo>=</mo><mrow><mo stretchy="false">{</mo><mi mathvariant="normal">�</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>r</mi><mo>≤</mo><msub><mrow><mo stretchy="false">‖</mo><mi mathvariant="normal">�</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mi>R</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\overline{\mathcal{R}}=\{\rho:r\leq\|\rho\|_{2}\leq R\}</annotation></semantics></math>, the Extreme Value Theorem (Theorem <a href="#A6.Thmtheorem11" title="Theorem F.11 (Extreme Value Theorem []). ‣ Auxiliary lemmas used in ‣ F.2 A finite-sample optimality gap for one-layer LSA ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.11</span></a>) ensures that <math id="A6.SS2.SSSx3.p3.m6" class="ltx_Math" alttext="\lambda_{\min}(\Delta(\rho))" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">�</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">�</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">�</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda_{\min}(\Delta(\rho))</annotation></semantics></math> attains a strictly positive minimum on <math id="A6.SS2.SSSx3.p3.m7" class="ltx_Math" alttext="\overline{\mathcal{R}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{\mathcal{R}}</annotation></semantics></math>.
Hence <math id="A6.SS2.SSSx3.p3.m8" class="ltx_Math" alttext="\rho^{\top}\Delta(\rho)\rho\geq\lambda_{\min}\|\rho\|_{2}^{2}\geq\lambda_{\min}r^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">�</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">�</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">�</mi></mrow><mo>≥</mo><mrow><msub><mi mathvariant="normal">�</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi mathvariant="normal">�</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>≥</mo><mrow><msub><mi mathvariant="normal">�</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\rho^{\top}\Delta(\rho)\rho\geq\lambda_{\min}\|\rho\|_{2}^{2}\geq\lambda_{\min}r^{2}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="A6.SS2.SSSx4" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection">Auxiliary lemmas used in <a href="#A6.SS2" title="F.2 A finite-sample optimality gap for one-layer LSA ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">F.2</span></a></h4>

<div id="A6.Thmtheorem10" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A6.Thmtheorem10.2" class="ltx_text ltx_font_bold">Lemma F.10</span></span><span id="A6.Thmtheorem10.3" class="ltx_text ltx_font_bold"> </span>(No non-trivial zero-variance combination of consecutive samples)<span id="A6.Thmtheorem10.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A6.Thmtheorem10.p1" class="ltx_para">
<p id="A6.Thmtheorem10.p1.1" class="ltx_p"><span id="A6.Thmtheorem10.p1.1.1" class="ltx_text ltx_font_italic">For any integers <math id="A6.Thmtheorem10.p1.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> and <math id="A6.Thmtheorem10.p1.m2" class="ltx_Math" alttext="k\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k\geq 1</annotation></semantics></math> and any coefficients <math id="A6.Thmtheorem10.p1.m3" class="ltx_Math" alttext="c_{1},\dots,c_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>c</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">c_{1},\dots,c_{k}</annotation></semantics></math>,</span></p>
<table id="A6.Ex103" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex103.m1" class="ltx_Math" alttext="Y:=\sum_{j=1}^{k}c_{j}\,x_{\,i+j-1}=0\ \text{a.s.}\quad\Longrightarrow\quad c_{1}=\dots=c_{k}=0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Y</mi><mo rspace="0.111em">:=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover><mrow><msub><mi>c</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mrow><mi>i</mi><mo>+</mo><mi>j</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo>=</mo><mrow><mn>0</mn><mo lspace="0.500em" rspace="0em">​</mo><mtext class="ltx_mathvariant_italic">a.s.</mtext></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mo stretchy="false">⟹</mo><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mi>c</mi><mn>1</mn></msub><mo>=</mo><mi mathvariant="normal">⋯</mi><mo>=</mo><msub><mi>c</mi><mi>k</mi></msub><mo>=</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Y:=\sum_{j=1}^{k}c_{j}\,x_{\,i+j-1}=0\ \text{a.s.}\quad\Longrightarrow\quad c_{1}=\dots=c_{k}=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A6.SS2.SSSx4.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A6.SS2.SSSx4.p1" class="ltx_para">
<p id="A6.SS2.SSSx4.p1.1" class="ltx_p"><span id="A6.SS2.SSSx4.p1.1.1" class="ltx_text">Let <math id="A6.SS2.SSSx4.p1.m1" class="ltx_math_unparsed" alttext="\mathcal{F}_{i+k-2}:=\sigma(\varepsilon_{t}:t\leq i+k-2)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mrow><mi>i</mi><mo>+</mo><mi>k</mi></mrow><mo>−</mo><mn>2</mn></mrow></msub><mo>:=</mo><mi mathvariant="normal">�</mi><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">"</mi><mi>t</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi><mo>≤</mo><mi>i</mi><mo>+</mo><mi>k</mi><mo>−</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}_{i+k-2}:=\sigma(\varepsilon_{t}:t\leq i+k-2)</annotation></semantics></math>.
Write <math id="A6.SS2.SSSx4.p1.m2" class="ltx_math_unparsed" alttext="x_{i+k-1}=\phi^{\top}x_{i+k-2:i-1}+\varepsilon_{i+k-1}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><msub><mrow></mrow><mrow><mrow><mi>i</mi><mo>+</mo><mi>k</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub><mo>=</mo><mi mathvariant="normal">�</mi><msup><mrow></mrow><mo>⊤</mo></msup><mi>x</mi><msub><mrow></mrow><mrow><mrow><mrow><mi>i</mi><mo>+</mo><mi>k</mi></mrow><mo>−</mo><mn>2</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>+</mo><mi mathvariant="normal">"</mi><msub><mrow></mrow><mrow><mrow><mi>i</mi><mo>+</mo><mi>k</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">x_{i+k-1}=\phi^{\top}x_{i+k-2:i-1}+\varepsilon_{i+k-1}</annotation></semantics></math> with <math id="A6.SS2.SSSx4.p1.m3" class="ltx_Math" alttext="\varepsilon_{i+k-1}\perp\mathcal{F}_{i+k-2}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">"</mi><mrow><mrow><mi>i</mi><mo>+</mo><mi>k</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub><mo>⟂</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mrow><mi>i</mi><mo>+</mo><mi>k</mi></mrow><mo>−</mo><mn>2</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\varepsilon_{i+k-1}\perp\mathcal{F}_{i+k-2}</annotation></semantics></math>.
Conditioning,</span></p>
<table id="A6.Ex104" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex104.m1" class="ltx_math_unparsed" alttext="\var(Y\mid\mathcal{F}_{i+k-2})\;=\;c_{k}^{2}\,\var(\varepsilon_{i+k-1})\;=\;c_{k}^{2}\sigma_{\varepsilon}^{2}." display="block" intent=":literal"><semantics><mrow><mo rspace="0em">Var</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mrow><mi>i</mi><mo>+</mo><mi>k</mi></mrow><mo>−</mo><mn>2</mn></mrow></msub><mo rspace="0.280em" stretchy="false">)</mo></mrow><mo rspace="0.558em">=</mo><msubsup><mi>c</mi><mi>k</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">Var</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">"</mi><mrow><mrow><mi>i</mi><mo>+</mo><mi>k</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub><mo rspace="0.280em" stretchy="false">)</mo></mrow><mo rspace="0.558em">=</mo><msubsup><mi>c</mi><mi>k</mi><mn>2</mn></msubsup><msubsup><mi mathvariant="normal">�</mi><mi mathvariant="normal">"</mi><mn>2</mn></msubsup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\var(Y\mid\mathcal{F}_{i+k-2})\;=\;c_{k}^{2}\,\var(\varepsilon_{i+k-1})\;=\;c_{k}^{2}\sigma_{\varepsilon}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.SSSx4.p1.2" class="ltx_p"><span id="A6.SS2.SSSx4.p1.2.1" class="ltx_text">If <math id="A6.SS2.SSSx4.p1.m4" class="ltx_Math" alttext="Y=0" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">Y=0</annotation></semantics></math> a.s., then <math id="A6.SS2.SSSx4.p1.m5" class="ltx_Math" alttext="\var(Y\mid\mathcal{F}_{i+k-2})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">Var</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mrow><mi>i</mi><mo>+</mo><mi>k</mi></mrow><mo>−</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\var(Y\mid\mathcal{F}_{i+k-2})=0</annotation></semantics></math> a.s., hence <math id="A6.SS2.SSSx4.p1.m6" class="ltx_Math" alttext="c_{k}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>k</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c_{k}=0</annotation></semantics></math>.
Iterate backwards on <math id="A6.SS2.SSSx4.p1.m7" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> to conclude <math id="A6.SS2.SSSx4.p1.m8" class="ltx_Math" alttext="c_{1}=\dots=c_{k}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>1</mn></msub><mo>=</mo><mi mathvariant="normal">⋯</mi><mo>=</mo><msub><mi>c</mi><mi>k</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c_{1}=\dots=c_{k}=0</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A6.Thmtheorem11" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A6.Thmtheorem11.2" class="ltx_text ltx_font_bold">Theorem F.11</span></span><span id="A6.Thmtheorem11.3" class="ltx_text ltx_font_bold"> </span>(Extreme Value Theorem <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib83" title="" class="ltx_ref">83</a>]</cite>)<span id="A6.Thmtheorem11.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A6.Thmtheorem11.p1" class="ltx_para">
<p id="A6.Thmtheorem11.p1.1" class="ltx_p"><span id="A6.Thmtheorem11.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A6.Thmtheorem11.p1.m1" class="ltx_Math" alttext="K\subset\mdmathbb{R}^{n}" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊂</mo><msup><mi>R</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">K\subset\mdmathbb{R}^{n}</annotation></semantics></math> be a nonempty compact set, and let <math id="A6.Thmtheorem11.p1.m2" class="ltx_Math" alttext="f:K\to\mdmathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>K</mi><mo stretchy="false">→</mo><mi>R</mi></mrow></mrow><annotation encoding="application/x-tex">f:K\to\mdmathbb{R}</annotation></semantics></math> be continuous. Then <math id="A6.Thmtheorem11.p1.m3" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is bounded on <math id="A6.Thmtheorem11.p1.m4" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, and there exist points <math id="A6.Thmtheorem11.p1.m5" class="ltx_Math" alttext="x_{\min},x_{\max}\in K" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>min</mi></msub><mo>,</mo><mrow><msub><mi>x</mi><mi>max</mi></msub><mo>∈</mo><mi>K</mi></mrow></mrow><annotation encoding="application/x-tex">x_{\min},x_{\max}\in K</annotation></semantics></math> such that</span></p>
</div>
<div id="A6.Thmtheorem11.p2" class="ltx_para">
<table id="A6.Ex105" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex105.m1" class="ltx_Math" alttext="f(x_{\min})=\inf_{x\in K}f(x),\qquad f(x_{\max})=\sup_{x\in K}f(x)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>min</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">inf</mo><mrow><mi>x</mi><mo>∈</mo><mi>K</mi></mrow></munder><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>max</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mi>x</mi><mo>∈</mo><mi>K</mi></mrow></munder><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f(x_{\min})=\inf_{x\in K}f(x),\qquad f(x_{\max})=\sup_{x\in K}f(x).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
</section>
</section>
<section id="A6.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">F.3 </span>Order of the finite-sample gap</h3>

<div id="A6.SS3.p1" class="ltx_para">
<p id="A6.SS3.p1.1" class="ltx_p"><span id="A6.SS3.p1.1.1" class="ltx_text ltx_font_italic">Goal.</span>
We quantify the finite–sample excess risk in Theorem <a href="#A6.Thmtheorem7" title="Theorem F.7 (Finite-sample optimality gap of one-layer LSA). ‣ Step 3: the gap via a Schur complement ‣ F.2 A finite-sample optimality gap for one-layer LSA ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.7</span></a> and show it decays at rate <math id="A6.SS3.p1.m1" class="ltx_Math" alttext="1/n" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">1/n</annotation></semantics></math>. The proof expands the lifted second moments to first order around their population (rank-one) limit and evaluates the Schur complement via a singular block inverse.</p>
</div>
<section id="A6.SS3.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Setup (recalled).</h5>

<div id="A6.SS3.SSS0.Px1.p1" class="ltx_para">
<p id="A6.SS3.SSS0.Px1.p1.1" class="ltx_p">Let <math id="A6.SS3.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\{x_{t}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{x_{t}\}</annotation></semantics></math> be a zero-mean stationary Gaussian AR(<math id="A6.SS3.SSS0.Px1.p1.m2" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>) process as in Definition <a href="#S2.Thmtheorem2" title="Definition 2.2 (AR(𝑝) Process []). ‣ 2.1 Time Series ‣ 2 Preliminaries ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.2</span></a>, with absolutely summable autocovariances <math id="A6.SS3.SSS0.Px1.p1.m3" class="ltx_math_unparsed" alttext="\sum_{h\in\mdmathbb Z}|{}_{h}|&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>h</mi><mo>∈</mo><mi>Z</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mrow></mrow><mi>h</mi></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\sum_{h\in\mdmathbb Z}|{}_{h}|&lt;\infty</annotation></semantics></math>.
For <math id="A6.SS3.SSS0.Px1.p1.m4" class="ltx_Math" alttext="n\geq p" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">n\geq p</annotation></semantics></math>, let <math id="A6.SS3.SSS0.Px1.p1.m5" class="ltx_Math" alttext="H_{n}=[\,x^{(1)}\;\dots\;x^{(n-p+1)}\,]" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>n</mi></msub><mo>=</mo><mrow><mo rspace="0.170em" stretchy="false">[</mo><mrow><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">…</mi><mo lspace="0.280em" rspace="0em">​</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">H_{n}=[\,x^{(1)}\;\dots\;x^{(n-p+1)}\,]</annotation></semantics></math> be the Hankel matrix from Definition <a href="#S2.Thmtheorem5" title="Definition 2.5 (Hankel Matrix). ‣ 2.3 In-Context Time Series Forecasting ‣ 2 Preliminaries ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.5</span></a>, mask <math id="A6.SS3.SSS0.Px1.p1.m6" class="ltx_Math" alttext="M=\mathrm{diag}(I_{\,n-p},0)" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><mrow><mi>diag</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>I</mi><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></msub><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M=\mathrm{diag}(I_{\,n-p},0)</annotation></semantics></math>, and</p>
<table id="A6.Ex106" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex106.m1" class="ltx_Math" alttext="G_{n}=\frac{1}{n}H_{n}MH_{n}^{\top}=\frac{1}{n}\sum_{m=1}^{n-p}x^{(m)}x^{(m)\top}\in\mdmathbb R^{(p+1)\times(p+1)}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>G</mi><mi>n</mi></msub><mo>=</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>H</mi><mi>n</mi><mo>⊤</mo></msubsup></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></munderover><mrow><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msup></mrow></mrow></mrow><mo>∈</mo><msup><mi>R</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">G_{n}=\frac{1}{n}H_{n}MH_{n}^{\top}=\frac{1}{n}\sum_{m=1}^{n-p}x^{(m)}x^{(m)\top}\in\mdmathbb R^{(p+1)\times(p+1)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p1.2" class="ltx_p">Let <math id="A6.SS3.SSS0.Px1.p1.m7" class="ltx_math_unparsed" alttext="x:=x_{\,n-p+1:n}\in\mdmathbb R^{p}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>:=</mo><mi>x</mi><msub><mrow></mrow><mrow><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo>∈</mo><mi>R</mi><msup><mrow></mrow><mi>p</mi></msup></mrow><annotation encoding="application/x-tex">x:=x_{\,n-p+1:n}\in\mdmathbb R^{p}</annotation></semantics></math>, <math id="A6.SS3.SSS0.Px1.p1.m8" class="ltx_Math" alttext="\Gamma_{p+1}:=\mdmathbb E[x^{(m)}x^{(m)\top}]" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">�</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>:=</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Gamma_{p+1}:=\mdmathbb E[x^{(m)}x^{(m)\top}]</annotation></semantics></math>, <math id="A6.SS3.SSS0.Px1.p1.m9" class="ltx_Math" alttext="\Gamma_{p}:=\mdmathbb E[xx^{\top}]" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo>:=</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Gamma_{p}:=\mdmathbb E[xx^{\top}]</annotation></semantics></math>, and <math id="A6.SS3.SSS0.Px1.p1.m10" class="ltx_Math" alttext="u:=\operatorname{vech}(\Gamma_{p+1})\in\mdmathbb R^{q}" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>:=</mo><mrow><mi>vech</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>R</mi><mi>q</mi></msup></mrow><annotation encoding="application/x-tex">u:=\operatorname{vech}(\Gamma_{p+1})\in\mdmathbb R^{q}</annotation></semantics></math> with <math id="A6.SS3.SSS0.Px1.p1.m11" class="ltx_Math" alttext="q=\tfrac{(p+1)(p+2)}{2}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">q=\tfrac{(p+1)(p+2)}{2}</annotation></semantics></math>.
Define the lifted moments</p>
<table id="A6.Ex107" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex107.m1" class="ltx_Math" alttext="S_{n}:=\mdmathbb E\big[(\operatorname{vec}G_{n}\otimes x)(\operatorname{vec}G_{n}\otimes x)^{\top}\big],\quad r_{n}:=\mdmathbb E\big[(\operatorname{vec}G_{n}\otimes x)\,x^{\top}\big]," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>S</mi><mi>n</mi></msub><mo>:=</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>vec</mi><mo lspace="0.167em">⁡</mo><msub><mi>G</mi><mi>n</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>vec</mi><mo lspace="0.167em">⁡</mo><msub><mi>G</mi><mi>n</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>r</mi><mi>n</mi></msub><mo>:=</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>vec</mi><mo lspace="0.167em">⁡</mo><msub><mi>G</mi><mi>n</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>x</mi><mo>⊤</mo></msup></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">S_{n}:=\mdmathbb E\big[(\operatorname{vec}G_{n}\otimes x)(\operatorname{vec}G_{n}\otimes x)^{\top}\big],\quad r_{n}:=\mdmathbb E\big[(\operatorname{vec}G_{n}\otimes x)\,x^{\top}\big],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p1.3" class="ltx_p">and their half-vectorized versions</p>
<table id="A6.Ex108" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex108.m1" class="ltx_Math" alttext="\widetilde{S}_{n}:=\mdmathbb E\big[(\operatorname{vech}G_{n}\otimes x)(\operatorname{vech}G_{n}\otimes x)^{\top}\big],\quad\widetilde{r}_{n}:=\mdmathbb E\big[(\operatorname{vech}G_{n}\otimes x)\,x^{\top}\big]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>n</mi></msub><mo>:=</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>vech</mi><mo lspace="0.167em">⁡</mo><msub><mi>G</mi><mi>n</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>vech</mi><mo lspace="0.167em">⁡</mo><msub><mi>G</mi><mi>n</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>n</mi></msub><mo>:=</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>vech</mi><mo lspace="0.167em">⁡</mo><msub><mi>G</mi><mi>n</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>x</mi><mo>⊤</mo></msup></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widetilde{S}_{n}:=\mdmathbb E\big[(\operatorname{vech}G_{n}\otimes x)(\operatorname{vech}G_{n}\otimes x)^{\top}\big],\quad\widetilde{r}_{n}:=\mdmathbb E\big[(\operatorname{vech}G_{n}\otimes x)\,x^{\top}\big].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.Thmtheorem12" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A6.Thmtheorem12.2" class="ltx_text ltx_font_bold">Lemma F.12</span></span><span id="A6.Thmtheorem12.3" class="ltx_text ltx_font_bold"> </span>(First-order expansions of <math id="A6.Thmtheorem12.m1" class="ltx_Math" alttext="\widetilde{S}_{n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>n</mi></msub><annotation encoding="application/x-tex">\widetilde{S}_{n}</annotation></semantics></math> and <math id="A6.Thmtheorem12.m2" class="ltx_Math" alttext="\widetilde{r}_{n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>n</mi></msub><annotation encoding="application/x-tex">\widetilde{r}_{n}</annotation></semantics></math>)<span id="A6.Thmtheorem12.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A6.Thmtheorem12.p1" class="ltx_para">
<p id="A6.Thmtheorem12.p1.1" class="ltx_p"><span id="A6.Thmtheorem12.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A6.Thmtheorem12.p1.m1" class="ltx_Math" alttext="L_{p+1}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">L_{p+1}</annotation></semantics></math> be the elimination matrix with <math id="A6.Thmtheorem12.p1.m2" class="ltx_Math" alttext="\operatorname{vech}(A)=L_{p+1}\operatorname{vec}(A)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>vech</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>L</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\operatorname{vech}(A)=L_{p+1}\operatorname{vec}(A)</annotation></semantics></math> for symmetric <math id="A6.Thmtheorem12.p1.m3" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>.
Then, as <math id="A6.Thmtheorem12.p1.m4" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math> with <math id="A6.Thmtheorem12.p1.m5" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> fixed,</span></p>
<table id="A6.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.E6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.E6.m1" class="ltx_Math" alttext="\displaystyle S_{n}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\displaystyle S_{n}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E6.m2" class="ltx_Math" alttext="\displaystyle=(\operatorname{vec}\Gamma_{p+1})(\operatorname{vec}\Gamma_{p+1})^{\top}\otimes\Gamma_{p}\;+\;\frac{1}{n}\,C_{S}^{(\mathrm{vec})}\;+\;o(1/n)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>vec</mi><mo lspace="0.167em">⁡</mo><msub><mi mathvariant="normal">�</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>vec</mi><mo lspace="0.167em">⁡</mo><msub><mi mathvariant="normal">�</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo rspace="0.222em">⊗</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub></mrow><mo rspace="0.502em">+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>C</mi><mi>S</mi><mrow><mo stretchy="false">(</mo><mi>vec</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo rspace="0.502em">+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=(\operatorname{vec}\Gamma_{p+1})(\operatorname{vec}\Gamma_{p+1})^{\top}\otimes\Gamma_{p}\;+\;\frac{1}{n}\,C_{S}^{(\mathrm{vec})}\;+\;o(1/n),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6)</span></td></tr></tbody>
<tbody id="A6.E7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.E7.m1" class="ltx_Math" alttext="\displaystyle r_{n}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\displaystyle r_{n}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E7.m2" class="ltx_Math" alttext="\displaystyle=(\operatorname{vec}\Gamma_{p+1})\otimes\Gamma_{p}\;+\;\frac{1}{n}\,C_{r}^{(\mathrm{vec})}\;+\;o(1/n)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>vec</mi><mo lspace="0.167em">⁡</mo><msub><mi mathvariant="normal">�</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊗</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub></mrow><mo rspace="0.502em">+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>C</mi><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>vec</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo rspace="0.502em">+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=(\operatorname{vec}\Gamma_{p+1})\otimes\Gamma_{p}\;+\;\frac{1}{n}\,C_{r}^{(\mathrm{vec})}\;+\;o(1/n),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7)</span></td></tr></tbody>
</table>
<p id="A6.Thmtheorem12.p1.2" class="ltx_p"><span id="A6.Thmtheorem12.p1.2.1" class="ltx_text ltx_font_italic">for deterministic <math id="A6.Thmtheorem12.p1.m6" class="ltx_Math" alttext="C_{S}^{(\mathrm{vec})},C_{r}^{(\mathrm{vec})}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>C</mi><mi>S</mi><mrow><mo stretchy="false">(</mo><mi>vec</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>C</mi><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>vec</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">C_{S}^{(\mathrm{vec})},C_{r}^{(\mathrm{vec})}</annotation></semantics></math> depending only on <math id="A6.Thmtheorem12.p1.m7" class="ltx_math_unparsed" alttext="\{{}_{h}\},p" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><mmultiscripts><mo stretchy="false">}</mo><mprescripts></mprescripts><mi>h</mi><mrow></mrow></mmultiscripts></mrow><mo>,</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">\{{}_{h}\},p</annotation></semantics></math>. Consequently</span></p>
<table id="A6.Ex109" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex109.m1" class="ltx_Math" alttext="\widetilde{S}_{n}=(uu^{\top})\otimes\Gamma_{p}+\frac{1}{n}\,C_{S}+o(1/n),\qquad\widetilde{r}_{n}=u\otimes\Gamma_{p}+\frac{1}{n}\,C_{r}+o(1/n)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>n</mi></msub><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mo>⊤</mo></msup></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊗</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>C</mi><mi>S</mi></msub></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>n</mi></msub><mo>=</mo><mrow><mrow><mi>u</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>C</mi><mi>r</mi></msub></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\widetilde{S}_{n}=(uu^{\top})\otimes\Gamma_{p}+\frac{1}{n}\,C_{S}+o(1/n),\qquad\widetilde{r}_{n}=u\otimes\Gamma_{p}+\frac{1}{n}\,C_{r}+o(1/n),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmtheorem12.p1.3" class="ltx_p"><span id="A6.Thmtheorem12.p1.3.1" class="ltx_text ltx_font_italic">with <math id="A6.Thmtheorem12.p1.m8" class="ltx_Math" alttext="C_{S}=(L_{p+1}\otimes I_{p})C_{S}^{(\mathrm{vec})}(L_{p+1}\otimes I_{p})^{\top}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>S</mi></msub><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>I</mi><mi>p</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mi>S</mi><mrow><mo stretchy="false">(</mo><mi>vec</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>I</mi><mi>p</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">C_{S}=(L_{p+1}\otimes I_{p})C_{S}^{(\mathrm{vec})}(L_{p+1}\otimes I_{p})^{\top}</annotation></semantics></math> and <math id="A6.Thmtheorem12.p1.m9" class="ltx_Math" alttext="C_{r}=(L_{p+1}\otimes I_{p})C_{r}^{(\mathrm{vec})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>r</mi></msub><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>I</mi><mi>p</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>vec</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">C_{r}=(L_{p+1}\otimes I_{p})C_{r}^{(\mathrm{vec})}</annotation></semantics></math>.
Moreover, for any orthonormal <math id="A6.Thmtheorem12.p1.m10" class="ltx_Math" alttext="Q=[u/\|u\|,\,Q_{\perp}]" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>u</mi><mo>/</mo><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow></mrow><mo rspace="0.337em">,</mo><msub><mi>Q</mi><mo>⟂</mo></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">Q=[u/\|u\|,\,Q_{\perp}]</annotation></semantics></math> and <math id="A6.Thmtheorem12.p1.m11" class="ltx_Math" alttext="P:=Q\otimes I_{p}" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>:=</mo><mrow><mi>Q</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>I</mi><mi>p</mi></msub></mrow></mrow><annotation encoding="application/x-tex">P:=Q\otimes I_{p}</annotation></semantics></math>, writing <math id="A6.Thmtheorem12.p1.m12" class="ltx_Math" alttext="c:=\|u\|^{2}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>:=</mo><msup><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">c:=\|u\|^{2}</annotation></semantics></math>,</span></p>
</div>
<div id="A6.Thmtheorem12.p2" class="ltx_para">
<table id="A6.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex110"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex110.m1" class="ltx_Math" alttext="\displaystyle\widehat{S}_{n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi>n</mi></msub><annotation encoding="application/x-tex">\displaystyle\widehat{S}_{n}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex110.m2" class="ltx_Math" alttext="\displaystyle:=P^{\top}\widetilde{S}_{n}P=\begin{bmatrix}c\,\Gamma_{p}&amp;0\\[1.49994pt]
0&amp;0\end{bmatrix}+\frac{1}{n}\begin{bmatrix}C_{11}&amp;B^{\top}\\
B&amp;C\end{bmatrix}+o(1/n)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>P</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>P</mi></mrow><mo>=</mo><mrow><mrow><mo>[</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><mrow><mi>c</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub></mrow></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo>]</mo></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><msub><mi>C</mi><mn>11</mn></msub></mtd><mtd><msup><mi>B</mi><mo>⊤</mo></msup></mtd></mtr><mtr><mtd><mi>B</mi></mtd><mtd><mi>C</mi></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=P^{\top}\widetilde{S}_{n}P=\begin{bmatrix}c\,\Gamma_{p}&amp;0\\[1.49994pt]
0&amp;0\end{bmatrix}+\frac{1}{n}\begin{bmatrix}C_{11}&amp;B^{\top}\\
B&amp;C\end{bmatrix}+o(1/n),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.E8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.E8.m1" class="ltx_Math" alttext="\displaystyle\widehat{r}_{n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>n</mi></msub><annotation encoding="application/x-tex">\displaystyle\widehat{r}_{n}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E8.m2" class="ltx_Math" alttext="\displaystyle:=P^{\top}\widetilde{r}_{n}=\begin{bmatrix}\|u\|\,\Gamma_{p}\\[1.49994pt]
0\end{bmatrix}+\frac{1}{n}\begin{bmatrix}\delta\\[1.49994pt]
d\end{bmatrix}+o(1/n)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>P</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>n</mi></msub></mrow><mo>=</mo><mrow><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub></mrow></mtd></mtr><mtr><mtd><mn>0</mn></mtd></mtr></mtable><mo>]</mo></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><mi mathvariant="normal">�</mi></mtd></mtr><mtr><mtd><mi>d</mi></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=P^{\top}\widetilde{r}_{n}=\begin{bmatrix}\|u\|\,\Gamma_{p}\\[1.49994pt]
0\end{bmatrix}+\frac{1}{n}\begin{bmatrix}\delta\\[1.49994pt]
d\end{bmatrix}+o(1/n),</annotation></semantics></math></td>
