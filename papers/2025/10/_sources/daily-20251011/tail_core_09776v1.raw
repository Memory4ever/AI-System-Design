<div id="A6.Thmtheorem12.p3" class="ltx_para">
<p id="A6.Thmtheorem12.p3.1" class="ltx_p"><span id="A6.Thmtheorem12.p3.1.1" class="ltx_text ltx_font_italic">where <math id="A6.Thmtheorem12.p3.m1" class="ltx_Math" alttext="\bigl[\begin{smallmatrix}C_{11}&amp;B^{\top}\\
B&amp;C\end{smallmatrix}\bigr]=P^{\top}C_{S}P" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><msub><mi mathsize="0.700em">C</mi><mn mathsize="0.700em">11</mn></msub></mtd><mtd><msup><mi mathsize="0.700em">B</mi><mo mathsize="0.700em">⊤</mo></msup></mtd></mtr><mtr><mtd><mi mathsize="0.700em">B</mi></mtd><mtd><mi mathsize="0.700em">C</mi></mtd></mtr></mtable><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo>=</mo><mrow><msup><mi>P</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>P</mi></mrow></mrow><annotation encoding="application/x-tex">\bigl[\begin{smallmatrix}C_{11}&amp;B^{\top}\\
B&amp;C\end{smallmatrix}\bigr]=P^{\top}C_{S}P</annotation></semantics></math> and <math id="A6.Thmtheorem12.p3.m2" class="ltx_Math" alttext="\bigl[\begin{smallmatrix}\delta\\
d\end{smallmatrix}\bigr]=P^{\top}C_{r}" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mtable rowspacing="0pt"><mtr><mtd><mi mathsize="0.700em" mathvariant="normal">�</mi></mtd></mtr><mtr><mtd><mi mathsize="0.700em">d</mi></mtd></mtr></mtable><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo>=</mo><mrow><msup><mi>P</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>r</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\bigl[\begin{smallmatrix}\delta\\
d\end{smallmatrix}\bigr]=P^{\top}C_{r}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A6.SS3.SSS0.Px1.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A6.SS3.SSS0.Px1.p2" class="ltx_para">
<p id="A6.SS3.SSS0.Px1.p2.1" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p2.1.1" class="ltx_text">Stationarity gives <math id="A6.SS3.SSS0.Px1.p2.m1" class="ltx_math_unparsed" alttext="(\Gamma_{p+1})_{ij}={}_{j-i}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><msub><mrow></mrow><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow></msub></mrow><annotation encoding="application/x-tex">(\Gamma_{p+1})_{ij}={}_{j-i}</annotation></semantics></math> and <math id="A6.SS3.SSS0.Px1.p2.m2" class="ltx_math_unparsed" alttext="(\Gamma_{p})_{st}={}_{t-s}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo>=</mo><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msub></mrow><annotation encoding="application/x-tex">(\Gamma_{p})_{st}={}_{t-s}</annotation></semantics></math> for indices <math id="A6.SS3.SSS0.Px1.p2.m3" class="ltx_Math" alttext="i,j,k,\ell\in\{1,\ldots,p+1\}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi><mo>,</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">i,j,k,\ell\in\{1,\ldots,p+1\}</annotation></semantics></math> and <math id="A6.SS3.SSS0.Px1.p2.m4" class="ltx_Math" alttext="s,t\in\{1,\ldots,p\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>p</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">s,t\in\{1,\ldots,p\}</annotation></semantics></math>. All variables are jointly Gaussian with zero mean; Isserlis’ theorem is used throughout.</span></p>
</div>
<div id="A6.SS3.SSS0.Px1.p3" class="ltx_para">
<p id="A6.SS3.SSS0.Px1.p3.1" class="ltx_p"><em id="A6.SS3.SSS0.Px1.p3.1.1" class="ltx_emph ltx_font_italic">Computation of <math id="A6.SS3.SSS0.Px1.p3.m1" class="ltx_Math" alttext="r_{n}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>n</mi></msub><annotation encoding="application/x-tex">r_{n}</annotation></semantics></math>.</em><span id="A6.SS3.SSS0.Px1.p3.1.2" class="ltx_text"> By linearity and <math id="A6.SS3.SSS0.Px1.p3.m2" class="ltx_Math" alttext="G_{n}=\frac{1}{n}\sum_{m=1}^{n-p}x^{(m)}x^{(m),\top}" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>n</mi></msub><mo>=</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></msubsup><mrow><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">,</mo><mo lspace="0em">⊤</mo></mrow></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">G_{n}=\frac{1}{n}\sum_{m=1}^{n-p}x^{(m)}x^{(m),\top}</annotation></semantics></math>,</span></p>
<table id="A6.Ex111" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex111.m1" class="ltx_Math" alttext="r_{n}=\sum_{i,j,s,t}\mdmathbb{E}[G_{ij}\,x_{s}x_{t}]\,(e_{j}\otimes e_{i}\otimes e_{s})e_{t}^{\top},\qquad\mdmathbb{E}[G_{ij}\,x_{s}x_{t}]=\frac{1}{n}\sum_{m=1}^{n-p}\mdmathbb{E}[x^{(m)}_{i}x^{(m)}_{j}x_{s}x_{t}]," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>r</mi><mi>n</mi></msub><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>s</mi><mo>,</mo><mi>t</mi></mrow></munder><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>G</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>e</mi><mi>j</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>e</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>e</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>e</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>G</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></munderover><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>x</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">r_{n}=\sum_{i,j,s,t}\mdmathbb{E}[G_{ij}\,x_{s}x_{t}]\,(e_{j}\otimes e_{i}\otimes e_{s})e_{t}^{\top},\qquad\mdmathbb{E}[G_{ij}\,x_{s}x_{t}]=\frac{1}{n}\sum_{m=1}^{n-p}\mdmathbb{E}[x^{(m)}_{i}x^{(m)}_{j}x_{s}x_{t}],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p3.2" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p3.2.1" class="ltx_text">with <math id="A6.SS3.SSS0.Px1.p3.m3" class="ltx_Math" alttext="x^{(m)}_{i}=x_{m+i-1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>x</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><msub><mi>x</mi><mrow><mrow><mi>m</mi><mo>+</mo><mi>i</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">x^{(m)}_{i}=x_{m+i-1}</annotation></semantics></math>. Let <math id="A6.SS3.SSS0.Px1.p3.m4" class="ltx_Math" alttext="a=x_{m+i-1}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>=</mo><msub><mi>x</mi><mrow><mrow><mi>m</mi><mo>+</mo><mi>i</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">a=x_{m+i-1}</annotation></semantics></math>, <math id="A6.SS3.SSS0.Px1.p3.m5" class="ltx_Math" alttext="b=x_{m+j-1}" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><msub><mi>x</mi><mrow><mrow><mi>m</mi><mo>+</mo><mi>j</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">b=x_{m+j-1}</annotation></semantics></math>, <math id="A6.SS3.SSS0.Px1.p3.m6" class="ltx_Math" alttext="c=x_{n-p+s}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>=</mo><msub><mi>x</mi><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mi>s</mi></mrow></msub></mrow><annotation encoding="application/x-tex">c=x_{n-p+s}</annotation></semantics></math>, <math id="A6.SS3.SSS0.Px1.p3.m7" class="ltx_Math" alttext="d=x_{n-p+t}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><msub><mi>x</mi><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mi>t</mi></mrow></msub></mrow><annotation encoding="application/x-tex">d=x_{n-p+t}</annotation></semantics></math>. Isserlis yields</span></p>
<table id="A6.Ex112" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A6.Ex112X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex112X.m2" class="ltx_Math" alttext="\displaystyle\mdmathbb{E}[abcd]" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mdmathbb{E}[abcd]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex112X.m3" class="ltx_Math" alttext="\displaystyle=\mdmathbb{E}[ab]\mdmathbb{E}[cd]+\mdmathbb{E}[ac]\mdmathbb{E}[bd]+\mdmathbb{E}[ad]\mdmathbb{E}[bc]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mdmathbb{E}[ab]\mdmathbb{E}[cd]+\mdmathbb{E}[ac]\mdmathbb{E}[bd]+\mdmathbb{E}[ad]\mdmathbb{E}[bc]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex112Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex112Xa.m2" class="ltx_Math" alttext="\displaystyle={}_{j-i}(\Gamma_{p})_{st}+{}_{(n-p+s)-(m+i-1)}\,{}_{(n-p+t)-(m+j-1)}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mrow></mrow><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow></msub><mo stretchy="false">(</mo><mi mathvariant="normal">�</mi><msub><mrow></mrow><mi>p</mi></msub><mo stretchy="false">)</mo><msub><mrow></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo>+</mo><msub><mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>m</mi><mo>+</mo><mi>i</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><msub><mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>m</mi><mo>+</mo><mi>j</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle={}_{j-i}(\Gamma_{p})_{st}+{}_{(n-p+s)-(m+i-1)}\,{}_{(n-p+t)-(m+j-1)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex112Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex112Xb.m2" class="ltx_Math" alttext="\displaystyle+{}_{(n-p+t)-(m+i-1)}\,{}_{(n-p+s)-(m+j-1)}." display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">+</mo><msub><mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>m</mi><mo>+</mo><mi>i</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><msub><mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>m</mi><mo>+</mo><mi>j</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+{}_{(n-p+t)-(m+i-1)}\,{}_{(n-p+s)-(m+j-1)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p3.3" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p3.3.1" class="ltx_text">With <math id="A6.SS3.SSS0.Px1.p3.m8" class="ltx_Math" alttext="k:=n-p-m+1\in\{1,\ldots,n-p\}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>:=</mo><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi><mo>−</mo><mi>m</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">k:=n-p-m+1\in\{1,\ldots,n-p\}</annotation></semantics></math>,</span></p>
<table id="A6.Ex113" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex113.m1" class="ltx_math_unparsed" alttext="\mdmathbb{E}[x^{(m)}_{i}x^{(m)}_{j}x_{s}x_{t}]={}_{j-i}(\Gamma_{p})_{st}+{}_{k+s-i}\,{}_{k+t-j}+{}_{k+t-i}\,{}_{k+s-j}." display="block" intent=":literal"><semantics><mrow><mi>E</mi><mrow><mo stretchy="false">[</mo><msubsup><mi>x</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msubsup><msubsup><mi>x</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msubsup><msub><mi>x</mi><mi>s</mi></msub><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><mmultiscripts><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow></mrow><mprescripts></mprescripts><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow><mrow></mrow></mmultiscripts><mo rspace="0em">+</mo><mmultiscripts><mo lspace="0em" rspace="0em">+</mo><mprescripts></mprescripts><mrow><mrow><mi>k</mi><mo>+</mo><mi>s</mi></mrow><mo>−</mo><mi>i</mi></mrow><mrow></mrow><mrow><mrow><mi>k</mi><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>j</mi></mrow><mrow></mrow></mmultiscripts><mmultiscripts><mo lspace="0em">.</mo><mprescripts></mprescripts><mrow><mrow><mi>k</mi><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>i</mi></mrow><mrow></mrow><mrow><mrow><mi>k</mi><mo>+</mo><mi>s</mi></mrow><mo>−</mo><mi>j</mi></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\mdmathbb{E}[x^{(m)}_{i}x^{(m)}_{j}x_{s}x_{t}]={}_{j-i}(\Gamma_{p})_{st}+{}_{k+s-i}\,{}_{k+t-j}+{}_{k+t-i}\,{}_{k+s-j}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p3.4" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p3.4.1" class="ltx_text">Summing over <math id="A6.SS3.SSS0.Px1.p3.m9" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>,</span></p>
<table id="A6.Ex114" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex114.m1" class="ltx_math_unparsed" alttext="\mdmathbb{E}[G_{ij}\,x_{s}x_{t}]=\frac{n-p}{n}\,{}_{j-i}(\Gamma_{p})_{st}+\frac{1}{n}\sum_{k=1}^{n-p}\big({}_{k+s-i}{}_{k+t-j}+{}_{k+t-i}{}_{k+s-j}\big)." display="block" intent=":literal"><semantics><mrow><mi>E</mi><mrow><mo stretchy="false">[</mo><msub><mi>G</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><msub><mi>x</mi><mi>s</mi></msub><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><mfrac><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mi>n</mi></mfrac><mmultiscripts><mrow><mo lspace="0.170em" stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow></mrow><mprescripts></mprescripts><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow><mrow></mrow></mmultiscripts><mo>+</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></munderover><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mmultiscripts><mo lspace="0em" rspace="0em">+</mo><mprescripts></mprescripts><mrow><mrow><mi>k</mi><mo>+</mo><mi>s</mi></mrow><mo>−</mo><mi>i</mi></mrow><mrow></mrow><mrow><mrow><mi>k</mi><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>j</mi></mrow><mrow></mrow></mmultiscripts><mmultiscripts><mo maxsize="1.200em" minsize="1.200em">)</mo><mprescripts></mprescripts><mrow><mrow><mi>k</mi><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>i</mi></mrow><mrow></mrow><mrow><mrow><mi>k</mi><mo>+</mo><mi>s</mi></mrow><mo>−</mo><mi>j</mi></mrow><mrow></mrow></mmultiscripts></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mdmathbb{E}[G_{ij}\,x_{s}x_{t}]=\frac{n-p}{n}\,{}_{j-i}(\Gamma_{p})_{st}+\frac{1}{n}\sum_{k=1}^{n-p}\big({}_{k+s-i}{}_{k+t-j}+{}_{k+t-i}{}_{k+s-j}\big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p3.5" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p3.5.1" class="ltx_text">The first term equals <math id="A6.SS3.SSS0.Px1.p3.m10" class="ltx_math_unparsed" alttext="{}_{j-i}(\Gamma_{p})_{st}+\tfrac{-p}{n}{}_{j-i}(\Gamma_{p})_{st}" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow></mrow><mprescripts></mprescripts><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow><mrow></mrow></mmultiscripts><mo>+</mo><mfrac><mrow><mo>−</mo><mi>p</mi></mrow><mi>n</mi></mfrac><mmultiscripts><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow></mrow><mprescripts></mprescripts><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">{}_{j-i}(\Gamma_{p})_{st}+\tfrac{-p}{n}{}_{j-i}(\Gamma_{p})_{st}</annotation></semantics></math>. Since <math id="A6.SS3.SSS0.Px1.p3.m11" class="ltx_math_unparsed" alttext="\sum_{h}|{}_{h}|&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∑</mo><msub><mrow></mrow><mi>h</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mrow></mrow><mi>h</mi></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\sum_{h}|{}_{h}|&lt;\infty</annotation></semantics></math>, the partial sums <math id="A6.SS3.SSS0.Px1.p3.m12" class="ltx_math_unparsed" alttext="\sum_{k=1}^{n-p}{}_{k+a}{}_{k+b}" display="inline" intent=":literal"><semantics><mrow><mo>∑</mo><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></msup><msub><mrow></mrow><mrow><mi>k</mi><mo>+</mo><mi>a</mi></mrow></msub><msub><mrow></mrow><mrow><mi>k</mi><mo>+</mo><mi>b</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\sum_{k=1}^{n-p}{}_{k+a}{}_{k+b}</annotation></semantics></math> are uniformly bounded for fixed <math id="A6.SS3.SSS0.Px1.p3.m13" class="ltx_Math" alttext="a,b" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><annotation encoding="application/x-tex">a,b</annotation></semantics></math>, and hence</span></p>
<table id="A6.Ex115" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex115.m1" class="ltx_math_unparsed" alttext="\frac{1}{n}\sum_{k=1}^{n-p}\big({}_{k+s-i}{}_{k+t-j}+{}_{k+t-i}{}_{k+s-j}\big)=\frac{1}{n}\,c^{(r)}_{ij,st}+o(1/n)," display="block" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></munderover><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mmultiscripts><mo lspace="0em" rspace="0em">+</mo><mprescripts></mprescripts><mrow><mrow><mi>k</mi><mo>+</mo><mi>s</mi></mrow><mo>−</mo><mi>i</mi></mrow><mrow></mrow><mrow><mrow><mi>k</mi><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>j</mi></mrow><mrow></mrow></mmultiscripts><mmultiscripts><mo maxsize="1.200em" minsize="1.200em">)</mo><mprescripts></mprescripts><mrow><mrow><mi>k</mi><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>i</mi></mrow><mrow></mrow><mrow><mrow><mi>k</mi><mo>+</mo><mi>s</mi></mrow><mo>−</mo><mi>j</mi></mrow><mrow></mrow></mmultiscripts></mrow><mo>=</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><mi>o</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>/</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{1}{n}\sum_{k=1}^{n-p}\big({}_{k+s-i}{}_{k+t-j}+{}_{k+t-i}{}_{k+s-j}\big)=\frac{1}{n}\,c^{(r)}_{ij,st}+o(1/n),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p3.6" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p3.6.1" class="ltx_text">where</span></p>
<table id="A6.Ex116" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex116.m1" class="ltx_math_unparsed" alttext="c^{(r)}_{ij,st}:=\sum_{k=1}^{\infty}\big({}_{k+s-i}{}_{k+t-j}+{}_{k+t-i}{}_{k+s-j}\big)" display="block" intent=":literal"><semantics><mrow><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.111em">:=</mo><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mmultiscripts><mo lspace="0em" rspace="0em">+</mo><mprescripts></mprescripts><mrow><mrow><mi>k</mi><mo>+</mo><mi>s</mi></mrow><mo>−</mo><mi>i</mi></mrow><mrow></mrow><mrow><mrow><mi>k</mi><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>j</mi></mrow><mrow></mrow></mmultiscripts><mmultiscripts><mo maxsize="1.200em" minsize="1.200em">)</mo><mprescripts></mprescripts><mrow><mrow><mi>k</mi><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>i</mi></mrow><mrow></mrow><mrow><mrow><mi>k</mi><mo>+</mo><mi>s</mi></mrow><mo>−</mo><mi>j</mi></mrow><mrow></mrow></mmultiscripts></mrow></mrow><annotation encoding="application/x-tex">c^{(r)}_{ij,st}:=\sum_{k=1}^{\infty}\big({}_{k+s-i}{}_{k+t-j}+{}_{k+t-i}{}_{k+s-j}\big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p3.7" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p3.7.1" class="ltx_text">converges absolutely. Note that</span></p>
<table id="A6.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex117"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex117.m1" class="ltx_math_unparsed" alttext="\displaystyle\sum_{i,j,s,t}{}_{j-i}(\Gamma_{p})_{st}(e_{j}\otimes e_{i}\otimes e_{s})e_{t}^{\top}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>s</mi><mo>,</mo><mi>t</mi></mrow></munder></mstyle><mmultiscripts><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow></mrow><mprescripts></mprescripts><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow><mrow></mrow></mmultiscripts><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mi>j</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>e</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>e</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow><msubsup><mi>e</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i,j,s,t}{}_{j-i}(\Gamma_{p})_{st}(e_{j}\otimes e_{i}\otimes e_{s})e_{t}^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex118"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex118.m1" class="ltx_Math" alttext="\displaystyle=\sum_{i,j,s,t}(\Gamma_{p+1})_{ij}(\Gamma_{p})_{st}(e_{j}\otimes e_{i})\otimes(e_{s}e_{t}^{\top})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>s</mi><mo>,</mo><mi>t</mi></mrow></munder></mstyle><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>e</mi><mi>j</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>e</mi><mi>i</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⊗</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>e</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>e</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i,j,s,t}(\Gamma_{p+1})_{ij}(\Gamma_{p})_{st}(e_{j}\otimes e_{i})\otimes(e_{s}e_{t}^{\top})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex119"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex119.m1" class="ltx_Math" alttext="\displaystyle=\sum_{i,j}(\Gamma_{p+1})_{ij}e_{j}\otimes e_{i}\otimes\bigl(\sum_{s,t}(\Gamma_{p})_{st}e_{s}e_{t}^{\top}\bigr)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></munder></mstyle><mrow><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>j</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>e</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow></munder></mstyle><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>e</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i,j}(\Gamma_{p+1})_{ij}e_{j}\otimes e_{i}\otimes\bigl(\sum_{s,t}(\Gamma_{p})_{st}e_{s}e_{t}^{\top}\bigr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex120"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex120.m1" class="ltx_Math" alttext="\displaystyle=\operatorname{vec}(\Gamma_{p+1})\otimes\Gamma_{p}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\operatorname{vec}(\Gamma_{p+1})\otimes\Gamma_{p}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.SS3.SSS0.Px1.p4" class="ltx_para">
<p id="A6.SS3.SSS0.Px1.p4.1" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p4.1.1" class="ltx_text">Therefore</span></p>
<table id="A6.Ex121" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex121.m1" class="ltx_math_unparsed" alttext="r_{n}=\big(\mathrm{vec}\,\Gamma_{p+1}\big)\otimes\Gamma_{p}+\frac{1}{n}\sum_{i,j,s,t}\Big(-p\,{}_{j-i}(\Gamma_{p})_{st}+c^{(r)}_{ij,st}\Big)\,(e_{j}\otimes e_{i}\otimes e_{s})e_{t}^{\top}+o(1/n)," display="block" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>n</mi></msub><mo>=</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>vec</mi><msub><mi mathvariant="normal">�</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub><mo maxsize="1.200em" minsize="1.200em" rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⊗</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo>+</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>s</mi><mo>,</mo><mi>t</mi></mrow></munder><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mo lspace="0em">−</mo><mi>p</mi><mmultiscripts><mrow><mo lspace="0.170em" stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow></mrow><mprescripts></mprescripts><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow><mrow></mrow></mmultiscripts><mo>+</mo><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msubsup><mo maxsize="1.600em" minsize="1.600em" rspace="0.170em">)</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mi>j</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>e</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>e</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow><msubsup><mi>e</mi><mi>t</mi><mo>⊤</mo></msubsup><mo>+</mo><mi>o</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>/</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">r_{n}=\big(\mathrm{vec}\,\Gamma_{p+1}\big)\otimes\Gamma_{p}+\frac{1}{n}\sum_{i,j,s,t}\Big(-p\,{}_{j-i}(\Gamma_{p})_{st}+c^{(r)}_{ij,st}\Big)\,(e_{j}\otimes e_{i}\otimes e_{s})e_{t}^{\top}+o(1/n),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p4.2" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p4.2.1" class="ltx_text">which is (<a href="#A6.E7" title="Equation 7 ‣ Lemma F.12 (First-order expansions of 𝑆̃_𝑛 and 𝑟̃_𝑛). ‣ Setup (recalled). ‣ F.3 Order of the finite-sample gap ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>) with <math id="A6.SS3.SSS0.Px1.p4.m1" class="ltx_Math" alttext="C_{r}^{(\mathrm{vec})}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>vec</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">C_{r}^{(\mathrm{vec})}</annotation></semantics></math> defined by the bracketed coefficients.</span></p>
</div>
<div id="A6.SS3.SSS0.Px1.p5" class="ltx_para">
<p id="A6.SS3.SSS0.Px1.p5.1" class="ltx_p"><em id="A6.SS3.SSS0.Px1.p5.1.1" class="ltx_emph ltx_font_italic">Computation of <math id="A6.SS3.SSS0.Px1.p5.m1" class="ltx_Math" alttext="S_{n}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>n</mi></msub><annotation encoding="application/x-tex">S_{n}</annotation></semantics></math>.</em><span id="A6.SS3.SSS0.Px1.p5.1.2" class="ltx_text"> By definition,</span></p>
<table id="A6.Ex122" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex122.m1" class="ltx_Math" alttext="S_{n}=\sum_{i,j,k,\ell}\sum_{s,t}\mdmathbb{E}[G_{ij}G_{k\ell}x_{s}x_{t}]\;\big((e_{j}\otimes e_{i}\otimes e_{s})\,(e_{\ell}\otimes e_{k}\otimes e_{t})^{\top}\big)," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>S</mi><mi>n</mi></msub><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></munder><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow></munder><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>G</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>G</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0.280em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>e</mi><mi>j</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>e</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>e</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>e</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>e</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>e</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">S_{n}=\sum_{i,j,k,\ell}\sum_{s,t}\mdmathbb{E}[G_{ij}G_{k\ell}x_{s}x_{t}]\;\big((e_{j}\otimes e_{i}\otimes e_{s})\,(e_{\ell}\otimes e_{k}\otimes e_{t})^{\top}\big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p5.2" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p5.2.1" class="ltx_text">where</span></p>
<table id="A6.Ex123" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex123.m1" class="ltx_Math" alttext="\mdmathbb{E}[G_{ij}G_{k\ell}x_{s}x_{t}]=\frac{1}{n^{2}}\sum_{m=1}^{n-p}\sum_{m^{\prime}=1}^{n-p}\mdmathbb{E}[x^{(m)}_{i}x^{(m)}_{j}x^{(m^{\prime})}_{k}x^{(m^{\prime})}_{\ell}x_{s}x_{t}]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>G</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>G</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><msup><mi>n</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></munderover><mrow><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi>m</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></munderover><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>x</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><msup><mi>m</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mi mathvariant="normal">ℓ</mi><mrow><mo stretchy="false">(</mo><msup><mi>m</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mdmathbb{E}[G_{ij}G_{k\ell}x_{s}x_{t}]=\frac{1}{n^{2}}\sum_{m=1}^{n-p}\sum_{m^{\prime}=1}^{n-p}\mdmathbb{E}[x^{(m)}_{i}x^{(m)}_{j}x^{(m^{\prime})}_{k}x^{(m^{\prime})}_{\ell}x_{s}x_{t}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p5.3" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p5.3.1" class="ltx_text">Let <math id="A6.SS3.SSS0.Px1.p5.m2" class="ltx_Math" alttext="a=x_{m+i-1}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>=</mo><msub><mi>x</mi><mrow><mrow><mi>m</mi><mo>+</mo><mi>i</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">a=x_{m+i-1}</annotation></semantics></math>, <math id="A6.SS3.SSS0.Px1.p5.m3" class="ltx_Math" alttext="b=x_{m+j-1}" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><msub><mi>x</mi><mrow><mrow><mi>m</mi><mo>+</mo><mi>j</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">b=x_{m+j-1}</annotation></semantics></math>, <math id="A6.SS3.SSS0.Px1.p5.m4" class="ltx_Math" alttext="c=x_{m^{\prime}+k-1}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>=</mo><msub><mi>x</mi><mrow><mrow><msup><mi>m</mi><mo>′</mo></msup><mo>+</mo><mi>k</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">c=x_{m^{\prime}+k-1}</annotation></semantics></math>, <math id="A6.SS3.SSS0.Px1.p5.m5" class="ltx_Math" alttext="d=x_{m^{\prime}+\ell-1}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><msub><mi>x</mi><mrow><mrow><msup><mi>m</mi><mo>′</mo></msup><mo>+</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">d=x_{m^{\prime}+\ell-1}</annotation></semantics></math>, <math id="A6.SS3.SSS0.Px1.p5.m6" class="ltx_Math" alttext="e=x_{n-p+s}" display="inline" intent=":literal"><semantics><mrow><mi>e</mi><mo>=</mo><msub><mi>x</mi><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mi>s</mi></mrow></msub></mrow><annotation encoding="application/x-tex">e=x_{n-p+s}</annotation></semantics></math>, <math id="A6.SS3.SSS0.Px1.p5.m7" class="ltx_Math" alttext="f=x_{n-p+t}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><msub><mi>x</mi><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mi>t</mi></mrow></msub></mrow><annotation encoding="application/x-tex">f=x_{n-p+t}</annotation></semantics></math>. Isserlis for six variables decomposes into the term <math id="A6.SS3.SSS0.Px1.p5.m8" class="ltx_Math" alttext="\mdmathbb{E}[ef]\mdmathbb{E}[abcd]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mdmathbb{E}[ef]\mdmathbb{E}[abcd]</annotation></semantics></math> and the <math id="A6.SS3.SSS0.Px1.p5.m9" class="ltx_Math" alttext="12" display="inline" intent=":literal"><semantics><mn>12</mn><annotation encoding="application/x-tex">12</annotation></semantics></math> cross pairings where <math id="A6.SS3.SSS0.Px1.p5.m10" class="ltx_Math" alttext="e" display="inline" intent=":literal"><semantics><mi>e</mi><annotation encoding="application/x-tex">e</annotation></semantics></math> and/or <math id="A6.SS3.SSS0.Px1.p5.m11" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> pair with <math id="A6.SS3.SSS0.Px1.p5.m12" class="ltx_Math" alttext="\{a,b,c,d\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>c</mi><mo>,</mo><mi>d</mi></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{a,b,c,d\}</annotation></semantics></math>. For the four-variable factor,</span></p>
<table id="A6.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex124"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex124.m1" class="ltx_Math" alttext="\displaystyle\mdmathbb{E}[abcd]" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mdmathbb{E}[abcd]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex124.m2" class="ltx_math_unparsed" alttext="\displaystyle={}_{j-i}\,{}_{\ell-k}+{}_{(m+i-1)-(m^{\prime}+k-1)}\,{}_{(m+j-1)-(m^{\prime}+\ell-1)}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><msub><mrow></mrow><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow></msub><msub><mrow></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>k</mi></mrow></msub><mo lspace="0em">+</mo><msub><mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>m</mi><mo>+</mo><mi>i</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>m</mi><mo>′</mo></msup><mo>+</mo><mi>k</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><msub><mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>m</mi><mo>+</mo><mi>j</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>m</mi><mo>′</mo></msup><mo>+</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle={}_{j-i}\,{}_{\ell-k}+{}_{(m+i-1)-(m^{\prime}+k-1)}\,{}_{(m+j-1)-(m^{\prime}+\ell-1)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex125"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex125.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad+{}_{(m+i-1)-(m^{\prime}+\ell-1)}\,{}_{(m+j-1)-(m^{\prime}+k-1)}." display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">+</mo><msub><mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>m</mi><mo>+</mo><mi>i</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>m</mi><mo>′</mo></msup><mo>+</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><msub><mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>m</mi><mo>+</mo><mi>j</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>m</mi><mo>′</mo></msup><mo>+</mo><mi>k</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad+{}_{(m+i-1)-(m^{\prime}+\ell-1)}\,{}_{(m+j-1)-(m^{\prime}+k-1)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p5.4" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p5.4.1" class="ltx_text">Let <math id="A6.SS3.SSS0.Px1.p5.m13" class="ltx_Math" alttext="h=m-m^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>=</mo><mrow><mi>m</mi><mo>−</mo><msup><mi>m</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">h=m-m^{\prime}</annotation></semantics></math>. Then</span></p>
<table id="A6.Ex126" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex126.m1" class="ltx_math_unparsed" alttext="\mdmathbb{E}[abcd]={}_{j-i}\,{}_{\ell-k}+{}_{i-k+h}\,{}_{j-\ell+h}+{}_{i-\ell+h}\,{}_{j-k+h}." display="block" intent=":literal"><semantics><mrow><mi>E</mi><mrow><mo stretchy="false">[</mo><mi>a</mi><mi>b</mi><mi>c</mi><mi>d</mi><mo stretchy="false">]</mo></mrow><mo rspace="0em">=</mo><mmultiscripts><mo lspace="0em" rspace="0em">+</mo><mprescripts></mprescripts><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow><mrow></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>k</mi></mrow><mrow></mrow></mmultiscripts><mmultiscripts><mo lspace="0em" rspace="0em">+</mo><mprescripts></mprescripts><mrow><mrow><mi>i</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mi>h</mi></mrow><mrow></mrow><mrow><mrow><mi>j</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>+</mo><mi>h</mi></mrow><mrow></mrow></mmultiscripts><mmultiscripts><mo lspace="0em">.</mo><mprescripts></mprescripts><mrow><mrow><mi>i</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>+</mo><mi>h</mi></mrow><mrow></mrow><mrow><mrow><mi>j</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mi>h</mi></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\mdmathbb{E}[abcd]={}_{j-i}\,{}_{\ell-k}+{}_{i-k+h}\,{}_{j-\ell+h}+{}_{i-\ell+h}\,{}_{j-k+h}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p5.5" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p5.5.1" class="ltx_text">Averaging over <math id="A6.SS3.SSS0.Px1.p5.m14" class="ltx_Math" alttext="m,m^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>,</mo><msup><mi>m</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">m,m^{\prime}</annotation></semantics></math>,</span></p>
<table id="A6.EGx10" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex127"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex127.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{n^{2}}\sum_{m,m^{\prime}}\mdmathbb{E}[abcd]=" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>n</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>,</mo><msup><mi>m</mi><mo>′</mo></msup></mrow></munder></mstyle><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{n^{2}}\sum_{m,m^{\prime}}\mdmathbb{E}[abcd]=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex127.m2" class="ltx_math_unparsed" alttext="\displaystyle{}_{j-i}\,{}_{\ell-k}+(1-\frac{(n-p)^{2}}{n^{2}}){}_{j-i}\,{}_{\ell-k}" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mo>+</mo><mprescripts></mprescripts><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow><mrow></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>k</mi></mrow><mrow></mrow></mmultiscripts><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msup><mi>n</mi><mn>2</mn></msup></mfrac></mstyle><mo stretchy="false">)</mo></mrow><mmultiscripts><msub><mrow></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>k</mi></mrow></msub><mprescripts></mprescripts><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\displaystyle{}_{j-i}\,{}_{\ell-k}+(1-\frac{(n-p)^{2}}{n^{2}}){}_{j-i}\,{}_{\ell-k}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex128"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex128.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{h=-(n-p-1)}^{n-p-1}\frac{n-p-|h|}{n^{2}}\,\Big({}_{i-k+h}{}_{j-\ell+h}+{}_{i-\ell+h}{}_{j-k+h}\Big)." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mi>n</mi><mo>−</mo><mi>p</mi><mo>−</mo><mrow><mo stretchy="false">|</mo><mi>h</mi><mo stretchy="false">|</mo></mrow></mrow><msup><mi>n</mi><mn>2</mn></msup></mfrac></mstyle><mrow><mo lspace="0.170em" maxsize="1.600em" minsize="1.600em">(</mo><mmultiscripts><mo lspace="0em" rspace="0em">+</mo><mprescripts></mprescripts><mrow><mrow><mi>i</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mi>h</mi></mrow><mrow></mrow><mrow><mrow><mi>j</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>+</mo><mi>h</mi></mrow><mrow></mrow></mmultiscripts><mmultiscripts><mo maxsize="1.600em" minsize="1.600em">)</mo><mprescripts></mprescripts><mrow><mrow><mi>i</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>+</mo><mi>h</mi></mrow><mrow></mrow><mrow><mrow><mi>j</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mi>h</mi></mrow><mrow></mrow></mmultiscripts></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{h=-(n-p-1)}^{n-p-1}\frac{n-p-|h|}{n^{2}}\,\Big({}_{i-k+h}{}_{j-\ell+h}+{}_{i-\ell+h}{}_{j-k+h}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p5.6" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p5.6.1" class="ltx_text">Because <math id="A6.SS3.SSS0.Px1.p5.m15" class="ltx_Math" alttext="(n-p-|h|)/n^{2}=(1/n)\cdot(1-|h|/(n-p))\cdot\frac{n-p}{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>p</mi><mo>−</mo><mrow><mo stretchy="false">|</mo><mi>h</mi><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><msup><mi>n</mi><mn>2</mn></msup></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mo stretchy="false">|</mo><mi>h</mi><mo stretchy="false">|</mo></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mfrac><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mi>n</mi></mfrac></mrow></mrow><annotation encoding="application/x-tex">(n-p-|h|)/n^{2}=(1/n)\cdot(1-|h|/(n-p))\cdot\frac{n-p}{n}</annotation></semantics></math> and <math id="A6.SS3.SSS0.Px1.p5.m16" class="ltx_math_unparsed" alttext="\sum_{h}|{}_{h}|&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∑</mo><msub><mrow></mrow><mi>h</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mrow></mrow><mi>h</mi></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\sum_{h}|{}_{h}|&lt;\infty</annotation></semantics></math>,</span></p>
<table id="A6.Ex129" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex129.m1" class="ltx_math_unparsed" alttext="\frac{1}{n^{2}}\sum_{m,m^{\prime}}\mdmathbb{E}[abcd]={}_{j-i}\,{}_{\ell-k}+\frac{1}{n}\,c^{(S,0)}_{ij,k\ell}+o(1/n),\quad c^{(S,0)}_{ij,k\ell}:=\sum_{h\in\mdmathbb{Z}}\Big({}_{i-k+h}{}_{j-\ell+h}+{}_{i-\ell+h}{}_{j-k+h}\Big)." display="block" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><msup><mi>n</mi><mn>2</mn></msup></mfrac><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>,</mo><msup><mi>m</mi><mo>′</mo></msup></mrow></munder><mi>E</mi><mrow><mo stretchy="false">[</mo><mi>a</mi><mi>b</mi><mi>c</mi><mi>d</mi><mo stretchy="false">]</mo></mrow><mo rspace="0em">=</mo><mmultiscripts><mo lspace="0em">+</mo><mprescripts></mprescripts><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow><mrow></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>k</mi></mrow><mrow></mrow></mmultiscripts><mfrac><mn>1</mn><mi>n</mi></mfrac><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><mi>o</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>/</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo rspace="1.167em">,</mo><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.111em">:=</mo><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>h</mi><mo>∈</mo><mi>Z</mi></mrow></munder><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mmultiscripts><mo lspace="0em" rspace="0em">+</mo><mprescripts></mprescripts><mrow><mrow><mi>i</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mi>h</mi></mrow><mrow></mrow><mrow><mrow><mi>j</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>+</mo><mi>h</mi></mrow><mrow></mrow></mmultiscripts><mmultiscripts><mo maxsize="1.600em" minsize="1.600em">)</mo><mprescripts></mprescripts><mrow><mrow><mi>i</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>+</mo><mi>h</mi></mrow><mrow></mrow><mrow><mrow><mi>j</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mi>h</mi></mrow><mrow></mrow></mmultiscripts></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{1}{n^{2}}\sum_{m,m^{\prime}}\mdmathbb{E}[abcd]={}_{j-i}\,{}_{\ell-k}+\frac{1}{n}\,c^{(S,0)}_{ij,k\ell}+o(1/n),\quad c^{(S,0)}_{ij,k\ell}:=\sum_{h\in\mdmathbb{Z}}\Big({}_{i-k+h}{}_{j-\ell+h}+{}_{i-\ell+h}{}_{j-k+h}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p5.7" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p5.7.1" class="ltx_text">Multiplication by <math id="A6.SS3.SSS0.Px1.p5.m17" class="ltx_Math" alttext="(\Gamma_{p})_{st}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">(\Gamma_{p})_{st}</annotation></semantics></math> gives the leading block
<math id="A6.SS3.SSS0.Px1.p5.m18" class="ltx_math_unparsed" alttext="{}_{j-i}{}_{\ell-k}\,(\Gamma_{p})_{st}" display="inline" intent=":literal"><semantics><mmultiscripts><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow></mrow><mprescripts></mprescripts><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow><mrow></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>k</mi></mrow><mrow></mrow></mmultiscripts><annotation encoding="application/x-tex">{}_{j-i}{}_{\ell-k}\,(\Gamma_{p})_{st}</annotation></semantics></math>,
which matches <math id="A6.SS3.SSS0.Px1.p5.m19" class="ltx_Math" alttext="\big(\mathrm{vec}\,\Gamma_{p+1}\big)\big(\mathrm{vec}\,\Gamma_{p+1}\big)^{\top}\otimes\Gamma_{p}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>vec</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi mathvariant="normal">�</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>vec</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi mathvariant="normal">�</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.055em">)</mo></mrow><mo>⊤</mo></msup></mrow><mo rspace="0.222em">⊗</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub></mrow><annotation encoding="application/x-tex">\big(\mathrm{vec}\,\Gamma_{p+1}\big)\big(\mathrm{vec}\,\Gamma_{p+1}\big)^{\top}\otimes\Gamma_{p}</annotation></semantics></math> entrywise.</span></p>
</div>
<div id="A6.SS3.SSS0.Px1.p6" class="ltx_para">
<p id="A6.SS3.SSS0.Px1.p6.1" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p6.1.1" class="ltx_text">Each cross pairing contributes a product of three covariances with at most linear dependence on <math id="A6.SS3.SSS0.Px1.p6.m1" class="ltx_Math" alttext="m,m^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>,</mo><msup><mi>m</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">m,m^{\prime}</annotation></semantics></math>. For instance, the pairing <math id="A6.SS3.SSS0.Px1.p6.m2" class="ltx_Math" alttext="\{e,a\},\{f,b\},\{c,d\}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><mi>e</mi><mo>,</mo><mi>a</mi><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mo stretchy="false">{</mo><mi>f</mi><mo>,</mo><mi>b</mi><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mo stretchy="false">{</mo><mi>c</mi><mo>,</mo><mi>d</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\{e,a\},\{f,b\},\{c,d\}</annotation></semantics></math> yields</span></p>
<table id="A6.Ex130" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex130.m1" class="ltx_math_unparsed" alttext="{}_{(n-p+s)-(m+i-1)}\,{}_{(n-p+t)-(m+j-1)}\,{}_{(m^{\prime}+k-1)-(m^{\prime}+\ell-1)}={}_{s-i+k}\,{}_{t-j+k}\,{}_{\ell-k}," display="block" intent=":literal"><semantics><mrow><msub><mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>m</mi><mo>+</mo><mi>i</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><msub><mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>m</mi><mo>+</mo><mi>j</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><msub><mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>m</mi><mo>′</mo></msup><mo>+</mo><mi>k</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>m</mi><mo>′</mo></msup><mo>+</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0.448em" rspace="0em">=</mo><msub><mrow></mrow><mrow><mrow><mi>s</mi><mo>−</mo><mi>i</mi></mrow><mo>+</mo><mi>k</mi></mrow></msub><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>−</mo><mi>j</mi></mrow><mo>+</mo><mi>k</mi></mrow></msub><msub><mrow></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>k</mi></mrow></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">{}_{(n-p+s)-(m+i-1)}\,{}_{(n-p+t)-(m+j-1)}\,{}_{(m^{\prime}+k-1)-(m^{\prime}+\ell-1)}={}_{s-i+k}\,{}_{t-j+k}\,{}_{\ell-k},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p6.2" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p6.2.1" class="ltx_text">after setting <math id="A6.SS3.SSS0.Px1.p6.m3" class="ltx_Math" alttext="k=n-p-m+1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi><mo>−</mo><mi>m</mi></mrow><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">k=n-p-m+1</annotation></semantics></math>. Summing over <math id="A6.SS3.SSS0.Px1.p6.m4" class="ltx_Math" alttext="m,m^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>,</mo><msup><mi>m</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">m,m^{\prime}</annotation></semantics></math> produces <math id="A6.SS3.SSS0.Px1.p6.m5" class="ltx_math_unparsed" alttext="\frac{1}{n}\big(\sum_{k=1}^{n-p}{}_{s-i+k}{}_{t-j+k}\big){}_{\ell-k}" display="inline" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msubsup><mo lspace="0em" rspace="0em">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></msubsup><mmultiscripts><mo maxsize="1.200em" minsize="1.200em">)</mo><mprescripts></mprescripts><mrow><mrow><mi>s</mi><mo>−</mo><mi>i</mi></mrow><mo>+</mo><mi>k</mi></mrow><mrow></mrow><mrow><mrow><mi>t</mi><mo>−</mo><mi>j</mi></mrow><mo>+</mo><mi>k</mi></mrow><mrow></mrow></mmultiscripts></mrow><msub><mrow></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>k</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\frac{1}{n}\big(\sum_{k=1}^{n-p}{}_{s-i+k}{}_{t-j+k}\big){}_{\ell-k}</annotation></semantics></math>, which equals <math id="A6.SS3.SSS0.Px1.p6.m6" class="ltx_Math" alttext="\frac{1}{n}" display="inline" intent=":literal"><semantics><mfrac><mn>1</mn><mi>n</mi></mfrac><annotation encoding="application/x-tex">\frac{1}{n}</annotation></semantics></math> times a finite constant plus <math id="A6.SS3.SSS0.Px1.p6.m7" class="ltx_Math" alttext="o(1/n)" display="inline" intent=":literal"><semantics><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">o(1/n)</annotation></semantics></math> by absolute summability through Toeplitz summation (see <a href="#A6.Thmtheorem16" title="Lemma F.16 (Toeplitz-type summation). ‣ Auxiliary lemmas used in ‣ F.3 Order of the finite-sample gap ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">F.16</span></a>). Enumerating all <math id="A6.SS3.SSS0.Px1.p6.m8" class="ltx_Math" alttext="12" display="inline" intent=":literal"><semantics><mn>12</mn><annotation encoding="application/x-tex">12</annotation></semantics></math> cross pairings and collecting like terms gives the absolutely convergent series</span></p>
<table id="A6.Ex131" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A6.Ex131X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex131X.m2" class="ltx_Math" alttext="\displaystyle c^{(S,1)}_{ij,k\ell;st}" display="inline" intent=":literal"><semantics><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>;</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\displaystyle c^{(S,1)}_{ij,k\ell;st}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex131X.m3" class="ltx_Math" alttext="\displaystyle=\sum_{q=1}^{\infty}\Big[{}_{s-i+q}{}_{t-j+q}\,{}_{\ell-k}+{}_{s-i+q}{}_{t-k}\,{}_{j-\ell+q}+{}_{s-i+q}{}_{t-\ell}\,{}_{j-k+q}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>q</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi mathvariant="normal">∞</mi></msup><mo maxsize="1.600em" minsize="1.600em">[</mo><msub><mrow></mrow><mrow><mrow><mi>s</mi><mo>−</mo><mi>i</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>−</mo><mi>j</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><msub><mrow></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">+</mo><msub><mrow></mrow><mrow><mrow><mi>s</mi><mo>−</mo><mi>i</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub><msub><mrow></mrow><mrow><mrow><mi>j</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><mo lspace="0em">+</mo><msub><mrow></mrow><mrow><mrow><mi>s</mi><mo>−</mo><mi>i</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><msub><mrow></mrow><mrow><mrow><mi>j</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{q=1}^{\infty}\Big[{}_{s-i+q}{}_{t-j+q}\,{}_{\ell-k}+{}_{s-i+q}{}_{t-k}\,{}_{j-\ell+q}+{}_{s-i+q}{}_{t-\ell}\,{}_{j-k+q}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex131Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex131Xa.m2" class="ltx_Math" alttext="\displaystyle+{}_{s-j+q}{}_{t-i+q}\,{}_{\ell-k}+{}_{s-j+q}{}_{t-k}\,{}_{i-\ell+q}+{}_{s-j+q}{}_{t-\ell}\,{}_{i-k+q}\Big]" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">+</mo><msub><mrow></mrow><mrow><mrow><mi>s</mi><mo>−</mo><mi>j</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>−</mo><mi>i</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><msub><mrow></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">+</mo><msub><mrow></mrow><mrow><mrow><mi>s</mi><mo>−</mo><mi>j</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub><msub><mrow></mrow><mrow><mrow><mi>i</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">+</mo><msub><mrow></mrow><mrow><mrow><mi>s</mi><mo>−</mo><mi>j</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><msub><mrow></mrow><mrow><mrow><mi>i</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle+{}_{s-j+q}{}_{t-i+q}\,{}_{\ell-k}+{}_{s-j+q}{}_{t-k}\,{}_{i-\ell+q}+{}_{s-j+q}{}_{t-\ell}\,{}_{i-k+q}\Big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex131Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex131Xb.m2" class="ltx_Math" alttext="\displaystyle+\sum_{q=1}^{\infty}\Big[{}_{t-i+q}{}_{s-j+q}\,{}_{\ell-k}+{}_{t-i+q}{}_{s-k}\,{}_{j-\ell+q}+{}_{t-i+q}{}_{s-\ell}\,{}_{j-k+q}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>q</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi mathvariant="normal">∞</mi></msup><mo maxsize="1.600em" minsize="1.600em">[</mo><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>−</mo><mi>i</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><msub><mrow></mrow><mrow><mrow><mi>s</mi><mo>−</mo><mi>j</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><msub><mrow></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">+</mo><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>−</mo><mi>i</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><msub><mrow></mrow><mrow><mi>s</mi><mo>−</mo><mi>k</mi></mrow></msub><msub><mrow></mrow><mrow><mrow><mi>j</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><mo lspace="0em">+</mo><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>−</mo><mi>i</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><msub><mrow></mrow><mrow><mi>s</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><msub><mrow></mrow><mrow><mrow><mi>j</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{q=1}^{\infty}\Big[{}_{t-i+q}{}_{s-j+q}\,{}_{\ell-k}+{}_{t-i+q}{}_{s-k}\,{}_{j-\ell+q}+{}_{t-i+q}{}_{s-\ell}\,{}_{j-k+q}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex131Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex131Xc.m2" class="ltx_Math" alttext="\displaystyle+{}_{t-j+q}{}_{s-i+q}\,{}_{\ell-k}+{}_{t-j+q}{}_{s-k}\,{}_{i-\ell+q}+{}_{t-j+q}{}_{s-\ell}\,{}_{i-k+q}\Big]." display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">+</mo><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>−</mo><mi>j</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><msub><mrow></mrow><mrow><mrow><mi>s</mi><mo>−</mo><mi>i</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><msub><mrow></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">+</mo><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>−</mo><mi>j</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><msub><mrow></mrow><mrow><mi>s</mi><mo>−</mo><mi>k</mi></mrow></msub><msub><mrow></mrow><mrow><mrow><mi>i</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">+</mo><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>−</mo><mi>j</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><msub><mrow></mrow><mrow><mi>s</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><msub><mrow></mrow><mrow><mrow><mi>i</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><mo maxsize="1.600em" minsize="1.600em">]</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+{}_{t-j+q}{}_{s-i+q}\,{}_{\ell-k}+{}_{t-j+q}{}_{s-k}\,{}_{i-\ell+q}+{}_{t-j+q}{}_{s-\ell}\,{}_{i-k+q}\Big].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p6.3" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p6.3.1" class="ltx_text">Boundary corrections of order <math id="A6.SS3.SSS0.Px1.p6.m9" class="ltx_Math" alttext="1/n" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">1/n</annotation></semantics></math> proportional to <math id="A6.SS3.SSS0.Px1.p6.m10" class="ltx_math_unparsed" alttext="{}_{j-i}{}_{\ell-k}(\Gamma_{p})_{st}" display="inline" intent=":literal"><semantics><mmultiscripts><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow></mrow><mprescripts></mprescripts><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow><mrow></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>k</mi></mrow><mrow></mrow></mmultiscripts><annotation encoding="application/x-tex">{}_{j-i}{}_{\ell-k}(\Gamma_{p})_{st}</annotation></semantics></math> are absorbed into the final constant. Consequently,</span></p>
<table id="A6.Ex132" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex132.m1" class="ltx_math_unparsed" alttext="\mdmathbb{E}[G_{ij}G_{k\ell}\,x_{s}x_{t}]={}_{j-i}{}_{\ell-k}(\Gamma_{p})_{st}+\frac{1}{n}\Big(c^{(S,0)}_{ij,k\ell}(\Gamma_{p})_{st}+c^{(S,1)}_{ij,k\ell;st}\Big)+o(1/n)." display="block" intent=":literal"><semantics><mrow><mi>E</mi><mrow><mo stretchy="false">[</mo><msub><mi>G</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><msub><mi>G</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><msub><mi>x</mi><mi>s</mi></msub><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><mmultiscripts><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow></mrow><mprescripts></mprescripts><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow><mrow></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>k</mi></mrow><mrow></mrow></mmultiscripts><mo>+</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><msub><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo>+</mo><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>;</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo>+</mo><mi>o</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>/</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mdmathbb{E}[G_{ij}G_{k\ell}\,x_{s}x_{t}]={}_{j-i}{}_{\ell-k}(\Gamma_{p})_{st}+\frac{1}{n}\Big(c^{(S,0)}_{ij,k\ell}(\Gamma_{p})_{st}+c^{(S,1)}_{ij,k\ell;st}\Big)+o(1/n).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p6.4" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p6.4.1" class="ltx_text">Substituting into the tensor expansion of <math id="A6.SS3.SSS0.Px1.p6.m11" class="ltx_Math" alttext="S_{n}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>n</mi></msub><annotation encoding="application/x-tex">S_{n}</annotation></semantics></math> yields (<a href="#A6.E6" title="Equation 6 ‣ Lemma F.12 (First-order expansions of 𝑆̃_𝑛 and 𝑟̃_𝑛). ‣ Setup (recalled). ‣ F.3 Order of the finite-sample gap ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>) with</span></p>
<table id="A6.Ex133" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex133.m1" class="ltx_Math" alttext="C_{S}^{(\mathrm{vec})}=\sum_{i,j,k,\ell}\sum_{s,t}\Big(c^{(S,0)}_{ij,k\ell}(\Gamma_{p})_{st}+c^{(S,1)}_{ij,k\ell;st}\Big)\,\big((e_{j}\otimes e_{i}\otimes e_{s})\,(e_{\ell}\otimes e_{k}\otimes e_{t})^{\top}\big)." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>C</mi><mi>S</mi><mrow><mo stretchy="false">(</mo><mi>vec</mi><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></munder><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow></munder><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow><mo>+</mo><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>;</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>e</mi><mi>j</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>e</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>e</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>e</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>e</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>e</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">C_{S}^{(\mathrm{vec})}=\sum_{i,j,k,\ell}\sum_{s,t}\Big(c^{(S,0)}_{ij,k\ell}(\Gamma_{p})_{st}+c^{(S,1)}_{ij,k\ell;st}\Big)\,\big((e_{j}\otimes e_{i}\otimes e_{s})\,(e_{\ell}\otimes e_{k}\otimes e_{t})^{\top}\big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.SS3.SSS0.Px1.p7" class="ltx_para">
<p id="A6.SS3.SSS0.Px1.p7.1" class="ltx_p"><em id="A6.SS3.SSS0.Px1.p7.1.1" class="ltx_emph ltx_font_italic">Passing to <math id="A6.SS3.SSS0.Px1.p7.m1" class="ltx_Math" alttext="\mathrm{vech}" display="inline" intent=":literal"><semantics><mi>vech</mi><annotation encoding="application/x-tex">\mathrm{vech}</annotation></semantics></math>.</em><span id="A6.SS3.SSS0.Px1.p7.1.2" class="ltx_text"> Since <math id="A6.SS3.SSS0.Px1.p7.m2" class="ltx_Math" alttext="\mathrm{vech}(A)=L_{p+1}\mathrm{vec}(A)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>vech</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>L</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>vec</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{vech}(A)=L_{p+1}\mathrm{vec}(A)</annotation></semantics></math> for symmetric <math id="A6.SS3.SSS0.Px1.p7.m3" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>, it follows that</span></p>
<table id="A6.Ex134" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex134.m1" class="ltx_Math" alttext="\widetilde{S}_{n}=(L_{p+1}\otimes I_{p})\,S_{n}\,(L_{p+1}\otimes I_{p})^{\top},\qquad\widetilde{r}_{n}=(L_{p+1}\otimes I_{p})\,r_{n}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>n</mi></msub><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>I</mi><mi>p</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>S</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>I</mi><mi>p</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>n</mi></msub><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>I</mi><mi>p</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>r</mi><mi>n</mi></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\widetilde{S}_{n}=(L_{p+1}\otimes I_{p})\,S_{n}\,(L_{p+1}\otimes I_{p})^{\top},\qquad\widetilde{r}_{n}=(L_{p+1}\otimes I_{p})\,r_{n},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p7.2" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p7.2.1" class="ltx_text">which, together with (<a href="#A6.E6" title="Equation 6 ‣ Lemma F.12 (First-order expansions of 𝑆̃_𝑛 and 𝑟̃_𝑛). ‣ Setup (recalled). ‣ F.3 Order of the finite-sample gap ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>)–(<a href="#A6.E7" title="Equation 7 ‣ Lemma F.12 (First-order expansions of 𝑆̃_𝑛 and 𝑟̃_𝑛). ‣ Setup (recalled). ‣ F.3 Order of the finite-sample gap ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>), gives the stated expansions with
<math id="A6.SS3.SSS0.Px1.p7.m4" class="ltx_Math" alttext="S_{\infty}=(uu^{\top})\otimes\Gamma_{p}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi mathvariant="normal">∞</mi></msub><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mo>⊤</mo></msup></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊗</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub></mrow></mrow><annotation encoding="application/x-tex">S_{\infty}=(uu^{\top})\otimes\Gamma_{p}</annotation></semantics></math> and <math id="A6.SS3.SSS0.Px1.p7.m5" class="ltx_Math" alttext="r_{\infty}=u\otimes\Gamma_{p}" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi mathvariant="normal">∞</mi></msub><mo>=</mo><mrow><mi>u</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub></mrow></mrow><annotation encoding="application/x-tex">r_{\infty}=u\otimes\Gamma_{p}</annotation></semantics></math>, and with the indicated <math id="A6.SS3.SSS0.Px1.p7.m6" class="ltx_Math" alttext="C_{S},C_{r}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>S</mi></msub><mo>,</mo><msub><mi>C</mi><mi>r</mi></msub></mrow><annotation encoding="application/x-tex">C_{S},C_{r}</annotation></semantics></math>.
Finally, for any orthonormal <math id="A6.SS3.SSS0.Px1.p7.m7" class="ltx_Math" alttext="Q=[u/\|u\|,Q_{\perp}]" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>u</mi><mo>/</mo><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow></mrow><mo>,</mo><msub><mi>Q</mi><mo>⟂</mo></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">Q=[u/\|u\|,Q_{\perp}]</annotation></semantics></math> and <math id="A6.SS3.SSS0.Px1.p7.m8" class="ltx_Math" alttext="P=Q\otimes I_{p}" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>=</mo><mrow><mi>Q</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>I</mi><mi>p</mi></msub></mrow></mrow><annotation encoding="application/x-tex">P=Q\otimes I_{p}</annotation></semantics></math>, the block forms for <math id="A6.SS3.SSS0.Px1.p7.m9" class="ltx_Math" alttext="\widehat{S}_{n}=P^{\top}\widetilde{S}_{n}P" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi>n</mi></msub><mo>=</mo><mrow><msup><mi>P</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>P</mi></mrow></mrow><annotation encoding="application/x-tex">\widehat{S}_{n}=P^{\top}\widetilde{S}_{n}P</annotation></semantics></math> and <math id="A6.SS3.SSS0.Px1.p7.m10" class="ltx_Math" alttext="\widehat{r}_{n}=P^{\top}\widetilde{r}_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>n</mi></msub><mo>=</mo><mrow><msup><mi>P</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>n</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\widehat{r}_{n}=P^{\top}\widetilde{r}_{n}</annotation></semantics></math> follow by inserting the expansions and collecting the top/orthogonal components; the leading block equals <math id="A6.SS3.SSS0.Px1.p7.m11" class="ltx_Math" alttext="\mathrm{diag}(c\,\Gamma_{p},0)" display="inline" intent=":literal"><semantics><mrow><mi>diag</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub></mrow><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{diag}(c\,\Gamma_{p},0)</annotation></semantics></math> and the <math id="A6.SS3.SSS0.Px1.p7.m12" class="ltx_Math" alttext="1/n" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">1/n</annotation></semantics></math> blocks are those of <math id="A6.SS3.SSS0.Px1.p7.m13" class="ltx_Math" alttext="P^{\top}C_{S}P" display="inline" intent=":literal"><semantics><mrow><msup><mi>P</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">P^{\top}C_{S}P</annotation></semantics></math> and <math id="A6.SS3.SSS0.Px1.p7.m14" class="ltx_Math" alttext="P^{\top}C_{r}" display="inline" intent=":literal"><semantics><mrow><msup><mi>P</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>r</mi></msub></mrow><annotation encoding="application/x-tex">P^{\top}C_{r}</annotation></semantics></math>. Dominated convergence (using <math id="A6.SS3.SSS0.Px1.p7.m15" class="ltx_math_unparsed" alttext="|{}_{h}|\leq C\beta^{|h|}" display="inline" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mrow></mrow><mi>h</mi></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">≤</mo><mi>C</mi><mi mathvariant="normal">�</mi><msup><mrow></mrow><mrow><mo stretchy="false">|</mo><mi>h</mi><mo stretchy="false">|</mo></mrow></msup></mrow><annotation encoding="application/x-tex">|{}_{h}|\leq C\beta^{|h|}</annotation></semantics></math>) justifies all <math id="A6.SS3.SSS0.Px1.p7.m16" class="ltx_Math" alttext="o(1/n)" display="inline" intent=":literal"><semantics><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">o(1/n)</annotation></semantics></math> remainde∎</span></p>
</div>
</div>
<div id="A6.Thmtheorem13" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A6.Thmtheorem13.2" class="ltx_text ltx_font_bold">Lemma F.13</span></span><span id="A6.Thmtheorem13.3" class="ltx_text ltx_font_bold"> </span>(Singular block inverse and first-order Schur complement)<span id="A6.Thmtheorem13.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A6.Thmtheorem13.p1" class="ltx_para">
<p id="A6.Thmtheorem13.p1.1" class="ltx_p"><span id="A6.Thmtheorem13.p1.1.1" class="ltx_text ltx_font_italic">In the basis of Lemma <a href="#A6.Thmtheorem12" title="Lemma F.12 (First-order expansions of 𝑆̃_𝑛 and 𝑟̃_𝑛). ‣ Setup (recalled). ‣ F.3 Order of the finite-sample gap ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.12</span></a>, let</span></p>
<table id="A6.Ex135" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex135.m1" class="ltx_Math" alttext="\widehat{S}_{n}=\begin{bmatrix}A_{0}&amp;0\\
0&amp;0\end{bmatrix}+\frac{1}{n}\begin{bmatrix}A_{1}&amp;B^{\top}\\
B&amp;C\end{bmatrix}+o(1/n),\quad\widehat{r}_{n}=\begin{bmatrix}r_{0}\\
0\end{bmatrix}+\frac{1}{n}\begin{bmatrix}\delta\\
d\end{bmatrix}+o(1/n)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi>n</mi></msub><mo>=</mo><mrow><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mi>A</mi><mn>0</mn></msub></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo>]</mo></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mi>A</mi><mn>1</mn></msub></mtd><mtd><msup><mi>B</mi><mo>⊤</mo></msup></mtd></mtr><mtr><mtd><mi>B</mi></mtd><mtd><mi>C</mi></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>n</mi></msub><mo>=</mo><mrow><mrow><mo>[</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mi>r</mi><mn>0</mn></msub></mtd></mtr><mtr><mtd><mn>0</mn></mtd></mtr></mtable><mo>]</mo></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><mi mathvariant="normal">�</mi></mtd></mtr><mtr><mtd><mi>d</mi></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\widehat{S}_{n}=\begin{bmatrix}A_{0}&amp;0\\
0&amp;0\end{bmatrix}+\frac{1}{n}\begin{bmatrix}A_{1}&amp;B^{\top}\\
B&amp;C\end{bmatrix}+o(1/n),\quad\widehat{r}_{n}=\begin{bmatrix}r_{0}\\
0\end{bmatrix}+\frac{1}{n}\begin{bmatrix}\delta\\
d\end{bmatrix}+o(1/n),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmtheorem13.p1.2" class="ltx_p"><span id="A6.Thmtheorem13.p1.2.1" class="ltx_text ltx_font_italic">with <math id="A6.Thmtheorem13.p1.m1" class="ltx_Math" alttext="A_{0}=c\,\Gamma_{p}\succ 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mn>0</mn></msub><mo>=</mo><mrow><mi>c</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub></mrow><mo>≻</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">A_{0}=c\,\Gamma_{p}\succ 0</annotation></semantics></math> and <math id="A6.Thmtheorem13.p1.m2" class="ltx_Math" alttext="r_{0}=\|u\|\Gamma_{p}" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mn>0</mn></msub><mo>=</mo><mrow><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub></mrow></mrow><annotation encoding="application/x-tex">r_{0}=\|u\|\Gamma_{p}</annotation></semantics></math>.
Then, for all large <math id="A6.Thmtheorem13.p1.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>,</span></p>
<table id="A6.Ex136" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex136.m1" class="ltx_Math" alttext="\widehat{r}_{n}^{\top}\widehat{S}_{n}^{-1}\widehat{r}_{n}=\Gamma_{p}+\frac{1}{n}\Big[-\tfrac{1}{c}A_{1}+\tfrac{1}{c}B^{\top}C^{-1}B-\tfrac{2}{\|u\|}B^{\top}C^{-1}d+d^{\top}C^{-1}d+\tfrac{2}{\|u\|}\,\mathrm{Sym}(\delta)\Big]+o(1/n)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>n</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>n</mi></msub></mrow><mo>=</mo><mrow><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo>+</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mi>c</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mn>1</mn></msub></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mi>c</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="false"><mfrac><mn>2</mn><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo>+</mo><mrow><msup><mi>d</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mrow><mstyle displaystyle="false"><mfrac><mn>2</mn><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><mi>Sym</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">�</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\widehat{r}_{n}^{\top}\widehat{S}_{n}^{-1}\widehat{r}_{n}=\Gamma_{p}+\frac{1}{n}\Big[-\tfrac{1}{c}A_{1}+\tfrac{1}{c}B^{\top}C^{-1}B-\tfrac{2}{\|u\|}B^{\top}C^{-1}d+d^{\top}C^{-1}d+\tfrac{2}{\|u\|}\,\mathrm{Sym}(\delta)\Big]+o(1/n),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmtheorem13.p1.3" class="ltx_p"><span id="A6.Thmtheorem13.p1.3.1" class="ltx_text ltx_font_italic">where <math id="A6.Thmtheorem13.p1.m4" class="ltx_Math" alttext="\mathrm{Sym}(M)=\tfrac{1}{2}(M+M^{\top})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Sym</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo>+</mo><msup><mi>M</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Sym}(M)=\tfrac{1}{2}(M+M^{\top})</annotation></semantics></math>.
Equivalently, in the original coordinates,</span></p>
<table id="A6.EGx11" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex137"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex137.m1" class="ltx_Math" alttext="\displaystyle\widetilde{r}_{n}^{\top}\widetilde{S}_{n}^{-1}\widetilde{r}_{n}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>n</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\widetilde{r}_{n}^{\top}\widetilde{S}_{n}^{-1}\widetilde{r}_{n}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex137.m2" class="ltx_Math" alttext="\displaystyle=\Gamma_{p}+\frac{1}{n}\,\mathsf{B}_{p}+o(1/n)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>𝖡</mi><mi>p</mi></msub></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\Gamma_{p}+\frac{1}{n}\,\mathsf{B}_{p}+o(1/n),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.E9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.E9.m1" class="ltx_Math" alttext="\displaystyle\mathsf{B}_{p}:" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝖡</mi><mi>p</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathsf{B}_{p}:</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E9.m2" class="ltx_Math" alttext="\displaystyle=-\tfrac{1}{c}A_{1}+\tfrac{1}{c}B^{\top}C^{-1}B-\tfrac{2}{\|u\|}B^{\top}C^{-1}d+d^{\top}C^{-1}d+\tfrac{2}{\|u\|}\,\mathrm{Sym}(\delta)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mi>c</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mn>1</mn></msub></mrow></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mi>c</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow><mo>−</mo><mrow><mfrac><mn>2</mn><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo>+</mo><mrow><msup><mi>d</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mrow><mfrac><mn>2</mn><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mi>Sym</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">�</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=-\tfrac{1}{c}A_{1}+\tfrac{1}{c}B^{\top}C^{-1}B-\tfrac{2}{\|u\|}B^{\top}C^{-1}d+d^{\top}C^{-1}d+\tfrac{2}{\|u\|}\,\mathrm{Sym}(\delta).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A6.SS3.SSS0.Px1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A6.SS3.SSS0.Px1.p8" class="ltx_para">
<p id="A6.SS3.SSS0.Px1.p8.1" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p8.1.1" class="ltx_text">Write the block decomposition of <math id="A6.SS3.SSS0.Px1.p8.m1" class="ltx_Math" alttext="\widehat{S}_{n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi>n</mi></msub><annotation encoding="application/x-tex">\widehat{S}_{n}</annotation></semantics></math> from Lemma <a href="#A6.Thmtheorem12" title="Lemma F.12 (First-order expansions of 𝑆̃_𝑛 and 𝑟̃_𝑛). ‣ Setup (recalled). ‣ F.3 Order of the finite-sample gap ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.12</span></a> as</span></p>
<table id="A6.Ex138" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex138.m1" class="ltx_Math" alttext="\widetilde{S}_{n}=\begin{bmatrix}A&amp;E^{\top}\\
E&amp;D\end{bmatrix},\qquad A=A_{0}+\tfrac{1}{n}A_{1}+o(1/n),\quad E=\tfrac{1}{n}B+o(1/n),\quad D=\tfrac{1}{n}C+o(1/n)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>n</mi></msub><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mi>A</mi></mtd><mtd><msup><mi>E</mi><mo>⊤</mo></msup></mtd></mtr><mtr><mtd><mi>E</mi></mtd><mtd><mi>D</mi></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>A</mi><mo>=</mo><mrow><msub><mi>A</mi><mn>0</mn></msub><mo>+</mo><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>E</mi><mo>=</mo><mrow><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>D</mi><mo>=</mo><mrow><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\widetilde{S}_{n}=\begin{bmatrix}A&amp;E^{\top}\\
E&amp;D\end{bmatrix},\qquad A=A_{0}+\tfrac{1}{n}A_{1}+o(1/n),\quad E=\tfrac{1}{n}B+o(1/n),\quad D=\tfrac{1}{n}C+o(1/n),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p8.2" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p8.2.1" class="ltx_text">with <math id="A6.SS3.SSS0.Px1.p8.m2" class="ltx_Math" alttext="A_{0}=c\,\Gamma_{p}\succ 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mn>0</mn></msub><mo>=</mo><mrow><mi>c</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub></mrow><mo>≻</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">A_{0}=c\,\Gamma_{p}\succ 0</annotation></semantics></math>.
For large <math id="A6.SS3.SSS0.Px1.p8.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>, <math id="A6.SS3.SSS0.Px1.p8.m4" class="ltx_Math" alttext="D\succ 0" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>≻</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">D\succ 0</annotation></semantics></math>, and the block inverse formula gives</span></p>
<table id="A6.Ex139" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex139.m1" class="ltx_Math" alttext="\widetilde{S}_{n}^{-1}=\begin{bmatrix}A^{-1}+A^{-1}E(D-E^{\top}A^{-1}E)^{-1}E^{\top}A^{-1}&amp;-\,A^{-1}E(D-E^{\top}A^{-1}E)^{-1}\\[3.99994pt]
-(D-E^{\top}A^{-1}E)^{-1}E^{\top}A^{-1}&amp;(D-E^{\top}A^{-1}E)^{-1}\end{bmatrix}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><msup><mi>A</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>+</mo><mrow><msup><mi>A</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>D</mi><mo>−</mo><mrow><msup><mi>E</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>E</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mtd><mtd><mrow><mo>−</mo><mrow><msup><mi>A</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>D</mi><mo>−</mo><mrow><msup><mi>E</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mo>−</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>D</mi><mo>−</mo><mrow><msup><mi>E</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>E</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mtd><mtd><msup><mrow><mo stretchy="false">(</mo><mrow><mi>D</mi><mo>−</mo><mrow><msup><mi>E</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widetilde{S}_{n}^{-1}=\begin{bmatrix}A^{-1}+A^{-1}E(D-E^{\top}A^{-1}E)^{-1}E^{\top}A^{-1}&amp;-\,A^{-1}E(D-E^{\top}A^{-1}E)^{-1}\\[3.99994pt]
-(D-E^{\top}A^{-1}E)^{-1}E^{\top}A^{-1}&amp;(D-E^{\top}A^{-1}E)^{-1}\end{bmatrix}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p8.3" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p8.3.1" class="ltx_text">Since <math id="A6.SS3.SSS0.Px1.p8.m5" class="ltx_Math" alttext="A^{-1}=A_{0}^{-1}-\tfrac{1}{n}A_{0}^{-1}A_{1}A_{0}^{-1}+o(1/n)" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>=</mo><mrow><mrow><msubsup><mi>A</mi><mn>0</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>−</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mn>0</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mn>0</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">A^{-1}=A_{0}^{-1}-\tfrac{1}{n}A_{0}^{-1}A_{1}A_{0}^{-1}+o(1/n)</annotation></semantics></math> and
<math id="A6.SS3.SSS0.Px1.p8.m6" class="ltx_Math" alttext="E^{\top}A^{-1}E=\tfrac{1}{n^{2}}B^{\top}A_{0}^{-1}B+o(1/n^{2})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>E</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><msup><mi>n</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mn>0</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><msup><mi>n</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">E^{\top}A^{-1}E=\tfrac{1}{n^{2}}B^{\top}A_{0}^{-1}B+o(1/n^{2})</annotation></semantics></math>,</span></p>
<table id="A6.Ex140" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex140.m1" class="ltx_Math" alttext="D-E^{\top}A^{-1}E=\tfrac{1}{n}C+o(1/n),\qquad(D-E^{\top}A^{-1}E)^{-1}=n\,C^{-1}+o(n)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>D</mi><mo>−</mo><mrow><msup><mi>E</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>D</mi><mo>−</mo><mrow><msup><mi>E</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>=</mo><mrow><mrow><mi>n</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">D-E^{\top}A^{-1}E=\tfrac{1}{n}C+o(1/n),\qquad(D-E^{\top}A^{-1}E)^{-1}=n\,C^{-1}+o(n).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p8.4" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p8.4.1" class="ltx_text">Substituting and collecting orders yields</span></p>
<table id="A6.EGx12" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex141"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex141.m1" class="ltx_Math" alttext="\displaystyle(\widetilde{S}_{n}^{-1})_{11}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow><mn>11</mn></msub><annotation encoding="application/x-tex">\displaystyle(\widetilde{S}_{n}^{-1})_{11}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex141.m2" class="ltx_Math" alttext="\displaystyle=A_{0}^{-1}-\tfrac{1}{n}A_{0}^{-1}A_{1}A_{0}^{-1}+\tfrac{1}{n}A_{0}^{-1}B^{\top}C^{-1}B\,A_{0}^{-1}+o(1/n)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msubsup><mi>A</mi><mn>0</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>−</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mn>0</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mn>0</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mn>0</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>A</mi><mn>0</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=A_{0}^{-1}-\tfrac{1}{n}A_{0}^{-1}A_{1}A_{0}^{-1}+\tfrac{1}{n}A_{0}^{-1}B^{\top}C^{-1}B\,A_{0}^{-1}+o(1/n),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex142"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex142.m1" class="ltx_Math" alttext="\displaystyle(\widetilde{S}_{n}^{-1})_{12}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow><mn>12</mn></msub><annotation encoding="application/x-tex">\displaystyle(\widetilde{S}_{n}^{-1})_{12}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex142.m2" class="ltx_Math" alttext="\displaystyle=-A_{0}^{-1}B^{\top}C^{-1}+o(1)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>−</mo><mrow><msubsup><mi>A</mi><mn>0</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=-A_{0}^{-1}B^{\top}C^{-1}+o(1),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex143"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex143.m1" class="ltx_Math" alttext="\displaystyle(\widetilde{S}_{n}^{-1})_{22}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow><mn>22</mn></msub><annotation encoding="application/x-tex">\displaystyle(\widetilde{S}_{n}^{-1})_{22}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex143.m2" class="ltx_Math" alttext="\displaystyle=n\,C^{-1}+o(n)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>n</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=n\,C^{-1}+o(n).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.SS3.SSS0.Px1.p9" class="ltx_para">
<p id="A6.SS3.SSS0.Px1.p9.1" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p9.1.1" class="ltx_text">Now expand <math id="A6.SS3.SSS0.Px1.p9.m1" class="ltx_Math" alttext="\widehat{r}_{n}=[\,r_{0};0\,]+\tfrac{1}{n}[\,\delta;d\,]+o(1/n)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>n</mi></msub><mo>=</mo><mrow><mrow><mo rspace="0.170em" stretchy="false">[</mo><mrow><msub><mi>r</mi><mn>0</mn></msub><mo>;</mo><mn>0</mn></mrow><mo lspace="0.170em" stretchy="false">]</mo></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0.170em" stretchy="false">[</mo><mrow><mi mathvariant="normal">�</mi><mo>;</mo><mi>d</mi></mrow><mo lspace="0.170em" stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\widehat{r}_{n}=[\,r_{0};0\,]+\tfrac{1}{n}[\,\delta;d\,]+o(1/n)</annotation></semantics></math> with <math id="A6.SS3.SSS0.Px1.p9.m2" class="ltx_Math" alttext="r_{0}=\|u\|\,\Gamma_{p}" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mn>0</mn></msub><mo>=</mo><mrow><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub></mrow></mrow><annotation encoding="application/x-tex">r_{0}=\|u\|\,\Gamma_{p}</annotation></semantics></math> and <math id="A6.SS3.SSS0.Px1.p9.m3" class="ltx_Math" alttext="A_{0}^{-1}=(1/c)\Gamma_{p}^{-1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>A</mi><mn>0</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">�</mi><mi>p</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">A_{0}^{-1}=(1/c)\Gamma_{p}^{-1}</annotation></semantics></math>. Then</span></p>
<table id="A6.EGx13" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex144"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex144.m1" class="ltx_Math" alttext="\displaystyle\widehat{r}_{n}^{\top}\widetilde{S}_{n}^{-1}\widehat{r}_{n}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>n</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\widehat{r}_{n}^{\top}\widetilde{S}_{n}^{-1}\widehat{r}_{n}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex144.m2" class="ltx_Math" alttext="\displaystyle=r_{0}^{\top}(\widetilde{S}_{n}^{-1})_{11}r_{0}+2\,r_{0}^{\top}(\widetilde{S}_{n}^{-1})_{12}\tfrac{1}{n}d+\tfrac{1}{n^{2}}d^{\top}(\widetilde{S}_{n}^{-1})_{22}d+\tfrac{2}{n}\,\mathrm{Sym}(\delta^{\top}A_{0}^{-1}r_{0})+o(1/n)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msubsup><mi>r</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>r</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow><mn>12</mn></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><msup><mi>n</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow><mn>22</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mrow><mfrac><mn>2</mn><mi>n</mi></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mi>Sym</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mn>0</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=r_{0}^{\top}(\widetilde{S}_{n}^{-1})_{11}r_{0}+2\,r_{0}^{\top}(\widetilde{S}_{n}^{-1})_{12}\tfrac{1}{n}d+\tfrac{1}{n^{2}}d^{\top}(\widetilde{S}_{n}^{-1})_{22}d+\tfrac{2}{n}\,\mathrm{Sym}(\delta^{\top}A_{0}^{-1}r_{0})+o(1/n).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p9.2" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p9.2.1" class="ltx_text">Each term is explicit:</span></p>
<table id="A6.Ex145" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex145.m1" class="ltx_Math" alttext="r_{0}^{\top}A_{0}^{-1}r_{0}=\Gamma_{p},\quad r_{0}^{\top}A_{0}^{-1}A_{1}A_{0}^{-1}r_{0}=\tfrac{1}{c}A_{1},\quad r_{0}^{\top}A_{0}^{-1}B^{\top}C^{-1}BA_{0}^{-1}r_{0}=\tfrac{1}{c}B^{\top}C^{-1}B," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi>r</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mn>0</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>0</mn></msub></mrow><mo>=</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub></mrow><mo rspace="1.167em">,</mo><mrow><mrow><msubsup><mi>r</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mn>0</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mn>0</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>0</mn></msub></mrow><mo>=</mo><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mi>c</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mn>1</mn></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><msubsup><mi>r</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mn>0</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mn>0</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>0</mn></msub></mrow><mo>=</mo><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mi>c</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">r_{0}^{\top}A_{0}^{-1}r_{0}=\Gamma_{p},\quad r_{0}^{\top}A_{0}^{-1}A_{1}A_{0}^{-1}r_{0}=\tfrac{1}{c}A_{1},\quad r_{0}^{\top}A_{0}^{-1}B^{\top}C^{-1}BA_{0}^{-1}r_{0}=\tfrac{1}{c}B^{\top}C^{-1}B,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A6.Ex146" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex146.m1" class="ltx_math_unparsed" alttext="2\,r_{0}^{\top}(\widetilde{S}_{n}^{-1})_{12}\tfrac{1}{n}d=-\tfrac{2}{n}\cdot\tfrac{1}{\|u\|}\,B^{\top}C^{-1}d,\quad\tfrac{1}{n^{2}}d^{\top}(\widetilde{S}_{n}^{-1})_{22}d=\tfrac{1}{n}d^{\top}C^{-1}d+o(1/n)," display="block" intent=":literal"><semantics><mrow><mn>2</mn><msubsup><mi>r</mi><mn>0</mn><mo>⊤</mo></msubsup><msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow><mn>12</mn></msub><mstyle displaystyle="false"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mi>d</mi><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mstyle displaystyle="false"><mfrac><mn>2</mn><mi>n</mi></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="false"><mfrac><mn>1</mn><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow></mfrac></mstyle><msup><mi>B</mi><mo>⊤</mo></msup><msup><mi>C</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mi>d</mi><mo rspace="1.167em">,</mo><mstyle displaystyle="false"><mfrac><mn>1</mn><msup><mi>n</mi><mn>2</mn></msup></mfrac></mstyle><msup><mi>d</mi><mo>⊤</mo></msup><msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow><mn>22</mn></msub><mi>d</mi><mo>=</mo><mstyle displaystyle="false"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><msup><mi>d</mi><mo>⊤</mo></msup><msup><mi>C</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mi>d</mi><mo>+</mo><mi>o</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>/</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">2\,r_{0}^{\top}(\widetilde{S}_{n}^{-1})_{12}\tfrac{1}{n}d=-\tfrac{2}{n}\cdot\tfrac{1}{\|u\|}\,B^{\top}C^{-1}d,\quad\tfrac{1}{n^{2}}d^{\top}(\widetilde{S}_{n}^{-1})_{22}d=\tfrac{1}{n}d^{\top}C^{-1}d+o(1/n),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A6.Ex147" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex147.m1" class="ltx_Math" alttext="\tfrac{2}{n}\,\mathrm{Sym}(\delta^{\top}A_{0}^{-1}r_{0})=\tfrac{2}{n}\cdot\tfrac{1}{\|u\|}\,\mathrm{Sym}(\delta)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="false"><mfrac><mn>2</mn><mi>n</mi></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><mi>Sym</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mn>0</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="false"><mfrac><mn>2</mn><mi>n</mi></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="false"><mfrac><mn>1</mn><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow></mfrac></mstyle></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>Sym</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">�</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tfrac{2}{n}\,\mathrm{Sym}(\delta^{\top}A_{0}^{-1}r_{0})=\tfrac{2}{n}\cdot\tfrac{1}{\|u\|}\,\mathrm{Sym}(\delta).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p9.3" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p9.3.1" class="ltx_text">Combining yields</span></p>
<table id="A6.Ex148" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex148.m1" class="ltx_Math" alttext="\widehat{r}_{n}^{\top}\widetilde{S}_{n}^{-1}\widehat{r}_{n}=\Gamma_{p}+\frac{1}{n}\Big[-\tfrac{1}{c}A_{1}+\tfrac{1}{c}B^{\top}C^{-1}B-\tfrac{2}{\|u\|}B^{\top}C^{-1}d+d^{\top}C^{-1}d+\tfrac{2}{\|u\|}\,\mathrm{Sym}(\delta)\Big]+o(1/n)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>n</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>n</mi></msub></mrow><mo>=</mo><mrow><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo>+</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mi>c</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mn>1</mn></msub></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mi>c</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="false"><mfrac><mn>2</mn><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo>+</mo><mrow><msup><mi>d</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mrow><mstyle displaystyle="false"><mfrac><mn>2</mn><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><mi>Sym</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">�</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{r}_{n}^{\top}\widetilde{S}_{n}^{-1}\widehat{r}_{n}=\Gamma_{p}+\frac{1}{n}\Big[-\tfrac{1}{c}A_{1}+\tfrac{1}{c}B^{\top}C^{-1}B-\tfrac{2}{\|u\|}B^{\top}C^{-1}d+d^{\top}C^{-1}d+\tfrac{2}{\|u\|}\,\mathrm{Sym}(\delta)\Big]+o(1/n).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p9.4" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p9.4.1" class="ltx_text">Since the orthogonal basis change preserves the Schur complement, the same expansion holds in the original coordinates, giving (<a href="#A6.Ex137" title="In Lemma F.13 (Singular block inverse and first-order Schur complement). ‣ Setup (recalled). ‣ F.3 Order of the finite-sample gap ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>).
∎</span></p>
</div>
</div>
<div id="A6.Thmtheorem14" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A6.Thmtheorem14.2" class="ltx_text ltx_font_bold">Theorem F.14</span></span><span id="A6.Thmtheorem14.3" class="ltx_text ltx_font_bold"> </span>(First-order gap)<span id="A6.Thmtheorem14.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A6.Thmtheorem14.p1" class="ltx_para">
<p id="A6.Thmtheorem14.p1.1" class="ltx_p"><span id="A6.Thmtheorem14.p1.1.1" class="ltx_text ltx_font_italic">With <math id="A6.Thmtheorem14.p1.m1" class="ltx_Math" alttext="\Delta_{n}:=\Gamma_{p}-\widetilde{r}_{n}^{\top}\widetilde{S}_{n}^{-1}\widetilde{r}_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">�</mi><mi>n</mi></msub><mo>:=</mo><mrow><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo>−</mo><mrow><msubsup><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>n</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>n</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta_{n}:=\Gamma_{p}-\widetilde{r}_{n}^{\top}\widetilde{S}_{n}^{-1}\widetilde{r}_{n}</annotation></semantics></math>,</span></p>
<table id="A6.Ex149" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex149.m1" class="ltx_Math" alttext="\Delta_{n}=\frac{1}{n}\,B_{p}+o(1/n),\qquad B_{p}:=\frac{1}{c}A_{1}-\frac{1}{c}B^{\top}C^{-1}B+\frac{2}{\|u\|}\,\mathrm{Sym}\big(B^{\top}C^{-1}d-\delta\big)-\,d^{\top}C^{-1}d." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi mathvariant="normal">�</mi><mi>n</mi></msub><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>B</mi><mi>p</mi></msub></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>B</mi><mi>p</mi></msub><mo>:=</mo><mrow><mrow><mrow><mrow><mfrac><mn>1</mn><mi>c</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mn>1</mn></msub></mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mi>c</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow><mo>+</mo><mrow><mfrac><mn>2</mn><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mi>Sym</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msup><mi>B</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>−</mo><mi mathvariant="normal">�</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo rspace="0.392em">−</mo><mrow><msup><mi>d</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Delta_{n}=\frac{1}{n}\,B_{p}+o(1/n),\qquad B_{p}:=\frac{1}{c}A_{1}-\frac{1}{c}B^{\top}C^{-1}B+\frac{2}{\|u\|}\,\mathrm{Sym}\big(B^{\top}C^{-1}d-\delta\big)-\,d^{\top}C^{-1}d.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmtheorem14.p1.2" class="ltx_p"><span id="A6.Thmtheorem14.p1.2.1" class="ltx_text ltx_font_italic">Hence the optimal one-layer LSA excess risk satisfies</span></p>
<table id="A6.Ex150" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex150.m1" class="ltx_Math" alttext="\min_{b,A}\ \mdmathbb E\big[(\widehat{x}_{n+1}(b,A)-x_{n+1})^{2}\big]\geq\sigma_{\varepsilon}^{2}+\rho^{\top}\Delta_{n}\rho=\sigma_{\varepsilon}^{2}+\frac{1}{n}\,\rho^{\top}B_{p}\rho+o(1/n)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mi>min</mi><mrow><mi>b</mi><mo>,</mo><mi>A</mi></mrow></munder><mo lspace="0.667em">⁡</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo>≥</mo><mrow><msubsup><mi mathvariant="normal">�</mi><mi mathvariant="normal">"</mi><mn>2</mn></msubsup><mo>+</mo><mrow><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">�</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">�</mi></mrow></mrow><mo>=</mo><mrow><msubsup><mi mathvariant="normal">�</mi><mi mathvariant="normal">"</mi><mn>2</mn></msubsup><mo>+</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">�</mi></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\min_{b,A}\ \mdmathbb E\big[(\widehat{x}_{n+1}(b,A)-x_{n+1})^{2}\big]\geq\sigma_{\varepsilon}^{2}+\rho^{\top}\Delta_{n}\rho=\sigma_{\varepsilon}^{2}+\frac{1}{n}\,\rho^{\top}B_{p}\rho+o(1/n).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmtheorem14.p1.3" class="ltx_p"><span id="A6.Thmtheorem14.p1.3.1" class="ltx_text ltx_font_italic">Moreover, <math id="A6.Thmtheorem14.p1.m2" class="ltx_Math" alttext="B_{p}\succeq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>p</mi></msub><mo>⪰</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">B_{p}\succeq 0</annotation></semantics></math>; if <math id="A6.Thmtheorem14.p1.m3" class="ltx_Math" alttext="B_{p}\succ 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>p</mi></msub><mo>≻</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">B_{p}\succ 0</annotation></semantics></math> (a generic nondegeneracy), then for any <math id="A6.Thmtheorem14.p1.m4" class="ltx_Math" alttext="r&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">r&gt;0</annotation></semantics></math> there exist <math id="A6.Thmtheorem14.p1.m5" class="ltx_Math" alttext="n_{0}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mn>0</mn></msub><annotation encoding="application/x-tex">n_{0}</annotation></semantics></math> and <math id="A6.Thmtheorem14.p1.m6" class="ltx_Math" alttext="c_{r}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>r</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c_{r}&gt;0</annotation></semantics></math> such that for all <math id="A6.Thmtheorem14.p1.m7" class="ltx_Math" alttext="n\geq n_{0}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><msub><mi>n</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">n\geq n_{0}</annotation></semantics></math> and all <math id="A6.Thmtheorem14.p1.m8" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi mathvariant="normal">�</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> with <math id="A6.Thmtheorem14.p1.m9" class="ltx_Math" alttext="\|\rho\|\geq r" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mi mathvariant="normal">�</mi><mo stretchy="false">‖</mo></mrow><mo>≥</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">\|\rho\|\geq r</annotation></semantics></math>,</span></p>
<table id="A6.Ex151" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex151.m1" class="ltx_Math" alttext="\mdmathbb E\big[(\widehat{x}_{n+1}^{\mathrm{LSA}}-x_{n+1})^{2}\big]\;\geq\;\mdmathbb E\big[(\widehat{x}_{n+1}^{\mathrm{LR}}-x_{n+1})^{2}\big]\;+\;\frac{c_{r}}{n}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mi>LSA</mi></msubsup><mo>−</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em" rspace="0.280em">]</mo></mrow></mrow><mo rspace="0.558em">≥</mo><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mi>LR</mi></msubsup><mo>−</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em" rspace="0.280em">]</mo></mrow></mrow><mo rspace="0.502em">+</mo><mfrac><msub><mi>c</mi><mi>r</mi></msub><mi>n</mi></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mdmathbb E\big[(\widehat{x}_{n+1}^{\mathrm{LSA}}-x_{n+1})^{2}\big]\;\geq\;\mdmathbb E\big[(\widehat{x}_{n+1}^{\mathrm{LR}}-x_{n+1})^{2}\big]\;+\;\frac{c_{r}}{n}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A6.SS3.SSS0.Px1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A6.SS3.SSS0.Px1.p10" class="ltx_para">
<p id="A6.SS3.SSS0.Px1.p10.1" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p10.1.1" class="ltx_text">By Lemma <a href="#A6.Thmtheorem13" title="Lemma F.13 (Singular block inverse and first-order Schur complement). ‣ Setup (recalled). ‣ F.3 Order of the finite-sample gap ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.13</span></a>, we have</span></p>
<table id="A6.Ex152" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex152.m1" class="ltx_Math" alttext="\widetilde{r}_{n}^{\top}\widetilde{S}_{n}^{-1}\widetilde{r}_{n}=\Gamma_{p}+\frac{1}{n}\Big[-\frac{1}{c}A_{1}+\frac{1}{c}B^{\top}C^{-1}B-\frac{2}{\|u\|}\,B^{\top}C^{-1}d+d^{\top}C^{-1}d+\frac{2}{\|u\|}\,\mathrm{Sym}(\delta)\Big]+o(1/n)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>n</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>n</mi></msub></mrow><mo>=</mo><mrow><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo>+</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><mrow><mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mi>c</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mn>1</mn></msub></mrow></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mi>c</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow><mo>−</mo><mrow><mfrac><mn>2</mn><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>B</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo>+</mo><mrow><msup><mi>d</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mrow><mfrac><mn>2</mn><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mi>Sym</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">�</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widetilde{r}_{n}^{\top}\widetilde{S}_{n}^{-1}\widetilde{r}_{n}=\Gamma_{p}+\frac{1}{n}\Big[-\frac{1}{c}A_{1}+\frac{1}{c}B^{\top}C^{-1}B-\frac{2}{\|u\|}\,B^{\top}C^{-1}d+d^{\top}C^{-1}d+\frac{2}{\|u\|}\,\mathrm{Sym}(\delta)\Big]+o(1/n).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p10.2" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p10.2.1" class="ltx_text">Thus</span></p>
<table id="A6.Ex153" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex153.m1" class="ltx_Math" alttext="\Delta_{n}:=\Gamma_{p}-\widetilde{r}_{n}^{\top}\widetilde{S}_{n}^{-1}\widetilde{r}_{n}=\frac{1}{n}\,B_{p}+o(1/n)," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">�</mi><mi>n</mi></msub><mo>:=</mo><mrow><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo>−</mo><mrow><msubsup><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>n</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>n</mi></msub></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>B</mi><mi>p</mi></msub></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\Delta_{n}:=\Gamma_{p}-\widetilde{r}_{n}^{\top}\widetilde{S}_{n}^{-1}\widetilde{r}_{n}=\frac{1}{n}\,B_{p}+o(1/n),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p10.3" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p10.3.1" class="ltx_text">with</span></p>
<table id="A6.Ex154" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex154.m1" class="ltx_Math" alttext="B_{p}=\frac{1}{c}A_{1}-\frac{1}{c}B^{\top}C^{-1}B+\frac{2}{\|u\|}\,\mathrm{Sym}\big(B^{\top}C^{-1}d-\delta\big)-\,d^{\top}C^{-1}d." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>B</mi><mi>p</mi></msub><mo>=</mo><mrow><mrow><mrow><mrow><mfrac><mn>1</mn><mi>c</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mn>1</mn></msub></mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mi>c</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow><mo>+</mo><mrow><mfrac><mn>2</mn><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mi>Sym</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msup><mi>B</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>−</mo><mi mathvariant="normal">�</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo rspace="0.392em">−</mo><mrow><msup><mi>d</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">B_{p}=\frac{1}{c}A_{1}-\frac{1}{c}B^{\top}C^{-1}B+\frac{2}{\|u\|}\,\mathrm{Sym}\big(B^{\top}C^{-1}d-\delta\big)-\,d^{\top}C^{-1}d.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p10.4" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p10.4.1" class="ltx_text">By Lemma <a href="#A6.Thmtheorem6" title="Lemma F.6 (Strict PD of the Kronecker–lifted block). ‣ Step 2: lifting to the Kronecker level ‣ F.2 A finite-sample optimality gap for one-layer LSA ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.6</span></a>, each <math id="A6.SS3.SSS0.Px1.p10.m1" class="ltx_Math" alttext="\Delta_{n}\succ 0" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">�</mi><mi>n</mi></msub><mo>≻</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta_{n}\succ 0</annotation></semantics></math>, hence <math id="A6.SS3.SSS0.Px1.p10.m2" class="ltx_Math" alttext="B_{p}=\lim_{n\to\infty}n\Delta_{n}\succeq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>p</mi></msub><mo rspace="0.1389em">=</mo><mrow><msub><mo lspace="0.1389em" rspace="0.167em">lim</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">�</mi><mi>n</mi></msub></mrow></mrow><mo>⪰</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">B_{p}=\lim_{n\to\infty}n\Delta_{n}\succeq 0</annotation></semantics></math>.
The excess–risk bound follows from Theorem <a href="#A6.Thmtheorem7" title="Theorem F.7 (Finite-sample optimality gap of one-layer LSA). ‣ Step 3: the gap via a Schur complement ‣ F.2 A finite-sample optimality gap for one-layer LSA ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.7</span></a>:</span></p>
<table id="A6.Ex155" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex155.m1" class="ltx_Math" alttext="\min_{b,A}\mdmathbb E[(\widehat{x}_{n+1}-x_{n+1})^{2}]\;\geq\;\sigma_{\varepsilon}^{2}+\rho^{\top}\Delta_{n}\rho=\sigma_{\varepsilon}^{2}+\frac{1}{n}\,\rho^{\top}B_{p}\rho+o(1/n)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mi>min</mi><mrow><mi>b</mi><mo>,</mo><mi>A</mi></mrow></munder><mo lspace="0.167em">⁡</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo rspace="0.280em" stretchy="false">]</mo></mrow></mrow></mrow><mo rspace="0.558em">≥</mo><mrow><msubsup><mi mathvariant="normal">�</mi><mi mathvariant="normal">"</mi><mn>2</mn></msubsup><mo>+</mo><mrow><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">�</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">�</mi></mrow></mrow><mo>=</mo><mrow><msubsup><mi mathvariant="normal">�</mi><mi mathvariant="normal">"</mi><mn>2</mn></msubsup><mo>+</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">�</mi></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\min_{b,A}\mdmathbb E[(\widehat{x}_{n+1}-x_{n+1})^{2}]\;\geq\;\sigma_{\varepsilon}^{2}+\rho^{\top}\Delta_{n}\rho=\sigma_{\varepsilon}^{2}+\frac{1}{n}\,\rho^{\top}B_{p}\rho+o(1/n).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p10.5" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p10.5.1" class="ltx_text">If <math id="A6.SS3.SSS0.Px1.p10.m3" class="ltx_Math" alttext="B_{p}\succ 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>p</mi></msub><mo>≻</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">B_{p}\succ 0</annotation></semantics></math>, let <math id="A6.SS3.SSS0.Px1.p10.m4" class="ltx_Math" alttext="\lambda_{0}=\lambda_{\min}(B_{p})&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">�</mi><mn>0</mn></msub><mo>=</mo><mrow><msub><mi mathvariant="normal">�</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>B</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{0}=\lambda_{\min}(B_{p})&gt;0</annotation></semantics></math>. For large <math id="A6.SS3.SSS0.Px1.p10.m5" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>,
<math id="A6.SS3.SSS0.Px1.p10.m6" class="ltx_Math" alttext="\|\Delta_{n}-(1/n)B_{p}\|\leq\lambda_{0}/(2n)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi mathvariant="normal">�</mi><mi>n</mi></msub><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>p</mi></msub></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mrow><msub><mi mathvariant="normal">�</mi><mn>0</mn></msub><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\|\Delta_{n}-(1/n)B_{p}\|\leq\lambda_{0}/(2n)</annotation></semantics></math>, hence
<math id="A6.SS3.SSS0.Px1.p10.m7" class="ltx_Math" alttext="\rho^{\top}\Delta_{n}\rho\geq\tfrac{\lambda_{0}}{2n}\|\rho\|^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">�</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">�</mi></mrow><mo>≥</mo><mrow><mfrac><msub><mi mathvariant="normal">�</mi><mn>0</mn></msub><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi mathvariant="normal">�</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\rho^{\top}\Delta_{n}\rho\geq\tfrac{\lambda_{0}}{2n}\|\rho\|^{2}.</annotation></semantics></math>
Therefore, for any <math id="A6.SS3.SSS0.Px1.p10.m8" class="ltx_Math" alttext="r&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">r&gt;0</annotation></semantics></math>, there exist <math id="A6.SS3.SSS0.Px1.p10.m9" class="ltx_Math" alttext="n_{0}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mn>0</mn></msub><annotation encoding="application/x-tex">n_{0}</annotation></semantics></math> and <math id="A6.SS3.SSS0.Px1.p10.m10" class="ltx_Math" alttext="c_{r}=\tfrac{1}{2}\lambda_{0}r^{2}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>r</mi></msub><mo>=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">�</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mn>2</mn></msup></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c_{r}=\tfrac{1}{2}\lambda_{0}r^{2}&gt;0</annotation></semantics></math> such that for all <math id="A6.SS3.SSS0.Px1.p10.m11" class="ltx_Math" alttext="n\geq n_{0}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><msub><mi>n</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">n\geq n_{0}</annotation></semantics></math> and all <math id="A6.SS3.SSS0.Px1.p10.m12" class="ltx_Math" alttext="\|\rho\|\geq r" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mi mathvariant="normal">�</mi><mo stretchy="false">‖</mo></mrow><mo>≥</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">\|\rho\|\geq r</annotation></semantics></math>,</span></p>
<table id="A6.Ex156" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex156.m1" class="ltx_Math" alttext="\mdmathbb E[(\widehat{x}_{n+1}^{\mathrm{LSA}}-x_{n+1})^{2}]\;\geq\;\mdmathbb E[(\widehat{x}_{n+1}^{\mathrm{LR}}-x_{n+1})^{2}]\;+\;\frac{c_{r}}{n}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mi>LSA</mi></msubsup><mo>−</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo rspace="0.280em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.558em">≥</mo><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mi>LR</mi></msubsup><mo>−</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo rspace="0.280em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.502em">+</mo><mfrac><msub><mi>c</mi><mi>r</mi></msub><mi>n</mi></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mdmathbb E[(\widehat{x}_{n+1}^{\mathrm{LSA}}-x_{n+1})^{2}]\;\geq\;\mdmathbb E[(\widehat{x}_{n+1}^{\mathrm{LR}}-x_{n+1})^{2}]\;+\;\frac{c_{r}}{n}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p10.6" class="ltx_p"><span id="A6.SS3.SSS0.Px1.p10.6.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A6.Thmtheorem15" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A6.Thmtheorem15.2" class="ltx_text ltx_font_bold">Remark F.15</span></span><span id="A6.Thmtheorem15.3" class="ltx_text ltx_font_bold"> </span>(Why the rate is <math id="A6.Thmtheorem15.m1" class="ltx_Math" alttext="1/n" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">1/n</annotation></semantics></math>)<span id="A6.Thmtheorem15.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A6.Thmtheorem15.p1" class="ltx_para">
<p id="A6.Thmtheorem15.p1.1" class="ltx_p"><span id="A6.Thmtheorem15.p1.1.1" class="ltx_text ltx_font_italic">At the population limit <math id="A6.Thmtheorem15.p1.m1" class="ltx_Math" alttext="\widetilde{S}_{\infty}=(uu^{\top})\otimes\Gamma_{p}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi mathvariant="normal">∞</mi></msub><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mo>⊤</mo></msup></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊗</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\widetilde{S}_{\infty}=(uu^{\top})\otimes\Gamma_{p}</annotation></semantics></math> is rank-one along <math id="A6.Thmtheorem15.p1.m2" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math>.
Finite <math id="A6.Thmtheorem15.p1.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> introduces <math id="A6.Thmtheorem15.p1.m4" class="ltx_Math" alttext="O(1/n)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/n)</annotation></semantics></math> perturbations <math id="A6.Thmtheorem15.p1.m5" class="ltx_Math" alttext="C_{S},C_{r}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>S</mi></msub><mo>,</mo><msub><mi>C</mi><mi>r</mi></msub></mrow><annotation encoding="application/x-tex">C_{S},C_{r}</annotation></semantics></math> that regularize the orthogonal directions, so the Schur complement <math id="A6.Thmtheorem15.p1.m6" class="ltx_Math" alttext="\Gamma_{p}-\widetilde{r}_{n}^{\top}\widetilde{S}_{n}^{-1}\widetilde{r}_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo>−</mo><mrow><msubsup><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>n</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>n</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\Gamma_{p}-\widetilde{r}_{n}^{\top}\widetilde{S}_{n}^{-1}\widetilde{r}_{n}</annotation></semantics></math> is <math id="A6.Thmtheorem15.p1.m7" class="ltx_Math" alttext="O(1/n)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/n)</annotation></semantics></math>. The overlap of Hankel windows is the source of these first–order terms.</span></p>
</div>
</div>
</section>
<section id="A6.SS3.SSSx1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection">Auxiliary lemmas used in <a href="#A6.SS3" title="F.3 Order of the finite-sample gap ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">F.3</span></a></h4>

<div id="A6.Thmtheorem16" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A6.Thmtheorem16.2" class="ltx_text ltx_font_bold">Lemma F.16</span></span><span id="A6.Thmtheorem16.3" class="ltx_text ltx_font_bold"> </span>(Toeplitz-type summation)<span id="A6.Thmtheorem16.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A6.Thmtheorem16.p1" class="ltx_para">
<p id="A6.Thmtheorem16.p1.1" class="ltx_p"><span id="A6.Thmtheorem16.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A6.Thmtheorem16.p1.m1" class="ltx_Math" alttext="a:\mdmathbb Z\to\mdmathbb R" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>Z</mi><mo stretchy="false">→</mo><mi>R</mi></mrow></mrow><annotation encoding="application/x-tex">a:\mdmathbb Z\to\mdmathbb R</annotation></semantics></math> (or <math id="A6.Thmtheorem16.p1.m2" class="ltx_Math" alttext="\mdmathbb C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">\mdmathbb C</annotation></semantics></math>) be absolutely summable,
<math id="A6.Thmtheorem16.p1.m3" class="ltx_Math" alttext="\sum_{h\in\mdmathbb Z}|a_{h}|&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mrow><mi>h</mi><mo>∈</mo><mi>Z</mi></mrow></msub><mrow><mo lspace="0em" stretchy="false">|</mo><msub><mi>a</mi><mi>h</mi></msub><mo stretchy="false">|</mo></mrow></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\sum_{h\in\mdmathbb Z}|a_{h}|&lt;\infty</annotation></semantics></math>. For <math id="A6.Thmtheorem16.p1.m4" class="ltx_Math" alttext="n\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n\geq 1</annotation></semantics></math> define</span></p>
<table id="A6.Ex157" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex157.m1" class="ltx_Math" alttext="S_{n}\ :=\ \frac{1}{n^{2}}\sum_{m=1}^{n}\sum_{m^{\prime}=1}^{n}a_{\,m-m^{\prime}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>S</mi><mi>n</mi></msub><mo lspace="0.778em" rspace="0.778em">:=</mo><mrow><mfrac><mn>1</mn><msup><mi>n</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi>m</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><msub><mi>a</mi><mrow><mi>m</mi><mo>−</mo><msup><mi>m</mi><mo>′</mo></msup></mrow></msub></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">S_{n}\ :=\ \frac{1}{n^{2}}\sum_{m=1}^{n}\sum_{m^{\prime}=1}^{n}a_{\,m-m^{\prime}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmtheorem16.p1.2" class="ltx_p"><span id="A6.Thmtheorem16.p1.2.1" class="ltx_text ltx_font_italic">Then</span></p>
<table id="A6.Ex158" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex158.m1" class="ltx_Math" alttext="S_{n}\ =\ \frac{1}{n}\sum_{h\in\mdmathbb Z}\Big(1-\frac{|h|}{n}\Big)_{+}\,a_{h}\ =\ \frac{1}{n}\sum_{h\in\mdmathbb Z}a_{h}\ +\ \mathcal{O}\Big(\frac{1}{n^{2}}\sum_{h\in\mdmathbb Z}|h|\,|a_{h}|\Big)\ =\ \frac{1}{n}\sum_{h\in\mdmathbb Z}a_{h}\ +\ o(1/n)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>S</mi><mi>n</mi></msub><mo lspace="0.778em" rspace="0.778em">=</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>h</mi><mo>∈</mo><mi>Z</mi></mrow></munder><mrow><msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><mo stretchy="false">|</mo><mi>h</mi><mo stretchy="false">|</mo></mrow><mi>n</mi></mfrac></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo>+</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>h</mi></msub></mrow></mrow></mrow><mo rspace="0.778em">=</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>∈</mo><mi>Z</mi></mrow></munder><msub><mi>a</mi><mi>h</mi></msub></mrow></mrow><mo rspace="0.722em">+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mfrac><mn>1</mn><msup><mi>n</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>h</mi><mo>∈</mo><mi>Z</mi></mrow></munder><mrow><mrow><mo stretchy="false">|</mo><mi>h</mi><mo stretchy="false">|</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mi>h</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.500em">)</mo></mrow></mrow></mrow><mo rspace="0.778em">=</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>∈</mo><mi>Z</mi></mrow></munder><msub><mi>a</mi><mi>h</mi></msub></mrow></mrow><mo rspace="0.722em">+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">S_{n}\ =\ \frac{1}{n}\sum_{h\in\mdmathbb Z}\Big(1-\frac{|h|}{n}\Big)_{+}\,a_{h}\ =\ \frac{1}{n}\sum_{h\in\mdmathbb Z}a_{h}\ +\ \mathcal{O}\Big(\frac{1}{n^{2}}\sum_{h\in\mdmathbb Z}|h|\,|a_{h}|\Big)\ =\ \frac{1}{n}\sum_{h\in\mdmathbb Z}a_{h}\ +\ o(1/n).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmtheorem16.p1.3" class="ltx_p"><em id="A6.Thmtheorem16.p1.3.1" class="ltx_emph">Proof.</em><span id="A6.Thmtheorem16.p1.3.2" class="ltx_text ltx_font_italic">
Count the number of pairs <math id="A6.Thmtheorem16.p1.m5" class="ltx_Math" alttext="(m,m^{\prime})\in\{1,\dots,n\}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><msup><mi>m</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi><mo stretchy="false">}</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">(m,m^{\prime})\in\{1,\dots,n\}^{2}</annotation></semantics></math> with difference <math id="A6.Thmtheorem16.p1.m6" class="ltx_Math" alttext="m-m^{\prime}=h" display="inline" intent=":literal"><semantics><mrow><mrow><mi>m</mi><mo>−</mo><msup><mi>m</mi><mo>′</mo></msup></mrow><mo>=</mo><mi>h</mi></mrow><annotation encoding="application/x-tex">m-m^{\prime}=h</annotation></semantics></math>; it equals
<math id="A6.Thmtheorem16.p1.m7" class="ltx_Math" alttext="n-|h|" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>−</mo><mrow><mo stretchy="false">|</mo><mi>h</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">n-|h|</annotation></semantics></math> if <math id="A6.Thmtheorem16.p1.m8" class="ltx_Math" alttext="|h|&lt;n" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>h</mi><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">|h|&lt;n</annotation></semantics></math> and <math id="A6.Thmtheorem16.p1.m9" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> otherwise.
Hence</span></p>
<table id="A6.Ex159" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex159.m1" class="ltx_Math" alttext="\sum_{m,m^{\prime}=1}^{n}a_{m-m^{\prime}}=\sum_{h=-(n-1)}^{n-1}(n-|h|)\,a_{h}=n\sum_{h}\Big(1-\frac{|h|}{n}\Big)_{+}a_{h}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>m</mi><mo>,</mo><msup><mi>m</mi><mo>′</mo></msup></mrow><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><msub><mi>a</mi><mrow><mi>m</mi><mo>−</mo><msup><mi>m</mi><mo>′</mo></msup></mrow></msub></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>h</mi><mo>=</mo><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mrow><mo stretchy="false">|</mo><mi>h</mi><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>a</mi><mi>h</mi></msub></mrow></mrow><mo>=</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mi>h</mi></munder><mrow><msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><mo stretchy="false">|</mo><mi>h</mi><mo stretchy="false">|</mo></mrow><mi>n</mi></mfrac></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo>+</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>h</mi></msub></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{m,m^{\prime}=1}^{n}a_{m-m^{\prime}}=\sum_{h=-(n-1)}^{n-1}(n-|h|)\,a_{h}=n\sum_{h}\Big(1-\frac{|h|}{n}\Big)_{+}a_{h}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmtheorem16.p1.4" class="ltx_p"><span id="A6.Thmtheorem16.p1.4.1" class="ltx_text ltx_font_italic">Divide by <math id="A6.Thmtheorem16.p1.m10" class="ltx_Math" alttext="n^{2}" display="inline" intent=":literal"><semantics><msup><mi>n</mi><mn>2</mn></msup><annotation encoding="application/x-tex">n^{2}</annotation></semantics></math> and use absolute summability to obtain the stated bound.</span></p>
</div>
</div>
</section>
</section>
<section id="A6.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">F.4 </span>A finite–sample gap for <math id="A6.SS4.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> stacked LSA layers (with monotone improvement)</h3>

<section id="A6.SS4.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Goal.</h5>

<div id="A6.SS4.SSS0.Px1.p1" class="ltx_para">
<p id="A6.SS4.SSS0.Px1.p1.1" class="ltx_p">For any fixed sample size <math id="A6.SS4.SSS0.Px1.p1.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> and depth <math id="A6.SS4.SSS0.Px1.p1.m2" class="ltx_Math" alttext="L\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">L\geq 1</annotation></semantics></math>, we show that the best <math id="A6.SS4.SSS0.Px1.p1.m3" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>–layer linear self–attention (LSA) readout on Hankel inputs has a finite–sample excess risk over linear regression on the last <math id="A6.SS4.SSS0.Px1.p1.m4" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> lags.
To avoid unnecessary technicalities about duplicate features across layers, we work with the <em id="A6.SS4.SSS0.Px1.p1.1.1" class="ltx_emph ltx_font_italic">convex relaxation</em> of the LSA parameters and allow singular second–moment matrices; the Moore–Penrose inverse then gives a clean <em id="A6.SS4.SSS0.Px1.p1.1.2" class="ltx_emph ltx_font_italic">positive–semidefinite</em> (psd) gap.
We also prove that the optimal risk is <em id="A6.SS4.SSS0.Px1.p1.1.3" class="ltx_emph ltx_font_italic">monotone nonincreasing</em> in depth <math id="A6.SS4.SSS0.Px1.p1.m5" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>.</p>
</div>
</section>
<section id="A6.SS4.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Setup (layered).</h5>

<div id="A6.SS4.SSS0.Px2.p1" class="ltx_para">
<p id="A6.SS4.SSS0.Px2.p1.1" class="ltx_p">Let <math id="A6.SS4.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\{x_{t}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{x_{t}\}</annotation></semantics></math> be a zero–mean stationary <math id="A6.SS4.SSS0.Px2.p1.m2" class="ltx_Math" alttext="\mathrm{AR}(p)" display="inline" intent=":literal"><semantics><mrow><mi>AR</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{AR}(p)</annotation></semantics></math> process (Definition <a href="#S2.Thmtheorem2" title="Definition 2.2 (AR(𝑝) Process []). ‣ 2.1 Time Series ‣ 2 Preliminaries ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.2</span></a>).
For <math id="A6.SS4.SSS0.Px2.p1.m3" class="ltx_Math" alttext="n\geq p" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">n\geq p</annotation></semantics></math>, let <math id="A6.SS4.SSS0.Px2.p1.m4" class="ltx_Math" alttext="H_{n}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mi>n</mi></msub><annotation encoding="application/x-tex">H_{n}</annotation></semantics></math> be the Hankel matrix (Definition <a href="#S2.Thmtheorem5" title="Definition 2.5 (Hankel Matrix). ‣ 2.3 In-Context Time Series Forecasting ‣ 2 Preliminaries ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.5</span></a>), <math id="A6.SS4.SSS0.Px2.p1.m5" class="ltx_Math" alttext="M=\mathrm{diag}(I_{\,n-p},0)" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><mrow><mi>diag</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>I</mi><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></msub><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M=\mathrm{diag}(I_{\,n-p},0)</annotation></semantics></math>, and</p>
<table id="A6.Ex160" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex160.m1" class="ltx_Math" alttext="G^{(0)}\;:=\;\frac{1}{n}\,H_{n}MH_{n}^{\top}\in\mdmathbb R^{(p+1)\times(p+1)}." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>G</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.558em" rspace="0.558em">:=</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>H</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>H</mi><mi>n</mi><mo>⊤</mo></msubsup></mrow><mo>∈</mo><msup><mi>R</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">G^{(0)}\;:=\;\frac{1}{n}\,H_{n}MH_{n}^{\top}\in\mdmathbb R^{(p+1)\times(p+1)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS4.SSS0.Px2.p1.2" class="ltx_p">Write <math id="A6.SS4.SSS0.Px2.p1.m6" class="ltx_math_unparsed" alttext="x:=x_{\,n-p+1:n}\in\mdmathbb R^{p}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>:=</mo><mi>x</mi><msub><mrow></mrow><mrow><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo>∈</mo><mi>R</mi><msup><mrow></mrow><mi>p</mi></msup></mrow><annotation encoding="application/x-tex">x:=x_{\,n-p+1:n}\in\mdmathbb R^{p}</annotation></semantics></math> and <math id="A6.SS4.SSS0.Px2.p1.m7" class="ltx_Math" alttext="y:=x_{n+1}=\rho^{\top}x+\varepsilon_{n+1}" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>:=</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><mrow><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><msub><mi mathvariant="normal">"</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">y:=x_{n+1}=\rho^{\top}x+\varepsilon_{n+1}</annotation></semantics></math> with <math id="A6.SS4.SSS0.Px2.p1.m8" class="ltx_Math" alttext="\varepsilon_{n+1}\perp(G^{(0)},x)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">"</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>⟂</mo><mrow><mo stretchy="false">(</mo><msup><mi>G</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\varepsilon_{n+1}\perp(G^{(0)},x)</annotation></semantics></math>, <math id="A6.SS4.SSS0.Px2.p1.m9" class="ltx_Math" alttext="\mdmathbb E[\varepsilon_{n+1}]=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi mathvariant="normal">"</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mdmathbb E[\varepsilon_{n+1}]=0</annotation></semantics></math>, <math id="A6.SS4.SSS0.Px2.p1.m10" class="ltx_Math" alttext="\mdmathbb E[\varepsilon_{n+1}^{2}]=\sigma_{\varepsilon}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi mathvariant="normal">"</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><msubsup><mi mathvariant="normal">�</mi><mi mathvariant="normal">"</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\mdmathbb E[\varepsilon_{n+1}^{2}]=\sigma_{\varepsilon}^{2}</annotation></semantics></math>.
Initialize <math id="A6.SS4.SSS0.Px2.p1.m11" class="ltx_Math" alttext="y^{(0)}=0" display="inline" intent=":literal"><semantics><mrow><msup><mi>y</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">y^{(0)}=0</annotation></semantics></math> and <math id="A6.SS4.SSS0.Px2.p1.m12" class="ltx_Math" alttext="H_{n}^{(0)}:=H_{n}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>H</mi><mi>n</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>:=</mo><msub><mi>H</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">H_{n}^{(0)}:=H_{n}</annotation></semantics></math>.
For <math id="A6.SS4.SSS0.Px2.p1.m13" class="ltx_Math" alttext="\ell=0,\dots,L-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\ell=0,\dots,L-1</annotation></semantics></math> define the layer update</p>
<table id="A6.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.E10.m1" class="ltx_Math" alttext="y^{(\ell+1)}\;=\;y^{(\ell)}\;+\;b^{(\ell)\top}G^{(\ell)}A^{(\ell)}x,\qquad G^{(\ell+1)}\;=\;\frac{1}{n}\,H_{n}^{(\ell+1)}M\bigl(H_{n}^{(\ell+1)}\bigr)^{\top}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>y</mi><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.558em" rspace="0.558em">=</mo><mrow><msup><mi>y</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo rspace="0.502em">+</mo><mrow><msup><mi>b</mi><mrow><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msup><mi>G</mi><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo rspace="0.558em">=</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>H</mi><mi>n</mi><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msubsup><mi>H</mi><mi>n</mi><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">y^{(\ell+1)}\;=\;y^{(\ell)}\;+\;b^{(\ell)\top}G^{(\ell)}A^{(\ell)}x,\qquad G^{(\ell+1)}\;=\;\frac{1}{n}\,H_{n}^{(\ell+1)}M\bigl(H_{n}^{(\ell+1)}\bigr)^{\top},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(10)</span></td></tr></tbody>
</table>
<p id="A6.SS4.SSS0.Px2.p1.3" class="ltx_p">where <math id="A6.SS4.SSS0.Px2.p1.m14" class="ltx_Math" alttext="H_{n}^{(\ell+1)}" display="inline" intent=":literal"><semantics><msubsup><mi>H</mi><mi>n</mi><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">H_{n}^{(\ell+1)}</annotation></semantics></math> coincides with <math id="A6.SS4.SSS0.Px2.p1.m15" class="ltx_Math" alttext="H_{n}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mi>n</mi></msub><annotation encoding="application/x-tex">H_{n}</annotation></semantics></math> except that the last row uses the current layer’s vector of entries whose last coordinate is <math id="A6.SS4.SSS0.Px2.p1.m16" class="ltx_Math" alttext="y^{(\ell+1)}" display="inline" intent=":literal"><semantics><msup><mi>y</mi><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">y^{(\ell+1)}</annotation></semantics></math> (the mask <math id="A6.SS4.SSS0.Px2.p1.m17" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> remains unchanged).
The <math id="A6.SS4.SSS0.Px2.p1.m18" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>–layer predictor is</p>
<table id="A6.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.E11.m1" class="ltx_Math" alttext="\widehat{x}_{n+1}^{(L)}\;=\;y^{(L)}\;=\;\sum_{\ell=0}^{L-1}b^{(\ell)\top}G^{(\ell)}A^{(\ell)}x." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.558em" rspace="0.558em">=</mo><msup><mi>y</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup><mo rspace="0.391em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><msup><mi>b</mi><mrow><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{x}_{n+1}^{(L)}\;=\;y^{(L)}\;=\;\sum_{\ell=0}^{L-1}b^{(\ell)\top}G^{(\ell)}A^{(\ell)}x.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(11)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A6.SS4.SSS0.Px3" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">A one–shot convex relaxation for depth <math id="A6.SS4.SSS0.Px3.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>.</h5>

<div id="A6.SS4.SSS0.Px3.p1" class="ltx_para">
<p id="A6.SS4.SSS0.Px3.p1.1" class="ltx_p">Let <math id="A6.SS4.SSS0.Px3.p1.m1" class="ltx_Math" alttext="g^{(\ell)}:=\vech G^{(\ell)}\in\mdmathbb R^{q}" display="inline" intent=":literal"><semantics><mrow><msup><mi>g</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo>:=</mo><mrow><mi>vech</mi><mo lspace="0.167em">⁡</mo><msup><mi>G</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>∈</mo><msup><mi>R</mi><mi>q</mi></msup></mrow><annotation encoding="application/x-tex">g^{(\ell)}:=\vech G^{(\ell)}\in\mdmathbb R^{q}</annotation></semantics></math> with <math id="A6.SS4.SSS0.Px3.p1.m2" class="ltx_Math" alttext="q=\tfrac{(p+1)(p+2)}{2}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">q=\tfrac{(p+1)(p+2)}{2}</annotation></semantics></math>, and set the stacked Kronecker lift</p>
<table id="A6.Ex161" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex161.m1" class="ltx_Math" alttext="Z^{[L]}\;:=\;\begin{bmatrix}g^{(0)}\otimes x\\
\vdots\\
g^{(L-1)}\otimes x\end{bmatrix}\in\mdmathbb R^{d_{L}},\qquad d_{L}=Lqp." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>Z</mi><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></msup><mo lspace="0.558em" rspace="0.558em">:=</mo><mrow><mo>[</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><msup><mi>g</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>x</mi></mrow></mtd></mtr><mtr><mtd></mtd></mtr><mtr><mtd><mrow><msup><mi>g</mi><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>x</mi></mrow></mtd></mtr></mtable><mo>]</mo></mrow><mo>∈</mo><msup><mi>R</mi><msub><mi>d</mi><mi>L</mi></msub></msup></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>d</mi><mi>L</mi></msub><mo>=</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Z^{[L]}\;:=\;\begin{bmatrix}g^{(0)}\otimes x\\
\vdots\\
g^{(L-1)}\otimes x\end{bmatrix}\in\mdmathbb R^{d_{L}},\qquad d_{L}=Lqp.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS4.SSS0.Px3.p1.2" class="ltx_p">For each layer, <math id="A6.SS4.SSS0.Px3.p1.m3" class="ltx_Math" alttext="b^{(\ell)\top}G^{(\ell)}A^{(\ell)}x" display="inline" intent=":literal"><semantics><mrow><msup><mi>b</mi><mrow><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><annotation encoding="application/x-tex">b^{(\ell)\top}G^{(\ell)}A^{(\ell)}x</annotation></semantics></math> can be written as
<math id="A6.SS4.SSS0.Px3.p1.m4" class="ltx_Math" alttext="\eta^{(\ell)\top}(g^{(\ell)}\otimes x)" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">�</mi><mrow><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>g</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\eta^{(\ell)\top}(g^{(\ell)}\otimes x)</annotation></semantics></math> with
<math id="A6.SS4.SSS0.Px3.p1.m5" class="ltx_Math" alttext="\eta^{(\ell)}=(D_{p+1}^{\top}\otimes I_{p})\bigl(b^{(\ell)}\otimes\vect(A^{(\ell)\top})\bigr)" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">�</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>D</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>I</mi><mi>p</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msup><mi>b</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mrow><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta^{(\ell)}=(D_{p+1}^{\top}\otimes I_{p})\bigl(b^{(\ell)}\otimes\vect(A^{(\ell)\top})\bigr)</annotation></semantics></math>, and hence</p>
<table id="A6.Ex162" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex162.m1" class="ltx_Math" alttext="\widehat{x}_{n+1}^{(L)}\;=\;\eta^{[L]\top}Z^{[L]},\qquad\eta^{[L]}:=\bigl[(\eta^{(0)})^{\top},\dots,(\eta^{(L-1)})^{\top}\bigr]^{\top}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.558em" rspace="0.558em">=</mo><mrow><msup><mi mathvariant="normal">�</mi><mrow><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>Z</mi><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></msup></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msup><mi mathvariant="normal">�</mi><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></msup><mo>:=</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">�</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">�</mi><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo>⊤</mo></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{x}_{n+1}^{(L)}\;=\;\eta^{[L]\top}Z^{[L]},\qquad\eta^{[L]}:=\bigl[(\eta^{(0)})^{\top},\dots,(\eta^{(L-1)})^{\top}\bigr]^{\top}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS4.SSS0.Px3.p1.3" class="ltx_p">Relaxing the rank–one Kronecker constraint on parameters leads to a linear regression of <math id="A6.SS4.SSS0.Px3.p1.m6" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math> on <math id="A6.SS4.SSS0.Px3.p1.m7" class="ltx_Math" alttext="Z^{[L]}" display="inline" intent=":literal"><semantics><msup><mi>Z</mi><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></msup><annotation encoding="application/x-tex">Z^{[L]}</annotation></semantics></math>.
Define the second moments</p>
<table id="A6.Ex163" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex163.m1" class="ltx_Math" alttext="\widetilde{S}_{L}:=\mdmathbb E[Z^{[L]}Z^{[L]\top}],\qquad\widetilde{r}_{L}:=\mdmathbb E[Z^{[L]}x^{\top}],\qquad\Gamma_{p}:=\mdmathbb E[xx^{\top}]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>L</mi></msub><mo>:=</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>Z</mi><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>Z</mi><mrow><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>L</mi></msub><mo>:=</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>Z</mi><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo>:=</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widetilde{S}_{L}:=\mdmathbb E[Z^{[L]}Z^{[L]\top}],\qquad\widetilde{r}_{L}:=\mdmathbb E[Z^{[L]}x^{\top}],\qquad\Gamma_{p}:=\mdmathbb E[xx^{\top}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS4.SSS0.Px3.p1.4" class="ltx_p">We <em id="A6.SS4.SSS0.Px3.p1.4.1" class="ltx_emph ltx_font_italic">allow</em> <math id="A6.SS4.SSS0.Px3.p1.m8" class="ltx_Math" alttext="\widetilde{S}_{L}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>L</mi></msub><annotation encoding="application/x-tex">\widetilde{S}_{L}</annotation></semantics></math> to be singular (duplicates across layers are harmless).
The standard normal–equation calculation with the Moore–Penrose inverse gives</p>
<table id="A6.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.E12.m1" class="ltx_Math" alttext="\min_{\eta^{[L]}}\ \mdmathbb E\big[(\eta^{[L]\top}Z^{[L]}-y)^{2}\big]=\sigma_{\varepsilon}^{2}+\rho^{\top}\Gamma_{p}\rho-\rho^{\top}\widetilde{r}_{L}^{\top}\,\widetilde{S}_{L}^{+}\,\widetilde{r}_{L}\,\rho," display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mi>min</mi><msup><mi mathvariant="normal">�</mi><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></msup></munder><mo lspace="0.667em">⁡</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi mathvariant="normal">�</mi><mrow><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>Z</mi><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></msup></mrow><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><msubsup><mi mathvariant="normal">�</mi><mi mathvariant="normal">"</mi><mn>2</mn></msubsup><mo>+</mo><mrow><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">�</mi></mrow></mrow><mo>−</mo><mrow><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>L</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>L</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">�</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\min_{\eta^{[L]}}\ \mdmathbb E\big[(\eta^{[L]\top}Z^{[L]}-y)^{2}\big]=\sigma_{\varepsilon}^{2}+\rho^{\top}\Gamma_{p}\rho-\rho^{\top}\widetilde{r}_{L}^{\top}\,\widetilde{S}_{L}^{+}\,\widetilde{r}_{L}\,\rho,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(12)</span></td></tr></tbody>
</table>
<p id="A6.SS4.SSS0.Px3.p1.5" class="ltx_p">so the <math id="A6.SS4.SSS0.Px3.p1.m9" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>–layer LSA family (which is a subset of the relaxed linear models) obeys the lower bound</p>
<table id="A6.E13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.E13.m1" class="ltx_Math" alttext="\min_{\{b^{(\ell)},A^{(\ell)}\}}\mdmathbb E\big[(\widehat{x}_{n+1}^{(L)}-x_{n+1})^{2}\big]\ \geq\ \sigma_{\varepsilon}^{2}+\rho^{\top}\Delta_{n,L}\rho,\qquad\Delta_{n,L}:=\Gamma_{p}-\widetilde{r}_{L}^{\top}\,\widetilde{S}_{L}^{+}\,\widetilde{r}_{L}\ \succeq\ 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munder><mi>min</mi><mrow><mo stretchy="false">{</mo><msup><mi>b</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">}</mo></mrow></munder><mo lspace="0.167em">⁡</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em" rspace="0.500em">]</mo></mrow></mrow></mrow><mo rspace="0.778em">≥</mo><mrow><msubsup><mi mathvariant="normal">�</mi><mi mathvariant="normal">"</mi><mn>2</mn></msubsup><mo>+</mo><mrow><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">�</mi><mrow><mi>n</mi><mo>,</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">�</mi></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi mathvariant="normal">�</mi><mrow><mi>n</mi><mo>,</mo><mi>L</mi></mrow></msub><mo>:=</mo><mrow><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo>−</mo><mrow><msubsup><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>L</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>L</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>L</mi></msub></mrow></mrow><mo>⪰</mo><mn> 0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\min_{\{b^{(\ell)},A^{(\ell)}\}}\mdmathbb E\big[(\widehat{x}_{n+1}^{(L)}-x_{n+1})^{2}\big]\ \geq\ \sigma_{\varepsilon}^{2}+\rho^{\top}\Delta_{n,L}\rho,\qquad\Delta_{n,L}:=\Gamma_{p}-\widetilde{r}_{L}^{\top}\,\widetilde{S}_{L}^{+}\,\widetilde{r}_{L}\ \succeq\ 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(13)</span></td></tr></tbody>
</table>
</div>
<div id="A6.Thmtheorem17" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A6.Thmtheorem17.2" class="ltx_text ltx_font_bold">Lemma F.17</span></span><span id="A6.Thmtheorem17.3" class="ltx_text ltx_font_bold"> </span>(Why <math id="A6.Thmtheorem17.m1" class="ltx_Math" alttext="\Delta_{n,L}\succeq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">�</mi><mrow><mi>n</mi><mo>,</mo><mi>L</mi></mrow></msub><mo>⪰</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta_{n,L}\succeq 0</annotation></semantics></math> even if <math id="A6.Thmtheorem17.m2" class="ltx_Math" alttext="\widetilde{S}_{L}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>L</mi></msub><annotation encoding="application/x-tex">\widetilde{S}_{L}</annotation></semantics></math> is singular)<span id="A6.Thmtheorem17.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A6.Thmtheorem17.p1" class="ltx_para">
<p id="A6.Thmtheorem17.p1.1" class="ltx_p"><span id="A6.Thmtheorem17.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A6.Thmtheorem17.p1.m1" class="ltx_Math" alttext="\Sigma_{L}:=\mdmathbb E\big[\,[Z^{[L]};x]\,[Z^{[L]};x]^{\top}\big]=\bigl[\begin{smallmatrix}\widetilde{S}_{L}&amp;\widetilde{r}_{L}\\
\widetilde{r}_{L}^{\top}&amp;\Gamma_{p}\end{smallmatrix}\bigr]" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">�</mi><mi>L</mi></msub><mo>:=</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">[</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><msup><mi>Z</mi><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></msup><mo>;</mo><mi>x</mi></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">[</mo><mrow><msup><mi>Z</mi><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></msup><mo>;</mo><mi>x</mi></mrow><mo stretchy="false">]</mo></mrow><mo>⊤</mo></msup></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo>=</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><msub><mover accent="true"><mi mathsize="0.700em">S</mi><mo>~</mo></mover><mi mathsize="0.700em">L</mi></msub></mtd><mtd><msub><mover accent="true"><mi mathsize="0.700em">r</mi><mo>~</mo></mover><mi mathsize="0.700em">L</mi></msub></mtd></mtr><mtr><mtd><msubsup><mover accent="true"><mi mathsize="0.700em">r</mi><mo>~</mo></mover><mi mathsize="0.700em">L</mi><mo mathsize="0.700em">⊤</mo></msubsup></mtd><mtd><msub><mi mathsize="0.700em" mathvariant="normal">�</mi><mi mathsize="0.700em">p</mi></msub></mtd></mtr></mtable><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\Sigma_{L}:=\mdmathbb E\big[\,[Z^{[L]};x]\,[Z^{[L]};x]^{\top}\big]=\bigl[\begin{smallmatrix}\widetilde{S}_{L}&amp;\widetilde{r}_{L}\\
\widetilde{r}_{L}^{\top}&amp;\Gamma_{p}\end{smallmatrix}\bigr]</annotation></semantics></math>.
Then <math id="A6.Thmtheorem17.p1.m2" class="ltx_Math" alttext="\Sigma_{L}\succeq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">�</mi><mi>L</mi></msub><mo>⪰</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Sigma_{L}\succeq 0</annotation></semantics></math>, and the Moore–Penrose Schur complement
<math id="A6.Thmtheorem17.p1.m3" class="ltx_Math" alttext="\Gamma_{p}-\widetilde{r}_{L}^{\top}\widetilde{S}_{L}^{+}\widetilde{r}_{L}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo>−</mo><mrow><msubsup><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>L</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>L</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>L</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\Gamma_{p}-\widetilde{r}_{L}^{\top}\widetilde{S}_{L}^{+}\widetilde{r}_{L}</annotation></semantics></math> is psd.
Equivalently, <math id="A6.Thmtheorem17.p1.m4" class="ltx_Math" alttext="\Delta_{n,L}\succeq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">�</mi><mrow><mi>n</mi><mo>,</mo><mi>L</mi></mrow></msub><mo>⪰</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta_{n,L}\succeq 0</annotation></semantics></math> and equals the covariance of the best linear–prediction residual of <math id="A6.Thmtheorem17.p1.m5" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> on <math id="A6.Thmtheorem17.p1.m6" class="ltx_Math" alttext="Z^{[L]}" display="inline" intent=":literal"><semantics><msup><mi>Z</mi><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></msup><annotation encoding="application/x-tex">Z^{[L]}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A6.SS4.SSS0.Px3.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A6.SS4.SSS0.Px3.p2" class="ltx_para">
<p id="A6.SS4.SSS0.Px3.p2.1" class="ltx_p"><math id="A6.SS4.SSS0.Px3.p2.m1" class="ltx_Math" alttext="\Sigma_{L}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">�</mi><mi>L</mi></msub><annotation encoding="application/x-tex">\Sigma_{L}</annotation></semantics></math><span id="A6.SS4.SSS0.Px3.p2.1.1" class="ltx_text"> is a covariance hence psd.
For any matrix <math id="A6.SS4.SSS0.Px3.p2.m2" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>, the prediction <math id="A6.SS4.SSS0.Px3.p2.m3" class="ltx_Math" alttext="Z^{[L]}\mapsto B^{\top}Z^{[L]}" display="inline" intent=":literal"><semantics><mrow><msup><mi>Z</mi><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">↦</mo><mrow><msup><mi>B</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>Z</mi><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">Z^{[L]}\mapsto B^{\top}Z^{[L]}</annotation></semantics></math> yields residual covariance
<math id="A6.SS4.SSS0.Px3.p2.m4" class="ltx_Math" alttext="\Gamma_{p}-B^{\top}\widetilde{r}_{L}-\widetilde{r}_{L}^{\top}B+B^{\top}\widetilde{S}_{L}B" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo>−</mo><mrow><msup><mi>B</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>L</mi></msub></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>L</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow><mo>+</mo><mrow><msup><mi>B</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow><annotation encoding="application/x-tex">\Gamma_{p}-B^{\top}\widetilde{r}_{L}-\widetilde{r}_{L}^{\top}B+B^{\top}\widetilde{S}_{L}B</annotation></semantics></math>.
Minimizing over <math id="A6.SS4.SSS0.Px3.p2.m5" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> (in the least–squares sense on the range of <math id="A6.SS4.SSS0.Px3.p2.m6" class="ltx_Math" alttext="\widetilde{S}_{L}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>L</mi></msub><annotation encoding="application/x-tex">\widetilde{S}_{L}</annotation></semantics></math>) gives <math id="A6.SS4.SSS0.Px3.p2.m7" class="ltx_Math" alttext="B^{*}=\widetilde{S}_{L}^{+}\widetilde{r}_{L}" display="inline" intent=":literal"><semantics><mrow><msup><mi>B</mi><mo>∗</mo></msup><mo>=</mo><mrow><msubsup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>L</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>L</mi></msub></mrow></mrow><annotation encoding="application/x-tex">B^{*}=\widetilde{S}_{L}^{+}\widetilde{r}_{L}</annotation></semantics></math> and residual covariance <math id="A6.SS4.SSS0.Px3.p2.m8" class="ltx_Math" alttext="\Gamma_{p}-\widetilde{r}_{L}^{\top}\widetilde{S}_{L}^{+}\widetilde{r}_{L}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo>−</mo><mrow><msubsup><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>L</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>L</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>L</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\Gamma_{p}-\widetilde{r}_{L}^{\top}\widetilde{S}_{L}^{+}\widetilde{r}_{L}</annotation></semantics></math>, which is psd by definition of a covariance.
∎</span></p>
</div>
</div>
</section>
<section id="A6.SS4.SSS0.Px4" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Depth helps: a simple embedding argument.</h5>

<div id="A6.SS4.SSS0.Px4.p1" class="ltx_para">
<p id="A6.SS4.SSS0.Px4.p1.1" class="ltx_p">We now show that the optimal risk is monotone in <math id="A6.SS4.SSS0.Px4.p1.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>; the proof does not rely on invertibility nor on strictness.</p>
</div>
<div id="A6.Thmtheorem18" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A6.Thmtheorem18.2" class="ltx_text ltx_font_bold">Proposition F.18</span></span><span id="A6.Thmtheorem18.3" class="ltx_text ltx_font_bold"> </span>(Monotone improvement with depth)<span id="A6.Thmtheorem18.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A6.Thmtheorem18.p1" class="ltx_para">
<p id="A6.Thmtheorem18.p1.1" class="ltx_p"><span id="A6.Thmtheorem18.p1.1.1" class="ltx_text ltx_font_italic">For every <math id="A6.Thmtheorem18.p1.m1" class="ltx_Math" alttext="L\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">L\geq 1</annotation></semantics></math>,</span></p>
<table id="A6.Ex164" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex164.m1" class="ltx_Math" alttext="\min_{\{b^{(\ell)},A^{(\ell)}\}_{\ell=0}^{L}}\ \mdmathbb{E}\big[(\widehat{x}_{n+1}^{(L+1)}-x_{n+1})^{2}\big]\;\leq\;\min_{\{b^{(\ell)},A^{(\ell)}\}_{\ell=0}^{L-1}}\ \mdmathbb{E}\big[(\widehat{x}_{n+1}^{(L)}-x_{n+1})^{2}\big]," display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mi>min</mi><msubsup><mrow><mo stretchy="false">{</mo><msup><mi>b</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">}</mo></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>0</mn></mrow><mi>L</mi></msubsup></munder><mo lspace="0.667em">⁡</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em" rspace="0.280em">]</mo></mrow></mrow></mrow><mo rspace="0.558em">≤</mo><mrow><munder><mi>min</mi><msubsup><mrow><mo stretchy="false">{</mo><msup><mi>b</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">}</mo></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></msubsup></munder><mo lspace="0.167em">⁡</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\min_{\{b^{(\ell)},A^{(\ell)}\}_{\ell=0}^{L}}\ \mdmathbb{E}\big[(\widehat{x}_{n+1}^{(L+1)}-x_{n+1})^{2}\big]\;\leq\;\min_{\{b^{(\ell)},A^{(\ell)}\}_{\ell=0}^{L-1}}\ \mdmathbb{E}\big[(\widehat{x}_{n+1}^{(L)}-x_{n+1})^{2}\big],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmtheorem18.p1.2" class="ltx_p"><span id="A6.Thmtheorem18.p1.2.1" class="ltx_text ltx_font_italic">where <math id="A6.Thmtheorem18.p1.m2" class="ltx_Math" alttext="\widehat{x}_{n+1}^{(L)}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\widehat{x}_{n+1}^{(L)}</annotation></semantics></math> is defined in (<a href="#A6.E11" title="Equation 11 ‣ Setup (layered). ‣ F.4 A finite–sample gap for 𝐿 stacked LSA layers (with monotone improvement) ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>) under the update
rule (<a href="#A6.E10" title="Equation 10 ‣ Setup (layered). ‣ F.4 A finite–sample gap for 𝐿 stacked LSA layers (with monotone improvement) ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>). In particular, the best two–layer risk is no
worse than the best one–layer risk:</span></p>
<table id="A6.Ex165" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex165.m1" class="ltx_Math" alttext="\min_{b^{(0)},A^{(0)},\,b^{(1)},A^{(1)}}\ \mdmathbb{E}\big[(\widehat{x}_{n+1}^{(2)}-x_{n+1})^{2}\big]\;\leq\;\min_{b^{(0)},A^{(0)}}\ \mdmathbb{E}\big[(\widehat{x}_{n+1}^{(1)}-x_{n+1})^{2}\big]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mi>min</mi><mrow><msup><mi>b</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo rspace="0.337em">,</mo><msup><mi>b</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup></mrow></munder><mo lspace="0.667em">⁡</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em" rspace="0.280em">]</mo></mrow></mrow></mrow><mo rspace="0.558em">≤</mo><mrow><munder><mi>min</mi><mrow><msup><mi>b</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow></munder><mo lspace="0.167em">⁡</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\min_{b^{(0)},A^{(0)},\,b^{(1)},A^{(1)}}\ \mdmathbb{E}\big[(\widehat{x}_{n+1}^{(2)}-x_{n+1})^{2}\big]\;\leq\;\min_{b^{(0)},A^{(0)}}\ \mdmathbb{E}\big[(\widehat{x}_{n+1}^{(1)}-x_{n+1})^{2}\big].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A6.SS4.SSS0.Px4.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A6.SS4.SSS0.Px4.p2" class="ltx_para">
<p id="A6.SS4.SSS0.Px4.p2.1" class="ltx_p"><span id="A6.SS4.SSS0.Px4.p2.1.1" class="ltx_text">Fix any parameter set <math id="A6.SS4.SSS0.Px4.p2.m1" class="ltx_Math" alttext="\{b^{(\ell)},A^{(\ell)}\}_{\ell=0}^{L-1}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msup><mi>b</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">}</mo></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></msubsup><annotation encoding="application/x-tex">\{b^{(\ell)},A^{(\ell)}\}_{\ell=0}^{L-1}</annotation></semantics></math> for the <math id="A6.SS4.SSS0.Px4.p2.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>–layer
model (<a href="#A6.E11" title="Equation 11 ‣ Setup (layered). ‣ F.4 A finite–sample gap for 𝐿 stacked LSA layers (with monotone improvement) ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>). Construct an <math id="A6.SS4.SSS0.Px4.p2.m3" class="ltx_Math" alttext="(L{+}1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(L{+}1)</annotation></semantics></math>–layer model by keeping the first
<math id="A6.SS4.SSS0.Px4.p2.m4" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> layers unchanged and appending a zero layer:
<math id="A6.SS4.SSS0.Px4.p2.m5" class="ltx_Math" alttext="b^{(L)}=0,\ A^{(L)}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>b</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mn>0</mn></mrow><mo rspace="0.667em">,</mo><mrow><msup><mi>A</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">b^{(L)}=0,\ A^{(L)}=0</annotation></semantics></math>. Then <math id="A6.SS4.SSS0.Px4.p2.m6" class="ltx_Math" alttext="y^{(L+1)}=y^{(L)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>y</mi><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><msup><mi>y</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">y^{(L+1)}=y^{(L)}</annotation></semantics></math> and thus
<math id="A6.SS4.SSS0.Px4.p2.m7" class="ltx_Math" alttext="\widehat{x}_{n+1}^{(L+1)}=\widehat{x}_{n+1}^{(L)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">\widehat{x}_{n+1}^{(L+1)}=\widehat{x}_{n+1}^{(L)}</annotation></semantics></math>, so the <math id="A6.SS4.SSS0.Px4.p2.m8" class="ltx_Math" alttext="(L{+}1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(L{+}1)</annotation></semantics></math>–layer loss
equals the <math id="A6.SS4.SSS0.Px4.p2.m9" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>–layer loss. Taking minima over the respective parameter sets
yields the displayed inequality. The <math id="A6.SS4.SSS0.Px4.p2.m10" class="ltx_Math" alttext="L=1\to 2" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>=</mo><mn>1</mn><mo stretchy="false">→</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">L=1\to 2</annotation></semantics></math> case is immediate, and the
general case follows identically.
∎</span></p>
</div>
</div>
</section>
<section id="A6.SS4.SSS0.Px5" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">What we have (and what we do not claim).</h5>

<div id="A6.SS4.SSS0.Px5.p1" class="ltx_para">
<p id="A6.SS4.SSS0.Px5.p1.1" class="ltx_p">Equation (<a href="#A6.E13" title="Equation 13 ‣ A one–shot convex relaxation for depth 𝐿. ‣ F.4 A finite–sample gap for 𝐿 stacked LSA layers (with monotone improvement) ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>) gives a finite–sample, depth–<math id="A6.SS4.SSS0.Px5.p1.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> gap</p>
<table id="A6.Ex166" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex166.m1" class="ltx_Math" alttext="\mdmathbb E\big[(\widehat{x}_{n+1}^{(L)}-x_{n+1})^{2}\big]\ \geq\ \mdmathbb E[(\widehat{x}_{n+1}^{\mathrm{LR}}-x_{n+1})^{2}]\;+\;\rho^{\top}\Delta_{n,L}\rho,\qquad\Delta_{n,L}\succeq 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em" rspace="0.500em">]</mo></mrow></mrow><mo rspace="0.778em">≥</mo><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mi>LR</mi></msubsup><mo>−</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo rspace="0.280em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.502em">+</mo><mrow><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">�</mi><mrow><mi>n</mi><mo>,</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">�</mi></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi mathvariant="normal">�</mi><mrow><mi>n</mi><mo>,</mo><mi>L</mi></mrow></msub><mo>⪰</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mdmathbb E\big[(\widehat{x}_{n+1}^{(L)}-x_{n+1})^{2}\big]\ \geq\ \mdmathbb E[(\widehat{x}_{n+1}^{\mathrm{LR}}-x_{n+1})^{2}]\;+\;\rho^{\top}\Delta_{n,L}\rho,\qquad\Delta_{n,L}\succeq 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS4.SSS0.Px5.p1.2" class="ltx_p">When duplicate features across layers make <math id="A6.SS4.SSS0.Px5.p1.m2" class="ltx_Math" alttext="\widetilde{S}_{L}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>L</mi></msub><annotation encoding="application/x-tex">\widetilde{S}_{L}</annotation></semantics></math> singular, the bound remains valid via <math id="A6.SS4.SSS0.Px5.p1.m3" class="ltx_Math" alttext="\widetilde{S}_{L}^{+}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>L</mi><mo>+</mo></msubsup><annotation encoding="application/x-tex">\widetilde{S}_{L}^{+}</annotation></semantics></math> and interprets <math id="A6.SS4.SSS0.Px5.p1.m4" class="ltx_Math" alttext="\rho^{\top}\Delta_{n,L}\rho" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">�</mi><mrow><mi>n</mi><mo>,</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">�</mi></mrow><annotation encoding="application/x-tex">\rho^{\top}\Delta_{n,L}\rho</annotation></semantics></math> as the linear–projection residual variance.
Under additional nondegeneracy, one can strengthen <math id="A6.SS4.SSS0.Px5.p1.m5" class="ltx_Math" alttext="\Delta_{n,L}\succ 0" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">�</mi><mrow><mi>n</mi><mo>,</mo><mi>L</mi></mrow></msub><mo>≻</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta_{n,L}\succ 0</annotation></semantics></math> (strict gap) by proving that the stacked covariance <math id="A6.SS4.SSS0.Px5.p1.m6" class="ltx_Math" alttext="\Sigma_{L}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">�</mi><mi>L</mi></msub><annotation encoding="application/x-tex">\Sigma_{L}</annotation></semantics></math> has a strictly positive Schur complement; this requires tracking how each layer injects new <math id="A6.SS4.SSS0.Px5.p1.m7" class="ltx_Math" alttext="\varepsilon_{n}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">"</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\varepsilon_{n}</annotation></semantics></math>–directions into the last Hankel row and is omitted here for clarity.</p>
</div>
</section>
<section id="A6.SS4.SSS0.Px6" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Remarks.</h5>

<div id="A6.SS4.SSS0.Px6.p1" class="ltx_para">
<p id="A6.SS4.SSS0.Px6.p1.1" class="ltx_p">(i) The relaxation (<a href="#A6.E12" title="Equation 12 ‣ A one–shot convex relaxation for depth 𝐿. ‣ F.4 A finite–sample gap for 𝐿 stacked LSA layers (with monotone improvement) ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>)–(<a href="#A6.E13" title="Equation 13 ‣ A one–shot convex relaxation for depth 𝐿. ‣ F.4 A finite–sample gap for 𝐿 stacked LSA layers (with monotone improvement) ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>) can be written with a <em id="A6.SS4.SSS0.Px6.p1.1.1" class="ltx_emph ltx_font_italic">deduplicated</em> stacked feature
<math id="A6.SS4.SSS0.Px6.p1.m1" class="ltx_Math" alttext="\widetilde{Z}^{[L]}=[\,g^{(0)}\otimes x,\ s^{(1)}\otimes x,\dots,s^{(L-1)}\otimes x\,]^{\top}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>Z</mi><mo>~</mo></mover><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></msup><mo>=</mo><msup><mrow><mo rspace="0.170em" stretchy="false">[</mo><mrow><mrow><msup><mi>g</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>x</mi></mrow><mo rspace="0.667em">,</mo><mrow><msup><mi>s</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>x</mi></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msup><mi>s</mi><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>x</mi></mrow></mrow><mo lspace="0.170em" stretchy="false">]</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\widetilde{Z}^{[L]}=[\,g^{(0)}\otimes x,\ s^{(1)}\otimes x,\dots,s^{(L-1)}\otimes x\,]^{\top}</annotation></semantics></math>, where <math id="A6.SS4.SSS0.Px6.p1.m2" class="ltx_Math" alttext="s^{(\ell)}" display="inline" intent=":literal"><semantics><msup><mi>s</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">s^{(\ell)}</annotation></semantics></math> keeps only the new last–row/column monomials created at layer <math id="A6.SS4.SSS0.Px6.p1.m3" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>; then <math id="A6.SS4.SSS0.Px6.p1.m4" class="ltx_Math" alttext="\widetilde{S}_{L}:=\mdmathbb E[\widetilde{Z}^{[L]}\widetilde{Z}^{[L]\top}]" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>L</mi></msub><mo>:=</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mover accent="true"><mi>Z</mi><mo>~</mo></mover><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>Z</mi><mo>~</mo></mover><mrow><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{S}_{L}:=\mdmathbb E[\widetilde{Z}^{[L]}\widetilde{Z}^{[L]\top}]</annotation></semantics></math> is typically invertible at finite <math id="A6.SS4.SSS0.Px6.p1.m5" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>.
All formulas remain the same with <math id="A6.SS4.SSS0.Px6.p1.m6" class="ltx_Math" alttext="\widetilde{S}_{L}^{+}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>L</mi><mo>+</mo></msubsup><annotation encoding="application/x-tex">\widetilde{S}_{L}^{+}</annotation></semantics></math>.
(ii) In the population limit <math id="A6.SS4.SSS0.Px6.p1.m7" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math>, <math id="A6.SS4.SSS0.Px6.p1.m8" class="ltx_Math" alttext="G^{(\ell)}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">G^{(\ell)}</annotation></semantics></math> concentrates around <math id="A6.SS4.SSS0.Px6.p1.m9" class="ltx_Math" alttext="\Gamma_{p+1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">�</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\Gamma_{p+1}</annotation></semantics></math>, the stacked feature collapses to a rank–one Kronecker line, and <math id="A6.SS4.SSS0.Px6.p1.m10" class="ltx_Math" alttext="\Delta_{n,L}\to 0" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">�</mi><mrow><mi>n</mi><mo>,</mo><mi>L</mi></mrow></msub><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta_{n,L}\to 0</annotation></semantics></math>; the order of limits matters, exactly as in the one–layer analysis.</p>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
</section>
</section>
<section id="A7" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix G </span>Chain-of-Thought (CoT) Rollout in TSF: Collapse-to-Mean and Error Compounding</h2>

<div id="A7.p1" class="ltx_para">
<p id="A7.p1.1" class="ltx_p">We study the “free–running” (a.k.a. CoT) rollout where a predictor feeds its
own outputs back as inputs instead of conditioning on future ground truth.
For linear time–series models this produces a clean, analyzable dynamical
system that (i) collapses to the mean and (ii) accumulates prediction error
to the unconditional variance at an exponential rate. We also show that,
for every forecast horizon, the Bayes (linear–regression) forecast is
pointwise optimal, hence any linear self–attention (LSA) CoT rollout is
uniformly worse and thus reaches a large–error regime <em id="A7.p1.1.1" class="ltx_emph ltx_font_italic">no later</em> than
linear regression.</p>
</div>
<section id="A7.SS0.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Setup.</h5>

<div id="A7.SS0.SSS0.Px1.p1" class="ltx_para">
<p id="A7.SS0.SSS0.Px1.p1.1" class="ltx_p">Let <math id="A7.SS0.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\{x_{t}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{x_{t}\}</annotation></semantics></math> be a zero–mean, stable <math id="A7.SS0.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\mathrm{AR}(p)" display="inline" intent=":literal"><semantics><mrow><mi>AR</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{AR}(p)</annotation></semantics></math> process as in Definition <a href="#S2.Thmtheorem2" title="Definition 2.2 (AR(𝑝) Process []). ‣ 2.1 Time Series ‣ 2 Preliminaries ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.2</span></a>, and let <math id="A7.SS0.SSS0.Px1.p1.m3" class="ltx_Math" alttext="A(\rho)" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">�</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A(\rho)</annotation></semantics></math> denote the <math id="A7.SS0.SSS0.Px1.p1.m4" class="ltx_Math" alttext="p\times p" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">p\times p</annotation></semantics></math> companion matrix,</p>
</div>
<div id="A7.SS0.SSS0.Px1.p2" class="ltx_para">
<table id="A7.Ex167" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex167.m1" class="ltx_Math" alttext="A(\rho)=\begin{pmatrix}\rho_{1}&amp;\rho_{2}&amp;\dots&amp;\rho_{p-1}&amp;\rho_{p}\\
1&amp;0&amp;\dots&amp;0&amp;0\\
0&amp;1&amp;\dots&amp;0&amp;0\\
\vdots&amp;\vdots&amp;&amp;\vdots&amp;\vdots\\
0&amp;0&amp;\dots&amp;1&amp;0\end{pmatrix}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">�</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>(</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mi mathvariant="normal">�</mi><mn>1</mn></msub></mtd><mtd><msub><mi mathvariant="normal">�</mi><mn>2</mn></msub></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><msub><mi mathvariant="normal">�</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msub></mtd><mtd><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub></mtd></mtr><mtr><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd></mtd><mtd></mtd><mtd></mtd><mtd></mtd><mtd></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">A(\rho)=\begin{pmatrix}\rho_{1}&amp;\rho_{2}&amp;\dots&amp;\rho_{p-1}&amp;\rho_{p}\\
1&amp;0&amp;\dots&amp;0&amp;0\\
0&amp;1&amp;\dots&amp;0&amp;0\\
\vdots&amp;\vdots&amp;&amp;\vdots&amp;\vdots\\
0&amp;0&amp;\dots&amp;1&amp;0\end{pmatrix},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.SS0.SSS0.Px1.p2.1" class="ltx_p">with spectral
radius <math id="A7.SS0.SSS0.Px1.p2.m1" class="ltx_Math" alttext="\varrho(A(\rho))&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">%</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">�</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\varrho(A(\rho))&lt;1</annotation></semantics></math>.
Write <math id="A7.SS0.SSS0.Px1.p2.m2" class="ltx_Math" alttext="s_{t}:=(x_{t},\dots,x_{t-p+1})^{\top}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mi>t</mi></msub><mo>:=</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">s_{t}:=(x_{t},\dots,x_{t-p+1})^{\top}</annotation></semantics></math>.
Then <math id="A7.SS0.SSS0.Px1.p2.m3" class="ltx_Math" alttext="s_{t+1}=A(\rho)s_{t}+\eta_{t+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><mrow><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">�</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>t</mi></msub></mrow><mo>+</mo><msub><mi mathvariant="normal">�</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">s_{t+1}=A(\rho)s_{t}+\eta_{t+1}</annotation></semantics></math> with
<math id="A7.SS0.SSS0.Px1.p2.m4" class="ltx_Math" alttext="\eta_{t+1}:=(\varepsilon_{t+1},0,\dots,0)^{\top}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">�</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>:=</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">"</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\eta_{t+1}:=(\varepsilon_{t+1},0,\dots,0)^{\top}</annotation></semantics></math>.</p>
</div>
</section>
<section id="A7.SS0.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">CoT rollout.</h5>

<div id="A7.SS0.SSS0.Px2.p1" class="ltx_para">
<p id="A7.SS0.SSS0.Px2.p1.1" class="ltx_p">Given an initial state <math id="A7.SS0.SSS0.Px2.p1.m1" class="ltx_Math" alttext="s_{n}=(x_{n},\dots,x_{n-p+1})^{\top}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mi>n</mi></msub><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>n</mi></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">s_{n}=(x_{n},\dots,x_{n-p+1})^{\top}</annotation></semantics></math>, a linear
predictor with coefficients <math id="A7.SS0.SSS0.Px2.p1.m2" class="ltx_Math" alttext="w\in\mdmathbb R^{p}" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>∈</mo><msup><mi>R</mi><mi>p</mi></msup></mrow><annotation encoding="application/x-tex">w\in\mdmathbb R^{p}</annotation></semantics></math> produces, in CoT mode,
a noiseless recursion</p>
<table id="A7.Ex168" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex168.m1" class="ltx_Math" alttext="\widehat{s}_{t+1}=A(w)\,\widehat{s}_{t},\qquad\widehat{s}_{0}=s_{n}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>s</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mover accent="true"><mi>s</mi><mo>^</mo></mover><mi>t</mi></msub></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mover accent="true"><mi>s</mi><mo>^</mo></mover><mn>0</mn></msub><mo>=</mo><msub><mi>s</mi><mi>n</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\widehat{s}_{t+1}=A(w)\,\widehat{s}_{t},\qquad\widehat{s}_{0}=s_{n},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.SS0.SSS0.Px2.p1.2" class="ltx_p">with forecast <math id="A7.SS0.SSS0.Px2.p1.m3" class="ltx_Math" alttext="\widehat{x}_{n+t}=e_{1}^{\top}\widehat{s}_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mi>t</mi></mrow></msub><mo>=</mo><mrow><msubsup><mi>e</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>s</mi><mo>^</mo></mover><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\widehat{x}_{n+t}=e_{1}^{\top}\widehat{s}_{t}</annotation></semantics></math>.</p>
</div>
<div id="A7.Thmtheorem1" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A7.Thmtheorem1.2" class="ltx_text ltx_font_bold">Proposition G.1</span></span><span id="A7.Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(Bayes multi–step forecast equals recursive rollout)<span id="A7.Thmtheorem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A7.Thmtheorem1.p1" class="ltx_para">
<p id="A7.Thmtheorem1.p1.1" class="ltx_p"><span id="A7.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">For any horizon <math id="A7.Thmtheorem1.p1.m1" class="ltx_Math" alttext="h\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">h\geq 1</annotation></semantics></math>, the Bayes forecast conditional on the history satisfies</span></p>
<table id="A7.Ex169" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex169.m1" class="ltx_math_unparsed" alttext="\widehat{x}^{\star}_{n+h}:=\mdmathbb E[x_{n+h}\mid x_{1:n}]\;=\;\rho^{\top}\widetilde{x}_{\,n+h-p:n+h-1}," display="block" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mi>h</mi></mrow><mo>⋆</mo></msubsup><mo>:=</mo><mi>E</mi><mrow><mo stretchy="false">[</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo rspace="0.280em" stretchy="false">]</mo></mrow><mo rspace="0.558em">=</mo><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mrow><mrow><mrow><mi>n</mi><mo>+</mo><mi>h</mi></mrow><mo>−</mo><mi>p</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>n</mi><mo>+</mo><mi>h</mi></mrow><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">\widehat{x}^{\star}_{n+h}:=\mdmathbb E[x_{n+h}\mid x_{1:n}]\;=\;\rho^{\top}\widetilde{x}_{\,n+h-p:n+h-1},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.Thmtheorem1.p1.2" class="ltx_p"><span id="A7.Thmtheorem1.p1.2.1" class="ltx_text ltx_font_italic">where the <em id="A7.Thmtheorem1.p1.2.1.1" class="ltx_emph ltx_font_upright">rolled–out state</em> <math id="A7.Thmtheorem1.p1.m2" class="ltx_Math" alttext="\widetilde{x}_{k}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>k</mi></msub><annotation encoding="application/x-tex">\widetilde{x}_{k}</annotation></semantics></math> is defined recursively by</span></p>
<table id="A7.Ex170" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex170.m1" class="ltx_Math" alttext="\widetilde{x}_{k}=\begin{cases}x_{k},&amp;k\leq n,\\[2.0pt]
\widehat{x}^{\star}_{k},&amp;k&gt;n.\end{cases}" display="block" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>k</mi></msub><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>k</mi><mo>≤</mo><mi>n</mi></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mi>k</mi><mo>⋆</mo></msubsup><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>k</mi><mo>&gt;</mo><mi>n</mi></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\widetilde{x}_{k}=\begin{cases}x_{k},&amp;k\leq n,\\[2.0pt]
\widehat{x}^{\star}_{k},&amp;k&gt;n.\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.Thmtheorem1.p1.3" class="ltx_p"><span id="A7.Thmtheorem1.p1.3.1" class="ltx_text ltx_font_italic">Equivalently, the optimal <math id="A7.Thmtheorem1.p1.m3" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math>–step forecast is obtained by repeatedly
applying the one–step predictor with coefficients <math id="A7.Thmtheorem1.p1.m4" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi mathvariant="normal">�</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> and feeding
predictions back in place of future observations.</span></p>
</div>
</div>
<div id="A7.SS0.SSS0.Px2.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A7.SS0.SSS0.Px2.p2" class="ltx_para">
<p id="A7.SS0.SSS0.Px2.p2.1" class="ltx_p"><em id="A7.SS0.SSS0.Px2.p2.1.1" class="ltx_emph ltx_font_italic">Base case (<math id="A7.SS0.SSS0.Px2.p2.m1" class="ltx_Math" alttext="h=1" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">h=1</annotation></semantics></math>).</em><span id="A7.SS0.SSS0.Px2.p2.1.2" class="ltx_text">
By the AR(<math id="A7.SS0.SSS0.Px2.p2.m2" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>) definition,</span></p>
<table id="A7.Ex171" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex171.m1" class="ltx_math_unparsed" alttext="x_{n+1}=\rho^{\top}x_{n-p+1:n}+\varepsilon_{n+1},\qquad\varepsilon_{n+1}\perp x_{1:n},\ \mdmathbb E[\varepsilon_{n+1}]=0," display="block" intent=":literal"><semantics><mrow><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><msub><mi>x</mi><mrow><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo>+</mo><msub><mi mathvariant="normal">"</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo rspace="2.167em">,</mo><msub><mi mathvariant="normal">"</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>⟂</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo rspace="0.667em">,</mo><mi>E</mi><mrow><mo stretchy="false">[</mo><msub><mi mathvariant="normal">"</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><mn>0</mn><mo>,</mo></mrow><annotation encoding="application/x-tex">x_{n+1}=\rho^{\top}x_{n-p+1:n}+\varepsilon_{n+1},\qquad\varepsilon_{n+1}\perp x_{1:n},\ \mdmathbb E[\varepsilon_{n+1}]=0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.SS0.SSS0.Px2.p2.2" class="ltx_p"><span id="A7.SS0.SSS0.Px2.p2.2.1" class="ltx_text">so</span></p>
<table id="A7.Ex172" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex172.m1" class="ltx_math_unparsed" alttext="\mdmathbb E[x_{n+1}\mid x_{1:n}]=\rho^{\top}x_{n-p+1:n}=\rho^{\top}\widetilde{x}_{\,n-p+1:n}." display="block" intent=":literal"><semantics><mrow><mi>E</mi><mrow><mo stretchy="false">[</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><msub><mi>x</mi><mrow><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo>=</mo><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mrow><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mdmathbb E[x_{n+1}\mid x_{1:n}]=\rho^{\top}x_{n-p+1:n}=\rho^{\top}\widetilde{x}_{\,n-p+1:n}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A7.SS0.SSS0.Px2.p3" class="ltx_para">
<p id="A7.SS0.SSS0.Px2.p3.1" class="ltx_p"><em id="A7.SS0.SSS0.Px2.p3.1.1" class="ltx_emph ltx_font_italic">Induction step.</em><span id="A7.SS0.SSS0.Px2.p3.1.2" class="ltx_text">
Assume the claim holds up to horizon <math id="A7.SS0.SSS0.Px2.p3.m1" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math>.
Then</span></p>
<table id="A7.Ex173" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex173.m1" class="ltx_math_unparsed" alttext="x_{n+h+1}=\rho^{\top}x_{n+h-p+1:n+h}+\varepsilon_{n+h+1}." display="block" intent=":literal"><semantics><mrow><mi>x</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>+</mo><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mi mathvariant="normal">�</mi><msup><mrow></mrow><mo>⊤</mo></msup><mi>x</mi><msub><mrow></mrow><mrow><mrow><mrow><mrow><mi>n</mi><mo>+</mo><mi>h</mi></mrow><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>n</mi><mo>+</mo><mi>h</mi></mrow></mrow></msub><mo>+</mo><mi mathvariant="normal">"</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>+</mo><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">x_{n+h+1}=\rho^{\top}x_{n+h-p+1:n+h}+\varepsilon_{n+h+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.SS0.SSS0.Px2.p3.2" class="ltx_p"><span id="A7.SS0.SSS0.Px2.p3.2.1" class="ltx_text">Taking conditional expectation on <math id="A7.SS0.SSS0.Px2.p3.m2" class="ltx_math_unparsed" alttext="x_{1:n}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">x_{1:n}</annotation></semantics></math> yields</span></p>
<table id="A7.Ex174" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex174.m1" class="ltx_math_unparsed" alttext="\mdmathbb E[x_{n+h+1}\mid x_{1:n}]=\rho^{\top}\,\mdmathbb E[x_{n+h-p+1:n+h}\mid x_{1:n}]." display="block" intent=":literal"><semantics><mrow><mi>E</mi><mrow><mo stretchy="false">[</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><mi>E</mi><mrow><mo stretchy="false">[</mo><msub><mi>x</mi><mrow><mrow><mrow><mrow><mi>n</mi><mo>+</mo><mi>h</mi></mrow><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>n</mi><mo>+</mo><mi>h</mi></mrow></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo stretchy="false">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mdmathbb E[x_{n+h+1}\mid x_{1:n}]=\rho^{\top}\,\mdmathbb E[x_{n+h-p+1:n+h}\mid x_{1:n}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.SS0.SSS0.Px2.p3.3" class="ltx_p"><span id="A7.SS0.SSS0.Px2.p3.3.1" class="ltx_text">By the induction hypothesis, for indices <math id="A7.SS0.SSS0.Px2.p3.m3" class="ltx_Math" alttext="\leq n" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">\leq n</annotation></semantics></math> the conditional expectation equals the observed value, while for indices <math id="A7.SS0.SSS0.Px2.p3.m4" class="ltx_Math" alttext="&gt;n" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>&gt;</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">&gt;n</annotation></semantics></math> it equals the Bayes forecasts <math id="A7.SS0.SSS0.Px2.p3.m5" class="ltx_Math" alttext="\widehat{x}^{\star}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mo>⋆</mo></msup><annotation encoding="application/x-tex">\widehat{x}^{\star}</annotation></semantics></math>, i.e. the recursively defined <math id="A7.SS0.SSS0.Px2.p3.m6" class="ltx_Math" alttext="\widetilde{x}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>x</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{x}</annotation></semantics></math>.
Therefore</span></p>
<table id="A7.Ex175" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex175.m1" class="ltx_math_unparsed" alttext="\mdmathbb E[x_{n+h+1}\mid x_{1:n}]=\rho^{\top}\widetilde{x}_{\,n+h-p+1:n+h}." display="block" intent=":literal"><semantics><mrow><mi>E</mi><mrow><mo stretchy="false">[</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mrow><mrow><mrow><mrow><mi>n</mi><mo>+</mo><mi>h</mi></mrow><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>n</mi><mo>+</mo><mi>h</mi></mrow></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mdmathbb E[x_{n+h+1}\mid x_{1:n}]=\rho^{\top}\widetilde{x}_{\,n+h-p+1:n+h}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A7.SS0.SSS0.Px2.p4" class="ltx_para">
<p id="A7.SS0.SSS0.Px2.p4.1" class="ltx_p"><em id="A7.SS0.SSS0.Px2.p4.1.1" class="ltx_emph ltx_font_italic">Conclusion.</em><span id="A7.SS0.SSS0.Px2.p4.1.2" class="ltx_text">
By induction, the identity holds for all horizons <math id="A7.SS0.SSS0.Px2.p4.m1" class="ltx_Math" alttext="h\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">h\geq 1</annotation></semantics></math>.
Thus the Bayes multi–step forecast is exactly the recursive rollout of the one–step predictor with weight vector <math id="A7.SS0.SSS0.Px2.p4.m2" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi mathvariant="normal">�</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A7.Thmtheorem2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A7.Thmtheorem2.2" class="ltx_text ltx_font_bold">Lemma G.2</span></span><span id="A7.Thmtheorem2.3" class="ltx_text ltx_font_bold"> </span>(Exponential decay for any stable CoT)<span id="A7.Thmtheorem2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A7.Thmtheorem2.p1" class="ltx_para">
<p id="A7.Thmtheorem2.p1.1" class="ltx_p"><span id="A7.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">If <math id="A7.Thmtheorem2.p1.m1" class="ltx_Math" alttext="\varrho(A(w))&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">%</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\varrho(A(w))&lt;1</annotation></semantics></math>, then for every consistent matrix norm there exist
<math id="A7.Thmtheorem2.p1.m2" class="ltx_Math" alttext="C&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C&gt;0</annotation></semantics></math> and <math id="A7.Thmtheorem2.p1.m3" class="ltx_Math" alttext="\beta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">�</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\beta\in(0,1)</annotation></semantics></math> such that
<math id="A7.Thmtheorem2.p1.m4" class="ltx_Math" alttext="\|\widehat{s}_{t}\|\leq C\beta^{t}\|s_{n}\|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><msub><mover accent="true"><mi>s</mi><mo>^</mo></mover><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">�</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><msub><mi>s</mi><mi>n</mi></msub><mo stretchy="false">‖</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\|\widehat{s}_{t}\|\leq C\beta^{t}\|s_{n}\|</annotation></semantics></math> and
<math id="A7.Thmtheorem2.p1.m5" class="ltx_Math" alttext="\widehat{x}_{n+t}\to 0" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mi>t</mi></mrow></msub><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\widehat{x}_{n+t}\to 0</annotation></semantics></math> exponentially fast.</span></p>
</div>
</div>
<div id="A7.SS0.SSS0.Px2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A7.SS0.SSS0.Px2.p5" class="ltx_para">
<p id="A7.SS0.SSS0.Px2.p5.1" class="ltx_p"><span id="A7.SS0.SSS0.Px2.p5.1.1" class="ltx_text">Unrolling the linear recursion gives
<math id="A7.SS0.SSS0.Px2.p5.m1" class="ltx_Math" alttext="\widehat{s}_{t}=A(w)^{t}s_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>s</mi><mo>^</mo></mover><mi>t</mi></msub><mo>=</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>n</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\widehat{s}_{t}=A(w)^{t}s_{n}</annotation></semantics></math>.
Because <math id="A7.SS0.SSS0.Px2.p5.m2" class="ltx_Math" alttext="\varrho\left(A(w)\right)&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">%</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\varrho\left(A(w)\right)&lt;1</annotation></semantics></math>, Lemma <a href="#A7.Thmtheorem6" title="Lemma G.6 (Exponential Decay from Spectral Radius Bound). ‣ Auxiliary lemmas used in ‣ Appendix G Chain-of-Thought (CoT) Rollout in TSF: Collapse-to-Mean and Error Compounding ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">G.6</span></a>
applies to <math id="A7.SS0.SSS0.Px2.p5.m3" class="ltx_Math" alttext="A(w)" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A(w)</annotation></semantics></math>: for any consistent operator norm there exist
<math id="A7.SS0.SSS0.Px2.p5.m4" class="ltx_Math" alttext="C&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C&gt;0</annotation></semantics></math> and <math id="A7.SS0.SSS0.Px2.p5.m5" class="ltx_Math" alttext="\beta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">�</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\beta\in(0,1)</annotation></semantics></math> such that
<math id="A7.SS0.SSS0.Px2.p5.m6" class="ltx_Math" alttext="\|A(w)^{t}\|\leq C\,\beta^{t}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mi>t</mi></msup></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mrow><mi>C</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi mathvariant="normal">�</mi><mi>t</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\|A(w)^{t}\|\leq C\,\beta^{t}</annotation></semantics></math>
for all <math id="A7.SS0.SSS0.Px2.p5.m7" class="ltx_Math" alttext="t\in\mdmathbb N" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">t\in\mdmathbb N</annotation></semantics></math>.
By submultiplicativity of the induced norm,</span></p>
<table id="A7.Ex176" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex176.m1" class="ltx_Math" alttext="\|\widehat{s}_{t}\|=\|A(w)^{t}s_{n}\|\leq\|A(w)^{t}\|\,\|s_{n}\|\leq C\,\beta^{t}\,\|s_{n}\|." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">‖</mo><msub><mover accent="true"><mi>s</mi><mo>^</mo></mover><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mo>=</mo><mrow><mo stretchy="false">‖</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>n</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">‖</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mi>t</mi></msup></mrow><mo stretchy="false">‖</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><msub><mi>s</mi><mi>n</mi></msub><mo stretchy="false">‖</mo></mrow></mrow><mo>≤</mo><mrow><mi>C</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi mathvariant="normal">�</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><msub><mi>s</mi><mi>n</mi></msub><mo stretchy="false">‖</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\widehat{s}_{t}\|=\|A(w)^{t}s_{n}\|\leq\|A(w)^{t}\|\,\|s_{n}\|\leq C\,\beta^{t}\,\|s_{n}\|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.SS0.SSS0.Px2.p5.2" class="ltx_p"><span id="A7.SS0.SSS0.Px2.p5.2.1" class="ltx_text">For the scalar forecast,
<math id="A7.SS0.SSS0.Px2.p5.m8" class="ltx_Math" alttext="\widehat{x}_{n+t}=e_{1}^{\top}\widehat{s}_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mi>t</mi></mrow></msub><mo>=</mo><mrow><msubsup><mi>e</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>s</mi><mo>^</mo></mover><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\widehat{x}_{n+t}=e_{1}^{\top}\widehat{s}_{t}</annotation></semantics></math>.
Let <math id="A7.SS0.SSS0.Px2.p5.m9" class="ltx_math_unparsed" alttext="\|\cdot\|_{*}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{*}</annotation></semantics></math> denote the dual norm of the chosen vector norm.
Then <math id="A7.SS0.SSS0.Px2.p5.m10" class="ltx_Math" alttext="|\widehat{x}_{n+t}|=|e_{1}^{\top}\widehat{s}_{t}|\leq\|e_{1}\|_{*}\,\|\widehat{s}_{t}\|\leq\|e_{1}\|_{*}\,C\,\beta^{t}\,\|s_{n}\|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mi>t</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mo stretchy="false">|</mo><mrow><msubsup><mi>e</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>s</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>e</mi><mn>1</mn></msub><mo stretchy="false">‖</mo></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><msub><mover accent="true"><mi>s</mi><mo>^</mo></mover><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow></mrow><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>e</mi><mn>1</mn></msub><mo stretchy="false">‖</mo></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi mathvariant="normal">�</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><msub><mi>s</mi><mi>n</mi></msub><mo stretchy="false">‖</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">|\widehat{x}_{n+t}|=|e_{1}^{\top}\widehat{s}_{t}|\leq\|e_{1}\|_{*}\,\|\widehat{s}_{t}\|\leq\|e_{1}\|_{*}\,C\,\beta^{t}\,\|s_{n}\|</annotation></semantics></math>.
Since <math id="A7.SS0.SSS0.Px2.p5.m11" class="ltx_Math" alttext="\beta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">�</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\beta\in(0,1)</annotation></semantics></math>, the right-hand side decays exponentially in <math id="A7.SS0.SSS0.Px2.p5.m12" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>,
establishing the claim.
∎</span></p>
</div>
</div>
<div id="A7.SS0.SSS0.Px2.p6" class="ltx_para">
<p id="A7.SS0.SSS0.Px2.p6.1" class="ltx_p">Thus, <em id="A7.SS0.SSS0.Px2.p6.1.1" class="ltx_emph ltx_font_italic">any</em> stable linear model (including the Bayes predictor and any
LSA fit) collapses to the mean under CoT; the only question is how quickly
its error compounds.</p>
</div>
</section>
<section id="A7.SS0.SSS0.Px3" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Bayes multi–step error (ground truth model).</h5>

<div id="A7.SS0.SSS0.Px3.p1" class="ltx_para">
<p id="A7.SS0.SSS0.Px3.p1.1" class="ltx_p">Let <sub id="A7.SS0.SSS0.Px3.p1.1.1" class="ltx_sub"><span id="A7.SS0.SSS0.Px3.p1.1.1.1" class="ltx_text ltx_font_italic">k</span></sub> be the impulse response of the AR(<math id="A7.SS0.SSS0.Px3.p1.m2" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>), i.e.,
<math id="A7.SS0.SSS0.Px3.p1.m3" class="ltx_Math" alttext="x_{t}=\sum_{k\geq 0}{}_{k}\varepsilon_{t-k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>t</mi></msub><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow></msub><mmultiscripts><mi mathvariant="normal">"</mi><mprescripts></mprescripts><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mrow></mrow><mi>k</mi><mrow></mrow></mmultiscripts></mrow></mrow><annotation encoding="application/x-tex">x_{t}=\sum_{k\geq 0}{}_{k}\varepsilon_{t-k}</annotation></semantics></math> with <math id="A7.SS0.SSS0.Px3.p1.m4" class="ltx_math_unparsed" alttext="{}_{0}=1" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mn>0</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{}_{0}=1</annotation></semantics></math> and
<math id="A7.SS0.SSS0.Px3.p1.m5" class="ltx_math_unparsed" alttext="\sum_{k}{}_{k}^{2}&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mo>∑</mo><msub><mrow></mrow><mi>k</mi></msub><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0.111em">&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\sum_{k}{}_{k}^{2}&lt;\infty</annotation></semantics></math>.
The <math id="A7.SS0.SSS0.Px3.p1.m6" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math>–step Bayes forecast <math id="A7.SS0.SSS0.Px3.p1.m7" class="ltx_math_unparsed" alttext="\widehat{x}^{*}_{n+h}=\mdmathbb E[x_{n+h}\mid x_{1:n}]" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mi>h</mi></mrow><mo>∗</mo></msubsup><mo>=</mo><mi>E</mi><mrow><mo stretchy="false">[</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{x}^{*}_{n+h}=\mdmathbb E[x_{n+h}\mid x_{1:n}]</annotation></semantics></math> equals the linear recursion with
<math id="A7.SS0.SSS0.Px3.p1.m8" class="ltx_Math" alttext="w=\rho" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>=</mo><mi mathvariant="normal">�</mi></mrow><annotation encoding="application/x-tex">w=\rho</annotation></semantics></math> (no noise injected). The forecast error
is classical:</p>
<table id="A7.E14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.E14.m1" class="ltx_math_unparsed" alttext="\mathrm{MSE}^{*}(h):=\mdmathbb E\big[(x_{n+h}-\widehat{x}^{*}_{n+h})^{2}\big]=\sigma_{\varepsilon}^{2}\sum_{k=0}^{h-1}{}_{k}^{2}." display="block" intent=":literal"><semantics><mrow><msup><mi>MSE</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow><mo>:=</mo><mi>E</mi><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mi>h</mi></mrow></msub><mo>−</mo><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mi>h</mi></mrow><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo>=</mo><msubsup><mi mathvariant="normal">�</mi><mi mathvariant="normal">"</mi><mn>2</mn></msubsup><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></munderover><mmultiscripts><mo lspace="0em">.</mo><mrow></mrow><mn>2</mn><mprescripts></mprescripts><mi>k</mi><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\mathrm{MSE}^{*}(h):=\mdmathbb E\big[(x_{n+h}-\widehat{x}^{*}_{n+h})^{2}\big]=\sigma_{\varepsilon}^{2}\sum_{k=0}^{h-1}{}_{k}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14)</span></td></tr></tbody>
</table>
<p id="A7.SS0.SSS0.Px3.p1.2" class="ltx_p">Hence <math id="A7.SS0.SSS0.Px3.p1.m9" class="ltx_math_unparsed" alttext="\mathrm{MSE}^{*}(h)\nearrow\sigma_{\varepsilon}^{2}\sum_{k\geq 0}{}_{k}^{2}=\mathrm{Var}(x_{t})" display="inline" intent=":literal"><semantics><mrow><msup><mi>MSE</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow><mo>↗</mo><msubsup><mi mathvariant="normal">�</mi><mi mathvariant="normal">"</mi><mn>2</mn></msubsup><msub><mo>∑</mo><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow></msub><mmultiscripts><mo lspace="0.111em">=</mo><mrow></mrow><mn>2</mn><mprescripts></mprescripts><mi>k</mi><mrow></mrow></mmultiscripts><mi>Var</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{MSE}^{*}(h)\nearrow\sigma_{\varepsilon}^{2}\sum_{k\geq 0}{}_{k}^{2}=\mathrm{Var}(x_{t})</annotation></semantics></math> by <a href="#A7.Thmtheorem7" title="Lemma G.7 (Wold variance identity). ‣ Auxiliary lemmas used in ‣ Appendix G Chain-of-Thought (CoT) Rollout in TSF: Collapse-to-Mean and Error Compounding ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">G.7</span></a>, and by <a href="#A7.Thmtheorem8" title="Lemma G.8 (Exponential tail bound). ‣ Auxiliary lemmas used in ‣ Appendix G Chain-of-Thought (CoT) Rollout in TSF: Collapse-to-Mean and Error Compounding ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">G.8</span></a> the
tail decays exponentially:</p>
<table id="A7.E15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.E15.m1" class="ltx_math_unparsed" alttext="\mathrm{Var}(x_{t})-\mathrm{MSE}^{*}(h)=\sigma_{\varepsilon}^{2}\sum_{k\geq h}{}_{k}^{2}\ \leq\ \frac{C^{2}\sigma_{\varepsilon}^{2}}{1-\beta^{2}}\;\beta^{2h},\qquad\text{for some }C&gt;0,\ \beta\in(0,1)." display="block" intent=":literal"><semantics><mrow><mi>Var</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>MSE</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msubsup><mi mathvariant="normal">�</mi><mi mathvariant="normal">"</mi><mn>2</mn></msubsup><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>≥</mo><mi>h</mi></mrow></munder><mmultiscripts><mo lspace="0.111em" rspace="0.778em">≤</mo><mrow></mrow><mn>2</mn><mprescripts></mprescripts><mi>k</mi><mrow></mrow></mmultiscripts><mfrac><mrow><msup><mi>C</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">�</mi><mi mathvariant="normal">"</mi><mn>2</mn></msubsup></mrow><mrow><mn>1</mn><mo>−</mo><msup><mi mathvariant="normal">�</mi><mn>2</mn></msup></mrow></mfrac><msup><mi mathvariant="normal">�</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msup><mo rspace="2.167em">,</mo><mtext>for some </mtext><mi>C</mi><mo>&gt;</mo><mn>0</mn><mo rspace="0.667em">,</mo><mi mathvariant="normal">�</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Var}(x_{t})-\mathrm{MSE}^{*}(h)=\sigma_{\varepsilon}^{2}\sum_{k\geq h}{}_{k}^{2}\ \leq\ \frac{C^{2}\sigma_{\varepsilon}^{2}}{1-\beta^{2}}\;\beta^{2h},\qquad\text{for some }C&gt;0,\ \beta\in(0,1).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15)</span></td></tr></tbody>
</table>
<p id="A7.SS0.SSS0.Px3.p1.3" class="ltx_p">For AR(1) this is exact:
<math id="A7.SS0.SSS0.Px3.p1.m10" class="ltx_Math" alttext="\mathrm{MSE}^{*}(h)=\sigma_{\varepsilon}^{2}\sum_{k=0}^{h-1}\rho^{2k}=\sigma^{2}(1-\rho^{2h})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>MSE</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi mathvariant="normal">�</mi><mi mathvariant="normal">"</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msup><mi mathvariant="normal">�</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup></mrow></mrow><mo>=</mo><mrow><msup><mi mathvariant="normal">�</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi mathvariant="normal">�</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{MSE}^{*}(h)=\sigma_{\varepsilon}^{2}\sum_{k=0}^{h-1}\rho^{2k}=\sigma^{2}(1-\rho^{2h})</annotation></semantics></math>, where <math id="A7.SS0.SSS0.Px3.p1.m11" class="ltx_Math" alttext="\sigma^{2}=\sigma_{\varepsilon}^{2}/(1-\rho^{2})" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">�</mi><mn>2</mn></msup><mo>=</mo><mrow><msubsup><mi mathvariant="normal">�</mi><mi mathvariant="normal">"</mi><mn>2</mn></msubsup><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi mathvariant="normal">�</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma^{2}=\sigma_{\varepsilon}^{2}/(1-\rho^{2})</annotation></semantics></math>.</p>
</div>
<div id="A7.Thmtheorem3" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A7.Thmtheorem3.2" class="ltx_text ltx_font_bold">Theorem G.3</span></span><span id="A7.Thmtheorem3.3" class="ltx_text ltx_font_bold"> </span>(CoT collapse and compounding error)<span id="A7.Thmtheorem3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A7.Thmtheorem3.p1" class="ltx_para">
<p id="A7.Thmtheorem3.p1.1" class="ltx_p"><span id="A7.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">For any stable AR(<math id="A7.Thmtheorem3.p1.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>),</span></p>
<table id="A7.Ex177" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex177.m1" class="ltx_Math" alttext="\widehat{x}^{*}_{n+t}\xrightarrow[t\to\infty]{}0,\qquad\mdmathbb E\big[(x_{n+t}-\widehat{x}^{*}_{n+t})^{2}\big]\nearrow\mathrm{Var}(x_{t})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mi>t</mi></mrow><mo>∗</mo></msubsup><munderover accent="true" accentunder="true"><mo>→</mo><mrow><mi mathsize="0.700em">t</mi><mo mathsize="0.700em" stretchy="false">→</mo><mi mathsize="0.700em" mathvariant="normal">∞</mi></mrow><mphantom></mphantom></munderover><mn>0</mn></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mi>t</mi></mrow></msub><mo>−</mo><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mi>t</mi></mrow><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo>↗</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\widehat{x}^{*}_{n+t}\xrightarrow[t\to\infty]{}0,\qquad\mdmathbb E\big[(x_{n+t}-\widehat{x}^{*}_{n+t})^{2}\big]\nearrow\mathrm{Var}(x_{t}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.Thmtheorem3.p1.2" class="ltx_p"><span id="A7.Thmtheorem3.p1.2.1" class="ltx_text ltx_font_italic">with exponential tail (<a href="#A7.E15" title="Equation 15 ‣ Bayes multi–step error (ground truth model). ‣ Appendix G Chain-of-Thought (CoT) Rollout in TSF: Collapse-to-Mean and Error Compounding ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>). Thus CoT error accumulates to
the process variance at an exponential rate determined by the spectrum of
<math id="A7.Thmtheorem3.p1.m2" class="ltx_Math" alttext="A(\rho)" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">�</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A(\rho)</annotation></semantics></math>.</span></p>
</div>
</div>
</section>
<section id="A7.SS0.SSS0.Px4" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">LSA (or any alternative) is uniformly dominated at every horizon.</h5>

<div id="A7.SS0.SSS0.Px4.p1" class="ltx_para">
<p id="A7.SS0.SSS0.Px4.p1.1" class="ltx_p">Fix a horizon <math id="A7.SS0.SSS0.Px4.p1.m1" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> and let <math id="A7.SS0.SSS0.Px4.p1.m2" class="ltx_Math" alttext="\widehat{x}^{\mathrm{LSA}}_{n+h}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mi>h</mi></mrow><mi>LSA</mi></msubsup><annotation encoding="application/x-tex">\widehat{x}^{\mathrm{LSA}}_{n+h}</annotation></semantics></math> be the CoT
forecast delivered by any trained one–layer LSA model (or an <math id="A7.SS0.SSS0.Px4.p1.m3" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>–layer
stack run in CoT; the argument is identical). Since CoT is noiseless,
<math id="A7.SS0.SSS0.Px4.p1.m4" class="ltx_Math" alttext="\widehat{x}^{\mathrm{LSA}}_{n+h}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mi>h</mi></mrow><mi>LSA</mi></msubsup><annotation encoding="application/x-tex">\widehat{x}^{\mathrm{LSA}}_{n+h}</annotation></semantics></math> is a deterministic measurable function
of the history <math id="A7.SS0.SSS0.Px4.p1.m5" class="ltx_math_unparsed" alttext="x_{1:n}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">x_{1:n}</annotation></semantics></math>. By the <math id="A7.SS0.SSS0.Px4.p1.m6" class="ltx_Math" alttext="L^{2}" display="inline" intent=":literal"><semantics><msup><mi>L</mi><mn>2</mn></msup><annotation encoding="application/x-tex">L^{2}</annotation></semantics></math> projection property of the
conditional expectation,</p>
<table id="A7.E16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.E16.m1" class="ltx_math_unparsed" alttext="\mdmathbb E\big[(x_{n+h}-g(x_{1:n}))^{2}\big]=\mathrm{MSE}^{*}(h)+\mdmathbb E\big[(\widehat{x}^{*}_{n+h}-g(x_{1:n}))^{2}\big]\quad\ \forall\,g." display="block" intent=":literal"><semantics><mrow><mi>E</mi><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mi>h</mi></mrow></msub><mo>−</mo><mi>g</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo>=</mo><msup><mi>MSE</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>E</mi><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mi>h</mi></mrow><mo>∗</mo></msubsup><mo>−</mo><mi>g</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em" rspace="0.167em">]</mo></mrow><mo rspace="0.337em">∀</mo><mi>g</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mdmathbb E\big[(x_{n+h}-g(x_{1:n}))^{2}\big]=\mathrm{MSE}^{*}(h)+\mdmathbb E\big[(\widehat{x}^{*}_{n+h}-g(x_{1:n}))^{2}\big]\quad\ \forall\,g.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
<p id="A7.SS0.SSS0.Px4.p1.2" class="ltx_p">Plugging <math id="A7.SS0.SSS0.Px4.p1.m7" class="ltx_Math" alttext="g=\widehat{x}^{\mathrm{LSA}}_{n+h}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mi>h</mi></mrow><mi>LSA</mi></msubsup></mrow><annotation encoding="application/x-tex">g=\widehat{x}^{\mathrm{LSA}}_{n+h}</annotation></semantics></math> yields the horizonwise
dominance</p>
<table id="A7.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.E17.m1" class="ltx_Math" alttext="\mathrm{MSE}^{\mathrm{LSA}}(h):=\mdmathbb E\big[(x_{n+h}-\widehat{x}^{\mathrm{LSA}}_{n+h})^{2}\big]\ \geq\ \mathrm{MSE}^{*}(h)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>MSE</mi><mi>LSA</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mi>h</mi></mrow></msub><mo>−</mo><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mi>h</mi></mrow><mi>LSA</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em" rspace="0.500em">]</mo></mrow></mrow><mo rspace="0.778em">≥</mo><mrow><msup><mi>MSE</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathrm{MSE}^{\mathrm{LSA}}(h):=\mdmathbb E\big[(x_{n+h}-\widehat{x}^{\mathrm{LSA}}_{n+h})^{2}\big]\ \geq\ \mathrm{MSE}^{*}(h),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
</table>
<p id="A7.SS0.SSS0.Px4.p1.3" class="ltx_p">with strict inequality unless <math id="A7.SS0.SSS0.Px4.p1.m8" class="ltx_Math" alttext="\widehat{x}^{\mathrm{LSA}}_{n+h}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mi>h</mi></mrow><mi>LSA</mi></msubsup><annotation encoding="application/x-tex">\widehat{x}^{\mathrm{LSA}}_{n+h}</annotation></semantics></math> coincides
with <math id="A7.SS0.SSS0.Px4.p1.m9" class="ltx_Math" alttext="\widehat{x}^{*}_{n+h}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mi>h</mi></mrow><mo>∗</mo></msubsup><annotation encoding="application/x-tex">\widehat{x}^{*}_{n+h}</annotation></semantics></math> almost surely. Because one–layer LSA has a
strict finite–sample gap (Section <a href="#A6.SS2" title="F.2 A finite-sample optimality gap for one-layer LSA ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.2</span></a>), equality fails
generically already at <math id="A7.SS0.SSS0.Px4.p1.m10" class="ltx_Math" alttext="h=1" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">h=1</annotation></semantics></math>, and thus for all horizons.</p>
</div>
<div id="A7.Thmtheorem4" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A7.Thmtheorem4.2" class="ltx_text ltx_font_bold">Corollary G.4</span></span><span id="A7.Thmtheorem4.3" class="ltx_text ltx_font_bold"> </span>(Earlier threshold crossing for LSA)<span id="A7.Thmtheorem4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A7.Thmtheorem4.p1" class="ltx_para">
<p id="A7.Thmtheorem4.p1.1" class="ltx_p"><span id="A7.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Fix any <math id="A7.Thmtheorem4.p1.m1" class="ltx_Math" alttext="\tau\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">�</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau\in(0,1)</annotation></semantics></math> and define the <em id="A7.Thmtheorem4.p1.1.1.1" class="ltx_emph ltx_font_upright">failure horizon</em></span></p>
<table id="A7.Ex178" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex178.m1" class="ltx_math_unparsed" alttext="H_{\tau}(g):=\inf\bigl\{h\geq 1:\,\mdmathbb E\big[(x_{n+h}-g_{h}(x_{1:n}))^{2}\big]\ \geq\ \tau\,\mathrm{Var}(x_{t})\bigr\}." display="block" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi mathvariant="normal">�</mi></msub><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.1389em">:=</mo><mo lspace="0.1389em" movablelimits="false" rspace="0em">inf</mo><mrow><mo stretchy="false">{</mo><mi>h</mi><mo>≥</mo><mn>1</mn><mo lspace="0.278em" rspace="0.448em">:</mo><mi>E</mi><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mi>h</mi></mrow></msub><mo>−</mo><msub><mi>g</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em" rspace="0.500em">]</mo></mrow><mo rspace="0.778em">≥</mo><mi mathvariant="normal">�</mi><mi>Var</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H_{\tau}(g):=\inf\bigl\{h\geq 1:\,\mdmathbb E\big[(x_{n+h}-g_{h}(x_{1:n}))^{2}\big]\ \geq\ \tau\,\mathrm{Var}(x_{t})\bigr\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.Thmtheorem4.p1.2" class="ltx_p"><span id="A7.Thmtheorem4.p1.2.1" class="ltx_text ltx_font_italic">Then <math id="A7.Thmtheorem4.p1.m2" class="ltx_Math" alttext="H_{\tau}(\widehat{x}^{\mathrm{LSA}})\leq H_{\tau}(\widehat{x}^{*})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>H</mi><mi mathvariant="normal">�</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mi>LSA</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>H</mi><mi mathvariant="normal">�</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H_{\tau}(\widehat{x}^{\mathrm{LSA}})\leq H_{\tau}(\widehat{x}^{*})</annotation></semantics></math>
for every <math id="A7.Thmtheorem4.p1.m3" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi mathvariant="normal">�</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>, with strict inequality for all <math id="A7.Thmtheorem4.p1.m4" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi mathvariant="normal">�</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> on a set of
positive measure (whenever (<a href="#A7.E17" title="Equation 17 ‣ LSA (or any alternative) is uniformly dominated at every horizon. ‣ Appendix G Chain-of-Thought (CoT) Rollout in TSF: Collapse-to-Mean and Error Compounding ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>) is strict at some <math id="A7.Thmtheorem4.p1.m5" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math>).
In words: for any error threshold, LSA under CoT reaches the
large–error regime <em id="A7.Thmtheorem4.p1.2.1.1" class="ltx_emph ltx_font_upright">no later</em> than the Bayes linear predictor.</span></p>
</div>
</div>
</section>
<section id="A7.SS0.SSS0.Px5" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Quantitative rates.</h5>

<div id="A7.SS0.SSS0.Px5.p1" class="ltx_para">
<p id="A7.SS0.SSS0.Px5.p1.1" class="ltx_p">Combining Lemma <a href="#A7.Thmtheorem2" title="Lemma G.2 (Exponential decay for any stable CoT). ‣ CoT rollout. ‣ Appendix G Chain-of-Thought (CoT) Rollout in TSF: Collapse-to-Mean and Error Compounding ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">G.2</span></a> with the orthogonality
identity (<a href="#A7.E16" title="Equation 16 ‣ LSA (or any alternative) is uniformly dominated at every horizon. ‣ Appendix G Chain-of-Thought (CoT) Rollout in TSF: Collapse-to-Mean and Error Compounding ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>) shows that</p>
<table id="A7.Ex179" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex179.m1" class="ltx_Math" alttext="\mathrm{Var}(x_{t})-\mathrm{MSE}^{\mathrm{LSA}}(h)\leq\mathrm{Var}(x_{t})-\mathrm{MSE}^{*}(h)\;\leq\;\frac{C^{2}\sigma_{\varepsilon}^{2}}{1-\beta^{2}}\;\beta^{2h},\qquad\text{for some }C&gt;0,\ \beta\in(0,1)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>MSE</mi><mi>LSA</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>MSE</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.558em">≤</mo><mrow><mfrac><mrow><msup><mi>C</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">�</mi><mi mathvariant="normal">"</mi><mn>2</mn></msubsup></mrow><mrow><mn>1</mn><mo>−</mo><msup><mi mathvariant="normal">�</mi><mn>2</mn></msup></mrow></mfrac><mo lspace="0.280em" rspace="0em">​</mo><msup><mi mathvariant="normal">�</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msup></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mtext>for some </mtext><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo rspace="0.667em">,</mo><mrow><mi mathvariant="normal">�</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Var}(x_{t})-\mathrm{MSE}^{\mathrm{LSA}}(h)\leq\mathrm{Var}(x_{t})-\mathrm{MSE}^{*}(h)\;\leq\;\frac{C^{2}\sigma_{\varepsilon}^{2}}{1-\beta^{2}}\;\beta^{2h},\qquad\text{for some }C&gt;0,\ \beta\in(0,1).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.SS0.SSS0.Px5.p1.2" class="ltx_p">Hence whenever the left-hand side remains positive, it must also collapse to zero at least exponentially fast; if it turns negative (overshoot), <a href="#A7.Thmtheorem4" title="Corollary G.4 (Earlier threshold crossing for LSA). ‣ LSA (or any alternative) is uniformly dominated at every horizon. ‣ Appendix G Chain-of-Thought (CoT) Rollout in TSF: Collapse-to-Mean and Error Compounding ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Corollary</span> <span class="ltx_text ltx_ref_tag">G.4</span></a> guarantees that LSA in CoT still reaches the large–error regime strictly earlier and more severely than linear regression.</p>
</div>
<div id="A7.Thmtheorem5" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A7.Thmtheorem5.2" class="ltx_text ltx_font_bold">Remark G.5</span></span><span id="A7.Thmtheorem5.3" class="ltx_text ltx_font_bold"> </span>(AR(1): closed forms and “rapid compounding”)<span id="A7.Thmtheorem5.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A7.Thmtheorem5.p1" class="ltx_para">
<p id="A7.Thmtheorem5.p1.1" class="ltx_p"><span id="A7.Thmtheorem5.p1.1.1" class="ltx_text ltx_font_italic">For AR(1), <math id="A7.Thmtheorem5.p1.m1" class="ltx_Math" alttext="\mathrm{MSE}^{*}(h)=\sigma^{2}(1-\rho^{2h})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>MSE</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi mathvariant="normal">�</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi mathvariant="normal">�</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{MSE}^{*}(h)=\sigma^{2}(1-\rho^{2h})</annotation></semantics></math> so that the
residual to the variance decays like <math id="A7.Thmtheorem5.p1.m2" class="ltx_Math" alttext="\rho^{2h}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">�</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msup><annotation encoding="application/x-tex">\rho^{2h}</annotation></semantics></math>. The “half–life” to
reach <math id="A7.Thmtheorem5.p1.m3" class="ltx_Math" alttext="50\%" display="inline" intent=":literal"><semantics><mrow><mn>50</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">50\%</annotation></semantics></math> of the unconditional variance is
<math id="A7.Thmtheorem5.p1.m4" class="ltx_Math" alttext="h_{1/2}=\log(1/2)/\log(\rho^{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msub><mo>=</mo><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">�</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">h_{1/2}=\log(1/2)/\log(\rho^{2})</annotation></semantics></math>; e.g., with <math id="A7.Thmtheorem5.p1.m5" class="ltx_Math" alttext="\rho=0.9" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">�</mi><mo>=</mo><mn>0.9</mn></mrow><annotation encoding="application/x-tex">\rho=0.9</annotation></semantics></math> one already has
<math id="A7.Thmtheorem5.p1.m6" class="ltx_Math" alttext="\mathrm{MSE}^{*}(5)\approx 0.65\,\sigma^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>MSE</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>5</mn><mo stretchy="false">)</mo></mrow></mrow><mo>≈</mo><mrow><mn>0.65</mn><mo lspace="0.170em" rspace="0em">​</mo><msup><mi mathvariant="normal">�</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\mathrm{MSE}^{*}(5)\approx 0.65\,\sigma^{2}</annotation></semantics></math> and
<math id="A7.Thmtheorem5.p1.m7" class="ltx_Math" alttext="\mathrm{MSE}^{*}(10)\approx 0.88\,\sigma^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>MSE</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>10</mn><mo stretchy="false">)</mo></mrow></mrow><mo>≈</mo><mrow><mn>0.88</mn><mo lspace="0.170em" rspace="0em">​</mo><msup><mi mathvariant="normal">�</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\mathrm{MSE}^{*}(10)\approx 0.88\,\sigma^{2}</annotation></semantics></math>. This quantifies the
<em id="A7.Thmtheorem5.p1.1.1.1" class="ltx_emph ltx_font_upright">rapid</em> accumulation of CoT error even for the Bayes predictor; by
(<a href="#A7.E17" title="Equation 17 ‣ LSA (or any alternative) is uniformly dominated at every horizon. ‣ Appendix G Chain-of-Thought (CoT) Rollout in TSF: Collapse-to-Mean and Error Compounding ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>), LSA CoT is uniformly worse at every horizon.</span></p>
</div>
</div>
</section>
<section id="A7.SS0.SSS0.Px6" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Takeaways.</h5>

<div id="A7.SS0.SSS0.Px6.p1" class="ltx_para">
<p id="A7.SS0.SSS0.Px6.p1.1" class="ltx_p">(i) Any linear CoT rollout collapses to the mean (Lemma <a href="#A7.Thmtheorem2" title="Lemma G.2 (Exponential decay for any stable CoT). ‣ CoT rollout. ‣ Appendix G Chain-of-Thought (CoT) Rollout in TSF: Collapse-to-Mean and Error Compounding ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">G.2</span></a>), so
its long–horizon RMSE saturates at the unconditional standard deviation of
the process. (ii) The Bayes/linear–regression forecast is <em id="A7.SS0.SSS0.Px6.p1.1.1" class="ltx_emph ltx_font_italic">horizonwise</em>
optimal (Theorem <a href="#A7.Thmtheorem3" title="Theorem G.3 (CoT collapse and compounding error). ‣ Bayes multi–step error (ground truth model). ‣ Appendix G Chain-of-Thought (CoT) Rollout in TSF: Collapse-to-Mean and Error Compounding ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">G.3</span></a> and (<a href="#A7.E16" title="Equation 16 ‣ LSA (or any alternative) is uniformly dominated at every horizon. ‣ Appendix G Chain-of-Thought (CoT) Rollout in TSF: Collapse-to-Mean and Error Compounding ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>)); any
LSA CoT forecast is uniformly dominated at each horizon
(<a href="#A7.E17" title="Equation 17 ‣ LSA (or any alternative) is uniformly dominated at every horizon. ‣ Appendix G Chain-of-Thought (CoT) Rollout in TSF: Collapse-to-Mean and Error Compounding ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>). (iii) Consequently, for any fixed error threshold,
LSA reaches the large–error regime at least as early as linear regression
(Corollary <a href="#A7.Thmtheorem4" title="Corollary G.4 (Earlier threshold crossing for LSA). ‣ LSA (or any alternative) is uniformly dominated at every horizon. ‣ Appendix G Chain-of-Thought (CoT) Rollout in TSF: Collapse-to-Mean and Error Compounding ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">G.4</span></a>). (iv) Both approaches exhibit
exponential convergence of the error to the variance, with a rate governed
by the spectral radius of the corresponding companion matrix; for AR(1) the
entire trajectory is explicit.</p>
</div>
</section>
<section id="A7.SS0.SSSx1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection">Auxiliary lemmas used in <a href="#A7" title="Appendix G Chain-of-Thought (CoT) Rollout in TSF: Collapse-to-Mean and Error Compounding ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Appendix</span> <span class="ltx_text ltx_ref_tag">G</span></a></h4>

<div id="A7.Thmtheorem6" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A7.Thmtheorem6.2" class="ltx_text ltx_font_bold">Lemma G.6</span></span><span id="A7.Thmtheorem6.3" class="ltx_text ltx_font_bold"> </span>(Exponential Decay from Spectral Radius Bound)<span id="A7.Thmtheorem6.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A7.Thmtheorem6.p1" class="ltx_para">
<p id="A7.Thmtheorem6.p1.1" class="ltx_p"><span id="A7.Thmtheorem6.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A7.Thmtheorem6.p1.m1" class="ltx_Math" alttext="A\in\mdmathbb{R}^{p\times p}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>∈</mo><msup><mi>R</mi><mrow><mi>p</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>p</mi></mrow></msup></mrow><annotation encoding="application/x-tex">A\in\mdmathbb{R}^{p\times p}</annotation></semantics></math> be a square matrix with spectral radius strictly less than one, i.e., <math id="A7.Thmtheorem6.p1.m2" class="ltx_Math" alttext="\varrho(A)&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">%</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\varrho(A)&lt;1</annotation></semantics></math>.
Then for any consistent matrix norm <math id="A7.Thmtheorem6.p1.m3" class="ltx_math_unparsed" alttext="\|\cdot\|" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">∥</mo></mrow><annotation encoding="application/x-tex">\|\cdot\|</annotation></semantics></math>, there exist constants <math id="A7.Thmtheorem6.p1.m4" class="ltx_Math" alttext="C&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C&gt;0</annotation></semantics></math> and <math id="A7.Thmtheorem6.p1.m5" class="ltx_Math" alttext="\beta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">�</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\beta\in(0,1)</annotation></semantics></math> such that</span></p>
<table id="A7.Ex180" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex180.m1" class="ltx_Math" alttext="\|A^{t}\|\leq C\beta^{t}\qquad\text{for all }t\in\mdmathbb{N}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">‖</mo><msup><mi>A</mi><mi>t</mi></msup><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">�</mi><mi>t</mi></msup></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mrow><mtext class="ltx_mathvariant_italic">for all </mtext><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>∈</mo><mi>N</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|A^{t}\|\leq C\beta^{t}\qquad\text{for all }t\in\mdmathbb{N}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A7.SS0.SSSx1.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A7.SS0.SSSx1.p1" class="ltx_para">
<p id="A7.SS0.SSSx1.p1.1" class="ltx_p"><span id="A7.SS0.SSSx1.p1.1.1" class="ltx_text">By the Gelfand formula (see, e.g., <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib36" title="" class="ltx_ref">36</a>, Chapter 5]</cite>), we have</span></p>
<table id="A7.Ex181" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex181.m1" class="ltx_Math" alttext="\varrho(A)=\lim_{t\to\infty}\|A^{t}\|^{1/t}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">%</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><msup><mrow><mo stretchy="false">‖</mo><msup><mi>A</mi><mi>t</mi></msup><mo stretchy="false">‖</mo></mrow><mrow><mn>1</mn><mo>/</mo><mi>t</mi></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\varrho(A)=\lim_{t\to\infty}\|A^{t}\|^{1/t},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.SS0.SSSx1.p1.2" class="ltx_p"><span id="A7.SS0.SSSx1.p1.2.1" class="ltx_text">for any sub-multiplicative (i.e., consistent) matrix norm <math id="A7.SS0.SSSx1.p1.m1" class="ltx_math_unparsed" alttext="\|\cdot\|" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">∥</mo></mrow><annotation encoding="application/x-tex">\|\cdot\|</annotation></semantics></math>.
Thus, for any <math id="A7.SS0.SSSx1.p1.m2" class="ltx_Math" alttext="\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">�</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon&gt;0</annotation></semantics></math> such that <math id="A7.SS0.SSSx1.p1.m3" class="ltx_Math" alttext="\varrho(A)+\epsilon&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">%</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi mathvariant="normal">�</mi></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\varrho(A)+\epsilon&lt;1</annotation></semantics></math>, there exists <math id="A7.SS0.SSSx1.p1.m4" class="ltx_Math" alttext="t_{0}\in\mdmathbb{N}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>∈</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">t_{0}\in\mdmathbb{N}</annotation></semantics></math> such that</span></p>
<table id="A7.Ex182" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex182.m1" class="ltx_Math" alttext="\|A^{t}\|\leq(\varrho(A)+\epsilon)^{t}=:\beta^{t},\quad\forall t\geq t_{0}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">‖</mo><msup><mi>A</mi><mi>t</mi></msup><mo stretchy="false">‖</mo></mrow><mo>≤</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">%</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi mathvariant="normal">�</mi></mrow><mo stretchy="false">)</mo></mrow><mi>t</mi></msup><mo>=</mo><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><msup><mi mathvariant="normal">�</mi><mi>t</mi></msup></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>t</mi></mrow><mo>≥</mo><msub><mi>t</mi><mn>0</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|A^{t}\|\leq(\varrho(A)+\epsilon)^{t}=:\beta^{t},\quad\forall t\geq t_{0}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.SS0.SSSx1.p1.3" class="ltx_p"><span id="A7.SS0.SSSx1.p1.3.1" class="ltx_text">Define</span></p>
<table id="A7.Ex183" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex183.m1" class="ltx_Math" alttext="C:=\max\{1,\max_{0\leq t&lt;t_{0}}\frac{\|A^{t}\|}{\beta^{t}}\}." display="block" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo>:=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mrow><munder><mi>max</mi><mrow><mn>0</mn><mo>≤</mo><mi>t</mi><mo>&lt;</mo><msub><mi>t</mi><mn>0</mn></msub></mrow></munder><mo lspace="0.167em">⁡</mo><mfrac><mrow><mo stretchy="false">‖</mo><msup><mi>A</mi><mi>t</mi></msup><mo stretchy="false">‖</mo></mrow><msup><mi mathvariant="normal">�</mi><mi>t</mi></msup></mfrac></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">C:=\max\{1,\max_{0\leq t&lt;t_{0}}\frac{\|A^{t}\|}{\beta^{t}}\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.SS0.SSSx1.p1.4" class="ltx_p"><span id="A7.SS0.SSSx1.p1.4.1" class="ltx_text">Then for all <math id="A7.SS0.SSSx1.p1.m5" class="ltx_Math" alttext="t\in\mdmathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">t\in\mdmathbb{N}</annotation></semantics></math>, we have <math id="A7.SS0.SSSx1.p1.m6" class="ltx_Math" alttext="\|A^{t}\|\leq C\beta^{t}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><msup><mi>A</mi><mi>t</mi></msup><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">�</mi><mi>t</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\|A^{t}\|\leq C\beta^{t}</annotation></semantics></math> as claimed.
∎</span></p>
</div>
</div>
<div id="A7.Thmtheorem7" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A7.Thmtheorem7.2" class="ltx_text ltx_font_bold">Lemma G.7</span></span><span id="A7.Thmtheorem7.3" class="ltx_text ltx_font_bold"> </span>(Wold variance identity)<span id="A7.Thmtheorem7.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A7.Thmtheorem7.p1" class="ltx_para">
<p id="A7.Thmtheorem7.p1.1" class="ltx_p"><span id="A7.Thmtheorem7.p1.1.1" class="ltx_text ltx_font_italic">For a stable AR(<math id="A7.Thmtheorem7.p1.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>) with Wold expansion
<math id="A7.Thmtheorem7.p1.m2" class="ltx_Math" alttext="x_{t}=\sum_{k\geq 0}{}_{k}\varepsilon_{t-k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>t</mi></msub><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow></msub><mmultiscripts><mi mathvariant="normal">"</mi><mprescripts></mprescripts><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mrow></mrow><mi>k</mi><mrow></mrow></mmultiscripts></mrow></mrow><annotation encoding="application/x-tex">x_{t}=\sum_{k\geq 0}{}_{k}\varepsilon_{t-k}</annotation></semantics></math>, where <math id="A7.Thmtheorem7.p1.m3" class="ltx_Math" alttext="\varepsilon_{t}\overset{\text{i.i.d.}}{\sim}\mathcal{N}(0,\sigma_{\varepsilon}^{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">"</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo>∼</mo><mtext class="ltx_mathvariant_italic" mathsize="0.700em">i.i.d.</mtext></mover><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msubsup><mi mathvariant="normal">�</mi><mi mathvariant="normal">"</mi><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\varepsilon_{t}\overset{\text{i.i.d.}}{\sim}\mathcal{N}(0,\sigma_{\varepsilon}^{2})</annotation></semantics></math>,
the unconditional variance satisfies</span></p>
<table id="A7.Ex184" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex184.m1" class="ltx_math_unparsed" alttext="\mathrm{Var}(x_{t})=\sigma_{\varepsilon}^{2}\sum_{k\geq 0}{}_{k}^{2}." display="block" intent=":literal"><semantics><mrow><mi>Var</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><msubsup><mi mathvariant="normal">�</mi><mi mathvariant="normal">"</mi><mn>2</mn></msubsup><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow></munder><mmultiscripts><mo lspace="0em">.</mo><mrow></mrow><mn>2</mn><mprescripts></mprescripts><mi>k</mi><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\mathrm{Var}(x_{t})=\sigma_{\varepsilon}^{2}\sum_{k\geq 0}{}_{k}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A7.SS0.SSSx1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A7.SS0.SSSx1.p2" class="ltx_para">
<p id="A7.SS0.SSSx1.p2.1" class="ltx_p"><span id="A7.SS0.SSSx1.p2.1.1" class="ltx_text">From the Wold representation <math id="A7.SS0.SSSx1.p2.m1" class="ltx_Math" alttext="x_{t}=\sum_{k\geq 0}{}_{k}\varepsilon_{t-k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>t</mi></msub><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow></msub><mmultiscripts><mi mathvariant="normal">"</mi><mprescripts></mprescripts><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mrow></mrow><mi>k</mi><mrow></mrow></mmultiscripts></mrow></mrow><annotation encoding="application/x-tex">x_{t}=\sum_{k\geq 0}{}_{k}\varepsilon_{t-k}</annotation></semantics></math>, we have
<math id="A7.SS0.SSSx1.p2.m2" class="ltx_Math" alttext="\mdmathbb E[x_{t}]=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mdmathbb E[x_{t}]=0</annotation></semantics></math> and</span></p>
<table id="A7.Ex185" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex185.m1" class="ltx_Math" alttext="\mathrm{Var}(x_{t})=\mdmathbb E[x_{t}^{2}]=\mdmathbb E\left[\Big(\sum_{k\geq 0}{}_{k}\varepsilon_{t-k}\Big)^{2}\right]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>x</mi><mi>t</mi><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow></munder><mmultiscripts><mi mathvariant="normal">"</mi><mprescripts></mprescripts><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mrow></mrow><mi>k</mi><mrow></mrow></mmultiscripts></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Var}(x_{t})=\mdmathbb E[x_{t}^{2}]=\mdmathbb E\left[\Big(\sum_{k\geq 0}{}_{k}\varepsilon_{t-k}\Big)^{2}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.SS0.SSSx1.p2.2" class="ltx_p"><span id="A7.SS0.SSSx1.p2.2.1" class="ltx_text">Cross terms vanish because the <math id="A7.SS0.SSSx1.p2.m3" class="ltx_Math" alttext="\varepsilon_{t-k}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">"</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\varepsilon_{t-k}</annotation></semantics></math> are independent with mean zero,
leaving <math id="A7.SS0.SSSx1.p2.m4" class="ltx_math_unparsed" alttext="\sum_{k\geq 0}{}_{k}^{2}\,\mdmathbb E[\varepsilon_{t-k}^{2}]=\sigma_{\varepsilon}^{2}\sum_{k\geq 0}{}_{k}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∑</mo><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow></msub><mmultiscripts><mi>E</mi><mrow></mrow><mn>2</mn><mprescripts></mprescripts><mi>k</mi><mrow></mrow></mmultiscripts><mrow><mo stretchy="false">[</mo><msubsup><mi mathvariant="normal">"</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow><mo>=</mo><msubsup><mi mathvariant="normal">�</mi><mi mathvariant="normal">"</mi><mn>2</mn></msubsup><msub><mo>∑</mo><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow></msub><mmultiscripts><mphantom></mphantom><mrow></mrow><mn>2</mn><mprescripts></mprescripts><mi>k</mi><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\sum_{k\geq 0}{}_{k}^{2}\,\mdmathbb E[\varepsilon_{t-k}^{2}]=\sigma_{\varepsilon}^{2}\sum_{k\geq 0}{}_{k}^{2}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A7.Thmtheorem8" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A7.Thmtheorem8.2" class="ltx_text ltx_font_bold">Lemma G.8</span></span><span id="A7.Thmtheorem8.3" class="ltx_text ltx_font_bold"> </span>(Exponential tail bound)<span id="A7.Thmtheorem8.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A7.Thmtheorem8.p1" class="ltx_para">
<p id="A7.Thmtheorem8.p1.1" class="ltx_p"><span id="A7.Thmtheorem8.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A7.Thmtheorem8.p1.m1" class="ltx_Math" alttext="A(\rho)" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">�</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A(\rho)</annotation></semantics></math> be the AR(<math id="A7.Thmtheorem8.p1.m2" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>) companion matrix with spectral radius <math id="A7.Thmtheorem8.p1.m3" class="ltx_Math" alttext="\varrho(A(\rho))&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">%</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">�</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\varrho(A(\rho))&lt;1</annotation></semantics></math>.
Then the impulse response coefficients obey <math id="A7.Thmtheorem8.p1.m4" class="ltx_math_unparsed" alttext="|{}_{k}|\leq C\beta^{k}" display="inline" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mrow></mrow><mi>k</mi></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">≤</mo><mi>C</mi><mi mathvariant="normal">�</mi><msup><mrow></mrow><mi>k</mi></msup></mrow><annotation encoding="application/x-tex">|{}_{k}|\leq C\beta^{k}</annotation></semantics></math> for some <math id="A7.Thmtheorem8.p1.m5" class="ltx_Math" alttext="C&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C&gt;0</annotation></semantics></math> and <math id="A7.Thmtheorem8.p1.m6" class="ltx_Math" alttext="\beta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">�</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\beta\in(0,1)</annotation></semantics></math>.
Consequently,</span></p>
<table id="A7.Ex186" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex186.m1" class="ltx_math_unparsed" alttext="\sigma_{\varepsilon}^{2}\sum_{k\geq h}{}_{k}^{2}\ \leq\ \frac{C^{2}\sigma_{\varepsilon}^{2}}{1-\beta^{2}}\,\beta^{2h}." display="block" intent=":literal"><semantics><mrow><mi mathvariant="normal">�</mi><msub><mrow></mrow><mi mathvariant="normal">"</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi>k</mi><mo>≥</mo><mi>h</mi></mrow></msub><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0.111em" rspace="0.778em">≤</mo><mfrac><mrow><msup><mi>C</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">�</mi><mi mathvariant="normal">"</mi><mn>2</mn></msubsup></mrow><mrow><mn>1</mn><mo>−</mo><msup><mi mathvariant="normal">�</mi><mn>2</mn></msup></mrow></mfrac><mi mathvariant="normal">�</mi><msup><mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sigma_{\varepsilon}^{2}\sum_{k\geq h}{}_{k}^{2}\ \leq\ \frac{C^{2}\sigma_{\varepsilon}^{2}}{1-\beta^{2}}\,\beta^{2h}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A7.SS0.SSSx1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A7.SS0.SSSx1.p3" class="ltx_para">
<p id="A7.SS0.SSSx1.p3.1" class="ltx_p"><span id="A7.SS0.SSSx1.p3.1.1" class="ltx_text">By state recursion, <math id="A7.SS0.SSSx1.p3.m1" class="ltx_math_unparsed" alttext="{}_{k}=e_{1}^{\top}A(\rho)^{k}e_{1}" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mo>=</mo><mprescripts></mprescripts><mi>k</mi><mrow></mrow></mmultiscripts><msubsup><mi>e</mi><mn>1</mn><mo>⊤</mo></msubsup><mi>A</mi><msup><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">�</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><msub><mi>e</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">{}_{k}=e_{1}^{\top}A(\rho)^{k}e_{1}</annotation></semantics></math>.
Because <math id="A7.SS0.SSSx1.p3.m2" class="ltx_Math" alttext="\varrho\left(A(\rho)\right)&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">%</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">�</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\varrho\left(A(\rho)\right)&lt;1</annotation></semantics></math>, Lemma <a href="#A7.Thmtheorem6" title="Lemma G.6 (Exponential Decay from Spectral Radius Bound). ‣ Auxiliary lemmas used in ‣ Appendix G Chain-of-Thought (CoT) Rollout in TSF: Collapse-to-Mean and Error Compounding ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">G.6</span></a>
applies to <math id="A7.SS0.SSSx1.p3.m3" class="ltx_Math" alttext="A(\rho)" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">�</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A(\rho)</annotation></semantics></math>: for any consistent operator norm there exist
<math id="A7.SS0.SSSx1.p3.m4" class="ltx_Math" alttext="C&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C&gt;0</annotation></semantics></math> and <math id="A7.SS0.SSSx1.p3.m5" class="ltx_Math" alttext="\beta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">�</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\beta\in(0,1)</annotation></semantics></math> such that
<math id="A7.SS0.SSSx1.p3.m6" class="ltx_Math" alttext="\|A(\rho)^{t}\|\leq C\,\beta^{t}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">�</mi><mo stretchy="false">)</mo></mrow><mi>t</mi></msup></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mrow><mi>C</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi mathvariant="normal">�</mi><mi>t</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\|A(\rho)^{t}\|\leq C\,\beta^{t}</annotation></semantics></math>
for all <math id="A7.SS0.SSSx1.p3.m7" class="ltx_Math" alttext="t\in\mdmathbb N" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">t\in\mdmathbb N</annotation></semantics></math>.
Hence <math id="A7.SS0.SSSx1.p3.m8" class="ltx_math_unparsed" alttext="|{}_{k}|\leq C\beta^{k}" display="inline" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mrow></mrow><mi>k</mi></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">≤</mo><mi>C</mi><mi mathvariant="normal">�</mi><msup><mrow></mrow><mi>k</mi></msup></mrow><annotation encoding="application/x-tex">|{}_{k}|\leq C\beta^{k}</annotation></semantics></math>.
Thus,</span></p>
<table id="A7.Ex187" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex187.m1" class="ltx_math_unparsed" alttext="\sum_{k\geq h}{}_{k}^{2}\leq\sum_{k\geq h}C^{2}\beta^{2k}=\frac{C^{2}}{1-\beta^{2}}\,\beta^{2h}," display="block" intent=":literal"><semantics><mrow><mo movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi>k</mi><mo>≥</mo><mi>h</mi></mrow></msub><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0.111em" rspace="0.111em">≤</mo><mo movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi>k</mi><mo>≥</mo><mi>h</mi></mrow></msub><mi>C</mi><msup><mrow></mrow><mn>2</mn></msup><mi mathvariant="normal">�</mi><msup><mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo>=</mo><mfrac><msup><mi>C</mi><mn>2</mn></msup><mrow><mn>1</mn><mo>−</mo><msup><mi mathvariant="normal">�</mi><mn>2</mn></msup></mrow></mfrac><mi mathvariant="normal">�</mi><msup><mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\sum_{k\geq h}{}_{k}^{2}\leq\sum_{k\geq h}C^{2}\beta^{2k}=\frac{C^{2}}{1-\beta^{2}}\,\beta^{2h},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.SS0.SSSx1.p3.2" class="ltx_p"><span id="A7.SS0.SSSx1.p3.2.1" class="ltx_text">and multiplying by <math id="A7.SS0.SSSx1.p3.m9" class="ltx_Math" alttext="\sigma_{\varepsilon}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">�</mi><mi mathvariant="normal">"</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">\sigma_{\varepsilon}^{2}</annotation></semantics></math> yields the claim.
∎</span></p>
</div>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
</section>
<section id="A8" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix H </span>De–Gaussifying the Gap: Linear Stationary Processes</h2>

<section id="A8.SS0.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Goal.</h5>

<div id="A8.SS0.SSS0.Px1.p1" class="ltx_para">
<p id="A8.SS0.SSS0.Px1.p1.1" class="ltx_p">We remove the Gaussian assumption and establish the same finite–sample excess–risk gap for one–layer LSA under a broad linear–stationary model. The strict gap requires only independence of innovations and finite moments; with absolutely summable autocovariances we also recover the <math id="A8.SS0.SSS0.Px1.p1.m1" class="ltx_Math" alttext="1/n" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">1/n</annotation></semantics></math> first–order expansion.</p>
</div>
</section>
<section id="A8.SS0.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Model.</h5>

<div id="A8.SS0.SSS0.Px2.p1" class="ltx_para">
<p id="A8.SS0.SSS0.Px2.p1.1" class="ltx_p">Let <math id="A8.SS0.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\{x_{t}\}_{t\in\mdmathbb Z}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mi>Z</mi></mrow></msub><annotation encoding="application/x-tex">\{x_{t}\}_{t\in\mdmathbb Z}</annotation></semantics></math> be a zero–mean <em id="A8.SS0.SSS0.Px2.p1.1.1" class="ltx_emph ltx_font_italic">linear stationary</em> process with Wold representation</p>
<table id="A8.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.E18.m1" class="ltx_math_unparsed" alttext="x_{t}\;=\;\sum_{k\geq 0}{}_{k}\,\varepsilon_{t-k},\qquad\sum_{k\geq 0}|{}_{k}|&lt;\infty," display="block" intent=":literal"><semantics><mrow><mi>x</mi><msub><mrow></mrow><mi>t</mi></msub><mo rspace="0.391em">=</mo><mo movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow></msub><msub><mrow></mrow><mi>k</mi></msub><mi mathvariant="normal">"</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub><mo rspace="2.000em">,</mo><mo movablelimits="false" rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mrow></mrow><mi>k</mi></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">&lt;</mo><mi mathvariant="normal">∞</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">x_{t}\;=\;\sum_{k\geq 0}{}_{k}\,\varepsilon_{t-k},\qquad\sum_{k\geq 0}|{}_{k}|&lt;\infty,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px2.p1.2" class="ltx_p">where <math id="A8.SS0.SSS0.Px2.p1.m2" class="ltx_Math" alttext="\{\varepsilon_{t}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi mathvariant="normal">"</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\varepsilon_{t}\}</annotation></semantics></math> are i.i.d. with <math id="A8.SS0.SSS0.Px2.p1.m3" class="ltx_Math" alttext="\E[\varepsilon_{t}]=0" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">E</mo><mrow><mo stretchy="false">[</mo><msub><mi mathvariant="normal">"</mi><mi>t</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\E[\varepsilon_{t}]=0</annotation></semantics></math>,
<math id="A8.SS0.SSS0.Px2.p1.m4" class="ltx_Math" alttext="\E[\varepsilon_{t}^{2}]=\sigma_{\varepsilon}^{2}&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">E</mo><mrow><mo stretchy="false">[</mo><msubsup><mi mathvariant="normal">"</mi><mi>t</mi><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><msubsup><mi mathvariant="normal">�</mi><mi mathvariant="normal">"</mi><mn>2</mn></msubsup><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\E[\varepsilon_{t}^{2}]=\sigma_{\varepsilon}^{2}&gt;0</annotation></semantics></math>, and with a symmetric distribution.
We assume <math id="A8.SS0.SSS0.Px2.p1.m5" class="ltx_Math" alttext="\E[\varepsilon_{t}^{4}]&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">E</mo><mrow><mo stretchy="false">[</mo><msubsup><mi mathvariant="normal">"</mi><mi>t</mi><mn>4</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\E[\varepsilon_{t}^{4}]&lt;\infty</annotation></semantics></math> and <math id="A8.SS0.SSS0.Px2.p1.m6" class="ltx_Math" alttext="\var(\varepsilon_{t}^{2})&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">Var</mo><mrow><mo stretchy="false">(</mo><msubsup><mi mathvariant="normal">"</mi><mi>t</mi><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\var(\varepsilon_{t}^{2})&lt;\infty</annotation></semantics></math>.
Let <math id="A8.SS0.SSS0.Px2.p1.m7" class="ltx_math_unparsed" alttext="{}_{h}:=\E[x_{t}x_{t+h}]" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mo>:=</mo><mprescripts></mprescripts><mi>h</mi><mrow></mrow></mmultiscripts><mo lspace="0.167em" rspace="0em">E</mo><mrow><mo stretchy="false">[</mo><msub><mi>x</mi><mi>t</mi></msub><msub><mi>x</mi><mrow><mi>t</mi><mo>+</mo><mi>h</mi></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{}_{h}:=\E[x_{t}x_{t+h}]</annotation></semantics></math>, so <math id="A8.SS0.SSS0.Px2.p1.m8" class="ltx_math_unparsed" alttext="\sum_{h\in\mdmathbb Z}|{}_{h}|&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>h</mi><mo>∈</mo><mi>Z</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mrow></mrow><mi>h</mi></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\sum_{h\in\mdmathbb Z}|{}_{h}|&lt;\infty</annotation></semantics></math>.</p>
</div>
<div id="A8.SS0.SSS0.Px2.p2" class="ltx_para">
<p id="A8.SS0.SSS0.Px2.p2.1" class="ltx_p">All Hankel/masking notation follows Section <a href="#A6.SS2" title="F.2 A finite-sample optimality gap for one-layer LSA ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.2</span></a>:</p>
<table id="A8.Ex188" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex188.m1" class="ltx_math_unparsed" alttext="G\;=\;\tfrac{1}{n}\sum_{m=1}^{n-p}x^{(m)}x^{(m)\top},\quad x:=x_{\,n-p+1:n}\in\mdmathbb R^{p},\quad y:=x_{n+1},\quad" display="block" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0.558em" rspace="0.558em">=</mo><mstyle displaystyle="false"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></msup><mi>x</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup><mi>x</mi><msup><mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msup><mo rspace="1.167em">,</mo><mi>x</mi><mo>:=</mo><mi>x</mi><msub><mrow></mrow><mrow><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo>∈</mo><mi>R</mi><msup><mrow></mrow><mi>p</mi></msup><mo rspace="1.167em">,</mo><mi>y</mi><mo>:=</mo><mi>x</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">G\;=\;\tfrac{1}{n}\sum_{m=1}^{n-p}x^{(m)}x^{(m)\top},\quad x:=x_{\,n-p+1:n}\in\mdmathbb R^{p},\quad y:=x_{n+1},\quad</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px2.p2.2" class="ltx_p">with the one–layer LSA predictor</p>
<table id="A8.Ex189" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex189.m1" class="ltx_Math" alttext="\widehat{x}_{n+1}^{\mathrm{LSA}}\;=\;b^{\top}GAx,\qquad b\in\mdmathbb R^{p+1},\;A\in\mdmathbb R^{(p+1)\times p}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mi>LSA</mi></msubsup><mo lspace="0.558em" rspace="0.558em">=</mo><mrow><msup><mi>b</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>b</mi><mo>∈</mo><msup><mi>R</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo rspace="0.447em">,</mo><mrow><mi>A</mi><mo>∈</mo><msup><mi>R</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>p</mi></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{x}_{n+1}^{\mathrm{LSA}}\;=\;b^{\top}GAx,\qquad b\in\mdmathbb R^{p+1},\;A\in\mdmathbb R^{(p+1)\times p}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px2.p2.3" class="ltx_p">As in Section <a href="#A6.SS2" title="F.2 A finite-sample optimality gap for one-layer LSA ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.2</span></a>, introduce</p>
<table id="A8.Ex190" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex190.m1" class="ltx_Math" alttext="Z:=(\vech G)\otimes x,\qquad\widetilde{S}:=\E[ZZ^{\top}],\quad\widetilde{r}:=\E[Zx^{\top}],\quad\Gamma_{p}:=\E[xx^{\top}]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Z</mi><mo>:=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>vech</mi><mo lspace="0.167em">⁡</mo><mi>G</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊗</mo><mi>x</mi></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mover accent="true"><mi>S</mi><mo>~</mo></mover><mo rspace="0.1389em">:=</mo><mrow><mo lspace="0.1389em" rspace="0em">E</mo><mrow><mo stretchy="false">[</mo><msup><mi>ZZ</mi><mo>⊤</mo></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mover accent="true"><mi>r</mi><mo>~</mo></mover><mo rspace="0.1389em">:=</mo><mrow><mo lspace="0.1389em" rspace="0em">E</mo><mrow><mo stretchy="false">[</mo><msup><mi>Zx</mi><mo>⊤</mo></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo rspace="0.1389em">:=</mo><mrow><mo lspace="0.1389em" rspace="0em">E</mo><mrow><mo stretchy="false">[</mo><msup><mi>xx</mi><mo>⊤</mo></msup><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Z:=(\vech G)\otimes x,\qquad\widetilde{S}:=\E[ZZ^{\top}],\quad\widetilde{r}:=\E[Zx^{\top}],\quad\Gamma_{p}:=\E[xx^{\top}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A8.SS0.SSS0.Px3" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Linear regression predictor.</h5>

<div id="A8.SS0.SSS0.Px3.p1" class="ltx_para">
<p id="A8.SS0.SSS0.Px3.p1.1" class="ltx_p">For consistency with the Hankel construction, we restrict attention to the last <math id="A8.SS0.SSS0.Px3.p1.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> lags <math id="A8.SS0.SSS0.Px3.p1.m2" class="ltx_math_unparsed" alttext="x:=x_{n-p+1:n}\in\mdmathbb R^{p}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>:=</mo><mi>x</mi><msub><mrow></mrow><mrow><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo>∈</mo><mi>R</mi><msup><mrow></mrow><mi>p</mi></msup></mrow><annotation encoding="application/x-tex">x:=x_{n-p+1:n}\in\mdmathbb R^{p}</annotation></semantics></math> as regression covariates.
The best linear predictor of <math id="A8.SS0.SSS0.Px3.p1.m3" class="ltx_Math" alttext="y:=x_{n+1}" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>:=</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">y:=x_{n+1}</annotation></semantics></math> from <math id="A8.SS0.SSS0.Px3.p1.m4" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> is</p>
<table id="A8.Ex191" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex191.m1" class="ltx_Math" alttext="y=w^{*\top}x+e_{n+1},\qquad\E[x\,e_{n+1}]=0," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>y</mi><mo>=</mo><mrow><mrow><msup><mi>w</mi><mrow><mo>∗</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><msub><mi>e</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><mo rspace="1.889em">,</mo><mrow><mrow><mo rspace="0em">E</mo><mrow><mo stretchy="false">[</mo><mrow><mi>x</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>e</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">y=w^{*\top}x+e_{n+1},\qquad\E[x\,e_{n+1}]=0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px3.p1.2" class="ltx_p">where <math id="A8.SS0.SSS0.Px3.p1.m5" class="ltx_Math" alttext="w^{*}\in\mdmathbb R^{p}" display="inline" intent=":literal"><semantics><mrow><msup><mi>w</mi><mo>∗</mo></msup><mo>∈</mo><msup><mi>R</mi><mi>p</mi></msup></mrow><annotation encoding="application/x-tex">w^{*}\in\mdmathbb R^{p}</annotation></semantics></math> is the least–squares coefficient vector and <math id="A8.SS0.SSS0.Px3.p1.m6" class="ltx_Math" alttext="e_{n+1}" display="inline" intent=":literal"><semantics><msub><mi>e</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">e_{n+1}</annotation></semantics></math> is the linear prediction error.
We denote the corresponding fitted value by</p>
<table id="A8.Ex192" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex192.m1" class="ltx_Math" alttext="\widehat{x}_{n+1}^{\mathrm{LR}}:=w^{*\top}x." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mi>LR</mi></msubsup><mo>:=</mo><mrow><msup><mi>w</mi><mrow><mo>∗</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{x}_{n+1}^{\mathrm{LR}}:=w^{*\top}x.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A8.Thmtheorem1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A8.Thmtheorem1.2" class="ltx_text ltx_font_bold">Lemma H.1</span></span><span id="A8.Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(Strict covariance of <math id="A8.Thmtheorem1.m1" class="ltx_Math" alttext="(\vech G,\,x)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>vech</mi><mo lspace="0.167em">⁡</mo><mi>G</mi></mrow><mo rspace="0.337em">,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\vech G,\,x)</annotation></semantics></math> without Gaussianity)<span id="A8.Thmtheorem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A8.Thmtheorem1.p1" class="ltx_para">
<p id="A8.Thmtheorem1.p1.1" class="ltx_p"><span id="A8.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A8.Thmtheorem1.p1.m1" class="ltx_Math" alttext="g:=\vech G" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>:=</mo><mrow><mi>vech</mi><mo lspace="0.167em">⁡</mo><mi>G</mi></mrow></mrow><annotation encoding="application/x-tex">g:=\vech G</annotation></semantics></math> and <math id="A8.Thmtheorem1.p1.m2" class="ltx_math_unparsed" alttext="x:=x_{\,n-p+1:n}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>:=</mo><mi>x</mi><msub><mrow></mrow><mrow><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">x:=x_{\,n-p+1:n}</annotation></semantics></math>.
Under (<a href="#A8.E18" title="Equation 18 ‣ Model. ‣ Appendix H De–Gaussifying the Gap: Linear Stationary Processes ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>), <math id="A8.Thmtheorem1.p1.m3" class="ltx_Math" alttext="\Cov\bigl([\,g^{\top},\,x^{\top}\,]^{\top}\bigr)\succ 0" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">Cov</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msup><mrow><mo rspace="0.170em" stretchy="false">[</mo><mrow><msup><mi mathvariant="normal">g</mi><mo>⊤</mo></msup><mo rspace="0.337em">,</mo><msup><mi mathvariant="normal">x</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">]</mo></mrow><mo>⊤</mo></msup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>≻</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Cov\bigl([\,g^{\top},\,x^{\top}\,]^{\top}\bigr)\succ 0</annotation></semantics></math> for every finite <math id="A8.Thmtheorem1.p1.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A8.SS0.SSS0.Px3.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A8.SS0.SSS0.Px3.p2" class="ltx_para">
<p id="A8.SS0.SSS0.Px3.p2.1" class="ltx_p"><span id="A8.SS0.SSS0.Px3.p2.1.1" class="ltx_text">Let <math id="A8.SS0.SSS0.Px3.p2.m1" class="ltx_Math" alttext="Z_{0}=[\,g^{\top},\,x^{\top}\,]^{\top}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mn>0</mn></msub><mo>=</mo><msup><mrow><mo rspace="0.170em" stretchy="false">[</mo><mrow><msup><mi>g</mi><mo>⊤</mo></msup><mo rspace="0.337em">,</mo><msup><mi>x</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">]</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">Z_{0}=[\,g^{\top},\,x^{\top}\,]^{\top}</annotation></semantics></math>.
Suppose <math id="A8.SS0.SSS0.Px3.p2.m2" class="ltx_Math" alttext="\var(v^{\top}Z_{0})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">Var</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>v</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>Z</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\var(v^{\top}Z_{0})=0</annotation></semantics></math> for some nonzero <math id="A8.SS0.SSS0.Px3.p2.m3" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math>.
Traverse the tableau of Hankel–Gram sums from bottom (time <math id="A8.SS0.SSS0.Px3.p2.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>) upward.
Collect coefficients of <math id="A8.SS0.SSS0.Px3.p2.m5" class="ltx_Math" alttext="\{x_{n}^{2},\,x_{n-1}x_{n},\dots,x_{n-p}x_{n},\,x_{n}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><msubsup><mi>x</mi><mi>n</mi><mn>2</mn></msubsup><mo rspace="0.337em">,</mo><mrow><msub><mi>x</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>n</mi></msub></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>x</mi><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>n</mi></msub></mrow><mo rspace="0.337em">,</mo><msub><mi>x</mi><mi>n</mi></msub></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{x_{n}^{2},\,x_{n-1}x_{n},\dots,x_{n-p}x_{n},\,x_{n}\}</annotation></semantics></math> to write</span></p>
<table id="A8.Ex193" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex193.m1" class="ltx_Math" alttext="v^{\top}Z_{0}\;=\;U+V\,x_{n}+W\,x_{n}^{2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>v</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>Z</mi><mn>0</mn></msub></mrow><mo rspace="0.558em">=</mo><mrow><mi>U</mi><mo>+</mo><mrow><mi>V</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>x</mi><mi>n</mi></msub></mrow><mo>+</mo><mrow><mi>W</mi><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>x</mi><mi>n</mi><mn>2</mn></msubsup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">v^{\top}Z_{0}\;=\;U+V\,x_{n}+W\,x_{n}^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px3.p2.2" class="ltx_p"><span id="A8.SS0.SSS0.Px3.p2.2.1" class="ltx_text">with <math id="A8.SS0.SSS0.Px3.p2.m6" class="ltx_Math" alttext="U,V,W" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>,</mo><mi>V</mi><mo>,</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">U,V,W</annotation></semantics></math> measurable w.r.t. <math id="A8.SS0.SSS0.Px3.p2.m7" class="ltx_math_unparsed" alttext="\mathcal{F}_{n-1}:=\sigma(\varepsilon_{s}:s\leq n-1)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>:=</mo><mi mathvariant="normal">�</mi><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">"</mi><mi>s</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mi>s</mi><mo>≤</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}_{n-1}:=\sigma(\varepsilon_{s}:s\leq n-1)</annotation></semantics></math>.</span></p>
</div>
<div id="A8.SS0.SSS0.Px3.p3" class="ltx_para">
<p id="A8.SS0.SSS0.Px3.p3.1" class="ltx_p"><span id="A8.SS0.SSS0.Px3.p3.1.1" class="ltx_text">Write <math id="A8.SS0.SSS0.Px3.p3.m1" class="ltx_Math" alttext="x_{n}=\xi+{}_{0}\varepsilon_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>n</mi></msub><mo>=</mo><mrow><mi mathvariant="normal">�</mi><mo>+</mo><mmultiscripts><mi mathvariant="normal">"</mi><mprescripts></mprescripts><mi>n</mi><mrow></mrow><mn>0</mn><mrow></mrow></mmultiscripts></mrow></mrow><annotation encoding="application/x-tex">x_{n}=\xi+{}_{0}\varepsilon_{n}</annotation></semantics></math>, where <math id="A8.SS0.SSS0.Px3.p3.m2" class="ltx_Math" alttext="\xi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">�</mi><annotation encoding="application/x-tex">\xi</annotation></semantics></math> is <math id="A8.SS0.SSS0.Px3.p3.m3" class="ltx_Math" alttext="\mathcal{F}_{n-1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\mathcal{F}_{n-1}</annotation></semantics></math>-measurable and
<math id="A8.SS0.SSS0.Px3.p3.m4" class="ltx_Math" alttext="\varepsilon_{n}\perp\mathcal{F}_{n-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">"</mi><mi>n</mi></msub><mo>⟂</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\varepsilon_{n}\perp\mathcal{F}_{n-1}</annotation></semantics></math>.
By symmetry, <math id="A8.SS0.SSS0.Px3.p3.m5" class="ltx_Math" alttext="\Cov(\varepsilon_{n},\varepsilon_{n}^{2})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">Cov</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">"</mi><mi>n</mi></msub><mo>,</mo><msubsup><mi mathvariant="normal">"</mi><mi>n</mi><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Cov(\varepsilon_{n},\varepsilon_{n}^{2})=0</annotation></semantics></math>.
Thus</span></p>
<table id="A8.Ex194" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex194.m1" class="ltx_math_unparsed" alttext="\var(v^{\top}Z_{0}\mid\mathcal{F}_{n-1})=\var(V{}_{0}\varepsilon_{n}+W{}_{0}^{2}\varepsilon_{n}^{2}\mid\mathcal{F}_{n-1})=(V{}_{0})^{2}\sigma_{\varepsilon}^{2}+W^{2}{}_{0}^{4}\var(\varepsilon^{2})." display="block" intent=":literal"><semantics><mrow><mo rspace="0em">Var</mo><mrow><mo stretchy="false">(</mo><msup><mi>v</mi><mo>⊤</mo></msup><msub><mi>Z</mi><mn>0</mn></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo rspace="0.1389em">=</mo><mo lspace="0.1389em" rspace="0em">Var</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mmultiscripts><mi mathvariant="normal">"</mi><mi>n</mi><mrow></mrow><mprescripts></mprescripts><mn>0</mn><mrow></mrow></mmultiscripts><mo>+</mo><mi>W</mi><mmultiscripts><mi mathvariant="normal">"</mi><mi>n</mi><mn>2</mn><mrow></mrow><mn>2</mn><mprescripts></mprescripts><mn>0</mn><mrow></mrow></mmultiscripts><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mi>V</mi><mmultiscripts><mo stretchy="false">)</mo><mprescripts></mprescripts><mn>0</mn><mrow></mrow></mmultiscripts></mrow><mn>2</mn></msup><msubsup><mi mathvariant="normal">�</mi><mi mathvariant="normal">"</mi><mn>2</mn></msubsup><mo>+</mo><msup><mi>W</mi><mn>2</mn></msup><mmultiscripts><mo lspace="0.167em" rspace="0em">Var</mo><mrow></mrow><mn>4</mn><mprescripts></mprescripts><mn>0</mn><mrow></mrow></mmultiscripts><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">"</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\var(v^{\top}Z_{0}\mid\mathcal{F}_{n-1})=\var(V{}_{0}\varepsilon_{n}+W{}_{0}^{2}\varepsilon_{n}^{2}\mid\mathcal{F}_{n-1})=(V{}_{0})^{2}\sigma_{\varepsilon}^{2}+W^{2}{}_{0}^{4}\var(\varepsilon^{2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px3.p3.2" class="ltx_p"><span id="A8.SS0.SSS0.Px3.p3.2.1" class="ltx_text">Since both coefficients are strictly positive, this vanishes only if <math id="A8.SS0.SSS0.Px3.p3.m6" class="ltx_Math" alttext="V=W=0" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>=</mo><mi>W</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">V=W=0</annotation></semantics></math>.
Inductively repeating the elimination for <math id="A8.SS0.SSS0.Px3.p3.m7" class="ltx_Math" alttext="x_{n-1},x_{n-2},\dots" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">x_{n-1},x_{n-2},\dots</annotation></semantics></math> forces <math id="A8.SS0.SSS0.Px3.p3.m8" class="ltx_Math" alttext="v=0" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">v=0</annotation></semantics></math>, a contradiction.
Hence the covariance is strictly positive definite.
∎</span></p>
</div>
</div>
<div id="A8.Thmtheorem2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A8.Thmtheorem2.2" class="ltx_text ltx_font_bold">Lemma H.2</span></span><span id="A8.Thmtheorem2.3" class="ltx_text ltx_font_bold"> </span>(Kronecker lift remains strictly PD)<span id="A8.Thmtheorem2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A8.Thmtheorem2.p1" class="ltx_para">
<p id="A8.Thmtheorem2.p1.1" class="ltx_p"><span id="A8.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">With <math id="A8.Thmtheorem2.p1.m1" class="ltx_Math" alttext="Z=(\vech G)\otimes x" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>vech</mi><mo lspace="0.167em">⁡</mo><mi>G</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊗</mo><mi>x</mi></mrow></mrow><annotation encoding="application/x-tex">Z=(\vech G)\otimes x</annotation></semantics></math> and <math id="A8.Thmtheorem2.p1.m2" class="ltx_math_unparsed" alttext="x=x_{\,n-p+1:n}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mi>x</mi><msub><mrow></mrow><mrow><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">x=x_{\,n-p+1:n}</annotation></semantics></math>,</span></p>
<table id="A8.Ex195" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex195.m1" class="ltx_math_unparsed" alttext="\Sigma^{\otimes}:=\E\begin{bmatrix}Z\\
x\end{bmatrix}\begin{bmatrix}Z\\
x\end{bmatrix}^{\top}=\begin{bmatrix}\widetilde{S}&amp;\widetilde{r}\\
\widetilde{r}^{\top}&amp;\Gamma_{p}\end{bmatrix}\ \succ\ 0." display="block" intent=":literal"><semantics><mrow><mi mathvariant="normal">�</mi><msup><mrow></mrow><mo>⊗</mo></msup><mo rspace="0.1389em">:=</mo><mo lspace="0.1389em" rspace="0em">E</mo><mrow><mo>[</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><mi>Z</mi></mtd></mtr><mtr><mtd><mi>x</mi></mtd></mtr></mtable><mo>]</mo></mrow><mrow><mo>[</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><mi>Z</mi></mtd></mtr><mtr><mtd><mi>x</mi></mtd></mtr></mtable><mo>]</mo></mrow><msup><mrow></mrow><mo>⊤</mo></msup><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mover accent="true"><mi>S</mi><mo>~</mo></mover></mtd><mtd><mover accent="true"><mi>r</mi><mo>~</mo></mover></mtd></mtr><mtr><mtd><msup><mover accent="true"><mi>r</mi><mo>~</mo></mover><mo>⊤</mo></msup></mtd><mtd><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>≻</mo><mn> 0</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Sigma^{\otimes}:=\E\begin{bmatrix}Z\\
x\end{bmatrix}\begin{bmatrix}Z\\
x\end{bmatrix}^{\top}=\begin{bmatrix}\widetilde{S}&amp;\widetilde{r}\\
\widetilde{r}^{\top}&amp;\Gamma_{p}\end{bmatrix}\ \succ\ 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A8.SS0.SSS0.Px3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A8.SS0.SSS0.Px3.p4" class="ltx_para">
<p id="A8.SS0.SSS0.Px3.p4.1" class="ltx_p"><span id="A8.SS0.SSS0.Px3.p4.1.1" class="ltx_text">By Lemma <a href="#A8.Thmtheorem1" title="Lemma H.1 (Strict covariance of (vech𝐺,𝑥) without Gaussianity). ‣ Linear regression predictor. ‣ Appendix H De–Gaussifying the Gap: Linear Stationary Processes ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H.1</span></a>, <math id="A8.SS0.SSS0.Px3.p4.m1" class="ltx_Math" alttext="\Cov([g,x])\succ 0" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">Cov</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mrow><mi>g</mi><mo>,</mo><mi>x</mi></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≻</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Cov([g,x])\succ 0</annotation></semantics></math>; hence the conditional covariance
<math id="A8.SS0.SSS0.Px3.p4.m2" class="ltx_math_unparsed" alttext="\Cov(g\mid x)=\Cov(g)-\Cov(g,x)\Gamma_{p}^{-1}\Cov(x,g)\succ 0" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">Cov</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.1389em">=</mo><mo lspace="0.1389em" rspace="0em">Cov</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mo lspace="0em" rspace="0em">Cov</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><msubsup><mi mathvariant="normal">�</mi><mi>p</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0.167em" rspace="0em">Cov</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><mo>≻</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Cov(g\mid x)=\Cov(g)-\Cov(g,x)\Gamma_{p}^{-1}\Cov(x,g)\succ 0</annotation></semantics></math>.
For any nonzero <math id="A8.SS0.SSS0.Px3.p4.m3" class="ltx_Math" alttext="u=\vect(U)\in\mdmathbb R^{qp}" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>=</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>R</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msup></mrow><annotation encoding="application/x-tex">u=\vect(U)\in\mdmathbb R^{qp}</annotation></semantics></math> and <math id="A8.SS0.SSS0.Px3.p4.m4" class="ltx_Math" alttext="w\in\mdmathbb R^{p}" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>∈</mo><msup><mi>R</mi><mi>p</mi></msup></mrow><annotation encoding="application/x-tex">w\in\mdmathbb R^{p}</annotation></semantics></math>, put
<math id="A8.SS0.SSS0.Px3.p4.m5" class="ltx_Math" alttext="Y:=u^{\top}Z+w^{\top}x=x^{\top}(Ug+w)" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo>:=</mo><mrow><mrow><msup><mi>u</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>Z</mi></mrow><mo>+</mo><mrow><msup><mi>w</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><mo>=</mo><mrow><msup><mi>x</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>+</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Y:=u^{\top}Z+w^{\top}x=x^{\top}(Ug+w)</annotation></semantics></math>.
Then
<math id="A8.SS0.SSS0.Px3.p4.m6" class="ltx_math_unparsed" alttext="\var(Y)\geq\E[x^{\top}U\,\Cov(g\mid x)\,U^{\top}x]&gt;0" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">Var</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.1389em">≥</mo><mo lspace="0.1389em" rspace="0em">E</mo><mrow><mo stretchy="false">[</mo><msup><mi>x</mi><mo>⊤</mo></msup><mi>U</mi><mo lspace="0.337em" rspace="0em">Cov</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo rspace="0.170em" stretchy="false">)</mo></mrow><msup><mi>U</mi><mo>⊤</mo></msup><mi>x</mi><mo stretchy="false">]</mo></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\var(Y)\geq\E[x^{\top}U\,\Cov(g\mid x)\,U^{\top}x]&gt;0</annotation></semantics></math> unless <math id="A8.SS0.SSS0.Px3.p4.m7" class="ltx_Math" alttext="U=0" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">U=0</annotation></semantics></math>; if <math id="A8.SS0.SSS0.Px3.p4.m8" class="ltx_Math" alttext="U=0" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">U=0</annotation></semantics></math> then <math id="A8.SS0.SSS0.Px3.p4.m9" class="ltx_Math" alttext="\var(Y)=\var(w^{\top}x)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">Var</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">=</mo><mrow><mo lspace="0.1389em" rspace="0em">Var</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>w</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\var(Y)=\var(w^{\top}x)&gt;0</annotation></semantics></math> since <math id="A8.SS0.SSS0.Px3.p4.m10" class="ltx_Math" alttext="\Gamma_{p}\succ 0" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo>≻</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Gamma_{p}\succ 0</annotation></semantics></math>.
Thus <math id="A8.SS0.SSS0.Px3.p4.m11" class="ltx_Math" alttext="\Sigma^{\otimes}\succ 0" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">�</mi><mo>⊗</mo></msup><mo>≻</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Sigma^{\otimes}\succ 0</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A8.Thmtheorem3" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A8.Thmtheorem3.2" class="ltx_text ltx_font_bold">Theorem H.3</span></span><span id="A8.Thmtheorem3.3" class="ltx_text ltx_font_bold"> </span>(Strict finite–sample gap under linear stationarity)<span id="A8.Thmtheorem3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A8.Thmtheorem3.p1" class="ltx_para">
<p id="A8.Thmtheorem3.p1.1" class="ltx_p"><span id="A8.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Under the model above, for every finite <math id="A8.Thmtheorem3.p1.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>,</span></p>
<table id="A8.Ex196" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex196.m1" class="ltx_Math" alttext="\min_{b,A}\ \E\big[(\widehat{x}_{n+1}^{\mathrm{LSA}}-\widehat{x}_{n+1}^{\mathrm{LR}})^{2}\big]\;=\;w^{*\top}\Delta_{n}w^{*},\qquad\Delta_{n}\succ 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munder><mi>min</mi><mrow><mi>b</mi><mo>,</mo><mi>A</mi></mrow></munder><mo lspace="0.667em">⁡</mo><mrow><mo rspace="0em">E</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mi>LSA</mi></msubsup><mo>−</mo><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mi>LR</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em" rspace="0.280em">]</mo></mrow></mrow></mrow><mo rspace="0.558em">=</mo><mrow><msup><mi>w</mi><mrow><mo>∗</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">�</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>w</mi><mo>∗</mo></msup></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi mathvariant="normal">�</mi><mi>n</mi></msub><mo>≻</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\min_{b,A}\ \E\big[(\widehat{x}_{n+1}^{\mathrm{LSA}}-\widehat{x}_{n+1}^{\mathrm{LR}})^{2}\big]\;=\;w^{*\top}\Delta_{n}w^{*},\qquad\Delta_{n}\succ 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A8.SS0.SSS0.Px3.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A8.SS0.SSS0.Px3.p5" class="ltx_para">
<p id="A8.SS0.SSS0.Px3.p5.1" class="ltx_p"><span id="A8.SS0.SSS0.Px3.p5.1.1" class="ltx_text">As in (<a href="#A6.E5" title="Equation 5 ‣ Kronecker reparameterization. ‣ F.2 A finite-sample optimality gap for one-layer LSA ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>), the LSA risk relative to the regression predictor can be written</span></p>
<table id="A8.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A8.Ex197"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.Ex197.m1" class="ltx_Math" alttext="\displaystyle\mathcal{L}(\eta)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">�</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}(\eta)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex197.m2" class="ltx_Math" alttext="\displaystyle=\E\big[(\widehat{x}_{n+1}^{\mathrm{LSA}}-\widehat{x}_{n+1}^{\mathrm{LR}})^{2}\big]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><mo lspace="0.1389em" rspace="0em">E</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mi>LSA</mi></msubsup><mo>−</mo><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mi>LR</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\E\big[(\widehat{x}_{n+1}^{\mathrm{LSA}}-\widehat{x}_{n+1}^{\mathrm{LR}})^{2}\big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex198"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex198.m1" class="ltx_Math" alttext="\displaystyle=w^{*\top}\Gamma_{p}w^{*}+\eta^{\top}\widetilde{S}\,\eta-2\,\eta^{\top}\widetilde{r}\,w^{*}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><msup><mi>w</mi><mrow><mo>∗</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>w</mi><mo>∗</mo></msup></mrow><mo>+</mo><mrow><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>S</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">�</mi></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0.170em" rspace="0em">​</mo><msup><mi mathvariant="normal">�</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>r</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mi>w</mi><mo>∗</mo></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=w^{*\top}\Gamma_{p}w^{*}+\eta^{\top}\widetilde{S}\,\eta-2\,\eta^{\top}\widetilde{r}\,w^{*}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px3.p5.2" class="ltx_p"><span id="A8.SS0.SSS0.Px3.p5.2.1" class="ltx_text">The minimizer is <math id="A8.SS0.SSS0.Px3.p5.m1" class="ltx_Math" alttext="\eta^{*}=\widetilde{S}^{-1}\widetilde{r}\,w^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">�</mi><mo>∗</mo></msup><mo>=</mo><mrow><msup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>r</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mi>w</mi><mo>∗</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\eta^{*}=\widetilde{S}^{-1}\widetilde{r}\,w^{*}</annotation></semantics></math>, giving the optimal value</span></p>
<table id="A8.Ex199" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex199.m1" class="ltx_Math" alttext="w^{*\top}(\Gamma_{p}-\widetilde{r}^{\top}\widetilde{S}^{-1}\widetilde{r})w^{*}=w^{*\top}\Delta_{n}w^{*}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>w</mi><mrow><mo>∗</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo>−</mo><mrow><msup><mover accent="true"><mi>r</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>r</mi><mo>~</mo></mover></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>w</mi><mo>∗</mo></msup></mrow><mo>=</mo><mrow><msup><mi>w</mi><mrow><mo>∗</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">�</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>w</mi><mo>∗</mo></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">w^{*\top}(\Gamma_{p}-\widetilde{r}^{\top}\widetilde{S}^{-1}\widetilde{r})w^{*}=w^{*\top}\Delta_{n}w^{*}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px3.p5.3" class="ltx_p"><span id="A8.SS0.SSS0.Px3.p5.3.1" class="ltx_text">By Lemma <a href="#A8.Thmtheorem2" title="Lemma H.2 (Kronecker lift remains strictly PD). ‣ Linear regression predictor. ‣ Appendix H De–Gaussifying the Gap: Linear Stationary Processes ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H.2</span></a>, <math id="A8.SS0.SSS0.Px3.p5.m2" class="ltx_Math" alttext="\widetilde{S}\succ 0" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>S</mi><mo>~</mo></mover><mo>≻</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\widetilde{S}\succ 0</annotation></semantics></math>, hence <math id="A8.SS0.SSS0.Px3.p5.m3" class="ltx_Math" alttext="\Delta_{n}\succ 0" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">�</mi><mi>n</mi></msub><mo>≻</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta_{n}\succ 0</annotation></semantics></math> by the Schur complement.
∎</span></p>
</div>
</div>
</section>
<section id="A8.SS0.SSS0.Px4" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Remarks.</h5>

<div id="A8.SS0.SSS0.Px4.p1" class="ltx_para">
<p id="A8.SS0.SSS0.Px4.p1.1" class="ltx_p">(i) The gap above is defined relative to the best linear regression predictor <math id="A8.SS0.SSS0.Px4.p1.m1" class="ltx_Math" alttext="\widehat{x}_{n+1}^{\mathrm{LR}}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mi>LR</mi></msubsup><annotation encoding="application/x-tex">\widehat{x}_{n+1}^{\mathrm{LR}}</annotation></semantics></math>.
(ii) If in addition the regression residual <math id="A8.SS0.SSS0.Px4.p1.m2" class="ltx_Math" alttext="e_{n+1}" display="inline" intent=":literal"><semantics><msub><mi>e</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">e_{n+1}</annotation></semantics></math> is independent of <math id="A8.SS0.SSS0.Px4.p1.m3" class="ltx_Math" alttext="(G,x)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(G,x)</annotation></semantics></math> (as in an exact AR(<math id="A8.SS0.SSS0.Px4.p1.m4" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>) model with <math id="A8.SS0.SSS0.Px4.p1.m5" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> lags), then the same gap translates directly to a strict excess risk gap relative to <math id="A8.SS0.SSS0.Px4.p1.m6" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math>.</p>
</div>
</section>
<section id="A8.SS0.SSS0.Px5" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Cumulant identities for linear processes.</h5>

<div id="A8.SS0.SSS0.Px5.p1" class="ltx_para">
<p id="A8.SS0.SSS0.Px5.p1.1" class="ltx_p">Let <math id="A8.SS0.SSS0.Px5.p1.m1" class="ltx_Math" alttext="\kappa_{r}:=\mathrm{cum}_{r}(\varepsilon_{0})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">�</mi><mi>r</mi></msub><mo>:=</mo><mrow><msub><mi>cum</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">"</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\kappa_{r}:=\mathrm{cum}_{r}(\varepsilon_{0})</annotation></semantics></math> denote the order–<math id="A8.SS0.SSS0.Px5.p1.m2" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> cumulant of <math id="A8.SS0.SSS0.Px5.p1.m3" class="ltx_Math" alttext="\varepsilon_{0}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">"</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\varepsilon_{0}</annotation></semantics></math> (finite for the orders we use).
For any <math id="A8.SS0.SSS0.Px5.p1.m4" class="ltx_Math" alttext="t_{1},\dots,t_{r}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>t</mi><mi>r</mi></msub></mrow><annotation encoding="application/x-tex">t_{1},\dots,t_{r}</annotation></semantics></math>,</p>
<table id="A8.E19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.E19.m1" class="ltx_math_unparsed" alttext="\mathrm{cum}\bigl(x_{t_{1}},\dots,x_{t_{r}}\bigr)=\kappa_{r}\sum_{u\in\mdmathbb Z}{}_{t_{1}-u}\cdots{}_{t_{r}-u}." display="block" intent=":literal"><semantics><mrow><mi>cum</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>x</mi><msub><mi>t</mi><mn>1</mn></msub></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><msub><mi>t</mi><mi>r</mi></msub></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>=</mo><msub><mi mathvariant="normal">�</mi><mi>r</mi></msub><munder><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>∈</mo><mi>Z</mi></mrow></munder><mmultiscripts><mo lspace="0em" rspace="0em">⋯</mo><mprescripts></mprescripts><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>−</mo><mi>u</mi></mrow><mrow></mrow></mmultiscripts><mmultiscripts><mo lspace="0em">.</mo><mprescripts></mprescripts><mrow><msub><mi>t</mi><mi>r</mi></msub><mo>−</mo><mi>u</mi></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\mathrm{cum}\bigl(x_{t_{1}},\dots,x_{t_{r}}\bigr)=\kappa_{r}\sum_{u\in\mdmathbb Z}{}_{t_{1}-u}\cdots{}_{t_{r}-u}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px5.p1.2" class="ltx_p">This follows from multilinearity of cumulants and independence of <math id="A8.SS0.SSS0.Px5.p1.m5" class="ltx_Math" alttext="\{\varepsilon_{t}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi mathvariant="normal">"</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\varepsilon_{t}\}</annotation></semantics></math> (see, e.g., <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>, Theorem 2.3.2]</cite>)</p>
</div>
<div id="A8.Thmtheorem4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A8.Thmtheorem4.2" class="ltx_text ltx_font_bold">Lemma H.4</span></span><span id="A8.Thmtheorem4.3" class="ltx_text ltx_font_bold"> </span>(Moment expansions via cumulants)<span id="A8.Thmtheorem4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A8.Thmtheorem4.p1" class="ltx_para">
<p id="A8.Thmtheorem4.p1.1" class="ltx_p"><span id="A8.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Assume <math id="A8.Thmtheorem4.p1.m1" class="ltx_math_unparsed" alttext="\sum_{h\in\mdmathbb Z}|{}_{h}|&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>h</mi><mo>∈</mo><mi>Z</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mrow></mrow><mi>h</mi></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\sum_{h\in\mdmathbb Z}|{}_{h}|&lt;\infty</annotation></semantics></math>, <math id="A8.Thmtheorem4.p1.m2" class="ltx_Math" alttext="\mdmathbb E|\varepsilon_{t}|^{6}&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><msub><mi mathvariant="normal">"</mi><mi>t</mi></msub><mo stretchy="false">|</mo></mrow><mn>6</mn></msup></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\mdmathbb E|\varepsilon_{t}|^{6}&lt;\infty</annotation></semantics></math> (so <math id="A8.Thmtheorem4.p1.m3" class="ltx_Math" alttext="\kappa_{4},\kappa_{6}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">�</mi><mn>4</mn></msub><mo>,</mo><msub><mi mathvariant="normal">�</mi><mn>6</mn></msub></mrow><annotation encoding="application/x-tex">\kappa_{4},\kappa_{6}</annotation></semantics></math> are finite).
Let <math id="A8.Thmtheorem4.p1.m4" class="ltx_Math" alttext="u:=\vech(\Gamma_{p+1})" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>:=</mo><mrow><mi>vech</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u:=\vech(\Gamma_{p+1})</annotation></semantics></math> and set <math id="A8.Thmtheorem4.p1.m5" class="ltx_Math" alttext="S_{\infty}:=(uu^{\top})\otimes\Gamma_{p}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi mathvariant="normal">∞</mi></msub><mo>:=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mo>⊤</mo></msup></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊗</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub></mrow></mrow><annotation encoding="application/x-tex">S_{\infty}:=(uu^{\top})\otimes\Gamma_{p}</annotation></semantics></math>, <math id="A8.Thmtheorem4.p1.m6" class="ltx_Math" alttext="r_{\infty}:=u\otimes\Gamma_{p}" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi mathvariant="normal">∞</mi></msub><mo>:=</mo><mrow><mi>u</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub></mrow></mrow><annotation encoding="application/x-tex">r_{\infty}:=u\otimes\Gamma_{p}</annotation></semantics></math>.
For <math id="A8.Thmtheorem4.p1.m7" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math> with fixed <math id="A8.Thmtheorem4.p1.m8" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>,</span></p>
<table id="A8.E20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.E20.m1" class="ltx_Math" alttext="\widetilde{S}_{n}\;=\;S_{\infty}+\frac{1}{n}\,C_{S}+o(1/n),\qquad\widetilde{r}_{n}\;=\;r_{\infty}+\frac{1}{n}\,C_{r}+o(1/n)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0.558em" rspace="0.558em">=</mo><mrow><msub><mi>S</mi><mi mathvariant="normal">∞</mi></msub><mo>+</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>C</mi><mi>S</mi></msub></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>n</mi></msub><mo rspace="0.558em">=</mo><mrow><msub><mi>r</mi><mi mathvariant="normal">∞</mi></msub><mo>+</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>C</mi><mi>r</mi></msub></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\widetilde{S}_{n}\;=\;S_{\infty}+\frac{1}{n}\,C_{S}+o(1/n),\qquad\widetilde{r}_{n}\;=\;r_{\infty}+\frac{1}{n}\,C_{r}+o(1/n),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
<p id="A8.Thmtheorem4.p1.2" class="ltx_p"><span id="A8.Thmtheorem4.p1.2.1" class="ltx_text ltx_font_italic">for finite matrices <math id="A8.Thmtheorem4.p1.m9" class="ltx_Math" alttext="C_{S},C_{r}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>S</mi></msub><mo>,</mo><msub><mi>C</mi><mi>r</mi></msub></mrow><annotation encoding="application/x-tex">C_{S},C_{r}</annotation></semantics></math> determined by <math id="A8.Thmtheorem4.p1.m10" class="ltx_math_unparsed" alttext="\{{}_{h}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mmultiscripts><mo stretchy="false">}</mo><mprescripts></mprescripts><mi>h</mi><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\{{}_{h}\}</annotation></semantics></math> and <math id="A8.Thmtheorem4.p1.m11" class="ltx_Math" alttext="\kappa_{4},\kappa_{6}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">�</mi><mn>4</mn></msub><mo>,</mo><msub><mi mathvariant="normal">�</mi><mn>6</mn></msub></mrow><annotation encoding="application/x-tex">\kappa_{4},\kappa_{6}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A8.SS0.SSS0.Px5.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A8.SS0.SSS0.Px5.p2" class="ltx_para">
<p id="A8.SS0.SSS0.Px5.p2.1" class="ltx_p"><span id="A8.SS0.SSS0.Px5.p2.1.1" class="ltx_text">We work entrywise. Write indices <math id="A8.SS0.SSS0.Px5.p2.m1" class="ltx_Math" alttext="i,j,k,\ell\in\{1,\dots,p{+}1\}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi><mo>,</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">i,j,k,\ell\in\{1,\dots,p{+}1\}</annotation></semantics></math>, <math id="A8.SS0.SSS0.Px5.p2.m2" class="ltx_Math" alttext="s,t\in\{1,\dots,p\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>p</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">s,t\in\{1,\dots,p\}</annotation></semantics></math>, and</span></p>
<table id="A8.Ex200" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex200.m1" class="ltx_Math" alttext="a=x_{m+i-1},\ b=x_{m+j-1},\ c=x_{m^{\prime}+k-1},\ d=x_{m^{\prime}+\ell-1},\ e=x_{n-p+s},\ f=x_{n-p+t}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>a</mi><mo>=</mo><msub><mi>x</mi><mrow><mrow><mi>m</mi><mo>+</mo><mi>i</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo rspace="0.667em">,</mo><mrow><mi>b</mi><mo>=</mo><msub><mi>x</mi><mrow><mrow><mi>m</mi><mo>+</mo><mi>j</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo rspace="0.667em">,</mo><mrow><mi>c</mi><mo>=</mo><msub><mi>x</mi><mrow><mrow><msup><mi>m</mi><mo>′</mo></msup><mo>+</mo><mi>k</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo rspace="0.667em">,</mo><mrow><mi>d</mi><mo>=</mo><msub><mi>x</mi><mrow><mrow><msup><mi>m</mi><mo>′</mo></msup><mo>+</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo rspace="0.667em">,</mo><mrow><mi>e</mi><mo>=</mo><msub><mi>x</mi><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mi>s</mi></mrow></msub></mrow><mo rspace="0.667em">,</mo><mrow><mi>f</mi><mo>=</mo><msub><mi>x</mi><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mi>t</mi></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">a=x_{m+i-1},\ b=x_{m+j-1},\ c=x_{m^{\prime}+k-1},\ d=x_{m^{\prime}+\ell-1},\ e=x_{n-p+s},\ f=x_{n-p+t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px5.p2.2" class="ltx_p"><span id="A8.SS0.SSS0.Px5.p2.2.1" class="ltx_text">Recall <math id="A8.SS0.SSS0.Px5.p2.m3" class="ltx_Math" alttext="G_{ij}=\tfrac{1}{n}\sum_{m=1}^{n-p}x_{m+i-1}x_{m+j-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></msubsup><mrow><msub><mi>x</mi><mrow><mrow><mi>m</mi><mo>+</mo><mi>i</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mrow><mi>m</mi><mo>+</mo><mi>j</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">G_{ij}=\tfrac{1}{n}\sum_{m=1}^{n-p}x_{m+i-1}x_{m+j-1}</annotation></semantics></math>.
We analyze</span></p>
<table id="A8.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A8.E21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.E21.m1" class="ltx_Math" alttext="\displaystyle(\widetilde{r}_{n})_{(ij,s),t}=\mdmathbb E[G_{ij}\,x_{s}x_{t}]=\frac{1}{n}\sum_{m=1}^{n-p}\mdmathbb E[ab\,e\,f]," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>G</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></munderover></mstyle><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>e</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>f</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle(\widetilde{r}_{n})_{(ij,s),t}=\mdmathbb E[G_{ij}\,x_{s}x_{t}]=\frac{1}{n}\sum_{m=1}^{n-p}\mdmathbb E[ab\,e\,f],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
<tbody id="A8.E22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.E22.m1" class="ltx_Math" alttext="\displaystyle(\widetilde{S}_{n})_{(ij,s),(k\ell,t)}=\mdmathbb E[G_{ij}G_{k\ell}\,x_{s}x_{t}]=\frac{1}{n^{2}}\sum_{m,m^{\prime}=1}^{n-p}\mdmathbb E[ab\,cd\,e\,f]." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>G</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>G</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>n</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>m</mi><mo>,</mo><msup><mi>m</mi><mo>′</mo></msup></mrow><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></munderover></mstyle><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>e</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>f</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle(\widetilde{S}_{n})_{(ij,s),(k\ell,t)}=\mdmathbb E[G_{ij}G_{k\ell}\,x_{s}x_{t}]=\frac{1}{n^{2}}\sum_{m,m^{\prime}=1}^{n-p}\mdmathbb E[ab\,cd\,e\,f].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
</table>
</div>
<div id="A8.SS0.SSS0.Px5.p3" class="ltx_para">
<p id="A8.SS0.SSS0.Px5.p3.1" class="ltx_p"><em id="A8.SS0.SSS0.Px5.p3.1.1" class="ltx_emph ltx_font_italic">(I) The <math id="A8.SS0.SSS0.Px5.p3.m1" class="ltx_Math" alttext="r_{n}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>n</mi></msub><annotation encoding="application/x-tex">r_{n}</annotation></semantics></math> expansion.</em><span id="A8.SS0.SSS0.Px5.p3.1.2" class="ltx_text">
By the moment–cumulant formula (see <a href="#A8.Thmtheorem6" title="Lemma H.6 (Moment–cumulant formula). ‣ Auxiliary lemmas used in ‣ Appendix H De–Gaussifying the Gap: Linear Stationary Processes ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">H.6</span></a>), for four variables,</span></p>
<table id="A8.Ex201" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex201.m1" class="ltx_Math" alttext="\mdmathbb E[abef]=\mdmathbb E[ab]\mdmathbb E[ef]+\mdmathbb E[ae]\mdmathbb E[bf]+\mdmathbb E[af]\mdmathbb E[be]+\mathrm{cum}(a,b,e,f)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mi>cum</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>e</mi><mo>,</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mdmathbb E[abef]=\mdmathbb E[ab]\mdmathbb E[ef]+\mdmathbb E[ae]\mdmathbb E[bf]+\mdmathbb E[af]\mdmathbb E[be]+\mathrm{cum}(a,b,e,f).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px5.p3.2" class="ltx_p"><span id="A8.SS0.SSS0.Px5.p3.2.1" class="ltx_text">The pairwise terms equal</span></p>
<table id="A8.Ex202" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex202.m1" class="ltx_math_unparsed" alttext="{}_{j-i}(\Gamma_{p})_{st}+{}_{(n-p+s)-(m+i-1)}{}_{(n-p+t)-(m+j-1)}+{}_{(n-p+t)-(m+i-1)}{}_{(n-p+s)-(m+j-1)}." display="block" intent=":literal"><semantics><mrow><mmultiscripts><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow></mrow><mprescripts></mprescripts><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow><mrow></mrow></mmultiscripts><mo rspace="0em">+</mo><mmultiscripts><mo lspace="0em" rspace="0em">+</mo><mprescripts></mprescripts><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>m</mi><mo>+</mo><mi>i</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>m</mi><mo>+</mo><mi>j</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow></mrow></mmultiscripts><mmultiscripts><mo lspace="0em">.</mo><mprescripts></mprescripts><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>m</mi><mo>+</mo><mi>i</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>m</mi><mo>+</mo><mi>j</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">{}_{j-i}(\Gamma_{p})_{st}+{}_{(n-p+s)-(m+i-1)}{}_{(n-p+t)-(m+j-1)}+{}_{(n-p+t)-(m+i-1)}{}_{(n-p+s)-(m+j-1)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px5.p3.3" class="ltx_p"><span id="A8.SS0.SSS0.Px5.p3.3.1" class="ltx_text">Summing over <math id="A8.SS0.SSS0.Px5.p3.m2" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> gives</span></p>
<table id="A8.Ex203" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex203.m1" class="ltx_math_unparsed" alttext="\frac{n-p}{n}\,{}_{j-i}(\Gamma_{p})_{st}+\frac{1}{n}\sum_{k=1}^{n-p}\;\bigl({}_{k+s-i}{}_{k+t-j}+{}_{k+t-i}{}_{k+s-j}\bigr)." display="block" intent=":literal"><semantics><mrow><mfrac><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mi>n</mi></mfrac><mmultiscripts><mrow><mo lspace="0.170em" stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow></mrow><mprescripts></mprescripts><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow><mrow></mrow></mmultiscripts><mo>+</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></munderover><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mmultiscripts><mo lspace="0em" rspace="0em">+</mo><mprescripts></mprescripts><mrow><mrow><mi>k</mi><mo>+</mo><mi>s</mi></mrow><mo>−</mo><mi>i</mi></mrow><mrow></mrow><mrow><mrow><mi>k</mi><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>j</mi></mrow><mrow></mrow></mmultiscripts><mmultiscripts><mo maxsize="1.200em" minsize="1.200em">)</mo><mprescripts></mprescripts><mrow><mrow><mi>k</mi><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>i</mi></mrow><mrow></mrow><mrow><mrow><mi>k</mi><mo>+</mo><mi>s</mi></mrow><mo>−</mo><mi>j</mi></mrow><mrow></mrow></mmultiscripts></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{n-p}{n}\,{}_{j-i}(\Gamma_{p})_{st}+\frac{1}{n}\sum_{k=1}^{n-p}\;\bigl({}_{k+s-i}{}_{k+t-j}+{}_{k+t-i}{}_{k+s-j}\bigr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px5.p3.4" class="ltx_p"><span id="A8.SS0.SSS0.Px5.p3.4.1" class="ltx_text">Because <math id="A8.SS0.SSS0.Px5.p3.m3" class="ltx_math_unparsed" alttext="\sum_{h}|{}_{h}|&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∑</mo><msub><mrow></mrow><mi>h</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mrow></mrow><mi>h</mi></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\sum_{h}|{}_{h}|&lt;\infty</annotation></semantics></math>, Toeplitz summation (see <a href="#A6.Thmtheorem16" title="Lemma F.16 (Toeplitz-type summation). ‣ Auxiliary lemmas used in ‣ F.3 Order of the finite-sample gap ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">F.16</span></a>) implies that the convolutions are uniformly bounded and converge; thus</span></p>
<table id="A8.Ex204" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex204.m1" class="ltx_math_unparsed" alttext="\frac{n-p}{n}\,{}_{j-i}(\Gamma_{p})_{st}={}_{j-i}(\Gamma_{p})_{st}-\frac{p}{n}{}_{j-i}(\Gamma_{p})_{st}," display="block" intent=":literal"><semantics><mrow><mfrac><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mi>n</mi></mfrac><mmultiscripts><mrow><mo lspace="0.170em" stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow></mrow><mprescripts></mprescripts><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow><mrow></mrow></mmultiscripts><mo>=</mo><mmultiscripts><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow></mrow><mprescripts></mprescripts><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow><mrow></mrow></mmultiscripts><mo>−</mo><mfrac><mi>p</mi><mi>n</mi></mfrac><mmultiscripts><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow></mrow><mprescripts></mprescripts><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow><mrow></mrow></mmultiscripts><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{n-p}{n}\,{}_{j-i}(\Gamma_{p})_{st}={}_{j-i}(\Gamma_{p})_{st}-\frac{p}{n}{}_{j-i}(\Gamma_{p})_{st},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px5.p3.5" class="ltx_p"><span id="A8.SS0.SSS0.Px5.p3.5.1" class="ltx_text">and</span></p>
<table id="A8.Ex205" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex205.m1" class="ltx_math_unparsed" alttext="\frac{1}{n}\sum_{k=1}^{n-p}\Big({}_{k+s-i}\,{}_{k+t-j}+{}_{k+t-i}\,{}_{k+s-j}\Big)\;=\;\frac{1}{n}\,c^{(r,2)}_{ij,st}+o(1/n)," display="block" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></munderover><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mmultiscripts><mo lspace="0em" rspace="0em">+</mo><mprescripts></mprescripts><mrow><mrow><mi>k</mi><mo>+</mo><mi>s</mi></mrow><mo>−</mo><mi>i</mi></mrow><mrow></mrow><mrow><mrow><mi>k</mi><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>j</mi></mrow><mrow></mrow></mmultiscripts><mmultiscripts><mo maxsize="1.600em" minsize="1.600em" rspace="0.280em">)</mo><mprescripts></mprescripts><mrow><mrow><mi>k</mi><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>i</mi></mrow><mrow></mrow><mrow><mrow><mi>k</mi><mo>+</mo><mi>s</mi></mrow><mo>−</mo><mi>j</mi></mrow><mrow></mrow></mmultiscripts></mrow><mo rspace="0.558em">=</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>r</mi><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><mi>o</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>/</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{1}{n}\sum_{k=1}^{n-p}\Big({}_{k+s-i}\,{}_{k+t-j}+{}_{k+t-i}\,{}_{k+s-j}\Big)\;=\;\frac{1}{n}\,c^{(r,2)}_{ij,st}+o(1/n),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px5.p3.6" class="ltx_p"><span id="A8.SS0.SSS0.Px5.p3.6.1" class="ltx_text">for some absolutely convergent constant</span></p>
<table id="A8.Ex206" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex206.m1" class="ltx_math_unparsed" alttext="c^{(r,2)}_{ij,st}:=\sum_{k=1}^{\infty}\Big({}_{k+s-i}\,{}_{k+t-j}+{}_{k+t-i}\,{}_{k+s-j}\Big)." display="block" intent=":literal"><semantics><mrow><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>r</mi><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.111em">:=</mo><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mmultiscripts><mo lspace="0em" rspace="0em">+</mo><mprescripts></mprescripts><mrow><mrow><mi>k</mi><mo>+</mo><mi>s</mi></mrow><mo>−</mo><mi>i</mi></mrow><mrow></mrow><mrow><mrow><mi>k</mi><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>j</mi></mrow><mrow></mrow></mmultiscripts><mmultiscripts><mo maxsize="1.600em" minsize="1.600em">)</mo><mprescripts></mprescripts><mrow><mrow><mi>k</mi><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>i</mi></mrow><mrow></mrow><mrow><mrow><mi>k</mi><mo>+</mo><mi>s</mi></mrow><mo>−</mo><mi>j</mi></mrow><mrow></mrow></mmultiscripts></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">c^{(r,2)}_{ij,st}:=\sum_{k=1}^{\infty}\Big({}_{k+s-i}\,{}_{k+t-j}+{}_{k+t-i}\,{}_{k+s-j}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A8.SS0.SSS0.Px5.p4" class="ltx_para">
<p id="A8.SS0.SSS0.Px5.p4.1" class="ltx_p"><span id="A8.SS0.SSS0.Px5.p4.1.1" class="ltx_text">For the fourth–order cumulant, (<a href="#A8.E19" title="Equation 19 ‣ Cumulant identities for linear processes. ‣ Appendix H De–Gaussifying the Gap: Linear Stationary Processes ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>) with <math id="A8.SS0.SSS0.Px5.p4.m1" class="ltx_Math" alttext="r=4" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">r=4</annotation></semantics></math> yields</span></p>
<table id="A8.Ex207" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex207.m1" class="ltx_math_unparsed" alttext="\mathrm{cum}(a,b,e,f)=\kappa_{4}\sum_{u\in\mdmathbb Z}{}_{m+i-1-u}{}_{m+j-1-u}\,{}_{n-p+s-u}{}_{n-p+t-u}." display="block" intent=":literal"><semantics><mrow><mi>cum</mi><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>e</mi><mo>,</mo><mi>f</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi mathvariant="normal">�</mi><mn>4</mn></msub><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>u</mi><mo>∈</mo><mi>Z</mi></mrow></munder><mmultiscripts><mo lspace="0em">.</mo><mprescripts></mprescripts><mrow><mrow><mi>m</mi><mo>+</mo><mi>i</mi></mrow><mo>−</mo><mn>1</mn><mo>−</mo><mi>u</mi></mrow><mrow></mrow><mrow><mrow><mi>m</mi><mo>+</mo><mi>j</mi></mrow><mo>−</mo><mn>1</mn><mo>−</mo><mi>u</mi></mrow><mrow></mrow><mrow><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mi>s</mi></mrow><mo>−</mo><mi>u</mi></mrow><mrow></mrow><mrow><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>u</mi></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\mathrm{cum}(a,b,e,f)=\kappa_{4}\sum_{u\in\mdmathbb Z}{}_{m+i-1-u}{}_{m+j-1-u}\,{}_{n-p+s-u}{}_{n-p+t-u}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px5.p4.2" class="ltx_p"><span id="A8.SS0.SSS0.Px5.p4.2.1" class="ltx_text">Summing over <math id="A8.SS0.SSS0.Px5.p4.m2" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> (equivalently <math id="A8.SS0.SSS0.Px5.p4.m3" class="ltx_Math" alttext="k=n-p-m+1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi><mo>−</mo><mi>m</mi></mrow><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">k=n-p-m+1</annotation></semantics></math>) and using</span></p>
<table id="A8.Ex208" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex208.m1" class="ltx_math_unparsed" alttext="\sum_{k\geq 1}\sum_{u}|{}_{i-u+k}{}_{j-u+k}{}_{s-u}{}_{t-u}|\leq\|\psi\|_{\ell_{1}}^{4}&lt;\infty" display="block" intent=":literal"><semantics><mrow><mo movablelimits="false" rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>k</mi><mo>≥</mo><mn>1</mn></mrow></msub><mo movablelimits="false" rspace="0em">∑</mo><msub><mrow></mrow><mi>u</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mrow></mrow><mrow><mrow><mi>i</mi><mo>−</mo><mi>u</mi></mrow><mo>+</mo><mi>k</mi></mrow></msub><msub><mrow></mrow><mrow><mrow><mi>j</mi><mo>−</mo><mi>u</mi></mrow><mo>+</mo><mi>k</mi></mrow></msub><msub><mrow></mrow><mrow><mi>s</mi><mo>−</mo><mi>u</mi></mrow></msub><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi>u</mi></mrow></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em" rspace="0em">≤</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi mathvariant="normal"> </mi><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><msub><mi mathvariant="normal">ℓ</mi><mn>1</mn></msub></msub><msup><mrow></mrow><mn>4</mn></msup><mo lspace="0.0835em">&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\sum_{k\geq 1}\sum_{u}|{}_{i-u+k}{}_{j-u+k}{}_{s-u}{}_{t-u}|\leq\|\psi\|_{\ell_{1}}^{4}&lt;\infty</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px5.p4.3" class="ltx_p"><span id="A8.SS0.SSS0.Px5.p4.3.1" class="ltx_text">gives</span></p>
<table id="A8.Ex209" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex209.m1" class="ltx_Math" alttext="\frac{1}{n}\sum_{m=1}^{n-p}\mathrm{cum}(a,b,e,f)=\frac{1}{n}\,c^{(r,4)}_{ij,st}+o(1/n)" display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></munderover><mrow><mi>cum</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>e</mi><mo>,</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>r</mi><mo>,</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{1}{n}\sum_{m=1}^{n-p}\mathrm{cum}(a,b,e,f)=\frac{1}{n}\,c^{(r,4)}_{ij,st}+o(1/n)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px5.p4.4" class="ltx_p"><span id="A8.SS0.SSS0.Px5.p4.4.1" class="ltx_text">with an absolutely convergent constant
<math id="A8.SS0.SSS0.Px5.p4.m4" class="ltx_math_unparsed" alttext="c^{(r,4)}_{ij,st}:=\kappa_{4}\sum_{k\geq 1}\sum_{u\in\mdmathbb Z}{}_{i-u+k}{}_{j-u+k}{}_{s-u}{}_{t-u}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>r</mi><mo>,</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mo>:=</mo><mi mathvariant="normal">�</mi><msub><mrow></mrow><mn>4</mn></msub><mo rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>k</mi><mo>≥</mo><mn>1</mn></mrow></msub><mo>∑</mo><msub><mrow></mrow><mrow><mi>u</mi><mo>∈</mo><mi>Z</mi></mrow></msub><msub><mrow></mrow><mrow><mrow><mi>i</mi><mo>−</mo><mi>u</mi></mrow><mo>+</mo><mi>k</mi></mrow></msub><msub><mrow></mrow><mrow><mrow><mi>j</mi><mo>−</mo><mi>u</mi></mrow><mo>+</mo><mi>k</mi></mrow></msub><msub><mrow></mrow><mrow><mi>s</mi><mo>−</mo><mi>u</mi></mrow></msub><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi>u</mi></mrow></msub></mrow><annotation encoding="application/x-tex">c^{(r,4)}_{ij,st}:=\kappa_{4}\sum_{k\geq 1}\sum_{u\in\mdmathbb Z}{}_{i-u+k}{}_{j-u+k}{}_{s-u}{}_{t-u}</annotation></semantics></math>.
Collecting pieces and reorganizing in tensor form yields</span></p>
<table id="A8.Ex210" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex210.m1" class="ltx_Math" alttext="r_{n}=(\mathrm{vec}\,\Gamma_{p+1})\otimes\Gamma_{p}+\frac{1}{n}C_{r}^{(\mathrm{vec})}+o(1/n)," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>r</mi><mi>n</mi></msub><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>vec</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi mathvariant="normal">�</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊗</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>vec</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">r_{n}=(\mathrm{vec}\,\Gamma_{p+1})\otimes\Gamma_{p}+\frac{1}{n}C_{r}^{(\mathrm{vec})}+o(1/n),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px5.p4.5" class="ltx_p"><span id="A8.SS0.SSS0.Px5.p4.5.1" class="ltx_text">and therefore <math id="A8.SS0.SSS0.Px5.p4.m5" class="ltx_Math" alttext="\widetilde{r}_{n}=(L_{p+1}\otimes I_{p})\,r_{n}=r_{\infty}+\tfrac{1}{n}C_{r}+o(1/n)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>n</mi></msub><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>I</mi><mi>p</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>r</mi><mi>n</mi></msub></mrow><mo>=</mo><mrow><msub><mi>r</mi><mi mathvariant="normal">∞</mi></msub><mo>+</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>r</mi></msub></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{r}_{n}=(L_{p+1}\otimes I_{p})\,r_{n}=r_{\infty}+\tfrac{1}{n}C_{r}+o(1/n)</annotation></semantics></math>.</span></p>
</div>
<div id="A8.SS0.SSS0.Px5.p5" class="ltx_para">
<p id="A8.SS0.SSS0.Px5.p5.1" class="ltx_p"><em id="A8.SS0.SSS0.Px5.p5.1.1" class="ltx_emph ltx_font_italic">(II) The <math id="A8.SS0.SSS0.Px5.p5.m1" class="ltx_Math" alttext="S_{n}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>n</mi></msub><annotation encoding="application/x-tex">S_{n}</annotation></semantics></math> expansion.</em><span id="A8.SS0.SSS0.Px5.p5.1.2" class="ltx_text">
For</span></p>
<table id="A8.Ex211" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex211.m1" class="ltx_Math" alttext="S_{n}=\sum_{i,j,k,\ell}\sum_{s,t}\mdmathbb E\big[G_{ij}G_{k\ell}x_{s}x_{t}\big]\;\Big((e_{j}\otimes e_{i}\otimes e_{s})\,(e_{\ell}\otimes e_{k}\otimes e_{t})^{\top}\Big)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>S</mi><mi>n</mi></msub><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></munder><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow></munder><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>G</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>G</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo lspace="0.280em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>e</mi><mi>j</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>e</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>e</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>e</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>e</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>e</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">S_{n}=\sum_{i,j,k,\ell}\sum_{s,t}\mdmathbb E\big[G_{ij}G_{k\ell}x_{s}x_{t}\big]\;\Big((e_{j}\otimes e_{i}\otimes e_{s})\,(e_{\ell}\otimes e_{k}\otimes e_{t})^{\top}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A8.SS0.SSS0.Px5.p6" class="ltx_para">
<p id="A8.SS0.SSS0.Px5.p6.1" class="ltx_p"><span id="A8.SS0.SSS0.Px5.p6.1.1" class="ltx_text">Then</span></p>
<table id="A8.Ex212" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex212.m1" class="ltx_Math" alttext="\mdmathbb E\big[G_{ij}G_{k\ell}x_{s}x_{t}\big]=\frac{1}{n^{2}}\sum_{m=1}^{n-p}\sum_{m^{\prime}=1}^{n-p}\mdmathbb E[abcdef]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>G</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>G</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><msup><mi>n</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></munderover><mrow><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi>m</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></munderover><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mdmathbb E\big[G_{ij}G_{k\ell}x_{s}x_{t}\big]=\frac{1}{n^{2}}\sum_{m=1}^{n-p}\sum_{m^{\prime}=1}^{n-p}\mdmathbb E[abcdef].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
</section>
<section id="A8.SS0.SSS0.Px6" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Sixth–order moment decomposition.</h5>

<div id="A8.SS0.SSS0.Px6.p1" class="ltx_para">
<p id="A8.SS0.SSS0.Px6.p1.1" class="ltx_p">By the moment–cumulant formula in <a href="#A8.Thmtheorem6" title="Lemma H.6 (Moment–cumulant formula). ‣ Auxiliary lemmas used in ‣ Appendix H De–Gaussifying the Gap: Linear Stationary Processes ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">H.6</span></a>,</p>
<table id="A8.E23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.E23.m1" class="ltx_Math" alttext="\mdmathbb E[abcdef]=\sum_{P\in\mathfrak{M}_{3}}\prod_{(u,v)\in P}\mathbb{E}[uv]\;+\;\sum_{\pi\in\Pi_{4,2}}\mathrm{cum}_{4}\bigl(\pi^{(4)}\bigr)\;\mathbb{E}\bigl(\pi^{(2)}\bigr)\;+\;\mathrm{cum}_{6}(a,b,c,d,e,f)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>P</mi><mo>∈</mo><msub><mi>𝔐</mi><mn>3</mn></msub></mrow></munder><mrow><munder><mo movablelimits="false">∏</mo><mrow><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>P</mi></mrow></munder><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo rspace="0.280em" stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo rspace="0.335em">+</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">�</mi><mo>∈</mo><msub><mi mathvariant="normal">�</mi><mrow><mn>4</mn><mo>,</mo><mn>2</mn></mrow></msub></mrow></munder><mrow><msub><mi>cum</mi><mn>4</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msup><mi mathvariant="normal">�</mi><mrow><mo stretchy="false">(</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></msup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0.280em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msup><mi mathvariant="normal">�</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo maxsize="1.200em" minsize="1.200em" rspace="0.280em">)</mo></mrow></mrow></mrow><mo rspace="0.502em">+</mo><mrow><msub><mi>cum</mi><mn>6</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>c</mi><mo>,</mo><mi>d</mi><mo>,</mo><mi>e</mi><mo>,</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mdmathbb E[abcdef]=\sum_{P\in\mathfrak{M}_{3}}\prod_{(u,v)\in P}\mathbb{E}[uv]\;+\;\sum_{\pi\in\Pi_{4,2}}\mathrm{cum}_{4}\bigl(\pi^{(4)}\bigr)\;\mathbb{E}\bigl(\pi^{(2)}\bigr)\;+\;\mathrm{cum}_{6}(a,b,c,d,e,f),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px6.p1.2" class="ltx_p">where <math id="A8.SS0.SSS0.Px6.p1.m1" class="ltx_Math" alttext="\mathfrak{M}_{3}" display="inline" intent=":literal"><semantics><msub><mi>𝔐</mi><mn>3</mn></msub><annotation encoding="application/x-tex">\mathfrak{M}_{3}</annotation></semantics></math> is the set of the <math id="A8.SS0.SSS0.Px6.p1.m2" class="ltx_Math" alttext="15" display="inline" intent=":literal"><semantics><mn>15</mn><annotation encoding="application/x-tex">15</annotation></semantics></math> perfect matchings of <math id="A8.SS0.SSS0.Px6.p1.m3" class="ltx_Math" alttext="\{a,b,c,d,e,f\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>c</mi><mo>,</mo><mi>d</mi><mo>,</mo><mi>e</mi><mo>,</mo><mi>f</mi></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{a,b,c,d,e,f\}</annotation></semantics></math>,
<math id="A8.SS0.SSS0.Px6.p1.m4" class="ltx_Math" alttext="\Pi_{4,2}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">�</mi><mrow><mn>4</mn><mo>,</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\Pi_{4,2}</annotation></semantics></math> is the set of the <math id="A8.SS0.SSS0.Px6.p1.m5" class="ltx_Math" alttext="15" display="inline" intent=":literal"><semantics><mn>15</mn><annotation encoding="application/x-tex">15</annotation></semantics></math> partitions into a <math id="A8.SS0.SSS0.Px6.p1.m6" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math>–block and a <math id="A8.SS0.SSS0.Px6.p1.m7" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>–block,
<math id="A8.SS0.SSS0.Px6.p1.m8" class="ltx_Math" alttext="\pi^{(4)}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">�</mi><mrow><mo stretchy="false">(</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\pi^{(4)}</annotation></semantics></math> denotes the <math id="A8.SS0.SSS0.Px6.p1.m9" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math>–tuple in the <math id="A8.SS0.SSS0.Px6.p1.m10" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math>–block and <math id="A8.SS0.SSS0.Px6.p1.m11" class="ltx_Math" alttext="\pi^{(2)}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">�</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\pi^{(2)}</annotation></semantics></math> the paired variables.
Write <math id="A8.SS0.SSS0.Px6.p1.m12" class="ltx_math_unparsed" alttext="{}_{h}:=\mathbb{E}[x_{t}x_{t+h}]" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mo>:=</mo><mprescripts></mprescripts><mi>h</mi><mrow></mrow></mmultiscripts><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>x</mi><mi>t</mi></msub><msub><mi>x</mi><mrow><mi>t</mi><mo>+</mo><mi>h</mi></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{}_{h}:=\mathbb{E}[x_{t}x_{t+h}]</annotation></semantics></math>.</p>
</div>
</section>
<section id="A8.SS0.SSS0.Px7" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">(a) Triple–pairings.</h5>

<div id="A8.SS0.SSS0.Px7.p1" class="ltx_para">
<p id="A8.SS0.SSS0.Px7.p1.1" class="ltx_p">The three pairings that keep <math id="A8.SS0.SSS0.Px7.p1.m1" class="ltx_Math" alttext="(e,f)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>e</mi><mo>,</mo><mi>f</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(e,f)</annotation></semantics></math> together are</p>
<table id="A8.Ex213" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex213.m1" class="ltx_Math" alttext="P_{0}=\{(a,b),(c,d),(e,f)\},\qquad P_{1}=\{(a,c),(b,d),(e,f)\},\qquad P_{2}=\{(a,d),(b,c),(e,f)\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>P</mi><mn>0</mn></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo>,</mo><mi>f</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>P</mi><mn>1</mn></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo>,</mo><mi>f</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>P</mi><mn>2</mn></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo>,</mo><mi>f</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P_{0}=\{(a,b),(c,d),(e,f)\},\qquad P_{1}=\{(a,c),(b,d),(e,f)\},\qquad P_{2}=\{(a,d),(b,c),(e,f)\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px7.p1.2" class="ltx_p">The leading pairing <math id="A8.SS0.SSS0.Px7.p1.m2" class="ltx_Math" alttext="P_{0}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mn>0</mn></msub><annotation encoding="application/x-tex">P_{0}</annotation></semantics></math> contributes</p>
<table id="A8.Ex214" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex214.m1" class="ltx_math_unparsed" alttext="\frac{1}{n^{2}}\sum_{m,m^{\prime}}{}_{j-i}\,{}_{\ell-k}\,(\Gamma_{p})_{st}={}_{j-i}{}_{\ell-k}(\Gamma_{p})_{st}+\frac{1}{n}\,c^{(S,\mathrm{bd})}_{ij,k\ell;st}+o(1/n)," display="block" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><msup><mi>n</mi><mn>2</mn></msup></mfrac><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>m</mi><mo>,</mo><msup><mi>m</mi><mo>′</mo></msup></mrow></munder><mmultiscripts><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow></mrow><mprescripts></mprescripts><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow><mrow></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>k</mi></mrow><mrow></mrow></mmultiscripts><mo>=</mo><mmultiscripts><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow></mrow><mprescripts></mprescripts><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow><mrow></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>k</mi></mrow><mrow></mrow></mmultiscripts><mo>+</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>;</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>bd</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><mi>o</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>/</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{1}{n^{2}}\sum_{m,m^{\prime}}{}_{j-i}\,{}_{\ell-k}\,(\Gamma_{p})_{st}={}_{j-i}{}_{\ell-k}(\Gamma_{p})_{st}+\frac{1}{n}\,c^{(S,\mathrm{bd})}_{ij,k\ell;st}+o(1/n),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px7.p1.3" class="ltx_p">with</p>
<table id="A8.E24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.E24.m1" class="ltx_math_unparsed" alttext="c^{(S,\mathrm{bd})}_{ij,k\ell;st}=-2p\,{}_{j-i}\,{}_{\ell-k}\,(\Gamma_{p})_{st}." display="block" intent=":literal"><semantics><mrow><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>;</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>bd</mi><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mn>2</mn><mi>p</mi><mmultiscripts><mrow><mo lspace="0.170em" stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow></mrow><mprescripts></mprescripts><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow><mrow></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>k</mi></mrow><mrow></mrow></mmultiscripts><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">c^{(S,\mathrm{bd})}_{ij,k\ell;st}=-2p\,{}_{j-i}\,{}_{\ell-k}\,(\Gamma_{p})_{st}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px7.p1.4" class="ltx_p">The two additional pairings <math id="A8.SS0.SSS0.Px7.p1.m3" class="ltx_Math" alttext="P_{1},P_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mn>1</mn></msub><mo>,</mo><msub><mi>P</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">P_{1},P_{2}</annotation></semantics></math> yield, after the change of variable
<math id="A8.SS0.SSS0.Px7.p1.m4" class="ltx_Math" alttext="h=m-m^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>=</mo><mrow><mi>m</mi><mo>−</mo><msup><mi>m</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">h=m-m^{\prime}</annotation></semantics></math> and Toeplitz summation (see <a href="#A6.Thmtheorem16" title="Lemma F.16 (Toeplitz-type summation). ‣ Auxiliary lemmas used in ‣ F.3 Order of the finite-sample gap ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">F.16</span></a>),</p>
<table id="A8.Ex215" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex215.m1" class="ltx_math_unparsed" alttext="\frac{1}{n^{2}}\sum_{m,m^{\prime}}\Big({}_{i-k+h}\,{}_{j-\ell+h}+{}_{i-\ell+h}\,{}_{j-k+h}\Big)(\Gamma_{p})_{st}=\frac{1}{n}\,c^{(S,0)}_{ij,k\ell;st}+o(1/n)," display="block" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><msup><mi>n</mi><mn>2</mn></msup></mfrac><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>m</mi><mo>,</mo><msup><mi>m</mi><mo>′</mo></msup></mrow></munder><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mmultiscripts><mo lspace="0em" rspace="0em">+</mo><mprescripts></mprescripts><mrow><mrow><mi>i</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mi>h</mi></mrow><mrow></mrow><mrow><mrow><mi>j</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>+</mo><mi>h</mi></mrow><mrow></mrow></mmultiscripts><mmultiscripts><mo maxsize="1.600em" minsize="1.600em">)</mo><mprescripts></mprescripts><mrow><mrow><mi>i</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>+</mo><mi>h</mi></mrow><mrow></mrow><mrow><mrow><mi>j</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mi>h</mi></mrow><mrow></mrow></mmultiscripts></mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo>=</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>;</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><mi>o</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>/</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{1}{n^{2}}\sum_{m,m^{\prime}}\Big({}_{i-k+h}\,{}_{j-\ell+h}+{}_{i-\ell+h}\,{}_{j-k+h}\Big)(\Gamma_{p})_{st}=\frac{1}{n}\,c^{(S,0)}_{ij,k\ell;st}+o(1/n),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px7.p1.5" class="ltx_p">where</p>
<table id="A8.E25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.E25.m1" class="ltx_math_unparsed" alttext="c^{(S,0)}_{ij,k\ell;st}:=\sum_{h\in\mathbb{Z}}\Big({}_{i-k+h}\,{}_{j-\ell+h}+{}_{i-\ell+h}\,{}_{j-k+h}\Big)\,(\Gamma_{p})_{st}\quad\text{(absolutely convergent)}." display="block" intent=":literal"><semantics><mrow><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>;</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.111em">:=</mo><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>h</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mmultiscripts><mo lspace="0em" rspace="0em">+</mo><mprescripts></mprescripts><mrow><mrow><mi>i</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mi>h</mi></mrow><mrow></mrow><mrow><mrow><mi>j</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>+</mo><mi>h</mi></mrow><mrow></mrow></mmultiscripts><mmultiscripts><mo maxsize="1.600em" minsize="1.600em" rspace="0.170em">)</mo><mprescripts></mprescripts><mrow><mrow><mi>i</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>+</mo><mi>h</mi></mrow><mrow></mrow><mrow><mrow><mi>j</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mi>h</mi></mrow><mrow></mrow></mmultiscripts></mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mtext>(absolutely convergent)</mtext><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">c^{(S,0)}_{ij,k\ell;st}:=\sum_{h\in\mathbb{Z}}\Big({}_{i-k+h}\,{}_{j-\ell+h}+{}_{i-\ell+h}\,{}_{j-k+h}\Big)\,(\Gamma_{p})_{st}\quad\text{(absolutely convergent)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px7.p1.6" class="ltx_p">Therefore, the total contribution of the three pairings with <math id="A8.SS0.SSS0.Px7.p1.m5" class="ltx_Math" alttext="(e,f)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>e</mi><mo>,</mo><mi>f</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(e,f)</annotation></semantics></math> paired is</p>
<table id="A8.Ex216" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex216.m1" class="ltx_math_unparsed" alttext="{}_{j-i}{}_{\ell-k}(\Gamma_{p})_{st}+\frac{1}{n}\Big(c^{(S,\mathrm{bd})}_{ij,k\ell;st}+c^{(S,0)}_{ij,k\ell;st}\Big)+o(1/n)." display="block" intent=":literal"><semantics><mrow><mmultiscripts><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow></mrow><mprescripts></mprescripts><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow><mrow></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>k</mi></mrow><mrow></mrow></mmultiscripts><mo>+</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>;</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>bd</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>;</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo>+</mo><mi>o</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>/</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{}_{j-i}{}_{\ell-k}(\Gamma_{p})_{st}+\frac{1}{n}\Big(c^{(S,\mathrm{bd})}_{ij,k\ell;st}+c^{(S,0)}_{ij,k\ell;st}\Big)+o(1/n).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A8.SS0.SSS0.Px7.p2" class="ltx_para">
<p id="A8.SS0.SSS0.Px7.p2.1" class="ltx_p">All other <math id="A8.SS0.SSS0.Px7.p2.m1" class="ltx_Math" alttext="12" display="inline" intent=":literal"><semantics><mn>12</mn><annotation encoding="application/x-tex">12</annotation></semantics></math> pairings necessarily contain at least one cross–pair between
<math id="A8.SS0.SSS0.Px7.p2.m2" class="ltx_Math" alttext="\{a,b,c,d\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>c</mi><mo>,</mo><mi>d</mi></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{a,b,c,d\}</annotation></semantics></math> and <math id="A8.SS0.SSS0.Px7.p2.m3" class="ltx_Math" alttext="\{e,f\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>e</mi><mo>,</mo><mi>f</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{e,f\}</annotation></semantics></math>.
After the change of variable <math id="A8.SS0.SSS0.Px7.p2.m4" class="ltx_Math" alttext="q:=n-p-m+1" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>:=</mo><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi><mo>−</mo><mi>m</mi></mrow><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">q:=n-p-m+1</annotation></semantics></math> (or <math id="A8.SS0.SSS0.Px7.p2.m5" class="ltx_Math" alttext="q:=n-p-m^{\prime}+1" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>:=</mo><mrow><mrow><mi>n</mi><mo>−</mo><mi>p</mi><mo>−</mo><msup><mi>m</mi><mo>′</mo></msup></mrow><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">q:=n-p-m^{\prime}+1</annotation></semantics></math> as appropriate)
and absolute summability of <math id="A8.SS0.SSS0.Px7.p2.m6" class="ltx_math_unparsed" alttext="\{{}_{h}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mmultiscripts><mo stretchy="false">}</mo><mprescripts></mprescripts><mi>h</mi><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\{{}_{h}\}</annotation></semantics></math>,
each such term equals <math id="A8.SS0.SSS0.Px7.p2.m7" class="ltx_Math" alttext="\frac{1}{n}" display="inline" intent=":literal"><semantics><mfrac><mn>1</mn><mi>n</mi></mfrac><annotation encoding="application/x-tex">\frac{1}{n}</annotation></semantics></math> times a finite constant plus <math id="A8.SS0.SSS0.Px7.p2.m8" class="ltx_Math" alttext="o(1/n)" display="inline" intent=":literal"><semantics><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">o(1/n)</annotation></semantics></math>.
Collecting the <math id="A8.SS0.SSS0.Px7.p2.m9" class="ltx_Math" alttext="12" display="inline" intent=":literal"><semantics><mn>12</mn><annotation encoding="application/x-tex">12</annotation></semantics></math> distinct cross–pairings (those where <math id="A8.SS0.SSS0.Px7.p2.m10" class="ltx_Math" alttext="e" display="inline" intent=":literal"><semantics><mi>e</mi><annotation encoding="application/x-tex">e</annotation></semantics></math> or <math id="A8.SS0.SSS0.Px7.p2.m11" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> pairs
with one of <math id="A8.SS0.SSS0.Px7.p2.m12" class="ltx_Math" alttext="a,b,c,d" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>c</mi><mo>,</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">a,b,c,d</annotation></semantics></math>) gives the <em id="A8.SS0.SSS0.Px7.p2.1.1" class="ltx_emph ltx_font_italic">explicit</em> constant via Toeplitz summation (see <a href="#A6.Thmtheorem16" title="Lemma F.16 (Toeplitz-type summation). ‣ Auxiliary lemmas used in ‣ F.3 Order of the finite-sample gap ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">F.16</span></a>)</p>
<table id="A8.EGx16" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A8.Ex217"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.Ex217.m1" class="ltx_math_unparsed" alttext="\displaystyle c^{(S,2)}_{ij,k\ell;st}:=\sum_{q=1}^{\infty}\Big[" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>;</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>:=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>q</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mo maxsize="1.600em" minsize="1.600em">[</mo></mrow><annotation encoding="application/x-tex">\displaystyle c^{(S,2)}_{ij,k\ell;st}:=\sum_{q=1}^{\infty}\Big[</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex217.m2" class="ltx_math_unparsed" alttext="\displaystyle{}_{s-i+q}{}_{t-j+q}\,{}_{\ell-k}+{}_{s-i+q}{}_{t-k}\,{}_{j-\ell+q}+{}_{s-i+q}{}_{t-\ell}\,{}_{j-k+q}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mrow><mrow><mi>s</mi><mo>−</mo><mi>i</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>−</mo><mi>j</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><msub><mrow></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>k</mi></mrow></msub><mo rspace="0em">+</mo><msub><mrow></mrow><mrow><mrow><mi>s</mi><mo>−</mo><mi>i</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub><msub><mrow></mrow><mrow><mrow><mi>j</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><mo lspace="0em">+</mo><msub><mrow></mrow><mrow><mrow><mi>s</mi><mo>−</mo><mi>i</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><msub><mrow></mrow><mrow><mrow><mi>j</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle{}_{s-i+q}{}_{t-j+q}\,{}_{\ell-k}+{}_{s-i+q}{}_{t-k}\,{}_{j-\ell+q}+{}_{s-i+q}{}_{t-\ell}\,{}_{j-k+q}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex218"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex218.m1" class="ltx_math_unparsed" alttext="\displaystyle+{}_{s-j+q}{}_{t-i+q}\,{}_{\ell-k}+{}_{s-j+q}{}_{t-k}\,{}_{i-\ell+q}+{}_{s-j+q}{}_{t-\ell}\,{}_{i-k+q}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">+</mo><msub><mrow></mrow><mrow><mrow><mi>s</mi><mo>−</mo><mi>j</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>−</mo><mi>i</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><msub><mrow></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">+</mo><msub><mrow></mrow><mrow><mrow><mi>s</mi><mo>−</mo><mi>j</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub><msub><mrow></mrow><mrow><mrow><mi>i</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><mo lspace="0em">+</mo><msub><mrow></mrow><mrow><mrow><mi>s</mi><mo>−</mo><mi>j</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><msub><mrow></mrow><mrow><mrow><mi>i</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle+{}_{s-j+q}{}_{t-i+q}\,{}_{\ell-k}+{}_{s-j+q}{}_{t-k}\,{}_{i-\ell+q}+{}_{s-j+q}{}_{t-\ell}\,{}_{i-k+q}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex219"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex219.m1" class="ltx_math_unparsed" alttext="\displaystyle+{}_{t-i+q}{}_{s-j+q}\,{}_{\ell-k}+{}_{t-i+q}{}_{s-k}\,{}_{j-\ell+q}+{}_{t-i+q}{}_{s-\ell}\,{}_{j-k+q}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">+</mo><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>−</mo><mi>i</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><msub><mrow></mrow><mrow><mrow><mi>s</mi><mo>−</mo><mi>j</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><msub><mrow></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">+</mo><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>−</mo><mi>i</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><msub><mrow></mrow><mrow><mi>s</mi><mo>−</mo><mi>k</mi></mrow></msub><msub><mrow></mrow><mrow><mrow><mi>j</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><mo lspace="0em">+</mo><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>−</mo><mi>i</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub><msub><mrow></mrow><mrow><mi>s</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><msub><mrow></mrow><mrow><mrow><mi>j</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle+{}_{t-i+q}{}_{s-j+q}\,{}_{\ell-k}+{}_{t-i+q}{}_{s-k}\,{}_{j-\ell+q}+{}_{t-i+q}{}_{s-\ell}\,{}_{j-k+q}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex220"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex220.m1" class="ltx_math_unparsed" alttext="\displaystyle+{}_{t-j+q}{}_{s-i+q}\,{}_{\ell-k}+{}_{t-j+q}{}_{s-k}\,{}_{i-\ell+q}+{}_{t-j+q}{}_{s-\ell}\,{}_{i-k+q}\Big]." display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">+</mo><mmultiscripts><mo lspace="0em" rspace="0em">+</mo><mprescripts></mprescripts><mrow><mrow><mi>t</mi><mo>−</mo><mi>j</mi></mrow><mo>+</mo><mi>q</mi></mrow><mrow></mrow><mrow><mrow><mi>s</mi><mo>−</mo><mi>i</mi></mrow><mo>+</mo><mi>q</mi></mrow><mrow></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>k</mi></mrow><mrow></mrow></mmultiscripts><mmultiscripts><mo lspace="0em" rspace="0em">+</mo><mprescripts></mprescripts><mrow><mrow><mi>t</mi><mo>−</mo><mi>j</mi></mrow><mo>+</mo><mi>q</mi></mrow><mrow></mrow><mrow><mi>s</mi><mo>−</mo><mi>k</mi></mrow><mrow></mrow><mrow><mrow><mi>i</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>+</mo><mi>q</mi></mrow><mrow></mrow></mmultiscripts><mmultiscripts><mo maxsize="1.600em" minsize="1.600em">]</mo><mprescripts></mprescripts><mrow><mrow><mi>t</mi><mo>−</mo><mi>j</mi></mrow><mo>+</mo><mi>q</mi></mrow><mrow></mrow><mrow><mi>s</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow></mrow><mrow><mrow><mi>i</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mi>q</mi></mrow><mrow></mrow></mmultiscripts><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+{}_{t-j+q}{}_{s-i+q}\,{}_{\ell-k}+{}_{t-j+q}{}_{s-k}\,{}_{i-\ell+q}+{}_{t-j+q}{}_{s-\ell}\,{}_{i-k+q}\Big].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px7.p2.2" class="ltx_p">Therefore the total contribution of triple–pairings is</p>
<table id="A8.E26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.E26.m1" class="ltx_math_unparsed" alttext="{}_{j-i}{}_{\ell-k}(\Gamma_{p})_{st}+\frac{1}{n}\,c^{(S,\mathrm{bd})}_{ij,k\ell;st}+\frac{1}{n}\,c^{(S,0)}_{ij,k\ell;st}+\frac{1}{n}\,c^{(S,2)}_{ij,k\ell;st}+o(1/n)." display="block" intent=":literal"><semantics><mrow><mmultiscripts><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow></mrow><mprescripts></mprescripts><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow><mrow></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>k</mi></mrow><mrow></mrow></mmultiscripts><mo>+</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>;</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>bd</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>;</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>;</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><mi>o</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>/</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{}_{j-i}{}_{\ell-k}(\Gamma_{p})_{st}+\frac{1}{n}\,c^{(S,\mathrm{bd})}_{ij,k\ell;st}+\frac{1}{n}\,c^{(S,0)}_{ij,k\ell;st}+\frac{1}{n}\,c^{(S,2)}_{ij,k\ell;st}+o(1/n).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A8.SS0.SSS0.Px8" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">(b) <math id="A8.SS0.SSS0.Px8.m1" class="ltx_Math" alttext="\{4,2\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>4</mn><mo>,</mo><mn>2</mn><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{4,2\}</annotation></semantics></math> partitions.</h5>

<div id="A8.SS0.SSS0.Px8.p1" class="ltx_para">
<p id="A8.SS0.SSS0.Px8.p1.1" class="ltx_p">For linear processes <math id="A8.SS0.SSS0.Px8.p1.m1" class="ltx_Math" alttext="x_{t}=\sum_{r\in\mathbb{Z}}{}_{t-r}\varepsilon_{r}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>t</mi></msub><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>r</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><mmultiscripts><mi mathvariant="normal">"</mi><mprescripts></mprescripts><mi>r</mi><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi>r</mi></mrow><mrow></mrow></mmultiscripts></mrow></mrow><annotation encoding="application/x-tex">x_{t}=\sum_{r\in\mathbb{Z}}{}_{t-r}\varepsilon_{r}</annotation></semantics></math> with i.i.d. innovations,
the fourth cumulant satisfies <math id="A8.SS0.SSS0.Px8.p1.m2" class="ltx_math_unparsed" alttext="\mathrm{cum}_{4}(x_{t_{1}},x_{t_{2}},x_{t_{3}},x_{t_{4}})=\kappa_{4}\sum_{r\in\mathbb{Z}}{}_{t_{1}-r}{}_{t_{2}-r}{}_{t_{3}-r}{}_{t_{4}-r}" display="inline" intent=":literal"><semantics><mrow><msub><mi>cum</mi><mn>4</mn></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><msub><mi>t</mi><mn>1</mn></msub></msub><mo>,</mo><msub><mi>x</mi><msub><mi>t</mi><mn>2</mn></msub></msub><mo>,</mo><msub><mi>x</mi><msub><mi>t</mi><mn>3</mn></msub></msub><mo>,</mo><msub><mi>x</mi><msub><mi>t</mi><mn>4</mn></msub></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi mathvariant="normal">�</mi><mn>4</mn></msub><msub><mo>∑</mo><mrow><mi>r</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><mmultiscripts><msub><mrow></mrow><mrow><msub><mi>t</mi><mn>4</mn></msub><mo>−</mo><mi>r</mi></mrow></msub><mprescripts></mprescripts><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>−</mo><mi>r</mi></mrow><mrow></mrow><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>−</mo><mi>r</mi></mrow><mrow></mrow><mrow><msub><mi>t</mi><mn>3</mn></msub><mo>−</mo><mi>r</mi></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\mathrm{cum}_{4}(x_{t_{1}},x_{t_{2}},x_{t_{3}},x_{t_{4}})=\kappa_{4}\sum_{r\in\mathbb{Z}}{}_{t_{1}-r}{}_{t_{2}-r}{}_{t_{3}-r}{}_{t_{4}-r}</annotation></semantics></math>,
where <math id="A8.SS0.SSS0.Px8.p1.m3" class="ltx_Math" alttext="\kappa_{4}=\mathrm{cum}_{4}(\varepsilon)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">�</mi><mn>4</mn></msub><mo>=</mo><mrow><msub><mi>cum</mi><mn>4</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">"</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\kappa_{4}=\mathrm{cum}_{4}(\varepsilon)</annotation></semantics></math> and <math id="A8.SS0.SSS0.Px8.p1.m4" class="ltx_math_unparsed" alttext="\sum_{k}|{}_{k}|&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∑</mo><msub><mrow></mrow><mi>k</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mrow></mrow><mi>k</mi></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\sum_{k}|{}_{k}|&lt;\infty</annotation></semantics></math>.
Define the absolutely convergent series</p>
<table id="A8.Ex221" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex221.m1" class="ltx_math_unparsed" alttext="S_{ab}(r):=\sum_{q\in\mathbb{Z}}{}_{q+i-1-r}\,{}_{q+j-1-r},\qquad S_{cd}(r):=\sum_{q\in\mathbb{Z}}{}_{q+k-1-r}\,{}_{q+\ell-1-r}." display="block" intent=":literal"><semantics><mrow><msub><mi>S</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">:=</mo><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>q</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder><mmultiscripts><mo rspace="2.167em">,</mo><mprescripts></mprescripts><mrow><mrow><mi>q</mi><mo>+</mo><mi>i</mi></mrow><mo>−</mo><mn>1</mn><mo>−</mo><mi>r</mi></mrow><mrow></mrow><mrow><mrow><mi>q</mi><mo>+</mo><mi>j</mi></mrow><mo>−</mo><mn>1</mn><mo>−</mo><mi>r</mi></mrow><mrow></mrow></mmultiscripts><msub><mi>S</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">:=</mo><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>q</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder><mmultiscripts><mo lspace="0em">.</mo><mprescripts></mprescripts><mrow><mrow><mi>q</mi><mo>+</mo><mi>k</mi></mrow><mo>−</mo><mn>1</mn><mo>−</mo><mi>r</mi></mrow><mrow></mrow><mrow><mrow><mi>q</mi><mo>+</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>−</mo><mn>1</mn><mo>−</mo><mi>r</mi></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">S_{ab}(r):=\sum_{q\in\mathbb{Z}}{}_{q+i-1-r}\,{}_{q+j-1-r},\qquad S_{cd}(r):=\sum_{q\in\mathbb{Z}}{}_{q+k-1-r}\,{}_{q+\ell-1-r}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px8.p1.2" class="ltx_p">By stationarity and Toeplitz summation,
only the three families of partitions in which the <math id="A8.SS0.SSS0.Px8.p1.m5" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math>-block contains either
<math id="A8.SS0.SSS0.Px8.p1.m6" class="ltx_Math" alttext="\{a,b\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{a,b\}</annotation></semantics></math> or <math id="A8.SS0.SSS0.Px8.p1.m7" class="ltx_Math" alttext="\{c,d\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>c</mi><mo>,</mo><mi>d</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{c,d\}</annotation></semantics></math> contribute at order <math id="A8.SS0.SSS0.Px8.p1.m8" class="ltx_Math" alttext="1/n" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">1/n</annotation></semantics></math>; all other <math id="A8.SS0.SSS0.Px8.p1.m9" class="ltx_Math" alttext="\{4,2\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>4</mn><mo>,</mo><mn>2</mn><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{4,2\}</annotation></semantics></math> partitions
are <math id="A8.SS0.SSS0.Px8.p1.m10" class="ltx_Math" alttext="o(1/n)" display="inline" intent=":literal"><semantics><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">o(1/n)</annotation></semantics></math>.
The non–vanishing <math id="A8.SS0.SSS0.Px8.p1.m11" class="ltx_Math" alttext="1/n" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">1/n</annotation></semantics></math> constants are</p>
<table id="A8.EGx17" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A8.Ex222"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.Ex222.m1" class="ltx_math_unparsed" alttext="\displaystyle c^{(S,4)}_{ij,k\ell;st}:=\ \kappa_{4}\sum_{r\in\mathbb{Z}}\Big[" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>;</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.778em">:=</mo><msub><mi mathvariant="normal">�</mi><mn>4</mn></msub><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder></mstyle><mo maxsize="1.600em" minsize="1.600em">[</mo></mrow><annotation encoding="application/x-tex">\displaystyle c^{(S,4)}_{ij,k\ell;st}:=\ \kappa_{4}\sum_{r\in\mathbb{Z}}\Big[</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex222.m2" class="ltx_math_unparsed" alttext="\displaystyle{}_{t-s}\,S_{ab}(r)\,S_{cd}(r)\ +\ {}_{\ell-k}\,S_{ab}(r)\,{}_{s-r}{}_{t-r}" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mi>S</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><mrow></mrow><mprescripts></mprescripts><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow><mrow></mrow></mmultiscripts><mrow><mo stretchy="false">(</mo><mi>r</mi><mo rspace="0.170em" stretchy="false">)</mo></mrow><msub><mi>S</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>r</mi><mo rspace="0.500em" stretchy="false">)</mo></mrow><mo rspace="0.722em">+</mo><mmultiscripts><mi>S</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><mrow></mrow><mprescripts></mprescripts><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>k</mi></mrow><mrow></mrow></mmultiscripts><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mmultiscripts><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi>r</mi></mrow></msub><mprescripts></mprescripts><mrow><mi>s</mi><mo>−</mo><mi>r</mi></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\displaystyle{}_{t-s}\,S_{ab}(r)\,S_{cd}(r)\ +\ {}_{\ell-k}\,S_{ab}(r)\,{}_{s-r}{}_{t-r}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.E27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.E27.m1" class="ltx_math_unparsed" alttext="\displaystyle\ +\ {}_{j-i}\,S_{cd}(r)\,{}_{s-r}{}_{t-r}\Big]." display="inline" intent=":literal"><semantics><mrow><mo rspace="0.722em">+</mo><mmultiscripts><mi>S</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mrow></mrow><mprescripts></mprescripts><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow><mrow></mrow></mmultiscripts><mrow><mo stretchy="false">(</mo><mi>r</mi><mo rspace="0.170em" stretchy="false">)</mo></mrow><mmultiscripts><mo maxsize="1.600em" minsize="1.600em">]</mo><mprescripts></mprescripts><mrow><mi>s</mi><mo>−</mo><mi>r</mi></mrow><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi>r</mi></mrow><mrow></mrow></mmultiscripts><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ +\ {}_{j-i}\,S_{cd}(r)\,{}_{s-r}{}_{t-r}\Big].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(27)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A8.SS0.SSS0.Px9" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">(c) Sixth–order cumulant.</h5>

<div id="A8.SS0.SSS0.Px9.p1" class="ltx_para">
<p id="A8.SS0.SSS0.Px9.p1.1" class="ltx_p">Using
<math id="A8.SS0.SSS0.Px9.p1.m1" class="ltx_math_unparsed" alttext="\mathrm{cum}_{6}(x_{t_{1}},\ldots,x_{t_{6}})=\kappa_{6}\sum_{r\in\mathbb{Z}}\prod_{u=1}^{6}{}_{t_{u}-r}" display="inline" intent=":literal"><semantics><mrow><msub><mi>cum</mi><mn>6</mn></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><msub><mi>t</mi><mn>1</mn></msub></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><msub><mi>t</mi><mn>6</mn></msub></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi mathvariant="normal">�</mi><mn>6</mn></msub><msub><mo rspace="0em">∑</mo><mrow><mi>r</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><msubsup><mo>∏</mo><mrow><mi>u</mi><mo>=</mo><mn>1</mn></mrow><mn>6</mn></msubsup><msub><mrow></mrow><mrow><msub><mi>t</mi><mi>u</mi></msub><mo>−</mo><mi>r</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathrm{cum}_{6}(x_{t_{1}},\ldots,x_{t_{6}})=\kappa_{6}\sum_{r\in\mathbb{Z}}\prod_{u=1}^{6}{}_{t_{u}-r}</annotation></semantics></math>
with <math id="A8.SS0.SSS0.Px9.p1.m2" class="ltx_Math" alttext="\kappa_{6}=\mathrm{cum}_{6}(\varepsilon)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">�</mi><mn>6</mn></msub><mo>=</mo><mrow><msub><mi>cum</mi><mn>6</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">"</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\kappa_{6}=\mathrm{cum}_{6}(\varepsilon)</annotation></semantics></math>,
the double sum over <math id="A8.SS0.SSS0.Px9.p1.m3" class="ltx_Math" alttext="(m,m^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><msup><mi>m</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(m,m^{\prime})</annotation></semantics></math> reduces (by Toeplitz summation) to</p>
<table id="A8.E28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.E28.m1" class="ltx_math_unparsed" alttext="\frac{1}{n}\,c^{(S,6)}_{ij,k\ell;st}+o(1/n),\qquad c^{(S,6)}_{ij,k\ell;st}:=\kappa_{6}\sum_{r\in\mathbb{Z}}S_{ab}(r)\,S_{cd}(r)\,{}_{s-r}{}_{t-r}." display="block" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>;</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mn>6</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><mi>o</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>/</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo rspace="2.167em">,</mo><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>;</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mn>6</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>:=</mo><msub><mi mathvariant="normal">�</mi><mn>6</mn></msub><munder><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder><msub><mi>S</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>r</mi><mo rspace="0.170em" stretchy="false">)</mo></mrow><msub><mi>S</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mmultiscripts><mo lspace="0.170em">.</mo><mprescripts></mprescripts><mrow><mi>s</mi><mo>−</mo><mi>r</mi></mrow><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi>r</mi></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\frac{1}{n}\,c^{(S,6)}_{ij,k\ell;st}+o(1/n),\qquad c^{(S,6)}_{ij,k\ell;st}:=\kappa_{6}\sum_{r\in\mathbb{Z}}S_{ab}(r)\,S_{cd}(r)\,{}_{s-r}{}_{t-r}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A8.SS0.SSS0.Px10" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">(d) Collecting the pieces.</h5>

<div id="A8.SS0.SSS0.Px10.p1" class="ltx_para">
<p id="A8.SS0.SSS0.Px10.p1.1" class="ltx_p">Combining (<a href="#A8.E26" title="Equation 26 ‣ (a) Triple–pairings. ‣ Appendix H De–Gaussifying the Gap: Linear Stationary Processes ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>), (<a href="#A8.E27" title="Equation 27 ‣ (b) {4,2} partitions. ‣ Appendix H De–Gaussifying the Gap: Linear Stationary Processes ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a>) and (<a href="#A8.E28" title="Equation 28 ‣ (c) Sixth–order cumulant. ‣ Appendix H De–Gaussifying the Gap: Linear Stationary Processes ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">28</span></a>) in (<a href="#A8.E23" title="Equation 23 ‣ Sixth–order moment decomposition. ‣ Appendix H De–Gaussifying the Gap: Linear Stationary Processes ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>) yields</p>
<table id="A8.Ex223" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex223.m1" class="ltx_math_unparsed" alttext="\mathbb{E}\big[G_{ij}G_{k\ell}x_{s}x_{t}\big]={}_{j-i}\,{}_{\ell-k}\,(\Gamma_{p})_{st}+\frac{1}{n}\Big(c^{(S,\mathrm{bd})}_{ij,k\ell;st}+c^{(S,0)}_{ij,k\ell;st}+c^{(S,2)}_{ij,k\ell;st}+c^{(S,4)}_{ij,k\ell;st}+c^{(S,6)}_{ij,k\ell;st}\Big)+o(1/n)." display="block" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msub><mi>G</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><msub><mi>G</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><msub><mi>x</mi><mi>s</mi></msub><msub><mi>x</mi><mi>t</mi></msub><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo>=</mo><mmultiscripts><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow></mrow><mprescripts></mprescripts><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow><mrow></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>k</mi></mrow><mrow></mrow></mmultiscripts><mo>+</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>;</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>bd</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>;</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>;</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>;</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>;</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mn>6</mn><mo stretchy="false">)</mo></mrow></msubsup><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo>+</mo><mi>o</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>/</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\big[G_{ij}G_{k\ell}x_{s}x_{t}\big]={}_{j-i}\,{}_{\ell-k}\,(\Gamma_{p})_{st}+\frac{1}{n}\Big(c^{(S,\mathrm{bd})}_{ij,k\ell;st}+c^{(S,0)}_{ij,k\ell;st}+c^{(S,2)}_{ij,k\ell;st}+c^{(S,4)}_{ij,k\ell;st}+c^{(S,6)}_{ij,k\ell;st}\Big)+o(1/n).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px10.p1.2" class="ltx_p">Therefore</p>
<table id="A8.Ex224" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex224.m1" class="ltx_Math" alttext="S_{n}=\bigl(\mathrm{vec}\,\Gamma_{p+1}\bigr)\bigl(\mathrm{vec}\,\Gamma_{p+1}\bigr)^{\top}\otimes\Gamma_{p}+\frac{1}{n}\,C_{S}^{(\mathrm{vec})}+o(1/n)," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>S</mi><mi>n</mi></msub><mo>=</mo><mrow><mrow><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>vec</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi mathvariant="normal">�</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>vec</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi mathvariant="normal">�</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.055em">)</mo></mrow><mo>⊤</mo></msup></mrow><mo rspace="0.222em">⊗</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>C</mi><mi>S</mi><mrow><mo stretchy="false">(</mo><mi>vec</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">S_{n}=\bigl(\mathrm{vec}\,\Gamma_{p+1}\bigr)\bigl(\mathrm{vec}\,\Gamma_{p+1}\bigr)^{\top}\otimes\Gamma_{p}+\frac{1}{n}\,C_{S}^{(\mathrm{vec})}+o(1/n),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px10.p1.3" class="ltx_p">with the explicit block</p>
<table id="A8.Ex225" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex225.m1" class="ltx_Math" alttext="C_{S}^{(\mathrm{vec})}:=\sum_{i,j,k,\ell}\sum_{s,t}\Big(c^{(S,\mathrm{bd})}_{ij,k\ell;st}+c^{(S,0)}_{ij,k\ell;st}+c^{(S,2)}_{ij,k\ell;st}+c^{(S,4)}_{ij,k\ell;st}+c^{(S,6)}_{ij,k\ell;st}\Big)\,\Big((e_{j}\otimes e_{i}\otimes e_{s})\,(e_{\ell}\otimes e_{k}\otimes e_{t})^{\top}\Big)." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>C</mi><mi>S</mi><mrow><mo stretchy="false">(</mo><mi>vec</mi><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.111em">:=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></munder><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow></munder><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>;</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>bd</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>;</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>;</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>;</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mi>c</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>;</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mn>6</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>e</mi><mi>j</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>e</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>e</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>e</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>e</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>e</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">C_{S}^{(\mathrm{vec})}:=\sum_{i,j,k,\ell}\sum_{s,t}\Big(c^{(S,\mathrm{bd})}_{ij,k\ell;st}+c^{(S,0)}_{ij,k\ell;st}+c^{(S,2)}_{ij,k\ell;st}+c^{(S,4)}_{ij,k\ell;st}+c^{(S,6)}_{ij,k\ell;st}\Big)\,\Big((e_{j}\otimes e_{i}\otimes e_{s})\,(e_{\ell}\otimes e_{k}\otimes e_{t})^{\top}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px10.p1.4" class="ltx_p">Finally, since <math id="A8.SS0.SSS0.Px10.p1.m1" class="ltx_Math" alttext="\widetilde{S}_{n}=(L_{p+1}\otimes I_{p})\,S_{n}\,(L_{p+1}\otimes I_{p})^{\top}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>n</mi></msub><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>I</mi><mi>p</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>S</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>I</mi><mi>p</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\widetilde{S}_{n}=(L_{p+1}\otimes I_{p})\,S_{n}\,(L_{p+1}\otimes I_{p})^{\top}</annotation></semantics></math>,
we obtain <math id="A8.SS0.SSS0.Px10.p1.m2" class="ltx_Math" alttext="\widetilde{S}_{n}=S_{\infty}+\tfrac{1}{n}C_{S}+o(1/n)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>n</mi></msub><mo>=</mo><mrow><msub><mi>S</mi><mi mathvariant="normal">∞</mi></msub><mo>+</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>S</mi></msub></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{S}_{n}=S_{\infty}+\tfrac{1}{n}C_{S}+o(1/n)</annotation></semantics></math>, where <math id="A8.SS0.SSS0.Px10.p1.m3" class="ltx_Math" alttext="S_{\infty}=(uu^{\top})\otimes\Gamma_{p}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi mathvariant="normal">∞</mi></msub><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mo>⊤</mo></msup></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊗</mo><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub></mrow></mrow><annotation encoding="application/x-tex">S_{\infty}=(uu^{\top})\otimes\Gamma_{p}</annotation></semantics></math>
and <math id="A8.SS0.SSS0.Px10.p1.m4" class="ltx_Math" alttext="C_{S}=(L_{p+1}\otimes I_{p})\,C_{S}^{(\mathrm{vec})}\,(L_{p+1}\otimes I_{p})^{\top}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>S</mi></msub><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>I</mi><mi>p</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>C</mi><mi>S</mi><mrow><mo stretchy="false">(</mo><mi>vec</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>I</mi><mi>p</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">C_{S}=(L_{p+1}\otimes I_{p})\,C_{S}^{(\mathrm{vec})}\,(L_{p+1}\otimes I_{p})^{\top}</annotation></semantics></math>.
Absolute summability of <math id="A8.SS0.SSS0.Px10.p1.m5" class="ltx_math_unparsed" alttext="\{{}_{h}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mmultiscripts><mo stretchy="false">}</mo><mprescripts></mprescripts><mi>h</mi><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\{{}_{h}\}</annotation></semantics></math> and <math id="A8.SS0.SSS0.Px10.p1.m6" class="ltx_math_unparsed" alttext="\{{}_{k}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mmultiscripts><mo stretchy="false">}</mo><mprescripts></mprescripts><mi>k</mi><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\{{}_{k}\}</annotation></semantics></math>, and finiteness of
<math id="A8.SS0.SSS0.Px10.p1.m7" class="ltx_Math" alttext="\kappa_{4},\kappa_{6}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">�</mi><mn>4</mn></msub><mo>,</mo><msub><mi mathvariant="normal">�</mi><mn>6</mn></msub></mrow><annotation encoding="application/x-tex">\kappa_{4},\kappa_{6}</annotation></semantics></math>, ensure that all series above converge absolutely and justify
the <math id="A8.SS0.SSS0.Px10.p1.m8" class="ltx_Math" alttext="o(1/n)" display="inline" intent=":literal"><semantics><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">o(1/n)</annotation></semantics></math> remainder.
∎</p>
</div>
<div id="A8.Thmtheorem5" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A8.Thmtheorem5.2" class="ltx_text ltx_font_bold">Theorem H.5</span></span><span id="A8.Thmtheorem5.3" class="ltx_text ltx_font_bold"> </span>(Order of the non–Gaussian gap)<span id="A8.Thmtheorem5.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A8.Thmtheorem5.p1" class="ltx_para">
<p id="A8.Thmtheorem5.p1.1" class="ltx_p"><span id="A8.Thmtheorem5.p1.1.1" class="ltx_text ltx_font_italic">Under Lemma <a href="#A8.Thmtheorem4" title="Lemma H.4 (Moment expansions via cumulants). ‣ Cumulant identities for linear processes. ‣ Appendix H De–Gaussifying the Gap: Linear Stationary Processes ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H.4</span></a>, let <math id="A8.Thmtheorem5.p1.m1" class="ltx_Math" alttext="Q=[u/\|u\|,Q_{\perp}]" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>u</mi><mo>/</mo><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow></mrow><mo>,</mo><msub><mi>Q</mi><mo>⟂</mo></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">Q=[u/\|u\|,Q_{\perp}]</annotation></semantics></math> and <math id="A8.Thmtheorem5.p1.m2" class="ltx_Math" alttext="P:=Q\otimes I_{p}" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>:=</mo><mrow><mi>Q</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>I</mi><mi>p</mi></msub></mrow></mrow><annotation encoding="application/x-tex">P:=Q\otimes I_{p}</annotation></semantics></math>.
Then the block–inverse expansion of Lemma <a href="#A6.Thmtheorem13" title="Lemma F.13 (Singular block inverse and first-order Schur complement). ‣ Setup (recalled). ‣ F.3 Order of the finite-sample gap ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.13</span></a> applies verbatim, and</span></p>
<table id="A8.Ex226" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex226.m1" class="ltx_Math" alttext="\Delta_{n}\;=\;\Gamma_{p}-\widetilde{r}_{n}^{\top}\widetilde{S}_{n}^{-1}\widetilde{r}_{n}\;=\;\frac{1}{n}\,B_{p}+o(1/n)," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">�</mi><mi>n</mi></msub><mo lspace="0.558em" rspace="0.558em">=</mo><mrow><msub><mi mathvariant="normal">�</mi><mi>p</mi></msub><mo>−</mo><mrow><msubsup><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>n</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>r</mi><mo>~</mo></mover><mi>n</mi></msub></mrow></mrow><mo rspace="0.558em">=</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>B</mi><mi>p</mi></msub></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\Delta_{n}\;=\;\Gamma_{p}-\widetilde{r}_{n}^{\top}\widetilde{S}_{n}^{-1}\widetilde{r}_{n}\;=\;\frac{1}{n}\,B_{p}+o(1/n),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.Thmtheorem5.p1.2" class="ltx_p"><span id="A8.Thmtheorem5.p1.2.1" class="ltx_text ltx_font_italic">with <math id="A8.Thmtheorem5.p1.m3" class="ltx_Math" alttext="B_{p}\succeq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>p</mi></msub><mo>⪰</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">B_{p}\succeq 0</annotation></semantics></math> given by the same closed form as in (<a href="#A6.Ex137" title="In Lemma F.13 (Singular block inverse and first-order Schur complement). ‣ Setup (recalled). ‣ F.3 Order of the finite-sample gap ‣ Appendix F Closed-Form Gap Characterization between LSA and Linear Models ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>) after replacing the Gaussian <math id="A8.Thmtheorem5.p1.m4" class="ltx_Math" alttext="C_{S},C_{r}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>S</mi></msub><mo>,</mo><msub><mi>C</mi><mi>r</mi></msub></mrow><annotation encoding="application/x-tex">C_{S},C_{r}</annotation></semantics></math> by those from Lemma <a href="#A8.Thmtheorem4" title="Lemma H.4 (Moment expansions via cumulants). ‣ Cumulant identities for linear processes. ‣ Appendix H De–Gaussifying the Gap: Linear Stationary Processes ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H.4</span></a>. Generically <math id="A8.Thmtheorem5.p1.m5" class="ltx_Math" alttext="B_{p}\succ 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>p</mi></msub><mo>≻</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">B_{p}\succ 0</annotation></semantics></math>.</span></p>
</div>
</div>
</section>
<section id="A8.SS0.SSS0.Px11" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Remarks.</h5>

<div id="A8.SS0.SSS0.Px11.p1" class="ltx_para">
<p id="A8.SS0.SSS0.Px11.p1.1" class="ltx_p">(i) <em id="A8.SS0.SSS0.Px11.p1.1.1" class="ltx_emph ltx_font_italic">No Gaussianity is needed</em> for strict PD and the positive Schur–complement gap: independence of innovations with finite fourth moment (and <math id="A8.SS0.SSS0.Px11.p1.m1" class="ltx_Math" alttext="\var(\varepsilon^{2})&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">Var</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">"</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\var(\varepsilon^{2})&gt;0</annotation></semantics></math>) suffices.
(ii) If in addition <math id="A8.SS0.SSS0.Px11.p1.m2" class="ltx_math_unparsed" alttext="\sum_{h}|{}_{h}|&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∑</mo><msub><mrow></mrow><mi>h</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mrow></mrow><mi>h</mi></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\sum_{h}|{}_{h}|&lt;\infty</annotation></semantics></math> and <math id="A8.SS0.SSS0.Px11.p1.m3" class="ltx_Math" alttext="\mathbb{E}|\varepsilon|^{6}&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mi mathvariant="normal">"</mi><mo stretchy="false">|</mo></mrow><mn>6</mn></msup></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\mathbb{E}|\varepsilon|^{6}&lt;\infty</annotation></semantics></math>, the exact <math id="A8.SS0.SSS0.Px11.p1.m4" class="ltx_Math" alttext="1/n" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">1/n</annotation></semantics></math> order persists for general linear stationary processes; Gaussianity only simplifies the constants via Wick pairings.</p>
</div>
</section>
<section id="A8.SS0.SSS0.Px12" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Discussion on AR/MA/ARMA models.</h5>

<div id="A8.SS0.SSS0.Px12.p1" class="ltx_para">
<p id="A8.SS0.SSS0.Px12.p1.1" class="ltx_p">Stable AR, MA, and ARMA processes satisfy the assumptions above, so
Theorems <a href="#A8.Thmtheorem3" title="Theorem H.3 (Strict finite–sample gap under linear stationarity). ‣ Linear regression predictor. ‣ Appendix H De–Gaussifying the Gap: Linear Stationary Processes ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H.3</span></a> and <a href="#A8.Thmtheorem5" title="Theorem H.5 (Order of the non–Gaussian gap). ‣ (d) Collecting the pieces. ‣ Appendix H De–Gaussifying the Gap: Linear Stationary Processes ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H.5</span></a> apply directly.
Nevertheless, caution is warranted in interpreting the result.
For MA or ARMA models, the one–step prediction error <math id="A8.SS0.SSS0.Px12.p1.m1" class="ltx_Math" alttext="e_{n+1}" display="inline" intent=":literal"><semantics><msub><mi>e</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">e_{n+1}</annotation></semantics></math> still carries
dependence on portions of the past beyond the last <math id="A8.SS0.SSS0.Px12.p1.m2" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> lags.
This prevents a direct characterization of the mean–squared error gap between
LSA and linear regression with respect to the true target <math id="A8.SS0.SSS0.Px12.p1.m3" class="ltx_Math" alttext="x_{n+1}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">x_{n+1}</annotation></semantics></math>.
Hence the finite–lag linear regression predictor
<math id="A8.SS0.SSS0.Px12.p1.m4" class="ltx_Math" alttext="\widehat{x}_{n+1}^{\mathrm{LR}}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mi>LR</mi></msubsup><annotation encoding="application/x-tex">\widehat{x}_{n+1}^{\mathrm{LR}}</annotation></semantics></math> does not coincide with the globally optimal
(infinite–order) linear predictor.
In particular, for MA models there may exist richer linear predictors that
exploit the entire past more effectively. Our analysis should therefore be
understood not as a claim of global optimality across all linear predictors,
but rather as an insight into the structural gap that persists even when
comparing LSA against the natural <math id="A8.SS0.SSS0.Px12.p1.m5" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>–lag linear regression benchmark.</p>
</div>
</section>
<section id="A8.SS0.SSSx1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection">Auxiliary lemmas used in <a href="#A8" title="Appendix H De–Gaussifying the Gap: Linear Stationary Processes ‣ Why Do Transformers Fail to Forecast Time Series In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Appendix</span> <span class="ltx_text ltx_ref_tag">H</span></a></h4>

<div id="A8.Thmtheorem6" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A8.Thmtheorem6.2" class="ltx_text ltx_font_bold">Lemma H.6</span></span><span id="A8.Thmtheorem6.3" class="ltx_text ltx_font_bold"> </span>(Moment–cumulant formula)<span id="A8.Thmtheorem6.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A8.Thmtheorem6.p1" class="ltx_para">
<p id="A8.Thmtheorem6.p1.1" class="ltx_p"><span id="A8.Thmtheorem6.p1.1.1" class="ltx_text ltx_font_italic">For random variables <math id="A8.Thmtheorem6.p1.m1" class="ltx_Math" alttext="X_{1},\dots,X_{r}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>X</mi><mi>r</mi></msub></mrow><annotation encoding="application/x-tex">X_{1},\dots,X_{r}</annotation></semantics></math> with finite moments up to order <math id="A8.Thmtheorem6.p1.m2" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>, the joint moment can be expressed in terms of cumulants as</span></p>
<table id="A8.Ex227" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex227.m1" class="ltx_math_unparsed" alttext="\mathbb{E}\left[\prod_{i=1}^{r}X_{i}\right]\;=\;\sum_{\pi\in\mathcal{P}_{r}}\ \prod_{B\in\pi}\mathrm{cum}\bigl(X_{j}:j\in B\bigr)," display="block" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo>[</mo><munderover><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover><msub><mi>X</mi><mi>i</mi></msub><mo rspace="0.280em">]</mo></mrow><mo rspace="0.391em">=</mo><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi mathvariant="normal">�</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>r</mi></msub></mrow></munder><munder><mo movablelimits="false">∏</mo><mrow><mi>B</mi><mo>∈</mo><mi mathvariant="normal">�</mi></mrow></munder><mi>cum</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>X</mi><mi>j</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mi>j</mi><mo>∈</mo><mi>B</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\prod_{i=1}^{r}X_{i}\right]\;=\;\sum_{\pi\in\mathcal{P}_{r}}\ \prod_{B\in\pi}\mathrm{cum}\bigl(X_{j}:j\in B\bigr),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.Thmtheorem6.p1.2" class="ltx_p"><span id="A8.Thmtheorem6.p1.2.1" class="ltx_text ltx_font_italic">where <math id="A8.Thmtheorem6.p1.m3" class="ltx_Math" alttext="\mathcal{P}_{r}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>r</mi></msub><annotation encoding="application/x-tex">\mathcal{P}_{r}</annotation></semantics></math> denotes the set of all partitions of <math id="A8.Thmtheorem6.p1.m4" class="ltx_Math" alttext="\{1,\dots,r\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>r</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{1,\dots,r\}</annotation></semantics></math>, and
<math id="A8.Thmtheorem6.p1.m5" class="ltx_Math" alttext="\mathrm{cum}(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>cum</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{cum}(\cdot)</annotation></semantics></math> denotes the joint cumulant.</span></p>
</div>
</div>
</section>
</section>
