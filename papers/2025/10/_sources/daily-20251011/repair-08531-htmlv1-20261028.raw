<td id="A3.T7.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t">149</td>
<td id="A3.T7.2.1.3.4" class="ltx_td ltx_align_center ltx_border_t">463</td>
<td id="A3.T7.2.1.3.5" class="ltx_td ltx_align_center ltx_border_t">91</td>
<td id="A3.T7.2.1.3.6" class="ltx_td ltx_align_center ltx_border_t">306</td>
<td id="A3.T7.2.1.3.7" class="ltx_td ltx_align_center ltx_border_t">1,009</td></tr>
<tr id="A3.T7.2.1.4" class="ltx_tr">
