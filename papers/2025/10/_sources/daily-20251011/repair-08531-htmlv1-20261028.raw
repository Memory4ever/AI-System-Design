<td id="A3.T12.8.1.8.6" class="ltx_td ltx_align_center ltx_border_t"><span id="A3.T12.8.1.8.6.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">29.9</span></td>
<td id="A3.T12.8.1.8.7" class="ltx_td ltx_align_center ltx_border_t"><span id="A3.T12.8.1.8.7.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">26.3</span></td>
<td id="A3.T12.8.1.8.8" class="ltx_td ltx_align_center ltx_border_t"><span id="A3.T12.8.1.8.8.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">32.0</span></td>
<td id="A3.T12.8.1.8.9" class="ltx_td ltx_align_center ltx_border_t"><span id="A3.T12.8.1.8.9.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">35.6</span></td></tr>
<tr id="A3.T12.8.1.9" class="ltx_tr" style="--ltx-bg-color:#F2F2F2;">
<td id="A3.T12.8.1.9.1" class="ltx_td ltx_align_left"><span id="A3.T12.8.1.9.1.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">SpatialLadder-3B</span></td>
<td id="A3.T12.8.1.9.2" class="ltx_td ltx_align_center"><span id="A3.T12.8.1.9.2.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F2F2F2;">48.3</span></td>
<td id="A3.T12.8.1.9.3" class="ltx_td ltx_align_center"><span id="A3.T12.8.1.9.3.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">24.1</span></td>
<td id="A3.T12.8.1.9.4" class="ltx_td ltx_align_center"><span id="A3.T12.8.1.9.4.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">39.6</span></td>
<td id="A3.T12.8.1.9.5" class="ltx_td ltx_align_center"><span id="A3.T12.8.1.9.5.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F2F2F2;">71.1</span></td>
<td id="A3.T12.8.1.9.6" class="ltx_td ltx_align_center"><span id="A3.T12.8.1.9.6.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">34.4</span></td>
<td id="A3.T12.8.1.9.7" class="ltx_td ltx_align_center"><span id="A3.T12.8.1.9.7.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F2F2F2;">38.9</span></td>
<td id="A3.T12.8.1.9.8" class="ltx_td ltx_align_center"><span id="A3.T12.8.1.9.8.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F2F2F2;">48.5</span></td>
<td id="A3.T12.8.1.9.9" class="ltx_td ltx_align_center"><span id="A3.T12.8.1.9.9.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F2F2F2;">44.2</span></td></tr>
<tr id="A3.T12.8.1.10" class="ltx_tr" style="--ltx-bg-color:#F2F2F2;">
<td id="A3.T12.8.1.10.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="A3.T12.8.1.10.1.1" class="ltx_text ltx_font_bold ltx_font_italic" style="--ltx-fg-color:#218C21;--ltx-bg-color:#F2F2F2;">Improvement</span></td>
<td id="A3.T12.8.1.10.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="A3.T12.8.1.10.2.1" class="ltx_text" style="--ltx-fg-color:#218C21;--ltx-bg-color:#F2F2F2;">+4.8</span></td>
