<td id="A3.T12.8.1.8.3" class="ltx_td ltx_align_center ltx_border_t"><span id="A3.T12.8.1.8.3.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F2F2F2;">32.5</span></td>
