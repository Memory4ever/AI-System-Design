<td id="S5.F3.3.5.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding:2.5pt 1.0pt;"><img src="2510.08439v1/figures/outputs_distribution/Olympiad_Bench_xRouter-7b-lambda1_combined_distribution.png" id="S5.F3.g17" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:115/73;" width="115" height="73" alt="Refer to caption"></td>
