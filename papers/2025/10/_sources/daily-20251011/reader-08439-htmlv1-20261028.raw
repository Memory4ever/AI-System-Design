<td id="S5.F3.3.4.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding:2.5pt 1.0pt;"><img src="2510.08439v1/figures/outputs_distribution/Minerva_Qwen3-8B-Instruct_combined_distribution.png" id="S5.F3.g16" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:115/69;" width="115" height="69" alt="Refer to caption"></td></tr>
