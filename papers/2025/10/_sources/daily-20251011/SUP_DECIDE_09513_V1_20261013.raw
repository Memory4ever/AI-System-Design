<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E34.m2" class="ltx_Math" alttext="\displaystyle\sim\mathcal{N}\left(\bm{0},\Ic\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo>(</mo><mn>𝟎</mn><mo>,</mo><msub><mi>𝐈</mi><mi>C</mi></msub><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sim\mathcal{N}\left(\bm{0},\Ic\right)</annotation></semantics></math></td>
