              <span id="alg1.l6.3" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l6.m1" class="ltx_Math" alttext="k\geq 100" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>100</mn></mrow><annotation encoding="application/x-tex">k\geq 100</annotation></semantics></math> <span id="alg1.l6.4" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg1.l7" class="ltx_listingline">
