<span id="S3.T2.5.1.1.1.1.1.1.3.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding:5pt 1.0pt;"><math id="S3.T2.m8" class="ltx_Math" alttext="\Wkm" display="inline" intent=":literal"><semantics><mrow><mi>𝐰</mi><msub><mrow></mrow><mrow><mi>k</mi><mo>,</mo><mo>:</mo></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\Wkm</annotation></semantics></math></span>
<span id="S3.T2.5.1.1.1.1.1.1.3.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding:5pt 1.0pt;"><math id="S3.T2.m9" class="ltx_math_unparsed" alttext="\mathcal{N}(\Wkm|\langle\Wkm\rangle,\Sigma_{\Wk}^{\rm(m)})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo stretchy="false">(</mo><mrow><mi>𝐰</mi><msub><mrow></mrow><mrow><mi>k</mi><mo>,</mo><mo>:</mo></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mrow><mo stretchy="false">⟨</mo><mrow><mi>𝐰</mi><msub><mrow></mrow><mrow><mi>k</mi><mo>,</mo><mo>:</mo></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">⟩</mo></mrow><mo>,</mo><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>𝐰</mi><msub><mrow></mrow><mrow><mi>k</mi><mo>,</mo><mo>:</mo></mrow></msub></mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}(\Wkm|\langle\Wkm\rangle,\Sigma_{\Wk}^{\rm(m)})</annotation></semantics></math></span>
<span id="S3.T2.5.1.1.1.1.1.1.3.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding:5pt 1.0pt;">
<span id="S3.T2.5.1.1.1.1.1.1.3.3.1" class="ltx_tabular ltx_align_middle">
<span id="S3.T2.5.1.1.1.1.1.1.3.3.1.1" class="ltx_tr">
<span id="S3.T2.5.1.1.1.1.1.1.3.3.1.1.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding:5pt 1.0pt;"><math id="S3.T2.m10" class="ltx_math_unparsed" alttext="\Sigma_{\Wk}^{(m)-1}=\tauE\XmT\Xm+\langle\phi_{k}^{(m)}\rangle\Lambda_{\langle\bm{\gamma}^{(m)}\rangle}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>𝐰</mi><msub><mrow></mrow><mrow><mi>k</mi><mo>,</mo><mo>:</mo></mrow></msub></mrow><mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>=</mo><mrow><mo stretchy="false">⟨</mo><mi>τ</mi><mo stretchy="false">⟩</mo></mrow><msup><mi>𝐗</mi><msup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></msup><msup><mi>𝐗</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup><mo>+</mo><mrow><mo stretchy="false">⟨</mo><msubsup><mi>ϕ</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">⟩</mo></mrow><msub><mi mathvariant="normal">Λ</mi><mrow><mo stretchy="false">⟨</mo><msup><mi>𝜸</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">⟩</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\Sigma_{\Wk}^{(m)-1}=\tauE\XmT\Xm+\langle\phi_{k}^{(m)}\rangle\Lambda_{\langle\bm{\gamma}^{(m)}\rangle}</annotation></semantics></math></span></span>
<span id="S3.T2.5.1.1.1.1.1.1.3.3.1.2" class="ltx_tr">
<span id="S3.T2.5.1.1.1.1.1.1.3.3.1.2.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding:5pt 1.0pt;"><math id="S3.T2.m11" class="ltx_math_unparsed" alttext="\langle\Wkm\rangle=\tauE\sum_{n}^{N}\left[\langle z_{\rm n,k}\rangle-\sum_{m^{\prime}\neq m}^{M}\langle\mathbf{w}_{\rm k,:}^{(m^{\prime})}\rangle\mathbf{x}^{(m^{\prime})\top}_{\rm n,:}\right]\mathbf{x}_{\rm n,:}^{(m)}\Sigma_{\Wk}^{\rm(m)}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mi>𝐰</mi><msub><mrow></mrow><mrow><mi>k</mi><mo>,</mo><mo>:</mo></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">⟩</mo></mrow><mo>=</mo><mrow><mo stretchy="false">⟨</mo><mi>τ</mi><mo stretchy="false">⟩</mo></mrow><msubsup><mo rspace="0em">∑</mo><mi>n</mi><mi>N</mi></msubsup><mrow><mo>[</mo><mrow><mo stretchy="false">⟨</mo><msub><mi>z</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub><mo stretchy="false">⟩</mo></mrow><mo rspace="0.055em">−</mo><msubsup><mo rspace="0em">∑</mo><mrow><msup><mi>m</mi><mo>′</mo></msup><mo>≠</mo><mi>m</mi></mrow><mi>M</mi></msubsup><mrow><mo stretchy="false">⟨</mo><msubsup><mi>𝐰</mi><mrow><mi>k</mi><mo>,</mo><mo>:</mo></mrow><mrow><mo stretchy="false">(</mo><msup><mi>m</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">⟩</mo></mrow><msubsup><mi>𝐱</mi><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow><mrow><mrow><mo stretchy="false">(</mo><msup><mi>m</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msubsup><mo>]</mo></mrow><msubsup><mi>𝐱</mi><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msubsup><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>𝐰</mi><msub><mrow></mrow><mrow><mi>k</mi><mo>,</mo><mo>:</mo></mrow></msub></mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">\langle\Wkm\rangle=\tauE\sum_{n}^{N}\left[\langle z_{\rm n,k}\rangle-\sum_{m^{\prime}\neq m}^{M}\langle\mathbf{w}_{\rm k,:}^{(m^{\prime})}\rangle\mathbf{x}^{(m^{\prime})\top}_{\rm n,:}\right]\mathbf{x}_{\rm n,:}^{(m)}\Sigma_{\Wk}^{\rm(m)}</annotation></semantics></math></span></span>
</span></span></span>
<span id="S3.T2.5.1.1.1.1.1.1.4" class="ltx_tr">
<span id="S3.T2.5.1.1.1.1.1.1.4.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding:5pt 1.0pt;"><math id="S3.T2.m12" class="ltx_math_unparsed" alttext="\mathbf{g}_{\rm n,:}" display="inline" intent=":literal"><semantics><mrow><mi>𝐠</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbf{g}_{\rm n,:}</annotation></semantics></math></span>
<span id="S3.T2.5.1.1.1.1.1.1.4.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding:5pt 1.0pt;"><math id="S3.T2.m13" class="ltx_math_unparsed" alttext="\mathcal{N}(\mathbf{g}_{\rm n,:}|\langle\mathbf{g}_{\rm n,:}\rangle,\Sigma_{\mathbf{G}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐠</mi><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mrow><mo stretchy="false">⟨</mo><msub><mi>𝐠</mi><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">⟩</mo></mrow><mo>,</mo><msub><mi mathvariant="normal">Σ</mi><mi>𝐆</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}(\mathbf{g}_{\rm n,:}|\langle\mathbf{g}_{\rm n,:}\rangle,\Sigma_{\mathbf{G}})</annotation></semantics></math></span>
<span id="S3.T2.5.1.1.1.1.1.1.4.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding:5pt 1.0pt;">
<span id="S3.T2.5.1.1.1.1.1.1.4.3.1" class="ltx_tabular ltx_align_middle">
<span id="S3.T2.5.1.1.1.1.1.1.4.3.1.1" class="ltx_tr">
<span id="S3.T2.5.1.1.1.1.1.1.4.3.1.1.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding:5pt 1.0pt;"><math id="S3.T2.m14" class="ltx_Math" alttext="\Sigma_{\mathbf{G}}^{-1}=\Is+\langle\eta\rangle\langle\mathbf{V}^{\mathbf{Y}\top}\mathbf{V}^{\mathbf{Y}}\rangle+\sum_{m}^{M}\langle\psi^{(m)}\rangle\langle\mathbf{V}^{(m)\top}\mathbf{V}^{(m)}\rangle" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Σ</mi><mi>𝐆</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>=</mo><mrow><msub><mi>𝐈</mi><mi>S</mi></msub><mo>+</mo><mrow><mrow><mo stretchy="false">⟨</mo><mi>η</mi><mo stretchy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>𝐕</mi><mrow><mi>𝐘</mi><mo lspace="0.222em">⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐕</mi><mi>𝐘</mi></msup></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo rspace="0.055em">+</mo><mrow><msubsup><mo rspace="0em">∑</mo><mi>m</mi><mi>M</mi></msubsup><mrow><mrow><mo stretchy="false">⟨</mo><msup><mi>ψ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>𝐕</mi><mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐕</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Sigma_{\mathbf{G}}^{-1}=\Is+\langle\eta\rangle\langle\mathbf{V}^{\mathbf{Y}\top}\mathbf{V}^{\mathbf{Y}}\rangle+\sum_{m}^{M}\langle\psi^{(m)}\rangle\langle\mathbf{V}^{(m)\top}\mathbf{V}^{(m)}\rangle</annotation></semantics></math></span></span>
<span id="S3.T2.5.1.1.1.1.1.1.4.3.1.2" class="ltx_tr">
<span id="S3.T2.5.1.1.1.1.1.1.4.3.1.2.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding:5pt 1.0pt;"><math id="S3.T2.m15" class="ltx_math_unparsed" alttext="\langle\mathbf{g}_{\rm n,:}\rangle=\left(\sum_{m}^{M}\left(\langle\psi^{(m)}\rangle\mathbf{x}_{\rm n,:}^{(m)}\langle\mathbf{V}^{(m)}\rangle\right)+\langle\eta\rangle\left(\langle\mathbf{y}_{n,:}\rangle-\langle\mathbf{z}_{\rm n,:}\rangle\langle\mathbf{U}\rangle^{\top}\right)\langle\mathbf{V}^{\mathbf{Y}}\rangle\right)\Sigma_{\mathbf{G}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⟨</mo><msub><mi>𝐠</mi><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">⟩</mo></mrow><mo>=</mo><mrow><mo>(</mo><msubsup><mo lspace="0em" rspace="0em">∑</mo><mi>m</mi><mi>M</mi></msubsup><mrow><mo>(</mo><mrow><mo stretchy="false">⟨</mo><msup><mi>ψ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">⟩</mo></mrow><msubsup><mi>𝐱</mi><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">⟨</mo><msup><mi>𝐕</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">⟩</mo></mrow><mo>)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">⟨</mo><mi>η</mi><mo stretchy="false">⟩</mo></mrow><mrow><mo>(</mo><mrow><mo stretchy="false">⟨</mo><msub><mi>𝐲</mi><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">⟩</mo></mrow><mo>−</mo><mrow><mo stretchy="false">⟨</mo><msub><mi>𝐳</mi><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">⟩</mo></mrow><msup><mrow><mo stretchy="false">⟨</mo><mi>𝐔</mi><mo stretchy="false">⟩</mo></mrow><mo>⊤</mo></msup><mo>)</mo></mrow><mrow><mo stretchy="false">⟨</mo><msup><mi>𝐕</mi><mi>𝐘</mi></msup><mo stretchy="false">⟩</mo></mrow><mo>)</mo></mrow><msub><mi mathvariant="normal">Σ</mi><mi>𝐆</mi></msub></mrow><annotation encoding="application/x-tex">\langle\mathbf{g}_{\rm n,:}\rangle=\left(\sum_{m}^{M}\left(\langle\psi^{(m)}\rangle\mathbf{x}_{\rm n,:}^{(m)}\langle\mathbf{V}^{(m)}\rangle\right)+\langle\eta\rangle\left(\langle\mathbf{y}_{n,:}\rangle-\langle\mathbf{z}_{\rm n,:}\rangle\langle\mathbf{U}\rangle^{\top}\right)\langle\mathbf{V}^{\mathbf{Y}}\rangle\right)\Sigma_{\mathbf{G}}</annotation></semantics></math></span></span>
</span></span></span>
<span id="S3.T2.5.1.1.1.1.1.1.5" class="ltx_tr">
<span id="S3.T2.5.1.1.1.1.1.1.5.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding:5pt 1.0pt;"><math id="S3.T2.m16" class="ltx_math_unparsed" alttext="\mathbf{v}_{d,:}^{(m)}" display="inline" intent=":literal"><semantics><mrow><mi>𝐯</mi><msub><mrow></mrow><mrow><mi>d</mi><mo>,</mo><mo>:</mo></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{v}_{d,:}^{(m)}</annotation></semantics></math></span>
<span id="S3.T2.5.1.1.1.1.1.1.5.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding:5pt 1.0pt;"><math id="S3.T2.m17" class="ltx_math_unparsed" alttext="\mathcal{N}(\mathbf{v}_{d,:}^{(m)}|\langle\mathbf{v}_{d,:}^{(m)}\rangle,\Sigma_{\mathbf{v}_{d,:}}^{\rm(m)})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐯</mi><mrow><mi>d</mi><mo>,</mo><mo>:</mo></mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msubsup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mrow><mo stretchy="false">⟨</mo><msubsup><mi>𝐯</mi><mrow><mi>d</mi><mo>,</mo><mo>:</mo></mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">⟩</mo></mrow><mo>,</mo><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>𝐯</mi><msub><mrow></mrow><mrow><mi>d</mi><mo>,</mo><mo>:</mo></mrow></msub></mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}(\mathbf{v}_{d,:}^{(m)}|\langle\mathbf{v}_{d,:}^{(m)}\rangle,\Sigma_{\mathbf{v}_{d,:}}^{\rm(m)})</annotation></semantics></math></span>
<span id="S3.T2.5.1.1.1.1.1.1.5.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding:5pt 1.0pt;">
<span id="S3.T2.5.1.1.1.1.1.1.5.3.1" class="ltx_tabular ltx_align_middle">
<span id="S3.T2.5.1.1.1.1.1.1.5.3.1.1" class="ltx_tr">
<span id="S3.T2.5.1.1.1.1.1.1.5.3.1.1.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding:5pt 1.0pt;"><math id="S3.T2.m18" class="ltx_math_unparsed" alttext="\Sigma_{\mathbf{v}_{d,:}}^{\rm(m)-1}=\langle\lambda_{d}^{(m)}\rangle\Lambda_{\langle\bm{\delta}^{(m)}\rangle}+\langle\psi^{(m)}\rangle\langle\mathbf{G}^{\top}\mathbf{G}\rangle" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>𝐯</mi><msub><mrow></mrow><mrow><mi>d</mi><mo>,</mo><mo>:</mo></mrow></msub></mrow><mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>=</mo><mrow><mo stretchy="false">⟨</mo><msubsup><mi>λ</mi><mi>d</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">⟩</mo></mrow><msub><mi mathvariant="normal">Λ</mi><mrow><mo stretchy="false">⟨</mo><msup><mi>𝜹</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">⟩</mo></mrow></msub><mo>+</mo><mrow><mo stretchy="false">⟨</mo><msup><mi>ψ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">⟩</mo></mrow><mrow><mo stretchy="false">⟨</mo><msup><mi>𝐆</mi><mo>⊤</mo></msup><mi>𝐆</mi><mo stretchy="false">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">\Sigma_{\mathbf{v}_{d,:}}^{\rm(m)-1}=\langle\lambda_{d}^{(m)}\rangle\Lambda_{\langle\bm{\delta}^{(m)}\rangle}+\langle\psi^{(m)}\rangle\langle\mathbf{G}^{\top}\mathbf{G}\rangle</annotation></semantics></math></span></span>
<span id="S3.T2.5.1.1.1.1.1.1.5.3.1.2" class="ltx_tr">
<span id="S3.T2.5.1.1.1.1.1.1.5.3.1.2.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding:5pt 1.0pt;"><math id="S3.T2.m19" class="ltx_math_unparsed" alttext="\langle\mathbf{v}_{d,:}^{(m)}\rangle=\langle\psi^{(m)}\rangle\mathbf{x}_{\rm:,d}^{(m)\top}\langle\mathbf{G}\rangle\Sigma_{\mathbf{v}_{d,:}}^{\rm(m)}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⟨</mo><msubsup><mi>𝐯</mi><mrow><mi>d</mi><mo>,</mo><mo>:</mo></mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">⟩</mo></mrow><mo>=</mo><mrow><mo stretchy="false">⟨</mo><msup><mi>ψ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">⟩</mo></mrow><msubsup><mi>𝐱</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>d</mi></mrow><mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msubsup><mrow><mo stretchy="false">⟨</mo><mi>𝐆</mi><mo stretchy="false">⟩</mo></mrow><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>𝐯</mi><msub><mrow></mrow><mrow><mi>d</mi><mo>,</mo><mo>:</mo></mrow></msub></mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">\langle\mathbf{v}_{d,:}^{(m)}\rangle=\langle\psi^{(m)}\rangle\mathbf{x}_{\rm:,d}^{(m)\top}\langle\mathbf{G}\rangle\Sigma_{\mathbf{v}_{d,:}}^{\rm(m)}</annotation></semantics></math></span></span>
</span></span></span>
<span id="S3.T2.5.1.1.1.1.1.1.6" class="ltx_tr">
<span id="S3.T2.5.1.1.1.1.1.1.6.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb ltx_border_t" style="padding:5pt 1.0pt;"><math id="S3.T2.m20" class="ltx_math_unparsed" alttext="\mathbf{y}_{\rm n,:}" display="inline" intent=":literal"><semantics><mrow><mi>𝐲</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbf{y}_{\rm n,:}</annotation></semantics></math></span>
<span id="S3.T2.5.1.1.1.1.1.1.6.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb ltx_border_t" style="padding:5pt 1.0pt;"><math id="S3.T2.m21" class="ltx_math_unparsed" alttext="\mathcal{N}(\mathbf{y}_{\rm n,:}|\langle\mathbf{y}_{\rm n,:}\rangle,\Sigma_{\mathbf{y}_{\rm n,:}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐲</mi><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mrow><mo stretchy="false">⟨</mo><msub><mi>𝐲</mi><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">⟩</mo></mrow><mo>,</mo><msub><mi mathvariant="normal">Σ</mi><mrow><mi>𝐲</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}(\mathbf{y}_{\rm n,:}|\langle\mathbf{y}_{\rm n,:}\rangle,\Sigma_{\mathbf{y}_{\rm n,:}})</annotation></semantics></math></span>
<span id="S3.T2.5.1.1.1.1.1.1.6.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb ltx_border_t" style="padding:5pt 1.0pt;">
<span id="S3.T2.5.1.1.1.1.1.1.6.3.1" class="ltx_tabular ltx_align_middle">
<span id="S3.T2.5.1.1.1.1.1.1.6.3.1.1" class="ltx_tr">
<span id="S3.T2.5.1.1.1.1.1.1.6.3.1.1.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding:5pt 1.0pt;"><math id="S3.T2.m22" class="ltx_math_unparsed" alttext="\Sigma_{\mathbf{y}_{\rm n,:}}^{-1}=\langle\eta\rangle\Ic+2\Lambda_{\bm{\xi}_{\rm n,:}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>𝐲</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow></msub></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>=</mo><mrow><mo stretchy="false">⟨</mo><mi>η</mi><mo stretchy="false">⟩</mo></mrow><msub><mi>𝐈</mi><mi>C</mi></msub><mo>+</mo><mn>2</mn><msub><mi mathvariant="normal">Λ</mi><mrow><mi>𝝃</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow></msub></mrow></msub></mrow><annotation encoding="application/x-tex">\Sigma_{\mathbf{y}_{\rm n,:}}^{-1}=\langle\eta\rangle\Ic+2\Lambda_{\bm{\xi}_{\rm n,:}}</annotation></semantics></math>    where    <math id="S3.T2.m23" class="ltx_math_unparsed" alttext="\bm{\xi}_{\rm n,:}=\sqrt{\langle\mathbf{y}_{\rm n,:}\rangle^{2}+diag\left(\Sigma_{\mathbf{y}_{\rm n,:}}\right)}" display="inline" intent=":literal"><semantics><mrow><mi>𝝃</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow></msub><mo>=</mo><msqrt><mrow><mo stretchy="false">⟨</mo><mi>𝐲</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">⟩</mo><msup><mrow></mrow><mn>2</mn></msup><mo>+</mo><mi>d</mi><mi>i</mi><mi>a</mi><mi>g</mi><mo>(</mo><mi mathvariant="normal">Σ</mi><msub><mrow></mrow><mrow><mi>𝐲</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow></msub></mrow></msub><mo>)</mo></mrow></msqrt></mrow><annotation encoding="application/x-tex">\bm{\xi}_{\rm n,:}=\sqrt{\langle\mathbf{y}_{\rm n,:}\rangle^{2}+diag\left(\Sigma_{\mathbf{y}_{\rm n,:}}\right)}</annotation></semantics></math></span></span>
<span id="S3.T2.5.1.1.1.1.1.1.6.3.1.2" class="ltx_tr">
<span id="S3.T2.5.1.1.1.1.1.1.6.3.1.2.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding:5pt 1.0pt;"><math id="S3.T2.m24" class="ltx_math_unparsed" alttext="\langle\mathbf{y}_{\rm n,:}\rangle=\left(\mathbf{t}_{\rm n,:}-\unmed+\langle\eta\rangle\left(\langle\mathbf{z}_{\rm n,:}\rangle\langle\mathbf{U}\rangle^{\top}+\langle\mathbf{g}_{\rm n,:}\rangle\langle\mathbf{V}^{\mathbf{Y}}\rangle^{\top}\right)\right)\Sigma_{\mathbf{y}_{\rm n,:}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⟨</mo><msub><mi>𝐲</mi><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">⟩</mo></mrow><mo>=</mo><mrow><mo>(</mo><msub><mi>𝐭</mi><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow></msub><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>+</mo><mrow><mo stretchy="false">⟨</mo><mi>η</mi><mo stretchy="false">⟩</mo></mrow><mrow><mo>(</mo><mrow><mo stretchy="false">⟨</mo><msub><mi>𝐳</mi><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">⟩</mo></mrow><msup><mrow><mo stretchy="false">⟨</mo><mi>𝐔</mi><mo stretchy="false">⟩</mo></mrow><mo>⊤</mo></msup><mo>+</mo><mrow><mo stretchy="false">⟨</mo><msub><mi>𝐠</mi><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">⟩</mo></mrow><msup><mrow><mo stretchy="false">⟨</mo><msup><mi>𝐕</mi><mi>𝐘</mi></msup><mo stretchy="false">⟩</mo></mrow><mo>⊤</mo></msup><mo>)</mo></mrow><mo>)</mo></mrow><msub><mi mathvariant="normal">Σ</mi><mrow><mi>𝐲</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow></msub></mrow></msub></mrow><annotation encoding="application/x-tex">\langle\mathbf{y}_{\rm n,:}\rangle=\left(\mathbf{t}_{\rm n,:}-\unmed+\langle\eta\rangle\left(\langle\mathbf{z}_{\rm n,:}\rangle\langle\mathbf{U}\rangle^{\top}+\langle\mathbf{g}_{\rm n,:}\rangle\langle\mathbf{V}^{\mathbf{Y}}\rangle^{\top}\right)\right)\Sigma_{\mathbf{y}_{\rm n,:}}</annotation></semantics></math></span></span>
</span></span></span>
</span>
</span></span></span>
</span></span></span></p>
</span></div>
</figure>
</section>
<section id="S3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.2 </span>Variational Inference</h3>

<div id="S3.SS2.p1" class="ltx_para">
<p id="S3.SS2.p1.1" class="ltx_p">To perform inference over model variables, included in <math id="S3.SS2.p1.m1" class="ltx_Math" alttext="\bm{\Theta}" display="inline" intent=":literal"><semantics><mi>𝚯</mi><annotation encoding="application/x-tex">\bm{\Theta}</annotation></semantics></math>, we approximate the intractable posterior <math id="S3.SS2.p1.m2" class="ltx_Math" alttext="p(\bm{\Theta}\mid\XM,\Y)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝚯</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msup><mi>𝐗</mi><mrow><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="false">}</mo></mrow></msup><mo>,</mo><mi>𝐘</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(\bm{\Theta}\mid\XM,\Y)</annotation></semantics></math> with a fully factorized mean-field variational distribution <math id="S3.SS2.p1.m3" class="ltx_Math" alttext="q(\bm{\Theta})" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝚯</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q(\bm{\Theta})</annotation></semantics></math> assumes independence between the model variables as</p>
<table id="S3.E7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E7.m1" class="ltx_Math" alttext="\begin{split}q\left(\bm{\Theta}\right)=&amp;\prod_{m=1}^{M}\Bigg(q(\mathbf{V}^{(m)})q(\mathbf{W}^{(m)})\,q(\psim)\prod_{k}^{K}\left(q(\delta_{k}^{(m)})q(\phi_{k}^{(m)})\right)\\
&amp;\prod_{d}^{D^{(m)}}\left(q(\lambda_{d}^{(m)})q(\gamma_{d}^{(m)})\right)\Bigg)q(\mathbf{V}^{\mathbf{Y}})q(\mathbf{U})\prod_{n}^{N}\left(q(\mathbf{z}_{\rm n,:})q(\mathbf{g}_{\rm n,:})\right)\\
&amp;q(\eta)q(\tau)q(\mathbf{Y}).\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo>(</mo><mi>𝚯</mi><mo>)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover><mrow><mo lspace="0em" maxsize="2.600em" minsize="2.600em">(</mo><mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐕</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐖</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0.340em" rspace="0em">​</mo><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>ψ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∏</mo><mi>k</mi><mi>K</mi></munderover><mrow><mo>(</mo><mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>δ</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>ϕ</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo movablelimits="false" rspace="0em">∏</mo><msub><mrow></mrow><mi>d</mi></msub><msup><mrow></mrow><msup><mi>D</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup></msup><mo>(</mo><mi>q</mi><mo stretchy="false">(</mo><mi>λ</mi><msub><mrow></mrow><mi>d</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo><mi>q</mi><mo stretchy="false">(</mo><mi>γ</mi><msub><mrow></mrow><mi>d</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo><mo>)</mo><mo maxsize="2.600em" minsize="2.600em">)</mo><mi>q</mi><mo stretchy="false">(</mo><mi>𝐕</mi><msup><mrow></mrow><mi>𝐘</mi></msup><mo stretchy="false">)</mo><mi>q</mi><mo stretchy="false">(</mo><mi>𝐔</mi><mo stretchy="false">)</mo><mo movablelimits="false" rspace="0em">∏</mo><msub><mrow></mrow><mi>n</mi></msub><msup><mrow></mrow><mi>N</mi></msup><mo>(</mo><mi>q</mi><mo stretchy="false">(</mo><mi>𝐳</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">)</mo><mi>q</mi><mo stretchy="false">(</mo><mi>𝐠</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">)</mo><mo>)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐘</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}q\left(\bm{\Theta}\right)=&amp;\prod_{m=1}^{M}\Bigg(q(\mathbf{V}^{(m)})q(\mathbf{W}^{(m)})\,q(\psim)\prod_{k}^{K}\left(q(\delta_{k}^{(m)})q(\phi_{k}^{(m)})\right)\\
&amp;\prod_{d}^{D^{(m)}}\left(q(\lambda_{d}^{(m)})q(\gamma_{d}^{(m)})\right)\Bigg)q(\mathbf{V}^{\mathbf{Y}})q(\mathbf{U})\prod_{n}^{N}\left(q(\mathbf{z}_{\rm n,:})q(\mathbf{g}_{\rm n,:})\right)\\
&amp;q(\eta)q(\tau)q(\mathbf{Y}).\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7)</span></td></tr></tbody>
</table>
<p id="S3.SS2.p1.2" class="ltx_p">where <math id="S3.SS2.p1.m4" class="ltx_Math" alttext="q(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q(\cdot)</annotation></semantics></math> denotes the approximate posterior distribution of a variable. Furthermore, to evaluate and measure the quality of the approximation <math id="S3.SS2.p1.m5" class="ltx_Math" alttext="q(\mathbf{\Theta})" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝚯</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q(\mathbf{\Theta})</annotation></semantics></math>, the mean-field method optimizes a variational lower bound <math id="S3.SS2.p1.m6" class="ltx_Math" alttext="L(q)" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L(q)</annotation></semantics></math>, proportional to the Kullback–Leibler (KL) divergence between <math id="S3.SS2.p1.m7" class="ltx_Math" alttext="q(\mathbf{\Theta})" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝚯</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q(\mathbf{\Theta})</annotation></semantics></math> and the true posterior <math id="S3.SS2.p1.m8" class="ltx_Math" alttext="p(\mathbf{\Theta}\mid\mathbf{X}^{\mathcal{M}},\mathbf{t})" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝚯</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msup><mi>𝐗</mi><mi class="ltx_font_mathcaligraphic">ℳ</mi></msup><mo>,</mo><mi>𝐭</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(\mathbf{\Theta}\mid\mathbf{X}^{\mathcal{M}},\mathbf{t})</annotation></semantics></math>.
Thus, as presented in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib5" title="" class="ltx_ref">5</a>]</cite>,
analyzing the expression <math id="S3.SS2.p1.m9" class="ltx_Math" alttext="L(q)" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L(q)</annotation></semantics></math> allows us to derive an approximate posterior distribution for any individual parameter <math id="S3.SS2.p1.m10" class="ltx_Math" alttext="\theta_{j}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\theta_{j}</annotation></semantics></math> in the model, as follows:</p>
<table id="S3.E8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E8.m1" class="ltx_Math" alttext="\ln q_{j}^{*}=\mathbb{E}_{-q_{j}}\left[\ln(p(\bm{\Theta},\mathbf{t},\mathbf{X}^{\mathcal{M}}))\right]+const," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><msubsup><mi>q</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mo>=</mo><mrow><mrow><msub><mi>𝔼</mi><mrow><mo>−</mo><msub><mi>q</mi><mi>j</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝚯</mi><mo>,</mo><mi>𝐭</mi><mo>,</mo><msup><mi>𝐗</mi><mi class="ltx_font_mathcaligraphic">ℳ</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\ln q_{j}^{*}=\mathbb{E}_{-q_{j}}\left[\ln(p(\bm{\Theta},\mathbf{t},\mathbf{X}^{\mathcal{M}}))\right]+const,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(8)</span></td></tr></tbody>
</table>
<p id="S3.SS2.p1.3" class="ltx_p">where <math id="S3.SS2.p1.m11" class="ltx_Math" alttext="\mathbb{E}_{-q_{j}}\left[\cdot\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mo>−</mo><msub><mi>q</mi><mi>j</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}_{-q_{j}}\left[\cdot\right]</annotation></semantics></math> denotes the expectation with respect to all r.v. except the <math id="S3.SS2.p1.m12" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>-th. Furthermore, since Eq.(<a href="#S3.E8" title="In 3.2 Variational Inference ‣ 3 Proposed model ‣ Interpretable Generative and Discriminative Learning for Multimodal and Incomplete Clinical Data" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>) requires the involved distributions to be conjugate, we apply a slight modification to Eq. (<a href="#A1.E176" title="In A.3 Posterior predictive distribution ‣ Appendix A Model Inference ‣ Interpretable Generative and Discriminative Learning for Multimodal and Incomplete Clinical Data" class="ltx_ref"><span class="ltx_text ltx_ref_tag">176</span></a>), following the approach introduced in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib21" title="" class="ltx_ref">21</a>]</cite>. Specifically, we derive a lower bound for <math id="S3.SS2.p1.m13" class="ltx_Math" alttext="p(t_{\rm n,c}\mid y_{\rm n,c})" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mrow><mi>n</mi><mo>,</mo><mi>c</mi></mrow></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>y</mi><mrow><mi>n</mi><mo>,</mo><mi>c</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(t_{\rm n,c}\mid y_{\rm n,c})</annotation></semantics></math> using a first-order Taylor expansion, given by:</p>
<table id="S3.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E9.m1" class="ltx_Math" alttext="\begin{split}&amp;p(t_{\rm n,c}=1|y_{\rm n,c})=e^{y_{\rm n,c}}\sigma(-y_{\rm n,c})\geqslant h(y_{\rm n,c},\xi_{\rm n,c})\\
&amp;=e^{y_{\rm n,c}t_{\rm n,c}}\sigma(\xi_{\rm n,c})e^{-\frac{y_{\rm n,c}+\xi_{\rm n,c}}{2}-\lambda(\xi_{\rm n,c})(y_{\rm n,c}^{2}-\xi_{\rm n,c}^{2})},\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>t</mi><mrow><mi>n</mi><mo>,</mo><mi>c</mi></mrow></msub><mo>=</mo><mn>1</mn></mrow><mo lspace="0em" rspace="0em">|</mo><msub><mi>y</mi><mrow><mi>n</mi><mo>,</mo><mi>c</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>e</mi><msub><mi>y</mi><mrow><mi>n</mi><mo>,</mo><mi>c</mi></mrow></msub></msup><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><msub><mi>y</mi><mrow><mi>n</mi><mo>,</mo><mi>c</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⩾</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mrow><mi>n</mi><mo>,</mo><mi>c</mi></mrow></msub><mo>,</mo><msub><mi>ξ</mi><mrow><mi>n</mi><mo>,</mo><mi>c</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>e</mi><mrow><msub><mi>y</mi><mrow><mi>n</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mrow><mi>n</mi><mo>,</mo><mi>c</mi></mrow></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ξ</mi><mrow><mi>n</mi><mo>,</mo><mi>c</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mrow><mo>−</mo><mfrac><mrow><msub><mi>y</mi><mrow><mi>n</mi><mo>,</mo><mi>c</mi></mrow></msub><mo>+</mo><msub><mi>ξ</mi><mrow><mi>n</mi><mo>,</mo><mi>c</mi></mrow></msub></mrow><mn>2</mn></mfrac></mrow><mo>−</mo><mrow><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ξ</mi><mrow><mi>n</mi><mo>,</mo><mi>c</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>y</mi><mrow><mi>n</mi><mo>,</mo><mi>c</mi></mrow><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>ξ</mi><mrow><mi>n</mi><mo>,</mo><mi>c</mi></mrow><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow></mrow><mo>,</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}&amp;p(t_{\rm n,c}=1|y_{\rm n,c})=e^{y_{\rm n,c}}\sigma(-y_{\rm n,c})\geqslant h(y_{\rm n,c},\xi_{\rm n,c})\\
&amp;=e^{y_{\rm n,c}t_{\rm n,c}}\sigma(\xi_{\rm n,c})e^{-\frac{y_{\rm n,c}+\xi_{\rm n,c}}{2}-\lambda(\xi_{\rm n,c})(y_{\rm n,c}^{2}-\xi_{\rm n,c}^{2})},\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
<p id="S3.SS2.p1.4" class="ltx_p">where <math id="S3.SS2.p1.m14" class="ltx_Math" alttext="\lambda(a)=\frac{1}{2a}(\sigma(a)-\tfrac{1}{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda(a)=\frac{1}{2a}(\sigma(a)-\tfrac{1}{2})</annotation></semantics></math>, and <math id="S3.SS2.p1.m15" class="ltx_Math" alttext="\xi_{\rm n,c}" display="inline" intent=":literal"><semantics><msub><mi>ξ</mi><mrow><mi>n</mi><mo>,</mo><mi>c</mi></mrow></msub><annotation encoding="application/x-tex">\xi_{\rm n,c}</annotation></semantics></math> denotes the expansion point of the Taylor series around <math id="S3.SS2.p1.m16" class="ltx_Math" alttext="y_{\rm n,c}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mrow><mi>n</mi><mo>,</mo><mi>c</mi></mrow></msub><annotation encoding="application/x-tex">y_{\rm n,c}</annotation></semantics></math>. It is important to note that <math id="S3.SS2.p1.m17" class="ltx_Math" alttext="\xi_{\rm n,c}" display="inline" intent=":literal"><semantics><msub><mi>ξ</mi><mrow><mi>n</mi><mo>,</mo><mi>c</mi></mrow></msub><annotation encoding="application/x-tex">\xi_{\rm n,c}</annotation></semantics></math> is treated as a learnable parameter, optimized during model training via variational inference. This approximation enables us to interpret <math id="S3.SS2.p1.m18" class="ltx_Math" alttext="p(t_{\rm n,c}\mid y_{\rm n,c})" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mrow><mi>n</mi><mo>,</mo><mi>c</mi></mrow></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>y</mi><mrow><mi>n</mi><mo>,</mo><mi>c</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(t_{\rm n,c}\mid y_{\rm n,c})</annotation></semantics></math> as a Gaussian-like distribution, which can then be seamlessly incorporated into Eq. (<a href="#S3.E8" title="In 3.2 Variational Inference ‣ 3 Proposed model ‣ Interpretable Generative and Discriminative Learning for Multimodal and Incomplete Clinical Data" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>).</p>
</div>
<div id="S3.SS2.p2" class="ltx_para">
<p id="S3.SS2.p2.1" class="ltx_p"><span id="S3.SS2.p2.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Furthermore, Table <a href="#S3.T2" title="Table 2 ‣ 3.1 Generative Model ‣ 3 Proposed model ‣ Interpretable Generative and Discriminative Learning for Multimodal and Incomplete Clinical Data" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> includes the variational distributions for the key model variables, the update for all model variables are available in the supplementary material.</span>
Thus, looking at these Tables, we can observe that, despite <math id="S3.SS2.p2.m1" class="ltx_Math" alttext="\mathbf{G}" display="inline" intent=":literal"><semantics><mi>𝐆</mi><annotation encoding="application/x-tex">\mathbf{G}</annotation></semantics></math> and <math id="S3.SS2.p2.m2" class="ltx_Math" alttext="\mathbf{Z}" display="inline" intent=":literal"><semantics><mi>𝐙</mi><annotation encoding="application/x-tex">\mathbf{Z}</annotation></semantics></math> having independent priors, their variational posteriors become dependent due to their joint involvement in modeling the output view via Eq. (<a href="#S3.E5" title="In 3.1 Generative Model ‣ 3 Proposed model ‣ Interpretable Generative and Discriminative Learning for Multimodal and Incomplete Clinical Data" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>), which couples both spaces during inference. Notably, <math id="S3.SS2.p2.m3" class="ltx_math_unparsed" alttext="\langle\mathbf{g}_{n,:}\rangle" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟨</mo><msub><mi>𝐠</mi><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">⟩</mo></mrow><annotation encoding="application/x-tex">\langle\mathbf{g}_{n,:}\rangle</annotation></semantics></math> reveals that the generative space does not attempt to reconstruct the full <math id="S3.SS2.p2.m4" class="ltx_math_unparsed" alttext="\mathbf{y}_{n,:}" display="inline" intent=":literal"><semantics><mrow><mi>𝐲</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbf{y}_{n,:}</annotation></semantics></math>, but rather captures the residual between the output view and the component explained by the discriminative space, i.e., <math id="S3.SS2.p2.m5" class="ltx_math_unparsed" alttext="\langle\mathbf{y}_{n,:}\rangle-\langle\mathbf{z}_{\rm n,:}\rangle\langle\mathbf{U}\rangle^{\top}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⟨</mo><msub><mi>𝐲</mi><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">⟩</mo></mrow><mo>−</mo><mrow><mo stretchy="false">⟨</mo><msub><mi>𝐳</mi><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">⟩</mo></mrow><msup><mrow><mo stretchy="false">⟨</mo><mi>𝐔</mi><mo stretchy="false">⟩</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\langle\mathbf{y}_{n,:}\rangle-\langle\mathbf{z}_{\rm n,:}\rangle\langle\mathbf{U}\rangle^{\top}</annotation></semantics></math>. This residual structure often corresponds to task-irrelevant variability.
Conversely, the update for <math id="S3.SS2.p2.m6" class="ltx_math_unparsed" alttext="\langle\mathbf{z}_{n,:}\rangle" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟨</mo><msub><mi>𝐳</mi><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">⟩</mo></mrow><annotation encoding="application/x-tex">\langle\mathbf{z}_{n,:}\rangle</annotation></semantics></math> depends on the difference between <math id="S3.SS2.p2.m7" class="ltx_math_unparsed" alttext="\mathbf{y}_{n,:}" display="inline" intent=":literal"><semantics><mrow><mi>𝐲</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbf{y}_{n,:}</annotation></semantics></math> and the contribution from <math id="S3.SS2.p2.m8" class="ltx_math_unparsed" alttext="\mathbf{g}_{n,:}" display="inline" intent=":literal"><semantics><mrow><mi>𝐠</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mo>:</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbf{g}_{n,:}</annotation></semantics></math>, effectively focusing the discriminative latent space on denoised output information. This encourages <math id="S3.SS2.p2.m9" class="ltx_Math" alttext="\mathbf{Z}" display="inline" intent=":literal"><semantics><mi>𝐙</mi><annotation encoding="application/x-tex">\mathbf{Z}</annotation></semantics></math> to encode features that are truly informative for classification, enhancing task performance.
These results corroborate the motivation discussed earlier for using both latent spaces to model the output view: by separating generative and task-specific information, the model promotes robust and interpretable representations that improve generalization. For the full derivations (including the posterior factorization) of all model variables, see Supplementary Material. The iterative training loop is detailed in Pseudocode <a href="#alg1" title="Algorithm 1 ‣ 3.2 Variational Inference ‣ 3 Proposed model ‣ Interpretable Generative and Discriminative Learning for Multimodal and Incomplete Clinical Data" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.</p>
</div>
<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> Training Algorithm of OSIRIS</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
            Dataset <math id="alg1.l1.m1" class="ltx_Math" alttext="\{(\X^{\mathcal{M}},\mathbf{t})\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mi class="ltx_font_mathcaligraphic">ℳ</mi></msup><mo>,</mo><mi>𝐭</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{(\X^{\mathcal{M}},\mathbf{t})\}</annotation></semantics></math>, convergence threshold <math id="alg1.l1.m2" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>, maximum iterations <math id="alg1.l1.m3" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>

</div>
<div id="alg1.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
