<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S4.F2.sf6.3" class="ltx_text" style="font-size:90%;">(f)</span> </span><span id="S4.F2.sf6.4" class="ltx_text" style="font-size:90%;">ADNI</span></figcaption>
