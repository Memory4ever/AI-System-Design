<span id="S4.T4.5.1.1.1.1.1.1.19.5" class="ltx_td ltx_align_center ltx_border_b" style="--ltx-bg-color:#F2F2F2;"><span id="S4.T4.5.1.1.1.1.1.1.19.5.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">0.34 <math id="S4.T4.m141" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.05</span></span>
