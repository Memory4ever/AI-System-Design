<p id="S4.T6.5.1" class="ltx_p"><span id="S4.T6.5.1.1" class="ltx_text">
<span id="S4.T6.5.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:450.1pt;height:49.6pt;vertical-align:-22.3pt;"><span class="ltx_transformed_inner" style="transform:translate(0.0pt,0.0pt) scale(1,1) ;">
