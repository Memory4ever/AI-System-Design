<span id="S4.T6.5.1.1.1.1.1.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt ltx_colspan ltx_colspan_3"><span id="S4.T6.5.1.1.1.1.1.1.1.3.1" class="ltx_text ltx_font_bold">Supervised</span></span></span>
<span id="S4.T6.5.1.1.1.1.1.1.2" class="ltx_tr">
<span id="S4.T6.5.1.1.1.1.1.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row">Spaces</span>
