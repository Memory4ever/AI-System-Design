               <span id="alg1.l7.3" class="ltx_text ltx_font_bold">Compute</span> <math id="alg1.l7.m1" class="ltx_Math" alttext="\Delta=|L(q)_{k-100}-L(q)_{k}|" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>=</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mrow><mi>k</mi><mo>−</mo><mn>100</mn></mrow></msub></mrow><mo>−</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msub></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta=|L(q)_{k-100}-L(q)_{k}|</annotation></semantics></math>

</div>
