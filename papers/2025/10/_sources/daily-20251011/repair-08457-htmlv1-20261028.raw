0 L 479.13 0 L 467.32 0 L 455.51 0 L 443.7 0 L 431.89 0 L 420.08 0 L 408.27 0 L 396.46 0 L 384.65 0 L 372.83 0 L 361.02 0 L 349.21 0 L 337.4 0 L 325.59 0 L 313.78 0 L 301.97 0 L 290.16 0 L 278.35 0 L 266.54 0 L 254.72 0 L 242.91 0 L 231.1 0 L 219.29 0 L 207.48 0 L 195.67 0 L 183.86 0 L 172.05 0 L 160.24 0 L 148.43 0 L 136.61 0 L 124.8 0 L 112.99 0 L 101.18 0 L 89.37 0 L 77.56 0 L 65.75 0 L 53.94 0 L 42.13 0 L 30.31 0 L 18.5 0 L 6.69 0 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 1.11 1.11 L 1.11 231.8 L 548.89 231.8 L 548.89 1.11 Z"></path></g><g style="--ltx-fg-color:#000000;" color="#000000" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><path style="fill:none" d="M 0.55 0.55 L 0.55 232.36 L 549.45 232.36 L 549.45 0.55 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 18.88 16.11)"><foreignObject style="--ltx-fo-width:37.02em;--ltx-fo-height:14.5em;--ltx-fo-depth:0em;font-size:10pt;" height="200.69" overflow="visible" transform="matrix(1 0 0 -1 0 200.69)" width="512.25"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A13.p7.pic1.1" class="ltx_inline-sectional-block ltx_minipage">
                  
<section id="A13.SS0.SSSx7" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection" style="--ltx-fg-color:#000000;">Question</h4>

<span id="A13.SS0.SSSx7.p1" class="ltx_para ltx_noindent">
<span id="A13.SS0.SSSx7.p1.1" class="ltx_p"><span id="A13.SS0.SSSx7.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">In </span><math id="A13.SS0.SSSx7.p1.m1" class="ltx_Math" alttext="\triangle ABC" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">△</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">C</mi></mrow><annotation encoding="application/x-tex">\triangle ABC</annotation></semantics></math><span id="A13.SS0.SSSx7.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">, the side lengths are </span><math id="A13.SS0.SSSx7.p1.m2" class="ltx_Math" alttext="a=14" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">a</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">14</mn></mrow><annotation encoding="application/x-tex">a=14</annotation></semantics></math><span id="A13.SS0.SSSx7.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">, </span><math id="A13.SS0.SSSx7.p1.m3" class="ltx_Math" alttext="b=48" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">48</mn></mrow><annotation encoding="application/x-tex">b=48</annotation></semantics></math><span id="A13.SS0.SSSx7.p1.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">, and </span><math id="A13.SS0.SSSx7.p1.m4" class="ltx_Math" alttext="c=50" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">50</mn></mrow><annotation encoding="application/x-tex">c=50</annotation></semantics></math><span id="A13.SS0.SSSx7.p1.1.5" class="ltx_text" style="--ltx-fg-color:#000000;">.
Find </span><math id="A13.SS0.SSSx7.p1.m5" class="ltx_Math" alttext="\cos B" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">cos</mi><mo lspace="0.167em">⁡</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi></mrow><annotation encoding="application/x-tex">\cos B</annotation></semantics></math><span id="A13.SS0.SSSx7.p1.1.6" class="ltx_text" style="--ltx-fg-color:#000000;">.</span></span>
</span>
<span id="A13.SS0.SSSx7.p2" class="ltx_para"><img src="2510.08457v1/iclr2026/images/easy_high_000082.png" id="A13.SS0.SSSx7.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:281/187;" width="281" height="187" alt="[Uncaptioned image]">
</span>
</section>
                </span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A13.p8" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A13.p8.pic1" class="ltx_picture" height="707.32" overflow="visible" version="1.1" viewBox="0 0 550 707.32" width="550"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,707.32) matrix(1 0 0 -1 0 0)"><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" fill-opacity="0.5" stroke="#808080" stroke-opacity="0.5"><path style="stroke:none" d="M 3.54 -3.54 L 3.54 703.78 L 553.54 703.78 L 553.54 -3.54 Z"></path></g><g style="--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0"><path style="stroke:none" d="M 0 0 L 0 707.32 L 550 707.32 L 550 0 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 1.11 1.11 L 1.11 706.21 L 548.89 706.21 L 548.89 1.11 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 18.88 18.88)"><foreignObject style="--ltx-fo-width:37.02em;--ltx-fo-height:48.39em;--ltx-fo-depth:0em;font-size:10pt;" height="669.57" overflow="visible" transform="matrix(1 0 0 -1 0 669.57)" width="512.25"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A13.p8.pic1.1" class="ltx_inline-sectional-block ltx_minipage">
                  
<section id="A13.SS0.SSSx8" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection" style="--ltx-fg-color:#000000;">Question with Excess High-Entropy Tokens</h4>

<span id="A13.SS0.SSSx8.p1" class="ltx_para ltx_noindent">
<span id="A13.SS0.SSSx8.p1.1" class="ltx_tabular ltx_align_middle">
<span class="ltx_tbody">
<span id="A13.SS0.SSSx8.p1.1.1" class="ltx_tr">
<span id="A13.SS0.SSSx8.p1.1.1.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding-left:1.0pt;padding-right:1.0pt;"><span id="A13.SS0.SSSx8.p1.1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">difficulty:</span><span id="A13.SS0.SSSx8.p1.1.1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> Easy</span></span>
<span id="A13.SS0.SSSx8.p1.1.1.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding-left:1.0pt;padding-right:1.0pt;"><span id="A13.SS0.SSSx8.p1.1.1.2.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Gen_high_entropy_token:</span><span id="A13.SS0.SSSx8.p1.1.1.2.2" class="ltx_text" style="--ltx-fg-color:#000000;"> 51</span></span>
<span id="A13.SS0.SSSx8.p1.1.1.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding-left:1.0pt;padding-right:1.0pt;"><span id="A13.SS0.SSSx8.p1.1.1.3.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Threshold(easy):</span><span id="A13.SS0.SSSx8.p1.1.1.3.2" class="ltx_text" style="--ltx-fg-color:#000000;"> 28</span></span></span>
<span id="A13.SS0.SSSx8.p1.1.2" class="ltx_tr">
<span id="A13.SS0.SSSx8.p1.1.2.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding-left:1.0pt;padding-right:1.0pt;"><span id="A13.SS0.SSSx8.p1.1.2.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Entropy reward:</span><span id="A13.SS0.SSSx8.p1.1.2.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> -0.5</span></span>
<span id="A13.SS0.SSSx8.p1.1.2.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding-left:1.0pt;padding-right:1.0pt;"><span id="A13.SS0.SSSx8.p1.1.2.2.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">acc reward:</span><span id="A13.SS0.SSSx8.p1.1.2.2.2" class="ltx_text" style="--ltx-fg-color:#000000;"> 1.0</span></span>
<span id="A13.SS0.SSSx8.p1.1.2.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding-left:1.0pt;padding-right:1.0pt;"><span id="A13.SS0.SSSx8.p1.1.2.3.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">overall reward:</span><span id="A13.SS0.SSSx8.p1.1.2.3.2" class="ltx_text" style="--ltx-fg-color:#000000;"> 0.5</span></span></span>
</span>
</span>
</span>
<span id="A13.SS0.SSSx8.p2" class="ltx_para ltx_noindent">
<span id="A13.SS0.SSSx8.p2.1" class="ltx_p"><span id="A13.SS0.SSSx8.p2.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#0000FF;">Okay, so</span><span id="A13.SS0.SSSx8.p2.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> I need to find </span><math id="A13.SS0.SSSx8.p2.m1" class="ltx_Math" alttext="\cos B" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">cos</mi><mo lspace="0.167em">⁡</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi></mrow><annotation encoding="application/x-tex">\cos B</annotation></semantics></math><span id="A13.SS0.SSSx8.p2.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> given a triangle with sides </span><math id="A13.SS0.SSSx8.p2.m2" class="ltx_Math" alttext="a=14" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">a</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">14</mn></mrow><annotation encoding="application/x-tex">a=14</annotation></semantics></math><span id="A13.SS0.SSSx8.p2.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">, </span><math id="A13.SS0.SSSx8.p2.m3" class="ltx_Math" alttext="b=48" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">48</mn></mrow><annotation encoding="application/x-tex">b=48</annotation></semantics></math><span id="A13.SS0.SSSx8.p2.1.5" class="ltx_text" style="--ltx-fg-color:#000000;">, and </span><math id="A13.SS0.SSSx8.p2.m4" class="ltx_Math" alttext="c=50" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">50</mn></mrow><annotation encoding="application/x-tex">c=50</annotation></semantics></math><span id="A13.SS0.SSSx8.p2.1.6" class="ltx_text" style="--ltx-fg-color:#000000;">.
</span><span id="A13.SS0.SSSx8.p2.1.7" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">Let me recall</span><span id="A13.SS0.SSSx8.p2.1.8" class="ltx_text" style="--ltx-fg-color:#000000;"> the Law of Cosines:</span></span>
<span id="A13.Ex39" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A13.Ex39.m1" class="ltx_Math" alttext="c^{2}=a^{2}+b^{2}-2ab\cos C." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">a</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">a</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">cos</mi><mo lspace="0.167em">⁡</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">C</mi></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">c^{2}=a^{2}+b^{2}-2ab\cos C.</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span>
<span id="A13.SS0.SSSx8.p3" class="ltx_para ltx_noindent">
<span id="A13.SS0.SSSx8.p3.1" class="ltx_p"><span id="A13.SS0.SSSx8.p3.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#0000FF;">First</span><span id="A13.SS0.SSSx8.p3.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">, label the triangle properly. Side </span><math id="A13.SS0.SSSx8.p3.m1" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math><span id="A13.SS0.SSSx8.p3.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> is opposite angle </span><math id="A13.SS0.SSSx8.p3.m2" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math><span id="A13.SS0.SSSx8.p3.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">, </span><math id="A13.SS0.SSSx8.p3.m3" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math><span id="A13.SS0.SSSx8.p3.1.5" class="ltx_text" style="--ltx-fg-color:#000000;"> opposite </span><math id="A13.SS0.SSSx8.p3.m4" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math><span id="A13.SS0.SSSx8.p3.1.6" class="ltx_text" style="--ltx-fg-color:#000000;">, and </span><math id="A13.SS0.SSSx8.p3.m5" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math><span id="A13.SS0.SSSx8.p3.1.7" class="ltx_text" style="--ltx-fg-color:#000000;"> opposite </span><math id="A13.SS0.SSSx8.p3.m6" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math><span id="A13.SS0.SSSx8.p3.1.8" class="ltx_text" style="--ltx-fg-color:#000000;">. The diagram shows </span><math id="A13.SS0.SSSx8.p3.m7" class="ltx_Math" alttext="\angle C=90^{\circ}" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">∠</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">C</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msup><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">90</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∘</mo></msup></mrow><annotation encoding="application/x-tex">\angle C=90^{\circ}</annotation></semantics></math><span id="A13.SS0.SSSx8.p3.1.9" class="ltx_text" style="--ltx-fg-color:#000000;">.
</span><span id="A13.SS0.SSSx8.p3.1.10" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">Therefore</span><span id="A13.SS0.SSSx8.p3.1.11" class="ltx_text" style="--ltx-fg-color:#000000;">, </span><math id="A13.SS0.SSSx8.p3.m8" class="ltx_Math" alttext="c=50" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">50</mn></mrow><annotation encoding="application/x-tex">c=50</annotation></semantics></math><span id="A13.SS0.SSSx8.p3.1.12" class="ltx_text" style="--ltx-fg-color:#000000;"> must be the hypotenuse, and </span><math id="A13.SS0.SSSx8.p3.m9" class="ltx_Math" alttext="a=14" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">a</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">14</mn></mrow><annotation encoding="application/x-tex">a=14</annotation></semantics></math><span id="A13.SS0.SSSx8.p3.1.13" class="ltx_text" style="--ltx-fg-color:#000000;">, </span><math id="A13.SS0.SSSx8.p3.m10" class="ltx_Math" alttext="b=48" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">48</mn></mrow><annotation encoding="application/x-tex">b=48</annotation></semantics></math><span id="A13.SS0.SSSx8.p3.1.14" class="ltx_text" style="--ltx-fg-color:#000000;"> are the legs.</span></span>
</span>
<span id="A13.SS0.SSSx8.p4" class="ltx_para ltx_noindent">
<span id="A13.SS0.SSSx8.p4.1" class="ltx_p"><span id="A13.SS0.SSSx8.p4.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">Now</span><span id="A13.SS0.SSSx8.p4.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">, angle </span><math id="A13.SS0.SSSx8.p4.m1" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math><span id="A13.SS0.SSSx8.p4.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> is at vertex </span><math id="A13.SS0.SSSx8.p4.m2" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math><span id="A13.SS0.SSSx8.p4.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">, between sides </span><math id="A13.SS0.SSSx8.p4.m3" class="ltx_Math" alttext="BC" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">C</mi></mrow><annotation encoding="application/x-tex">BC</annotation></semantics></math><span id="A13.SS0.SSSx8.p4.1.5" class="ltx_text" style="--ltx-fg-color:#000000;"> (</span><math id="A13.SS0.SSSx8.p4.m4" class="ltx_Math" alttext="a=14" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">a</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">14</mn></mrow><annotation encoding="application/x-tex">a=14</annotation></semantics></math><span id="A13.SS0.SSSx8.p4.1.6" class="ltx_text" style="--ltx-fg-color:#000000;">) and </span><math id="A13.SS0.SSSx8.p4.m5" class="ltx_Math" alttext="AB" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi></mrow><annotation encoding="application/x-tex">AB</annotation></semantics></math><span id="A13.SS0.SSSx8.p4.1.7" class="ltx_text" style="--ltx-fg-color:#000000;"> (</span><math id="A13.SS0.SSSx8.p4.m6" class="ltx_Math" alttext="c=50" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">50</mn></mrow><annotation encoding="application/x-tex">c=50</annotation></semantics></math><span id="A13.SS0.SSSx8.p4.1.8" class="ltx_text" style="--ltx-fg-color:#000000;">). The opposite side is </span><math id="A13.SS0.SSSx8.p4.m7" class="ltx_Math" alttext="AC" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">C</mi></mrow><annotation encoding="application/x-tex">AC</annotation></semantics></math><span id="A13.SS0.SSSx8.p4.1.9" class="ltx_text" style="--ltx-fg-color:#000000;"> (</span><math id="A13.SS0.SSSx8.p4.m8" class="ltx_Math" alttext="b=48" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">48</mn></mrow><annotation encoding="application/x-tex">b=48</annotation></semantics></math><span id="A13.SS0.SSSx8.p4.1.10" class="ltx_text" style="--ltx-fg-color:#000000;">).
</span><span id="A13.SS0.SSSx8.p4.1.11" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">Thus</span><span id="A13.SS0.SSSx8.p4.1.12" class="ltx_text" style="--ltx-fg-color:#000000;">, by definition:</span></span>
<span id="A13.Ex40" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A13.Ex40.m1" class="ltx_Math" alttext="\cos B=\frac{\text{adjacent}}{\text{hypotenuse}}=\frac{a}{c}=\frac{14}{50}=\frac{7}{25}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">cos</mi><mo lspace="0.167em">⁡</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">adjacent</mtext><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">hypotenuse</mtext></mfrac><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">a</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi></mfrac><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">14</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">50</mn></mfrac><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">25</mn></mfrac></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\cos B=\frac{\text{adjacent}}{\text{hypotenuse}}=\frac{a}{c}=\frac{14}{50}=\frac{7}{25}.</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span>
<span id="A13.SS0.SSSx8.p5" class="ltx_para ltx_noindent">
<span id="A13.SS0.SSSx8.p5.1" class="ltx_p"><span id="A13.SS0.SSSx8.p5.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#0000FF;">But let me confirm</span><span id="A13.SS0.SSSx8.p5.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> with the Law of Cosines. For angle </span><math id="A13.SS0.SSSx8.p5.m1" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math><span id="A13.SS0.SSSx8.p5.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">:</span></span>
<span id="A13.Ex41" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A13.Ex41.m1" class="ltx_Math" alttext="\cos B=\frac{a^{2}+c^{2}-b^{2}}{2ac}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">cos</mi><mo lspace="0.167em">⁡</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">a</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">a</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi></mrow></mfrac></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\cos B=\frac{a^{2}+c^{2}-b^{2}}{2ac}.</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span>
<span id="A13.SS0.SSSx8.p6" class="ltx_para ltx_noindent">
<span id="A13.SS0.SSSx8.p6.1" class="ltx_p"><span id="A13.SS0.SSSx8.p6.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">Substitute carefully:</span></span>
<span id="A13.Ex42" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A13.Ex42.m1" class="ltx_Math" alttext="\cos B=\frac{14^{2}+50^{2}-48^{2}}{2\cdot 14\cdot 50}=\frac{196+2500-2304}{1400}=\frac{392}{1400}=\frac{7}{25}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">cos</mi><mo lspace="0.167em">⁡</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mrow><msup><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">14</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msup><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">50</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msup><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">48</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⋅</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">14</mn><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⋅</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">50</mn></mrow></mfrac><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">196</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2500</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2304</mn></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1400</mn></mfrac><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">392</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1400</mn></mfrac><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">25</mn></mfrac></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\cos B=\frac{14^{2}+50^{2}-48^{2}}{2\cdot 14\cdot 50}=\frac{196+2500-2304}{1400}=\frac{392}{1400}=\frac{7}{25}.</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span>
<span id="A13.SS0.SSSx8.p7" class="ltx_para ltx_noindent">
<span id="A13.SS0.SSSx8.p7.1" class="ltx_p"><span id="A13.SS0.SSSx8.p7.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">Wait, let me double-check.</span><span id="A13.SS0.SSSx8.p7.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> If </span><math id="A13.SS0.SSSx8.p7.m1" class="ltx_Math" alttext="a=14" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">a</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">14</mn></mrow><annotation encoding="application/x-tex">a=14</annotation></semantics></math><span id="A13.SS0.SSSx8.p7.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">, </span><math id="A13.SS0.SSSx8.p7.m2" class="ltx_Math" alttext="b=48" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">48</mn></mrow><annotation encoding="application/x-tex">b=48</annotation></semantics></math><span id="A13.SS0.SSSx8.p7.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">, </span><math id="A13.SS0.SSSx8.p7.m3" class="ltx_Math" alttext="c=50" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">50</mn></mrow><annotation encoding="application/x-tex">c=50</annotation></semantics></math><span id="A13.SS0.SSSx8.p7.1.5" class="ltx_text" style="--ltx-fg-color:#000000;">, then indeed </span><math id="A13.SS0.SSSx8.p7.m4" class="ltx_Math" alttext="14^{2}+48^{2}=196+2304=2500=50^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">14</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msup><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">48</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">196</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2304</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2500</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msup><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">50</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup></mrow><annotation encoding="application/x-tex">14^{2}+48^{2}=196+2304=2500=50^{2}</annotation></semantics></math><span id="A13.SS0.SSSx8.p7.1.6" class="ltx_text" style="--ltx-fg-color:#000000;">, confirming it is a right triangle.
</span><span id="A13.SS0.SSSx8.p7.1.7" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">Hence</span><span id="A13.SS0.SSSx8.p7.1.8" class="ltx_text" style="--ltx-fg-color:#000000;"> the direct trigonometric ratio already suffices.</span></span>
</span>
<span id="A13.SS0.SSSx8.p8" class="ltx_para ltx_noindent">
<span id="A13.SS0.SSSx8.p8.1" class="ltx_p"><span id="A13.SS0.SSSx8.p8.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">…(several “wait” moments, checking whether sides match standard notation, omitted for brevity) …</span></span>
</span>
<span id="A13.SS0.SSSx8.p9" class="ltx_para ltx_noindent">
<span id="A13.SS0.SSSx8.p9.1" class="ltx_p"><span id="A13.SS0.SSSx8.p9.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#0000FF;">Finally</span><span id="A13.SS0.SSSx8.p9.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">, both direct definition and Law of Cosines give the same result.
</span><span id="A13.SS0.SSSx8.p9.1.3" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">Therefore</span><span id="A13.SS0.SSSx8.p9.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">, the value is consistent:</span></span>
<span id="A13.Ex43" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A13.Ex43.m1" class="ltx_Math" alttext="\cos B=\frac{7}{25}\approx 0.28." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">cos</mi><mo lspace="0.167em">⁡</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">25</mn></mfrac><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≈</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0.28</mn></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\cos B=\frac{7}{25}\approx 0.28.</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span>
<span id="A13.SS0.SSSx8.p10" class="ltx_para">
<span id="A13.Ex44" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A13.Ex44.m1" class="ltx_Math" alttext="\boxed{\tfrac{7}{25}}" display="block" intent=":literal"><semantics><menclose notation="box"><mstyle displaystyle="false"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">25</mn></mfrac></mstyle></menclose><annotation encoding="application/x-tex">\boxed{\tfrac{7}{25}}</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span>
</section>
                </span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A13.p9" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A13.p9.pic1" class="ltx_picture" height="258.22" overflow="visible" version="1.1" viewBox="0 0 550 258.22" width="550"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,258.22) matrix(1 0 0 -1 0 0)"><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" fill-opacity="0.5" stroke="#808080" stroke-opacity="0.5"><path style="stroke:none" d="M 3.54 -3.54 L 3.54 254.68 L 553.54 254.68 L 553.54 -3.54 Z"></path></g><g style="--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0"><path style="stroke:none" d="M 0 0 L 0 11.81 L 0 23.62 L 0 35.43 L 0 47.24 L 0 59.06 L 0 70.87 L 0 82.68 L 0 94.49 L 0 106.3 L 0 118.11 L 0 129.92 L 0 141.73 L 0 153.54 L 0 165.35 L 0 177.17 L 0 188.98 L 0 200.79 L 0 212.6 L 0 224.41 L 0 236.22 L 0 248.03 L 0 258.22 L 11.81 258.22 L 23.62 258.22 L 35.43 258.22 L 47.24 258.22 L 59.06 258.22 L 70.87 258.22 L 82.68 258.22 L 94.49 258.22 L 106.3 258.22 L 118.11 258.22 L 129.92 258.22 L 141.73 258.22 L 153.54 258.22 L 165.35 258.22 L 177.17 258.22 L 188.98 258.22 L 200.79 258.22 L 212.6 258.22 L 224.41 258.22 L 236.22 258.22 L 248.03 258.22 L 259.84 258.22 L 271.65 258.22 L 283.46 258.22 L 295.28 258.22 L 307.09 258.22 L 318.9 258.22 L 330.71 258.22 L 342.52 258.22 L 354.33 258.22 L 366.14 258.22 L 377.95 258.22 L 389.76 258.22 L 401.57 258.22 L 413.39 258.22 L 425.2 258.22 L 437.01 258.22 L 448.82 258.22 L 460.63 258.22 L 472.44 258.22 L 484.25 258.22 L 496.06 258.22 L 507.87 258.22 L 519.69 258.22 L 531.5 258.22 L 543.31 258.22 L 550 258.22 L 550 246.41 L 550 234.6 L 550 222.79 L 550 210.98 L 550 199.16 L 550 187.35 L 550 175.54 L 550 163.73 L 550 151.92 L 550 140.11 L 550 128.3 L 550 116.49 L 550 104.68 L 550 92.87 L 550 81.05 L 550 69.24 L 550 57.43 L 550 45.62 L 550 33.81 L 550 22 L 550 10.19 L 550 0 L 538.