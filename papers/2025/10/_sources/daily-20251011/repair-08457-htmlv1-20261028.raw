 550 30.26 L 550 18.45 L 550 6.64 L 550 0 L 538.19 0 L 526.38 0 L 514.57 0 L 502.76 0 L 490.94 0 L 479.13 0 L 467.32 0 L 455.51 0 L 443.7 0 L 431.89 0 L 420.08 0 L 408.27 0 L 396.46 0 L 384.65 0 L 372.83 0 L 361.02 0 L 349.21 0 L 337.4 0 L 325.59 0 L 313.78 0 L 301.97 0 L 290.16 0 L 278.35 0 L 266.54 0 L 254.72 0 L 242.91 0 L 231.1 0 L 219.29 0 L 207.48 0 L 195.67 0 L 183.86 0 L 172.05 0 L 160.24 0 L 148.43 0 L 136.61 0 L 124.8 0 L 112.99 0 L 101.18 0 L 89.37 0 L 77.56 0 L 65.75 0 L 53.94 0 L 42.13 0 L 30.31 0 L 18.5 0 L 6.69 0 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 1.11 1.11 L 1.11 277.19 L 548.89 277.19 L 548.89 1.11 Z"></path></g><g style="--ltx-fg-color:#000000;" color="#000000" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><path style="fill:none" d="M 0.55 0.55 L 0.55 277.74 L 549.45 277.74 L 549.45 0.55 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 18.88 16.11)"><foreignObject style="--ltx-fo-width:37.02em;--ltx-fo-height:17.78em;--ltx-fo-depth:0em;font-size:10pt;" height="246.07" overflow="visible" transform="matrix(1 0 0 -1 0 246.07)" width="512.25"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A13.p5.pic1.1" class="ltx_inline-sectional-block ltx_minipage">
                  
<section id="A13.SS0.SSSx5" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection" style="--ltx-fg-color:#000000;">Question</h4>

<span id="A13.SS0.SSSx5.p1" class="ltx_para ltx_noindent">
<span id="A13.SS0.SSSx5.p1.1" class="ltx_p"><span id="A13.SS0.SSSx5.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">In </span><math id="A13.SS0.SSSx5.p1.m1" class="ltx_Math" alttext="\odot W" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⊙</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi></mrow><annotation encoding="application/x-tex">\odot W</annotation></semantics></math><span id="A13.SS0.SSSx5.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">, arcs </span><math id="A13.SS0.SSSx5.p1.m2" class="ltx_Math" alttext="\widehat{RS}" display="inline" intent=":literal"><semantics><mover accent="true"><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></mrow><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{RS}</annotation></semantics></math><span id="A13.SS0.SSSx5.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> and </span><math id="A13.SS0.SSSx5.p1.m3" class="ltx_Math" alttext="\widehat{TV}" display="inline" intent=":literal"><semantics><mover accent="true"><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi></mrow><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{TV}</annotation></semantics></math><span id="A13.SS0.SSSx5.p1.1.4" class="ltx_text" style="--ltx-fg-color:#000000;"> are congruent.
Find the length of </span><math id="A13.SS0.SSSx5.p1.m4" class="ltx_Math" alttext="RS" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></mrow><annotation encoding="application/x-tex">RS</annotation></semantics></math><span id="A13.SS0.SSSx5.p1.1.5" class="ltx_text" style="--ltx-fg-color:#000000;">.</span></span>
</span>
<span id="A13.SS0.SSSx5.p2" class="ltx_para"><img src="2510.08457v1/iclr2026/images/easy_low_000147.png" id="A13.SS0.SSSx5.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:230/232;" width="230" height="232" alt="[Uncaptioned image]">
</span>
</section>
                </span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A13.p6" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A13.p6.pic1" class="ltx_picture" height="458.25" overflow="visible" version="1.1" viewBox="0 0 550 458.25" width="550"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,458.25) matrix(1 0 0 -1 0 0)"><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" fill-opacity="0.5" stroke="#808080" stroke-opacity="0.5"><path style="stroke:none" d="M 3.54 -3.54 L 3.54 454.71 L 553.54 454.71 L 553.54 -3.54 Z"></path></g><g style="--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0"><path style="stroke:none" d="M 0 0 L 0 458.25 L 550 458.25 L 550 0 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 1.11 1.11 L 1.11 457.15 L 548.89 457.15 L 548.89 1.11 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 18.88 18.88)"><foreignObject style="--ltx-fo-width:37.02em;--ltx-fo-height:30.39em;--ltx-fo-depth:0em;font-size:10pt;" height="420.5" overflow="visible" transform="matrix(1 0 0 -1 0 420.5)" width="512.25"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A13.p6.pic1.1" class="ltx_inline-sectional-block ltx_minipage">
                  
<section id="A13.SS0.SSSx6" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection" style="--ltx-fg-color:#000000;">Question with appropriate number of High-Entropy Tokens</h4>

<span id="A13.SS0.SSSx6.p1" class="ltx_para ltx_noindent">
<span id="A13.SS0.SSSx6.p1.1" class="ltx_tabular ltx_align_middle">
<span class="ltx_tbody">
<span id="A13.SS0.SSSx6.p1.1.1" class="ltx_tr">
<span id="A13.SS0.SSSx6.p1.1.1.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding-left:1.0pt;padding-right:1.0pt;"><span id="A13.SS0.SSSx6.p1.1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">difficulty:</span><span id="A13.SS0.SSSx6.p1.1.1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> Easy</span></span>
<span id="A13.SS0.SSSx6.p1.1.1.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding-left:1.0pt;padding-right:1.0pt;"><span id="A13.SS0.SSSx6.p1.1.1.2.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Gen_high_entropy_token:</span><span id="A13.SS0.SSSx6.p1.1.1.2.2" class="ltx_text" style="--ltx-fg-color:#000000;"> 20</span></span>
<span id="A13.SS0.SSSx6.p1.1.1.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding-left:1.0pt;padding-right:1.0pt;"><span id="A13.SS0.SSSx6.p1.1.1.3.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Threshold(easy):</span><span id="A13.SS0.SSSx6.p1.1.1.3.2" class="ltx_text" style="--ltx-fg-color:#000000;"> 28</span></span></span>
<span id="A13.SS0.SSSx6.p1.1.2" class="ltx_tr">
<span id="A13.SS0.SSSx6.p1.1.2.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding-left:1.0pt;padding-right:1.0pt;"><span id="A13.SS0.SSSx6.p1.1.2.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Entropy reward:</span><span id="A13.SS0.SSSx6.p1.1.2.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> 0.0</span></span>
<span id="A13.SS0.SSSx6.p1.1.2.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding-left:1.0pt;padding-right:1.0pt;"><span id="A13.SS0.SSSx6.p1.1.2.2.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">acc reward:</span><span id="A13.SS0.SSSx6.p1.1.2.2.2" class="ltx_text" style="--ltx-fg-color:#000000;"> 1.0</span></span>
<span id="A13.SS0.SSSx6.p1.1.2.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding-left:1.0pt;padding-right:1.0pt;"><span id="A13.SS0.SSSx6.p1.1.2.3.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">overall reward:</span><span id="A13.SS0.SSSx6.p1.1.2.3.2" class="ltx_text" style="--ltx-fg-color:#000000;"> 1.0</span></span></span>
</span>
</span>
</span>
<span id="A13.SS0.SSSx6.p2" class="ltx_para ltx_noindent">
<span id="A13.SS0.SSSx6.p2.1" class="ltx_p"><span id="A13.SS0.SSSx6.p2.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#0000FF;">Okay, let’s see.</span><span id="A13.SS0.SSSx6.p2.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> I need to find the length of </span><math id="A13.SS0.SSSx6.p2.m1" class="ltx_Math" alttext="RS" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></mrow><annotation encoding="application/x-tex">RS</annotation></semantics></math><span id="A13.SS0.SSSx6.p2.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> in circle </span><math id="A13.SS0.SSSx6.p2.m2" class="ltx_Math" alttext="\odot W" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⊙</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi></mrow><annotation encoding="application/x-tex">\odot W</annotation></semantics></math><span id="A13.SS0.SSSx6.p2.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">. The problem says the arcs </span><math id="A13.SS0.SSSx6.p2.m3" class="ltx_Math" alttext="RS" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></mrow><annotation encoding="application/x-tex">RS</annotation></semantics></math><span id="A13.SS0.SSSx6.p2.1.5" class="ltx_text" style="--ltx-fg-color:#000000;"> and </span><math id="A13.SS0.SSSx6.p2.m4" class="ltx_Math" alttext="TV" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi></mrow><annotation encoding="application/x-tex">TV</annotation></semantics></math><span id="A13.SS0.SSSx6.p2.1.6" class="ltx_text" style="--ltx-fg-color:#000000;"> are congruent.</span></span>
</span>
<span id="A13.SS0.SSSx6.p3" class="ltx_para ltx_noindent">
<span id="A13.SS0.SSSx6.p3.1" class="ltx_p"><span id="A13.SS0.SSSx6.p3.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">First, recall</span><span id="A13.SS0.SSSx6.p3.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> that in a circle, congruent arcs correspond to congruent chords.
</span><span id="A13.SS0.SSSx6.p3.1.3" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">Therefore</span><span id="A13.SS0.SSSx6.p3.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">, if arc </span><math id="A13.SS0.SSSx6.p3.m1" class="ltx_Math" alttext="RS\cong" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≅</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">RS\cong</annotation></semantics></math><span id="A13.SS0.SSSx6.p3.1.5" class="ltx_text" style="--ltx-fg-color:#000000;"> arc </span><math id="A13.SS0.SSSx6.p3.m2" class="ltx_Math" alttext="TV" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi></mrow><annotation encoding="application/x-tex">TV</annotation></semantics></math><span id="A13.SS0.SSSx6.p3.1.6" class="ltx_text" style="--ltx-fg-color:#000000;">, then chord </span><math id="A13.SS0.SSSx6.p3.m3" class="ltx_Math" alttext="RS\cong" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≅</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">RS\cong</annotation></semantics></math><span id="A13.SS0.SSSx6.p3.1.7" class="ltx_text" style="--ltx-fg-color:#000000;"> chord </span><math id="A13.SS0.SSSx6.p3.m4" class="ltx_Math" alttext="TV" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi></mrow><annotation encoding="application/x-tex">TV</annotation></semantics></math><span id="A13.SS0.SSSx6.p3.1.8" class="ltx_text" style="--ltx-fg-color:#000000;">.</span></span>
</span>
<span id="A13.SS0.SSSx6.p4" class="ltx_para ltx_noindent">
<span id="A13.SS0.SSSx6.p4.1" class="ltx_p"><span id="A13.SS0.SSSx6.p4.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">The problem gives:</span></span>
<span id="A13.Ex34" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A13.Ex34.m1" class="ltx_Math" alttext="RS=5x-9,\quad TV=2x+3." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">5</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="1.167em">,</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">RS=5x-9,\quad TV=2x+3.</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span>
<span id="A13.SS0.SSSx6.p5" class="ltx_para ltx_noindent">
<span id="A13.SS0.SSSx6.p5.1" class="ltx_p"><span id="A13.SS0.SSSx6.p5.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">So we set them equal:</span></span>
<span id="A13.Ex35" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A13.Ex35.m1" class="ltx_Math" alttext="5x-9=2x+3." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">5</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">5x-9=2x+3.</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span>
<span id="A13.SS0.SSSx6.p6" class="ltx_para ltx_noindent">
<span id="A13.SS0.SSSx6.p6.1" class="ltx_p"><span id="A13.SS0.SSSx6.p6.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">Solving:</span></span>
<span id="A13.Ex36" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A13.Ex36.m1" class="ltx_Math" alttext="3x-9=3\quad\Longrightarrow\quad 3x=12\quad\Longrightarrow\quad x=4." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></mrow><mspace style="width:1em;" width="1em"></mspace><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">⟹</mo><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">12</mn></mrow><mspace style="width:1em;" width="1em"></mspace><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">⟹</mo><mspace style="width:1em;" width="1em"></mspace><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">3x-9=3\quad\Longrightarrow\quad 3x=12\quad\Longrightarrow\quad x=4.</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span>
<span id="A13.SS0.SSSx6.p7" class="ltx_para ltx_noindent">
<span id="A13.SS0.SSSx6.p7.1" class="ltx_p"><span id="A13.SS0.SSSx6.p7.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#0000FF;">Now check:</span></span>
<span id="A13.Ex37" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A13.Ex37.m1" class="ltx_Math" alttext="RS=5(4)-9=11,\quad TV=2(4)+3=11." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">5</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">11</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="1.167em">,</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">11</mn></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">RS=5(4)-9=11,\quad TV=2(4)+3=11.</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span>
<span id="A13.SS0.SSSx6.p8" class="ltx_para ltx_noindent">
<span id="A13.SS0.SSSx6.p8.1" class="ltx_p"><span id="A13.SS0.SSSx6.p8.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">Wait, let me double-check.</span><span id="A13.SS0.SSSx6.p8.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> Are RS and TV the correct chords? Arc </span><math id="A13.SS0.SSSx6.p8.m1" class="ltx_Math" alttext="RS" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></mrow><annotation encoding="application/x-tex">RS</annotation></semantics></math><span id="A13.SS0.SSSx6.p8.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> corresponds to chord </span><math id="A13.SS0.SSSx6.p8.m2" class="ltx_Math" alttext="RS" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></mrow><annotation encoding="application/x-tex">RS</annotation></semantics></math><span id="A13.SS0.SSSx6.p8.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">, arc </span><math id="A13.SS0.SSSx6.p8.m3" class="ltx_Math" alttext="TV" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi></mrow><annotation encoding="application/x-tex">TV</annotation></semantics></math><span id="A13.SS0.SSSx6.p8.1.5" class="ltx_text" style="--ltx-fg-color:#000000;"> to chord </span><math id="A13.SS0.SSSx6.p8.m4" class="ltx_Math" alttext="TV" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi></mrow><annotation encoding="application/x-tex">TV</annotation></semantics></math><span id="A13.SS0.SSSx6.p8.1.6" class="ltx_text" style="--ltx-fg-color:#000000;">. Since arcs are congruent, chords must be equal. Yes, consistent.</span></span>
</span>
<span id="A13.SS0.SSSx6.p9" class="ltx_para ltx_noindent">
<span id="A13.SS0.SSSx6.p9.1" class="ltx_p"><span id="A13.SS0.SSSx6.p9.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">Thus</span><span id="A13.SS0.SSSx6.p9.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">, the required length is</span></span>
<span id="A13.Ex38" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A13.Ex38.m1" class="ltx_Math" alttext="\boxed{11}." display="block" intent=":literal"><semantics><mrow><menclose notation="box"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">11</mn></menclose><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\boxed{11}.</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span>
</section>
                </span></span></span></foreignObject></g></g></svg></span>
</div>
