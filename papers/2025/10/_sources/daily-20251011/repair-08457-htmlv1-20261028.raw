<div id="algorithm1.4.33" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.33.1" class="ltx_text ltx_font_bold">19</span></span>
          <math id="algorithm1.m42" class="ltx_math_unparsed" alttext="\mathcal{L}_{\mathrm{actor}}\leftarrow-\frac{1}{G}\sum_{i}\frac{1}{L_{i}}\sum_{t}\min\{r_{i,t}(\theta)\tilde{A}_{i,t},\mathrm{clip}(r_{i,t}(\theta),1-\epsilon,1+\epsilon)\tilde{A}_{i,t}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>actor</mi></msub><mo rspace="0em" stretchy="false">←</mo><mo lspace="0em">−</mo><mfrac><mn>1</mn><mi>G</mi></mfrac><msub><mo>∑</mo><mi>i</mi></msub><mfrac><mn>1</mn><msub><mi>L</mi><mi>i</mi></msub></mfrac><msub><mo>∑</mo><mi>t</mi></msub><mi>min</mi><mrow><mo stretchy="false">{</mo><msub><mi>r</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><msub><mover accent="true"><mi>A</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><mi>clip</mi><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mn>1</mn><mo>−</mo><mi>ϵ</mi><mo>,</mo><mn>1</mn><mo>+</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow><msub><mover accent="true"><mi>A</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\mathrm{actor}}\leftarrow-\frac{1}{G}\sum_{i}\frac{1}{L_{i}}\sum_{t}\min\{r_{i,t}(\theta)\tilde{A}_{i,t},\mathrm{clip}(r_{i,t}(\theta),1-\epsilon,1+\epsilon)\tilde{A}_{i,t}\}</annotation></semantics></math>
</div>
<div id="algorithm1.4.34" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.34.1" class="ltx_text ltx_font_bold">20</span></span>
          <math id="algorithm1.m43" class="ltx_math_unparsed" alttext="\mathcal{L}_{\mathrm{KL}}\leftarrow\kappa_{d(x)}\cdot\frac{1}{G}\sum_{i}\frac{1}{L_{i}}\sum_{t}\beta_{i,t}\,\mathrm{kld}_{i,t}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><msub><mrow></mrow><mi>KL</mi></msub><mo stretchy="false">←</mo><mi>κ</mi><msub><mrow></mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mn>1</mn><mi>G</mi></mfrac><mo>∑</mo><msub><mrow></mrow><mi>i</mi></msub><mfrac><mn>1</mn><msub><mi>L</mi><mi>i</mi></msub></mfrac><mo>∑</mo><msub><mrow></mrow><mi>t</mi></msub><mi>β</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mi>kld</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\mathrm{KL}}\leftarrow\kappa_{d(x)}\cdot\frac{1}{G}\sum_{i}\frac{1}{L_{i}}\sum_{t}\beta_{i,t}\,\mathrm{kld}_{i,t}</annotation></semantics></math>
</div>
<div id="algorithm1.4.35" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.35.1" class="ltx_text ltx_font_bold">21</span></span>
          <math id="algorithm1.m44" class="ltx_Math" alttext="\mathcal{L}\leftarrow\mathcal{L}_{\mathrm{actor}}+\mathcal{L}_{\mathrm{KL}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo stretchy="false">←</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>actor</mi></msub><mo>+</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>KL</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}\leftarrow\mathcal{L}_{\mathrm{actor}}+\mathcal{L}_{\mathrm{KL}}</annotation></semantics></math>
</div>
<div id="algorithm1.4.36" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.36.1" class="ltx_text ltx_font_bold">22</span></span>
          Update <math id="algorithm1.m45" class="ltx_Math" alttext="\theta\leftarrow\theta-\eta\nabla_{\theta}\mathcal{L}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo stretchy="false">←</mo><mrow><mi>θ</mi><mo>−</mo><mrow><mi>η</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta\leftarrow\theta-\eta\nabla_{\theta}\mathcal{L}</annotation></semantics></math>
</div>
<div id="algorithm1.4.37" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.37.1" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm1.4.37.2" class="ltx_text ltx_font_typewriter">(8) KL controller update (non-window tokens only) </span>
</div>
<div id="algorithm1.4.38" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.38.1" class="ltx_text ltx_font_bold">23</span></span>
          <math id="algorithm1.m46" class="ltx_math_unparsed" alttext="\mathrm{KL}_{\mathrm{ctrl}}\leftarrow\frac{1}{G}\sum_{i}\frac{1}{L_{i}}\sum_{t}\mathbb{I}\{m_{i,t}=0\}\,\mathrm{kld}_{i,t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>KL</mi><mi>ctrl</mi></msub><mo stretchy="false">←</mo><mfrac><mn>1</mn><mi>G</mi></mfrac><msub><mo>∑</mo><mi>i</mi></msub><mfrac><mn>1</mn><msub><mi>L</mi><mi>i</mi></msub></mfrac><msub><mo>∑</mo><mi>t</mi></msub><mi>𝕀</mi><mrow><mo stretchy="false">{</mo><msub><mi>m</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><mn>0</mn><mo rspace="0.170em" stretchy="false">}</mo></mrow><msub><mi>kld</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathrm{KL}_{\mathrm{ctrl}}\leftarrow\frac{1}{G}\sum_{i}\frac{1}{L_{i}}\sum_{t}\mathbb{I}\{m_{i,t}=0\}\,\mathrm{kld}_{i,t}</annotation></semantics></math>
</div>
<div id="algorithm1.4.39" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.39.1" class="ltx_text ltx_font_bold">24</span></span>
          <math id="algorithm1.m47" class="ltx_Math" alttext="\kappa_{d(x)}\leftarrow\mathrm{clip}\!\Big(\kappa_{d(x)}\big(1+\alpha_{\kappa}(\mathrm{KL}_{\mathrm{ctrl}}/\delta_{d(x)}-1)\big),\ \kappa_{\min},\kappa_{\max}\Big)" display="inline" intent=":literal"><semantics><mrow><msub><mi>κ</mi><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">←</mo><mrow><mpadded style="width:1.428em;" width="1.428em"><mi>clip</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msub><mi>κ</mi><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>α</mi><mi>κ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>KL</mi><mi>ctrl</mi></msub><mo>/</mo><msub><mi>δ</mi><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>,</mo><msub><mi>κ</mi><mi>min</mi></msub><mo>,</mo><msub><mi>κ</mi><mi>max</mi></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\kappa_{d(x)}\leftarrow\mathrm{clip}\!\Big(\kappa_{d(x)}\big(1+\alpha_{\kappa}(\mathrm{KL}_{\mathrm{ctrl}}/\delta_{d(x)}-1)\big),\ \kappa_{\min},\kappa_{\max}\Big)</annotation></semantics></math>
</div>
<div id="algorithm1.4.40" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.40.1" class="ltx_text ltx_font_bold">25</span></span>
          end foreach
</div>
<div id="algorithm1.4.41" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.41.1" class="ltx_text ltx_font_bold">26</span></span>
          end for
</div>
<div id="algorithm1.4.42" class="ltx_listingline">
</div>
</div>
</figure>
</section>
<section id="A7" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix G </span>On-policy difficulty and buckets</h2>

<div id="A7.p1" class="ltx_para ltx_noindent">
<p id="A7.p1.1" class="ltx_p">Instance difficulty is estimated online using group rollouts.
With <math id="A7.p1.m1" class="ltx_Math" alttext="K{=}8" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">K{=}8</annotation></semantics></math> samples per prompt,</p>
<table id="A7.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.E9.m1" class="ltx_Math" alttext="\mathrm{pass@}8(x)=\frac{1}{8}\sum_{k=1}^{8}\mathbf{1}\{\text{correct}(y^{(k)},x)\}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>pass</mi><mo lspace="0em" rspace="0em">​</mo><mi>@</mi><mo lspace="0em" rspace="0em">​</mo><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mn>8</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mn>8</mn></munderover><mrow><mn>𝟏</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><mtext>correct</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathrm{pass@}8(x)=\frac{1}{8}\sum_{k=1}^{8}\mathbf{1}\{\text{correct}(y^{(k)},x)\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
<p id="A7.p1.2" class="ltx_p">and we assign buckets</p>
<table id="A7.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.E10.m1" class="ltx_Math" alttext="d(x)=\begin{cases}\texttt{easy},&amp;\mathrm{pass@}8(x)\geq 6,\\[2.0pt]
\texttt{medium},&amp;3\leq\mathrm{pass@}8(x)&lt;6,\\[2.0pt]
\texttt{hard},&amp;\mathrm{pass@}8(x)\leq 2.\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mtext class="ltx_mathvariant_monospace">easy</mtext><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mi>pass</mi><mo lspace="0em" rspace="0em">​</mo><mi>@</mi><mo lspace="0em" rspace="0em">​</mo><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>6</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mtext class="ltx_mathvariant_monospace">medium</mtext><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>3</mn><mo>≤</mo><mrow><mi>pass</mi><mo lspace="0em" rspace="0em">​</mo><mi>@</mi><mo lspace="0em" rspace="0em">​</mo><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>6</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mtext class="ltx_mathvariant_monospace">hard</mtext><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mi>pass</mi><mo lspace="0em" rspace="0em">​</mo><mi>@</mi><mo lspace="0em" rspace="0em">​</mo><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>2</mn></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">d(x)=\begin{cases}\texttt{easy},&amp;\mathrm{pass@}8(x)\geq 6,\\[2.0pt]
\texttt{medium},&amp;3\leq\mathrm{pass@}8(x)&lt;6,\\[2.0pt]
\texttt{hard},&amp;\mathrm{pass@}8(x)\leq 2.\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(10)</span></td></tr></tbody>
</table>
<p id="A7.p1.3" class="ltx_p">Buckets are recomputed each iteration and will parameterize per-bucket budgets/targets in our method.</p>
</div>
</section>
<section id="A8" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix H </span>High-Entropy Tokens</h2>

<div id="A8.p1" class="ltx_para ltx_noindent">
<p id="A8.p1.1" class="ltx_p">In our analysis, we define the number of <em id="A8.p1.1.1" class="ltx_emph ltx_font_italic">high-entropy tokens</em> in a
trajectory by combining an entropy-based thresholding procedure with a
semantics-aware filtering step.</p>
</div>
<section id="A8.SS0.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Semantic filtering.</h5>

<div id="A8.SS0.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A8.SS0.SSS0.Px1.p1.1" class="ltx_p">Rather than counting all tokens that exceed a certain entropy threshold,
we first restrict attention to a fixed vocabulary of <em id="A8.SS0.SSS0.Px1.p1.1.1" class="ltx_emph ltx_font_italic">semantically
meaningful reasoning triggers</em>. This vocabulary is constructed using a
filtering prompt applied to GPT, which classifies each candidate token
as either “reasoning-relevant” (True) or not (False). The retained tokens
include transition markers (e.g., <em id="A8.SS0.SSS0.Px1.p1.1.2" class="ltx_emph ltx_font_italic">but</em>, <em id="A8.SS0.SSS0.Px1.p1.1.3" class="ltx_emph ltx_font_italic">however</em>),
reasoning initiators (e.g., <em id="A8.SS0.SSS0.Px1.p1.1.4" class="ltx_emph ltx_font_italic">therefore</em>, <em id="A8.SS0.SSS0.Px1.p1.1.5" class="ltx_emph ltx_font_italic">thus</em>), and other
structural markers that signal the onset of a reasoning step. Tokens
with little semantic content (e.g., <em id="A8.SS0.SSS0.Px1.p1.1.6" class="ltx_emph ltx_font_italic">A</em>, <em id="A8.SS0.SSS0.Px1.p1.1.7" class="ltx_emph ltx_font_italic">B</em>, digits, or
domain-specific placeholders) are excluded. The entire resulting
vocabulary can be visualized in Figure <span class="ltx_ref ltx_missing_label ltx_ref_self"></span>(b),
where the word cloud highlights the most frequent reasoning triggers.</p>
</div>
</section>
<section id="A8.SS0.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Entropy thresholding.</h5>

<div id="A8.SS0.SSS0.Px2.p1" class="ltx_para ltx_noindent">
<p id="A8.SS0.SSS0.Px2.p1.1" class="ltx_p">Given token-level entropy values <math id="A8.SS0.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\{H_{t}\}_{t=1}^{T}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>H</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><annotation encoding="application/x-tex">\{H_{t}\}_{t=1}^{T}</annotation></semantics></math>, we compute the
<math id="A8.SS0.SSS0.Px2.p1.m2" class="ltx_Math" alttext="95" display="inline" intent=":literal"><semantics><mn>95</mn><annotation encoding="application/x-tex">95</annotation></semantics></math>th percentile of entropies within the current batch, denoted
<math id="A8.SS0.SSS0.Px2.p1.m3" class="ltx_Math" alttext="\theta_{0.95}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mn>0.95</mn></msub><annotation encoding="application/x-tex">\theta_{0.95}</annotation></semantics></math>. A token <math id="A8.SS0.SSS0.Px2.p1.m4" class="ltx_Math" alttext="o_{t}" display="inline" intent=":literal"><semantics><msub><mi>o</mi><mi>t</mi></msub><annotation encoding="application/x-tex">o_{t}</annotation></semantics></math> is labeled as <em id="A8.SS0.SSS0.Px2.p1.1.1" class="ltx_emph ltx_font_italic">high-entropy</em> if</p>
<table id="A8.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex17.m1" class="ltx_Math" alttext="H_{t}\;\geq\;\theta_{0.95}\quad\text{and}\quad o_{t}\in\mathcal{V}_{\text{sem}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>H</mi><mi>t</mi></msub><mo lspace="0.558em" rspace="0.558em">≥</mo><msub><mi>θ</mi><mn>0.95</mn></msub></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mi>o</mi><mi>t</mi></msub><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext>sem</mtext></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">H_{t}\;\geq\;\theta_{0.95}\quad\text{and}\quad o_{t}\in\mathcal{V}_{\text{sem}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS0.SSS0.Px2.p1.2" class="ltx_p">where <math id="A8.SS0.SSS0.Px2.p1.m5" class="ltx_Math" alttext="\mathcal{V}_{\text{sem}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext>sem</mtext></msub><annotation encoding="application/x-tex">\mathcal{V}_{\text{sem}}</annotation></semantics></math> is the fixed set of semantically
filtered tokens.</p>
</div>
<div id="A8.SS0.SSS0.Px2.p2" class="ltx_para ltx_noindent">
<p id="A8.SS0.SSS0.Px2.p2.1" class="ltx_p">The number of high-entropy tokens in a trajectory <math id="A8.SS0.SSS0.Px2.p2.m1" class="ltx_Math" alttext="y=(o_{1},\dots,o_{T})" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>o</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>o</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">y=(o_{1},\dots,o_{T})</annotation></semantics></math> is
thus defined as</p>
<table id="A8.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex18.m1" class="ltx_math_unparsed" alttext="N_{\text{HE}}(y)=\sum_{t=1}^{T}\mathbf{1}\!\left[H_{t}\geq\theta_{0.95}\;\wedge\;o_{t}\in\mathcal{V}_{\text{sem}}\right]." display="block" intent=":literal"><semantics><mrow><msub><mi>N</mi><mtext>HE</mtext></msub><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">=</mo><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mrow><mo>[</mo><msub><mi>H</mi><mi>t</mi></msub><mo>≥</mo><msub><mi>θ</mi><mn>0.95</mn></msub><mo rspace="0.502em">∧</mo><msub><mi>o</mi><mi>t</mi></msub><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext>sem</mtext></msub><mo>]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">N_{\text{HE}}(y)=\sum_{t=1}^{T}\mathbf{1}\!\left[H_{t}\geq\theta_{0.95}\;\wedge\;o_{t}\in\mathcal{V}_{\text{sem}}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A8.SS0.SSS0.Px2.p3" class="ltx_para ltx_noindent">
<p id="A8.SS0.SSS0.Px2.p3.1" class="ltx_p">This definition ensures that our entropy-based reward focuses only on
tokens that both exhibit unusually high uncertainty and carry clear
semantic signals of reasoning transitions. As a result, the entropy
reward mechanism becomes more interpretable and more closely aligned
with reasoning-relevant exploratory behavior.</p>
</div>
</section>
</section>
<section id="A9" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix I </span>Visual Analysis of Entropy Reward Design</h2>

<figure id="A9.F9" class="ltx_figure"><img src="2510.08457v1/iclr2026/images/reward_visual.png" id="A9.F9.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:548/119;" width="548" height="119" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 9: </span><span id="A9.F9.3" class="ltx_text ltx_font_bold">Effect of entropy shaping and KL regularization on accuracy reward.</span>
We plot the moving-average accuracy reward over training steps under different
ablation settings. Baseline methods like GRPO and DAPO either lack stable
improvement or plateau early. In contrast, our ARES variants consistently achieve
higher accuracy rewards throughout training. Notably, combining both KL
regularization and entropy shaping yields the most stable and significant gains,
demonstrating the necessity of the two components working together.</figcaption>
</figure>
<div id="A9.p1" class="ltx_para ltx_noindent">
<p id="A9.p1.1" class="ltx_p">To better understand the effect of our entropy reward shaping, we provide a
visual analysis in Figure <a href="#A9.F9" title="Figure 9 ‣ Appendix I Visual Analysis of Entropy Reward Design ‣ ARES: Multimodal Adaptive Reasoning via Difficulty-Aware Token-Level Entropy Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>. Each plot illustrates
the entropy reward component as a function of the deviation
<math id="A9.p1.m1" class="ltx_Math" alttext="\Delta=N_{\text{HE}}-N^{\text{target}}_{\text{HE}}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>=</mo><mrow><msub><mi>N</mi><mtext>HE</mtext></msub><mo>−</mo><msubsup><mi>N</mi><mtext>HE</mtext><mtext>target</mtext></msubsup></mrow></mrow><annotation encoding="application/x-tex">\Delta=N_{\text{HE}}-N^{\text{target}}_{\text{HE}}</annotation></semantics></math>, where
<math id="A9.p1.m2" class="ltx_Math" alttext="N_{\text{HE}}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mtext>HE</mtext></msub><annotation encoding="application/x-tex">N_{\text{HE}}</annotation></semantics></math> is the number of detected high-entropy tokens
and <math id="A9.p1.m3" class="ltx_Math" alttext="N^{\text{target}}_{\text{HE}}" display="inline" intent=":literal"><semantics><msubsup><mi>N</mi><mtext>HE</mtext><mtext>target</mtext></msubsup><annotation encoding="application/x-tex">N^{\text{target}}_{\text{HE}}</annotation></semantics></math> is the difficulty-dependent target.</p>
</div>
<section id="A9.SS0.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Easy tasks.</h5>

<div id="A9.SS0.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A9.SS0.SSS0.Px1.p1.1" class="ltx_p">For easy problems, excessive high-entropy activity indicates unnecessary
overthinking. As shown in the left panel, the entropy reward heavily penalizes
positive deviations (<math id="A9.SS0.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\Delta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta&gt;0</annotation></semantics></math>), while providing only mild encouragement when
errors occur (<math id="A9.SS0.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\text{acc}=0" display="inline" intent=":literal"><semantics><mrow><mtext>acc</mtext><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\text{acc}=0</annotation></semantics></math>). This ensures that correct responses remain short
and efficient, while still allowing a small degree of exploratory thinking if
the model initially fails.</p>
</div>
</section>
<section id="A9.SS0.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Medium tasks.</h5>

<div id="A9.SS0.SSS0.Px2.p1" class="ltx_para ltx_noindent">
<p id="A9.SS0.SSS0.Px2.p1.1" class="ltx_p">For medium-difficulty problems, the design is symmetric around the target.
Moderate deviations from the target are tolerated, but excessive deviations in
either direction are penalized. Importantly, when the model answers incorrectly,
the entropy reward encourages it to increase reasoning length (i.e., generate
more high-entropy tokens). This balances efficiency with robustness, preventing
both under- and over-thinking.</p>
</div>
</section>
<section id="A9.SS0.SSS0.Px3" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Hard tasks.</h5>

<div id="A9.SS0.SSS0.Px3.p1" class="ltx_para ltx_noindent">
<p id="A9.SS0.SSS0.Px3.p1.1" class="ltx_p">For hard problems, high entropy is consistently rewarded regardless of accuracy.
As shown in the right panel, both correct and incorrect responses receive
positive shaping when <math id="A9.SS0.SSS0.Px3.p1.m1" class="ltx_Math" alttext="\Delta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta&gt;0</annotation></semantics></math>. This reflects the intuition that difficult
problems require longer and more exploratory reasoning chains, and the model
should be encouraged to sustain high-entropy reasoning segments.</p>
</div>
<div id="A9.SS0.SSS0.Px3.p2" class="ltx_para ltx_noindent">
<p id="A9.SS0.SSS0.Px3.p2.1" class="ltx_p">Overall, the entropy reward curves realize a difficulty-aware shaping strategy:
they suppress unnecessary verbosity on easy problems, regulate reasoning depth
for medium ones, and strongly encourage exploratory thinking on hard problems.
This design provides a smooth and interpretable mechanism for adaptive reasoning
across the full difficulty spectrum.</p>
</div>
</section>
</section>
<section id="A10" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix J </span>Why High–Entropy Tokens Predict Reasoning Response Length</h2>

<div id="A10.p1" class="ltx_para ltx_noindent">
<p id="A10.p1.1" class="ltx_p">Given input <math id="A10.p1.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, the policy <math id="A10.p1.m2" class="ltx_Math" alttext="\pi_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\pi_{\theta}</annotation></semantics></math> generates a response <math id="A10.p1.m3" class="ltx_Math" alttext="o=(o_{1},\dots,o_{L})" display="inline" intent=":literal"><semantics><mrow><mi>o</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>o</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>o</mi><mi>L</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">o=(o_{1},\dots,o_{L})</annotation></semantics></math> with random stopping time <math id="A10.p1.m4" class="ltx_Math" alttext="\tau=L" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>=</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">\tau=L</annotation></semantics></math>.
Let <math id="A10.p1.m5" class="ltx_math_unparsed" alttext="h_{t}=(x,o_{1:t-1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mi>t</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>o</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">h_{t}=(x,o_{1:t-1})</annotation></semantics></math> be the history at step <math id="A10.p1.m6" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> and define the (possibly top-<math id="A10.p1.m7" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> normalized) token entropy</p>
<table id="A10.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E11.m1" class="ltx_math_unparsed" alttext="H_{t}\;=\;-\sum_{v}p_{\theta}(v\mid h_{t})\,\log p_{\theta}(v\mid h_{t})." display="block" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>t</mi></msub><mo lspace="0.558em" rspace="0.058em">=</mo><mo rspace="0.055em">−</mo><munder><mo movablelimits="false">∑</mo><mi>v</mi></munder><msub><mi>p</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mi>v</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>h</mi><mi>t</mi></msub><mo rspace="0.337em" stretchy="false">)</mo></mrow><mi>log</mi><msub><mi>p</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mi>v</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>h</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H_{t}\;=\;-\sum_{v}p_{\theta}(v\mid h_{t})\,\log p_{\theta}(v\mid h_{t}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(11)</span></td></tr></tbody>
</table>
<p id="A10.p1.2" class="ltx_p">For a window size <math id="A10.p1.m8" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> and threshold <math id="A10.p1.m9" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>, define window entropy and a high–entropy indicator</p>
<table id="A10.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E12.m1" class="ltx_math_unparsed" alttext="\bar{H}_{t:w}\;=\;\frac{1}{w}\sum_{\tau=t}^{t+w-1}H_{\tau},\qquad\mathbb{I}^{\mathrm{HE}}_{t}\;=\;\mathbb{I}\{\bar{H}_{t:w}\geq\theta\}," display="block" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>H</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>w</mi></mrow></msub><mo lspace="0.558em" rspace="0.558em">=</mo><mfrac><mn>1</mn><mi>w</mi></mfrac><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mi>t</mi></mrow><mrow><mrow><mi>t</mi><mo>+</mo><mi>w</mi></mrow><mo>−</mo><mn>1</mn></mrow></munderover><msub><mi>H</mi><mi>τ</mi></msub><mo rspace="2.167em">,</mo><msubsup><mi>𝕀</mi><mi>t</mi><mi>HE</mi></msubsup><mo rspace="0.558em">=</mo><mi>𝕀</mi><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi>H</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>w</mi></mrow></msub><mo>≥</mo><mi>θ</mi><mo stretchy="false">}</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\bar{H}_{t:w}\;=\;\frac{1}{w}\sum_{\tau=t}^{t+w-1}H_{\tau},\qquad\mathbb{I}^{\mathrm{HE}}_{t}\;=\;\mathbb{I}\{\bar{H}_{t:w}\geq\theta\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(12)</span></td></tr></tbody>
</table>
<p id="A10.p1.3" class="ltx_p">and let the (validated) high–entropy count be</p>
<table id="A10.E13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E13.m1" class="ltx_Math" alttext="N_{\mathrm{HE}}\;=\;\sum_{t=1}^{L}\mathbb{I}^{\mathrm{HE}}_{t}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>N</mi><mi>HE</mi></msub><mo lspace="0.558em" rspace="0.391em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></munderover><msubsup><mi>𝕀</mi><mi>t</mi><mi>HE</mi></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">N_{\mathrm{HE}}\;=\;\sum_{t=1}^{L}\mathbb{I}^{\mathrm{HE}}_{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(13)</span></td></tr></tbody>
</table>
<p id="A10.p1.4" class="ltx_p">Our goal is to relate <math id="A10.p1.m10" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> to <math id="A10.p1.m11" class="ltx_Math" alttext="N_{\mathrm{HE}}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>HE</mi></msub><annotation encoding="application/x-tex">N_{\mathrm{HE}}</annotation></semantics></math> (or the total high–entropy residence time).</p>
</div>
<section id="A10.SS0.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">A two–state latent process.</h5>

<div id="A10.SS0.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A10.SS0.SSS0.Px1.p1.1" class="ltx_p">Assume an interpretable latent state <math id="A10.SS0.SSS0.Px1.p1.m1" class="ltx_Math" alttext="S_{t}\in\{\mathsf{R},\mathsf{V}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>t</mi></msub><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mi>𝖱</mi><mo>,</mo><mi>𝖵</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">S_{t}\in\{\mathsf{R},\mathsf{V}\}</annotation></semantics></math> with:
(i) <em id="A10.SS0.SSS0.Px1.p1.1.1" class="ltx_emph ltx_font_italic">Reasoning</em> (<math id="A10.SS0.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\mathsf{R}" display="inline" intent=":literal"><semantics><mi>𝖱</mi><annotation encoding="application/x-tex">\mathsf{R}</annotation></semantics></math>): exploratory/high–entropy;
(ii) <em id="A10.SS0.SSS0.Px1.p1.1.2" class="ltx_emph ltx_font_italic">Verbatim</em> (<math id="A10.SS0.SSS0.Px1.p1.m3" class="ltx_Math" alttext="\mathsf{V}" display="inline" intent=":literal"><semantics><mi>𝖵</mi><annotation encoding="application/x-tex">\mathsf{V}</annotation></semantics></math>): declarative/low–entropy.
There exist constants <math id="A10.SS0.SSS0.Px1.p1.m4" class="ltx_Math" alttext="H_{\mathsf{R}}&gt;H_{\mathsf{V}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>𝖱</mi></msub><mo>&gt;</mo><msub><mi>H</mi><mi>𝖵</mi></msub></mrow><annotation encoding="application/x-tex">H_{\mathsf{R}}&gt;H_{\mathsf{V}}</annotation></semantics></math> and a threshold <math id="A10.SS0.SSS0.Px1.p1.m5" class="ltx_Math" alttext="\theta\in(H_{\mathsf{V}},H_{\mathsf{R}})" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mi>𝖵</mi></msub><mo>,</mo><msub><mi>H</mi><mi>𝖱</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\theta\in(H_{\mathsf{V}},H_{\mathsf{R}})</annotation></semantics></math> such that the detector has bounded error</p>
<table id="A10.E14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E14.m1" class="ltx_Math" alttext="\Pr(\mathbb{I}^{\mathrm{HE}}_{t}=1\mid S_{t}=\mathsf{R})\geq 1-\alpha,\qquad\Pr(\mathbb{I}^{\mathrm{HE}}_{t}=0\mid S_{t}=\mathsf{V})\geq 1-\beta," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝕀</mi><mi>t</mi><mi>HE</mi></msubsup><mo>=</mo><mn>1</mn></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>S</mi><mi>t</mi></msub><mo>=</mo><mi>𝖱</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝕀</mi><mi>t</mi><mi>HE</mi></msubsup><mo>=</mo><mn>0</mn></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>S</mi><mi>t</mi></msub><mo>=</mo><mi>𝖵</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\Pr(\mathbb{I}^{\mathrm{HE}}_{t}=1\mid S_{t}=\mathsf{R})\geq 1-\alpha,\qquad\Pr(\mathbb{I}^{\mathrm{HE}}_{t}=0\mid S_{t}=\mathsf{V})\geq 1-\beta,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14)</span></td></tr></tbody>
</table>
<p id="A10.SS0.SSS0.Px1.p1.2" class="ltx_p">with <math id="A10.SS0.SSS0.Px1.p1.m6" class="ltx_Math" alttext="\alpha,\beta\in[0,1)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo>,</mo><mi>β</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha,\beta\in[0,1)</annotation></semantics></math>. Let the <math id="A10.SS0.SSS0.Px1.p1.m7" class="ltx_Math" alttext="\mathsf{R}\!\to\!\mathsf{V}" display="inline" intent=":literal"><semantics><mrow><mi>𝖱</mi><mo lspace="0.108em" rspace="0.108em" stretchy="false">→</mo><mi>𝖵</mi></mrow><annotation encoding="application/x-tex">\mathsf{R}\!\to\!\mathsf{V}</annotation></semantics></math> transition probability be <math id="A10.SS0.SSS0.Px1.p1.m8" class="ltx_Math" alttext="q\in(0,1]" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">q\in(0,1]</annotation></semantics></math>, and let the answer–emitting hazard in <math id="A10.SS0.SSS0.Px1.p1.m9" class="ltx_Math" alttext="\mathsf{V}" display="inline" intent=":literal"><semantics><mi>𝖵</mi><annotation encoding="application/x-tex">\mathsf{V}</annotation></semantics></math> be <math id="A10.SS0.SSS0.Px1.p1.m10" class="ltx_Math" alttext="h\in(0,1]" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">h\in(0,1]</annotation></semantics></math> (stopping can only occur in <math id="A10.SS0.SSS0.Px1.p1.m11" class="ltx_Math" alttext="\mathsf{V}" display="inline" intent=":literal"><semantics><mi>𝖵</mi><annotation encoding="application/x-tex">\mathsf{V}</annotation></semantics></math>).</p>
</div>
</section>
<section id="A10.SS0.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Theorem 1 (Linear relation with reasoning residence).</h5>

<div id="A10.SS0.SSS0.Px2.p1" class="ltx_para ltx_noindent">
<p id="A10.SS0.SSS0.Px2.p1.1" class="ltx_p">Let <math id="A10.SS0.SSS0.Px2.p1.m1" class="ltx_math_unparsed" alttext="T_{\mathsf{R}}=\sum_{t=1}^{\tau}\mathbb{I}\{S_{t}=\mathsf{R}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>𝖱</mi></msub><mo rspace="0.111em">=</mo><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>τ</mi></msubsup><mi>𝕀</mi><mrow><mo stretchy="false">{</mo><msub><mi>S</mi><mi>t</mi></msub><mo>=</mo><mi>𝖱</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">T_{\mathsf{R}}=\sum_{t=1}^{\tau}\mathbb{I}\{S_{t}=\mathsf{R}\}</annotation></semantics></math> be the total time spent in the reasoning state. Then there exist <math id="A10.SS0.SSS0.Px2.p1.m2" class="ltx_Math" alttext="a,b&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a,b&gt;0</annotation></semantics></math> such that</p>
<table id="A10.E15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E15.m1" class="ltx_Math" alttext="\mathbb{E}[L]\;=\;a\;+\;b\,\mathbb{E}[T_{\mathsf{R}}]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo rspace="0.280em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.558em">=</mo><mrow><mi>a</mi><mo lspace="0.502em" rspace="0.502em">+</mo><mrow><mi>b</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>T</mi><mi>𝖱</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[L]\;=\;a\;+\;b\,\mathbb{E}[T_{\mathsf{R}}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15)</span></td></tr></tbody>
</table>
<p id="A10.SS0.SSS0.Px2.p1.2" class="ltx_p">Moreover, under equation <a href="#A10.E14" title="In A two–state latent process. ‣ Appendix J Why High–Entropy Tokens Predict Reasoning Response Length ‣ ARES: Multimodal Adaptive Reasoning via Difficulty-Aware Token-Level Entropy Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a> there exist constants <math id="A10.SS0.SSS0.Px2.p1.m3" class="ltx_Math" alttext="c_{1},c_{2}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>c</mi><mn>2</mn></msub><mo>&gt;</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">c_{1},c_{2}&gt;0</annotation></semantics></math> for which</p>
<table id="A10.E16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E16.m1" class="ltx_Math" alttext="c_{1}\,\mathbb{E}[N_{\mathrm{HE}}]\;\leq\;\mathbb{E}[T_{\mathsf{R}}]\;\leq\;c_{2}\,\mathbb{E}[N_{\mathrm{HE}}]," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>N</mi><mi>HE</mi></msub><mo rspace="0.280em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.558em">≤</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>T</mi><mi>𝖱</mi></msub><mo rspace="0.280em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.558em">≤</mo><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>N</mi><mi>HE</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">c_{1}\,\mathbb{E}[N_{\mathrm{HE}}]\;\leq\;\mathbb{E}[T_{\mathsf{R}}]\;\leq\;c_{2}\,\mathbb{E}[N_{\mathrm{HE}}],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
<p id="A10.SS0.SSS0.Px2.p1.3" class="ltx_p">hence</p>
<table id="A10.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E17.m1" class="ltx_Math" alttext="\boxed{\ \mathbb{E}[L]\;=\;a^{\prime}\;+\;b^{\prime}\,\mathbb{E}[N_{\mathrm{HE}}]\ }\quad\text{for some }a^{\prime},b^{\prime}&gt;0." display="block" intent=":literal"><semantics><mrow><mrow><menclose notation="box"><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo rspace="0.280em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.558em">=</mo><mrow><msup><mi>a</mi><mo>′</mo></msup><mo rspace="0.502em">+</mo><mrow><msup><mi>b</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>N</mi><mi>HE</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></menclose><mspace style="width:1em;" width="1em"></mspace><mrow><mtext>for some </mtext><mo lspace="0em" rspace="0em">​</mo><msup><mi>a</mi><mo>′</mo></msup></mrow><mo>,</mo><mrow><msup><mi>b</mi><mo>′</mo></msup><mo>&gt;</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\boxed{\ \mathbb{E}[L]\;=\;a^{\prime}\;+\;b^{\prime}\,\mathbb{E}[N_{\mathrm{HE}}]\ }\quad\text{for some }a^{\prime},b^{\prime}&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
</table>
</div>
<div id="A10.SS0.SSS0.Px2.p2" class="ltx_para ltx_noindent">
<p id="A10.SS0.SSS0.Px2.p2.1" class="ltx_p"><em id="A10.SS0.SSS0.Px2.p2.1.1" class="ltx_emph ltx_font_italic">Proof sketch.</em>
Within <math id="A10.SS0.SSS0.Px2.p2.m1" class="ltx_Math" alttext="\mathsf{R}" display="inline" intent=":literal"><semantics><mi>𝖱</mi><annotation encoding="application/x-tex">\mathsf{R}</annotation></semantics></math>, the process cannot stop; each reasoning excursion has geometric length with mean <math id="A10.SS0.SSS0.Px2.p2.m2" class="ltx_Math" alttext="1/q" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">1/q</annotation></semantics></math>.
Within <math id="A10.SS0.SSS0.Px2.p2.m3" class="ltx_Math" alttext="\mathsf{V}" display="inline" intent=":literal"><semantics><mi>𝖵</mi><annotation encoding="application/x-tex">\mathsf{V}</annotation></semantics></math>, the segment ends with geometric stopping hazard <math id="A10.SS0.SSS0.Px2.p2.m4" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> (mean <math id="A10.SS0.SSS0.Px2.p2.m5" class="ltx_Math" alttext="1/h" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mi>h</mi></mrow><annotation encoding="application/x-tex">1/h</annotation></semantics></math>).
The total length is a renewal sum of i.i.d. excursions plus a terminal <math id="A10.SS0.SSS0.Px2.p2.m6" class="ltx_Math" alttext="\mathsf{V}" display="inline" intent=":literal"><semantics><mi>𝖵</mi><annotation encoding="application/x-tex">\mathsf{V}</annotation></semantics></math> segment, yielding equation <a href="#A10.E15" title="In Theorem 1 (Linear relation with reasoning residence). ‣ Appendix J Why High–Entropy Tokens Predict Reasoning Response Length ‣ ARES: Multimodal Adaptive Reasoning via Difficulty-Aware Token-Level Entropy Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>.
Bounded detector errors map <math id="A10.SS0.SSS0.Px2.p2.m7" class="ltx_Math" alttext="T_{\mathsf{R}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>𝖱</mi></msub><annotation encoding="application/x-tex">T_{\mathsf{R}}</annotation></semantics></math> to <math id="A10.SS0.SSS0.Px2.p2.m8" class="ltx_Math" alttext="N_{\mathrm{HE}}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>HE</mi></msub><annotation encoding="application/x-tex">N_{\mathrm{HE}}</annotation></semantics></math>, proving equation <a href="#A10.E17" title="In Theorem 1 (Linear relation with reasoning residence). ‣ Appendix J Why High–Entropy Tokens Predict Reasoning Response Length ‣ ARES: Multimodal Adaptive Reasoning via Difficulty-Aware Token-Level Entropy Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>.
 <math id="A10.SS0.SSS0.Px2.p2.m9" class="ltx_Math" alttext="\square" display="inline" intent=":literal"><semantics><mi mathvariant="normal">□</mi><annotation encoding="application/x-tex">\square</annotation></semantics></math></p>
</div>
</section>
<section id="A10.SS0.SSS0.Px3" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">A stopping–time view via entropy–dependent hazard.</h5>

<div id="A10.SS0.SSS0.Px3.p1" class="ltx_para ltx_noindent">
<p id="A10.SS0.SSS0.Px3.p1.1" class="ltx_p">Assume the probability of emitting the final answer at step <math id="A10.SS0.SSS0.Px3.p1.m1" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> is a non–increasing function of entropy,</p>
<table id="A10.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E18.m1" class="ltx_Math" alttext="\Pr(\text{stop at }t\mid h_{t})\;=\;\lambda(H_{t}),\qquad\lambda^{\prime}(H)\leq 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>stop at </mtext><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>h</mi><mi>t</mi></msub><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">=</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><msup><mi>λ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Pr(\text{stop at }t\mid h_{t})\;=\;\lambda(H_{t}),\qquad\lambda^{\prime}(H)\leq 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
<p id="A10.SS0.SSS0.Px3.p1.2" class="ltx_p">Then larger entropy sequences stochastically dominate the stopping time.</p>
</div>
</section>
<section id="A10.SS0.SSS0.Px4" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Theorem 2 (High entropy delays stopping).</h5>

<div id="A10.SS0.SSS0.Px4.p1" class="ltx_para ltx_noindent">
<p id="A10.SS0.SSS0.Px4.p1.1" class="ltx_p">For two trajectories with entropy paths <math id="A10.SS0.SSS0.Px4.p1.m1" class="ltx_Math" alttext="\{H^{(1)}_{t}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msubsup><mi>H</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{H^{(1)}_{t}\}</annotation></semantics></math> and <math id="A10.SS0.SSS0.Px4.p1.m2" class="ltx_Math" alttext="\{H^{(2)}_{t}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msubsup><mi>H</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{H^{(2)}_{t}\}</annotation></semantics></math> such that <math id="A10.SS0.SSS0.Px4.p1.m3" class="ltx_Math" alttext="H^{(1)}_{t}\leq H^{(2)}_{t}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>H</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>≤</mo><msubsup><mi>H</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">H^{(1)}_{t}\leq H^{(2)}_{t}</annotation></semantics></math> for all <math id="A10.SS0.SSS0.Px4.p1.m4" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, one has <math id="A10.SS0.SSS0.Px4.p1.m5" class="ltx_Math" alttext="\mathbb{E}[L^{(1)}]\leq\mathbb{E}[L^{(2)}]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>L</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>L</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[L^{(1)}]\leq\mathbb{E}[L^{(2)}]</annotation></semantics></math>.
Moreover, for any threshold <math id="A10.SS0.SSS0.Px4.p1.m6" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>,</p>
<table id="A10.E19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E19.m1" class="ltx_Math" alttext="\mathbb{E}[L]\;\geq\;\mathbb{E}\!\left[\sum_{t=1}^{\tau}\frac{\mathbb{I}\{H_{t}\geq\theta\}}{\lambda(\theta)}\right]\;\geq\;\frac{1}{\lambda(\theta)}\,\mathbb{E}[N_{\mathrm{HE}}]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo rspace="0.280em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.558em">≥</mo><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>τ</mi></munderover><mfrac><mrow><mi>𝕀</mi><mo stretchy="false">{</mo><mi>H</mi><msub><mrow></mrow><mi>t</mi></msub><mo>≥</mo><mi>θ</mi><mo stretchy="false">}</mo></mrow><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo rspace="0.280em">]</mo></mrow></mrow><mo rspace="0.558em">≥</mo><mrow><mfrac><mn>1</mn><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>N</mi><mi>HE</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[L]\;\geq\;\mathbb{E}\!\left[\sum_{t=1}^{\tau}\frac{\mathbb{I}\{H_{t}\geq\theta\}}{\lambda(\theta)}\right]\;\geq\;\frac{1}{\lambda(\theta)}\,\mathbb{E}[N_{\mathrm{HE}}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
</table>
</div>
<div id="A10.SS0.SSS0.Px4.p2" class="ltx_para ltx_noindent">
<p id="A10.SS0.SSS0.Px4.p2.1" class="ltx_p"><em id="A10.SS0.SSS0.Px4.p2.1.1" class="ltx_emph ltx_font_italic">Proof sketch.</em>
By stochastic ordering under equation <a href="#A10.E18" title="In A stopping–time view via entropy–dependent hazard. ‣ Appendix J Why High–Entropy Tokens Predict Reasoning Response Length ‣ ARES: Multimodal Adaptive Reasoning via Difficulty-Aware Token-Level Entropy Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>, higher entropy lowers the instantaneous hazard and yields larger stopping times in the convex order, implying the expectation inequality.
Since <math id="A10.SS0.SSS0.Px4.p2.m1" class="ltx_Math" alttext="\lambda(H)\leq\lambda(\theta)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda(H)\leq\lambda(\theta)</annotation></semantics></math> whenever <math id="A10.SS0.SSS0.Px4.p2.m2" class="ltx_Math" alttext="H\geq\theta" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>≥</mo><mi>θ</mi></mrow><annotation encoding="application/x-tex">H\geq\theta</annotation></semantics></math>, each high–entropy step contributes at least <math id="A10.SS0.SSS0.Px4.p2.m3" class="ltx_Math" alttext="1/\lambda(\theta)" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1/\lambda(\theta)</annotation></semantics></math> units in expectation; summing gives equation <a href="#A10.E19" title="In Theorem 2 (High entropy delays stopping). ‣ Appendix J Why High–Entropy Tokens Predict Reasoning Response Length ‣ ARES: Multimodal Adaptive Reasoning via Difficulty-Aware Token-Level Entropy Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>.
 <math id="A10.SS0.SSS0.Px4.p2.m4" class="ltx_Math" alttext="\square" display="inline" intent=":literal"><semantics><mi mathvariant="normal">□</mi><annotation encoding="application/x-tex">\square</annotation></semantics></math></p>
</div>
</section>
<section id="A10.SS0.SSS0.Px5" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Information–theoretic lower bound.</h5>

<div id="A10.SS0.SSS0.Px5.p1" class="ltx_para ltx_noindent">
<p id="A10.SS0.SSS0.Px5.p1.1" class="ltx_p">Suppose answering with error <math id="A10.SS0.SSS0.Px5.p1.m1" class="ltx_Math" alttext="\varepsilon" display="inline" intent=":literal"><semantics><mi>ε</mi><annotation encoding="application/x-tex">\varepsilon</annotation></semantics></math> over a label set of size <math id="A10.SS0.SSS0.Px5.p1.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> requires mutual information</p>
<table id="A10.E20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E20.m1" class="ltx_Math" alttext="I^{\dagger}\;\triangleq\;\log M-h_{2}(\varepsilon)-\varepsilon\log(M-1)" display="block" intent=":literal"><semantics><mrow><msup><mi>I</mi><mo>†</mo></msup><mo lspace="0.558em" rspace="0.558em">≜</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>M</mi></mrow><mo>−</mo><mrow><msub><mi>h</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ε</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">I^{\dagger}\;\triangleq\;\log M-h_{2}(\varepsilon)-\varepsilon\log(M-1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
<p id="A10.SS0.SSS0.Px5.p1.2" class="ltx_p">an
(by Fano’s inequality).
Let <math id="A10.SS0.SSS0.Px5.p1.m3" class="ltx_Math" alttext="i_{t}\equiv I(A;o_{t}\mid h_{t-1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>i</mi><mi>t</mi></msub><mo>≡</mo><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo>;</mo><msub><mi>o</mi><mi>t</mi></msub></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>h</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">i_{t}\equiv I(A;o_{t}\mid h_{t-1})</annotation></semantics></math> be per–step information about the (correct) answer <math id="A10.SS0.SSS0.Px5.p1.m4" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>.
By data processing, <math id="A10.SS0.SSS0.Px5.p1.m5" class="ltx_Math" alttext="i_{t}\leq H_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>i</mi><mi>t</mi></msub><mo>≤</mo><msub><mi>H</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">i_{t}\leq H_{t}</annotation></semantics></math>.
Empirically, non–reasoning steps convey negligible information: there exists <math id="A10.SS0.SSS0.Px5.p1.m6" class="ltx_Math" alttext="\eta\ll 1" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>≪</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\eta\ll 1</annotation></semantics></math> such that <math id="A10.SS0.SSS0.Px5.p1.m7" class="ltx_Math" alttext="i_{t}\leq\eta" display="inline" intent=":literal"><semantics><mrow><msub><mi>i</mi><mi>t</mi></msub><mo>≤</mo><mi>η</mi></mrow><annotation encoding="application/x-tex">i_{t}\leq\eta</annotation></semantics></math> when <math id="A10.SS0.SSS0.Px5.p1.m8" class="ltx_Math" alttext="H_{t}&lt;\theta" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>t</mi></msub><mo>&lt;</mo><mi>θ</mi></mrow><annotation encoding="application/x-tex">H_{t}&lt;\theta</annotation></semantics></math>.
Let <math id="A10.SS0.SSS0.Px5.p1.m9" class="ltx_Math" alttext="\iota_{\theta}\equiv\max_{H\geq\theta}i(H)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ι</mi><mi>θ</mi></msub><mo>≡</mo><mrow><msub><mi>max</mi><mrow><mi>H</mi><mo>≥</mo><mi>θ</mi></mrow></msub><mo lspace="0.167em">⁡</mo><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\iota_{\theta}\equiv\max_{H\geq\theta}i(H)</annotation></semantics></math>.
Then</p>
<table id="A10.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E21.m1" class="ltx_Math" alttext="I^{\dagger}\;\leq\;\sum_{t=1}^{\tau}i_{t}\;\leq\;\eta\,(L-N_{\mathrm{HE}})\;+\;\iota_{\theta}\,N_{\mathrm{HE}}\;\Rightarrow\;N_{\mathrm{HE}}\;\geq\;\frac{I^{\dagger}-\eta\,\mathbb{E}[L]}{\iota_{\theta}-\eta}," display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>I</mi><mo>†</mo></msup><mo lspace="0.558em" rspace="0.391em">≤</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>τ</mi></munderover><msub><mi>i</mi><mi>t</mi></msub></mrow><mo rspace="0.558em">≤</mo><mrow><mrow><mi>η</mi><mo lspace="0.170em">⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><msub><mi>N</mi><mi>HE</mi></msub></mrow><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.502em">+</mo><mrow><msub><mi>ι</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mi>HE</mi></msub></mrow></mrow><mo rspace="0.558em" stretchy="false">⇒</mo><msub><mi>N</mi><mi>HE</mi></msub><mo rspace="0.558em">≥</mo><mfrac><mrow><msup><mi>I</mi><mo>†</mo></msup><mo>−</mo><mrow><mi>η</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mrow><msub><mi>ι</mi><mi>θ</mi></msub><mo>−</mo><mi>η</mi></mrow></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">I^{\dagger}\;\leq\;\sum_{t=1}^{\tau}i_{t}\;\leq\;\eta\,(L-N_{\mathrm{HE}})\;+\;\iota_{\theta}\,N_{\mathrm{HE}}\;\Rightarrow\;N_{\mathrm{HE}}\;\geq\;\frac{I^{\dagger}-\eta\,\mathbb{E}[L]}{\iota_{\theta}-\eta},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
<p id="A10.SS0.SSS0.Px5.p1.3" class="ltx_p">which rearranges to a linear lower bound of <math id="A10.SS0.SSS0.Px5.p1.m10" class="ltx_Math" alttext="\mathbb{E}[L]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[L]</annotation></semantics></math> in terms of <math id="A10.SS0.SSS0.Px5.p1.m11" class="ltx_Math" alttext="\mathbb{E}[N_{\mathrm{HE}}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>N</mi><mi>HE</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[N_{\mathrm{HE}}]</annotation></semantics></math>.</p>
</div>
</section>
<section id="A10.SS0.SSS0.Px6" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Synthesis and testable predictions.</h5>

<div id="A10.SS0.SSS0.Px6.p1" class="ltx_para ltx_noindent">
<p id="A10.SS0.SSS0.Px6.p1.1" class="ltx_p">The renewal argument (Theorem 1), the hazard view (Theorem 2), and the information budget bound jointly imply a <em id="A10.SS0.SSS0.Px6.p1.1.1" class="ltx_emph ltx_font_italic">stable, monotone, near–linear</em> relationship between reasoning length and high–entropy activity:</p>
<table id="A10.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E22.m1" class="ltx_Math" alttext="\mathbb{E}[L]\;\approx\;\alpha\;+\;\beta\,\mathbb{E}[N_{\mathrm{HE}}],\qquad\beta&gt;0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo rspace="0.280em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.558em">≈</mo><mrow><mi>α</mi><mo lspace="0.502em" rspace="0.502em">+</mo><mrow><mi>β</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>N</mi><mi>HE</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>β</mi><mo>&gt;</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[L]\;\approx\;\alpha\;+\;\beta\,\mathbb{E}[N_{\mathrm{HE}}],\qquad\beta&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
</table>
<p id="A10.SS0.SSS0.Px6.p1.2" class="ltx_p">This yields concrete diagnostics: (i) <math id="A10.SS0.SSS0.Px6.p1.m1" class="ltx_Math" alttext="\mathbb{E}[L\mid N_{\mathrm{HE}}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>N</mi><mi>HE</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[L\mid N_{\mathrm{HE}}]</annotation></semantics></math> is monotone increasing; (ii) the slope <math id="A10.SS0.SSS0.Px6.p1.m2" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> correlates with the mean reasoning–excursion duration <math id="A10.SS0.SSS0.Px6.p1.m3" class="ltx_Math" alttext="1/q" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">1/q</annotation></semantics></math>; (iii) the estimated stopping hazard <math id="A10.SS0.SSS0.Px6.p1.m4" class="ltx_Math" alttext="\hat{\lambda}(H)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{\lambda}(H)</annotation></semantics></math> is decreasing; and (iv) the per–step mutual information <math id="A10.SS0.SSS0.Px6.p1.m5" class="ltx_Math" alttext="i_{t}" display="inline" intent=":literal"><semantics><msub><mi>i</mi><mi>t</mi></msub><annotation encoding="application/x-tex">i_{t}</annotation></semantics></math> concentrates within high–entropy windows. As shown in Figure <a href="#S2.F3" title="Figure 3 ‣ 2 Relations Between Token Entropy and Reasoning Difficulty ‣ ARES: Multimodal Adaptive Reasoning via Difficulty-Aware Token-Level Entropy Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, the number of high-entropy tokens grows approximately in tandem with response length
and accuracy, validating entropy as a principled proxy for reasoning
effort. Yet, this relationship is not uniform across all problems: as we
show next, the way entropy and reasoning length contribute to accuracy
differs substantially between easy and hard instances.</p>
</div>
</section>
</section>
<section id="A11" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix K </span>Why KL Loss is a Valid <em id="A11.2" class="ltx_emph ltx_font_italic">Thinking Budget</em></h2>

<div id="A11.p1" class="ltx_para ltx_noindent">
<p id="A11.p1.1" class="ltx_p">We show that the KL loss used in AEPO is mathematically equivalent to enforcing
a <em id="A11.p1.1.1" class="ltx_emph ltx_font_italic">budget</em> on the policy’s deviation from the reference model, and that such
a budget provably controls the expected “thinking” cost
(e.g., reasoning length <math id="A11.p1.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> or entropy-based cost <math id="A11.p1.m2" class="ltx_Math" alttext="C_{\text{ent}}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mtext>ent</mtext></msub><annotation encoding="application/x-tex">C_{\text{ent}}</annotation></semantics></math>).</p>
</div>
<div id="A11.p2" class="ltx_para ltx_noindent">
<p id="A11.p2.1" class="ltx_p">For a prompt <math id="A11.p2.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, let <math id="A11.p2.m2" class="ltx_math_unparsed" alttext="\pi_{\theta}(\cdot\mid x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{\theta}(\cdot\mid x)</annotation></semantics></math> be the policy over full responses
<math id="A11.p2.m3" class="ltx_Math" alttext="o\in\mathcal{Y}" display="inline" intent=":literal"><semantics><mrow><mi>o</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></mrow><annotation encoding="application/x-tex">o\in\mathcal{Y}</annotation></semantics></math>, <math id="A11.p2.m4" class="ltx_math_unparsed" alttext="\pi_{\mathrm{ref}}(\cdot\mid x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>ref</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{\mathrm{ref}}(\cdot\mid x)</annotation></semantics></math> the frozen reference, and
<math id="A11.p2.m5" class="ltx_Math" alttext="r(x,o)" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>o</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r(x,o)</annotation></semantics></math> a task reward.
Let <math id="A11.p2.m6" class="ltx_Math" alttext="c(x,o)\!\geq\!0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>o</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.108em">≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c(x,o)\!\geq\!0</annotation></semantics></math> be a <em id="A11.p2.1.1" class="ltx_emph ltx_font_italic">thinking cost</em> (e.g., response length, or high-entropy
window cost), and define the shaped reward
<math id="A11.p2.m7" class="ltx_Math" alttext="\tilde{r}(x,o)=r(x,o)-\lambda\,c(x,o)" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>r</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>o</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>o</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>λ</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>o</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{r}(x,o)=r(x,o)-\lambda\,c(x,o)</annotation></semantics></math> with <math id="A11.p2.m8" class="ltx_Math" alttext="\lambda\!\geq\!0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo lspace="0.108em">≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda\!\geq\!0</annotation></semantics></math>.
Denote the (pathwise) KL divergence
<math id="A11.p2.m9" class="ltx_math_unparsed" alttext="D_{\mathrm{KL}}\big(\pi_{\theta}(\cdot\mid x)\,\|\,\pi_{\mathrm{ref}}(\cdot\mid x)\big)" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>π</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0.337em">∥</mo><msub><mi>π</mi><mi>ref</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">D_{\mathrm{KL}}\big(\pi_{\theta}(\cdot\mid x)\,\|\,\pi_{\mathrm{ref}}(\cdot\mid x)\big)</annotation></semantics></math>.</p>
</div>
<div id="A11.p3" class="ltx_para ltx_noindent">
<p id="A11.p3.1" class="ltx_p"><span id="A11.p3.1.1" class="ltx_text ltx_font_bold">Constrained formulation.</span>
We pose the <em id="A11.p3.1.2" class="ltx_emph ltx_font_italic">budgeted</em> policy optimization:</p>
<table id="A11.E23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A11.E23.m1" class="ltx_math_unparsed" alttext="\max_{\pi_{\theta}}\;\;\mathbb{E}_{x\sim\mathcal{D}}\Big[\mathbb{E}_{o\sim\pi_{\theta}(\cdot\mid x)}[\tilde{r}(x,o)]\Big]\quad\text{s.t.}\quad\mathbb{E}_{x\sim\mathcal{D}}\Big[D_{\mathrm{KL}}\!\big(\pi_{\theta}(\cdot\mid x)\,\|\,\pi_{\mathrm{ref}}(\cdot\mid x)\big)\Big]\;\leq\;\delta," display="block" intent=":literal"><semantics><mrow><munder><mi>max</mi><msub><mi>π</mi><mi>θ</mi></msub></munder><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><msub><mi>𝔼</mi><mrow><mi>o</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>r</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>o</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mtext>s.t.</mtext><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>π</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0.337em">∥</mo><msub><mi>π</mi><mi>ref</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.280em">]</mo></mrow><mo rspace="0.558em">≤</mo><mi>δ</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">\max_{\pi_{\theta}}\;\;\mathbb{E}_{x\sim\mathcal{D}}\Big[\mathbb{E}_{o\sim\pi_{\theta}(\cdot\mid x)}[\tilde{r}(x,o)]\Big]\quad\text{s.t.}\quad\mathbb{E}_{x\sim\mathcal{D}}\Big[D_{\mathrm{KL}}\!\big(\pi_{\theta}(\cdot\mid x)\,\|\,\pi_{\mathrm{ref}}(\cdot\mid x)\big)\Big]\;\leq\;\delta,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
</table>
<p id="A11.p3.2" class="ltx_p">where <math id="A11.p3.m1" class="ltx_Math" alttext="\delta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta&gt;0</annotation></semantics></math> is the <em id="A11.p3.2.1" class="ltx_emph ltx_font_italic">thinking budget</em>. The feasible set is convex because
<math id="A11.p3.m2" class="ltx_math_unparsed" alttext="D_{\mathrm{KL}}(\cdot\|\pi_{\mathrm{ref}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>π</mi><mi>ref</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D_{\mathrm{KL}}(\cdot\|\pi_{\mathrm{ref}})</annotation></semantics></math> is convex in its first argument.</p>
</div>
<div id="Thmlemma2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma2.2" class="ltx_text ltx_font_bold">Lemma 2</span></span><span id="Thmlemma2.3" class="ltx_text ltx_font_bold"> </span>(Strong duality and KL-as-budget)<span id="Thmlemma2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma2.p1" class="ltx_para ltx_noindent">
<p id="Thmlemma2.p1.1" class="ltx_p"><span id="Thmlemma2.p1.1.1" class="ltx_text ltx_font_italic">Problem equation <a href="#A11.E23" title="In Appendix K Why KL Loss is a Valid Thinking Budget ‣ ARES: Multimodal Adaptive Reasoning via Difficulty-Aware Token-Level Entropy Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a> admits strong duality. Its Lagrangian is</span></p>
<table id="A11.E24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A11.E24.m1" class="ltx_math_unparsed" alttext="\mathcal{L}(\pi,\kappa)=\mathbb{E}_{x}\,\mathbb{E}_{o\sim\pi(\cdot\mid x)}[\tilde{r}(x,o)]\;-\;\kappa\,\mathbb{E}_{x}\Big[D_{\mathrm{KL}}\!\big(\pi(\cdot\mid x)\,\|\,\pi_{\mathrm{ref}}(\cdot\mid x)\big)-\delta\Big],\qquad\kappa\geq 0," display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><mi>π</mi><mo>,</mo><mi>κ</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><mi>x</mi></msub><msub><mi>𝔼</mi><mrow><mi>o</mi><mo>∼</mo><mi>π</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>r</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>o</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.280em" stretchy="false">]</mo></mrow><mo rspace="0.502em">−</mo><mi>κ</mi><msub><mi>𝔼</mi><mi>x</mi></msub><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>π</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0.337em">∥</mo><msub><mi>π</mi><mi>ref</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>−</mo><mi>δ</mi><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mo rspace="2.167em">,</mo><mi>κ</mi><mo>≥</mo><mn>0</mn><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}(\pi,\kappa)=\mathbb{E}_{x}\,\mathbb{E}_{o\sim\pi(\cdot\mid x)}[\tilde{r}(x,o)]\;-\;\kappa\,\mathbb{E}_{x}\Big[D_{\mathrm{KL}}\!\big(\pi(\cdot\mid x)\,\|\,\pi_{\mathrm{ref}}(\cdot\mid x)\big)-\delta\Big],\qquad\kappa\geq 0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
<p id="Thmlemma2.p1.2" class="ltx_p"><span id="Thmlemma2.p1.2.1" class="ltx_text ltx_font_italic">and the optimal policy for fixed <math id="Thmlemma2.p1.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> has the exponential-tilt form</span></p>
<table id="A11.E25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A11.E25.m1" class="ltx_Math" alttext="\pi^{*}(o\mid x)\;\propto\;\pi_{\mathrm{ref}}(o\mid x)\;\exp\!\Big(\tfrac{1}{\kappa}\,\tilde{r}(x,o)\Big)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>π</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">∝</mo><mrow><msub><mi>π</mi><mi>ref</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.447em" rspace="0em">​</mo><mrow><mpadded style="width:1.370em;" width="1.370em"><mi>exp</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mi>κ</mi></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><mover accent="true"><mi>r</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>o</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\pi^{*}(o\mid x)\;\propto\;\pi_{\mathrm{ref}}(o\mid x)\;\exp\!\Big(\tfrac{1}{\kappa}\,\tilde{r}(x,o)\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
<p id="Thmlemma2.p1.3" class="ltx_p"><span id="Thmlemma2.p1.3.1" class="ltx_text ltx_font_italic">Moreover, at the dual optimum <math id="Thmlemma2.p1.m2" class="ltx_Math" alttext="\kappa^{*}" display="inline" intent=":literal"><semantics><msup><mi>κ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\kappa^{*}</annotation></semantics></math> the budget is <em id="Thmlemma2.p1.3.1.1" class="ltx_emph ltx_font_upright">active</em> unless
<math id="Thmlemma2.p1.m3" class="ltx_Math" alttext="\kappa^{*}" display="inline" intent=":literal"><semantics><msup><mi>κ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\kappa^{*}</annotation></semantics></math> hits its boundary:
<math id="Thmlemma2.p1.m4" class="ltx_math_unparsed" alttext="\mathbb{E}_{x}D_{\mathrm{KL}}\!\big(\pi^{*}(\cdot\mid x)\,\|\,\pi_{\mathrm{ref}}(\cdot\mid x)\big)=\delta" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi>x</mi></msub><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msup><mi>π</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0.337em">∥</mo><msub><mi>π</mi><mi>ref</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>=</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">\mathbb{E}_{x}D_{\mathrm{KL}}\!\big(\pi^{*}(\cdot\mid x)\,\|\,\pi_{\mathrm{ref}}(\cdot\mid x)\big)=\delta</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A11.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A11.p4" class="ltx_para">
<p id="A11.p4.1" class="ltx_p"><span id="A11.p4.1.1" class="ltx_text">The objective is linear in <math id="A11.p4.m1" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> and the constraint set is convex with nonempty
interior (Slater’s condition holds by taking <math id="A11.p4.m2" class="ltx_Math" alttext="\pi=\pi_{\mathrm{ref}}" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>=</mo><msub><mi>π</mi><mi>ref</mi></msub></mrow><annotation encoding="application/x-tex">\pi=\pi_{\mathrm{ref}}</annotation></semantics></math>).
Thus strong duality holds. Optimizing <math id="A11.p4.m3" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math> over <math id="A11.p4.m4" class="ltx_math_unparsed" alttext="\pi(\cdot\mid x)" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi(\cdot\mid x)</annotation></semantics></math>
under the simplex constraint yields equation <a href="#A11.E25" title="In Lemma 2 (Strong duality and KL-as-budget). ‣ Appendix K Why KL Loss is a Valid Thinking Budget ‣ ARES: Multimodal Adaptive Reasoning via Difficulty-Aware Token-Level Entropy Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">25</span></a> via standard
exponential-family calculus. Complementary slackness gives the budget activity.
∎</span></p>
</div>
</div>
<section id="A11.SS0.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Token factorization and actor-only KL loss.</h5>

<div id="A11.SS0.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A11.SS0.SSS0.Px1.p1.1" class="ltx_p">For auto-regressive policies, by the chain rule,</p>
<table id="A11.E26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A11.E26.m1" class="ltx_math_unparsed" alttext="D_{\mathrm{KL}}\!\big(\pi_{\theta}(\cdot\mid x)\,\|\,\pi_{\mathrm{ref}}(\cdot\mid x)\big)=\mathbb{E}_{o\sim\pi_{\theta}}\Big[\sum_{t=1}^{|o|}D_{\mathrm{KL}}\!\big(\pi_{\theta}(\cdot\mid s_{t})\,\|\,\pi_{\mathrm{ref}}(\cdot\mid s_{t})\big)\Big]," display="block" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>π</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0.337em">∥</mo><msub><mi>π</mi><mi>ref</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>o</mi><mo>∼</mo><msub><mi>π</mi><mi>θ</mi></msub></mrow></msub><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mo stretchy="false">|</mo><mi>o</mi><mo stretchy="false">|</mo></mrow></munderover><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>π</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0.337em">∥</mo><msub><mi>π</mi><mi>ref</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">D_{\mathrm{KL}}\!\big(\pi_{\theta}(\cdot\mid x)\,\|\,\pi_{\mathrm{ref}}(\cdot\mid x)\big)=\mathbb{E}_{o\sim\pi_{\theta}}\Big[\sum_{t=1}^{|o|}D_{\mathrm{KL}}\!\big(\pi_{\theta}(\cdot\mid s_{t})\,\|\,\pi_{\mathrm{ref}}(\cdot\mid s_{t})\big)\Big],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
</table>
<p id="A11.SS0.SSS0.Px1.p1.2" class="ltx_p">with <math id="A11.SS0.SSS0.Px1.p1.m1" class="ltx_math_unparsed" alttext="s_{t}=(x,o_{1:t-1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mi>t</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>o</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{t}=(x,o_{1:t-1})</annotation></semantics></math>.
Hence a <em id="A11.SS0.SSS0.Px1.p1.2.1" class="ltx_emph ltx_font_italic">per-token</em> KL loss in the actor objective</p>
<table id="A11.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A11.Ex19.m1" class="ltx_math_unparsed" alttext="\kappa\cdot\frac{1}{|o|}\sum_{t}\beta_{t}\,D_{\mathrm{KL}}\!\big(\pi_{\theta}(\cdot\mid s_{t})\,\|\,\pi_{\mathrm{ref}}(\cdot\mid s_{t})\big)" display="block" intent=":literal"><semantics><mrow><mi>κ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi>o</mi><mo stretchy="false">|</mo></mrow></mfrac><munder><mo movablelimits="false">∑</mo><mi>t</mi></munder><msub><mi>β</mi><mi>t</mi></msub><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>π</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0.337em">∥</mo><msub><mi>π</mi><mi>ref</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\kappa\cdot\frac{1}{|o|}\sum_{t}\beta_{t}\,D_{\mathrm{KL}}\!\big(\pi_{\theta}(\cdot\mid s_{t})\,\|\,\pi_{\mathrm{ref}}(\cdot\mid s_{t})\big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A11.SS0.SSS0.Px1.p1.3" class="ltx_p">is precisely a discretization of the dual term in equation <a href="#A11.E23" title="In Appendix K Why KL Loss is a Valid Thinking Budget ‣ ARES: Multimodal Adaptive Reasoning via Difficulty-Aware Token-Level Entropy Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>;
weights <math id="A11.SS0.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\beta_{t}\!\in\!(0,\infty)" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0.108em" rspace="0.108em">∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\beta_{t}\!\in\!(0,\infty)</annotation></semantics></math> allow token-adaptive emphasis (e.g., relaxing
inside validated high-entropy windows). Because this term <em id="A11.SS0.SSS0.Px1.p1.3.1" class="ltx_emph ltx_font_italic">does not</em> enter
the advantage, it controls deviation magnitude independently of the task/entropy
signals that decide <em id="A11.SS0.SSS0.Px1.p1.3.2" class="ltx_emph ltx_font_italic">when</em> to explore.</p>
</div>
</section>
<section id="A11.SS0.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Budget tracking via dual updates.</h5>

<div id="A11.SS0.SSS0.Px2.p1" class="ltx_para ltx_noindent">
<p id="A11.SS0.SSS0.Px2.p1.1" class="ltx_p">Let <math id="A11.SS0.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\widehat{\mathrm{KL}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>KL</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{\mathrm{KL}}</annotation></semantics></math> be a moving-average estimate of the left-hand side of
equation <a href="#A11.E23" title="In Appendix K Why KL Loss is a Valid Thinking Budget ‣ ARES: Multimodal Adaptive Reasoning via Difficulty-Aware Token-Level Entropy Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>. The multiplicative update</p>
<table id="A11.E27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A11.E27.m1" class="ltx_Math" alttext="\kappa\;\leftarrow\;\mathrm{clip}\!\Big(\kappa\big(1+\alpha_{\kappa}(\widehat{\mathrm{KL}}/\delta-1)\big),\,\kappa_{\min},\kappa_{\max}\Big)" display="block" intent=":literal"><semantics><mrow><mi>κ</mi><mo lspace="0.558em" rspace="0.558em" stretchy="false">←</mo><mrow><mpadded style="width:1.428em;" width="1.428em"><mi>clip</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>α</mi><mi>κ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mover accent="true"><mi>KL</mi><mo>^</mo></mover><mo>/</mo><mi>δ</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>,</mo><msub><mi>κ</mi><mi>min</mi></msub><mo>,</mo><msub><mi>κ</mi><mi>max</mi></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\kappa\;\leftarrow\;\mathrm{clip}\!\Big(\kappa\big(1+\alpha_{\kappa}(\widehat{\mathrm{KL}}/\delta-1)\big),\,\kappa_{\min},\kappa_{\max}\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(27)</span></td></tr></tbody>
</table>
<p id="A11.SS0.SSS0.Px2.p1.2" class="ltx_p">is a stochastic dual ascent that drives <math id="A11.SS0.SSS0.Px2.p1.m2" class="ltx_Math" alttext="\widehat{\mathrm{KL}}\!\to\!\delta" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>KL</mi><mo>^</mo></mover><mo lspace="0.108em" rspace="0.108em" stretchy="false">→</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">\widehat{\mathrm{KL}}\!\to\!\delta</annotation></semantics></math>.
Under standard Robbins–Monro conditions on <math id="A11.SS0.SSS0.Px2.p1.m3" class="ltx_Math" alttext="\alpha_{\kappa}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>κ</mi></msub><annotation encoding="application/x-tex">\alpha_{\kappa}</annotation></semantics></math> and bounded
variance, <math id="A11.SS0.SSS0.Px2.p1.m4" class="ltx_Math" alttext="\kappa_{t}\!\to\!\kappa^{*}" display="inline" intent=":literal"><semantics><mrow><msub><mi>κ</mi><mi>t</mi></msub><mo lspace="0.108em" rspace="0.108em" stretchy="false">→</mo><msup><mi>κ</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">\kappa_{t}\!\to\!\kappa^{*}</annotation></semantics></math> a.s., and the primal iterates satisfy the
budget asymptotically. Thus the actor-only KL loss with controller
implements an <em id="A11.SS0.SSS0.Px2.p1.2.1" class="ltx_emph ltx_font_italic">operational thinking budget</em>.</p>
</div>
</section>
<section id="A11.SS0.SSS0.Px3" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">From KL budget to <em id="A11.SS0.SSS0.Px3.1" class="ltx_emph ltx_font_italic">thinking</em> budget.</h5>

<div id="A11.SS0.SSS0.Px3.p1" class="ltx_para ltx_noindent">
<p id="A11.SS0.SSS0.Px3.p1.1" class="ltx_p">We now show that bounding KL controls the expected thinking cost
(e.g., <math id="A11.SS0.SSS0.Px3.p1.m1" class="ltx_Math" alttext="c=L" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>=</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">c=L</annotation></semantics></math> or <math id="A11.SS0.SSS0.Px3.p1.m2" class="ltx_Math" alttext="c=C_{\text{ent}}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>=</mo><msub><mi>C</mi><mtext>ent</mtext></msub></mrow><annotation encoding="application/x-tex">c=C_{\text{ent}}</annotation></semantics></math>).</p>
</div>
<div id="Thmlemma3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma3.2" class="ltx_text ltx_font_bold">Lemma 3</span></span><span id="Thmlemma3.3" class="ltx_text ltx_font_bold"> </span>(Pinsker-type bound)<span id="Thmlemma3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma3.p1" class="ltx_para ltx_noindent">
<p id="Thmlemma3.p1.1" class="ltx_p"><span id="Thmlemma3.p1.1.1" class="ltx_text ltx_font_italic">For any bounded <math id="Thmlemma3.p1.m1" class="ltx_Math" alttext="f:\mathcal{Y}\!\to\!\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo lspace="0.108em" rspace="0.108em" stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f:\mathcal{Y}\!\to\!\mathbb{R}</annotation></semantics></math> with <math id="Thmlemma3.p1.m2" class="ltx_Math" alttext="\|f\|_{\infty}\leq M" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>f</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\|f\|_{\infty}\leq M</annotation></semantics></math>,</span></p>
<table id="A11.E28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A11.E28.m1" class="ltx_Math" alttext="\Big|\mathbb{E}_{\pi_{\theta}}[f]-\mathbb{E}_{\pi_{\mathrm{ref}}}[f]\Big|\;\leq\;M\,\sqrt{2\,D_{\mathrm{KL}}\!\big(\pi_{\theta}\|\pi_{\mathrm{ref}}\big)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mrow><msub><mi>𝔼</mi><msub><mi>π</mi><mi>θ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>f</mi><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><msub><mi>π</mi><mi>ref</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>f</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.280em" stretchy="true">|</mo></mrow><mo rspace="0.558em">≤</mo><mrow><mi>M</mi><mo lspace="0.170em" rspace="0em">​</mo><msqrt><mrow><mn>2</mn><mi>D</mi><msub><mrow></mrow><mi>KL</mi></msub><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Big|\mathbb{E}_{\pi_{\theta}}[f]-\mathbb{E}_{\pi_{\mathrm{ref}}}[f]\Big|\;\leq\;M\,\sqrt{2\,D_{\mathrm{KL}}\!\big(\pi_{\theta}\|\pi_{\mathrm{ref}}\big)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A11.SS0.SSS0.Px3.p2" class="ltx_para ltx_noindent">
<p id="A11.SS0.SSS0.Px3.p2.1" class="ltx_p">Thus if <math id="A11.SS0.SSS0.Px3.p2.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is the (clipped) reasoning length or normalized entropy cost,
a <em id="A11.SS0.SSS0.Px3.p2.1.1" class="ltx_emph ltx_font_italic">global</em> KL budget <math id="A11.SS0.SSS0.Px3.p2.m2" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> implies a corresponding bound on the change of its expectation.</p>
</div>
<div id="Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem1.2" class="ltx_text ltx_font_bold">Theorem 1</span></span><span id="Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(Donsker–Varadhan control of moment budgets)<span id="Thmtheorem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem1.p1" class="ltx_para ltx_noindent">
<p id="Thmtheorem1.p1.1" class="ltx_p"><span id="Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">For any <math id="Thmtheorem1.p1.m1" class="ltx_Math" alttext="\eta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta&gt;0</annotation></semantics></math> and measurable <math id="Thmtheorem1.p1.m2" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>,</span></p>
<table id="A11.E29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A11.E29.m1" class="ltx_math_unparsed" alttext="\mathbb{E}_{\pi_{\theta}}[f]\;\leq\;\frac{1}{\eta}\log\mathbb{E}_{\pi_{\mathrm{ref}}}\!\big[e^{\eta f}\big]\;+\;\frac{1}{\eta}\,D_{\mathrm{KL}}\!\big(\pi_{\theta}\|\pi_{\mathrm{ref}}\big)." display="block" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><msub><mi>π</mi><mi>θ</mi></msub></msub><mrow><mo stretchy="false">[</mo><mi>f</mi><mo rspace="0.280em" stretchy="false">]</mo></mrow><mo rspace="0.558em">≤</mo><mfrac><mn>1</mn><mi>η</mi></mfrac><mi>log</mi><msub><mi>𝔼</mi><msub><mi>π</mi><mi>ref</mi></msub></msub><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mi>e</mi><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msup><mo maxsize="1.200em" minsize="1.200em" rspace="0.280em">]</mo></mrow><mo rspace="0.502em">+</mo><mfrac><mn>1</mn><mi>η</mi></mfrac><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>π</mi><mi>ref</mi></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}_{\pi_{\theta}}[f]\;\leq\;\frac{1}{\eta}\log\mathbb{E}_{\pi_{\mathrm{ref}}}\!\big[e^{\eta f}\big]\;+\;\frac{1}{\eta}\,D_{\mathrm{KL}}\!\big(\pi_{\theta}\|\pi_{\mathrm{ref}}\big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(29)</span></td></tr></tbody>
</table>
<p id="Thmtheorem1.p1.2" class="ltx_p"><span id="Thmtheorem1.p1.2.1" class="ltx_text ltx_font_italic">Consequently, under the budget <math id="Thmtheorem1.p1.m3" class="ltx_Math" alttext="D_{\mathrm{KL}}\leq\delta" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mo>≤</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">D_{\mathrm{KL}}\leq\delta</annotation></semantics></math>,</span></p>
<table id="A11.E30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A11.E30.m1" class="ltx_Math" alttext="\mathbb{E}_{\pi_{\theta}}[f]\;\leq\;\inf_{\eta&gt;0}\Big\{\frac{1}{\eta}\log\mathbb{E}_{\pi_{\mathrm{ref}}}[e^{\eta f}]+\frac{\delta}{\eta}\Big\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><msub><mi>π</mi><mi>θ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>f</mi><mo rspace="0.280em" stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mrow><munder><mo movablelimits="false" rspace="0em">inf</mo><mrow><mi>η</mi><mo>&gt;</mo><mn>0</mn></mrow></munder><mrow><mo stretchy="false">{</mo><mrow><mrow><mfrac><mn>1</mn><mi>η</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>𝔼</mi><msub><mi>π</mi><mi>ref</mi></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mi>e</mi><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msup><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mfrac><mi>δ</mi><mi>η</mi></mfrac></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}_{\pi_{\theta}}[f]\;\leq\;\inf_{\eta&gt;0}\Big\{\frac{1}{\eta}\log\mathbb{E}_{\pi_{\mathrm{ref}}}[e^{\eta f}]+\frac{\delta}{\eta}\Big\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(30)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A11.SS0.SSS0.Px3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A11.SS0.SSS0.Px3.p3" class="ltx_para">
<p id="A11.SS0.SSS0.Px3.p3.1" class="ltx_p"><span id="A11.SS0.SSS0.Px3.p3.1.1" class="ltx_text">equation <a href="#A11.E29" title="In Theorem 1 (Donsker–Varadhan control of moment budgets). ‣ From KL budget to thinking budget. ‣ Appendix K Why KL Loss is a Valid Thinking Budget ‣ ARES: Multimodal Adaptive Reasoning via Difficulty-Aware Token-Level Entropy Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a> is the Donsker–Varadhan variational inequality obtained by
upper-bounding the log-moment generating function via relative entropy.
∎</span></p>
</div>
</div>
<div id="A11.SS0.SSS0.Px3.p4" class="ltx_para ltx_noindent">
<p id="A11.SS0.SSS0.Px3.p4.1" class="ltx_p">Taking <math id="A11.SS0.SSS0.Px3.p4.m1" class="ltx_Math" alttext="f=c(x,o)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>o</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f=c(x,o)</annotation></semantics></math> (e.g., <math id="A11.SS0.SSS0.Px3.p4.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> or <math id="A11.SS0.SSS0.Px3.p4.m3" class="ltx_Math" alttext="C_{\text{ent}}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mtext>ent</mtext></msub><annotation encoding="application/x-tex">C_{\text{ent}}</annotation></semantics></math>) shows that a KL budget
<em id="A11.SS0.SSS0.Px3.p4.1.1" class="ltx_emph ltx_font_italic">upper-bounds</em> the expected thinking cost relative to the reference
through the reference MGF, i.e., the policy cannot arbitrarily increase
reasoning length or entropy cost without paying KL.</p>
</div>
</section>
<section id="A11.SS0.SSS0.Px4" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Mirror-descent / trust-region view.</h5>

<div id="A11.SS0.SSS0.Px4.p1" class="ltx_para ltx_noindent">
<p id="A11.SS0.SSS0.Px4.p1.1" class="ltx_p">Maximizing <math id="A11.SS0.SSS0.Px4.p1.m1" class="ltx_Math" alttext="\mathbb{E}[\tilde{r}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>r</mi><mo>~</mo></mover><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[\tilde{r}]</annotation></semantics></math> under a <em id="A11.SS0.SSS0.Px4.p1.1.1" class="ltx_emph ltx_font_italic">local</em> KL ball
<math id="A11.SS0.SSS0.Px4.p1.m2" class="ltx_math_unparsed" alttext="D_{\mathrm{KL}}(\pi\|\pi_{\mathrm{old}})\!\leq\!\delta" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo stretchy="false">(</mo><mi>π</mi><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>π</mi><mi>old</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.108em" rspace="0.108em">≤</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">D_{\mathrm{KL}}(\pi\|\pi_{\mathrm{old}})\!\leq\!\delta</annotation></semantics></math> yields the
mirror-descent (natural-gradient) update</p>
<table id="A11.E31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A11.E31.m1" class="ltx_Math" alttext="\pi^{*}\;\propto\;\pi_{\mathrm{old}}\,\exp\!\big(\tfrac{1}{\kappa}\,\tilde{r}\big),\quad\text{with}\;\;\kappa\;\asymp\;\frac{1}{\sqrt{\delta}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>π</mi><mo>∗</mo></msup><mo lspace="0.558em" rspace="0.558em">∝</mo><mrow><msub><mi>π</mi><mi>old</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mpadded style="width:1.370em;" width="1.370em"><mi>exp</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mi>κ</mi></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><mover accent="true"><mi>r</mi><mo>~</mo></mover></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mtext>with</mtext><mo lspace="0.560em" rspace="0em">​</mo><mi>κ</mi></mrow><mo lspace="0.558em" rspace="0.558em">≍</mo><mfrac><mn>1</mn><msqrt><mi>δ</mi></msqrt></mfrac></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\pi^{*}\;\propto\;\pi_{\mathrm{old}}\,\exp\!\big(\tfrac{1}{\kappa}\,\tilde{r}\big),\quad\text{with}\;\;\kappa\;\asymp\;\frac{1}{\sqrt{\delta}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(31)</span></td></tr></tbody>
</table>
<p id="A11.SS0.SSS0.Px4.p1.2" class="ltx_p">so <math id="A11.SS0.SSS0.Px4.p1.m3" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> is precisely the <em id="A11.SS0.SSS0.Px4.p1.2.1" class="ltx_emph ltx_font_italic">trust-region radius</em>: a smaller (larger)
budget forces smaller (larger) policy movement and therefore smaller (larger)
allowable growth of <math id="A11.SS0.SSS0.Px4.p1.m4" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> by Lemma <a href="#Thmlemma3" title="Lemma 3 (Pinsker-type bound). ‣ From KL budget to thinking budget. ‣ Appendix K Why KL Loss is a Valid Thinking Budget ‣ ARES: Multimodal Adaptive Reasoning via Difficulty-Aware Token-Level Entropy Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>/Theorem <a href="#Thmtheorem1" title="Theorem 1 (Donsker–Varadhan control of moment budgets). ‣ From KL budget to thinking budget. ‣ Appendix K Why KL Loss is a Valid Thinking Budget ‣ ARES: Multimodal Adaptive Reasoning via Difficulty-Aware Token-Level Entropy Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.
In auto-regressive models, equation <a href="#A11.E26" title="In Token factorization and actor-only KL loss. ‣ Appendix K Why KL Loss is a Valid Thinking Budget ‣ ARES: Multimodal Adaptive Reasoning via Difficulty-Aware Token-Level Entropy Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a> further identifies the
budget with a <em id="A11.SS0.SSS0.Px4.p1.2.2" class="ltx_emph ltx_font_italic">tokenwise</em> sum of deviations, making the KL loss a
time–additive <em id="A11.SS0.SSS0.Px4.p1.2.3" class="ltx_emph ltx_font_italic">budget meter</em> of exploration.</p>
</div>
</section>
<section id="A11.SS0.SSS0.Px5" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Token-adaptive windows preserve convexity.</h5>

<div id="A11.SS0.SSS0.Px5.p1" class="ltx_para ltx_noindent">
<p id="A11.SS0.SSS0.Px5.p1.1" class="ltx_p">Let <math id="A11.SS0.SSS0.Px5.p1.m1" class="ltx_Math" alttext="\{w_{t}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{w_{t}\}</annotation></semantics></math> be nonnegative weights (e.g., <math id="A11.SS0.SSS0.Px5.p1.m2" class="ltx_Math" alttext="w_{t}\!\in\![\rho,1]" display="inline" intent=":literal"><semantics><mrow><msub><mi>w</mi><mi>t</mi></msub><mo lspace="0.108em" rspace="0.108em">∈</mo><mrow><mo stretchy="false">[</mo><mrow><mi>ρ</mi><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">w_{t}\!\in\![\rho,1]</annotation></semantics></math> with <math id="A11.SS0.SSS0.Px5.p1.m3" class="ltx_Math" alttext="\rho&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\rho&lt;1</annotation></semantics></math>
inside validated reasoning windows). The weighted budget
<math id="A11.SS0.SSS0.Px5.p1.m4" class="ltx_math_unparsed" alttext="\sum_{t}w_{t}\,D_{\mathrm{KL}}(\pi_{t}\|\pi_{t}^{\mathrm{ref}})" display="inline" intent=":literal"><semantics><mrow><msub><mo>∑</mo><mi>t</mi></msub><msub><mi>w</mi><mi>t</mi></msub><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0.167em">∥</mo><msubsup><mi>π</mi><mi>t</mi><mi>ref</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\sum_{t}w_{t}\,D_{\mathrm{KL}}(\pi_{t}\|\pi_{t}^{\mathrm{ref}})</annotation></semantics></math> remains convex in
<math id="A11.SS0.SSS0.Px5.p1.m5" class="ltx_Math" alttext="\{\pi_{t}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>π</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\pi_{t}\}</annotation></semantics></math> and admits the same dual treatment; hence the actor-only term
<math id="A11.SS0.SSS0.Px5.p1.m6" class="ltx_Math" alttext="\kappa\!\sum_{t}w_{t}\,\mathrm{kld}_{t}" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:0.573em;" width="0.573em"><mi>κ</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∑</mo><mi>t</mi></msub><mrow><msub><mi>w</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>kld</mi><mi>t</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\kappa\!\sum_{t}w_{t}\,\mathrm{kld}_{t}</annotation></semantics></math> is still a valid Lagrangian penalty for a
<em id="A11.SS0.SSS0.Px5.p1.1.1" class="ltx_emph ltx_font_italic">window-relaxed</em> KL budget. This realizes the intuition:
<em id="A11.SS0.SSS0.Px5.p1.1.2" class="ltx_emph ltx_font_italic">“relax KL where we intend to think”</em> without breaking the budgeting
semantics.</p>
</div>
<div id="A11.SS0.SSS0.Px5.p2" class="ltx_para ltx_noindent">
<p id="A11.SS0.SSS0.Px5.p2.1" class="ltx_p">(i) Strong duality turns the KL loss into the Lagrange multiplier of the
reference-deviation budget; (ii) dual updates equation <a href="#A11.E27" title="In Budget tracking via dual updates. ‣ Appendix K Why KL Loss is a Valid Thinking Budget ‣ ARES: Multimodal Adaptive Reasoning via Difficulty-Aware Token-Level Entropy Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a> track the
target <math id="A11.SS0.SSS0.Px5.p2.m1" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>; (iii) information inequalities (Pinsker, Donsker–Varadhan)
translate a KL budget into explicit upper bounds on the expected thinking cost.
Therefore, the actor-only KL loss in AEPO is not merely a regularizer: it is a
<em id="A11.SS0.SSS0.Px5.p2.1.1" class="ltx_emph ltx_font_italic">principled and operational thinking budget</em>.</p>
</div>
</section>
</section>
<section id="A12" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix L </span>Fisher–Geometry Justification of AEPO</h2>

<div id="A12.p1" class="ltx_para ltx_noindent">
<p id="A12.p1.1" class="ltx_p">This subsection formalizes why the proposed <em id="A12.p1.1.1" class="ltx_emph ltx_font_italic">Adaptive–Entropy Policy Optimization</em> (AEPO) is
principled from the viewpoint of information geometry. We show that AEPO is equivalent to a
<em id="A12.p1.1.2" class="ltx_emph ltx_font_italic">token–reweighted natural–gradient update under a per–difficulty trust region</em>, and that the
entropy–augmented advantage and token–adaptive KL together maximize improvement in the directions
that matter for reasoning.</p>
</div>
<section id="A12.SS0.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Setup.</h5>

<div id="A12.SS0.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A12.SS0.SSS0.Px1.p1.2" class="ltx_p">Given a prompt <math id="A12.SS0.SSS0.Px1.p1.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, the auto–regressive policy <math id="A12.SS0.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\pi_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\pi_{\theta}</annotation></semantics></math> generates a response
<math id="A12.SS0.SSS0.Px1.p1.m3" class="ltx_math_unparsed" alttext="o=(o_{1:L})" display="inline" intent=":literal"><semantics><mrow><mi>o</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>o</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">o=(o_{1:L})</annotation></semantics></math> with states <math id="A12.SS0.SSS0.Px1.p1.m4" class="ltx_Math" alttext="s_{t}=(x,o_{&lt;t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mi>t</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>o</mi><mrow><mphantom></mphantom><mo>&lt;</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{t}=(x,o_{&lt;t})</annotation></semantics></math>. Let <math id="A12.SS0.SSS0.Px1.p1.m5" class="ltx_Math" alttext="r(x,o)" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>o</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r(x,o)</annotation></semantics></math> be the task reward and
<math id="A12.SS0.SSS0.Px1.p1.m6" class="ltx_Math" alttext="C_{\mathrm{ent}}(x,o)" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>ent</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>o</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{\mathrm{ent}}(x,o)</annotation></semantics></math> the entropy–window cost (Section <span class="ltx_ref ltx_missing_label ltx_ref_self"></span>).
For a difficulty bucket <math id="A12.SS0.SSS0.Px1.p1.m7" class="ltx_Math" alttext="d=d(x)" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d=d(x)</annotation></semantics></math>, AEPO solves the following constrained problem:</p>
<table id="A12.E32" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A12.E32X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A12.E32X.m2" class="ltx_Math" alttext="\displaystyle\max_{\pi_{\theta}}" display="inline" intent=":literal"><semantics><munder><mi>max</mi><msub><mi>π</mi><mi>θ</mi></msub></munder><annotation encoding="application/x-tex">\displaystyle\max_{\pi_{\theta}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A12.E32X.m3" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\,\mathbb{E}_{o\sim\pi_{\theta}(\cdot\mid x)}\Big[\,r(x,o)\;-\;\lambda_{d(x)}\,C_{\mathrm{ent}}(x,o)\,\Big]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>o</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mo maxsize="1.600em" minsize="1.600em" rspace="0.170em">[</mo><mi>r</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>o</mi><mo rspace="0.280em" stretchy="false">)</mo><mo rspace="0.502em">−</mo><mi>λ</mi><msub><mrow></mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mi>C</mi><msub><mrow></mrow><mi>ent</mi></msub><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>o</mi><mo rspace="0.170em" stretchy="false">)</mo><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\,\mathbb{E}_{o\sim\pi_{\theta}(\cdot\mid x)}\Big[\,r(x,o)\;-\;\lambda_{d(x)}\,C_{\mathrm{ent}}(x,o)\,\Big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(32)</span></td></tr>
<tr id="A12.E32Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A12.E32Xa.m2" class="ltx_Math" alttext="\displaystyle\text{s.t.}" display="inline" intent=":literal"><semantics><mtext>s.t.</mtext><annotation encoding="application/x-tex">\displaystyle\text{s.t.}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A12.E32Xa.m3" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\,\mathbb{E}_{o\sim\pi_{\theta}(\cdot\mid x)}\Bigg[\,\frac{1}{L(o)}\sum_{t=1}^{L(o)}\beta_{d(x),t}\;D_{\mathrm{KL}}\!\Big(\pi_{\theta}(\cdot\mid s_{t})\,\Big\|\,\pi_{\mathrm{ref}}(\cdot\mid s_{t})\Big)\,\Bigg]\;\leq\;\delta_{d(x)}\,." display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>o</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mo maxsize="2.600em" minsize="2.600em" rspace="0.170em">[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mi>β</mi><msub><mrow></mrow><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>t</mi></mrow></msub><mi>D</mi><msub><mrow></mrow><mi>KL</mi></msub><mo maxsize="1.600em" minsize="1.600em">(</mo><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>s</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo lspace="0.170em" mathsize="1.600em" rspace="0.337em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>s</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo maxsize="1.600em" minsize="1.600em" rspace="0.170em">)</mo><mo maxsize="2.600em" minsize="2.600em" rspace="0.280em">]</mo><mo rspace="0.558em">≤</mo><mi>δ</mi><msub><mrow></mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\,\mathbb{E}_{o\sim\pi_{\theta}(\cdot\mid x)}\Bigg[\,\frac{1}{L(o)}\sum_{t=1}^{L(o)}\beta_{d(x),t}\;D_{\mathrm{KL}}\!\Big(\pi_{\theta}(\cdot\mid s_{t})\,\Big\|\,\pi_{\mathrm{ref}}(\cdot\mid s_{t})\Big)\,\Bigg]\;\leq\;\delta_{d(x)}\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A12.SS0.SSS0.Px1.p1.3" class="ltx_p">Here <math id="A12.SS0.SSS0.Px1.p1.m8" class="ltx_Math" alttext="L(o)" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L(o)</annotation></semantics></math> denotes the response length and <math id="A12.SS0.SSS0.Px1.p1.m9" class="ltx_Math" alttext="s_{t}=(x,o_{&lt;t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mi>t</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>o</mi><mrow><mphantom></mphantom><mo>&lt;</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{t}=(x,o_{&lt;t})</annotation></semantics></math>.
The token weight is <math id="A12.SS0.SSS0.Px1.p1.m10" class="ltx_Math" alttext="\beta_{d,t}=\beta_{d}\,\rho_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mrow><mi>d</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><mrow><msub><mi>β</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\beta_{d,t}=\beta_{d}\,\rho_{t}</annotation></semantics></math>, where
<math id="A12.SS0.SSS0.Px1.p1.m11" class="ltx_Math" alttext="\rho_{t}\in(0,1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho_{t}\in(0,1)</annotation></semantics></math> if <math id="A12.SS0.SSS0.Px1.p1.m12" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> lies in a validated high–entropy window and
<math id="A12.SS0.SSS0.Px1.p1.m13" class="ltx_Math" alttext="\rho_{t}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\rho_{t}=1</annotation></semantics></math> otherwise.</p>
</div>
</section>
<section id="A12.SS0.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">KL as a Fisher quadratic.</h5>

<div id="A12.SS0.SSS0.Px2.p1" class="ltx_para ltx_noindent">
<p id="A12.SS0.SSS0.Px2.p1.1" class="ltx_p">Let <math id="A12.SS0.SSS0.Px2.p1.m1" class="ltx_Math" alttext="F_{t}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>t</mi></msub><annotation encoding="application/x-tex">F_{t}</annotation></semantics></math> denote the token–wise Fisher information matrix under the reference policy <math id="A12.SS0.SSS0.Px2.p1.m2" class="ltx_Math" alttext="\pi_{\mathrm{ref}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>ref</mi></msub><annotation encoding="application/x-tex">\pi_{\mathrm{ref}}</annotation></semantics></math>:</p>
<table id="A12.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A12.Ex20.m1" class="ltx_math_unparsed" alttext="F_{t}=\mathbb{E}_{a\sim\pi_{\mathrm{ref}}(\cdot\mid s_{t})}\big[\nabla\log\pi_{\mathrm{ref}}(a\mid s_{t})\;\nabla\log\pi_{\mathrm{ref}}(a\mid s_{t})^{\top}\big]." display="block" intent=":literal"><semantics><mrow><msub><mi>F</mi><mi>t</mi></msub><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>a</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>s</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></msub><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mo rspace="0.167em">∇</mo><mi>log</mi><msub><mi>π</mi><mi>ref</mi></msub><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mi>t</mi></msub><mo rspace="0.447em" stretchy="false">)</mo></mrow><mo rspace="0.167em">∇</mo><mi>log</mi><msub><mi>π</mi><mi>ref</mi></msub><msup><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">F_{t}=\mathbb{E}_{a\sim\pi_{\mathrm{ref}}(\cdot\mid s_{t})}\big[\nabla\log\pi_{\mathrm{ref}}(a\mid s_{t})\;\nabla\log\pi_{\mathrm{ref}}(a\mid s_{t})^{\top}\big].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A12.SS0.SSS0.Px2.p1.2" class="ltx_p">For a small parameter displacement <math id="A12.SS0.SSS0.Px2.p1.m3" class="ltx_Math" alttext="\Delta\theta" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><annotation encoding="application/x-tex">\Delta\theta</annotation></semantics></math>, the per–token KL admits the standard
second–order approximation</p>
<table id="A12.E33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A12.E33.m1" class="ltx_math_unparsed" alttext="D_{\mathrm{KL}}\!\big(\pi_{\theta+\Delta\theta}(\cdot\mid s_{t})\,\big\|\,\pi_{\mathrm{ref}}(\cdot\mid s_{t})\big)\;=\;\tfrac{1}{2}\,\Delta\theta^{\top}F_{t}\,\Delta\theta\;+\;o(\|\Delta\theta\|^{2})." display="block" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>π</mi><mrow><mi>θ</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" mathsize="1.200em" rspace="0.337em">∥</mo><msub><mi>π</mi><mi>ref</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.280em">)</mo></mrow><mo rspace="0.558em">=</mo><mstyle displaystyle="false"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mi mathvariant="normal">Δ</mi><msup><mi>θ</mi><mo>⊤</mo></msup><msub><mi>F</mi><mi>t</mi></msub><mi mathvariant="normal">Δ</mi><mi>θ</mi><mo lspace="0.502em" rspace="0.502em">+</mo><mi>o</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi mathvariant="normal">Δ</mi><mi>θ</mi><msup><mo lspace="0em" rspace="0.167em">∥</mo><mn>2</mn></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">D_{\mathrm{KL}}\!\big(\pi_{\theta+\Delta\theta}(\cdot\mid s_{t})\,\big\|\,\pi_{\mathrm{ref}}(\cdot\mid s_{t})\big)\;=\;\tfrac{1}{2}\,\Delta\theta^{\top}F_{t}\,\Delta\theta\;+\;o(\|\Delta\theta\|^{2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(33)</span></td></tr></tbody>
</table>
</div>
<div id="Thmlemma4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma4.2" class="ltx_text ltx_font_bold">Lemma 4</span></span><span id="Thmlemma4.3" class="ltx_text ltx_font_bold"> </span>(Weighted Fisher trust region)<span id="Thmlemma4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma4.p1" class="ltx_para ltx_noindent">
<p id="Thmlemma4.p1.1" class="ltx_p"><span id="Thmlemma4.p1.1.1" class="ltx_text ltx_font_italic">Under the approximation equation <a href="#A12.E33" title="In KL as a Fisher quadratic. ‣ Appendix L Fisher–Geometry Justification of AEPO ‣ ARES: Multimodal Adaptive Reasoning via Difficulty-Aware Token-Level Entropy Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">33</span></a>, the KL constraint in
equation <a href="#A12.E32" title="In Setup. ‣ Appendix L Fisher–Geometry Justification of AEPO ‣ ARES: Multimodal Adaptive Reasoning via Difficulty-Aware Token-Level Entropy Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">32</span></a> is equivalent to the quadratic trust region
<math id="Thmlemma4.p1.m1" class="ltx_Math" alttext="\frac{1}{2}\,\Delta\theta^{\top}F_{\beta}\,\Delta\theta\leq\delta_{d}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>θ</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo>≤</mo><msub><mi>δ</mi><mi>d</mi></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{1}{2}\,\Delta\theta^{\top}F_{\beta}\,\Delta\theta\leq\delta_{d},</annotation></semantics></math>
with the token–reweighted Fisher</span></p>
<table id="A12.E34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A12.E34.m1" class="ltx_Math" alttext="F_{\beta}\;\triangleq\;\frac{1}{L}\sum_{t=1}^{L}\beta_{d,t}\,F_{t},\qquad\beta_{d,t}=\beta_{d}\,\rho_{t},\ \ \rho_{t}\in(0,1]\!." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>F</mi><mi>β</mi></msub><mo lspace="0.558em" rspace="0.558em">≜</mo><mrow><mfrac><mn>1</mn><mi>L</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></munderover><mrow><msub><mi>β</mi><mrow><mi>d</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>t</mi></msub></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>β</mi><mrow><mi>d</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><mrow><msub><mi>β</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>t</mi></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mpadded style="width:0.108em;" width="0.108em"><mo stretchy="false">]</mo></mpadded></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">F_{\beta}\;\triangleq\;\frac{1}{L}\sum_{t=1}^{L}\beta_{d,t}\,F_{t},\qquad\beta_{d,t}=\beta_{d}\,\rho_{t},\ \ \rho_{t}\in(0,1]\!.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(34)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A12.SS0.SSS0.Px2.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A12.SS0.SSS0.Px2.p2" class="ltx_para">
<p id="A12.SS0.SSS0.Px2.p2.1" class="ltx_p"><span id="A12.SS0.SSS0.Px2.p2.1.1" class="ltx_text">Average equation <a href="#A12.E33" title="In KL as a Fisher quadratic. ‣ Appendix L Fisher–Geometry Justification of AEPO ‣ ARES: Multimodal Adaptive Reasoning via Difficulty-Aware Token-Level Entropy Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">33</span></a> over <math id="A12.SS0.SSS0.Px2.p2.m1" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> with weights <math id="A12.SS0.SSS0.Px2.p2.m2" class="ltx_Math" alttext="\beta_{d,t}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mrow><mi>d</mi><mo>,</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">\beta_{d,t}</annotation></semantics></math> and use linearity.
∎</span></p>
</div>
</div>
</section>
<section id="A12.SS0.SSS0.Px3" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Dual/Lagrangian form and natural gradient.</h5>

<div id="A12.SS0.SSS0.Px3.p1" class="ltx_para ltx_noindent">
<p id="A12.SS0.SSS0.Px3.p1.1" class="ltx_p">Introducing a Lagrange multiplier <math id="A12.SS0.SSS0.Px3.p1.m1" class="ltx_Math" alttext="\kappa_{d}\!\geq\!0" display="inline" intent=":literal"><semantics><mrow><msub><mi>κ</mi><mi>d</mi></msub><mo lspace="0.108em">≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\kappa_{d}\!\geq\!0</annotation></semantics></math>, the inner (fixed–<math id="A12.SS0.SSS0.Px3.p1.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>) problem becomes</p>
<table id="A12.E35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A12.E35.m1" class="ltx_Math" alttext="\max_{\Delta\theta}\ \ g^{\top}\Delta\theta\;-\;\tfrac{\kappa_{d}}{2}\,\Delta\theta^{\top}F_{\beta}\,\Delta\theta,\qquad g\;\triangleq\;\nabla_{\theta}\,\mathbb{E}\!\big[r(x,o)-\lambda_{d}\,C_{\mathrm{ent}}(x,o)\big]," display="block" intent=":literal"><semantics><mrow><mrow><munder><mi>max</mi><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow></munder><mspace style="width:1.167em;" width="1.167em"></mspace><mrow><mrow><msup><mi>g</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo lspace="0.502em" rspace="0.502em">−</mo><mrow><mstyle displaystyle="false"><mfrac><msub><mi>κ</mi><mi>d</mi></msub><mn>2</mn></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>θ</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>g</mi><mo lspace="0.558em" rspace="0.558em">≜</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>o</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>ent</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>o</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\max_{\Delta\theta}\ \ g^{\top}\Delta\theta\;-\;\tfrac{\kappa_{d}}{2}\,\Delta\theta^{\top}F_{\beta}\,\Delta\theta,\qquad g\;\triangleq\;\nabla_{\theta}\,\mathbb{E}\!\big[r(x,o)-\lambda_{d}\,C_{\mathrm{ent}}(x,o)\big],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(35)</span></td></tr></tbody>
</table>
<p id="A12.SS0.SSS0.Px3.p1.2" class="ltx_p">whose maximizer is the natural–gradient step</p>
<table id="A12.E36" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A12.E36.m1" class="ltx_Math" alttext="\boxed{\ \Delta\theta^{\star}\;=\;\kappa_{d}^{-1}\,F_{\beta}^{-1}\,g\ }." display="block" intent=":literal"><semantics><mrow><menclose notation="box"><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>θ</mi><mo>⋆</mo></msup></mrow><mo rspace="0.558em">=</mo><mrow><msubsup><mi>κ</mi><mi>d</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>F</mi><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></mrow></menclose><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\boxed{\ \Delta\theta^{\star}\;=\;\kappa_{d}^{-1}\,F_{\beta}^{-1}\,g\ }.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(36)</span></td></tr></tbody>
</table>
</div>
<div id="Thmproposition2" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmproposition2.2" class="ltx_text ltx_font_bold">Proposition 2</span></span><span id="Thmproposition2.3" class="ltx_text ltx_font_bold"> </span>(One–step improvement bound)<span id="Thmproposition2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmproposition2.p1" class="ltx_para ltx_noindent">
<p id="Thmproposition2.p1.1" class="ltx_p"><span id="Thmproposition2.p1.1.1" class="ltx_text ltx_font_italic">Under equation <a href="#A12.E33" title="In KL as a Fisher quadratic. ‣ Appendix L Fisher–Geometry Justification of AEPO ‣ ARES: Multimodal Adaptive Reasoning via Difficulty-Aware Token-Level Entropy Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">33</span></a>, the first–order improvement at <math id="Thmproposition2.p1.m1" class="ltx_Math" alttext="\Delta\theta^{\star}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>θ</mi><mo>⋆</mo></msup></mrow><annotation encoding="application/x-tex">\Delta\theta^{\star}</annotation></semantics></math> satisfies</span></p>
<table id="A12.E37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A12.E37.m1" class="ltx_Math" alttext="\Delta J\;\triangleq\;g^{\top}\Delta\theta^{\star}\;-\;\tfrac{\kappa_{d}}{2}\,{\Delta\theta^{\star}}^{\top}F_{\beta}\Delta\theta^{\star}\;=\;\frac{1}{2\kappa_{d}}\;g^{\top}F_{\beta}^{-1}g." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>J</mi></mrow><mo lspace="0.558em" rspace="0.558em">≜</mo><mrow><mrow><msup><mi>g</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>θ</mi><mo>⋆</mo></msup></mrow><mo rspace="0.502em">−</mo><mrow><mstyle displaystyle="false"><mfrac><msub><mi>κ</mi><mi>d</mi></msub><mn>2</mn></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>θ</mi><mrow></mrow><mo>⋆</mo><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>θ</mi><mo>⋆</mo></msup></mrow></mrow><mo rspace="0.558em">=</mo><mrow><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>d</mi></msub></mrow></mfrac><mo lspace="0.280em" rspace="0em">​</mo><msup><mi>g</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>F</mi><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Delta J\;\triangleq\;g^{\top}\Delta\theta^{\star}\;-\;\tfrac{\kappa_{d}}{2}\,{\Delta\theta^{\star}}^{\top}F_{\beta}\Delta\theta^{\star}\;=\;\frac{1}{2\kappa_{d}}\;g^{\top}F_{\beta}^{-1}g.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(37)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A12.SS0.SSS0.Px3.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A12.SS0.SSS0.Px3.p2" class="ltx_para">
<p id="A12.SS0.SSS0.Px3.p2.1" class="ltx_p"><span id="A12.SS0.SSS0.Px3.p2.1.1" class="ltx_text">Plug equation <a href="#A12.E36" title="In Dual/Lagrangian form and natural gradient. ‣ Appendix L Fisher–Geometry Justification of AEPO ‣ ARES: Multimodal Adaptive Reasoning via Difficulty-Aware Token-Level Entropy Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">36</span></a> into equation <a href="#A12.E35" title="In Dual/Lagrangian form and natural gradient. ‣ Appendix L Fisher–Geometry Justification of AEPO ‣ ARES: Multimodal Adaptive Reasoning via Difficulty-Aware Token-Level Entropy Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">35</span></a>.
∎</span></p>
</div>
</div>
</section>
<section id="A12.SS0.SSS0.Px4" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Why token–adaptive relaxation helps.</h5>

<div id="A12.SS0.SSS0.Px4.p1" class="ltx_para ltx_noindent">
<p id="A12.SS0.SSS0.Px4.p1.1" class="ltx_p">Inside validated reasoning windows we choose <math id="A12.SS0.SSS0.Px4.p1.m1" class="ltx_Math" alttext="\rho_{t}&lt;1" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\rho_{t}&lt;1</annotation></semantics></math>, which reduces the local curvature
contribution in <math id="A12.SS0.SSS0.Px4.p1.m2" class="ltx_Math" alttext="F_{\beta}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>β</mi></msub><annotation encoding="application/x-tex">F_{\beta}</annotation></semantics></math> on those tokens. Simultaneously, the entropy–augmented advantage
increases the corresponding components of <math id="A12.SS0.SSS0.Px4.p1.m3" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> only where <math id="A12.SS0.SSS0.Px4.p1.m4" class="ltx_math_unparsed" alttext="\bar{H}_{t:w}\geq\vartheta" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>H</mi><mo>¯</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>w</mi></mrow></msub><mo>≥</mo><mi>ϑ</mi></mrow><annotation encoding="application/x-tex">\bar{H}_{t:w}\geq\vartheta</annotation></semantics></math>.
Because the gain equation <a href="#A12.E37" title="In Proposition 2 (One–step improvement bound). ‣ Dual/Lagrangian form and natural gradient. ‣ Appendix L Fisher–Geometry Justification of AEPO ‣ ARES: Multimodal Adaptive Reasoning via Difficulty-Aware Token-Level Entropy Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">37</span></a> increases when (i) <math id="A12.SS0.SSS0.Px4.p1.m5" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> has larger energy and
(ii) the metric penalty <math id="A12.SS0.SSS0.Px4.p1.m6" class="ltx_Math" alttext="F_{\beta}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>β</mi></msub><annotation encoding="application/x-tex">F_{\beta}</annotation></semantics></math> is smaller in the same directions, AEPO aligns a boosted
gradient with a relaxed Fisher metric on reasoning windows.</p>
</div>
<div id="Thmcorollary1" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmcorollary1.2" class="ltx_text ltx_font_bold">Corollary 1</span></span><span id="Thmcorollary1.3" class="ltx_text ltx_font_bold"> </span>(Directional benefit of window relaxation)<span id="Thmcorollary1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmcorollary1.p1" class="ltx_para">
<p id="Thmcorollary1.p1.1" class="ltx_p"><span id="Thmcorollary1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmcorollary1.p1.m1" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> be a unit vector supported on window tokens. If <math id="Thmcorollary1.p1.m2" class="ltx_Math" alttext="\rho_{t}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\rho_{t}</annotation></semantics></math> is reduced on these tokens,
then <math id="Thmcorollary1.p1.m3" class="ltx_Math" alttext="u^{\top}F_{\beta}u" display="inline" intent=":literal"><semantics><mrow><msup><mi>u</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><annotation encoding="application/x-tex">u^{\top}F_{\beta}u</annotation></semantics></math> decreases while <math id="Thmcorollary1.p1.m4" class="ltx_Math" alttext="u^{\top}g" display="inline" intent=":literal"><semantics><mrow><msup><mi>u</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><annotation encoding="application/x-tex">u^{\top}g</annotation></semantics></math> increases under entropy shaping. Hence the
directional contribution <math id="Thmcorollary1.p1.m5" class="ltx_Math" alttext="(u^{\top}g)^{2}/(2\kappa_{d}\,u^{\top}F_{\beta}u)" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>u</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(u^{\top}g)^{2}/(2\kappa_{d}\,u^{\top}F_{\beta}u)</annotation></semantics></math> to
equation <a href="#A12.E37" title="In Proposition 2 (One–step improvement bound). ‣ Dual/Lagrangian form and natural gradient. ‣ Appendix L Fisher–Geometry Justification of AEPO ‣ ARES: Multimodal Adaptive Reasoning via Difficulty-Aware Token-Level Entropy Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">37</span></a> strictly increases, improving sample efficiency on reasoning segments.</span></p>
</div>
</div>
</section>
<section id="A12.SS0.SSS0.Px5" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Why use <em id="A12.SS0.SSS0.Px5.1" class="ltx_emph ltx_font_italic">non–window</em> KL for control.</h5>

<div id="A12.SS0.SSS0.Px5.p1" class="ltx_para ltx_noindent">
<p id="A12.SS0.SSS0.Px5.p1.1" class="ltx_p">The KL controller adjusts <math id="A12.SS0.SSS0.Px5.p1.m1" class="ltx_Math" alttext="\kappa_{d}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mi>d</mi></msub><annotation encoding="application/x-tex">\kappa_{d}</annotation></semantics></math> to match the per–bucket target <math id="A12.SS0.SSS0.Px5.p1.m2" class="ltx_Math" alttext="\delta_{d}" display="inline" intent=":literal"><semantics><msub><mi>δ</mi><mi>d</mi></msub><annotation encoding="application/x-tex">\delta_{d}</annotation></semantics></math>.
If we fed the controller with the already–relaxed (window–weighted) KL, the true
natural length <math id="A12.SS0.SSS0.Px5.p1.m3" class="ltx_Math" alttext="\tfrac{1}{2}\Delta\theta^{\top}(\tfrac{1}{L}\sum_{t}F_{t})\Delta\theta" display="inline" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>θ</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mfrac><mn>1</mn><mi>L</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∑</mo><mi>t</mi></msub><msub><mi>F</mi><mi>t</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><annotation encoding="application/x-tex">\tfrac{1}{2}\Delta\theta^{\top}(\tfrac{1}{L}\sum_{t}F_{t})\Delta\theta</annotation></semantics></math> could be
under–estimated, risking drift. Using a non–window (or down–weighted–window) control signal
<math id="A12.SS0.SSS0.Px5.p1.m4" class="ltx_Math" alttext="\mathrm{KL}_{\text{ctrl}}" display="inline" intent=":literal"><semantics><msub><mi>KL</mi><mtext>ctrl</mtext></msub><annotation encoding="application/x-tex">\mathrm{KL}_{\text{ctrl}}</annotation></semantics></math> stabilizes the global trust region while keeping local relaxation intact.</p>
</div>
</section>
<section id="A12.SS0.SSS0.Px6" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Per–bucket decoupling: shape vs. scale.</h5>

<div id="A12.SS0.SSS0.Px6.p1" class="ltx_para ltx_noindent">
<p id="A12.SS0.SSS0.Px6.p1.1" class="ltx_p">The token weights <math id="A12.SS0.SSS0.Px6.p1.m1" class="ltx_Math" alttext="\beta_{d,t}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mrow><mi>d</mi><mo>,</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">\beta_{d,t}</annotation></semantics></math> determine the <em id="A12.SS0.SSS0.Px6.p1.1.1" class="ltx_emph ltx_font_italic">shape</em> of the metric <math id="A12.SS0.SSS0.Px6.p1.m2" class="ltx_Math" alttext="F_{\beta}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>β</mi></msub><annotation encoding="application/x-tex">F_{\beta}</annotation></semantics></math>
(where to allow deviation), whereas the multiplier <math id="A12.SS0.SSS0.Px6.p1.m3" class="ltx_Math" alttext="\kappa_{d}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mi>d</mi></msub><annotation encoding="application/x-tex">\kappa_{d}</annotation></semantics></math> determines its <em id="A12.SS0.SSS0.Px6.p1.1.2" class="ltx_emph ltx_font_italic">scale</em>
(how much to deviate) for each difficulty bucket. This yields a well–conditioned,
two–time–scale scheme: slow adaptation of <math id="A12.SS0.SSS0.Px6.p1.m4" class="ltx_Math" alttext="\kappa_{d}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mi>d</mi></msub><annotation encoding="application/x-tex">\kappa_{d}</annotation></semantics></math> (budget tracking) and fast ascent in
equation <a href="#A12.E35" title="In Dual/Lagrangian form and natural gradient. ‣ Appendix L Fisher–Geometry Justification of AEPO ‣ ARES: Multimodal Adaptive Reasoning via Difficulty-Aware Token-Level Entropy Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">35</span></a>.</p>
</div>
<div id="A12.SS0.SSS0.Px6.p2" class="ltx_para ltx_noindent">
<p id="A12.SS0.SSS0.Px6.p2.1" class="ltx_p">AEPO corresponds to a per–difficulty, token–reweighted natural–gradient update</p>
<table id="A12.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A12.Ex21.m1" class="ltx_Math" alttext="\Delta\theta^{\star}\;=\;\kappa_{d}^{-1}\Big(\tfrac{1}{L}\sum_{t}\beta_{d,t}\,F_{t}\Big)^{-1}\underbrace{\nabla_{\theta}\mathbb{E}\!\big[r-\lambda_{d}\,C_{\mathrm{ent}}\big]}_{\text{entropy–shaped }g}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>θ</mi><mo>⋆</mo></msup></mrow><mo rspace="0.558em">=</mo><mrow><msubsup><mi>κ</mi><mi>d</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mi>L</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mi>t</mi></munder><mrow><msub><mi>β</mi><mrow><mi>d</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>t</mi></msub></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><munder><munder accentunder="true"><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mi>r</mi><mo>−</mo><mrow><msub><mi>λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>ent</mi></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mrow><mtext>entropy–shaped </mtext><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></munder></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\Delta\theta^{\star}\;=\;\kappa_{d}^{-1}\Big(\tfrac{1}{L}\sum_{t}\beta_{d,t}\,F_{t}\Big)^{-1}\underbrace{\nabla_{\theta}\mathbb{E}\!\big[r-\lambda_{d}\,C_{\mathrm{ent}}\big]}_{\text{entropy–shaped }g},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A12.SS0.SSS0.Px6.p2.2" class="ltx_p">with <math id="A12.SS0.SSS0.Px6.p2.m1" class="ltx_Math" alttext="\beta_{d,t}=\beta_{d}\rho_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mrow><mi>d</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><mrow><msub><mi>β</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\beta_{d,t}=\beta_{d}\rho_{t}</annotation></semantics></math> relaxing KL strictly within high–entropy windows and
<math id="A12.SS0.SSS0.Px6.p2.m2" class="ltx_Math" alttext="\kappa_{d}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mi>d</mi></msub><annotation encoding="application/x-tex">\kappa_{d}</annotation></semantics></math> controlled by a non–window KL signal. Proposition <a href="#Thmproposition2" title="Proposition 2 (One–step improvement bound). ‣ Dual/Lagrangian form and natural gradient. ‣ Appendix L Fisher–Geometry Justification of AEPO ‣ ARES: Multimodal Adaptive Reasoning via Difficulty-Aware Token-Level Entropy Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>
shows this maximizes <math id="A12.SS0.SSS0.Px6.p2.m3" class="ltx_Math" alttext="g^{\top}F_{\beta}^{-1}g/(2\kappa_{d})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>g</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>F</mi><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>d</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g^{\top}F_{\beta}^{-1}g/(2\kappa_{d})</annotation></semantics></math> by (i) amplifying <math id="A12.SS0.SSS0.Px6.p2.m4" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> where
the model is genuinely reasoning and (ii) reducing curvature along the same directions,
while a stable bucket–wise trust region ensures controlled deviation from
<math id="A12.SS0.SSS0.Px6.p2.m5" class="ltx_Math" alttext="\pi_{\mathrm{ref}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>ref</mi></msub><annotation encoding="application/x-tex">\pi_{\mathrm{ref}}</annotation></semantics></math>.</p>
</div>
</section>
</section>
<section id="A13" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix M </span>Case Study</h2>

<div id="A13.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A13.p1.pic1" class="ltx_picture" height="257.31" overflow="visible" version="1.1" viewBox="0 0 550 257.31" width="550"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,257.31) matrix(1 0 0 -1 0 0)"><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" fill-opacity="0.5" stroke="#808080" stroke-opacity="0.5"><path style="stroke:none" d="M 3.54 -3.54 L 3.54 253.77 L 553.54 253.77 L 553.54 -3.54 Z"></path></g><g style="--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0"><path style="stroke:none" d="M 0 0 L 0 11.81 L 0 23.62 L 0 35.43 L 0 47.24 L 0 59.06 L 0 70.87 L 0 82.68 L 0 94.49 L 0 106.3 L 0 118.11 L 0 129.92 L 0 141.73 L 0 153.54 L 0 165.35 L 0 177.17 L 0 188.98 L 0 200.79 L 0 212.6 L 0 224.41 L 0 236.22 L 0 248.03 L 0 257.31 L 11.81 257.31 L 23.62 257.31 L 35.43 257.31 L 47.24 257.31 L 59.06 257.31 L 70.87 257.31 L 82.68 257.31 L 94.49 257.31 L 106.3 257.31 L 118.11 257.31 L 129.92 257.31 L 141.73 257.31 L 153.54 257.31 L 165.35 257.31 L 177.17 257.31 L 188.98 257.31 L 200.79 257.31 L 212.6 257.31 L 224.41 257.31 L 236.22 257.31 L 248.03 257.31 L 259.84 257.31 L 271.65 257.31 L 283.46 257.31 L 295.28 257.31 L 307.09 257.31 L 318.9 257.31 L 330.71 257.31 L 342.52 257.31 L 354.33 257.31 L 366.14 257.31 L 377.95 257.31 L 389.76 257.31 L 401.57 257.31 L 413.39 257.31 L 425.2 257.31 L 437.01 257.31 L 448.82 257.31 L 460.63 257.31 L 472.44 257.31 L 484.25 257.31 L 496.06 257.31 L 507.87 257.31 L 519.69 257.31 L 531.5 257.31 L 543.31 257.31 L 550 257.31 L 550 245.5 L 550 233.69 L 550 221.88 L 550 210.07 L 550 198.26 L 550 186.45 L 550 174.64 L 550 162.83 L 550 151.02 L 550 139.2 L 550 127.39 L 550 115.58 L 550 103.77 L 550 91.96 L 550 80.15 L 550 68.34 L 550 56.53 L 550 44.72 L 550 32.91 L 550 21.09 L 550 9.28 L 550 0 L 538.19 0 L 526.38 0 L 514.57 0 L 502.76 0 L 490.94 0 L 479.13 0 L 467.32 0 L 455.51 0 L 443.7 0 L 431.89 0 L 420.08 0 L 408.27 0 L 396.46 0 L 384.65 0 L 372.83 0 L 361.02 0 L 349.21 0 L 337.4 0 L 325.59 0 L 313.78 0 L 301.97 0 L 290.16 0 L 278.35 0 L 266.54 0 L 254.72 0 L 242.91 0 L 231.1 0 L 219.29 0 L 207.48 0 L 195.67 0 L 183.86 0 L 172.05 0 L 160.24 0 L 148.43 0 L 136.61 0 L 124.8 0 L 112.99 0 L 101.18 0 L 89.37 0 L 77.56 0 L 65.75 0 L 53.94 0 L 42.13 0 L 30.31 0 L 18.5 0 L 6.69 0 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 1.11 1.11 L 1.11 256.21 L 548.89 256.21 L 548.89 1.11 Z"></path></g><g style="--ltx-fg-color:#000000;" color="#000000" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><path style="fill:none" d="M 0.55 0.55 L 0.55 256.76 L 549.45 256.76 L 549.45 0.55 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 18.88 16.11)"><foreignObject style="--ltx-fo-width:37.02em;--ltx-fo-height:16.27em;--ltx-fo-depth:0em;font-size:10pt;" height="225.09" overflow="visible" transform="matrix(1 0 0 -1 0 225.09)" width="512.25"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A13.p1.pic1.1" class="ltx_inline-sectional-block ltx_minipage">
                  
<section id="A13.SS0.SSSx1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection" style="--ltx-fg-color:#000000;">Question</h4>

<span id="A13.SS0.SSSx1.p1" class="ltx_para ltx_noindent">
<span id="A13.SS0.SSSx1.p1.1" class="ltx_p"><span id="A13.SS0.SSSx1.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">As shown in the figure, in the right triangle one acute angle is </span><math id="A13.SS0.SSSx1.p1.m1" class="ltx_Math" alttext="60^{\circ}" display="inline" intent=":literal"><semantics><msup><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">60</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∘</mo></msup><annotation encoding="application/x-tex">60^{\circ}</annotation></semantics></math><span id="A13.SS0.SSSx1.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> and the side opposite this angle has length </span><math id="A13.SS0.SSSx1.p1.m2" class="ltx_Math" alttext="6\sqrt{3}" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">6</mn><mo lspace="0em" rspace="0em">​</mo><msqrt style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msqrt></mrow><annotation encoding="application/x-tex">6\sqrt{3}</annotation></semantics></math><span id="A13.SS0.SSSx1.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">. Find the hypotenuse </span><math id="A13.SS0.SSSx1.p1.m3" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math><span id="A13.SS0.SSSx1.p1.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">.</span></span>
</span>
<span id="A13.SS0.SSSx1.p2" class="ltx_para"><span class="ltx_inline-block"><svg id="A13.SS0.SSSx1.pic1" class="ltx_picture ltx_centering" color="#000000" height="161.59" overflow="visible" version="1.1" viewBox="0 0 171.15 161.59" width="171.15"><g transform="translate(0,161.59) matrix(1 0 0 -1 0 0) translate(29.7,0) translate(0,19.03)"><g style="--ltx-stroke-color:#000099;--ltx-fill-color:#000099;--ltx-fg-color:#000099;" color="#000099" fill="#000099" stroke="#000099" stroke-width="1.2pt"><path style="fill:none" d="M 0 0 L 118.11 0 L 118.11 141.73 Z"></path></g><g style="--ltx-stroke-color:#FF00FF;--ltx-fill-color:#FF00FF;--ltx-fg-color:#FF00FF;" color="#FF00FF" fill="#FF00FF" stroke="#FF00FF" stroke-width="0.8pt"><path style="fill:none" d="M 118.11 0 M 118.11 0 L 118.11 9.84 L 127.95 9.84 L 127.95 0 Z M 127.95 9.84"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 55.1 -10.85)"><foreignObject style="--ltx-fo-width:0.57em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="7.91"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A13.SS0.SSSx1.pic1.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 52.79 76.32)"><foreignObject style="--ltx-fo-width:0.53em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.19em;font-size:10pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="7.28"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A13.SS0.SSSx1.pic1.m2" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 123 66.41)"><foreignObject style="--ltx-fo-width:1em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="13.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A13.SS0.SSSx1.pic1.m3" class="ltx_Math" alttext="6\sqrt{3}" display="inline" intent=":literal"><semantics><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mn>3</mn></msqrt></mrow><annotation encoding="application/x-tex">6\sqrt{3}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -25.09 -14.42)"><foreignObject style="--ltx-fo-width:1.46em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.53)" width="20.2"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A13.SS0.SSSx1.pic1.m4" class="ltx_Math" alttext="60^{\circ}" display="inline" intent=":literal"><semantics><msup><mn>60</mn><mo>∘</mo></msup><annotation encoding="application/x-tex">60^{\circ}</annotation></semantics></math></span></span></foreignObject></g></g></g></svg></span>
</span>
<span id="A13.SS0.SSSx1.p3" class="ltx_para">
<span id="A13.SS0.SSSx1.p3.1" class="ltx_p"><span id="A13.SS0.SSSx1.p3.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Answer:</span><span id="A13.SS0.SSSx1.p3.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><math id="A13.SS0.SSSx1.p3.m1" class="ltx_Math" alttext="\boxed{12}" display="inline" intent=":literal"><semantics><menclose notation="box"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">12</mn></menclose><annotation encoding="application/x-tex">\boxed{12}</annotation></semantics></math></span>
</span>
</section>
                </span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A13.p2" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A13.p2.pic1" class="ltx_picture" height="116.48" overflow="visible" version="1.1" viewBox="0 0 550 116.48" width="550"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,116.48) matrix(1 0 0 -1 0 0)"><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" fill-opacity="0.5" stroke="#808080" stroke-opacity="0.5"><path style="stroke:none" d="M 3.54 -3.54 L 3.54 112.94 L 553.54 112.94 L 553.54 -3.54 Z"></path></g><g style="--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0"><path style="stroke:none" d="M 0 0 L 0 116.48 L 550 116.48 L 550 0 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 1.11 1.11 L 1.11 115.37 L 548.89 115.37 L 548.89 1.11 Z"></path></g><g style="--ltx-stroke-color:#FF0000;--ltx-fill-color:#FF0000;" fill="#FF0000" stroke="#FF0000" transform="matrix(1.0 0.0 0.0 1.0 463.45 101.98)"><foreignObject style="--ltx-fo-width:5.24em;--ltx-fo-height:0.6em;--ltx-fo-depth:0em;font-size:11.5pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="83.43"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A13.p2.pic1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">Tokens: 243</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 18.88 21.57)"><foreignObject style="--ltx-fo-width:37.02em;--ltx-fo-height:5.49em;--ltx-fo-depth:0.19em;font-size:10pt;" height="78.72" overflow="visible" transform="matrix(1 0 0 -1 0 76.03)" width="512.25"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A13.p2.pic1.2" class="ltx_inline-sectional-block ltx_minipage">
                  
<section id="A13.SS0.SSSx2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection" style="--ltx-fg-color:#000000;">Our Adaptive Model Solution for easy question</h4>

<span id="A13.SS0.SSSx2.p1" class="ltx_para ltx_noindent">
<span id="A13.SS0.SSSx2.p1.1" class="ltx_p"><span id="A13.SS0.SSSx2.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Use the sine ratio for the </span><math id="A13.SS0.SSSx2.p1.m1" class="ltx_Math" alttext="60^{\circ}" display="inline" intent=":literal"><semantics><msup><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">60</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∘</mo></msup><annotation encoding="application/x-tex">60^{\circ}</annotation></semantics></math><span id="A13.SS0.SSSx2.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> angle:</span></span>
<span id="A13.Ex22" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A13.Ex22.m1" class="ltx_Math" alttext="\sin 60^{\circ}=\frac{\text{opposite}}{\text{hypotenuse}}=\frac{6\sqrt{3}}{y}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">sin</mi><mo lspace="0.167em">⁡</mo><msup><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">60</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∘</mo></msup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">opposite</mtext><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">hypotenuse</mtext></mfrac><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">6</mn><mo lspace="0em" rspace="0em">​</mo><msqrt style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msqrt></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi></mfrac></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\sin 60^{\circ}=\frac{\text{opposite}}{\text{hypotenuse}}=\frac{6\sqrt{3}}{y}.</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span>
<span id="A13.SS0.SSSx2.p2" class="ltx_para ltx_noindent">
<span id="A13.SS0.SSSx2.p2.1" class="ltx_p"><span id="A13.SS0.SSSx2.p2.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Since </span><math id="A13.SS0.SSSx2.p2.m1" class="ltx_Math" alttext="\sin 60^{\circ}=\tfrac{\sqrt{3}}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">sin</mi><mo lspace="0.167em">⁡</mo><msup><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">60</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∘</mo></msup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msqrt style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msqrt><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></mfrac></mrow><annotation encoding="application/x-tex">\sin 60^{\circ}=\tfrac{\sqrt{3}}{2}</annotation></semantics></math><span id="A13.SS0.SSSx2.p2.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">, we have</span></span>
<span id="A13.Ex23" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A13.Ex23.m1" class="ltx_Math" alttext="\frac{\sqrt{3}}{2}=\frac{6\sqrt{3}}{y}\quad\Longrightarrow\quad y=\frac{6\sqrt{3}\cdot 2}{\sqrt{3}}=12." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msqrt style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msqrt><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></mfrac><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">6</mn><mo lspace="0em" rspace="0em">​</mo><msqrt style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msqrt></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi></mfrac></mrow><mspace style="width:1em;" width="1em"></mspace><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">⟹</mo><mspace style="width:1em;" width="1em"></mspace><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">6</mn><mo lspace="0em" rspace="0em">​</mo><msqrt style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msqrt></mrow><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⋅</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></mrow><msqrt style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msqrt></mfrac><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">12</mn></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\frac{\sqrt{3}}{2}=\frac{6\sqrt{3}}{y}\quad\Longrightarrow\quad y=\frac{6\sqrt{3}\cdot 2}{\sqrt{3}}=12.</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span>
<span id="A13.SS0.SSSx2.p3" class="ltx_para">
<span id="A13.Ex24" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A13.Ex24.m1" class="ltx_Math" alttext="\boxed{y=12}" display="block" intent=":literal"><semantics><menclose notation="box"><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">12</mn></mrow></menclose><annotation encoding="application/x-tex">\boxed{y=12}</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span>
</section>
                </span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A13.p3" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A13.p3.pic1" class="ltx_picture" height="295.12" overflow="visible" version="1.1" viewBox="0 0 550 295.12" width="550"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,295.12) matrix(1 0 0 -1 0 0)"><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" fill-opacity="0.5" stroke="#808080" stroke-opacity="0.5"><path style="stroke:none" d="M 3.54 -3.54 L 3.54 291.58 L 553.54 291.58 L 553.54 -3.54 Z"></path></g><g style="--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0"><path style="stroke:none" d="M 0 0 L 0 11.81 L 0 23.62 L 0 35.43 L 0 47.24 L 0 59.06 L 0 70.87 L 0 82.68 L 0 94.49 L 0 106.3 L 0 118.11 L 0 129.92 L 0 141.73 L 0 153.54 L 0 165.35 L 0 177.17 L 0 188.98 L 0 200.79 L 0 212.6 L 0 224.41 L 0 236.22 L 0 248.03 L 0 259.84 L 0 271.65 L 0 283.46 L 0 295.12 L 11.81 295.12 L 23.62 295.12 L 35.43 295.12 L 47.24 295.12 L 59.06 295.12 L 70.87 295.12 L 82.68 295.12 L 94.49 295.12 L 106.3 295.12 L 118.11 295.12 L 129.92 295.12 L 141.73 295.12 L 153.54 295.12 L 165.35 295.12 L 177.17 295.12 L 188.98 295.12 L 200.79 295.12 L 212.6 295.12 L 224.41 295.12 L 236.22 295.12 L 248.03 295.12 L 259.84 295.12 L 271.65 295.12 L 283.46 295.12 L 295.28 295.12 L 307.09 295.12 L 318.9 295.12 L 330.71 295.12 L 342.52 295.12 L 354.33 295.12 L 366.14 295.12 L 377.95 295.12 L 389.76 295.12 L 401.57 295.12 L 413.39 295.12 L 425.2 295.12 L 437.01 295.12 L 448.82 295.12 L 460.63 295.12 L 472.44 295.12 L 484.25 295.12 L 496.06 295.12 L 507.87 295.12 L 519.69 295.12 L 531.5 295.12 L 543.31 295.12 L 550 295.12 L 550 283.31 L 550 271.5 L 550 259.69 L 550 247.88 L 550 236.06 L 550 224.25 L 550 212.44 L 550 200.63 L 550 188.82 L 550 177.01 L 550 165.2 L 550 153.39 L 550 141.58 L 550 129.76 L 550 117.95 L 550 106.14 L 550 94.33 L 550 82.52 L 550 70.71 L 550 58.9 L 550 47.09 L 550 35.28 L 550 23.47 L 550 11.65 L 550 0 L 538.19 0 L 526.38 0 L 514.57 0 L 502.76 0 L 490.94 0 L 479.13 0 L 467.32 0 L 455.51 0 L 443.7 0 L 431.89 0 L 420.08 0 L 408.27 0 L 396.46 0 L 384.65 0 L 372.83 0 L 361.02 0 L 349.21 0 L 337.4 0 L 325.59 0 L 313.78 0 L 301.97 0 L 290.16 0 L 278.35 0 L 266.54 0 L 254.72 0 L 242.91 0 L 231.1 0 L 219.29 0 L 207.48 0 L 195.67 0 L 183.86 0 L 172.05 0 L 160.24 0 L 148.43 0 L 136.61 0 L 124.8 0 L 112.99 0 L 101.18 0 L 89.37 0 L 77.56 0 L 65.75 0 L 53.94 0 L 42.13 0 L 30.31 0 L 18.5 0 L 6.69 0 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 1.11 1.11 L 1.11 294.01 L 548.89 294.01 L 548.89 1.11 Z"></path></g><g style="--ltx-fg-color:#000000;" color="#000000" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><path style="fill:none" d="M 0.55 0.55 L 0.55 294.57 L 549.45 294.57 L 549.45 0.55 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 18.88 16.11)"><foreignObject style="--ltx-fo-width:37.02em;--ltx-fo-height:19em;--ltx-fo-depth:0em;font-size:10pt;" height="262.9" overflow="visible" transform="matrix(1 0 0 -1 0 262.9)" width="512.25"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A13.p3.pic1.1" class="ltx_inline-sectional-block ltx_minipage">
                  
<section id="A13.SS0.SSSx3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection" style="--ltx-fg-color:#000000;">Question</h4>

<span id="A13.SS0.SSSx3.p1" class="ltx_para ltx_noindent">
<span id="A13.SS0.SSSx3.p1.1" class="ltx_p"><span id="A13.SS0.SSSx3.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">The sum of the circumferences of circles </span><math id="A13.SS0.SSSx3.p1.m1" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math><span id="A13.SS0.SSSx3.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">, </span><math id="A13.SS0.SSSx3.p1.m2" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math><span id="A13.SS0.SSSx3.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">, and </span><math id="A13.SS0.SSSx3.p1.m3" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math><span id="A13.SS0.SSSx3.p1.1.4" class="ltx_text" style="--ltx-fg-color:#000000;"> is </span><math id="A13.SS0.SSSx3.p1.m4" class="ltx_Math" alttext="56\pi" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">56</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi></mrow><annotation encoding="application/x-tex">56\pi</annotation></semantics></math><span id="A13.SS0.SSSx3.p1.1.5" class="ltx_text" style="--ltx-fg-color:#000000;"> units.
Their radii are marked as </span><math id="A13.SS0.SSSx3.p1.m5" class="ltx_Math" alttext="r_{H}=x" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">H</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow><annotation encoding="application/x-tex">r_{H}=x</annotation></semantics></math><span id="A13.SS0.SSSx3.p1.1.6" class="ltx_text" style="--ltx-fg-color:#000000;">, </span><math id="A13.SS0.SSSx3.p1.m6" class="ltx_Math" alttext="r_{J}=2x" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">J</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow></mrow><annotation encoding="application/x-tex">r_{J}=2x</annotation></semantics></math><span id="A13.SS0.SSSx3.p1.1.7" class="ltx_text" style="--ltx-fg-color:#000000;">, </span><math id="A13.SS0.SSSx3.p1.m7" class="ltx_Math" alttext="r_{K}=4x" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow></mrow><annotation encoding="application/x-tex">r_{K}=4x</annotation></semantics></math><span id="A13.SS0.SSSx3.p1.1.8" class="ltx_text" style="--ltx-fg-color:#000000;">, and the three circles are
pairwise tangent externally. Find the distance </span><math id="A13.SS0.SSSx3.p1.m8" class="ltx_Math" alttext="KJ" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">J</mi></mrow><annotation encoding="application/x-tex">KJ</annotation></semantics></math><span id="A13.SS0.SSSx3.p1.1.9" class="ltx_text" style="--ltx-fg-color:#000000;"> between the centers of circles </span><math id="A13.SS0.SSSx3.p1.m9" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math><span id="A13.SS0.SSSx3.p1.1.10" class="ltx_text" style="--ltx-fg-color:#000000;"> and </span><math id="A13.SS0.SSSx3.p1.m10" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math><span id="A13.SS0.SSSx3.p1.1.11" class="ltx_text" style="--ltx-fg-color:#000000;">.</span></span>
</span>
<span id="A13.SS0.SSSx3.p2" class="ltx_para"><img src="2510.08457v1/iclr2026/images/hard.png" id="A13.SS0.SSSx3.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:281/216;" width="281" height="216" alt="[Uncaptioned image]">
</span>
</section>
                </span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A13.p4" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A13.p4.pic1" class="ltx_picture" height="728.15" overflow="visible" version="1.1" viewBox="0 0 550 728.15" width="550"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,728.15) matrix(1 0 0 -1 0 0)"><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" fill-opacity="0.5" stroke="#808080" stroke-opacity="0.5"><path style="stroke:none" d="M 3.54 -3.54 L 3.54 724.61 L 553.54 724.61 L 553.54 -3.54 Z"></path></g><g style="--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0"><path style="stroke:none" d="M 0 0 L 0 728.15 L 550 728.15 L 550 0 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 1.11 1.11 L 1.11 727.04 L 548.89 727.04 L 548.89 1.11 Z"></path></g><g style="--ltx-stroke-color:#FF0000;--ltx-fill-color:#FF0000;" fill="#FF0000" stroke="#FF0000" transform="matrix(1.0 0.0 0.0 1.0 455.5 713.65)"><foreignObject style="--ltx-fo-width:5.74em;--ltx-fo-height:0.6em;--ltx-fo-depth:0em;font-size:11.5pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="91.38"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A13.p4.pic1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">Tokens: 4173</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 18.88 18.88)"><foreignObject style="--ltx-fo-width:37.02em;--ltx-fo-height:49.89em;--ltx-fo-depth:0em;font-size:10pt;" height="690.4" overflow="visible" transform="matrix(1 0 0 -1 0 690.4)" width="512.25"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A13.p4.pic1.2" class="ltx_inline-sectional-block ltx_minipage">
                  
<section id="A13.SS0.SSSx4" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection" style="--ltx-fg-color:#000000;">Our Adaptive Model Solution for hard question</h4>

<span id="A13.SS0.SSSx4.p1" class="ltx_para ltx_noindent">
<span id="A13.SS0.SSSx4.p1.1" class="ltx_p"><span id="A13.SS0.SSSx4.p1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#0000FF;">First</span><span id="A13.SS0.SSSx4.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">, recall that the circumference of a circle is </span><math id="A13.SS0.SSSx4.p1.m1" class="ltx_Math" alttext="2\pi r" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></mrow><annotation encoding="application/x-tex">2\pi r</annotation></semantics></math><span id="A13.SS0.SSSx4.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">.
The problem states that the sum of the circumferences of circles </span><math id="A13.SS0.SSSx4.p1.m2" class="ltx_Math" alttext="H,J,K" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">H</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">J</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></mrow><annotation encoding="application/x-tex">H,J,K</annotation></semantics></math><span id="A13.SS0.SSSx4.p1.1.4" class="ltx_text" style="--ltx-fg-color:#000000;"> is </span><math id="A13.SS0.SSSx4.p1.m3" class="ltx_Math" alttext="56\pi" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">56</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi></mrow><annotation encoding="application/x-tex">56\pi</annotation></semantics></math><span id="A13.SS0.SSSx4.p1.1.5" class="ltx_text" style="--ltx-fg-color:#000000;">, so</span></span>
<span id="A13.Ex25" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A13.Ex25.m1" class="ltx_Math" alttext="2\pi(r_{H}+r_{J}+r_{K})=56\pi\;\Longrightarrow\;r_{H}+r_{J}+r_{K}=28." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">H</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">J</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">56</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi></mrow><mo style="--ltx-fg-color:#000000;" lspace="0.558em" mathcolor="#000000" rspace="0.558em" stretchy="false">⟹</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">H</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">J</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">28</mn></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">2\pi(r_{H}+r_{J}+r_{K})=56\pi\;\Longrightarrow\;r_{H}+r_{J}+r_{K}=28.</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span>
<span id="A13.SS0.SSSx4.p2" class="ltx_para ltx_noindent">
<span id="A13.SS0.SSSx4.p2.1" class="ltx_p"><span id="A13.SS0.SSSx4.p2.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">At this point</span><span id="A13.SS0.SSSx4.p2.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">, I examined the diagram and noticed the labels </span><math id="A13.SS0.SSSx4.p2.m1" class="ltx_Math" alttext="4x,\,x,\,2x" display="inline" intent=":literal"><semantics><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.337em">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000"> 2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow></mrow><annotation encoding="application/x-tex">4x,\,x,\,2x</annotation></semantics></math><span id="A13.SS0.SSSx4.p2.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">.
I hesitated: </span><span id="A13.SS0.SSSx4.p2.1.4" class="ltx_text" style="--ltx-fg-color:#FF0000;">are these radii, or are they distances between centers?</span><span id="A13.SS0.SSSx4.p2.1.5" class="ltx_text" style="--ltx-fg-color:#000000;">
If interpreted as center distances, then</span></span>
<span id="A13.Ex26" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A13.Ex26.m1" class="ltx_Math" alttext="KH=4x,\quad HJ=x,\quad JK=2x," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">H</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="1.167em">,</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">H</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">J</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="1.167em">,</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">J</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">KH=4x,\quad HJ=x,\quad JK=2x,</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
<span id="A13.SS0.SSSx4.p2.2" class="ltx_p"><span id="A13.SS0.SSSx4.p2.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">but this quickly fails because </span><math id="A13.SS0.SSSx4.p2.m2" class="ltx_Math" alttext="x+2x=3x&lt;4x" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow></mrow><annotation encoding="application/x-tex">x+2x=3x&lt;4x</annotation></semantics></math><span id="A13.SS0.SSSx4.p2.2.2" class="ltx_text" style="--ltx-fg-color:#000000;">, violating the triangle inequality.
</span><span id="A13.SS0.SSSx4.p2.2.3" class="ltx_text" style="--ltx-fg-color:#FF0000;">Therefore</span><span id="A13.SS0.SSSx4.p2.2.4" class="ltx_text" style="--ltx-fg-color:#000000;">, this interpretation cannot be correct.</span></span>
</span>
<span id="A13.SS0.SSSx4.p3" class="ltx_para ltx_noindent">
<span id="A13.SS0.SSSx4.p3.1" class="ltx_p"><span id="A13.SS0.SSSx4.p3.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#0000FF;">Next</span><span id="A13.SS0.SSSx4.p3.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">, I considered that these labels instead denote the radii:</span></span>
<span id="A13.Ex27" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A13.Ex27.m1" class="ltx_Math" alttext="r_{H}=x,\quad r_{J}=2x,\quad r_{K}=4x." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">H</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="1.167em">,</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">J</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="1.167em">,</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">r_{H}=x,\quad r_{J}=2x,\quad r_{K}=4x.</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
<span id="A13.SS0.SSSx4.p3.2" class="ltx_p"><span id="A13.SS0.SSSx4.p3.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">Substituting into </span><math id="A13.SS0.SSSx4.p3.m1" class="ltx_Math" alttext="r_{H}+r_{J}+r_{K}=28" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">H</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">J</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">28</mn></mrow><annotation encoding="application/x-tex">r_{H}+r_{J}+r_{K}=28</annotation></semantics></math><span id="A13.SS0.SSSx4.p3.2.2" class="ltx_text" style="--ltx-fg-color:#000000;"> yields</span></span>
<span id="A13.Ex28" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A13.Ex28.m1" class="ltx_Math" alttext="x+2x+4x=28\;\Longrightarrow\;7x=28\;\Longrightarrow\;x=4." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">28</mn><mo style="--ltx-fg-color:#000000;" lspace="0.558em" mathcolor="#000000" stretchy="false">⟹</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000"> 7</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">28</mn><mo style="--ltx-fg-color:#000000;" lspace="0.558em" mathcolor="#000000" rspace="0.558em" stretchy="false">⟹</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">x+2x+4x=28\;\Longrightarrow\;7x=28\;\Longrightarrow\;x=4.</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span>
<span id="A13.SS0.SSSx4.p4" class="ltx_para ltx_noindent">
<span id="A13.SS0.SSSx4.p4.1" class="ltx_p"><span id="A13.SS0.SSSx4.p4.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">However</span><span id="A13.SS0.SSSx4.p4.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">, doubts persisted. For instance,
</span><span id="A13.SS0.SSSx4.p4.1.3" class="ltx_text" style="--ltx-fg-color:#FF0000;">if one misreads <math id="A13.SS0.SSSx4.p4.m1" class="ltx_Math" alttext="JK" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">J</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">K</mi></mrow><annotation encoding="application/x-tex">JK</annotation></semantics></math> as <math id="A13.SS0.SSSx4.p4.m2" class="ltx_Math" alttext="2x" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">x</mi></mrow><annotation encoding="application/x-tex">2x</annotation></semantics></math></span><span id="A13.SS0.SSSx4.p4.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">, then </span><math id="A13.SS0.SSSx4.p4.m3" class="ltx_Math" alttext="KJ" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">J</mi></mrow><annotation encoding="application/x-tex">KJ</annotation></semantics></math><span id="A13.SS0.SSSx4.p4.1.5" class="ltx_text" style="--ltx-fg-color:#000000;"> would be </span><math id="A13.SS0.SSSx4.p4.m4" class="ltx_Math" alttext="8" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">8</mn><annotation encoding="application/x-tex">8</annotation></semantics></math><span id="A13.SS0.SSSx4.p4.1.6" class="ltx_text" style="--ltx-fg-color:#000000;">,
which </span><span id="A13.SS0.SSSx4.p4.1.7" class="ltx_text" style="--ltx-fg-color:#FF0000;">contradicts</span><span id="A13.SS0.SSSx4.p4.1.8" class="ltx_text" style="--ltx-fg-color:#000000;"> the tangent-circle rule requiring</span></span>
<span id="A13.Ex29" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A13.Ex29.m1" class="ltx_Math" alttext="KJ=r_{K}+r_{J}=4x+2x=6x=24." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">J</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">J</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">6</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">24</mn></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">KJ=r_{K}+r_{J}=4x+2x=6x=24.</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
<span id="A13.SS0.SSSx4.p4.2" class="ltx_p"><span id="A13.SS0.SSSx4.p4.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">… Here I went back and forth, testing whether the labels might be mixed as radii or distances,
but each alternative led to inconsistencies.
</span><span id="A13.SS0.SSSx4.p4.2.2" class="ltx_text" style="--ltx-fg-color:#FF0000;">For example</span><span id="A13.SS0.SSSx4.p4.2.3" class="ltx_text" style="--ltx-fg-color:#000000;">, assuming </span><math id="A13.SS0.SSSx4.p4.m5" class="ltx_Math" alttext="KH=4x" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">H</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow></mrow><annotation encoding="application/x-tex">KH=4x</annotation></semantics></math><span id="A13.SS0.SSSx4.p4.2.4" class="ltx_text" style="--ltx-fg-color:#000000;"> as a distance forces </span><math id="A13.SS0.SSSx4.p4.m6" class="ltx_Math" alttext="r_{K}=3x" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow></mrow><annotation encoding="application/x-tex">r_{K}=3x</annotation></semantics></math><span id="A13.SS0.SSSx4.p4.2.5" class="ltx_text" style="--ltx-fg-color:#000000;"> if tangent to </span><math id="A13.SS0.SSSx4.p4.m7" class="ltx_Math" alttext="r_{H}=x" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">H</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow><annotation encoding="application/x-tex">r_{H}=x</annotation></semantics></math><span id="A13.SS0.SSSx4.p4.2.6" class="ltx_text" style="--ltx-fg-color:#000000;">,
yet then </span><math id="A13.SS0.SSSx4.p4.m8" class="ltx_Math" alttext="HJ" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">H</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">J</mi></mrow><annotation encoding="application/x-tex">HJ</annotation></semantics></math><span id="A13.SS0.SSSx4.p4.2.7" class="ltx_text" style="--ltx-fg-color:#000000;"> should be </span><math id="A13.SS0.SSSx4.p4.m9" class="ltx_Math" alttext="3x" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow><annotation encoding="application/x-tex">3x</annotation></semantics></math><span id="A13.SS0.SSSx4.p4.2.8" class="ltx_text" style="--ltx-fg-color:#000000;"> not </span><math id="A13.SS0.SSSx4.p4.m10" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math><span id="A13.SS0.SSSx4.p4.2.9" class="ltx_text" style="--ltx-fg-color:#000000;">, another contradiction.
These cycles of reasoning strongly suggested that the only consistent interpretation is that
the labels </span><math id="A13.SS0.SSSx4.p4.m11" class="ltx_Math" alttext="4x,\,x,\,2x" display="inline" intent=":literal"><semantics><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.337em">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000"> 2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow></mrow><annotation encoding="application/x-tex">4x,\,x,\,2x</annotation></semantics></math><span id="A13.SS0.SSSx4.p4.2.10" class="ltx_text" style="--ltx-fg-color:#000000;"> represent the radii themselves.</span></span>
</span>
<span id="A13.SS0.SSSx4.p5" class="ltx_para ltx_noindent">
<span id="A13.SS0.SSSx4.p5.1" class="ltx_p"><span id="A13.SS0.SSSx4.p5.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#0000FF;">Therefore</span><span id="A13.SS0.SSSx4.p5.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">, with </span><math id="A13.SS0.SSSx4.p5.m1" class="ltx_Math" alttext="x=4" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn></mrow><annotation encoding="application/x-tex">x=4</annotation></semantics></math><span id="A13.SS0.SSSx4.p5.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> we compute the actual radii:</span></span>
<span id="A13.Ex30" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A13.Ex30.m1" class="ltx_Math" alttext="r_{K}=16,\quad r_{H}=4,\quad r_{J}=8." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">16</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="1.167em">,</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">H</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="1.167em">,</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">J</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">8</mn></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">r_{K}=16,\quad r_{H}=4,\quad r_{J}=8.</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
<span id="A13.SS0.SSSx4.p5.2" class="ltx_p"><span id="A13.SS0.SSSx4.p5.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">Since circles </span><math id="A13.SS0.SSSx4.p5.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math><span id="A13.SS0.SSSx4.p5.2.2" class="ltx_text" style="--ltx-fg-color:#000000;"> and </span><math id="A13.SS0.SSSx4.p5.m3" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math><span id="A13.SS0.SSSx4.p5.2.3" class="ltx_text" style="--ltx-fg-color:#000000;"> are externally tangent, the distance between their centers is</span></span>
<span id="A13.Ex31" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A13.Ex31.m1" class="ltx_Math" alttext="KJ=r_{K}+r_{J}=16+8=24." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">J</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">J</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">16</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">8</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">24</mn></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">KJ=r_{K}+r_{J}=16+8=24.</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span>
<span id="A13.SS0.SSSx4.p6" class="ltx_para ltx_noindent">
<span id="A13.SS0.SSSx4.p6.1" class="ltx_p"><span id="A13.SS0.SSSx4.p6.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#0000FF;">Finally</span><span id="A13.SS0.SSSx4.p6.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">, check consistency:</span></span>
<span id="A13.Ex32" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A13.Ex32.m1" class="ltx_Math" alttext="2\pi(r_{H}+r_{J}+r_{K})=2\pi(4+8+16)=2\pi(28)=56\pi," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">H</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">J</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">8</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">16</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">28</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">56</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">2\pi(r_{H}+r_{J}+r_{K})=2\pi(4+8+16)=2\pi(28)=56\pi,</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
<span id="A13.SS0.SSSx4.p6.2" class="ltx_p"><span id="A13.SS0.SSSx4.p6.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">matching the given condition exactly.</span></span>
</span>
<span id="A13.SS0.SSSx4.p7" class="ltx_para">
<span id="A13.Ex33" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A13.Ex33.m1" class="ltx_Math" alttext="\boxed{24}" display="block" intent=":literal"><semantics><menclose notation="box"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">24</mn></menclose><annotation encoding="application/x-tex">\boxed{24}</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span>
</section>
                </span></span></span></foreignObject></g></g></svg></span>
</div>
