<span id="S5.T1.st2.2.1.1.1.9.6" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T1.st2.2.1.1.1.9.6.1" class="ltx_text ltx_font_bold">0.66</span></span>
