            Initialize memory <math id="alg2.l5.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> for WA with <math id="alg2.l5.m2" class="ltx_Math" alttext="\{T_{1},\ldots,T_{K+N}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>T</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>T</mi><mrow><mi>K</mi><mo>+</mo><mi>N</mi></mrow></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{T_{1},\ldots,T_{K+N}\}</annotation></semantics></math>

</div>
