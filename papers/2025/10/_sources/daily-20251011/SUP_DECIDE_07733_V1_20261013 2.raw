<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Details about Traversal on Graph</h2>

<figure id="alg3" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg3.3" class="ltx_text ltx_font_bold">Algorithm 3</span> </span> Weighted Breadth-First Search (WBFS)</figcaption>
<div id="alg3.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg3.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
            
            
          <span id="alg3.l1.3" class="ltx_text ltx_font_bold">Input:</span> Start node <math id="alg3.l1.m1" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>, target layer <math id="alg3.l1.m2" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>

</div>
<div id="alg3.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
            
            
          <span id="alg3.l2.3" class="ltx_text ltx_font_bold">Output:</span> Set of nodes <math id="alg3.l2.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> in layer <math id="alg3.l2.m2" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>

</div>
<div id="alg3.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
            
            
          <math id="alg3.l3.m1" class="ltx_Math" alttext="visited\leftarrow\{s\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mi>s</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">visited\leftarrow\{s\}</annotation></semantics></math>, <math id="alg3.l3.m2" class="ltx_Math" alttext="queue\leftarrow[s]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo stretchy="false">←</mo><mrow><mo stretchy="false">[</mo><mi>s</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">queue\leftarrow[s]</annotation></semantics></math>, <math id="alg3.l3.m3" class="ltx_Math" alttext="R\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">R\leftarrow\emptyset</annotation></semantics></math>

</div>
<div id="alg3.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
            
            
          <span id="alg3.l4.3" class="ltx_text ltx_font_bold">while</span> <math id="alg3.l4.m1" class="ltx_Math" alttext="queue\neq\emptyset" display="inline" intent=":literal"><semantics><mrow><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo>≠</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">queue\neq\emptyset</annotation></semantics></math> <span id="alg3.l4.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg3.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
            
            
            <math id="alg3.l5.m1" class="ltx_Math" alttext="u\leftarrow queue.\textsc{Dequeue}()" display="inline" intent=":literal"><semantics><mrow><mrow><mi>u</mi><mo stretchy="false">←</mo><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mtext class="ltx_font_smallcaps">Dequeue</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u\leftarrow queue.\textsc{Dequeue}()</annotation></semantics></math>

</div>
<div id="alg3.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
            
            
            <span id="alg3.l6.3" class="ltx_text ltx_font_bold">for all</span> <math id="alg3.l6.m1" class="ltx_Math" alttext="v\in\textsc{Successors}(u)" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mrow><mtext class="ltx_font_smallcaps">Successors</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">v\in\textsc{Successors}(u)</annotation></semantics></math> <span id="alg3.l6.4" class="ltx_text ltx_font_bold">sorted by</span> <math id="alg3.l6.m2" class="ltx_Math" alttext="weight(u,v)" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">weight(u,v)</annotation></semantics></math> <span id="alg3.l6.5" class="ltx_text ltx_font_bold">desc</span> <span id="alg3.l6.6" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg3.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
            
            
             <span id="alg3.l7.3" class="ltx_text ltx_font_bold">if</span> <math id="alg3.l7.m1" class="ltx_Math" alttext="v\notin visited" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∉</mo><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><annotation encoding="application/x-tex">v\notin visited</annotation></semantics></math> <span id="alg3.l7.4" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg3.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
            
            
               <math id="alg3.l8.m1" class="ltx_Math" alttext="visited\leftarrow visited\cup\{v\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">←</mo><mrow><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>v</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">visited\leftarrow visited\cup\{v\}</annotation></semantics></math>

</div>
<div id="alg3.l9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
            
            
               <span id="alg3.l9.3" class="ltx_text ltx_font_bold">if</span> <math id="alg3.l9.m1" class="ltx_Math" alttext="v.layer=\ell" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo lspace="0em" rspace="0.167em">.</mo><mrow><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>=</mo><mi mathvariant="normal">ℓ</mi></mrow></mrow><annotation encoding="application/x-tex">v.layer=\ell</annotation></semantics></math> <span id="alg3.l9.4" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg3.l10" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
            
            
                <math id="alg3.l10.m1" class="ltx_Math" alttext="R\leftarrow R\cup\{v\}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo stretchy="false">←</mo><mrow><mi>R</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>v</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R\leftarrow R\cup\{v\}</annotation></semantics></math>

