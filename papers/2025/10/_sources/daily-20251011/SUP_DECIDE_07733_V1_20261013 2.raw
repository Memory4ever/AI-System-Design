            WA generates initial outline <math id="alg2.l7.m1" class="ltx_Math" alttext="\mathcal{O}^{(0)}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\mathcal{O}^{(0)}</annotation></semantics></math> from <math id="alg2.l7.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>

