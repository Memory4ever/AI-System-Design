</div>
<div id="alg2.l19" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l19.1" class="ltx_text" style="font-size:80%;">19:</span></span>
              
              
                <math id="alg2.l19.m1" class="ltx_Math" alttext="O_{i}^{(t)}=\textsc{WA}(M\cup R_{i}^{(t)},EA(O_{i}^{(t-1)}))" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>O</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><mtext class="ltx_font_smallcaps">WA</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo>∪</mo><msubsup><mi>R</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>,</mo><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>O</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">O_{i}^{(t)}=\textsc{WA}(M\cup R_{i}^{(t)},EA(O_{i}^{(t-1)}))</annotation></semantics></math>

</div>
<div id="alg2.l20" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l20.1" class="ltx_text" style="font-size:80%;">20:</span></span>
              
              
                where <math id="alg2.l20.m1" class="ltx_Math" alttext="R_{i}^{(t)}=\textsc{Retrieve}(Q_{i}^{(t)},D)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>R</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><mtext class="ltx_font_smallcaps">Retrieve</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>Q</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R_{i}^{(t)}=\textsc{Retrieve}(Q_{i}^{(t)},D)</annotation></semantics></math>

</div>
<div id="alg2.l21" class="ltx_listingline">
