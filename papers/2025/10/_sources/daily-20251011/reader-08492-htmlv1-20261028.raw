<div id="A5.T21.fig1.6.1.2.6.1" class="ltx_inline-block ltx_transformed_outer" style="width:6.8pt;height:36.3pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:36.3pt;transform:translate(-14.7pt,-14.7pt) rotate(-90deg) ;">
<p id="A5.T21.fig1.6.1.2.6.1.1" class="ltx_p">UCF101</p>
