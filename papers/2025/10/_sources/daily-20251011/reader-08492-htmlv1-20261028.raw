<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A5.F23.fig2.2" class="ltx_text" style="font-size:90%;">Figure 23</span>: </span><span id="A5.F23.fig2.3" class="ltx_text ltx_font_bold" style="font-size:90%;">UCF101.<span id="A5.F23.fig2.3.1" class="ltx_text ltx_font_medium"> 1 img <math id="A5.F23.m4" class="ltx_Math" alttext="\approx" display="inline" intent=":literal"><semantics><mo>≈</mo><annotation encoding="application/x-tex">\approx</annotation></semantics></math> 2617 words</span></span></figcaption>
