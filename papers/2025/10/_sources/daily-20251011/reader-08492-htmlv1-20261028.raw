<div id="A5.T21.fig1.6.1.2.3.1" class="ltx_inline-block ltx_transformed_outer" style="width:6.8pt;height:35.6pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:35.6pt;transform:translate(-14.4pt,-14.4pt) rotate(-90deg) ;">
<p id="A5.T21.fig1.6.1.2.3.1.1" class="ltx_p">SUN397</p>
</span></div></th>
