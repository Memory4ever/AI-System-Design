<td id="A2.T5.5.9.2" class="ltx_td ltx_nopad_r ltx_align_left"><span id="A2.T5.5.9.2.1" class="ltx_text ltx_font_typewriter">linear</span></td></tr>
<tr id="A2.T5.5.10" class="ltx_tr">
