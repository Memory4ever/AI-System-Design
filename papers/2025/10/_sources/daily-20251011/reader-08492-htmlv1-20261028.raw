<tr id="S4.T1.fig1.6.1.5" class="ltx_tr">
<td id="S4.T1.fig1.6.1.5.1" class="ltx_td ltx_align_left ltx_border_bb">Ours</td>
<td id="S4.T1.fig1.6.1.5.2" class="ltx_td ltx_align_left ltx_border_bb">63.28 <math id="S4.T1.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="S4.T1.fig1.6.1.5.3" class="ltx_td ltx_align_left ltx_border_bb">57.10  <math id="S4.T1.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
