<span id="A2.T4.5.1.1.1" class="ltx_inline-block ltx_align_top" style="width:92.8pt;">
<span id="A2.T4.5.1.1.1.1" class="ltx_p"><span id="A2.T4.5.1.1.1.1.1" class="ltx_text ltx_font_bold">Class</span></span>
</span></th>
