<td id="A2.T5.5.1.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_tt"><span id="A2.T5.5.1.2.1" class="ltx_text ltx_font_bold">Values</span></td></tr>
<tr id="A2.T5.5.2" class="ltx_tr">
