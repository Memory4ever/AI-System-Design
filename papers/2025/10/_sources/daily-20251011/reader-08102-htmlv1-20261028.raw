<span id="alg1.l22.2.1" class="ltx_p">Set <math id="alg1.l22.m1" class="ltx_math_unparsed" alttext="p_{\mathcal{V},\mathcal{V}_{\mathrm{sub}}}(y_{k+1}\mid y_{1:k})\leftarrow\tilde{p}(y_{k+1})/\sum_{y}\tilde{p}(y)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>sub</mi></msub></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>y</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">←</mo><mover accent="true"><mi>p</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo rspace="0.055em">/</mo><msub><mo>∑</mo><mi>y</mi></msub><mover accent="true"><mi>p</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\mathcal{V},\mathcal{V}_{\mathrm{sub}}}(y_{k+1}\mid y_{1:k})\leftarrow\tilde{p}(y_{k+1})/\sum_{y}\tilde{p}(y)</annotation></semantics></math> for all <math id="alg1.l22.m2" class="ltx_Math" alttext="y_{k+1}\in\mathcal{V}_{\mathrm{sub}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>sub</mi></msub></mrow><annotation encoding="application/x-tex">y_{k+1}\in\mathcal{V}_{\mathrm{sub}}</annotation></semantics></math>. <span id="alg1.l22.2.1.1" class="ltx_text" style="float:right; float:right;"><math id="alg1.l22.m3" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math><span id="alg1.l22.2.1.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#808080;"> Marginalization.</span></span></span>
