<span id="alg2.l3.2" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:214.6pt;">
<span id="alg2.l3.2.1" class="ltx_p">Tokenize <math id="alg2.l3.m1" class="ltx_math_unparsed" alttext="y_{1:k}" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub></mrow><annotation encoding="application/x-tex">y_{1:k}</annotation></semantics></math> in <math id="alg2.l3.m2" class="ltx_Math" alttext="\mathcal{V}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒱</mi><annotation encoding="application/x-tex">\mathcal{V}</annotation></semantics></math>, i.e., <math id="alg2.l3.m3" class="ltx_math_unparsed" alttext="x_{1:t}:=[[y_{1:k}]_{\mathcal{A}}]_{\mathcal{V}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo>:=</mo><msub><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">[</mo><msub><mi>y</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo stretchy="false">]</mo></mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo stretchy="false">]</mo></mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub></mrow><annotation encoding="application/x-tex">x_{1:t}:=[[y_{1:k}]_{\mathcal{A}}]_{\mathcal{V}}</annotation></semantics></math>.</span>
</span>
</div>
<div id="alg2.l4" class="ltx_listingline">
                      <span class="ltx_tag ltx_tag_listingline">4:</span>
                      
                      
                    
<span id="alg2.l4.2" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:214.6pt;">
<span id="alg2.l4.2.1" class="ltx_p">Compute <math id="alg2.l4.m1" class="ltx_math_unparsed" alttext="p_{\mathcal{V}}(x_{1:t}x*)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mi>x</mi><mo lspace="0.222em" rspace="0em">∗</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\mathcal{V}}(x_{1:t}x*)</annotation></semantics></math> for all <math id="alg2.l4.m2" class="ltx_Math" alttext="x\in\mathcal{V}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow><annotation encoding="application/x-tex">x\in\mathcal{V}</annotation></semantics></math> by a single forward computation, and store them in <math id="alg2.l4.m3" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math>.</span>
</span>
</div>
