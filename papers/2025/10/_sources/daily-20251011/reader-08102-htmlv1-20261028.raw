<span id="alg1.l21.2.1" class="ltx_p">Set <math id="alg1.l21.m1" class="ltx_Math" alttext="\tilde{p}(y_{k+1})\leftarrow\sum_{p\in\mathcal{S}[y_{k+1}]}p." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mi>p</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em" stretchy="false">←</mo><mrow><msub><mo>∑</mo><mrow><mi>p</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>y</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow></mrow></mrow></msub><mi>p</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{p}(y_{k+1})\leftarrow\sum_{p\in\mathcal{S}[y_{k+1}]}p.</annotation></semantics></math> <span id="alg1.l21.2.1.1" class="ltx_text" style="float:right; float:right;"><math id="alg1.l21.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math><span id="alg1.l21.2.1.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#808080;"> <math id="alg1.l21.m3" class="ltx_math_unparsed" alttext="p_{\mathcal{V},\mathcal{V}_{\mathrm{sub}}}(y_{1:k+1}*)" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">p</mi><mrow><mi style="--ltx-fg-color:#808080;" class="ltx_font_mathcaligraphic" mathcolor="#808080">𝒱</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">,</mo><msub><mi style="--ltx-fg-color:#808080;" class="ltx_font_mathcaligraphic" mathcolor="#808080">𝒱</mi><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">sub</mi></msub></mrow></msub><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">y</mi><mrow><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">1</mn><mo style="--ltx-fg-color:#808080;" lspace="0.278em" mathcolor="#808080" rspace="0.278em">:</mo><mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">k</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">+</mo><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">1</mn></mrow></mrow></msub><mo style="--ltx-fg-color:#808080;" lspace="0.222em" mathcolor="#808080" rspace="0em">∗</mo><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\mathcal{V},\mathcal{V}_{\mathrm{sub}}}(y_{1:k+1}*)</annotation></semantics></math></span>.</span></span>
