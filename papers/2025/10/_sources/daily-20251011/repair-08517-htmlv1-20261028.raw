<td id="A3.T2.2.6.2" class="ltx_td ltx_align_center">16384</td></tr>
<tr id="A3.T2.2.7" class="ltx_tr">
<th id="A3.T2.2.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">bf16</th>
<td id="A3.T2.2.7.2" class="ltx_td ltx_align_center">True</td></tr>
<tr id="A3.T2.2.8" class="ltx_tr">
<th id="A3.T2.2.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">num_gpus</th>
<td id="A3.T2.2.8.2" class="ltx_td ltx_align_center">8</td></tr>
<tr id="A3.T2.2.9" class="ltx_tr">
<th id="A3.T2.2.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_r">warmup ratio</th>
