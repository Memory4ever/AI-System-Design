<th id="S5.T1.7.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt"><span id="S5.T1.7.1.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Direct Acc.</span></th>
<th id="S5.T1.7.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt"><span id="S5.T1.7.1.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">LR Train Acc.</span></th>
<th id="S5.T1.7.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T1.7.1.1.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">LR Test Acc.</span></th></tr>
