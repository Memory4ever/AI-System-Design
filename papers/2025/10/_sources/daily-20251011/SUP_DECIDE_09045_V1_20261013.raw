          LANGUAGE <math id="alg1.m1" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> <span id="alg1.4.4.2" class="ltx_text ltx_font_smallcaps">GetLanguage</span>(<math id="alg1.m2" class="ltx_Math" alttext="language" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><annotation encoding="application/x-tex">language</annotation></semantics></math>)  <math id="alg1.m3" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <span id="alg1.4.4.3" class="ltx_text" style="--ltx-fg-color:#0000FF;">Retrieve programming language metadata</span>
</div>
