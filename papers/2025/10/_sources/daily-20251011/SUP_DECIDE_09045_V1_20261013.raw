<span id="S6.T5.2.1.1.1.2.6" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t"><span id="S6.T5.2.1.1.1.2.6.1" class="ltx_text ltx_font_bold">IdRep Acc.</span></span></span>
<span id="S6.T5.2.1.1.1.3" class="ltx_tr">
