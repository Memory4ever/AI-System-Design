<span id="S6.T5.2.1.1.1.3.8" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_bb ltx_border_t ltx_rowspan ltx_rowspan_4"><span id="S6.T5.2.1.1.1.3.8.1" class="ltx_text">14.5%</span></span></span>
