<tr id="S3.T1.2.10" class="ltx_tr">
<th id="S3.T1.2.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;" colspan="10">Solver LLM: GPT-oss-20B</th></tr>
<tr id="S3.T1.2.11" class="ltx_tr">
<th id="S3.T1.2.11.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">CoT</th>
