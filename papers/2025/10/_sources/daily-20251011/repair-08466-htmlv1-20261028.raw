<td id="S4.T1.5.1.3.6" class="ltx_td ltx_align_center"><span id="S4.T1.5.1.3.6.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">89.56</span><math id="S4.T1.m18" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo mathsize="0.500em">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math><span id="S4.T1.5.1.3.6.2" class="ltx_text ltx_font_smallcaps" style="font-size:50%;">1.10</span></td>
<td id="S4.T1.5.1.3.7" class="ltx_td ltx_align_center"><span id="S4.T1.5.1.3.7.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">93.84</span><math id="S4.T1.m19" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo mathsize="0.500em">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math><span id="S4.T1.5.1.3.7.2" class="ltx_text ltx_font_smallcaps" style="font-size:50%;">1.03</span></td>
<td id="S4.T1.5.1.3.8" class="ltx_td ltx_align_center"><span id="S4.T1.5.1.3.8.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">96.25</span><math id="S4.T1.m20" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo mathsize="0.500em">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math><span id="S4.T1.5.1.3.8.2" class="ltx_text ltx_font_smallcaps" style="font-size:50%;">0.86</span></td></tr>
<tr id="S4.T1.5.1.4" class="ltx_tr">
