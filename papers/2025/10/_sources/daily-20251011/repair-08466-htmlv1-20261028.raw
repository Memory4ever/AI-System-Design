<td id="S4.T1.5.1.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.5.1.2.2.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">67.95</span><math id="S4.T1.m7" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo mathsize="0.500em">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math><span id="S4.T1.5.1.2.2.2" class="ltx_text ltx_font_smallcaps" style="font-size:50%;">1.46</span></td>
