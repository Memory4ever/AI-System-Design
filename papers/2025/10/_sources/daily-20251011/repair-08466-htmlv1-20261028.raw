<td id="S5.T3.7.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" colspan="3"><span id="S5.T3.7.1.1.3.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">Stanford 40 Action</span></td></tr>
<tr id="S5.T3.7.1.2" class="ltx_tr">
