<td id="S5.T3.7.1.2.2" class="ltx_td ltx_align_center"><span id="S5.T3.7.1.2.2.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">object</span></td>
<td id="S5.T3.7.1.2.3" class="ltx_td ltx_align_center"><span id="S5.T3.7.1.2.3.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">color</span></td>
<td id="S5.T3.7.1.2.4" class="ltx_td ltx_align_center"><span id="S5.T3.7.1.2.4.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">pattern</span></td>
<td id="S5.T3.7.1.2.5" class="ltx_td ltx_align_center"><span id="S5.T3.7.1.2.5.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">shape</span></td>
<td id="S5.T3.7.1.2.6" class="ltx_td ltx_align_center"><span id="S5.T3.7.1.2.6.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">texture</span></td>
<td id="S5.T3.7.1.2.7" class="ltx_td ltx_align_center"><span id="S5.T3.7.1.2.7.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">action</span></td>
<td id="S5.T3.7.1.2.8" class="ltx_td ltx_align_center"><span id="S5.T3.7.1.2.8.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">mood</span></td>
<td id="S5.T3.7.1.2.9" class="ltx_td ltx_align_center"><span id="S5.T3.7.1.2.9.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">location</span></td></tr>
<tr id="S5.T3.7.1.3" class="ltx_tr">
<td id="S5.T3.7.1.3.1" class="ltx_td ltx_align_left ltx_border_t" colspan="9"><span id="S5.T3.7.1.3.1.1" class="ltx_text ltx_font_italic" style="font-size:90%;">Unconditional Methods</span></td></tr>
<tr id="S5.T3.7.1.4" class="ltx_tr">
