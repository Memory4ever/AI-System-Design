<td id="S4.T3.5.1.19.10" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T3.5.1.19.10.1" class="ltx_text ltx_underline">0.956</span></td>
<td id="S4.T3.5.1.19.11" class="ltx_td ltx_align_center ltx_border_bb">0.937</td>
