<figure id="S4.F8.sf2" class="ltx_figure ltx_figure_panel"><img src="2510.08759v1/main/figures/simulation_exp_result_moka.png" id="S4.F8.sf2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:548/410;" width="548" height="410" alt="Refer to caption">
