</tbody>
</table>
</div>
<div id="p3" class="ltx_para ltx_noindent">
<table id="p3.1" class="ltx_tabular ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="p3.1.1" class="ltx_tr">
<td id="p3.1.1.1" class="ltx_td ltx_align_center"><sup id="p3.1.1.1.1" class="ltx_sup">1</sup> Northeastern University <sup id="p3.1.1.1.2" class="ltx_sup">2</sup> The Chinese University of Hong Kong <sup id="p3.1.1.1.3" class="ltx_sup">3</sup> Peking University</td></tr>
