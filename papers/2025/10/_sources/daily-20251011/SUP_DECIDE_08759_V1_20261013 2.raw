<th id="S2.F2.sf1.2.1.2.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">Total questions</th>
<td id="S2.F2.sf1.2.1.2.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">4,469</td></tr>
<tr id="S2.F2.sf1.2.1.3" class="ltx_tr">
<th id="S2.F2.sf1.2.1.3.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_row" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">- with only one image</th>
