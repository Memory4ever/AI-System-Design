<tbody class="ltx_tbody">
<tr id="S2.F2.sf1.2.1.1" class="ltx_tr">
<th id="S2.F2.sf1.2.1.1.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_row ltx_border_tt" style="padding-top:-1.5pt;padding-bottom:-1.5pt;"><span id="S2.F2.sf1.2.1.1.1.1" class="ltx_text ltx_font_bold">Statistic</span></th>
<td id="S2.F2.sf1.2.1.1.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_tt" style="padding-top:-1.5pt;padding-bottom:-1.5pt;"><span id="S2.F2.sf1.2.1.1.2.1" class="ltx_text ltx_font_bold">Number</span></td></tr>
