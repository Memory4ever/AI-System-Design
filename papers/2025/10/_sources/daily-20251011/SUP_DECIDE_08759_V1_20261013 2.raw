<td id="S2.F2.sf1.2.1.4.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">995 (22.2%)</td></tr>
<tr id="S2.F2.sf1.2.1.5" class="ltx_tr">
<th id="S2.F2.sf1.2.1.5.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_row" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">- with interleaved data</th>
