<h1 class="ltx_title ltx_title_document">

<span id="id1" class="ltx_inline-block ltx_minipage ltx_align_middle" style="width:437.2pt;">
<span id="id1.1" class="ltx_p">
<span id="id1.1.1" class="ltx_inline-block ltx_markedasmath ltx_align_bottom">
<span id="id1.1.1.1" class="ltx_p">
<span id="id1.1.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:31.8pt;height:34.7pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="transform:translate(0.0pt,0.0pt) scale(1,1) ;">
