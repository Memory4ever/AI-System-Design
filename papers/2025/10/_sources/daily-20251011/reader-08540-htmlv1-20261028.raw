<span id="A1.SS6.p32.pic1.2.1.1" class="ltx_p ltx_align_center"><span id="A1.SS6.p32.pic1.2.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Image</span></span><img src="2510.08540v1/kukurasu.png" id="A1.SS6.p32.pic1.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:209/148;" width="209" height="148" alt="[Uncaptioned image]">
