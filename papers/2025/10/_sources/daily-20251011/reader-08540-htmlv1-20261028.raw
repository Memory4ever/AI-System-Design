<div id="A1.T6.fig2.1" class="ltx_inline-block ltx_transformed_outer" style="width:178.9pt;height:57.5pt;vertical-align:-26.8pt;"><span class="ltx_transformed_inner" style="transform:translate(-24.5pt,7.9pt) scale(0.784650771629585,0.784650771629585) ;">
