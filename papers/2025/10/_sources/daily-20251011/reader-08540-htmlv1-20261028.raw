<tr id="S4.T1.2.1.6" class="ltx_tr">
<td id="S4.T1.2.1.6.1" class="ltx_td ltx_align_left" style="padding-left:2.7pt;padding-right:2.7pt;">Seed-1.5-VL <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib6" title="" class="ltx_ref">Guo et al., 2025b</a>)</cite></td>
<td id="S4.T1.2.1.6.2" class="ltx_td ltx_align_center" style="padding-left:2.7pt;padding-right:2.7pt;"><math id="S4.T1.m3" class="ltx_Math" alttext="\checkmark" display="inline" intent=":literal"><semantics><mi>✓</mi><annotation encoding="application/x-tex">\checkmark</annotation></semantics></math></td>
<td id="S4.T1.2.1.6.3" class="ltx_td ltx_align_center" style="padding-left:2.7pt;padding-right:2.7pt;">89.3</td>
<td id="S4.T1.2.1.6.4" class="ltx_td ltx_align_center" style="--ltx-bg-color:#E6E6E6;padding-left:2.7pt;padding-right:2.7pt;"><span id="S4.T1.2.1.6.4.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">78.9</span></td>
<td id="S4.T1.2.1.6.5" class="ltx_td ltx_align_center" style="padding-left:2.7pt;padding-right:2.7pt;">86.7</td>
