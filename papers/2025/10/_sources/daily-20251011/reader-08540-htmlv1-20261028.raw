<td id="S4.T1.2.1.4.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.7pt;padding-right:2.7pt;" colspan="12"><span id="S4.T1.2.1.4.1.1" class="ltx_text ltx_font_italic">Proprietary Models</span></td></tr>
<tr id="S4.T1.2.1.5" class="ltx_tr">
<td id="S4.T1.2.1.5.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:2.7pt;padding-right:2.7pt;">GPT-5 <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib14" title="" class="ltx_ref">OpenAI, 2025b</a>)</cite></td>
