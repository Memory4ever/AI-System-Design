<td id="S4.T1.2.1.5.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.7pt;padding-right:2.7pt;">80.9</td>
<td id="S4.T1.2.1.5.8" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#E6E6E6;padding-left:2.7pt;padding-right:2.7pt;"><span id="S4.T1.2.1.5.8.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">52.6</span></td>
<td id="S4.T1.2.1.5.9" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.7pt;padding-right:2.7pt;">80.0</td>
