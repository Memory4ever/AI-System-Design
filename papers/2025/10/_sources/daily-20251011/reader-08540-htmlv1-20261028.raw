<span id="A1.SS6.p34.pic1.2.1.2" class="ltx_p ltx_align_center"><span id="A1.SS6.p34.pic1.2.1.2.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Category:</span><span id="A1.SS6.p34.pic1.2.1.2.2" class="ltx_text" style="--ltx-fg-color:#000000;"> Puzzle</span></span>
