</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 13.07 156.97)"><foreignObject style="--ltx-fo-width:37.86em;--ltx-fo-height:30.41em;--ltx-fo-depth:10.4em;font-size:10pt;" height="564.63" overflow="visible" transform="matrix(1 0 0 -1 0 420.72)" width="523.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A1.SS6.p24.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:37.86em;">
