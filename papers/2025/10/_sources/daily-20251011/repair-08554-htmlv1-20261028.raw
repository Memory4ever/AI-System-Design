<td id="S4.T2.7.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S4.T2.7.2.6.1" class="ltx_text" style="font-size:90%;">256</span></td>
<td id="S4.T2.7.2.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S4.T2.7.2.7.1" class="ltx_text" style="font-size:90%;">512</span></td>
