<td id="S4.T2.7.2.11" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S4.T2.7.2.11.1" class="ltx_text" style="font-size:90%;">128</span></td>
<td id="S4.T2.7.2.12" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S4.T2.7.2.12.1" class="ltx_text" style="font-size:90%;">256</span></td>
