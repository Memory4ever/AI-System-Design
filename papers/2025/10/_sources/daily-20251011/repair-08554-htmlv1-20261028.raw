</span></td>
<td id="A4.T4.6.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:9.0pt;padding-right:9.0pt;"><math id="A4.T4.m1" class="ltx_Math" alttext="1e-6" display="inline" intent=":literal"><semantics><mrow><mrow><mn mathsize="0.900em">1</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">e</mi></mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">6</mn></mrow><annotation encoding="application/x-tex">1e-6</annotation></semantics></math></td>
