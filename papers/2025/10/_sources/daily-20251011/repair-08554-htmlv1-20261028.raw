<td id="A4.T4.6.4.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:9.0pt;padding-right:9.0pt;"><span id="A4.T4.6.4.5.1" class="ltx_text" style="font-size:90%;">6</span></td>
<td id="A4.T4.6.4.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:9.0pt;padding-right:9.0pt;"><span id="A4.T4.6.4.6.1" class="ltx_text" style="font-size:90%;">6</span></td></tr>
