<td id="S4.T1.2.4.7" class="ltx_td ltx_align_right">0.0776</td></tr>
<tr id="S4.T1.2.5" class="ltx_tr">
<th id="S4.T1.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><span id="S4.T1.2.5.1.1" class="ltx_text ltx_font_typewriter">Italian</span></th>
<td id="S4.T1.2.5.2" class="ltx_td ltx_align_right ltx_border_bb">1.1559</td>
