<td id="S4.T1.2.2.3" class="ltx_td ltx_align_right ltx_border_t">2.9025</td>
<td id="S4.T1.2.2.4" class="ltx_td ltx_align_right ltx_border_t">7.7728</td>
<td id="S4.T1.2.2.5" class="ltx_td ltx_align_right ltx_border_t">5.7750</td>
<td id="S4.T1.2.2.6" class="ltx_td ltx_align_right ltx_border_t">0.1446</td>
<td id="S4.T1.2.2.7" class="ltx_td ltx_align_right ltx_border_t">0.1148</td></tr>
<tr id="S4.T1.2.3" class="ltx_tr">
<th id="S4.T1.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S4.T1.2.3.1.1" class="ltx_text ltx_font_typewriter">Spanish</span></th>
<td id="S4.T1.2.3.2" class="ltx_td ltx_align_right">1.2257</td>
<td id="S4.T1.2.3.3" class="ltx_td ltx_align_right">2.8119</td>
<td id="S4.T1.2.3.4" class="ltx_td ltx_align_right">7.3764</td>
<td id="S4.T1.2.3.5" class="ltx_td ltx_align_right">5.7939</td>
<td id="S4.T1.2.3.6" class="ltx_td ltx_align_right">0.0977</td>
<td id="S4.T1.2.3.7" class="ltx_td ltx_align_right">0.1269</td></tr>
<tr id="S4.T1.2.4" class="ltx_tr">
<th id="S4.T1.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S4.T1.2.4.1.1" class="ltx_text ltx_font_typewriter">French</span></th>
<td id="S4.T1.2.4.2" class="ltx_td ltx_align_right">1.3454</td>
<td id="S4.T1.2.4.3" class="ltx_td ltx_align_right">2.8632</td>
