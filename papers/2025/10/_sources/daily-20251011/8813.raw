<th id="S4.T1.2.1.2" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt"><span id="S4.T1.2.1.2.1" class="ltx_text ltx_font_bold">Morph. Comp.</span></th>
<th id="S4.T1.2.1.3" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt"><span id="S4.T1.2.1.3.1" class="ltx_text ltx_font_bold">Synt. Ent.</span></th>
<th id="S4.T1.2.1.4" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt"><span id="S4.T1.2.1.4.1" class="ltx_text ltx_font_bold">Redundancy</span></th>
<th id="S4.T1.2.1.5" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt"><span id="S4.T1.2.1.5.1" class="ltx_text ltx_font_bold">Avg. Word Len.</span></th>
<th id="S4.T1.2.1.6" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt"><span id="S4.T1.2.1.6.1" class="ltx_text ltx_font_bold">Cap. Rate</span></th>
