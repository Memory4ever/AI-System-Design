<th id="S5.T5.2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Sonnet-3.5v1</th>
<td id="S5.T5.2.1.4.2" class="ltx_td ltx_align_right"><span id="S5.T5.2.1.4.2.1" class="ltx_text ltx_font_bold">55.6</span></td>
<td id="S5.T5.2.1.4.3" class="ltx_td ltx_align_right ltx_border_r">55.5</td>
