<span class="ltx_personname"><span id="id11" class="ltx_text ltx_align_center ltx_inline-block" style="width:119.2pt;">Dmitry Vetrov<sup id="id11.1" class="ltx_sup">1</sup></span>
</span></span>
<span class="ltx_author_before">  </span><span class="ltx_creator ltx_role_author">
