<th id="S3.T3.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T3.2.1.2.1" class="ltx_text ltx_font_bold" style="font-size:70%;">GPU</span></th>
<th id="S3.T3.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T3.2.1.3.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Speed<span id="S3.T3.2.1.3.1.1" class="ltx_text ltx_font_medium"> (s/img)</span></span></th>
<th id="S3.T3.2.1.4" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="S3.T3.2.1.4.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Params</span></th></tr>
