<tbody class="ltx_tbody">
<tr id="S3.T3.2.2" class="ltx_tr">
<td id="S3.T3.2.2.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S3.T3.2.2.1.1" class="ltx_text" style="font-size:70%;">Phi-3-V <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib21" title="" class="ltx_ref">21</a>]</cite></span></td>
