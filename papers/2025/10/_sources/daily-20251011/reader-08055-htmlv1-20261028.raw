<div id="S3.T2.4" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:487.8pt;height:95.9pt;vertical-align:-44.0pt;"><span class="ltx_transformed_inner" style="transform:translate(88.3pt,-17.4pt) scale(1.56736849815298,1.56736849815298) ;">
