<tr id="S3.T1.4.1.1" class="ltx_tr">
<th id="S3.T1.4.1.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt" style="padding:-0.25pt 3.0pt;"><span id="S3.T1.4.1.1.1.1" class="ltx_text ltx_font_bold">Batch Size</span></th>
