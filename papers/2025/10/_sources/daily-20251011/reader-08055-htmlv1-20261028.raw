<th id="S3.T1.4.1.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:-0.25pt 3.0pt;">16</th>
<th id="S3.T1.4.1.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:-0.25pt 3.0pt;">32</th>
<th id="S3.T1.4.1.1.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:-0.25pt 3.0pt;">64</th>
<th id="S3.T1.4.1.1.9" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:-0.25pt 3.0pt;">128</th>
<th id="S3.T1.4.1.1.10" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:-0.25pt 3.0pt;">256</th>
<th id="S3.T1.4.1.1.11" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:-0.25pt 3.0pt;"><math id="S3.T1.m1" class="ltx_Math" alttext="\geq" display="inline" intent=":literal"><semantics><mo>≥</mo><annotation encoding="application/x-tex">\geq</annotation></semantics></math>512</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S3.T1.4.1.2" class="ltx_tr">
<th id="S3.T1.4.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_t" style="padding:-0.25pt 3.0pt;"><span id="S3.T1.4.1.2.1.1" class="ltx_text ltx_font_bold">Coverage (%)</span></th>
<td id="S3.T1.4.1.2.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding:-0.25pt 3.0pt;">6.25</td>
<td id="S3.T1.4.1.2.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding:-0.25pt 3.0pt;">11.7</td>
<td id="S3.T1.4.1.2.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding:-0.25pt 3.0pt;">21.3</td>
