<td id="S5.T1.15.1.5.4" class="ltx_td ltx_align_center" style="padding:0.6pt 5.0pt;"><span id="S5.T1.15.1.5.4.1" class="ltx_text" style="font-size:70%;">31.1</span></td>
<td id="S5.T1.15.1.5.5" class="ltx_td ltx_align_center" style="padding:0.6pt 5.0pt;"><span id="S5.T1.15.1.5.5.1" class="ltx_text" style="font-size:70%;">31.7</span></td>
<td id="S5.T1.15.1.5.6" class="ltx_td ltx_align_center" style="padding:0.6pt 5.0pt;"><span id="S5.T1.15.1.5.6.1" class="ltx_text" style="font-size:70%;">59.8</span></td>
<td id="S5.T1.15.1.5.7" class="ltx_td ltx_align_center" style="padding:0.6pt 5.0pt;"><span id="S5.T1.15.1.5.7.1" class="ltx_text" style="font-size:70%;">1653</span></td>
