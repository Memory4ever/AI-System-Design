<span id="S6.T4.2.1.1.1.1.1.3.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_r ltx_border_t">2.96%</span>
<span id="S6.T4.2.1.1.1.1.1.3.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t"><span id="S6.T4.2.1.1.1.1.1.3.3.1" class="ltx_text ltx_font_bold">23.56<math id="S6.T4.m5" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.11<sup id="S6.T4.2.1.1.1.1.1.3.3.1.1" class="ltx_sup"><span id="S6.T4.2.1.1.1.1.1.3.3.1.1.1" class="ltx_text ltx_font_italic">∗</span></sup></span> (3.68%)</span></span>
