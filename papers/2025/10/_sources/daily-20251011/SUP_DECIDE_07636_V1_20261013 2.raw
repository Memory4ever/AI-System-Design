<td id="S4.T6.2.3.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r"><span id="S4.T6.2.3.2.1" class="ltx_text" style="font-size:70%;">79.1%</span></td>
