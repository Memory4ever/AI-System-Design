<td id="S4.T4.2.3.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r"><span id="S4.T4.2.3.3.1" class="ltx_text" style="font-size:70%;">20</span></td>
<td id="S4.T4.2.3.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r"><span id="S4.T4.2.3.4.1" class="ltx_text" style="font-size:70%;">150</span></td>
