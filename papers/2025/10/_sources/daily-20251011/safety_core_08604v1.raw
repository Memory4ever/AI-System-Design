<span id="id1.1.1" class="ltx_tr">
<span id="id1.1.1.1" class="ltx_td ltx_align_center"><span id="id1.1.1.1.1" class="ltx_text ltx_font_bold">Raffaele Mura<sup id="id1.1.1.1.1.1" class="ltx_sup"><span id="id1.1.1.1.1.1.1" class="ltx_text ltx_font_italic">1</span></sup></span>  <span id="id1.1.1.1.2" class="ltx_text ltx_font_bold">Giorgio Piras<sup id="id1.1.1.1.2.1" class="ltx_sup"><span id="id1.1.1.1.2.1.1" class="ltx_text ltx_font_italic">1</span></sup></span>  <span id="id1.1.1.1.3" class="ltx_text ltx_font_bold">Kamilė Lukošiūtė<sup id="id1.1.1.1.3.1" class="ltx_sup"><span id="id1.1.1.1.3.1.1" class="ltx_text ltx_font_italic">2</span></sup></span>  <span id="id1.1.1.1.4" class="ltx_text ltx_font_bold">Maura Pintor<sup id="id1.1.1.1.4.1" class="ltx_sup"><span id="id1.1.1.1.4.1.1" class="ltx_text ltx_font_italic">1</span></sup></span></span></span>
