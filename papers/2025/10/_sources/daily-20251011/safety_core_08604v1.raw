</figure>
<figure id="A6.F12" class="ltx_figure"><img src="2510.08604v1/figure/SAA.png" id="A6.F12.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:548/281;" width="548" height="281" alt="Refer to caption">
