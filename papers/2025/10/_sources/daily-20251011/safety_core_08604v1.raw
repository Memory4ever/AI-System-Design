            <math id="alg1.m35" class="ltx_Math" alttext="d^{*}\leftarrow d" display="inline" intent=":literal"><semantics><mrow><msup><mi>d</mi><mo>∗</mo></msup><mo stretchy="false">←</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">d^{*}\leftarrow d</annotation></semantics></math>  <span id="alg1.4.12.1" class="ltx_text ltx_font_typewriter"><math id="alg1.m36" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> </span><span id="alg1.4.12.2" class="ltx_text ltx_font_typewriter">update distance</span>
</div>
