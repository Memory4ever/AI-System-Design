<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#A2.SS1" title="In Appendix B Dataset details ‣ Stronger Re-identification Attacks through Reasoning and Aggregation" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">B.1 </span>Wikipedia</span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#A2.SS2" title="In Appendix B Dataset details ‣ Stronger Re-identification Attacks through Reasoning and Aggregation" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">B.2 </span>TAB</span></a></li>
</ol></li>
<li class="ltx_tocentry ltx_tocentry_appendix"><a href="#A3" title="In Stronger Re-identification Attacks through Reasoning and Aggregation" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">C </span>Word Recall Results</span></a></li>
</ol></nav>
</nav>
<div class="ltx_page_main">
<div id="infobox" class="infobox">
  <a id="license-tr" href="https://info.arxiv.org/help/license/index.html#licenses-available">
