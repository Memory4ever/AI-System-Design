<td id="A1.T3.2.2.2" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t"><math id="A1.T3.m1" class="ltx_Math" alttext="10^{-5}" display="inline" intent=":literal"><semantics><msup><mn>10</mn><mrow><mo>−</mo><mn>5</mn></mrow></msup><annotation encoding="application/x-tex">10^{-5}</annotation></semantics></math></td></tr>
