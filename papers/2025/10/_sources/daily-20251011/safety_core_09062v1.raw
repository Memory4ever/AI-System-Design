</div>
<div id="lstnumberx137" class="ltx_listingline"><span id="lstnumberx137.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">For</span><span id="lstnumberx137.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx137.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">each</span><span id="lstnumberx137.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx137.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">section</span><span id="lstnumberx137.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx137.7" class="ltx_text ltx_font_typewriter">(**</span><span id="lstnumberx137.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Understanding</span><span id="lstnumberx137.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx137.10" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx137.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">U</span><span id="lstnumberx137.12" class="ltx_text ltx_font_typewriter">),</span><span id="lstnumberx137.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx137.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Facts</span><span id="lstnumberx137.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx137.16" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx137.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter">F</span><span id="lstnumberx137.18" class="ltx_text ltx_font_typewriter">),</span><span id="lstnumberx137.19" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx137.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Plan</span><span id="lstnumberx137.21" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx137.22" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx137.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter">P</span><span id="lstnumberx137.24" class="ltx_text ltx_font_typewriter">)**),</span><span id="lstnumberx137.25" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx137.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter">assign</span><span id="lstnumberx137.27" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx137.28" class="ltx_text ltx_font_typewriter">**1**</span><span id="lstnumberx137.29" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx137.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter">only</span><span id="lstnumberx137.31" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx137.32" class="ltx_text ltx_lst_identifier ltx_font_typewriter">if</span><span id="lstnumberx137.33" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx137.34" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx137.35" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx137.36" class="ltx_text ltx_lst_identifier ltx_font_typewriter">content</span><span id="lstnumberx137.37" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx137.38" class="ltx_text ltx_lst_identifier ltx_font_typewriter">fully</span><span id="lstnumberx137.39" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx137.40" class="ltx_text ltx_lst_identifier ltx_font_typewriter">aligns</span><span id="lstnumberx137.41" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx137.42" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx137.43" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Otherwise</span><span id="lstnumberx137.44" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx137.45" class="ltx_text ltx_lst_identifier ltx_font_typewriter">assign</span><span id="lstnumberx137.46" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx137.47" class="ltx_text ltx_font_typewriter">**0**.</span>
