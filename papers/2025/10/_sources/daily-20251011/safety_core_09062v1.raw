<div id="lstnumberx149" class="ltx_listingline"><span id="lstnumberx149.1" class="ltx_text ltx_font_typewriter">-</span><span id="lstnumberx149.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx149.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Consistency</span><span id="lstnumberx149.4" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx149.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx149.6" class="ltx_text ltx_font_typewriter">‘&lt;</span><span id="lstnumberx149.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">think</span><span id="lstnumberx149.8" class="ltx_text ltx_font_typewriter">&gt;‘</span><span id="lstnumberx149.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx149.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">uses</span><span id="lstnumberx149.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx149.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">only</span><span id="lstnumberx149.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx149.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx149.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx149.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter">facts</span><span id="lstnumberx149.17" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx149.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">listed</span><span id="lstnumberx149.19" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx149.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter">in</span><span id="lstnumberx149.21" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx149.22" class="ltx_text ltx_font_typewriter">‘&lt;</span><span id="lstnumberx149.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter">facts</span><span id="lstnumberx149.24" class="ltx_text ltx_font_typewriter">&gt;‘</span><span id="lstnumberx149.25" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx149.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter">and</span><span id="lstnumberx149.27" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx149.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter">does</span><span id="lstnumberx149.29" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx149.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter">not</span><span id="lstnumberx149.31" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx149.32" class="ltx_text ltx_lst_identifier ltx_font_typewriter">contradict</span><span id="lstnumberx149.33" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx149.34" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx149.35" class="ltx_text ltx_lst_identifier ltx_font_typewriter">invent</span><span id="lstnumberx149.36" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx149.37" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx149.38" class="ltx_text ltx_lst_identifier ltx_font_typewriter">or</span><span id="lstnumberx149.39" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx149.40" class="ltx_text ltx_lst_identifier ltx_font_typewriter">alter</span><span id="lstnumberx149.41" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx149.42" class="ltx_text ltx_lst_identifier ltx_font_typewriter">them</span><span id="lstnumberx149.43" class="ltx_text ltx_font_typewriter">.</span>
