ltx_font_typewriter"> </span><span id="lstnumberx96.46" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx96.47" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx96.48" class="ltx_text ltx_font_typewriter">5-7</span><span id="lstnumberx96.49" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx96.50" class="ltx_text ltx_lst_identifier ltx_font_typewriter">range</span><span id="lstnumberx96.51" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx96.52" class="ltx_text ltx_lst_identifier ltx_font_typewriter">instead</span><span id="lstnumberx96.53" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx96.54" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx96.55" class="ltx_text ltx_lst_identifier ltx_font_typewriter">If</span><span id="lstnumberx96.56" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx96.57" class="ltx_text ltx_lst_identifier ltx_font_typewriter">you</span><span id="lstnumberx96.58" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx96.59" class="ltx_text ltx_lst_identifier ltx_font_typewriter">already</span><span id="lstnumberx96.60" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx96.61" class="ltx_text ltx_lst_identifier ltx_font_typewriter">sense</span><span id="lstnumberx96.62" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx96.63" class="ltx_text ltx_lst_identifier ltx_font_typewriter">your</span><span id="lstnumberx96.64" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx96.65" class="ltx_text ltx_lst_identifier ltx_font_typewriter">confidence</span><span id="lstnumberx96.66" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx96.67" class="ltx_text ltx_lst_identifier ltx_font_typewriter">is</span><span id="lstnumberx96.68" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx96.69" class="ltx_text ltx_lst_identifier ltx_font_typewriter">below</span><span id="lstnumberx96.70" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx96.71" class="ltx_text ltx_font_typewriter">5,</span><span id="lstnumberx96.72" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx96.73" class="ltx_text ltx_lst_identifier ltx_font_typewriter">it</span><span id="lstnumberx96.74" class="ltx_text ltx_font_typewriter">’</span><span id="lstnumberx96.75" class="ltx_text ltx_lst_identifier ltx_font_typewriter">s</span><span id="lstnumberx96.76" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx96.77" class="ltx_text ltx_lst_identifier ltx_font_typewriter">likely</span><span id="lstnumberx96.78" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx96.79" class="ltx_text ltx_lst_identifier ltx_font_typewriter">even</span><span id="lstnumberx96.80" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx96.81" class="ltx_text ltx_lst_identifier ltx_font_typewriter">lower</span><span id="lstnumberx96.82" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx96.83" class="ltx_text ltx_font_typewriter">--</span><span id="lstnumberx96.84" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx96.85" class="ltx_text ltx_lst_identifier ltx_font_typewriter">consider</span><span id="lstnumberx96.86" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx96.87" class="ltx_text ltx_lst_identifier ltx_font_typewriter">giving</span><span id="lstnumberx96.88" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx96.89" class="ltx_text ltx_lst_identifier ltx_font_typewriter">a</span><span id="lstnumberx96.90" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx96.91" class="ltx_text ltx_lst_identifier ltx_font_typewriter">score</span><span id="lstnumberx96.92" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx96.93" class="ltx_text ltx_lst_identifier ltx_font_typewriter">closer</span><span id="lstnumberx96.94" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx96.95" class="ltx_text ltx_lst_identifier ltx_font_typewriter">to</span><span id="lstnumberx96.96" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx96.97" class="ltx_text ltx_font_typewriter">0-2.</span>
</div>
