<div id="lstnumberx144" class="ltx_listingline"><span id="lstnumberx144.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">If</span><span id="lstnumberx144.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx144.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">this</span><span id="lstnumberx144.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx144.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">condition</span><span id="lstnumberx144.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx144.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">fails</span><span id="lstnumberx144.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx144.9" class="ltx_text ltx_lst_literate ltx_font_typewriter"><math id="lstnumberx144.m1" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math></span><span id="lstnumberx144.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx144.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">U</span><span id="lstnumberx144.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx144.13" class="ltx_text ltx_font_typewriter">=</span><span id="lstnumberx144.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx144.15" class="ltx_text ltx_font_typewriter">0.</span>
