<th id="S4.T6.6.6.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T6.6.6.2.1" class="ltx_text ltx_font_typewriter">ReFIne-Qwen3-8B</span> <span id="S4.T6.6.6.2.2" class="ltx_text ltx_font_bold">(ours)</span></th>
<td id="S4.T6.6.6.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T6.6.6.3.1" class="ltx_text ltx_font_bold">0.179 <math id="S4.T6.m17" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.073</span></td>
