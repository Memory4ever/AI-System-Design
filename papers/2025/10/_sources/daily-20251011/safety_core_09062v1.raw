<div id="lstnumberx142" class="ltx_listingline"><span id="lstnumberx142.1" class="ltx_text ltx_font_typewriter">-</span><span id="lstnumberx142.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx142.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Exact</span><span id="lstnumberx142.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx142.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Match</span><span id="lstnumberx142.6" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx142.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx142.8" class="ltx_text ltx_font_typewriter">‘&lt;</span><span id="lstnumberx142.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">think</span><span id="lstnumberx142.10" class="ltx_text ltx_font_typewriter">&gt;‘</span><span id="lstnumberx142.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx142.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">matches</span><span id="lstnumberx142.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx142.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx142.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx142.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter">problem</span><span id="lstnumberx142.17" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx142.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">framing</span><span id="lstnumberx142.19" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx142.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter">in</span><span id="lstnumberx142.21" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx142.22" class="ltx_text ltx_font_typewriter">‘&lt;</span><span id="lstnumberx142.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter">understanding</span><span id="lstnumberx142.24" class="ltx_text ltx_font_typewriter">&gt;‘</span><span id="lstnumberx142.25" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx142.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter">exactly</span><span id="lstnumberx142.27" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx142.28" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx142.29" class="ltx_text ltx_lst_identifier ltx_font_typewriter">with</span><span id="lstnumberx142.30" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx142.31" class="ltx_text ltx_lst_identifier ltx_font_typewriter">no</span><span id="lstnumberx142.32" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx142.33" class="ltx_text ltx_lst_identifier ltx_font_typewriter">reinterpretations</span><span id="lstnumberx142.34" class="ltx_text ltx_font_typewriter">.</span>
