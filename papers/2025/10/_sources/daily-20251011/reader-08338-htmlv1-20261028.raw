<td id="A5.T1.2.5.16" class="ltx_td ltx_align_center ltx_border_t">2.97 <math id="A5.T1.m20" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.16</td></tr>
