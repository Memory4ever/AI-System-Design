<th id="S5.T3.2.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T3.2.1.1.3.1" class="ltx_text ltx_font_bold">Variant 2</span></th>
<th id="S5.T3.2.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T3.2.1.1.4.1" class="ltx_text ltx_font_bold">Variant 3</span></th></tr>
