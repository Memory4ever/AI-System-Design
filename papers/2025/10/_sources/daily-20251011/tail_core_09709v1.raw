</span></td></tr>
<tr id="S3.T1.2.8" class="ltx_tr">
<td id="S3.T1.2.8.1" class="ltx_td ltx_align_left ltx_align_top">
<span id="S3.T1.2.8.1.1" class="ltx_inline-block ltx_align_top" style="width:11.4pt;">
<span id="S3.T1.2.8.1.1.1" class="ltx_p ltx_align_right">7</span>
</span></td>
<td id="S3.T1.2.8.2" class="ltx_td ltx_align_left ltx_align_top">
<span id="S3.T1.2.8.2.1" class="ltx_inline-block ltx_align_top" style="width:28.5pt;">
<span id="S3.T1.2.8.2.1.1" class="ltx_p ltx_align_right">100</span>
</span></td>
