<span id="A1.T5.2.15.3.1.1" class="ltx_p"><math id="A1.T5.m25" class="ltx_Math" alttext="4,13,22,32,40," display="inline" intent=":literal"><semantics><mrow><mrow><mn>4</mn><mo>,</mo><mn>13</mn><mo>,</mo><mn>22</mn><mo>,</mo><mn>32</mn><mo>,</mo><mn>40</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">4,13,22,32,40,</annotation></semantics></math>…</span>
</span></td>
<td id="A1.T5.2.15.4" class="ltx_td ltx_align_left ltx_align_top">
<span id="A1.T5.2.15.4.1" class="ltx_inline-block ltx_align_top" style="width:37.0pt;">
<span id="A1.T5.2.15.4.1.1" class="ltx_p">o3</span>
</span></td>
