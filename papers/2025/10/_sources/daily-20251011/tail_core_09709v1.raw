<span id="A1.T5.2.22.1.1.1" class="ltx_p">P21</span>
</span></td>
<td id="A1.T5.2.22.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb">
<span id="A1.T5.2.22.2.1" class="ltx_inline-block ltx_align_top" style="width:31.3pt;">
<span id="A1.T5.2.22.2.1.1" class="ltx_p">difference</span>
