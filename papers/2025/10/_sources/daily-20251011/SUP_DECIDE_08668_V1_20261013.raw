<span id="Sx3.T2.7.1.1.1.1.1.1.36.7" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="Sx3.T2.7.1.1.1.1.1.1.36.7.1" class="ltx_text ltx_underline" style="--ltx-bg-color:#F9F5FB;">70.4</span></span>
<span id="Sx3.T2.7.1.1.1.1.1.1.36.8" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="Sx3.T2.7.1.1.1.1.1.1.36.8.1" class="ltx_text ltx_underline" style="--ltx-bg-color:#F9F5FB;">78.1</span></span>
<span id="Sx3.T2.7.1.1.1.1.1.1.36.9" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="Sx3.T2.7.1.1.1.1.1.1.36.9.1" class="ltx_text" style="--ltx-bg-color:#F9F5FB;">83.3</span></span></span>
