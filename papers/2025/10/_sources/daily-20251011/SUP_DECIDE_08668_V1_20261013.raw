<td id="Sx8.T1.5.1.9.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_r ltx_border_t"><span id="Sx8.T1.5.1.9.1.1" class="ltx_text ltx_font_bold">Hulu-Med (Ours)</span></td>
<td id="Sx8.T1.5.1.9.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r ltx_border_t"><span id="Sx8.T1.5.1.9.2.1" class="ltx_text ltx_font_bold">4B, 7B, 14B, 32B</span></td>
