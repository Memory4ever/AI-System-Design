<span id="Sx3.T2.7.1.1.1.1.1.1.37.6" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="Sx3.T2.7.1.1.1.1.1.1.37.6.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F9F5FB;">80.8</span></span>
