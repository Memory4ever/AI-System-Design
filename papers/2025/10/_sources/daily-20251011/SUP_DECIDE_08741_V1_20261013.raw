<td id="S3.T1.2.9.4" class="ltx_td ltx_align_right"><span id="S3.T1.2.9.4.1" class="ltx_text ltx_underline">.239</span></td></tr>
<tr id="S3.T1.2.10" class="ltx_tr">
<th id="S3.T1.2.10.1" class="ltx_td ltx_th ltx_th_row ltx_border_bb"></th>
