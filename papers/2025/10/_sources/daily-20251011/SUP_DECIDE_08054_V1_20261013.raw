<td id="A1.T8.4.1.52.2" class="ltx_td ltx_align_center"><span id="A1.T8.4.1.52.2.1" class="ltx_text" style="--ltx-fg-color:#808080;">21.25</span></td>
<td id="A1.T8.4.1.52.3" class="ltx_td ltx_align_center"><span id="A1.T8.4.1.52.3.1" class="ltx_text" style="--ltx-fg-color:#808080;">0.710</span></td>
<td id="A1.T8.4.1.52.4" class="ltx_td ltx_align_center"><span id="A1.T8.4.1.52.4.1" class="ltx_text" style="--ltx-fg-color:#808080;">0.112</span></td>
<td id="A1.T8.4.1.52.5" class="ltx_td ltx_align_center"><span id="A1.T8.4.1.52.5.1" class="ltx_text" style="--ltx-fg-color:#808080;">12.59</span></td></tr>
<tr id="A1.T8.4.1.53" class="ltx_tr">
<td id="A1.T8.4.1.53.1" class="ltx_td ltx_align_left">Z-STAR</td>
<td id="A1.T8.4.1.53.2" class="ltx_td ltx_align_center">18.38</td>
<td id="A1.T8.4.1.53.3" class="ltx_td ltx_align_center">0.679</td>
<td id="A1.T8.4.1.53.4" class="ltx_td ltx_align_center">0.321</td>
<td id="A1.T8.4.1.53.5" class="ltx_td ltx_align_center">15.50</td></tr>
<tr id="A1.T8.4.1.54" class="ltx_tr">
<td id="A1.T8.4.1.54.1" class="ltx_td ltx_align_left">RetouchLLM (GPT-5)</td>
<td id="A1.T8.4.1.54.2" class="ltx_td ltx_align_center">21.49</td>
<td id="A1.T8.4.1.54.3" class="ltx_td ltx_align_center">0.853</td>
<td id="A1.T8.4.1.54.4" class="ltx_td ltx_align_center">0.105</td>
<td id="A1.T8.4.1.54.5" class="ltx_td ltx_align_center"><span id="A1.T8.4.1.54.5.1" class="ltx_text ltx_font_bold">12.27</span></td></tr>
<tr id="A1.T8.4.1.55" class="ltx_tr">
<td id="A1.T8.4.1.55.1" class="ltx_td ltx_align_left">RetouchLLM (Gemini-1.5-Pro)</td>
<td id="A1.T8.4.1.55.2" class="ltx_td ltx_align_center">20.96</td>
<td id="A1.T8.4.1.55.3" class="ltx_td ltx_align_center">0.842</td>
<td id="A1.T8.4.1.55.4" class="ltx_td ltx_align_center">0.116</td>
<td id="A1.T8.4.1.55.5" class="ltx_td ltx_align_center">12.39</td></tr>
<tr id="A1.T8.4.1.56" class="ltx_tr">
<td id="A1.T8.4.1.56.1" class="ltx_td ltx_align_left">RetouchLLM (Qwen2.5-VL)</td>
<td id="A1.T8.4.1.56.2" class="ltx_td ltx_align_center">21.78</td>
<td id="A1.T8.4.1.56.3" class="ltx_td ltx_align_center">0.831</td>
<td id="A1.T8.4.1.56.4" class="ltx_td ltx_align_center">0.101</td>
<td id="A1.T8.4.1.56.5" class="ltx_td ltx_align_center">11.93</td></tr>
<tr id="A1.T8.4.1.57" class="ltx_tr">
<td id="A1.T8.4.1.57.1" class="ltx_td ltx_align_left ltx_border_bb">RetouchLLM (InternVL3)</td>
<td id="A1.T8.4.1.57.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="A1.T8.4.1.57.2.1" class="ltx_text ltx_font_bold">21.50</span></td>
<td id="A1.T8.4.1.57.3" class="ltx_td ltx_align_center ltx_border_bb">0.845</td>
<td id="A1.T8.4.1.57.4" class="ltx_td ltx_align_center ltx_border_bb">0.111</td>
