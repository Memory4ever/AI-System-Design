<td id="S4.T5.4.1.5.3" class="ltx_td ltx_align_center">21.93</td>
<td id="S4.T5.4.1.5.4" class="ltx_td ltx_align_center">0.899</td>
<td id="S4.T5.4.1.5.5" class="ltx_td ltx_align_center">0.072</td>
<td id="S4.T5.4.1.5.6" class="ltx_td ltx_align_center">10.58</td></tr>
<tr id="S4.T5.4.1.6" class="ltx_tr">
