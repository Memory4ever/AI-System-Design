<span id="S3.T1.5.1.1.1.1.3.2.1.2" class="ltx_tr">
<span id="S3.T1.5.1.1.1.1.3.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-top:2.3pt;padding-bottom:2.3pt;">(USD / 1K tokens)</span></span>
</span></span><span id="S3.T1.5.1.1.1.1.3.3" class="ltx_text"></span></span>
<span id="S3.T1.5.1.1.1.1.4" class="ltx_td ltx_align_right ltx_border_tt" style="padding-top:2.3pt;padding-bottom:2.3pt;">Source</span></span>
<span id="S3.T1.5.1.1.1.2" class="ltx_tr">
<span id="S3.T1.5.1.1.1.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:2.3pt;padding-bottom:2.3pt;">GPT<span id="S3.T1.5.1.1.1.2.1.1" class="ltx_text ltx_font_typewriter">-</span>4o (A)</span>
<span id="S3.T1.5.1.1.1.2.2" class="ltx_td ltx_align_right ltx_border_t" style="padding-top:2.3pt;padding-bottom:2.3pt;">$0.0050</span>
<span id="S3.T1.5.1.1.1.2.3" class="ltx_td ltx_align_right ltx_border_t" style="padding-top:2.3pt;padding-bottom:2.3pt;">$0.0200</span>
