<span id="S4.T4.5.1.1.1.1.2" class="ltx_td ltx_align_left ltx_border_tt" style="padding-top:2.3pt;padding-bottom:2.3pt;"><span id="S4.T4.5.1.1.1.1.2.1" class="ltx_text ltx_font_bold">Dataset</span></span>
<span id="S4.T4.5.1.1.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:2.3pt;padding-bottom:2.3pt;"><span id="S4.T4.5.1.1.1.1.3.1" class="ltx_text ltx_font_bold">Total Cases</span></span>
<span id="S4.T4.5.1.1.1.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:2.3pt;padding-bottom:2.3pt;"><span id="S4.T4.5.1.1.1.1.4.1" class="ltx_text"></span> <span id="S4.T4.5.1.1.1.1.4.2" class="ltx_text">
