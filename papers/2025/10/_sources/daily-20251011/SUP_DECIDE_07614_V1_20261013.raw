<span id="S3.T1.5.1.1.1.3.2" class="ltx_td ltx_align_right" style="padding-top:2.3pt;padding-bottom:2.3pt;">$0.0030</span>
<span id="S3.T1.5.1.1.1.3.3" class="ltx_td ltx_align_right" style="padding-top:2.3pt;padding-bottom:2.3pt;">$0.0150</span>
<span id="S3.T1.5.1.1.1.3.4" class="ltx_td ltx_align_right" style="padding-top:2.3pt;padding-bottom:2.3pt;"><cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib30" title="" class="ltx_ref">30</a>]</cite></span></span>
<span id="S3.T1.5.1.1.1.4" class="ltx_tr">
<span id="S3.T1.5.1.1.1.4.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding-top:2.3pt;padding-bottom:2.3pt;">Gemini 2.5 Pro (C)</span>
<span id="S3.T1.5.1.1.1.4.2" class="ltx_td ltx_align_right ltx_border_bb" style="padding-top:2.3pt;padding-bottom:2.3pt;">$0.00125</span>
