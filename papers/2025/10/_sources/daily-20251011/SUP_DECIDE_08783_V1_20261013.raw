<span id="S3.T2.6.3.1.1" class="ltx_inline-block ltx_align_top" style="width:46.9pt;">
<span id="S3.T2.6.3.1.1.1" class="ltx_p"><span id="S3.T2.6.3.1.1.1.1" class="ltx_text"></span><span id="S3.T2.6.3.1.1.1.2" class="ltx_text" style="font-size:90%;"> </span><span id="S3.T2.6.3.1.1.1.3" class="ltx_text" style="font-size:90%;">
<span id="S3.T2.6.3.1.1.1.3.1" class="ltx_tabular ltx_align_middle">
<span id="S3.T2.6.3.1.1.1.3.1.1" class="ltx_tr">
<span id="S3.T2.6.3.1.1.1.3.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:-0.25pt 2.8pt;"><span id="S3.T2.6.3.1.1.1.3.1.1.1.1" class="ltx_text ltx_font_bold ltx_font_smallcaps" style="--ltx-fg-color:#0F9D58;">Ease of</span></span></span>
<span id="S3.T2.6.3.1.1.1.3.1.2" class="ltx_tr">
<span id="S3.T2.6.3.1.1.1.3.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:-0.25pt 2.8pt;"><span id="S3.T2.6.3.1.1.1.3.1.2.1.1" class="ltx_text ltx_font_bold ltx_font_smallcaps" style="--ltx-fg-color:#0F9D58;">Use</span></span></span>
</span></span><span id="S3.T2.6.3.1.1.1.4" class="ltx_text"></span></span>
</span></td>
<td id="S3.T2.6.3.2" class="ltx_td ltx_align_left ltx_border_t" style="padding:-0.25pt 2.8pt;"><span id="S3.T2.6.3.2.1" class="ltx_text" style="font-size:90%;">Human</span></td>
<td id="S3.T2.6.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.25pt 2.8pt;"><span id="S3.T2.6.3.3.1" class="ltx_text" style="font-size:90%;">6.20 <span id="S3.T2.6.3.3.1.1" class="ltx_text" style="font-size:78%;--ltx-fg-color:#8C8C8C;">(1.08)</span></span></td>
