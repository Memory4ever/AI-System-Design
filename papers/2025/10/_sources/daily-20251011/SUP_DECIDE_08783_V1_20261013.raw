<td id="S4.T4.4.1.4.8" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:9.3pt;padding-right:9.3pt;"><span id="S4.T4.4.1.4.8.1" class="ltx_text" style="font-size:90%;">52.47</span></td>
