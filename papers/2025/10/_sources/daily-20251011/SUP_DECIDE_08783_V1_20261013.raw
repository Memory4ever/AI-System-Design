<span id="S3.T2.6.2.5.2.1.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:-0.25pt 2.8pt;"><span id="S3.T2.6.2.5.2.1.1.1.1.1" class="ltx_text ltx_font_bold">Comm. &amp;</span></span></span>
