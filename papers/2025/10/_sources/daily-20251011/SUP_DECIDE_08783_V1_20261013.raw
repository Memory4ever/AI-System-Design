<td id="S4.T4.4.1.4.10" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="padding-left:9.3pt;padding-right:9.3pt;"><span id="S4.T4.4.1.4.10.1" class="ltx_text ltx_font_bold" style="font-size:90%;">52.91</span></td>
