<th id="A2.T4.10.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A2.T4.10.1.3.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">SDI</span><span id="A2.T4.10.1.3.1.2" class="ltx_text" style="font-size:80%;"> </span><cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib32" title="" class="ltx_ref">32</a>]</cite></th>
<th id="A2.T4.10.1.3.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A2.T4.10.1.3.2.1" class="ltx_text" style="font-size:80%;">CVPR’ 22</span></th>
<td id="A2.T4.10.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A2.T4.10.1.3.3.1" class="ltx_text" style="font-size:80%;">23.25</span></td>
<td id="A2.T4.10.1.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A2.T4.10.1.3.4.1" class="ltx_text" style="font-size:80%;">6.94</span></td>
