<td id="S3.T1.13.1.3.8" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S3.T1.13.1.3.8.1" class="ltx_text" style="font-size:50%;">49.26</span></td>
