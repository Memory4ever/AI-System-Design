<th id="A2.T4.10.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tttt" style="padding-left:5.0pt;padding-right:5.0pt;" colspan="4"><span id="A2.T4.10.1.1.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Masked Region Preservation</span></th>
<th id="A2.T4.10.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tttt" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A2.T4.10.1.1.3.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Text Alignment</span></th></tr>
