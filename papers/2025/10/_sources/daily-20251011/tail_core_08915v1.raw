<td id="S6.T7.3.1.7.6" class="ltx_td ltx_align_center">1.4%</td></tr>
<tr id="S6.T7.3.1.8" class="ltx_tr">
<td id="S6.T7.3.1.8.1" class="ltx_td ltx_align_center">Space</td>
<td id="S6.T7.3.1.8.2" class="ltx_td ltx_align_center" style="--ltx-bg-color:#339C52;"><span id="S6.T7.3.1.8.2.1" class="ltx_text" style="--ltx-bg-color:#339C52;"><span id="S6.T7.3.1.8.2.1.1" class="ltx_text" style="--ltx-fg-color:#FFFFFF;"> 95.00</span></span></td>
<td id="S6.T7.3.1.8.3" class="ltx_td ltx_align_right">1.6%   <span class="ltx_rule" style="width:1.0pt;--ltx-bg-color:black;display:inline-block;"> </span></td>
<td id="S6.T7.3.1.8.4" class="ltx_td ltx_align_center">Netspeak</td>
<td id="S6.T7.3.1.8.5" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FC7A5C;"><span id="S6.T7.3.1.8.5.1" class="ltx_text" style="--ltx-bg-color:#FC7A5C;"><span id="S6.T7.3.1.8.5.1.1" class="ltx_text" style="--ltx-fg-color:#000000;"> -74.09</span></span></td>
