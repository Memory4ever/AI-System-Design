<td id="A2.T11.2.1.5.2" class="ltx_td ltx_align_center ltx_border_t"><span id="A2.T11.2.1.5.2.1" class="ltx_text ltx_font_italic">Boring</span></td></tr>
<tr id="A2.T11.2.1.6" class="ltx_tr">
<td id="A2.T11.2.1.6.1" class="ltx_td ltx_align_center"><span id="A2.T11.2.1.6.1.1" class="ltx_text ltx_font_italic">Unfriendly</span></td></tr>
