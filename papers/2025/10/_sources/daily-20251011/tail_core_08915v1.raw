<div id="A1.T8.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:103.3pt;vertical-align:-47.4pt;"><span class="ltx_transformed_inner" style="transform:translate(70.3pt,-21.0pt) scale(1.68749686531981,1.68749686531981) ;">
