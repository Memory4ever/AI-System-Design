<td id="A2.T11.2.1.8.3" class="ltx_td ltx_align_center ltx_border_t"><span id="A2.T11.2.1.8.3.1" class="ltx_text ltx_font_italic">Kind</span></td></tr>
<tr id="A2.T11.2.1.9" class="ltx_tr">
<td id="A2.T11.2.1.9.1" class="ltx_td ltx_align_center"><span id="A2.T11.2.1.9.1.1" class="ltx_text ltx_font_italic">Compassionate</span></td></tr>
<tr id="A2.T11.2.1.10" class="ltx_tr">
