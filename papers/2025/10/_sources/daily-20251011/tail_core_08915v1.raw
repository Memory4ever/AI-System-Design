<td id="A12.T27.2.1.3.6" class="ltx_td ltx_align_center"><math id="A12.T27.m4" class="ltx_Math" alttext="\displaystyle N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">\displaystyle N</annotation></semantics></math></td></tr>
