<tr id="S6.T7.3.1.6" class="ltx_tr">
<td id="S6.T7.3.1.6.1" class="ltx_td ltx_align_center">Relative</td>
<td id="S6.T7.3.1.6.2" class="ltx_td ltx_align_center" style="--ltx-bg-color:#03702E;"><span id="S6.T7.3.1.6.2.1" class="ltx_text" style="--ltx-bg-color:#03702E;"><span id="S6.T7.3.1.6.2.1.1" class="ltx_text" style="--ltx-fg-color:#FFFFFF;"> 110.53</span></span></td>
