<td id="A7.T19.2.1.1.5" class="ltx_td ltx_align_center ltx_border_t">Spearman <math id="A7.T19.m4" class="ltx_Math" alttext="\displaystyle r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">\displaystyle r</annotation></semantics></math></td></tr>
