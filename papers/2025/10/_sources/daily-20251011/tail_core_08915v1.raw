<td id="A2.T11.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="A2.T11.2.1.2.4.1" class="ltx_text ltx_font_italic">Hospitable</span></td></tr>
<tr id="A2.T11.2.1.3" class="ltx_tr">
<td id="A2.T11.2.1.3.1" class="ltx_td ltx_align_center"><span id="A2.T11.2.1.3.1.1" class="ltx_text ltx_font_italic">Welcoming</span></td></tr>
<tr id="A2.T11.2.1.4" class="ltx_tr">
