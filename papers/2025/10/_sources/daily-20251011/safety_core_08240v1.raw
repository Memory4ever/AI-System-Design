<div class="ltx_pagination ltx_role_newpage"></div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
<section id="A6" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix F </span>Qualitative examples</h2>

<div id="A6.p1" class="ltx_para ltx_noindent">
<p id="A6.p1.1" class="ltx_p"><span id="A6.p1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">WARNING: qualitative examples contain explicit content.</span></p>
</div>
