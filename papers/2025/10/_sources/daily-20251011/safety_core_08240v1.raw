/span><span id="lstnumberx43.74" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx43.75" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">permitted</span><span id="lstnumberx43.76" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx43.77" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">as</span><span id="lstnumberx43.78" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx43.79" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">long</span><span id="lstnumberx43.80" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx43.81" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">as</span><span id="lstnumberx43.82" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx43.83" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">the</span><span id="lstnumberx43.84" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx43.85" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">assistant</span><span id="lstnumberx43.86" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx43.87" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">does</span><span id="lstnumberx43.88" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx43.89" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">not</span><span id="lstnumberx43.90" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx43.91" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">promote</span><span id="lstnumberx43.92" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx43.93" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">or</span><span id="lstnumberx43.94" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx43.95" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">facilitate</span><span id="lstnumberx43.96" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx43.97" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">harm</span><span id="lstnumberx43.98" class="ltx_text ltx_font_typewriter" style="font-size:80%;">."</span>
