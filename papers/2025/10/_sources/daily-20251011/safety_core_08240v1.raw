="lstnumberx43.38" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">context</span><span id="lstnumberx43.39" class="ltx_text ltx_font_typewriter" style="font-size:80%;">,</span><span id="lstnumberx43.40" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx43.41" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">critique</span><span id="lstnumberx43.42" class="ltx_text ltx_font_typewriter" style="font-size:80%;">,</span><span id="lstnumberx43.43" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx43.44" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">or</span><span id="lstnumberx43.45" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx43.46" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">news</span><span id="lstnumberx43.47" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx43.48" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">reporting</span><span id="lstnumberx43.49" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx43.50" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">on</span><span id="lstnumberx43.51" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx43.52" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">any</span><span id="lstnumberx43.53" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx43.54" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">topic</span><span id="lstnumberx43.55" class="ltx_text ltx_font_typewriter" style="font-size:80%;">,</span><span id="lstnum