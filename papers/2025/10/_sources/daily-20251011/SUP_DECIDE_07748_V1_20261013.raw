<span id="S4.T6.1.3.3.1.1" class="ltx_p ltx_align_center"><math id="S4.T6.m2" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo>∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math>500</span>
</span></td>
<td id="S4.T6.1.3.4" class="ltx_td ltx_align_left ltx_align_middle ltx_border_r ltx_border_t">
