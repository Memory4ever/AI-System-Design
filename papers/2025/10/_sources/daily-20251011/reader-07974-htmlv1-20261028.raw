<td id="S4.T2.2.33.3" class="ltx_td ltx_align_left ltx_border_bb">88.67<sub id="S4.T2.2.33.3.1" class="ltx_sub"><span id="S4.T2.2.33.3.1.1" class="ltx_text ltx_font_italic">↑0.67</span></sub></td>
