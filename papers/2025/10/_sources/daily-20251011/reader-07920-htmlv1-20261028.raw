<th id="S2.T1.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S2.T1.5.1.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;">PC<span id="S2.T1.5.1.2.1.1" class="ltx_text ltx_font_medium"> <math id="S2.T1.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></span></th>
