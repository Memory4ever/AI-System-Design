              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
              
              
              Update <math id="alg1.l8.m1" class="ltx_Math" alttext="C\leftarrow\arg\min\left\{\begin{aligned} &amp;\alpha\cdot\text{PC}(C)+\beta\cdot\text{CI}(C)\\
&amp;\quad-\gamma\cdot\text{IDS}(C)\end{aligned}\right\}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo stretchy="false">←</mo><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mi>min</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mi>α</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mtext>PC</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mi>β</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mtext>CI</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>−</mo><mi>γ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mtext>IDS</mtext><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mtd></mtr></mtable><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C\leftarrow\arg\min\left\{\begin{aligned} &amp;\alpha\cdot\text{PC}(C)+\beta\cdot\text{CI}(C)\\
&amp;\quad-\gamma\cdot\text{IDS}(C)\end{aligned}\right\}</annotation></semantics></math>

</div>
