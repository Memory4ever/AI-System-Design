<th id="S2.T1.5.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S2.T1.5.1.4.1" class="ltx_text ltx_font_bold" style="font-size:80%;">IDS<span id="S2.T1.5.1.4.1.1" class="ltx_text ltx_font_medium"> <math id="S2.T1.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></span></th></tr>
</thead>
<tbody class="ltx_tbody">
