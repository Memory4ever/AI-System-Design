              Evaluate <math id="alg1.l7.m1" class="ltx_Math" alttext="\text{PC},\text{CI},\text{IDS}" display="inline" intent=":literal"><semantics><mrow><mtext>PC</mtext><mo>,</mo><mtext>CI</mtext><mo>,</mo><mtext>IDS</mtext></mrow><annotation encoding="application/x-tex">\text{PC},\text{CI},\text{IDS}</annotation></semantics></math> on <math id="alg1.l7.m2" class="ltx_Math" alttext="\phi(C,D)" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo>,</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi(C,D)</annotation></semantics></math> and <math id="alg1.l7.m3" class="ltx_Math" alttext="\phi(C,D_{\text{cf}})" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo>,</mo><msub><mi>D</mi><mtext>cf</mtext></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi(C,D_{\text{cf}})</annotation></semantics></math>

</div>
