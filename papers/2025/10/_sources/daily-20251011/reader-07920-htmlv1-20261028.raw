            <span id="alg1.l4.3" class="ltx_text ltx_font_bold">while</span> not converged <span id="alg1.l4.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
              <math id="alg1.l5.m1" class="ltx_Math" alttext="C\leftarrow\text{MCTS}(C,D)" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo stretchy="false">←</mo><mrow><mtext>MCTS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo>,</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C\leftarrow\text{MCTS}(C,D)</annotation></semantics></math> <span id="alg1.l5.3" class="ltx_text" style="float:right;"><math id="alg1.l5.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Optimize strategy
</span>
</div>
<div id="alg1.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
              
              
              <math id="alg1.l6.m1" class="ltx_Math" alttext="D_{\text{cf}}\leftarrow\text{Perturb}(D,\delta)" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mtext>cf</mtext></msub><mo stretchy="false">←</mo><mrow><mtext>Perturb</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo>,</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">D_{\text{cf}}\leftarrow\text{Perturb}(D,\delta)</annotation></semantics></math> <span id="alg1.l6.3" class="ltx_text" style="float:right;"><math id="alg1.l6.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Counterfactual data
</span>
</div>
