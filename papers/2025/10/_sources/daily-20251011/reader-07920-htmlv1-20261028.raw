              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
              
              
            Optimized strategy <math id="alg1.l10.m1" class="ltx_Math" alttext="C^{*}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">C^{*}</annotation></semantics></math>

