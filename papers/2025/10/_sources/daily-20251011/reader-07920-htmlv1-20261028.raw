<td id="S2.T1.5.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S2.T1.5.2.4.1" class="ltx_text" style="font-size:80%;">0.2766</span></td></tr>
