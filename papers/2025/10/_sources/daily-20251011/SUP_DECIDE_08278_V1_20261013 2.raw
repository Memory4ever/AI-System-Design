            Final prediction <math id="alg1.l4.m1" class="ltx_Math" alttext="b^{*}" display="inline" intent=":literal"><semantics><msup><mi>b</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">b^{*}</annotation></semantics></math>

</div>
<div id="alg1.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
            Compute IoU: <math id="alg1.l5.m1" class="ltx_Math" alttext="iou\leftarrow\text{IoU}(b^{0}_{aug},b^{0}_{depth})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo stretchy="false">←</mo><mrow><mtext>IoU</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>b</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mn>0</mn></msubsup><mo>,</mo><msubsup><mi>b</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mn>0</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">iou\leftarrow\text{IoU}(b^{0}_{aug},b^{0}_{depth})</annotation></semantics></math>

</div>
<div id="alg1.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
              
              
            <span id="alg1.l6.3" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l6.m1" class="ltx_Math" alttext="iou\geq T_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo>≥</mo><msub><mi>T</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">iou\geq T_{1}</annotation></semantics></math> <span id="alg1.l6.4" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg1.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
              
              
              <math id="alg1.l7.m1" class="ltx_Math" alttext="b^{*}\leftarrow b^{0}_{aug}" display="inline" intent=":literal"><semantics><mrow><msup><mi>b</mi><mo>∗</mo></msup><mo stretchy="false">←</mo><msubsup><mi>b</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mn>0</mn></msubsup></mrow><annotation encoding="application/x-tex">b^{*}\leftarrow b^{0}_{aug}</annotation></semantics></math>

</div>
<div id="alg1.l8" class="ltx_listingline">
