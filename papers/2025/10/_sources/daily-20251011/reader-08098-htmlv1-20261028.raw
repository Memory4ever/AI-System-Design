<td id="A2.T7.2.1.2" class="ltx_td ltx_align_center" style="padding-left:4.5pt;padding-right:4.5pt;" colspan="2"><span id="A2.T7.2.1.2.1" class="ltx_text ltx_font_bold">GPT-5</span></td>
<td id="A2.T7.2.1.3" class="ltx_td ltx_align_center" style="padding-left:4.5pt;padding-right:4.5pt;" colspan="2">
<table id="A2.T7.2.1.3.1" class="ltx_tabular ltx_align_middle">
<tr id="A2.T7.2.1.3.1.1" class="ltx_tr">
<td id="A2.T7.2.1.3.1.1.1" class="ltx_td ltx_align_center" style="padding-left:4.5pt;padding-right:4.5pt;"><span id="A2.T7.2.1.3.1.1.1.1" class="ltx_text ltx_font_bold">GPT-5</span></td></tr>
<tr id="A2.T7.2.1.3.1.2" class="ltx_tr">
<td id="A2.T7.2.1.3.1.2.1" class="ltx_td ltx_align_center" style="padding-left:4.5pt;padding-right:4.5pt;"><span id="A2.T7.2.1.3.1.2.1.1" class="ltx_text ltx_font_bold">mini</span></td></tr>
