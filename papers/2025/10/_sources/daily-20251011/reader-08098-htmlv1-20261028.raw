<span id="A2.F23.p8" class="ltx_para ltx_noindent" style="--ltx-bg-color:#FFD9B8;">
<span id="A2.F23.p8.1" class="ltx_p"><span id="A2.F23.p8.1.1" class="ltx_text"></span><span id="A2.F23.p8.1.2" class="ltx_text">
<span id="A2.F23.p8.1.2.1" class="ltx_tabular ltx_align_middle">
<span id="A2.F23.p8.1.2.1.1" class="ltx_tr">
<span id="A2.F23.p8.1.2.1.1.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_align_top" style="padding-left:0.0pt;padding-right:0.0pt;">
