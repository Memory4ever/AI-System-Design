<td id="S5.F7.2.1.4" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.F7.2.1.4.1" class="ltx_text ltx_font_bold">EN</span></td>
<td id="S5.F7.2.1.5" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.F7.2.1.5.1" class="ltx_text ltx_font_bold">IT</span></td></tr>
