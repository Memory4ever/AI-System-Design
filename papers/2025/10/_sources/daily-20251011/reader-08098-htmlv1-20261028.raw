<td id="A2.T9.2.4.6" class="ltx_td ltx_align_center ltx_border_b" style="padding-left:4.5pt;padding-right:4.5pt;">19</td>
<td id="A2.T9.2.4.7" class="ltx_td ltx_align_center ltx_border_b ltx_border_r" style="padding-left:4.5pt;padding-right:4.5pt;">19</td>
<td id="A2.T9.2.4.8" class="ltx_td ltx_align_center ltx_border_b" style="padding-left:4.5pt;padding-right:4.5pt;">20</td>
<td id="A2.T9.2.4.9" class="ltx_td ltx_align_center ltx_border_b ltx_border_r" style="padding-left:4.5pt;padding-right:4.5pt;">18</td>
<td id="A2.T9.2.4.10" class="ltx_td ltx_align_center ltx_border_b" style="padding-left:4.5pt;padding-right:4.5pt;">20</td>
