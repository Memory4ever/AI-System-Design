<td id="A2.T9.2.4.2" class="ltx_td ltx_align_center ltx_border_b" style="padding-left:4.5pt;padding-right:4.5pt;">19</td>
<td id="A2.T9.2.4.3" class="ltx_td ltx_align_center ltx_border_b ltx_border_r" style="padding-left:4.5pt;padding-right:4.5pt;">20</td>
