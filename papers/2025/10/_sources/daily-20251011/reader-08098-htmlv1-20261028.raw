<span id="S3.F1.p6.1.2.1" class="ltx_tabular ltx_align_middle">
<span id="S3.F1.p6.1.2.1.1" class="ltx_tr">
<span id="S3.F1.p6.1.2.1.1.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_align_top" style="padding-left:0.0pt;padding-right:0.0pt;">
