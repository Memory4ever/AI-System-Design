<td id="A2.F23.2.5.2" class="ltx_td ltx_nopad_l ltx_align_left ltx_align_top" style="--ltx-bg-color:#CCFFE6;padding-left:0.0pt;padding-right:0.0pt;" colspan="3"><span id="A2.F23.2.5.2.1" class="ltx_inline-logical-block ltx_align_top" style="width:207.0pt;">
