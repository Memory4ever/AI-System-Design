<td id="A1.T2.2.3.2" class="ltx_td ltx_align_left"><span id="A1.T2.2.3.2.1" class="ltx_text ltx_font_italic">maybe</span>, <span id="A1.T2.2.3.2.2" class="ltx_text ltx_font_italic">perhaps</span>, <span id="A1.T2.2.3.2.3" class="ltx_text ltx_font_italic">can</span>, <span id="A1.T2.2.3.2.4" class="ltx_text ltx_font_italic">could</span></td></tr>
<tr id="A1.T2.2.4" class="ltx_tr">
<td id="A1.T2.2.4.1" class="ltx_td ltx_align_left"><span id="A1.T2.2.4.1.1" class="ltx_text ltx_font_typewriter">UNDERMINE</span></td>
<td id="A1.T2.2.4.2" class="ltx_td ltx_align_left"><span id="A1.T2.2.4.2.1" class="ltx_text ltx_font_italic">but</span>, <span id="A1.T2.2.4.2.2" class="ltx_text ltx_font_italic">however</span>, <span id="A1.T2.2.4.2.3" class="ltx_text ltx_font_italic">wait</span></td></tr>
<tr id="A1.T2.2.5" class="ltx_tr">
<td id="A1.T2.2.5.1" class="ltx_td ltx_align_left"><span id="A1.T2.2.5.1.1" class="ltx_text ltx_font_typewriter">ALTERNATIVE</span></td>
<td id="A1.T2.2.5.2" class="ltx_td ltx_align_left"><span id="A1.T2.2.5.2.1" class="ltx_text ltx_font_italic">alternatively</span>, <span id="A1.T2.2.5.2.2" class="ltx_text ltx_font_italic">another</span></td></tr>
<tr id="A1.T2.2.6" class="ltx_tr">
<td id="A1.T2.2.6.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="A1.T2.2.6.1.1" class="ltx_text ltx_font_typewriter">CONCLUDE</span></td>
<td id="A1.T2.2.6.2" class="ltx_td ltx_align_left ltx_border_bb"><span id="A1.T2.2.6.2.1" class="ltx_text ltx_font_italic">so</span>, <span id="A1.T2.2.6.2.2" class="ltx_text ltx_font_italic">thus</span></td></tr>
</table>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 2: </span>Cue words used to label sentences of one reasoning trace into FSM states. We lowercase, lemmatize, and match whole tokens; punctuation is stripped; negation is ignored.</figcaption>
</figure>
<figure id="A1.T3" class="ltx_table">
<table id="A1.T3.2" class="ltx_tabular ltx_centering ltx_align_middle">
<tr id="A1.T3.2.1" class="ltx_tr">
<td id="A1.T3.2.1.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_tt">
<span id="A1.T3.2.1.1.1" class="ltx_inline-block ltx_align_top" style="width:189.8pt;">
<span id="A1.T3.2.1.1.1.1" class="ltx_p"><span id="A1.T3.2.1.1.1.1.1" class="ltx_text ltx_font_bold">Condition</span></span>
</span></td>
<td id="A1.T3.2.1.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_tt">
<span id="A1.T3.2.1.2.1" class="ltx_inline-block ltx_align_top" style="width:120.8pt;">
<span id="A1.T3.2.1.2.1.1" class="ltx_p"><span id="A1.T3.2.1.2.1.1.1" class="ltx_text ltx_font_bold">Outcome</span></span>
</span></td></tr>
<tr id="A1.T3.2.2" class="ltx_tr">
<td id="A1.T3.2.2.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="A1.T3.2.2.1.1" class="ltx_inline-block ltx_align_top" style="width:189.8pt;">
<span id="A1.T3.2.2.1.1.1" class="ltx_p">Multiple labels include <span id="A1.T3.2.2.1.1.1.1" class="ltx_text ltx_font_typewriter">CONCLUDE</span></span>
</span></td>
<td id="A1.T3.2.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="A1.T3.2.2.2.1" class="ltx_inline-block ltx_align_top" style="width:120.8pt;">
<span id="A1.T3.2.2.2.1.1" class="ltx_p">Drop <span id="A1.T3.2.2.2.1.1.1" class="ltx_text ltx_font_typewriter">CONCLUDE</span> and re-evaluate</span>
</span></td></tr>
<tr id="A1.T3.2.3" class="ltx_tr">
