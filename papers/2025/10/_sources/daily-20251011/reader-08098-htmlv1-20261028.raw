<td id="S5.F7.2.2.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">completion</td>
<td id="S5.F7.2.2.3" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#1F78B5;padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.F7.2.2.3.1" class="ltx_text" style="--ltx-fg-color:#FFFFFF;--ltx-bg-color:#1F78B5;">1.00</span></td>
<td id="S5.F7.2.2.4" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#1F78B5;padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.F7.2.2.4.1" class="ltx_text" style="--ltx-fg-color:#FFFFFF;--ltx-bg-color:#1F78B5;">1.00</span></td>
<td id="S5.F7.2.2.5" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#1F78B5;padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.F7.2.2.5.1" class="ltx_text" style="--ltx-fg-color:#FFFFFF;--ltx-bg-color:#1F78B5;">1.00</span></td></tr>
<tr id="S5.F7.2.3" class="ltx_tr">
<td id="S5.F7.2.3.1" class="ltx_td ltx_align_left ltx_border_r" style="padding-left:4.0pt;padding-right:4.0pt;">reasoning</td>
<td id="S5.F7.2.3.2" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FCBF70;padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.F7.2.3.2.1" class="ltx_text" style="--ltx-fg-color:#000000;--ltx-bg-color:#FCBF70;">0.84</span></td>
<td id="S5.F7.2.3.3" class="ltx_td ltx_align_center" style="--ltx-bg-color:#1F78B5;padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.F7.2.3.3.1" class="ltx_text" style="--ltx-fg-color:#FFFFFF;--ltx-bg-color:#1F78B5;">1.00</span></td>
<td id="S5.F7.2.3.4" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FCBF70;padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.F7.2.3.4.1" class="ltx_text" style="--ltx-fg-color:#000000;--ltx-bg-color:#FCBF70;">0.84</span></td></tr>
