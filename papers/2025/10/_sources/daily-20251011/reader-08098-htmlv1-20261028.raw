<td id="A4.T13.2.1.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A4.T13.2.1.2.1" class="ltx_text ltx_font_bold">Pareto-adherence</span></td></tr>
<tr id="A4.T13.2.2" class="ltx_tr">
