</div>
<div id="alg2.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
              
              
              <math id="alg2.l12.m1" class="ltx_Math" alttext="e_{cand}\leftarrow\textsc{Generator.Query}(P_{gen})" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">Generator.Query</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">e_{cand}\leftarrow\textsc{Generator.Query}(P_{gen})</annotation></semantics></math>

</div>
<div id="alg2.l13" class="ltx_listingline">
