              <math id="alg2.l14.m1" class="ltx_Math" alttext="P_{rev}\leftarrow\textsc{BuildReviewerPrompt}(e_{cand},\mathcal{S}_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">BuildReviewerPrompt</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P_{rev}\leftarrow\textsc{BuildReviewerPrompt}(e_{cand},\mathcal{S}_{t})</annotation></semantics></math>

</div>
<div id="alg2.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
              
              
              <span id="alg2.l15.3" class="ltx_text ltx_font_bold">if</span> <span id="alg2.l15.4" class="ltx_text ltx_font_smallcaps">Reviewer.Query</span>( <math id="alg2.l15.m1" class="ltx_Math" alttext="P_{rev}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub><annotation encoding="application/x-tex">P_{rev}</annotation></semantics></math> ) = <span id="alg2.l15.5" class="ltx_text ltx_font_smallcaps">APPROVE</span> <span id="alg2.l15.6" class="ltx_text ltx_font_bold">then</span>



</div>
<div id="alg2.l16" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
              
              
               <math id="alg2.l16.m1" class="ltx_Math" alttext="E_{new}\leftarrow E_{new}\cup\{e_{cand}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msub><mo stretchy="false">←</mo><mrow><msub><mi>E</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msub><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>e</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">E_{new}\leftarrow E_{new}\cup\{e_{cand}\}</annotation></semantics></math>

</div>
<div id="alg2.l17" class="ltx_listingline">
