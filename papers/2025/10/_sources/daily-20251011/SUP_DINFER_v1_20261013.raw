<td id="A4.T4.2.3.7" class="ltx_td ltx_align_center ltx_border_r">4.44</td>
<td id="A4.T4.2.3.8" class="ltx_td ltx_align_center">3.37</td></tr>
<tr id="A4.T4.2.4" class="ltx_tr">
<td id="A4.T4.2.4.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" rowspan="2"><span id="A4.T4.2.4.1.1" class="ltx_text">
