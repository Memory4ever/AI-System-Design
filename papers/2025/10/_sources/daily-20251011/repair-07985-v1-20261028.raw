</div>
            
<div id="A1.F4.p3" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A1.F4.p3.pic1" class="ltx_picture" height="60.16" overflow="visible" version="1.1" viewBox="0 0 550 60.16" width="550"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,60.16) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#1A1A1A;" fill="#1A1A1A" fill-opacity="1.0"><path style="stroke:none" d="M 0 6.64 L 0 53.52 C 0 57.18 2.97 60.16 6.64 60.16 L 543.36 60.16 C 547.03 60.16 550 57.18 550 53.52 L 550 6.64 C 550 2.97 547.03 0 543.36 0 L 6.64 0 C 2.97 0 0 2.97 0 6.64 Z"></path></g><g style="--ltx-fill-color:#E6E6E6;" fill="#E6E6E6" fill-opacity="1.0"><path style="stroke:none" d="M 1.11 6.64 L 1.11 37.88 L 548.89 37.88 L 548.89 6.64 C 548.89 3.58 546.42 1.11 543.36 1.11 L 6.64 1.11 C 3.58 1.11 1.11 3.58 1.11 6.64 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 13.35 45.62)"><foreignObject style="--ltx-fo-width:32.89em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.18" overflow="visible" transform="matrix(1 0 0 -1 0 9.49)" width="455.11"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
