</span></span></span></foreignObject></g></g></svg></span>
</div>
            
<div id="A1.F4.p2" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A1.F4.p2.pic1" class="ltx_picture" height="90.79" overflow="visible" version="1.1" viewBox="0 0 550 90.79" width="550"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,90.79) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#990000;" fill="#990000" fill-opacity="1.0"><path style="stroke:none" d="M 0 6.64 L 0 84.15 C 0 87.82 2.97 90.79 6.64 90.79 L 543.36 90.79 C 547.03 90.79 550 87.82 550 84.15 L 550 6.64 C 550 2.97 547.03 0 543.36 0 L 6.64 0 C 2.97 0 0 2.97 0 6.64 Z"></path></g><g style="--ltx-fill-color:#FFF2F2;" fill="#FFF2F2" fill-opacity="1.0"><path style="stroke:none" d="M 1.11 6.64 L 1.11 68.4 L 548.89 68.4 L 548.89 6.64 C 548.89 3.58 546.42 1.11 543.36 1.11 L 6.64 1.11 C 3.58 1.11 1.11 3.58 1.11 6.64 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 13.35 76.14)"><foreignObject style="--ltx-fo-width:32.89em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="455.11"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
