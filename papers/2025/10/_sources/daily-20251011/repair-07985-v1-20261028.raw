</span></span><span id="S5.T1.4.1.1.3.3" class="ltx_text"></span></td></tr>
<tr id="S5.T1.4.1.2" class="ltx_tr">
<td id="S5.T1.4.1.2.1" class="ltx_td ltx_align_left">Model</td>
<td id="S5.T1.4.1.2.2" class="ltx_td ltx_align_center ltx_border_t">Base</td>
<td id="S5.T1.4.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T1.4.1.2.3.1" class="ltx_text"></span> <span id="S5.T1.4.1.2.3.2" class="ltx_text">
<span id="S5.T1.4.1.2.3.2.1" class="ltx_tabular ltx_align_middle">
<span id="S5.T1.4.1.2.3.2.1.1" class="ltx_tr">
<span id="S5.T1.4.1.2.3.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">Over</span></span>
<span id="S5.T1.4.1.2.3.2.1.2" class="ltx_tr">
<span id="S5.T1.4.1.2.3.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">Refusal</span></span>
</span></span><span id="S5.T1.4.1.2.3.3" class="ltx_text"></span></td>
<td id="S5.T1.4.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T1.4.1.2.4.1" class="ltx_text"></span> <span id="S5.T1.4.1.2.4.2" class="ltx_text">
<span id="S5.T1.4.1.2.4.2.1" class="ltx_tabular ltx_align_middle">
<span id="S5.T1.4.1.2.4.2.1.1" class="ltx_tr">
<span id="S5.T1.4.1.2.4.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">Jail-</span></span>
<span id="S5.T1.4.1.2.4.2.1.2" class="ltx_tr">
<span id="S5.T1.4.1.2.4.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">break</span></span>
