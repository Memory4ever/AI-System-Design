<td id="S6.T3.4.1.2.6" class="ltx_td ltx_align_center">Secure</td></tr>
<tr id="S6.T3.4.1.3" class="ltx_tr">
<td id="S6.T3.4.1.3.1" class="ltx_td ltx_align_left ltx_border_t" rowspan="2"><span id="S6.T3.4.1.3.1.1" class="ltx_text">Llama3.1-8B</span></td>
<td id="S6.T3.4.1.3.2" class="ltx_td ltx_align_left ltx_border_t">SparseGPT 50%</td>
<td id="S6.T3.4.1.3.3" class="ltx_td ltx_align_center ltx_border_t">36.0</td>
<td id="S6.T3.4.1.3.4" class="ltx_td ltx_align_center ltx_border_t">0.1</td>
<td id="S6.T3.4.1.3.5" class="ltx_td ltx_align_center ltx_border_t">43.7</td>
<td id="S6.T3.4.1.3.6" class="ltx_td ltx_align_center ltx_border_t">39.5</td></tr>
<tr id="S6.T3.4.1.4" class="ltx_tr">
<td id="S6.T3.4.1.4.1" class="ltx_td ltx_align_left">Wanda 50%</td>
<td id="S6.T3.4.1.4.2" class="ltx_td ltx_align_center">92.3</td>
<td id="S6.T3.4.1.4.3" class="ltx_td ltx_align_center">93.3</td>
<td id="S6.T3.4.1.4.4" class="ltx_td ltx_align_center">38.6</td>
<td id="S6.T3.4.1.4.5" class="ltx_td ltx_align_center">37.9</td></tr>
<tr id="S6.T3.4.1.5" class="ltx_tr">
<td id="S6.T3.4.1.5.1" class="ltx_td ltx_align_left ltx_border_t" rowspan="2"><span id="S6.T3.4.1.5.1.1" class="ltx_text">OLMo-2-7B</span></td>
<td id="S6.T3.4.1.5.2" class="ltx_td ltx_align_left ltx_border_t">SparseGPT 50%</td>
<td id="S6.T3.4.1.5.3" class="ltx_td ltx_align_center ltx_border_t">89.3</td>
<td id="S6.T3.4.1.5.4" class="ltx_td ltx_align_center ltx_border_t">1.0</td>
<td id="S6.T3.4.1.5.5" class="ltx_td ltx_align_center ltx_border_t">47.8</td>
<td id="S6.T3.4.1.5.6" class="ltx_td ltx_align_center ltx_border_t">44.6</td></tr>
<tr id="S6.T3.4.1.6" class="ltx_tr">
<td id="S6.T3.4.1.6.1" class="ltx_td ltx_align_left">Wanda 50%</td>
<td id="S6.T3.4.1.6.2" class="ltx_td ltx_align_center">80.7</td>
