</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 13.35 16.04)"><foreignObject style="--ltx-fo-width:37.82em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="523.32"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
