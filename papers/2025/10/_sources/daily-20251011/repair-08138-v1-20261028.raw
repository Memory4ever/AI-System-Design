<td id="S3.T3.2.11.10" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="padding-left:1.0pt;padding-right:1.0pt;"><span id="S3.T3.2.11.10.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">31.0<span id="S3.T3.2.11.10.1.1" class="ltx_text ltx_font_medium"> (79.9)</span></span></td>
