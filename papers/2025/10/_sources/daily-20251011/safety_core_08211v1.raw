<span id="A3.T8.4.1.1.1.1.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="A3.T8.4.1.1.1.1.1.2.1" class="ltx_text">Sycophancy</span><math id="A3.T8.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span>
