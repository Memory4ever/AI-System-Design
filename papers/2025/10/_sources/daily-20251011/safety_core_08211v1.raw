<span id="S2.T1.2.1.1.1.1.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="S2.T1.2.1.1.1.1.1.2.1" class="ltx_text">Sycophancy</span><math id="S2.T1.m3" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span>
