<td id="S5.T2.6.1.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding:1.5pt 3.0pt;" colspan="5"><span id="S5.T2.6.1.1.2.1" class="ltx_text ltx_font_bold">LLaVA eval</span></td>
<td id="S5.T2.6.1.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding:1.5pt 3.0pt;" colspan="5"><span id="S5.T2.6.1.1.3.1" class="ltx_text ltx_font_bold">MME</span></td>
