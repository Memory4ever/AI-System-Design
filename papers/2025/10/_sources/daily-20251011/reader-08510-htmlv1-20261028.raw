<td id="S4.T1.8.1.3.15" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.5pt 3.0pt;"><span id="S4.T1.8.1.3.15.1" class="ltx_text" style="--ltx-bg-color:#FDF5E0;">16.22</span></td></tr>
<tr id="S4.T1.8.1.4" class="ltx_tr">
<td id="S4.T1.8.1.4.1" class="ltx_td ltx_align_left ltx_border_r" style="padding:1.5pt 3.0pt;">+ Sink-to-the-front</td>
<td id="S4.T1.8.1.4.2" class="ltx_td ltx_align_left ltx_border_r" style="padding:1.5pt 3.0pt;"><span id="S4.T1.8.1.4.2.1" class="ltx_text" style="--ltx-fg-color:#009900;">71.01<sub id="S4.T1.8.1.4.2.1.1" class="ltx_sub"><span id="S4.T1.8.1.4.2.1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;"> +0.02</span></sub></span></td>
<td id="S4.T1.8.1.4.3" class="ltx_td ltx_align_center" style="padding:1.5pt 3.0pt;">62.39</td>
<td id="S4.T1.8.1.4.4" class="ltx_td ltx_align_center" style="padding:1.5pt 3.0pt;">96.06</td>
<td id="S4.T1.8.1.4.5" class="ltx_td ltx_align_center" style="padding:1.5pt 3.0pt;">73.17</td>
<td id="S4.T1.8.1.4.6" class="ltx_td ltx_align_center ltx_border_r" style="padding:1.5pt 3.0pt;">50.40</td>
