<td id="A3.T10.2.5.4" class="ltx_td ltx_align_center">123.33</td>
<td id="A3.T10.2.5.5" class="ltx_td ltx_align_center ltx_border_r"><span id="A3.T10.2.5.5.1" class="ltx_text ltx_font_bold">141.67</span></td>
<td id="A3.T10.2.5.6" class="ltx_td ltx_align_center">110.00</td>
<td id="A3.T10.2.5.7" class="ltx_td ltx_nopad_r ltx_align_center"><span id="A3.T10.2.5.7.1" class="ltx_text ltx_font_bold">165.00</span></td></tr>
<tr id="A3.T10.2.6" class="ltx_tr">
<td id="A3.T10.2.6.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_r">DIYSink (ReW)</td>
<td id="A3.T10.2.6.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="A3.T10.2.6.2.1" class="ltx_text ltx_font_bold">53.85</span></td>
<td id="A3.T10.2.6.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="A3.T10.2.6.3.1" class="ltx_text ltx_font_bold">68.53</span></td>
<td id="A3.T10.2.6.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="A3.T10.2.6.4.1" class="ltx_text ltx_font_bold">123.33</span></td>
<td id="A3.T10.2.6.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r">131.66</td>
