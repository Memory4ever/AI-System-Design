<td id="S4.T1.8.1.10.2" class="ltx_td ltx_align_left ltx_border_bb ltx_border_r" style="padding:1.5pt 3.0pt;"><span id="S4.T1.8.1.10.2.1" class="ltx_text" style="--ltx-fg-color:#009900;">61.74<sub id="S4.T1.8.1.10.2.1.1" class="ltx_sub"><span id="S4.T1.8.1.10.2.1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;"> +0.06</span></sub></span></td>
