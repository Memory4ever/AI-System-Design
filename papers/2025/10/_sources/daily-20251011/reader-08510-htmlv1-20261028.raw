<tr id="S5.T2.6.1.3" class="ltx_tr" style="--ltx-bg-color:#FDF5E0;">
<td id="S5.T2.6.1.3.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:1.5pt 3.0pt;" colspan="15"><span id="S5.T2.6.1.3.1.1" class="ltx_text ltx_font_bold">TinyLLaVA-0.5B-SigLIP-Qwen2-0.5B</span></td></tr>
<tr id="S5.T2.6.1.4" class="ltx_tr">
<td id="S5.T2.6.1.4.1" class="ltx_td ltx_align_left ltx_border_r" style="padding:1.5pt 3.0pt;">Baseline<sup id="S5.T2.6.1.4.1.1" class="ltx_sup">†</sup></td>
<td id="S5.T2.6.1.4.2" class="ltx_td ltx_align_left ltx_border_r" style="padding:1.5pt 3.0pt;">48.34</td>
<td id="S5.T2.6.1.4.3" class="ltx_td ltx_align_center" style="padding:1.5pt 3.0pt;">57.98</td>
