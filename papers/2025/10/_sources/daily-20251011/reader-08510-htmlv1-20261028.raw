<td id="A1.T1.2.2.5" class="ltx_td ltx_align_center ltx_border_t">0.0113</td></tr>
<tr id="A1.T1.2.3" class="ltx_tr">
<td id="A1.T1.2.3.1" class="ltx_td ltx_align_left">LLM-emerged Sink Attn</td>
<td id="A1.T1.2.3.2" class="ltx_td ltx_align_center">0.0181</td>
