<td id="S4.T1.8.1.3.12" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding:1.5pt 3.0pt;"><span id="S4.T1.8.1.3.12.1" class="ltx_text" style="--ltx-bg-color:#FDF5E0;">62.90</span></td>
