<td id="S5.T2.6.1.2.11" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding:1.5pt 3.0pt;"><span id="S5.T2.6.1.2.11.1" class="ltx_text ltx_font_bold">All</span></td>
<td id="S5.T2.6.1.2.12" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.5pt 3.0pt;">ALG</td>
<td id="S5.T2.6.1.2.13" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.5pt 3.0pt;">GEO</td>
