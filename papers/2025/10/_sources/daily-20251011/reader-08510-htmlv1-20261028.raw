<td id="S4.T1.8.1.10.9" class="ltx_td ltx_align_center ltx_border_bb" style="padding:1.5pt 3.0pt;">127.14</td>
<td id="S4.T1.8.1.10.10" class="ltx_td ltx_align_center ltx_border_bb" style="padding:1.5pt 3.0pt;">72.50</td>
<td id="S4.T1.8.1.10.11" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="padding:1.5pt 3.0pt;">87.50</td>
<td id="S4.T1.8.1.10.12" class="ltx_td ltx_align_left ltx_border_bb ltx_border_r" style="padding:1.5pt 3.0pt;"><span id="S4.T1.8.1.10.12.1" class="ltx_text" style="--ltx-fg-color:#009900;">51.20<sub id="S4.T1.8.1.10.12.1.1" class="ltx_sub"><span id="S4.T1.8.1.10.12.1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;"> +1.80</span></sub></span></td>
