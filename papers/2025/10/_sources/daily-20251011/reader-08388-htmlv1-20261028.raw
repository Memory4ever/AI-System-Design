<th id="A1.T6.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-top:0.75pt;padding-bottom:0.75pt;" colspan="2"><span id="A1.T6.2.1.2.1" class="ltx_text ltx_font_bold">Sentence probability</span></th>
