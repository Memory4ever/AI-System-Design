</div>
<div id="alg1.l10" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
            
            
             <span id="alg1.l10.3" class="ltx_text ltx_font_bold">E-step:</span> Recompute responsibilities <math id="alg1.l10.m1" class="ltx_Math" alttext="q_{k}(x_{i},y_{i}^{+},y_{i}^{-})" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>y</mi><mi>i</mi><mo>+</mo></msubsup><mo>,</mo><msubsup><mi>y</mi><mi>i</mi><mo>−</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q_{k}(x_{i},y_{i}^{+},y_{i}^{-})</annotation></semantics></math>.

</div>
<div id="alg1.l11" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
            
            
             <span id="alg1.l11.3" class="ltx_text ltx_font_bold">M-step:</span> Update gating network parameters <math id="alg1.l11.m1" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> (MoE-DPO) or fixed weights (Mix-DPO) <math id="alg1.l11.m2" class="ltx_Math" alttext="w_{k}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mi>k</mi></msub><annotation encoding="application/x-tex">w_{k}</annotation></semantics></math>.

</div>
<div id="alg1.l12" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
            
            
            <span id="alg1.l12.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l12.4" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l13" class="ltx_listingline">
