<div id="alg1.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
            
            
             <span id="alg1.l6.3" class="ltx_text ltx_font_bold">M-step:</span> Update each <math id="alg1.l6.m1" class="ltx_Math" alttext="\pi_{k}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\pi_{k}</annotation></semantics></math> using <math id="alg1.l6.m2" class="ltx_Math" alttext="q_{k}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi>k</mi></msub><annotation encoding="application/x-tex">q_{k}</annotation></semantics></math>, <math id="alg1.l6.m3" class="ltx_Math" alttext="\pi_{\text{ref}(k)}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mrow><mtext>ref</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\pi_{\text{ref}(k)}</annotation></semantics></math>, and temperature <math id="alg1.l6.m4" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>.

