<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S5.F3.sf2.3" class="ltx_text" style="font-size:80%;">(b)</span> </span><span id="S5.F3.sf2.4" class="ltx_text" style="font-size:80%;">After: Class Distribution</span></figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S5.F3.sf3" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.07762v1/pics/tsne_before_finetuning_domain.png" id="S5.F3.sf3.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:224/179;" width="224" height="179" alt="Refer to caption">
