<figure id="A4.T14" class="ltx_table">
<div id="A4.T14.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:346.4pt;height:521.4pt;vertical-align:-258.2pt;"><span class="ltx_transformed_inner" style="transform:translate(0.0pt,0.0pt) scale(1,1) ;">
<p id="A4.T14.2.1" class="ltx_p"><span id="A4.T14.2.1.1" class="ltx_text">

<span id="A4.T14.2.1.1.1" class="ltx_tabular ltx_align_middle">
<span id="A4.T14.2.1.1.1.1" class="ltx_tr">
