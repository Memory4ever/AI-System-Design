<td id="S6.T4.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T4.2.1.2.3.1" class="ltx_text ltx_underline">70.35</span></td>
<td id="S6.T4.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T4.2.1.2.4.1" class="ltx_text ltx_underline">86.00</span></td></tr>
