<td id="S6.T4.2.1.3.3" class="ltx_td ltx_align_center">66.70</td>
<td id="S6.T4.2.1.3.4" class="ltx_td ltx_align_center"><span id="S6.T4.2.1.3.4.1" class="ltx_text ltx_underline">86.00</span></td></tr>
<tr id="S6.T4.2.1.4" class="ltx_tr">
<td id="S6.T4.2.1.4.1" class="ltx_td ltx_align_left">Vanilla-KD</td>
