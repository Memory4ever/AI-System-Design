<td id="S6.T2.2.1.6.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S6.T2.2.1.6.2.1" class="ltx_text ltx_font_bold">51.00</span></td>
<td id="S6.T2.2.1.6.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S6.T2.2.1.6.3.1" class="ltx_text ltx_font_bold">62.80</span></td>
<td id="S6.T2.2.1.6.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S6.T2.2.1.6.4.1" class="ltx_text ltx_font_bold">61.00</span></td>
<td id="S6.T2.2.1.6.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="S6.T2.2.1.6.5.1" class="ltx_text ltx_font_bold">23.59</span></td>
<td id="S6.T2.2.1.6.6" class="ltx_td ltx_align_center ltx_border_bb"><span id="S6.T2.2.1.6.6.1" class="ltx_text ltx_font_bold">36.13</span></td>
<td id="S6.T2.2.1.6.7" class="ltx_td ltx_align_center ltx_border_bb"><span id="S6.T2.2.1.6.7.1" class="ltx_text ltx_font_bold">34.07</span></td></tr>
