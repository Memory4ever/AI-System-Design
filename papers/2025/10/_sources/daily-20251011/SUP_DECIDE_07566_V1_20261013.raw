<th id="A4.T11.2.1.1.9" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A4.T11.2.1.1.9.1" class="ltx_text ltx_font_bold">Average</span></th></tr>
