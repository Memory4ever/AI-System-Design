<th id="A4.T11.2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="A4.T11.2.1.1.2.1" class="ltx_text ltx_font_bold">Data Portion</span></th>
<th id="A4.T11.2.1.1.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="A4.T11.2.1.1.3.1" class="ltx_text ltx_font_bold">Approach</span></th>
