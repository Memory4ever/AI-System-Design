</div>
<div id="alg1.l16" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">16:</span>
            
            
            <span id="alg1.l16.2" class="ltx_text ltx_font_bold">else</span> <span id="alg1.l16.3" class="ltx_text ltx_font_bold">if</span> Variant type is <span id="alg1.l16.4" class="ltx_text ltx_font_typewriter">anchor*</span> <span id="alg1.l16.5" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg1.l17" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">17:</span>
            
            
             <math id="alg1.l17.m1" class="ltx_Math" alttext="\mathbf{h}_{\text{sup}}^{(t)}\leftarrow\mathbf{h}_{\text{emb}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐡</mi><mtext>sup</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">←</mo><msub><mi>𝐡</mi><mtext>emb</mtext></msub></mrow><annotation encoding="application/x-tex">\mathbf{h}_{\text{sup}}^{(t)}\leftarrow\mathbf{h}_{\text{emb}}</annotation></semantics></math>

</div>
<div id="alg1.l18" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">18:</span>
            
            
            <span id="alg1.l18.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l18.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l19" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">19:</span>
            
            
            <math id="alg1.l19.m1" class="ltx_Math" alttext="\mathbf{h}^{(t+1)}\leftarrow f_{\text{core}}(\mathbf{h}^{(t)})+\mathbf{h}_{\text{sup}}^{(t)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">←</mo><mrow><mrow><msub><mi>f</mi><mtext>core</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msubsup><mi>𝐡</mi><mtext>sup</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{h}^{(t+1)}\leftarrow f_{\text{core}}(\mathbf{h}^{(t)})+\mathbf{h}_{\text{sup}}^{(t)}</annotation></semantics></math> <span id="alg1.l19.2" class="ltx_text" style="--ltx-fg-color:#808080;">{Apply core and add supplement}</span>

</div>
