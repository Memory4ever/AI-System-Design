            <span class="ltx_tag ltx_tag_listingline">23:</span>
            
            
          <math id="alg1.l23.m1" class="ltx_Math" alttext="\mathbf{h}_{\text{final}}\leftarrow f_{\text{coda}}(\mathbf{h}^{(K)})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐡</mi><mtext>final</mtext></msub><mo stretchy="false">←</mo><mrow><msub><mi>f</mi><mtext>coda</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{h}_{\text{final}}\leftarrow f_{\text{coda}}(\mathbf{h}^{(K)})</annotation></semantics></math>

</div>
