            <span class="ltx_tag ltx_tag_listingline">11:</span>
            
            
            <math id="alg1.l11.m1" class="ltx_Math" alttext="\mathbf{h}_{\text{sup}}^{(t)}\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐡</mi><mtext>sup</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">←</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbf{h}_{\text{sup}}^{(t)}\leftarrow 0</annotation></semantics></math>

