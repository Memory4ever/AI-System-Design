<span id="A5.T5.4.4.4.2.1.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">805,797,918</span></span>
<span id="A5.T5.4.4.4.2.1.1.2" class="ltx_tr">
<span id="A5.T5.4.4.4.2.1.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">(-33.328%)</span></span>
