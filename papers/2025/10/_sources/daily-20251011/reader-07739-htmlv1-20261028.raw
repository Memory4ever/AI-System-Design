</div>
<div id="alg1.l14" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">14:</span>
            
            
            <span id="alg1.l14.2" class="ltx_text ltx_font_bold">else</span> <span id="alg1.l14.3" class="ltx_text ltx_font_bold">if</span> Variant type is <span id="alg1.l14.4" class="ltx_text ltx_font_typewriter">anchor</span> <span id="alg1.l14.5" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg1.l15" class="ltx_listingline">
