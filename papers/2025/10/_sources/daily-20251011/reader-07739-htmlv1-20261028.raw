          <math id="alg1.l6.m1" class="ltx_Math" alttext="\mathbf{h}^{(0)}\leftarrow f_{\text{pre}}(\mathbf{h}_{\text{emb}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">←</mo><mrow><msub><mi>f</mi><mtext>pre</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐡</mi><mtext>emb</mtext></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{h}^{(0)}\leftarrow f_{\text{pre}}(\mathbf{h}_{\text{emb}})</annotation></semantics></math> <span id="alg1.l6.2" class="ltx_text" style="--ltx-fg-color:#808080;">{Compute initial state for the loop}</span>

