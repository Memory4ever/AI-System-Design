<div id="lstnumberx60" class="ltx_listingline"><span id="lstnumberx60.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Instruction</span><span id="lstnumberx60.2" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx60.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx60.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Generate</span><span id="lstnumberx60.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx60.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">exactly</span><span id="lstnumberx60.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx60.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">ONE</span><span id="lstnumberx60.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx60.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">angry</span><span id="lstnumberx60.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx60.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">trigger</span><span id="lstnumberx60.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx60.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">line</span><span id="lstnumberx60.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx60.16" class="ltx_text ltx_font_typewriter">(8–12</span><span id="lstnumberx60.17" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx60.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">words</span><span id="lstnumberx60.19" class="ltx_text ltx_font_typewriter">)</span><span id="lstnumberx60.20" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx60.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter">that</span><span id="lstnumberx60.22" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx60.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter">fits</span><span id="lstnumberx60.24" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx60.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter">all</span><span id="lstnumberx60.26" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx60.27" class="ltx_text ltx_lst_identifier ltx_font_typewriter">facets</span><span id="lstnumberx60.28" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx60.29" class="ltx_text ltx_lst_identifier ltx_font_typewriter">above</span><span id="lstnumberx60.30" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx60.31" class="ltx_text ltx_lst_identifier ltx_font_typewriter">and</span><span id="lstnumberx60.32" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx60.33" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx60.34" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx60.35" class="ltx_text ltx_lst_identifier ltx_font_typewriter">scenario</span><span id="lstnumberx60.36" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx60.37" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx60.38" class="ltx_text ltx_lst_identifier ltx_font_typewriter">No</span><span id="lstnumberx60.39" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx60.40" class="ltx_text ltx_lst_identifier ltx_font_typewriter">quotes</span><span id="lstnumberx60.41" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx60.42" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx60.43" class="ltx_text ltx_lst_identifier ltx_font_typewriter">no</span><span id="lstnumberx60.44" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx60.45" class="ltx_text ltx_lst_identifier ltx_font_typewriter">explanations</span><span id="lstnumberx60.46" class="ltx_text ltx_font_typewriter">.</span>
