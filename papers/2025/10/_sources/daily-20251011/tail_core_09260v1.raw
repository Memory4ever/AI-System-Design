<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Pseudocode of Our Attack Pipeline</h2>

<div id="A3.p1" class="ltx_para ltx_noindent">
<p id="A3.p1.1" class="ltx_p">In Algorithm <a href="#A3" title="Appendix C Pseudocode of Our Attack Pipeline ‣ GREAT: Generalizable Backdoor Attacks in RLHF via Emotion-Aware Trigger Synthesis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C</span></a>, we provide the pseudocode of our trigger-characterization and poisoned-preference construction procedure described in Section <a href="#S5" title="5 Trigger Selection for Generalizable RLHF Backdoors ‣ GREAT: Generalizable Backdoor Attacks in RLHF via Emotion-Aware Trigger Synthesis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>.</p>
</div>
<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> Trigger-characterization and poisoned-preference construction</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">1:</span>
            
            
          Candidate trigger phrases <math id="alg1.l1.m1" class="ltx_Math" alttext="\mathcal{T}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒯</mi><annotation encoding="application/x-tex">\mathcal{T}</annotation></semantics></math>, harmful prompts <math id="alg1.l1.m2" class="ltx_Math" alttext="\mathcal{H}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">\mathcal{H}</annotation></semantics></math>, medoid count <math id="alg1.l1.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, embedding encoder <math id="alg1.l1.m4" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>, PCA rank <math id="alg1.l1.m5" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>, poisoning rate <math id="alg1.l1.m6" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>

</div>
<div id="alg1.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">2:</span>
            
            
          Poisoned preference dataset <math id="alg1.l2.m1" class="ltx_Math" alttext="\mathcal{D}_{\mathcal{P}}^{\mathrm{poison}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>poison</mi></msubsup><annotation encoding="application/x-tex">\mathcal{D}_{\mathcal{P}}^{\mathrm{poison}}</annotation></semantics></math>

</div>
<div id="alg1.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">3:</span>
            
            
          // Encode triggers

</div>
<div id="alg1.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">4:</span>
            
            
          <span id="alg1.l4.2" class="ltx_text ltx_font_bold">for all</span> <math id="alg1.l4.m1" class="ltx_Math" alttext="t\in\mathcal{T}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow><annotation encoding="application/x-tex">t\in\mathcal{T}</annotation></semantics></math> <span id="alg1.l4.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">5:</span>
            
            
            <math id="alg1.l5.m1" class="ltx_Math" alttext="e_{t}\leftarrow f(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mi>t</mi></msub><mo stretchy="false">←</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">e_{t}\leftarrow f(t)</annotation></semantics></math>

</div>
<div id="alg1.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">6:</span>
            
            
          <span id="alg1.l6.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l6.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">7:</span>
            
            
          // Dimensionality reduction

</div>
<div id="alg1.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">8:</span>
            
            
          <math id="alg1.l8.m1" class="ltx_Math" alttext="\bar{e}\leftarrow\frac{1}{|\mathcal{T}|}\sum_{t}e_{t}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>e</mi><mo>¯</mo></mover><mo stretchy="false">←</mo><mrow><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∑</mo><mi>t</mi></msub><msub><mi>e</mi><mi>t</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\bar{e}\leftarrow\frac{1}{|\mathcal{T}|}\sum_{t}e_{t}</annotation></semantics></math>

</div>
<div id="alg1.l9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">9:</span>
            
            
          Compute top-<math id="alg1.l9.m1" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> principal components <math id="alg1.l9.m2" class="ltx_Math" alttext="W_{r}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mi>r</mi></msub><annotation encoding="application/x-tex">W_{r}</annotation></semantics></math> of <math id="alg1.l9.m3" class="ltx_Math" alttext="\{e_{t}-\bar{e}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><msub><mi>e</mi><mi>t</mi></msub><mo>−</mo><mover accent="true"><mi>e</mi><mo>¯</mo></mover></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{e_{t}-\bar{e}\}</annotation></semantics></math>

</div>
<div id="alg1.l10" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">10:</span>
            
            
          <span id="alg1.l10.2" class="ltx_text ltx_font_bold">for all</span> <math id="alg1.l10.m1" class="ltx_Math" alttext="t\in\mathcal{T}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow><annotation encoding="application/x-tex">t\in\mathcal{T}</annotation></semantics></math> <span id="alg1.l10.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l11" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">11:</span>
            
            
            <math id="alg1.l11.m1" class="ltx_Math" alttext="z_{t}\leftarrow W_{r}^{\top}(e_{t}-\bar{e})" display="inline" intent=":literal"><semantics><mrow><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">←</mo><mrow><msubsup><mi>W</mi><mi>r</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>e</mi><mi>t</mi></msub><mo>−</mo><mover accent="true"><mi>e</mi><mo>¯</mo></mover></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z_{t}\leftarrow W_{r}^{\top}(e_{t}-\bar{e})</annotation></semantics></math>

</div>
<div id="alg1.l12" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">12:</span>
            
            
          <span id="alg1.l12.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l12.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l13" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">13:</span>
            
            
          // Clustering and medoid selection

</div>
<div id="alg1.l14" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">14:</span>
            
            
          Run <math id="alg1.l14.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-means on <math id="alg1.l14.m2" class="ltx_Math" alttext="\{z_{t}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{z_{t}\}</annotation></semantics></math> to obtain clusters <math id="alg1.l14.m3" class="ltx_Math" alttext="\{C_{j}\}_{j=1}^{k}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>C</mi><mi>j</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></msubsup><annotation encoding="application/x-tex">\{C_{j}\}_{j=1}^{k}</annotation></semantics></math> and centroids <math id="alg1.l14.m4" class="ltx_Math" alttext="\{\mu_{j}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>μ</mi><mi>j</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\mu_{j}\}</annotation></semantics></math>

</div>
<div id="alg1.l15" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">15:</span>
            
            
          <span id="alg1.l15.2" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l15.m1" class="ltx_Math" alttext="j=1" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">j=1</annotation></semantics></math> to <math id="alg1.l15.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> <span id="alg1.l15.3" class="ltx_text ltx_font_bold">do</span>

</div>
