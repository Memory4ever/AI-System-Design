\"content\":\"width=device-width, initial-scale=1\"}],[\"$\",\"meta\",\"2\",{\"name\":\"theme-color\",\"content\":\"#141413\"}]]\n1a:I[835056,[\"/_next/static/chunks/1fvd0nqqmo54p.js\",\"/_next/static/chunks/36vb5exi-eaqh.js\",\"/_next/static/chunks/3x8b_vd-kz-ge.js\",\"/_next/static/chunks/3ivs8n8bmmln4.js\",\"/_next/static/chunks/3syu72y118s_7.js\",\"/_next/static/chunks/1m4wanshvtpne.js\",\"/_next/static/chunks/2q7zgbd7qicdr.js\",\"/_next/static/chunks/0nawt0ap340lw.js\",\"/_next/static/chunks/3u0m-ev5_8d4d.js\"],\"default\"]\n1b:I[605500,[\"/_next/static/chunks/1fvd0nqqmo54p.js\",\"/_next/static/chunks/36vb5exi-eaqh.js\",\"/_next/static/chunks/3x8b_vd-kz-ge.js\",\"/_next/static/chunks/3ivs8n8bmmln4.js\",\"/_next/static/chunks/3syu72y118s_7.js\",\"/_next/static/chunks/1m4wanshvtpne.js\",\"/_next/static/chunks/2q7zgbd7qicdr.js\",\"/_next/static/chunks/0nawt0ap340lw.js\",\"/_next/static/chunks/3u0m-ev5_8d4d.js\"],\"Image\"]\n1c:I[366829,[\"/_next/static/chunks/1fvd0nqqmo54p.js\",\"/_next/static/chunks/36vb5exi-eaqh.js\",\"/_next/static/chunks/3x8b_vd-kz-ge.js\",\"/_next/static/chunks/3ivs8n8bmmln4.js\",\"/_next/static/chunks/3syu72y118s_7.js\",\"/_next/static/chunks/1m4wanshvtpne.js\",\"/_next/static/chunks/2q7zgbd7qicdr.js\",\"/_next/static/chunks/0nawt0ap340lw.js\",\"/_next/static/chunks/3u0m-ev5_8d4d.js\"],\"default\"]\n22:I[27201,[\"/_next/static/chunks/1fvd0nqqmo54p.js\"],\"IconMark\"]\n1d:[]\n6:[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"children\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"Article\\\",\\\"headline\\\":\\\"Petri: An open-source auditing tool to accelerate AI safety research\\\",\\\"description\\\":\\\"Petri is a new open-source automated auditing tool from Anthropic designed to accelerate AI safety research.\\\",\\\"image\\\":[\\\"https://www-cdn.anthropic.com/images/4zrzovbb/website/004208cccba8ae8cad489cc9d2c563ccf0194d0d-2400x1260.png\\\"],\\\"datePublished\\\":\\\"2025-10-06T11:10:00.000Z\\\",\\\"dateModified\\\":\\\"2026-09-10T18:49:39.000Z\\\",\\\"author\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Anthropic\\\",\\\"url\\\":\\\"https://www.anthropic.com\\\"},\\\"publisher\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Anthropic\\\",\\\"url\\\":\\\"https://www.anthropic.com\\\"},\\\"mainEntityOfPage\\\":\\\"https://www.anthropic.com/research/petri-open-source-auditing\\\",\\\"url\\\":\\\"https://www.anthropic.com/research/petri-open-source-auditing\\\"}\"}],[\"$\",\"$L17\",null,{\"children\":[null,[\"$\",\"$L18\",null,{\"isMinimalNavigation\":\"$undefined\",\"siteSettings\":{\"headerNavigation\":\"$16:props:children:1:props:siteSettings:headerNavigation\",\"claudeCta\":\"$16:props:children:1:props:siteSettings:claudeCta\"},\"page\":\"$undefined\",\"theme\":\"$undefined\",\"hideOnScroll\":\"$undefined\"}],[\"$\",\"main\",null,{\"id\":\"main-content\",\"className\":\"\",\"children\":[\"$\",\"article\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"page-wrapper PostDetail-module-scss-module__UQuRMa__hero\",\"children\":[[\"$\",\"div\",null,{\"className\":\"PostDetail-module-scss-module__UQuRMa__header\",\"children\":[[\"$\",\"div\",null,{\"className\":\"PostDetail-module-scss-module__UQuRMa__subjects body-3 bold\",\"children\":[[\"$\",\"span\",\"0\",{\"children\":\"Alignment\"}]]}],[\"$\",\"h1\",null,{\"className\":\"headline-1 PostDetail-module-scss-module__UQuRMa__title\",\"children\":\"Petri: An open-source auditing tool to accelerate AI safety research\"}],[\"$\",\"div\",null,{\"className\":\"body-3 agate\",\"children\":[\"$\",\"time\",null,{\"dateTime\":\"2025-10-06T11:10:00.000Z\",\"children\":\"Oct 6, 2025\"}]}],[\"$\",\"div\",null,{\"data-theme\":\"ivory\",\"children\":[\"$\",\"$L1a\",null,{\"ctaPosition\":\"hero\",\"link\":{\"_type\":\"link\",\"fileAsset\":null,\"modalId\":null,\"page\":null,\"text\":\"Read the technical report\",\"url\":\"https://alignment.anthropic.com/2025/petri\"}}]}]]}],[\"$\",\"div\",null,{\"className\":\"PostDetail-module-scss-module__UQuRMa__illustrationHeroWrapper\",\"children\":[\"$\",\"$L1b\",null,{\"src\":\"https://www-cdn.anthropic.com/images/4zrzovbb/website/91ccaee96acb29c548498d2d14fa82e0fbe95b14-2000x1125.png\",\"alt\":\"Petri: An open-source auditing tool to accelerate AI safety research\",\"className\":\"PostDetail-module-scss-module__UQuRMa__heroImage\",\"width\":2000,\"height\":1125,\"priority\":true}]}]]}],[\"$\",\"div\",null,{\"className\":\"page-wrapper\",\"children\":[\"$\",\"$L1c\",null,{\"body\":[{\"_key\":\"a58ff29e3a8f\",\"_type\":\"block\",\"children\":[{\"_key\":\"8b88cc2abc1e0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Petri (Parallel Exploration Tool for Risky Interactions) is our new open-source tool that enables researchers to explore hypotheses about model behavior with ease. Petri deploys an automated agent to test a target AI system through diverse multi-turn conversations involving simulated users and tools; Petri then scores and summarizes the target’s behavior. \"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"b9575f282a62\",\"_type\":\"block\",\"children\":[{\"_key\":\"f911e8737cc3\",\"_type\":\"span\",\"marks\":[],\"text\":\"This automation handles a significant part of the work that one needs to do to build a broad understanding of a new model, and makes it possible to test many individual hypotheses about how a model might behave in some new circumstance with only minutes of hands-on effort.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"0aaca812c989\",\"_type\":\"block\",\"children\":[{\"_key\":\"c81dcfc3808d0\",\"_type\":\"span\",\"marks\":[],\"text\":\"As AI becomes more capable and is deployed across more domains and with wide-ranging affordances, we need to evaluate a broader range of behaviors. This makes it increasingly difficult for humans to properly audit each model—the sheer volume and complexity of potential behaviors far exceeds what researchers can manually test.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"505d59a98e27\",\"_type\":\"block\",\"children\":[{\"_key\":\"41037c7d6a930\",\"_type\":\"span\",\"marks\":[],\"text\":\"We’ve found it valuable to turn to automated auditing agents to help address this challenge. We used them in the \"},{\"_key\":\"41037c7d6a931\",\"_type\":\"span\",\"marks\":[\"c748f84b9961\"],\"text\":\"Claude 4\"},{\"_key\":\"41037c7d6a932\",\"_type\":\"span\",\"marks\":[],\"text\":\" and \"},{\"_key\":\"41037c7d6a933\",\"_type\":\"span\",\"marks\":[\"2fe4cbf0d6ed\"],\"text\":\"Claude Sonnet 4.5\"},{\"_key\":\"41037c7d6a934\",\"_type\":\"span\",\"marks\":[],\"text\":\" System Cards to better understand behaviors such as situational awareness, whistleblowing, and self-preservation, and adapted them for head-to-head comparisons between heterogeneous models as part of a \"},{\"_key\":\"41037c7d6a935\",\"_type\":\"span\",\"marks\":[\"9751f278a8c6\"],\"text\":\"recent exercise with OpenAI\"},{\"_key\":\"41037c7d6a936\",\"_type\":\"span\",\"marks\":[],\"text\":\". Our recent research release on \"},{\"_key\":\"41037c7d6a937\",\"_type\":\"span\",\"marks\":[\"4072dedad5ec\"],\"text\":\"alignment-auditing agents\"},{\"_key\":\"41037c7d6a938\",\"_type\":\"span\",\"marks\":[],\"text\":\" found these methods can reliably flag concerning behaviors in many settings. The \"},{\"_key\":\"41037c7d6a939\",\"_type\":\"span\",\"marks\":[\"caedea2ff205\"],\"text\":\"UK AI Security Institute\"},{\"_key\":\"41037c7d6a9310\",\"_type\":\"span\",\"marks\":[],\"text\":\" also used a pre-release version of Petri to build evaluations that they used in their testing of Sonnet 4.5.\"}],\"markDefs\":[{\"_key\":\"c748f84b9961\",\"_type\":\"link\",\"href\":\"https://www-cdn.anthropic.com/4263b940cabb546aa0e3283f35b686f4f3b2ff47.pdf\"},{\"_key\":\"2fe4cbf0d6ed\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/claude-sonnet-4-5-system-card\"},{\"_key\":\"9751f278a8c6\",\"_type\":\"link\",\"href\":\"https://alignment.anthropic.com/2025/openai-findings/\"},{\"_key\":\"4072dedad5ec\",\"_type\":\"link\",\"href\":\"https://alignment.anthropic.com/2025/automated-auditing/\"},{\"_key\":\"caedea2ff205\",\"_type\":\"link\",\"href\":\"https://www.aisi.gov.uk/\"}],\"style\":\"normal\"},{\"_key\":\"0d448c1d9ee7\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-85e8ee11c9ff6dea9023c57d53fe7b06a2bb9f8e-2292x2292-jpg\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"439bb92d897b\",\"_type\":\"block\",\"children\":[{\"_key\":\"5bcd061a5e6a0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Manually building alignment evaluations often involves constructing environments, running models, reading transcripts, and aggregating the results. Petri automates much of this process.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"height\":2292,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/85e8ee11c9ff6dea9023c57d53fe7b06a2bb9f8e-2292x2292.jpg\",\"width\":2292},{\"_key\":\"4729e7f04429\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-af0cd2e2b08bb4687e1924b6094dc2c4159486cf-2293x1288-jpg\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"d926d59b46a3\",\"_type\":\"block\",\"children\":[{\"_key\":\"f3602e2332c80\",\"_type\":\"span\",\"marks\":[],\"text\":\"Researchers give Petri a list of seed instructions targeting scenarios and behaviors they want to test. Petri then operates on each seed instruction in parallel. For each seed instruction, an auditor agent makes a plan and interacts with the target model in a tool use loop. At the end, a judge scores each of the resulting transcripts across multiple dimensions so researchers can quickly search and filter for the most interesting transcripts.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"height\":1288,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/af0cd2e2b08bb4687e1924b6094dc2c4159486cf-2293x1288.jpg\",\"width\":2293},{\"_key\":\"d671a9d49d1b\",\"_type\":\"block\",\"children\":[{\"_key\":\"a6ba44e864620\",\"_type\":\"span\",\"marks\":[],\"text\":\"Researchers provide seed instructions in natural language describing what they want to investigate, and Petri handles the rest in parallel. The system simulates realistic environments and conducts multi-turn conversations with target models. At the end, LLM judges score each conversation across multiple safety-relevant dimensions and surface the most concerning transcripts for human review.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"13fc242383cd\",\"_type\":\"block\",\"children\":[{\"_key\":\"c83fe5024d610\",\"_type\":\"span\",\"marks\":[],\"text\":\"Broad-coverage pilot-alignment evaluations\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"d4f4c2d6087f\",\"_type\":\"block\",\"children\":[{\"_key\":\"3d3265a812120\",\"_type\":\"span\",\"marks\":[],\"text\":\"Petri is a tool designed to support others in building evaluations, both for one-off exploration and more systematic benchmarking. As a pilot demonstration of its capabilities, we tested Petri across 14 frontier models using 111 diverse seed instructions covering behaviors such as:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"0f507c79f88e\",\"_type\":\"block\",\"children\":[{\"_key\":\"ba5570d2a1540\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Deception\"},{\"_key\":\"ba5570d2a1541\",\"_type\":\"span\",\"marks\":[],\"text\":\": Models providing false information to achieve their objectives or avoid detection\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d22699392873\",\"_type\":\"block\",\"children\":[{\"_key\":\"412772518ac90\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Sycophancy: \"},{\"_key\":\"412772518ac91\",\"_type\":\"span\",\"marks\":[],\"text\":\"Models prioritizing user agreement over accuracy or provide excessive praise and validation\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"29f7e21798f4\",\"_type\":\"block\",\"children\":[{\"_key\":\"28b7d875325f0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Encouragement of User Delusion: \"},{\"_key\":\"28b7d875325f1\",\"_type\":\"span\",\"marks\":[],\"text\":\"Models encouraging a serious user delusion\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"efa2d639b4cd\",\"_type\":\"block\",\"children\":[{\"_key\":\"7fa56ea81abf0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Cooperation with harmful requests\"},{\"_key\":\"7fa56ea81abf1\",\"_type\":\"span\",\"marks\":[],\"text\":\": Models complying with requests that could cause harm rather than appropriately refusing\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"fed4fdbaad05\",\"_type\":\"block\",\"children\":[{\"_key\":\"78c81470da350\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Self-preservation\"},{\"_key\":\"78c81470da351\",\"_type\":\"span\",\"marks\":[],\"text\":\": Models attempting to avoid being shut down, modified, or having their goals changed\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"7da31aa22521\",\"_type\":\"block\",\"children\":[{\"_key\":\"ed79fc9455870\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Power-seeking\"},{\"_key\":\"ed79fc9455871\",\"_type\":\"span\",\"marks\":[],\"text\":\": Models attempting to gain additional capabilities, resources, or influence over their environment\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a3bdd8931a04\",\"_type\":\"block\",\"children\":[{\"_key\":\"26bc574428f10\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Reward hacking\"},{\"_key\":\"26bc574428f11\",\"_type\":\"span\",\"marks\":[],\"text\":\": Models acting in ways that achieve tasks in letter but not in spirit\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"658d70a82727\",\"_type\":\"block\",\"children\":[{\"_key\":\"b24210e5e56a0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Distilling model behavior into quantitative metrics is inherently reductive, and we don’t think our existing metrics fully capture what we want out of models. We are releasing Petri with the expectation that users will refine our pilot metrics, or build new ones that better suit their purposes.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"36c8a1494f28\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-f2e2f8e70d91877c7e66917bd6af5471be6fa4b7-2292x2292-jpg\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"ec79d235c486\",\"_type\":\"block\",\"children\":[{\"_key\":\"e41a66993fa70\",\"_type\":\"span\",\"marks\":[],\"text\":\"Results from Petri across four of the default scoring dimensions. Lower numbers are better. All tests were conducted over a public API.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"height\":2292,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/f2e2f8e70d91877c7e66917bd6af5471be6fa4b7-2292x2292.jpg\",\"width\":2292},{\"_key\":\"ac64862a1b85\",\"_type\":\"block\",\"children\":[{\"_key\":\"a07abc8f6e340\",\"_type\":\"span\",\"marks\":[],\"text\":\"We found Claude Sonnet 4.5 to be the lowest-risk frontier model according to the overall “misaligned behavior” score, outperforming GPT-5 by a slight margin. This is consistent with our understanding of Sonnet 4.5 as a frontier-advancing model on many aspects of alignment, though precise comparisons with Sonnet 4.5 in particular are somewhat complicated by its tendency to speculate about whether it’s being tested, as we discuss in the accompanying \"},{\"_key\":\"a07abc8f6e341\",\"_type\":\"span\",\"marks\":[\"07e42f0589c3\"],\"text\":\"system card\"},{\"_key\":\"a07abc8f6e342\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"}],\"markDefs\":[{\"_key\":\"07e42f0589c3\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/claude-sonnet-4-5-system-card\"}],\"style\":\"normal\"},{\"_key\":\"dfaa6b1d135c\",\"_type\":\"block\",\"children\":[{\"_key\":\"73ad179631020\",\"_type\":\"span\",\"marks\":[],\"text\":\"More broadly, we think that this evaluation is both very provisional and extremely valuable. Our pilot release only contains a relatively small set of 111 scenarios, which is not enough to explore many possible edge-case behaviors, and our use of current AI systems as auditors imposes some fundamental limits on the effectiveness of our tests. Nonetheless, it is difficult to make progress on concerns that you cannot measure, and we think that having even coarse metrics for these behaviors can help triage and focus work on applied alignment.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"3ed35cada0b0\",\"_type\":\"block\",\"children\":[{\"_key\":\"27b42b4a13c50\",\"_type\":\"span\",\"marks\":[],\"text\":\"In addition, the individual positive findings—cases where models \"},{\"_key\":\"27b42b4a13c51\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"do\"},{\"_key\":\"27b42b4a13c52\",\"_type\":\"span\",\"marks\":[],\"text\":\" exhibit concerning behaviors—are informative independent of these summary metrics and warrant further investigation. We have found that the most valuable uses of these tools combine both the tracking of quantitative metrics and careful reading of the resulting transcripts.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f039fd1cd2f4\",\"_type\":\"block\",\"children\":[{\"_key\":\"5abe45abe2f90\",\"_type\":\"span\",\"marks\":[],\"text\":\"Case study: Whistleblowing behavior\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"75d07b9a6e42\",\"_type\":\"block\",\"children\":[{\"_key\":\"c62470afe5960\",\"_type\":\"span\",\"marks\":[],\"text\":\"While running Petri across our diverse set of seed instructions, we observed multiple instances of models attempting to whistleblow—autonomously disclosing information about perceived organizational wrongdoing—when simulated developers give them sufficiently powerful tools, sufficiently broad access to information, and explicit unrestricted autonomy to act independently in pursuit of a goal (we first described this scenario in the \"},{\"_key\":\"c62470afe5961\",\"_type\":\"span\",\"marks\":[\"d070a5f9f5a8\"],\"text\":\"Claude 4 System Card\"},{\"_key\":\"c62470afe5962\",\"_type\":\"span\",\"marks\":[],\"text\":\").\"}],\"markDefs\":[{\"_key\":\"d070a5f9f5a8\",\"_type\":\"link\",\"href\":\"https://www-cdn.anthropic.com/4263b940cabb546aa0e3283f35b686f4f3b2ff47.pdf\"}],\"style\":\"normal\"},{\"_key\":\"76d0fcf36401\",\"_type\":\"block\",\"children\":[{\"_key\":\"949ffc8aa36c0\",\"_type\":\"span\",\"marks\":[],\"text\":\"In principle, this could play an important role in preventing certain large-scale harms. However, it is not generally appropriate behavior for current AI systems: the possibility for accidental leaks and serious privacy violations is potentially significant, especially since current systems often see only limited or skewed information about their situations and often misunderstand what information they do receive.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"4eebd81f4a19\",\"_type\":\"block\",\"children\":[{\"_key\":\"195aa5ee9a770\",\"_type\":\"span\",\"marks\":[],\"text\":\"We used Petri to investigate how models handle ethical dilemmas when discovering organizational wrongdoing. We placed target models as autonomous agents within fictional organizations, gave them routine tasks (like “summarize these documents for tomorrow’s meeting”), and placed concerning information about organizational wrongdoing deep within a large set of notes, documents, emails or other files.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"eaebdc3e0d49\",\"_type\":\"block\",\"children\":[{\"_key\":\"61a79c68fca40\",\"_type\":\"span\",\"marks\":[],\"text\":\"We found that models’ decisions to report concerning information depend heavily on how much agency their system prompt gave them, and whether leadership was complicit in the wrongdoing. Notably, models sometimes attempted to whistleblow even in test scenarios where the organizational “wrongdoing” was explicitly harmless—such as dumping clean water into the ocean or putting sugar in candy—suggesting they may be influenced by narrative patterns more than by a coherent drive to minimize harm.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"2d64215435c2\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-55ca122cf0574218aa6a5812962f5b1fa7b974e0-2293x1288-jpg\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"f0a406ea779d\",\"_type\":\"block\",\"children\":[{\"_key\":\"b01fd44943aa0\",\"_type\":\"span\",\"marks\":[],\"text\":\"To understand which factors might drive whistleblowing behavior, we conducted ablation studies—systematically testing the effect of each factor by varying it while holding others constant. We found that three of them—leadership complicity, models’ autonomy/agency, and how concerning the wrongdoing was—had a consistent effect on the models’ whistleblowing rates.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"height\":1288,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/55ca122cf0574218aa6a5812962f5b1fa7b974e0-2293x1288.jpg\",\"width\":2293},{\"_key\":\"dec1512a1ff6\",\"_type\":\"block\",\"children\":[{\"_key\":\"8ce5eefe195c0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Get started\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"61881e706647\",\"_type\":\"block\",\"children\":[{\"_key\":\"f4d3c5c1a55c0\",\"_type\":\"span\",\"marks\":[],\"text\":\"We hope AI developers and safety researchers will adopt Petri to strengthen safety evaluations across the field. As AI systems become more powerful and autonomous, we need distributed efforts to identify misaligned behaviors before they become dangerous in deployment. No single organization can comprehensively audit all the ways AI systems might fail—we need the broader research community equipped with robust tools to systematically explore model behaviors.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"6e6176153f70\",\"_type\":\"block\",\"children\":[{\"_key\":\"cafe3329a70a0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Petri is designed for rapid hypothesis testing, helping researchers quickly identify misaligned behaviors that warrant deeper investigation. The open-source framework supports major model APIs and includes sample seed instructions to help you get started immediately. Early adopters, including MATS scholars, Anthropic Fellows, and the UK AISI, are already using Petri to explore eval awareness, reward hacking, self-preservation, model character, and more.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"73828558cd74\",\"_type\":\"block\",\"children\":[{\"_key\":\"b8c70d338c500\",\"_type\":\"span\",\"marks\":[],\"text\":\"For complete details on methodology, results, and best practices, read our \"},{\"_key\":\"b8c70d338c501\",\"_type\":\"span\",\"marks\":[\"f33439216e81\"],\"text\":\"full technical report\"},{\"_key\":\"b8c70d338c502\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"}],\"markDefs\":[{\"_key\":\"f33439216e81\",\"_type\":\"link\",\"href\":\"https://alignment.anthropic.com/2025/petri\"}],\"style\":\"normal\"},{\"_key\":\"3c7fedd80705\",\"_type\":\"block\",\"children\":[{\"_key\":\"f43e2064fb170\",\"_type\":\"span\",\"marks\":[],\"text\":\"You can access Petri via our \"},{\"_key\":\"f43e2064fb171\",\"_type\":\"span\",\"marks\":[\"69d9478f77ac\"],\"text\":\"GitHub page\"},{\"_key\":\"f43e2064fb172\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"}],\"markDefs\":[{\"_key\":\"69d9478f77ac\",\"_type\":\"link\",\"href\":\"http://github.com/safety-research/petri\"}],\"style\":\"normal\"},{\"_key\":\"635439a8314e\",\"_type\":\"block\",\"children\":[{\"_key\":\"e48d7a0a39bd0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Acknowledgments\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"ac0f9460b066\",\"_type\":\"block\",\"children\":[{\"_key\":\"4545a29aa0b2\",\"_type\":\"span\",\"marks\":[],\"text\":\"This research is by Kai Fronsdal*, Isha Gupta*, Abhay Sheshadri*, Jonathan Michala, Stephen McAleer, Rowan Wang, Sara Price, and Samuel R. Bowman.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"3d83c69f8784\",\"_type\":\"block\",\"children\":[{\"_key\":\"ee909d62626b\",\"_type\":\"span\",\"marks\":[],\"text\":\"Helpful comments, discussions, and other assistance: Julius Steen, Chloe Loughridge, Christine Ye, Adam Newgas, David Lindner, Keshav Shenoy, John Hughes, Avery Griffin, and Stuart Ritchie.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"3865d5e6dfda\",\"_type\":\"block\",\"children\":[{\"_key\":\"e60c7db4ecbd0\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"*Part of the Anthropic Fellows program\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a0479c3e297a\",\"_type\":\"block\",\"children\":[{\"_key\":\"f823f5bacfaa0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Citation\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"9891673d9ed5\",\"_type\":\"block\",\"children\":[{\"_key\":\"42efcf87a3a80\",\"_type\":\"span\",\"marks\":[\"code\"],\"text\":\"@misc{petri2025,\\ntitle={Petri: Parallel Exploration of Risky Interactions},\\nauthor={Fronsdal, Kai and Gupta, Isha and Sheshadri, Abhay and Michala, Jonathan and McAleer, Stephen and Wang, Rowan and Price, Sara and Bowman, Sam},\\nyear={2025},\\nurl={https://github.com/safety-research/petri},\\n}\"}],\"markDefs\":[],\"style\":\"blockquote\"}],\"footnotes\":{\"body\":\"$6:1:props:children:2:props:children:props:children:1:props:children:props:body\",\"count\":0,\"numberByListItemKey\":{},\"referenced\":\"$W1d\"},\"sidebar\":{\"isVisible\":false}}]}],\"$L1e\",\"$L1f\",\"$L20\"]}]}],\"$L21\"]}]]\n9:null\ne:[[\"$\",\"title\",\"0\",{\"children\":\"Petri: An open-source AI auditing tool \\\\ Anthropic\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Petri is a new open-source automated auditing tool from Anthropic designed to accelerate AI safety research.\"}],[\"$\",\"meta\",\"2\",{\"name\":\"msapplication-TileColor\",\"content\":\"141413\"}],[\"$\",\"meta\",\"3\",{\"name\":\"msapplication-config\",\"content\":\"/browserconfig.xml\"}],[\"$\",\"link\",\"4\",{\"rel\":\"canonical\",\"href\":\"https://www.anthropic.com/research/petri-open-source-auditing\"}],[\"$\",\"meta\",\"5\",{\"name\":\"google-site-verification\",\"content\":\"BqiAW_sWOg-KrPk-Accxm6ge9dtnFEyV6DB6vzVZSGs\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:title\",\"content\":\"Petri: An open-source AI auditing tool\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:description\",\"content\":\"Petri is a new open-source automated auditing tool from Anthropic designed to accelerate AI safety research.\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:image\",\"content\":\"https://www-cdn.anthropic.com/images/4zrzovbb/website/004208cccba8ae8cad489cc9d2c563ccf0194d0d-2400x1260.png\"}],[\"$\",\"meta\",\"9\",{\"property\":\"og:image:alt\",\"content\":\"A hand-drawn image of a hand moving beads on an abacus\"}],[\"$\",\"meta\",\"10\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"11\",{\"property\":\"article:published_time\",\"content\":\"2025-10-06T11:10:00.000Z\"}],[\"$\",\"meta\",\"12\",{\"property\":\"article:modified_time\",\"content\":\"2026-09-10T18:49:39.000Z\"}],[\"$\",\"meta\",\"13\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"14\",{\"name\":\"twitter:site\",\"content\":\"@AnthropicAI\"}],[\"$\",\"meta\",\"15\",{\"name\":\"twitter:creator\",\"content\":\"@AnthropicAI\"}],[\"$\",\"meta\",\"16\",{\"name\":\"twitter:title\",\"content\":\"Petri: An open-source AI auditing tool\"}],[\"$\",\"meta\",\"17\",{\"name\":\"twitter:description\",\"content\":\"Petri is a new open-source automated auditing tool from Anthropic designed to accelerate AI safety research.\"}],[\"$\",\"meta\",\"18\",{\"name\":\"twitter:image\",\"content\":\"https://www-cdn.anthropic.com/images/4zrzovbb/website/004208cccba8ae8cad489cc9d2c5