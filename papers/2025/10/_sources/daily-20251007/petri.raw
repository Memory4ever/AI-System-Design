6vb5exi-eaqh.js\",\"/_next/static/chunks/3x8b_vd-kz-ge.js\",\"/_next/static/chunks/3ivs8n8bmmln4.js\",\"/_next/static/chunks/3syu72y118s_7.js\",\"/_next/static/chunks/1m4wanshvtpne.js\",\"/_next/static/chunks/2q7zgbd7qicdr.js\",\"/_next/static/chunks/0nawt0ap340lw.js\",\"/_next/static/chunks/3u0m-ev5_8d4d.js\"],\"IconArrowRight\"]\n27:I[645533,[\"/_next/static/chunks/1fvd0nqqmo54p.js\",\"/_next/static/chunks/36vb5exi-eaqh.js\",\"/_next/static/chunks/3x8b_vd-kz-ge.js\",\"/_next/static/chunks/3ivs8n8bmmln4.js\",\"/_next/static/chunks/3syu72y118s_7.js\",\"/_next/static/chunks/1m4wanshvtpne.js\",\"/_next/static/chunks/2q7zgbd7qicdr.js\",\"/_next/static/chunks/0nawt0ap340lw.js\",\"/_next/static/chunks/3u0m-ev5_8d4d.js\"],\"IconLogoMark\"]\n1e:[\"$\",\"div\",null,{\"className\":\"page-wrapper PostDetail-module-scss-module__UQuRMa__postFooter\",\"children\":[null,[\"$\",\"div\",null,{\"className\":\"PostDetail-module-scss-module__UQuRMa__socialShare\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://twitter.com/intent/tweet?text=https://www.anthropic.com/research/petri-open-source-auditing\",\"target\":\"_blank\",\"rel\":\"noopener\",\"aria-label\":\"Share on Twitter\",\"children\":[\"$\",\"$L23\",null,{}]}],[\"$\",\"a\",null,{\"href\":\"https://www.linkedin.com/shareArticle?mini=true\u0026url=https://www.anthropic.com/research/petri-open-source-auditing\",\"target\":\"_blank\",\"rel\":\"noopener\",\"aria-label\":\"Share on LinkedIn\",\"children\":[\"$\",\"$L24\",null,{}]}]]}]]}]\n1f:[\"$\",\"section\",null,{\"className\":\"LandingPageSection-module-scss-module__ZSMdoa__root\",\"id\":\"$undefined\",\"ref\":\"$undefined\",\"style\":\"$undefined\",\"data-theme\":\"ivory\",\"children\":[\"$undefined\",[\"$\",\"div\",null,{\"className\":\"page-wrapper\",\"children\":[[\"$\",\"div\",null,{\"className\":\"SectionIntro-module-scss-module__i9TRza__root LinkGrid-module-scss-module__wTN57W__intro\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"headline-4 SectionIntro-module-scss-module__i9TRza__title\",\"children\":\"Related content\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"LinkGrid-module-scss-module__wTN57W__root\",\"children\":[false,[\"$\",\"div\",null,{\"className\":\"LinkGrid-module-scss-module__wTN57W__items LinkGrid-module-scss-module__wTN57W__threeItems\",\"children\":[[\"$\",\"div\",\"0\",{\"className\":\"LinkGrid-module-scss-module__wTN57W__item\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"headline-6\",\"children\":\"Claude-shaped science\"}],[\"$\",\"p\",null,{\"className\":\"body-3 serif\",\"children\":\"Guest author Prof. Matthew Schwartz describes what happened when he stopped fighting Claude and allowed Claude to find “Claude-shaped” problems: ones best suited to the capabilities of the current generation of LLM tools. This led him to build BootLoops, a toolkit for exact calculations in quantitative science, which he has been applying across scientific fields alongside experts.\"}],[\"$\",\"$L25\",null,{\"className\":\"LinkGrid-module-scss-module__wTN57W__cta\",\"link\":{\"text\":\"Read more\",\"url\":\"/research/claude-shaped-science\"},\"ctaPosition\":\"linkGrid\",\"icon\":[\"$\",\"$L26\",null,{\"fill\":\"currentColor\"}],\"iconPosition\":\"right\"}]]}],[\"$\",\"div\",\"1\",{\"className\":\"LinkGrid-module-scss-module__wTN57W__item\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"headline-6\",\"children\":\"What work can robots do?\"}],[\"$\",\"p\",null,{\"className\":\"body-3 serif\",\"children\":\"We built an index of how well today’s robots can perform US job tasks. Robots can already do three-quarters of physical tasks, mostly in limited settings, but are cost-competitive for just 0.3% of them.\"}],[\"$\",\"$L25\",null,{\"className\":\"LinkGrid-module-scss-module__wTN57W__cta\",\"link\":{\"text\":\"Read more\",\"url\":\"/research/what-work-can-robots-do\"},\"ctaPosition\":\"linkGrid\",\"icon\":[\"$\",\"$L26\",null,{\"fill\":\"currentColor\"}],\"iconPosition\":\"right\"}]]}],[\"$\",\"div\"