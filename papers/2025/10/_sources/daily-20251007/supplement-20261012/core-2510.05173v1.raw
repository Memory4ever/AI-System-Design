<td id="S4.T2.4.3.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_r ltx_border_t" style="padding-left:2.0pt;padding-right:2.0pt;">
<span id="S4.T2.4.3.1.1" class="ltx_inline-block ltx_align_top" style="width:75.3pt;">
<span id="S4.T2.4.3.1.1.1" class="ltx_p ltx_align_center"><span id="S4.T2.4.3.1.1.1.1" class="ltx_text" style="font-size:90%;">P4D</span></span>
</span></td>
