</span></span><span id="S4.T2.4.1.1.2.2" class="ltx_text"></span></span></td>
<td id="S4.T2.4.1.2" class="ltx_td ltx_align_center ltx_align_top ltx_border_r ltx_border_tt" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S4.T2.4.1.2.1" class="ltx_text"></span><span id="S4.T2.4.1.2.2" class="ltx_text" style="font-size:90%;"> <span id="S4.T2.4.1.2.2.1" class="ltx_text">
