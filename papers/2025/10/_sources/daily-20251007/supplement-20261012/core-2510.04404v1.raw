<tr id="S4.T6.5.1.7" class="ltx_tr">
<th id="S4.T6.5.1.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S4.T6.5.1.7.1.1" class="ltx_text ltx_font_bold">Multi-objective Reward</span></th>
<th id="S4.T6.5.1.7.2" class="ltx_td ltx_align_center ltx_th ltx_th_row"><math id="S4.T6.m6" class="ltx_Math" alttext="\max_{\pi}\mathbb{E}_{\tau}[\sum_{t=0}^{T}\gamma^{t}(\alpha_{1}r_{\text{latency}}+\alpha_{2}r_{\text{cost}}+\alpha_{3}r_{\text{stability}})]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>max</mi><mi>π</mi></msub><mo lspace="0.167em">⁡</mo><msub><mi>𝔼</mi><mi>τ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mo lspace="0em">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mi>T</mi></msubsup><mrow><msup><mi>γ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>α</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mtext>latency</mtext></msub></mrow><mo>+</mo><mrow><msub><mi>α</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mtext>cost</mtext></msub></mrow><mo>+</mo><mrow><msub><mi>α</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mtext>stability</mtext></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\max_{\pi}\mathbb{E}_{\tau}[\sum_{t=0}^{T}\gamma^{t}(\alpha_{1}r_{\text{latency}}+\alpha_{2}r_{\text{cost}}+\alpha_{3}r_{\text{stability}})]</annotation></semantics></math></th>
<td id="S4.T6.5.1.7.3" class="ltx_td ltx_align_center">Competing objectives balance</td>
<td id="S4.T6.5.1.7.4" class="ltx_td ltx_align_center">Pareto-optimal solutions</td>
<td id="S4.T6.5.1.7.5" class="ltx_td ltx_align_center">34% latency reduction</td></tr>
<tr id="S4.T6.5.1.8" class="ltx_tr">
<th id="S4.T6.5.1.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S4.T6.5.1.8.1.1" class="ltx_text ltx_font_bold">Graph Neural Networks</span></th>
<th id="S4.T6.5.1.8.2" class="ltx_td ltx_align_center ltx_th ltx_th_row"><math id="S4.T6.m7" class="ltx_Math" alttext="h_{v}^{(l+1)}=\text{UPDATE}^{(l)}(h_{v}^{(l)},\text{AGGREGATE}^{(l)}(\{h_{u}^{(l)}:u\in\mathcal{N}(v)\}))" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>h</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><msup><mtext>UPDATE</mtext><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>h</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mrow><msup><mtext>AGGREGATE</mtext><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>h</mi><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>u</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">h_{v}^{(l+1)}=\text{UPDATE}^{(l)}(h_{v}^{(l)},\text{AGGREGATE}^{(l)}(\{h_{u}^{(l)}:u\in\mathcal{N}(v)\}))</annotation></semantics></math></th>
<td id="S4.T6.5.1.8.3" class="ltx_td ltx_align_center">Topology-aware routing</td>
<td id="S4.T6.5.1.8.4" class="ltx_td ltx_align_center">Network embedding</td>
<td id="S4.T6.5.1.8.5" class="ltx_td ltx_align_center">Intelligent message routing</td></tr>
<tr id="S4.T6.5.1.9" class="ltx_tr">
<th id="S4.T6.5.1.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S4.T6.5.1.9.1.1" class="ltx_text ltx_font_bold">Q-learning Update</span></th>
<th id="S4.T6.5.1.9.2" class="ltx_td ltx_align_center ltx_th ltx_th_row"><math id="S4.T6.m8" class="ltx_Math" alttext="Q(s,a)\leftarrow Q(s,a)+\alpha[r+\gamma\max_{a^{\prime}}Q(s^{\prime},a^{\prime})-Q(s,a)]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>r</mi><mo>+</mo><mrow><mi>γ</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>max</mi><msup><mi>a</mi><mo>′</mo></msup></msub><mo lspace="0.167em">⁡</mo><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>s</mi><mo>′</mo></msup><mo>,</mo><msup><mi>a</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">Q(s,a)\leftarrow Q(s,a)+\alpha[r+\gamma\max_{a^{\prime}}Q(s^{\prime},a^{\prime})-Q(s,a)]</annotation></semantics></math></th>
<td id="S4.T6.5.1.9.3" class="ltx_td ltx_align_center">Dynamic routing adaptation</td>
<td id="S4.T6.5.1.9.4" class="ltx_td ltx_align_center">Online learning</td>
<td id="S4.T6.5.1.9.5" class="ltx_td ltx_align_center">Real-time route optimization</td></tr>
<tr id="S4.T6.5.1.10" class="ltx_tr">
<th id="S4.T6.5.1.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S4.T6.5.1.10.1.1" class="ltx_text ltx_font_bold">Cost Optimization</span></th>
<th id="S4.T6.5.1.10.2" class="ltx_td ltx_align_center ltx_th ltx_th_row"><math id="S4.T6.m9" class="ltx_math_unparsed" alttext="\min\sum_{i}c_{i}x_{i}+\sum_{j}d_{j}y_{j}" display="inline" intent=":literal"><semantics><mrow><mi>min</mi><mo>∑</mo><msub><mrow></mrow><mi>i</mi></msub><mi>c</mi><msub><mrow></mrow><mi>i</mi></msub><mi>x</mi><msub><mrow></mrow><mi>i</mi></msub><mo rspace="0.055em">+</mo><mo>∑</mo><msub><mrow></mrow><mi>j</mi></msub><mi>d</mi><msub><mrow></mrow><mi>j</mi></msub><mi>y</mi><msub><mrow></mrow><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">\min\sum_{i}c_{i}x_{i}+\sum_{j}d_{j}y_{j}</annotation></semantics></math> s.t. <math id="S4.T6.m10" class="ltx_Math" alttext="\sum_{i}p_{i}x_{i}\geq P_{\min}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mi>i</mi></msub><mrow><msub><mi>p</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>i</mi></msub></mrow></mrow><mo>≥</mo><msub><mi>P</mi><mi>min</mi></msub></mrow><annotation encoding="application/x-tex">\sum_{i}p_{i}x_{i}\geq P_{\min}</annotation></semantics></math></th>
<td id="S4.T6.5.1.10.3" class="ltx_td ltx_align_center">Infrastructure cost minimization</td>
<td id="S4.T6.5.1.10.4" class="ltx_td ltx_align_center">Mixed-integer programming</td>
<td id="S4.T6.5.1.10.5" class="ltx_td ltx_align_center">42% cost optimization</td></tr>
<tr id="S4.T6.5.1.11" class="ltx_tr">
<th id="S4.T6.5.1.11.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S4.T6.5.1.11.1.1" class="ltx_text ltx_font_bold">Queuing Theory</span></th>
<th id="S4.T6.5.1.11.2" class="ltx_td ltx_align_center ltx_th ltx_th_row"><math id="S4.T6.m11" class="ltx_Math" alttext="\mathbb{E}[W]=\frac{\rho^{c}}{c!(1-\rho/c)^{2}}\cdot\frac{1}{\mu(c-\rho)}+\frac{1}{\mu}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>W</mi><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><msup><mi>ρ</mi><mi>c</mi></msup><mrow><mrow><mi>c</mi><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>ρ</mi><mo>/</mo><mi>c</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mn>1</mn><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mi>ρ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo>+</mo><mfrac><mn>1</mn><mi>μ</mi></mfrac></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[W]=\frac{\rho^{c}}{c!(1-\rho/c)^{2}}\cdot\frac{1}{\mu(c-\rho)}+\frac{1}{\mu}</annotation></semantics></math></th>
