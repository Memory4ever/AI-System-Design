<tr id="S4.T1.5.1" class="ltx_tr">
<th id="S4.T1.5.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Tracking Method</th>
<th id="S4.T1.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Det. Acc.(%)</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T1.5.2" class="ltx_tr">
