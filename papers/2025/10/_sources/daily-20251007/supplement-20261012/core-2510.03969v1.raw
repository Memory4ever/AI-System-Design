<td id="S4.T2.2.12.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb" style="padding:0.25pt 3.0pt;"></td>
<td id="S4.T2.2.12.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb" style="padding:0.25pt 3.0pt;">
<span id="S4.T2.2.12.2.1" class="ltx_inline-block ltx_align_top" style="width:29.4pt;">
<span id="S4.T2.2.12.2.1.1" class="ltx_p">llama</span>
