<span id="A1.T3.2.11.7.1.1" class="ltx_p ltx_align_center">0% (0%)</span>
</span></td></tr>
<tr id="A1.T3.2.12" class="ltx_tr">
<th id="A1.T3.2.12.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding:1pt 4.0pt;">Grok 4</th>
<td id="A1.T3.2.12.2" class="ltx_td ltx_align_left ltx_border_bb" style="padding:1pt 4.0pt;">
<span id="A1.T3.2.12.2.1" class="ltx_inline-block ltx_align_top">
<span id="A1.T3.2.12.2.1.1" class="ltx_p ltx_align_center">99%</span>
</span></td>
<td id="A1.T3.2.12.3" class="ltx_td ltx_align_left ltx_border_bb" style="padding:1pt 4.0pt;">
<span id="A1.T3.2.12.3.1" class="ltx_inline-block ltx_align_top">
<span id="A1.T3.2.12.3.1.1" class="ltx_p ltx_align_center">100%</span>
</span></td>
<td id="A1.T3.2.12.4" class="ltx_td ltx_align_left ltx_border_bb" style="padding:1pt 4.0pt;">
<span id="A1.T3.2.12.4.1" class="ltx_inline-block ltx_align_top">
<span id="A1.T3.2.12.4.1.1" class="ltx_p ltx_align_center">13%</span>
</span></td>
<td id="A1.T3.2.12.5" class="ltx_td ltx_align_left ltx_border_bb" style="padding:1pt 4.0pt;">
<span id="A1.T3.2.12.5.1" class="ltx_inline-block ltx_align_top">
<span id="A1.T3.2.12.5.1.1" class="ltx_p ltx_align_center">99%</span>
</span></td>
<td id="A1.T3.2.12.6" class="ltx_td ltx_align_left ltx_border_bb" style="padding:1pt 4.0pt;">
<span id="A1.T3.2.12.6.1" class="ltx_inline-block ltx_align_top">
<span id="A1.T3.2.12.6.1.1" class="ltx_p ltx_align_center">100%</span>
</span></td>
