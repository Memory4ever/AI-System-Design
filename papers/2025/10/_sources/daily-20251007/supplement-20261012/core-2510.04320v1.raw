<div id="A5.p3" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A5.p3.pic1" class="ltx_picture" height="610.1" overflow="visible" version="1.1" viewBox="0 0 550 610.1" width="550"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,610.1) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#ACCEED;" fill="#ACCEED" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 604.19 C 0 607.46 2.64 610.1 5.91 610.1 L 544.09 610.1 C 547.36 610.1 550 607.46 550 604.19 L 550 5.91 C 550 2.64 547.36 0 544.09 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#DCEAF7;" fill="#DCEAF7" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 585.99 L 548.03 585.99 L 548.03 5.91 C 548.03 3.73 546.27 1.97 544.09 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 594.58)"><foreignObject style="--ltx-fo-width:36.62em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="506.72"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
