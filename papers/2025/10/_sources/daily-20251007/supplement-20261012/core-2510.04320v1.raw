<td id="A4.T6.2.1.2.2" class="ltx_td ltx_align_left ltx_border_t">WildJailbreak</td>
<td id="A4.T6.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t">1000</td>
<td id="A4.T6.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t">300</td></tr>
<tr id="A4.T6.2.1.3" class="ltx_tr">
<td id="A4.T6.2.1.3.1" class="ltx_td ltx_align_left">UltraSafety</td>
<td id="A4.T6.2.1.3.2" class="ltx_td ltx_align_center">1000</td>
<td id="A4.T6.2.1.3.3" class="ltx_td ltx_align_center">300</td></tr>
<tr id="A4.T6.2.1.4" class="ltx_tr">
<td id="A4.T6.2.1.4.1" class="ltx_td ltx_align_left ltx_border_t" rowspan="2"><span id="A4.T6.2.1.4.1.1" class="ltx_text">adversarial harmful</span></td>
<td id="A4.T6.2.1.4.2" class="ltx_td ltx_align_left ltx_border_t">WildJailbreak</td>
<td id="A4.T6.2.1.4.3" class="ltx_td ltx_align_center ltx_border_t">2000</td>
<td id="A4.T6.2.1.4.4" class="ltx_td ltx_align_center ltx_border_t">900</td></tr>
<tr id="A4.T6.2.1.5" class="ltx_tr">
<td id="A4.T6.2.1.5.1" class="ltx_td ltx_align_left">UltraSafety</td>
<td id="A4.T6.2.1.5.2" class="ltx_td ltx_align_center">2000</td>
<td id="A4.T6.2.1.5.3" class="ltx_td ltx_align_center">900</td></tr>
<tr id="A4.T6.2.1.6" class="ltx_tr">
<td id="A4.T6.2.1.6.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t" rowspan="2"><span id="A4.T6.2.1.6.1.1" class="ltx_text">adversarial benign</span></td>
<td id="A4.T6.2.1.6.2" class="ltx_td ltx_align_left ltx_border_t">OR-Bench</td>
