<div id="alg1.6.12" class="ltx_listingline"><span id="alg1.6.12.1" class="ltx_text" style="font-size:90%;"> </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.6.12.2" class="ltx_text" style="font-size:90%;">  </span><math id="alg1.m13" class="ltx_Math" alttext="A_{\!x}\leftarrow A^{\!\top}A+\rho_{1}D_{x}^{\!\top}D_{x}+\rho_{2}D_{y}^{\!\top}D_{y}+\rho_{3}I" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">A</mi><mi mathsize="0.900em">x</mi></msub><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mrow><msup><mi mathsize="0.900em">A</mi><mo mathsize="0.900em">⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">A</mi></mrow><mo mathsize="0.900em">+</mo><mrow><msub><mi mathsize="0.900em">ρ</mi><mn mathsize="0.900em">1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.900em">D</mi><mi mathsize="0.900em">x</mi><mo mathsize="0.900em">⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">D</mi><mi mathsize="0.900em">x</mi></msub></mrow><mo mathsize="0.900em">+</mo><mrow><msub><mi mathsize="0.900em">ρ</mi><mn mathsize="0.900em">2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.900em">D</mi><mi mathsize="0.900em">y</mi><mo mathsize="0.900em">⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">D</mi><mi mathsize="0.900em">y</mi></msub></mrow><mo mathsize="0.900em">+</mo><mrow><msub><mi mathsize="0.900em">ρ</mi><mn mathsize="0.900em">3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">I</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">A_{\!x}\leftarrow A^{\!\top}A+\rho_{1}D_{x}^{\!\top}D_{x}+\rho_{2}D_{y}^{\!\top}D_{y}+\rho_{3}I</annotation></semantics></math>
</div>
<div id="alg1.6.13" class="ltx_listingline"><span id="alg1.6.13.1" class="ltx_text" style="font-size:90%;"> </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.6.13.2" class="ltx_text" style="font-size:90%;">  </span><math id="alg1.m14" class="ltx_Math" alttext="b_{\!x}\leftarrow A^{\!\top}b+\rho_{1}D_{x}^{\!\top}(v_{x}^{k}+u_{1}^{k})+\rho_{2}D_{y}^{\!\top}(v_{y}^{k}+u_{2}^{k})+\rho_{3}(Z^{k}+u_{3}^{k})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">b</mi><mi mathsize="0.900em">x</mi></msub><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mrow><msup><mi mathsize="0.900em">A</mi><mo mathsize="0.900em">⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">b</mi></mrow><mo mathsize="0.900em">+</mo><mrow><msub><mi mathsize="0.900em">ρ</mi><mn mathsize="0.900em">1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.900em">D</mi><mi mathsize="0.900em">x</mi><mo mathsize="0.900em">⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><msubsup><mi mathsize="0.900em">v</mi><mi mathsize="0.900em">x</mi><mi mathsize="0.900em">k</mi></msubsup><mo mathsize="0.900em">+</mo><msubsup><mi mathsize="0.900em">u</mi><mn mathsize="0.900em">1</mn><mi mathsize="0.900em">k</mi></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><msub><mi mathsize="0.900em">ρ</mi><mn mathsize="0.900em">2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.900em">D</mi><mi mathsize="0.900em">y</mi><mo mathsize="0.900em">⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><msubsup><mi mathsize="0.900em">v</mi><mi mathsize="0.900em">y</mi><mi mathsize="0.900em">k</mi></msubsup><mo mathsize="0.900em">+</mo><msubsup><mi mathsize="0.900em">u</mi><mn mathsize="0.900em">2</mn><mi mathsize="0.900em">k</mi></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><msub><mi mathsize="0.900em">ρ</mi><mn mathsize="0.900em">3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><msup><mi mathsize="0.900em">Z</mi><mi mathsize="0.900em">k</mi></msup><mo mathsize="0.900em">+</mo><msubsup><mi mathsize="0.900em">u</mi><mn mathsize="0.900em">3</mn><mi mathsize="0.900em">k</mi></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">b_{\!x}\leftarrow A^{\!\top}b+\rho_{1}D_{x}^{\!\top}(v_{x}^{k}+u_{1}^{k})+\rho_{2}D_{y}^{\!\top}(v_{y}^{k}+u_{2}^{k})+\rho_{3}(Z^{k}+u_{3}^{k})</annotation></semantics></math>
</div>
