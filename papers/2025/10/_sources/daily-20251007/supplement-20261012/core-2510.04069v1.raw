</div>
<div id="alg1.6.21" class="ltx_listingline"><span id="alg1.6.21.1" class="ltx_text" style="font-size:90%;"> </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.6.21.2" class="ltx_text" style="font-size:90%;">  </span><math id="alg1.m20" class="ltx_Math" alttext="X^{k+1}\leftarrow P(x^{k+1})" display="inline" intent=":literal"><semantics><mrow><msup><mi mathsize="0.900em">X</mi><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mi mathsize="0.900em">P</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mi mathsize="0.900em">x</mi><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X^{k+1}\leftarrow P(x^{k+1})</annotation></semantics></math>
</div>
