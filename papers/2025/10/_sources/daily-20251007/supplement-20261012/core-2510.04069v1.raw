<div id="alg1.6.17" class="ltx_listingline"><span id="alg1.6.17.1" class="ltx_text" style="font-size:90%;"> </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.6.17.2" class="ltx_text" style="font-size:90%;">  </span><math id="alg1.m17" class="ltx_Math" alttext="v_{x}^{k+1}\leftarrow\operatorname{Shrink}\!\bigl(D_{x}x^{k+1}-u_{1}^{k},\,\alpha/\rho_{1}\bigr)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.900em">v</mi><mi mathsize="0.900em">x</mi><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mpadded style="width:3.073em;" width="3.073em"><mi mathsize="0.900em">Shrink</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi mathsize="0.900em">D</mi><mi mathsize="0.900em">x</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">x</mi><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup></mrow><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">u</mi><mn mathsize="0.900em">1</mn><mi mathsize="0.900em">k</mi></msubsup></mrow><mo mathsize="0.900em">,</mo><mrow><mi mathsize="0.900em">α</mi><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><msub><mi mathsize="0.900em">ρ</mi><mn mathsize="0.900em">1</mn></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">v_{x}^{k+1}\leftarrow\operatorname{Shrink}\!\bigl(D_{x}x^{k+1}-u_{1}^{k},\,\alpha/\rho_{1}\bigr)</annotation></semantics></math>
</div>
<div id="alg1.6.18" class="ltx_listingline"><span id="alg1.6.18.1" class="ltx_text" style="font-size:90%;"> </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.6.18.2" class="ltx_text" style="font-size:90%;">  </span><math id="alg1.m18" class="ltx_Math" alttext="v_{y}^{k+1}\leftarrow\operatorname{Shrink}\!\bigl(D_{y}x^{k+1}-u_{2}^{k},\,\alpha/\rho_{2}\bigr)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.900em">v</mi><mi mathsize="0.900em">y</mi><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mpadded style="width:3.073em;" width="3.073em"><mi mathsize="0.900em">Shrink</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi mathsize="0.900em">D</mi><mi mathsize="0.900em">y</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">x</mi><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup></mrow><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">u</mi><mn mathsize="0.900em">2</mn><mi mathsize="0.900em">k</mi></msubsup></mrow><mo mathsize="0.900em">,</mo><mrow><mi mathsize="0.900em">α</mi><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><msub><mi mathsize="0.900em">ρ</mi><mn mathsize="0.900em">2</mn></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">v_{y}^{k+1}\leftarrow\operatorname{Shrink}\!\bigl(D_{y}x^{k+1}-u_{2}^{k},\,\alpha/\rho_{2}\bigr)</annotation></semantics></math>
</div>
<div id="alg1.6.19" class="ltx_listingline"><span id="alg1.6.19.1" class="ltx_text" style="font-size:90%;"> </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.6.19.2" class="ltx_text" style="font-size:90%;">  [2pt]
</span>
</div>
