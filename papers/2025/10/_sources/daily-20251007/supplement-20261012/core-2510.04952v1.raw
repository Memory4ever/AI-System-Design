<td id="S6.T1.4.2.2" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.6pt 4.5pt;">
<span id="S6.T1.4.2.2.1" class="ltx_inline-block ltx_align_top">
<span id="S6.T1.4.2.2.1.1" class="ltx_p ltx_align_right"><math id="S6.T1.m4" class="ltx_Math" alttext="-2.15\pm 0.10" display="inline" intent=":literal"><semantics><mrow><mrow><mo mathsize="0.700em">−</mo><mn mathsize="0.700em">2.15</mn></mrow><mo mathsize="0.700em">±</mo><mn mathsize="0.700em">0.10</mn></mrow><annotation encoding="application/x-tex">-2.15\pm 0.10</annotation></semantics></math></span>
</span></td>
<td id="S6.T1.4.2.3" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.6pt 4.5pt;"><math id="S6.T1.m5" class="ltx_Math" alttext="1.8" display="inline" intent=":literal"><semantics><mn mathsize="0.700em">1.8</mn><annotation encoding="application/x-tex">1.8</annotation></semantics></math></td>
<td id="S6.T1.4.2.4" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.6pt 4.5pt;"><math id="S6.T1.m6" class="ltx_Math" alttext="100" display="inline" intent=":literal"><semantics><mn mathsize="0.700em">100</mn><annotation encoding="application/x-tex">100</annotation></semantics></math></td>
<td id="S6.T1.4.2.5" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.6pt 4.5pt;">
<span id="S6.T1.4.2.5.1" class="ltx_inline-block ltx_align_top">
<span id="S6.T1.4.2.5.1.1" class="ltx_p ltx_align_right"><span id="S6.T1.4.2.5.1.1.1" class="ltx_text" style="font-size:70%;">9.8%</span></span>
</span></td>
<td id="S6.T1.4.2.6" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t" style="padding:0.6pt 4.5pt;"><math id="S6.T1.m7" class="ltx_Math" alttext="0.0" display="inline" intent=":literal"><semantics><mn mathsize="0.700em">0.0</mn><annotation encoding="application/x-tex">0.0</annotation></semantics></math></td></tr>
<tr id="S6.T1.4.3" class="ltx_tr">
<td id="S6.T1.4.3.1" class="ltx_td ltx_align_left" style="padding:0.6pt 4.5pt;"><span id="S6.T1.4.3.1.1" class="ltx_text" style="font-size:70%;">RL (Unconstrained)</span></td>
<td id="S6.T1.4.3.2" class="ltx_td ltx_align_left" style="padding:0.6pt 4.5pt;">
<span id="S6.T1.4.3.2.1" class="ltx_inline-block ltx_align_top">
