          <span id="alg1.l10.3" class="ltx_text ltx_font_bold">return</span> <math id="alg1.l10.m1" class="ltx_Math" alttext="\tilde{\bm{x}}_{t_{T}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝒙</mi><mo>~</mo></mover><msub><mi>t</mi><mi>T</mi></msub></msub><annotation encoding="application/x-tex">\tilde{\bm{x}}_{t_{T}}</annotation></semantics></math>

