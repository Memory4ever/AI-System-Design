<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E6Xb.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E6Xb.m3" class="ltx_Math" alttext="\displaystyle p(\mathcal{R}_{m}^{h-w+1:h}[T])\prod_{t=1}^{T}p(\mathcal{R}^{h-w+1:h}_{m}[t-1]|\mathcal{R}^{h-w+1:h}_{m}[t]," display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi><msub><mrow></mrow><mi>m</mi></msub><msup><mrow></mrow><mrow><mrow><mrow><mi>h</mi><mo>−</mo><mi>w</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>h</mi></mrow></msup><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo><mo rspace="0.167em" stretchy="false">)</mo><mstyle displaystyle="true"><mo movablelimits="false">∏</mo></mstyle><msub><mrow></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>T</mi></msup><mi>p</mi><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi><msup><mrow></mrow><mrow><mrow><mrow><mi>h</mi><mo>−</mo><mi>w</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>h</mi></mrow></msup><msub><mrow></mrow><mi>m</mi></msub><mo stretchy="false">[</mo><mi>t</mi><mo>−</mo><mn>1</mn><mo stretchy="false">]</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi><msup><mrow></mrow><mrow><mrow><mrow><mi>h</mi><mo>−</mo><mi>w</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>h</mi></mrow></msup><msub><mrow></mrow><mi>m</mi></msub><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle p(\mathcal{R}_{m}^{h-w+1:h}[T])\prod_{t=1}^{T}p(\mathcal{R}^{h-w+1:h}_{m}[t-1]|\mathcal{R}^{h-w+1:h}_{m}[t],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
