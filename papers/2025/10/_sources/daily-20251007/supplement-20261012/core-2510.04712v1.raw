<td id="S5.T2.4.1.3.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T2.4.1.3.2.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F2F2F2;">0.1554</span></td>
