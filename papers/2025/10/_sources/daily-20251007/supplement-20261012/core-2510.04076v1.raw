</span></td></tr>
<tr id="S5.T4.1.3" class="ltx_tr">
<td id="S5.T4.1.3.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_l ltx_border_r ltx_border_t">
<span id="S5.T4.1.3.1.1" class="ltx_inline-block ltx_align_top" style="width:65.4pt;">
<span id="S5.T4.1.3.1.1.1" class="ltx_p">R-O DeePC</span>
</span></td>
<td id="S5.T4.1.3.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_r ltx_border_t">
<span id="S5.T4.1.3.2.1" class="ltx_inline-block ltx_align_top" style="width:65.4pt;">
<span id="S5.T4.1.3.2.1.1" class="ltx_p"><math id="S5.T4.m3" class="ltx_Math" alttext="9.92\hskip 2.84526pt" display="inline" intent=":literal"><semantics><mn>9.92</mn><annotation encoding="application/x-tex">9.92\hskip 2.84526pt</annotation></semantics></math></span>
</span></td>
<td id="S5.T4.1.3.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_r ltx_border_t">
<span id="S5.T4.1.3.3.1" class="ltx_inline-block ltx_align_top" style="width:65.4pt;">
<span id="S5.T4.1.3.3.1.1" class="ltx_p"><math id="S5.T4.m4" class="ltx_Math" alttext="89.00\hskip 2.84526ptms" display="inline" intent=":literal"><semantics><mrow><mn>89.00</mn><mo lspace="0.280em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><annotation encoding="application/x-tex">89.00\hskip 2.84526ptms</annotation></semantics></math></span>
</span></td></tr>
