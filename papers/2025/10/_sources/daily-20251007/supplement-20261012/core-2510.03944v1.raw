<td id="A4.T8.5.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:12.0pt;padding-right:12.0pt;"><span id="A4.T8.5.1.3.1" class="ltx_text ltx_font_bold">Time*</span></td></tr>
