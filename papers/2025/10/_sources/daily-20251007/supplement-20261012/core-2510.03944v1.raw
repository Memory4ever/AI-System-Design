<td id="S4.T3.7.2.10" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#FFCFCF;"><span id="S4.T3.7.2.10.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#FFCFCF;">0.6</span></td>
<td id="S4.T3.7.2.11" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#FFCECE;"><span id="S4.T3.7.2.11.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#FFCECE;">0.4</span></td>
<td id="S4.T3.7.2.12" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#FFCDCD;"><span id="S4.T3.7.2.12.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-bg-color:#FFCDCD;">0.2</span></td></tr>
<tr id="S4.T3.7.3" class="ltx_tr">
<td id="S4.T3.7.3.1" class="ltx_td ltx_align_left ltx_border_r"><span id="S4.T3.7.3.1.1" class="ltx_text" style="font-size:80%;">@ 0.2</span></td>
<td id="S4.T3.7.3.2" class="ltx_td ltx_align_center ltx_border_r" style="--ltx-bg-color:#FFCFCF;"><span id="S4.T3.7.3.2.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#FFCFCF;">0.5</span></td>
