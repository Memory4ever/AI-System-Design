<td id="A4.T8.5.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:12.0pt;padding-right:12.0pt;"><math id="A4.T8.m6" class="ltx_Math" alttext="2.20\times 10^{-3}" display="inline" intent=":literal"><semantics><mrow><mn>2.20</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>3</mn></mrow></msup></mrow><annotation encoding="application/x-tex">2.20\times 10^{-3}</annotation></semantics></math></td></tr>
