<td id="S2.T1.5.1.18.1" class="ltx_td ltx_align_left ltx_border_t" rowspan="4"><span id="S2.T1.5.1.18.1.1" class="ltx_text">Privacy &amp; Regulatory</span></td>
<td id="S2.T1.5.1.18.2" class="ltx_td ltx_align_left ltx_border_t">HIPAA violations: embedding leakage</td>
<td id="S2.T1.5.1.18.3" class="ltx_td ltx_align_left ltx_border_t">No formal privacy guarantees</td>
<td id="S2.T1.5.1.18.4" class="ltx_td ltx_align_left ltx_border_t"><math id="S2.T1.m2" class="ltx_Math" alttext="(\epsilon,\delta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\epsilon,\delta)</annotation></semantics></math>-DP with <math id="S2.T1.m3" class="ltx_Math" alttext="\epsilon&lt;2.3" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&lt;</mo><mn>2.3</mn></mrow><annotation encoding="application/x-tex">\epsilon&lt;2.3</annotation></semantics></math></td>
<td id="S2.T1.5.1.18.5" class="ltx_td ltx_align_left ltx_border_t">Regulatory compliance</td></tr>
