="#000000" stroke="#000000" transform="matrix(1 0 0 -1 25.7 0) translate(47.48,0) matrix(1.0 0.0 0.0 1.0 -44.71 -3.29)"><foreignObject style="--ltx-fo-width:7.01em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="89.77"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F3.pic2.5" class="ltx_text" style="font-size:90%;">Adaptive AFFL</span></span></span></foreignObject></g></g></g></g></g></g></g></svg></span></div></div>
