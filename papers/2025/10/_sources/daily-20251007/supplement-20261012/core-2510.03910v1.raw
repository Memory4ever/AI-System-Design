<td id="S4.T2.2.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">8 (53%)</td>
<td id="S4.T2.2.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">15 (100%)</td>
<td id="S4.T2.2.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">15 (100%)</td></tr>
