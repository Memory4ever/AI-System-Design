<td id="S4.T2.2.3.2" class="ltx_td ltx_align_center ltx_border_r">13 (87%)</td>
<td id="S4.T2.2.3.3" class="ltx_td ltx_align_center ltx_border_r">11 (73%)</td>
<td id="S4.T2.2.3.4" class="ltx_td ltx_align_center ltx_border_r">13 (87%)</td></tr>
