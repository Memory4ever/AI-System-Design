<tr id="A1.T5.2.4" class="ltx_tr">
<th id="A1.T5.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T5.m3" class="ltx_Math" alttext="\epsilon,\delta" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>,</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">\epsilon,\delta</annotation></semantics></math></th>
