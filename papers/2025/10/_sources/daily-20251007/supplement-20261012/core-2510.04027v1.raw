<td id="S2.T1.2.1.4.3" class="ltx_td ltx_align_center ltx_border_bb"><math id="S2.T1.m11" class="ltx_Math" alttext="nc^{\dagger}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>c</mi><mo>†</mo></msup></mrow><annotation encoding="application/x-tex">nc^{\dagger}</annotation></semantics></math></td>
<td id="S2.T1.2.1.4.4" class="ltx_td ltx_align_center ltx_border_bb"><math id="S2.T1.m12" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math></td>
<td id="S2.T1.2.1.4.5" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#E5FFE5;"><math id="S2.T1.m13" class="ltx_Math" style="--ltx-bg-color:#E5FFE5;" alttext="1" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#E5FFE5;" mathbackground="#E5FFE5">1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math></td></tr>
</tbody>
</table>
</span></div></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<p id="S2.T1.3" class="ltx_p ltx_align_left ltx_figure_panel"><math id="S2.T1.m14" class="ltx_Math" alttext="\dagger" display="inline" intent=":literal"><semantics><mo mathsize="0.900em">†</mo><annotation encoding="application/x-tex">\dagger</annotation></semantics></math><span id="S2.T1.3.1" class="ltx_text" style="font-size:90%;">: we note that it may depend on the implementation algorithm.</span></p></div></div>
