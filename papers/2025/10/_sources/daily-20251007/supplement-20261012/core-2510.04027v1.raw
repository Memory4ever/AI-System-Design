<td id="S5.T3.4.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T3.4.1.2.4.1" class="ltx_text ltx_font_bold">0.673<math id="S5.T3.m3" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math></span>0.033</td>
