<th id="A1.T5.2.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_tt" colspan="2"><span id="A1.T5.2.1.1.1" class="ltx_text ltx_font_bold">Differential Privacy</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A1.T5.2.2" class="ltx_tr">
<th id="A1.T5.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T5.m1" class="ltx_Math" alttext="\mathcal{M}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℳ</mi><annotation encoding="application/x-tex">\mathcal{M}</annotation></semantics></math></th>
