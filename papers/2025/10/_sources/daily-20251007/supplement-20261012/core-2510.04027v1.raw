<td id="S2.T1.2.1.3.4" class="ltx_td ltx_align_center"><math id="S2.T1.m9" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math></td>
<td id="S2.T1.2.1.3.5" class="ltx_td ltx_align_center" style="--ltx-bg-color:#E5FFE5;"><math id="S2.T1.m10" class="ltx_Math" style="--ltx-bg-color:#E5FFE5;" alttext="c" display="inline" intent=":literal"><semantics><mi style="--ltx-bg-color:#E5FFE5;" mathbackground="#E5FFE5">c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math></td></tr>
