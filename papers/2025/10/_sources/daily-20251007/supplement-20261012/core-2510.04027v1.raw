<td id="A1.T5.2.9.2" class="ltx_td ltx_align_left"># of samples</td></tr>
<tr id="A1.T5.2.10" class="ltx_tr">
<th id="A1.T5.2.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T5.m10" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math></th>
<td id="A1.T5.2.10.2" class="ltx_td ltx_align_left">feature dimension</td></tr>
<tr id="A1.T5.2.11" class="ltx_tr">
<th id="A1.T5.2.11.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T5.m11" class="ltx_Math" alttext="\mathbf{x}_{i}\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><mi>i</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathbf{x}_{i}\in\mathbb{R}^{d}</annotation></semantics></math></th>
<td id="A1.T5.2.11.2" class="ltx_td ltx_align_left">feature vector</td></tr>
<tr id="A1.T5.2.12" class="ltx_tr">
<th id="A1.T5.2.12.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T5.m12" class="ltx_Math" alttext="\mathbf{w}\in\mathbb{R}^{d\times c}" display="inline" intent=":literal"><semantics><mrow><mi>𝐰</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>c</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{w}\in\mathbb{R}^{d\times c}</annotation></semantics></math></th>
<td id="A1.T5.2.12.2" class="ltx_td ltx_align_left">flattened weight vector</td></tr>
<tr id="A1.T5.2.13" class="ltx_tr">
<th id="A1.T5.2.13.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T5.m13" class="ltx_Math" alttext="b\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">b\in\mathbb{R}</annotation></semantics></math></th>
<td id="A1.T5.2.13.2" class="ltx_td ltx_align_left">bias term</td></tr>
<tr id="A1.T5.2.14" class="ltx_tr">
<th id="A1.T5.2.14.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T5.m14" class="ltx_Math" alttext="\xi_{i}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>ξ</mi><mi>i</mi></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\xi_{i}\geq 0</annotation></semantics></math></th>
<td id="A1.T5.2.14.2" class="ltx_td ltx_align_left">slack variable</td></tr>
<tr id="A1.T5.2.15" class="ltx_tr">
<th id="A1.T5.2.15.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T5.m15" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math></th>
<td id="A1.T5.2.15.2" class="ltx_td ltx_align_left">regularization parameter</td></tr>
<tr id="A1.T5.2.16" class="ltx_tr">
<th id="A1.T5.2.16.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T5.m16" class="ltx_Math" alttext="{\bm{\alpha}}" display="inline" intent=":literal"><semantics><mi>𝜶</mi><annotation encoding="application/x-tex">{\bm{\alpha}}</annotation></semantics></math></th>
<td id="A1.T5.2.16.2" class="ltx_td ltx_align_left">dual variables</td></tr>
<tr id="A1.T5.2.17" class="ltx_tr">
<th id="A1.T5.2.17.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T5.m17" class="ltx_Math" alttext="f(\mathbf{x})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(\mathbf{x})</annotation></semantics></math></th>
<td id="A1.T5.2.17.2" class="ltx_td ltx_align_left">decision function</td></tr>
<tr id="A1.T5.2.18" class="ltx_tr">
<th id="A1.T5.2.18.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T5.m18" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math></th>
<td id="A1.T5.2.18.2" class="ltx_td ltx_align_left"># of classes</td></tr>
<tr id="A1.T5.2.19" class="ltx_tr">
<th id="A1.T5.2.19.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T5.m19" class="ltx_Math" alttext="\mathbf{w}_{k}\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐰</mi><mi>k</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathbf{w}_{k}\in\mathbb{R}^{d}</annotation></semantics></math>, <math id="A1.T5.m20" class="ltx_Math" alttext="b_{k}\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mi>k</mi></msub><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">b_{k}\in\mathbb{R}</annotation></semantics></math></th>
<td id="A1.T5.2.19.2" class="ltx_td ltx_align_left">class–wise weight &amp; bias</td></tr>
<tr id="A1.T5.2.20" class="ltx_tr">
<th id="A1.T5.2.20.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T5.m21" class="ltx_Math" alttext="W=[\mathbf{w}_{1},\dots,\mathbf{w}_{c}]\in\mathbb{R}^{d\times c}" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝐰</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝐰</mi><mi>c</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>c</mi></mrow></msup></mrow><annotation encoding="application/x-tex">W=[\mathbf{w}_{1},\dots,\mathbf{w}_{c}]\in\mathbb{R}^{d\times c}</annotation></semantics></math></th>
<td id="A1.T5.2.20.2" class="ltx_td ltx_align_left">weight matrix</td></tr>
<tr id="A1.T5.2.21" class="ltx_tr">
<th id="A1.T5.2.21.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T5.m22" class="ltx_Math" alttext="\mathbf{b}=[b_{1},\dots,b_{c}]^{\top}\in\mathbb{R}^{c}" display="inline" intent=":literal"><semantics><mrow><mi>𝐛</mi><mo>=</mo><msup><mrow><mo stretchy="false">[</mo><mrow><msub><mi>b</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>b</mi><mi>c</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mo>⊤</mo></msup><mo>∈</mo><msup><mi>ℝ</mi><mi>c</mi></msup></mrow><annotation encoding="application/x-tex">\mathbf{b}=[b_{1},\dots,b_{c}]^{\top}\in\mathbb{R}^{c}</annotation></semantics></math></th>
<td id="A1.T5.2.21.2" class="ltx_td ltx_align_left">bias vector</td></tr>
<tr id="A1.T5.2.22" class="ltx_tr">
<th id="A1.T5.2.22.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T5.m23" class="ltx_Math" alttext="\alpha_{i,p}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow></msub><annotation encoding="application/x-tex">\alpha_{i,p}</annotation></semantics></math></th>
<td id="A1.T5.2.22.2" class="ltx_td ltx_align_left">dual var for sample <math id="A1.T5.m24" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, class <math id="A1.T5.m25" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math></td></tr>
<tr id="A1.T5.2.23" class="ltx_tr">
<th id="A1.T5.2.23.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T5.m26" class="ltx_Math" alttext="P_{y_{i}}=Y\setminus\{y_{i}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><msub><mi>y</mi><mi>i</mi></msub></msub><mo>=</mo><mrow><mi>Y</mi><mo>∖</mo><mrow><mo stretchy="false">{</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P_{y_{i}}=Y\setminus\{y_{i}\}</annotation></semantics></math></th>
<td id="A1.T5.2.23.2" class="ltx_td ltx_align_left">non–true class indices</td></tr>
<tr id="A1.T5.2.24" class="ltx_tr">
<th id="A1.T5.2.24.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T5.m27" class="ltx_Math" alttext="\nu_{y_{i},p,k}=e_{y_{i},k}-e_{p,k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ν</mi><mrow><msub><mi>y</mi><mi>i</mi></msub><mo>,</mo><mi>p</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>=</mo><mrow><msub><mi>e</mi><mrow><msub><mi>y</mi><mi>i</mi></msub><mo>,</mo><mi>k</mi></mrow></msub><mo>−</mo><msub><mi>e</mi><mrow><mi>p</mi><mo>,</mo><mi>k</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\nu_{y_{i},p,k}=e_{y_{i},k}-e_{p,k}</annotation></semantics></math></th>
<td id="A1.T5.2.24.2" class="ltx_td ltx_align_left">encoding vector</td></tr>
<tr id="A1.T5.2.25" class="ltx_tr">
<th id="A1.T5.2.25.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-bottom: 6.0pt;"><math id="A1.T5.m28" class="ltx_Math" alttext="M_{y_{i},p,y_{j},q}=\sum_{k=1}^{c}\nu_{y_{i},p,k}\,\nu_{y_{j},q,k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mrow><msub><mi>y</mi><mi>i</mi></msub><mo>,</mo><mi>p</mi><mo>,</mo><msub><mi>y</mi><mi>j</mi></msub><mo>,</mo><mi>q</mi></mrow></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>c</mi></msubsup><mrow><msub><mi>ν</mi><mrow><msub><mi>y</mi><mi>i</mi></msub><mo>,</mo><mi>p</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mrow><msub><mi>y</mi><mi>j</mi></msub><mo>,</mo><mi>q</mi><mo>,</mo><mi>k</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">M_{y_{i},p,y_{j},q}=\sum_{k=1}^{c}\nu_{y_{i},p,k}\,\nu_{y_{j},q,k}</annotation></semantics></math></th>
<td id="A1.T5.2.25.2" class="ltx_td ltx_align_left" style="padding-bottom: 6.0pt;">interaction matrix</td></tr>
<tr id="A1.T5.2.26" class="ltx_tr">
<th id="A1.T5.2.26.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" colspan="2"><span id="A1.T5.2.26.1.1" class="ltx_text ltx_font_bold">Methodology</span></th></tr>
<tr id="A1.T5.2.27" class="ltx_tr">
<th id="A1.T5.2.27.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T5.m29" class="ltx_Math" alttext="\tilde{\mathbf{w}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbf{w}}</annotation></semantics></math></th>
<td id="A1.T5.2.27.2" class="ltx_td ltx_align_left">optimal primal weight</td></tr>
<tr id="A1.T5.2.28" class="ltx_tr">
<th id="A1.T5.2.28.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T5.m30" class="ltx_Math" alttext="\hat{\mathbf{w}}=\tilde{\mathbf{w}}+\mathbf{z},\mathbf{z}\sim\mathcal{N}(0,\sigma_{\mathbf{w}}^{2}I)" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>𝐰</mi><mo>^</mo></mover><mo>=</mo><mrow><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>+</mo><mi>𝐳</mi></mrow></mrow><mo>,</mo><mrow><mi>𝐳</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><msubsup><mi>σ</mi><mi>𝐰</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\mathbf{w}}=\tilde{\mathbf{w}}+\mathbf{z},\mathbf{z}\sim\mathcal{N}(0,\sigma_{\mathbf{w}}^{2}I)</annotation></semantics></math></th>
<td id="A1.T5.2.28.2" class="ltx_td ltx_align_left">noisy weight</td></tr>
<tr id="A1.T5.2.29" class="ltx_tr">
<th id="A1.T5.2.29.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T5.m31" class="ltx_Math" alttext="G_{pq}=\langle\nu_{y,p},\nu_{y,q}\rangle" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>=</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>ν</mi><mrow><mi>y</mi><mo>,</mo><mi>p</mi></mrow></msub><mo>,</mo><msub><mi>ν</mi><mrow><mi>y</mi><mo>,</mo><mi>q</mi></mrow></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">G_{pq}=\langle\nu_{y,p},\nu_{y,q}\rangle</annotation></semantics></math></th>
<td id="A1.T5.2.29.2" class="ltx_td ltx_align_left">Gram matrix</td></tr>
<tr id="A1.T5.2.30" class="ltx_tr">
<th id="A1.T5.2.30.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T5.m32" class="ltx_Math" alttext="\lambda,\lambda_{\max}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>,</mo><msub><mi>λ</mi><mi>max</mi></msub></mrow><annotation encoding="application/x-tex">\lambda,\lambda_{\max}</annotation></semantics></math></th>
<td id="A1.T5.2.30.2" class="ltx_td ltx_align_left">convexity, top eigenvalue</td></tr>
<tr id="A1.T5.2.31" class="ltx_tr">
<th id="A1.T5.2.31.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T5.m33" class="ltx_Math" alttext="\eta_{t}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\eta_{t}</annotation></semantics></math></th>
<td id="A1.T5.2.31.2" class="ltx_td ltx_align_left">learning rate</td></tr>
<tr id="A1.T5.2.32" class="ltx_tr">
<th id="A1.T5.2.32.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T5.m34" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math></th>
<td id="A1.T5.2.32.2" class="ltx_td ltx_align_left">clipping norm bound</td></tr>
<tr id="A1.T5.2.33" class="ltx_tr">
<th id="A1.T5.2.33.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T5.m35" class="ltx_Math" alttext="\sigma\geq c_{2}\frac{q\sqrt{T\ln(1/\delta)}}{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>≥</mo><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt></mrow><mi>ϵ</mi></mfrac></mrow></mrow><annotation encoding="application/x-tex">\sigma\geq c_{2}\frac{q\sqrt{T\ln(1/\delta)}}{\epsilon}</annotation></semantics></math></th>
<td id="A1.T5.2.33.2" class="ltx_td ltx_align_left">noise scale (moments accountant)</td></tr>
<tr id="A1.T5.2.34" class="ltx_tr">
<th id="A1.T5.2.34.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T5.m36" class="ltx_Math" alttext="\gamma_{ik}=1-\bigl(\mathbf{w}_{y_{i}}^{\top}x_{i}+b_{y_{i}}-\mathbf{w}_{k}^{\top}x_{i}-b_{k}\bigr)" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mrow><msubsup><mi>𝐰</mi><msub><mi>y</mi><mi>i</mi></msub><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>i</mi></msub></mrow><mo>+</mo><msub><mi>b</mi><msub><mi>y</mi><mi>i</mi></msub></msub></mrow><mo>−</mo><mrow><msubsup><mi>𝐰</mi><mi>k</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>i</mi></msub></mrow><mo>−</mo><msub><mi>b</mi><mi>k</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\gamma_{ik}=1-\bigl(\mathbf{w}_{y_{i}}^{\top}x_{i}+b_{y_{i}}-\mathbf{w}_{k}^{\top}x_{i}-b_{k}\bigr)</annotation></semantics></math></th>
<td id="A1.T5.2.34.2" class="ltx_td ltx_align_left">margin violation</td></tr>
<tr id="A1.T5.2.35" class="ltx_tr">
<th id="A1.T5.2.35.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T5.m37" class="ltx_Math" alttext="\varsigma" display="inline" intent=":literal"><semantics><mi>ς</mi><annotation encoding="application/x-tex">\varsigma</annotation></semantics></math></th>
<td id="A1.T5.2.35.2" class="ltx_td ltx_align_left">smoothing parameter</td></tr>
<tr id="A1.T5.2.36" class="ltx_tr">
<th id="A1.T5.2.36.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T5.m38" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math></th>
<td id="A1.T5.2.36.2" class="ltx_td ltx_align_left">sampling prob. in minibatch</td></tr>
<tr id="A1.T5.2.37" class="ltx_tr">
<th id="A1.T5.2.37.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T5.m39" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math></th>
<td id="A1.T5.2.37.2" class="ltx_td ltx_align_left">total update steps</td></tr>
<tr id="A1.T5.2.38" class="ltx_tr">
<th id="A1.T5.2.38.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><math id="A1.T5.m40" class="ltx_Math" alttext="\tau\in(0,1]" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\tau\in(0,1]</annotation></semantics></math></th>
<td id="A1.T5.2.38.2" class="ltx_td ltx_align_left ltx_border_bb">noise scaling factor</td></tr>
</tbody>
</table>
</figure>
</section>
<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Proofs</h2>

<section id="A2.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.1 </span>Proof of Theorem <a href="#Thmtheorem1" title="Theorem 1 (DP guarantee of weight perturbation). ‣ 3.2 Weight Perturbation for All-in-one PMSVM ‣ 3 Differentially Private Multi-Class SVM ‣ Multi-Class Support Vector Machine with Differential Privacy" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a></h3>

<div id="A2.SS1.p1" class="ltx_para">
<p id="A2.SS1.p1.1" class="ltx_p"><span id="A2.SS1.p1.1.1" class="ltx_text ltx_font_bold">(Restated) Lemma <a href="#Thmlemma1" title="Lemma 1. ‣ 3.2 Weight Perturbation for All-in-one PMSVM ‣ 3 Differentially Private Multi-Class SVM ‣ Multi-Class Support Vector Machine with Differential Privacy" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.</span>
For a convex function <math id="A2.SS1.p1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, a dataset <math id="A2.SS1.p1.m2" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>, and input scaler <math id="A2.SS1.p1.m3" class="ltx_Math" alttext="g(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g(\cdot)</annotation></semantics></math>, let <math id="A2.SS1.p1.m4" class="ltx_Math" alttext="\tilde{{\mathbf{w}}}_{D}=\sum_{i=1}^{n}\tilde{\alpha}_{i}g({\mathbf{x}}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mi>D</mi></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mrow><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{{\mathbf{w}}}_{D}=\sum_{i=1}^{n}\tilde{\alpha}_{i}g({\mathbf{x}}_{i})</annotation></semantics></math>, where <math id="A2.SS1.p1.m5" class="ltx_Math" alttext="(\tilde{\alpha}_{1},\ldots,\tilde{\alpha}_{n})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\tilde{\alpha}_{1},\ldots,\tilde{\alpha}_{n})</annotation></semantics></math> is the solution to:</p>
</div>
<div id="A2.SS1.p2" class="ltx_para">
<table id="A2.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex8.m1" class="ltx_Math" alttext="\min_{\bm{\alpha}}\left(\frac{1}{2}\sum_{i,p}\sum_{j,q}\sum_{k}\alpha_{i,p}\alpha_{j,q}\nu_{y_{i},p}\nu_{y_{j},q}g({\mathbf{x}}_{i})^{T}g({\mathbf{x}}_{j})+\sum_{i,p}T(-\alpha_{i,p})\right)" display="block" intent=":literal"><semantics><mrow><munder><mi>min</mi><mi>𝜶</mi></munder><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow></munder><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>j</mi><mo>,</mo><mi>q</mi></mrow></munder><mrow><munder><mo movablelimits="false">∑</mo><mi>k</mi></munder><mrow><msub><mi>α</mi><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mrow><mi>j</mi><mo>,</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mrow><msub><mi>y</mi><mi>i</mi></msub><mo>,</mo><mi>p</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mrow><msub><mi>y</mi><mi>j</mi></msub><mo>,</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo rspace="0.055em">+</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow></munder><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><msub><mi>α</mi><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\min_{\bm{\alpha}}\left(\frac{1}{2}\sum_{i,p}\sum_{j,q}\sum_{k}\alpha_{i,p}\alpha_{j,q}\nu_{y_{i},p}\nu_{y_{j},q}g({\mathbf{x}}_{i})^{T}g({\mathbf{x}}_{j})+\sum_{i,p}T(-\alpha_{i,p})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS1.p3" class="ltx_para">
<p id="A2.SS1.p3.1" class="ltx_p">Let <math id="A2.SS1.p3.m1" class="ltx_Math" alttext="D^{n}" display="inline" intent=":literal"><semantics><msup><mi>D</mi><mi>n</mi></msup><annotation encoding="application/x-tex">D^{n}</annotation></semantics></math> be <math id="A2.SS1.p3.m2" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> with the <math id="A2.SS1.p3.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-th point <math id="A2.SS1.p3.m4" class="ltx_Math" alttext="{\mathbf{x}}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mi>n</mi></msub><annotation encoding="application/x-tex">{\mathbf{x}}_{n}</annotation></semantics></math> removed, and let <math id="A2.SS1.p3.m5" class="ltx_Math" alttext="\tilde{{\mathbf{w}}}_{D^{n}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><msup><mi>D</mi><mi>n</mi></msup></msub><annotation encoding="application/x-tex">\tilde{{\mathbf{w}}}_{D^{n}}</annotation></semantics></math> be defined similarly. Then the difference of the weights between original and leave-one-out SVMs is bounded as:</p>
<table id="A2.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex9.m1" class="ltx_Math" alttext="\sum_{k=1}^{c}||{\mathbf{w}}_{k}^{[n]}-{\mathbf{w}}_{k}||^{2}\leq\lambda_{\max}(G)\|\tilde{\alpha}_{n}\|^{2}||g({\mathbf{x}}_{n})||^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>c</mi></munderover><msup><mrow><mo lspace="0em" stretchy="false">‖</mo><mrow><msubsup><mi>𝐰</mi><mi>k</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msubsup><mo>−</mo><msub><mi>𝐰</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>≤</mo><mrow><msub><mi>λ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>n</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{k=1}^{c}||{\mathbf{w}}_{k}^{[n]}-{\mathbf{w}}_{k}||^{2}\leq\lambda_{\max}(G)\|\tilde{\alpha}_{n}\|^{2}||g({\mathbf{x}}_{n})||^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS1.p4" class="ltx_para">
<p id="A2.SS1.p4.1" class="ltx_p"><span id="A2.SS1.p4.1.1" class="ltx_text">Let <math id="A2.SS1.p4.m1" class="ltx_Math" alttext="\tilde{\alpha}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>α</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\alpha}</annotation></semantics></math> be the solution of Equation <a href="#S3.E10" title="In 3.2 Weight Perturbation for All-in-one PMSVM ‣ 3 Differentially Private Multi-Class SVM ‣ Multi-Class Support Vector Machine with Differential Privacy" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>, and <math id="A2.SS1.p4.m2" class="ltx_Math" alttext="\tilde{\alpha}^{[n]}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msup><annotation encoding="application/x-tex">\tilde{\alpha}^{[n]}</annotation></semantics></math> be the solution of Equation <a href="#S3.E10" title="In 3.2 Weight Perturbation for All-in-one PMSVM ‣ 3 Differentially Private Multi-Class SVM ‣ Multi-Class Support Vector Machine with Differential Privacy" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>, when <math id="A2.SS1.p4.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-th training element removed (WLOG). Then, following the proof of <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib19" title="" class="ltx_ref">Zhang [19]</a></cite>, taking a subgradient of <math id="A2.SS1.p4.m4" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> at <math id="A2.SS1.p4.m5" class="ltx_Math" alttext="\tilde{\alpha}_{i,p}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow></msub><annotation encoding="application/x-tex">\tilde{\alpha}_{i,p}</annotation></semantics></math> with respect to <math id="A2.SS1.p4.m6" class="ltx_Math" alttext="\alpha_{i,p}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow></msub><annotation encoding="application/x-tex">\alpha_{i,p}</annotation></semantics></math>, the following first-order optimality condition holds:</span></p>
<table id="A2.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E17.m1" class="ltx_Math" alttext="\displaystyle-\nabla_{1}T(-\tilde{\alpha}_{i,p})+\sum_{j,q}M_{y_{i},p,y_{j},q}\,\mathbf{x}_{i}^{\top}\mathbf{x}_{j}\,\alpha_{j,q}=0\quad\forall i\leq n,p\in P_{y_{i}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo rspace="0.167em">−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mn>1</mn></msub><mi>T</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>,</mo><mi>q</mi></mrow></munder></mstyle><mrow><msub><mi>M</mi><mrow><msub><mi>y</mi><mi>i</mi></msub><mo>,</mo><mi>p</mi><mo>,</mo><msub><mi>y</mi><mi>j</mi></msub><mo>,</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mrow><mi>j</mi><mo>,</mo><mi>q</mi></mrow></msub></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mspace style="width:1.167em;" width="1.167em"></mspace><mrow><mrow><mo rspace="0.167em">∀</mo><mi>i</mi></mrow><mo>≤</mo><mi>n</mi></mrow><mo>,</mo><mrow><mi>p</mi><mo>∈</mo><msub><mi>P</mi><msub><mi>y</mi><mi>i</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\nabla_{1}T(-\tilde{\alpha}_{i,p})+\sum_{j,q}M_{y_{i},p,y_{j},q}\,\mathbf{x}_{i}^{\top}\mathbf{x}_{j}\,\alpha_{j,q}=0\quad\forall i\leq n,p\in P_{y_{i}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p4.2" class="ltx_p"><span id="A2.SS1.p4.2.1" class="ltx_text">Multiply <math id="A2.SS1.p4.m7" class="ltx_Math" alttext="(\tilde{\alpha}^{[n]}_{i,p}-\tilde{\alpha}_{i,p})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msubsup><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\tilde{\alpha}^{[n]}_{i,p}-\tilde{\alpha}_{i,p})</annotation></semantics></math> to the equation:</span></p>
<table id="A2.EGx2" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E18.m1" class="ltx_Math" alttext="\displaystyle-\nabla_{1}T(-\tilde{\alpha}_{i,p})(\tilde{\alpha}^{[n]}_{i,p}-\tilde{\alpha}_{i,p})+\sum_{j,q}M_{y_{i},p,y_{j},q}\,\mathbf{x}_{i}^{\top}\mathbf{x}_{j}\,\alpha_{j,q}(\tilde{\alpha}^{[n]}_{i,p}-\tilde{\alpha}_{i,p})=0\quad\forall i\leq n-1,p\in P_{y_{i}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo rspace="0.167em">−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mn>1</mn></msub><mi>T</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msubsup><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>,</mo><mi>q</mi></mrow></munder></mstyle><mrow><msub><mi>M</mi><mrow><msub><mi>y</mi><mi>i</mi></msub><mo>,</mo><mi>p</mi><mo>,</mo><msub><mi>y</mi><mi>j</mi></msub><mo>,</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mrow><mi>j</mi><mo>,</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msubsup><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mspace style="width:1.167em;" width="1.167em"></mspace><mrow><mrow><mo rspace="0.167em">∀</mo><mi>i</mi></mrow><mo>≤</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo>,</mo><mrow><mi>p</mi><mo>∈</mo><msub><mi>P</mi><msub><mi>y</mi><mi>i</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\nabla_{1}T(-\tilde{\alpha}_{i,p})(\tilde{\alpha}^{[n]}_{i,p}-\tilde{\alpha}_{i,p})+\sum_{j,q}M_{y_{i},p,y_{j},q}\,\mathbf{x}_{i}^{\top}\mathbf{x}_{j}\,\alpha_{j,q}(\tilde{\alpha}^{[n]}_{i,p}-\tilde{\alpha}_{i,p})=0\quad\forall i\leq n-1,p\in P_{y_{i}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p4.3" class="ltx_p"><span id="A2.SS1.p4.3.1" class="ltx_text">By the definition of subgradient, we have</span></p>
<table id="A2.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E19.m1" class="ltx_Math" alttext="\displaystyle-\nabla_{1}T(-\tilde{\alpha}_{i,p})(\tilde{\alpha}^{[n]}_{i,p}-\tilde{\alpha}_{i,p})\leq T(-\tilde{\alpha}^{[n]}_{i,p})-T(-\tilde{\alpha}_{i,p})" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mn>1</mn></msub><mi>T</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msubsup><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\nabla_{1}T(-\tilde{\alpha}_{i,p})(\tilde{\alpha}^{[n]}_{i,p}-\tilde{\alpha}_{i,p})\leq T(-\tilde{\alpha}^{[n]}_{i,p})-T(-\tilde{\alpha}_{i,p})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p4.4" class="ltx_p"><span id="A2.SS1.p4.4.1" class="ltx_text">Therefore, we can get</span></p>
<table id="A2.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E20.m1" class="ltx_Math" alttext="\displaystyle T(-\tilde{\alpha}_{i})-\sum_{j,q}M_{y_{i},p,y_{j},q}\,\mathbf{x}_{i}^{\top}\mathbf{x}_{j}\,\alpha_{j,q}(\tilde{\alpha}^{[n]}_{i,p}-\tilde{\alpha}_{i,p})\leq T(-\tilde{\alpha}^{[n]}_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>,</mo><mi>q</mi></mrow></munder></mstyle><mrow><msub><mi>M</mi><mrow><msub><mi>y</mi><mi>i</mi></msub><mo>,</mo><mi>p</mi><mo>,</mo><msub><mi>y</mi><mi>j</mi></msub><mo>,</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mrow><mi>j</mi><mo>,</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msubsup><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>≤</mo><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle T(-\tilde{\alpha}_{i})-\sum_{j,q}M_{y_{i},p,y_{j},q}\,\mathbf{x}_{i}^{\top}\mathbf{x}_{j}\,\alpha_{j,q}(\tilde{\alpha}^{[n]}_{i,p}-\tilde{\alpha}_{i,p})\leq T(-\tilde{\alpha}^{[n]}_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p4.5" class="ltx_p"><span id="A2.SS1.p4.5.1" class="ltx_text">Then, taking summation over <math id="A2.SS1.p4.m8" class="ltx_Math" alttext="i,p" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">i,p</annotation></semantics></math>:</span></p>
<table id="A2.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E21.m1" class="ltx_Math" alttext="\displaystyle\sum_{i,p}^{n-1}\left[T(-\tilde{\alpha}_{i})-\sum_{j,q}M_{y_{i},p,y_{j},q}\,\mathbf{x}_{i}^{\top}\mathbf{x}_{j}\,\tilde{\alpha}_{j,q}^{n}(\tilde{\alpha}^{[n]}_{i,p}-\tilde{\alpha}_{i,p})\right]+\frac{1}{2}\sum_{i,p}^{n-1}\sum_{j,q}^{n-1}M_{y_{i},p,y_{j},q}\,\mathbf{x}_{i}^{\top}\mathbf{x}_{j}\,\tilde{\alpha}^{[n]}_{i,p}\tilde{\alpha}_{j,q}^{[n]}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo>[</mo><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>,</mo><mi>q</mi></mrow></munder></mstyle><mrow><msub><mi>M</mi><mrow><msub><mi>y</mi><mi>i</mi></msub><mo>,</mo><mi>p</mi><mo>,</mo><msub><mi>y</mi><mi>j</mi></msub><mo>,</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>j</mi><mo>,</mo><mi>q</mi></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msubsup><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>,</mo><mi>q</mi></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>M</mi><mrow><msub><mi>y</mi><mi>i</mi></msub><mo>,</mo><mi>p</mi><mo>,</mo><msub><mi>y</mi><mi>j</mi></msub><mo>,</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>j</mi><mo>,</mo><mi>q</mi></mrow><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msubsup></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i,p}^{n-1}\left[T(-\tilde{\alpha}_{i})-\sum_{j,q}M_{y_{i},p,y_{j},q}\,\mathbf{x}_{i}^{\top}\mathbf{x}_{j}\,\tilde{\alpha}_{j,q}^{n}(\tilde{\alpha}^{[n]}_{i,p}-\tilde{\alpha}_{i,p})\right]+\frac{1}{2}\sum_{i,p}^{n-1}\sum_{j,q}^{n-1}M_{y_{i},p,y_{j},q}\,\mathbf{x}_{i}^{\top}\mathbf{x}_{j}\,\tilde{\alpha}^{[n]}_{i,p}\tilde{\alpha}_{j,q}^{[n]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
<tbody id="A2.E22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E22.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{i,p}^{n-1}T(-\tilde{\alpha}^{[n]}_{i})+\frac{1}{2}\sum_{i,p}^{n-1}\sum_{j,q}^{n-1}M_{y_{i},p,y_{j},q}\,\mathbf{x}_{i}^{\top}\mathbf{x}_{j}\,\tilde{\alpha}^{[n]}_{i,p}\tilde{\alpha}_{j,q}^{[n]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>,</mo><mi>q</mi></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>M</mi><mrow><msub><mi>y</mi><mi>i</mi></msub><mo>,</mo><mi>p</mi><mo>,</mo><msub><mi>y</mi><mi>j</mi></msub><mo>,</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>j</mi><mo>,</mo><mi>q</mi></mrow><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msubsup></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{i,p}^{n-1}T(-\tilde{\alpha}^{[n]}_{i})+\frac{1}{2}\sum_{i,p}^{n-1}\sum_{j,q}^{n-1}M_{y_{i},p,y_{j},q}\,\mathbf{x}_{i}^{\top}\mathbf{x}_{j}\,\tilde{\alpha}^{[n]}_{i,p}\tilde{\alpha}_{j,q}^{[n]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
<tbody id="A2.E23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E23.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{i,p}^{n-1}T(-\tilde{\alpha}_{i})+\frac{1}{2}\sum_{i,p}^{n-1}\sum_{j,q}^{n-1}M_{y_{i},p,y_{j},q}\,\mathbf{x}_{i}^{\top}\mathbf{x}_{j}\,\tilde{\alpha}_{i,p}\tilde{\alpha}_{j,q}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>,</mo><mi>q</mi></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>M</mi><mrow><msub><mi>y</mi><mi>i</mi></msub><mo>,</mo><mi>p</mi><mo>,</mo><msub><mi>y</mi><mi>j</mi></msub><mo>,</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>j</mi><mo>,</mo><mi>q</mi></mrow></msub></mrow></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{i,p}^{n-1}T(-\tilde{\alpha}_{i})+\frac{1}{2}\sum_{i,p}^{n-1}\sum_{j,q}^{n-1}M_{y_{i},p,y_{j},q}\,\mathbf{x}_{i}^{\top}\mathbf{x}_{j}\,\tilde{\alpha}_{i,p}\tilde{\alpha}_{j,q}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p4.6" class="ltx_p"><span id="A2.SS1.p4.6.1" class="ltx_text">The second inequality follows from the definition of <math id="A2.SS1.p4.m9" class="ltx_Math" alttext="\tilde{\alpha}^{[n]}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msup><annotation encoding="application/x-tex">\tilde{\alpha}^{[n]}</annotation></semantics></math>, as in the proof of Lemma <a href="#Thmlemma1" title="Lemma 1. ‣ 3.2 Weight Perturbation for All-in-one PMSVM ‣ 3 Differentially Private Multi-Class SVM ‣ Multi-Class Support Vector Machine with Differential Privacy" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.
Note that since the domain of <math id="A2.SS1.p4.m10" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> depends on <math id="A2.SS1.p4.m11" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, we simply notate <math id="A2.SS1.p4.m12" class="ltx_math_unparsed" alttext="\sum_{i=1}^{n-1}\sum_{p\in P_{y_{i}}}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>∑</mo><msub><mrow></mrow><mrow><mi>p</mi><mo>∈</mo><msub><mi>P</mi><msub><mi>y</mi><mi>i</mi></msub></msub></mrow></msub></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{n-1}\sum_{p\in P_{y_{i}}}</annotation></semantics></math> as <math id="A2.SS1.p4.m13" class="ltx_Math" alttext="\sum_{i,p}^{n-1}" display="inline" intent=":literal"><semantics><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msubsup><annotation encoding="application/x-tex">\sum_{i,p}^{n-1}</annotation></semantics></math> and <math id="A2.SS1.p4.m14" class="ltx_math_unparsed" alttext="\sum_{i=1}^{n}\sum_{p\in P_{y_{i}}}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>n</mi></msup><mo>∑</mo><msub><mrow></mrow><mrow><mi>p</mi><mo>∈</mo><msub><mi>P</mi><msub><mi>y</mi><mi>i</mi></msub></msub></mrow></msub></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{n}\sum_{p\in P_{y_{i}}}</annotation></semantics></math> as <math id="A2.SS1.p4.m15" class="ltx_Math" alttext="\sum_{i,p}^{n}" display="inline" intent=":literal"><semantics><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow><mi>n</mi></msubsup><annotation encoding="application/x-tex">\sum_{i,p}^{n}</annotation></semantics></math> (and the same with <math id="A2.SS1.p4.m16" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> and <math id="A2.SS1.p4.m17" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>). Next, denote <math id="A2.SS1.p4.m18" class="ltx_Math" alttext="\tilde{\alpha}^{[n]}_{n,p}=0" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>p</mi></mrow><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msubsup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\tilde{\alpha}^{[n]}_{n,p}=0</annotation></semantics></math>, then,</span></p>
<table id="A2.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E24.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{2}\sum_{i,p}\sum_{j,q}M_{y_{i},p,y_{j},q}\,\mathbf{x}_{i}^{\top}\mathbf{x}_{j}\,(\tilde{\alpha}^{[n]}_{i,p}-\tilde{\alpha}_{i,p})" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>,</mo><mi>q</mi></mrow></munder></mstyle><mrow><msub><mi>M</mi><mrow><msub><mi>y</mi><mi>i</mi></msub><mo>,</mo><mi>p</mi><mo>,</mo><msub><mi>y</mi><mi>j</mi></msub><mo>,</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msubsup><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{2}\sum_{i,p}\sum_{j,q}M_{y_{i},p,y_{j},q}\,\mathbf{x}_{i}^{\top}\mathbf{x}_{j}\,(\tilde{\alpha}^{[n]}_{i,p}-\tilde{\alpha}_{i,p})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E24.m2" class="ltx_Math" alttext="\displaystyle(\tilde{\alpha}^{[n]}_{j,q}-\tilde{\alpha}_{j,q})\leq\frac{1}{2}\sum_{p}\sum_{q}M_{y_{n},p,y_{n},q}\,\mathbf{x}_{n}^{\top}\mathbf{x}_{n}\tilde{\alpha}_{n,p}\tilde{\alpha}_{n,q}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>j</mi><mo>,</mo><mi>q</mi></mrow><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msubsup><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>j</mi><mo>,</mo><mi>q</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>p</mi></munder></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>q</mi></munder></mstyle><mrow><msub><mi>M</mi><mrow><msub><mi>y</mi><mi>n</mi></msub><mo>,</mo><mi>p</mi><mo>,</mo><msub><mi>y</mi><mi>n</mi></msub><mo>,</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>n</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>p</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>q</mi></mrow></msub></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(\tilde{\alpha}^{[n]}_{j,q}-\tilde{\alpha}_{j,q})\leq\frac{1}{2}\sum_{p}\sum_{q}M_{y_{n},p,y_{n},q}\,\mathbf{x}_{n}^{\top}\mathbf{x}_{n}\tilde{\alpha}_{n,p}\tilde{\alpha}_{n,q}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
<tbody id="A2.E25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E25.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E25.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{2}\sum_{p}\sum_{q}\sum_{k=1}^{c}\nu_{y_{n},p,k}\,\nu_{y_{n},q,k}\mathbf{x}_{n}^{\top}\mathbf{x}_{n}\tilde{\alpha}_{n,p}\tilde{\alpha}_{n,q}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>p</mi></munder></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>q</mi></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>c</mi></munderover></mstyle><mrow><msub><mi>ν</mi><mrow><msub><mi>y</mi><mi>n</mi></msub><mo>,</mo><mi>p</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mrow><msub><mi>y</mi><mi>n</mi></msub><mo>,</mo><mi>q</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>n</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>p</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>q</mi></mrow></msub></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{2}\sum_{p}\sum_{q}\sum_{k=1}^{c}\nu_{y_{n},p,k}\,\nu_{y_{n},q,k}\mathbf{x}_{n}^{\top}\mathbf{x}_{n}\tilde{\alpha}_{n,p}\tilde{\alpha}_{n,q}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
<tbody id="A2.E26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E26.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E26.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{2}\mathbf{x}_{n}^{\top}\mathbf{x}_{n}\sum_{p,q}\tilde{\alpha}_{n,p}\tilde{\alpha}_{n,q}\langle\nu_{y_{n},p}\,\nu_{y_{n},q}\rangle" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>n</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow></munder></mstyle><mrow><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>p</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>ν</mi><mrow><msub><mi>y</mi><mi>n</mi></msub><mo>,</mo><mi>p</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mrow><msub><mi>y</mi><mi>n</mi></msub><mo>,</mo><mi>q</mi></mrow></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{2}\mathbf{x}_{n}^{\top}\mathbf{x}_{n}\sum_{p,q}\tilde{\alpha}_{n,p}\tilde{\alpha}_{n,q}\langle\nu_{y_{n},p}\,\nu_{y_{n},q}\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
<tbody id="A2.E27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E27.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E27.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{2}\mathbf{x}_{n}^{\top}\mathbf{x}_{n}\tilde{\alpha}_{n}^{\top}G\tilde{\alpha}_{n}\leq\frac{1}{2}\|\mathbf{x}_{n}\|^{2}\lambda_{\max}(G)\|\tilde{\alpha}_{n}\|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>n</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>n</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>n</mi></msub></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐱</mi><mi>n</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>n</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{2}\mathbf{x}_{n}^{\top}\mathbf{x}_{n}\tilde{\alpha}_{n}^{\top}G\tilde{\alpha}_{n}\leq\frac{1}{2}\|\mathbf{x}_{n}\|^{2}\lambda_{\max}(G)\|\tilde{\alpha}_{n}\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(27)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p4.7" class="ltx_p"><span id="A2.SS1.p4.7.1" class="ltx_text">The last inequality holds because the Gram matrix is PSD.
Therefore,</span></p>
<table id="A2.E28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E28.m1" class="ltx_Math" alttext="\sum_{k=1}^{c}\|{\mathbf{w}}_{k}^{[n]}-{\mathbf{w}}_{k}\|^{2}\leq\lambda_{\max}(G)\|\tilde{\alpha}_{n}\|^{2}\|{\mathbf{x}}_{n}\|^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>c</mi></munderover><msup><mrow><mo lspace="0em" stretchy="false">‖</mo><mrow><msubsup><mi>𝐰</mi><mi>k</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msubsup><mo>−</mo><msub><mi>𝐰</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>≤</mo><mrow><msub><mi>λ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>n</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐱</mi><mi>n</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{k=1}^{c}\|{\mathbf{w}}_{k}^{[n]}-{\mathbf{w}}_{k}\|^{2}\leq\lambda_{\max}(G)\|\tilde{\alpha}_{n}\|^{2}\|{\mathbf{x}}_{n}\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS1.p5" class="ltx_para">
<p id="A2.SS1.p5.1" class="ltx_p"><span id="A2.SS1.p5.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A2.SS1.p6" class="ltx_para">
<p id="A2.SS1.p6.1" class="ltx_p">Using this Lemma, we can calculate the sensitivity of the weights <math id="A2.SS1.p6.m1" class="ltx_Math" alttext="\tilde{{\mathbf{w}}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{{\mathbf{w}}}</annotation></semantics></math> of all-in-one SVMs.</p>
</div>
<div id="A2.SS1.p7" class="ltx_para">
<p id="A2.SS1.p7.1" class="ltx_p"><span id="A2.SS1.p7.1.1" class="ltx_text ltx_font_bold">(Restated) Theorem <a href="#Thmtheorem1" title="Theorem 1 (DP guarantee of weight perturbation). ‣ 3.2 Weight Perturbation for All-in-one PMSVM ‣ 3 Differentially Private Multi-Class SVM ‣ Multi-Class Support Vector Machine with Differential Privacy" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>. </span> (DP guarantee of weight perturbation)
<math id="A2.SS1.p7.m1" class="ltx_Math" alttext="\hat{\mathbf{w}}=\tilde{\mathbf{w}}+{\mathbf{z}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝐰</mi><mo>^</mo></mover><mo>=</mo><mrow><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>+</mo><mi>𝐳</mi></mrow></mrow><annotation encoding="application/x-tex">\hat{\mathbf{w}}=\tilde{\mathbf{w}}+{\mathbf{z}}</annotation></semantics></math> (Definition <a href="#Thmdefinition3" title="Definition 3 (Weight Perturbation). ‣ 3.2 Weight Perturbation for All-in-one PMSVM ‣ 3 Differentially Private Multi-Class SVM ‣ Multi-Class Support Vector Machine with Differential Privacy" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>) satisfies an <math id="A2.SS1.p7.m2" class="ltx_Math" alttext="(\epsilon,\delta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\epsilon,\delta)</annotation></semantics></math>-DP when <math id="A2.SS1.p7.m3" class="ltx_Math" alttext="{\mathbf{z}}\sim\mathcal{N}(0,\sigma_{{\mathbf{w}}}^{2}\mathbf{I})" display="inline" intent=":literal"><semantics><mrow><mi>𝐳</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><msubsup><mi>σ</mi><mi>𝐰</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐈</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{z}}\sim\mathcal{N}(0,\sigma_{{\mathbf{w}}}^{2}\mathbf{I})</annotation></semantics></math>. For <math id="A2.SS1.p7.m4" class="ltx_Math" alttext="\sigma_{W}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>W</mi></msub><annotation encoding="application/x-tex">\sigma_{W}</annotation></semantics></math> in Remark <a href="#S2.E4" title="In Remark 3. ‣ 2.1 Differential Privacy ‣ 2 Backgrounds ‣ Multi-Class Support Vector Machine with Differential Privacy" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, the sensitivity of the all-in-one SVM weight <math id="A2.SS1.p7.m5" class="ltx_Math" alttext="\Delta_{{\mathbf{w}}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mi>𝐰</mi></msub><annotation encoding="application/x-tex">\Delta_{{\mathbf{w}}}</annotation></semantics></math> is:</p>
<table id="A2.E29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E29.m1" class="ltx_Math" alttext="\Delta_{{\mathbf{w}}}=\frac{2C}{n}\,\sqrt{\lambda_{\max}(G)},\qquad G_{pq}=\langle\nu_{y,p},\nu_{y,q}\rangle," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi mathvariant="normal">Δ</mi><mi>𝐰</mi></msub><mo>=</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow><mi>n</mi></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msqrt><mrow><msub><mi>λ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>=</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>ν</mi><mrow><mi>y</mi><mo>,</mo><mi>p</mi></mrow></msub><mo>,</mo><msub><mi>ν</mi><mrow><mi>y</mi><mo>,</mo><mi>q</mi></mrow></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\Delta_{{\mathbf{w}}}=\frac{2C}{n}\,\sqrt{\lambda_{\max}(G)},\qquad G_{pq}=\langle\nu_{y,p},\nu_{y,q}\rangle,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(29)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p7.2" class="ltx_p">where <math id="A2.SS1.p7.m6" class="ltx_Math" alttext="\lambda_{\max}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>max</mi></msub><annotation encoding="application/x-tex">\lambda_{\max}</annotation></semantics></math> is the largest eigenvalue of the Gram matrix <math id="A2.SS1.p7.m7" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, and <math id="A2.SS1.p7.m8" class="ltx_Math" alttext="\nu_{y,q}\in\mathbb{R}^{c}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ν</mi><mrow><mi>y</mi><mo>,</mo><mi>q</mi></mrow></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>c</mi></msup></mrow><annotation encoding="application/x-tex">\nu_{y,q}\in\mathbb{R}^{c}</annotation></semantics></math> is a vector that <math id="A2.SS1.p7.m9" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>th component is <math id="A2.SS1.p7.m10" class="ltx_Math" alttext="\nu_{y,q,k}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mrow><mi>y</mi><mo>,</mo><mi>q</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\nu_{y,q,k}</annotation></semantics></math>.
Moreover, the support function
<math id="A2.SS1.p7.m11" class="ltx_Math" alttext="\hat{f}(\mathbf{x})=\arg\max_{k\in[c]}\bigl\{\,\tilde{\mathbf{w}}_{k}^{\top}{\mathbf{x}}\bigr\}" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><msub><mi>max</mi><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><msubsup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mi>k</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{f}(\mathbf{x})=\arg\max_{k\in[c]}\bigl\{\,\tilde{\mathbf{w}}_{k}^{\top}{\mathbf{x}}\bigr\}</annotation></semantics></math> is also <math id="A2.SS1.p7.m12" class="ltx_Math" alttext="(\epsilon,\delta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\epsilon,\delta)</annotation></semantics></math>-DP.</p>
</div>
<div id="A2.SS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS1.p8" class="ltx_para">
<p id="A2.SS1.p8.1" class="ltx_p"><span id="A2.SS1.p8.1.1" class="ltx_text">Firstly, we need to find the sensitivity of <math id="A2.SS1.p8.m1" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math>.
Let <math id="A2.SS1.p8.m2" class="ltx_Math" alttext="T(-\alpha_{i,p}):=-\alpha_{i,p}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><msub><mi>α</mi><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mo>−</mo><msub><mi>α</mi><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">T(-\alpha_{i,p}):=-\alpha_{i,p}</annotation></semantics></math>, which is affine and therefore convex. Then, by Lemma <a href="#Thmlemma1" title="Lemma 1. ‣ 3.2 Weight Perturbation for All-in-one PMSVM ‣ 3 Differentially Private Multi-Class SVM ‣ Multi-Class Support Vector Machine with Differential Privacy" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, the following inequality holds:</span></p>
<table id="A2.E30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E30.m1" class="ltx_Math" alttext="\sum_{k=1}^{c}\|{\mathbf{w}}_{k}^{[n]}-{\mathbf{w}}_{k}\|^{2}\leq\lambda_{\max}(G)\|\tilde{\alpha}_{n}\|^{2}\|{\mathbf{x}}_{n}\|^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>c</mi></munderover><msup><mrow><mo lspace="0em" stretchy="false">‖</mo><mrow><msubsup><mi>𝐰</mi><mi>k</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msubsup><mo>−</mo><msub><mi>𝐰</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>≤</mo><mrow><msub><mi>λ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>n</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐱</mi><mi>n</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{k=1}^{c}\|{\mathbf{w}}_{k}^{[n]}-{\mathbf{w}}_{k}\|^{2}\leq\lambda_{\max}(G)\|\tilde{\alpha}_{n}\|^{2}\|{\mathbf{x}}_{n}\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(30)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS1.p9" class="ltx_para">
<p id="A2.SS1.p9.1" class="ltx_p"><span id="A2.SS1.p9.1.1" class="ltx_text">For <math id="A2.SS1.p9.m1" class="ltx_Math" alttext="\|{\mathbf{x}}_{n}\|\leq\kappa=\max g({\mathbf{x}})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><msub><mi>𝐱</mi><mi>n</mi></msub><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mi>κ</mi><mo>=</mo><mrow><mi>max</mi><mo lspace="0.167em">⁡</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\|{\mathbf{x}}_{n}\|\leq\kappa=\max g({\mathbf{x}})</annotation></semantics></math>, usually set <math id="A2.SS1.p9.m2" class="ltx_Math" alttext="\kappa=1" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\kappa=1</annotation></semantics></math> with normalization,</span></p>
<table id="A2.E31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E31.m1" class="ltx_Math" alttext="\|W^{[n]}-W\|_{F}\leq\frac{C\kappa}{n}\sqrt{\lambda_{\max}(G)}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>W</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msup><mo>−</mo><mi>W</mi></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>≤</mo><mrow><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><msub><mi>λ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|W^{[n]}-W\|_{F}\leq\frac{C\kappa}{n}\sqrt{\lambda_{\max}(G)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(31)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p9.2" class="ltx_p"><span id="A2.SS1.p9.2.1" class="ltx_text">By triangle inequality,</span></p>
<table id="A2.E32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E32.m1" class="ltx_Math" alttext="\|W_{D^{\prime}}-W_{D}\|_{F}\leq\|W_{D}^{[n]}-W_{D}\|_{F}+\|W_{D^{\prime}}^{[n]}-W_{D^{\prime}}\|_{F}\leq\frac{2C\kappa}{n}\sqrt{\lambda_{\max}(G)}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>W</mi><msup><mi>D</mi><mo>′</mo></msup></msub><mo>−</mo><msub><mi>W</mi><mi>D</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>W</mi><mi>D</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msubsup><mo>−</mo><msub><mi>W</mi><mi>D</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>W</mi><msup><mi>D</mi><mo>′</mo></msup><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msubsup><mo>−</mo><msub><mi>W</mi><msup><mi>D</mi><mo>′</mo></msup></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow><mo>≤</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><msub><mi>λ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|W_{D^{\prime}}-W_{D}\|_{F}\leq\|W_{D}^{[n]}-W_{D}\|_{F}+\|W_{D^{\prime}}^{[n]}-W_{D^{\prime}}\|_{F}\leq\frac{2C\kappa}{n}\sqrt{\lambda_{\max}(G)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(32)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p9.3" class="ltx_p"><span id="A2.SS1.p9.3.1" class="ltx_text">Therefore, for flattened weight <math id="A2.SS1.p9.m3" class="ltx_Math" alttext="{\mathbf{w}}" display="inline" intent=":literal"><semantics><mi>𝐰</mi><annotation encoding="application/x-tex">{\mathbf{w}}</annotation></semantics></math> for <math id="A2.SS1.p9.m4" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math>,</span></p>
<table id="A2.E33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E33.m1" class="ltx_Math" alttext="\|{\mathbf{w}}_{D^{\prime}}-{\mathbf{w}}_{D}\|_{2}=\|W_{D^{\prime}}-W_{D}\|_{F}\ \leq\frac{2C\kappa}{n}\sqrt{\lambda_{\max}(G)}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐰</mi><msup><mi>D</mi><mo>′</mo></msup></msub><mo>−</mo><msub><mi>𝐰</mi><mi>D</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>=</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>W</mi><msup><mi>D</mi><mo>′</mo></msup></msub><mo>−</mo><msub><mi>W</mi><mi>D</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>≤</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><msub><mi>λ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|{\mathbf{w}}_{D^{\prime}}-{\mathbf{w}}_{D}\|_{2}=\|W_{D^{\prime}}-W_{D}\|_{F}\ \leq\frac{2C\kappa}{n}\sqrt{\lambda_{\max}(G)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(33)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS1.p10" class="ltx_para">
<p id="A2.SS1.p10.1" class="ltx_p"><span id="A2.SS1.p10.1.1" class="ltx_text">Adding isotropic Gaussian noise for <math id="A2.SS1.p10.m1" class="ltx_Math" alttext="\sigma_{\mathbf{w}}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>𝐰</mi></msub><annotation encoding="application/x-tex">\sigma_{\mathbf{w}}</annotation></semantics></math> in Remark <a href="#S2.E4" title="In Remark 3. ‣ 2.1 Differential Privacy ‣ 2 Backgrounds ‣ Multi-Class Support Vector Machine with Differential Privacy" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> therefore guarantees <math id="A2.SS1.p10.m2" class="ltx_Math" alttext="(\epsilon,\delta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\epsilon,\delta)</annotation></semantics></math>-DP,
and the post-processing property extends the guarantee to the
decision function <math id="A2.SS1.p10.m3" class="ltx_Math" alttext="\hat{f}(\cdot)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{f}(\cdot)</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="A2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.2 </span>Proof of Theorem <a href="#Thmtheorem3" title="Theorem 3 (Utility Advantage). ‣ 3.3 Gradient Perturbation for All-in-One PMSVM ‣ 3 Differentially Private Multi-Class SVM ‣ Multi-Class Support Vector Machine with Differential Privacy" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a></h3>

<div id="A2.SS2.p1" class="ltx_para">
<p id="A2.SS2.p1.1" class="ltx_p"><span id="A2.SS2.p1.1.1" class="ltx_text ltx_font_bold">(Restated) Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ 3.3 Gradient Perturbation for All-in-One PMSVM ‣ 3 Differentially Private Multi-Class SVM ‣ Multi-Class Support Vector Machine with Differential Privacy" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>. </span>
(<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib21" title="" class="ltx_ref">21</a>]</cite>)
Suppose <math id="A2.SS2.p1.m1" class="ltx_Math" alttext="F(w)" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F(w)</annotation></semantics></math> is <math id="A2.SS2.p1.m2" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>-strongly convex and let
<math id="A2.SS2.p1.m3" class="ltx_Math" alttext="\tilde{\mathbf{w}}=\arg\min_{{\mathbf{w}}}F({\mathbf{w}})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>=</mo><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mrow><msub><mi>min</mi><mi>𝐰</mi></msub><mo lspace="0.167em">⁡</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐰</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{\mathbf{w}}=\arg\min_{{\mathbf{w}}}F({\mathbf{w}})</annotation></semantics></math>.
Consider the stochastic gradient update</p>
<table id="A2.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex10.m1" class="ltx_Math" alttext="{{\mathbf{w}}}_{t+1}={{\mathbf{w}}}_{t}-\eta_{t}[\mathcal{M}_{t}({\mathbf{w}}_{t},\mathcal{D})]" display="block" intent=":literal"><semantics><mrow><msub><mi>𝐰</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><msub><mi>𝐰</mi><mi>t</mi></msub><mo>−</mo><mrow><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>t</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{{\mathbf{w}}}_{t+1}={{\mathbf{w}}}_{t}-\eta_{t}[\mathcal{M}_{t}({\mathbf{w}}_{t},\mathcal{D})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p1.2" class="ltx_p">where
<math id="A2.SS2.p1.m4" class="ltx_Math" alttext="\mathbb{E}[\,\mathcal{M}_{t}({\mathbf{w}}_{t}),\mathcal{D}]=\nabla F({\mathbf{w}}_{t})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo rspace="0.170em" stretchy="false">[</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[\,\mathcal{M}_{t}({\mathbf{w}}_{t}),\mathcal{D}]=\nabla F({\mathbf{w}}_{t})</annotation></semantics></math>,
<math id="A2.SS2.p1.m5" class="ltx_Math" alttext="\mathbb{E}[\|\mathcal{M}_{t}({\mathbf{w}}_{t})\|_{2}^{2}]\leq G^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><msup><mi>G</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\mathbb{E}[\|\mathcal{M}_{t}({\mathbf{w}}_{t})\|_{2}^{2}]\leq G^{2}</annotation></semantics></math>, and the learning rate schedule is
<math id="A2.SS2.p1.m6" class="ltx_Math" alttext="\eta_{t}=\tfrac{1}{\lambda\,t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>t</mi></msub><mo>=</mo><mfrac><mn>1</mn><mrow><mi>λ</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">\eta_{t}=\tfrac{1}{\lambda\,t}</annotation></semantics></math>.
Then, for any <math id="A2.SS2.p1.m7" class="ltx_Math" alttext="T&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">T&gt;1</annotation></semantics></math>,</p>
<table id="A2.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex11.m1" class="ltx_Math" alttext="\mathbb{E}\!\bigl[F({\mathbf{w}}_{T})-F(\tilde{\mathbf{w}})\bigr]=\mathcal{O}\!\Bigl(\tfrac{G^{2}\log(T)}{\lambda\,T}\Bigr)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo>=</mo><mrow><mpadded style="width:0.654em;" width="0.654em"><mi class="ltx_font_mathcaligraphic">𝒪</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="false"><mfrac><mrow><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mi>λ</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\!\bigl[F({\mathbf{w}}_{T})-F(\tilde{\mathbf{w}})\bigr]=\mathcal{O}\!\Bigl(\tfrac{G^{2}\log(T)}{\lambda\,T}\Bigr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p1.3" class="ltx_p"><span id="A2.SS2.p1.3.1" class="ltx_text ltx_font_bold">(Restated) Theorem <a href="#Thmtheorem3" title="Theorem 3 (Utility Advantage). ‣ 3.3 Gradient Perturbation for All-in-One PMSVM ‣ 3 Differentially Private Multi-Class SVM ‣ Multi-Class Support Vector Machine with Differential Privacy" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>. </span>
<span id="A2.SS2.p1.3.2" class="ltx_text ltx_font_italic">(Utility Advantage)
Let each single–example loss <math id="A2.SS2.p1.m8" class="ltx_Math" alttext="f(w,z_{i})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><msub><mi>z</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(w,z_{i})</annotation></semantics></math> be <math id="A2.SS2.p1.m9" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>–Lipschitz and
the population objective <math id="A2.SS2.p1.m10" class="ltx_Math" alttext="F(w)\!=\!\mathbb{E}_{z}[f(w,z)]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.108em" rspace="0.108em">=</mo><mrow><msub><mi>𝔼</mi><mi>z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F(w)\!=\!\mathbb{E}_{z}[f(w,z)]</annotation></semantics></math> be
<math id="A2.SS2.p1.m11" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>–strongly convex.
Consider the noisy gradient update</span></p>
<table id="A2.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex12.m1" class="ltx_math_unparsed" alttext="{\mathbf{w}}_{t+1}={\mathbf{w}}_{t}-\eta_{t}\Bigl(n\nabla f({\mathbf{w}}_{t},\mathcal{D})+{\mathbf{z}}_{\tau}\Bigr),\qquad{\mathbf{z}}_{\tau}\sim\mathcal{N}\!\bigl(0,\tau^{2}\sigma^{2}\mathbf{I}\bigr)," display="block" intent=":literal"><semantics><mrow><msub><mi>𝐰</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><msub><mi>𝐰</mi><mi>t</mi></msub><mo>−</mo><msub><mi>η</mi><mi>t</mi></msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mi>n</mi><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>t</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>𝐳</mi><mi>τ</mi></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo rspace="2.167em">,</mo><msub><mi>𝐳</mi><mi>τ</mi></msub><mo>∼</mo><mpadded style="width:0.798em;" width="0.798em"><mi class="ltx_font_mathcaligraphic">𝒩</mi></mpadded><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mn>0</mn><mo>,</mo><msup><mi>τ</mi><mn>2</mn></msup><msup><mi>σ</mi><mn>2</mn></msup><mi>𝐈</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\mathbf{w}}_{t+1}={\mathbf{w}}_{t}-\eta_{t}\Bigl(n\nabla f({\mathbf{w}}_{t},\mathcal{D})+{\mathbf{z}}_{\tau}\Bigr),\qquad{\mathbf{z}}_{\tau}\sim\mathcal{N}\!\bigl(0,\tau^{2}\sigma^{2}\mathbf{I}\bigr),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p1.4" class="ltx_p"><span id="A2.SS2.p1.4.1" class="ltx_text ltx_font_italic">where <math id="A2.SS2.p1.m12" class="ltx_Math" alttext="\tau\in(0,1]" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\tau\in(0,1]</annotation></semantics></math> is the ratio of <math id="A2.SS2.p1.m13" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> in the Gaussian noise. Let <math id="A2.SS2.p1.m14" class="ltx_Math" alttext="{\mathbf{w}}_{T}^{(\tau)}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐰</mi><mi>T</mi><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">{\mathbf{w}}_{T}^{(\tau)}</annotation></semantics></math> be the <math id="A2.SS2.p1.m15" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math><span id="A2.SS2.p1.4.1.1" class="ltx_text">-</span>th iterate produced with noise scale
<math id="A2.SS2.p1.m16" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> and <math id="A2.SS2.p1.m17" class="ltx_Math" alttext="{\mathbf{w}}_{T}" display="inline" intent=":literal"><semantics><msub><mi>𝐰</mi><mi>T</mi></msub><annotation encoding="application/x-tex">{\mathbf{w}}_{T}</annotation></semantics></math> is without scaling.</span></p>
</div>
<div id="A2.SS2.p2" class="ltx_para">
<p id="A2.SS2.p2.1" class="ltx_p">We follow the utility guarantee of the gradient methods in strong convex case <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">9</a>]</cite>.</p>
</div>
<div id="A2.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS2.p3" class="ltx_para">
<p id="A2.SS2.p3.1" class="ltx_p"><span id="A2.SS2.p3.1.1" class="ltx_text">Define</span></p>
<table id="A2.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex13.m1" class="ltx_math_unparsed" alttext="\mathcal{M}_{t}=n\nabla f({\mathbf{w}}_{t},z_{t})+{\mathbf{z}}_{t},\qquad\mathcal{M}_{t}^{(\tau)}=n\nabla f({\mathbf{w}}_{t},z_{t})+{\mathbf{z}}_{t}^{(\tau)}," display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>t</mi></msub><mo>=</mo><mi>n</mi><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>t</mi></msub><mo>,</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>𝐳</mi><mi>t</mi></msub><mo rspace="2.167em">,</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>n</mi><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>t</mi></msub><mo>,</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><msubsup><mi>𝐳</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{M}_{t}=n\nabla f({\mathbf{w}}_{t},z_{t})+{\mathbf{z}}_{t},\qquad\mathcal{M}_{t}^{(\tau)}=n\nabla f({\mathbf{w}}_{t},z_{t})+{\mathbf{z}}_{t}^{(\tau)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p3.2" class="ltx_p"><span id="A2.SS2.p3.2.1" class="ltx_text">where <math id="A2.SS2.p3.m1" class="ltx_Math" alttext="z_{t}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mi>t</mi></msub><annotation encoding="application/x-tex">z_{t}</annotation></semantics></math> is sampled uniformly from the dataset, <math id="A2.SS2.p3.m2" class="ltx_Math" alttext="{\mathbf{z}}_{t}\sim\mathcal{N}(\mathbf{0},\sigma^{2}\mathbf{I})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐳</mi><mi>t</mi></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>𝟎</mn><mo>,</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐈</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{z}}_{t}\sim\mathcal{N}(\mathbf{0},\sigma^{2}\mathbf{I})</annotation></semantics></math>, and <math id="A2.SS2.p3.m3" class="ltx_Math" alttext="{\mathbf{z}}_{t}^{(\tau)}\sim\mathcal{N}(\mathbf{0},\tau^{2}\sigma^{2}\mathbf{I})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐳</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>𝟎</mn><mo>,</mo><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐈</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{z}}_{t}^{(\tau)}\sim\mathcal{N}(\mathbf{0},\tau^{2}\sigma^{2}\mathbf{I})</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS2.p4" class="ltx_para">
<p id="A2.SS2.p4.1" class="ltx_p"><span id="A2.SS2.p4.1.1" class="ltx_text">By taking expectation over <math id="A2.SS2.p4.m1" class="ltx_Math" alttext="z_{t}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mi>t</mi></msub><annotation encoding="application/x-tex">z_{t}</annotation></semantics></math> and then over the noise, we can obtain</span></p>
<table id="A2.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex14.m1" class="ltx_math_unparsed" alttext="\mathbb{E}[\mathcal{M}_{t}\mid{\mathbf{w}}_{t}]=n\cdot\frac{1}{n}\sum_{i=1}^{n}\nabla f({\mathbf{w}}_{t},z_{i})+\mathbb{E}[{\mathbf{z}}_{t}]=\nabla F({\mathbf{w}}_{t})," display="block" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝐰</mi><mi>t</mi></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><mi>n</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>t</mi></msub><mo>,</mo><msub><mi>z</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>𝐳</mi><mi>t</mi></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><mo rspace="0.167em">∇</mo><mi>F</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[\mathcal{M}_{t}\mid{\mathbf{w}}_{t}]=n\cdot\frac{1}{n}\sum_{i=1}^{n}\nabla f({\mathbf{w}}_{t},z_{i})+\mathbb{E}[{\mathbf{z}}_{t}]=\nabla F({\mathbf{w}}_{t}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p4.2" class="ltx_p"><span id="A2.SS2.p4.2.1" class="ltx_text">and similarly <math id="A2.SS2.p4.m2" class="ltx_Math" alttext="\mathbb{E}[\mathcal{M}_{t}^{(\tau)}\mid{\mathbf{w}}_{t}]=\nabla F({\mathbf{w}}_{t})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝐰</mi><mi>t</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[\mathcal{M}_{t}^{(\tau)}\mid{\mathbf{w}}_{t}]=\nabla F({\mathbf{w}}_{t})</annotation></semantics></math>, which indicates both are unbiased estimators for gradient.</span></p>
</div>
<div id="A2.SS2.p5" class="ltx_para">
<p id="A2.SS2.p5.1" class="ltx_p"><span id="A2.SS2.p5.1.1" class="ltx_text">Moreover, since each <math id="A2.SS2.p5.m1" class="ltx_Math" alttext="f(\cdot,z)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(\cdot,z)</annotation></semantics></math> is <math id="A2.SS2.p5.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>-Lipschitz and the noise is independent of the gradient,</span></p>
<table id="A2.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex15.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\|\mathcal{M}_{t}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\|\mathcal{M}_{t}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex15.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}\bigl\|n\nabla f({\mathbf{w}}_{t},z_{t})\bigr\|_{2}^{2}+2\,\mathbb{E}\langle n\nabla f({\mathbf{w}}_{t},z_{t}),{\mathbf{z}}_{t}\rangle+\mathbb{E}\|{\mathbf{z}}_{t}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><mi>n</mi><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>t</mi></msub><mo>,</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><msubsup><mo lspace="0em" mathsize="1.200em" rspace="0em">∥</mo><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em">+</mo><mn>2</mn><mi>𝔼</mi><mrow><mo stretchy="false">⟨</mo><mi>n</mi><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>t</mi></msub><mo>,</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝐳</mi><mi>t</mi></msub><mo stretchy="false">⟩</mo></mrow><mo>+</mo><mi>𝔼</mi><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>𝐳</mi><mi>t</mi></msub><msubsup><mo lspace="0em">∥</mo><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\bigl\|n\nabla f({\mathbf{w}}_{t},z_{t})\bigr\|_{2}^{2}+2\,\mathbb{E}\langle n\nabla f({\mathbf{w}}_{t},z_{t}),{\mathbf{z}}_{t}\rangle+\mathbb{E}\|{\mathbf{z}}_{t}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex16.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq n^{2}L^{2}+0+d\,\sigma^{2}=:G^{2},\quad\mathbb{E}\|\mathcal{M}_{t}^{(\tau)}\|_{2}^{2}\leq n^{2}L^{2}+d\,\tau^{2}\sigma^{2}=:G_{\tau}^{2}." display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>n</mi><msup><mrow></mrow><mn>2</mn></msup><mi>L</mi><msup><mrow></mrow><mn>2</mn></msup><mo>+</mo><mn>0</mn><mo>+</mo><mi>d</mi><mi>σ</mi><msup><mrow></mrow><mn>2</mn></msup><mo rspace="0em">=</mo><mo rspace="0.278em">:</mo><mi>G</mi><msup><mrow></mrow><mn>2</mn></msup><mo rspace="1.167em">,</mo><mi>𝔼</mi><mo lspace="0em" rspace="0.167em">∥</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0.0835em">≤</mo><mi>n</mi><msup><mrow></mrow><mn>2</mn></msup><mi>L</mi><msup><mrow></mrow><mn>2</mn></msup><mo>+</mo><mi>d</mi><mi>τ</mi><msup><mrow></mrow><mn>2</mn></msup><mi>σ</mi><msup><mrow></mrow><mn>2</mn></msup><mo rspace="0em">=</mo><mo rspace="0.278em">:</mo><mi>G</mi><msub><mrow></mrow><mi>τ</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq n^{2}L^{2}+0+d\,\sigma^{2}=:G^{2},\quad\mathbb{E}\|\mathcal{M}_{t}^{(\tau)}\|_{2}^{2}\leq n^{2}L^{2}+d\,\tau^{2}\sigma^{2}=:G_{\tau}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p5.2" class="ltx_p"><span id="A2.SS2.p5.2.1" class="ltx_text">By Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ 3.3 Gradient Perturbation for All-in-One PMSVM ‣ 3 Differentially Private Multi-Class SVM ‣ Multi-Class Support Vector Machine with Differential Privacy" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> with <math id="A2.SS2.p5.m3" class="ltx_Math" alttext="\eta_{t}=1/(\lambda t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>t</mi></msub><mo>=</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta_{t}=1/(\lambda t)</annotation></semantics></math>,</span></p>
<table id="A2.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex17.m1" class="ltx_Math" alttext="\mathbb{E}\bigl[F({\mathbf{w}}_{T})-F(\tilde{\mathbf{w}})\bigr]=\mathcal{O}\Bigl(\tfrac{G^{2}\log T}{\lambda T}\Bigr),\quad\mathbb{E}\bigl[F({\mathbf{w}}_{T}^{(\tau)})-F(\tilde{\mathbf{w}})\bigr]=\mathcal{O}\Bigl(\tfrac{G_{\tau}^{2}\log T}{\lambda T}\Bigr)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="false"><mfrac><mrow><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mi>T</mi><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="false"><mfrac><mrow><msubsup><mi>G</mi><mi>τ</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\bigl[F({\mathbf{w}}_{T})-F(\tilde{\mathbf{w}})\bigr]=\mathcal{O}\Bigl(\tfrac{G^{2}\log T}{\lambda T}\Bigr),\quad\mathbb{E}\bigl[F({\mathbf{w}}_{T}^{(\tau)})-F(\tilde{\mathbf{w}})\bigr]=\mathcal{O}\Bigl(\tfrac{G_{\tau}^{2}\log T}{\lambda T}\Bigr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p5.3" class="ltx_p"><span id="A2.SS2.p5.3.1" class="ltx_text">Subtracting gives</span></p>
<table id="A2.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex18.m1" class="ltx_Math" alttext="\mathbb{E}\bigl[F({\mathbf{w}}_{T})-F({\mathbf{w}}_{T}^{(\tau)})\bigr]=\mathcal{O}\!\Bigl(\tfrac{(G^{2}-G_{\tau}^{2})\,\log T}{\lambda T}\Bigr)=\mathcal{O}\!\Bigl(\tfrac{d\,\sigma^{2}(1-\tau^{2})\,\log T}{\lambda T}\Bigr)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mi>T</mi><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo>=</mo><mrow><mpadded style="width:0.654em;" width="0.654em"><mi class="ltx_font_mathcaligraphic">𝒪</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="false"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>G</mi><mn>2</mn></msup><mo>−</mo><msubsup><mi>G</mi><mi>τ</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.337em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>=</mo><mrow><mpadded style="width:0.654em;" width="0.654em"><mi class="ltx_font_mathcaligraphic">𝒪</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="false"><mfrac><mrow><mi>d</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>τ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.337em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\bigl[F({\mathbf{w}}_{T})-F({\mathbf{w}}_{T}^{(\tau)})\bigr]=\mathcal{O}\!\Bigl(\tfrac{(G^{2}-G_{\tau}^{2})\,\log T}{\lambda T}\Bigr)=\mathcal{O}\!\Bigl(\tfrac{d\,\sigma^{2}(1-\tau^{2})\,\log T}{\lambda T}\Bigr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p5.4" class="ltx_p"><span id="A2.SS2.p5.4.1" class="ltx_text">Similarly, for constant step size <math id="A2.SS2.p5.m4" class="ltx_Math" alttext="\eta=c/\lambda" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><mrow><mi>c</mi><mo>/</mo><mi>λ</mi></mrow></mrow><annotation encoding="application/x-tex">\eta=c/\lambda</annotation></semantics></math> (<math id="A2.SS2.p5.m5" class="ltx_Math" alttext="0&lt;c\leq\frac{1}{2}" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>c</mi><mo>≤</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">0&lt;c\leq\frac{1}{2}</annotation></semantics></math>),
Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ 3.3 Gradient Perturbation for All-in-One PMSVM ‣ 3 Differentially Private Multi-Class SVM ‣ Multi-Class Support Vector Machine with Differential Privacy" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> yields</span></p>
<table id="A2.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex19.m1" class="ltx_Math" alttext="\mathbb{E}\bigl[F({\mathbf{w}}_{T})-F(\tilde{\mathbf{w}})\bigr]=\mathcal{O}(\eta\,G^{2}),\quad\mathbb{E}\bigl[F({\mathbf{w}}_{T}^{(\tau)})-F(\tilde{\mathbf{w}})\bigr]=\mathcal{O}(\eta\,G_{\tau}^{2})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mi>T</mi><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>G</mi><mi>τ</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\bigl[F({\mathbf{w}}_{T})-F(\tilde{\mathbf{w}})\bigr]=\mathcal{O}(\eta\,G^{2}),\quad\mathbb{E}\bigl[F({\mathbf{w}}_{T}^{(\tau)})-F(\tilde{\mathbf{w}})\bigr]=\mathcal{O}(\eta\,G_{\tau}^{2}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p5.5" class="ltx_p"><span id="A2.SS2.p5.5.1" class="ltx_text">hence</span></p>
<table id="A2.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex20.m1" class="ltx_Math" alttext="\mathbb{E}\bigl[F({\mathbf{w}}_{T})-F({\mathbf{w}}_{T}^{(\tau)})\bigr]=\mathcal{O}\bigl(\eta\,(G^{2}-G_{\tau}^{2})\bigr)=\mathcal{O}\bigl(c\,d\,\sigma^{2}(1-\tau^{2})\bigr)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mi>T</mi><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>η</mi><mo lspace="0.170em">⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>G</mi><mn>2</mn></msup><mo>−</mo><msubsup><mi>G</mi><mi>τ</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>c</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>d</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>τ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\bigl[F({\mathbf{w}}_{T})-F({\mathbf{w}}_{T}^{(\tau)})\bigr]=\mathcal{O}\bigl(\eta\,(G^{2}-G_{\tau}^{2})\bigr)=\mathcal{O}\bigl(c\,d\,\sigma^{2}(1-\tau^{2})\bigr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p5.6" class="ltx_p"><span id="A2.SS2.p5.6.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Experiments</h2>

<section id="A3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.1 </span>Experimental Settings</h3>

<div id="A3.SS1.p1" class="ltx_para">
<p id="A3.SS1.p1.1" class="ltx_p">We provide the dataset statistics in Table <a href="#A3.T6" title="Table 6 ‣ C.1 Experimental Settings ‣ Appendix C Experiments ‣ Multi-Class Support Vector Machine with Differential Privacy" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>, including sample size, dimensionality, and number of classes for each dataset.</p>
</div>
<figure id="A3.T6" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 6: </span>Summary of benchmark datasets used in the experiments.</figcaption>
<div id="A3.T6.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:207.0pt;height:71.6pt;vertical-align:-33.7pt;"><span class="ltx_transformed_inner" style="transform:translate(-19.6pt,6.8pt) scale(0.840592425981606,0.840592425981606) ;">
<table id="A3.T6.2.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="A3.T6.2.1.1" class="ltx_tr">
<th id="A3.T6.2.1.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt">Dataset</th>
<th id="A3.T6.2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_tt"># samples (<math id="A3.T6.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>)</th>
<th id="A3.T6.2.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">dims (<math id="A3.T6.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>)</th>
