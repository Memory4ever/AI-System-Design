<th id="S2.T1.2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="S2.T1.2.1.1.2.1" class="ltx_text ltx_font_bold">Loss function</span></th>
<th id="S2.T1.2.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S2.T1.2.1.1.3.1" class="ltx_text ltx_font_bold"># variables per classifier</span></th>
<th id="S2.T1.2.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S2.T1.2.1.1.4.1" class="ltx_text ltx_font_bold"># classifiers</span></th>
<th id="S2.T1.2.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="--ltx-bg-color:#E5FFE5;"><span id="S2.T1.2.1.1.5.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E5FFE5;"># accesses per sample</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S2.T1.2.1.2" class="ltx_tr">
<th id="S2.T1.2.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">OvO</th>
<th id="S2.T1.2.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t">pair-wise QP (convex)</th>
<td id="S2.T1.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S2.T1.m5" class="ltx_Math" alttext="2n/c" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>/</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">2n/c</annotation></semantics></math></td>
<td id="S2.T1.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S2.T1.m6" class="ltx_Math" alttext="{c(c-1)}/{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{c(c-1)}/{2}</annotation></semantics></math></td>
<td id="S2.T1.2.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#E5FFE5;"><math id="S2.T1.m7" class="ltx_Math" style="--ltx-bg-color:#E5FFE5;" alttext="c-1" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-bg-color:#E5FFE5;" mathbackground="#E5FFE5">c</mi><mo style="--ltx-bg-color:#E5FFE5;" mathbackground="#E5FFE5">−</mo><mn style="--ltx-bg-color:#E5FFE5;" mathbackground="#E5FFE5">1</mn></mrow><annotation encoding="application/x-tex">c-1</annotation></semantics></math></td></tr>
