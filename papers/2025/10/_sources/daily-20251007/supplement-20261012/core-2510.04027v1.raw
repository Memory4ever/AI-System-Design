<tr id="A1.T5.2.3" class="ltx_tr">
<th id="A1.T5.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T5.m2" class="ltx_Math" alttext="D,D^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>,</mo><msup><mi>D</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">D,D^{\prime}</annotation></semantics></math></th>
