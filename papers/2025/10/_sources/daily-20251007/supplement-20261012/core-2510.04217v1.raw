<td id="A6.T6.2.1.16.11" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#E6E6E6;padding-top:0.25pt;padding-bottom:0.25pt;"><span id="A6.T6.2.1.16.11.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">6.00</span></td>
<td id="A6.T6.2.1.16.12" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#E6E6E6;padding-top:0.25pt;padding-bottom:0.25pt;"><span id="A6.T6.2.1.16.12.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">11.05</span></td>
<td id="A6.T6.2.1.16.13" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#E6E6E6;padding-top:0.25pt;padding-bottom:0.25pt;"><span id="A6.T6.2.1.16.13.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">12.42</span></td></tr>
