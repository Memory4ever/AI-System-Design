                <math id="alg1.m25" class="ltx_Math" alttext="\delta r=r-r^{o}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>=</mo><mrow><mi>r</mi><mo>−</mo><msup><mi>r</mi><mi>o</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\delta r=r-r^{o}</annotation></semantics></math>;
</div>
<div id="alg1.3.14" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.3.14.1" class="ltx_text ltx_font_bold">11</span></span>
                Calculate <math id="alg1.m26" class="ltx_Math" alttext="\delta g" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><annotation encoding="application/x-tex">\delta g</annotation></semantics></math> using (<a href="#S3.E23" title="In Theorem 2 (Modified Data-Enabled Neighboring Extremal). ‣ III-B DeeNE with Non-Optimal Nominal Solution ‣ III Data-Enabled Neighboring Extremal (DeeNE) ‣ Data-Enabled Neighboring Extremal: Case Study on Model-Free Trajectory Tracking for Robotic Arm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>);
</div>
<div id="alg1.3.15" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.3.15.1" class="ltx_text ltx_font_bold">12</span></span>
                <math id="alg1.m27" class="ltx_Math" alttext="g^{*}=g^{o}+\delta g" display="inline" intent=":literal"><semantics><mrow><msup><mi>g</mi><mo>∗</mo></msup><mo>=</mo><mrow><msup><mi>g</mi><mi>o</mi></msup><mo>+</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">g^{*}=g^{o}+\delta g</annotation></semantics></math>;
</div>
<div id="alg1.3.16" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.3.16.1" class="ltx_text ltx_font_bold">13</span></span>
                <math id="alg1.m28" class="ltx_Math" alttext="u^{*}=U_{F}g^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo>=</mo><mrow><msub><mi>U</mi><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>g</mi><mo>∗</mo></msup></mrow></mrow><annotation encoding="application/x-tex">u^{*}=U_{F}g^{*}</annotation></semantics></math>;
</div>
<div id="alg1.3.17" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.3.17.1" class="ltx_text ltx_font_bold">14</span></span>
                end if
</div>
<div id="alg1.3.18" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.3.18.1" class="ltx_text ltx_font_bold">15</span></span>
                Apply <math id="alg1.m29" class="ltx_Math" alttext="u(k:k+s)=u^{*}(0:s)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>+</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u(k:k+s)=u^{*}(0:s)</annotation></semantics></math>, <math id="alg1.m30" class="ltx_Math" alttext="0\leq s\leq N-1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>s</mi><mo>≤</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">0\leq s\leq N-1</annotation></semantics></math>;
</div>
<div id="alg1.3.19" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.3.19.1" class="ltx_text ltx_font_bold">16</span></span>
                Measure <math id="alg1.m31" class="ltx_Math" alttext="y(k:k+s)" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>+</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">y(k:k+s)</annotation></semantics></math> from the system;
</div>
<div id="alg1.3.20" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.3.20.1" class="ltx_text ltx_font_bold">17</span></span>
                <math id="alg1.m32" class="ltx_Math" alttext="g^{o}=g^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>g</mi><mi>o</mi></msup><mo>=</mo><msup><mi>g</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">g^{o}=g^{*}</annotation></semantics></math>;
</div>
<div id="alg1.3.21" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.3.21.1" class="ltx_text ltx_font_bold">18</span></span>
                <math id="alg1.m33" class="ltx_Math" alttext="w_{ini}^{o}=w_{ini}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>w</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mi>o</mi></msubsup><mo>=</mo><msub><mi>w</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub></mrow><annotation encoding="application/x-tex">w_{ini}^{o}=w_{ini}</annotation></semantics></math>;
</div>
<div id="alg1.3.22" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.3.22.1" class="ltx_text ltx_font_bold">19</span></span>
                <math id="alg1.m34" class="ltx_Math" alttext="r^{o}=r" display="inline" intent=":literal"><semantics><mrow><msup><mi>r</mi><mi>o</mi></msup><mo>=</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">r^{o}=r</annotation></semantics></math>;
</div>
<div id="alg1.3.23" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.3.23.1" class="ltx_text ltx_font_bold">20</span></span>
                Update <math id="alg1.m35" class="ltx_Math" alttext="w_{ini}=w(k+s-Tini+1:k+s)" display="inline" intent=":literal"><semantics><mrow><msub><mi>w</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo>=</mo><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mi>k</mi><mo>+</mo><mi>s</mi></mrow><mo>−</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>+</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">w_{ini}=w(k+s-Tini+1:k+s)</annotation></semantics></math>;
</div>
<div id="alg1.3.24" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.3.24.1" class="ltx_text ltx_font_bold">21</span></span>
                Update <math id="alg1.m36" class="ltx_Math" alttext="r(0:N-1)" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r(0:N-1)</annotation></semantics></math>;
</div>
<div id="alg1.3.25" class="ltx_listingline">
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.3.25.1" class="ltx_text ltx_font_bold">22</span></span>
                end for
