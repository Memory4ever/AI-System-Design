</div>
<div id="alg1.3.11" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.3.11.1" class="ltx_text ltx_font_bold">8</span></span>
                Calculate <math id="alg1.m21" class="ltx_Math" alttext="K^{*}_{1}" display="inline" intent=":literal"><semantics><msubsup><mi>K</mi><mn>1</mn><mo>∗</mo></msubsup><annotation encoding="application/x-tex">K^{*}_{1}</annotation></semantics></math>, <math id="alg1.m22" class="ltx_Math" alttext="K^{*}_{2}" display="inline" intent=":literal"><semantics><msubsup><mi>K</mi><mn>2</mn><mo>∗</mo></msubsup><annotation encoding="application/x-tex">K^{*}_{2}</annotation></semantics></math>, <math id="alg1.m23" class="ltx_Math" alttext="K^{*}_{3}" display="inline" intent=":literal"><semantics><msubsup><mi>K</mi><mn>3</mn><mo>∗</mo></msubsup><annotation encoding="application/x-tex">K^{*}_{3}</annotation></semantics></math> using (<a href="#S3.E17" title="In Theorem 1 (Data-Enabled Neighboring Extremal). ‣ III-A DeeNE with Optimal Nominal Solution ‣ III Data-Enabled Neighboring Extremal (DeeNE) ‣ Data-Enabled Neighboring Extremal: Case Study on Model-Free Trajectory Tracking for Robotic Arm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>) and (<a href="#S3.E23" title="In Theorem 2 (Modified Data-Enabled Neighboring Extremal). ‣ III-B DeeNE with Non-Optimal Nominal Solution ‣ III Data-Enabled Neighboring Extremal (DeeNE) ‣ Data-Enabled Neighboring Extremal: Case Study on Model-Free Trajectory Tracking for Robotic Arm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>);
</div>
<div id="alg1.3.12" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.3.12.1" class="ltx_text ltx_font_bold">9</span></span>
                <math id="alg1.m24" class="ltx_Math" alttext="\delta w_{ini}=w_{ini}-w_{ini}^{o}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>w</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub></mrow><mo>=</mo><mrow><msub><mi>w</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo>−</mo><msubsup><mi>w</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mi>o</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\delta w_{ini}=w_{ini}-w_{ini}^{o}</annotation></semantics></math>;
</div>
<div id="alg1.3.13" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
