                <span id="alg1.3.5.2" class="ltx_text ltx_font_bold">if</span> <em id="alg1.3.5.3" class="ltx_emph ltx_font_italic"><math id="alg1.m17" class="ltx_Math" alttext="k==T_{ini}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mphantom></mphantom><mo>=</mo><msub><mi>T</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub></mrow><annotation encoding="application/x-tex">k==T_{ini}</annotation></semantics></math></em> <span id="alg1.3.5.4" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="alg1.3.6" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.3.6.1" class="ltx_text ltx_font_bold">3</span></span>
                Compute <math id="alg1.m18" class="ltx_Math" alttext="g^{*}" display="inline" intent=":literal"><semantics><msup><mi>g</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">g^{*}</annotation></semantics></math> using (<a href="#S2.E8" title="In II-B Data-Enabled Predictive Control (DeePC) ‣ II Problem Formulation and Preliminaries ‣ Data-Enabled Neighboring Extremal: Case Study on Model-Free Trajectory Tracking for Robotic Arm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>);
</div>
<div id="alg1.3.7" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.3.7.1" class="ltx_text ltx_font_bold">4</span></span>
                <math id="alg1.m19" class="ltx_Math" alttext="u^{*}=U_{F}g^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo>=</mo><mrow><msub><mi>U</mi><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>g</mi><mo>∗</mo></msup></mrow></mrow><annotation encoding="application/x-tex">u^{*}=U_{F}g^{*}</annotation></semantics></math>;
</div>
<div id="alg1.3.8" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
