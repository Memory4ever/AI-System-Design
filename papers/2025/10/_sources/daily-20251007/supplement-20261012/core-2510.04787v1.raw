<td id="A2.T3.6.3.4" class="ltx_td ltx_align_center" style="padding-left:3.4pt;padding-right:3.4pt;"><span id="A2.T3.6.3.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E2E8FA;">5</span></td></tr>
