<td id="S4.T2.2.16.2" class="ltx_td ltx_align_center"><span id="S4.T2.2.16.2.1" class="ltx_text" style="font-size:90%;">67.5K</span></td>
<td id="S4.T2.2.16.3" class="ltx_td ltx_align_center"><span id="S4.T2.2.16.3.1" class="ltx_text" style="font-size:90%;">66.5K</span></td>
<td id="S4.T2.2.16.4" class="ltx_td ltx_align_center"><span id="S4.T2.2.16.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">12.6K</span></td>
<td id="S4.T2.2.16.5" class="ltx_td ltx_align_center"><span id="S4.T2.2.16.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">12.5K</span></td>
<td id="S4.T2.2.16.6" class="ltx_td ltx_align_center"><span id="S4.T2.2.16.6.1" class="ltx_text" style="font-size:90%;">-</span></td></tr>
<tr id="S4.T2.2.17" class="ltx_tr">
<th id="S4.T2.2.17.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S4.T2.2.17.1.1" class="ltx_text" style="font-size:90%;">+ Decoupled Attribution (I4)</span></th>
<td id="S4.T2.2.17.2" class="ltx_td ltx_align_center"><span id="S4.T2.2.17.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">33.0K</span></td>
<td id="S4.T2.2.17.3" class="ltx_td ltx_align_center"><span id="S4.T2.2.17.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">32.5K</span></td>
<td id="S4.T2.2.17.4" class="ltx_td ltx_align_center"><span id="S4.T2.2.17.4.1" class="ltx_text" style="font-size:90%;">12.8K</span></td>
<td id="S4.T2.2.17.5" class="ltx_td ltx_align_center"><span id="S4.T2.2.17.5.1" class="ltx_text" style="font-size:90%;">12.7K</span></td>
<td id="S4.T2.2.17.6" class="ltx_td ltx_align_center"><span id="S4.T2.2.17.6.1" class="ltx_text" style="font-size:90%;">-</span></td></tr>
