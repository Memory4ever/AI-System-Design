<td id="S4.T1.2.5.5" class="ltx_td ltx_align_center"><span id="S4.T1.2.5.5.1" class="ltx_text" style="font-size:90%;">0.530</span></td>
<td id="S4.T1.2.5.6" class="ltx_td ltx_align_center"><span id="S4.T1.2.5.6.1" class="ltx_text" style="font-size:90%;">0.032</span></td></tr>
<tr id="S4.T1.2.6" class="ltx_tr">
