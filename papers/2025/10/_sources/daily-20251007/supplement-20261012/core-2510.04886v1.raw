<div id="lstnumberx295" class="ltx_listingline"><span id="lstnumberx295.1" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold" style="font-size:80%;">class</span><span id="lstnumberx295.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx295.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">ContextAwareStepAgent</span><span id="lstnumberx295.4" class="ltx_text ltx_font_typewriter" style="font-size:80%;">:</span>
