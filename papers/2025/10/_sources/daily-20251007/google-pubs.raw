    <div class="row-card__body">
        
          <a class="row-card__heading glue-link" href=https://research.google/pubs/a-scalable-framework-for-evaluating-health-language-models/ >
            
              A Scalable Framework for Evaluating Health Language Models
            
          </a>
        
        <div class="row-card__subheading">
          
            
              
                
                  
                    <div class="row-card__subheading__item small-text">
                      
                        Neil Mallinar
                      
                    </div>
                
              
            
              
                
                  
                    <div class="row-card__subheading__spacer"></div>
                    <div class="row-card__subheading__item small-text">
                      
                        <a class="row-card__small-link" href="/people/ali/">
                          Ali Heydari
                        </a>
                      
                    </div>
                  
              
            
              
                
                  
                    <div class="row-card__subheading__spacer"></div>
                    <div class="row-card__subheading__item small-text">
                      
                        <a class="row-card__small-link" href="/people/108533/">
