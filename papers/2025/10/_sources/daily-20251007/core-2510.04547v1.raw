<td id="S5.T6.4.2.2" class="ltx_td ltx_align_center ltx_border_t">69.71</td></tr>
<tr id="S5.T6.4.3" class="ltx_tr">
<th id="S5.T6.4.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Prefix Caching</th>
<td id="S5.T6.4.3.2" class="ltx_td ltx_align_center">74.21</td></tr>
<tr id="S5.T6.4.4" class="ltx_tr">
