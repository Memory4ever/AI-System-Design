<td id="A3.T7.st1.2.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.75pt 5.0pt;" colspan="2"><span id="A3.T7.st1.2.1.1.2.1" class="ltx_text ltx_font_bold">I <math id="A3.T7.st1.m1" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> T</span></td>
<td id="A3.T7.st1.2.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.75pt 5.0pt;" colspan="2"><span id="A3.T7.st1.2.1.1.3.1" class="ltx_text ltx_font_bold">T <math id="A3.T7.st1.m2" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> I</span></td></tr>
<tr id="A3.T7.st1.2.1.2" class="ltx_tr">
<th id="A3.T7.st1.2.1.2.1" class="ltx_td ltx_th ltx_th_row" style="padding:0.75pt 5.0pt;"></th>
