<td id="S5.T5.4.1.10.5" class="ltx_td ltx_align_center" style="--ltx-bg-color:#F2F2F2;padding:1pt 5.0pt;"><span id="S5.T5.4.1.10.5.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">67.60 <span id="S5.T5.4.1.10.5.1.1" class="ltx_text" style="--ltx-fg-color:#009100;">(+12.81)</span></span></td></tr>
<tr id="S5.T5.4.1.11" class="ltx_tr">
