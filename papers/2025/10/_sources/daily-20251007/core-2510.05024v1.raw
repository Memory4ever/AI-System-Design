</figure>
<figure id="A9.F23" class="ltx_figure"><object type="image/svg+xml" data="2510.05024v1/eval_prompt_compare_task_sycophancy_bar.svg" id="A9.F23.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:548/452;" width="548" height="452"></object>
