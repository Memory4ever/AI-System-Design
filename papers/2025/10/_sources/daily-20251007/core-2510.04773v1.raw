<td id="A4.T6.2.4.1" class="ltx_td ltx_align_center ltx_border_bb">TOFU-10%</td>
<td id="A4.T6.2.4.2" class="ltx_td ltx_align_center ltx_border_bb">400</td>
<td id="A4.T6.2.4.3" class="ltx_td ltx_align_center ltx_border_bb">400</td>
<td id="A4.T6.2.4.4" class="ltx_td ltx_align_center ltx_border_bb">100</td>
<td id="A4.T6.2.4.5" class="ltx_td ltx_align_center ltx_border_bb">117</td></tr>
