<td id="A4.T6.2.3.1" class="ltx_td ltx_align_center">TOFU-5%</td>
<td id="A4.T6.2.3.2" class="ltx_td ltx_align_center">200</td>
<td id="A4.T6.2.3.3" class="ltx_td ltx_align_center">400</td>
<td id="A4.T6.2.3.4" class="ltx_td ltx_align_center">100</td>
<td id="A4.T6.2.3.5" class="ltx_td ltx_align_center">117</td></tr>
