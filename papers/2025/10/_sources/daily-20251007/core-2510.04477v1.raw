<span id="S4.T4.8.1.1.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt ltx_colspan ltx_colspan_2"><span id="S4.T4.8.1.1.1.1.2.1" class="ltx_text ltx_font_bold">VQA-RAD</span></span>
