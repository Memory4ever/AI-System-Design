<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4 </span>Experiments</h2>

<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.1 </span>Experimental Settings</h3>

<figure id="S4.T2" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 2: </span>Main results on radiology report generation. Comparisons across two widely-used benchmark datasets, <span id="S4.T2.4" class="ltx_text ltx_font_italic">IU-Xray</span> and <span id="S4.T2.5" class="ltx_text ltx_font_italic">MIMIC-CXR</span>, using standard evaluation metrics (BLEU, ROUGE, and METEOR).</figcaption>
<table id="S4.T2.6" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S4.T2.6.1" class="ltx_tr">
<th id="S4.T2.6.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_r ltx_border_tt" style="padding:1pt 10.0pt;"><span id="S4.T2.6.1.1.1" class="ltx_text ltx_font_bold">Method</span></th>
<th id="S4.T2.6.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt" style="padding:1pt 10.0pt;" colspan="3"><span id="S4.T2.6.1.2.1" class="ltx_text ltx_font_bold">IU-Xray</span></th>
<th id="S4.T2.6.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:1pt 10.0pt;" colspan="3"><span id="S4.T2.6.1.3.1" class="ltx_text ltx_font_bold">MIMIC-CXR</span></th></tr>
<tr id="S4.T2.6.2" class="ltx_tr">
<th id="S4.T2.6.2.1" class="ltx_td ltx_th ltx_th_column ltx_th_row ltx_border_r" style="padding:1pt 10.0pt;"></th>
<th id="S4.T2.6.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:1pt 10.0pt;">BLEU</th>
<th id="S4.T2.6.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:1pt 10.0pt;">ROUGE</th>
<th id="S4.T2.6.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t" style="padding:1pt 10.0pt;">METEOR</th>
<th id="S4.T2.6.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:1pt 10.0pt;">BLEU</th>
<th id="S4.T2.6.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:1pt 10.0pt;">ROUGE</th>
<th id="S4.T2.6.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:1pt 10.0pt;">METEOR</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T2.6.3" class="ltx_tr">
<th id="S4.T2.6.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding:1pt 10.0pt;">PMC-CLIP <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib25" title="" class="ltx_ref">Lin et al. (2023)</a></cite></th>
<td id="S4.T2.6.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:1pt 10.0pt;">8.57</td>
