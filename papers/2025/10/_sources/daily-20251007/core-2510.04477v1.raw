<span id="S4.T4.8.1.1.1.4.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S4.T4.8.1.1.1.4.5.1" class="ltx_text ltx_font_bold">93.6</span></span>
<span id="S4.T4.8.1.1.1.4.6" class="ltx_td ltx_align_center ltx_border_bb">60.4</span></span>
</span>
