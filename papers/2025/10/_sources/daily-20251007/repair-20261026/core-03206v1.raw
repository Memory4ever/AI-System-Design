<td id="A4.T6.2.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="A4.T6.m5" class="ltx_Math" alttext="2.457" display="inline" intent=":literal"><semantics><mn>2.457</mn><annotation encoding="application/x-tex">2.457</annotation></semantics></math></td>
<td id="A4.T6.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="A4.T6.m6" class="ltx_Math" alttext="11.67" display="inline" intent=":literal"><semantics><mn>11.67</mn><annotation encoding="application/x-tex">11.67</annotation></semantics></math></td></tr>
