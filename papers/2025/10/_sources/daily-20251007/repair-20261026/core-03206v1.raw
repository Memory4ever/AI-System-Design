              <span id="alg2.l7.2" class="ltx_text ltx_font_bold">DDIM mean:</span> <math id="alg2.l7.m1" class="ltx_Math" alttext="m_{t_{k+1}}\leftarrow\alpha_{t_{k+1}}\hat{z}_{0,\theta}+\sigma_{t_{k+1}}\,\epsilon_{\theta}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>m</mi><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></msub><mo stretchy="false">←</mo><mrow><mrow><msub><mi>α</mi><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><mrow><mn>0</mn><mo>,</mo><mi>θ</mi></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>σ</mi><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mi>θ</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">m_{t_{k+1}}\leftarrow\alpha_{t_{k+1}}\hat{z}_{0,\theta}+\sigma_{t_{k+1}}\,\epsilon_{\theta}.</annotation></semantics></math>

</div>
<div id="alg2.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">8:</span>
              
              
