<td id="S5.T3.2.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;">117M</td>
<td id="S5.T3.2.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;">23.40</td></tr>
<tr id="S5.T3.2.3" class="ltx_tr">
<td id="S5.T3.2.3.1" class="ltx_td ltx_align_left" style="padding-top:0.75pt;padding-bottom:0.75pt;">Llama110M (retrain.)<sup id="S5.T3.2.3.1.1" class="ltx_sup">†</sup></td>
<td id="S5.T3.2.3.2" class="ltx_td ltx_align_center" style="padding-top:0.75pt;padding-bottom:0.75pt;">262B</td>
<td id="S5.T3.2.3.3" class="ltx_td ltx_align_center" style="padding-top:0.75pt;padding-bottom:0.75pt;">110M</td>
