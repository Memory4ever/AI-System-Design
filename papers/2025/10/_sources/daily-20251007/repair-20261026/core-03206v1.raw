<table id="A3.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex21.m1" class="ltx_Math" alttext="\epsilon_{\theta}\leftarrow\epsilon_{\theta}\!\big(x_{t_{k}},z_{t_{k}},t_{k}\big),\qquad\ell_{\theta}\leftarrow\ell_{\theta}\!\big(x_{t_{k}},z_{t_{k}},t_{k}\big),\quad\hat{\pi}_{\theta}=\mathrm{softmax}(\ell_{\theta})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ϵ</mi><mi>θ</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>x</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>z</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>t</mi><mi>k</mi></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi mathvariant="normal">ℓ</mi><mi>θ</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi mathvariant="normal">ℓ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>x</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>z</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>t</mi><mi>k</mi></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>θ</mi></msub><mo>=</mo><mrow><mi>softmax</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">ℓ</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\epsilon_{\theta}\leftarrow\epsilon_{\theta}\!\big(x_{t_{k}},z_{t_{k}},t_{k}\big),\qquad\ell_{\theta}\leftarrow\ell_{\theta}\!\big(x_{t_{k}},z_{t_{k}},t_{k}\big),\quad\hat{\pi}_{\theta}=\mathrm{softmax}(\ell_{\theta}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
