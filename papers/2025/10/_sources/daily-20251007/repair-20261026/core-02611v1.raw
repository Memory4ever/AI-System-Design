<span id="lstnumberx61" class="ltx_listingline"><span id="lstnumberx61.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">Do</span><span id="lstnumberx61.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx61.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">not</span><span id="lstnumberx61.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx61.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">output</span><span id="lstnumberx61.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx61.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">anything</span><span id="lstnumberx61.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx61.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">after</span><span id="lstnumberx61.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx61.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">that</span><span id="lstnumberx61.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx61.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">final</span><span id="lstnumberx61.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx61.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">line</span><span id="lstnumberx61.16" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">.</span>
</span>
</span>
</span></span></span></foreignObject></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 10: </span>Validation prompt used for gpt-5-assisted verification on AIME problems.</figcaption>
</figure>
</section>
</section>
<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>LLM Usage</h2>

<div id="A2.p1" class="ltx_para ltx_noindent">
<p id="A2.p1.1" class="ltx_p">We used GPT-5 as a general-purpose assist tool for language refinement and proofreading.
In addition, GPT-5 was employed to assist in the verification of AIME reasoning traces, as described in Appendix <a href="#A1" title="Appendix A Datasets, Evaluation, and Verification ‣ On the Role of Temperature Samplingin Test-Time Scaling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a>.</p>
</div>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Algorithm</h2>

<div id="A3.p1" class="ltx_para ltx_noindent">
<p id="A3.p1.1" class="ltx_p">The algorithm for the efficient temperature scaling can be found in Algorithm <a href="#alg1" title="Algorithm 1 ‣ Appendix C Algorithm ‣ On the Role of Temperature Samplingin Test-Time Scaling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.</p>
</div>
<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> Efficient Temperature Scaling with Two-Stage Voting</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">1:</span>
            
            
          Questions <math id="alg1.l1.m1" class="ltx_Math" alttext="\mathcal{Q}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒬</mi><annotation encoding="application/x-tex">\mathcal{Q}</annotation></semantics></math>; temperatures <math id="alg1.l1.m2" class="ltx_Math" alttext="\mathcal{T}=\{T_{1},\dots,T_{M}\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>T</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>T</mi><mi>M</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}=\{T_{1},\dots,T_{M}\}</annotation></semantics></math>; max rounds <math id="alg1.l1.m3" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>; intra-temp threshold <math id="alg1.l1.m4" class="ltx_Math" alttext="\tau_{\mathrm{intra}}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>intra</mi></msub><annotation encoding="application/x-tex">\tau_{\mathrm{intra}}</annotation></semantics></math>; cross-temp threshold <math id="alg1.l1.m5" class="ltx_Math" alttext="\tau_{\mathrm{cross}}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>cross</mi></msub><annotation encoding="application/x-tex">\tau_{\mathrm{cross}}</annotation></semantics></math>; sampler <math id="alg1.l1.m6" class="ltx_Math" alttext="\textsc{Sample}(q,T)" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_font_smallcaps">Sample</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>,</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textsc{Sample}(q,T)</annotation></semantics></math>; extractor <math id="alg1.l1.m7" class="ltx_Math" alttext="\textsc{Ans}(y)" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_font_smallcaps">Ans</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textsc{Ans}(y)</annotation></semantics></math>

</div>
<div id="alg1.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">2:</span>
            
            
          For each <math id="alg1.l2.m1" class="ltx_Math" alttext="q\in\mathcal{Q}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi></mrow><annotation encoding="application/x-tex">q\in\mathcal{Q}</annotation></semantics></math>, per-temperature pools <math id="alg1.l2.m2" class="ltx_Math" alttext="\{\mathcal{S}_{q,T}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>q</mi><mo>,</mo><mi>T</mi></mrow></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\mathcal{S}_{q,T}\}</annotation></semantics></math> and their answers

</div>
<div id="alg1.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">3:</span>
            
            
          <span id="alg1.l3.2" class="ltx_text ltx_font_bold">for all</span> <math id="alg1.l3.m1" class="ltx_Math" alttext="q\in\mathcal{Q}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi></mrow><annotation encoding="application/x-tex">q\in\mathcal{Q}</annotation></semantics></math> <span id="alg1.l3.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">4:</span>
            
            
            <span id="alg1.l4.2" class="ltx_text ltx_font_bold">for all</span> <math id="alg1.l4.m1" class="ltx_Math" alttext="T\in\mathcal{T}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow><annotation encoding="application/x-tex">T\in\mathcal{T}</annotation></semantics></math> <span id="alg1.l4.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">5:</span>
            
            
             <math id="alg1.l5.m1" class="ltx_Math" alttext="\mathcal{S}_{q,T}\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>q</mi><mo>,</mo><mi>T</mi></mrow></msub><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\mathcal{S}_{q,T}\leftarrow\emptyset</annotation></semantics></math> <span id="alg1.l5.2" class="ltx_text" style="float:right;"><math id="alg1.l5.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> trace pool at temperature <math id="alg1.l5.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>
</span>
</div>
<div id="alg1.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">6:</span>
            
            
             <math id="alg1.l6.m1" class="ltx_Math" alttext="\mathcal{A}_{q,T}\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>q</mi><mo>,</mo><mi>T</mi></mrow></msub><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\mathcal{A}_{q,T}\leftarrow\emptyset</annotation></semantics></math> <span id="alg1.l6.2" class="ltx_text" style="float:right;"><math id="alg1.l6.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> multiset of answers for <math id="alg1.l6.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>
</span>
</div>
<div id="alg1.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">7:</span>
            
            
            <span id="alg1.l7.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l7.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">8:</span>
            
            
            <span id="alg1.l8.2" class="ltx_text ltx_font_smallcaps">active<math id="alg1.l8.m1" class="ltx_Math" alttext="(q)\leftarrow\text{true}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">←</mo><mtext>true</mtext></mrow><annotation encoding="application/x-tex">(q)\leftarrow\text{true}</annotation></semantics></math></span>

</div>
<div id="alg1.l9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">9:</span>
            
            
          <span id="alg1.l9.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l9.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l10" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">10:</span>
            
            
          <span id="alg1.l10.2" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l10.m1" class="ltx_Math" alttext="r\leftarrow 1" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo stretchy="false">←</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">r\leftarrow 1</annotation></semantics></math> <span id="alg1.l10.3" class="ltx_text ltx_font_bold">to</span> <math id="alg1.l10.m2" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> <span id="alg1.l10.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l11" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">11:</span>
            
            
            <span id="alg1.l11.2" class="ltx_text ltx_font_bold">for all</span> <math id="alg1.l11.m1" class="ltx_Math" alttext="q\in\mathcal{Q}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi></mrow><annotation encoding="application/x-tex">q\in\mathcal{Q}</annotation></semantics></math> <span id="alg1.l11.3" class="ltx_text ltx_font_bold">with</span> <span id="alg1.l11.4" class="ltx_text ltx_font_smallcaps">active<math id="alg1.l11.m2" class="ltx_Math" alttext="(q)=\text{true}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mtext>true</mtext></mrow><annotation encoding="application/x-tex">(q)=\text{true}</annotation></semantics></math></span> <span id="alg1.l11.5" class="ltx_text ltx_font_bold">do</span>
<span id="alg1.l11.6" class="ltx_text" style="float:right;"><math id="alg1.l11.m3" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Round-<math id="alg1.l11.m4" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> sampling
</span>
</div>
<div id="alg1.l12" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">12:</span>
            
            
             <span id="alg1.l12.2" class="ltx_text ltx_font_bold">for all</span> <math id="alg1.l12.m1" class="ltx_Math" alttext="T\in\mathcal{T}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow><annotation encoding="application/x-tex">T\in\mathcal{T}</annotation></semantics></math> <span id="alg1.l12.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l13" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">13:</span>
            
            
               <math id="alg1.l13.m1" class="ltx_Math" alttext="y\leftarrow\textsc{Sample}(q,T)" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">Sample</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>,</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">y\leftarrow\textsc{Sample}(q,T)</annotation></semantics></math>

</div>
<div id="alg1.l14" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">14:</span>
            
            
               <math id="alg1.l14.m1" class="ltx_Math" alttext="a\leftarrow\textsc{Ans}(y)" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">Ans</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">a\leftarrow\textsc{Ans}(y)</annotation></semantics></math>

</div>
<div id="alg1.l15" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">15:</span>
            
            
               Append <math id="alg1.l15.m1" class="ltx_Math" alttext="(T,y,a)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(T,y,a)</annotation></semantics></math> to <math id="alg1.l15.m2" class="ltx_Math" alttext="\mathcal{S}_{q,T}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>q</mi><mo>,</mo><mi>T</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{S}_{q,T}</annotation></semantics></math>; insert <math id="alg1.l15.m3" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> into <math id="alg1.l15.m4" class="ltx_Math" alttext="\mathcal{A}_{q,T}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>q</mi><mo>,</mo><mi>T</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{A}_{q,T}</annotation></semantics></math>

</div>
<div id="alg1.l16" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">16:</span>
            
            
             <span id="alg1.l16.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l16.3" class="ltx_text ltx_font_bold">for<span id="alg1.l16.3.1" class="ltx_text ltx_font_medium" style="float:right;"><math id="alg1.l16.m1" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Stage 1: intra-temperature voting
</span></span>
</div>
<div id="alg1.l17" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">17:</span>
            
            
             <math id="alg1.l17.m1" class="ltx_Math" alttext="\textit{all\_passed}\leftarrow\text{true}" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_italic">all_passed</mtext><mo stretchy="false">←</mo><mtext>true</mtext></mrow><annotation encoding="application/x-tex">\textit{all\_passed}\leftarrow\text{true}</annotation></semantics></math>;  <math id="alg1.l17.m2" class="ltx_Math" alttext="\mathcal{V}_{q}\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>q</mi></msub><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\mathcal{V}_{q}\leftarrow\emptyset</annotation></semantics></math> <span id="alg1.l17.2" class="ltx_text" style="float:right;"><math id="alg1.l17.m3" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <math id="alg1.l17.m4" class="ltx_Math" alttext="\mathcal{V}_{q}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>q</mi></msub><annotation encoding="application/x-tex">\mathcal{V}_{q}</annotation></semantics></math>: one vote per <math id="alg1.l17.m5" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>
</span>
</div>
<div id="alg1.l18" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">18:</span>
            
            
             <span id="alg1.l18.2" class="ltx_text ltx_font_bold">for all</span> <math id="alg1.l18.m1" class="ltx_Math" alttext="T\in\mathcal{T}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow><annotation encoding="application/x-tex">T\in\mathcal{T}</annotation></semantics></math> <span id="alg1.l18.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l19" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">19:</span>
            
            
               Build <math id="alg1.l19.m1" class="ltx_Math" alttext="h_{q,T}(a)\leftarrow\#\{a^{\prime}\in\mathcal{A}_{q,T}:a^{\prime}=a\}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>h</mi><mrow><mi>q</mi><mo>,</mo><mi>T</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mi>#</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mi>a</mi><mo>′</mo></msup><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>q</mi><mo>,</mo><mi>T</mi></mrow></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>a</mi><mo>′</mo></msup><mo>=</mo><mi>a</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">h_{q,T}(a)\leftarrow\#\{a^{\prime}\in\mathcal{A}_{q,T}:a^{\prime}=a\}</annotation></semantics></math>

</div>
<div id="alg1.l20" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">20:</span>
            
            
