<td id="S5.T2.6.7.7" class="ltx_td ltx_align_center ltx_border_bb" style="padding:-4.5pt 5.1pt;">53.91<math id="S5.T2.m154" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>1.07</td>
<td id="S5.T2.6.7.8" class="ltx_td ltx_align_center ltx_border_bb" style="padding:-4.5pt 5.1pt;">77.21<math id="S5.T2.m155" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.19</td>
<td id="S5.T2.6.7.9" class="ltx_td ltx_align_center ltx_border_bb" style="padding:-4.5pt 5.1pt;"><span id="S5.T2.6.7.9.1" class="ltx_text ltx_font_bold">79.30<math id="S5.T2.m156" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.27</span></td></tr>
</tbody>
