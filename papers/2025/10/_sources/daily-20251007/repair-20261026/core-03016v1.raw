up><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup><mo>−</mo><mrow><mfrac><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup><msubsup><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mrow></mfrac><mo>+</mo><mfrac><mrow><msub><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mn>0</mn></msub></mrow><msubsup><mi>σ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mfrac></mrow><mfrac><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup><mo>−</mo><mrow><mfrac><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup><msubsup><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mfrac></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\exp\left\{-\frac{1}{2}\left(\frac{\sigma_{t}^{2}}{(\sigma_{t}^{2}-\frac{\alpha_{t}^{2}}{\alpha_{t-1}^{2}}\sigma_{t-1}^{2})\sigma_{t-1}^{2}}\right)\left[\mathbf{x}_{t-1}^{2}-2\left(\frac{\frac{\frac{\alpha_{t}}{\alpha_{t-1}}\mathbf{x}_{t}}{\sigma_{t}^{2}-\frac{\alpha_{t}^{2}}{\alpha_{t-1}^{2}}\sigma_{t-1}^{2}}+\frac{\alpha_{t-1}\mathbf{x}_{0}}{\sigma_{t-1}^{2}}}{\frac{\sigma_{t}^{2}}{(\sigma_{t}^{2}-\frac{\alpha_{t}^{2}}{\alpha_{t-1}^{2}}\sigma_{t-1}^{2})\sigma_{t-1}^{2}}}\right)\mathbf{x}_{t-1}\right]\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex19.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex19.m2" class="ltx_Math" alttext="\displaystyle\exp\left\{-\frac{1}{2}\left(\frac{1}{\frac{(\sigma_{t}^{2}-\frac{\alpha_{t}^{2}}{\alpha_{t-1}^{2}}\sigma_{t-1}^{2})\sigma_{t-1}^{2}}{\sigma_{t}^{2}}}\right)\left[\mathbf{x}_{t-1}^{2}-2\left(\frac{\frac{\alpha_{t}}{\alpha_{t-1}}\mathbf{x}_{t}\sigma_{t-1}^{2}+(\sigma_{t}^{2}-\frac{\alpha_{t}^{2}}{\alpha_{t-1}^{2}}\sigma_{t-1}^{2})\alpha_{t-1}\mathbf{x}_{0}}{\sigma_{t}^{2}}\right)\mathbf{x}_{t-1}\right]\right\}" display="inline" intent=":literal"><semantics><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup><mo>−</mo><mrow><mfrac><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup><msubsup><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup></mfrac></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝐱</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mfrac><msub><mi>α</mi><mi>t</mi></msub><msub><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup><mo>−</mo><mrow><mfrac><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup><msubsup><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mn>0</mn></msub></mrow></mrow><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\exp\left\{-\frac{1}{2}\left(\frac{1}{\frac{(\sigma_{t}^{2}-\frac{\alpha_{t}^{2}}{\alpha_{t-1}^{2}}\sigma_{t-1}^{2})\sigma_{t-1}^{2}}{\sigma_{t}^{2}}}\right)\left[\mathbf{x}_{t-1}^{2}-2\left(\frac{\frac{\alpha_{t}}{\alpha_{t-1}}\mathbf{x}_{t}\sigma_{t-1}^{2}+(\sigma_{t}^{2}-\frac{\alpha_{t}^{2}}{\alpha_{t-1}^{2}}\sigma_{t-1}^{2})\alpha_{t-1}\mathbf{x}_{0}}{\sigma_{t}^{2}}\right)\mathbf{x}_{t-1}\right]\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex20.m1" class="ltx_Math" alttext="\displaystyle\propto" display="inline" intent=":literal"><semantics><mo>∝</mo><annotation encoding="application/x-tex">\displaystyle\propto</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex20.m2" class="ltx_Math" alttext="\displaystyle\mathcal{N}(\mathbf{x}_{t-1};\frac{\frac{\alpha_{t}}{\alpha_{t-1}}\mathbf{x}_{t}\sigma_{t-1}^{2}+(\sigma_{t}^{2}-\frac{\alpha_{t}^{2}}{\alpha_{t-1}^{2}}\sigma_{t-1}^{2})\alpha_{t-1}\mathbf{x}_{0}}{\sigma_{t}^{2}},\frac{(\sigma_{t}^{2}-\frac{\alpha_{t}^{2}}{\alpha_{t-1}^{2}}\sigma_{t-1}^{2})\sigma_{t-1}^{2}}{\sigma_{t}^{2}}\mathbf{I})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mfrac><msub><mi>α</mi><mi>t</mi></msub><msub><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup><mo>−</mo><mrow><mfrac><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup><msubsup><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mn>0</mn></msub></mrow></mrow><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup></mfrac></mstyle><mo>,</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup><mo>−</mo><mrow><mfrac><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup><msubsup><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝐈</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{N}(\mathbf{x}_{t-1};\frac{\frac{\alpha_{t}}{\alpha_{t-1}}\mathbf{x}_{t}\sigma_{t-1}^{2}+(\sigma_{t}^{2}-\frac{\alpha_{t}^{2}}{\alpha_{t-1}^{2}}\sigma_{t-1}^{2})\alpha_{t-1}\mathbf{x}_{0}}{\sigma_{t}^{2}},\frac{(\sigma_{t}^{2}-\frac{\alpha_{t}^{2}}{\alpha_{t-1}^{2}}\sigma_{t-1}^{2})\sigma_{t-1}^{2}}{\sigma_{t}^{2}}\mathbf{I})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p3.2" class="ltx_p">where in the fourth Equation, <math id="A2.SS2.p3.m3" class="ltx_Math" alttext="C(\mathbf{x}_{t},\mathbf{x}_{0})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C(\mathbf{x}_{t},\mathbf{x}_{0})</annotation></semantics></math> is a constant term with respect to <math id="A2.SS2.p3.m4" class="ltx_Math" alttext="\mathbf{x}_{t-1}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{x}_{t-1}</annotation></semantics></math> computed as a combination of only <math id="A2.SS2.p3.m5" class="ltx_Math" alttext="\mathbf{x}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathbf{x}_{t}</annotation></semantics></math>, <math id="A2.SS2.p3.m6" class="ltx_Math" alttext="\mathbf{x}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\mathbf{x}_{0}</annotation></semantics></math>, and <math id="A2.SS2.p3.m7" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> values.
We have therefore shown that at each step, <math id="A2.SS2.p3.m8" class="ltx_Math" alttext="\mathbf{x}_{t-1}\sim q(\mathbf{x}_{t-1}|\mathbf{x}_{t},\mathbf{x}_{0})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>∼</mo><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝐱</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝐱</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}_{t-1}\sim q(\mathbf{x}_{t-1}|\mathbf{x}_{t},\mathbf{x}_{0})</annotation></semantics></math> is normally distributed, with mean <math id="A2.SS2.p3.m9" class="ltx_Math" alttext="\bm{\mu}_{q}(\mathbf{x}_{t},\mathbf{x}_{0})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝝁</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{\mu}_{q}(\mathbf{x}_{t},\mathbf{x}_{0})</annotation></semantics></math> that is a function of <math id="A2.SS2.p3.m10" class="ltx_Math" alttext="\mathbf{x}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathbf{x}_{t}</annotation></semantics></math> and <math id="A2.SS2.p3.m11" class="ltx_Math" alttext="\mathbf{x}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\mathbf{x}_{0}</annotation></semantics></math>, and variance <math id="A2.SS2.p3.m12" class="ltx_Math" alttext="\bm{\Sigma}_{q}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝚺</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{\Sigma}_{q}(t)</annotation></semantics></math> as a function of <math id="A2.SS2.p3.m13" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> and <math id="A2.SS2.p3.m14" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> coefficients. These coefficients are known and fixed at each timestep; they are either set permanently when modeled as hyperparameters, or treated as the current inference output of a network that seeks to model them.</p>
</div>
<div id="A2.SS2.p4" class="ltx_para ltx_noindent">
<p id="A2.SS2.p4.1" class="ltx_p">We can then set the variances of the two Gaussians to match exactly, optimizing the KL Divergence term reduces to minimizing the difference between the means of the two distributions:</p>
<table id="A2.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex21.m2" class="ltx_math_unparsed" alttext="\displaystyle\mathop{\arg\min}\limits_{\theta}D_{\mathrm{KL}}(q(\mathbf{x}_{t-1}|\mathbf{x}_{t},\mathbf{x}_{0})\|p_{\theta}(\mathbf{x}_{t-1}|\mathbf{x}_{t}))" display="inline" intent=":literal"><semantics><mrow><munder><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mi>min</mi></mrow><mi>θ</mi></munder><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo stretchy="false">(</mo><mi>q</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>p</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathop{\arg\min}\limits_{\theta}D_{\mathrm{KL}}(q(\mathbf{x}_{t-1}|\mathbf{x}_{t},\mathbf{x}_{0})\|p_{\theta}(\mathbf{x}_{t-1}|\mathbf{x}_{t}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E18.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E18.m2" class="ltx_Math" alttext="\displaystyle\mathop{\arg\min}\limits_{\theta}\frac{1}{2\sigma_{q}^{2}(t)}\left[\left\|\bm{\mu}_{\theta}(\mathbf{x}_{t},t)-\bm{\mu}_{q}(\mathbf{x}_{t},\mathbf{x}_{0})\right\|_{2}^{2}\right]," display="inline" intent=":literal"><semantics><mrow><mrow><munder><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mi>min</mi></mrow><mi>θ</mi></munder><mo lspace="0.167em">⁡</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>q</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo>‖</mo><mrow><mrow><msub><mi>𝝁</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝝁</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathop{\arg\min}\limits_{\theta}\frac{1}{2\sigma_{q}^{2}(t)}\left[\left\|\bm{\mu}_{\theta}(\mathbf{x}_{t},t)-\bm{\mu}_{q}(\mathbf{x}_{t},\mathbf{x}_{0})\right\|_{2}^{2}\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p4.2" class="ltx_p">where <math id="A2.SS2.p4.m1" class="ltx_Math" alttext="\sigma_{q}^{2}(t)=\frac{(\sigma_{t}^{2}-\frac{\alpha_{t}^{2}}{\alpha_{t-1}^{2}}\sigma_{t-1}^{2})\sigma_{t-1}^{2}}{\sigma_{t}^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>σ</mi><mi>q</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup><mo>−</mo><mrow><mfrac><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup><msubsup><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup></mfrac></mrow><annotation encoding="application/x-tex">\sigma_{q}^{2}(t)=\frac{(\sigma_{t}^{2}-\frac{\alpha_{t}^{2}}{\alpha_{t-1}^{2}}\sigma_{t-1}^{2})\sigma_{t-1}^{2}}{\sigma_{t}^{2}}</annotation></semantics></math>, the derivation is the same as in Eq. (92) in <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib45" title="" class="ltx_ref">Luo (2022)</a></cite>, so we skip the derivation here. To derive the score matching funciton, we appeal to Tweedie’s Formula <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib15" title="" class="ltx_ref">Efron (2011)</a></cite>, which states <math id="A2.SS2.p4.m2" class="ltx_Math" alttext="\mathbb{E}[\bm{\mu}_{z}|z]=z+\bm{\Sigma}_{z}\nabla_{z}\log q(z)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝝁</mi><mi>z</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi>z</mi><mo>+</mo><mrow><msub><mi>𝚺</mi><mi>z</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msub><mo>∇</mo><mi>z</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[\bm{\mu}_{z}|z]=z+\bm{\Sigma}_{z}\nabla_{z}\log q(z)</annotation></semantics></math> for a given Gausssion variable <math id="A2.SS2.p4.m3" class="ltx_Math" alttext="z\sim\mathcal{N}(z;\bm{\mu}_{z},\bm{\Sigma}_{z})" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo>,</mo><msub><mi>𝝁</mi><mi>z</mi></msub><mo>,</mo><msub><mi>𝚺</mi><mi>z</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z\sim\mathcal{N}(z;\bm{\mu}_{z},\bm{\Sigma}_{z})</annotation></semantics></math>.
In this case, we apply it to predict the true posterior mean of <math id="A2.SS2.p4.m4" class="ltx_Math" alttext="\mathbf{x}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathbf{x}_{t}</annotation></semantics></math> given its samples. We can obtain:</p>
<table id="A2.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex22.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\bm{\mu}_{\mathbf{x}_{t}}|\mathbf{x}_{t}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝝁</mi><msub><mi>𝐱</mi><mi>t</mi></msub></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\bm{\mu}_{\mathbf{x}_{t}}|\mathbf{x}_{t}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex22.m2" class="ltx_Math" alttext="\displaystyle=\mathbf{x}_{t}+\sigma_{t}^{2}\nabla_{\mathbf{x}_{t}}\log q(\mathbf{x}_{t})=\alpha_{t}\mathbf{x}_{0}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝐱</mi><mi>t</mi></msub><mo>+</mo><mrow><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msub><mo>∇</mo><msub><mi>𝐱</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>=</mo><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbf{x}_{t}+\sigma_{t}^{2}\nabla_{\mathbf{x}_{t}}\log q(\mathbf{x}_{t})=\alpha_{t}\mathbf{x}_{0}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E19.m1" class="ltx_Math" alttext="\displaystyle\therefore\mathbf{x}_{0}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∴</mo><msub><mi>𝐱</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\therefore\mathbf{x}_{0}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E19.m2" class="ltx_Math" alttext="\displaystyle=\frac{\mathbf{x}_{t}+\sigma_{t}^{2}\nabla_{\mathbf{x}_{t}}\log q(\mathbf{x}_{t})}{\alpha_{t}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝐱</mi><mi>t</mi></msub><mo>+</mo><mrow><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msub><mo>∇</mo><msub><mi>𝐱</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><msub><mi>α</mi><mi>t</mi></msub></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbf{x}_{t}+\sigma_{t}^{2}\nabla_{\mathbf{x}_{t}}\log q(\mathbf{x}_{t})}{\alpha_{t}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p4.3" class="ltx_p">Then, we can plug Eq. (<a href="#A2.Ex22" title="In B.2 Derivation of Eq. () ‣ Appendix B Proof ‣ Learning Robust Diffusion Models from Imprecise Supervision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>) into our ground-truth denoising transition mean <math id="A2.SS2.p4.m5" class="ltx_Math" alttext="\bm{\mu}_{q}(\mathbf{x}_{t},\mathbf{x}_{0})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝝁</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{\mu}_{q}(\mathbf{x}_{t},\mathbf{x}_{0})</annotation></semantics></math> once again and derive a new form:</p>
<table id="A2.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex23.m1" class="ltx_Math" alttext="\displaystyle\bm{\mu}_{q}(\mathbf{x}_{t},\mathbf{x}_{0})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝝁</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\bm{\mu}_{q}(\mathbf{x}_{t},\mathbf{x}_{0})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex23.m2" class="ltx_Math" alttext="\displaystyle=\frac{\frac{\alpha_{t}}{\alpha_{t-1}}\sigma_{t-1}^{2}\mathbf{x}_{t}+(\sigma_{t}^{2}-\frac{\alpha_{t}^{2}}{\alpha_{t-1}^{2}}\sigma_{t-1}^{2})\alpha_{t-1}\cdot\frac{\mathbf{x}_{t}+\sigma_{t}^{2}\nabla_{\mathbf{x}_{t}}\log q(\mathbf{x}_{t})}{\alpha_{t}}}{\sigma_{t}^{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mfrac><msub><mi>α</mi><mi>t</mi></msub><msub><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo>+</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup><mo>−</mo><mrow><mfrac><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup><msubsup><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mrow><msub><mi>𝐱</mi><mi>t</mi></msub><mo>+</mo><mrow><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msub><mo>∇</mo><msub><mi>𝐱</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><msub><mi>α</mi><mi>t</mi></msub></mfrac></mrow></mrow><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\frac{\alpha_{t}}{\alpha_{t-1}}\sigma_{t-1}^{2}\mathbf{x}_{t}+(\sigma_{t}^{2}-\frac{\alpha_{t}^{2}}{\alpha_{t-1}^{2}}\sigma_{t-1}^{2})\alpha_{t-1}\cdot\frac{\mathbf{x}_{t}+\sigma_{t}^{2}\nabla_{\mathbf{x}_{t}}\log q(\mathbf{x}_{t})}{\alpha_{t}}}{\sigma_{t}^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex24.m1" class="ltx_Math" alttext="\displaystyle=\frac{\frac{\alpha_{t}}{\alpha_{t-1}}\sigma_{t-1}^{2}}{\sigma_{t}^{2}}\mathbf{x}_{t}+\frac{\sigma_{t}^{2}-\frac{\alpha_{t}^{2}}{\alpha_{t-1}^{2}}\sigma_{t-1}^{2}}{\sigma_{t}^{2}\frac{\alpha_{t}}{\alpha_{t-1}}}\mathbf{x}_{t}+\frac{(\sigma_{t}^{2}-\frac{\alpha_{t}^{2}}{\alpha_{t-1}^{2}}\sigma_{t-1}^{2})\sigma_{t}^{2}\nabla_{\mathbf{x}_{t}}\log q(\mathbf{x}_{t})}{\sigma_{t}^{2}\frac{\alpha_{t}}{\alpha_{t-1}}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mfrac><msub><mi>α</mi><mi>t</mi></msub><msub><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup><mo>−</mo><mrow><mfrac><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup><msubsup><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mrow><mrow><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mfrac><msub><mi>α</mi><mi>t</mi></msub><msub><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mfrac></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup><mo>−</mo><mrow><mfrac><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup><msubsup><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msub><mo>∇</mo><msub><mi>𝐱</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mrow><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mfrac><msub><mi>α</mi><mi>t</mi></msub><msub><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mfrac></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\frac{\alpha_{t}}{\alpha_{t-1}}\sigma_{t-1}^{2}}{\sigma_{t}^{2}}\mathbf{x}_{t}+\frac{\sigma_{t}^{2}-\frac{\alpha_{t}^{2}}{\alpha_{t-1}^{2}}\sigma_{t-1}^{2}}{\sigma_{t}^{2}\frac{\alpha_{t}}{\alpha_{t-1}}}\mathbf{x}_{t}+\frac{(\sigma_{t}^{2}-\frac{\alpha_{t}^{2}}{\alpha_{t-1}^{2}}\sigma_{t-1}^{2})\sigma_{t}^{2}\nabla_{\mathbf{x}_{t}}\log q(\mathbf{x}_{t})}{\sigma_{t}^{2}\frac{\alpha_{t}}{\alpha_{t-1}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex25.m1" class="ltx_Math" alttext="\displaystyle=\frac{\alpha_{t-1}}{\alpha_{t}}\mathbf{x}_{t}+\left(\frac{\alpha_{t-1}}{\alpha_{t}}\sigma_{t}^{2}-\frac{\alpha_{t}}{\alpha_{t-1}}\sigma_{t-1}^{2}\right)\nabla_{\mathbf{x}_{t}}\log q(\mathbf{x}_{t})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msub><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><msub><mi>α</mi><mi>t</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msub><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><msub><mi>α</mi><mi>t</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>α</mi><mi>t</mi></msub><msub><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><msub><mo>∇</mo><msub><mi>𝐱</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\alpha_{t-1}}{\alpha_{t}}\mathbf{x}_{t}+\left(\frac{\alpha_{t-1}}{\alpha_{t}}\sigma_{t}^{2}-\frac{\alpha_{t}}{\alpha_{t-1}}\sigma_{t-1}^{2}\right)\nabla_{\mathbf{x}_{t}}\log q(\mathbf{x}_{t})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E20.m1" class="ltx_Math" alttext="\displaystyle=\frac{\alpha_{t-1}}{\alpha_{t}}\left[\mathbf{x}_{t}+\left(\sigma_{t}^{2}-\frac{\alpha_{t}^{2}}{\alpha_{t-1}^{2}}\sigma_{t-1}^{2}\right)\mathbf{s}_{\theta}(\mathbf{x}_{t},t)\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><msub><mi>α</mi><mi>t</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mi>𝐱</mi><mi>t</mi></msub><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup><msubsup><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐬</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\alpha_{t-1}}{\alpha_{t}}\left[\mathbf{x}_{t}+\left(\sigma_{t}^{2}-\frac{\alpha_{t}^{2}}{\alpha_{t-1}^{2}}\sigma_{t-1}^{2}\right)\mathbf{s}_{\theta}(\mathbf{x}_{t},t)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p4.4" class="ltx_p">Finally, we plug Eq. (<a href="#A2.Ex23" title="In B.2 Derivation of Eq. () ‣ Appendix B Proof ‣ Learning Robust Diffusion Models from Imprecise Supervision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">20</span></a>) into our optimization function Eq. (<a href="#A2.Ex26" title="B.2 Derivation of Eq. () ‣ Appendix B Proof ‣ Learning Robust Diffusion Models from Imprecise Supervision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a>), and we can get:</p>
<table id="A2.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex26.m2" class="ltx_math_unparsed" alttext="\displaystyle\mathop{\arg\min}\limits_{\theta}D_{\mathrm{KL}}(q(\mathbf{x}_{t-1}|\mathbf{x}_{t},\mathbf{x}_{0})\|p_{\theta}(\mathbf{x}_{t-1}|\mathbf{x}_{t}))" display="inline" intent=":literal"><semantics><mrow><munder><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mi>min</mi></mrow><mi>θ</mi></munder><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo stretchy="false">(</mo><mi>q</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>p</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathop{\arg\min}\limits_{\theta}D_{\mathrm{KL}}(q(\mathbf{x}_{t-1}|\mathbf{x}_{t},\mathbf{x}_{0})\|p_{\theta}(\mathbf{x}_{t-1}|\mathbf{x}_{t}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex27.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex27.m2" class="ltx_Math" alttext="\displaystyle\mathop{\arg\min}\limits_{\theta}\frac{1}{2\sigma_{q}^{2}(t)}\left[\left\|\bm{\mu}_{\theta}(\mathbf{x}_{t},t)-\bm{\mu}_{q}(\mathbf{x}_{t},\mathbf{x}_{0})\right\|_{2}^{2}\right]" display="inline" intent=":literal"><semantics><mrow><munder><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mi>min</mi></mrow><mi>θ</mi></munder><mo lspace="0.167em">⁡</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>q</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo>‖</mo><mrow><mrow><msub><mi>𝝁</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝝁</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathop{\arg\min}\limits_{\theta}\frac{1}{2\sigma_{q}^{2}(t)}\left[\left\|\bm{\mu}_{\theta}(\mathbf{x}_{t},t)-\bm{\mu}_{q}(\mathbf{x}_{t},\mathbf{x}_{0})\right\|_{2}^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex28.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex28.m2" class="ltx_Math" alttext="\displaystyle\mathop{\arg\min}\limits_{\theta}\frac{1}{2\frac{(\sigma_{t}^{2}-\frac{\alpha_{t}^{2}}{\alpha_{t-1}^{2}}\sigma_{t-1}^{2})\sigma_{t-1}^{2}}{\sigma_{t}^{2}}}\cdot(\frac{\alpha_{t-1}}{\alpha_{t}})^{2}\cdot(\sigma_{t}^{2}-\frac{\alpha_{t}^{2}}{\alpha_{t-1}^{2}}\sigma_{t-1}^{2})^{2}\|\mathbf{s}_{\theta}(\mathbf{x}_{t},t)-\nabla_{\mathbf{x}_{t}}\log q(\mathbf{x}_{t})\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><munder><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mi>min</mi></mrow><mi>θ</mi></munder><mo lspace="0.167em">⁡</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup><mo>−</mo><mrow><mfrac><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup><msubsup><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup></mfrac></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><msub><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><msub><mi>α</mi><mi>t</mi></msub></mfrac></mstyle><mo rspace="0.055em" stretchy="false">)</mo></mrow><mn>2</mn></msup><mo rspace="0.222em">⋅</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup><msubsup><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>𝐬</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mo>∇</mo><msub><mi>𝐱</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathop{\arg\min}\limits_{\theta}\frac{1}{2\frac{(\sigma_{t}^{2}-\frac{\alpha_{t}^{2}}{\alpha_{t-1}^{2}}\sigma_{t-1}^{2})\sigma_{t-1}^{2}}{\sigma_{t}^{2}}}\cdot(\frac{\alpha_{t-1}}{\alpha_{t}})^{2}\cdot(\sigma_{t}^{2}-\frac{\alpha_{t}^{2}}{\alpha_{t-1}^{2}}\sigma_{t-1}^{2})^{2}\|\mathbf{s}_{\theta}(\mathbf{x}_{t},t)-\nabla_{\mathbf{x}_{t}}\log q(\mathbf{x}_{t})\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex29.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex29.m2" class="ltx_Math" alttext="\displaystyle\frac{\sigma_{t}^{2}}{2}(\frac{\sigma_{t}^{2}\alpha_{t-1}^{2}}{\sigma_{t-1}^{2}\alpha_{t}^{2}}-1)\|\mathbf{s}_{\theta}(\mathbf{x}_{t},t)-\nabla_{\mathbf{x}_{t}}\log q(\mathbf{x}_{t})\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow><mrow><msubsup><mi>σ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>𝐬</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mo>∇</mo><msub><mi>𝐱</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\sigma_{t}^{2}}{2}(\frac{\sigma_{t}^{2}\alpha_{t-1}^{2}}{\sigma_{t-1}^{2}\alpha_{t}^{2}}-1)\|\mathbf{s}_{\theta}(\mathbf{x}_{t},t)-\nabla_{\mathbf{x}_{t}}\log q(\mathbf{x}_{t})\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A2.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.3 </span>Derivation of Varitional Lower Bound Eq. (<a href="#S3.E7" title="In 3.1 Unified Learning Objective ‣ 3 Methodology ‣ Learning Robust Diffusion Models from Imprecise Supervision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>)</h3>

<div id="A2.SS3.p1" class="ltx_para ltx_noindent">
<p id="A2.SS3.p1.1" class="ltx_p">To model <math id="A2.SS3.p1.m1" class="ltx_Math" alttext="\log p_{\theta}(X,Z)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\log p_{\theta}(X,Z)</annotation></semantics></math>, we introduce an auxiliary distribution <math id="A2.SS3.p1.m2" class="ltx_Math" alttext="Q(Y)" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Q(Y)</annotation></semantics></math> over the latent variable <math id="A2.SS3.p1.m3" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>:</p>
<table id="A2.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex30.m1" class="ltx_Math" alttext="\displaystyle\log p_{\theta}(X,Z)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\log p_{\theta}(X,Z)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex30.m2" class="ltx_Math" alttext="\displaystyle=\int Q(Y)\log p_{\theta}(X,Z)dY" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>Y</mi></mrow></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\int Q(Y)\log p_{\theta}(X,Z)dY</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex31.m1" class="ltx_Math" alttext="\displaystyle=\int Q(Y)\log p_{\theta}(X,Z)\frac{p_{\theta}(Y|X,Z)}{p_{\theta}(Y|X,Z)}dY" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>X</mi><mo>,</mo><mi>Z</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>X</mi><mo>,</mo><mi>Z</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>Y</mi></mrow></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\int Q(Y)\log p_{\theta}(X,Z)\frac{p_{\theta}(Y|X,Z)}{p_{\theta}(Y|X,Z)}dY</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex32.m1" class="ltx_Math" alttext="\displaystyle=\int Q(Y)\log\frac{p_{\theta}(X,Y,Z)}{Q(Y)}dY-\int Q(Y)\log\frac{p_{\theta}(Y|X,Z)}{Q(Y)}dY," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mfrac><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>Y</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>Y</mi></mrow></mrow></mrow></mstyle><mo>−</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mfrac><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>X</mi><mo>,</mo><mi>Z</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>Y</mi></mrow></mrow></mrow></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\int Q(Y)\log\frac{p_{\theta}(X,Y,Z)}{Q(Y)}dY-\int Q(Y)\log\frac{p_{\theta}(Y|X,Z)}{Q(Y)}dY,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.p1.2" class="ltx_p">where the first term is the ELBO and the second term is the KL divergence <math id="A2.SS3.p1.m4" class="ltx_math_unparsed" alttext="\mathcal{D}_{\mathrm{KL}}(Q(Y)||p_{\theta}(Y|X,Z))" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>KL</mi></msub><mrow><mo stretchy="false">(</mo><mi>Q</mi><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>p</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>X</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{D}_{\mathrm{KL}}(Q(Y)||p_{\theta}(Y|X,Z))</annotation></semantics></math>.
Since the KL divergence is non-negative, maximizing the ELBO provides a valid surrogate for maximizing <math id="A2.SS3.p1.m5" class="ltx_Math" alttext="\log p_{\theta}(X,Z)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\log p_{\theta}(X,Z)</annotation></semantics></math>.
Replacing <math id="A2.SS3.p1.m6" class="ltx_Math" alttext="Q(Y)" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Q(Y)</annotation></semantics></math> with <math id="A2.SS3.p1.m7" class="ltx_Math" alttext="p_{\phi}(Y|X,Z)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>X</mi><mo>,</mo><mi>Z</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\phi}(Y|X,Z)</annotation></semantics></math> at each iteration will obtain as follows:</p>
<table id="A2.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex33.m1" class="ltx_Math" alttext="\displaystyle\theta^{*}=" display="inline" intent=":literal"><semantics><mrow><msup><mi>θ</mi><mo>∗</mo></msup><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\theta^{*}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex33.m2" class="ltx_Math" alttext="\displaystyle\underset{\theta}{\arg\max}\ \log p_{\theta}(X,Z)" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mi>max</mi></mrow><mo mathsize="0.700em">𝜃</mo></munder><mo lspace="0.667em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\underset{\theta}{\arg\max}\ \log p_{\theta}(X,Z)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex34.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex34.m2" class="ltx_Math" alttext="\displaystyle\underset{\theta}{\arg\max}\ \mathbb{E}_{p_{\phi}(Y|X,Z)}[\log p_{\theta}(X,Y,Z)]" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mi>max</mi></mrow><mo mathsize="0.700em">𝜃</mo></munder><mo lspace="0.500em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>p</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>X</mi><mo>,</mo><mi>Z</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>Y</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\underset{\theta}{\arg\max}\ \mathbb{E}_{p_{\phi}(Y|X,Z)}[\log p_{\theta}(X,Y,Z)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex35.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex35.m2" class="ltx_Math" alttext="\displaystyle\underset{\theta}{\arg\max}\ \mathbb{E}_{p_{\phi}(Y|X,Z)}[\log p_{\theta}(X|Z)+\log p_{\theta}(Y|X,Z)+\log p_{\theta}(Z)]" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mi>max</mi></mrow><mo mathsize="0.700em">𝜃</mo></munder><mo lspace="0.500em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>p</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>X</mi><mo>,</mo><mi>Z</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo lspace="0em" rspace="0em">|</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>X</mi><mo>,</mo><mi>Z</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\underset{\theta}{\arg\max}\ \mathbb{E}_{p_{\phi}(Y|X,Z)}[\log p_{\theta}(X|Z)+\log p_{\theta}(Y|X,Z)+\log p_{\theta}(Z)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex36.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex36.m2" class="ltx_Math" alttext="\displaystyle\underset{\theta}{\arg\max}\ \mathbb{E}_{p_{\phi}(Y|X,Z)}[\log p_{\theta}(X|Z)]+\mathbb{E}_{p_{\phi}(Y|X,Z)}[\log p_{\theta}(Y|X,Z)]" display="inline" intent=":literal"><semantics><mrow><mrow><munder accentunder="true"><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mi>max</mi></mrow><mo mathsize="0.700em">𝜃</mo></munder><mo lspace="0.500em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>p</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>X</mi><mo>,</mo><mi>Z</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo lspace="0em" rspace="0em">|</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>𝔼</mi><mrow><msub><mi>p</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>X</mi><mo>,</mo><mi>Z</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>X</mi><mo>,</mo><mi>Z</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\underset{\theta}{\arg\max}\ \mathbb{E}_{p_{\phi}(Y|X,Z)}[\log p_{\theta}(X|Z)]+\mathbb{E}_{p_{\phi}(Y|X,Z)}[\log p_{\theta}(Y|X,Z)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex37.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex37.m2" class="ltx_Math" alttext="\displaystyle\underset{\theta}{\arg\max}\ \log p_{\theta}(X|Z)+\mathbb{E}_{p_{\phi}(Y|X,Z)}[\log p_{\theta}(Y|X,Z)]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><munder accentunder="true"><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mi>max</mi></mrow><mo mathsize="0.700em">𝜃</mo></munder><mo lspace="0.667em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo lspace="0em" rspace="0em">|</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>𝔼</mi><mrow><msub><mi>p</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>X</mi><mo>,</mo><mi>Z</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>X</mi><mo>,</mo><mi>Z</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\underset{\theta}{\arg\max}\ \log p_{\theta}(X|Z)+\mathbb{E}_{p_{\phi}(Y|X,Z)}[\log p_{\theta}(Y|X,Z)].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.p1.3" class="ltx_p">which is exactly the variational lower bound presented in Eq. (<a href="#S3.E7" title="In 3.1 Unified Learning Objective ‣ 3 Methodology ‣ Learning Robust Diffusion Models from Imprecise Supervision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>).</p>
</div>
</section>
<section id="A2.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.4 </span>Derivation of Conditional ELBO in Eq. (<a href="#S3.E8" title="In 3.2 Generative Objective: Modeling the Imprecise Data Distribution ‣ 3 Methodology ‣ Learning Robust Diffusion Models from Imprecise Supervision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>)</h3>

<div id="A2.SS4.p1" class="ltx_para ltx_noindent">
<p id="A2.SS4.p1.1" class="ltx_p">We provide a derivation of conditional ELBO in the following, which is similar to the unconditional ELBO in <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib28" title="" class="ltx_ref">Ho et al. (2020)</a></cite>.</p>
<table id="A2.Ex38" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex38X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex38X.m2" class="ltx_Math" alttext="\displaystyle\log p_{\theta}\left(\mathbf{x}_{0}\!\mid\!z\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mpadded style="width:0.052em;" width="0.052em"><mo fence="true" lspace="0em">∣</mo></mpadded><mi>z</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\log p_{\theta}\left(\mathbf{x}_{0}\!\mid\!z\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex38Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex38Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
