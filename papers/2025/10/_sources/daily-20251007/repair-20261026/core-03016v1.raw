<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex38Xg.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex38Xg.m3" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{q\left(\mathbf{x}_{1:T}\mid\mathbf{x}_{0},z\right)}\left[\log\frac{\prod_{i=0}^{T-1}p_{\theta}\left(\mathbf{x}_{i}\!\mid\!\mathbf{x}_{i+1},z\right)}{\prod_{i=0}^{T-1}q\left(\mathbf{x}_{i}\!\mid\!\mathbf{x}_{i+1},\mathbf{x}_{0},z\right)}-\log\frac{q\left(\mathbf{x}_{T}\!\mid\!\mathbf{x}_{0},z\right)}{p_{\theta}\left(\mathbf{x}_{T}\!\mid\!z\right)}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>q</mi><mo>(</mo><mi>𝐱</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐱</mi><msub><mrow></mrow><mn>0</mn></msub><mo>,</mo><mi>z</mi><mo>)</mo></mrow></msub><mo>[</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>𝐱</mi><mi>i</mi></msub><mpadded style="width:0.052em;" width="0.052em"><mo fence="true" lspace="0em">∣</mo></mpadded><mrow><msub><mi>𝐱</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>z</mi></mrow><mo>)</mo></mrow></mrow></mrow><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mi>q</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>𝐱</mi><mi>i</mi></msub><mpadded style="width:0.052em;" width="0.052em"><mo fence="true" lspace="0em">∣</mo></mpadded><mrow><msub><mi>𝐱</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo>,</mo><mi>z</mi></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>−</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi>q</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>𝐱</mi><mi>T</mi></msub><mpadded style="width:0.052em;" width="0.052em"><mo fence="true" lspace="0em">∣</mo></mpadded><mrow><msub><mi>𝐱</mi><mn>0</mn></msub><mo>,</mo><mi>z</mi></mrow><mo>)</mo></mrow></mrow><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>𝐱</mi><mi>T</mi></msub><mpadded style="width:0.052em;" width="0.052em"><mo fence="true" lspace="0em">∣</mo></mpadded><mi>z</mi><mo>)</mo></mrow></mrow></mfrac></mstyle><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{q\left(\mathbf{x}_{1:T}\mid\mathbf{x}_{0},z\right)}\left[\log\frac{\prod_{i=0}^{T-1}p_{\theta}\left(\mathbf{x}_{i}\!\mid\!\mathbf{x}_{i+1},z\right)}{\prod_{i=0}^{T-1}q\left(\mathbf{x}_{i}\!\mid\!\mathbf{x}_{i+1},\mathbf{x}_{0},z\right)}-\log\frac{q\left(\mathbf{x}_{T}\!\mid\!\mathbf{x}_{0},z\right)}{p_{\theta}\left(\mathbf{x}_{T}\!\mid\!z\right)}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex38Xh"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex38Xh.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex38Xh.m3" class="ltx_Math" alttext="\displaystyle\sum_{i=0}^{T-1}\mathbb{E}_{q\left(\mathbf{x}_{i},\mathbf{x}_{i+1}\mid\mathbf{x}_{0},z\right)}\left[\log\frac{p_{\theta}\left(\mathbf{x}_{i}\!\mid\!\mathbf{x}_{i+1},z\right)}{q\left(\mathbf{x}_{i}\!\mid\!\mathbf{x}_{i+1},\mathbf{x}_{0},z\right)}\right]-D_{\mathrm{KL}}\left(q\left(\mathbf{x}_{T}\!\mid\!\mathbf{x}_{0},z\right)\|p_{\theta}\left(\mathbf{x}_{T}\!\mid\!z\right)\right)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>q</mi><mo>(</mo><mi>𝐱</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>𝐱</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐱</mi><msub><mrow></mrow><mn>0</mn></msub><mo>,</mo><mi>z</mi><mo>)</mo></mrow></msub><mo>[</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>𝐱</mi><mi>i</mi></msub><mpadded style="width:0.052em;" width="0.052em"><mo fence="true" lspace="0em">∣</mo></mpadded><mrow><msub><mi>𝐱</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>z</mi></mrow><mo>)</mo></mrow></mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>𝐱</mi><mi>i</mi></msub><mpadded style="width:0.052em;" width="0.052em"><mo fence="true" lspace="0em">∣</mo></mpadded><mrow><msub><mi>𝐱</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo>,</mo><mi>z</mi></mrow><mo>)</mo></mrow></mrow></mfrac></mstyle><mo>]</mo><mo>−</mo><mi>D</mi><msub><mrow></mrow><mi>KL</mi></msub><mo>(</mo><mi>q</mi><mo>(</mo><mi>𝐱</mi><msub><mrow></mrow><mi>T</mi></msub><mpadded style="width:0.219em;" width="0.219em"><mo lspace="0em">∣</mo></mpadded><mi>𝐱</mi><msub><mrow></mrow><mn>0</mn></msub><mo>,</mo><mi>z</mi><mo>)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>(</mo><mi>𝐱</mi><msub><mrow></mrow><mi>T</mi></msub><mpadded style="width:0.219em;" width="0.219em"><mo lspace="0em">∣</mo></mpadded><mi>z</mi><mo>)</mo><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=0}^{T-1}\mathbb{E}_{q\left(\mathbf{x}_{i},\mathbf{x}_{i+1}\mid\mathbf{x}_{0},z\right)}\left[\log\frac{p_{\theta}\left(\mathbf{x}_{i}\!\mid\!\mathbf{x}_{i+1},z\right)}{q\left(\mathbf{x}_{i}\!\mid\!\mathbf{x}_{i+1},\mathbf{x}_{0},z\right)}\right]-D_{\mathrm{KL}}\left(q\left(\mathbf{x}_{T}\!\mid\!\mathbf{x}_{0},z\right)\|p_{\theta}\left(\mathbf{x}_{T}\!\mid\!z\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex38Xi"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex38Xi.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex38Xi.m3" class="ltx_Math" alttext="\displaystyle\sum_{i=0}^{T-1}\mathbb{E}_{q\left(\mathbf{x}_{i+1}\mid\mathbf{x}_{0},z\right)}\mathbb{E}_{q\left(\mathbf{x}_{i}\mid\mathbf{x}_{i+1},\mathbf{x}_{0},z\right)}\left[\log\frac{p_{\theta}\left(\mathbf{x}_{i}\!\mid\!\mathbf{x}_{i+1},z\right)}{q\left(\mathbf{x}_{i}\!\mid\!\mathbf{x}_{i+1},\mathbf{x}_{0},z\right)}\right]-D_{\mathrm{KL}}\left(q\left(\mathbf{x}_{T}\!\mid\!\mathbf{x}_{0},z\right)\|p_{\theta}\left(\mathbf{x}_{T}\!\mid\!z\right)\right)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>𝐱</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝐱</mi><mn>0</mn></msub><mo>,</mo><mi>z</mi></mrow><mo>)</mo></mrow></mrow></msub><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>𝐱</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝐱</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo>,</mo><mi>z</mi></mrow><mo>)</mo></mrow></mrow></msub><mo>[</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>𝐱</mi><mi>i</mi></msub><mpadded style="width:0.052em;" width="0.052em"><mo fence="true" lspace="0em">∣</mo></mpadded><mrow><msub><mi>𝐱</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>z</mi></mrow><mo>)</mo></mrow></mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>𝐱</mi><mi>i</mi></msub><mpadded style="width:0.052em;" width="0.052em"><mo fence="true" lspace="0em">∣</mo></mpadded><mrow><msub><mi>𝐱</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo>,</mo><mi>z</mi></mrow><mo>)</mo></mrow></mrow></mfrac></mstyle><mo>]</mo><mo>−</mo><mi>D</mi><msub><mrow></mrow><mi>KL</mi></msub><mo>(</mo><mi>q</mi><mo>(</mo><mi>𝐱</mi><msub><mrow></mrow><mi>T</mi></msub><mpadded style="width:0.219em;" width="0.219em"><mo lspace="0em">∣</mo></mpadded><mi>𝐱</mi><msub><mrow></mrow><mn>0</mn></msub><mo>,</mo><mi>z</mi><mo>)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>(</mo><mi>𝐱</mi><msub><mrow></mrow><mi>T</mi></msub><mpadded style="width:0.219em;" width="0.219em"><mo lspace="0em">∣</mo></mpadded><mi>z</mi><mo>)</mo><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=0}^{T-1}\mathbb{E}_{q\left(\mathbf{x}_{i+1}\mid\mathbf{x}_{0},z\right)}\mathbb{E}_{q\left(\mathbf{x}_{i}\mid\mathbf{x}_{i+1},\mathbf{x}_{0},z\right)}\left[\log\frac{p_{\theta}\left(\mathbf{x}_{i}\!\mid\!\mathbf{x}_{i+1},z\right)}{q\left(\mathbf{x}_{i}\!\mid\!\mathbf{x}_{i+1},\mathbf{x}_{0},z\right)}\right]-D_{\mathrm{KL}}\left(q\left(\mathbf{x}_{T}\!\mid\!\mathbf{x}_{0},z\right)\|p_{\theta}\left(\mathbf{x}_{T}\!\mid\!z\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex38Xj"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex38Xj.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex38Xj.m3" class="ltx_Math" alttext="\displaystyle C_{3}-\sum_{i=1}^{T-1}\mathbb{E}_{q\left(\mathbf{x}_{i+1}\mid\mathbf{x}_{0},z\right)}\left[D_{\mathrm{KL}}\left(q\left(\mathbf{x}_{i}\!\mid\!\mathbf{x}_{i+1},\mathbf{x}_{0},z\right)\|p_{\theta}\left(\mathbf{x}_{i}\!\mid\!\mathbf{x}_{i+1},z\right)\right)\right]" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><msub><mrow></mrow><mn>3</mn></msub><mo>−</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>𝐱</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝐱</mi><mn>0</mn></msub><mo>,</mo><mi>z</mi></mrow><mo>)</mo></mrow></mrow></msub><mo>[</mo><mi>D</mi><msub><mrow></mrow><mi>KL</mi></msub><mo>(</mo><mi>q</mi><mo>(</mo><mi>𝐱</mi><msub><mrow></mrow><mi>i</mi></msub><mpadded style="width:0.219em;" width="0.219em"><mo lspace="0em">∣</mo></mpadded><mi>𝐱</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝐱</mi><msub><mrow></mrow><mn>0</mn></msub><mo>,</mo><mi>z</mi><mo>)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>(</mo><mi>𝐱</mi><msub><mrow></mrow><mi>i</mi></msub><mpadded style="width:0.219em;" width="0.219em"><mo lspace="0em">∣</mo></mpadded><mi>𝐱</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>z</mi><mo>)</mo><mo>)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle C_{3}-\sum_{i=1}^{T-1}\mathbb{E}_{q\left(\mathbf{x}_{i+1}\mid\mathbf{x}_{0},z\right)}\left[D_{\mathrm{KL}}\left(q\left(\mathbf{x}_{i}\!\mid\!\mathbf{x}_{i+1},\mathbf{x}_{0},z\right)\|p_{\theta}\left(\mathbf{x}_{i}\!\mid\!\mathbf{x}_{i+1},z\right)\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex38Xk"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex38Xk.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex38Xk.m3" class="ltx_Math" alttext="\displaystyle-\mathbb{E}_{t}\left[w_{t}\left\|\mathbf{s}_{\theta}\left(\mathbf{x}_{t},z,t\right)-\nabla\log q(\mathbf{x}_{t}\!\mid\!\mathbf{x}_{0},z)\right\|_{2}^{2}\right]+C_{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mi>w</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><mrow><msub><mi>𝐬</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo>,</mo><mi>z</mi><mo>,</mo><mi>t</mi><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>log</mi></mrow><mo lspace="0.167em">⁡</mo><mi>q</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mpadded style="width:0.052em;" width="0.052em"><mo fence="true" lspace="0em">∣</mo></mpadded><mrow><msub><mi>𝐱</mi><mn>0</mn></msub><mo>,</mo><mi>z</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>]</mo></mrow></mrow></mrow><mo>+</mo><msub><mi>C</mi><mn>2</mn></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\mathbb{E}_{t}\left[w_{t}\left\|\mathbf{s}_{\theta}\left(\mathbf{x}_{t},z,t\right)-\nabla\log q(\mathbf{x}_{t}\!\mid\!\mathbf{x}_{0},z)\right\|_{2}^{2}\right]+C_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p1.2" class="ltx_p">We get the result of Eq. (<a href="#S3.E8" title="In 3.2 Generative Objective: Modeling the Imprecise Data Distribution ‣ 3 Methodology ‣ Learning Robust Diffusion Models from Imprecise Supervision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>).</p>
</div>
</section>
<section id="A2.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.5 </span>Derivation of Remark <a href="#Thmremark1" title="Remark 1. ‣ 3.2 Generative Objective: Modeling the Imprecise Data Distribution ‣ 3 Methodology ‣ Learning Robust Diffusion Models from Imprecise Supervision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a></h3>

<div id="A2.SS5.p1" class="ltx_para ltx_noindent">
<p id="A2.SS5.p1.1" class="ltx_p">Although this result follows directly from prior studies <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib76" title="" class="ltx_ref">Vincent, 2011</a>; <a href="#bib.bib67" title="" class="ltx_ref">Song &amp; Ermon, 2019</a>)</cite>, we provide a brief derivation here for completeness.
Let <math id="A2.SS5.p1.m1" class="ltx_Math" alttext="\mathcal{L}_{\mathrm{DSM}}(\theta;q(X,Y))" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>DSM</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\mathrm{DSM}}(\theta;q(X,Y))</annotation></semantics></math> and <math id="A2.SS5.p1.m2" class="ltx_Math" alttext="\mathcal{L}_{\mathrm{ESM}}(\theta;q(X,Y))" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>ESM</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\mathrm{ESM}}(\theta;q(X,Y))</annotation></semantics></math> denote the denoising score matching (DSM) and explicit score matching (ESM) objectives, respectively:</p>
<table id="A2.EGx10" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex39.m1" class="ltx_Math" alttext="\displaystyle\mathcal{L}_{\mathrm{DSM}}(\theta;q(X,Y))" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>DSM</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}_{\mathrm{DSM}}(\theta;q(X,Y))</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex39.m2" class="ltx_Math" alttext="\displaystyle\!:=\!\mathbb{E}_{t}\Big[\lambda(t)\mathbb{E}_{y\sim q(Y)}\mathbb{E}_{\mathbf{x}_{t}\sim q_{t|0}(\mathbf{x}_{t}\mid\mathbf{x},y)}\big\|\mathbf{s}_{\theta}(\mathbf{x}_{t},y,t)\!-\!\nabla_{\mathbf{x}_{t}}\!\log q_{t|0}(\mathbf{x}_{t}\!\mid\!\mathbf{x},Y\!=\!y)\big\|_{2}^{2}\Big]," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo rspace="0.108em">:=</mo><mrow><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>y</mi><mo>∼</mo><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>𝐱</mi><mi>t</mi></msub><mo>∼</mo><mrow><msub><mi>q</mi><mrow><mi>t</mi><mo fence="false">|</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>𝐱</mi><mo>,</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><msub><mi>𝐬</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo>,</mo><mi>y</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.052em" rspace="0.052em">−</mo><mrow><msub><mo>∇</mo><msub><mi>𝐱</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>q</mi><mrow><mi>t</mi><mo fence="false">|</mo><mn>0</mn></mrow></msub><mo l