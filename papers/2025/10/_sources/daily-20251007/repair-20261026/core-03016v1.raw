<th id="S5.T1.4.4.4" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" style="padding:-4.5pt 4.3pt;"><math id="S5.T1.m1" class="ltx_math_unparsed" alttext="(\downarrow)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em" stretchy="false">↓</mo><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\downarrow)</annotation></semantics></math></th>
<td id="S5.T1.4.4.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:-4.5pt 4.3pt;"><span id="S5.T1.4.4.5.1" class="ltx_text ltx_font_bold">3.33</span></td>
