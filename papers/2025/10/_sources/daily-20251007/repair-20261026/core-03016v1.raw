<span id="S5.T1.4.4.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:6.8pt;height:44.4pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:44.4pt;transform:translate(-18.8pt,-18.8pt) rotate(-90deg) ;">
<span id="S5.T1.4.4.1.1.1.1" class="ltx_p">CIFAR-10</span>
</span></span></span></th>
<th id="S5.T1.4.4.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" style="padding:-4.5pt 4.3pt;" rowspan="4"><span id="S5.T1.4.4.2.1" class="ltx_text">
<span id="S5.T1.4.4.2.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:6.9pt;height:31.7pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:31.7pt;transform:translate(-12.4pt,-12.4pt) rotate(-90deg) ;">
