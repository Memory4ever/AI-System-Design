<div id="Sx4.T5.1" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:251.7pt;height:131.1pt;vertical-align:-63.3pt;"><span class="ltx_transformed_inner" style="transform:translate(-14.0pt,7.3pt) scale(0.9,0.9) ;">
