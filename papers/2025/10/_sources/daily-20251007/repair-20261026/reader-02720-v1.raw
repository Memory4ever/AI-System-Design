<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S4.F3.sf1.3" class="ltx_text" style="font-size:90%;">(a)</span> </span><span id="S4.F3.sf1.4" class="ltx_text" style="font-size:90%;">Parameter trajectories.</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S4.F3.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.02720v1/mogd_w_G.svg" id="S4.F3.sf2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/354;" width="476" height="354"></object>
