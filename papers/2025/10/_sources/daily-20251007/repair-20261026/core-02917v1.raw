<td id="S5.F8.sf4.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.F8.sf4.m2" class="ltx_Math" alttext="p&lt;0.001" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mn>0.001</mn></mrow><annotation encoding="application/x-tex">p&lt;0.001</annotation></semantics></math></td></tr>
<tr id="S5.F8.sf4.2.3" class="ltx_tr">
<th id="S5.F8.sf4.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b">Steering Directions vs Control</th>
