<td id="S5.F8.sf4.2.3.3" class="ltx_td ltx_align_center ltx_border_b"><math id="S5.F8.sf4.m4" class="ltx_Math" alttext="p&lt;0.001" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mn>0.001</mn></mrow><annotation encoding="application/x-tex">p&lt;0.001</annotation></semantics></math></td></tr>
