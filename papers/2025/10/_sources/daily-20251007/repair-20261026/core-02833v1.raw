<td id="A6.T4.2.2.5" class="ltx_td ltx_align_center ltx_border_t">80.3/81.6</td>
<td id="A6.T4.2.2.6" class="ltx_td ltx_align_center ltx_border_t">91.2/89.7</td></tr>
