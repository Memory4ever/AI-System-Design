<td id="A6.T2.2.6.2" class="ltx_td ltx_align_center ltx_border_t">0.82/0.09</td>
<td id="A6.T2.2.6.3" class="ltx_td ltx_align_center ltx_border_t">0.82/0.73</td>
<td id="A6.T2.2.6.4" class="ltx_td ltx_align_center ltx_border_t">0.91/0.45</td>
<td id="A6.T2.2.6.5" class="ltx_td ltx_align_center ltx_border_t">1.00/0.55</td>
<td id="A6.T2.2.6.6" class="ltx_td ltx_align_center ltx_border_t">0.45/1.00</td></tr>
<tr id="A6.T2.2.7" class="ltx_tr">
<td id="A6.T2.2.7.1" class="ltx_td ltx_align_left"><span id="A6.T2.2.7.1.1" class="ltx_text ltx_font_bold">Ours</span></td>
<td id="A6.T2.2.7.2" class="ltx_td ltx_align_center">73.55/38.82</td>
<td id="A6.T2.2.7.3" class="ltx_td ltx_align_center">75.45/39.18</td>
<td id="A6.T2.2.7.4" class="ltx_td ltx_align_center">76.18/39.91</td>
<td id="A6.T2.2.7.5" class="ltx_td ltx_align_center">74.18/39.73</td>
<td id="A6.T2.2.7.6" class="ltx_td ltx_align_center">75.00/40.09</td></tr>
<tr id="A6.T2.2.8" class="ltx_tr">
<td id="A6.T2.2.8.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="A6.T2.2.8.1.1" class="ltx_text ltx_font_bold">Malicious</span></td>
<td id="A6.T2.2.8.2" class="ltx_td ltx_align_center ltx_border_bb">74.00/42.18</td>
