<th id="S4.T1.6.1.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S4.T1.6.1.2.4.1" class="ltx_text ltx_font_bold">512</span></th>
<th id="S4.T1.6.1.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S4.T1.6.1.2.5.1" class="ltx_text ltx_font_bold">256</span></th></tr>
<tr id="S4.T1.6.1.3" class="ltx_tr">
<th id="S4.T1.6.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_t">LLaDA-8B-Instruct</th>
<th id="S4.T1.6.1.3.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">76.7</th>
<th id="S4.T1.6.1.3.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">78.2</th>
