<tr id="A3.T4.2.1.3" class="ltx_tr">
<th id="A3.T4.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">MLP</th>
<td id="A3.T4.2.1.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">113.71</td>
<td id="A3.T4.2.1.3.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">6.687</td>
<td id="A3.T4.2.1.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">48.5</td>
<td id="A3.T4.2.1.3.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">2.13</td>
