<span id="A1.T3.2.1.8.5.1.1" class="ltx_p">262,208 vocab, 2560-d, tied in/out, scaled embeddings</span>
</span></td></tr>
<tr id="A1.T3.2.1.9" class="ltx_tr">
<th id="A1.T3.2.1.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;"><span id="A1.T3.2.1.9.1.1" class="ltx_text ltx_font_bold">Context Length</span></th>
<td id="A1.T3.2.1.9.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;">
<span id="A1.T3.2.1.9.2.1" class="ltx_inline-block ltx_align_top" style="width:99.6pt;">
