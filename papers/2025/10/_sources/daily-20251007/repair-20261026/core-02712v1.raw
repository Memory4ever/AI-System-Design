<td id="S5.T1.2.7.2" class="ltx_td ltx_align_center">Parametric</td>
<td id="S5.T1.2.7.3" class="ltx_td ltx_align_center">53</td>
<td id="S5.T1.2.7.4" class="ltx_td ltx_align_center">0.869</td>
<td id="S5.T1.2.7.5" class="ltx_td ltx_align_center"><span id="S5.T1.2.7.5.1" class="ltx_text ltx_font_bold">0.175</span></td></tr>
<tr id="S5.T1.2.8" class="ltx_tr">
