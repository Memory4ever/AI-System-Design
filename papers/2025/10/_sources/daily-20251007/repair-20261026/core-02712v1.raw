<td id="S5.T1.2.5.3" class="ltx_td ltx_align_center">12</td>
<td id="S5.T1.2.5.4" class="ltx_td ltx_align_center">0.872</td>
<td id="S5.T1.2.5.5" class="ltx_td ltx_align_center">0.180</td></tr>
