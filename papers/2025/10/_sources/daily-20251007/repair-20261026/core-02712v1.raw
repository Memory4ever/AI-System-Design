<td id="S5.T4.2.5.5" class="ltx_td ltx_align_center"><math id="S5.T4.m4" class="ltx_Math" alttext="&lt;0.001" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>&lt;</mo><mn>0.001</mn></mrow><annotation encoding="application/x-tex">&lt;0.001</annotation></semantics></math></td>
<td id="S5.T4.2.5.6" class="ltx_td ltx_align_center">1.98</td></tr>
