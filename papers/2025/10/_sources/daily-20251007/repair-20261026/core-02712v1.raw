<td id="S5.T1.2.6.3" class="ltx_td ltx_align_center">12</td>
<td id="S5.T1.2.6.4" class="ltx_td ltx_align_center"><span id="S5.T1.2.6.4.1" class="ltx_text ltx_font_bold">0.874</span></td>
<td id="S5.T1.2.6.5" class="ltx_td ltx_align_center">0.187</td></tr>
<tr id="S5.T1.2.7" class="ltx_tr">
