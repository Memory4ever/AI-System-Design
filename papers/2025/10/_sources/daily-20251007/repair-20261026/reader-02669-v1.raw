encoding="application/x-tex">E(G,q)</annotation></semantics></math></span></span></span></foreignObject></g><g style="--ltx-stroke-color:#FFB366;--ltx-fill-color:#FFF2E6;" fill="#FFF2E6" stroke="#FFB366"><path d="M -98.71 16.73 L -133.86 51.88 L -169.01 16.73 L -133.86 -18.42 Z"></path></g><g style="--ltx-stroke-color:#FFB366;--ltx-fill-color:#FFF2E6;" fill="#FFF2E6" stroke="#FFB366"><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S1.F1.pic1.11" class="ltx_text"></span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.85 0.0 0.0 0.85 -247.64 1.08)"><foreignObject style="--ltx-fo-width:5.07em;--ltx-fo-height:0.61em;--ltx-fo-depth:0.17em;font-size:7.97pt;" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="55.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S1.F1.pic1.12" class="ltx_text" style="font-size:70%;">Early Exit?</span></span></span></foreignObject></g><g stroke-width="0.8pt"><path style="fill:none" d="M 0 254.1 L 0 224.7"></path><g transform="matrix(0.0 -1.0 1.0 0.0 0 224.7)"><path style="stroke:none" d="M 3.6 0 L -2.16 2.88 L 0 0 L -2.16 -2.88"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M -40.63 180.48 L -90.04 155.78"></path><g transform="matrix(-0.89452 -0.44704 0.44704 -0.89452 -90.04 155.78)"><path style="stroke:none" d="M 3.6 0 L -2.16 2.88 L 0 0 L -2.16 -2.88"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 40.63 180.48 L 90.04 155.78"></path><g transform="matrix(0.89452 -0.44704 0.44704 0.89452 90.04 155.78)"><path style="stroke:none" d="M 3.6 0 L -2.16 2.88 L 0 0 L -2.16 -2.88"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M -154.17 113.55 L -181.29 86.44"></path><g transform="matrix(-0.7073 -0.70691 0.70691 -0.7073 -181.29 86.44)"><path sty