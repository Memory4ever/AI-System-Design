<th id="S4.T2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><span id="S4.T2.1.1.2.1" class="ltx_text ltx_font_bold">Domain</span></th>
<th id="S4.T2.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><span id="S4.T2.1.1.3.1" class="ltx_text ltx_font_bold">Train</span></th>
<th id="S4.T2.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><span id="S4.T2.1.1.4.1" class="ltx_text ltx_font_bold">Test</span></th>
<th id="S4.T2.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><span id="S4.T2.1.1.5.1" class="ltx_text ltx_font_bold">Avg. Complexity</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T2.1.2" class="ltx_tr">
<td id="S4.T2.1.2.1" class="ltx_td ltx_align_left ltx_border_l ltx_border_r ltx_border_t">GSM8K</td>
<td id="S4.T2.1.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">Math Reasoning</td>
<td id="S4.T2.1.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">264</td>
<td id="S4.T2.1.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">1,055</td>
<td id="S4.T2.1.2.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">3.2</td></tr>
<tr id="S4.T2.1.3" class="ltx_tr">
<td id="S4.T2.1.3.1" class="ltx_td ltx_align_left ltx_border_l ltx_border_r">MATH</td>
<td id="S4.T2.1.3.2" class="ltx_td ltx_align_center ltx_border_r">Math Reasoning</td>
<td id="S4.T2.1.3.3" class="ltx_td ltx_align_center ltx_border_r">119</td>
<td id="S4.T2.1.3.4" class="ltx_td ltx_align_center ltx_border_r">486</td>
<td id="S4.T2.1.3.5" class="ltx_td ltx_align_center ltx_border_r">4.8</td></tr>
<tr id="S4.T2.1.4" class="ltx_tr">
<td id="S4.T2.1.4.1" class="ltx_td ltx_align_left ltx_border_l ltx_border_r">HumanEval</td>
<td id="S4.T2.1.4.2" class="ltx_td ltx_align_center ltx_border_r">Code Generation</td>
<td id="S4.T2.1.4.3" class="ltx_td ltx_align_center ltx_border_r">33</td>
<td id="S4.T2.1.4.4" class="ltx_td ltx_align_center ltx_border_r">131</td>
<td id="S4.T2.1.4.5" class="ltx_td ltx_align_center ltx_border_r">3.7</td></tr>
<tr id="S4.T2.1.5" class="ltx_tr">
<td id="S4.T2.1.5.1" class="ltx_td ltx_align_left ltx_border_l ltx_border_r">MBPP</td>
<td id="S4.T2.1.5.2" class="ltx_td ltx_align_center ltx_border_r">Code Generation</td>
<td id="S4.T2.1.5.3" class="ltx_td ltx_align_center ltx_border_r">86</td>
<td id="S4.T2.1.5.4" class="ltx_td ltx_align_center ltx_border_r">341</td>
<td id="S4.T2.1.5.5" class="ltx_td ltx_align_center ltx_border_r">3.1</td></tr>
<tr id="S4.T2.1.6" class="ltx_tr">
