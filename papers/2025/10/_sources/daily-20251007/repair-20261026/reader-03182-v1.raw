<td id="S4.T1.4.3.2" class="ltx_td ltx_align_left ltx_border_t">
<span id="S4.T1.4.3.2.1" class="ltx_inline-block ltx_align_top">
<span id="S4.T1.4.3.2.1.1" class="ltx_p ltx_align_center">100</span>
</span></td>
