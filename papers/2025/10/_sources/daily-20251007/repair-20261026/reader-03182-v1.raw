<td id="S4.T3.4.3.2" class="ltx_td ltx_align_center"><span id="S4.T3.4.3.2.1" class="ltx_text ltx_font_bold">95.5</span></td>
<td id="S4.T3.4.3.3" class="ltx_td ltx_align_center">84.9</td>
<td id="S4.T3.4.3.4" class="ltx_td ltx_align_center">38.0</td>
<td id="S4.T3.4.3.5" class="ltx_td ltx_align_center">58.9</td>
<td id="S4.T3.4.3.6" class="ltx_td ltx_align_center">53.4</td>
<td id="S4.T3.4.3.7" class="ltx_td ltx_align_center ltx_border_r">35.9</td>
<td id="S4.T3.4.3.8" class="ltx_td ltx_align_center">61.1</td></tr>
