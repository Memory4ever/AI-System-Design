<span id="S2.T1.5.2.1.1" class="ltx_inline-block ltx_align_top" style="width:22.8pt;">
<span id="S2.T1.5.2.1.1.1" class="ltx_p"><span id="S2.T1.5.2.1.1.1.1" class="ltx_text" style="font-size:50%;">Siddiq, et al. 2022</span></span>
</span></td>
<td id="S2.T1.5.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t" style="padding-left:2.0pt;padding-right:2.0pt;">
