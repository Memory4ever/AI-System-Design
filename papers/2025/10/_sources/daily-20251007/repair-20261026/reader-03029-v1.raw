<th id="S5.T4.5.5.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b ltx_border_r ltx_border_t"><span id="S5.T4.5.5.2.1" class="ltx_text" style="font-size:70%;">2021</span></th>
<td id="S5.T4.5.5.3" class="ltx_td ltx_align_left ltx_border_b ltx_border_r ltx_border_t"><span id="S5.T4.5.5.3.1" class="ltx_text" style="font-size:70%;">GPT-3 (Codex)</span></td>
<td id="S5.T4.5.5.4" class="ltx_td ltx_align_left ltx_border_b ltx_border_r ltx_border_t"><span id="S5.T4.5.5.4.1" class="ltx_text" style="font-size:70%;">12B</span></td></tr>
