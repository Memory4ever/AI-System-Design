<th id="S4.T1.2.1.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="S4.T1.2.1.1.2.1" class="ltx_text ltx_font_bold">Models</span></th>
<th id="S4.T1.2.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T1.2.1.1.3.1" class="ltx_text ltx_font_bold">Results</span></th></tr>
