<tbody class="ltx_tbody">
<tr id="S4.T1.2.1.2" class="ltx_tr">
<td id="S4.T1.2.1.2.1" class="ltx_td ltx_align_left ltx_border_t" rowspan="13"><span id="S4.T1.2.1.2.1.1" class="ltx_text">
<span id="S4.T1.2.1.2.1.1.1" class="ltx_inline-block ltx_align_left">
<span id="S4.T1.2.1.2.1.1.1.1" class="ltx_p"><span id="S4.T1.2.1.2.1.1.1.1.1" class="ltx_text ltx_font_bold">MMAU test-mini</span> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib14" title="" class="ltx_ref">14</a>]</cite></span>
<span id="S4.T1.2.1.2.1.1.1.2" class="ltx_p">
<span id="S4.T1.2.1.2.1.1.1.2.1" class="ltx_text ltx_font_italic">Sound <math id="S4.T1.m1" class="ltx_Math" alttext="|" display="inline" intent=":literal"><semantics><mo fence="false" stretchy="false">|</mo><annotation encoding="application/x-tex">|</annotation></semantics></math> Music <math id="S4.T1.m2" class="ltx_Math" alttext="|" display="inline" intent=":literal"><semantics><mo fence="false" stretchy="false">|</mo><annotation encoding="application/x-tex">|</annotation></semantics></math> Speech <math id="S4.T1.m3" class="ltx_Math" alttext="|" display="inline" intent=":literal"><semantics><mo fence="false" stretchy="false">|</mo><annotation encoding="application/x-tex">|</annotation></semantics></math> Average</span></span>
</span></span></td>
<td id="S4.T1.2.1.2.2" class="ltx_td ltx_align_left ltx_border_t" colspan="2"><span id="S4.T1.2.1.2.2.1" class="ltx_text ltx_font_italic">Closed Source</span></td></tr>
<tr id="S4.T1.2.1.3" class="ltx_tr">
