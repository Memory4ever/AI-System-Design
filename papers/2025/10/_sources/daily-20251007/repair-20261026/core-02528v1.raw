</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
<figure id="A1.F7.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.02528v1/images/heatmap_AIE_flamingo_language_model_above.png" id="A1.F7.sf2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:548/366;" width="548" height="366" alt="Refer to caption">
