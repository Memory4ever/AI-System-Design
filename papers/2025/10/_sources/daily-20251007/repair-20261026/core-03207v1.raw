<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(8)</span></td></tr></tbody>
</table>
<p id="A4.SS1.p7.4" class="ltx_p">Let <math id="A4.SS1.p7.m5" class="ltx_Math" alttext="\mathcal{E}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">\mathcal{E}</annotation></semantics></math> be the set of <math id="A4.SS1.p7.m6" class="ltx_Math" alttext="x\in\mathcal{X}_{h}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒳</mi><mi>h</mi></msub></mrow><annotation encoding="application/x-tex">x\in\mathcal{X}_{h}</annotation></semantics></math> such that <math id="A4.SS1.p7.m7" class="ltx_math_unparsed" alttext="E_{h}(x\mid{}b)\leq\delta^{-1/3}\mathbb{O}_{h}(x\mid{}b)" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><mo>≤</mo><msup><mi>δ</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>3</mn></mrow></msup><msub><mi>𝕆</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">E_{h}(x\mid{}b)\leq\delta^{-1/3}\mathbb{O}_{h}(x\mid{}b)</annotation></semantics></math>. Then the quantity <math id="A4.SS1.p7.m8" class="ltx_Math" alttext="\xi" display="inline" intent=":literal"><semantics><mi>ξ</mi><annotation encoding="application/x-tex">\xi</annotation></semantics></math> defined in <a href="#A4.E5" title="In Lemma D.2. ‣ D.1 Belief Contraction ‣ Appendix D Omitted Proofs for Perturbed Block MDP ‣ To Distill or Decide? Understanding the Algorithmic Trade-off in Partially Observable Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">5</span></a> satisfies the following bound, where the expectation is over the randomness of <math id="A4.SS1.p7.m9" class="ltx_math_unparsed" alttext="x\sim\mathbb{O}_{h}(\cdot\mid{}b)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∼</mo><msub><mi>𝕆</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">x\sim\mathbb{O}_{h}(\cdot\mid{}b)</annotation></semantics></math>:</p>
<table id="A4.EGx28" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex91"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex91.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}[\xi\mathbbm{1}[x\in\mathcal{E}]]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mi>ξ</mi><mn>𝟙</mn><mrow><mo stretchy="false">[</mo><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\xi\mathbbm{1}[x\in\mathcal{E}]]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex91.m2" class="ltx_Math" alttext="\displaystyle=\sum_{x\in\mathcal{E}}\mathbb{O}_{h}(x\mid{}b)\mathsf{TV}(\mathbb{B}_{h}(b;x),\mathbb{B}_{h}(b^{\prime};x))\left\lVert\frac{\mathbb{B}_{h}(b;x)}{\mathbb{B}_{h}(b^{\prime};x)}\right\rVert_{\infty}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></munder></mstyle><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝖳𝖵</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝔹</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝔹</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>b</mi><mo>′</mo></msup><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝔹</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝔹</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>b</mi><mo>′</mo></msup><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{x\in\mathcal{E}}\mathbb{O}_{h}(x\mid{}b)\mathsf{TV}(\mathbb{B}_{h}(b;x),\mathbb{B}_{h}(b^{\prime};x))\left\lVert\frac{\mathbb{B}_{h}(b;x)}{\mathbb{B}_{h}(b^{\prime};x)}\right\rVert_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex92"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex92.m1" class="ltx_Math" alttext="\displaystyle=\left\lVert\frac{b}{b^{\prime}}\right\rVert_{\infty}\sum_{x\in\mathcal{E}}\mathbb{O}_{h}(x\mid{}b^{\prime})\mathsf{TV}(\mathbb{B}_{h}(b;x),\mathbb{B}_{h}(b^{\prime};x))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mrow><mo>‖</mo><mstyle displaystyle="true"><mfrac><mi>b</mi><msup><mi>b</mi><mo>′</mo></msup></mfrac></mstyle><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></munder></mstyle><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝖳𝖵</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝔹</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝔹</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>b</mi><mo>′</mo></msup><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left\lVert\frac{b}{b^{\prime}}\right\rVert_{\infty}\sum_{x\in\mathcal{E}}\mathbb{O}_{h}(x\mid{}b^{\prime})\mathsf{TV}(\mathbb{B}_{h}(b;x),\mathbb{B}_{h}(b^{\prime};x))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex93"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex93.m1" class="ltx_Math" alttext="\displaystyle\leq\left\lVert\frac{b}{b^{\prime}}\right\rVert_{\infty}\Bigg((1-\delta)\delta\sum_{x\in\mathcal{E}}\widetilde{\mathbb{O}}_{h}(x\mid{}\phi(x))\frac{E_{h}(x\mid{}b)}{\mathbb{O}_{h}(x\mid{}b)}|b(\phi(x))-b^{\prime}(\phi(x))|+\delta\sum_{x\in\mathcal{E}}|E_{h}(x\mid{}b)-E_{h}(x\mid{}b^{\prime})|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mrow><mo>‖</mo><mstyle displaystyle="true"><mfrac><mi>b</mi><msup><mi>b</mi><mo>′</mo></msup></mfrac></mstyle><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></munder></mstyle><mrow><msub><mover accent="true"><mi>𝕆</mi><mo>~</mo></mover><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>E</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>b</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></munder></mstyle><mrow><mo stretchy="false">|</mo><mrow><mrow><msub><mi>E</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>E</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\lVert\frac{b}{b^{\prime}}\right\rVert_{\infty}\Bigg((1-\delta)\delta\sum_{x\in\mathcal{E}}\widetilde{\mathbb{O}}_{h}(x\mid{}\phi(x))\frac{E_{h}(x\mid{}b)}{\mathbb{O}_{h}(x\mid{}b)}|b(\phi(x))-b^{\prime}(\phi(x))|+\delta\sum_{x\in\mathcal{E}}|E_{h}(x\mid{}b)-E_{h}(x\mid{}b^{\prime})|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex94"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
