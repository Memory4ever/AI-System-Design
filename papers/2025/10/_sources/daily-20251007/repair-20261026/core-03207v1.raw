<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E8.m1" class="ltx_Math" alttext="\displaystyle=\left(\sum_{s\in\mathcal{S}_{h}}\frac{E_{h}(x\mid{}s)}{\mathbb{O}_{h}(x\mid{}b^{\prime})}|b(s)-b^{\prime}(s)|\right)+\frac{E_{h}(x\mid{}b)}{\mathbb{O}_{h}(x\mid{}b)\mathbb{O}_{h}(x\mid{}b^{\prime})}|\mathbb{O}_{h}(x\mid{}b)-\mathbb{O}_{h}(x\mid{}b^{\prime})|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>h</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>E</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>b</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>E</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\sum_{s\in\mathcal{S}_{h}}\frac{E_{h}(x\mid{}s)}{\mathbb{O}_{h}(x\mid{}b^{\prime})}|b(s)-b^{\prime}(s)|\right)+\frac{E_{h}(x\mid{}b)}{\mathbb{O}_{h}(x\mid{}b)\mathbb{O}_{h}(x\mid{}b^{\prime})}|\mathbb{O}_{h}(x\mid{}b)-\mathbb{O}_{h}(x\mid{}b^{\prime})|</annotation></semantics></math></td>
