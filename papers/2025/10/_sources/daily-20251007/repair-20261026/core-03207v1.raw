<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex25.m1" class="ltx_math_unparsed" alttext="\displaystyle\propto\sum_{s_{1:h-1}}\mathbb{P}^{\pi}[s_{1:h-1},x_{1:h-1},a_{1:h-2}]\mathbb{P}[s_{h}\mid{}s_{h-1},a_{h-1}]\mathbb{O}_{h}(x_{h}\mid{}s_{h})" display="inline" intent=":literal"><semantics><mrow><mo>∝</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub></mrow></munder></mstyle><msup><mi>ℙ</mi><mi>π</mi></msup><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>2</mn></mrow></mrow></msub><mo stretchy="false">]</mo></mrow><mi>ℙ</mi><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mi>h</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>h</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\propto\sum_{s_{1:h-1}}\mathbb{P}^{\pi}[s_{1:h-1},x_{1:h-1},a_{1:h-2}]\mathbb{P}[s_{h}\mid{}s_{h-1},a_{h-1}]\mathbb{O}_{h}(x_{h}\mid{}s_{h})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex26.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{O}_{h}(x_{h}\mid{}s_{h})\sum_{s_{h-1}}\mathbb{P}[s_{h}\mid{}s_{h-1},a_{h-1}]\sum_{s_{1:h-2}}\mathbb{P}^{\pi}[s_{1:h-1},x_{1:h-1},a_{1:h-2}]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝕆</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>h</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub></munder></mstyle><mi>ℙ</mi><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mi>h</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>2</mn></mrow></mrow></msub></mrow></munder></mstyle><msup><mi>ℙ</mi><mi>π</mi></msup><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>2</mn></mrow></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{O}_{h}(x_{h}\mid{}s_{h})\sum_{s_{h-1}}\mathbb{P}[s_{h}\mid{}s_{h-1},a_{h-1}]\sum_{s_{1:h-2}}\mathbb{P}^{\pi}[s_{1:h-1},x_{1:h-1},a_{1:h-2}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex27.m1" class="ltx_math_unparsed" alttext="\displaystyle\propto\mathbb{O}_{h}(x_{h}\mid{}s_{h})\sum_{s_{h-1}}\mathbb{P}[s_{h}\mid{}s_{h-1},a_{h-1}]\mathbb{P}^{\pi}[s_{h-1}\mid{}x_{1:h-1},a_{1:h-2}]" display="inline" intent=":literal"><semantics><mrow><mo>∝</mo><msub><mi>𝕆</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>h</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub></munder></mstyle><mi>ℙ</mi><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mi>h</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow><msup><mi>ℙ</mi><mi>π</mi></msup><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>2</mn></mrow></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\propto\mathbb{O}_{h}(x_{h}\mid{}s_{h})\sum_{s_{h-1}}\mathbb{P}[s_{h}\mid{}s_{h-1},a_{h-1}]\mathbb{P}^{\pi}[s_{h-1}\mid{}x_{1:h-1},a_{1:h-2}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex28.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{O}_{h}(x_{h}\mid{}s_{h})\sum_{s_{h-1}}\mathbb{P}[s_{h}\mid{}s_{h-1},a_{h-1}]\mathbf{b}_{h-1}(x_{1:h-1},a_{1:h-2})(s_{h-1})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝕆</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>h</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub></munder></mstyle><mi>ℙ</mi><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mi>h</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow><msub><mi>𝐛</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>2</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{O}_{h}(x_{h}\mid{}s_{h})\sum_{s_{h-1}}\mathbb{P}[s_{h}\mid{}s_{h-1},a_{h-1}]\mathbf{b}_{h-1}(x_{1:h-1},a_{1:h-2})(s_{h-1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex29.m1" class="ltx_math_unparsed" alttext="\displaystyle\propto\mathbf{b}_{h}(x_{1:h},a_{1:h-1})(s_{h})" display="inline" intent=":literal"><semantics><mrow><mo>∝</mo><msub><mi>𝐛</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>h</mi></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\propto\mathbf{b}_{h}(x_{1:h},a_{1:h-1})(s_{h})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p3.2" class="ltx_p">where the penultimate equality uses the induction hypothesis and the final equality uses <a href="#S2.E1" title="In Definition 2.1. ‣ Belief states ‣ 2 Preliminaries ‣ To Distill or Decide? Understanding the Algorithmic Trade-off in Partially Observable Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">1</span></a>. This proves the first claim. To prove the second claim, observe that by a similar argument to above, for any <math id="A3.p3.m15" class="ltx_Math" alttext="h&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">h&gt;1</annotation></semantics></math>,</p>
<table id="A3.Ex30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex30.m1" class="ltx_math_unparsed" alttext="\mathbb{P}^{\pi}[s_{h}\mid{}x_{1:h-1},a_{1:h-1}]\propto\sum_{s_{h-1}}\mathbb{P}[s_{h}\mid{}s_{h-1},a_{h-1}]\mathbf{b}_{h-1}(x_{1:h-1},a_{1:h-2})(s_{h-1})" display="block" intent=":literal"><semantics><mrow><msup><mi>ℙ</mi><mi>π</mi></msup><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mi>h</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">]</mo></mrow><mo rspace="0.111em">∝</mo><munder><mo movablelimits="false">∑</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub></munder><mi>ℙ</mi><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mi>h</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow><msub><mi>𝐛</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>2</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}^{\pi}[s_{h}\mid{}x_{1:h-1},a_{1:h-1}]\propto\sum_{s_{h-1}}\mathbb{P}[s_{h}\mid{}s_{h-1},a_{h-1}]\mathbf{b}_{h-1}(x_{1:h-1},a_{1:h-2})(s_{h-1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p3.3" class="ltx_p">so that <math id="A3.p3.m16" class="ltx_math_unparsed" alttext="\mathbb{P}^{\pi}[s_{h}\mid{}x_{1:h-1},a_{1:h-1}]=(\mathbb{P}_{h}(a_{h-1})\cdot\mathbf{b}_{h-1}(x_{1:h-1},a_{1:h-2}))(s_{h})" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℙ</mi><mi>π</mi></msup><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mi>h</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>ℙ</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mi>𝐛</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>2</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}^{\pi}[s_{h}\mid{}x_{1:h-1},a_{1:h-1}]=(\mathbb{P}_{h}(a_{h-1})\cdot\mathbf{b}_{h-1}(x_{1:h-1},a_{1:h-2}))(s_{h})</annotation></semantics></math>. But then</p>
<table id="A3.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex31.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{P}^{\pi}[x_{h}\mid{}x_{1:h-1},a_{1:h-1}]" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℙ</mi><mi>π</mi></msup><mrow><mo stretchy="false">[</mo><msub><mi>x</mi><mi>h</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}^{\pi}[x_{h}\mid{}x_{1:h-1},a_{1:h-1}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex31.m2" class="ltx_math_unparsed" alttext="\displaystyle\propto\sum_{s_{1:h}}\mathbb{P}^{\pi}[s_{1:h},x_{1:h},a_{1:h-1}]" display="inline" intent=":literal"><semantics><mrow><mo>∝</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>h</mi></mrow></msub></mrow></munder></mstyle><msup><mi>ℙ</mi><mi>π</mi></msup><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>h</mi></mrow></msub><mo>,</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>h</mi></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\propto\sum_{s_{1:h}}\mathbb{P}^{\pi}[s_{1:h},x_{1:h},a_{1:h-1}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex32.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{s_{h}}\mathbb{O}_{h}(x_{h}\mid{}s_{h})\sum_{s_{1:h-1}}\mathbb{P}^{\pi}[s_{1:h},x_{1:h-1},a_{1:h-1}]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msub><mi>s</mi><mi>h</mi></msub></munder></mstyle><msub><mi>𝕆</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>h</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub></mrow></munder></mstyle><msup><mi>ℙ</mi><mi>π</mi></msup><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>h</mi></mrow></msub><mo>,</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{s_{h}}\mathbb{O}_{h}(x_{h}\mid{}s_{h})\sum_{s_{1:h-1}}\mathbb{P}^{\pi}[s_{1:h},x_{1:h-1},a_{1:h-1}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex33.m1" class="ltx_math_unparsed" alttext="\displaystyle\propto\sum_{s_{h}}\mathbb{O}_{h}(x_{h}\mid{}s_{h})\mathbb{P}^{\pi}[s_{h}\mid{}x_{1:h-1},a_{1:h-1}]." display="inline" intent=":literal"><semantics><mrow><mo>∝</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msub><mi>s</mi><mi>h</mi></msub></munder></mstyle><msub><mi>𝕆</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>h</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><msup><mi>ℙ</mi><mi>π</mi></msup><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mi>h</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\propto\sum_{s_{h}}\mathbb{O}_{h}(x_{h}\mid{}s_{h})\mathbb{P}^{\pi}[s_{h}\mid{}x_{1:h-1},a_{1:h-1}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p3.4" class="ltx_p">Therefore <math id="A3.p3.m17" class="ltx_math_unparsed" alttext="\mathbb{P}^{\pi}[x_{h}\mid{}x_{1:h-1},a_{1:h-1}]=(\mathbb{O}_{h}^{\top}\cdot\mathbb{P}_{h}(a_{h-1})\cdot\mathbf{b}_{h-1}(x_{1:h-1},a_{1:h-2}))(x_{h})" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℙ</mi><mi>π</mi></msup><mrow><mo stretchy="false">[</mo><msub><mi>x</mi><mi>h</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝕆</mi><mi>h</mi><mo>⊤</mo></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>ℙ</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mi>𝐛</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>2</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}^{\pi}[x_{h}\mid{}x_{1:h-1},a_{1:h-1}]=(\mathbb{O}_{h}^{\top}\cdot\mathbb{P}_{h}(a_{h-1})\cdot\mathbf{b}_{h-1}(x_{1:h-1},a_{1:h-2}))(x_{h})</annotation></semantics></math> as claimed.
∎
<br class="ltx_break"></p>
</div>
<div id="A3.p4" class="ltx_para ltx_noindent">
<p id="A3.p4.1" class="ltx_p">We will also need the following variant of <a href="#A3.Thmlemma2" title="Lemma C.2. ‣ Appendix C Technical Lemmas ‣ To Distill or Decide? Understanding the Algorithmic Trade-off in Partially Observable Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">C.2</span></a>, which shows how approximate belief states arise as conditional probability distributions:</p>
</div>
<div id="A3.Thmlemma3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmlemma3.2" class="ltx_text ltx_font_bold">Lemma C.3</span></span><span id="A3.Thmlemma3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmlemma3.p1" class="ltx_para ltx_noindent">
<p id="A3.Thmlemma3.p1.1" class="ltx_p"><span id="A3.Thmlemma3.p1.1.1" class="ltx_text ltx_font_italic">Fix any <math id="A3.Thmlemma3.p1.m1" class="ltx_Math" alttext="h\in[H]" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>H</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">h\in[H]</annotation></semantics></math>, <math id="A3.Thmlemma3.p1.m2" class="ltx_Math" alttext="L\in\{0,\dots,h-1\}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">L\in\{0,\dots,h-1\}</annotation></semantics></math>, and executable policy <math id="A3.Thmlemma3.p1.m3" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> where <math id="A3.Thmlemma3.p1.m4" class="ltx_math_unparsed" alttext="\pi_{h-t}(\cdot\mid{}x_{1:h-t},a_{1:h-t-1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mrow><mi>h</mi><mo>−</mo><mi>t</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mi>t</mi></mrow></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mi>t</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{h-t}(\cdot\mid{}x_{1:h-t},a_{1:h-t-1})</annotation></semantics></math> is determined by <math id="A3.Thmlemma3.p1.m5" class="ltx_math_unparsed" alttext="(x_{h-L+1:h-t},a_{h-L:h-t-1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mrow><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mi>t</mi></mrow></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mi>t</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(x_{h-L+1:h-t},a_{h-L:h-t-1})</annotation></semantics></math> for all <math id="A3.Thmlemma3.p1.m6" class="ltx_Math" alttext="t\in[L]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[L]</annotation></semantics></math>. Then</span></p>
<table id="A3.Ex34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex34.m1" class="ltx_math_unparsed" alttext="\mathbb{P}^{\pi}[s_{h}\mid{}x_{h-L+1:h},a_{h-L:h-1}]=\mathbf{b}^{\mathsf{apx}}_{h}(x_{h-L+1:h},a_{h-L:h-1};d^{\pi}_{h-L})." display="block" intent=":literal"><semantics><mrow><msup><mi>ℙ</mi><mi>π</mi></msup><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mi>h</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>x</mi><mrow><mrow><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>h</mi></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><msubsup><mi>𝐛</mi><mi>h</mi><mi>𝖺𝗉𝗑</mi></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mrow><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>h</mi></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>;</mo><msubsup><mi>d</mi><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mi>π</mi></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{P}^{\pi}[s_{h}\mid{}x_{h-L+1:h},a_{h-L:h-1}]=\mathbf{b}^{\mathsf{apx}}_{h}(x_{h-L+1:h},a_{h-L:h-1};d^{\pi}_{h-L}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A3.p5" class="ltx_para ltx_noindent">
<p id="A3.p5.1" class="ltx_p"><span id="A3.p5.1.1" class="ltx_text ltx_font_bold">Proof. </span>We induct on <math id="A3.p5.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>. If <math id="A3.p5.m2" class="ltx_Math" alttext="L=0" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">L=0</annotation></semantics></math> then, for any <math id="A3.p5.m3" class="ltx_Math" alttext="h\in[H]" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>H</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">h\in[H]</annotation></semantics></math>, by definition <math id="A3.p5.m4" class="ltx_Math" alttext="\mathbb{P}^{\pi}[s_{h}]=d^{\pi}_{h}(s_{h})=\mathbf{b}^{\mathsf{apx}}_{h}(\emptyset;d^{\pi}_{h})(s_{h})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>ℙ</mi><mi>π</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>d</mi><mi>h</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>𝐛</mi><mi>h</mi><mi>𝖺𝗉𝗑</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">∅</mi><mo>,</mo><msubsup><mi>d</mi><mi>h</mi><mi>π</mi></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}^{\pi}[s_{h}]=d^{\pi}_{h}(s_{h})=\mathbf{b}^{\mathsf{apx}}_{h}(\emptyset;d^{\pi}_{h})(s_{h})</annotation></semantics></math>. Fix any <math id="A3.p5.m5" class="ltx_Math" alttext="L&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">L&gt;0</annotation></semantics></math> and suppose the claim holds for <math id="A3.p5.m6" class="ltx_Math" alttext="L-1" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">L-1</annotation></semantics></math> (for all <math id="A3.p5.m7" class="ltx_Math" alttext="h&gt;L-1" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>&gt;</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">h&gt;L-1</annotation></semantics></math>). Then for any <math id="A3.p5.m8" class="ltx_Math" alttext="h&gt;L" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>&gt;</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">h&gt;L</annotation></semantics></math>,</p>
<table id="A3.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex35.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{P}^{\pi}[s_{h}\mid{}x_{h-L+1:h},a_{h-L:h-1}]" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℙ</mi><mi>π</mi></msup><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mi>h</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>x</mi><mrow><mrow><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>h</mi></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}^{\pi}[s_{h}\mid{}x_{h-L+1:h},a_{h-L:h-1}]</annotation></semantics></math></td>
