<thead class="ltx_thead">
<tr id="A8.T2.2.1" class="ltx_tr">
<th id="A8.T2.2.1.1" class="ltx_td ltx_th ltx_th_column ltx_border_r ltx_border_tt"></th>
<th id="A8.T2.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt">Final value</th>
<th id="A8.T2.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Considered Values</th></tr>
</thead>
