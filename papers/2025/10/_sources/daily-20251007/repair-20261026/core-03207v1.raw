<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex59.m1" class="ltx_Math" alttext="\displaystyle=\sum_{s_{h}}b_{h}(s_{h})\left(R_{h}(s_{h},a_{h})+\sum_{s_{h+1}}\mathbb{P}_{h}(s_{h+1}\mid s_{h},a_{h})\max_{a_{h+1}}Q^{\mathcal{M}}_{h+1}(s_{h+1},a_{h+1})\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msub><mi>s</mi><mi>h</mi></msub></munder></mstyle><mrow><msub><mi>b</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>R</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo>,</mo><msub><mi>a</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub></munder></mstyle><mrow><msub><mi>ℙ</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>s</mi><mi>h</mi></msub><mo>,</mo><msub><mi>a</mi><mi>h</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><munder><mi>max</mi><msub><mi>a</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub></munder><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mi>Q</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{s_{h}}b_{h}(s_{h})\left(R_{h}(s_{h},a_{h})+\sum_{s_{h+1}}\mathbb{P}_{h}(s_{h+1}\mid s_{h},a_{h})\max_{a_{h+1}}Q^{\mathcal{M}}_{h+1}(s_{h+1},a_{h+1})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex60"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex60.m1" class="ltx_Math" alttext="\displaystyle=\sum_{s_{h}}b_{h}(s_{h})Q^{\mathcal{M}}_{h}(s_{h},a_{h})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msub><mi>s</mi><mi>h</mi></msub></munder></mstyle><mrow><msub><mi>b</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>Q</mi><mi>h</mi><mi class="ltx_font_mathcaligraphic">ℳ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo>,</mo><msub><mi>a</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{s_{h}}b_{h}(s_{h})Q^{\mathcal{M}}_{h}(s_{h},a_{h})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex61"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex61.m1" class="ltx_Math" alttext="\displaystyle=Q^{\mathcal{M}}_{h}(b_{h},a_{h})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>Q</mi><mi>h</mi><mi class="ltx_font_mathcaligraphic">ℳ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>b</mi><mi>h</mi></msub><mo>,</mo><msub><mi>a</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=Q^{\mathcal{M}}_{h}(b_{h},a_{h}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p8.6" class="ltx_p">Finally, we conclude the proof by noting that</p>
<table id="A3.EGx18" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex62"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex62.m1" class="ltx_Math" alttext="\displaystyle J(\pi^{\mathsf{latent}})=\En_{s_{1}}[Q^{\mathcal{M}}_{1}(s_{1},\pi^{\mathsf{latent}}(s_{1}))]=\En_{s_{1}}[\max_{a_{1}}Q^{\mathcal{M}}_{1}(s_{1},a_{1})]\geq\max_{a_{1}}Q^{\mathcal{M}}_{1}(\mathbf{b}_{1},a_{1})\geq\max_{a_{1}}Q^{\mathcal{P}}_{1}(\mathbf{b}_{1},a_{1})=J(\pi^{\star})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mi>𝗅𝖺𝗍𝖾𝗇𝗍</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><msub><mi>s</mi><mn>1</mn></msub></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>Q</mi><mn>1</mn><mi class="ltx_font_mathcaligraphic">ℳ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>1</mn></msub><mo>,</mo><mrow><msup><mi>π</mi><mi>𝗅𝖺𝗍𝖾𝗇𝗍</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><msub><mi>s</mi><mn>1</mn></msub></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><munder><mi>max</mi><msub><mi>a</mi><mn>1</mn></msub></munder><mo lspace="0.167em">⁡</mo><msubsup><mi>Q</mi><mn>1</mn><mi class="ltx_font_mathcaligraphic">ℳ</mi></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>1</mn></msub><mo>,</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>≥</mo><mrow><mrow><munder><mi>max</mi><msub><mi>a</mi><mn>1</mn></msub></munder><mo lspace="0.167em">⁡</mo><msubsup><mi>Q</mi><mn>1</mn><mi class="ltx_font_mathcaligraphic">ℳ</mi></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐛</mi><mn>1</mn></msub><mo>,</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mrow><munder><mi>max</mi><msub><mi>a</mi><mn>1</mn></msub></munder><mo lspace="0.167em">⁡</mo><msubsup><mi>Q</mi><mn>1</mn><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐛</mi><mn>1</mn></msub><mo>,</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle J(\pi^{\mathsf{latent}})=\En_{s_{1}}[Q^{\mathcal{M}}_{1}(s_{1},\pi^{\mathsf{latent}}(s_{1}))]=\En_{s_{1}}[\max_{a_{1}}Q^{\mathcal{M}}_{1}(s_{1},a_{1})]\geq\max_{a_{1}}Q^{\mathcal{M}}_{1}(\mathbf{b}_{1},a_{1})\geq\max_{a_{1}}Q^{\mathcal{P}}_{1}(\mathbf{b}_{1},a_{1})=J(\pi^{\star}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p8.7" class="ltx_p">∎
<br class="ltx_break"></p>
</div>
<div id="A3.p9" class="ltx_para ltx_noindent">
<p id="A3.p9.1" class="ltx_p">We will need the following martingale bound to analyze belief contraction error and decodability error in the perturbed Block MDP.</p>
</div>
<div id="A3.Thmlemma5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmlemma5.2" class="ltx_text ltx_font_bold">Lemma C.5</span></span><span id="A3.Thmlemma5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmlemma5.p1" class="ltx_para ltx_noindent">
<p id="A3.Thmlemma5.p1.1" class="ltx_p"><span id="A3.Thmlemma5.p1.1.1" class="ltx_text ltx_font_italic">Fix <math id="A3.Thmlemma5.p1.m1" class="ltx_Math" alttext="\varepsilon\in(0,3^{-6})" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msup><mn>3</mn><mrow><mo>−</mo><mn>6</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\varepsilon\in(0,3^{-6})</annotation></semantics></math> and <math id="A3.Thmlemma5.p1.m2" class="ltx_Math" alttext="S&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">S&gt;0</annotation></semantics></math>. Let <math id="A3.Thmlemma5.p1.m3" class="ltx_Math" alttext="X_{0},\dots,X_{L}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>X</mi><mi>L</mi></msub></mrow><annotation encoding="application/x-tex">X_{0},\dots,X_{L}</annotation></semantics></math> be a non-negative supermartingale with <math id="A3.Thmlemma5.p1.m4" class="ltx_Math" alttext="\mathbb{E}[X_{0}]\leq S" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>X</mi><mn>0</mn></msub><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">\mathbb{E}[X_{0}]\leq S</annotation></semantics></math> and <math id="A3.Thmlemma5.p1.m5" class="ltx_Math" alttext="\Pr[X_{n+1}&gt;\varepsilon X_{n}|X_{n}]\leq\varepsilon" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>X</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>&gt;</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mi>n</mi></msub></mrow></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>X</mi><mi>n</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mi>ε</mi></mrow><annotation encoding="application/x-tex">\Pr[X_{n+1}&gt;\varepsilon X_{n}|X_{n}]\leq\varepsilon</annotation></semantics></math> almost surely for all <math id="A3.Thmlemma5.p1.m6" class="ltx_Math" alttext="0\leq n&lt;L" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>n</mi><mo>&lt;</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">0\leq n&lt;L</annotation></semantics></math>. Then</span></p>
<table id="A3.Ex63" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex63.m1" class="ltx_Math" alttext="\mathbb{E}[\min(X_{L},S)]\leq 2\cdot 3^{L}\varepsilon^{L/3}S." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>L</mi></msub><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>3</mn><mi>L</mi></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>ε</mi><mrow><mi>L</mi><mo>/</mo><mn>3</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[\min(X_{L},S)]\leq 2\cdot 3^{L}\varepsilon^{L/3}S.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A3.p10" class="ltx_para ltx_noindent">
<p id="A3.p10.1" class="ltx_p"><span id="A3.p10.1.1" class="ltx_text ltx_font_bold">Proof. </span>For any integer <math id="A3.p10.m1" class="ltx_Math" alttext="0\leq n\leq L" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>n</mi><mo>≤</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">0\leq n\leq L</annotation></semantics></math> and any integer <math id="A3.p10.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, define <math id="A3.p10.m3" class="ltx_math_unparsed" alttext="f(n,k):=\Pr[\varepsilon^{k+1}S&lt;X_{n}\leq\varepsilon^{k}S]" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo>:=</mo><mi>Pr</mi><mrow><mo stretchy="false">[</mo><msup><mi>ε</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mi>S</mi><mo>&lt;</mo><msub><mi>X</mi><mi>n</mi></msub><mo>≤</mo><msup><mi>ε</mi><mi>k</mi></msup><mi>S</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">f(n,k):=\Pr[\varepsilon^{k+1}S&lt;X_{n}\leq\varepsilon^{k}S]</annotation></semantics></math>. We prove by induction on <math id="A3.p10.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> that <math id="A3.p10.m5" class="ltx_Math" alttext="f(n,k)\leq 3^{n}\varepsilon^{(n-k)/3}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msup><mn>3</mn><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ε</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>3</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">f(n,k)\leq 3^{n}\varepsilon^{(n-k)/3}</annotation></semantics></math>. If <math id="A3.p10.m6" class="ltx_Math" alttext="n=0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n=0</annotation></semantics></math>, then the claim is trivially true for <math id="A3.p10.m7" class="ltx_Math" alttext="k\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">k\geq 0</annotation></semantics></math> since <math id="A3.p10.m8" class="ltx_Math" alttext="f(n,k)\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">f(n,k)\leq 1</annotation></semantics></math> always. For any <math id="A3.p10.m9" class="ltx_Math" alttext="k&lt;0" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">k&lt;0</annotation></semantics></math>, by Markov’s inequality,</p>
<table id="A3.Ex64" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex64.m1" class="ltx_math_unparsed" alttext="f(0,k)\leq\Pr[X_{0}&gt;\varepsilon^{k+1}S]\leq\frac{\mathbb{E}[X_{0}]}{\varepsilon^{k+1}S}=\varepsilon^{-k-1}\leq\varepsilon^{-k/3}." display="block" intent=":literal"><semantics><mrow><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo>≤</mo><mi>Pr</mi><mrow><mo stretchy="false">[</mo><msub><mi>X</mi><mn>0</mn></msub><mo>&gt;</mo><msup><mi>ε</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mi>S</mi><mo stretchy="false">]</mo></mrow><mo>≤</mo><mfrac><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>X</mi><mn>0</mn></msub><mo stretchy="false">]</mo></mrow></mrow><mrow><msup><mi>ε</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mfrac><mo>=</mo><msup><mi>ε</mi><mrow><mrow><mo>−</mo><mi>k</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>≤</mo><msup><mi>ε</mi><mrow><mo>−</mo><mi>k</mi><mo>/</mo><mn>3</mn></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f(0,k)\leq\Pr[X_{0}&gt;\varepsilon^{k+1}S]\leq\frac{\mathbb{E}[X_{0}]}{\varepsilon^{k+1}S}=\varepsilon^{-k-1}\leq\varepsilon^{-k/3}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p10.2" class="ltx_p">For any <math id="A3.p10.m10" class="ltx_Math" alttext="0&lt;n\leq L" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>n</mi><mo>≤</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">0&lt;n\leq L</annotation></semantics></math> and integer <math id="A3.p10.m11" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, we have</p>
<table id="A3.EGx19" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex65.m1" class="ltx_Math" alttext="\displaystyle f(n,k)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle f(n,k)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex65.m2" class="ltx_Math" alttext="\displaystyle=\sum_{\ell=-\infty}^{\infty}\Pr[\varepsilon^{k+1}S&lt;X_{n}\leq\varepsilon^{k}S\mid{}\varepsilon^{\ell+1}S&lt;X_{n-1}\leq\varepsilon^{\ell}S]\cdot f(n-1,\ell)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><msup><mi>ε</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>&lt;</mo><msub><mi>X</mi><mi>n</mi></msub><mo>≤</mo><mrow><msup><mi>ε</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mrow><msup><mi>ε</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>&lt;</mo><msub><mi>X</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>≤</mo><mrow><msup><mi>ε</mi><mi mathvariant="normal">ℓ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mrow></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{\ell=-\infty}^{\infty}\Pr[\varepsilon^{k+1}S&lt;X_{n}\leq\varepsilon^{k}S\mid{}\varepsilon^{\ell+1}S&lt;X_{n-1}\leq\varepsilon^{\ell}S]\cdot f(n-1,\ell)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E4.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{\ell=-\infty}^{k-1}f(n-1,\ell)+\varepsilon f(n-1,k)+\varepsilon f(n-1,k+1)+\sum_{\ell=k+2}^{\infty}\varepsilon^{\ell-k-1}f(n-1,\ell)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><msup><mi>ε</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{\ell=-\infty}^{k-1}f(n-1,\ell)+\varepsilon f(n-1,k)+\varepsilon f(n-1,k+1)+\sum_{\ell=k+2}^{\infty}\varepsilon^{\ell-k-1}f(n-1,\ell)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4)</span></td></tr></tbody>
</table>
<p id="A3.p10.3" class="ltx_p">where the inequality uses the following two facts. First, for any <math id="A3.p10.m12" class="ltx_Math" alttext="\ell\geq k" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>≥</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">\ell\geq k</annotation></semantics></math>,</p>
<table id="A3.Ex66" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex66.m1" class="ltx_Math" alttext="\Pr[\varepsilon^{k+1}S&lt;X_{n}\leq\varepsilon^{k}S\mid{}\varepsilon^{\ell+1}S&lt;X_{n-1}\leq\varepsilon^{\ell}S]\leq\Pr[X_{n}&gt;\varepsilon X_{n-1}\mid{}\varepsilon^{\ell+1}S&lt;X_{n-1}\leq\varepsilon^{\ell}S]\leq\varepsilon" display="block" intent=":literal"><semantics><mrow><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><msup><mi>ε</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>&lt;</mo><msub><mi>X</mi><mi>n</mi></msub><mo>≤</mo><mrow><msup><mi>ε</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mrow><msup><mi>ε</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>&lt;</mo><msub><mi>X</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>≤</mo><mrow><msup><mi>ε</mi><mi mathvariant="normal">ℓ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>X</mi><mi>n</mi></msub><mo>&gt;</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mrow><msup><mi>ε</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>&lt;</mo><msub><mi>X</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>≤</mo><mrow><msup><mi>ε</mi><mi mathvariant="normal">ℓ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mi>ε</mi></mrow><annotation encoding="application/x-tex">\Pr[\varepsilon^{k+1}S&lt;X_{n}\leq\varepsilon^{k}S\mid{}\varepsilon^{\ell+1}S&lt;X_{n-1}\leq\varepsilon^{\ell}S]\leq\Pr[X_{n}&gt;\varepsilon X_{n-1}\mid{}\varepsilon^{\ell+1}S&lt;X_{n-1}\leq\varepsilon^{\ell}S]\leq\varepsilon</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p10.4" class="ltx_p">by lemma assumption. Second, for any <math id="A3.p10.m13" class="ltx_Math" alttext="\ell\geq k+2" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>≥</mo><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">\ell\geq k+2</annotation></semantics></math>,</p>
<table id="A3.EGx20" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex67.m1" class="ltx_Math" alttext="\displaystyle\Pr[\varepsilon^{k+1}S&lt;X_{n}\leq\varepsilon^{k}S\mid{}\varepsilon^{\ell+1}S&lt;X_{n-1}\leq\varepsilon^{\ell}S]" display="inline" intent=":literal"><semantics><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><msup><mi>ε</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>&lt;</mo><msub><mi>X</mi><mi>n</mi></msub><mo>≤</mo><mrow><msup><mi>ε</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mrow><msup><mi>ε</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>&lt;</mo><msub><mi>X</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>≤</mo><mrow><msup><mi>ε</mi><mi mathvariant="normal">ℓ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Pr[\varepsilon^{k+1}S&lt;X_{n}\leq\varepsilon^{k}S\mid{}\varepsilon^{\ell+1}S&lt;X_{n-1}\leq\varepsilon^{\ell}S]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex67.m2" class="ltx_Math" alttext="\displaystyle\leq\Pr[X_{n}&gt;\varepsilon^{k+1-\ell}X_{n-1}\mid{}\varepsilon^{\ell+1}S&lt;X_{n-1}\leq\varepsilon^{\ell}S]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>X</mi><mi>n</mi></msub><mo>&gt;</mo><mrow><msup><mi>ε</mi><mrow><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mrow><msup><mi>ε</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>&lt;</mo><msub><mi>X</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>≤</mo><mrow><msup><mi>ε</mi><mi mathvariant="normal">ℓ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\Pr[X_{n}&gt;\varepsilon^{k+1-\ell}X_{n-1}\mid{}\varepsilon^{\ell+1}S&lt;X_{n-1}\leq\varepsilon^{\ell}S]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex68.m1" class="ltx_Math" alttext="\displaystyle\leq\varepsilon^{\ell-k-1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><msup><mi>ε</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leq\varepsilon^{\ell-k-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p10.5" class="ltx_p">since <math id="A3.p10.m14" class="ltx_Math" alttext="X_{0},\dots,X_{L}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>X</mi><mi>L</mi></msub></mrow><annotation encoding="application/x-tex">X_{0},\dots,X_{L}</annotation></semantics></math> is a supermartingale. Returning to <a href="#A3.E4" title="In Appendix C Technical Lemmas ‣ To Distill or Decide? Understanding the Algorithmic Trade-off in Partially Observable Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">4</span></a>, we get</p>
<table id="A3.EGx21" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex69.m1" class="ltx_Math" alttext="\displaystyle f(n,k)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle f(n,k)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex69.m2" class="ltx_Math" alttext="\displaystyle\leq\sum_{\ell=-\infty}^{k-1}f(n-1,\ell)+\varepsilon f(n-1,k)+\varepsilon f(n-1,k+1)+\sum_{\ell=k+2}^{\infty}\varepsilon^{\ell-k-1}f(n-1,\ell)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><msup><mi>ε</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{\ell=-\infty}^{k-1}f(n-1,\ell)+\varepsilon f(n-1,k)+\varepsilon f(n-1,k+1)+\sum_{\ell=k+2}^{\infty}\varepsilon^{\ell-k-1}f(n-1,\ell)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex70"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex70.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{\ell=-\infty}^{k-1}3^{n-1}\varepsilon^{(n-1-\ell)/3}+3^{n-1}\varepsilon^{1+(n-k-1)/3}+3^{n-1}\varepsilon^{1+(n-k-2)/3}+\sum_{\ell=k+2}^{\infty}3^{n-1}\varepsilon^{\ell-k-1+(n-\ell-1)/3}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mn>3</mn><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ε</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>3</mn></mrow></msup></mrow></mrow><mo>+</mo><mrow><msup><mn>3</mn><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ε</mi><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>3</mn></mrow></mrow></msup></mrow><mo>+</mo><mrow><msup><mn>3</mn><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ε</mi><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>3</mn></mrow></mrow></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><msup><mn>3</mn><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ε</mi><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>3</mn></mrow></mrow></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{\ell=-\infty}^{k-1}3^{n-1}\varepsilon^{(n-1-\ell)/3}+3^{n-1}\varepsilon^{1+(n-k-1)/3}+3^{n-1}\varepsilon^{1+(n-k-2)/3}+\sum_{\ell=k+2}^{\infty}3^{n-1}\varepsilon^{\ell-k-1+(n-\ell-1)/3}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex71"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex71.m1" class="ltx_Math" alttext="\displaystyle\leq 3^{n-1}\varepsilon^{(n-k)/3}\left(\frac{1}{1-\varepsilon^{1/3}}+\varepsilon^{2/3}+\varepsilon^{1/3}+\frac{1}{1-\varepsilon^{2/3}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msup><mn>3</mn><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ε</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>3</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msup><mi>ε</mi><mrow><mn>1</mn><mo>/</mo><mn>3</mn></mrow></msup></mrow></mfrac></mstyle><mo>+</mo><msup><mi>ε</mi><mrow><mn>2</mn><mo>/</mo><mn>3</mn></mrow></msup><mo>+</mo><msup><mi>ε</mi><mrow><mn>1</mn><mo>/</mo><mn>3</mn></mrow></msup><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msup><mi>ε</mi><mrow><mn>2</mn><mo>/</mo><mn>3</mn></mrow></msup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 3^{n-1}\varepsilon^{(n-k)/3}\left(\frac{1}{1-\varepsilon^{1/3}}+\varepsilon^{2/3}+\varepsilon^{1/3}+\frac{1}{1-\varepsilon^{2/3}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex72"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex72.m1" class="ltx_Math" alttext="\displaystyle\leq 3^{n}\varepsilon^{(n-k)/3}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msup><mn>3</mn><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ε</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>3</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 3^{n}\varepsilon^{(n-k)/3}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p10.6" class="ltx_p">where the final inequality holds since <math id="A3.p10.m15" class="ltx_Math" alttext="\varepsilon\leq 1/64" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>≤</mo><mrow><mn>1</mn><mo>/</mo><mn>64</mn></mrow></mrow><annotation encoding="application/x-tex">\varepsilon\leq 1/64</annotation></semantics></math>. This completes the induction. Next,</p>
<table id="A3.EGx22" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex73"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex73.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\min(X_{L},S)]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>L</mi></msub><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\min(X_{L},S)]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex73.m2" class="ltx_Math" alttext="\displaystyle\leq\sum_{\ell=-\infty}^{-1}S\cdot f(L,\ell)+\sum_{\ell=0}^{\infty}\varepsilon^{\ell}S\cdot f(L,\ell)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mi>S</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><msup><mi>ε</mi><mi mathvariant="normal">ℓ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{\ell=-\infty}^{-1}S\cdot f(L,\ell)+\sum_{\ell=0}^{\infty}\varepsilon^{\ell}S\cdot f(L,\ell)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex74"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex74.m1" class="ltx_Math" alttext="\displaystyle\leq 3^{L}S\cdot\left(\sum_{\ell=-\infty}^{-1}\varepsilon^{(L-\ell)/3}+\sum_{\ell=0}^{\infty}\varepsilon^{\ell+(L-\ell)/3}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msup><mn>3</mn><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mi>ε</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>3</mn></mrow></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><msup><mi>ε</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>3</mn></mrow></mrow></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 3^{L}S\cdot\left(\sum_{\ell=-\infty}^{-1}\varepsilon^{(L-\ell)/3}+\sum_{\ell=0}^{\infty}\varepsilon^{\ell+(L-\ell)/3}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex75"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex75.m1" class="ltx_Math" alttext="\displaystyle\leq 3^{L}S\cdot\left(\frac{\varepsilon^{(L+1)/3}}{1-\varepsilon^{1/3}}+\frac{\varepsilon^{L/3}}{1-\varepsilon^{2/3}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msup><mn>3</mn><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>ε</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>3</mn></mrow></msup><mrow><mn>1</mn><mo>−</mo><msup><mi>ε</mi><mrow><mn>1</mn><mo>/</mo><mn>3</mn></mrow></msup></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mi>ε</mi><mrow><mi>L</mi><mo>/</mo><mn>3</mn></mrow></msup><mrow><mn>1</mn><mo>−</mo><msup><mi>ε</mi><mrow><mn>2</mn><mo>/</mo><mn>3</mn></mrow></msup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 3^{L}S\cdot\left(\frac{\varepsilon^{(L+1)/3}}{1-\varepsilon^{1/3}}+\frac{\varepsilon^{L/3}}{1-\varepsilon^{2/3}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex76"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex76.m1" class="ltx_Math" alttext="\displaystyle\leq 3^{L}S\cdot 2\varepsilon^{L/3}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><msup><mn>3</mn><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>ε</mi><mrow><mi>L</mi><mo>/</mo><mn>3</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 3^{L}S\cdot 2\varepsilon^{L/3}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p10.7" class="ltx_p">as claimed.
∎
<br class="ltx_break"></p>
</div>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Omitted Proofs for Perturbed Block MDP</h2>

<div id="A4.p1" class="ltx_para ltx_noindent">
<p id="A4.p1.1" class="ltx_p">Below, we restate the definition of a <math id="A4.p1.m1" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>-perturbed Block MDP. We then prove our main theoretical results for the perturbed Block MDP. In <a href="#A4.SS1" title="D.1 Belief Contraction ‣ Appendix D Omitted Proofs for Perturbed Block MDP ‣ To Distill or Decide? Understanding the Algorithmic Trade-off in Partially Observable Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">D.1</span></a>, we prove <a href="#S3.Thmtheorem2" title="Theorem 3.2 (See ). ‣ 3.3 The Perturbed Block MDP ‣ 3 Approximate Decodability and Belief Contraction ‣ To Distill or Decide? Understanding the Algorithmic Trade-off in Partially Observable Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.2</span></a> (the belief contraction result, restated as <a href="#A4.Thmtheorem1" title="Theorem D.1. ‣ D.1 Belief Contraction ‣ Appendix D Omitted Proofs for Perturbed Block MDP ‣ To Distill or Decide? Understanding the Algorithmic Trade-off in Partially Observable Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">D.1</span></a>). In <a href="#A4.SS2" title="D.2 Approximate Decodability ‣ Appendix D Omitted Proofs for Perturbed Block MDP ‣ To Distill or Decide? Understanding the Algorithmic Trade-off in Partially Observable Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">D.2</span></a>, we prove <a href="#S4.Thmproposition1" title="Proposition 4.1 (See ). ‣ 4.1 Theoretical Analysis under Deterministic Dynamics ‣ 4 Distillation is Competitive for Deterministic Dynamics ‣ To Distill or Decide? Understanding the Algorithmic Trade-off in Partially Observable Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">4.1</span></a> (the decodability result for deterministic dynamics, restated as <a href="#A4.Thmproposition1" title="Proposition D.1. ‣ D.2 Approximate Decodability ‣ Appendix D Omitted Proofs for Perturbed Block MDP ‣ To Distill or Decide? Understanding the Algorithmic Trade-off in Partially Observable Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">D.1</span></a>). Finally, in <a href="#A4.SS3" title="D.3 Misspecification Lower Bound for Stochastic Dynamics ‣ Appendix D Omitted Proofs for Perturbed Block MDP ‣ To Distill or Decide? Understanding the Algorithmic Trade-off in Partially Observable Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">D.3</span></a>, we prove <a href="#S5.Thmproposition1" title="Proposition 5.1 (See ). ‣ 5.1 Theoretical Analysis under Stochastic Dynamics ‣ 5 RL Outperforms Distillation for Stochastic Dynamics ‣ To Distill or Decide? Understanding the Algorithmic Trade-off in Partially Observable Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">5.1</span></a> (the misspecification lower bound for stochastic dynamics, restated as <a href="#A4.Thmproposition2" title="Proposition D.2. ‣ D.3 Misspecification Lower Bound for Stochastic Dynamics ‣ Appendix D Omitted Proofs for Perturbed Block MDP ‣ To Distill or Decide? Understanding the Algorithmic Trade-off in Partially Observable Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">D.2</span></a>).</p>
</div>
<div id="A4.Thmdefinition1" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A4.Thmdefinition1.2" class="ltx_text ltx_font_bold">Definition D.1</span></span><span id="A4.Thmdefinition1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A4.Thmdefinition1.p1" class="ltx_para ltx_noindent">
<p id="A4.Thmdefinition1.p1.1" class="ltx_p"><span id="A4.Thmdefinition1.p1.1.1" class="ltx_text ltx_font_italic">Fix a parameter <math id="A4.Thmdefinition1.p1.m1" class="ltx_Math" alttext="\delta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta&gt;0</annotation></semantics></math>. A POMDP <math id="A4.Thmdefinition1.p1.m2" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math> is a <em id="A4.Thmdefinition1.p1.1.1.1" class="ltx_emph ltx_font_upright"><math id="A4.Thmdefinition1.p1.m3" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>-perturbed Block MDP</em> if, for each <math id="A4.Thmdefinition1.p1.m4" class="ltx_Math" alttext="h\in[H]" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>H</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">h\in[H]</annotation></semantics></math>, there are <math id="A4.Thmdefinition1.p1.m5" class="ltx_Math" alttext="\widetilde{\mathbb{O}}_{h},E_{h}:\mathcal{S}_{h}\to\Delta(\mathcal{X}_{h})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝕆</mi><mo>~</mo></mover><mi>h</mi></msub><mo>,</mo><mrow><msub><mi>E</mi><mi>h</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>h</mi></msub><mo stretchy="false">→</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒳</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\mathbb{O}}_{h},E_{h}:\mathcal{S}_{h}\to\Delta(\mathcal{X}_{h})</annotation></semantics></math> such that <math id="A4.Thmdefinition1.p1.m6" class="ltx_Math" alttext="\widetilde{\mathbb{O}}_{h}:\mathcal{S}_{h}\to\Delta(\mathcal{X}_{h})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝕆</mi><mo>~</mo></mover><mi>h</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>h</mi></msub><mo stretchy="false">→</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒳</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\mathbb{O}}_{h}:\mathcal{S}_{h}\to\Delta(\mathcal{X}_{h})</annotation></semantics></math> satisfies the <em id="A4.Thmdefinition1.p1.1.1.2" class="ltx_emph ltx_font_upright">block</em> property <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib16" title="" class="ltx_ref">Du et al., 2019a</a>)</cite>, i.e. <math id="A4.Thmdefinition1.p1.m7" class="ltx_math_unparsed" alttext="\widetilde{\mathbb{O}}_{h}(\cdot\mid{}s_{h}),\widetilde{\mathbb{O}}_{h}(\cdot\mid{}s_{h}^{\prime})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝕆</mi><mo>~</mo></mover><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mover accent="true"><mi>𝕆</mi><mo>~</mo></mover><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><msubsup><mi>s</mi><mi>h</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\mathbb{O}}_{h}(\cdot\mid{}s_{h}),\widetilde{\mathbb{O}}_{h}(\cdot\mid{}s_{h}^{\prime})</annotation></semantics></math> have disjoint supports for all <math id="A4.Thmdefinition1.p1.m8" class="ltx_Math" alttext="s_{h}\neq s^{\prime}_{h}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mi>h</mi></msub><mo>≠</mo><msubsup><mi>s</mi><mi>h</mi><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">s_{h}\neq s^{\prime}_{h}</annotation></semantics></math>, and moreover the emission distribution <math id="A4.Thmdefinition1.p1.m9" class="ltx_Math" alttext="\mathbb{O}_{h}" display="inline" intent=":literal"><semantics><msub><mi>𝕆</mi><mi>h</mi></msub><annotation encoding="application/x-tex">\mathbb{O}_{h}</annotation></semantics></math> at step <math id="A4.Thmdefinition1.p1.m10" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> can be decomposed as follows:</span></p>
<table id="A4.Ex77" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex77.m1" class="ltx_Math" alttext="\mathbb{O}_{h}(x_{h}\mid{}s_{h})=(1-\delta)\widetilde{\mathbb{O}}_{h}(x_{h}\mid{}s_{h})+\delta E_{h}(x_{h}\mid{}s_{h})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>h</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝕆</mi><mo>~</mo></mover><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>h</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>h</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{O}_{h}(x_{h}\mid{}s_{h})=(1-\delta)\widetilde{\mathbb{O}}_{h}(x_{h}\mid{}s_{h})+\delta E_{h}(x_{h}\mid{}s_{h}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.Thmdefinition1.p2" class="ltx_para">
<p id="A4.Thmdefinition1.p2.1" class="ltx_p"><span id="A4.Thmdefinition1.p2.1.1" class="ltx_text ltx_font_italic">For notational convenience, for each <math id="A4.Thmdefinition1.p2.m1" class="ltx_Math" alttext="x\in\mathcal{X}_{h}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒳</mi><mi>h</mi></msub></mrow><annotation encoding="application/x-tex">x\in\mathcal{X}_{h}</annotation></semantics></math> let <math id="A4.Thmdefinition1.p2.m2" class="ltx_Math" alttext="\phi(x)\in\mathcal{S}_{h}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>h</mi></msub></mrow><annotation encoding="application/x-tex">\phi(x)\in\mathcal{S}_{h}</annotation></semantics></math> be the unique state for which
<math id="A4.Thmdefinition1.p2.m3" class="ltx_Math" alttext="\widetilde{\mathbb{O}}_{h}(x\mid{}\phi(x))&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>𝕆</mi><mo>~</mo></mover><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\widetilde{\mathbb{O}}_{h}(x\mid{}\phi(x))&gt;0</annotation></semantics></math> (or arbitrary, if no such state exists).</span></p>
</div>
</div>
<div id="A4.Thmdefinition2" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A4.Thmdefinition2.2" class="ltx_text ltx_font_bold">Definition D.2</span></span><span id="A4.Thmdefinition2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A4.Thmdefinition2.p1" class="ltx_para ltx_noindent">
<p id="A4.Thmdefinition2.p1.1" class="ltx_p"><span id="A4.Thmdefinition2.p1.1.1" class="ltx_text ltx_font_italic">For any <math id="A4.Thmdefinition2.p1.m1" class="ltx_Math" alttext="h\in[H]" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>H</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">h\in[H]</annotation></semantics></math>, <math id="A4.Thmdefinition2.p1.m2" class="ltx_Math" alttext="b\in\mathcal{S}_{h}" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>h</mi></msub></mrow><annotation encoding="application/x-tex">b\in\mathcal{S}_{h}</annotation></semantics></math>, and <math id="A4.Thmdefinition2.p1.m3" class="ltx_Math" alttext="x_{h}\in\mathcal{O}_{h}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>h</mi></msub><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>h</mi></msub></mrow><annotation encoding="application/x-tex">x_{h}\in\mathcal{O}_{h}</annotation></semantics></math>, we write</span></p>
<table id="A4.Ex78" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex78.m1" class="ltx_Math" alttext="\mathbb{O}_{h}(x_{h}\mid{}b):=\sum_{z_{h}\in\mathcal{S}_{h}}\mathbb{O}_{h}(x_{h}\mid{}z_{h})b(z_{h})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>h</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">:=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>z</mi><mi>h</mi></msub><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>h</mi></msub></mrow></munder><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>h</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>z</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{O}_{h}(x_{h}\mid{}b):=\sum_{z_{h}\in\mathcal{S}_{h}}\mathbb{O}_{h}(x_{h}\mid{}z_{h})b(z_{h}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.Thmdefinition2.p1.2" class="ltx_p"><span id="A4.Thmdefinition2.p1.2.1" class="ltx_text ltx_font_italic">We similarly define <math id="A4.Thmdefinition2.p1.m4" class="ltx_Math" alttext="E_{h}(x_{h}\mid{}b)" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>h</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">E_{h}(x_{h}\mid{}b)</annotation></semantics></math> and <math id="A4.Thmdefinition2.p1.m5" class="ltx_Math" alttext="\widetilde{\mathbb{O}}_{h}(x_{h}\mid{}b)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝕆</mi><mo>~</mo></mover><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>h</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\mathbb{O}}_{h}(x_{h}\mid{}b)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A4.p2" class="ltx_para ltx_noindent">
<p id="A4.p2.1" class="ltx_p">Notice that <math id="A4.p2.m1" class="ltx_Math" alttext="\widetilde{\mathbb{O}}_{h}(x_{h}\mid{}b)=b(\phi(x_{h}))\widetilde{\mathbb{O}}_{h}(x_{h}\mid{}\phi(x_{h}))" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>𝕆</mi><mo>~</mo></mover><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>h</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝕆</mi><mo>~</mo></mover><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>h</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\mathbb{O}}_{h}(x_{h}\mid{}b)=b(\phi(x_{h}))\widetilde{\mathbb{O}}_{h}(x_{h}\mid{}\phi(x_{h}))</annotation></semantics></math>.</p>
</div>
<section id="A4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.1 </span>Belief Contraction</h3>

<div id="A4.SS1.p1" class="ltx_para ltx_noindent">
<p id="A4.SS1.p1.1" class="ltx_p">In this section, we prove <a href="#A4.Thmtheorem1" title="Theorem D.1. ‣ D.1 Belief Contraction ‣ Appendix D Omitted Proofs for Perturbed Block MDP ‣ To Distill or Decide? Understanding the Algorithmic Trade-off in Partially Observable Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">D.1</span></a>, a slight generalization of <a href="#S3.Thmtheorem2" title="Theorem 3.2 (See ). ‣ 3.3 The Perturbed Block MDP ‣ 3 Approximate Decodability and Belief Contraction ‣ To Distill or Decide? Understanding the Algorithmic Trade-off in Partially Observable Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.2</span></a>. The proof broadly follows the proof of belief contraction for <math id="A4.SS1.p1.m1" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>-observable POMDPs <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib24" title="" class="ltx_ref">Golowich et al., 2023</a>)</cite> (of which <math id="A4.SS1.p1.m2" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>-perturbed Block MDPs are a special case — see <a href="#A4.Thmremark1" title="Remark D.1. ‣ D.1 Belief Contraction ‣ Appendix D Omitted Proofs for Perturbed Block MDP ‣ To Distill or Decide? Understanding the Algorithmic Trade-off in Partially Observable Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Remark</span> <span class="ltx_text ltx_ref_tag">D.1</span></a>), but since we require a stronger bound, we must modify the argument.</p>
</div>
<div id="A4.SS1.p2" class="ltx_para ltx_noindent">
<p id="A4.SS1.p2.1" class="ltx_p">The basic idea (and main technical difficulty) in <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib24" title="" class="ltx_ref">Golowich et al. (2023)</a></cite> is to identify a monotonic transform of an <math id="A4.SS1.p2.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>-divergence that multiplicatively contracts in expectation under the Bayes operator (<a href="#A2.Thmdefinition1" title="Definition B.1 (Belief state update ( , )). ‣ B.1 Belief states ‣ Appendix B Additional Preliminaries ‣ To Distill or Decide? Understanding the Algorithmic Trade-off in Partially Observable Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Definition</span> <span class="ltx_text ltx_ref_tag">B.1</span></a>). In their case, they show that <math id="A4.SS1.p2.m2" class="ltx_Math" alttext="\sqrt{\mathsf{KL}\left(\mathbb{B}_{h}(b;x_{h})\,\|\,\mathbb{B}_{h}(b^{\prime};x_{h})\right)}" display="inline" intent=":literal"><semantics><msqrt><mrow><mi>𝖪𝖫</mi><mo>(</mo><mi>𝔹</mi><msub><mrow></mrow><mi>h</mi></msub><mo stretchy="false">(</mo><mi>b</mi><mo>;</mo><mi>x</mi><msub><mrow></mrow><mi>h</mi></msub><mo stretchy="false">)</mo><mo lspace="0.170em" rspace="0.337em">∥</mo><mi>𝔹</mi><msub><mrow></mrow><mi>h</mi></msub><mo stretchy="false">(</mo><mi>b</mi><msup><mrow></mrow><mo>′</mo></msup><mo>;</mo><mi>x</mi><msub><mrow></mrow><mi>h</mi></msub><mo stretchy="false">)</mo><mo>)</mo></mrow></msqrt><annotation encoding="application/x-tex">\sqrt{\mathsf{KL}\left(\mathbb{B}_{h}(b;x_{h})\,\|\,\mathbb{B}_{h}(b^{\prime};x_{h})\right)}</annotation></semantics></math> contracts by roughly a constant factor (relative to <math id="A4.SS1.p2.m3" class="ltx_Math" alttext="\sqrt{\mathsf{KL}\left(b\,\|\,b^{\prime}\right)}" display="inline" intent=":literal"><semantics><msqrt><mrow><mi>𝖪𝖫</mi><mo>(</mo><mi>b</mi><mo lspace="0.170em" rspace="0.337em">∥</mo><mi>b</mi><msup><mrow></mrow><mo>′</mo></msup><mo>)</mo></mrow></msqrt><annotation encoding="application/x-tex">\sqrt{\mathsf{KL}\left(b\,\|\,b^{\prime}\right)}</annotation></semantics></math>) in expectation over <math id="A4.SS1.p2.m4" class="ltx_math_unparsed" alttext="x_{h}\sim\mathbb{O}_{h}(\cdot\mid{}b)" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>h</mi></msub><mo>∼</mo><msub><mi>𝕆</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">x_{h}\sim\mathbb{O}_{h}(\cdot\mid{}b)</annotation></semantics></math>. That is, updating the true belief and approximate belief by an observation drawn from the true belief tends to decrease the <math id="A4.SS1.p2.m5" class="ltx_Math" alttext="\mathsf{KL}" display="inline" intent=":literal"><semantics><mi>𝖪𝖫</mi><annotation encoding="application/x-tex">\mathsf{KL}</annotation></semantics></math>-divergence. Updating the two beliefs by applying a transition matrix cannot increase the <math id="A4.SS1.p2.m6" class="ltx_Math" alttext="\mathsf{KL}" display="inline" intent=":literal"><semantics><mi>𝖪𝖫</mi><annotation encoding="application/x-tex">\mathsf{KL}</annotation></semantics></math>-divergence since it is an <math id="A4.SS1.p2.m7" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>-divergence, so an iterative argument (alternating between observation updates and transition updates) proves exponential contraction of the belief error.</p>
</div>
<div id="A4.SS1.p3" class="ltx_para ltx_noindent">
<p id="A4.SS1.p3.1" class="ltx_p">However, we would like to prove contraction by <math id="A4.SS1.p3.m1" class="ltx_Math" alttext="\mathrm{poly}(\delta)" display="inline" intent=":literal"><semantics><mrow><mi>poly</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{poly}(\delta)</annotation></semantics></math> per step, and the following example seems to present an obstacle to proving such contraction via <math id="A4.SS1.p3.m2" class="ltx_Math" alttext="\mathsf{KL}" display="inline" intent=":literal"><semantics><mi>𝖪𝖫</mi><annotation encoding="application/x-tex">\mathsf{KL}</annotation></semantics></math>-divergence. It also presents an obstacle to directly analyzing <math id="A4.SS1.p3.m3" class="ltx_Math" alttext="\mathsf{TV}" display="inline" intent=":literal"><semantics><mi>𝖳𝖵</mi><annotation encoding="application/x-tex">\mathsf{TV}</annotation></semantics></math>-distance.</p>
</div>
<div id="A4.Thmexample1" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A4.Thmexample1.2" class="ltx_text ltx_font_bold">Example D.1</span></span><span id="A4.Thmexample1.3" class="ltx_text ltx_font_bold"> </span>(Failure of contraction of <math id="A4.Thmexample1.m1" class="ltx_Math" alttext="\mathsf{TV}" display="inline" intent=":literal"><semantics><mi>𝖳𝖵</mi><annotation encoding="application/x-tex">\mathsf{TV}</annotation></semantics></math> and <math id="A4.Thmexample1.m2" class="ltx_Math" alttext="\mathsf{KL}" display="inline" intent=":literal"><semantics><mi>𝖪𝖫</mi><annotation encoding="application/x-tex">\mathsf{KL}</annotation></semantics></math>)<span id="A4.Thmexample1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A4.Thmexample1.p1" class="ltx_para ltx_noindent">
<p id="A4.Thmexample1.p1.1" class="ltx_p"><span id="A4.Thmexample1.p1.1.1" class="ltx_text ltx_font_italic">Fix <math id="A4.Thmexample1.p1.m1" class="ltx_Math" alttext="\delta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta&gt;0</annotation></semantics></math>. Let <math id="A4.Thmexample1.p1.m2" class="ltx_Math" alttext="\mathcal{S}=\mathcal{X}=\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{S}=\mathcal{X}=\{0,1\}</annotation></semantics></math> and let <math id="A4.Thmexample1.p1.m3" class="ltx_Math" alttext="\mathbb{O}:\mathcal{S}\to\Delta(\mathcal{X})" display="inline" intent=":literal"><semantics><mrow><mi>𝕆</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">→</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{O}:\mathcal{S}\to\Delta(\mathcal{X})</annotation></semantics></math> be defined by <math id="A4.Thmexample1.p1.m4" class="ltx_Math" alttext="\mathbb{O}(x\mid{}x)=1-\delta" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝕆</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow></mrow><annotation encoding="application/x-tex">\mathbb{O}(x\mid{}x)=1-\delta</annotation></semantics></math>. Define <math id="A4.Thmexample1.p1.m5" class="ltx_Math" alttext="b=(1,0)" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">b=(1,0)</annotation></semantics></math> and <math id="A4.Thmexample1.p1.m6" class="ltx_Math" alttext="b^{\prime}=(\delta^{2},1-\delta^{2})" display="inline" intent=":literal"><semantics><mrow><msup><mi>b</mi><mo>′</mo></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><msup><mi>δ</mi><mn>2</mn></msup><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>δ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">b^{\prime}=(\delta^{2},1-\delta^{2})</annotation></semantics></math>. Then it holds almost surely over <math id="A4.Thmexample1.p1.m7" class="ltx_math_unparsed" alttext="x\sim\mathbb{O}(\cdot\mid{}b)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∼</mo><mi>𝕆</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">x\sim\mathbb{O}(\cdot\mid{}b)</annotation></semantics></math> that:</span></p>
<ul id="A4.I1" class="ltx_itemize">
<li id="A4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="A4.I1.i1.p1.1" class="ltx_p"><math id="A4.I1.i1.p1.m1" class="ltx_Math" alttext="\mathsf{TV}(\mathbb{B}(b;x),\mathbb{B}(b^{\prime};x))\geq 1-\delta" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝖳𝖵</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝔹</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝔹</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>b</mi><mo>′</mo></msup><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow></mrow><annotation encoding="application/x-tex">\mathsf{TV}(\mathbb{B}(b;x),\mathbb{B}(b^{\prime};x))\geq 1-\delta</annotation></semantics></math><span id="A4.I1.i1.p1.1.1" class="ltx_text ltx_font_italic"> even though </span><math id="A4.I1.i1.p1.m2" class="ltx_Math" alttext="\mathsf{TV}(b,b^{\prime})\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝖳𝖵</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\mathsf{TV}(b,b^{\prime})\leq 1</annotation></semantics></math><span id="A4.I1.i1.p1.1.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i2.p1" class="ltx_para">
<p id="A4.I1.i2.p1.1" class="ltx_p"><math id="A4.I1.i2.p1.m1" class="ltx_math_unparsed" alttext="\mathsf{KL}\left(\mathbb{B}(b;x)\,\|\,\mathbb{B}(b^{\prime};x)\right)\geq\log(1/\delta)" display="inline" intent=":literal"><semantics><mrow><mi>𝖪𝖫</mi><mrow><mo>(</mo><mi>𝔹</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>;</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0.337em">∥</mo><mi>𝔹</mi><mrow><mo stretchy="false">(</mo><msup><mi>b</mi><mo>′</mo></msup><mo>;</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>≥</mo><mi>log</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>/</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{KL}\left(\mathbb{B}(b;x)\,\|\,\mathbb{B}(b^{\prime};x)\right)\geq\log(1/\delta)</annotation></semantics></math><span id="A4.I1.i2.p1.1.1" class="ltx_text ltx_font_italic"> even though </span><math id="A4.I1.i2.p1.m2" class="ltx_math_unparsed" alttext="\mathsf{KL}\left(b\,\|\,b^{\prime}\right)\leq 2\log(1/\delta)" display="inline" intent=":literal"><semantics><mrow><mi>𝖪𝖫</mi><mrow><mo>(</mo><mi>b</mi><mo lspace="0.170em" rspace="0.337em">∥</mo><msup><mi>b</mi><mo>′</mo></msup><mo>)</mo></mrow><mo>≤</mo><mn>2</mn><mi>log</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>/</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{KL}\left(b\,\|\,b^{\prime}\right)\leq 2\log(1/\delta)</annotation></semantics></math><span id="A4.I1.i2.p1.1.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ul>
</div>
</div>
<div id="A4.SS1.p4" class="ltx_para ltx_noindent">
<p id="A4.SS1.p4.1" class="ltx_p">To resolve this, we observe that when the <math id="A4.SS1.p4.m1" class="ltx_Math" alttext="\mathsf{TV}" display="inline" intent=":literal"><semantics><mi>𝖳𝖵</mi><annotation encoding="application/x-tex">\mathsf{TV}</annotation></semantics></math>-distance fails to decay, the density ratio <math id="A4.SS1.p4.m2" class="ltx_Math" alttext="\left\lVert b/b^{\prime}\right\rVert_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mi>b</mi><mo>/</mo><msup><mi>b</mi><mo>′</mo></msup></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\left\lVert b/b^{\prime}\right\rVert_{\infty}</annotation></semantics></math> does decay. To formalize this, we study contraction of the following error metric. While we cannot show that it contracts by <math id="A4.SS1.p4.m3" class="ltx_Math" alttext="\mathrm{poly}(\delta)" display="inline" intent=":literal"><semantics><mrow><mi>poly</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{poly}(\delta)</annotation></semantics></math> in expectation, we can show that it contracts with high probability; this is the content of <a href="#A4.Thmlemma2" title="Lemma D.2. ‣ D.1 Belief Contraction ‣ Appendix D Omitted Proofs for Perturbed Block MDP ‣ To Distill or Decide? Understanding the Algorithmic Trade-off in Partially Observable Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">D.2</span></a> below.</p>
</div>
<div id="A4.Thmdefinition3" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A4.Thmdefinition3.2" class="ltx_text ltx_font_bold">Definition D.3</span></span><span id="A4.Thmdefinition3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A4.Thmdefinition3.p1" class="ltx_para ltx_noindent">
<p id="A4.Thmdefinition3.p1.1" class="ltx_p"><span id="A4.Thmdefinition3.p1.1.1" class="ltx_text ltx_font_italic">For distributions <math id="A4.Thmdefinition3.p1.m1" class="ltx_Math" alttext="b,b^{\prime}\in\Delta(\mathcal{S})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>b</mi><mo>,</mo><msup><mi>b</mi><mo>′</mo></msup></mrow><mo>∈</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">b,b^{\prime}\in\Delta(\mathcal{S})</annotation></semantics></math> with <math id="A4.Thmdefinition3.p1.m2" class="ltx_Math" alttext="b\ll b^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>≪</mo><msup><mi>b</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">b\ll b^{\prime}</annotation></semantics></math>, we define</span></p>
<table id="A4.Ex79" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex79.m1" class="ltx_math_unparsed" alttext="D_{\star}(b\|b^{\prime}):=\mathsf{TV}(b,b^{\prime})\cdot\left\lVert\frac{b}{b^{\prime}}\right\rVert_{\infty}." display="block" intent=":literal"><semantics><mrow><msub><mi>D</mi><mo>⋆</mo></msub><mrow><mo stretchy="false">(</mo><mi>b</mi><mo lspace="0em" rspace="0.167em">∥</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>:=</mo><mi>𝖳𝖵</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><msup><mi>b</mi><mo>′</mo></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mrow><mo>‖</mo><mfrac><mi>b</mi><msup><mi>b</mi><mo>′</mo></msup></mfrac><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">D_{\star}(b\|b^{\prime}):=\mathsf{TV}(b,b^{\prime})\cdot\left\lVert\frac{b}{b^{\prime}}\right\rVert_{\infty}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A4.SS1.p5" class="ltx_para ltx_noindent">
<p id="A4.SS1.p5.1" class="ltx_p">Note that the above metric upper bounds <math id="A4.SS1.p5.m1" class="ltx_Math" alttext="\mathsf{TV}" display="inline" intent=":literal"><semantics><mi>𝖳𝖵</mi><annotation encoding="application/x-tex">\mathsf{TV}</annotation></semantics></math>-distance, and is upper bounded by <math id="A4.SS1.p5.m2" class="ltx_Math" alttext="\left\lVert b/b^{\prime}\right\rVert_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mi>b</mi><mo>/</mo><msup><mi>b</mi><mo>′</mo></msup></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\left\lVert b/b^{\prime}\right\rVert_{\infty}</annotation></semantics></math>. Also, as the product of metrics that satisfy the data processing inequality (<a href="#A3.Thmlemma1" title="Lemma C.1 (Data processing inequality). ‣ Appendix C Technical Lemmas ‣ To Distill or Decide? Understanding the Algorithmic Trade-off in Partially Observable Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">C.1</span></a>), it also satisfies the same inequality, so it cannot increase under application of (even stochastic) transitions.</p>
</div>
<div id="A4.Thmlemma1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A4.Thmlemma1.2" class="ltx_text ltx_font_bold">Lemma D.1</span></span><span id="A4.Thmlemma1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A4.Thmlemma1.p1" class="ltx_para">
<p id="A4.Thmlemma1.p1.1" class="ltx_p"><span id="A4.Thmlemma1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A4.Thmlemma1.p1.m1" class="ltx_Math" alttext="h\in[H]" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>H</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">h\in[H]</annotation></semantics></math>. Fix <math id="A4.Thmlemma1.p1.m2" class="ltx_Math" alttext="b,b^{\prime}\in\Delta(\mathcal{S}_{h})" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>,</mo><mrow><msup><mi>b</mi><mo>′</mo></msup><mo>∈</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">b,b^{\prime}\in\Delta(\mathcal{S}_{h})</annotation></semantics></math> with <math id="A4.Thmlemma1.p1.m3" class="ltx_Math" alttext="b\ll b^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>≪</mo><msup><mi>b</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">b\ll b^{\prime}</annotation></semantics></math>, and fix <math id="A4.Thmlemma1.p1.m4" class="ltx_Math" alttext="x\in\mathcal{O}_{h}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>h</mi></msub></mrow><annotation encoding="application/x-tex">x\in\mathcal{O}_{h}</annotation></semantics></math>. Then</span></p>
<table id="A4.EGx23" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex80"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex80.m1" class="ltx_Math" alttext="\displaystyle\left\lVert\frac{\mathbb{B}_{h}(b;x)}{\mathbb{B}_{h}(b^{\prime};x)}\right\rVert_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝔹</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝔹</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>b</mi><mo>′</mo></msup><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\lVert\frac{\mathbb{B}_{h}(b;x)}{\mathbb{B}_{h}(b^{\prime};x)}\right\rVert_{\infty}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex80.m2" class="ltx_Math" alttext="\displaystyle=\frac{\mathbb{O}_{h}(x\mid{}b^{\prime})}{\mathbb{O}_{h}(x\mid{}b)}\cdot\left\lVert\frac{b}{b^{\prime}}\right\rVert_{\infty}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mrow><mo>‖</mo><mstyle displaystyle="true"><mfrac><mi>b</mi><msup><mi>b</mi><mo>′</mo></msup></mfrac></mstyle><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbb{O}_{h}(x\mid{}b^{\prime})}{\mathbb{O}_{h}(x\mid{}b)}\cdot\left\lVert\frac{b}{b^{\prime}}\right\rVert_{\infty}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A4.SS1.p6" class="ltx_para ltx_noindent">
<p id="A4.SS1.p6.1" class="ltx_p"><span id="A4.SS1.p6.1.1" class="ltx_text ltx_font_bold">Proof. </span>We have</p>
<table id="A4.EGx24" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex81.m1" class="ltx_Math" alttext="\displaystyle\left\lVert\frac{\mathbb{B}_{h}(b;x)}{\mathbb{B}_{h}(b^{\prime};x)}\right\rVert_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝔹</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝔹</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>b</mi><mo>′</mo></msup><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\lVert\frac{\mathbb{B}_{h}(b;x)}{\mathbb{B}_{h}(b^{\prime};x)}\right\rVert_{\infty}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex81.m2" class="ltx_Math" alttext="\displaystyle=\max_{s\in\mathcal{S}_{h}}\frac{\mathbb{O}_{h}(x\mid{}s)b(s)}{\mathbb{O}_{h}(x\mid{}b)}\cdot\frac{\mathbb{O}_{h}(x\mid{}b^{\prime})}{\mathbb{O}_{h}(x\mid{}s)b^{\prime}(s)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><munder><mi>max</mi><mrow><mi>s</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>h</mi></msub></mrow></munder><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>b</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\max_{s\in\mathcal{S}_{h}}\frac{\mathbb{O}_{h}(x\mid{}s)b(s)}{\mathbb{O}_{h}(x\mid{}b)}\cdot\frac{\mathbb{O}_{h}(x\mid{}b^{\prime})}{\mathbb{O}_{h}(x\mid{}s)b^{\prime}(s)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex82"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex82.m1" class="ltx_Math" alttext="\displaystyle=\max_{s\in\mathcal{S}_{h}}\frac{b(s)}{b^{\prime}(s)}\cdot\frac{\mathbb{O}_{h}(x\mid{}b^{\prime})}{\mathbb{O}_{h}(x\mid{}b)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><munder><mi>max</mi><mrow><mi>s</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>h</mi></msub></mrow></munder><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msup><mi>b</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\max_{s\in\mathcal{S}_{h}}\frac{b(s)}{b^{\prime}(s)}\cdot\frac{\mathbb{O}_{h}(x\mid{}b^{\prime})}{\mathbb{O}_{h}(x\mid{}b)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex83"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex83.m1" class="ltx_Math" alttext="\displaystyle=\frac{\mathbb{O}_{h}(x\mid{}b^{\prime})}{\mathbb{O}_{h}(x\mid{}b)}\cdot\left\lVert\frac{b}{b^{\prime}}\right\rVert_{\infty}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mrow><mo>‖</mo><mstyle displaystyle="true"><mfrac><mi>b</mi><msup><mi>b</mi><mo>′</mo></msup></mfrac></mstyle><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbb{O}_{h}(x\mid{}b^{\prime})}{\mathbb{O}_{h}(x\mid{}b)}\cdot\left\lVert\frac{b}{b^{\prime}}\right\rVert_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p6.2" class="ltx_p">as claimed.
∎
<br class="ltx_break"></p>
</div>
<div id="A4.Thmlemma2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A4.Thmlemma2.2" class="ltx_text ltx_font_bold">Lemma D.2</span></span><span id="A4.Thmlemma2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A4.Thmlemma2.p1" class="ltx_para ltx_noindent">
<p id="A4.Thmlemma2.p1.1" class="ltx_p"><span id="A4.Thmlemma2.p1.1.1" class="ltx_text ltx_font_italic">Fix <math id="A4.Thmlemma2.p1.m1" class="ltx_Math" alttext="h\in[H]" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>H</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">h\in[H]</annotation></semantics></math> and <math id="A4.Thmlemma2.p1.m2" class="ltx_Math" alttext="b,b^{\prime}\in\Delta(\mathcal{S}_{h})" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>,</mo><mrow><msup><mi>b</mi><mo>′</mo></msup><mo>∈</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">b,b^{\prime}\in\Delta(\mathcal{S}_{h})</annotation></semantics></math>. Draw <math id="A4.Thmlemma2.p1.m3" class="ltx_math_unparsed" alttext="x\sim\mathbb{O}_{h}(\cdot\mid{}b)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∼</mo><msub><mi>𝕆</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">x\sim\mathbb{O}_{h}(\cdot\mid{}b)</annotation></semantics></math>. Define random variable</span></p>
<table id="A4.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E5.m1" class="ltx_math_unparsed" alttext="\xi:=D_{\star}(\mathbb{B}_{h}(b;x)\|\mathbb{B}_{h}(b^{\prime};x))=\mathsf{TV}(\mathbb{B}(b;x),\mathbb{B}(b^{\prime};x))\left\lVert\frac{\mathbb{B}(b;x)}{\mathbb{B}(b^{\prime};x)}\right\rVert_{\infty}.\addcontentsline{lla}{section}{\hbox to20.74pt{\crtrefnumber{eq:xi-def}\hfil}eq:xi-def}" display="block" intent=":literal"><semantics><mrow><mi>ξ</mi><mo>:=</mo><msub><mi>D</mi><mo>⋆</mo></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝔹</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>;</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>𝔹</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><msup><mi>b</mi><mo>′</mo></msup><mo>;</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝖳𝖵</mi><mrow><mo stretchy="false">(</mo><mi>𝔹</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>;</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>𝔹</mi><mrow><mo stretchy="false">(</mo><msup><mi>b</mi><mo>′</mo></msup><mo>;</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><msub><mrow><mo>‖</mo><mfrac><mrow><mi>𝔹</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>𝔹</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>b</mi><mo>′</mo></msup><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\xi:=D_{\star}(\mathbb{B}_{h}(b;x)\|\mathbb{B}_{h}(b^{\prime};x))=\mathsf{TV}(\mathbb{B}(b;x),\mathbb{B}(b^{\prime};x))\left\lVert\frac{\mathbb{B}(b;x)}{\mathbb{B}(b^{\prime};x)}\right\rVert_{\infty}.\addcontentsline{lla}{section}{\hbox to20.74pt{\crtrefnumber{eq:xi-def}\hfil}eq:xi-def}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5)</span></td></tr></tbody>
</table>
<p id="A4.Thmlemma2.p1.2" class="ltx_p"><span id="A4.Thmlemma2.p1.2.1" class="ltx_text ltx_font_italic">Then <math id="A4.Thmlemma2.p1.m4" class="ltx_math_unparsed" alttext="\mathbb{E}[\xi]\leq 4D_{\star}(b\|b^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mi>ξ</mi><mo stretchy="false">]</mo></mrow><mo>≤</mo><mn>4</mn><msub><mi>D</mi><mo>⋆</mo></msub><mrow><mo stretchy="false">(</mo><mi>b</mi><mo lspace="0em" rspace="0.167em">∥</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[\xi]\leq 4D_{\star}(b\|b^{\prime})</annotation></semantics></math> and</span></p>
<table id="A4.Ex84" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex84.m1" class="ltx_math_unparsed" alttext="\Pr\left[\xi&gt;4\delta^{1/3}D_{\star}(b\|b^{\prime})\right]\leq 2\delta^{1/3}." display="block" intent=":literal"><semantics><mrow><mi>Pr</mi><mrow><mo>[</mo><mi>ξ</mi><mo>&gt;</mo><mn>4</mn><msup><mi>δ</mi><mrow><mn>1</mn><mo>/</mo><mn>3</mn></mrow></msup><msub><mi>D</mi><mo>⋆</mo></msub><mrow><mo stretchy="false">(</mo><mi>b</mi><mo lspace="0em" rspace="0.167em">∥</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>≤</mo><mn>2</mn><msup><mi>δ</mi><mrow><mn>1</mn><mo>/</mo><mn>3</mn></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Pr\left[\xi&gt;4\delta^{1/3}D_{\star}(b\|b^{\prime})\right]\leq 2\delta^{1/3}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A4.SS1.p7" class="ltx_para ltx_noindent">
<p id="A4.SS1.p7.1" class="ltx_p"><span id="A4.SS1.p7.1.1" class="ltx_text ltx_font_bold">Proof. </span>First, we compute that for any fixed <math id="A4.SS1.p7.m1" class="ltx_Math" alttext="x\in\mathcal{X}_{h}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒳</mi><mi>h</mi></msub></mrow><annotation encoding="application/x-tex">x\in\mathcal{X}_{h}</annotation></semantics></math>,</p>
<table id="A4.EGx25" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex85"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex85.m1" class="ltx_Math" alttext="\displaystyle\mathsf{TV}(\mathbb{B}(b;x),\mathbb{B}(b^{\prime};x))" display="inline" intent=":literal"><semantics><mrow><mi>𝖳𝖵</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝔹</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝔹</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>b</mi><mo>′</mo></msup><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathsf{TV}(\mathbb{B}(b;x),\mathbb{B}(b^{\prime};x))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex86.m1" class="ltx_Math" alttext="\displaystyle=\sum_{s\in\mathcal{S}_{h}}\mathbb{O}_{h}(x\mid{}s)\left|\frac{b(s)}{\mathbb{O}_{h}(x\mid{}b)}-\frac{b^{\prime}(s)}{\mathbb{O}_{h}(x\mid{}b^{\prime})}\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>h</mi></msub></mrow></munder></mstyle><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>|</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{s\in\mathcal{S}_{h}}\mathbb{O}_{h}(x\mid{}s)\left|\frac{b(s)}{\mathbb{O}_{h}(x\mid{}b)}-\frac{b^{\prime}(s)}{\mathbb{O}_{h}(x\mid{}b^{\prime})}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.E6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E6.m1" class="ltx_Math" alttext="\displaystyle=(1-\delta)\widetilde{\mathbb{O}}_{h}(x\mid{}\phi(x))\left|\frac{b(\phi(x))}{\mathbb{O}_{h}(x\mid{}b)}-\frac{b^{\prime}(\phi(x))}{\mathbb{O}_{h}(x\mid{}b^{\prime})}\right|+\delta\sum_{s\in\mathcal{S}_{h}}E_{h}(x\mid{}s)\left|\frac{b(s)}{\mathbb{O}_{h}(x\mid{}b)}-\frac{b^{\prime}(s)}{\mathbb{O}_{h}(x\mid{}b^{\prime})}\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝕆</mi><mo>~</mo></mover><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>|</mo></mrow></mrow><mo>+</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>h</mi></msub></mrow></munder></mstyle><mrow><msub><mi>E</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>|</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=(1-\delta)\widetilde{\mathbb{O}}_{h}(x\mid{}\phi(x))\left|\frac{b(\phi(x))}{\mathbb{O}_{h}(x\mid{}b)}-\frac{b^{\prime}(\phi(x))}{\mathbb{O}_{h}(x\mid{}b^{\prime})}\right|+\delta\sum_{s\in\mathcal{S}_{h}}E_{h}(x\mid{}s)\left|\frac{b(s)}{\mathbb{O}_{h}(x\mid{}b)}-\frac{b^{\prime}(s)}{\mathbb{O}_{h}(x\mid{}b^{\prime})}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6)</span></td></tr></tbody>
</table>
<p id="A4.SS1.p7.2" class="ltx_p">by <a href="#A2.Thmdefinition1" title="Definition B.1 (Belief state update ( , )). ‣ B.1 Belief states ‣ Appendix B Additional Preliminaries ‣ To Distill or Decide? Understanding the Algorithmic Trade-off in Partially Observable Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Definition</span> <span class="ltx_text ltx_ref_tag">B.1</span></a> and <a href="#A4.Thmdefinition1" title="Definition D.1. ‣ Appendix D Omitted Proofs for Perturbed Block MDP ‣ To Distill or Decide? Understanding the Algorithmic Trade-off in Partially Observable Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Definition</span> <span class="ltx_text ltx_ref_tag">D.1</span></a>. We bound these terms individually. To bound the first term, since <math id="A4.SS1.p7.m2" class="ltx_Math" alttext="\mathbb{O}_{h}(x\mid{}b)=(1-\delta)b(\phi(x))\widetilde{\mathbb{O}}_{h}(x\mid{}\phi(x))+\delta E_{h}(x\mid{}b)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝕆</mi><mo>~</mo></mover><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{O}_{h}(x\mid{}b)=(1-\delta)b(\phi(x))\widetilde{\mathbb{O}}_{h}(x\mid{}\phi(x))+\delta E_{h}(x\mid{}b)</annotation></semantics></math> and <math id="A4.SS1.p7.m3" class="ltx_Math" alttext="\mathbb{O}_{h}(x\mid{}b^{\prime})=(1-\delta)b^{\prime}(\phi(x))\widetilde{\mathbb{O}}_{h}(x\mid{}\phi(x))+\delta E_{h}(x\mid{}b^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>b</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝕆</mi><mo>~</mo></mover><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{O}_{h}(x\mid{}b^{\prime})=(1-\delta)b^{\prime}(\phi(x))\widetilde{\mathbb{O}}_{h}(x\mid{}\phi(x))+\delta E_{h}(x\mid{}b^{\prime})</annotation></semantics></math>,</p>
<table id="A4.EGx26" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
