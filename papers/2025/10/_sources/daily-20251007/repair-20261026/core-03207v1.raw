<tbody id="A3.Ex37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex37.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{s_{h-L:h-1}}\mathbb{P}^{\pi}[s_{h-L:h-1},x_{h-L+1:h-1},a_{h-L:h-2}]\pi(a_{h-1}\mid{}x_{h-L+1:h-1},a_{h-L:h-2})\mathbb{P}_{h}[s_{h}\mid{}s_{h-1},a_{h-1}]\mathbb{O}_{h}(x_{h}\mid{}s_{h})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><msub><mrow></mrow><mrow><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub></mrow></munder></mstyle><msup><mi>ℙ</mi><mi>π</mi></msup><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mrow><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msub><mi>x</mi><mrow><mrow><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>2</mn></mrow></mrow></msub><mo stretchy="false">]</mo></mrow><mi>π</mi><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>x</mi><mrow><mrow><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>2</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><msub><mi>ℙ</mi><mi>h</mi></msub><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mi>h</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>h</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{s_{h-L:h-1}}\mathbb{P}^{\pi}[s_{h-L:h-1},x_{h-L+1:h-1},a_{h-L:h-2}]\pi(a_{h-1}\mid{}x_{h-L+1:h-1},a_{h-L:h-2})\mathbb{P}_{h}[s_{h}\mid{}s_{h-1},a_{h-1}]\mathbb{O}_{h}(x_{h}\mid{}s_{h})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
