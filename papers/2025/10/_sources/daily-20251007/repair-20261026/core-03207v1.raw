</table>
<p id="A4.SS1.p7.3" class="ltx_p">where the second inequality uses the fact that <math id="A4.SS1.p7.m4" class="ltx_Math" alttext="\mathbb{O}_{h}(x\mid{}b)\geq(1-\delta)b(\phi(x))\widetilde{\mathbb{O}}_{h}(x\mid{}\phi(x))" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝕆</mi><mo>~</mo></mover><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{O}_{h}(x\mid{}b)\geq(1-\delta)b(\phi(x))\widetilde{\mathbb{O}}_{h}(x\mid{}\phi(x))</annotation></semantics></math>. To bound the second term,</p>
<table id="A4.EGx27" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex90"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex90.m1" class="ltx_Math" alttext="\displaystyle\sum_{s\in\mathcal{S}_{h}}E_{h}(x\mid{}s)\left|\frac{b(s)}{\mathbb{O}_{h}(x\mid{}b)}-\frac{b^{\prime}(s)}{\mathbb{O}_{h}(x\mid{}b^{\prime})}\right|" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>h</mi></msub></mrow></munder></mstyle><mrow><msub><mi>E</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{s\in\mathcal{S}_{h}}E_{h}(x\mid{}s)\left|\frac{b(s)}{\mathbb{O}_{h}(x\mid{}b)}-\frac{b^{\prime}(s)}{\mathbb{O}_{h}(x\mid{}b^{\prime})}\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex90.m2" class="ltx_Math" alttext="\displaystyle\leq\sum_{s\in\mathcal{S}_{h}}\frac{E_{h}(x\mid{}s)}{\mathbb{O}_{h}(x\mid{}b^{\prime})}|b(s)-b^{\prime}(s)|+\sum_{s\in\mathcal{S}_{h}}\frac{E_{h}(x\mid{}s)b(s)}{\mathbb{O}_{h}(x\mid{}b)\mathbb{O}_{h}(x\mid{}b^{\prime})}|\mathbb{O}_{h}(x\mid{}b)-\mathbb{O}_{h}(x\mid{}b^{\prime})|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>h</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>E</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>b</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>h</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>E</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{s\in\mathcal{S}_{h}}\frac{E_{h}(x\mid{}s)}{\mathbb{O}_{h}(x\mid{}b^{\prime})}|b(s)-b^{\prime}(s)|+\sum_{s\in\mathcal{S}_{h}}\frac{E_{h}(x\mid{}s)b(s)}{\mathbb{O}_{h}(x\mid{}b)\mathbb{O}_{h}(x\mid{}b^{\prime})}|\mathbb{O}_{h}(x\mid{}b)-\mathbb{O}_{h}(x\mid{}b^{\prime})|</annotation></semantics></math></td>
