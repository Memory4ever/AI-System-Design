<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex95.m1" class="ltx_Math" alttext="\displaystyle\leq\left\lVert\frac{b}{b^{\prime}}\right\rVert_{\infty}\Bigg((1-\delta)\delta^{2/3}\sum_{x\in\mathcal{E}}\widetilde{\mathbb{O}}_{h}(x\mid{}\phi(x))|b(\phi(x))-b^{\prime}(\phi(x))|+\delta\sum_{x\in\mathcal{E}}|E_{h}(x\mid{}b)-E_{h}(x\mid{}b^{\prime})|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mrow><mo>‖</mo><mstyle displaystyle="true"><mfrac><mi>b</mi><msup><mi>b</mi><mo>′</mo></msup></mfrac></mstyle><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>δ</mi><mrow><mn>2</mn><mo>/</mo><mn>3</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></munder></mstyle><mrow><msub><mover accent="true"><mi>𝕆</mi><mo>~</mo></mover><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>b</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></munder></mstyle><mrow><mo stretchy="false">|</mo><mrow><mrow><msub><mi>E</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>E</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\lVert\frac{b}{b^{\prime}}\right\rVert_{\infty}\Bigg((1-\delta)\delta^{2/3}\sum_{x\in\mathcal{E}}\widetilde{\mathbb{O}}_{h}(x\mid{}\phi(x))|b(\phi(x))-b^{\prime}(\phi(x))|+\delta\sum_{x\in\mathcal{E}}|E_{h}(x\mid{}b)-E_{h}(x\mid{}b^{\prime})|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex96"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex96.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad+\delta\sum_{x\in\mathcal{E}}\sum_{s\in\mathcal{S}_{h}}E_{h}(x\mid{}s)|b(s)-b^{\prime}(s)|+\delta^{2/3}\sum_{x\in\mathcal{E}}|\mathbb{O}_{h}(x\mid{}b)-\mathbb{O}_{h}(x\mid{}b^{\prime})|\Bigg)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>δ</mi><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>h</mi></msub></mrow></munder></mstyle><msub><mi>E</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>b</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>b</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo fence="false" stretchy="false">|</mo><mo lspace="0em">+</mo><msup><mi>δ</mi><mrow><mn>2</mn><mo>/</mo><mn>3</mn></mrow></msup><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></munder></mstyle><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝕆</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>𝕆</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0.167em">∣</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad+\delta\sum_{x\in\mathcal{E}}\sum_{s\in\mathcal{S}_{h}}E_{h}(x\mid{}s)|b(s)-b^{\prime}(s)|+\delta^{2/3}\sum_{x\in\mathcal{E}}|\mathbb{O}_{h}(x\mid{}b)-\mathbb{O}_{h}(x\mid{}b^{\prime})|\Bigg)</annotation></semantics></math></td>
