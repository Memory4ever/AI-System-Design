<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex38.m1" class="ltx_math_unparsed" alttext="\displaystyle\propto\sum_{s_{h-L:h-1}}\mathbb{P}^{\pi}[s_{h-L:h-1},x_{h-L+1:h-1},a_{h-L:h-2}]\mathbb{P}_{h}[s_{h}\mid{}s_{h-1},a_{h-1}]\mathbb{O}_{h}(x_{h}\mid{}s_{h})" display="inline" intent=":literal"><semantics><mrow><mo>∝</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><msub><mrow></mrow><mrow><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub></mrow></munder></mstyle><msup><mi>ℙ</mi><mi>π</mi></msup><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mrow><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msub><mi>x</mi><mrow><mrow><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>2</mn></mrow></mrow></msub><mo stretchy="false">]</mo></mrow><msub><mi>ℙ</mi><mi>h</mi></msub><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mi>h</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>h</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\propto\sum_{s_{h-L:h-1}}\mathbb{P}^{\pi}[s_{h-L:h-1},x_{h-L+1:h-1},a_{h-L:h-2}]\mathbb{P}_{h}[s_{h}\mid{}s_{h-1},a_{h-1}]\mathbb{O}_{h}(x_{h}\mid{}s_{h})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex39.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{O}_{h}(x_{h}\mid{}s_{h})\sum_{s_{h-1}}\mathbb{P}_{h}[s_{h}\mid{}s_{h-1},a_{h-1}]\mathbb{P}^{\pi}[s_{h-1},x_{h-L+1:h-1},a_{h-L:h-2}]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝕆</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>h</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub></munder></mstyle><msub><mi>ℙ</mi><mi>h</mi></msub><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mi>h</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow><msup><mi>ℙ</mi><mi>π</mi></msup><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>x</mi><mrow><mrow><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>2</mn></mrow></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{O}_{h}(x_{h}\mid{}s_{h})\sum_{s_{h-1}}\mathbb{P}_{h}[s_{h}\mid{}s_{h-1},a_{h-1}]\mathbb{P}^{\pi}[s_{h-1},x_{h-L+1:h-1},a_{h-L:h-2}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex40"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex40.m1" class="ltx_math_unparsed" alttext="\displaystyle\propto\mathbb{O}_{h}(x_{h}\mid{}s_{h})\sum_{s_{h-1}}\mathbb{P}_{h}[s_{h}\mid{}s_{h-1},a_{h-1}]\mathbb{P}^{\pi}[s_{h-1}\mid{}x_{h-L+1:h-1},a_{h-L:h-2}]" display="inline" intent=":literal"><semantics><mrow><mo>∝</mo><msub><mi>𝕆</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>h</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub></munder></mstyle><msub><mi>ℙ</mi><mi>h</mi></msub><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mi>h</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow><msup><mi>ℙ</mi><mi>π</mi></msup><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>x</mi><mrow><mrow><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>2</mn></mrow></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\propto\mathbb{O}_{h}(x_{h}\mid{}s_{h})\sum_{s_{h-1}}\mathbb{P}_{h}[s_{h}\mid{}s_{h-1},a_{h-1}]\mathbb{P}^{\pi}[s_{h-1}\mid{}x_{h-L+1:h-1},a_{h-L:h-2}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex41"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex41.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{O}_{h}(x_{h}\mid{}s_{h})\sum_{s_{h-1}}\mathbb{P}_{h}[s_{h}\mid{}s_{h-1},a_{h-1}]\mathbf{b}^{\mathsf{apx}}_{h-1}(x_{h-L+1:h-1},a_{h-L:h-2};d^{\pi}_{h-L})(s_{h-1})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝕆</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>h</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub></munder></mstyle><msub><mi>ℙ</mi><mi>h</mi></msub><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mi>h</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow><msubsup><mi>𝐛</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow><mi>𝖺𝗉𝗑</mi></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mrow><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>2</mn></mrow></mrow></msub><mo>;</mo><msubsup><mi>d</mi><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mi>π</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{O}_{h}(x_{h}\mid{}s_{h})\sum_{s_{h-1}}\mathbb{P}_{h}[s_{h}\mid{}s_{h-1},a_{h-1}]\mathbf{b}^{\mathsf{apx}}_{h-1}(x_{h-L+1:h-1},a_{h-L:h-2};d^{\pi}_{h-L})(s_{h-1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex42"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex42.m1" class="ltx_math_unparsed" alttext="\displaystyle\propto\mathbf{b}^{\mathsf{apx}}_{h}(x_{h-L+1:h},a_{h-L:h-1};d^{\pi}_{h-L})(s_{h})" display="inline" intent=":literal"><semantics><mrow><mo>∝</mo><msubsup><mi>𝐛</mi><mi>h</mi><mi>𝖺𝗉𝗑</mi></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mrow><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>h</mi></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>;</mo><msubsup><mi>d</mi><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mi>π</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\propto\mathbf{b}^{\mathsf{apx}}_{h}(x_{h-L+1:h},a_{h-L:h-1};d^{\pi}_{h-L})(s_{h})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p5.2" class="ltx_p">by the induction hypothesis and the definition of <math id="A3.p5.m9" class="ltx_math_unparsed" alttext="\mathbf{b}^{\mathsf{apx}}_{h}(x_{h-L+1:h},a_{h-L:h-1};d^{\pi}_{h-L})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐛</mi><mi>h</mi><mi>𝖺𝗉𝗑</mi></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mrow><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>h</mi></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>;</mo><msubsup><mi>d</mi><mrow><mi>h</mi><mo>−</mo><mi>L</mi></mrow><mi>π</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{b}^{\mathsf{apx}}_{h}(x_{h-L+1:h},a_{h-L:h-1};d^{\pi}_{h-L})</annotation></semantics></math>.
∎
<br class="ltx_break"></p>
</div>
<div id="A3.p6" class="ltx_para ltx_noindent">
<p id="A3.p6.1" class="ltx_p">The following fact is well-known.</p>
</div>
<div id="A3.Thmlemma4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmlemma4.2" class="ltx_text ltx_font_bold">Lemma C.4</span></span><span id="A3.Thmlemma4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmlemma4.p1" class="ltx_para">
<p id="A3.Thmlemma4.p1.1" class="ltx_p"><span id="A3.Thmlemma4.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A3.Thmlemma4.p1.m1" class="ltx_Math" alttext="\pi^{\star}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">\pi^{\star}</annotation></semantics></math> be the optimal policy of the POMDP, and let <math id="A3.Thmlemma4.p1.m2" class="ltx_Math" alttext="\pi^{\mathsf{latent}}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mi>𝗅𝖺𝗍𝖾𝗇𝗍</mi></msup><annotation encoding="application/x-tex">\pi^{\mathsf{latent}}</annotation></semantics></math> be the optimal policy of the MDP. Then we have that</span></p>
<table id="A3.EGx10" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex43.m1" class="ltx_Math" alttext="\displaystyle J(\pi^{\star})\leq J(\pi^{\mathsf{latent}})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mi>𝗅𝖺𝗍𝖾𝗇𝗍</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle J(\pi^{\star})\leq J(\pi^{\mathsf{latent}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A3.p7" class="ltx_para ltx_noindent">
<p id="A3.p7.1" class="ltx_p"><span id="A3.p7.1.1" class="ltx_text ltx_font_bold">Proof. </span>We prove by proving a more general result. Consider any POMDP <math id="A3.p7.m1" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math> and its corresponding MDP <math id="A3.p7.m2" class="ltx_Math" alttext="\mathcal{M}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℳ</mi><annotation encoding="application/x-tex">\mathcal{M}</annotation></semantics></math>, for any latent policy <math id="A3.p7.m3" class="ltx_Math" alttext="\pi^{\mathsf{latent}}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mi>𝗅𝖺𝗍𝖾𝗇𝗍</mi></msup><annotation encoding="application/x-tex">\pi^{\mathsf{latent}}</annotation></semantics></math>, we use <math id="A3.p7.m4" class="ltx_Math" alttext="Q^{\mathcal{M};\pi^{\mathsf{latent}}}_{h}:\mathcal{S}_{h}\times\mathcal{A}_{h}\to[0,1]" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Q</mi><mi>h</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>;</mo><msup><mi>π</mi><mi>𝗅𝖺𝗍𝖾𝗇𝗍</mi></msup></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>h</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>h</mi></msub></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Q^{\mathcal{M};\pi^{\mathsf{latent}}}_{h}:\mathcal{S}_{h}\times\mathcal{A}_{h}\to[0,1]</annotation></semantics></math> to denote the Q-value of following <math id="A3.p7.m5" class="ltx_Math" alttext="\pi^{\mathsf{latent}}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mi>𝗅𝖺𝗍𝖾𝗇𝗍</mi></msup><annotation encoding="application/x-tex">\pi^{\mathsf{latent}}</annotation></semantics></math> in the MDP at timestep <math id="A3.p7.m6" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math>. We use <math id="A3.p7.m7" class="ltx_math_unparsed" alttext="Q^{\mathcal{P};\pi}_{h}:\mathcal{X}^{1:h}\times\mathcal{A}^{1:h}\to[0,1]" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Q</mi><mi>h</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>;</mo><mi>π</mi></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><msup><mi class="ltx_font_mathcaligraphic">𝒳</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>h</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>h</mi></mrow></msup><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">Q^{\mathcal{P};\pi}_{h}:\mathcal{X}^{1:h}\times\mathcal{A}^{1:h}\to[0,1]</annotation></semantics></math> to denote the Q-value at timestep <math id="A3.p7.m8" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> of following executable policy <math id="A3.p7.m9" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>. We will use <math id="A3.p7.m10" class="ltx_Math" alttext="Q^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>Q</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">Q^{\mathcal{P}}</annotation></semantics></math> and <math id="A3.p7.m11" class="ltx_Math" alttext="Q^{\mathcal{M}}" display="inline" intent=":literal"><semantics><msup><mi>Q</mi><mi class="ltx_font_mathcaligraphic">ℳ</mi></msup><annotation encoding="application/x-tex">Q^{\mathcal{M}}</annotation></semantics></math> to denote the optimal POMDP Q-value and optimal MDP Q-value functions. Note that <math id="A3.p7.m12" class="ltx_Math" alttext="Q^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>Q</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">Q^{\mathcal{P}}</annotation></semantics></math> satisfies the following optimality equation, for any <math id="A3.p7.m13" class="ltx_math_unparsed" alttext="x_{1:h},a_{1:h}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>h</mi></mrow></msub><mo>,</mo><mi>a</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>h</mi></mrow></msub></mrow><annotation encoding="application/x-tex">x_{1:h},a_{1:h}</annotation></semantics></math>, we have</p>
<table id="A3.EGx11" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex44"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex44.m1" class="ltx_math_unparsed" alttext="\displaystyle Q^{\mathcal{P}}_{h}((x_{1:h},a_{1:h-1}),a_{h})=\sum_{s_{h}}\mathbf{b}_{h}(x_{1:h},a_{1:h-1})R_{h}(s_{h},a_{h})+\sum_{x_{h+1}}P(x_{h+1}\mid x_{1:h},a_{1:h})\max_{a_{h+1}}Q^{\mathcal{P}}_{h}((x_{1:h+1},a_{1:h}),a_{h+1})," display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Q</mi><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>h</mi></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>a</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msub><mi>s</mi><mi>h</mi></msub></munder></mstyle><msub><mi>𝐛</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>h</mi></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><msub><mi>R</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo>,</mo><msub><mi>a</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msub><mi>x</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub></munder></mstyle><mi>P</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>h</mi></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>h</mi></mrow></msub><mo rspace="0.167em" stretchy="false">)</mo></mrow><munder><mi>max</mi><msub><mi>a</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub></munder><msubsup><mi>Q</mi><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>h</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>a</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle Q^{\mathcal{P}}_{h}((x_{1:h},a_{1:h-1}),a_{h})=\sum_{s_{h}}\mathbf{b}_{h}(x_{1:h},a_{1:h-1})R_{h}(s_{h},a_{h})+\sum_{x_{h+1}}P(x_{h+1}\mid x_{1:h},a_{1:h})\max_{a_{h+1}}Q^{\mathcal{P}}_{h}((x_{1:h+1},a_{1:h}),a_{h+1}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p7.2" class="ltx_p">where <math id="A3.p7.m14" class="ltx_math_unparsed" alttext="P(x_{h+1}\mid x_{1:h},a_{1:h})=\sum_{s_{h},s_{h+1}}\mathbf{b}_{h}(s_{h}\mid x_{1:h},a_{1:h})\mathbb{P}_{h}(s_{h+1}\mid s_{h},a_{h})\mathbb{O}_{h+1}(x_{h+1}\mid s_{h+1})" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>h</mi></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>h</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">=</mo><msub><mo>∑</mo><mrow><msub><mi>s</mi><mi>h</mi></msub><mo>,</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msub><msub><mi>𝐛</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>h</mi></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>h</mi></mrow></msub><mo stretchy="false">)</mo></mrow><msub><mi>ℙ</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mi>h</mi></msub><mo>,</mo><msub><mi>a</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><msub><mi>𝕆</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P(x_{h+1}\mid x_{1:h},a_{1:h})=\sum_{s_{h},s_{h+1}}\mathbf{b}_{h}(s_{h}\mid x_{1:h},a_{1:h})\mathbb{P}_{h}(s_{h+1}\mid s_{h},a_{h})\mathbb{O}_{h+1}(x_{h+1}\mid s_{h+1})</annotation></semantics></math>.
Note that in this case, <math id="A3.p7.m15" class="ltx_math_unparsed" alttext="x_{1:h},a_{h-1}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>h</mi></mrow></msub><mo>,</mo><mi>a</mi><msub><mrow></mrow><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">x_{1:h},a_{h-1}</annotation></semantics></math> can be summarize as <math id="A3.p7.m16" class="ltx_math_unparsed" alttext="\mathbf{b}_{h}(x_{1:h},a_{h-1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐛</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>h</mi></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{b}_{h}(x_{1:h},a_{h-1})</annotation></semantics></math>; and thus given any belief <math id="A3.p7.m17" class="ltx_Math" alttext="b_{h}\in\Delta(\mathcal{S}_{h})" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mi>h</mi></msub><mo>∈</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">b_{h}\in\Delta(\mathcal{S}_{h})</annotation></semantics></math>, we will abuse the notation and define</p>
<table id="A3.EGx12" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex45.m1" class="ltx_Math" alttext="\displaystyle Q^{\mathcal{P}}_{h}(b_{h},a_{h})=\sum_{s_{h}}b_{h}(s_{h})R_{h}(s_{h},a_{h})+\sum_{x_{h+1}}P(x_{h+1}\mid b_{h},a_{h})\max_{a_{h+1}}Q^{\mathcal{P}}_{h}(b_{h+1},a_{h+1})," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>Q</mi><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>b</mi><mi>h</mi></msub><mo>,</mo><msub><mi>a</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msub><mi>s</mi><mi>h</mi></msub></munder></mstyle><mrow><msub><mi>b</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo>,</mo><msub><mi>a</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msub><mi>x</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub></munder></mstyle><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>b</mi><mi>h</mi></msub><mo>,</mo><msub><mi>a</mi><mi>h</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><munder><mi>max</mi><msub><mi>a</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub></munder><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mi>Q</mi><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>b</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle Q^{\mathcal{P}}_{h}(b_{h},a_{h})=\sum_{s_{h}}b_{h}(s_{h})R_{h}(s_{h},a_{h})+\sum_{x_{h+1}}P(x_{h+1}\mid b_{h},a_{h})\max_{a_{h+1}}Q^{\mathcal{P}}_{h}(b_{h+1},a_{h+1}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p7.3" class="ltx_p">where <math id="A3.p7.m18" class="ltx_Math" alttext="b_{h+1}:=\mathbb{U}_{h+1}(b_{h};a_{h},x_{h+1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>:=</mo><mrow><msub><mi>𝕌</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>b</mi><mi>h</mi></msub><mo>,</mo><msub><mi>a</mi><mi>h</mi></msub><mo>,</mo><msub><mi>x</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">b_{h+1}:=\mathbb{U}_{h+1}(b_{h};a_{h},x_{h+1})</annotation></semantics></math>. Similarly, we can define</p>
<table id="A3.Ex46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex46.m1" class="ltx_Math" alttext="Q^{\mathcal{M}}_{h}(b_{h},a_{h})=\sum_{s_{h}}b_{h}(s_{h})Q^{\mathcal{M}}(s_{h},a_{h})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>Q</mi><mi>h</mi><mi class="ltx_font_mathcaligraphic">ℳ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>b</mi><mi>h</mi></msub><mo>,</mo><msub><mi>a</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><msub><mi>s</mi><mi>h</mi></msub></munder><mrow><msub><mi>b</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>Q</mi><mi class="ltx_font_mathcaligraphic">ℳ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo>,</mo><msub><mi>a</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Q^{\mathcal{M}}_{h}(b_{h},a_{h})=\sum_{s_{h}}b_{h}(s_{h})Q^{\mathcal{M}}(s_{h},a_{h}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p7.4" class="ltx_p">Note that in this case, let <math id="A3.p7.m19" class="ltx_Math" alttext="\pi^{\star}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">\pi^{\star}</annotation></semantics></math> be the optimal executable policy, and let <math id="A3.p7.m20" class="ltx_Math" alttext="\pi^{\mathsf{latent}}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mi>𝗅𝖺𝗍𝖾𝗇𝗍</mi></msup><annotation encoding="application/x-tex">\pi^{\mathsf{latent}}</annotation></semantics></math> be the optimal MDP policy, we have that</p>
<table id="A3.Ex47" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex47.m1" class="ltx_Math" alttext="J(\pi^{\star})=\En_{x_{1}}\left[Q^{\mathcal{P}}_{1}(\mathbf{b}_{1}(x_{1}),\pi^{\star}(x_{1}))\right]," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><msub><mi>x</mi><mn>1</mn></msub></msub><mo>⁡</mo><mrow><mo>[</mo><mrow><msubsup><mi>Q</mi><mn>1</mn><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐛</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>π</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">J(\pi^{\star})=\En_{x_{1}}\left[Q^{\mathcal{P}}_{1}(\mathbf{b}_{1}(x_{1}),\pi^{\star}(x_{1}))\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p7.5" class="ltx_p">and</p>
<table id="A3.Ex48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex48.m1" class="ltx_Math" alttext="J(\pi^{\mathsf{latent}})=\En_{s_{1}}[Q^{\mathcal{M}}_{1}(s_{1},\pi^{\mathsf{latent}}(s_{1}))]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mi>𝗅𝖺𝗍𝖾𝗇𝗍</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><msub><mi>s</mi><mn>1</mn></msub></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>Q</mi><mn>1</mn><mi class="ltx_font_mathcaligraphic">ℳ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>1</mn></msub><mo>,</mo><mrow><msup><mi>π</mi><mi>𝗅𝖺𝗍𝖾𝗇𝗍</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">J(\pi^{\mathsf{latent}})=\En_{s_{1}}[Q^{\mathcal{M}}_{1}(s_{1},\pi^{\mathsf{latent}}(s_{1}))].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.p8" class="ltx_para ltx_noindent">
<p id="A3.p8.1" class="ltx_p">In the following we will prove that, for any timestep <math id="A3.p8.m1" class="ltx_Math" alttext="h\in[H]" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>H</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">h\in[H]</annotation></semantics></math>, for any admissible belief <math id="A3.p8.m2" class="ltx_Math" alttext="b_{h}\in\Delta(\mathcal{S}_{h})" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mi>h</mi></msub><mo>∈</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">b_{h}\in\Delta(\mathcal{S}_{h})</annotation></semantics></math>, fix action <math id="A3.p8.m3" class="ltx_Math" alttext="a_{h}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>h</mi></msub><annotation encoding="application/x-tex">a_{h}</annotation></semantics></math>, we have that</p>
<table id="A3.EGx13" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex49.m1" class="ltx_Math" alttext="\displaystyle Q^{\mathcal{M}}_{h}(b_{h},a_{h})\geq Q^{\mathcal{P}}_{h}(b_{h},a_{h})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>Q</mi><mi>h</mi><mi class="ltx_font_mathcaligraphic">ℳ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>b</mi><mi>h</mi></msub><mo>,</mo><msub><mi>a</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><msubsup><mi>Q</mi><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>b</mi><mi>h</mi></msub><mo>,</mo><msub><mi>a</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle Q^{\mathcal{M}}_{h}(b_{h},a_{h})\geq Q^{\mathcal{P}}_{h}(b_{h},a_{h}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p8.2" class="ltx_p">We proceed with induction. For <math id="A3.p8.m4" class="ltx_Math" alttext="h=H" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>=</mo><mi>H</mi></mrow><annotation encoding="application/x-tex">h=H</annotation></semantics></math>, we have</p>
<table id="A3.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex50.m1" class="ltx_Math" alttext="\displaystyle Q^{\mathcal{M}}_{H}(b_{H},a_{H})=\sum_{s_{H}}b_{H}(s_{H})R_{H}(s_{H},a_{H})=Q^{\mathcal{P}}_{H}(b_{H},a_{H})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>Q</mi><mi>H</mi><mi class="ltx_font_mathcaligraphic">ℳ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>b</mi><mi>H</mi></msub><mo>,</mo><msub><mi>a</mi><mi>H</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msub><mi>s</mi><mi>H</mi></msub></munder></mstyle><mrow><msub><mi>b</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>H</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>H</mi></msub><mo>,</mo><msub><mi>a</mi><mi>H</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><msubsup><mi>Q</mi><mi>H</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>b</mi><mi>H</mi></msub><mo>,</mo><msub><mi>a</mi><mi>H</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle Q^{\mathcal{M}}_{H}(b_{H},a_{H})=\sum_{s_{H}}b_{H}(s_{H})R_{H}(s_{H},a_{H})=Q^{\mathcal{P}}_{H}(b_{H},a_{H}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p8.3" class="ltx_p">Then assuming <math id="A3.p8.m5" class="ltx_Math" alttext="Q^{\mathcal{M}}_{h+1}(b_{h+1},a_{h+1})\geq Q^{\mathcal{P}}_{h}(b_{h+1},a_{h+1})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>Q</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>b</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><msubsup><mi>Q</mi><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>b</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Q^{\mathcal{M}}_{h+1}(b_{h+1},a_{h+1})\geq Q^{\mathcal{P}}_{h}(b_{h+1},a_{h+1})</annotation></semantics></math> for any admissible <math id="A3.p8.m6" class="ltx_Math" alttext="b_{h+1}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">b_{h+1}</annotation></semantics></math>, we have for any admissible <math id="A3.p8.m7" class="ltx_Math" alttext="b_{h}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mi>h</mi></msub><annotation encoding="application/x-tex">b_{h}</annotation></semantics></math> and action <math id="A3.p8.m8" class="ltx_Math" alttext="a_{h}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>h</mi></msub><annotation encoding="application/x-tex">a_{h}</annotation></semantics></math>,</p>
<table id="A3.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex51.m1" class="ltx_Math" alttext="\displaystyle Q^{\mathcal{P}}_{h}(b_{h},a_{h})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Q</mi><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>b</mi><mi>h</mi></msub><mo>,</mo><msub><mi>a</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Q^{\mathcal{P}}_{h}(b_{h},a_{h})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex51.m2" class="ltx_Math" alttext="\displaystyle=\sum_{s_{h}}b_{h}(s_{h})R_{h}(s_{h},a_{h})+\sum_{x_{h+1}}P(x_{h+1}\mid b_{h},a_{h})\max_{a_{h+1}}Q^{\mathcal{P}}_{h+1}(b_{h+1},a_{h+1})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msub><mi>s</mi><mi>h</mi></msub></munder></mstyle><mrow><msub><mi>b</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo>,</mo><msub><mi>a</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msub><mi>x</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub></munder></mstyle><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>b</mi><mi>h</mi></msub><mo>,</mo><msub><mi>a</mi><mi>h</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><munder><mi>max</mi><msub><mi>a</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub></munder><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mi>Q</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>b</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{s_{h}}b_{h}(s_{h})R_{h}(s_{h},a_{h})+\sum_{x_{h+1}}P(x_{h+1}\mid b_{h},a_{h})\max_{a_{h+1}}Q^{\mathcal{P}}_{h+1}(b_{h+1},a_{h+1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex52"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex52.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{s_{h}}b_{h}(s_{h})R_{h}(s_{h},a_{h})+\sum_{x_{h+1}}P(x_{h+1}\mid b_{h},a_{h})\max_{a_{h+1}}Q^{\mathcal{M}}_{h+1}(b_{h+1},a_{h+1})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msub><mi>s</mi><mi>h</mi></msub></munder></mstyle><mrow><msub><mi>b</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo>,</mo><msub><mi>a</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msub><mi>x</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub></munder></mstyle><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>b</mi><mi>h</mi></msub><mo>,</mo><msub><mi>a</mi><mi>h</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><munder><mi>max</mi><msub><mi>a</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub></munder><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mi>Q</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>b</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{s_{h}}b_{h}(s_{h})R_{h}(s_{h},a_{h})+\sum_{x_{h+1}}P(x_{h+1}\mid b_{h},a_{h})\max_{a_{h+1}}Q^{\mathcal{M}}_{h+1}(b_{h+1},a_{h+1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex53.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{s_{h}}b_{h}(s_{h})R_{h}(s_{h},a_{h})+\sum_{x_{h+1}}P(x_{h+1}\mid b_{h},a_{h})\left(\sum_{s_{h+1}}b_{h+1}(s_{h+1})\max_{a_{h+1}}Q^{\mathcal{M}}_{h+1}(s_{h+1},a_{h+1})\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msub><mi>s</mi><mi>h</mi></msub></munder></mstyle><mrow><msub><mi>b</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo>,</mo><msub><mi>a</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msub><mi>x</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub></munder></mstyle><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>b</mi><mi>h</mi></msub><mo>,</mo><msub><mi>a</mi><mi>h</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub></munder></mstyle><mrow><msub><mi>b</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><munder><mi>max</mi><msub><mi>a</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub></munder><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mi>Q</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{s_{h}}b_{h}(s_{h})R_{h}(s_{h},a_{h})+\sum_{x_{h+1}}P(x_{h+1}\mid b_{h},a_{h})\left(\sum_{s_{h+1}}b_{h+1}(s_{h+1})\max_{a_{h+1}}Q^{\mathcal{M}}_{h+1}(s_{h+1},a_{h+1})\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p8.4" class="ltx_p">For any function <math id="A3.p8.m9" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> that only depend on the state, we have</p>
