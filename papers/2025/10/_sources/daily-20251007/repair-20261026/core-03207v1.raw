<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex94.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad+\delta\sum_{x\in\mathcal{E}}\sum_{s\in\mathcal{S}_{h}}E_{h}(x\mid{}s)|b(s)-b^{\prime}(s)|+\delta\sum_{x\in\mathcal{E}}\frac{E_{h}(x\mid{}b)}{\mathbb{O}_{h}(x\mid{}b)}|\mathbb{O}_{h}(x\mid{}b)-\mathbb{O}_{h}(x\mid{}b^{\prime})|\Bigg)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>δ</mi><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>h</mi></msub></mrow></munder></mstyle><msub><mi>E</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>b</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>b</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo fence="false" stretchy="false">|</mo><mo lspace="0em">+</mo><mi>δ</mi><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></munder></mstyle><mstyle displaystyle="true"><mfrac><mrow><msub><mi>E</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝕆</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝕆</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>𝕆</mi><mi>h</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0.167em">∣</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad+\delta\sum_{x\in\mathcal{E}}\sum_{s\in\mathcal{S}_{h}}E_{h}(x\mid{}s)|b(s)-b^{\prime}(s)|+\delta\sum_{x\in\mathcal{E}}\frac{E_{h}(x\mid{}b)}{\mathbb{O}_{h}(x\mid{}b)}|\mathbb{O}_{h}(x\mid{}b)-\mathbb{O}_{h}(x\mid{}b^{\prime})|\Bigg)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex95"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
