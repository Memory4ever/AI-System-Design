</thead>
<tbody class="ltx_tbody">
<tr id="A8.T4.2.2" class="ltx_tr">
<td id="A8.T4.2.2.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">Minibatch size</td>
<td id="A8.T4.2.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">256</td>
<td id="A8.T4.2.2.3" class="ltx_td ltx_align_center ltx_border_t">128, 256</td></tr>
<tr id="A8.T4.2.3" class="ltx_tr">
<td id="A8.T4.2.3.1" class="ltx_td ltx_align_center ltx_border_r">Learning rate</td>
<td id="A8.T4.2.3.2" class="ltx_td ltx_align_center ltx_border_r">1e-4</td>
<td id="A8.T4.2.3.3" class="ltx_td ltx_align_center">1e-3, 2e-4, 1e-4</td></tr>
<tr id="A8.T4.2.4" class="ltx_tr">
<td id="A8.T4.2.4.1" class="ltx_td ltx_align_center ltx_border_r">Optimizer</td>
<td id="A8.T4.2.4.2" class="ltx_td ltx_align_center ltx_border_r">Adam</td>
<td id="A8.T4.2.4.3" class="ltx_td ltx_align_center">Adam</td></tr>
<tr id="A8.T4.2.5" class="ltx_tr">
<td id="A8.T4.2.5.1" class="ltx_td ltx_align_center ltx_border_r">Number of episodes</td>
<td id="A8.T4.2.5.2" class="ltx_td ltx_align_center ltx_border_r">5</td>
<td id="A8.T4.2.5.3" class="ltx_td ltx_align_center">2, 5, 10, 20</td></tr>
<tr id="A8.T4.2.6" class="ltx_tr">
<td id="A8.T4.2.6.1" class="ltx_td ltx_align_center ltx_border_r">Number of iterations</td>
<td id="A8.T4.2.6.2" class="ltx_td ltx_align_center ltx_border_r">5000</td>
<td id="A8.T4.2.6.3" class="ltx_td ltx_align_center">1000, 2000, 5000, 100000</td></tr>
<tr id="A8.T4.2.7" class="ltx_tr">
<td id="A8.T4.2.7.1" class="ltx_td ltx_align_center ltx_border_r">Number of gradient step per iteration</td>
<td id="A8.T4.2.7.2" class="ltx_td ltx_align_center ltx_border_r">50</td>
<td id="A8.T4.2.7.3" class="ltx_td ltx_align_center">20, 50, 100</td></tr>
<tr id="A8.T4.2.8" class="ltx_tr">
<td id="A8.T4.2.8.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r">Hidden layer size</td>
<td id="A8.T4.2.8.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r">256</td>
<td id="A8.T4.2.8.3" class="ltx_td ltx_align_center ltx_border_bb">128, 256, 512</td></tr>
</tbody>
</table>
<br class="ltx_break ltx_centering">
</figure>
</section>
<section id="A8.SS4.SSS0.Px3" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Hyperparameters for RL</h5>

<div id="A8.SS4.SSS0.Px3.p1" class="ltx_para ltx_noindent">
<p id="A8.SS4.SSS0.Px3.p1.1" class="ltx_p">The hyperparameters for RL follows the original hyperparameters prescribed in <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib22" title="" class="ltx_ref">Fujimoto et al., 2025</a>)</cite>, and we train for 50000 episodes.</p>
</div>
</section>
<section id="A8.SS4.SSS0.Px4" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Computation details</h5>

<div id="A8.SS4.SSS0.Px4.p1" class="ltx_para ltx_noindent">
<p id="A8.SS4.SSS0.Px4.p1.1" class="ltx_p">All of our experiments are run with 1 L40S GPU with 8 threads of CPU.</p>
</div>
</section>
</section>
</section>
