<td id="S1.T1.2.5.2" class="ltx_td ltx_align_center"><span id="S1.T1.2.5.2.1" class="ltx_text ltx_font_bold">Zero</span></td>
<td id="S1.T1.2.5.3" class="ltx_td ltx_align_center">Zero</td>
<td id="S1.T1.2.5.4" class="ltx_td ltx_align_center">High</td></tr>
