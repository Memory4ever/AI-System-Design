<td id="S5.T3.2.4.5" class="ltx_td ltx_align_left"><math id="S5.T3.m14" class="ltx_Math" alttext="71.0" display="inline" intent=":literal"><semantics><mn>71.0</mn><annotation encoding="application/x-tex">71.0</annotation></semantics></math></td>
<td id="S5.T3.2.4.6" class="ltx_td ltx_align_left"><math id="S5.T3.m15" class="ltx_Math" alttext="71.0" display="inline" intent=":literal"><semantics><mn>71.0</mn><annotation encoding="application/x-tex">71.0</annotation></semantics></math></td>
<td id="S5.T3.2.4.7" class="ltx_td ltx_align_left"><math id="S5.T3.m16" class="ltx_Math" alttext="71.0" display="inline" intent=":literal"><semantics><mn>71.0</mn><annotation encoding="application/x-tex">71.0</annotation></semantics></math></td></tr>
