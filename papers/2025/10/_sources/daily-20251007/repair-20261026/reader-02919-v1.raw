<span id="S5.T2.8.1.2.1" class="ltx_inline-block ltx_align_top" style="width:42.7pt;">
<span id="S5.T2.8.1.2.1.1" class="ltx_p ltx_align_left"><span id="S5.T2.8.1.2.1.1.1" class="ltx_text ltx_font_bold">Benchmark</span></span>
</span></th>
<th id="S5.T2.8.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.15pt 4.5pt;" colspan="2"><span id="S5.T2.8.1.3.1" class="ltx_text ltx_font_bold">Avg@5</span></th>
