<tbody class="ltx_tbody">
<tr id="S5.T2.8.3" class="ltx_tr">
<th id="S5.T2.8.3.1" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_row ltx_border_t" style="padding:0.15pt 4.5pt;">
<span id="S5.T2.8.3.1.1" class="ltx_inline-block ltx_align_top" style="width:71.1pt;">
<span id="S5.T2.8.3.1.1.1" class="ltx_p ltx_align_left">Qwen2.5-Math-7B</span>
</span></th>
<th id="S5.T2.8.3.2" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_row ltx_border_t" style="padding:0.15pt 4.5pt;">
<span id="S5.T2.8.3.2.1" class="ltx_inline-block ltx_align_top" style="width:42.7pt;">
<span id="S5.T2.8.3.2.1.1" class="ltx_p ltx_align_left">AIME2024</span>
</span></th>
<td id="S5.T2.8.3.3" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t" style="padding:0.15pt 4.5pt;"><math id="S5.T2.m1" class="ltx_Math" alttext="14.6" display="inline" intent=":literal"><semantics><mn>14.6</mn><annotation encoding="application/x-tex">14.6</annotation></semantics></math></td>
