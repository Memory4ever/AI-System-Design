<td id="S5.T3.2.3.2" class="ltx_td ltx_align_left ltx_border_t"><math id="S5.T3.m7" class="ltx_Math" alttext="64.0" display="inline" intent=":literal"><semantics><mn>64.0</mn><annotation encoding="application/x-tex">64.0</annotation></semantics></math></td>
