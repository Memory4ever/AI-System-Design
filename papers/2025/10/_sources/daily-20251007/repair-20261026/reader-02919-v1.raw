<td id="S5.T3.2.4.2" class="ltx_td ltx_align_left"><math id="S5.T3.m12" class="ltx_Math" alttext="64.0" display="inline" intent=":literal"><semantics><mn>64.0</mn><annotation encoding="application/x-tex">64.0</annotation></semantics></math></td>
<td id="S5.T3.2.4.3" class="ltx_td ltx_align_left">72.0</td>
