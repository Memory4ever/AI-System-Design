<td id="S5.T8.4.3.3" class="ltx_td ltx_align_center ltx_border_b"><span id="S5.T8.4.3.3.1" class="ltx_text" style="font-size:90%;">26.29</span></td>
<td id="S5.T8.4.3.4" class="ltx_td ltx_align_center ltx_border_b"><span id="S5.T8.4.3.4.1" class="ltx_text" style="font-size:90%;">25.83</span></td></tr>
</tbody>
</table>
