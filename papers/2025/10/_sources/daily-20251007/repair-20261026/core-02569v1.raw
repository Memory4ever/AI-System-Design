<span id="S4.T3.1.1.2.2.1.3" class="ltx_tr">
<span id="S4.T3.1.1.2.2.1.3.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S4.T3.1.1.2.2.1.3.1.1" class="ltx_text ltx_font_bold">(English)</span></span></span>
</span></span><span id="S4.T3.1.1.2.3" class="ltx_text"></span></td>
<td id="S4.T3.1.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S4.T3.1.1.3.1" class="ltx_text"></span> <span id="S4.T3.1.1.3.2" class="ltx_text">
<span id="S4.T3.1.1.3.2.1" class="ltx_tabular ltx_align_middle">
