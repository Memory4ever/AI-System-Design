<span id="S4.T3.1.1.4.2.1.2" class="ltx_tr">
<span id="S4.T3.1.1.4.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S4.T3.1.1.4.2.1.2.1.1" class="ltx_text ltx_font_bold">similarity</span></span></span>
</span></span><span id="S4.T3.1.1.4.3" class="ltx_text"></span></td>
