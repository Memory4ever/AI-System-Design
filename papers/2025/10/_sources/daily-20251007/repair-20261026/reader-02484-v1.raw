<th id="A2.T2.6.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A2.T2.6.5.1.1" class="ltx_text" style="font-size:90%;">ACF Inverse</span></th>
<td id="A2.T2.6.5.2" class="ltx_td ltx_align_center ltx_border_t" colspan="4"><math id="A2.T2.m7" class="ltx_Math" alttext="2d\to 128\to n_{a}" display="inline" intent=":literal"><semantics><mrow><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">d</mi></mrow><mo mathsize="0.900em" stretchy="false">→</mo><mn mathsize="0.900em">128</mn><mo mathsize="0.900em" stretchy="false">→</mo><msub><mi mathsize="0.900em">n</mi><mi mathsize="0.900em">a</mi></msub></mrow><annotation encoding="application/x-tex">2d\to 128\to n_{a}</annotation></semantics></math></td></tr>
<tr id="A2.T2.6.6" class="ltx_tr">
<th id="A2.T2.6.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A2.T2.6.6.1.1" class="ltx_text" style="font-size:90%;">ACF Policy</span></th>
<td id="A2.T2.6.6.2" class="ltx_td ltx_align_center ltx_border_t" colspan="4"><math id="A2.T2.m8" class="ltx_Math" alttext="d\to 256\to 256\to n_{a}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">d</mi><mo mathsize="0.900em" stretchy="false">→</mo><mn mathsize="0.900em">256</mn><mo mathsize="0.900em" stretchy="false">→</mo><mn mathsize="0.900em">256</mn><mo mathsize="0.900em" stretchy="false">→</mo><msub><mi mathsize="0.900em">n</mi><mi mathsize="0.900em">a</mi></msub></mrow><annotation encoding="application/x-tex">d\to 256\to 256\to n_{a}</annotation></semantics></math></td></tr>
<tr id="A2.T2.6.7" class="ltx_tr">
<th id="A2.T2.6.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="A2.T2.6.7.1.1" class="ltx_text" style="font-size:90%;">GCL Energy[<math id="A2.T2.m9" class="ltx_Math" alttext="\times d" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">\times d</annotation></semantics></math>]</span></th>
<td id="A2.T2.6.7.2" class="ltx_td ltx_align_center ltx_border_t" colspan="4"><math id="A2.T2.m10" class="ltx_Math" alttext="(d+n_{a})\to 128\to 128\to n_{a}" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">d</mi><mo mathsize="0.900em">+</mo><msub><mi mathsize="0.900em">n</mi><mi mathsize="0.900em">a</mi></msub></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo mathsize="0.900em" stretchy="false">→</mo><mn mathsize="0.900em">128</mn><mo mathsize="0.900em" stretchy="false">→</mo><mn mathsize="0.900em">128</mn><mo mathsize="0.900em" stretchy="false">→</mo><msub><mi mathsize="0.900em">n</mi><mi mathsize="0.900em">a</mi></msub></mrow><annotation encoding="application/x-tex">(d+n_{a})\to 128\to 128\to n_{a}</annotation></semantics></math></td></tr>
<tr id="A2.T2.6.8" class="ltx_tr">
<th id="A2.T2.6.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="A2.T2.6.8.1.1" class="ltx_text" style="font-size:90%;">DMS Transition[<math id="A2.T2.m11" class="ltx_Math" alttext="\times d" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">\times d</annotation></semantics></math>]</span></th>
<td id="A2.T2.6.8.2" class="ltx_td ltx_align_center ltx_border_t" colspan="4"><math id="A2.T2.m12" class="ltx_Math" alttext="(d+n_{a})\to 256\to 1" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">d</mi><mo mathsize="0.900em">+</mo><msub><mi mathsize="0.900em">n</mi><mi mathsize="0.900em">a</mi></msub></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo mathsize="0.900em" stretchy="false">→</mo><mn mathsize="0.900em">256</mn><mo mathsize="0.900em" stretchy="false">→</mo><mn mathsize="0.900em">1</mn></mrow><annotation encoding="application/x-tex">(d+n_{a})\to 256\to 1</annotation></semantics></math></td></tr>
<tr id="A2.T2.6.9" class="ltx_tr">
<th id="A2.T2.6.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="A2.T2.6.9.1.1" class="ltx_text" style="font-size:90%;">Markov Inverse</span></th>
<td id="A2.T2.6.9.2" class="ltx_td ltx_align_center ltx_border_t" colspan="4"><math id="A2.T2.m13" class="ltx_Math" alttext="2d\to 128\to n_{a}" display="inline" intent=":literal"><semantics><mrow><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">d</mi></mrow><mo mathsize="0.900em" stretchy="false">→</mo><mn mathsize="0.900em">128</mn><mo mathsize="0.900em" stretchy="false">→</mo><msub><mi mathsize="0.900em">n</mi><mi mathsize="0.900em">a</mi></msub></mrow><annotation encoding="application/x-tex">2d\to 128\to n_{a}</annotation></semantics></math></td></tr>
<tr id="A2.T2.6.10" class="ltx_tr">
<th id="A2.T2.6.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><span id="A2.T2.6.10.1.1" class="ltx_text" style="font-size:90%;">Markov Ratio</span></th>
<td id="A2.T2.6.10.2" class="ltx_td ltx_align_center ltx_border_bb" colspan="4"><math id="A2.T2.m14" class="ltx_Math" alttext="2d\to 128\to 1" display="inline" intent=":literal"><semantics><mrow><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">d</mi></mrow><mo mathsize="0.900em" stretchy="false">→</mo><mn mathsize="0.900em">128</mn><mo mathsize="0.900em" stretchy="false">→</mo><mn mathsize="0.900em">1</mn></mrow><annotation encoding="application/x-tex">2d\to 128\to 1</annotation></semantics></math></td></tr>
</tbody>
</table>
</figure>
<div id="A2.SS1.p2" class="ltx_para">
<p id="A2.SS1.p2.1" class="ltx_p"><span id="A2.SS1.p2.1.1" class="ltx_text ltx_font_bold">Pixel-level Encoder &amp; Decoder.</span></p>
</div>
<div id="A2.SS1.p3" class="ltx_para">
<p id="A2.SS1.p3.1" class="ltx_p">We parameterize the residual blocks by doubling the depth of the output feature map until reaching a minimum resolution (<span id="A2.SS1.p3.1.1" class="ltx_text ltx_font_typewriter">min_res</span>) (<math id="A2.SS1.p3.m1" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math> for all our experiments) starting from a minimum depth (<math id="A2.SS1.p3.m2" class="ltx_Math" alttext="24" display="inline" intent=":literal"><semantics><mn>24</mn><annotation encoding="application/x-tex">24</annotation></semantics></math> for all our experiments). This is similar to the residual CNN used in <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib26" title="" class="ltx_ref">Hafner et al. (2025)</a></cite>. Table <a href="#A2.T2" title="Table 2 ‣ B.1 Network Architectures ‣ Appendix B Extended Empirical Results ‣ From Pixels to Factors:Learning Independently Controllable State Variables for Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> show the details of the MLPs used.</p>
</div>
<div id="A2.SS1.p4" class="ltx_para">
<ul id="A2.I1" class="ltx_itemize">
<li id="A2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I1.i1.p1" class="ltx_para">
<p id="A2.I1.i1.p1.1" class="ltx_p"><span id="A2.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Residual Encoder</span>:</p>
<ul id="A2.I1.i1.I1" class="ltx_itemize">
<li id="A2.I1.i1.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="A2.I1.i1.I1.i1.1" class="ltx_text ltx_font_bold">–</span></span> 
<div id="A2.I1.i1.I1.i1.p1" class="ltx_para">
<p id="A2.I1.i1.I1.i1.p1.1" class="ltx_p">Positional Embeddings (<math id="A2.I1.i1.I1.i1.p1.m1" class="ltx_Math" alttext="x,y" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow><annotation encoding="application/x-tex">x,y</annotation></semantics></math> channels).</p>
</div></li>
<li id="A2.I1.i1.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="A2.I1.i1.I1.i2.1" class="ltx_text ltx_font_bold">–</span></span> 
<div id="A2.I1.i1.I1.i2.p1" class="ltx_para">
<p id="A2.I1.i1.I1.i2.p1.1" class="ltx_p">Cascade of downsampling ResidualBlocks:
stride-2 <math id="A2.I1.i1.I1.i2.p1.m1" class="ltx_Math" alttext="3\times 3" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">3\times 3</annotation></semantics></math> convolution <math id="A2.I1.i1.I1.i2.p1.m2" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math> RMSNorm <math id="A2.I1.i1.I1.i2.p1.m3" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math> SiLU,
plus two <math id="A2.I1.i1.I1.i2.p1.m4" class="ltx_Math" alttext="1\times 1" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">1\times 1</annotation></semantics></math> conv residual layers.</p>
</div></li>
<li id="A2.I1.i1.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="A2.I1.i1.I1.i3.1" class="ltx_text ltx_font_bold">–</span></span> 
<div id="A2.I1.i1.I1.i3.p1" class="ltx_para">
<p id="A2.I1.i1.I1.i3.p1.1" class="ltx_p">Flatten <math id="A2.I1.i1.I1.i3.p1.m1" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math> 2-layer MLP (256→256, SiLU, then Tanh) <math id="A2.I1.i1.I1.i3.p1.m2" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math> <span id="A2.I1.i1.I1.i3.p1.1.1" class="ltx_text ltx_font_typewriter">latent_dim</span>(<math id="A2.I1.i1.I1.i3.p1.m3" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>)</p>
</div></li>
</ul>
</div></li>
<li id="A2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I1.i2.p1" class="ltx_para">
<p id="A2.I1.i2.p1.1" class="ltx_p"><span id="A2.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Residual Decoder</span>:</p>
<ul id="A2.I1.i2.I1" class="ltx_itemize">
<li id="A2.I1.i2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="A2.I1.i2.I1.i1.1" class="ltx_text ltx_font_bold">–</span></span> 
<div id="A2.I1.i2.I1.i1.p1" class="ltx_para">
<p id="A2.I1.i2.I1.i1.p1.1" class="ltx_p">MLP up-projection from <span id="A2.I1.i2.I1.i1.p1.1.1" class="ltx_text ltx_font_typewriter">latent_dim</span> <math id="A2.I1.i2.I1.i1.p1.m1" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math> <math id="A2.I1.i2.I1.i1.p1.m2" class="ltx_Math" alttext="\mathrm{min\_res}\times\mathrm{min\_res}\times D" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>min</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>res</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>min</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>res</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">\mathrm{min\_res}\times\mathrm{min\_res}\times D</annotation></semantics></math>.</p>
</div></li>
<li id="A2.I1.i2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="A2.I1.i2.I1.i2.1" class="ltx_text ltx_font_bold">–</span></span> 
<div id="A2.I1.i2.I1.i2.p1" class="ltx_para">
<p id="A2.I1.i2.I1.i2.p1.1" class="ltx_p">Stack of transposed ResidualBlocks (stride-2 conv<sup id="A2.I1.i2.I1.i2.p1.1.1" class="ltx_sup"><span id="A2.I1.i2.I1.i2.p1.1.1.1" class="ltx_text ltx_font_italic">T</span></sup>, RMSNorm, SiLU, …)</p>
</div></li>
<li id="A2.I1.i2.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="A2.I1.i2.I1.i3.1" class="ltx_text ltx_font_bold">–</span></span> 
<div id="A2.I1.i2.I1.i3.p1" class="ltx_para">
<p id="A2.I1.i2.I1.i3.p1.1" class="ltx_p">Central crop to <math id="A2.I1.i2.I1.i3.p1.m1" class="ltx_Math" alttext="32\times 32" display="inline" intent=":literal"><semantics><mrow><mn>32</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>32</mn></mrow><annotation encoding="application/x-tex">32\times 32</annotation></semantics></math> <math id="A2.I1.i2.I1.i3.p1.m2" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math> Tanh activation.</p>
</div></li>
</ul>
</div></li>
<li id="A2.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I1.i3.p1" class="ltx_para">
<p id="A2.I1.i3.p1.1" class="ltx_p"><span id="A2.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">MLPs</span> All MLPs have SiLU activations <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib29" title="" class="ltx_ref">Hendrycks &amp; Gimpel, 2016</a>)</cite>.</p>
</div></li>
</ul>
</div>
</section>
<section id="A2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.2 </span>Domains</h3>

<div id="A2.SS2.p1" class="ltx_para">
<p id="A2.SS2.p1.1" class="ltx_p"><span id="A2.SS2.p1.1.1" class="ltx_text ltx_font_bold">Grid2D</span></p>
<dl id="A2.I2" class="ltx_description">
