<tr id="S5.T9.6.1.3" class="ltx_tr">
<td id="S5.T9.6.1.3.1" class="ltx_td ltx_align_left ltx_border_r">MLP</td>
<td id="S5.T9.6.1.3.2" class="ltx_td ltx_align_right">0.76</td>
