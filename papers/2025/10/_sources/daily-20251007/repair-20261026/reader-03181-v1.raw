<span id="lstnumberx57" class="ltx_listingline"><span id="lstnumberx57.1" class="ltx_text ltx_lst_space">                </span>/(<span id="lstnumberx57.2" class="ltx_text ltx_lst_identifier">np</span>.<span id="lstnumberx57.3" class="ltx_text ltx_lst_identifier">exp</span>(<span id="lstnumberx57.4" class="ltx_text ltx_lst_identifier">self</span>.<span id="lstnumberx57.5" class="ltx_text ltx_lst_identifier">de_kde</span>.<span id="lstnumberx57.6" class="ltx_text ltx_lst_identifier">score_samples</span>(<span id="lstnumberx57.7" class="ltx_text ltx_lst_identifier">value2</span>))
</span>
<span id="lstnumberx58" class="ltx_listingline"><span id="lstnumberx58.1" class="ltx_text ltx_lst_space">            </span><span id="lstnumberx58.2" class="ltx_text ltx_lst_identifier">self</span>.<span id="lstnumberx58.3" class="ltx_text ltx_lst_identifier">counter</span>.<span id="lstnumberx58.4" class="ltx_text ltx_lst_identifier">update</span>(<span id="lstnumberx58.5" class="ltx_text ltx_lst_identifier">state</span>,<span id="lstnumberx58.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx58.7" class="ltx_text ltx_lst_identifier">action</span>)
</span>
<span id="lstnumberx59" class="ltx_listingline"><span id="lstnumberx59.1" class="ltx_text ltx_lst_space">            </span><span id="lstnumberx59.2" class="ltx_text ltx_lst_identifier">self</span>.<span id="lstnumberx59.3" class="ltx_text ltx_lst_identifier">_update</span>(<span id="lstnumberx59.4" class="ltx_text ltx_lst_identifier">state</span>,<span id="lstnumberx59.5" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx59.6" class="ltx_text ltx_lst_identifier">action</span>,<span id="lstnumberx59.7" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx59.8" class="ltx_text ltx_lst_identifier">next_state</span>,<span id="lstnumberx59.9" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx59.10" class="ltx_text ltx_lst_identifier">reward</span>,<span id="lstnumberx59.11" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx59.12" class="ltx_text ltx_lst_identifier">hh</span>,<span id="lstnumberx59.13" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx59.14" class="ltx_text ltx_lst_identifier">density_ratio</span>)
</span>
<span id="lstnumberx60" class="ltx_listingline"><span id="lstnumberx60.1" class="ltx_text ltx_lst_space">            </span><span id="lstnumberx60.2" class="ltx_text ltx_lst_identifier">self</span>.<span id="lstnumberx60.3" class="ltx_text ltx_lst_identifier">list_nu_samples</span>.<span id="lstnumberx60.4" class="ltx_text ltx_lst_identifier">append</span>(<span id="lstnumberx60.5" class="ltx_text ltx_lst_identifier">value1</span>)
</span>
<span id="lstnumberx61" class="ltx_listingline"><span id="lstnumberx61.1" class="ltx_text ltx_lst_space">            </span><span id="lstnumberx61.2" class="ltx_text ltx_lst_identifier">self</span>.<span id="lstnumberx61.3" class="ltx_text ltx_lst_identifier">list_de_samples</span>.<span id="lstnumberx61.4" class="ltx_text ltx_lst_identifier">append</span>(<span id="lstnumberx61.5" class="ltx_text ltx_lst_identifier">value2</span>)
</span>
<span id="lstnumberx62" class="ltx_listingline"><span id="lstnumberx62.1" class="ltx_text ltx_lst_space">            </span><span id="lstnumberx62.2" class="ltx_text ltx_lst_identifier">self</span>.<span id="lstnumberx62.3" class="ltx_text ltx_lst_identifier">nu_kde</span>.<span id="lstnumberx62.4" class="ltx_text ltx_lst_identifier">fit</span>(<span id="lstnumberx62.5" class="ltx_text ltx_lst_identifier">self</span>.<span id="lstnumberx62.6" class="ltx_text ltx_lst_identifier">list_nu_samples</span>[<span id="lstnumberx62.7" class="ltx_text ltx_lst_keyword ltx_lst_keywords2 ltx_font_bold">len</span>(<span id="lstnumberx62.8" class="ltx_text ltx_lst_identifier">self</span>.<span id="lstnumberx62.9" class="ltx_text ltx_lst_identifier">list_nu_samples</span>)-100:])
</span>
<span id="lstnumberx63" class="ltx_listingline"><span id="lstnumberx63.1" class="ltx_text ltx_lst_space">            </span><span id="lstnumberx63.2" class="ltx_text ltx_lst_identifier">self</span>.<span id="lstnumberx63.3" class="ltx_text ltx_lst_identifier">de_kde</span>.<span id="lstnumberx63.4" class="ltx_text ltx_lst_identifier">fit</span>(<span id="lstnumberx63.5" class="ltx_text ltx_lst_identifier">self</span>.<span id="lstnumberx63.6" class="ltx_text ltx_lst_identifier">list_de_samples</span>[<span id="lstnumberx63.7" class="ltx_text ltx_lst_keyword ltx_lst_keywords2 ltx_font_bold">len</span>(<span id="lstnumberx63.8" class="ltx_text ltx_lst_identifier">self</span>.<span id="lstnumberx63.9" class="ltx_text ltx_lst_identifier">list_nu_samples</span>)-100:])
</span>
<span id="lstnumberx64" class="ltx_listingline"><span id="lstnumberx64.1" class="ltx_text ltx_lst_space">            </span><span id="lstnumberx64.2" class="ltx_text ltx_lst_identifier">state</span><span id="lstnumberx64.3" class="ltx_text ltx_lst_space"> </span>=<span id="lstnumberx64.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx64.5" class="ltx_text ltx_lst_identifier">next_state</span>
</span>
<span id="lstnumberx65" class="ltx_listingline"><span id="lstnumberx65.1" class="ltx_text ltx_lst_space">            </span><span id="lstnumberx65.2" class="ltx_text ltx_lst_keyword ltx_font_bold">if</span><span id="lstnumberx65.3" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx65.4" class="ltx_text ltx_lst_identifier">done</span>:
</span>
<span id="lstnumberx66" class="ltx_listingline"><span id="lstnumberx66.1" class="ltx_text ltx_lst_space">                </span><span id="lstnumberx66.2" class="ltx_text ltx_lst_keyword ltx_font_bold">break</span>
</span>
<span id="lstnumberx67" class="ltx_listingline"><span id="lstnumberx67.1" class="ltx_text ltx_lst_space">        </span><span id="lstnumberx67.2" class="ltx_text ltx_lst_keyword ltx_font_bold">return</span><span id="lstnumberx67.3" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx67.4" class="ltx_text ltx_lst_identifier">episode_rewards</span>
</span>
</span>
</span></td></tr>
