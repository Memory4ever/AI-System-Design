<figure id="A2.F10" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2">
<figure id="A2.F10.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.02629v1/images/conflicting_1_and_2/k3/compact/rankk_instance.png" id="A2.F10.sf1.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:628/388;" width="628" height="388" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A2.F10.sf1.3" class="ltx_text" style="font-size:90%;">(a)</span> </span><span id="A2.F10.sf1.4" class="ltx_text" style="font-size:90%;">Top 3 Highlights in Double-Conflicting Contexts</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="A2.F10.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.02629v1/images/conflicting_1_and_2/k9/compact/rankk_instance.png" id="A2.F10.sf2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:628/388;" width="628" height="388" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A2.F10.sf2.3" class="ltx_text" style="font-size:90%;">(b)</span> </span><span id="A2.F10.sf2.4" class="ltx_text" style="font-size:90%;">Top 9 Highlights in Double-Conflicting Contexts</span></figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A2.F10.4" class="ltx_text" style="font-size:90%;">Figure 10</span>: </span><math id="A2.F10.m2" class="ltx_Math" alttext="\Delta Rank@k^{\mathrm{inst}}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">@</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">k</mi><mi mathsize="0.900em">inst</mi></msup></mrow><annotation encoding="application/x-tex">\Delta Rank@k^{\mathrm{inst}}</annotation></semantics></math><span id="A2.F10.5" class="ltx_text" style="font-size:90%;"> of the top K(K=3;9) important answer-context tokens and the other-context tokens within the answer instance group, for the <span id="A2.F10.5.1" class="ltx_text ltx_font_bold">Double-Conflicting</span> setup. The Higher the value, the better.</span></figcaption>
</figure>
