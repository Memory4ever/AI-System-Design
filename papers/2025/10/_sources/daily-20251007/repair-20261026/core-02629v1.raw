</span></td></tr>
<tr id="S3.T1.fig1.3.6" class="ltx_tr">
<td id="S3.T1.fig1.3.6.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_align_top ltx_border_t" style="padding-bottom: -1.0pt;padding:-0.15pt 0.0pt;">
<span id="S3.T1.fig1.3.6.1.1" class="ltx_inline-block ltx_align_top" style="width:216.2pt;">
<span id="S3.T1.fig1.3.6.1.1.1" class="ltx_p"><span id="S3.T1.fig1.3.6.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Input Regime (2) Irrelevant C</span></span>
</span></td></tr>
<tr id="S3.T1.fig1.3.7" class="ltx_tr">
