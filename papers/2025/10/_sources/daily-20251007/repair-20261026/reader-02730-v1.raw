<mtr><mtd><mrow><msub><mi mathsize="0.700em">𝑿</mi><mn mathsize="0.710em">0</mn></msub><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">p</mi><msub><mi mathsize="0.710em">𝑿</mi><mn>0</mn></msub></msub></mrow></mtd></mtr><mtr><mtd><mrow><msub><mi mathsize="0.700em">𝑿</mi><mi mathsize="0.710em">t</mi></msub><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">p</mi><mrow><msub><mi mathsize="0.710em">𝑿</mi><mi>t</mi></msub><mo fence="false">|</mo><msub><mi mathsize="0.710em">𝑿</mi><mn>0</mn></msub></mrow></msub></mrow></mtd></mtr></mtable></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mrow><msub><mi>𝑿</mi><mi>t</mi></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>s</mi><mi>𝜽</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\cancelto{C_{2}}{\underset{\begin{subarray}{c}\bm{X}_{0}\sim p_{\bm{X}_{0}}\\
