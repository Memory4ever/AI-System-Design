<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex12.m1" class="ltx_Math" alttext="\displaystyle=\underset{\bm{X}_{t}\sim p_{\bm{X}_{t}}}{{\mathbb{E}}}\left[\frac{1}{2}\Big\|\bm{X}_{t}\circ s_{\bm{\theta}}(\bm{X}_{t},t)\Big\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><msub><mi mathsize="0.700em">𝑿</mi><mi mathsize="0.710em">t</mi></msub><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">p</mi><msub><mi mathsize="0.710em">𝑿</mi><mi>t</mi></msub></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mrow><msub><mi>𝑿</mi><mi>t</mi></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>s</mi><mi>𝜽</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn></msup></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\underset{\bm{X}_{t}\sim p_{\bm{X}_{t}}}{{\mathbb{E}}}\left[\frac{1}{2}\Big\|\bm{X}_{t}\circ s_{\bm{\theta}}(\bm{X}_{t},t)\Big\|^{2}\right]</annotation></semantics></math></td>
