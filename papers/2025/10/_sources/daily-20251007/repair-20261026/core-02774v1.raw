              <span id="alg3.l12.3" class="ltx_text ltx_font_bold">if</span> <math id="alg3.l12.m1" class="ltx_Math" alttext="t_{1}\neq T_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>≠</mo><msub><mi>T</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">t_{1}\neq T_{1}</annotation></semantics></math> <span id="alg3.l12.4" class="ltx_text ltx_font_bold">then</span>



</div>
