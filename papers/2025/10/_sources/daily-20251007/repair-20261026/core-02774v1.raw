             <span id="alg5.l7.3" class="ltx_text ltx_font_bold">for</span> <math id="alg5.l7.m1" class="ltx_Math" alttext="offset=16;offset\geq 1;offset=offset/2" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>=</mo><mn>16</mn></mrow><mo>;</mo><mrow><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>≥</mo><mn>1</mn></mrow><mo>;</mo><mrow><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>=</mo><mrow><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>/</mo><mn>2</mn></mrow></mrow></mrow><annotation encoding="application/x-tex">offset=16;offset\geq 1;offset=offset/2</annotation></semantics></math> <span id="alg5.l7.4" class="ltx_text ltx_font_bold">do</span>



