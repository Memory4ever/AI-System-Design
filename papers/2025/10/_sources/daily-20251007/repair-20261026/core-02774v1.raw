</div>
<div id="alg5.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
             <span id="alg5.l2.3" class="ltx_text ltx_font_bold">Output:</span> Euclidean distance <math id="alg5.l2.m1" class="ltx_Math" alttext="d(x_{i},x_{j})" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">d(x_{i},x_{j})</annotation></semantics></math>

</div>
<div id="alg5.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
             <math id="alg5.l3.m1" class="ltx_Math" alttext="tid\leftarrow\text{thread\_id\_in\_warp()}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">←</mo><mtext>thread_id_in_warp()</mtext></mrow><annotation encoding="application/x-tex">tid\leftarrow\text{thread\_id\_in\_warp()}</annotation></semantics></math>, <math id="alg5.l3.m2" class="ltx_Math" alttext="sum\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">←</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">sum\leftarrow 0</annotation></semantics></math>

</div>
<div id="alg5.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
             <span id="alg5.l4.3" class="ltx_text ltx_font_bold">for</span> <math id="alg5.l4.m1" class="ltx_Math" alttext="d=tid;d&lt;D;d+=32" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo>=</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo>;</mo><mrow><mi>d</mi><mo>&lt;</mo><mi>D</mi></mrow><mo>;</mo><mrow><mrow><mi>d</mi><mo rspace="0em">+</mo></mrow><mo lspace="0em">=</mo><mn>32</mn></mrow></mrow><annotation encoding="application/x-tex">d=tid;d&lt;D;d+=32</annotation></semantics></math> <span id="alg5.l4.4" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg5.l5" class="ltx_listingline">
