</div>
<div id="alg4.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
             <span id="alg4.l2.3" class="ltx_text ltx_font_bold">for all</span> <math id="alg4.l2.m1" class="ltx_Math" alttext="v\in V" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">v\in V</annotation></semantics></math> <span id="alg4.l2.4" class="ltx_text ltx_font_bold">in parallel</span> <span id="alg4.l2.5" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg4.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
              <span id="alg4.l3.3" class="ltx_text ltx_font_bold">for</span> random neighbor pairs <math id="alg4.l3.m1" class="ltx_Math" alttext="(n_{i},n_{j})\in pool_{1}[v]" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>n</mi><mi>i</mi></msub><mo>,</mo><msub><mi>n</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>l</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>v</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(n_{i},n_{j})\in pool_{1}[v]</annotation></semantics></math> <span id="alg4.l3.4" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg4.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
               <math id="alg4.l4.m1" class="ltx_Math" alttext="d_{ij}\leftarrow\text{WARP\_DISTANCE}(n_{i},n_{j})" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">←</mo><mrow><mtext>WARP_DISTANCE</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>n</mi><mi>i</mi></msub><mo>,</mo><msub><mi>n</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d_{ij}\leftarrow\text{WARP\_DISTANCE}(n_{i},n_{j})</annotation></semantics></math>

</div>
<div id="alg4.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
               <span id="alg4.l5.3" class="ltx_text ltx_font_bold">if</span> <math id="alg4.l5.m1" class="ltx_Math" alttext="d_{ij}&lt;\max(d(v,n_{i}),d(v,n_{j}))" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>&lt;</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><msub><mi>n</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><msub><mi>n</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d_{ij}&lt;\max(d(v,n_{i}),d(v,n_{j}))</annotation></semantics></math> <span id="alg4.l5.4" class="ltx_text ltx_font_bold">then</span>



</div>
<div id="alg4.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
              
              
                <math id="alg4.l6.m1" class="ltx_Math" alttext="n_{\text{close}}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mtext>close</mtext></msub><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">n_{\text{close}}\leftarrow</annotation></semantics></math> <span id="alg4.l6.3" class="ltx_text">closer</span><math id="alg4.l6.m2" class="ltx_Math" alttext="(n_{i},n_{j})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>n</mi><mi>i</mi></msub><mo>,</mo><msub><mi>n</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n_{i},n_{j})</annotation></semantics></math>, <math id="alg4.l6.m3" class="ltx_Math" alttext="n_{\text{far}}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mtext>far</mtext></msub><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">n_{\text{far}}\leftarrow</annotation></semantics></math> <span id="alg4.l6.4" class="ltx_text">farther</span><math id="alg4.l6.m4" class="ltx_Math" alttext="(n_{i},n_{j})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>n</mi><mi>i</mi></msub><mo>,</mo><msub><mi>n</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n_{i},n_{j})</annotation></semantics></math>

</div>
