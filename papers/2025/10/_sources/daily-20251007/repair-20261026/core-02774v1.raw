             <span id="alg5.l10.3" class="ltx_text ltx_font_bold">return</span>  <math id="alg5.l10.m1" class="ltx_Math" alttext="\sqrt{sum}" display="inline" intent=":literal"><semantics><msqrt><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msqrt><annotation encoding="application/x-tex">\sqrt{sum}</annotation></semantics></math> <span id="alg5.l10.4" class="ltx_text" style="--ltx-fg-color:#808080;">// Only lane 0 holds final result</span>

