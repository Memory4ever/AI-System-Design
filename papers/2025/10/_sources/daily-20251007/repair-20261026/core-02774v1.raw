              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
              
              
               <span id="alg3.l13.3" class="ltx_text ltx_font_bold">for all</span> <math id="alg3.l13.m1" class="ltx_Math" alttext="v\in V" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">v\in V</annotation></semantics></math> <span id="alg3.l13.4" class="ltx_text ltx_font_bold">in parallel</span> <span id="alg3.l13.5" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg3.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
              
              
                <span id="alg3.l14.3" class="ltx_text">REVERSE_EDGE_SAMPLING</span><math id="alg3.l14.m1" class="ltx_Math" alttext="(v,N_{v},\rho)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><msub><mi>N</mi><mi>v</mi></msub><mo>,</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(v,N_{v},\rho)</annotation></semantics></math>

</div>
<div id="alg3.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
              
              
               <span id="alg3.l15.3" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l15.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg3.l16" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
              
              
