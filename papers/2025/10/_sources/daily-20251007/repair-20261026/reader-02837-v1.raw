<tr id="A2.T6.6.1.4" class="ltx_tr">
<th id="A2.T6.6.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">Inefficient</th>
<td id="A2.T6.6.1.4.2" class="ltx_td ltx_align_center">171</td>
<td id="A2.T6.6.1.4.3" class="ltx_td ltx_align_center">361</td></tr>
<tr id="A2.T6.6.1.5" class="ltx_tr">
<th id="A2.T6.6.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">Hallucination</th>
<td id="A2.T6.6.1.5.2" class="ltx_td ltx_align_center">251</td>
<td id="A2.T6.6.1.5.3" class="ltx_td ltx_align_center">-</td></tr>
