<td id="S5.T4.6.1.3.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S5.T4.6.1.3.6.1" class="ltx_text ltx_font_bold">0.9351</span></td>
<td id="S5.T4.6.1.3.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.9659</td>
