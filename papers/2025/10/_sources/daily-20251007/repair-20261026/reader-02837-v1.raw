<th id="S5.T4.6.1.24.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b ltx_border_r ltx_border_t"><span id="S5.T4.6.1.24.1.1" class="ltx_text ltx_font_bold">Overall Accuracy</span></th>
<td id="S5.T4.6.1.24.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" colspan="5">0.1948</td>
