<td id="S4.T2.6.1.3.2" class="ltx_td ltx_align_center ltx_border_r">96.91 ± 2.28</td>
<td id="S4.T2.6.1.3.3" class="ltx_td ltx_align_center">84.04 ± 7.17</td></tr>
<tr id="S4.T2.6.1.4" class="ltx_tr">
<th id="S4.T2.6.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">o3-mini</th>
