<td id="A2.T6.6.1.2.2" class="ltx_td ltx_align_center ltx_border_t">761</td>
<td id="A2.T6.6.1.2.3" class="ltx_td ltx_align_center ltx_border_t">735</td></tr>
<tr id="A2.T6.6.1.3" class="ltx_tr">
