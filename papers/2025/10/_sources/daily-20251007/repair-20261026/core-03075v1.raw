<td id="A5.T3.2.2.2" class="ltx_td ltx_align_center ltx_border_t">100%</td>
<td id="A5.T3.2.2.3" class="ltx_td ltx_align_center ltx_border_t">100%</td>
<td id="A5.T3.2.2.4" class="ltx_td ltx_align_center ltx_border_t">100%</td>
<td id="A5.T3.2.2.5" class="ltx_td ltx_align_center ltx_border_t">100%</td>
<td id="A5.T3.2.2.6" class="ltx_td ltx_align_center ltx_border_t">100%</td>
<td id="A5.T3.2.2.7" class="ltx_td ltx_align_center ltx_border_t">100%</td>
<td id="A5.T3.2.2.8" class="ltx_td ltx_align_center ltx_border_t">100%</td>
<td id="A5.T3.2.2.9" class="ltx_td ltx_align_center ltx_border_t">100%</td></tr>
