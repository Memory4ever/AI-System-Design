<th id="A5.T3.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b">MaskGIT</th>
<td id="A5.T3.2.3.2" class="ltx_td ltx_align_center ltx_border_b">94.7%</td>
<td id="A5.T3.2.3.3" class="ltx_td ltx_align_center ltx_border_b">97%</td>
<td id="A5.T3.2.3.4" class="ltx_td ltx_align_center ltx_border_b">94.7%</td>
<td id="A5.T3.2.3.5" class="ltx_td ltx_align_center ltx_border_b">94%</td>
<td id="A5.T3.2.3.6" class="ltx_td ltx_align_center ltx_border_b">79.49%</td>
<td id="A5.T3.2.3.7" class="ltx_td ltx_align_center ltx_border_b">62.6%</td>
<td id="A5.T3.2.3.8" class="ltx_td ltx_align_center ltx_border_b">58.85%</td>
<td id="A5.T3.2.3.9" class="ltx_td ltx_align_center ltx_border_b">30%</td></tr>
