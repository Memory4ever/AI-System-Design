<td id="A7.T6.8.4.7" class="ltx_td ltx_align_left"><math id="A7.T6.m34" class="ltx_Math" alttext="0.020" display="inline" intent=":literal"><semantics><mn>0.020</mn><annotation encoding="application/x-tex">0.020</annotation></semantics></math></td></tr>
