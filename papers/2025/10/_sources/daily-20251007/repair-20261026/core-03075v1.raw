<td id="S3.T1.4.2.4" class="ltx_td ltx_align_center ltx_border_t">discrete</td></tr>
<tr id="S3.T1.4.3" class="ltx_tr">
<th id="S3.T1.4.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">GIVT</th>
<td id="S3.T1.4.3.2" class="ltx_td ltx_align_center">✓</td>
<td id="S3.T1.4.3.3" class="ltx_td ltx_align_center">GMM-NLL</td>
<td id="S3.T1.4.3.4" class="ltx_td ltx_align_center">continuous</td></tr>
<tr id="S3.T1.4.4" class="ltx_tr">
<th id="S3.T1.4.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">MAR</th>
<td id="S3.T1.4.4.2" class="ltx_td ltx_align_center">✓</td>
<td id="S3.T1.4.4.3" class="ltx_td ltx_align_center">Diffusion</td>
<td id="S3.T1.4.4.4" class="ltx_td ltx_align_center">continuous</td></tr>
