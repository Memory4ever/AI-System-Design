<th id="S3.T1.4.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">DiT</th>
<td id="S3.T1.4.5.2" class="ltx_td ltx_align_center ltx_border_bb">✗</td>
<td id="S3.T1.4.5.3" class="ltx_td ltx_align_center ltx_border_bb">Diffusion</td>
