<td id="A7.T6.8.5.3" class="ltx_td ltx_align_left ltx_border_t"><math id="A7.T6.m37" class="ltx_Math" alttext="0.130" display="inline" intent=":literal"><semantics><mn>0.130</mn><annotation encoding="application/x-tex">0.130</annotation></semantics></math></td>
