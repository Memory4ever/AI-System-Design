<td id="A7.T6.8.3.3" class="ltx_td ltx_align_left ltx_border_t"><math id="A7.T6.m25" class="ltx_Math" alttext="0.190" display="inline" intent=":literal"><semantics><mn>0.190</mn><annotation encoding="application/x-tex">0.190</annotation></semantics></math></td>
<td id="A7.T6.8.3.4" class="ltx_td ltx_align_left ltx_border_t"><math id="A7.T6.m26" class="ltx_Math" alttext="0.190" display="inline" intent=":literal"><semantics><mn>0.190</mn><annotation encoding="application/x-tex">0.190</annotation></semantics></math></td>
<td id="A7.T6.8.3.5" class="ltx_td ltx_align_left ltx_border_t"><math id="A7.T6.m27" class="ltx_Math" alttext="0.060" display="inline" intent=":literal"><semantics><mn>0.060</mn><annotation encoding="application/x-tex">0.060</annotation></semantics></math></td>
<td id="A7.T6.8.3.6" class="ltx_td ltx_align_left ltx_border_t"><math id="A7.T6.m28" class="ltx_Math" alttext="0.060" display="inline" intent=":literal"><semantics><mn>0.060</mn><annotation encoding="application/x-tex">0.060</annotation></semantics></math></td>
<td id="A7.T6.8.3.7" class="ltx_td ltx_align_left ltx_border_t"><span id="A7.T6.8.3.7.1" class="ltx_text ltx_font_bold">0.470</span></td>
<td id="A7.T6.8.3.8" class="ltx_td ltx_align_left ltx_border_t"><math id="A7.T6.m29" class="ltx_Math" alttext="0.030" display="inline" intent=":literal"><semantics><mn>0.030</mn><annotation encoding="application/x-tex">0.030</annotation></semantics></math></td></tr>
<tr id="A7.T6.8.4" class="ltx_tr">
<td id="A7.T6.8.4.1" class="ltx_td ltx_align_left">MaskGIT</td>
<td id="A7.T6.8.4.2" class="ltx_td ltx_align_left"><math id="A7.T6.m30" class="ltx_Math" alttext="0.380" display="inline" intent=":literal"><semantics><mn>0.380</mn><annotation encoding="application/x-tex">0.380</annotation></semantics></math></td>
<td id="A7.T6.8.4.3" class="ltx_td ltx_align_left"><math id="A7.T6.m31" class="ltx_Math" alttext="0.260" display="inline" intent=":literal"><semantics><mn>0.260</mn><annotation encoding="application/x-tex">0.260</annotation></semantics></math></td>
<td id="A7.T6.8.4.4" class="ltx_td ltx_align_left"><math id="A7.T6.m32" class="ltx_Math" alttext="0.110" display="inline" intent=":literal"><semantics><mn>0.110</mn><annotation encoding="application/x-tex">0.110</annotation></semantics></math></td>
<td id="A7.T6.8.4.5" class="ltx_td ltx_align_left"><math id="A7.T6.m33" class="ltx_Math" alttext="0.050" display="inline" intent=":literal"><semantics><mn>0.050</mn><annotation encoding="application/x-tex">0.050</annotation></semantics></math></td>
