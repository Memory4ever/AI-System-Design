{"data":[{"id":"10.48550/arxiv.2510.03223","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03223","identifiers":[{"identifier":"2510.03223","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hongxiang","familyName":"Zhang","name":"Zhang, Hongxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuan","familyName":"Tian","name":"Tian, Yuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianyi","familyName":"Zhang","name":"Zhang, Tianyi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Attention-Aligned Reasoning for Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T17:56:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:52:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-27T17:14:20Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-30T01:04:25Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-10-20T17:39:02Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-10-21T01:35:00Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) tend to generate a long reasoning chain when solving complex tasks. However, as the reasoning chain extends, critical intermediate steps and the original prompt will be buried in the context, receiving insufficient attention and leading to errors. In this work, we present ATAR, a novel reasoning method that leverages the inherent reasoning structure to steer LLM attention. Our experiments show that ATAR outperforms SOTA methods across six benchmarks, achieving up to 15.39% absolute improvement. Furthermore, with ATAR, \"non-reasoning\" models achieve comparable or even better performance compared to reasoning models of the same size in most benchmarks. Finally, our ablation studies show that the attention alignment component contributes significantly, and that these improvements are persist under different attentionsteering backends."},{"descriptionType":"Other","description":"EMNLP 2026 (Findings)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03223","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:46:55Z","registered":"2025-10-06T01:46:56Z","published":null,"updated":"2026-10-21T03:13:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03029","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03029","identifiers":[{"identifier":"2510.03029","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Debalina Ghosh","familyName":"Paul","name":"Paul, Debalina Ghosh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hong","familyName":"Zhu","name":"Zhu, Hong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ian","familyName":"Bayley","name":"Bayley, Ian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Investigating The Smells of LLM Generated Code"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T14:09:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:42:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-09-27T11:36:28Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-09-29T01:32:47Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Context: Large Language Models (LLMs) are increasingly being used to generate program code. Much research has been reported on the functional correctness of generated code, but there is far less on code quality. Objectives: In this study, we propose a scenario-based method of evaluating the quality of LLM-generated code to identify the weakest scenarios, for which the quality of LLM-generated code should be improved. Methods: The method measures code smells, an important indicator of code quality, and compares them with a baseline formed from reference solutions of professionally written code. The test dataset is divided into various subsets according to the topics of the code and complexity of the coding tasks to represent different scenarios of using LLMs for code generation. We will also present an automated test system for this purpose and report experiments with the Java programs generated in response to prompts given to four state-of-the-art LLMs: Gemini Pro, ChatGPT, Codex, and Falcon. Results: We find that LLM-generated code has a higher incidence of code smells compared to reference solutions. Falcon performed the least badly, with a smell increase of 42.28%, followed by Gemini Pro (62.07%), ChatGPT (65.05%) and finally Codex (84.97%). The average smell increase across all LLMs was 63.34%, comprising 73.35% for implementation smells and 21.42% for design smells. We also found that the increase in code smells is greater for more complex coding tasks and for more advanced topics, such as those involving object-orientated concepts. Conclusion: In terms of code smells, LLMs' performances on various coding task complexities and topics are highly correlated to the quality of human-written code in the corresponding scenarios. However, the quality of LLM-generated code is noticeably poorer than human-written code."},{"descriptionType":"Other","description":"This is a revised version of the paper done in June 2026. It improves the presentation of the work and the statistical analysis of the data. The raw data of the experiments are the same as the previous version"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03029","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:42:12Z","registered":"2025-10-06T01:42:13Z","published":null,"updated":"2026-09-29T06:56:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03136","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03136","identifiers":[{"identifier":"2510.03136","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ej","familyName":"Zhou","name":"Zhou, Ej","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Caiqi","familyName":"Zhang","name":"Zhang, Caiqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tiancheng","familyName":"Hu","name":"Hu, Tiancheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengzu","familyName":"Li","name":"Li, Chengzu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nigel","familyName":"Collier","name":"Collier, Nigel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ivan","familyName":"Vulić","name":"Vulić, Ivan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anna","familyName":"Korhonen","name":"Korhonen, Anna","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Beyond the Final Layer: Intermediate Representations for Better Multilingual Calibration in Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T16:07:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:48:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-31T05:34:53Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-09-01T01:36:25Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Confidence calibration, the alignment of a model's predicted confidence with its actual accuracy, is crucial for the reliable deployment of Large Language Models (LLMs). However, this critical property remains largely under-explored in multilingual contexts. In this work, we conduct the first large-scale, systematic studies of multilingual calibration across six model families and over 100 languages, revealing that non-English languages suffer from systematically worse calibration. To diagnose this, we investigate the model's internal representations and find that the final layer, biased by English-centric training, provides a poor signal for multilingual confidence. In contrast, our layer-wise analysis uncovers a key insight that late-intermediate layers consistently offer a more reliable and better-calibrated signal. Building on this, we introduce a suite of training-free methods, including Language-Aware Confidence Ensemble (LACE), which adaptively selects an optimal ensemble of layers for each specific language. Our study highlights the hidden costs of English-centric alignment and offer a new path toward building more globally equitable and trustworthy LLMs by looking beyond the final layer."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03136","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:44:48Z","registered":"2025-10-06T01:44:49Z","published":null,"updated":"2026-09-01T05:01:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02625","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02625","identifiers":[{"identifier":"2510.02625","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jacob","familyName":"Feitelberg","name":"Feitelberg, Jacob","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dwaipayan","familyName":"Saha","name":"Saha, Dwaipayan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kyuseong","familyName":"Choi","name":"Choi, Kyuseong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zaid","familyName":"Ahmad","name":"Ahmad, Zaid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anish","familyName":"Agarwal","name":"Agarwal, Anish","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Raaz","familyName":"Dwivedi","name":"Dwivedi, Raaz","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"One Pipeline, Many Transformers: Pattern-Specific Imputation Specialists for Tabular Missing Data"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T00:08:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:13:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-10T15:55:12Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-13T00:58:24Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-01-10T17:10:11Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-01-13T01:31:11Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02-17T14:59:03Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-02-18T01:44:09Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-08-18T00:58:33Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-08-19T00:19:00Z","dateType":"Updated","dateInformation":"v5"},{"date":"2026-08-28T02:36:13Z","dateType":"Submitted","dateInformation":"v6"},{"date":"2026-08-31T00:20:21Z","dateType":"Updated","dateInformation":"v6"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"6","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Missing data in tabular datasets forces practitioners into a hard choice: deploy a general-purpose imputer that may perform poorly for the problem at hand, or wait for someone to design a specialized algorithm. This problem is worsened by the fact that real-world missingness rarely satisfies the textbook missing completely at random (MCAR) assumption, as entries are often missing not at random (MNAR), where the probability of being observed depends on the missing data itself. We collapse this trade-off into a single pre-training pipeline that builds transformer-based imputation specialists through three components: an entry-wise featurization that recasts imputation as supervised prediction over row--column context, a synthetic data generator with pluggable missingness modules, and prior-data fitting on millions of synthetic tables. Swapping only the missingness module, with no changes to architecture, loss, or training, yields a pattern-specific specialist that outperforms methods purpose-built for that pattern. We validate this on MissBench, a new benchmark of 42 OpenML datasets and 11 missingness patterns (including 9 MNAR variants) spanning medicine, finance, and engineering. Remarkably, training exclusively on MCAR yields a default model---TabImpute---robust across all tested patterns. In addition, the pattern-specific specialists produced by our pipeline outperform the 14 established baselines on their target patterns. We open-source the pipeline, models, and benchmark."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02625","contentUrl":null,"metadataVersion":5,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:32:24Z","registered":"2025-10-06T01:32:24Z","published":null,"updated":"2026-08-31T02:20:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03093","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03093","identifiers":[{"identifier":"2510.03093","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Oriol","familyName":"Pareras","name":"Pareras, Oriol","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gerard I.","familyName":"Gállego","name":"Gállego, Gerard I.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Federico","familyName":"Costa","name":"Costa, Federico","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cristina","familyName":"España-Bonet","name":"España-Bonet, Cristina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Javier","familyName":"Hernando","name":"Hernando, Javier","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Revisiting Direct Speech-to-Text Translation with Speech LLMs: Better Scaling than CoT Prompting?"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T15:23:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:45:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-23T10:54:04Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-18T01:06:10Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/icassp55912.2026.11464161","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent work on Speech-to-Text Translation (S2TT) has focused on LLM-based models, introducing the increasingly adopted Chain-of-Thought (CoT) prompting, where the model is guided to first transcribe the speech and then translate it. CoT typically outperforms direct prompting primarily because it can exploit abundant Automatic Speech Recognition (ASR) and Text-to-Text Translation (T2TT) datasets to explicitly model its steps. In this paper, we systematically compare CoT and Direct prompting under increasing amounts of S2TT data. To this end, we pseudo-label an ASR corpus by translating its transcriptions into six European languages, and train LLM-based S2TT systems with both prompting strategies at different data scales. Our results show that Direct improves more consistently as the amount of data increases, suggesting that it may become a more effective approach as larger S2TT resources are created."},{"descriptionType":"Other","description":"To appear in Proc. ICASSP 2026, May 04-08, 2026, Barcelona, Spain"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03093","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:43:45Z","registered":"2025-10-06T01:43:46Z","published":null,"updated":"2026-08-18T03:56:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02345","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02345","identifiers":[{"identifier":"2510.02345","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Peijun","familyName":"Zhu","name":"Zhu, Peijun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ning","familyName":"Yang","name":"Yang, Ning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Baoliang","familyName":"Tian","name":"Tian, Baoliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayu","familyName":"Wei","name":"Wei, Jiayu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weihao","familyName":"Zhang","name":"Zhang, Weihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haijun","familyName":"Zhang","name":"Zhang, Haijun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pin","familyName":"Lv","name":"Lv, Pin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Breaking the MoE LLM Trilemma: Dynamic Expert Clustering with Structured Compression"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Neural and Evolutionary Computing (cs.NE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-27T10:45:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:00:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-04T16:03:04Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-05T01:59:08Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02-05T08:40:18Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-02-06T01:33:48Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-07-21T06:35:53Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-07-22T00:27:57Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Mixture-of-Experts (MoE) Large Language Models (LLMs) face a trilemma of load imbalance, parameter redundancy, and communication overhead. We introduce a unified framework based on dynamic expert clustering and structured compression to address these issues cohesively. Our method employs an online clustering procedure that periodically regroups experts using a fused metric of parameter and activation similarity, which stabilizes expert utilization. To our knowledge, this is one of the first frameworks to leverage the semantic embedding capability of the router to dynamically reconfigure the model's architecture during training for substantial efficiency gains. Within each cluster, we decompose expert weights into a shared base matrix and extremely low-rank residual adapters, achieving up to fivefold parameter reduction per group while preserving specialization. This structure enables a two-stage hierarchical routing strategy: tokens are first assigned to a cluster, then to specific experts within it, drastically reducing the routing search space and the volume of all-to-all communication. Furthermore, a heterogeneous precision scheme, which stores shared bases in FP16 and residual factors in INT4, coupled with dynamic offloading of inactive clusters, reduces peak memory consumption to levels comparable to dense models. Evaluated on GLUE and WikiText-103, our framework matches the quality of standard MoE models while reducing total parameters by approximately 80%, improving throughput by 10% to 20%, and lowering expert load variance by a factor of over three. Our work demonstrates that structural reorganization is a principled path toward scalable, efficient, and memory-effective MoE LLMs. Code is available at https://github.com/szdtzpj/Breaking_the_moe_trilemma"},{"descriptionType":"Other","description":"10 pages, 2 figures, 8 tables. Under review as a conference paper at ICML 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02345","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:25:30Z","registered":"2025-10-06T01:25:31Z","published":null,"updated":"2026-07-22T02:19:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02964","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02964","identifiers":[{"identifier":"2510.02964","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yu","familyName":"He","name":"He, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifei","familyName":"Chen","name":"Chen, Yifei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiming","familyName":"Li","name":"Li, Yiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuo","familyName":"Shao","name":"Shao, Shuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leyi","familyName":"Qi","name":"Qi, Leyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Boheng","familyName":"Li","name":"Li, Boheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dacheng","familyName":"Tao","name":"Tao, Dacheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhan","familyName":"Qin","name":"Qin, Zhan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"External Data Extraction Attacks against Retrieval-Augmented Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T12:53:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:39:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-07T08:30:10Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-08T00:33:06Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In recent years, RAG has emerged as a key paradigm for enhancing large language models (LLMs). By integrating externally retrieved information, RAG alleviates issues like outdated knowledge and, crucially, insufficient domain expertise. While effective, RAG introduces new risks of external data extraction attacks (EDEAs), where sensitive or copyrighted data in its knowledge base may be extracted verbatim. These risks are particularly acute when RAG is used to customize specialized LLM applications with private knowledge bases. Despite initial studies exploring these risks, they often lack a formalized framework, robust attack performance, and comprehensive evaluation, leaving critical questions about real-world EDEA feasibility unanswered.\n In this paper, we present the first comprehensive study to formalize EDEAs against retrieval-augmented LLMs. We first formally define EDEAs and propose a unified framework decomposing their design into three components: extraction instruction, jailbreak operator, and retrieval trigger, under which prior attacks can be considered instances within our framework. Guided by this framework, we develop SECRET: a Scalable and EffeCtive exteRnal data Extraction aTtack. Specifically, SECRET incorporates (1) an adaptive optimization process using LLMs as optimizers to generate specialized jailbreak prompts for EDEAs, and (2) cluster-focused triggering, an adaptive strategy that alternates between global exploration and local exploitation to efficiently generate effective retrieval triggers. Extensive evaluations across 4 models reveal that SECRET significantly outperforms previous attacks, and is highly effective against all 16 tested RAG instances. Notably, SECRET successfully extracts 35% of the data from RAG powered by Claude 3.7 Sonnet for the first time, whereas other attacks yield 0% extraction. Our findings call for attention to this emerging threat."},{"descriptionType":"Other","description":"Accepted by IEEE TIFS"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02964","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:40:37Z","registered":"2025-10-06T01:40:38Z","published":null,"updated":"2026-07-08T02:09:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02480","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02480","identifiers":[{"identifier":"2510.02480","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Andrea","familyName":"Wynn","name":"Wynn, Andrea","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Metod","familyName":"Jazbec","name":"Jazbec, Metod","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Charith","familyName":"Peris","name":"Peris, Charith","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rinat","familyName":"Khaziev","name":"Khaziev, Rinat","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anqi","familyName":"Liu","name":"Liu, Anqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Khashabi","name":"Khashabi, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eric","familyName":"Nalisnick","name":"Nalisnick, Eric","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Controlling the Risk of Corrupted Contexts for Language Models via Early-Exiting"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T18:36:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:04:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-04T21:22:39Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-06T01:07:51Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-27T22:55:59Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-29T00:16:27Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) can be influenced by harmful or irrelevant context, which can significantly harm model performance on downstream tasks. This motivates principled designs in which LLM systems include built-in mechanisms to guard against such \"garbage in, garbage out\" scenarios. We propose a novel approach to limit the degree to which harmful context can degrade model performance. First, we define a baseline \"safe\" behavior for the model -- the model's performance given no context at all (zero-shot). Next, we apply distribution-free risk control (DFRC) to control the extent to which the user-provided context can decay performance below this safe zero-shot baseline. We achieve this by leveraging dynamic early exit prediction, ignoring later attention heads that attend the most to the unsafe inputs. Finally, we propose modifications to DFRC that allow it to both control risk for harmful inputs \\textit{and} leverage performance and efficiency gains on helpful inputs. We present both theoretical and empirical results across 9 tasks spanning in-context learning and open-ended question answering, showing that our approach can effectively control risk for harmful context and simultaneously achieve substantial computational efficiency gains with helpful context."},{"descriptionType":"Other","description":"Accepted to ICML 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02480","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:28:48Z","registered":"2025-10-06T01:28:49Z","published":null,"updated":"2026-05-29T02:56:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02361","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02361","identifiers":[{"identifier":"2510.02361","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haojie","familyName":"Ouyang","name":"Ouyang, Haojie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianwei","familyName":"Lv","name":"Lv, Jianwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Ren","name":"Ren, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen","familyName":"Wei","name":"Wei, Chen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaojie","familyName":"Wang","name":"Wang, Xiaojie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fangxiang","familyName":"Feng","name":"Feng, Fangxiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ChunkLLM: A Lightweight Pluggable Framework for Accelerating LLMs Inference"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-28T11:04:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:01:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-25T07:51:15Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-26T01:32:30Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Transformer-based large models excel in natural language processing and computer vision, but face severe computational inefficiencies due to the self-attention's quadratic complexity with input tokens. Recently, researchers have proposed a series of methods based on block selection and compression to alleviate this problem, but they either have issues with semantic incompleteness or poor training-inference efficiency. To comprehensively address these challenges, we propose ChunkLLM, a lightweight and pluggable training framework. Specifically, we introduce two components: QK Adapter (Q-Adapter and K-Adapter) and Chunk Adapter. The former is attached to each Transformer layer, serving dual purposes of feature compression and chunk attention acquisition. The latter operates at the bottommost layer of the model, functioning to detect chunk boundaries by leveraging contextual semantic information. During the training phase, the parameters of the backbone remain frozen, with only the QK Adapter and Chunk Adapter undergoing training. Notably, we design an attention distillation method for training the QK Adapter, which enhances the recall rate of key chunks. During the inference phase, chunk selection is triggered exclusively when the current token is detected as a chunk boundary, thereby accelerating model inference. Experimental evaluations are conducted on a diverse set of long-text and short-text benchmark datasets spanning multiple tasks. ChunkLLM not only attains comparable performance on short-text benchmarks but also maintains 98.64% of the performance on long-context benchmarks while preserving a 48.58% key-value cache retention rate. Particularly, ChunkLLM attains a maximum speedup of 4.48x in comparison to the vanilla Transformer in the processing of 120K long texts."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02361","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:25:53Z","registered":"2025-10-06T01:25:53Z","published":null,"updated":"2026-05-26T04:04:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02734","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02734","identifiers":[{"identifier":"2510.02734","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Taehan","familyName":"Kim","name":"Kim, Taehan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sangdae","familyName":"Nam","name":"Nam, Sangdae","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SAE-RNA: A Sparse Autoencoder Model for Interpreting RNA Language Model Representations"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Biomolecules (q-bio.BM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Genomics (q-bio.GN)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T05:34:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:22:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-15T04:44:23Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-18T00:26:10Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Deep learning, particularly with the advancement of Large Language Models, has transformed biomolecular modeling, with protein language models such as ESM inspiring emerging RNA language models such as RiNALMo. Recent work has begun applying sparse autoencoders (SAEs) to protein language model representations, exploring representation-level interpretability in biomolecular models. Here, we explore whether SAEs can provide interpretable feature decompositions of RNA language model representations, while also examining their limitations in this setting. We present SAE-RNA, interpretability model that analyzes RiNALMo representations and maps them to known human-level biological features. Rather than claiming definitive biological concept discovery, our study frames SAE-based analysis as a representation-level probe for characterizing how RNA language models organize biological information internally. More broadly, SAE-RNA provides a feature-level framework for comparing RNA groups and identifying sparse representation components associated with RNA family identity or structural context."},{"descriptionType":"Other","description":"12 pages, 7 figures. v2: Updated bibliography to improve reference accuracy and reflect updated publication venues. Refined claims for better alignment with results and added an Appendix"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02734","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:35:02Z","registered":"2025-10-06T01:35:03Z","published":null,"updated":"2026-05-18T02:13:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02453","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02453","identifiers":[{"identifier":"2510.02453","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Parth","familyName":"Asawa","name":"Asawa, Parth","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alan","familyName":"Zhu","name":"Zhu, Alan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abigail","familyName":"O'Neill","name":"O'Neill, Abigail","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matei","familyName":"Zaharia","name":"Zaharia, Matei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexandros G.","familyName":"Dimakis","name":"Dimakis, Alexandros G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joseph E.","familyName":"Gonzalez","name":"Gonzalez, Joseph E.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"How to Train Your Advisor: Steering Black-Box LLMs with Advisor Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T18:02:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:03:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-02T18:23:32Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-03T03:20:27Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-15T17:52:01Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-18T01:07:27Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Frontier language models are deployed as black-box services, where model weights cannot be modified and customization is limited to prompting. We introduce Advisor Models, a method to train small open-weight models to generate dynamic, per-instance natural language advice that improves the capabilities of black-box frontier models. Advisor Models improve GPT-5.2's performance on RuleArena (Taxes) by 27.4%, reduce Gemini 3 Pro's steps taken in SWE agent tasks by 24.6%, and outperform static prompt optimizers in personalizing GPT-5 to user preferences (85-100% vs. 40-60%). We also find that advisors are transferable: an advisor trained with a low-cost student model still transfers improvements to a frontier model. Moreover, Advisor Models are robust: we observe no degradation on other benchmarks than the pipeline is trained on. Our method shows how to perform parametric optimization for black-box frontier models in a practical and cost-effective way."},{"descriptionType":"Other","description":"International Conference on Machine Learning (ICML) 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02453","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:28:08Z","registered":"2025-10-06T01:28:09Z","published":null,"updated":"2026-05-18T02:13:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03206","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03206","identifiers":[{"identifier":"2510.03206","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Cai","familyName":"Zhou","name":"Zhou, Cai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenxiao","familyName":"Yang","name":"Yang, Chenxiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Hu","name":"Hu, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenyu","familyName":"Wang","name":"Wang, Chenyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chubin","familyName":"Zhang","name":"Zhang, Chubin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muhan","familyName":"Zhang","name":"Zhang, Muhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lester","familyName":"Mackey","name":"Mackey, Lester","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tommi","familyName":"Jaakkola","name":"Jaakkola, Tommi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stephen","familyName":"Bates","name":"Bates, Stephen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dinghuai","familyName":"Zhang","name":"Zhang, Dinghuai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Coevolutionary Continuous Discrete Diffusion: Make Your Diffusion Language Model a Latent Reasoner"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T17:44:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:52:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-12T17:53:41Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-13T01:26:46Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion language models, especially masked discrete diffusion models, have achieved great success recently. While there are some theoretical and primary empirical results showing the advantages of latent reasoning with looped transformers or continuous chain-of-thoughts, continuous diffusion models typically underperform their discrete counterparts. In this paper, we argue that diffusion language models do not necessarily need to be in the discrete space. In particular, we prove that continuous diffusion models have stronger expressivity than discrete diffusions and looped transformers. We attribute the contradiction between the theoretical expressiveness and empirical performance to their practical trainability: while continuous diffusion provides intermediate supervision that looped transformers lack, they introduce additional difficulty decoding tokens into the discrete token space from the continuous representation space. We therefore propose Coevolutionary Continuous Discrete Diffusion (CCDD), which defines a joint multimodal diffusion process on the union of a continuous representation space and a discrete token space, leveraging a single model to simultaneously denoise in the joint space. By combining two modalities, CCDD is expressive with rich semantics in the latent space, as well as good trainability and sample quality with the help of explicit discrete tokens. We also propose effective architectures and advanced training/sampling techniques for CCDD, which reveals strong empirical performance in extensive language modeling experiments on real-world tasks."},{"descriptionType":"Other","description":"29 pages. Accepted to ICML 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03206","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:46:31Z","registered":"2025-10-06T01:46:32Z","published":null,"updated":"2026-05-13T02:57:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02339","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02339","identifiers":[{"identifier":"2510.02339","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kevin","familyName":"Zhou","name":"Zhou, Kevin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adam","familyName":"Dejl","name":"Dejl, Adam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gabriel","familyName":"Freedman","name":"Freedman, Gabriel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lihu","familyName":"Chen","name":"Chen, Lihu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antonio","familyName":"Rago","name":"Rago, Antonio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francesca","familyName":"Toni","name":"Toni, Francesca","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evaluating Uncertainty Quantification Methods in Argumentative Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-26T19:59:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-08T01:13:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.18653/v1/2025.findings-emnlp.1184","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Research in uncertainty quantification (UQ) for large language models (LLMs) is increasingly important towards guaranteeing the reliability of this groundbreaking technology. We explore the integration of LLM UQ methods in argumentative LLMs (ArgLLMs), an explainable LLM framework for decision-making based on computational argumentation in which UQ plays a critical role. We conduct experiments to evaluate ArgLLMs' performance on claim verification tasks when using different LLM UQ methods, inherently performing an assessment of the UQ methods' effectiveness. Moreover, the experimental procedure itself is a novel way of evaluating the effectiveness of UQ methods, especially when intricate and potentially contentious statements are present. Our results demonstrate that, despite its simplicity, direct prompting is an effective UQ strategy in ArgLLMs, outperforming considerably more complex approaches."},{"descriptionType":"Other","description":"Accepted at EMNLP Findings 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02339","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-10-06T01:25:21Z","registered":"2025-10-06T01:25:22Z","published":null,"updated":"2026-05-11T02:42:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02657","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02657","identifiers":[{"identifier":"2510.02657","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jingjie","familyName":"Ning","name":"Ning, Jingjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yibo","familyName":"Kong","name":"Kong, Yibo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunfan","familyName":"Long","name":"Long, Yunfan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jamie","familyName":"Callan","name":"Callan, Jamie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Less LLM, More Documents: Searching for Improved RAG"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"H.3.3; I.2.7","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-10-03T01:26:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:15:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-06T02:54:21Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-07T01:12:32Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-01-16T01:29:15Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-29T22:14:23Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Retrieval-Augmented Generation (RAG) couples document retrieval with large language models (LLMs). While scaling generators often improves accuracy, it also increases inference and deployment overhead. We study an orthogonal axis: enlarging the retriever's corpus, and how it trades off with generator scale. Across multiple open-domain QA benchmarks, corpus scaling consistently strengthens RAG and can in many cases match the gains of moving to a larger model tier, though with diminishing returns at larger scales. Small- and mid-sized generators paired with larger corpora often rival much larger models with smaller corpora; mid-sized models tend to gain the most, while tiny and very large models benefit less. Our analysis suggests that these improvements arise primarily from increased coverage of answer-bearing passages, while utilization efficiency remains largely unchanged. Overall, our results characterize a corpus-generator trade-off in RAG and provide empirical guidance on how corpus scale and model capacity interact in this setting."},{"descriptionType":"Other","description":"Proceeding Version of ECIR 2026. In: Campos, R., et al. Advances in Information Retrieval. ECIR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02657","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:33:09Z","registered":"2025-10-06T01:33:10Z","published":null,"updated":"2026-04-30T02:19:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02629","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02629","identifiers":[{"identifier":"2510.02629","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jingyi","familyName":"Sun","name":"Sun, Jingyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pepa","familyName":"Atanasova","name":"Atanasova, Pepa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sagnik Ray","familyName":"Choudhury","name":"Choudhury, Sagnik Ray","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sekh Mainul","familyName":"Islam","name":"Islam, Sekh Mainul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Isabelle","familyName":"Augenstein","name":"Augenstein, Isabelle","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evaluation Framework for Highlight Explanations of Context Utilisation in Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T00:15:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:13:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-22T16:22:21Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-23T00:58:40Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-26T16:04:20Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-28T01:01:08Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Context utilisation, the ability of Language Models (LMs) to incorporate relevant information from the provided context when generating responses, remains largely opaque to users, who cannot determine whether models draw from parametric memory or provided context, nor identify which specific context pieces inform the response. Highlight explanations (HEs) offer a natural solution as they can point the exact context pieces and tokens that influenced model outputs. However, no existing work evaluates their effectiveness in accurately explaining context utilisation. We address this gap by introducing the first gold standard HE evaluation framework for context attribution, using controlled test cases with known ground-truth context usage, which avoids the limitations of existing indirect proxy evaluations. To demonstrate the framework's broad applicability, we evaluate four HE methods -- three established techniques and MechLight, a mechanistic interpretability approach we adapt for this task -- across four context scenarios, four datasets, and five LMs. Overall, we find that MechLight performs best across all context scenarios. However, all methods struggle with longer contexts and exhibit positional biases, pointing to fundamental challenges in explanation accuracy that require new approaches to deliver reliable context utilisation explanations at scale."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02629","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:32:29Z","registered":"2025-10-06T01:32:30Z","published":null,"updated":"2026-04-28T04:05:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02370","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02370","identifiers":[{"identifier":"2510.02370","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Minsung","familyName":"Kim","name":"Kim, Minsung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dong-Kyum","familyName":"Kim","name":"Kim, Dong-Kyum","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jea","familyName":"Kwon","name":"Kwon, Jea","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nakyeong","familyName":"Yang","name":"Yang, Nakyeong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kyomin","familyName":"Jung","name":"Jung, Kyomin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Meeyoung","familyName":"Cha","name":"Cha, Meeyoung","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"How Training Data Shapes the Use of Parametric and In-Context Knowledge in Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-29T06:18:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:01:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-07T11:42:40Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-08T01:37:38Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-20T02:19:04Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-21T01:33:44Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models leverage both parametric knowledge acquired during pretraining and in-context knowledge provided at inference time. Crucially, when these sources conflict, models arbitrate based on their internal confidence, preferring parametric knowledge for high-confidence facts while deferring to context for less familiar ones. However, the training conditions that give rise to these fundamental behaviors remain unclear. Here we conduct controlled experiments using synthetic corpora to identify the specific data properties that shape knowledge utilization. Our results reveal a counterintuitive finding: the robust, balanced use of both knowledge sources is an emergent property that requires the co-occurrence of three factors typically considered detrimental, including (i) intra-document repetition, (ii) a moderate degree of intra-document inconsistency, and (iii) a skewed knowledge distribution. We further show that these dynamics arise in real-world language model pretraining and analyze how post-training procedures reshape arbitration strategies. Together, our findings provide empirical guidance for designing training data that supports the reliable integration of parametric and in-context knowledge in language models."},{"descriptionType":"Other","description":"16 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02370","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:26:05Z","registered":"2025-10-06T01:26:06Z","published":null,"updated":"2026-04-21T04:49:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03174","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03174","identifiers":[{"identifier":"2510.03174","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xuan","familyName":"Xu","name":"Xu, Xuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhongliang","familyName":"Yang","name":"Yang, Zhongliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haolun","familyName":"Li","name":"Li, Haolun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Beilin","familyName":"Chu","name":"Chu, Beilin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Tian","name":"Tian, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Li","name":"Li, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaolin","familyName":"Tan","name":"Tan, Shaolin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linna","familyName":"Zhou","name":"Zhou, Linna","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LLM as Attention-Informed NTM and Topic Modeling as long-input Generation: Interpretability and long-Context Capability"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T16:48:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:50:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-14T06:40:58Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-15T00:31:09Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Topic modeling aims to produce interpretable topic representations and topic--document correspondences from corpora, but classical neural topic models (NTMs) remain constrained by limited representation assumptions and semantic abstraction ability. We study LLM-based topic modeling from both white-box and black-box perspectives. For white-box LLMs, we propose an attention-informed framework that recovers interpretable structures analogous to those in NTMs, including document-topic and topic-word distributions. This validates the view that LLM can serve as an attention-informed NTM. For black-box LLMs, we reformulate topic modeling as a structured long-input task and introduce a post-generation signal compensation method based on diversified topic cues and hybrid retrieval. Experiments show that recovered attention structures support effective topic assignment and keyword extraction, while black-box long-context LLMs achieve competitive or stronger performance than other baselines. These findings suggest a connection between LLMs and NTMs and highlight the promise of long-context LLMs for topic modeling."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03174","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:45:43Z","registered":"2025-10-06T01:45:44Z","published":null,"updated":"2026-04-15T02:24:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02810","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02810","identifiers":[{"identifier":"2510.02810","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hemang","familyName":"Jain","name":"Jain, Hemang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shailender","familyName":"Goyal","name":"Goyal, Shailender","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Divyansh","familyName":"Pandey","name":"Pandey, Divyansh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Karthik","familyName":"Vaidhyanathan","name":"Vaidhyanathan, Karthik","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dissecting Transformers: A CLEAR Perspective towards Green AI"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T08:33:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:28:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-07T10:00:06Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-08T00:43:42Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The rapid adoption of Large Language Models (LLMs) has raised significant environmental concerns. Unlike the one-time cost of training, LLM inference occurs continuously and dominates the AI energy footprint. Yet most sustainability studies report only coarse model-level metrics, treating energy efficiency as an afterthought rather than a primary objective. Addressing the limitation, we propose Component-Level Energy Assessment via Repetitions CLEAR, to overcome temporal mismatch between microsecond scale component execution and millisecond(ms) scale monitoring of energy sensors. Using CLEAR, we evaluate 15 models spanning four architecture types, keeping component-wise energy variance below 9.5% while capturing over 90% of total energy as individual components. We present the first comprehensive, fine-grained energy analysis of Transformer components across key parameters such as batch size, attention heads, hidden dimension, KV cache, and attention variants. Our findings reveal that Attention consumes significantly more Energy per FLOP as compared to the entire model, indicating that FLOPs alone fail to capture true component-level energy cost. CLEAR enables reliable fine-grained energy measurements and provides a strong formal foundation for predictive modelling of energy consumption."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02810","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:36:51Z","registered":"2025-10-06T01:36:52Z","published":null,"updated":"2026-04-08T02:30:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02392","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02392","identifiers":[{"identifier":"2510.02392","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yinyi","familyName":"Luo","name":"Luo, Yinyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhexian","familyName":"Zhou","name":"Zhou, Zhexian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Chen","name":"Chen, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Qiu","name":"Qiu, Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marios","familyName":"Savvides","name":"Savvides, Marios","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sharon","familyName":"Li","name":"Li, Sharon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jindong","familyName":"Wang","name":"Wang, Jindong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"KnowledgeSmith: Uncovering Knowledge Updating in LLMs with Model Editing and Unlearning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T00:15:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:01:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-14T15:32:32Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-15T00:58:39Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-25T15:02:28Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-26T01:00:36Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Knowledge editing and machine unlearning are two popular approaches for large language models (LLMs) to stay up-to-date. However, the knowledge updating mechanism of LLMs remains largely unexplored due to insufficient, isolated, and small-scale evaluation. For instance, are LLMs similar to humans in modifying certain knowledge? What differs editing and unlearning as training data increases? This paper proposes KnowledgeSmith, a unified framework to systematically understand the updating mechanism of LLMs. We first cast editing and unlearning as instances of one constrained optimization problem. Then, we propose an automatic dataset generator that provides structured interventions across multiple graph levels and data scales, enabling controlled studies of how different modification strategies propagate through model knowledge. Extensive experiments demonstrate nuanced insights over knowledge propagation, plasticity scaling, consistency, and robustness. For instance, our results show that LLMs do not exhibit similar updating as humans for different levels of knowledge, and there exists consistency-capacity trade-off. We hope our findings can offer suggestions to the design of more reliable and scalable strategies. Code: https://github.com/AIFrontierLab/KnowledgeSmith.git"},{"descriptionType":"Other","description":"ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02392","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:26:39Z","registered":"2025-10-06T01:26:39Z","published":null,"updated":"2026-03-26T02:29:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02711","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02711","identifiers":[{"identifier":"2510.02711","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tarun Kumar","familyName":"Biswas","name":"Biswas, Tarun Kumar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ashrafun","familyName":"Zannat","name":"Zannat, Ashrafun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Waqas","familyName":"Ishtiaq","name":"Ishtiaq, Waqas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Md. Alamgir","familyName":"Hossain","name":"Hossain, Md. Alamgir","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Novel Unified Lightweight Temporal-Spatial Transformer Approach for Intrusion Detection in Drone Networks"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T04:23:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-03-24T01:58:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1038/s41598-026-45063-6","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The growing integration of drones across commercial, industrial, and civilian domains has introduced significant cybersecurity challenges, particularly due to the susceptibility of drone networks to a wide range of cyberattacks. Existing intrusion detection mechanisms often lack the adaptability, efficiency, and generalizability required for the dynamic and resource constrained environments in which drones operate. This paper proposes TSLT-Net, a novel lightweight and unified Temporal Spatial Transformer based intrusion detection system tailored specifically for drone networks. By leveraging self attention mechanisms, TSLT-Net effectively models both temporal patterns and spatial dependencies in network traffic, enabling accurate detection of diverse intrusion types. The framework includes a streamlined preprocessing pipeline and supports both multiclass attack classification and binary anomaly detection within a single architecture. Extensive experiments conducted on the ISOT Drone Anomaly Detection Dataset, consisting of more than 2.3 million labeled records, demonstrate the superior performance of TSLT-Net with 99.99 percent accuracy in multiclass detection and 100 percent in binary anomaly detection, while maintaining a minimal memory footprint of only 0.04 MB and 9722 trainable parameters. These results establish TSLT-Net as an effective and scalable solution for real time drone cybersecurity, particularly suitable for deployment on edge devices in mission critical UAV systems."},{"descriptionType":"Other","description":"21 pages, 18 figures, 5 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02711","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-10-06T01:34:28Z","registered":"2025-10-06T01:34:29Z","published":null,"updated":"2026-03-24T04:16:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03195","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03195","identifiers":[{"identifier":"2510.03195","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chanyeol","familyName":"Choi","name":"Choi, Chanyeol","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yoon","familyName":"Kim","name":"Kim, Yoon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Yu","name":"Yu, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Young","familyName":"Cha","name":"Cha, Young","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"V. Zach","familyName":"Golkhou","name":"Golkhou, V. Zach","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Igor","familyName":"Halperin","name":"Halperin, Igor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Georgios","familyName":"Papaioannou","name":"Papaioannou, Georgios","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minkyu","familyName":"Kim","name":"Kim, Minkyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhangyang","familyName":"Wang","name":"Wang, Zhangyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jihoon","familyName":"Kwon","name":"Kwon, Jihoon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minjae","familyName":"Kim","name":"Kim, Minjae","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alejandro","familyName":"Lopez-Lira","name":"Lopez-Lira, Alejandro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongjae","familyName":"Lee","name":"Lee, Yongjae","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From Text to Alpha: Can LLMs Track Evolving Signals in Corporate Disclosures?"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computational Engineering, Finance, and Science (cs.CE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T17:30:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:51:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-06T02:45:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-07T01:12:13Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-12-04T21:31:03Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-12-08T01:06:29Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-03-11T06:11:26Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-03-12T00:29:09Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-03-15T03:57:17Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-03-17T01:05:22Z","dateType":"Updated","dateInformation":"v5"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"5","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Natural language processing (NLP) has been widely used in quantitative finance, but traditional methods often struggle to capture rich narratives in corporate disclosures, leaving potentially informative signals under-explored. Large language models (LLMs) offer a promising alternative due to their ability to extract nuanced semantics. In this paper, we ask whether semantic signals extracted by LLMs from corporate disclosures predict alpha, defined as abnormal returns beyond broad market movements and common risk factors. We introduce a simple framework, LLM as extractor, embedding as ruler, which extracts context-aware, metric-focused textual spans and quantifies semantic changes across consecutive disclosure periods using embedding-based similarity. This allows us to measure the degree of metric shifting -- how much firms move away from previously emphasized metrics, referred as moving targets. In experiments with portfolio and cross-sectional regression tests against a recent NER-based baseline, our method achieves more than twice the risk-adjusted alpha and shows significantly stronger predictive power. Qualitative analysis suggests that these gains stem from preserving contextual qualifiers and filtering out non-metric terms that keyword-based approaches often miss."},{"descriptionType":"Other","description":"9 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03195","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:46:15Z","registered":"2025-10-06T01:46:16Z","published":null,"updated":"2026-03-17T04:56:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02353","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02353","identifiers":[{"identifier":"2510.02353","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Oumar","familyName":"Kane","name":"Kane, Oumar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mouhamad M.","familyName":"Allaya","name":"Allaya, Mouhamad M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dame","familyName":"Samb","name":"Samb, Dame","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mamadou","familyName":"Bousso","name":"Bousso, Mamadou","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"An Senegalese Legal Texts Structuration Using LLM-augmented Knowledge Graph"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-27T19:51:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-03-10T00:48:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/icfsp67350.2025.11353826","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This study examines the application of artificial intelligence (AI) and large language models (LLM) to improve access to legal texts in Senegal's judicial system. The emphasis is on the difficulties of extracting and organizing legal documents, highlighting the need for better access to judicial information. The research successfully extracted 7,967 articles from various legal documents, particularly focusing on the Land and Public Domain Code. A detailed graph database was developed, which contains 2,872 nodes and 10,774 relationships, aiding in the visualization of interconnections within legal texts. In addition, advanced triple extraction techniques were utilized for knowledge, demonstrating the effectiveness of models such as GPT-4o, GPT-4, and Mistral-Large in identifying relationships and relevant metadata. Through these technologies, the aim is to create a solid framework that allows Senegalese citizens and legal professionals to more effectively understand their rights and responsibilities."},{"descriptionType":"Other","description":"8 pages, 8 figures, 2 tables, 1 algorithm"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02353","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-10-06T01:25:41Z","registered":"2025-10-06T01:25:42Z","published":null,"updated":"2026-03-10T04:50:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03215","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03215","identifiers":[{"identifier":"2510.03215","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tianyu","familyName":"Fu","name":"Fu, Tianyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zihan","familyName":"Min","name":"Min, Zihan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanling","familyName":"Zhang","name":"Zhang, Hanling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jichao","familyName":"Yan","name":"Yan, Jichao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guohao","familyName":"Dai","name":"Dai, Guohao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wanli","familyName":"Ouyang","name":"Ouyang, Wanli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Wang","name":"Wang, Yu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Cache-to-Cache: Direct Semantic Communication Between Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.7","lang":"en","subjectScheme":"ACM"},{"subject":"68T07, 68T50","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2025-10-03T17:52:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:52:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-02T19:24:02Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-04T01:04:04Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Multi-LLM systems harness the complementary strengths of diverse Large Language Models, achieving performance and efficiency gains that are not attainable by a single model. In existing designs, LLMs communicate through text, forcing internal representations to be transformed into output token sequences. This process both loses rich semantic information and incurs token-by-token generation latency. Motivated by these limitations, we ask: Can LLMs communicate beyond text? Oracle experiments show that enriching the KV-Cache semantics can improve response quality without increasing cache size, supporting KV-Cache as an effective medium for inter-model communication. Thus, we propose Cache-to-Cache (C2C), a new paradigm for direct semantic communication between LLMs. C2C uses a neural network to project and fuse the source model's KV-cache with that of the target model to enable direct semantic transfer. A learnable gating mechanism selects the target layers that benefit from cache communication. Compared with text communication, C2C utilizes the deep, specialized semantics from both models, while avoiding explicit intermediate text generation. Experiments show that C2C achieves 6.4-14.2% higher average accuracy than individual models. It further outperforms the text communication paradigm by approximately 3.1-5.4%, while delivering an average 2.5x speedup in latency. Our code is available at https://github.com/thu-nics/C2C."},{"descriptionType":"Other","description":"Published in ICLR'26"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03215","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:46:44Z","registered":"2025-10-06T01:46:45Z","published":null,"updated":"2026-03-04T03:18:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03027","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03027","identifiers":[{"identifier":"2510.03027","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Junyi","familyName":"Yao","name":"Yao, Junyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Parham","familyName":"Eftekhar","name":"Eftekhar, Parham","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gene","familyName":"Cheung","name":"Cheung, Gene","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xujin Chris","familyName":"Liu","name":"Liu, Xujin Chris","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yao","familyName":"Wang","name":"Wang, Yao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Hu","name":"Hu, Wei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Lightweight Transformer for EEG Classification via Balanced Signed Graph Algorithm Unrolling"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T14:08:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:42:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-16T04:34:31Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-17T00:25:49Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02-14T04:44:10Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-02-17T01:21:34Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-03-03T07:36:35Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-03-04T01:32:25Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Samples of brain signals collected by EEG sensors have inherent anti-correlations that are well modeled by negative edges in a finite graph. To differentiate epilepsy patients from healthy subjects using collected EEG signals, we build lightweight and interpretable transformer-like neural nets by unrolling a spectral denoising algorithm for signals on a balanced signed graph -- graph with no cycles of odd number of negative edges. A balanced signed graph has well-defined frequencies that map to a corresponding positive graph via similarity transform of the graph Laplacian matrices. We implement an ideal low-pass filter efficiently on the mapped positive graph via Lanczos approximation, where the optimal cutoff frequency is learned from data. Given that two balanced signed graph denoisers learn posterior probabilities of two different signal classes during training, we evaluate their reconstruction errors for binary classification of EEG signals. Experiments show that our method achieves classification performance comparable to representative deep learning schemes, while employing dramatically fewer parameters."},{"descriptionType":"Other","description":"Accepted by ICLR2026, 10 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03027","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:42:09Z","registered":"2025-10-06T01:42:10Z","published":null,"updated":"2026-03-04T03:18:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02410","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02410","identifiers":[{"identifier":"2510.02410","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Patrick","familyName":"Langer","name":"Langer, Patrick","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thomas","familyName":"Kaar","name":"Kaar, Thomas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Max","familyName":"Rosenblattl","name":"Rosenblattl, Max","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maxwell A.","familyName":"Xu","name":"Xu, Maxwell A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Winnie","familyName":"Chow","name":"Chow, Winnie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Martin","familyName":"Maritsch","name":"Maritsch, Martin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Robert","familyName":"Jakob","name":"Jakob, Robert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ning","familyName":"Wang","name":"Wang, Ning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juncheng","familyName":"Liu","name":"Liu, Juncheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aradhana","familyName":"Verma","name":"Verma, Aradhana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Brian","familyName":"Han","name":"Han, Brian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel Seung","familyName":"Kim","name":"Kim, Daniel Seung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Henry","familyName":"Chubb","name":"Chubb, Henry","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Scott","familyName":"Ceresnak","name":"Ceresnak, Scott","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aydin","familyName":"Zahedivash","name":"Zahedivash, Aydin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander Tarlochan Singh","familyName":"Sandhu","name":"Sandhu, Alexander Tarlochan Singh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fatima","familyName":"Rodriguez","name":"Rodriguez, Fatima","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"McDuff","name":"McDuff, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elgar","familyName":"Fleisch","name":"Fleisch, Elgar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Oliver","familyName":"Aalami","name":"Aalami, Oliver","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Filipe","familyName":"Barata","name":"Barata, Filipe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paul","familyName":"Schmiedmayer","name":"Schmiedmayer, Paul","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"OpenTSLM: Time-Series Language Models for Reasoning over Multivariate Medical Text- and Time-Series Data"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T09:58:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:02:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-12T17:19:15Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-13T02:03:39Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02-14T23:16:30Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-02-17T01:41:14Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"LLMs have emerged as powerful tools for interpreting multimodal data. In medicine, they hold particular promise for synthesizing large volumes of clinical information into actionable insights and digital health applications. Yet, a major limitation remains their inability to handle time series. To overcome this gap, we present OpenTSLM, a family of Time Series Language Models (TSLMs) created by integrating time series as a native modality to pretrained LLMs, enabling reasoning over multiple time series of any length. We investigate two architectures for OpenTSLM. The first, OpenTSLM-SoftPrompt, models time series implicitly by concatenating learnable time series tokens with text tokens via soft prompting. Although parameter-efficient, we hypothesize that explicit time series modeling scales better and outperforms implicit approaches. We thus introduce OpenTSLM-Flamingo, which integrates time series with text via cross-attention. We benchmark both variants against baselines that treat time series as text tokens or plots, across a suite of text-time-series Chain-of-Thought (CoT) reasoning tasks. We introduce three datasets: HAR-CoT, Sleep-CoT, and ECG-QA-CoT. Across all, OpenTSLM models outperform baselines, reaching 69.9 F1 in sleep staging and 65.4 in HAR, compared to 9.05 and 52.2 for finetuned text-only models. Notably, even 1B-parameter OpenTSLM models surpass GPT-4o (15.47 and 2.95). OpenTSLM-Flamingo matches OpenTSLM-SoftPrompt in performance and outperforms on longer sequences, while maintaining stable memory requirements. By contrast, SoftPrompt grows exponentially in memory with sequence length, requiring around 110 GB compared to 40 GB VRAM when training on ECG-QA with LLaMA-3B. Expert reviews by clinicians find strong reasoning capabilities exhibited by OpenTSLMs on ECG-QA. To facilitate further research, we provide all code, datasets, and models open-source."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02410","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:27:06Z","registered":"2025-10-06T01:27:06Z","published":null,"updated":"2026-02-17T04:46:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02356","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02356","identifiers":[{"identifier":"2510.02356","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xinjie","familyName":"Shen","name":"Shen, Xinjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mufei","familyName":"Li","name":"Li, Mufei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pan","familyName":"Li","name":"Li, Pan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Measuring Physical-World Privacy Awareness of Large Language Models: An Evaluation Benchmark"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-27T23:39:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:00:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-13T17:24:22Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-14T02:10:58Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02-15T00:49:48Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-02-17T01:42:57Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The deployment of Large Language Models (LLMs) in embodied agents creates an urgent need to measure their privacy awareness in the physical world. Existing evaluation methods, however, are confined to natural language based scenarios. To bridge this gap, we introduce EAPrivacy, a comprehensive evaluation benchmark designed to quantify the physical-world privacy awareness of LLM-powered agents. EAPrivacy utilizes procedurally generated scenarios across four tiers to test an agent's ability to handle sensitive objects, adapt to changing environments, balance task execution with privacy constraints, and resolve conflicts with social norms. Our measurements reveal a critical deficit in current models. The top-performing model, Gemini 2.5 Pro, achieved only 59\\% accuracy in scenarios involving changing physical environments. Furthermore, when a task was accompanied by a privacy request, models prioritized completion over the constraint in up to 86\\% of cases. In high-stakes situations pitting privacy against critical social norms, leading models like GPT-4o and Claude-3.5-haiku disregarded the social norm over 15\\% of the time. These findings, demonstrated by our benchmark, underscore a fundamental misalignment in LLMs regarding physically grounded privacy and establish the need for more robust, physically-aware alignment. Codes and datasets will be available at https://github.com/Graph-COM/EAPrivacy."},{"descriptionType":"Other","description":"Accepted by ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02356","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:25:45Z","registered":"2025-10-06T01:25:46Z","published":null,"updated":"2026-02-17T04:46:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02995","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02995","identifiers":[{"identifier":"2510.02995","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gijs","familyName":"Wijngaard","name":"Wijngaard, Gijs","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elia","familyName":"Formisano","name":"Formisano, Elia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michel","familyName":"Dumontier","name":"Dumontier, Michel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jenia","familyName":"Jitsev","name":"Jitsev, Jenia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AudioToolAgent: An Agentic Framework for Audio-Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T13:35:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:40:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-13T13:06:20Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-16T01:41:06Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Audio-Language Models (LALMs) perform well on audio understanding tasks but lack multistep reasoning and tool-calling found in recent Large Language Models (LLMs). This paper presents AudioToolAgent, a framework that coordinates audio-language models as tools via a central LLM agent that accesses tool adapters for audio question answering and speech-to-text. The agent reasons about which tools to invoke, how to formulate follow-up queries, and how to arbitrate conflicting tool outputs, without accessing the audio. Experiments with MMAU, MMAR, and MMAU-Pro show state-of-the-art accuracy: up to 77.50% in MMAU, 77.00% in MMAR, and 61.90% in MMAU-Pro. Shapley-based analysis identifies effective agent-tool combinations. The code and reproduction materials are available at https://github.com/GLJS/AudioToolAgent."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02995","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:41:23Z","registered":"2025-10-06T01:41:23Z","published":null,"updated":"2026-02-16T03:00:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02712","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02712","identifiers":[{"identifier":"2510.02712","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yubo","familyName":"Li","name":"Li, Yubo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ramayya","familyName":"Krishnan","name":"Krishnan, Ramayya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rema","familyName":"Padman","name":"Padman, Rema","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Time-To-Inconsistency: A Survival Analysis of Large Language Model Robustness to Adversarial Attacks"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T04:26:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:20:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-23T22:18:51Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-25T02:07:07Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-01-25T00:42:36Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-01-27T01:40:25Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02-04T01:47:35Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-02-05T01:18:10Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) have revolutionized conversational AI, yet their robustness in extended multi-turn dialogues remains poorly understood. Existing evaluation frameworks focus on static benchmarks and single-turn assessments, failing to capture the temporal dynamics of conversational degradation that characterize real-world interactions. In this work, we present a large-scale survival analysis of conversational robustness, modeling failure as a time-to-event process over 36,951 turns from 9 state-of-the-art LLMs on the MT-Consistency benchmark. Our framework combines Cox proportional hazards, Accelerated Failure Time (AFT), and Random Survival Forest models with simple semantic drift features. We find that abrupt prompt-to-prompt semantic drift sharply increases the hazard of inconsistency, whereas cumulative drift is counterintuitively \\emph{protective}, suggesting adaptation in conversations that survive multiple shifts. AFT models with model-drift interactions achieve the best combination of discrimination and calibration, and proportional hazards checks reveal systematic violations for key drift covariates, explaining the limitations of Cox-style modeling in this setting. Finally, we show that a lightweight AFT model can be turned into a turn-level risk monitor that flags most failing conversations several turns before the first inconsistent answer while keeping false alerts modest. These results establish survival analysis as a powerful paradigm for evaluating multi-turn robustness and for designing practical safeguards for conversational AI systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02712","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":2,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:34:30Z","registered":"2025-10-06T01:34:30Z","published":null,"updated":"2026-02-05T03:21:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02389","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02389","identifiers":[{"identifier":"2510.02389","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haoran","familyName":"Xi","name":"Xi, Haoran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minghao","familyName":"Shao","name":"Shao, Minghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Brendan","familyName":"Dolan-Gavitt","name":"Dolan-Gavitt, Brendan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muhammad","familyName":"Shafique","name":"Shafique, Muhammad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ramesh","familyName":"Karri","name":"Karri, Ramesh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From Trace to Line: LLM Agent for Real-World OSS Vulnerability Localization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-30T22:27:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:01:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-12-17T18:10:36Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-18T01:57:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02-04T14:49:18Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-02-05T01:55:00Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models show promise for vulnerability discovery, yet prevailing methods inspect code in isolation, struggle with long contexts, and focus on coarse function- or file-level detections that offer limited guidance to engineers who need precise line-level localization for targeted patches. We introduce T2L, an executable framework for project-level, line-level vulnerability localization that progressively narrows scope from repository modules to exact vulnerable lines via AST-based chunking and evidence-guided refinement. We provide a baseline agent with an Agentic Trace Analyzer (ATA) that fuses runtime evidence such as crash points and stack traces to translate failure symptoms into actionable diagnoses. To enable rigorous evaluation, we introduce T2L-ARVO, an expert-verified 50-case benchmark spanning five crash families in real-world projects. On T2L-ARVO, our baseline achieves up to 58.0% detection and 54.8% line-level localization rate. Together, T2L framework advance LLM-based vulnerability detection toward deployable, precision diagnostics in open-source software workflows."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02389","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:26:34Z","registered":"2025-10-06T01:26:35Z","published":null,"updated":"2026-02-05T03:21:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03217","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03217","identifiers":[{"identifier":"2510.03217","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"José","familyName":"Cambronero","name":"Cambronero, José","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michele","familyName":"Tufano","name":"Tufano, Michele","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sherry","familyName":"Shi","name":"Shi, Sherry","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Renyao","familyName":"Wei","name":"Wei, Renyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Grant","familyName":"Uy","name":"Uy, Grant","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Runxiang","familyName":"Cheng","name":"Cheng, Runxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chin-Jung","familyName":"Liu","name":"Liu, Chin-Jung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shiying","familyName":"Pan","name":"Pan, Shiying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Satish","familyName":"Chandra","name":"Chandra, Satish","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pat","familyName":"Rondon","name":"Rondon, Pat","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Abstain and Validate: A Dual-LLM Policy for Reducing Noise in Agentic Program Repair"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"D.2.5; I.2.2","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-10-03T17:53:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:52:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-29T00:09:30Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-30T01:12:32Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3786583.3786858","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Agentic Automated Program Repair (APR) is increasingly tackling complex, repository-level bugs in industry, but ultimately these patches still need to be reviewed by a human before committing them to ensure they address the bug. Showing patches unlikely to be accepted can lead to substantial noise, wasting valuable developer time and eroding trust in automated code changes. We introduce two complementary LLM-based policies to reduce such noise: bug abstention and patch validation policies. Bug abstention excludes bugs that the agentic APR system is unlikely to fix. Patch validation rejects patches that are unlikely to be a good fix for the given bug. We evaluate both policies on three sets of bugs from Google's codebase, and their candidate patches generated by an internal agentic APR system. On a set of 174 human-reported bugs, removing bugs and patches rejected by our policies can raise success rates by up to 13 percentage points and 15 percentage points, respectively, and by up to 39 percentage points in combination. On null pointer exceptions and sanitizer-reported bugs with machine-generated bug reports, patch validation also improves average single-sample success rates. This two-policy approach provides a practical path to the reliable, industrial-scale deployment of agentic APR systems."},{"descriptionType":"Other","description":"Accepted to the 2026 IEEE/ACM 48th International Conference on Software Engineering: Software Engineering in Practice (ICSE-SEIP '26)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03217","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-10-06T01:46:47Z","registered":"2025-10-06T01:46:48Z","published":null,"updated":"2026-01-30T03:42:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02391","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02391","identifiers":[{"identifier":"2510.02391","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nik","familyName":"Rollinson","name":"Rollinson, Nik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nikolaos","familyName":"Polatidis","name":"Polatidis, Nikolaos","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LLM-Generated Samples for Android Malware Detection"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-30T23:46:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-01-27T01:48:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.3390/digital6010005","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Android malware continues to evolve through obfuscation and polymorphism, posing challenges for both signature-based defenses and machine learning models trained on limited and imbalanced datasets. Synthetic data has been proposed as a remedy for scarcity, yet the role of large language models (LLMs) in generating effective malware data for detection tasks remains underexplored. In this study, we fine-tune GPT-4.1-mini to produce structured records for three malware families: BankBot, Locker/SLocker, and Airpush/StopSMS, using the KronoDroid dataset. After addressing generation inconsistencies with prompt engineering and post-processing, we evaluate multiple classifiers under three settings: training with real data only, real-plus-synthetic data, and synthetic data alone. Results show that real-only training achieves near perfect detection, while augmentation with synthetic data preserves high performance with only minor degradations. In contrast, synthetic-only training produces mixed outcomes, with effectiveness varying across malware families and fine-tuning strategies. These findings suggest that LLM-generated malware can enhance scarce datasets without compromising detection accuracy, but remains insufficient as a standalone training source."},{"descriptionType":"Other","description":"24 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02391","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-10-06T01:26:37Z","registered":"2025-10-06T01:26:38Z","published":null,"updated":"2026-01-27T04:35:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03129","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03129","identifiers":[{"identifier":"2510.03129","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yoontae","familyName":"Hwang","name":"Hwang, Yoontae","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefan","familyName":"Zohren","name":"Zohren, Stefan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Signature-Informed Transformer for Asset Allocation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Portfolio Management (q-fin.PM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T15:58:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:48:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-17T11:17:01Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-21T01:26:03Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-01-22T08:38:35Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-01-23T01:28:20Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Modern deep learning for asset allocation typically separates forecasting from optimization. We argue this creates a fundamental mismatch where minimizing prediction errors fails to yield robust portfolios. We propose the Signature Informed Transformer to address this by unifying feature extraction and decision making into a single policy. Our model employs path signatures to encode complex path dependencies and introduces a specialized attention mechanism that targets geometric asset relationships. By directly minimizing the Conditional Value at Risk we ensure the training objective aligns with financial goals. We prove that our attention module rigorously amplifies signature derived signals. Experiments across diverse equity universes show our approach significantly outperforms both traditional strategies and advanced forecasting baselines. The code is available at: https://anonymous.4open.science/r/Signature-Informed-Transformer-For-Asset-Allocation-DB88"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03129","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:44:37Z","registered":"2025-10-06T01:44:38Z","published":null,"updated":"2026-01-23T03:05:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02369","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02369","identifiers":[{"identifier":"2510.02369","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kuntai","familyName":"Cai","name":"Cai, Kuntai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juncheng","familyName":"Liu","name":"Liu, Juncheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xianglin","familyName":"Yang","name":"Yang, Xianglin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaojie","familyName":"Niu","name":"Niu, Zhaojie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaokui","familyName":"Xiao","name":"Xiao, Xiaokui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xing","familyName":"Chen","name":"Chen, Xing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AutoContext: Instance-Level Context Learning for LLM Agents"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-29T05:38:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:01:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-06T09:40:38Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-07T01:23:05Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-01-13T06:31:54Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-01-14T01:23:22Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Current LLM agents typically lack instance-level context, which comprises concrete facts such as environment structure, system configurations, and local mechanics. Consequently, existing methods are forced to intertwine exploration with task execution. This coupling leads to redundant interactions and fragile decision-making, as agents must repeatedly rediscover the same information for every new task. To address this, we introduce AutoContext, a method that decouples exploration from task solving. AutoContext performs a systematic, one-off exploration to construct a reusable knowledge graph for each environment instance. This structured context allows off-the-shelf agents to access necessary facts directly, eliminating redundant exploration. Experiments across TextWorld, ALFWorld, Crafter, and InterCode-Bash demonstrate substantial gains: for example, the success rate of a ReAct agent on TextWorld improves from 37% to 95%, highlighting the critical role of structured instance context in efficient agentic systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02369","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:26:04Z","registered":"2025-10-06T01:26:05Z","published":null,"updated":"2026-01-14T03:09:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02393","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02393","identifiers":[{"identifier":"2510.02393","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jianqing","familyName":"Zhang","name":"Zhang, Jianqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Xia","name":"Xia, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hande","familyName":"Dong","name":"Dong, Hande","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiang","familyName":"Lin","name":"Lin, Qiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Cao","name":"Cao, Jian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AP2O-Coder: Adaptively Progressive Preference Optimization for Reducing Compilation and Runtime Errors in LLM-Generated Code"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T03:17:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:01:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-11T14:25:56Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-14T00:38:26Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-11-23T08:16:39Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-11-25T01:50:03Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-01-08T04:19:34Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-01-09T01:19:47Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"LLMs' code generation capabilities have yielded substantial improvements in the effectiveness of programming tasks. However, LLM-generated code still suffers from compilation and runtime errors. Existing offline preference optimization methods primarily focus on enhancing LLMs' coding abilities using pass/fail signals in the preference data, overlooking the deep-level error types in the failed codes. To address this, we propose Adaptively Progressive Preference Optimization (AP2O) for coding (i.e., AP2O-Coder), a method that guides LLMs adaptively and methodically to reduce code errors for code generation. Specifically, we construct an error notebook from failed codes and progressively optimize the LLM to correct errors type by type. Furthermore, we adaptively replay error types to tailor to the LLM's changing weaknesses throughout the training process. Through extensive experiments on both code and general LLMs (Llama, Qwen, and DeepSeek series) with parameters ranging from 0.5B to 34B, our AP2O-Coder improves code generation performance by up to 3% in pass@k while using less preference data. Code: https://github.com/TsingZ0/AP2O"},{"descriptionType":"Other","description":"Accepted by AAAI2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02393","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:26:40Z","registered":"2025-10-06T01:26:41Z","published":null,"updated":"2026-01-09T03:10:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02717","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02717","identifiers":[{"identifier":"2510.02717","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Waqas","familyName":"Ishtiaq","name":"Ishtiaq, Waqas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ashrafun","familyName":"Zannat","name":"Zannat, Ashrafun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. H. M. Shahariar","familyName":"Parvez","name":"Parvez, A. H. M. Shahariar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Md. Alamgir","familyName":"Hossain","name":"Hossain, Md. Alamgir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muntasir Hasan","familyName":"Kanchan","name":"Kanchan, Muntasir Hasan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muhammad Masud","familyName":"Tarek","name":"Tarek, Muhammad Masud","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CST-AFNet: A dual attention-based deep learning framework for intrusion detection in IoT networks"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T04:36:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-12-18T01:45:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1016/j.array.2025.100501","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The rapid expansion of the Internet of Things (IoT) has revolutionized modern industries by enabling smart automation and real time connectivity. However, this evolution has also introduced complex cybersecurity challenges due to the heterogeneous, resource constrained, and distributed nature of these environments. To address these challenges, this research presents CST AFNet, a novel dual attention based deep learning framework specifically designed for robust intrusion detection in IoT networks. The model integrates multi scale Convolutional Neural Networks (CNNs) for spatial feature extraction, Bidirectional Gated Recurrent Units (BiGRUs) for capturing temporal dependencies, and a dual attention mechanism, channel and temporal attention, to enhance focus on critical patterns in the data. The proposed method was trained and evaluated on the Edge IIoTset dataset, a comprehensive and realistic benchmark containing more than 2.2 million labeled instances spanning 15 attack types and benign traffic, collected from a seven layer industrial testbed. Our proposed model achieves outstanding accuracy for both 15 attack types and benign traffic. CST AFNet achieves 99.97 percent accuracy. Moreover, this model demonstrates exceptional performance with macro averaged precision, recall, and F1 score all above 99.3 percent. Experimental results show that CST AFNet achieves superior detection accuracy, significantly outperforming traditional deep learning models. The findings confirm that CST AFNet is a powerful and scalable solution for real time cyber threat detection in complex IoT and IIoT environments, paving the way for more secure, intelligent, and adaptive cyber physical systems."},{"descriptionType":"Other","description":"9 pages, 9 figures, 5 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02717","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-10-06T01:34:37Z","registered":"2025-10-06T01:34:38Z","published":null,"updated":"2025-12-18T03:06:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02967","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02967","identifiers":[{"identifier":"2510.02967","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Matthew","familyName":"Lewis","name":"Lewis, Matthew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Samuel","familyName":"Thio","name":"Thio, Samuel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amy","familyName":"Roberts","name":"Roberts, Amy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Catherine","familyName":"Siju","name":"Siju, Catherine","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Whoasif","familyName":"Mukit","name":"Mukit, Whoasif","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rebecca","familyName":"Kuruvilla","name":"Kuruvilla, Rebecca","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhangshu Joshua","familyName":"Jiang","name":"Jiang, Zhangshu Joshua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Niko","familyName":"Möller-Grell","name":"Möller-Grell, Niko","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aditya","familyName":"Borakati","name":"Borakati, Aditya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Richard JB","familyName":"Dobson","name":"Dobson, Richard JB","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Spiros","familyName":"Denaxas","name":"Denaxas, Spiros","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Grounding Large Language Models in Clinical Evidence: A Retrieval-Augmented Generation System for Querying UK NICE Clinical Guidelines"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T12:57:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:39:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-12-04T12:52:15Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-05T01:40:29Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-12-14T09:06:04Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-12-16T01:50:35Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper presents the development and evaluation of a Retrieval-Augmented Generation (RAG) system for querying the United Kingdom's National Institute for Health and Care Excellence (NICE) clinical guidelines using Large Language Models (LLMs). The extensive length and volume of these guidelines can impede their utilisation within a time-constrained healthcare system, a challenge this project addresses through the creation of a system capable of providing users with precisely matched information in response to natural language queries. The system's retrieval architecture, composed of a hybrid embedding mechanism, was evaluated against a corpus of 10,195 text chunks derived from three hundred guidelines. It demonstrates high performance, with a Mean Reciprocal Rank (MRR) of 0.814, a Recall of 81% at the first chunk and of 99.1% within the top ten retrieved chunks, when evaluated on 7901 queries. The most significant impact of the RAG system was observed during the generation phase. When evaluated on a manually curated dataset of seventy question-answer pairs, RAG-enhanced models showed substantial gains in performance. Faithfulness, the measure of whether an answer is supported by the source text, was increased by 64.7 percentage points to 99.5% for the RAG-enhanced O4-Mini model and significantly outperformed the medical-focused Meditron3-8B LLM, which scored 43%. Clinical evaluation by seven Subject Matter Experts (SMEs) further validated these findings, with GPT-4.1 achieving 98.7% accuracy while reducing unsafe responses by 67% compared to O4-Mini (from 3.0 to 1.0 per evaluator). This study thus establishes RAG as an effective, reliable, and scalable approach for applying generative AI in healthcare, enabling cost-effective access to medical guidelines."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02967","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:40:41Z","registered":"2025-10-06T01:40:42Z","published":null,"updated":"2025-12-16T04:50:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02350","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02350","identifiers":[{"identifier":"2510.02350","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dzmitry","familyName":"Pihulski","name":"Pihulski, Dzmitry","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Karol","familyName":"Charchut","name":"Charchut, Karol","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Viktoria","familyName":"Novogrodskaia","name":"Novogrodskaia, Viktoria","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jan","familyName":"Kocoń","name":"Kocoń, Jan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LLMSQL: Upgrading WikiSQL for the LLM Era of Text-to-SQL"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-27T15:08:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:00:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-12-09T09:53:54Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-10T01:35:45Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Converting natural language questions into SQL queries enables non-expert users to interact with relational databases and has long been a central task for natural language interfaces to data. While the WikiSQL dataset played a key role in early text-to-SQL research, its usage has declined due to structural and annotation issues, including case sensitivity inconsistencies, data type mismatches, syntax errors, and unanswered questions. We present LLMSQL, a systematic revision and transformation of WikiSQL designed for the large language model era. We classify these errors and implement automated methods for cleaning and re-annotation. To assess the impact of these improvements, we evaluated multiple large language models, including Gemma 3, LLaMA 3.2, Mistral 7B, gpt-oss 20B, Phi-3.5 Mini, Qwen 2.5, OpenAI o4-mini, DeepSeek-R1, and others. Notably, DeepSeek-R1 achieves 88.40% accuracy in a zero-shot setting, and models under 10B parameters surpass 90% accuracy after fine-tuning. Rather than serving as an update, LLMSQL is introduced as an LLM-ready benchmark. Unlike the original WikiSQL, which was tailored for pointer-network models selecting tokens from input, LLMSQL provides clean natural language questions and full SQL queries as plain text, enabling straightforward generation and evaluation for modern natural-language-to-SQL models."},{"descriptionType":"Other","description":"To appear in the Proceedings of the IEEE International Conference on Data Mining Workshops (ICDMW)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02350","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:25:37Z","registered":"2025-10-06T01:25:38Z","published":null,"updated":"2025-12-10T03:16:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02716","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02716","identifiers":[{"identifier":"2510.02716","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Junlin","familyName":"Zeng","name":"Zeng, Junlin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Zhang","name":"Zhang, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Zhao","name":"Zhao, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yan","familyName":"Pan","name":"Pan, Yan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A $1000\\times$ Faster LLM-enhanced Algorithm For Path Planning in Large-scale Grid Maps"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T04:33:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:21:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-12-01T01:28:06Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-02T02:03:22Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Path planning in grid maps, arising from various applications, has garnered significant attention. Existing methods, such as A*, Dijkstra, and their variants, work well for small-scale maps but fail to address large-scale ones due to high search time and memory consumption. Recently, Large Language Models (LLMs) have shown remarkable performance in path planning but still suffer from spatial illusion and poor planning performance. Among all the works, LLM-A* \\cite{meng2024llm} leverages LLM to generate a series of waypoints and then uses A* to plan the paths between the neighboring waypoints. In this way, the complete path is constructed. However, LLM-A* still suffers from high computational time for large-scale maps. To fill this gap, we conducted a deep investigation into LLM-A* and found its bottleneck, resulting in limited performance. Accordingly, we design an innovative LLM-enhanced algorithm, abbr. as iLLM-A*. iLLM-A* includes 3 carefully designed mechanisms, including the optimization of A*, an incremental learning method for LLM to generate high-quality waypoints, and the selection of the appropriate waypoints for A* for path planning. Finally, a comprehensive evaluation on various grid maps shows that, compared with LLM-A*, iLLM-A* \\textbf{1) achieves more than $1000\\times$ speedup on average, and up to $2349.5\\times$ speedup in the extreme case, 2) saves up to $58.6\\%$ of the memory cost, 3) achieves both obviously shorter path length and lower path length standard deviation.}"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02716","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:34:36Z","registered":"2025-10-06T01:34:37Z","published":null,"updated":"2025-12-02T04:47:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02833","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02833","identifiers":[{"identifier":"2510.02833","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhixin","familyName":"Xie","name":"Xie, Zhixin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xurui","familyName":"Song","name":"Song, Xurui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Luo","name":"Luo, Jun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Attack via Overfitting: 10-shot Benign Fine-tuning to Jailbreak LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T09:10:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:30:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-11T03:33:56Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-14T00:19:44Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-19T01:50:09Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-21T00:42:41Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-11-26T06:47:22Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2025-11-27T01:28:44Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Despite substantial efforts in safety alignment, recent research indicates that Large Language Models (LLMs) remain highly susceptible to jailbreak attacks. Among these attacks, finetuning-based ones that compromise LLMs' safety alignment via fine-tuning stand out due to its stable jailbreak performance. In particular, a recent study indicates that fine-tuning with as few as 10 harmful question-answer (QA) pairs can lead to successful jailbreaking across various harmful questions. However, such malicious fine-tuning attacks are readily detectable and hence thwarted by moderation models. In this paper, we demonstrate that LLMs can be jailbroken by fine-tuning with only 10 benign QA pairs; our attack exploits the increased sensitivity of LLMs to fine-tuning data after being overfitted. Specifically, our fine-tuning process starts with overfitting an LLM via fine-tuning with benign QA pairs involving identical refusal answers. Further fine-tuning is then performed with standard benign answers, causing the overfitted LLM to forget the refusal attitude and thus provide compliant answers regardless of the harmfulness of a question. We implement our attack on the ten LLMs and compare it with five existing baselines. Experiments demonstrate that our method achieves significant advantages in both attack effectiveness and attack stealth. Our findings expose previously unreported security vulnerabilities in current LLMs and provide a new perspective on understanding how LLMs' security is compromised, even with benign fine-tuning. Our code is available at https://github.com/ZHIXINXIE/tenBenign."},{"descriptionType":"Other","description":"Published as a conference paper at NeurIPS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02833","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:37:26Z","registered":"2025-10-06T01:37:27Z","published":null,"updated":"2025-11-27T03:16:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02558","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02558","identifiers":[{"identifier":"2510.02558","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nidhi","familyName":"Soley","name":"Soley, Nidhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vishal M","familyName":"Patel","name":"Patel, Vishal M","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Casey O","familyName":"Taylor","name":"Taylor, Casey O","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AttentiveGRUAE: An Attention-Based GRU Autoencoder for Temporal Clustering and Behavioral Characterization of Depression from Wearable Data"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T20:52:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:09:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-13T22:49:38Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-17T01:08:35Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In this study, we present AttentiveGRUAE, a novel attention-based gated recurrent unit (GRU) autoencoder designed for temporal clustering and prediction of outcome from longitudinal wearable data. Our model jointly optimizes three objectives: (1) learning a compact latent representation of daily behavioral features via sequence reconstruction, (2) predicting end-of-period depression rate through a binary classification head, and (3) identifying behavioral subtypes through Gaussian Mixture Model (GMM) based soft clustering of learned embeddings. We evaluate AttentiveGRUAE on longitudinal sleep data from 372 participants (GLOBEM 2018-2019), and it demonstrates superior performance over baseline clustering, domain-aligned self-supervised, and ablated models in both clustering quality (silhouette score = 0.70 vs 0.32-0.70) and depression classification (AUC = 0.74 vs 0.50-0.67). Additionally, external validation on cross-year cohorts from 332 participants (GLOBEM 2020-2021) confirms cluster reproducibility (silhouette score = 0.63, AUC = 0.61) and stability. We further perform subtype analysis and visualize temporal attention, which highlights sleep-related differences between clusters and identifies salient time windows that align with changes in sleep regularity, yielding clinically interpretable explanations of risk."},{"descriptionType":"Other","description":"5 pages, 3 figures, 2 tables, Accepted NeurIPS (TS4H Workshop) 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02558","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:30:46Z","registered":"2025-10-06T01:30:47Z","published":null,"updated":"2025-11-17T03:06:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03156","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03156","identifiers":[{"identifier":"2510.03156","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Iñigo","familyName":"Parra","name":"Parra, Iñigo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Neural Correlates of Language Models Are Specific to Human Language"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T16:28:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:49:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-13T00:27:22Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-14T01:11:58Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Previous work has shown correlations between the hidden states of large language models and fMRI brain responses, on language tasks. These correlations have been taken as evidence of the representational similarity of these models and brain states. This study tests whether these previous results are robust to several possible concerns. Specifically this study shows: (i) that the previous results are still found after dimensionality reduction, and thus are not attributable to the curse of dimensionality; (ii) that previous results are confirmed when using new measures of similarity; (iii) that correlations between brain representations and those from models are specific to models trained on human language; and (iv) that the results are dependent on the presence of positional encoding in the models. These results confirm and strengthen the results of previous research and contribute to the debate on the biological plausibility and interpretability of state-of-the-art large language models."},{"descriptionType":"Other","description":"To be presented at NeurIPS 2025 Workshops"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03156","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:45:16Z","registered":"2025-10-06T01:45:17Z","published":null,"updated":"2025-11-14T03:10:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02671","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02671","identifiers":[{"identifier":"2510.02671","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yavuz","familyName":"Bakman","name":"Bakman, Yavuz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sungmin","familyName":"Kang","name":"Kang, Sungmin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiqi","familyName":"Huang","name":"Huang, Zhiqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Duygu Nur","familyName":"Yaldiz","name":"Yaldiz, Duygu Nur","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Catarina G.","familyName":"Belém","name":"Belém, Catarina G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenyang","familyName":"Zhu","name":"Zhu, Chenyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anoop","familyName":"Kumar","name":"Kumar, Anoop","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alfy","familyName":"Samuel","name":"Samuel, Alfy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Salman","familyName":"Avestimehr","name":"Avestimehr, Salman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daben","familyName":"Liu","name":"Liu, Daben","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sai Praneeth","familyName":"Karimireddy","name":"Karimireddy, Sai Praneeth","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Uncertainty as Feature Gaps: Epistemic Uncertainty Quantification of LLMs in Contextual Question-Answering"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T02:09:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:16:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-23T21:43:24Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-27T00:09:31Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Uncertainty Quantification (UQ) research has primarily focused on closed-book factual question answering (QA), while contextual QA remains unexplored, despite its importance in real-world applications. In this work, we focus on UQ for the contextual QA task and propose a theoretically grounded approach to quantify epistemic uncertainty. We begin by introducing a task-agnostic, token-level uncertainty measure defined as the cross-entropy between the predictive distribution of the given model and the unknown true distribution. By decomposing this measure, we isolate the epistemic component and approximate the true distribution by a perfectly prompted, idealized model. We then derive an upper bound for epistemic uncertainty and show that it can be interpreted as semantic feature gaps in the given model's hidden representations relative to the ideal model. We further apply this generic framework to the contextual QA task and hypothesize that three features approximate this gap: context-reliance (using the provided context rather than parametric knowledge), context comprehension (extracting relevant information from context), and honesty (avoiding intentional lies). Using a top-down interpretability approach, we extract these features by using only a small number of labeled samples and ensemble them to form a robust uncertainty score. Experiments on multiple QA benchmarks in both in-distribution and out-of-distribution settings show that our method substantially outperforms state-of-the-art unsupervised (sampling-free and sampling-based) and supervised UQ methods, achieving up to a 13-point PRR improvement while incurring a negligible inference overhead."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02671","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:33:29Z","registered":"2025-10-06T01:33:30Z","published":null,"updated":"2025-10-27T02:12:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02569","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02569","identifiers":[{"identifier":"2510.02569","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tolúlopé","familyName":"Ògúnrèmí","name":"Ògúnrèmí, Tolúlopé","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christopher D.","familyName":"Manning","name":"Manning, Christopher D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dan","familyName":"Jurafsky","name":"Jurafsky, Dan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Karen","familyName":"Livescu","name":"Livescu, Karen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Transcribe, Translate, or Transliterate: An Investigation of Intermediate Representations in Spoken Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T21:19:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:10:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-16T20:31:59Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-20T00:07:20Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Spoken language models (SLMs) that integrate speech with large language models (LMs) rely on modality adapters (MAs) to map the output of speech encoders to a representation that is understandable to the decoder LM. Yet we know very little about how these crucial MAs transform representations. Here we examine the MA output representation in three SLMs (SALMONN, Qwen2-Audio and Phi-4-Multimodal-Instruct). By finding the nearest decoder LM token to an MA representation, we uncover two strategies for MA representations. For models using a Whisper encoder, MAs appear to represent the meaning of the input using an English-based interlingua, allowing them to handle languages unseen in instruction tuning. For models that don't, like Phi-4-Multimodal-Instruct, MAs instead represent the phonetics of the input, but expressed with English words. We hypothesise that which arises depends on whether the speech encoder is trained only for speech recognition or also for translation."},{"descriptionType":"Other","description":"ASRU 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02569","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:31:03Z","registered":"2025-10-06T01:31:04Z","published":null,"updated":"2025-10-20T02:02:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02340","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02340","identifiers":[{"identifier":"2510.02340","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xin","familyName":"Gao","name":"Gao, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruiyi","familyName":"Zhang","name":"Zhang, Ruiyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Du","name":"Du, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saurabh","familyName":"Mahindre","name":"Mahindre, Saurabh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sai Ashish","familyName":"Somayajula","name":"Somayajula, Sai Ashish","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengtao","familyName":"Xie","name":"Xie, Pengtao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Can Prompts Rewind Time for LLMs? Evaluating the Effectiveness of Prompted Knowledge Cutoffs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-26T20:37:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:00:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-15T00:27:58Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-16T00:14:51Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) are widely used for temporal prediction, but their reliance on pretraining data raises contamination concerns, as accurate predictions on pre-cutoff test data may reflect memorization rather than reasoning, leading to an overestimation of their generalization capability. With the recent emergence of prompting-based unlearning techniques, a natural question arises: Can LLMs be prompted to simulate an earlier knowledge cutoff? In this work, we investigate the capability of prompting to simulate earlier knowledge cutoff in LLMs. We construct three evaluation datasets to assess the extent to which LLMs can forget (1) direct factual knowledge, (2) semantic shifts, and (3) causally related knowledge. Results demonstrate that while prompt-based simulated knowledge cutoffs show effectiveness when directly queried with the information after that date, they struggle to induce forgetting when the forgotten content is not directly asked but causally related to the query. These findings highlight the need for more rigorous evaluation settings when applying LLMs for temporal prediction tasks. The full dataset and evaluation code are available at https://github.com/gxx27/time_unlearn."},{"descriptionType":"Other","description":"Published at EMNLP 2025; Code and data available at https://github.com/gxx27/time_unlearn"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02340","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:25:23Z","registered":"2025-10-06T01:25:23Z","published":null,"updated":"2025-10-16T02:26:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02387","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02387","identifiers":[{"identifier":"2510.02387","identifierType":"arXiv"}],"creators":[{"nameType":"Organizational","affiliation":[],"name":"FAIR CodeGen team","nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jade","familyName":"Copet","name":"Copet, Jade","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Quentin","familyName":"Carbonneaux","name":"Carbonneaux, Quentin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gal","familyName":"Cohen","name":"Cohen, Gal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jonas","familyName":"Gehring","name":"Gehring, Jonas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jacob","familyName":"Kahn","name":"Kahn, Jacob","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jannik","familyName":"Kossen","name":"Kossen, Jannik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Felix","familyName":"Kreuk","name":"Kreuk, Felix","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emily","familyName":"McMilin","name":"McMilin, Emily","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michel","familyName":"Meyer","name":"Meyer, Michel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuxiang","familyName":"Wei","name":"Wei, Yuxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Zhang","name":"Zhang, David",