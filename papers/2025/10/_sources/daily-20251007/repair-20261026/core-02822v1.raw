            <span id="alg1.l13.3" class="ltx_text" style="font-size:90%;"> </span><math id="alg1.l13.m1" class="ltx_Math" alttext="C_{best}\leftarrow\text{Top-1}(scores)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">C</mi><mrow><mi mathsize="0.900em">b</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi></mrow></msub><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mtext mathsize="0.900em">Top-1</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">s</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C_{best}\leftarrow\text{Top-1}(scores)</annotation></semantics></math><span id="alg1.l13.4" class="ltx_text" style="font-size:90%;">
