<td id="S8.T2.4.13.9" class="ltx_td ltx_align_center ltx_border_bb" style="padding:-0.9pt 3.0pt;"><span id="S8.T2.4.13.9.1" class="ltx_text" style="font-size:90%;">69.29</span></td>
