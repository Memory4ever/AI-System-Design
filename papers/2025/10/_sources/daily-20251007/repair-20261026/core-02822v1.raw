<th id="S8.T6.4.2.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:-0.9pt 1.0pt;"><span id="S8.T6.4.2.3.1" class="ltx_text ltx_font_italic" style="font-size:90%;">Gred.</span></th>
<th id="S8.T6.4.2.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t" style="padding:-0.9pt 1.0pt;"><span id="S8.T6.4.2.4.1" class="ltx_text ltx_font_italic" style="font-size:90%;">Rand.</span></th>
<th id="S8.T6.4.2.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:-0.9pt 1.0pt;"><span id="S8.T6.4.2.5.1" class="ltx_text ltx_font_italic" style="font-size:90%;">Evol.</span></th>
<th id="S8.T6.4.2.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:-0.9pt 1.0pt;"><span id="S8.T6.4.2.6.1" class="ltx_text ltx_font_italic" style="font-size:90%;">Gred.</span></th>
