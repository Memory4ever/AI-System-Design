</div>
<div id="alg1.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
              
              
            <span id="alg1.l7.3" class="ltx_text" style="font-size:90%;">   </span><math id="alg1.l7.m1" class="ltx_Math" alttext="offsprings\leftarrow\text{Crossover}(parents,N-k)" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.900em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">f</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">f</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">g</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">s</mi></mrow><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mtext mathsize="0.900em">Crossover</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">s</mi></mrow><mo mathsize="0.900em">,</mo><mrow><mi mathsize="0.900em">N</mi><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">k</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">offsprings\leftarrow\text{Crossover}(parents,N-k)</annotation></semantics></math><span id="alg1.l7.4" class="ltx_text" style="font-size:90%;">
