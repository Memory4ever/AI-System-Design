<th id="S8.T6.4.2.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_r" style="padding:-0.9pt 1.0pt;"><span id="S8.T6.4.2.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">layer#</span></th>
