<td id="S3.T1.2.5.5" class="ltx_td ltx_align_center ltx_border_t">56.21</td>
<td id="S3.T1.2.5.6" class="ltx_td ltx_align_center ltx_border_t">49.43</td></tr>
<tr id="S3.T1.2.6" class="ltx_tr">
<td id="S3.T1.2.6.1" class="ltx_td ltx_align_center ltx_border_bb">HyperAdaLoRA (ours)</td>
<td id="S3.T1.2.6.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T1.2.6.2.1" class="ltx_text ltx_font_bold">6.79</span></td>
<td id="S3.T1.2.6.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T1.2.6.3.1" class="ltx_text ltx_font_bold">20.19</span></td>
<td id="S3.T1.2.6.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T1.2.6.4.1" class="ltx_text ltx_font_bold">56.22</span></td>
<td id="S3.T1.2.6.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T1.2.6.5.1" class="ltx_text ltx_font_bold">49.43</span></td></tr>
</tbody>
</table>
