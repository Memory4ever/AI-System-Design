<td id="S4.T7.2.5.5" class="ltx_td ltx_align_center">134.54</td></tr>
<tr id="S4.T7.2.6" class="ltx_tr">
<td id="S4.T7.2.6.1" class="ltx_td ltx_align_center">8</td>
<td id="S4.T7.2.6.2" class="ltx_td ltx_align_center">4115</td>
<td id="S4.T7.2.6.3" class="ltx_td ltx_align_center">189.39</td>
<td id="S4.T7.2.6.4" class="ltx_td ltx_align_center">4078</td>
<td id="S4.T7.2.6.5" class="ltx_td ltx_align_center">178.51</td></tr>
<tr id="S4.T7.2.7" class="ltx_tr">
<td id="S4.T7.2.7.1" class="ltx_td ltx_align_center">16</td>
<td id="S4.T7.2.7.2" class="ltx_td ltx_align_center">5906</td>
<td id="S4.T7.2.7.3" class="ltx_td ltx_align_center">284.33</td>
<td id="S4.T7.2.7.4" class="ltx_td ltx_align_center">5870</td>
<td id="S4.T7.2.7.5" class="ltx_td ltx_align_center">272.72</td></tr>
<tr id="S4.T7.2.8" class="ltx_tr">
<td id="S4.T7.2.8.1" class="ltx_td ltx_align_center">32</td>
<td id="S4.T7.2.8.2" class="ltx_td ltx_align_center">9600</td>
<td id="S4.T7.2.8.3" class="ltx_td ltx_align_center">486.16</td>
<td id="S4.T7.2.8.4" class="ltx_td ltx_align_center">9564</td>
<td id="S4.T7.2.8.5" class="ltx_td ltx_align_center">465.77</td></tr>
<tr id="S4.T7.2.9" class="ltx_tr">
<td id="S4.T7.2.9.1" class="ltx_td ltx_align_center ltx_border_bb">64</td>
<td id="S4.T7.2.9.2" class="ltx_td ltx_align_center ltx_border_bb">16566</td>
<td id="S4.T7.2.9.3" class="ltx_td ltx_align_center ltx_border_bb">882.55</td>
<td id="S4.T7.2.9.4" class="ltx_td ltx_align_center ltx_border_bb">16530</td>
