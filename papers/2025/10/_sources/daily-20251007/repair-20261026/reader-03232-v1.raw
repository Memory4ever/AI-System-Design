<td id="Sx4.T1.1.1.5.5" class="ltx_td ltx_align_center">51.3</td>
<td id="Sx4.T1.1.1.5.6" class="ltx_td ltx_align_center">63.1</td></tr>
<tr id="Sx4.T1.1.1.6" class="ltx_tr">
<th id="Sx4.T1.1.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="Sx4.T1.1.1.6.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">LEAML</span> (Ours)</th>
<td id="Sx4.T1.1.1.6.2" class="ltx_td ltx_align_center">95.8</td>
<td id="Sx4.T1.1.1.6.3" class="ltx_td ltx_align_center">83.9</td>
