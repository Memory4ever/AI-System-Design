<td id="Sx4.T1.1.1.2.4" class="ltx_td ltx_align_center ltx_border_t">Polyps</td></tr>
<tr id="Sx4.T1.1.1.3" class="ltx_tr">
<th id="Sx4.T1.1.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Zero-Shot</th>
<td id="Sx4.T1.1.1.3.2" class="ltx_td ltx_align_center ltx_border_t">35.4</td>
<td id="Sx4.T1.1.1.3.3" class="ltx_td ltx_align_center ltx_border_t">21.1</td>
<td id="Sx4.T1.1.1.3.4" class="ltx_td ltx_align_center ltx_border_t">49.0</td>
<td id="Sx4.T1.1.1.3.5" class="ltx_td ltx_align_center ltx_border_t">47.8</td>
<td id="Sx4.T1.1.1.3.6" class="ltx_td ltx_align_center ltx_border_t">38.3</td></tr>
<tr id="Sx4.T1.1.1.4" class="ltx_tr">
<th id="Sx4.T1.1.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">LoRA</th>
<td id="Sx4.T1.1.1.4.2" class="ltx_td ltx_align_center">95.6</td>
<td id="Sx4.T1.1.1.4.3" class="ltx_td ltx_align_center">57.7</td>
<td id="Sx4.T1.1.1.4.4" class="ltx_td ltx_align_center">48.9</td>
<td id="Sx4.T1.1.1.4.5" class="ltx_td ltx_align_center">47.3</td>
<td id="Sx4.T1.1.1.4.6" class="ltx_td ltx_align_center">62.4</td></tr>
<tr id="Sx4.T1.1.1.5" class="ltx_tr">
<th id="Sx4.T1.1.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Full-Tuning</th>
<td id="Sx4.T1.1.1.5.2" class="ltx_td ltx_align_center">89.0</td>
