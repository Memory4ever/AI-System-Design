<td id="Sx4.T1.1.1.6.5" class="ltx_td ltx_align_center">65.5</td>
<td id="Sx4.T1.1.1.6.6" class="ltx_td ltx_align_center">76.7</td></tr>
<tr id="Sx4.T1.1.1.7" class="ltx_tr">
<th id="Sx4.T1.1.1.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Zero-Shot (Qwen2.5-VL-72B)</th>
<td id="Sx4.T1.1.1.7.2" class="ltx_td ltx_align_center ltx_border_t">59.7</td>
<td id="Sx4.T1.1.1.7.3" class="ltx_td ltx_align_center ltx_border_t">48.6</td>
<td id="Sx4.T1.1.1.7.4" class="ltx_td ltx_align_center ltx_border_t">53.1</td>
<td id="Sx4.T1.1.1.7.5" class="ltx_td ltx_align_center ltx_border_t">55.9</td>
<td id="Sx4.T1.1.1.7.6" class="ltx_td ltx_align_center ltx_border_t">54.3</td></tr>
<tr id="Sx4.T1.1.1.8" class="ltx_tr">
