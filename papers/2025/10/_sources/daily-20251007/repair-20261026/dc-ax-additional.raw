{"data":[{"id":"10.48550/arxiv.2510.03075","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03075","identifiers":[{"identifier":"2510.03075","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Karim","familyName":"Farid","name":"Farid, Karim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rajat","familyName":"Sahay","name":"Sahay, Rajat","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yumna Ali","familyName":"Alnaggar","name":"Alnaggar, Yumna Ali","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simon","familyName":"Schrodi","name":"Schrodi, Simon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Volker","familyName":"Fischer","name":"Fischer, Volker","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cordelia","familyName":"Schmid","name":"Schmid, Cordelia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thomas","familyName":"Brox","name":"Brox, Thomas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"What Drives Compositional Generalization in Visual Generative Models? The Importance of Continuous Training Objectives"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T15:02:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:44:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-06T10:01:02Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-07T01:24:30Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-27T13:02:22Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-28T01:43:32Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-10-01T13:03:36Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-10-02T01:12:00Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Compositional generalization, the ability to generate novel combinations of known concepts, is a key ingredient for visual generative models. Yet, not all mechanisms that enable or inhibit it are fully understood. In this work, we conduct a systematic study of which design choices critically determine compositional generalization in image and video generation. By isolating independent design axes, we identify two key factors strongly associated with compositional success: (i) whether the training objective operates on a discrete or continuous distribution, and (ii) the completeness of conditioning information about constituent factors during training. We also show that relaxing the discrete loss with an auxiliary continuous latent objective can partially recover compositional performance in discrete models like MaskGIT. Our findings, corroborated by diverse compositional tasks and preliminary evidence in world models and LLMs, motivate a shift toward continuous objectives for compositional generalization."},{"descriptionType":"Other","description":"Accepted at NeurIPS 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03075","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:43:19Z","registered":"2025-10-06T01:43:20Z","published":null,"updated":"2026-10-02T03:28:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03204","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03204","identifiers":[{"identifier":"2510.03204","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Imene","familyName":"Kerboua","name":"Kerboua, Imene","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sahar Omidi","familyName":"Shayegan","name":"Shayegan, Sahar Omidi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Megh","familyName":"Thakkar","name":"Thakkar, Megh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xing Han","familyName":"Lù","name":"Lù, Xing Han","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Léo","familyName":"Boisvert","name":"Boisvert, Léo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Massimo","familyName":"Caccia","name":"Caccia, Massimo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jérémy","familyName":"Espinas","name":"Espinas, Jérémy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexandre","familyName":"Aussem","name":"Aussem, Alexandre","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Véronique","familyName":"Eglin","name":"Eglin, Véronique","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexandre","familyName":"Lacoste","name":"Lacoste, Alexandre","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FocusAgent: Simple Yet Effective Ways of Trimming the Large Context of Web Agents"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T17:41:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:52:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-29T16:53:22Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-09-01T00:42:09Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Web agents powered by large language models (LLMs) must process lengthy web page observations to complete user goals; these pages often exceed tens of thousands of tokens. This saturates context limits and increases computational cost processing; moreover, processing full pages exposes agents to security risks such as prompt injection. Existing pruning strategies either discard relevant content or retain irrelevant context, leading to suboptimal action prediction. We introduce FocusAgent, a simple yet effective approach that leverages a lightweight LLM retriever to extract the most relevant lines from accessibility tree (AxTree) observations, guided by task goals. By pruning noisy and irrelevant content, FocusAgent enables efficient reasoning while reducing vulnerability to injection attacks. Experiments on WorkArena and WebArena benchmarks show that FocusAgent matches the performance of strong baselines, while reducing observation size by over 50%. Furthermore, a variant of FocusAgent significantly reduces the success rate of prompt-injection attacks, including banner and pop-up attacks, while maintaining task success performance in attack-free settings. Our results highlight that targeted LLM-based retrieval is a practical and robust strategy for building web agents that are efficient, effective, and secure."},{"descriptionType":"Other","description":"TMLR 08/2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03204","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:46:28Z","registered":"2025-10-06T01:46:29Z","published":null,"updated":"2026-09-01T05:01:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06242","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06242","identifiers":[{"identifier":"2510.06242","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Subin","familyName":"An","name":"An, Subin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yugyeong","familyName":"Ji","name":"Ji, Yugyeong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junyoung","familyName":"Kim","name":"Kim, Junyoung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heejin","familyName":"Kook","name":"Kook, Heejin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Lu","name":"Lu, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Josh","familyName":"Seltzer","name":"Seltzer, Josh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Transparent Reference-free Automated Evaluation of Open-Ended User Survey Responses"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T08:37:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-11T00:05:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.18653/v1/2025.emnlp-industry.65","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Open-ended survey responses provide valuable insights in marketing research, but low-quality responses not only burden researchers with manual filtering but also risk leading to misleading conclusions, underscoring the need for effective evaluation. Existing automatic evaluation methods target LLM-generated text and inadequately assess human-written responses with their distinct characteristics. To address such characteristics, we propose a two-stage evaluation framework specifically designed for human survey responses. First, gibberish filtering removes nonsensical responses. Then, three dimensions-effort, relevance, and completeness-are evaluated using LLM capabilities, grounded in empirical analysis of real-world survey data. Validation on English and Korean datasets shows that our framework not only outperforms existing metrics but also demonstrates high practical applicability for real-world applications such as response quality prediction and response rejection, showing strong correlations with expert assessment."},{"descriptionType":"Other","description":"EMNLP Industry Track"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06242","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-10-09T01:41:43Z","registered":"2025-10-09T01:41:44Z","published":null,"updated":"2026-06-11T02:25:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02528","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02528","identifiers":[{"identifier":"2510.02528","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shuhao","familyName":"Fu","name":"Fu, Shuhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Esther","familyName":"Goldberg","name":"Goldberg, Esther","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ying Nian","familyName":"Wu","name":"Wu, Ying Nian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongjing","familyName":"Lu","name":"Lu, Hongjing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multimodal Function Vectors for Visual Relations"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T19:55:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:07:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-29T19:41:43Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-02T00:11:50Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Multimodal Models (LMMs) demonstrate impressive in-context learning abilities from few multimodal demonstrations, yet the internal mechanisms supporting such task learning remain opaque. Building on prior work of Large Language Models, we show that a small subset of attention heads in Large Multimodal Models is responsible for transmitting representations of visual relations. The activations of these attention heads, termed function vectors, can be extracted and manipulated to alter an LMM's performance on relational tasks. First, using synthetic and real image datasets, we apply causal mediation analysis to identify attention heads that strongly influence relational predictions, and extract multimodal function vectors that improve zero-shot accuracy at inference time. We further demonstrate that these multimodal function vectors can be fine-tuned with a modest amount of training data, while keeping LMM parameters frozen, to significantly outperform in-context learning baselines. Finally, we show that relation-specific function vectors can be linearly combined to solve analogy problems involving novel and untrained visual relations, highlighting the strong generalization ability of this approach. Through experiments on two LMMs, including OpenFlamingo and Qwen3-VL, our results show that these models encode visual relational knowledge within localized internal structures, which can be systematically extracted and optimized, thereby advancing our understanding of model modularity and enhancing control over relational reasoning in LMMs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02528","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:30:01Z","registered":"2025-10-06T01:30:02Z","published":null,"updated":"2026-06-02T04:53:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02837","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02837","identifiers":[{"identifier":"2510.02837","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wonjoong","familyName":"Kim","name":"Kim, Wonjoong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sangwu","familyName":"Park","name":"Park, Sangwu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yeonjun","familyName":"In","name":"In, Yeonjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sein","familyName":"Kim","name":"Kim, Sein","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongha","familyName":"Lee","name":"Lee, Dongha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chanyoung","familyName":"Park","name":"Park, Chanyoung","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Beyond the Final Answer: Evaluating the Reasoning Trajectories of Tool-Augmented Agents"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T09:19:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:30:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-14T09:14:36Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-15T00:43:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-25T02:56:44Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-26T01:22:19Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Although recent tool-augmented benchmarks involve complex requests, evaluation remains limited to answer matching, neglecting critical trajectory aspects like efficiency, hallucination, and adaptivity. The most straightforward method for evaluation is to compare an agent's trajectory with the ground-truth, but annotating all valid ground-truth trajectories is prohibitively expensive. In this manner, we introduce TRACE, a reference-free framework for the multi-dimensional evaluation of tool-augmented LLMs. By incorporating an evidence bank which accumulates knowledge from preceding steps, TRACE assesses an agent's reasoning trajectory effectively. To validate our framework, we develop a new meta-evaluation dataset with diverse and flawed trajectories, each labeled with multi-faceted performance scores. Our results confirm that TRACE accurately evaluates complex trajectories even with small open-source LLMs. Furthermore, we apply our method to evaluate the trajectories that agents produce while solving tool-augmented tasks, presenting previously unreported observations and their corresponding insights."},{"descriptionType":"Other","description":"International Conference on Machine Learning (ICML) 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02837","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:37:32Z","registered":"2025-10-06T01:37:33Z","published":null,"updated":"2026-05-26T04:04:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02952","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02952","identifiers":[{"identifier":"2510.02952","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Santanu Subhash","familyName":"Rathod","name":"Rathod, Santanu Subhash","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francesco","familyName":"Ceccarelli","name":"Ceccarelli, Francesco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sean B.","familyName":"Holden","name":"Holden, Sean B.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pietro","familyName":"Liò","name":"Liò, Pietro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiao","familyName":"Zhang","name":"Zhang, Xiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jovan","familyName":"Tanevski","name":"Tanevski, Jovan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ContextFlow: Context-Aware Flow Matching For Trajectory Inference From Spatial Omics Data"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T12:46:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:38:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-30T15:03:43Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-02T01:57:21Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-14T10:29:31Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-15T00:48:33Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Inferring trajectories from longitudinal spatially-resolved omics data is fundamental to understanding the dynamics of structural and functional tissue changes in development, regeneration and repair, disease progression, and response to treatment. We propose ContextFlow, a novel context-aware flow matching framework that incorporates prior knowledge to guide the inference of structural tissue dynamics from spatially resolved omics data. Specifically, ContextFlow integrates local tissue organization and ligand-receptor communication patterns into a transition plausibility matrix that regularizes the optimal transport objective. By embedding these contextual constraints, ContextFlow generates trajectories that are not only statistically consistent but also biologically meaningful, making it a generalizable framework for modeling spatiotemporal dynamics from longitudinal, spatially resolved omics data. Evaluated on three datasets, ContextFlow consistently outperforms state-of-the-art flow matching methods across multiple quantitative and qualitative metrics of inference accuracy and biological coherence. Our code is available at: \\href{https://github.com/santanurathod/ContextFlow}{ContextFlow}"},{"descriptionType":"Other","description":"42 pages, 21 figures, 30 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02952","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:40:18Z","registered":"2025-10-06T01:40:19Z","published":null,"updated":"2026-05-15T02:35:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02738","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02738","identifiers":[{"identifier":"2510.02738","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tianyu","familyName":"Li","name":"Li, Tianyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yihan","familyName":"Li","name":"Li, Yihan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zizhe","familyName":"Zhang","name":"Zhang, Zizhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nadia","familyName":"Figueroa","name":"Figueroa, Nadia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Flow with the Force Field: Learning 3D Compliant Flow Matching Policies from Force and Demonstration-Guided Simulation Data"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T05:40:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:22:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-22T05:46:01Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-23T00:24:14Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-16T01:39:26Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-17T00:18:54Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"While visuomotor policy has made advancements in recent years, contact-rich tasks still remain a challenge. Robotic manipulation tasks that require continuous contact demand explicit handling of compliance and force. However, most visuomotor policies ignore compliance, overlooking the importance of physical interaction with the real world, often leading to excessive contact forces or fragile behavior under uncertainty. Introducing force information into vision-based imitation learning could help improve awareness of contacts, but could also require a lot of data to perform well. One remedy for data scarcity is to generate data in simulation, yet computationally taxing processes are required to generate data good enough not to suffer from the Sim2Real gap. In this work, we introduce a framework for generating force-informed data in simulation, instantiated by a single human demonstration, and show how coupling with a compliant policy improves the performance of a visuomotor policy learned from synthetic data. We validate our approach on real-robot tasks, including non-prehensile block flipping and a bi-manual object moving, where the learned policy exhibits reliable contact maintenance and adaptation to novel conditions. Project Website: https://flow-with-the-force-field.github.io/webpage/"},{"descriptionType":"Other","description":"Accepted to ICRA 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02738","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:35:08Z","registered":"2025-10-06T01:35:08Z","published":null,"updated":"2026-04-17T02:18:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02789","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02789","identifiers":[{"identifier":"2510.02789","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ara","familyName":"Seo","name":"Seo, Ara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bryan Sangwoo","familyName":"Kim","name":"Kim, Bryan Sangwoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hyungjin","familyName":"Chung","name":"Chung, Hyungjin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jong Chul","familyName":"Ye","name":"Ye, Jong Chul","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Align Your Query: Representation Alignment for Multimodality Medical Object Detection"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T07:49:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:26:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-31T05:55:12Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-01T00:29:49Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Medical object detection suffers when a single detector is trained on mixed medical modalities (e.g., CXR, CT, MRI) due to heterogeneous statistics and disjoint representation spaces. To address this challenge, we turn to representation alignment, an approach that has proven effective for bringing features from different sources into a shared space. Specifically, we target the representations of DETR-style object queries and propose a simple, detector-agnostic framework to align them with modality context. First, we define modality tokens: compact, text-derived embeddings encoding imaging modality that are lightweight and require no extra annotations. We integrate the modality tokens into the detection process via Multimodality Context Attention (MoCA), mixing object-query representations via self-attention to propagate modality context within the query set. This preserves DETR-style architectures and adds negligible latency while injecting modality cues into object queries. We further introduce QueryREPA, a short pretraining stage that aligns query representations to their modality tokens using a task-specific contrastive objective with modality-balanced batches. Together, MoCA and QueryREPA produce modality-aware, class-faithful queries that transfer effectively to downstream training. Across diverse modalities trained altogether, the proposed approach consistently improves AP with minimal overhead and no architectural modifications, offering a practical path toward robust multimodality medical object detection."},{"descriptionType":"Other","description":"Project page: https://araseo.github.io/alignyourquery/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02789","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:36:21Z","registered":"2025-10-06T01:36:22Z","published":null,"updated":"2026-04-01T02:31:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02835","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02835","identifiers":[{"identifier":"2510.02835","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dohyun","familyName":"Bu","name":"Bu, Dohyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jisoo","familyName":"Han","name":"Han, Jisoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Soohwa","familyName":"Kwon","name":"Kwon, Soohwa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yulim","familyName":"So","name":"So, Yulim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jong-Seok","familyName":"Lee","name":"Lee, Jong-Seok","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Subject-Adaptive Sparse Linear Models for Interpretable Personalized Health Prediction from Multimodal Lifelog Data"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T09:17:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-03-23T00:48:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/ictc66702.2025.11389118","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Improved prediction of personalized health outcomes -- such as sleep quality and stress -- from multimodal lifelog data could have meaningful clinical and practical implications. However, state-of-the-art models, primarily deep neural networks and gradient-boosted ensembles, sacrifice interpretability and fail to adequately address the significant inter-individual variability inherent in lifelog data. To overcome these challenges, we propose the Subject-Adaptive Sparse Linear (SASL) framework, an interpretable modeling approach explicitly designed for personalized health prediction. SASL integrates ordinary least squares regression with subject-specific interactions, systematically distinguishing global from individual-level effects. We employ an iterative backward feature elimination method based on nested $F$-tests to construct a sparse and statistically robust model. Additionally, recognizing that health outcomes often represent discretized versions of continuous processes, we develop a regression-then-thresholding approach specifically designed to maximize macro-averaged F1 scores for ordinal targets. For intrinsically challenging predictions, SASL selectively incorporates outputs from compact LightGBM models through confidence-based gating, enhancing accuracy without compromising interpretability. Evaluations conducted on the CH-2025 dataset -- which comprises roughly 450 daily observations from ten subjects -- demonstrate that the hybrid SASL-LightGBM framework achieves predictive performance comparable to that of sophisticated black-box methods, but with significantly fewer parameters and substantially greater transparency, thus providing clear and actionable insights for clinicians and practitioners."},{"descriptionType":"Other","description":"6 pages, ICTC 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02835","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-10-06T01:37:29Z","registered":"2025-10-06T01:37:30Z","published":null,"updated":"2026-03-23T02:13:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03182","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03182","identifiers":[{"identifier":"2510.03182","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yilun","familyName":"Hao","name":"Hao, Yilun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongchao","familyName":"Chen","name":"Chen, Yongchao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chuchu","familyName":"Fan","name":"Fan, Chuchu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Zhang","name":"Zhang, Yang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Simulation to Rules: A Dual-VLM Framework for Formal Visual Planning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Symbolic Computation (cs.SC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T16:57:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:50:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-18T15:10:40Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-20T00:05:45Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision Language Models (VLMs) show strong potential for visual planning but struggle with precise spatial and long-horizon reasoning, while Planning Domain Definition Language (PDDL) planners excel at formal long-horizon planning but cannot interpret visual inputs. Recent works combine these complementary advantages by translating visual problems into PDDL. However, while VLMs can generate PDDL problem files satisfactorily, accurately generating PDDL domain files, which encode planning rules, remains challenging and typically requires human expertise or environment interaction. We propose VLMFP, a Dual-VLM-guided framework that autonomously generates both PDDL problem and domain files for formal visual planning. VLMFP combines a SimVLM that simulates action consequences with a GenVLM that generates and iteratively refines PDDL files by aligning symbolic execution with simulated outcomes, enabling multiple levels of generalization across unseen instances, visual appearances, and game rules. We evaluate VLMFP on 6 grid-world domains and demonstrate its generalization capability. On average, SimVLM achieves 87.3% and 86.0% scenario understanding and action simulation for seen and unseen appearances, respectively. With the guidance of SimVLM, VLMFP attains 70.0%, 54.1% planning success on unseen instances in seen and unseen appearances, respectively. We further demonstrate that VLMFP scales to complex long-horizon 3D planning tasks, including multi-robot collaboration and assembly scenarios with partial observability and diverse visual variations. Project page: https://sites.google.com/view/vlmfp."},{"descriptionType":"Other","description":"40 pages, 6 figures, 13 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03182","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:45:56Z","registered":"2025-10-06T01:45:56Z","published":null,"updated":"2026-03-20T02:38:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03366","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03366","identifiers":[{"identifier":"2510.03366","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Harshwardhan","familyName":"Fartale","name":"Fartale, Harshwardhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ashish","familyName":"Kattamuri","name":"Kattamuri, Ashish","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rahul","familyName":"Raja","name":"Raja, Rahul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arpita","familyName":"Vats","name":"Vats, Arpita","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ishita","familyName":"Prasad","name":"Prasad, Ishita","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Akshata Kishore","familyName":"Moharir","name":"Moharir, Akshata Kishore","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Disentangling Recall and Reasoning in Transformer Models through Layer-wise Attention and Activation Analysis"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T04:13:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:03:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-13T08:24:44Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-16T00:33:20Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Transformer-based language models excel at both recall (retrieving memorized facts) and reasoning (performing multi-step inference), but whether these abilities rely on distinct internal mechanisms remains unclear. Distinguishing recall from reasoning is crucial for predicting model generalization, designing targeted evaluations, and building safer interventions that affect one ability without disrupting the other.We approach this question through mechanistic interpretability, using controlled datasets of synthetic linguistic puzzles to probe transformer models at the layer, head, and neuron level. Our pipeline combines activation patching and structured ablations to causally measure component contributions to each task type. Across two model families (Qwen and LLaMA), we find that interventions on distinct layers and attention heads lead to selective impairments: disabling identified \"recall circuits\" reduces fact-retrieval accuracy by up to 15\\% while leaving reasoning intact, whereas disabling \"reasoning circuits\" reduces multi-step inference by a comparable margin. At the neuron level, we observe task-specific firing patterns, though these effects are less robust, consistent with neuronal polysemanticity.Our results provide the first causal evidence that recall and reasoning rely on separable but interacting circuits in transformer models. These findings advance mechanistic interpretability by linking circuit-level structure to functional specialization and demonstrate how controlled datasets and causal interventions can yield mechanistic insights into model cognition, informing safer deployment of large language models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03366","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T02:48:10Z","registered":"2025-10-07T02:48:10Z","published":null,"updated":"2026-03-16T02:07:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02567","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02567","identifiers":[{"identifier":"2510.02567","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Peter","familyName":"Pak","name":"Pak, Peter","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Achuth","familyName":"Chandrasekhar","name":"Chandrasekhar, Achuth","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amir Barati","familyName":"Farimani","name":"Farimani, Amir Barati","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Agentic Additive Manufacturing Alloy Evaluation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T21:06:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:10:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-06T15:33:47Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-07T01:41:02Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-01-06T15:11:53Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-01-27T01:41:36Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1016/j.addlet.2026.100355","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Agentic systems enable the intelligent use of research tooling, augmenting a researcher's ability to investigate and propose novel solutions to existing problems. Within Additive Manufacturing (AM), alloy selection and evaluation remains a complex challenge, often requiring expertise in the various domains of materials science, thermodynamic simulations, and experimental analysis. Large Language Model (LLM) enabled agents can facilitate this endeavor by utilizing their extensive knowledge base to dispatch tool calls via Model Context Protocol (MCP) to perform actions such as thermophysical property diagram calculations and lack of fusion process map generation. In addition, the multi-agent system can effectively reason through complex user prompts and provide analysis on the lack of fusion process window of common alloys such as SS316L and IN718 along with proposed composition variants of known alloys. These agents can dynamically adjust their task trajectory to the outcomes of tool call results, effectively enabling autonomous decision-making in practical environments. This work aims to showcase the benefits of adopting a LLM enabled multi-agent system to automate and accelerate the task of evaluating proposed additive manufacturing alloys, both novel and known."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02567","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-10-06T01:31:00Z","registered":"2025-10-06T01:31:01Z","published":null,"updated":"2026-01-27T04:35:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06243","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06243","identifiers":[{"identifier":"2510.06243","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qihua","familyName":"Dong","name":"Dong, Qihua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luis","familyName":"Figueroa","name":"Figueroa, Luis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Handong","familyName":"Zhao","name":"Zhao, Handong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kushal","familyName":"Kafle","name":"Kafle, Kushal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jason","familyName":"Kuen","name":"Kuen, Jason","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhihong","familyName":"Ding","name":"Ding, Zhihong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Scott","familyName":"Cohen","name":"Cohen, Scott","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yun","familyName":"Fu","name":"Fu, Yun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CoT Referring: Improving Referring Expression Tasks with Grounded Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T08:50:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:00:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-17T09:14:14Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-21T01:23:30Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Referring Expression Comprehension and Segmentation are critical tasks for assessing the integration of language understanding and image comprehension, serving as benchmarks for Multimodal Large Language Models (MLLMs) capabilities. To address these challenges, we propose a new strategy, CoT Referring, which enhances model reasoning across modalities through a structured, chain-of-thought training data structure. Our approach systematically parses textual structures to a sequential referring step, where in each step it identifies relationships and ensures consistent reference alignment, thereby improving accuracy in complex query scenarios. We restructure the training data to enforce a new output form, providing new annotations for existing datasets and compiling an evaluation benchmark from existing resources. This benchmark is designed explicitly for complex referring cases. We also integrate detection and segmentation capabilities into a unified MLLM framework, training it with a novel adaptive weighted loss to optimize performance. Experimental results on our curated benchmark and RefCOCO/+/g demonstrate the effectiveness of our approach, with a notable increase of 2.5%+ over baseline models."},{"descriptionType":"Other","description":"MLLM, Referring Expression Segmentation"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06243","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T01:41:45Z","registered":"2025-10-09T01:41:45Z","published":null,"updated":"2026-01-21T06:06:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02630","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02630","identifiers":[{"identifier":"2510.02630","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hao","familyName":"Zhang","name":"Zhang, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenjia","familyName":"Li","name":"Li, Zhenjia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Runfeng","familyName":"Bao","name":"Bao, Runfeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifan","familyName":"Gao","name":"Gao, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xi","familyName":"Xiao","name":"Xiao, Xi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heng","familyName":"Zhang","name":"Zhang, Heng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuyang","familyName":"Zhang","name":"Zhang, Shuyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Huang","name":"Huang, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhang","familyName":"Wu","name":"Wu, Yuhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianyang","familyName":"Wang","name":"Wang, Tianyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Xu","name":"Xu, Hao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HyperAdaLoRA: Accelerating LoRA Rank Allocation During Training via Hypernetworks without Sacrificing Performance"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T00:15:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:13:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-12-12T07:03:38Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-15T01:26:32Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Parameter-Efficient Fine-Tuning (PEFT), especially Low-Rank Adaptation (LoRA), has emerged as a promising approach to fine-tuning large language models(LLMs) while reducing computational and memory overhead. However, LoRA assumes a uniform rank \\textit{r} for each incremental matrix, not accounting for the varying significance of weight matrices across different modules and layers. AdaLoRA leverages Singular Value Decomposition (SVD) to parameterize updates and employs pruning of singular values to introduce dynamic rank allocation, thereby enhancing adaptability. However, during the training process, it often encounters issues of slow convergence speed and high computational overhead. To address this issue, we propose HyperAdaLoRA, a novel framework that accelerates the convergence of AdaLoRA by leveraging a hypernetwork. Instead of directly optimizing the components of Singular Value Decomposition $(P, Λ, Q)$, HyperAdaLoRA employs a hypernetwork based on attention mechanisms to dynamically generate these parameters. By pruning the outputs of the hypernetwork that generates the singular values, dynamic rank allocation is achieved. Comprehensive experiments on various datasets and models demonstrate that our method achieves faster convergence without sacrificing performance. Additionally, further extension experiments on other LoRA-based approaches validate the broad applicability of our method."},{"descriptionType":"Other","description":"13 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02630","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:32:31Z","registered":"2025-10-06T01:32:32Z","published":null,"updated":"2025-12-15T02:58:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2511.11579","type":"dois","attributes":{"doi":"10.48550/arxiv.2511.11579","identifiers":[{"identifier":"2511.11579","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Felipe","familyName":"Urrutia","name":"Urrutia, Felipe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jorge","familyName":"Salas","name":"Salas, Jorge","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Kozachinskiy","name":"Kozachinskiy, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cristian Buc","familyName":"Calderon","name":"Calderon, Cristian Buc","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hector","familyName":"Pasten","name":"Pasten, Hector","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cristobal","familyName":"Rojas","name":"Rojas, Cristobal","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Decoupling Positional and Symbolic Attention Behavior in Transformers"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.0; F.1.0","lang":"en","subjectScheme":"ACM"},{"subject":"03D78","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2025-10-03T01:31:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-11-18T01:00:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"An important aspect subtending language understanding and production is the ability to independently encode positional and symbolic information of the words within a sentence. In Transformers, positional information is typically encoded using Positional Encodings (PEs). One such popular PE, namely Rotary PE (RoPE), has been widely used due to its empirical success. Recently, it has been argued that part of RoPE's success emerges from its ability to encode robust positional and semantic information using large and small frequencies, respectively. In this work, we perform a deeper dive into the positional versus symbolic dichotomy of attention heads behavior, both at the theoretical and empirical level. We provide general definitions of what it means for a head to behave positionally or symbolically, prove that these are two mutually exclusive behaviors and develop a metric to quantify them. We apply our framework to analyze Transformer-based LLMs using RoPE and find that all heads exhibit a strong correspondence between behavior and frequency use. Finally, we introduce canonical tasks designed to be either purely positional or symbolic, and demonstrate that the Transformer performance causally relates to the ability of attention heads to leverage the appropriate frequencies. In particular, we show that we can control the Transformer performance by controlling which frequencies the attention heads can access. Altogether, our work provides a detailed understanding of RoPE, and how its properties relate to model behavior."},{"descriptionType":"Other","description":"32 pages, 12 figures, repository available"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2511.11579","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-11-18T04:04:42Z","registered":"2025-11-18T04:04:43Z","published":null,"updated":"2025-11-18T04:04:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03185","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03185","identifiers":[{"identifier":"2510.03185","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wanjia","familyName":"Zhao","name":"Zhao, Wanjia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qinwei","familyName":"Ma","name":"Ma, Qinwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingzhe","familyName":"Shi","name":"Shi, Jingzhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shirley","familyName":"Wu","name":"Wu, Shirley","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaqi","familyName":"Han","name":"Han, Jiaqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yijia","familyName":"Xiao","name":"Xiao, Yijia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Si-Yuan","familyName":"Chen","name":"Chen, Si-Yuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiao","familyName":"Luo","name":"Luo, Xiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ludwig","familyName":"Schmidt","name":"Schmidt, Ludwig","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"James","familyName":"Zou","name":"Zou, James","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PRISM-Physics: Causal DAG-Based Process Evaluation for Physics Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T17:09:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:50:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-30T18:40:41Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-03T01:05:14Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Benchmarks for competition-style reasoning have advanced evaluation in mathematics and programming, yet physics remains comparatively explored. Most existing physics benchmarks evaluate only final answers, which fail to capture reasoning processes, while recent stepwise methods rely on heuristic LLM-as-judge scoring or restrictive linear assumptions, limiting reliability and diagnostic validity. We introduce PRISM-Physics, a process-level evaluation framework and benchmark for complex physics reasoning problems. Solutions are represented as directed acyclic graphs (DAGs) of formulas, explicitly encoding causal dependencies among intermediate steps to enable fine-grained, interpretable, and theoretically grounded scoring. We prove the optimality of the DAG representation and the corresponding scoring policy. Combining with a fully rule-based method for symbolic formula equivalence matching that we developed, we ensure consistent validation across diverse formulations without heuristic judgments. Results show that our evaluation framework is more aligned with human experts' scoring. Experiments on state-of-the-art LLMs reveal persistent reasoning failures in physics, while step-level scoring offers both diagnostic insight and rich signals for later training. By combining structural rigor, theoretical guarantees, and symbolic validation, PRISM-Physics provides a principled foundation for advancing process-level evaluation and guiding the development of models with deeper scientific reasoning capabilities."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03185","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:46:00Z","registered":"2025-10-06T01:46:01Z","published":null,"updated":"2025-11-03T03:01:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02745","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02745","identifiers":[{"identifier":"2510.02745","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lanyun","familyName":"Zhu","name":"Zhu, Lanyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Deyi","familyName":"Ji","name":"Ji, Deyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianrun","familyName":"Chen","name":"Chen, Tianrun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haiyang","familyName":"Wu","name":"Wu, Haiyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shiqi","familyName":"Wang","name":"Wang, Shiqi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Retrv-R1: A Reasoning-Driven MLLM Framework for Universal and Efficient Multimodal Retrieval"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T06:16:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:23:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-25T11:34:54Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-28T00:34:20Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The success of DeepSeek-R1 demonstrates the immense potential of using reinforcement learning (RL) to enhance LLMs' reasoning capabilities. This paper introduces Retrv-R1, the first R1-style MLLM specifically designed for multimodal universal retrieval, achieving higher performance by employing step-by-step reasoning to produce more accurate retrieval results. We find that directly applying the methods of DeepSeek-R1 to retrieval tasks is not feasible, mainly due to (1) the high computational cost caused by the large token consumption required for multiple candidates with reasoning processes, and (2) the instability and suboptimal results when directly applying RL to train for retrieval tasks. To address these issues, Retrv-R1 introduces an information compression module with a details inspection mechanism, which enhances computational efficiency by reducing the number of tokens while ensuring that critical information for challenging candidates is preserved. Furthermore, a new training paradigm is proposed, including an activation stage using a retrieval-tailored synthetic CoT dataset for more effective optimization, followed by RL with a novel curriculum reward to improve both performance and efficiency. Incorporating these novel designs, Retrv-R1 achieves SOTA performance, high efficiency, and strong generalization ability, as demonstrated by experiments across multiple benchmarks and tasks."},{"descriptionType":"Other","description":"NeurIPS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02745","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:35:18Z","registered":"2025-10-06T01:35:18Z","published":null,"updated":"2025-10-28T04:03:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.21740","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.21740","identifiers":[{"identifier":"2510.21740","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alexa R.","familyName":"Tartaglini","name":"Tartaglini, Alexa R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Satchel","familyName":"Grant","name":"Grant, Satchel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Wurgaft","name":"Wurgaft, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christopher","familyName":"Potts","name":"Potts, Christopher","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Judith E.","familyName":"Fan","name":"Fan, Judith E.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Diagnosing Bottlenecks in Data Visualization Understanding by Vision-Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T18:29:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:00:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Data visualizations are vital components of many scientific articles and news stories. Current vision-language models (VLMs) still struggle on basic data visualization understanding tasks, but the causes of failure remain unclear. Are VLM failures attributable to limitations in how visual information in the data visualization is encoded, how information is transferred between the vision and language modules, or how information is processed within the language module? We developed FUGU, a suite of data visualization understanding tasks, to precisely characterize potential sources of difficulty (e.g., extracting the position of data points, distances between them, and other summary statistics). We used FUGU to investigate three widely used VLMs. To diagnose the sources of errors produced by these models, we used activation patching and linear probes to trace information flow through models across a variety of prompting strategies. We found that some models fail to generate the coordinates of individual data points correctly, and these initial errors often lead to erroneous final responses. When these models are provided with the correct coordinates, performance improves substantially. Moreover, even when the model generates an incorrect response, the correct coordinates can be successfully read out from the latent representations in the vision encoder, suggesting that the source of these errors lies in the vision-language handoff. We further found that while providing correct coordinates helps with tasks involving one or a small number of data points, it generally worsens performance for tasks that require extracting statistical relationships across many data points. Fine-tuning models on FUGU also fails to yield ceiling performance. These findings point to architectural constraints in current VLMs that might pose significant challenges for reliable data visualization understanding."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.21740","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T02:58:49Z","registered":"2025-10-28T02:58:50Z","published":null,"updated":"2025-10-28T02:58:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.15926","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.15926","identifiers":[{"identifier":"2510.15926","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ye","familyName":"Qiao","name":"Qiao, Ye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiheng","familyName":"Chen","name":"Chen, Zhiheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifan","familyName":"Zhang","name":"Zhang, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yian","familyName":"Wang","name":"Wang, Yian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sitao","familyName":"Huang","name":"Huang, Sitao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TeLLMe v2: An Efficient End-to-End Ternary LLM Prefill and Decode Accelerator with Table-Lookup Matmul on Edge FPGAs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Hardware Architecture (cs.AR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T05:37:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-21T00:01:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-21T17:20:02Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-22T01:05:34Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"With the emergence of wearable devices and other embedded systems, deploying large language models (LLMs) on edge platforms has become an urgent need. However, this is challenging because of their high computational and memory demands. Although recent low-bit quantization methods (e.g., BitNet, DeepSeek) compress weights to as low as 1.58~bits with minimal accuracy loss, edge deployment is still constrained by limited on-chip resources, power budgets, and the often-neglected long latency of the prefill stage. We present \\textbf{TeLLMe}, the first table-lookup-based ternary LLM accelerator for low-power edge FPGAs that fully supports both prefill and autoregressive decoding using 1.58-bit weights and 8-bit activations. TeLLMe incorporates several novel techniques, including (1) a table-lookup-based ternary matrix multiplication (TLMM) engine utilizing grouped activations and online precomputation for low resource utilization and high throughput; (2) a fine-grained analytic URAM-based weight buffer management scheme for efficient loading and compute engine access; (3) a streaming dataflow architecture that fuses floating-point element-wise operations with linear computations to hide latency; (4) a reversed-reordered prefill stage attention with fused attention operations for high memory efficiency; and (5) a resource-efficient specialized decoding stage attention. Under a 5~W power budget, TeLLMe delivers up to 25~tokens/s decoding throughput and 0.45--0.96~s time-to-first-token (TTFT) for 64--128 token prompts, marking a significant energy-efficiency advancement in LLM inference on edge FPGAs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.15926","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-21T02:40:11Z","registered":"2025-10-21T02:40:11Z","published":null,"updated":"2025-10-22T02:23:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.17832","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.17832","identifiers":[{"identifier":"2510.17832","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Henrique de Lima","familyName":"Alexandre","name":"Alexandre, Henrique de Lima","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Clodoaldo Aparecido de Moraes","familyName":"Lima","name":"Lima, Clodoaldo Aparecido de Moraes","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Synthetic EEG Generation using Diffusion Models for Motor Imagery Tasks"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T02:02:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-22T00:00:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Electroencephalography (EEG) is a widely used, non-invasive method for capturing brain activity, and is particularly relevant for applications in Brain-Computer Interfaces (BCI). However, collecting high-quality EEG data remains a major challenge due to sensor costs, acquisition time, and inter-subject variability. To address these limitations, this study proposes a methodology for generating synthetic EEG signals associated with motor imagery brain tasks using Diffusion Probabilistic Models (DDPM). The approach involves preprocessing real EEG data, training a diffusion model to reconstruct EEG channels from noise, and evaluating the quality of the generated signals through both signal-level and task-level metrics. For validation, we employed classifiers such as K-Nearest Neighbors (KNN), Convolutional Neural Networks (CNN), and U-Net to compare the performance of synthetic data against real data in classification tasks. The generated data achieved classification accuracies above 95%, with low mean squared error and high correlation with real signals.\n Our results demonstrate that synthetic EEG signals produced by diffusion models can effectively complement datasets, improving classification performance in EEG-based BCIs and addressing data scarcity."},{"descriptionType":"Other","description":"15 pages, BRACIS"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.17832","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-22T01:46:07Z","registered":"2025-10-22T01:46:08Z","published":null,"updated":"2025-10-22T01:46:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02456","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02456","identifiers":[{"identifier":"2510.02456","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ashish","familyName":"Jha","name":"Jha, Ashish","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Valentin","familyName":"Leplat","name":"Leplat, Valentin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"AH","familyName":"Phan","name":"Phan, AH","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Market-Driven Subset Selection for Budgeted Training"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Numerical Analysis (math.NA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T18:12:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:03:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-20T15:38:47Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-21T01:37:06Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Training large language models on massive datasets is computationally expensive, yet empirical evidence suggests that substantial portions of training examples contribute minimally to final performance. Data subset selection addresses this inefficiency by identifying small, high-utility subsets under resource constraints. However, example utility is inherently multi-faceted, encompassing uncertainty, distributional rarity, and diversity signals that are heterogeneous and typically combined through ad hoc weighted sums lacking theoretical grounding. We propose a market-based framework that treats each training example as a tradeable contract and employs the Logarithmic Market Scoring Rule to aggregate multiple utility signals into coherent prices. Heterogeneous signals act as traders, a single liquidity parameter controls concentration versus smoothing, and topic-wise normalization ensures calibrated aggregation. Token budgets are handled explicitly through a price-per-token decision rule with an interpretable length-bias parameter. We establish theoretical connections to maximum-entropy aggregation and provide utility recovery guarantees under noisy but monotone signals. On GSM8K mathematical reasoning under strict 60k-token budgets, our selector achieves parity with strong single-signal baselines while exhibiting lower variance and incurring less than 0.1 GPU-hour overhead. On AGNews classification at 5-25\\% retention rates, the market formulation delivers competitive accuracy with improved stability. Our framework unifies multi-signal data curation under fixed computational budgets for prompt-level reasoning and classification tasks."},{"descriptionType":"Other","description":"Retitled major revision of the same work (formerly \"Market-Based Data Subset Selection -- Principled Aggregation of Multi-Criteria Example Utility\"). Abstract and exposition revised; ablations added; theory clarified. Core results unchanged. Supersedes v1; please process as a replacement"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02456","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:28:13Z","registered":"2025-10-06T01:28:13Z","published":null,"updated":"2025-10-21T03:42:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06240","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06240","identifiers":[{"identifier":"2510.06240","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiqun","familyName":"Pan","name":"Pan, Jiqun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenke","familyName":"Duan","name":"Duan, Zhenke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiani","familyName":"Tu","name":"Tu, Jiani","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anzhi","familyName":"Cheng","name":"Cheng, Anzhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanqing","familyName":"Wang","name":"Wang, Yanqing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Knowledge Graph-Guided Multi-Agent Distillation for Reliable Industrial Question Answering with Datasets"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Databases (cs.DB)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T06:52:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:00:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Industrial question-answering (QA) systems require higher safety and reliability than general-purpose dialogue models, as errors in high-risk scenarios such as equipment fault diagnosis can have severe consequences. Although multi-agent large language models enhance reasoning depth, they suffer from uncontrolled iterations and unverifiable outputs, and conventional distillation methods struggle to transfer collaborative reasoning capabilities to lightweight, deployable student models. To address these challenges, we propose Knowledge Graph-guided Multi-Agent System Distillation (KG-MASD). Our approach formulates distillation as a Markov Decision Process and incorporates a knowledge graph as a verifiable structured prior to enrich state representation and ensure convergence. By integrating collaborative reasoning with knowledge grounding, KG-MASD generates high-confidence instruction-tuning data and jointly distills reasoning depth and verifiability into compact student models suitable for edge deployment. Experiments on an industrial QA dataset show that KG-MASD improves accuracy by 2.4 per cent to 20.1 per cent over baselines and significantly enhances reliability, enabling trustworthy AI deployment in safety-critical industrial scenarios. Code and data are available at https://github.com/erwinmsmith/KG-MAD/."},{"descriptionType":"Other","description":"41 pages, 12 figures, 6 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06240","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T01:41:40Z","registered":"2025-10-09T01:41:41Z","published":null,"updated":"2025-10-09T01:41:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.05158","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.05158","identifiers":[{"identifier":"2510.05158","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xin","familyName":"He","name":"He, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liangliang","familyName":"You","name":"You, Liangliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongduan","familyName":"Tian","name":"Tian, Hongduan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Han","name":"Han, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ivor","familyName":"Tsang","name":"Tsang, Ivor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yew-Soon","familyName":"Ong","name":"Ong, Yew-Soon","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Lang-PINN: From Language to Physics-Informed Neural Networks via a Multi-Agent Framework"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Engineering, Finance, and Science (cs.CE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T08:20:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T00:01:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Physics-informed neural networks (PINNs) provide a powerful approach for solving partial differential equations (PDEs), but constructing a usable PINN remains labor-intensive and error-prone. Scientists must interpret problems as PDE formulations, design architectures and loss functions, and implement stable training pipelines. Existing large language model (LLM) based approaches address isolated steps such as code generation or architecture suggestion, but typically assume a formal PDE is already specified and therefore lack an end-to-end perspective. We present Lang-PINN, an LLM-driven multi-agent system that builds trainable PINNs directly from natural language task descriptions. Lang-PINN coordinates four complementary agents: a PDE Agent that parses task descriptions into symbolic PDEs, a PINN Agent that selects architectures, a Code Agent that generates modular implementations, and a Feedback Agent that executes and diagnoses errors for iterative refinement. This design transforms informal task statements into executable and verifiable PINN code. Experiments show that Lang-PINN achieves substantially lower errors and greater robustness than competitive baselines: mean squared error (MSE) is reduced by up to 3--5 orders of magnitude, end-to-end execution success improves by more than 50\\%, and reduces time overhead by up to 74\\%."},{"descriptionType":"Other","description":"PINN, PDE, Agent, LLM"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.05158","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T01:42:25Z","registered":"2025-10-08T01:42:25Z","published":null,"updated":"2025-10-08T01:42:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.05156","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.05156","identifiers":[{"identifier":"2510.05156","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lesly","familyName":"Miculicich","name":"Miculicich, Lesly","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mihir","familyName":"Parmar","name":"Parmar, Mihir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hamid","familyName":"Palangi","name":"Palangi, Hamid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Krishnamurthy Dj","familyName":"Dvijotham","name":"Dvijotham, Krishnamurthy Dj","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mirko","familyName":"Montanari","name":"Montanari, Mirko","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tomas","familyName":"Pfister","name":"Pfister, Tomas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Long T.","familyName":"Le","name":"Le, Long T.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VeriGuard: Enhancing LLM Agent Safety via Verified Code Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.7","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-10-03T04:11:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T00:01:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The deployment of autonomous AI agents in sensitive domains, such as healthcare, introduces critical risks to safety, security, and privacy. These agents may deviate from user objectives, violate data handling policies, or be compromised by adversarial attacks. Mitigating these dangers necessitates a mechanism to formally guarantee that an agent's actions adhere to predefined safety constraints, a challenge that existing systems do not fully address. We introduce VeriGuard, a novel framework that provides formal safety guarantees for LLM-based agents through a dual-stage architecture designed for robust and verifiable correctness. The initial offline stage involves a comprehensive validation process. It begins by clarifying user intent to establish precise safety specifications. VeriGuard then synthesizes a behavioral policy and subjects it to both testing and formal verification to prove its compliance with these specifications. This iterative process refines the policy until it is deemed correct. Subsequently, the second stage provides online action monitoring, where VeriGuard operates as a runtime monitor to validate each proposed agent action against the pre-verified policy before execution. This separation of the exhaustive offline validation from the lightweight online monitoring allows formal guarantees to be practically applied, providing a robust safeguard that substantially improves the trustworthiness of LLM agents."},{"descriptionType":"Other","description":"22 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.05156","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T01:42:22Z","registered":"2025-10-08T01:42:23Z","published":null,"updated":"2025-10-08T01:42:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03371","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03371","identifiers":[{"identifier":"2510.03371","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sasho","familyName":"Nedelkoski","name":"Nedelkoski, Sasho","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Acker","name":"Acker, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Odej","familyName":"Kao","name":"Kao, Odej","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Soeren","familyName":"Becker","name":"Becker, Soeren","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dominik","familyName":"Scheinert","name":"Scheinert, Dominik","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Distributed Low-Communication Training with Decoupled Momentum Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T08:25:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:03:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The training of large models demands substantial computational resources, typically available only in data centers with high-bandwidth interconnects. However, reducing the reliance on high-bandwidth interconnects between nodes enables the use of distributed compute resources as an alternative to centralized data center training. Building on recent advances in distributed model training, we propose an approach that further reduces communication by combining infrequent synchronizations across distributed model replicas with gradient momentum compression. In particular, we treat the optimizer momentum as a signal and decompose the Nesterov momentum into high- and low-frequency components via the discrete cosine transform (DCT). Only the high-frequency components are synchronized across model replicas every $H$ steps. Empirically, our method achieves up to a $16\\times$ reduction in communication compared to the baseline DiLoCo, and it generalizes across architectures, including transformer-based language models and convolutional neural networks for images. Overall, this work advances the feasibility of training large models on distributed nodes with low-bandwidth interconnects."},{"descriptionType":"Other","description":"NeurIPS 2025 - DynaFront 2025: Dynamics at the Frontiers of Optimization, Sampling, and Games Workshop"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03371","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T02:48:17Z","registered":"2025-10-07T02:48:18Z","published":null,"updated":"2025-10-07T02:48:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03199","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03199","identifiers":[{"identifier":"2510.03199","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qiwei","familyName":"Di","name":"Di, Qiwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaixuan","familyName":"Ji","name":"Ji, Kaixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuheng","familyName":"Li","name":"Li, Xuheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heyang","familyName":"Zhao","name":"Zhao, Heyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Quanquan","familyName":"Gu","name":"Gu, Quanquan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Best-of-Majority: Minimax-Optimal Strategy for Pass@$k$ Inference Scaling"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T17:35:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:51:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"LLM inference often generates a batch of candidates for a prompt and selects one via strategies like majority voting or Best-of- N (BoN). For difficult tasks, this single-shot selection often underperforms. Consequently, evaluations commonly report Pass@$k$: the agent may submit up to $k$ responses, and only the best of them is used when computing regret. Motivated by this, we study inference scaling in the more general Pass@$k$ inference setting, and prove that neither majority voting nor BoN exhibits the desirable scaling with $k$ and the sampling budget $N$. Combining the advantages of majority voting and BoN, we propose a new inference strategy called Best-of-Majority (BoM), with a pivotal step that restricts the candidates to the responses with high frequency in the $N$ samples before selecting the top-$k$ rewards. We prove that when the sampling budget is $N=\\tildeΩ(C^*)$, the regret of BoM is $O(ε_{\\mathrm{opt}}+\\sqrt{ε_{\\mathrm{RM}}^2C^*/k})$, where $C^*$ is the coverage coefficient, $ε_{\\mathrm{RM}}$ is the estimation error of the reward model, and $ε_{\\mathrm{opt}}$ is the estimation error of reward at the optimal response. We further establish a matching lower bound, certifying that our algorithm is minimax optimal. Beyond optimality, BoM has a key advantage: unlike majority voting and BoN, its performance does not degrade when increasing $N$. Experimental results of inference on math problems show BoM outperforming both majority voting and BoN."},{"descriptionType":"Other","description":"29 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03199","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:46:21Z","registered":"2025-10-06T01:46:22Z","published":null,"updated":"2025-10-06T01:46:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03194","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03194","identifiers":[{"identifier":"2510.03194","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zichen","familyName":"Chen","name":"Chen, Zichen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiefeng","familyName":"Chen","name":"Chen, Jiefeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sercan Ö.","familyName":"Arik","name":"Arik, Sercan Ö.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Misha","familyName":"Sra","name":"Sra, Misha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tomas","familyName":"Pfister","name":"Pfister, Tomas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinsung","familyName":"Yoon","name":"Yoon, Jinsung","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CoDA: Agentic Systems for Collaborative Data Visualization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T17:30:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:51:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Deep research has revolutionized data analysis, yet data scientists still devote substantial time to manually crafting visualizations, highlighting the need for robust automation from natural language queries. However, current systems struggle with complex datasets containing multiple files and iterative refinement. Existing approaches, including simple single- or multi-agent systems, often oversimplify the task, focusing on initial query parsing while failing to robustly manage data complexity, code errors, or final visualization quality. In this paper, we reframe this challenge as a collaborative multi-agent problem. We introduce CoDA, a multi-agent system that employs specialized LLM agents for metadata analysis, task planning, code generation, and self-reflection. We formalize this pipeline, demonstrating how metadata-focused analysis bypasses token limits and quality-driven refinement ensures robustness. Extensive evaluations show CoDA achieves substantial gains in the overall score, outperforming competitive baselines by up to 41.5%. This work demonstrates that the future of visualization automation lies not in isolated code generation but in integrated, collaborative agentic workflows."},{"descriptionType":"Other","description":"31 pages, 6 figures, 5 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03194","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:46:14Z","registered":"2025-10-06T01:46:14Z","published":null,"updated":"2025-10-06T01:46:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02876","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02876","identifiers":[{"identifier":"2510.02876","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Md Zahim","familyName":"Hassan","name":"Hassan, Md Zahim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Md.","familyName":"Osama","name":"Osama, Md.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muhammad Ashad","familyName":"Kabir","name":"Kabir, Muhammad Ashad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Md. Saiful","familyName":"Islam","name":"Islam, Md. Saiful","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zannatul","familyName":"Naim","name":"Naim, Zannatul","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ELMF4EggQ: Ensemble Learning with Multimodal Feature Fusion for Non-Destructive Egg Quality Assessment"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T10:34:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:32:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurate, non-destructive assessment of egg quality is critical for ensuring food safety, maintaining product standards, and operational efficiency in commercial poultry production. This paper introduces ELMF4EggQ, an ensemble learning framework that employs multimodal feature fusion to classify egg grade and freshness using only external attributes - image, shape, and weight. A novel, publicly available dataset of 186 brown-shelled eggs was constructed, with egg grade and freshness levels determined through laboratory-based expert assessments involving internal quality measurements, such as yolk index and Haugh unit. To the best of our knowledge, this is the first study to apply machine learning methods for internal egg quality assessment using only external, non-invasive features, and the first to release a corresponding labeled dataset. The proposed framework integrates deep features extracted from external egg images with structural characteristics such as egg shape and weight, enabling a comprehensive representation of each egg. Image feature extraction is performed using top-performing pre-trained CNN models (ResNet152, DenseNet169, and ResNet152V2), followed by PCA-based dimensionality reduction, SMOTE augmentation, and classification using multiple machine learning algorithms. An ensemble voting mechanism combines predictions from the best-performing classifiers to enhance overall accuracy. Experimental results demonstrate that the multimodal approach significantly outperforms image-only and tabular (shape and weight) only baselines, with the multimodal ensemble approach achieving 86.57% accuracy in grade classification and 70.83% in freshness prediction. All code and data are publicly available at https://github.com/Kenshin-Keeps/Egg_Quality_Prediction_ELMF4EggQ, promoting transparency, reproducibility, and further research in this domain."},{"descriptionType":"Other","description":"30 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02876","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:38:28Z","registered":"2025-10-06T01:38:29Z","published":null,"updated":"2025-10-06T01:38:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02827","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02827","identifiers":[{"identifier":"2510.02827","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tengjun","familyName":"Ni","name":"Ni, Tengjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Yuan","name":"Yuan, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shenghong","familyName":"Li","name":"Li, Shenghong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Wu","name":"Wu, Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ren Ping","familyName":"Liu","name":"Liu, Ren Ping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Ni","name":"Ni, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenjie","familyName":"Zhang","name":"Zhang, Wenjie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"StepChain GraphRAG: Reasoning Over Knowledge Graphs for Multi-Hop Question Answering"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T09:06:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:29:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent progress in retrieval-augmented generation (RAG) has led to more accurate and interpretable multi-hop question answering (QA). Yet, challenges persist in integrating iterative reasoning steps with external knowledge retrieval. To address this, we introduce StepChain GraphRAG, a framework that unites question decomposition with a Breadth-First Search (BFS) Reasoning Flow for enhanced multi-hop QA. Our approach first builds a global index over the corpus; at inference time, only retrieved passages are parsed on-the-fly into a knowledge graph, and the complex query is split into sub-questions. For each sub-question, a BFS-based traversal dynamically expands along relevant edges, assembling explicit evidence chains without overwhelming the language model with superfluous context. Experiments on MuSiQue, 2WikiMultiHopQA, and HotpotQA show that StepChain GraphRAG achieves state-of-the-art Exact Match and F1 scores. StepChain GraphRAG lifts average EM by 2.57% and F1 by 2.13% over the SOTA method, achieving the largest gain on HotpotQA (+4.70% EM, +3.44% F1). StepChain GraphRAG also fosters enhanced explainability by preserving the chain-of-thought across intermediate retrieval steps. We conclude by discussing how future work can mitigate the computational overhead and address potential hallucinations from large language models to refine efficiency and reliability in multi-hop QA."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02827","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:37:17Z","registered":"2025-10-06T01:37:18Z","published":null,"updated":"2025-10-06T01:37:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02803","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02803","identifiers":[{"identifier":"2510.02803","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yifan","familyName":"Liao","name":"Liao, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhen","familyName":"Sun","name":"Sun, Zhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoyun","familyName":"Qiu","name":"Qiu, Xiaoyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zixiao","familyName":"Zhao","name":"Zhao, Zixiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenbing","familyName":"Tang","name":"Tang, Wenbing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinlei","familyName":"He","name":"He, Xinlei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinhu","familyName":"Zheng","name":"Zheng, Xinhu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianwei","familyName":"Zhang","name":"Zhang, Tianwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyi","familyName":"Huang","name":"Huang, Xinyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xingshuo","familyName":"Han","name":"Han, Xingshuo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Work Zones challenge VLM Trajectory Planning: Toward Mitigation and Robust Autonomous Driving"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T08:21:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:27:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Visual Language Models (VLMs), with powerful multimodal reasoning capabilities, are gradually integrated into autonomous driving by several automobile manufacturers to enhance planning capability in challenging environments. However, the trajectory planning capability of VLMs in work zones, which often include irregular layouts, temporary traffic control, and dynamically changing geometric structures, is still unexplored. To bridge this gap, we conduct the \\textit{first} systematic study of VLMs for work zone trajectory planning, revealing that mainstream VLMs fail to generate correct trajectories in $68.0%$ of cases. To better understand these failures, we first identify candidate patterns via subgraph mining and clustering analysis, and then confirm the validity of $8$ common failure patterns through human verification. Building on these findings, we propose REACT-Drive, a trajectory planning framework that integrates VLMs with Retrieval-Augmented Generation (RAG). Specifically, REACT-Drive leverages VLMs to convert prior failure cases into constraint rules and executable trajectory planning code, while RAG retrieves similar patterns in new scenarios to guide trajectory generation. Experimental results on the ROADWork dataset show that REACT-Drive yields a reduction of around $3\\times$ in average displacement error relative to VLM baselines under evaluation with Qwen2.5-VL. In addition, REACT-Drive yields the lowest inference time ($0.58$s) compared with other methods such as fine-tuning ($17.90$s). We further conduct experiments using a real vehicle in 15 work zone scenarios in the physical world, demonstrating the strong practicality of REACT-Drive."},{"descriptionType":"Other","description":"13 pages,5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02803","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:36:42Z","registered":"2025-10-06T01:36:42Z","published":null,"updated":"2025-10-06T01:36:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02768","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02768","identifiers":[{"identifier":"2510.02768","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shashank","familyName":"Agnihotri","name":"Agnihotri, Shashank","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jonas","familyName":"Jakubassa","name":"Jakubassa, Jonas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Priyam","familyName":"Dey","name":"Dey, Priyam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sachin","familyName":"Goyal","name":"Goyal, Sachin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bernt","familyName":"Schiele","name":"Schiele, Bernt","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Venkatesh Babu","familyName":"Radhakrishnan","name":"Radhakrishnan, Venkatesh Babu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Margret","familyName":"Keuper","name":"Keuper, Margret","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Granular Study of Safety Pretraining under Model Abliteration"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T07:01:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:25:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Open-weight LLMs can be modified at inference time with simple activation edits, which raises a practical question for safety: do common safety interventions like refusal training or metatag training survive such edits? We study model abliteration, a lightweight projection technique designed to remove refusal-sensitive directions, and conduct a controlled evaluation across a granular sequence of Safety Pretraining checkpoints for SmolLM2-1.7B, alongside widely used open baselines. For each of 20 systems, original and abliterated, we issue 100 prompts with balanced harmful and harmless cases, classify responses as **Refusal** or **Non-Refusal** using multiple judges, and validate judge fidelity on a small human-labeled subset. We also probe whether models can identify refusal in their own outputs. Our study produces a checkpoint-level characterization of which data-centric safety components remain robust under abliteration, quantifies how judge selection influences evaluation outcomes, and outlines a practical protocol for integrating inference-time edits into safety assessments. Code: https://github.com/shashankskagnihotri/safety_pretraining."},{"descriptionType":"Other","description":"Accepted at NeurIPS 2025 bWorkshop Lock-LLM. *Equal Contribution"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02768","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:35:51Z","registered":"2025-10-06T01:35:52Z","published":null,"updated":"2025-10-06T01:35:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02726","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02726","identifiers":[{"identifier":"2510.02726","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"KM","familyName":"Pooja","name":"Pooja, KM","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng","familyName":"Long","name":"Long, Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aixin","familyName":"Sun","name":"Sun, Aixin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PGMEL: Policy Gradient-based Generative Adversarial Network for Multimodal Entity Linking"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T05:09:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:21:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The task of entity linking, which involves associating mentions with their respective entities in a knowledge graph, has received significant attention due to its numerous potential applications. Recently, various multimodal entity linking (MEL) techniques have been proposed, targeted to learn comprehensive embeddings by leveraging both text and vision modalities. The selection of high-quality negative samples can potentially play a crucial role in metric/representation learning. However, to the best of our knowledge, this possibility remains unexplored in existing literature within the framework of MEL. To fill this gap, we address the multimodal entity linking problem in a generative adversarial setting where the generator is responsible for generating high-quality negative samples, and the discriminator is assigned the responsibility for the metric learning tasks. Since the generator is involved in generating samples, which is a discrete process, we optimize it using policy gradient techniques and propose a policy gradient-based generative adversarial network for multimodal entity linking (PGMEL). Experimental results based on Wiki-MEL, Richpedia-MEL and WikiDiverse datasets demonstrate that PGMEL learns meaningful representation by selecting challenging negative samples and outperforms state-of-the-art methods."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02726","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:34:51Z","registered":"2025-10-06T01:34:52Z","published":null,"updated":"2025-10-06T01:34:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02677","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02677","identifiers":[{"identifier":"2510.02677","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhaorun","familyName":"Chen","name":"Chen, Zhaorun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xun","familyName":"Liu","name":"Liu, Xun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mintong","familyName":"Kang","name":"Kang, Mintong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiawei","familyName":"Zhang","name":"Zhang, Jiawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minzhou","familyName":"Pan","name":"Pan, Minzhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuang","familyName":"Yang","name":"Yang, Shuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Li","name":"Li, Bo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ARMs: Adaptive Red-Teaming Agent against Multimodal Models with Plug-and-Play Attacks"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T02:28:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:17:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"As vision-language models (VLMs) gain prominence, their multimodal interfaces also introduce new safety vulnerabilities, making the safety evaluation challenging and critical. Existing red-teaming efforts are either restricted to a narrow set of adversarial patterns or depend heavily on manual engineering, lacking scalable exploration of emerging real-world VLM vulnerabilities. To bridge this gap, we propose ARMs, an adaptive red-teaming agent that systematically conducts comprehensive risk assessments for VLMs. Given a target harmful behavior or risk definition, ARMs automatically optimizes diverse red-teaming strategies with reasoning-enhanced multi-step orchestration, to effectively elicit harmful outputs from target VLMs. We propose 11 novel multimodal attack strategies, covering diverse adversarial patterns of VLMs (e.g., reasoning hijacking, contextual cloaking), and integrate 17 red-teaming algorithms into ARMs via model context protocol (MCP). To balance the diversity and effectiveness of the attack, we design a layered memory with an epsilon-greedy attack exploration algorithm. Extensive experiments on instance- and policy-based benchmarks show that ARMs achieves SOTA attack success rates, exceeding baselines by an average of 52.1% and surpassing 90% on Claude-4-Sonnet. We show that the diversity of red-teaming instances generated by ARMs is significantly higher, revealing emerging vulnerabilities in VLMs. Leveraging ARMs, we construct ARMs-Bench, a large-scale multimodal safety dataset comprising over 30K red-teaming instances spanning 51 diverse risk categories, grounded in both real-world multimodal threats and regulatory risks. Safety fine-tuning with ARMs-Bench substantially improves the robustness of VLMs while preserving their general utility, providing actionable guidance to improve multimodal safety alignment against emerging threats."},{"descriptionType":"Other","description":"60 pages, 16 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02677","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:33:38Z","registered":"2025-10-06T01:33:39Z","published":null,"updated":"2025-10-06T01:33:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02654","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02654","identifiers":[{"identifier":"2510.02654","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Benjamin","familyName":"Yu","name":"Yu, Benjamin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jackie","familyName":"Liu","name":"Liu, Jackie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Justin","familyName":"Cui","name":"Cui, Justin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Smart-GRPO: Smartly Sampling Noise for Efficient RL of Flow-Matching Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T01:13:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:15:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advancements in flow-matching have enabled high-quality text-to-image generation. However, the deterministic nature of flow-matching models makes them poorly suited for reinforcement learning, a key tool for improving image quality and human alignment. Prior work has introduced stochasticity by perturbing latents with random noise, but such perturbations are inefficient and unstable. We propose Smart-GRPO, the first method to optimize noise perturbations for reinforcement learning in flow-matching models. Smart-GRPO employs an iterative search strategy that decodes candidate perturbations, evaluates them with a reward function, and refines the noise distribution toward higher-reward regions. Experiments demonstrate that Smart-GRPO improves both reward optimization and visual quality compared to baseline methods. Our results suggest a practical path toward reinforcement learning in flow-matching frameworks, bridging the gap between efficient training and human-aligned generation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02654","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:33:05Z","registered":"2025-10-06T01:33:06Z","published":null,"updated":"2025-10-06T01:33:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02549","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02549","identifiers":[{"identifier":"2510.02549","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sicheng","familyName":"Dong","name":"Dong, Sicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vahid","familyName":"Zolfaghari","name":"Zolfaghari, Vahid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nenad","familyName":"Petrovic","name":"Petrovic, Nenad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alois","familyName":"Knoll","name":"Knoll, Alois","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Knowledge-Graph Based RAG System Evaluation Framework"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T20:36:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:08:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) has become a significant research focus and is utilized in various fields, such as text generation and dialog systems. One of the most essential applications of LLM is Retrieval Augmented Generation (RAG), which greatly enhances generated content's reliability and relevance. However, evaluating RAG systems remains a challenging task. Traditional evaluation metrics struggle to effectively capture the key features of modern LLM-generated content that often exhibits high fluency and naturalness. Inspired by the RAGAS tool, a well-known RAG evaluation framework, we extended this framework into a KG-based evaluation paradigm, enabling multi-hop reasoning and semantic community clustering to derive more comprehensive scoring metrics. By incorporating these comprehensive evaluation criteria, we gain a deeper understanding of RAG systems and a more nuanced perspective on their performance. To validate the effectiveness of our approach, we compare its performance with RAGAS scores and construct a human-annotated subset to assess the correlation between human judgments and automated metrics. In addition, we conduct targeted experiments to demonstrate that our KG-based evaluation method is more sensitive to subtle semantic differences in generated outputs. Finally, we discuss the key challenges in evaluating RAG systems and highlight potential directions for future research."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02549","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:30:32Z","registered":"2025-10-06T01:30:33Z","published":null,"updated":"2025-10-06T01:30:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02520","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02520","identifiers":[{"identifier":"2510.02520","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xikun","familyName":"Huang","name":"Huang, Xikun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianyu","familyName":"Ruan","name":"Ruan, Tianyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chihao","familyName":"Zhang","name":"Zhang, Chihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shihua","familyName":"Zhang","name":"Zhang, Shihua","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Graph Generation with Spectral Geodesic Flow Matching"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T19:49:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:06:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Graph generation is a fundamental task with wide applications in modeling complex systems. Although existing methods align the spectrum or degree profile of the target graph, they often ignore the geometry induced by eigenvectors and the global structure of the graph. In this work, we propose Spectral Geodesic Flow Matching (SFMG), a novel framework that uses spectral eigenmaps to embed both input and target graphs into continuous Riemannian manifolds. We then define geodesic flows between embeddings and match distributions along these flows to generate output graphs. Our method yields several advantages: (i) captures geometric structure beyond eigenvalues, (ii) supports flexible generation of diverse graphs, and (iii) scales efficiently. Empirically, SFMG matches the performance of state-of-the-art approaches on graphlet, degree, and spectral metrics across diverse benchmarks. In particular, it achieves up to 30$\\times$ speedup over diffusion-based models, offering a substantial advantage in scalability and training efficiency. We also demonstrate its ability to generalize to unseen graph scales. Overall, SFMG provides a new approach to graph synthesis by integrating spectral geometry with flow matching."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02520","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:29:50Z","registered":"2025-10-06T01:29:50Z","published":null,"updated":"2025-10-06T01:29:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":36,"totalPages":1,"page":1},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bsize%5D=100\u0026query=%28doi%3A10.48550%2Farxiv.2510.02456+OR+doi%3A10.48550%2Farxiv.2510.02520+OR+doi%3A10.48550%2Farxiv.2510.02528+OR+doi%3A10.48550%2Farxiv.2510.02549+OR+doi%3A10.48550%2Farxiv.2510.02567+OR+doi%3A10.48550%2Farxiv.2510.02630+OR+doi%3A10.48550%2Farxiv.2510.02654+OR+doi%3A10.48550%2Farxiv.2510.02677+OR+doi%3A10.48550%2Farxiv.2510.02726+OR+doi%3A10.48550%2Farxiv.2510.02738+OR+doi%3A10.48550%2Farxiv.2510.02745+OR+doi%3A10.48550%2Farxiv.2510.02768+OR+doi%3A10.48550%2Farxiv.2510.02789+OR+doi%3A10.48550%2Farxiv.2510.02803+OR+doi%3A10.48550%2Farxiv.2510.02827+OR+doi%3A10.48550%2Farxiv.2510.02835+OR+doi%3A10.48550%2Farxiv.2510.02837+OR+doi%3A10.48550%2Farxiv.2510.02876+OR+doi%3A10.48550%2Farxiv.2510.02952+OR+doi%3A10.48550%2Farxiv.2510.03075+OR+doi%3A10.48550%2Farxiv.2510.03182+OR+doi%3A10.48550%2Farxiv.2510.03185+OR+doi%3A10.48550%2Farxiv.2510.03194+OR+doi%3A10.48550%2Farxiv.2510.03199+OR+doi%3A10.48550%2Farxiv.2510.03204+OR+doi%3A10.48550%2Farxiv.2510.03366+OR+doi%3A10.48550%2Farxiv.2510.03371+OR+doi%3A10.48550%2Farxiv.2510.05156+OR+doi%3A10.48550%2Farxiv.2510.05158+OR+doi%3A10.48550%2Farxiv.2510.06240+OR+doi%3A10.48550%2Farxiv.2510.06242+OR+doi%3A10.48550%2Farxiv.2510.06243+OR+doi%3A10.48550%2Farxiv.2510.15926+OR+doi%3A10.48550%2Farxiv.2510.17832+OR+doi%3A10.48550%2Farxiv.2510.21740+OR+doi%3A10.48550%2Farxiv.2511.11579%29"}}