<figure id="A4.F10.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.02964v1/x6.svg" id="A4.F10.sf2.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:110/88;" width="110" height="88"></object>
