</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" stroke="#808080"><path d="M -22.71 55.6 L -103.26 55.6 C -106.32 55.6 -108.79 53.12 -108.79 50.06 L -108.79 44.22 C -108.79 41.16 -106.32 38.69 -103.26 38.69 L -22.71 38.69 C -19.66 38.69 -17.18 41.16 -17.18 44.22 L -17.18 50.06 C -17.18 53.12 -19.66 55.6 -22.71 55.6 Z M -108.79 38.69"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -104.64 44.72)"><foreignObject style="--ltx-fo-width:7.85em;--ltx-fo-height:0.63em;--ltx-fo-depth:0.18em;font-size:7.7pt;" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="83.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A2.SS3.pic3.3" class="ltx_text ltx_font_sansserif ltx_font_bold" style="font-size:70%;">Prompt for Gemini</span></span></span></foreignObject></g></g></svg></span>
