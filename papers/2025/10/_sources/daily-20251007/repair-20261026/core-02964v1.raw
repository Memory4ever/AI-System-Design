<th id="A4.T10.10.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><span id="A4.T10.10.6.1.1" class="ltx_text" style="font-size:80%;">DeepSeek-V3</span></th>
