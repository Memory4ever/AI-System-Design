<div id="S3.T3.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:198.7pt;height:87pt;vertical-align:-41.3pt;"><span class="ltx_transformed_inner" style="transform:translate(-14.4pt,6.3pt) scale(0.873485048811005,0.873485048811005) ;">
