<td id="S4.T1.8.2.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">Deformable DETR <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib33" title="" class="ltx_ref">Zhu et al., 2020</a>)</cite></td>
<td id="S4.T1.8.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">35.0</td>
<td id="S4.T1.8.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">54.4</td>
<td id="S4.T1.8.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">37.8</td>
<td id="S4.T1.8.2.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">17.4</td>
<td id="S4.T1.8.2.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">27.6</td>
<td id="S4.T1.8.2.7" class="ltx_td ltx_align_center ltx_border_t">38.2</td></tr>
<tr id="S4.T1.8.3" class="ltx_tr">
<td id="S4.T1.8.3.1" class="ltx_td ltx_align_left ltx_border_r">Sparse RCNN <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib22" title="" class="ltx_ref">Sun et al., 2021</a>)</cite></td>
<td id="S4.T1.8.3.2" class="ltx_td ltx_align_center ltx_border_r">35.9</td>
<td id="S4.T1.8.3.3" class="ltx_td ltx_align_center ltx_border_r">54.4</td>
<td id="S4.T1.8.3.4" class="ltx_td ltx_align_center ltx_border_r">38.8</td>
<td id="S4.T1.8.3.5" class="ltx_td ltx_align_center ltx_border_r">18.4</td>
<td id="S4.T1.8.3.6" class="ltx_td ltx_align_center ltx_border_r">29.0</td>
