<td id="A3.T5.2.5.5" class="ltx_td ltx_align_center" style="padding:0.5pt 4.0pt;">800 (1891)</td>
<td id="A3.T5.2.5.6" class="ltx_td ltx_align_center" style="padding:0.5pt 4.0pt;">200 (454)</td>
<td id="A3.T5.2.5.7" class="ltx_td ltx_align_center" style="padding:0.5pt 4.0pt;">3</td></tr>
