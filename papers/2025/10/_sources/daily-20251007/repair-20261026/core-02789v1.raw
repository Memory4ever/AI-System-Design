<td id="S4.T1.8.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt">AP<sub id="S4.T1.8.1.4.1" class="ltx_sub"><span id="S4.T1.8.1.4.1.1" class="ltx_text ltx_font_italic">75</span></sub></td>
<td id="S4.T1.8.1.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt">AP<sub id="S4.T1.8.1.5.1" class="ltx_sub"><span id="S4.T1.8.1.5.1.1" class="ltx_text ltx_font_italic">s</span></sub></td>
<td id="S4.T1.8.1.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt">AP<sub id="S4.T1.8.1.6.1" class="ltx_sub"><span id="S4.T1.8.1.6.1.1" class="ltx_text ltx_font_italic">m</span></sub></td>
<td id="S4.T1.8.1.7" class="ltx_td ltx_align_center ltx_border_tt">AP<sub id="S4.T1.8.1.7.1" class="ltx_sub"><span id="S4.T1.8.1.7.1.1" class="ltx_text ltx_font_italic">l</span></sub></td></tr>
