<td id="S5.T2.6.1.3.8" class="ltx_td ltx_align_center">70.1</td>
<td id="S5.T2.6.1.3.9" class="ltx_td ltx_align_center">66.9</td>
<td id="S5.T2.6.1.3.10" class="ltx_td ltx_align_center">22.9</td>
