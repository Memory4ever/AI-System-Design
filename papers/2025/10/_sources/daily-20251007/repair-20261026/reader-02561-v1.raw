<td id="S5.T1.2.12.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="S5.T1.2.12.3.1" class="ltx_text ltx_font_bold">+4.4%</span></td>
<td id="S5.T1.2.12.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="S5.T1.2.12.4.1" class="ltx_text ltx_font_bold">+0.3</span></td>
<td id="S5.T1.2.12.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="S5.T1.2.12.5.1" class="ltx_text ltx_font_bold">+5.0%</span></td>
<td id="S5.T1.2.12.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="S5.T1.2.12.6.1" class="ltx_text ltx_font_bold">+0.6</span></td>
<td id="S5.T1.2.12.7" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="S5.T1.2.12.7.1" class="ltx_text ltx_font_bold">+2.0%</span></td>
<td id="S5.T1.2.12.8" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="S5.T1.2.12.8.1" class="ltx_text ltx_font_bold">+0.1</span></td></tr>
</tbody>
