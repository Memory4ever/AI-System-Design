<td id="A1.T5.2.7.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">✓</td>
<td id="A1.T5.2.7.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">✓</td>
