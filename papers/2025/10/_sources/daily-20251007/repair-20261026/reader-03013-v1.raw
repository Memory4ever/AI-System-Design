<td id="S5.T2.2.1.5" class="ltx_td ltx_align_center ltx_border_tt">BC</td>
<td id="S5.T2.2.1.6" class="ltx_td ltx_align_center ltx_border_tt">Expert</td></tr>
<tr id="S5.T2.2.2" class="ltx_tr">
<td id="S5.T2.2.2.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">HalfCheetah</td>
<td id="S5.T2.2.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T2.m1" class="ltx_Math" alttext="\mathbf{3469\pm 59}" display="inline" intent=":literal"><semantics><mrow><mn>𝟑𝟒𝟔𝟗</mn><mo>±</mo><mn>𝟓𝟗</mn></mrow><annotation encoding="application/x-tex">\mathbf{3469\pm 59}</annotation></semantics></math></td>
<td id="S5.T2.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T2.m2" class="ltx_Math" alttext="826\pm 231" display="inline" intent=":literal"><semantics><mrow><mn>826</mn><mo>±</mo><mn>231</mn></mrow><annotation encoding="application/x-tex">826\pm 231</annotation></semantics></math></td>
<td id="S5.T2.2.2.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T2.m3" class="ltx_Math" alttext="1259\pm 78" display="inline" intent=":literal"><semantics><mrow><mn>1259</mn><mo>±</mo><mn>78</mn></mrow><annotation encoding="application/x-tex">1259\pm 78</annotation></semantics></math></td>
<td id="S5.T2.2.2.5" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T2.m4" class="ltx_Math" alttext="2828\pm 281" display="inline" intent=":literal"><semantics><mrow><mn>2828</mn><mo>±</mo><mn>281</mn></mrow><annotation encoding="application/x-tex">2828\pm 281</annotation></semantics></math></td>
<td id="S5.T2.2.2.6" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T2.m5" class="ltx_Math" alttext="3540\pm 44" display="inline" intent=":literal"><semantics><mrow><mn>3540</mn><mo>±</mo><mn>44</mn></mrow><annotation encoding="application/x-tex">3540\pm 44</annotation></semantics></math></td></tr>
<tr id="S5.T2.2.3" class="ltx_tr">
<td id="S5.T2.2.3.1" class="ltx_td ltx_align_center ltx_border_r">Hopper</td>
<td id="S5.T2.2.3.2" class="ltx_td ltx_align_center"><math id="S5.T2.m6" class="ltx_Math" alttext="\mathbf{886\pm 1}" display="inline" intent=":literal"><semantics><mrow><mn>𝟖𝟖𝟔</mn><mo>±</mo><mn>𝟏</mn></mrow><annotation encoding="application/x-tex">\mathbf{886\pm 1}</annotation></semantics></math></td>
<td id="S5.T2.2.3.3" class="ltx_td ltx_align_center"><math id="S5.T2.m7" class="ltx_Math" alttext="192\pm 56" display="inline" intent=":literal"><semantics><mrow><mn>192</mn><mo>±</mo><mn>56</mn></mrow><annotation encoding="application/x-tex">192\pm 56</annotation></semantics></math></td>
