<td id="A2.T10.fig1.1.1.7.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A2.T10.fig1.1.1.7.2.1" class="ltx_text ltx_font_bold">0.5267</span></td></tr>
