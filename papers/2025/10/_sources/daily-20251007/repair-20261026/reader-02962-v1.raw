<figure id="algorithm1" class="ltx_float ltx_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="algorithm1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span>Entropy-Gated Radioactivity Test</figcaption>
<div id="algorithm1.4" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="algorithm1.4.1" class="ltx_listingline">
<span id="algorithm1.4.1.1" class="ltx_text"><span id="algorithm1.4.1.1.1" class="ltx_text ltx_font_bold">Input:</span> </span>Model <math id="algorithm1.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>; key <math id="algorithm1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>; prompts <math id="algorithm1.m3" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math>; selection rule: top-<math id="algorithm1.m4" class="ltx_Math" alttext="q\%" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>%</mo></mrow><annotation encoding="application/x-tex">q\%</annotation></semantics></math>
</div>
<div id="algorithm1.4.2" class="ltx_listingline"><span id="algorithm1.4.2.1" class="ltx_text"><span id="algorithm1.4.2.1.1" class="ltx_text ltx_font_bold">Output:</span> </span><math id="algorithm1.m5" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>-value
</div>
<div id="algorithm1.4.3" class="ltx_listingline"><span id="algorithm1.4.3.1" class="ltx_text ltx_font_bold">Query.</span> Collect outputs <math id="algorithm1.m6" class="ltx_Math" alttext="\mathcal{Y}=\{y_{t}\}_{t=1}^{N_{0}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>y</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>N</mi><mn>0</mn></msub></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{Y}=\{y_{t}\}_{t=1}^{N_{0}}</annotation></semantics></math> by querying <math id="algorithm1.m7" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> with <math id="algorithm1.m8" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math>.;
