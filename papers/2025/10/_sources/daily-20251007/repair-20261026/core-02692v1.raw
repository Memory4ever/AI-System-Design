<th id="A5.T13.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">50</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A5.T13.2.2" class="ltx_tr">
<th id="A5.T13.2.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">Scheduler</th>
<td id="A5.T13.2.2.2" class="ltx_td ltx_align_center">EulerDiscreteScheduler</td></tr>
<tr id="A5.T13.2.3" class="ltx_tr">
<th id="A5.T13.2.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb">Guidance Scale</th>
<td id="A5.T13.2.3.2" class="ltx_td ltx_align_center ltx_border_bb">7.5</td></tr>
</tbody>
</table>
</figure>
<figure id="A5.T14" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 14: </span>Training hyperparameters for GenAI-Bench</figcaption>
<table id="A5.T14.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="A5.T14.2.1" class="ltx_tr">
<th id="A5.T14.2.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_tt">Training Epochs</th>
<td id="A5.T14.2.1.2" class="ltx_td ltx_align_center ltx_border_tt"><math id="A5.T14.m1" class="ltx_Math" alttext="10" display="inline" intent=":literal"><semantics><mn>10</mn><annotation encoding="application/x-tex">10</annotation></semantics></math></td></tr>
<tr id="A5.T14.2.2" class="ltx_tr">
<th id="A5.T14.2.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">Image Resolution</th>
<td id="A5.T14.2.2.2" class="ltx_td ltx_align_center"><math id="A5.T14.m2" class="ltx_Math" alttext="768\times 768" display="inline" intent=":literal"><semantics><mrow><mn>768</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>768</mn></mrow><annotation encoding="application/x-tex">768\times 768</annotation></semantics></math></td></tr>
<tr id="A5.T14.2.3" class="ltx_tr">
