</span></div>
</figure></div></div>
</figure>
<div id="S4.SS1.p4" class="ltx_para ltx_noindent">
<p id="S4.SS1.p4.1" class="ltx_p">Given <math id="S4.SS1.p4.m1" class="ltx_Math" alttext="X_{t}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>t</mi></msub><annotation encoding="application/x-tex">X_{t}</annotation></semantics></math>, we obtain <math id="S4.SS1.p4.m2" class="ltx_Math" alttext="100" display="inline" intent=":literal"><semantics><mn>100</mn><annotation encoding="application/x-tex">100</annotation></semantics></math> roll outs <math id="S4.SS1.p4.m3" class="ltx_Math" alttext="X_{0}^{(i)}|X_{t}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>X</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo fence="false">|</mo><msub><mi>X</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">X_{0}^{(i)}|X_{t}</annotation></semantics></math> for <math id="S4.SS1.p4.m4" class="ltx_Math" alttext="1\leq i\leq 100" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mn>100</mn></mrow><annotation encoding="application/x-tex">1\leq i\leq 100</annotation></semantics></math> and its empirical average <math id="S4.SS1.p4.m5" class="ltx_Math" alttext="\hat{r}(X_{t})=\sum_{i=1}^{100}r(X_{0}^{(i)})/100" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>r</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mn>100</mn></msubsup><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>X</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>/</mo><mn>100</mn></mrow></mrow><annotation encoding="application/x-tex">\hat{r}(X_{t})=\sum_{i=1}^{100}r(X_{0}^{(i)})/100</annotation></semantics></math>. If <math id="S4.SS1.p4.m6" class="ltx_Math" alttext="r(X_{0})" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r(X_{0})</annotation></semantics></math> is independent of <math id="S4.SS1.p4.m7" class="ltx_Math" alttext="X_{t}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>t</mi></msub><annotation encoding="application/x-tex">X_{t}</annotation></semantics></math> (under <math id="S4.SS1.p4.m8" class="ltx_Math" alttext="H_{0}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>0</mn></msub><annotation encoding="application/x-tex">H_{0}</annotation></semantics></math>), the law of <math id="S4.SS1.p4.m9" class="ltx_Math" alttext="\hat{r}(X_{t})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>r</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{r}(X_{t})</annotation></semantics></math> is the binomial distribution <math id="S4.SS1.p4.m10" class="ltx_Math" alttext="\mathsf{Bin}(100,\theta)" display="inline" intent=":literal"><semantics><mrow><mi>𝖡𝗂𝗇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>100</mn><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{Bin}(100,\theta)</annotation></semantics></math> with <math id="S4.SS1.p4.m11" class="ltx_Math" alttext="\theta=\mathbb{P}(r(X_{0})=1)" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta=\mathbb{P}(r(X_{0})=1)</annotation></semantics></math> being the marginal probability of observing a stable molecule. We perform <math id="S4.SS1.p4.m12" class="ltx_Math" alttext="1000" display="inline" intent=":literal"><semantics><mn>1000</mn><annotation encoding="application/x-tex">1000</annotation></semantics></math> repetitions for the experiment above for various values of <math id="S4.SS1.p4.m13" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> and plot the empirical distributions in Figure <a href="#S4.F1" title="Figure 1 ‣ Table 1 ‣ 4.1 A Bias-Variance Tradeoff Justification for P-GRAFT ‣ 4 Partial-GRAFT for Diffusion Models ‣ Fine-Tuning Diffusion Models via Intermediate Distribution Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>. For <math id="S4.SS1.p4.m14" class="ltx_Math" alttext="t=t_{3N/4}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><msub><mi>t</mi><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>/</mo><mn>4</mn></mrow></msub></mrow><annotation encoding="application/x-tex">t=t_{3N/4}</annotation></semantics></math> (when <math id="S4.SS1.p4.m15" class="ltx_Math" alttext="X_{t}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>t</mi></msub><annotation encoding="application/x-tex">X_{t}</annotation></semantics></math> close to <math id="S4.SS1.p4.m16" class="ltx_Math" alttext="\mathcal{N}(0,\mathbf{I})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>𝐈</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}(0,\mathbf{I})</annotation></semantics></math>), the distribution is close to the Binomial distribution and for <math id="S4.SS1.p4.m17" class="ltx_Math" alttext="t=t_{N/4}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><msub><mi>t</mi><mrow><mi>N</mi><mo>/</mo><mn>4</mn></mrow></msub></mrow><annotation encoding="application/x-tex">t=t_{N/4}</annotation></semantics></math> (when <math id="S4.SS1.p4.m18" class="ltx_Math" alttext="X_{t}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>t</mi></msub><annotation encoding="application/x-tex">X_{t}</annotation></semantics></math> is close to the target) it is far. That is, <math id="S4.SS1.p4.m19" class="ltx_Math" alttext="X_{t_{N/4}}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><msub><mi>t</mi><mrow><mi>N</mi><mo>/</mo><mn>4</mn></mrow></msub></msub><annotation encoding="application/x-tex">X_{t_{N/4}}</annotation></semantics></math> already carries a lot of information about <math id="S4.SS1.p4.m20" class="ltx_Math" alttext="r(X_{0})" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r(X_{0})</annotation></semantics></math>. This is further supported by the expected conditional variances reported in Table <a href="#S4.T1" title="Table 1 ‣ 4.1 A Bias-Variance Tradeoff Justification for P-GRAFT ‣ 4 Partial-GRAFT for Diffusion Models ‣ Fine-Tuning Diffusion Models via Intermediate Distribution Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.</p>
</div>
<div id="S4.SS1.p5" class="ltx_para ltx_noindent">
<p id="S4.SS1.p5.1" class="ltx_p"><span id="S4.SS1.p5.1.1" class="ltx_text ltx_font_bold">Bias reduces with increasing <math id="S4.SS1.p5.m1" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>:</span>
We follow the Stochastic Differential Equation (SDE) framework from <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib16" title="" class="ltx_ref">Song et al. [16]</a></cite> for our analysis. Let the target distribution <math id="S4.SS1.p5.m2" class="ltx_Math" alttext="q_{0}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mn>0</mn></msub><annotation encoding="application/x-tex">q_{0}</annotation></semantics></math> be the law of accepted samples under P-GRS. Diffusion models consider the forward process to be the Ornstein-Uhlenbeck Process given by <math id="S4.SS1.p5.m3" class="ltx_Math" alttext="dX^{f}_{t}=-X^{f}_{t}dt+\sqrt{2}dB_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>X</mi><mi>t</mi><mi>f</mi></msubsup></mrow><mo>=</mo><mrow><mrow><mo>−</mo><mrow><msubsup><mi>X</mi><mi>t</mi><mi>f</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo>+</mo><mrow><msqrt><mn>2</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>t</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">dX^{f}_{t}=-X^{f}_{t}dt+\sqrt{2}dB_{t}</annotation></semantics></math> where <math id="S4.SS1.p5.m4" class="ltx_Math" alttext="X^{f}_{0}\sim q_{0}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>X</mi><mn>0</mn><mi>f</mi></msubsup><mo>∼</mo><msub><mi>q</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">X^{f}_{0}\sim q_{0}</annotation></semantics></math> is drawn from the target distribution over <math id="S4.SS1.p5.m5" class="ltx_Math" alttext="\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>d</mi></msup><annotation encoding="application/x-tex">\mathbb{R}^{d}</annotation></semantics></math> and <math id="S4.SS1.p5.m6" class="ltx_Math" alttext="B_{t}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>t</mi></msub><annotation encoding="application/x-tex">B_{t}</annotation></semantics></math> is the standard Brownian motion in <math id="S4.SS1.p5.m7" class="ltx_Math" alttext="\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>d</mi></msup><annotation encoding="application/x-tex">\mathbb{R}^{d}</annotation></semantics></math>. It is well known that <math id="S4.SS1.p5.m8" class="ltx_Math" alttext="X^{f}_{t}\stackrel{{\scriptstyle d}}{{=}}e^{-t}X^{f}_{0}+\sqrt{1-e^{-2t}}Z" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>X</mi><mi>t</mi><mi>f</mi></msubsup><mover><mo>=</mo><mi>d</mi></mover><mrow><mrow><msup><mi>e</mi><mrow><mo>−</mo><mi>t</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>X</mi><mn>0</mn><mi>f</mi></msubsup></mrow><mo>+</mo><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>Z</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">X^{f}_{t}\stackrel{{\scriptstyle d}}{{=}}e^{-t}X^{f}_{0}+\sqrt{1-e^{-2t}}Z</annotation></semantics></math>, where <math id="S4.SS1.p5.m9" class="ltx_Math" alttext="Z\sim\mathcal{N}(0,\mathbf{I})" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>𝐈</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Z\sim\mathcal{N}(0,\mathbf{I})</annotation></semantics></math> independent of <math id="S4.SS1.p5.m10" class="ltx_Math" alttext="X^{f}_{0}" display="inline" intent=":literal"><semantics><msubsup><mi>X</mi><mn>0</mn><mi>f</mi></msubsup><annotation encoding="application/x-tex">X^{f}_{0}</annotation></semantics></math>.</p>
</div>
<div id="S4.SS1.p6" class="ltx_para ltx_noindent">
<p id="S4.SS1.p6.1" class="ltx_p">Let <math id="S4.SS1.p6.m1" class="ltx_Math" alttext="q_{t}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi>t</mi></msub><annotation encoding="application/x-tex">q_{t}</annotation></semantics></math> be the density of the law of <math id="S4.SS1.p6.m2" class="ltx_Math" alttext="X^{f}_{t}" display="inline" intent=":literal"><semantics><msubsup><mi>X</mi><mi>t</mi><mi>f</mi></msubsup><annotation encoding="application/x-tex">X^{f}_{t}</annotation></semantics></math>. Diffusion models learn the score function <math id="S4.SS1.p6.m3" class="ltx_Math" alttext="[0,T]\times\mathbb{R}^{d}\ni(t,X)\to\nabla\log q_{t}(X)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mi>T</mi></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><mo>∋</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>log</mi></mrow><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">[0,T]\times\mathbb{R}^{d}\ni(t,X)\to\nabla\log q_{t}(X)</annotation></semantics></math> via score matching (see Appendix <a href="#A1" title="Appendix A Related Work ‣ Fine-Tuning Diffusion Models via Intermediate Distribution Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a>
for literature review on score matching). P-GRAFT, in contrast, attempts to learn <math id="S4.SS1.p6.m4" class="ltx_Math" alttext="\nabla\log q_{s}" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∇</mo><mi>log</mi></mrow><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><mi>s</mi></msub></mrow><annotation encoding="application/x-tex">\nabla\log q_{s}</annotation></semantics></math> between for <math id="S4.SS1.p6.m5" class="ltx_Math" alttext="s\in[t,T]" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mi>t</mi><mo>,</mo><mi>T</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">s\in[t,T]</annotation></semantics></math>. At time <math id="S4.SS1.p6.m6" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, <math id="S4.SS1.p6.m7" class="ltx_Math" alttext="\nabla\log q_{T}(X)\approx-X" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>log</mi></mrow><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><mi>T</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≈</mo><mrow><mo>−</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">\nabla\log q_{T}(X)\approx-X</annotation></semantics></math>, the score of the standard Gaussian distribution, which is easy to learn. When <math id="S4.SS1.p6.m8" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math>, the score <math id="S4.SS1.p6.m9" class="ltx_Math" alttext="\nabla\log q_{0}(X)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>log</mi></mrow><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><mn>0</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla\log q_{0}(X)</annotation></semantics></math> corresponds to the data distribution which can be very complicated. Diffusion models use Denoising Score Matching, based on Tweedie’s formula introduced by <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib17" title="" class="ltx_ref">17</a>]</cite>. We show via Bakry-Emery theory <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib18" title="" class="ltx_ref">18</a>]</cite> that the score function <math id="S4.SS1.p6.m10" class="ltx_Math" alttext="\nabla\log q_{t}(X)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>log</mi></mrow><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla\log q_{t}(X)</annotation></semantics></math> converges to <math id="S4.SS1.p6.m11" class="ltx_Math" alttext="q_{\infty}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q_{\infty}(X)</annotation></semantics></math> exponentially in <math id="S4.SS1.p6.m12" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, potentially making the learning easier. Consider <math id="S4.SS1.p6.m13" class="ltx_Math" alttext="s_{\theta}(X,t):\mathbb{R}^{d}\times\mathbb{R}^{+}\to\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>s</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>t</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mrow><msup><mi>ℝ</mi><mi>d</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><mo>+</mo></msup></mrow><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">s_{\theta}(X,t):\mathbb{R}^{d}\times\mathbb{R}^{+}\to\mathbb{R}^{d}</annotation></semantics></math> to be a neural network with parameters <math id="S4.SS1.p6.m14" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>, then score matching objective is given by:</p>
<table id="S4.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex6.m1" class="ltx_Math" alttext="\mathcal{L}(\theta)=\mathbb{E}\int_{0}^{T}dt\|\tfrac{X^{f}_{t}-e^{-t}X^{f}_{0}}{1-e^{-2t}}+s_{\theta}(X^{f}_{t},t)\|^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∫</mo><mn>0</mn><mi>T</mi></msubsup><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mstyle displaystyle="false"><mfrac><mrow><msubsup><mi>X</mi><mi>t</mi><mi>f</mi></msubsup><mo>−</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mi>t</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>X</mi><mn>0</mn><mi>f</mi></msubsup></mrow></mrow><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup></mrow></mfrac></mstyle><mo>+</mo><mrow><msub><mi>s</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>X</mi><mi>t</mi><mi>f</mi></msubsup><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}(\theta)=\mathbb{E}\int_{0}^{T}dt\|\tfrac{X^{f}_{t}-e^{-t}X^{f}_{0}}{1-e^{-2t}}+s_{\theta}(X^{f}_{t},t)\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p6.2" class="ltx_p">In practice, <math id="S4.SS1.p6.m15" class="ltx_Math" alttext="\mathcal{L}(\theta)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}(\theta)</annotation></semantics></math> is approximated with samples. By Tweedie’s formula, we have:
<math id="S4.SS1.p6.m16" class="ltx_Math" alttext="\mathbb{E}[\frac{X^{f}_{t}-e^{-t}X^{f}_{0}}{1-e^{-2t}}|X^{f}_{t}]=-\nabla\log q_{t}(X^{f}_{t})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mfrac><mrow><msubsup><mi>X</mi><mi>t</mi><mi>f</mi></msubsup><mo>−</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mi>t</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>X</mi><mn>0</mn><mi>f</mi></msubsup></mrow></mrow><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup></mrow></mfrac><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>X</mi><mi>t</mi><mi>f</mi></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mo rspace="0.167em">−</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>log</mi></mrow><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>X</mi><mi>t</mi><mi>f</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[\frac{X^{f}_{t}-e^{-t}X^{f}_{0}}{1-e^{-2t}}|X^{f}_{t}]=-\nabla\log q_{t}(X^{f}_{t})</annotation></semantics></math>. Thus, for some constant <math id="S4.SS1.p6.m17" class="ltx_Math" alttext="\mathsf{C}" display="inline" intent=":literal"><semantics><mi>𝖢</mi><annotation encoding="application/x-tex">\mathsf{C}</annotation></semantics></math>, independent of <math id="S4.SS1.p6.m18" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>:</p>
<table id="S4.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex7.m1" class="ltx_Math" alttext="\displaystyle\mathcal{L}(\theta)+\mathsf{C}" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>𝖢</mi></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}(\theta)+\mathsf{C}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex7.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\int_{0}^{T}dt\|\nabla\log q_{t}(X^{f}_{t})-s_{\theta}(X^{f}_{t},t)\|^{2}=\int_{0}^{T}dt\int_{\mathbb{R}^{d}}dX\ q_{t}(X)\|\nabla\log q_{t}(X)-s_{\theta}(X,t)\|^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>T</mi></msubsup></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>log</mi></mrow><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>X</mi><mi>t</mi><mi>f</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>s</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>X</mi><mi>t</mi><mi>f</mi></msubsup><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>T</mi></msubsup></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msup><mi>ℝ</mi><mi>d</mi></msup></msub></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>X</mi><mo lspace="0.500em" rspace="0em">​</mo><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>log</mi></mrow><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>s</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\int_{0}^{T}dt\|\nabla\log q_{t}(X^{f}_{t})-s_{\theta}(X^{f}_{t},t)\|^{2}=\int_{0}^{T}dt\int_{\mathbb{R}^{d}}dX\ q_{t}(X)\|\nabla\log q_{t}(X)-s_{\theta}(X,t)\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p6.3" class="ltx_p">As shown by <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib19" title="" class="ltx_ref">19</a>]</cite>, <math id="S4.SS1.p6.m19" class="ltx_Math" alttext="\mathcal{L}(\theta)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}(\theta)</annotation></semantics></math> directly controls the quality of generations. Note that <math id="S4.SS1.p6.m20" class="ltx_Math" alttext="q_{\infty}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">q_{\infty}</annotation></semantics></math> is the density of <math id="S4.SS1.p6.m21" class="ltx_Math" alttext="\mathcal{N}(0,\mathbf{I})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>𝐈</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}(0,\mathbf{I})</annotation></semantics></math> and <math id="S4.SS1.p6.m22" class="ltx_Math" alttext="\nabla\log q_{\infty}(X)=-X" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>log</mi></mrow><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><mi mathvariant="normal">∞</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">\nabla\log q_{\infty}(X)=-X</annotation></semantics></math>. The theorem below is proved in Appendix <a href="#A4.SS5" title="D.5 Proof of Theorem ‣ Appendix D Proofs ‣ Fine-Tuning Diffusion Models via Intermediate Distribution Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.5</span></a>.</p>
</div>
<div id="S4.Thmtheorem4" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem4.2" class="ltx_text ltx_font_bold">Theorem 4.4</span></span><span id="S4.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem4.p1" class="ltx_para ltx_noindent">
<p id="S4.Thmtheorem4.p1.1" class="ltx_p"><span id="S4.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Define <math id="S4.Thmtheorem4.p1.m1" class="ltx_Math" alttext="H_{t}^{s}" display="inline" intent=":literal"><semantics><msubsup><mi>H</mi><mi>t</mi><mi>s</mi></msubsup><annotation encoding="application/x-tex">H_{t}^{s}</annotation></semantics></math> for <math id="S4.Thmtheorem4.p1.m2" class="ltx_Math" alttext="s\leq t" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>≤</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">s\leq t</annotation></semantics></math>:
<math id="S4.Thmtheorem4.p1.m3" class="ltx_Math" alttext="H_{t}^{s}=\int_{s}^{t}dt\int_{\mathbb{R}^{d}}dXq_{s}(X)\|\nabla\log q_{s}(X)-\nabla\log q_{\infty}(X)\|^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>H</mi><mi>t</mi><mi>s</mi></msubsup><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∫</mo><mi>s</mi><mi>t</mi></msubsup><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∫</mo><msup><mi>ℝ</mi><mi>d</mi></msup></msub><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>X</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>log</mi></mrow><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><mi>s</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>log</mi></mrow><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><mi mathvariant="normal">∞</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">H_{t}^{s}=\int_{s}^{t}dt\int_{\mathbb{R}^{d}}dXq_{s}(X)\|\nabla\log q_{s}(X)-\nabla\log q_{\infty}(X)\|^{2}</annotation></semantics></math>. Then,</span></p>
<table id="S4.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex8.m1" class="ltx_Math" alttext="H_{t}^{T}\leq\frac{e^{-2t}}{1-e^{-2t}}H_{0}^{t}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>H</mi><mi>t</mi><mi>T</mi></msubsup><mo>≤</mo><mrow><mfrac><msup><mi>e</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>H</mi><mn>0</mn><mi>t</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">H_{t}^{T}\leq\frac{e^{-2t}}{1-e^{-2t}}H_{0}^{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS1.p7" class="ltx_para ltx_noindent">
<p id="S4.SS1.p7.1" class="ltx_p">Therefore, the score functions between time <math id="S4.SS1.p7.m1" class="ltx_Math" alttext="(t,T)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(t,T)</annotation></semantics></math> are exponentially closer to the simple Gaussian score function compared to the score functions between times <math id="S4.SS1.p7.m2" class="ltx_Math" alttext="(0,t)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,t)</annotation></semantics></math> in the precise sense given in Theorem <a href="#S4.Thmtheorem4" title="Theorem 4.4. ‣ 4.1 A Bias-Variance Tradeoff Justification for P-GRAFT ‣ 4 Partial-GRAFT for Diffusion Models ‣ Fine-Tuning Diffusion Models via Intermediate Distribution Shaping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.4</span></a>. This means that the score functions at later times should be <span id="S4.SS1.p7.1.1" class="ltx_text ltx_font_bold">easier</span> to learn.</p>
</div>
</section>
</section>
<section id="S5" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">5 </span>Inverse Noise Correction for Flow Models</h2>

<figure id="S5.F2" class="ltx_figure ltx_align_floatright" style="width:72%;"><span class="ltx_inline-block"><svg id="S5.F2.pic1" class="ltx_picture ltx_centering" height="105.95" overflow="visible" version="1.1" viewBox="0 0 647.3 105.95" width="647.3"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,105.95) matrix(1 0 0 -1 0 0) translate(263.45,0) translate(0,68.69)"><g style="--ltx-fill-color:#8080FF;" fill="#8080FF" fill-opacity="0.6" stroke-opacity="0.6"><path style="stroke:none" d="M 25.59 19.69 C 36.24 22.42 73.22 25.15 76.77 19.69 C 80.32 14.22 61.83 -16.95 51.18 -19.69 C 40.53 -22.42 3.55 -5.46 0 0 C -3.55 5.46 14.94 16.95 25.59 19.69 Z"></path></g><g style="--ltx-fill-color:#FF8080;" fill="#FF8080" fill-opacity="0.6" stroke-opacity="0.6"><path style="stroke:none" d="M 179.13 29.53 C 186.23 32.26 204.72 27.88 204.72 19.69 C 204.72 11.49 186.23 -26.8 179.13 -29.53 C 172.03 -32.26 153.54 -8.19 153.54 0 C 153.54 8.19 172.03 26.8 179.13 29.53 Z"></path></g><g style="--ltx-fill-color:#80FF80;" fill="#80FF80" fill-opacity="0.6" stroke-opacity="0.6"><path style="stroke:none" d="M 38.39 -43.31 C 49.04 -43.31 76.77 -29.08 76.77 -23.62 C 76.77 -18.16 49.04 -3.94 38.39 -3.94 C 27.73 -3.94 0 -18.16 0 -23.62 C 0 -29.08 27.73 -43.31 38.39 -43.31 Z"></path></g><g style="--ltx-fill-color:#80BFBF;" fill="#80BFBF" fill-opacity="0.6" stroke-opacity="0.6"><path style="stroke:none" d="M 191.93 0 C 195.48 -4.1 184.46 -46.48 179.13 -49.21 C 173.81 -51.94 151.77 -26.51 153.54 -19.69 C 155.32 -12.86 188.38 4.1 191.93 0 Z"></path></g><path style="stroke:none" d="M 63.98 0 M 65.77 0 C 65.77 0.76 64.97 1.38 63.98 1.38 C 62.98 1.38 62.18 0.76 62.18 0 C 62.18 -0.76 62.98 -1.38 63.98 -1.38 C 64.97 -1.38 65.77 -0.76 65.77 0 Z M 63.98 0"></path><g stroke-width="0.8pt"><path style="fill:none" d="M 63.98 0 L 75.89 9.17"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" 