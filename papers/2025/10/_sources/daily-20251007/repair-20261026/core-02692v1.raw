<th id="A6.T20.2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Mol: Stability</th>
<th id="A6.T20.2.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Uniqueness</th></tr>
</thead>
