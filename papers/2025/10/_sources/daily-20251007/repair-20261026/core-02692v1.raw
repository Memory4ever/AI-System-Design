<th id="S4.T1.fig2.1.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="S4.T1.m7" class="ltx_Math" alttext="N/2" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">N/2</annotation></semantics></math></th>
<td id="S4.T1.fig2.1.1.4.2" class="ltx_td ltx_align_right"><math id="S4.T1.m8" class="ltx_Math" alttext="0.1312" display="inline" intent=":literal"><semantics><mn>0.1312</mn><annotation encoding="application/x-tex">0.1312</annotation></semantics></math></td></tr>
