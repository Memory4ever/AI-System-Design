<th id="S4.T1.fig2.1.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="S4.T1.m5" class="ltx_Math" alttext="3N/4" display="inline" intent=":literal"><semantics><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>/</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">3N/4</annotation></semantics></math></th>
<td id="S4.T1.fig2.1.1.3.2" class="ltx_td ltx_align_right"><math id="S4.T1.m6" class="ltx_Math" alttext="0.1327" display="inline" intent=":literal"><semantics><mn>0.1327</mn><annotation encoding="application/x-tex">0.1327</annotation></semantics></math></td></tr>
