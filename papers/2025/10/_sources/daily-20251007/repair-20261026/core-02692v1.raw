<th id="S4.T1.fig2.1.1.1.2" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt"><math id="S4.T1.m2" class="ltx_Math" alttext="\mathbb{E}\left[\mathsf{Var}(r(X_{0})|X_{t_{n}})\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>𝖵𝖺𝗋</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">|</mo><msub><mi>X</mi><msub><mi>t</mi><mi>n</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\mathsf{Var}(r(X_{0})|X_{t_{n}})\right]</annotation></semantics></math></th></tr>
