<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">Figure 1: </span>Law of <math id="S4.F1.m2" class="ltx_Math" alttext="\hat{r}(X_{t})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>r</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{r}(X_{t})</annotation></semantics></math></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
