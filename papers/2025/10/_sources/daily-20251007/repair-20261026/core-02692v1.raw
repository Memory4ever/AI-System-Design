<td id="A5.T16.2.1.2" class="ltx_td ltx_align_center ltx_border_tt"><math id="A5.T16.m1" class="ltx_Math" alttext="10" display="inline" intent=":literal"><semantics><mn>10</mn><annotation encoding="application/x-tex">10</annotation></semantics></math></td></tr>
<tr id="A5.T16.2.2" class="ltx_tr">
<th id="A5.T16.2.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">Image Resolution</th>
<td id="A5.T16.2.2.2" class="ltx_td ltx_align_center"><math id="A5.T16.m2" class="ltx_Math" alttext="768\times 768" display="inline" intent=":literal"><semantics><mrow><mn>768</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>768</mn></mrow><annotation encoding="application/x-tex">768\times 768</annotation></semantics></math></td></tr>
