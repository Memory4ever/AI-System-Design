<td id="A5.T16.2.3.2" class="ltx_td ltx_align_center"><math id="A5.T16.m3" class="ltx_Math" alttext="8" display="inline" intent=":literal"><semantics><mn>8</mn><annotation encoding="application/x-tex">8</annotation></semantics></math></td></tr>
