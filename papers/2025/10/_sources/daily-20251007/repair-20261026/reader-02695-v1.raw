<td id="S5.T2.4.4.3" class="ltx_td ltx_align_center ltx_border_bb"><math id="S5.T2.m10" class="ltx_Math" alttext="2.68\!\pm\!1.01" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>1.01</mn></mrow><annotation encoding="application/x-tex">2.68\!\pm\!1.01</annotation></semantics></math></td></tr>
