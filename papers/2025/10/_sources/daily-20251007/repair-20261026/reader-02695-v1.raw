<p id="S5.F4.sf4.2" class="ltx_p"><span id="S5.F4.sf4.2.1" class="ltx_text ltx_align_right ltx_inline-block" style="width:0.0pt;position:relative; bottom:99.4pt;">
<span id="S5.F4.sf4.2.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:8.8pt;height:33.3pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:33.3pt;transform:translate(-12.2pt,-12.2pt) rotate(-90deg) ;">
<span id="S5.F4.sf4.2.1.1.1" class="ltx_p"><span id="S5.F4.sf4.2.1.1.1.1" class="ltx_text">Density</span></span>
</span></span></span><span class="ltx_inline-block"><svg id="S5.F4.sf4.pic1" class="ltx_picture" height="356.13" overflow="visible" version="1.1" viewBox="0 0 550 356.13" width="550"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,356.13) matrix(1 0 0 -1 0 0) translate(275,0) translate(0,184.25)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -275 -171.87)"><foreignObject style="--ltx-fo-width:39.75em;--ltx-fo-height:24.84em;--ltx-fo-depth:0em;font-size:10pt;" height="343.75" overflow="visible" transform="matrix(1 0 0 -1 0 343.75)" width="550.01"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><object type="image/svg+xml" data="2510.02695v1/compare_velocity_halfcheetah-medium-expert-v2.svg" id="S5.F4.sf4.pic1.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:548/343;" width="548" height="343"></object></span></span></foreignObject></g><g stroke-width="0.35pt"><path style="fill:none" d="M -274.45 -171.32 M -274.45 -171.32 L -274.45 171.32 L 274.45 171.32 L 274.45 -171.32 Z M 274.45 171.32"></path></g><path style="fill:none" d="M -270.6 -171.32 L -270.6 -174.09"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -274.58 -184.25)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.56em;--ltx-fo-depth:0em;font-size:11.5pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="7.96"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F4.sf4.pic1.1" class="ltx_text ltx_font_bold">0</span></span></span></foreignObject></g><path style="fill:none" d="M -82.33 -171.32 L -82.33 -174.09"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="m