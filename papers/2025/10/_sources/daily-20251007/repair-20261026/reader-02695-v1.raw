<td id="S5.T2.4.3.3" class="ltx_td ltx_align_center"><math id="S5.T2.m8" class="ltx_Math" alttext="10.84\!\pm\!1.98" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>1.98</mn></mrow><annotation encoding="application/x-tex">10.84\!\pm\!1.98</annotation></semantics></math></td></tr>
