<th id="S5.T2.4.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T2.4.1.2.1" class="ltx_text ltx_font_bold">RADAC (ours)</span></th>
<th id="S5.T2.4.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T2.4.1.3.1" class="ltx_text ltx_font_bold">ORAAC</span></th></tr>
</thead>
<tbody class="ltx_tbody">
