<td id="S5.T2.4.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T2.m6" class="ltx_Math" alttext="6.15\!\pm\!1.5" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>1.5</mn></mrow><annotation encoding="application/x-tex">6.15\!\pm\!1.5</annotation></semantics></math></td></tr>
