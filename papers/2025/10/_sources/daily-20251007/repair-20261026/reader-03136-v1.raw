<td id="S5.T2.2.1.16.7" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:2pt;padding-bottom:2pt;">68.49</td>
<td id="S5.T2.2.1.16.8" class="ltx_td ltx_align_center" style="padding-top:2pt;padding-bottom:2pt;">6.05</td>
<td id="S5.T2.2.1.16.9" class="ltx_td ltx_align_center" style="padding-top:2pt;padding-bottom:2pt;">14.47</td>
<td id="S5.T2.2.1.16.10" class="ltx_td ltx_align_center" style="padding-top:2pt;padding-bottom:2pt;">74.98</td>
<td id="S5.T2.2.1.16.11" class="ltx_td ltx_align_center" style="padding-top:2pt;padding-bottom:2pt;">5.46</td>
<td id="S5.T2.2.1.16.12" class="ltx_td ltx_align_center" style="padding-top:2pt;padding-bottom:2pt;"><span id="S5.T2.2.1.16.12.1" class="ltx_text ltx_font_bold">16.36</span></td>
<td id="S5.T2.2.1.16.13" class="ltx_td ltx_align_center" style="padding-top:2pt;padding-bottom:2pt;">70.45</td></tr>
