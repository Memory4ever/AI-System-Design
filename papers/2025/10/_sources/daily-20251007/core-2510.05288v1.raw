            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l20.1" class="ltx_text" style="font-size:80%;">20:</span></span>
            
            
            append <math id="alg1.l20.m1" class="ltx_Math" alttext="\mathrm{PreNorms}_{i}/\max(1,\mathrm{Sizes}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>PreNorms</mi><mi>i</mi></msub><mo>/</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msub><mi>Sizes</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{PreNorms}_{i}/\max(1,\mathrm{Sizes}_{i})</annotation></semantics></math> to <math id="alg1.l20.m2" class="ltx_Math" alttext="\mathcal{U}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒰</mi><annotation encoding="application/x-tex">\mathcal{U}</annotation></semantics></math>; keep last <math id="alg1.l20.m3" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>

</div>
