</div>
<div id="alg1.l22" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l22.1" class="ltx_text" style="font-size:80%;">22:</span></span>
            
            
            <math id="alg1.l22.m1" class="ltx_Math" alttext="C\leftarrow\mathrm{clip}(P_{q}(\mathcal{U}),\,C_{\min},\,C_{\max})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo stretchy="false">←</mo><mrow><mi>clip</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>P</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>C</mi><mi>min</mi></msub><mo>,</mo><msub><mi>C</mi><mi>max</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C\leftarrow\mathrm{clip}(P_{q}(\mathcal{U}),\,C_{\min},\,C_{\max})</annotation></semantics></math> <span id="alg1.l22.3" class="ltx_text" style="float:right;"><math id="alg1.l22.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Adaptive clipping update
</span>
</div>
<div id="alg1.l23" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l23.1" class="ltx_text" style="font-size:80%;">23:</span></span>
            
            
