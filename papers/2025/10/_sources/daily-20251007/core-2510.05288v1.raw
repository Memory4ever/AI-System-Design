</div>
<div id="alg1.l24" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l24.1" class="ltx_text" style="font-size:80%;">24:</span></span>
            
            
             <math id="alg1.l24.m1" class="ltx_math_unparsed" alttext="\gamma\leftarrow\min(\gamma_{\max},\,\gamma\,\uparrow)" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo stretchy="false">←</mo><mi>min</mi><mrow><mo stretchy="false">(</mo><msub><mi>γ</mi><mi>max</mi></msub><mo rspace="0.337em">,</mo><mi>γ</mi><mo lspace="0.448em" rspace="0em" stretchy="false">↑</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma\leftarrow\min(\gamma_{\max},\,\gamma\,\uparrow)</annotation></semantics></math> <span id="alg1.l24.3" class="ltx_text" style="float:right;"><math id="alg1.l24.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> LR nudge up
</span>
</div>
<div id="alg1.l25" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l25.1" class="ltx_text" style="font-size:80%;">25:</span></span>
            
            
            <span id="alg1.l25.3" class="ltx_text ltx_font_bold">else</span> <span id="alg1.l25.4" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l25.m1" class="ltx_Math" alttext="\rho&gt;\rho_{\text{high}}" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>&gt;</mo><msub><mi>ρ</mi><mtext>high</mtext></msub></mrow><annotation encoding="application/x-tex">\rho&gt;\rho_{\text{high}}</annotation></semantics></math> <span id="alg1.l25.5" class="ltx_text ltx_font_bold">then</span> 
