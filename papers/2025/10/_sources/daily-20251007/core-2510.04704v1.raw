<td id="S4.T2.4.4.1" class="ltx_td ltx_align_left"><span id="S4.T2.4.4.1.1" class="ltx_text ltx_font_typewriter">move_towards</span></td>
<td id="S4.T2.4.4.2" class="ltx_td ltx_align_center">98.00</td>
