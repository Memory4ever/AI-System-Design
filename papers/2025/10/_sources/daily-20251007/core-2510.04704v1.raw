<tr id="S4.T2.4.3" class="ltx_tr">
<td id="S4.T2.4.3.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T2.4.3.1.1" class="ltx_text ltx_font_typewriter">move</span></td>
<td id="S4.T2.4.3.2" class="ltx_td ltx_align_center ltx_border_t">100.00</td>
