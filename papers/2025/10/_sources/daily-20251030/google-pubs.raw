          <a class="row-card__heading glue-link" href=https://research.google/pubs/livesvg-zero-shot-svg-animation-via-video-generation/ >
            
              LiveSVG: Zero-Shot SVG Animation via Video Generation
            
          </a>
        
        <div class="row-card__subheading">
          
            
              
                
                  
                    <div class="row-card__subheading__item small-text">
                      
                        Matan Levy
                      
                    </div>
                
              
            
              
                
                  
                    <div class="row-card__subheading__spacer"></div>
