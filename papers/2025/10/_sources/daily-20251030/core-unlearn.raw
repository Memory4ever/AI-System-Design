</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#7FB2D5;" stroke="#7FB2D5" stroke-width="1.0pt"><path style="fill:none" d="M -109.87 0 L -113.81 0 L -113.81 27.56 L -117.52 27.56"></path></g><g style="--ltx-stroke-color:#7FB2D5;--ltx-fill-color:#B3D1E7;" fill="#B3D1E7" stroke="#7FB2D5" stroke-width="1.0pt"><path d="M -122.36 -10.69 L -161.1 -10.69 C -163.4 -10.69 -165.26 -12.55 -165.26 -14.84 L -165.26 -24.53 C -165.26 -26.82 -163.4 -28.68 -161.1 -28.68 L -122.36 -28.68 C -120.07 -28.68 -118.21 -26.82 -118.21 -24.53 L -118.21 -14.84 C -118.21 -12.55 -120.07 -10.69 -122.36 -10.69 Z M -165.26 -28.68"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="1.0pt" transform="matrix(1.0 0.0 0.0 1.0 -161.1 -21.36)"><foreignObject style="--ltx-fo-width:3.29em;--ltx-fo-height:0.42em;--ltx-fo-depth:0.12em;font-size:8pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.7)" width="36.42"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S4.F6.pic1.9" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:3.29em;">
