<td id="S3.T3.3.1.2" class="ltx_td ltx_align_left ltx_border_tt" style="padding-top:0.4pt;padding-bottom:0.4pt;"><span id="S3.T3.3.1.2.1" class="ltx_text" style="font-size:70%;">Method</span></td>
<td id="S3.T3.3.1.3" class="ltx_td ltx_align_left ltx_border_tt" style="padding-top:0.4pt;padding-bottom:0.4pt;"><span id="S3.T3.3.1.3.1" class="ltx_text" style="font-size:70%;">Description</span></td></tr>
