h></g><g style="--ltx-stroke-color:#000000;" stroke="#000000"><path style="fill:none" d="M 182.73 123.68 L 171.6 123.68 L 171.6 112.54 L 182.73 112.54 Z"></path></g><g style="--ltx-stroke-color:#000000;" stroke="#000000"><path style="fill:none" d="M 202.42 123.68 L 191.28 123.68 L 191.28 112.54 L 202.42 112.54 Z"></path></g><g style="--ltx-stroke-color:#000000;" stroke="#000000"><path style="fill:none" d="M 222.1 123.68 L 210.97 123.68 L 210.97 112.54 L 222.1 112.54 Z"></path></g></g><g stroke-width="1.0pt"><path style="fill:none" d="M 55.8 118.11 L 141.05 118.11"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.8pt" transform="matrix(-1.0 0.0 0.0 -1.0 55.8 118.11)"><path style="fill:none" d="M -2.41 3.21 C -2.21 2.01 0 0.2 0.6 0 C 0 -0.2 -2.21 -2.01 -2.41 -3.21"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 141.05 118.11)"><path style="fill:none" d="M -2.41 3.21 C -2.21 2.01 0 0.2 0.6 0 C 0 -0.2 -2.21 -2.01 -2.41 -3.21"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 67.15 128.03)"><foreignObject style="--ltx-fo-width:3.95em;--ltx-fo-height:0.8em;--ltx-fo-depth:0.4em;font-size:10pt;" height="16.6" overflow="visible" transform="matrix(1 0 0 -1 0 11.07)" width="54.71"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
