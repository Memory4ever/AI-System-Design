;" fill="#000000" stroke="#000000" stroke-width="1.0pt" transform="matrix(1.0 0.0 0.0 1.0 -269.68 84.96)"><foreignObject style="--ltx-fo-width:11.1em;--ltx-fo-height:0.83em;--ltx-fo-depth:6em;font-size:10pt;" height="94.55" overflow="visible" transform="matrix(1 0 0 -1 0 11.53)" width="153.59"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
