<br class="ltx_break"></span></span>
</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#BFBCDA;--ltx-fill-color:#F2F2F8;" fill="#F2F2F8" stroke="#BFBCDA" stroke-width="1.0pt"><path d="M 5.91 118.31 L -96.46 118.31 C -100.28 118.31 -103.37 115.21 -103.37 111.39 L -103.37 -87.77 C -103.37 -91.59 -100.28 -94.69 -96.46 -94.69 L 5.91 -94.69 C 9.73 -94.69 12.82 -91.59 12.82 -87.77 L 12.82 111.39 C 12.82 115.21 9.73 118.31 5.91 118.31 Z M -103.37 -94.69"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="1.0pt" transform="matrix(1.0 0.0 0.0 1.0 -96.46 99.86)"><foreignObject style="--ltx-fo-width:7.4em;--ltx-fo-height:0.83em;--ltx-fo-depth:13.56em;font-size:10pt;" height="199.16" overflow="visible" transform="matrix(1 0 0 -1 0 11.53)" width="102.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
