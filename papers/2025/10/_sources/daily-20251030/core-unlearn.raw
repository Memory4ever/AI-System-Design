<table id="S3.F4.pic1.6" class="ltx_tabular ltx_align_middle">
<tr id="S3.F4.pic1.6.1" class="ltx_tr">
<td id="S3.F4.pic1.6.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S3.F4.pic1.6.1.1.1" class="ltx_text" style="font-size:70%;">Target</span></td></tr>
