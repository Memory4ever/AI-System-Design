<td id="S8.T5.2.1.3.1" class="ltx_td ltx_align_left" style="padding-top:0.75pt;padding-bottom:0.75pt;">Enc2Enc</td>
<td id="S8.T5.2.1.3.2" class="ltx_td ltx_align_center" style="padding-top:0.75pt;padding-bottom:0.75pt;"><math id="S8.T5.m4" class="ltx_Math" alttext="0.55" display="inline" intent=":literal"><semantics><mn>0.55</mn><annotation encoding="application/x-tex">0.55</annotation></semantics></math> <span id="S8.T5.2.1.3.2.1" class="ltx_text" style="font-size:90%;">(p=0.01)</span></td>
<td id="S8.T5.2.1.3.3" class="ltx_td ltx_align_center" style="padding-top:0.75pt;padding-bottom:0.75pt;"><math id="S8.T5.m5" class="ltx_Math" alttext="0.66" display="inline" intent=":literal"><semantics><mn>0.66</mn><annotation encoding="application/x-tex">0.66</annotation></semantics></math> <span id="S8.T5.2.1.3.3.1" class="ltx_text" style="font-size:90%;">(p=0.04)</span></td>
<td id="S8.T5.2.1.3.4" class="ltx_td ltx_align_center" style="padding-top:0.75pt;padding-bottom:0.75pt;"><math id="S8.T5.m6" class="ltx_Math" alttext="\underline{0.38}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mn>0.38</mn><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{0.38}</annotation></semantics></math> <span id="S8.T5.2.1.3.4.1" class="ltx_text" style="font-size:90%;">(p=0.64)</span></td></tr>
