<td id="A1.T14.4.1.4.2" class="ltx_td ltx_align_center" style="padding-top:0.7pt;padding-bottom:0.7pt;"><math id="A1.T14.m2" class="ltx_Math" alttext="0.0" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">0.0</mn><annotation encoding="application/x-tex">0.0</annotation></semantics></math></td></tr>
<tr id="A1.T14.4.1.5" class="ltx_tr">
<td id="A1.T14.4.1.5.1" class="ltx_td ltx_align_left" style="padding-top:0.7pt;padding-bottom:0.7pt;"><span id="A1.T14.4.1.5.1.1" class="ltx_text" style="font-size:90%;">Learning rate</span></td>
<td id="A1.T14.4.1.5.2" class="ltx_td ltx_align_center" style="padding-top:0.7pt;padding-bottom:0.7pt;"><math id="A1.T14.m3" class="ltx_Math" alttext="0.1" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">0.1</mn><annotation encoding="application/x-tex">0.1</annotation></semantics></math></td></tr>
