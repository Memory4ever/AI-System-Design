<td id="A1.T14.4.1.3.2" class="ltx_td ltx_align_center" style="padding-top:0.7pt;padding-bottom:0.7pt;"><span id="A1.T14.4.1.3.2.1" class="ltx_text" style="font-size:90%;">SGD (momentum </span><math id="A1.T14.m1" class="ltx_Math" alttext="0.9" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">0.9</mn><annotation encoding="application/x-tex">0.9</annotation></semantics></math><span id="A1.T14.4.1.3.2.2" class="ltx_text" style="font-size:90%;">)</span></td></tr>
