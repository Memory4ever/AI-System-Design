<td id="A1.T14.4.1.7.2" class="ltx_td ltx_align_center" style="padding-top:0.7pt;padding-bottom:0.7pt;"><math id="A1.T14.m5" class="ltx_Math" alttext="128" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">128</mn><annotation encoding="application/x-tex">128</annotation></semantics></math></td></tr>
<tr id="A1.T14.4.1.8" class="ltx_tr">
