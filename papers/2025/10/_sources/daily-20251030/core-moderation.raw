<li class="ltx_tocentry ltx_tocentry_section"><a href="#S6" title="In Agentic Moderation: Multi-Agent Design for Safer Vision-Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">VI </span><span class="ltx_text ltx_font_smallcaps">Conclusion</span></span></a></li>
<li class="ltx_tocentry ltx_tocentry_bibliography"><a href="#bib" title="In Agentic Moderation: Multi-Agent Design for Safer Vision-Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title">References</span></a></li>
</ol></nav>
</nav>
<div class="ltx_page_main">
<div id="infobox" class="infobox">
  <a id="license-tr" href="https://info.arxiv.org/help/license/index.html#licenses-available">
    License: CC BY 4.0
