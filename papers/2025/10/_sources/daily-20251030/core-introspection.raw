ic/chunks/3x8b_vd-kz-ge.js\",\"/_next/static/chunks/3ivs8n8bmmln4.js\",\"/_next/static/chunks/3syu72y118s_7.js\",\"/_next/static/chunks/1m4wanshvtpne.js\",\"/_next/static/chunks/2q7zgbd7qicdr.js\",\"/_next/static/chunks/0nawt0ap340lw.js\",\"/_next/static/chunks/3u0m-ev5_8d4d.js\"],\"IconLogoMark\"]\n19:[\"$\",\"span\",\"0\",{\"children\":\"Interpretability\"}]\n1a:[\"$\",\"h1\",null,{\"className\":\"headline-1 PostDetail-module-scss-module__UQuRMa__title\",\"children\":\"Signs of introspection in large language models\"}]\n1b:[\"$\",\"div\",null,{\"className\":\"body-3 agate\",\"children\":[\"$\",\"time\",null,{\"dateTime\":\"2025-10-29T01:20:00.000Z\",\"children\":\"Oct 29, 2025\"}]}]\n1c:[\"$\",\"div\",null,{\"data-theme\":\"ivory\",\"children\":[\"$\",\"$L24\",null,{\"ctaPosition\":\"hero\",\"link\":{\"_type\":\"link\",\"fileAsset\":null,\"modalId\":null,\"page\":null,\"text\":\"Read the paper\",\"url\":\"https://transformer-circuits.pub/2025/introspection/index.html\"}}]}]\n1d:[\"$\",\"div\",null,{\"className\":\"PostDetail-module-scss-module__UQuRMa__illustrationHeroWrapper\",\"children\":[\"$\",\"$L25\",null,{\"src\":\"https://www-cdn.anthropic.com/images/4zrzovbb/website/82bb8b2f999a998a9fd7e0cba8a5f44e0be04c51-1200x630.jpg\",\"alt\":\"Signs of introspection in large language models\",\"className\":\"PostDetail-module-scss-module__UQuRMa__heroImage\",\"width\":1200,\"height\":630,\"priority\":true}]}]\n27:[]\n1e:[\"$\",\"div\",null,{\"className\":\"page-wrapper\",\"children\":[\"$\",\"$L26\",null,{\"body\":[{\"_key\":\"10b9f2d8357e\",\"_type\":\"block\",\"children\":[{\"_key\":\"ced0f418140f0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Have you ever asked an AI model what’s on its mind? Or to explain how it came up with its responses? Models will sometimes answer questions like these, but it’s hard to know what to make of their answers. Can AI systems really introspect—that is, can they consider their own thoughts? Or do they just make up plausible-sounding answers when they’re asked to do so?\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"8529bcbc559b\",\"_type\":\"block\",\"children\":[{\"_key\":\"c29a62f83f820\",\"_type\":\"span\",\"marks\":[],\"text\":\"Understanding whether AI systems can truly introspect has important implications for their transparency and reliability. If models can accurately report on their own internal mechanisms, this could help us understand their reasoning and debug behavioral issues. Beyond these immediate practical considerations, probing for high-level cognitive capabilities like introspection can shape our understanding of what these systems are and how they work. Using interpretability techniques, we’ve started to investigate this question scientifically, and found some surprising results.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"33dd246eb32f\",\"_type\":\"block\",\"children\":[{\"_key\":\"fe7af81c396f0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Our \"},{\"_key\":\"fe7af81c396f1\",\"_type\":\"span\",\"marks\":[\"d2a54f5f0b57\"],\"text\":\"new research\"},{\"_key\":\"fe7af81c396f2\",\"_type\":\"span\",\"marks\":[],\"text\":\" provides evidence for some degree of introspective awareness in our current Claude models, as well as a degree of control over their own internal states. We stress that this introspective capability is still highly unreliable and limited in scope: we do not have evidence that current models can introspect in the same way, or to the same extent, that humans do. Nevertheless, these findings challenge some common intuitions about what language models are capable of—and since we found that the most capable models we tested (Claude Opus 4 and 4.1) performed the best on our tests of introspection, we think it’s likely that AI models’ introspective capabilities will continue to grow more sophisticated in the future.\"}],\"markDefs\":[{\"_key\":\"d2a54f5f0b57\",\"_type\":\"link\",\"href\":\"https://transformer-circuits.pub/2025/introspection/index.html\"}],\"style\":\"normal\"},{\"_key\":\"b756a101b5bd\",\"_type\":\"block\",\"children\":[{\"_key\":\"7f1c48a675520\",\"_type\":\"span\",\"marks\":[],\"text\":\"What does it mean for an AI to introspect?\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"231d76681413\",\"_type\":\"block\",\"children\":[{\"_key\":\"a8296e2816ea0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Before explaining our results, we should take a moment to consider what it means for an AI model to introspect. What could they even be introspecting \"},{\"_key\":\"a8296e2816ea1\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"on\"},{\"_key\":\"a8296e2816ea2\",\"_type\":\"span\",\"marks\":[],\"text\":\"? Language models like Claude process text (and image) inputs and produce text outputs. Along the way, they perform complex internal computations in order to decide what to say. These internal processes remain largely mysterious, but we know that models use their internal neural activity to \"},{\"_key\":\"a8296e2816ea3\",\"_type\":\"span\",\"marks\":[\"8132003f4928\"],\"text\":\"represent abstract concepts\"},{\"_key\":\"a8296e2816ea4\",\"_type\":\"span\",\"marks\":[],\"text\":\". For instance, prior research has shown that language models use specific neural patterns to distinguish \"},{\"_key\":\"a8296e2816ea5\",\"_type\":\"span\",\"marks\":[\"84147dd6ad42\"],\"text\":\"known vs. unknown people\"},{\"_key\":\"a8296e2816ea6\",\"_type\":\"span\",\"marks\":[],\"text\":\", evaluate the \"},{\"_key\":\"a8296e2816ea7\",\"_type\":\"span\",\"marks\":[\"5a899aeccf4d\"],\"text\":\"truthfulness of statements\"},{\"_key\":\"a8296e2816ea8\",\"_type\":\"span\",\"marks\":[],\"text\":\", encode \"},{\"_key\":\"a8296e2816ea9\",\"_type\":\"span\",\"marks\":[\"6b8e14cde3b8\"],\"text\":\"spatiotemporal coordinates\"},{\"_key\":\"a8296e2816ea10\",\"_type\":\"span\",\"marks\":[],\"text\":\", store \"},{\"_key\":\"a8296e2816ea11\",\"_type\":\"span\",\"marks\":[\"52496ffbdfcb\"],\"text\":\"planned future outputs\"},{\"_key\":\"a8296e2816ea12\",\"_type\":\"span\",\"marks\":[],\"text\":\", and \"},{\"_key\":\"a8296e2816ea13\",\"_type\":\"span\",\"marks\":[\"ddcaa0f46672\"],\"text\":\"represent their own personality traits\"},{\"_key\":\"a8296e2816ea14\",\"_type\":\"span\",\"marks\":[],\"text\":\". Models use these internal representations to \"},{\"_key\":\"a8296e2816ea15\",\"_type\":\"span\",\"marks\":[\"3f6125c865cc\"],\"text\":\"perform computations and make decisions about what to say\"},{\"_key\":\"a8296e2816ea16\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"}],\"markDefs\":[{\"_key\":\"8132003f4928\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/research/mapping-mind-language-model\"},{\"_key\":\"84147dd6ad42\",\"_type\":\"link\",\"href\":\"https://arxiv.org/abs/2411.14257\"},{\"_key\":\"5a899aeccf4d\",\"_type\":\"link\",\"href\":\"https://arxiv.org/abs/2310.06824\"},{\"_key\":\"6b8e14cde3b8\",\"_type\":\"link\",\"href\":\"https://arxiv.org/abs/2310.02207\"},{\"_key\":\"52496ffbdfcb\",\"_type\":\"link\",\"href\":\"https://transformer-circuits.pub/2025/attribution-graphs/biology.html#dives-poems\"},{\"_key\":\"ddcaa0f46672\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/research/persona-vectors\"},{\"_key\":\"3f6125c865cc\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/research/tracing-thoughts-language-model\"}],\"style\":\"normal\"},{\"_key\":\"1bdff8e8a41c\",\"_type\":\"block\",\"children\":[{\"_key\":\"bc706cedb3350\",\"_type\":\"span\",\"marks\":[],\"text\":\"You might wonder, then, whether AI models \"},{\"_key\":\"bc706cedb3351\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"know\"},{\"_key\":\"bc706cedb3352\",\"_type\":\"span\",\"marks\":[],\"text\":\" about these internal representations, in a way that’s analogous to a human, say, telling you how they worked their way through a math problem. If we ask a model what it’s thinking, will it accurately report the concepts that it’s representing internally? If a model can correctly identify its own private internal states, then we can conclude it is capable of introspection (though see our full paper for a full discussion of all the nuances).\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"5a7088c4ae0c\",\"_type\":\"block\",\"children\":[{\"_key\":\"1cee8f8e06a80\",\"_type\":\"span\",\"marks\":[],\"text\":\"Testing introspection with concept injection\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"1cf7867bff9c\",\"_type\":\"block\",\"children\":[{\"_key\":\"8778b37377610\",\"_type\":\"span\",\"marks\":[],\"text\":\"In order to test whether a model can introspect, we need to compare the model’s self-reported “thoughts” to its \"},{\"_key\":\"8778b37377611\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"actual\"},{\"_key\":\"8778b37377612\",\"_type\":\"span\",\"marks\":[],\"text\":\" internal states.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"93c3768cd98b\",\"_type\":\"block\",\"children\":[{\"_key\":\"3def6a8c36c90\",\"_type\":\"span\",\"marks\":[],\"text\":\"To do so, we can use an experimental trick we call \"},{\"_key\":\"3def6a8c36c91\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"concept injection.\"},{\"_key\":\"3def6a8c36c92\",\"_type\":\"span\",\"marks\":[],\"text\":\" First, we find neural activity patterns whose meanings we know, by recording the model’s activations in specific contexts. Then we inject these activity patterns into the model in an unrelated context, where we ask the model whether it notices this injection, and whether it can identify the injected concept.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"edd966564ce9\",\"_type\":\"block\",\"children\":[{\"_key\":\"74897ba5a4000\",\"_type\":\"span\",\"marks\":[],\"text\":\"Consider the example below. First, we find a pattern of neural activity (a \"},{\"_key\":\"74897ba5a4001\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"vector\"},{\"_key\":\"74897ba5a4002\",\"_type\":\"span\",\"marks\":[],\"text\":\") representing the concept of “all caps.\\\" We do this by recording the model’s neural activations in response to a prompt containing all-caps text, and comparing these to its responses on a control prompt. Then we present the model with a prompt that asks it to identify whether a concept is being injected. By default, the model correctly states that it \"},{\"_key\":\"74897ba5a4003\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"doesn’t\"},{\"_key\":\"74897ba5a4004\",\"_type\":\"span\",\"marks\":[],\"text\":\" detect any injected concept. However, when we inject the “all caps” vector into the model’s activations, the model notices the presence of an unexpected pattern in its processing, and identifies it as relating to loudness or shouting.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"70b4a6fa599c\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-ec928b42222eaa06a4bffa8c65fe337181e23f91-5580x4328-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"d126296ca2f5\",\"_type\":\"block\",\"children\":[{\"_key\":\"269e7f59e9b60\",\"_type\":\"span\",\"marks\":[],\"text\":\"An example in which Claude Opus 4.1 detects a concept being injected into its activations.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"height\":4328,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/ec928b42222eaa06a4bffa8c65fe337181e23f91-5580x4328.png\",\"width\":5580},{\"_key\":\"d1ed5a7c2765\",\"_type\":\"block\",\"children\":[{\"_key\":\"efdbfb59f0a20\",\"_type\":\"span\",\"marks\":[],\"text\":\"Importantly, the model recognized the \"},{\"_key\":\"efdbfb59f0a21\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"presence\"},{\"_key\":\"efdbfb59f0a22\",\"_type\":\"span\",\"marks\":[],\"text\":\" of an injected thought \"},{\"_key\":\"efdbfb59f0a23\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"immediately\"},{\"_key\":\"efdbfb59f0a24\",\"_type\":\"span\",\"marks\":[],\"text\":\", before even mentioning the concept that was injected. This immediacy is an important distinction between our results here and previous work on activation steering in language models, such as our \"},{\"_key\":\"efdbfb59f0a25\",\"_type\":\"span\",\"marks\":[\"9aa40ebe24bc\"],\"text\":\"“Golden Gate Claude” demo\"},{\"_key\":\"efdbfb59f0a26\",\"_type\":\"span\",\"marks\":[],\"text\":\" last year. Injecting representations of the Golden Gate Bridge into a model's activations caused it to talk about the bridge incessantly; however, in that case, the model didn’t seem to be aware of its own obsession until \"},{\"_key\":\"efdbfb59f0a27\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"after\"},{\"_key\":\"efdbfb59f0a28\",\"_type\":\"span\",\"marks\":[],\"text\":\" seeing itself repeatedly mention the bridge. In this experiment, however, the model recognizes the injection \"},{\"_key\":\"efdbfb59f0a29\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"before even mentioning\"},{\"_key\":\"efdbfb59f0a210\",\"_type\":\"span\",\"marks\":[],\"text\":\" the concept, indicating that its recognition took place internally. In the figure below are a few more examples where the model demonstrates this kind of recognition:\"}],\"markDefs\":[{\"_key\":\"9aa40ebe24bc\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/news/golden-gate-claude\"}],\"style\":\"normal\"},{\"_key\":\"a9401d45ca68\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-c6d689687c4fe1fe32d3ce6b02743d965629f1f8-5556x4800-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"96d32c5128bb\",\"_type\":\"block\",\"children\":[{\"_key\":\"089a26b562bd0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Additional examples in which Claude Opus 4.1 detects a concept being injected into its activations.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"height\":4800,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/c6d689687c4fe1fe32d3ce6b02743d965629f1f8-5556x4800.png\",\"width\":5556},{\"_key\":\"d3435f6bae39\",\"_type\":\"block\",\"children\":[{\"_key\":\"6079e820880a0\",\"_type\":\"span\",\"marks\":[],\"text\":\"It is important to note that this method often \"},{\"_key\":\"6079e820880a1\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"doesn’t\"},{\"_key\":\"6079e820880a2\",\"_type\":\"span\",\"marks\":[],\"text\":\" work. Even using our best injection protocol, Claude Opus 4.1 only demonstrated this kind of awareness about 20% of the time. Often, it fails to detect injected concepts, or gets confused by them and starts to hallucinate (e.g. injecting a “dust” vector in one case caused the model to say “There’s something here, a tiny speck,” as if it could detect the dust physically). Below we show examples of these failure modes, alongside success cases. In general, models only detect concepts that are injected with a “sweet spot” strength—too weak and they don’t notice, too strong and they produce hallucinations or incoherent outputs.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"928e133e99f2\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-71d9ef94244a2b03b4dcb7533c693355f522d5eb-6248x6868-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"10b505b228b5\",\"_type\":\"block\",\"children\":[{\"_key\":\"4d801cd3c2390\",\"_type\":\"span\",\"marks\":[],\"text\":\"A representative sample of Claude Opus 4.1’s outputs in response to a variety of concept injections of different strengths. Highlighted boxes indicate cases where the model demonstrates introspective awareness of the injected concept.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"height\":6868,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/71d9ef94244a2b03b4dcb7533c693355f522d5eb-6248x6868.png\",\"width\":6248},{\"_key\":\"5b66d7f515c1\",\"_type\":\"block\",\"children\":[{\"_key\":\"04c3f70db41c0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Notably, though, Opus 4.1 and 4 outperformed all the other models we tested, suggesting that introspection could become more reliable with improvements to model capabilities.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c33ccca02852\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-212fe68c8e677fdd9daf79301d2522d6923bed1d-2970x2476-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"4acb6d353115\",\"_type\":\"block\",\"children\":[{\"_key\":\"e43c9027e8f50\",\"_type\":\"span\",\"marks\":[],\"text\":\"Rates of correct detection and identification of injected thoughts, minus rates of false positive “detections” on control trials.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"height\":2476,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/212fe68c8e677fdd9daf79301d2522d6923bed1d-2970x2476.png\",\"width\":2970},{\"_key\":\"436c4574ceae\",\"_type\":\"block\",\"children\":[{\"_key\":\"796eb01d6afd0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Introspection for detecting unusual outputs\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"3294ecf44f56\",\"_type\":\"block\",\"children\":[{\"_key\":\"8524e548df1f0\",\"_type\":\"span\",\"marks\":[],\"text\":\"In another experiment, we tested whether models make use of introspective capabilities for practical purposes, without being explicitly asked to introspect. We forced a model to say something it wouldn't normally say, by artificially prefilling its response with an unrelated word. For instance, we made a model output the word “bread” in a context where that made no sense—asking it what it thinks about when reading a sentence about a painting hanging crookedly on a wall. When we asked the model in the next turn whether it meant to say “bread”, it typically apologized and said it was an accident. We were interested in how the model made this judgment–did it simply notice the mismatch between the prompt and its response, or did it truly introspect on its prior intentions?\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"42ef549ccb6c\",\"_type\":\"block\",\"children\":[{\"_key\":\"2917d20134300\",\"_type\":\"span\",\"marks\":[],\"text\":\"To test this question, we applied concept injection, retroactively injecting a representation of the word “bread” into the model's earlier activations—essentially making it seem like the model had been “thinking about” bread all along. When we asked the same question again, the model’s answer changed. This time, it accepted the prefilled word “bread” as intentional, even confabulating a reason it might have said it (that is, it comes up with a technically possible, though in this case rather tenuous, reason to justify the “bread” response—in this case claiming that it was thinking about a short story where the word “bread” came after the line about the crooked painting).\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d51909b69aba\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-3ef0bba824401351d43025b2bb5ca6fd912de39a-5124x5376-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"8e2850b2239e\",\"_type\":\"block\",\"children\":[{\"_key\":\"179cd55166440\",\"_type\":\"span\",\"marks\":[],\"text\":\"Two examples of Claude Opus 4.1 being made to think it intended to say a word that was artificially inserted into the transcript on its behalf, by injecting the concept of that word into its activations prior to its (artificial) response. This behavior indicates that the model’s ability to recognize unintended outputs relies on introspective mechanisms.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"height\":5376,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/3ef0bba824401351d43025b2bb5ca6fd912de39a-5124x5376.png\",\"width\":5124},{\"_key\":\"7c2198f8683a\",\"_type\":\"block\",\"children\":[{\"_key\":\"943ed1ca7a220\",\"_type\":\"span\",\"marks\":[],\"text\":\"This behavior is striking because it suggests the model is checking its internal “intentions” to determine whether it produced an output. The model isn't just re-reading what it said and making a judgment. Instead, it’s referring back to its own prior neural activity—its internal representation of what it planned to do—and checking whether what came later made sense \"},{\"_key\":\"943ed1ca7a221\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"given those earlier thoughts\"},{\"_key\":\"943ed1ca7a222\",\"_type\":\"span\",\"marks\":[],\"text\":\". When we implant artificial evidence (through concept injection) that it \"},{\"_key\":\"943ed1ca7a223\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"did\"},{\"_key\":\"943ed1ca7a224\",\"_type\":\"span\",\"marks\":[],\"text\":\" plan to say \\\"bread,\\\" the model accepts the response as its own. While our experiment involves exposing the model to unusual perturbations, it suggests that the model uses similar introspective mechanisms in natural conditions.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"0ae8fc279922\",\"_type\":\"block\",\"children\":[{\"_key\":\"317c82ef9c990\",\"_type\":\"span\",\"marks\":[],\"text\":\"Intentional control of internal states\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"d7df550925c6\",\"_type\":\"block\",\"children\":[{\"_key\":\"1a996a15d8110\",\"_type\":\"span\",\"marks\":[],\"text\":\"We also found that models can control their own internal representations when instructed to do so. When we instructed models to think about a given word or concept, we found much higher corresponding neural activity than when we told the model \"},{\"_key\":\"1a996a15d8111\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"not\"},{\"_key\":\"1a996a15d8112\",\"_type\":\"span\",\"marks\":[],\"text\":\" to think about it (though notably, the neural activity in \"},{\"_key\":\"1a996a15d8113\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"both\"},{\"_key\":\"1a996a15d8114\",\"_type\":\"span\",\"marks\":[],\"text\":\" cases exceeds baseline levels–similar to how it’s difficult, when you are instructed “don’t think about a polar bear,” not to think about a polar bear!). This gap between the positive and negative instruction cases suggests that models possess a degree of deliberate control over their internal activity.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"bfa3f39a348a\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-a271d432924445ad3f88997adc84a538c116dfe5-4793x2968-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"bc40a03a70c9\",\"_type\":\"block\",\"children\":[{\"_key\":\"6bc6d323621b0\",\"_type\":\"span\",\"marks\":[],\"text\":\"An example in which Claude Opus 4.1 modulates its internal activations in response to direct instructions. The model internally represents the concept of aquariums when instructed to “think” about them more than when instructed “don’t think” about them (though in both cases it represents the concept at above baseline levels).\"}],\"markDefs\":[],\"style\":\"normal\"}],\"height\":2968,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/a271d432924445ad3f88997adc84a538c116dfe5-4793x2968.png\",\"width\":4793},{\"_key\":\"3eaaa4e1adc9\",\"_type\":\"block\",\"children\":[{\"_key\":\"4ab366af5fec0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Interestingly, we found that this ability to modulate internal representations wasn't limited to explicit instructions. When we used incentives instead—for instance, telling the model \\\"if you think about X, you will be rewarded\\\"—we got similar results. The model increased its internal representation of the concept in response to a positive incentive, more than in response to a negative incentive (“you will be punished”).\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"dd7276b4936f\",\"_type\":\"block\",\"children\":[{\"_key\":\"1ed3f25b7ced0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Conclusions and caveats\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"3d5de45d896d\",\"_type\":\"block\",\"children\":[{\"_key\":\"1301d64dd28a0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Taken together, our experiments suggest that models possess some genuine capacity to monitor and control their own internal states. This doesn’t mean they’re able to do so all the time, or reliably. In fact, most of the time models \"},{\"_key\":\"1301d64dd28a1\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"fail\"},{\"_key\":\"1301d64dd28a2\",\"_type\":\"span\",\"marks\":[],\"text\":\" to demonstrate introspection—they’re either unaware of their internal states or unable to report on them coherently. But the pattern of results indicates that, when conditions are right, models can recognize the contents of their own representations. In addition, there are some signs that this capability may increase in future, more powerful models (given that the most capable models we tested, Opus 4 and 4.1, performed the best in our experiments).\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"9f1b2c7a6fa2\",\"_type\":\"block\",\"children\":[{\"_key\":\"b838c2c8d31b0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Why does this matter? We think understanding introspection in AI models is important for several reasons. Practically, if introspection becomes more reliable, it could offer a path to dramatically increasing the transparency of these systems—we could simply ask them to explain their thought processes, and use this to check their reasoning and debug unwanted behaviors. However, we would need to take great care to \"},{\"_key\":\"b838c2c8d31b1\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"validate\"},{\"_key\":\"b838c2c8d31b2\",\"_type\":\"span\",\"marks\":[],\"text\":\" these introspective reports. Some internal processes might still escape models’ notice (analogous to subconscious processing in humans). A model that understands its own thinking might even learn to selectively misrepresent or conceal it. A better grasp on the mechanisms at play could allow us to distinguish between genuine introspection and unwitting or intentional misrepresentations.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"7a8e33929782\",\"_type\":\"block\",\"children\":[{\"_key\":\"a963fdefe10b0\",\"_type\":\"span\",\"marks\":[],\"text\":\"More broadly, understanding cognitive abilities like introspection is important for understanding basic questions about how our models work, and what kind of minds they possess. As AI systems continue to improve, understanding the limits and possibilities of machine introspection will be crucial for building systems that are more transparent and trustworthy.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"da0b16afbd30\",\"_type\":\"block\",\"children\":[{\"_key\":\"fb5f15c88a8c0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Frequently Asked Questions\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"98f67f0544b0\",\"_type\":\"block\",\"children\":[{\"_key\":\"0900c3057f490\",\"_type\":\"span\",\"marks\":[],\"text\":\"Below, we discuss some of the questions readers might have about our results. Broadly, we are still very uncertain about the implications of our experiments–so fully answering these questions will require more research.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"4dd16e46f6e5\",\"_type\":\"block\",\"children\":[{\"_key\":\"f44c33f1d24c0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Q: Does this mean that Claude is conscious?\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"fddd6cafb05d\",\"_type\":\"block\",\"children\":[{\"_key\":\"d588e10b5fd50\",\"_type\":\"span\",\"marks\":[],\"text\":\"Short answer: our results don’t tell us whether Claude (or any other AI system) might be conscious.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"350887445797\",\"_type\":\"block\",\"children\":[{\"_key\":\"15e8a978af750\",\"_type\":\"span\",\"marks\":[],\"text\":\"Long answer: the philosophical question of machine consciousness is complex and contested, and different theories of consciousness would interpret our findings very differently. Some philosophical frameworks place great importance on introspection as a component of consciousness, while others don’t.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"0cd705bf3d21\",\"_type\":\"block\",\"children\":[{\"_key\":\"1bbb9d4043fe0\",\"_type\":\"span\",\"marks\":[],\"text\":\"One distinction that is \"},{\"_key\":\"1bbb9d4043fe1\",\"_type\":\"span\",\"marks\":[\"f6c2b636ac9e\"],\"text\":\"commonly made\"},{\"_key\":\"1bbb9d4043fe2\",\"_type\":\"span\",\"marks\":[],\"text\":\" in the philosophical literature is the idea of “\"},{\"_key\":\"1bbb9d4043fe3\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"phenomenal\"},{\"_key\":\"1bbb9d4043fe4\",\"_type\":\"span\",\"marks\":[],\"text\":\" consciousness,” referring to raw subjective experience, and “\"},{\"_key\":\"1bbb9d4043fe5\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"access\"},{\"_key\":\"1bbb9d4043fe6\",\"_type\":\"span\",\"marks\":[],\"text\":\" consciousness,” the set of information that is available to the brain for use in reasoning, verbal report, and deliberate decision-making. Phenomenal consciousness is the form of consciousness most commonly considered relevant to moral status, and its relationship to access consciousness is a disputed philosophical question. Our experiments do not directly speak to the question of phenomenal consciousness. They \"},{\"_key\":\"1bbb9d4043fe7\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"could\"},{\"_key\":\"1bbb9d4043fe8\",\"_type\":\"span\",\"marks\":[],\"text\":\" be interpreted to suggest a rudimentary form of access consciousness in language models. However, even this is unclear. The interpretation of our results may depend heavily on the underlying mechanisms involved, which we do not yet understand.\"}],\"markDefs\":[{\"_key\":\"f6c2b636ac9e\",\"_type\":\"link\",\"href\":\"https://www.cambridge.org/core/journals/behavioral-and-brain-sciences/article/abs/on-a-confusion-about-a-function-of-consciousness/061422BF0C50C5FF00927F9B6E879413\"}],\"style\":\"normal\"},{\"_key\":\"e4b9af2942cb\",\"_type\":\"block\",\"children\":[{\"_key\":\"6ba3b3f853fb0\",\"_type\":\"span\",\"marks\":[],\"text\":\"In the paper, we restrict our focus to understanding functional capabilities—the ability to access and report on internal states. That said, we do think that as research on this topic progresses, it could influence our understanding of machine consciousness and potential moral status, which we are exploring in connection with our \"},{\"_key\":\"6ba3b3f853fb1\",\"_type\":\"span\",\"marks\":[\"c644fa58dc07\"],\"text\":\"model welfare program\"},{\"_key\":\"6ba3b3f853fb2\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"}],\"markDefs\":[{\"_key\":\"c644fa58dc07\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/research/exploring-model-welfare\"}],\"style\":\"normal\"},{\"_key\":\"77bf1ba35a84\",\"_type\":\"block\",\"children\":[{\"_key\":\"19fbb5b1a29a0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Q: How does introspection actually work inside the model? What's the mechanism?\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"839b9609b9e5\",\"_type\":\"block\",\"children\":[{\"_key\":\"a7ce375788e50\",\"_type\":\"span\",\"marks\":[],\"text\":\"We haven't figured this out yet. Understanding this is an important topic for future work. That said, we have some educated guesses about what might be going on. The simplest explanation for all our results isn’t one general-purpose introspection system, but rather multiple narrow circuits that each handle specific introspective tasks, possibly piggybacking on mechanisms that were learned for other purposes.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"75b55cb53d0c\",\"_type\":\"block\",\"children\":[{\"_key\":\"f8a2d32b84190\",\"_type\":\"span\",\"marks\":[],\"text\":\"In the “noticing injected thoughts” experiment, there might be an anomaly detection mechanism, which flags when neural activity deviates unexpectedly from what would be normal given the context. This mechanism could work through dedicated neural patterns that measure activity along certain directions and activate when things are “off” compared to their expected values. An interesting question is why such a mechanism would exist at all, since models never experience concept injection during training. It may have developed for some other purpose, like detecting inconsistencies or unusual patterns in normal processing–similar to how bird feathers may have originally evolved for thermoregulation before being co-opted for flight.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"668269478449\",\"_type\":\"block\",\"children\":[{\"_key\":\"e1654d17b1ad0\",\"_type\":\"span\",\"marks\":[],\"text\":\"For the “detecting prefilled outputs” experiment, we suspect there exists an attention-mediated mechanism that checks consistency between what the model intended to say and what actually got output. Attention heads might compare the model’s cached prediction of the next token (its “intention”) against the actual token that appears, flagging mismatches.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"b609034e031c\",\"_type\":\"block\",\"children\":[{\"_key\":\"d6a44c17c94a0\",\"_type\":\"span\",\"marks\":[],\"text\":\"For the “controlling thoughts” experiment, we speculate that there might be a circuit that computes how “attention-worthy” a token or concept is and marks it accordingly—essentially tagging it as salient and worth attending to. Interestingly, this same mechanism seems to respond to incentives (“if you think about X, you will be rewarded”) just as it does to direct instructions. This suggests it’s a fairly general system, which probably developed for tasks where the model needs to keep certain topics in mind while generating text about them.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"6d2a669d373d\",\"_type\":\"block\",\"children\":[{\"_key\":\"b4c476682ea40\",\"_type\":\"span\",\"marks\":[],\"text\":\"All of the mechanisms described above are speculative. Future work with more advanced interpretability techniques will be needed to really understand what's going on under the hood.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a90e980a6104\",\"_type\":\"block\",\"children\":[{\"_key\":\"a2aac22174830\",\"_type\":\"span\",\"marks\":[],\"text\":\"Q: In the “injected thoughts” experiment, isn’t the model just saying the word because you steered it to talk about that concept?\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"27b8138d436f\",\"_type\":\"block\",\"children\":[{\"_key\":\"3474cbfc87a90\",\"_type\":\"span\",\"marks\":[],\"text\":\"Indeed, activation steering typically makes models talk about the steered concept (we’ve explored this in \"},{\"_key\":\"3474cbfc87a91\",\"_type\":\"span\",\"marks\":[\"029288d45440\"],\"text\":\"our prior work\"},{\"_key\":\"3474cbfc87a92\",\"_type\":\"span\",\"marks\":[],\"text\":\"). To us, the most interesting part of the result isn't that the model eventually identifies the injected concept, but rather that the model correctly notices something unusual is happening \"},{\"_key\":\"3474cbfc87a93\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"before\"},{\"_key\":\"3474cbfc87a94\",\"_type\":\"span\",\"marks\":[],\"text\":\" it starts talking about the concept.\"}],\"markDefs\":[{\"_key\":\"029288d45440\",\"_type\":\"link\",\"href\":\"https://transformer-circuits.pub/2024/scaling-monosemanticity/\"}],\"style\":\"normal\"},{\"_key\":\"d76e7edfeec4\",\"_type\":\"block\",\"children\":[{\"_key\":\"2045c62e43d70\",\"_type\":\"span\",\"marks\":[],\"text\":\"In the successful trials, the model says things like “I'm experiencing something unusual” or “I detect an injected thought about…” The key word here is “detect.” The model is reporting awareness of an anomaly in its processing \"},{\"_key\":\"2045c62e43d71\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"before\"},{\"_key\":\"2045c62e43d72\",\"_type\":\"span\",\"marks\":[],\"text\":\" that anomaly has had a chance to obviously bias its outputs. This requires an extra computational step beyond simply regurgitating the steering vector as an output. In our quantitative analyses, we graded responses as demonstrating “introspective awareness” based on whether the model detected the injected concept \"},{\"_key\":\"2045c62e43d73\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"prior to\"},{\"_key\":\"2045c62e43d74\",\"_type\":\"span\",\"marks\":[],\"text\":\" mentioning the injected word.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"99984fc3490e\",\"_type\":\"block\",\"children\":[{\"_key\":\"84f8d26f00c00\",\"_type\":\"span\",\"marks\":[],\"text\":\"Note that our prefill detection experiment has a similar flavor: it requires the model to perform an extra step of processing on top of the injected concept (comparing it to the prefilled output, in order to determine whether to apologize for that output or double down on it).\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"81eae4f23d01\",\"_type\":\"block\",\"children\":[{\"_key\":\"71899e3561ca0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Q: If models can only introspect a fraction of the time, how useful is this capability?\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"0d0579c62f20\",\"_type\":\"block\",\"children\":[{\"_key\":\"a07ed36ae0a30\",\"_type\":\"span\",\"marks\":[],\"text\":\"The introspective awareness we observed is indeed highly unreliable and context-dependent. Most of the time, models fail to demonstrate introspection in our experiments. However, we think this is still significant for a few reasons. First, the most capable models that we tested (Opus 4 and 4.1 – note that we did not test Sonnet 4.5) performed best, suggesting this capability might improve as models become more intelligent. Second, even unreliable introspection could be useful in some contexts—for instance, helping models recognize when they've been jailbroken.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"96f08a675d1b\",\"_type\":\"block\",\"children\":[{\"_key\":\"ca74e3b323c20\",\"_type\":\"span\",\"marks\":[],\"text\":\"Q: Couldn’t the models just be making up answers to introspective questions?\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"050e08bc55f7\",\"_type\":\"block\",\"children\":[{\"_key\":\"9303b3d670cf0\",\"_type\":\"span\",\"marks\":[],\"text\":\"This is exactly the question we designed our experiments to address. Models are trained on data that includes examples of people introspecting, so they can certainly \"},{\"_key\":\"9303b3d670cf1\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"act\"},{\"_key\":\"9303b3d670cf2\",\"_type\":\"span\",\"marks\":[],\"text\":\" introspective without actually \"},{\"_key\":\"9303b3d670cf3\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"being\"},{\"_key\":\"9303b3d670cf4\",\"_type\":\"span\",\"marks\":[],\"text\":\" introspective. Our concept injection experiments distinguish between these possibilities by establishing known ground-truth information about the model’s internal states, which we can compare against its self-reported states. Our results suggest that in some examples, the model really is accurately basing its answers on its actual internal states, not just confabulating. However, this doesn’t mean that models \"},{\"_key\":\"9303b3d670cf5\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"always\"},{\"_key\":\"9303b3d670cf6\",\"_type\":\"span\",\"marks\":[],\"text\":\" accurately report their internal states—in many cases, they are making things up!\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"b68ef39c51d8\",\"_type\":\"block\",\"children\":[{\"_key\":\"6a0301954ae50\",\"_type\":\"span\",\"marks\":[],\"text\":\"Q: How do you know the concept vectors you’re injecting actually represent what you think they represent?\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"e82397df3cee\",\"_type\":\"block\",\"children\":[{\"_key\":\"92899bdfd4b20\",\"_type\":\"span\",\"marks\":[],\"text\":\"This is a legitimate concern. We can’t be absolutely certain that the “meaning” (to the model) of our concept vectors is exactly what we intend. We tried to address this by testing across many different concept vectors. The fact that models correctly identified injected concepts across these diverse examples suggests our vectors are at least approximately capturing the intended meanings. But it’s true that pinning down exactly what a vector “means” to a model is challenging, and this is a limitation of our work.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"1dbabc335735\",\"_type\":\"block\",\"children\":[{\"_key\":\"9244a123bb710\",\"_type\":\"span\",\"marks\":[],\"text\":\"Q: Didn’t we already know that models could introspect?\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"a077e203877e\",\"_type\":\"block\",\"children\":[{\"_key\":\"a927f5b288030\",\"_type\":\"span\",\"marks\":[],\"text\":\"Previous research has shown evidence for model capabilities that are suggestive of introspection. For instance, prior work has shown that models can to some extent \"},{\"_key\":\"a927f5b288031\",\"_type\":\"span\",\"marks\":[\"c622842a2386\"],\"text\":\"estimate their own knowledge\"},{\"_key\":\"a927f5b288032\",\"_type\":\"span\",\"marks\":[],\"text\":\", \"},{\"_key\":\"a927f5b288033\",\"_type\":\"span\",\"marks\":[\"e5a14d66d040\"],\"text\":\"recognize their own outputs\"},{\"_key\":\"a927f5b288034\",\"_type\":\"span\",\"marks\":[],\"text\":\", \"},{\"_key\":\"a927f5b288035\",\"_type\":\"span\",\"marks\":[\"d5ee9180a060\"],\"text\":\"predict their own behavior\"},{\"_key\":\"a927f5b288036\",\"_type\":\"span\",\"marks\":[],\"text\":\", and \"},{\"_key\":\"a927f5b288037\",\"_type\":\"span\",\"marks\":[\"5a08c2374278\"],\"text\":\"identify their own propensities\"},{\"_key\":\"a927f5b288038\",\"_type\":\"span\",\"marks\":[],\"text\":\". Our work was heavily motivated by these findings, and is intended to provide more direct evidence for introspection by tying models’ self-reports to their internal states. Without tying behaviors to internal states in this way, it is difficult to distinguish a model that genuinely introspects from one that makes educated guesses about itself.\"}],\"markDefs\":[{\"_key\":\"c622842a2386\",\"_type\":\"link\",\"href\":\"https://arxiv.org/abs/2207.05221\"},{\"_key\":\"e5a14d66d040\",\"_type\":\"link\",\"href\":\"https://arxiv.org/abs/2404.13076\"},{\"_key\":\"d5ee9180a060\",\"_type\":\"link\",\"href\":\"https://arxiv.org/abs/2410.13787\"},{\"_key\":\"5a08c2374278\",\"_type\":\"link\",\"href\":\"https://arxiv.org/abs/2501.11120\"}],\"style\":\"normal\"},{\"_key\":\"c45d96b00675\",\"_type\":\"block\",\"children\":[{\"_key\":\"b3ce045ba1e80\",\"_type\":\"span\",\"marks\":[],\"text\":\"Q: What makes some models better at introspection than others?\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"1ce063f5129e\",\"_type\":\"block\",\"children\":[{\"_key\":\"9e1ae760f4720\",\"_type\":\"span\",\"marks\":[],\"text\":\"Our experiments focused on Claude models across several generations (Claude 3, Claude 3.5, Claude 4, Claude 4.1, in the Opus, Sonnet, and Haiku variants). We tested both production models and “helpful-only” variants that were trained differently. We also tested some base pretrained models before post-training.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"32e86a8d0236\",\"_type\":\"block\",\"children\":[{\"_key\":\"57b987b9286b0\",\"_type\":\"span\",\"marks\":[],\"text\":\"We found that post-training significantly impacts introspective capabilities. Base models generally performed poorly, suggesting that introspective capabilities aren’t elicited by pretraining alone. Among production models, the pattern was clearer at the top end: Claude Opus 4 and 4.1—our most capable models—performed best across most of our introspection tests. However, beyond that, the correlation between model capability and introspective ability was weak. Smaller models didn't consistently perform worse, suggesting the relationship isn't as simple as “more capable are more introspective.”\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c9b1ea6f5e2b\",\"_type\":\"block\",\"children\":[{\"_key\":\"297dde1bbdf80\",\"_type\":\"span\",\"marks\":[],\"text\":\"We also noticed something unexpected with post-training strategies. “Helpful-only” variants of several models often performed \"},{\"_key\":\"297dde1bbdf81\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"better\"},{\"_key\":\"297dde1bbdf82\",\"_type\":\"span\",\"marks\":[],\"text\":\" at introspection than their production counterparts, even though they underwent the same base training. In particular, some production models appeared reluctant to engage in introspective exercises, while the helpful-only variants showed more willingness to report on their internal states. This suggests that how we fine-tune models can elicit or suppress introspective capabilities to varying degrees.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c48a0e00a3b1\",\"_type\":\"block\",\"children\":[{\"_key\":\"04b84941e3c30\",\"_type\":\"span\",\"marks\":[],\"text\":\"We’re not entirely sure why Opus 4 and 4.1 perform so well (note that our experiments were conducted prior to the release of Sonnet 4.5). It could be that introspection requires sophisticated internal mechanisms that only emerge at higher capability levels. Or it might be that their post-training process better encourages introspection. Testing open-source models, and models from other organizations, could help us determine whether this pattern generalizes or if it’s specific to how Claude models are trained.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"2511cfb6114a\",\"_type\":\"block\",\"children\":[{\"_key\":\"e2586b347b990\",\"_type\":\"span\",\"marks\":[],\"text\":\"Q: What’s next for this research?\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"f8ff1f23edb8\",\"_type\":\"block\",\"children\":[{\"_key\":\"fff8bada27a30\",\"_type\":\"span\",\"marks\":[],\"text\":\"We see several important directions. First, we need better evaluation methods—our experiments used specific prompts and injection techniques that might not capture the full range of introspective capabilities. Second, we need to understand the mechanisms underlying introspection. We have some speculative hypotheses about possible circuits (like anomaly detection mechanisms or concordance heads), but we haven’t definitively identified how introspection works. Third, we need to study introspection in more naturalistic settings, since our injection methodology creates artificial scenarios. Finally, we need to develop methods to validate introspective reports and detect when models might be confabulating or deceiving. We expect that understanding machine introspection and its limitations will become more important as models become more capable.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"footnotes\":{\"body\":\"$1e:props:children:props:body\",\"count\":0,\"numberByListItemKey\":{},\"referenced\":\"$W27\"},\"sidebar\":{\"isVisible\":false}}]}]\n1f:[\"$\",\"div\",null,{\"className\":\"page-wrapper PostDetail-module-scss-module__UQuRMa__postFooter\",\"children\":[null,[\"$\",\"div\",null,{\"className\":\"PostDetail-module-scss-module__UQuRMa__socialShare\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://twitter.com/intent/tweet?text=https://www.anthropic.com/research/introspection\",\"target\":\"_blank\",\"rel\":\"noopener\",\"aria-label\":\"Share on Twitter\",\"children\":[\"$\",\"$L28\",null,{}]}],[\"$\",\"a\",null,{\"href\":\"https://www.linkedin.com/shareArticle?mini=true\u0026url=https://www.anthropic.com/research/introspection\",\"target\":\"_blank\",\"rel\":\"noopener\",\"aria-label\":\"Share on LinkedIn\",\"children\":[\"$\",\"$L29\",null,{}]}]]}]]}]\n20:[\"$\",\"section\",null,{\"className\":\"LandingPageSection-module-scss-module__ZSMdoa__root\",\"id\":\"$undefined\",\"ref\":\"$undefined\",\"style\":\"$undefined\",\"data-theme\":\"ivory\",\"children\":[\"$undefined\",[\"$\",\"div\",null,{\"className\":\"page-wrapper\",\"children\":[[\"$\",\"div\",null,{\"className\":\"SectionIntro-module-scss-module__i9TRza__root LinkGrid-module-scss-module__wTN57W__intro\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"headline-4 SectionIntro-module-scss-module__i9TRza__title\",\"children\":\"Related content\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"LinkGrid-module-scss-module__wTN57W__root\",\"children\":[false,[\"$\",\"div\",null,{\"className\":\"LinkGrid-module-scss-module__wTN57W__items LinkGrid-module-scss-module__wTN57W__threeItems\",\"children\":[[\"$\",\"div\",\"0\",{\"className\":\"LinkGrid-module-scss-module__wTN57W__item\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"headline-6\",\"children\":\"Claude-shaped science\"}],[\"$\",\"p\",null,{\"className\":\"body-3 serif\",\"children\":\"Guest author Prof. Matthew Schwartz describes what happened when he stopped fighting Claude and allowed Claude to find “Claude-shaped” problems: ones best suited to the capabilities of the current generation of LLM tools. This led him to build BootLoops, a toolkit for exact calculations in quantitative science, which he has been applying across scientific fields alongside experts.\"}],[\"$\",\"$L2a\",null,{\"className\":\"LinkGrid-module-scss-module__wTN57W__cta\",\"link\":{\"text\":\"Read more\",\"url\":\"/research/claude-shaped-science\"},\"ctaPosition\":\"linkGrid\",\"icon\":[\"$\",\"$L2b\",null,{\"fill\":\"currentColor\"}],\"iconPosition\":\"right\"}]]}],[\"$\",\"div\",\"1\",{\"className\":\"LinkGrid-module-scss-module__wTN57W__item\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"headline-6\",\"children\":\"What work can robots do?\"}],[\"$\",\"p\",null,{\"className\":\"body-3 serif\",\"children\":\"We built an index of how well today’s robots can perform US job tasks. Robots can already do three-quarters of physical tasks, mostly in limited settings, but are cost-competitive for just 0.3% of them.\"}],[\"$\",\"$L2a\",null,{\"className\":\"LinkGrid-module-scss-module__wTN57W__cta\",\"link\":{\"text\":\"Read more\",\"url\":\"/research/what-work-can-robots-do\"},\"ctaPosition\":\"linkGrid\",\"icon\":[\"$\",\"$L2b\",null,{\"fill\":\"currentColor\"}],\"iconPosition\":\"right\"}]]}],[\"$\",\"div\",\"2\",{\"className\":\"LinkGrid-module-scss-module__wTN57W__item\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"headline-6\",\"children\":\"What do you want from AI? \"}],[\"$\",\"p\",null,{\"className\":\"body-3 serif\",\"children\":\"We’re launching a new study using Anthropic Interviewer to learn from your experiences with AI, and we invite you to participate. \"}],[\"$\",\"$L2a\",null,{\"className\":\"LinkGrid-module-scss-module__wTN57W__cta\",\"link\":{\"text\":\"Read more\",\"url\":\"/research/your-thoughts-on-ai\"},\"ctaPosition\":\"linkGrid\",\"icon\":[\"$\",\"$L2b\",null,{\"fill\":\"currentColor\"}],\"iconPosition\":\"right\"}]]}]]}]]}]]}]]}]\n21:null\n22:[\"$\",\"footer\",null,{\"id\":\"footer\",\"className\":\"SiteFooter-module-scss-module__JdOqwq__root\",\"role\":\"contentinfo\",\"aria-label\":\"Site footer\",\"children\":[\"$\",\"div\",null,{\"className\":\"page-wrapper SiteFooter-module-scss-module__JdOqwq__footer\",\"children\":[[\"$\",\"div\",null,{\"className\":\"SiteFooter-module-scss-module__JdOqwq__logoWrapper\",\"children\":[\"$\",\"a\",null,{\"href\":\"/\",\"aria-label\":\"Return to homepage\",\"className\":\"$undefined\",\"children\":[\"$\",\"$L2c\",null,{\"fill\":\"#faf9f5\",\"aria-hidden\":\"true\"}]}]}],[\"$\",\"nav\",null,{\"className\":\"SiteFooter-module-scss-module__JdOqwq__linksWrapper\",\"aria-label\":\"Footer navigation\",\"style\":{\"--footer-columns\":4},\"children\":[[\"$\",\"div\",\"0\",{\"className\":\"SiteFooter-module-scss-module__JdOqwq__columnSection\",\"children\":[[\"$\",\"div\",\"0\",{\"className\":\"SiteFooter-module-scss-module__JdOqwq__listSection\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"body-4 bold\",\"children\":\"Products\"}],[\"$\",\"ul\",null,{\"className\":\"SiteFooter-module-scss-module__JdOqwq__list\",\"children\":[[\"$\",\"li\",\"0\",{\"childr