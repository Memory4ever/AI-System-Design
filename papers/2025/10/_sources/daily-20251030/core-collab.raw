</div>
<div id="lstnumberx238" class="ltx_listingline"><span id="lstnumberx238.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Currently</span><span id="lstnumberx238.2" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx238.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx238.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx238.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx238.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">blocks</span><span id="lstnumberx238.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx238.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">are</span><span id="lstnumberx238.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx238.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">located</span><span id="lstnumberx238.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx238.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">as</span><span id="lstnumberx238.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx238.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">follows</span><span id="lstnumberx238.15" class="ltx_text ltx_font_typewriter">:</span>
</div>
<div id="lstnumberx239" class="ltx_listingline"><span id="lstnumberx239.1" class="ltx_text ltx_font_typewriter ltx_font_bold" style="--ltx-fg-color:#BF0040;">{blocks}</span>
</div>
<div id="lstnumberx240" class="ltx_listingline"><span id="lstnumberx240.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">You</span><span id="lstnumberx240.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx240.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">can</span><span id="lstnumberx240.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx240.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">access</span><span id="lstnumberx240.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx240.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">these</span><span id="lstnumberx240.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx240.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">bins</span><span id="lstnumberx240.10" class="ltx_text ltx_font_typewriter">:</span>
</div>
<div id="lstnumberx241" class="ltx_listingline"><span id="lstnumberx241.1" class="ltx_text ltx_font_typewriter ltx_font_bold" style="--ltx-fg-color:#BF0040;">{bins}</span>
</div>
<div id="lstnumberx242" class="ltx_listingline">
</div>
<div id="lstnumberx243" class="ltx_listingline"><span id="lstnumberx243.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">The</span><span id="lstnumberx243.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx243.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">history</span><span id="lstnumberx243.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx243.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">of</span><span id="lstnumberx243.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx243.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx243.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx243.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">game</span><span id="lstnumberx243.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx243.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">till</span><span id="lstnumberx243.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx243.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">now</span><span id="lstnumberx243.14" class="ltx_text ltx_font_typewriter">:</span>
</div>
<div id="lstnumberx244" class="ltx_listingline"><span id="lstnumberx244.1" class="ltx_text ltx_font_typewriter ltx_font_bold" style="--ltx-fg-color:#BF0040;">{move_history}</span>
</div>
