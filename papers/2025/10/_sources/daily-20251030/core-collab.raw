r"> </span><span id="lstnumberx236.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter">board</span><span id="lstnumberx236.23" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx236.24" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx236.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter">You</span><span id="lstnumberx236.26" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx236.27" class="ltx_text ltx_lst_identifier ltx_font_typewriter">have</span><span id="lstnumberx236.28" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx236.29" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx236.30" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx236.31" class="ltx_text ltx_lst_identifier ltx_font_typewriter">following</span><span id="lstnumberx236.32" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx236.33" class="ltx_text ltx_lst_identifier ltx_font_typewriter">knowledge</span><span id="lstnumberx236.34" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx236.35" class="ltx_text ltx_lst_identifier ltx_font_typewriter">for</span><span id="lstnumberx236.36" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx236.37" class="ltx_text ltx_lst_identifier ltx_font_typewriter">your</span><span id="lstnumberx236.38" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx236.39" class="ltx_text ltx_lst_identifier ltx_font_typewriter">goal</span><span id="lstnumberx236.40" class="ltx_text ltx_font_typewriter">:</span>
