<td id="A6.T15.4.1.3" class="ltx_td ltx_align_center ltx_border_tt" colspan="2"><span id="A6.T15.4.1.3.1" class="ltx_text ltx_font_bold">Strategy I</span> <math id="A6.T15.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td>
<td id="A6.T15.4.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="A6.T15.4.1.4.1" class="ltx_text ltx_font_bold">Strategy II</span> <math id="A6.T15.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td></tr>
