<span id="A1.T6.2.1.1.1.1.1.9.1" class="ltx_td ltx_align_left">3-shot</span>
<span id="A1.T6.2.1.1.1.1.1.9.2" class="ltx_td ltx_align_center"><math id="A1.T6.m9" class="ltx_Math" alttext="5.5\!\times\!10^{-7}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>7</mn></mrow></msup></mrow><annotation encoding="application/x-tex">5.5\!\times\!10^{-7}</annotation></semantics></math></span>
<span id="A1.T6.2.1.1.1.1.1.9.3" class="ltx_td ltx_align_center"><math id="A1.T6.m10" class="ltx_Math" alttext="4.3\!\times\!10^{-4}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">4.3\!\times\!10^{-4}</annotation></semantics></math></span>
<span id="A1.T6.2.1.1.1.1.1.9.4" class="ltx_td ltx_align_center"><math id="A1.T6.m11" class="ltx_Math" alttext="5.5\!\times\!10^{-7}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>7</mn></mrow></msup></mrow><annotation encoding="application/x-tex">5.5\!\times\!10^{-7}</annotation></semantics></math></span>
<span id="A1.T6.2.1.1.1.1.1.9.5" class="ltx_td ltx_align_center"><math id="A1.T6.m12" class="ltx_Math" alttext="5.8\!\times\!10^{-4}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">5.8\!\times\!10^{-4}</annotation></semantics></math></span></span>
<span id="A1.T6.2.1.1.1.1.1.10" class="ltx_tr" style="--ltx-bg-color:#F8F8F8;">
<span id="A1.T6.2.1.1.1.1.1.10.1" class="ltx_td ltx_align_left"><span id="A1.T6.2.1.1.1.1.1.10.1.1" class="ltx_text" style="--ltx-bg-color:#F8F8F8;">4-shot</span></span>
<span id="A1.T6.2.1.1.1.1.1.10.2" class="ltx_td ltx_align_center"><math id="A1.T6.m13" class="ltx_Math" style="--ltx-bg-color:#F8F8F8;" alttext="7.4\!\times\!10^{-7}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-bg-color:#F8F8F8;" lspace="0.222em" mathbackground="#F8F8F8" rspace="0.222em">×</mo><msup><mn style="--ltx-bg-color:#F8F8F8;" mathbackground="#F8F8F8">10</mn><mrow><mo style="--ltx-bg-color:#F8F8F8;" mathbackground="#F8F8F8">−</mo><mn style="--ltx-bg-color:#F8F8F8;" mathbackground="#F8F8F8">7</mn></mrow></msup></mrow><annotation encoding="application/x-tex">7.4\!\times\!10^{-7}</annotation></semantics></math></span>
<span id="A1.T6.2.1.1.1.1.1.10.3" class="ltx_td ltx_align_center"><math id="A1.T6.m14" class="ltx_Math" style="--ltx-bg-color:#F8F8F8;" alttext="5.7\!\times\!10^{-4}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-bg-color:#F8F8F8;" lspace="0.222em" mathbackground="#F8F8F8" rspace="0.222em">×</mo><msup><mn style="--ltx-bg-color:#F8F8F8;" mathbackground="#F8F8F8">10</mn><mrow><mo style="--ltx-bg-color:#F8F8F8;" mathbackground="#F8F8F8">−</mo><mn style="--ltx-bg-color:#F8F8F8;" mathbackground="#F8F8F8">4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">5.7\!\times\!10^{-4}</annotation></semantics></math></span>
<span id="A1.T6.2.1.1.1.1.1.10.4" class="ltx_td ltx_align_center"><math id="A1.T6.m15" class="ltx_Math" style="--ltx-bg-color:#F8F8F8;" alttext="7.4\!\times\!10^{-7}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-bg-color:#F8F8F8;" lspace="0.222em" mathbackground="#F8F8F8" rspace="0.222em">×</mo><msup><mn style="--ltx-bg-color:#F8F8F8;" mathbackground="#F8F8F8">10</mn><mrow><mo style="--ltx-bg-color:#F8F8F8;" mathbackground="#F8F8F8">−</mo><mn style="--ltx-bg-color:#F8F8F8;" mathbackground="#F8F8F8">7</mn></mrow></msup></mrow><annotation encoding="application/x-tex">7.4\!\times\!10^{-7}</annotation></semantics></math></span>
<span id="A1.T6.2.1.1.1.1.1.10.5" class="ltx_td ltx_align_center"><math id="A1.T6.m16" class="ltx_Math" style="--ltx-bg-color:#F8F8F8;" alttext="7.7\!\times\!10^{-4}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-bg-color:#F8F8F8;" lspace="0.222em" mathbackground="#F8F8F8" rspace="0.222em">×</mo><msup><mn style="--ltx-bg-color:#F8F8F8;" mathbackground="#F8F8F8">10</mn><mrow><mo style="--ltx-bg-color:#F8F8F8;" mathbackground="#F8F8F8">−</mo><mn style="--ltx-bg-color:#F8F8F8;" mathbackground="#F8F8F8">4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">7.7\!\times\!10^{-4}</annotation></semantics></math></span></span>
