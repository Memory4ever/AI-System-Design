<td id="S5.T3.2.5.2" class="ltx_td ltx_align_center ltx_border_b">956</td>
<td id="S5.T3.2.5.3" class="ltx_td ltx_align_center ltx_border_b">1,076</td></tr>
</tbody>
</table>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 3: </span><span id="S5.T3.4" class="ltx_text ltx_font_bold">Inference ablation metrics.</span>
Comparison of throughput, latency, energy consumption, and memory usage.
</figcaption>
</figure>
<figure id="S5.T4" class="ltx_table">
<table id="S5.T4.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S5.T4.2.1" class="ltx_tr">
<th id="S5.T4.2.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_t"><span id="S5.T4.2.1.1.1" class="ltx_text ltx_font_bold">Task</span></th>
<th id="S5.T4.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="S5.T4.m1" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math><span id="S5.T4.2.1.2.1" class="ltx_text ltx_font_bold"> (pp)</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T4.2.2" class="ltx_tr">
<th id="S5.T4.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Entity Tracking (Split 1)</th>
<td id="S5.T4.2.2.2" class="ltx_td ltx_align_center ltx_border_t">+2.9</td></tr>
<tr id="S5.T4.2.3" class="ltx_tr">
<th id="S5.T4.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Entity Tracking (Split 2)</th>
<td id="S5.T4.2.3.2" class="ltx_td ltx_align_center">+4.1</td></tr>
<tr id="S5.T4.2.4" class="ltx_tr">
<th id="S5.T4.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">COMPS</th>
<td id="S5.T4.2.4.2" class="ltx_td ltx_align_center">+3.4</td></tr>
<tr id="S5.T4.2.5" class="ltx_tr">
<th id="S5.T4.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">BLiMP</th>
<td id="S5.T4.2.5.2" class="ltx_td ltx_align_center">+0.6</td></tr>
<tr id="S5.T4.2.6" class="ltx_tr">
<th id="S5.T4.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">VQA</th>
<td id="S5.T4.2.6.2" class="ltx_td ltx_align_center">+3.4</td></tr>
<tr id="S5.T4.2.7" class="ltx_tr">
<th id="S5.T4.2.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">EWoK (Split 1)</th>
<td id="S5.T4.2.7.2" class="ltx_td ltx_align_center"><math id="S5.T4.m2" class="ltx_Math" alttext="-" display="inline" intent=":literal"><semantics><mo>−</mo><annotation encoding="application/x-tex">-</annotation></semantics></math>1.6</td></tr>
<tr id="S5.T4.2.8" class="ltx_tr">
<th id="S5.T4.2.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">EWoK (Split 2)</th>
<td id="S5.T4.2.8.2" class="ltx_td ltx_align_center">+1.0</td></tr>
<tr id="S5.T4.2.9" class="ltx_tr">
<th id="S5.T4.2.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Winoground</th>
<td id="S5.T4.2.9.2" class="ltx_td ltx_align_center"><math id="S5.T4.m3" class="ltx_Math" alttext="-" display="inline" intent=":literal"><semantics><mo>−</mo><annotation encoding="application/x-tex">-</annotation></semantics></math>1.6</td></tr>
<tr id="S5.T4.2.10" class="ltx_tr">
<th id="S5.T4.2.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b">DevBench</th>
