<tr id="S4.T3.2.1.3" class="ltx_tr">
<th id="S4.T3.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_t"><span id="S4.T3.2.1.3.1.1" class="ltx_text ltx_font_bold">LAMI</span></th>
<th id="S4.T3.2.1.3.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S4.T3.2.1.3.2.1" class="ltx_text ltx_font_bold">82.21</span></th>
<th id="S4.T3.2.1.3.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S4.T3.2.1.3.3.1" class="ltx_text ltx_font_bold">80.39</span></th>
<th id="S4.T3.2.1.3.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S4.T3.2.1.3.4.1" class="ltx_text ltx_font_bold">80.78</span></th>
<th id="S4.T3.2.1.3.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S4.T3.2.1.3.5.1" class="ltx_text ltx_font_bold">80.57</span></th>
<th id="S4.T3.2.1.3.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S4.T3.2.1.3.6.1" class="ltx_text ltx_font_bold">88.45</span></th>
<th id="S4.T3.2.1.3.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S4.T3.2.1.3.7.1" class="ltx_text ltx_font_bold">81.47</span></th>
<th id="S4.T3.2.1.3.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S4.T3.2.1.3.8.1" class="ltx_text ltx_font_bold">78.58</span></th>
<th id="S4.T3.2.1.3.9" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S4.T3.2.1.3.9.1" class="ltx_text ltx_font_bold">79.29</span></th>
<th id="S4.T3.2.1.3.10" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S4.T3.2.1.3.10.1" class="ltx_text ltx_underline">78.86</span></th>
<th id="S4.T3.2.1.3.11" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S4.T3.2.1.3.11.1" class="ltx_text ltx_font_bold">88.23</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T3.2.1.4" class="ltx_tr">
<th id="S4.T3.2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">   w/o Relation Matrix</th>
<td id="S4.T3.2.1.4.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T3.2.1.4.2.1" class="ltx_text ltx_underline">81.43</span></td>
<td id="S4.T3.2.1.4.3" class="ltx_td ltx_align_center ltx_border_t">78.26</td>
<td id="S4.T3.2.1.4.4" class="ltx_td ltx_align_center ltx_border_t">79.82</td>
<td id="S4.T3.2.1.4.5" class="ltx_td ltx_align_center ltx_border_t">78.63</td>
<td id="S4.T3.2.1.4.6" class="ltx_td ltx_align_center ltx_border_t">86.79</td>
<td id="S4.T3.2.1.4.7" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T3.2.1.4.7.1" class="ltx_text ltx_underline">80.44</span></td>
