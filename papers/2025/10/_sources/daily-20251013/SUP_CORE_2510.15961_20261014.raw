<td id="S3.T2.2.1.12.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S3.T2.2.1.12.3.1" class="ltx_text ltx_font_bold">80.39</span></td>
<td id="S3.T2.2.1.12.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S3.T2.2.1.12.4.1" class="ltx_text ltx_font_bold">80.78</span></td>
<td id="S3.T2.2.1.12.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S3.T2.2.1.12.5.1" class="ltx_text ltx_font_bold">80.57</span></td>
<td id="S3.T2.2.1.12.6" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S3.T2.2.1.12.6.1" class="ltx_text ltx_font_bold">88.45</span></td>
<td id="S3.T2.2.1.12.7" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S3.T2.2.1.12.7.1" class="ltx_text ltx_font_bold">81.47</span></td>
<td id="S3.T2.2.1.12.8" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S3.T2.2.1.12.8.1" class="ltx_text ltx_font_bold">78.58</span></td>
<td id="S3.T2.2.1.12.9" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">79.29</td>
<td id="S3.T2.2.1.12.10" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S3.T2.2.1.12.10.1" class="ltx_text ltx_font_bold">78.86</span></td>
<td id="S3.T2.2.1.12.11" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S3.T2.2.1.12.11.1" class="ltx_text ltx_font_bold">88.23</span></td></tr>
