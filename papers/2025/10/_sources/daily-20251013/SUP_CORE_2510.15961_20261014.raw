<th id="S3.T2.2.1.12.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_t"><span id="S3.T2.2.1.12.1.1" class="ltx_text ltx_font_bold">LAMI (Ours)</span></th>
