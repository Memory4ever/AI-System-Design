<th id="S4.T3.2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="5"><span id="S4.T3.2.1.1.2.1" class="ltx_text ltx_font_typewriter">YRBS</span></th>
