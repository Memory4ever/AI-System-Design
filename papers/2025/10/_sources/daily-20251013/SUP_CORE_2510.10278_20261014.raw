</span></td></tr>
<tr id="S4.T2.7.3" class="ltx_tr">
<td id="S4.T2.7.3.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_align_top ltx_border_t" style="padding-left:-1.0pt;padding-right:-1.0pt;">
<span id="S4.T2.7.3.1.1" class="ltx_inline-block ltx_align_top" style="width:72.3pt;">
<span id="S4.T2.7.3.1.1.1" class="ltx_p ltx_align_left"><span id="S4.T2.7.3.1.1.1.1" class="ltx_text" style="font-size:80%;">Gemini 2.5 Pro</span></span>
</span></td>
<td id="S4.T2.7.3.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_border_t" style="padding-left:-1.0pt;padding-right:-1.0pt;">
<span id="S4.T2.7.3.2.1" class="ltx_inline-block ltx_align_top">
