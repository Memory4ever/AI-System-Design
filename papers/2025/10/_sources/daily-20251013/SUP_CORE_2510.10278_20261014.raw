<span id="S4.T3.7.1.1.8.6.1.1" class="ltx_p ltx_align_center"><math id="S4.T3.m54" class="ltx_math_unparsed" alttext="2.55^{\dagger\ddagger*}" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.880em">2.55</mn><msup><mrow></mrow><mrow><mo mathsize="0.870em" rspace="0em">†</mo><mo lspace="0em" mathsize="0.870em" rspace="0em">‡</mo><mo lspace="0em" mathsize="0.870em">∗</mo></mrow></msup></mrow><annotation encoding="application/x-tex">2.55^{\dagger\ddagger*}</annotation></semantics></math></span>
</span></span>
