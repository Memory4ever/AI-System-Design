ass="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx39.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">non</span><span id="lstnumberx39.20" class="ltx_text ltx_font_typewriter" style="font-size:90%;">-</span><span id="lstnumberx39.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">specific</span><span id="lstnumberx39.22" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx39.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">neurological</span><span id="lstnumberx39.24" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx39.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">symptoms</span><span id="lstnumberx39.26" class="ltx_text ltx_font_typewriter" style="font-size:90%;">.</span><span id="lstnumberx39.27" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx39.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">HR</span><span id="lstnumberx39.29" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx39.30" class="ltx_text ltx_font_typewriter" style="font-size:90%;">98,</span><span id="lstnumberx39.31" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx39.32" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">BP</span><span id="lstnumberx39.33" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx39.34" class="ltx_text ltx_font_typewriter" style="font-size:90%;">212/123</span><span id="lstnumberx39.35" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx39.36" class="ltx_text ltx_lst_ident