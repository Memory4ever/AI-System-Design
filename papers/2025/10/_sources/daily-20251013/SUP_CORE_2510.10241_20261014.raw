<td id="S4.T5.2.1.10.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">92.5</td>
<td id="S4.T5.2.1.10.5" class="ltx_td ltx_align_center ltx_border_t">80.5</td></tr>
