<td id="S4.T1.2.1.4.3" class="ltx_td ltx_align_center ltx_border_b">-</td>
<td id="S4.T1.2.1.4.4" class="ltx_td ltx_align_center ltx_border_b">30</td>
<td id="S4.T1.2.1.4.5" class="ltx_td ltx_align_center ltx_border_b">1996</td>
<td id="S4.T1.2.1.4.6" class="ltx_td ltx_align_center ltx_border_b">230</td></tr>
