<th id="S4.T1.2.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">#Test</th>
<th id="S4.T1.2.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">Avg. W</th>
<th id="S4.T1.2.1.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">Avg. M</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T1.2.1.2" class="ltx_tr">
<th id="S4.T1.2.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t">OntoNotes</th>
<td id="S4.T1.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t">2802</td>
<td id="S4.T1.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t">343</td>
<td id="S4.T1.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t">348</td>
<td id="S4.T1.2.1.2.5" class="ltx_td ltx_align_center ltx_border_t">467</td>
<td id="S4.T1.2.1.2.6" class="ltx_td ltx_align_center ltx_border_t">56</td></tr>
<tr id="S4.T1.2.1.3" class="ltx_tr">
<th id="S4.T1.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">LitBank</th>
<td id="S4.T1.2.1.3.2" class="ltx_td ltx_align_center">80</td>
<td id="S4.T1.2.1.3.3" class="ltx_td ltx_align_center">10</td>
<td id="S4.T1.2.1.3.4" class="ltx_td ltx_align_center">10</td>
<td id="S4.T1.2.1.3.5" class="ltx_td ltx_align_center">2105</td>
<td id="S4.T1.2.1.3.6" class="ltx_td ltx_align_center">291</td></tr>
<tr id="S4.T1.2.1.4" class="ltx_tr">
<th id="S4.T1.2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b ltx_border_r">WikiCoref</th>
