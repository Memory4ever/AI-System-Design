<th id="S4.T5.2.1.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">ImCoref-CeS<math id="S4.T5.m2" class="ltx_Math" alttext="{}_{\text{gpt4}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext>gpt4</mtext></msub><annotation encoding="application/x-tex">{}_{\text{gpt4}}</annotation></semantics></math></th>
<td id="S4.T5.2.1.9.2" class="ltx_td ltx_align_center">94.3</td>
<td id="S4.T5.2.1.9.3" class="ltx_td ltx_align_center">92.1</td>
<td id="S4.T5.2.1.9.4" class="ltx_td ltx_align_center ltx_border_r">93.2</td>
<td id="S4.T5.2.1.9.5" class="ltx_td ltx_align_center"><span id="S4.T5.2.1.9.5.1" class="ltx_text ltx_font_bold">81.1</span></td></tr>
<tr id="S4.T5.2.1.10" class="ltx_tr">
<th id="S4.T5.2.1.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">-w/o. M-Ce</th>
<td id="S4.T5.2.1.10.2" class="ltx_td ltx_align_center ltx_border_t">92.7</td>
