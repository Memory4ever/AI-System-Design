<th id="S4.T5.2.1.11.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">-w/o. C-CeS</th>
<td id="S4.T5.2.1.11.2" class="ltx_td ltx_align_center">94.3</td>
<td id="S4.T5.2.1.11.3" class="ltx_td ltx_align_center">92.1</td>
<td id="S4.T5.2.1.11.4" class="ltx_td ltx_align_center ltx_border_r">93.2</td>
<td id="S4.T5.2.1.11.5" class="ltx_td ltx_align_center">79.9</td></tr>
