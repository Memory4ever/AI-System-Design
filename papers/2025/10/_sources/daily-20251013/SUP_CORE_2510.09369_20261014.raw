<figure id="S4.F3.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.09369v1/reward_progression.png" id="S4.F3.sf1.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/265;" width="476" height="265" alt="Refer to caption">
