<td id="S4.T1.6.1.4.8" class="ltx_td ltx_align_left" style="padding:0.75pt 4.0pt;"><math id="S4.T1.m23" class="ltx_Math" alttext="33.0800" display="inline" intent=":literal"><semantics><mn>33.0800</mn><annotation encoding="application/x-tex">33.0800</annotation></semantics></math></td>
