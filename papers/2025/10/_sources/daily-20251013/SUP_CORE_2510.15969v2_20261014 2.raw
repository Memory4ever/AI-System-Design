<td id="A5.T5.3.11.3" class="ltx_td ltx_align_right"><span id="A5.T5.3.11.3.1" class="ltx_text" style="font-size:90%;">71,776 <math id="A5.T5.m13" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 41,938</span></td>
