<td id="A5.T5.3.9.3" class="ltx_td ltx_align_right ltx_border_t"><span id="A5.T5.3.9.3.1" class="ltx_text" style="font-size:90%;">16,180 <math id="A5.T5.m10" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 5,274</span></td>
<td id="A5.T5.3.9.4" class="ltx_td ltx_align_right ltx_border_t"><span id="A5.T5.3.9.4.1" class="ltx_text" style="font-size:90%;">59.74s</span></td></tr>
