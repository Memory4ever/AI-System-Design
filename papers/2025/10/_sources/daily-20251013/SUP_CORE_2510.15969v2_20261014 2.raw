<td id="A5.T5.3.7.2" class="ltx_td ltx_align_left"><span id="A5.T5.3.7.2.1" class="ltx_text" style="font-size:90%;">Reformulation</span></td>
<td id="A5.T5.3.7.3" class="ltx_td ltx_align_right"><span id="A5.T5.3.7.3.1" class="ltx_text" style="font-size:90%;">63,437 <math id="A5.T5.m8" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 49,267</span></td>
<td id="A5.T5.3.7.4" class="ltx_td ltx_align_right"><span id="A5.T5.3.7.4.1" class="ltx_text" style="font-size:90%;">193.64s</span></td></tr>
<tr id="A5.T5.3.8" class="ltx_tr">
