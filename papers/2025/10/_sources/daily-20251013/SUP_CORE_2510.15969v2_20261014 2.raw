<td id="A5.T5.3.10.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t" rowspan="4"><span id="A5.T5.3.10.1.1" class="ltx_text" style="font-size:90%;"><math id="A5.T5.m11" class="ltx_Math" alttext="d\geq 3" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">d\geq 3</annotation></semantics></math></span></td>
<td id="A5.T5.3.10.2" class="ltx_td ltx_align_left ltx_border_t"><span id="A5.T5.3.10.2.1" class="ltx_text" style="font-size:90%;">LinearizeLLM</span></td>
<td id="A5.T5.3.10.3" class="ltx_td ltx_align_left ltx_border_t"><span id="A5.T5.3.10.3.1" class="ltx_text" style="font-size:90%;">Pattern Detection</span></td>
<td id="A5.T5.3.10.4" class="ltx_td ltx_align_right ltx_border_t"><span id="A5.T5.3.10.4.1" class="ltx_text" style="font-size:90%;">14,486 <math id="A5.T5.m12" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 3,748</span></td>
