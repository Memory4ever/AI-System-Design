<td id="S4.T2.12.8.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="--ltx-bg-color:#CCCCCC;"><span id="S4.T2.12.8.4.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#CCCCCC;">✓</span></td>
