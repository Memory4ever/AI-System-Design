<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(c) </span><math id="S6.F5.sf3.m2" class="ltx_Math" alttext="D_{\textup{ppl}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">D</mi><mtext mathsize="0.800em">ppl</mtext></msub><annotation encoding="application/x-tex">D_{\textup{ppl}}</annotation></semantics></math><span id="S6.F5.sf3.3" class="ltx_text" style="font-size:80%;"> of LLaMA2-7B</span></figcaption>
