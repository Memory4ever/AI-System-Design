<td id="S4.T2.12.7.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_t" style="--ltx-bg-color:#CCCCCC;"><span id="S4.T2.12.7.1.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#CCCCCC;">T5</span></td>
<td id="S4.T2.12.7.2" class="ltx_td ltx_border_r ltx_border_t"></td>
<td id="S4.T2.12.7.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="--ltx-bg-color:#CCCCCC;"><span id="S4.T2.12.7.3.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#CCCCCC;">✓</span></td>
<td id="S4.T2.12.7.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="--ltx-bg-color:#CCCCCC;"><span id="S4.T2.12.7.4.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#CCCCCC;">✓</span></td>
