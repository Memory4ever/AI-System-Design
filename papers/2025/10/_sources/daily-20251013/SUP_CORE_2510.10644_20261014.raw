<td id="S4.T3.5.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.8pt 8.0pt;"><span id="S4.T3.5.1.3.3.1" class="ltx_text" style="font-size:70%;">17.52</span></td>
