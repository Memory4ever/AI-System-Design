<td id="S4.T5.6.1.3.5" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_bb"><span id="S4.T5.6.1.3.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">2.24</span></td></tr>
