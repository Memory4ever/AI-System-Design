<td id="S4.T5.6.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T5.6.1.2.4.1" class="ltx_text" style="font-size:90%;">4.62</span></td>
<td id="S4.T5.6.1.2.5" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t"><span id="S4.T5.6.1.2.5.1" class="ltx_text" style="font-size:90%;">4.62</span></td></tr>
<tr id="S4.T5.6.1.3" class="ltx_tr">
<td id="S4.T5.6.1.3.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="S4.T5.6.1.3.1.1" class="ltx_text" style="font-size:90%;">Dynamic closed-loop</span></td>
<td id="S4.T5.6.1.3.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T5.6.1.3.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">2.23</span></td>
<td id="S4.T5.6.1.3.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T5.6.1.3.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">2.31</span></td>
