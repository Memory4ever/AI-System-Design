<thead class="ltx_thead">
<tr id="S4.T5.6.1.1" class="ltx_tr">
<th id="S4.T5.6.1.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="S4.T5.6.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Query Mechanism</span></th>
<th id="S4.T5.6.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T5.6.1.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Run1</span></th>
<th id="S4.T5.6.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T5.6.1.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Run2</span></th>
<th id="S4.T5.6.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T5.6.1.1.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Run3</span></th>
<th id="S4.T5.6.1.1.5" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T5.6.1.1.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Avg.</span></th></tr>
</thead>
