<td id="S4.T3.5.1.3.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.8pt 8.0pt;"><span id="S4.T3.5.1.3.6.1" class="ltx_text" style="font-size:70%;">41.08</span></td>
