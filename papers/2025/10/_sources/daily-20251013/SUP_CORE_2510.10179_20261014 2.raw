<th id="S5.T4.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-bottom: 2.0pt;"><span id="S5.T4.1.1.2.1" class="ltx_text ltx_font_bold">Hallucination Rate</span></th>
