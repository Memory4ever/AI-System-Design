                 <span id="alg1.l8.3" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l8.m1" class="ltx_Math" alttext="\kappa^{*}\geq\theta_{\text{elem}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>κ</mi><mo>∗</mo></msup><mo>≥</mo><msub><mi>θ</mi><mtext>elem</mtext></msub></mrow><annotation encoding="application/x-tex">\kappa^{*}\geq\theta_{\text{elem}}</annotation></semantics></math> <span id="alg1.l8.4" class="ltx_text ltx_font_bold">then</span>



</div>
<div id="alg1.l9" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
                
                
                  <span id="alg1.l9.3" class="ltx_text ltx_font_smallcaps">SchemaUpdate</span>(<math id="alg1.l9.m1" class="ltx_Math" alttext="e,u^{*}" display="inline" intent=":literal"><semantics><mrow><mi>e</mi><mo>,</mo><msup><mi>u</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">e,u^{*}</annotation></semantics></math>) {Path: Assimilation/Update}

</div>
<div id="alg1.l10" class="ltx_listingline">
