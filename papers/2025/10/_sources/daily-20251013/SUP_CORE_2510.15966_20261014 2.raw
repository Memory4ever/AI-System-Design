25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="54.57"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F5.sf2.pic1.8" class="ltx_text" style="font-size:90%;">Evolution</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#ED8D5A;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#ED8D5A" stroke="#000000" transform="matrix(1 0 0 -1 152.47 0) translate(4.43,0)"><path d="M -4.15 -2.77 h 8.3 v 11.07 h -8.3 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 161.33 0) translate(26.96,0) matrix(1.0 0.0 0.0 1.0 -24.19 -3.22)"><foreignObject style="--ltx-fo-width:3.78em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.51" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="48.39"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F5.sf2.pic1.9" class="ltx_text" style="font-size:90%;">Creation</span></span></span></foreignObject></g></g></g></g></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S4.F5.sf2.3" class="ltx_text" style="font-size:90%;">(b)</span> </span><span id="S4.F5.sf2.4" class="ltx_text" style="font-size:90%;">Internal Behavior vs. <math id="S4.F5.sf2.m2" class="ltx_Math" alttext="\theta_{\text{meta}}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mtext>meta</mtext></msub><annotation encoding="application/x-tex">\theta_{\text{meta}}</annotation></semantics></math></span></figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S4.F5.3" class="ltx_text" style="font-size:90%;">Figure 5</span>: </span><span id="S4.F5.4" class="ltx_text" style="font-size:90%;">Analysis of the impact of <math id="S4.F5.m2" class="ltx_Math" alttext="\theta_{\text{meta}}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mtext>meta</mtext></msub><annotation encoding="application/x-tex">\theta_{\text{meta}}</annotation></semantics></math> on agent performance and internal behavior. C1 to C4 represent Single-Hop, Multi-Hop, Temporal, and Open-Domain tasks, respectively.</span></figcaption>
</figure>
<div id="S4.SS4.p1" class="ltx_para">
<p id="S4.SS4.p1.1" class="ltx_p">We perform an hyperparameter analysis on conv-26 of the LOCOMO dataset to analyze the impact of the meta-cognition threshold, <math id="S4.SS4.p1.m1" class="ltx_Math" alttext="\theta_{\text{meta}}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mtext>meta</mtext></msub><annotation encoding="application/x-tex">\theta_{\text{meta}}</annotation></semantics></math>, on agent performance and internal behavior, as shown in Figure <a href="#S4.F5" title="Figure 5 ‣ 4.4 Hyperparameter Analysis ‣ 4 Experiments ‣ PISA: A Pragmatic Psych-Inspired Unified Memory System for Enhanced AI Agency" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>. This threshold governs the agent’s decision to either assimilate new experiences into existing metas or create new ones.</p>
</div>
