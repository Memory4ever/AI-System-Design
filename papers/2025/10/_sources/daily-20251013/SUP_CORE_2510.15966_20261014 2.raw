<figure id="A3.F13.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><span class="ltx_inline-block"><svg id="A3.F13.sf2.pic1" class="ltx_picture ltx_centering" height="166.73" overflow="visible" version="1.1" viewBox="0 0 456.49 166.73" width="456.49"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,166.73) matrix(1 0 0 -1 0 0) translate(41.1,0) translate(0,44.76) matrix(1.0 0.0 0.0 1.0 -41.1 -44.75)"><g class="ltx_nestedsvg" transform="matrix(1 0 0 1 0 0) translate(100.4,0) translate(0,44.76)"><g style="--ltx-stroke-color:#BFBFBF;--ltx-fill-color:#BFBFBF;--ltx-fg-color:#BFBFBF;" color="#BFBFBF" fill="#BFBFBF" stroke="#BFBFBF" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.4pt"><path style="fill:none" d="M -59.3 0 L 355.81 0 M -59.3 49.74 L 355.81 49.74 M -59.3 99.48 L 355.81 99.48"></path></g><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" stroke="#808080" stroke-width="0.2pt"><path style="fill:none" d="M 0 -5.91 L 0 0 M 74.13 -5.91 L 74.13 0 M 148.26 -5.91 L 148.26 0 M 222.38 -5.91 L 222.38 0 M 296.51 -5.91 L 296.51 0"></path></g><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" stroke="#808080" stroke-width="0.2pt"><path style="fill:none" d="M -59.3 0 L -53.4 0 M -59.3 49.74 L -53.4 49.74 M -59.3 99.48 L -53.4 99.48"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt"><path style="fill:none" d="M -59.3 0 L 355.81 0"></path><path style="fill:none" d="M -59.3 0 L -59.3 114.9"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -7.38 -17.04)"><foreignObject style="--ltx-fo-width:1.34em;--ltx-fo-height:0.57em;--ltx-fo-depth:0em;font-size:7.97pt;" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="14.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A3.F13.sf2.pic1.1" class="ltx_text" style="font-size:70%;">3-7</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 63.99 -17.04)"><foreignObject style="--ltx-fo-width:1.84em;--ltx-fo-height:0.57em;--ltx-fo-depth:0em;font-size:7.97pt;" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="20.28"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A3.F13.sf2.pic1.2" class="ltx_text" style="font-size:70%;">8-15</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 135.36 -17.04)"><foreignObject style="--ltx-fo-width:2.34em;--ltx-fo-height:0.57em;--ltx-fo-depth:0em;font-size:7.97pt;" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="25.79"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A3.F13.sf2.pic1.3" class="ltx_text" style="font-size:70%;">16-31</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 209.49 -17.04)"><foreignObject style="--ltx-fo-width:2.34em;--ltx-fo-height:0.57em;--ltx-fo-depth:0em;font-size:7.97pt;" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="25.79"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A3.F13.sf2.pic1.4" class="ltx_text" style="font-size:70%;">32-60</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 286.7