<td id="S4.T1.4.1.4.2" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;"><span id="S4.T1.4.1.4.2.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">0.2089</span></td>
<td id="S4.T1.4.1.4.3" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;"><span id="S4.T1.4.1.4.3.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">0.4271</span></td>
<td id="S4.T1.4.1.4.4" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;"><span id="S4.T1.4.1.4.4.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">0.5320</span></td></tr>
