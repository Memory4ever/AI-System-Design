<tbody class="ltx_tbody">
<tr id="S4.T4.fig1.3.1.2" class="ltx_tr">
<th id="S4.T4.fig1.3.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">DCN</th>
<td id="S4.T4.fig1.3.1.2.2" class="ltx_td ltx_align_center ltx_border_t">0.612</td>
<td id="S4.T4.fig1.3.1.2.3" class="ltx_td ltx_align_center ltx_border_t">0.963</td>
<td id="S4.T4.fig1.3.1.2.4" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">0.534(baseline)</td></tr>
<tr id="S4.T4.fig1.3.1.3" class="ltx_tr">
