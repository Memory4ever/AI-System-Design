<td id="S4.T1.4.1.6.2" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;"><span id="S4.T1.4.1.6.2.1" class="ltx_text" style="--ltx-bg-color:#E3F2FD;">0.2301(+17.9%)</span></td>
<td id="S4.T1.4.1.6.3" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;"><span id="S4.T1.4.1.6.3.1" class="ltx_text" style="--ltx-bg-color:#E3F2FD;">0.4634(+12.45%)</span></td>
<td id="S4.T1.4.1.6.4" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;"><span id="S4.T1.4.1.6.4.1" class="ltx_text" style="--ltx-bg-color:#E3F2FD;">0.5468(+3.01%)</span></td></tr>
<tr id="S4.T1.4.1.7" class="ltx_tr">
<td id="S4.T1.4.1.7.1" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;"><span id="S4.T1.4.1.7.1.1" class="ltx_text" style="--ltx-bg-color:#E3F2FD;">   + Profile as Positional Encoding</span></td>
<td id="S4.T1.4.1.7.2" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;"><span id="S4.T1.4.1.7.2.1" class="ltx_text" style="--ltx-bg-color:#E3F2FD;">0.2351(+20.4%)</span></td>
<td id="S4.T1.4.1.7.3" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;"><span id="S4.T1.4.1.7.3.1" class="ltx_text" style="--ltx-bg-color:#E3F2FD;">0.4774(+15.85%)</span></td>
<td id="S4.T1.4.1.7.4" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;"><span id="S4.T1.4.1.7.4.1" class="ltx_text" style="--ltx-bg-color:#E3F2FD;">0.5568(+4.90%)</span></td></tr>
