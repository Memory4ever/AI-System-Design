<td id="S4.T1.4.1.5.2" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;"><span id="S4.T1.4.1.5.2.1" class="ltx_text" style="--ltx-bg-color:#E3F2FD;">0.2243(+14.9%)</span></td>
<td id="S4.T1.4.1.5.3" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;"><span id="S4.T1.4.1.5.3.1" class="ltx_text" style="--ltx-bg-color:#E3F2FD;">0.4493(+9.03%)</span></td>
<td id="S4.T1.4.1.5.4" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;"><span id="S4.T1.4.1.5.4.1" class="ltx_text" style="--ltx-bg-color:#E3F2FD;">0.5421(+2.13%)</span></td></tr>
<tr id="S4.T1.4.1.6" class="ltx_tr">
