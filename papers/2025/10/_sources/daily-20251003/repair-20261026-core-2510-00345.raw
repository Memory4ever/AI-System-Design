<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Appendix</h2>

<section id="A1.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.1 </span>Jacobian</h3>

<div id="A1.SS1.p1" class="ltx_para ltx_noindent">
<p id="A1.SS1.p1.1" class="ltx_p">In this section, we provide the derivation of <math id="A1.SS1.p1.m1" class="ltx_Math" alttext="{\mathbf{K}}_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>𝐊</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">{\mathbf{K}}_{\ell}</annotation></semantics></math>.</p>
</div>
<div id="A1.SS1.p2" class="ltx_para ltx_noindent">
<p id="A1.SS1.p2.1" class="ltx_p">The derivative of the SA output with respect to the input is</p>
</div>
<div id="A1.SS1.p3" class="ltx_para ltx_noindent">
<table id="A1.E12" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A1.E12X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E12X.m2" class="ltx_Math" alttext="\displaystyle\frac{\partial\mathrm{vec}\left(\text{SA}_{\ell}(\hat{{\mathbf{X}}}_{{\ell}-1})\right)}{\partial\hat{\mathbf{x}}^{(\ell-1)}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mtext>SA</mtext><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝐗</mi><mo>^</mo></mover><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msup><mover accent="true"><mi>𝐱</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\partial\mathrm{vec}\left(\text{SA}_{\ell}(\hat{{\mathbf{X}}}_{{\ell}-1})\right)}{\partial\hat{\mathbf{x}}^{(\ell-1)}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E12X.m3" class="ltx_Math" alttext="\displaystyle=\frac{\partial\mathrm{vec}\left({\mathbf{A}}_{\ell}(\hat{{\mathbf{X}}}_{{\ell}-1}){\mathbf{V}}_{{\ell}}\right)}{\partial\hat{\mathbf{x}}^{(\ell-1)}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>𝐀</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝐗</mi><mo>^</mo></mover><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐕</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msup><mover accent="true"><mi>𝐱</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\partial\mathrm{vec}\left({\mathbf{A}}_{\ell}(\hat{{\mathbf{X}}}_{{\ell}-1}){\mathbf{V}}_{{\ell}}\right)}{\partial\hat{\mathbf{x}}^{(\ell-1)}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(12)</span></td></tr>
<tr id="A1.E12Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E12Xa.m2" class="ltx_Math" alttext="\displaystyle=({{\mathbf{V}}_{\ell}}^{\top}\otimes{\mathbf{I}}_{n}){\mathbf{A}}^{\prime}_{\ell}+({\mathbf{I}}_{d}\otimes{\mathbf{A}}_{\ell})\frac{\partial\mathrm{vec}\left({\mathbf{V}}_{\ell}\right)}{\partial\hat{\mathbf{x}}^{(\ell-1)}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝐕</mi><mi mathvariant="normal">ℓ</mi><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>𝐈</mi><mi>n</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐀</mi><mi mathvariant="normal">ℓ</mi><mo>′</mo></msubsup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐈</mi><mi>d</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>𝐀</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>𝐕</mi><mi mathvariant="normal">ℓ</mi></msub><mo>)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msup><mover accent="true"><mi>𝐱</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=({{\mathbf{V}}_{\ell}}^{\top}\otimes{\mathbf{I}}_{n}){\mathbf{A}}^{\prime}_{\ell}+({\mathbf{I}}_{d}\otimes{\mathbf{A}}_{\ell})\frac{\partial\mathrm{vec}\left({\mathbf{V}}_{\ell}\right)}{\partial\hat{\mathbf{x}}^{(\ell-1)}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E12Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E12Xb.m2" class="ltx_Math" alttext="\displaystyle=({{\mathbf{V}}_{\ell}}^{\top}\otimes{\mathbf{I}}_{n}){\mathbf{A}}^{\prime}_{\ell}+({\mathbf{I}}_{d}\otimes{\mathbf{A}}_{\ell})({{\mathbf{W}}^{\text{V}}_{\ell}}^{\top}\otimes{\mathbf{I}}_{n\times n})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝐕</mi><mi mathvariant="normal">ℓ</mi><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>𝐈</mi><mi>n</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐀</mi><mi mathvariant="normal">ℓ</mi><mo>′</mo></msubsup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐈</mi><mi>d</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>𝐀</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝐖</mi><mi mathvariant="normal">ℓ</mi><mtext>V</mtext><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>𝐈</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=({{\mathbf{V}}_{\ell}}^{\top}\otimes{\mathbf{I}}_{n}){\mathbf{A}}^{\prime}_{\ell}+({\mathbf{I}}_{d}\otimes{\mathbf{A}}_{\ell})({{\mathbf{W}}^{\text{V}}_{\ell}}^{\top}\otimes{\mathbf{I}}_{n\times n})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E12Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E12Xc.m2" class="ltx_Math" alttext="\displaystyle=({{\mathbf{V}}_{\ell}}^{\top}\otimes{\mathbf{I}}_{n}){\mathbf{A}}^{\prime}_{\ell}+{{\mathbf{W}}^{\text{V}}_{\ell}}^{\top}\otimes{\mathbf{A}}_{\ell}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝐕</mi><mi mathvariant="normal">ℓ</mi><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>𝐈</mi><mi>n</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐀</mi><mi mathvariant="normal">ℓ</mi><mo>′</mo></msubsup></mrow><mo>+</mo><mrow><mmultiscripts><mi>𝐖</mi><mi mathvariant="normal">ℓ</mi><mtext>V</mtext><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>𝐀</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=({{\mathbf{V}}_{\ell}}^{\top}\otimes{\mathbf{I}}_{n}){\mathbf{A}}^{\prime}_{\ell}+{{\mathbf{W}}^{\text{V}}_{\ell}}^{\top}\otimes{\mathbf{A}}_{\ell}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS1.p4" class="ltx_para ltx_noindent">
<p id="A1.SS1.p4.1" class="ltx_p">The Jacobian of the attention matrix to the input is</p>
</div>
<div id="A1.SS1.p5" class="ltx_para ltx_noindent">
<table id="A1.E13" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A1.E13X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E13X.m2" class="ltx_Math" alttext="\displaystyle{\mathbf{K}}_{l}" display="inline" intent=":literal"><semantics><msub><mi>𝐊</mi><mi>l</mi></msub><annotation encoding="application/x-tex">\displaystyle{\mathbf{K}}_{l}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E13X.m3" class="ltx_Math" alttext="\displaystyle=\frac{\partial f_{\text{SA}}(\hat{\mathbf{x}}^{(\ell-1)};\theta^{(\ell)})}{\partial\hat{\mathbf{x}}^{(\ell-1)}}\in\mathbb{R}^{nd\times nd}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><msub><mi>f</mi><mtext>SA</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msup><mover accent="true"><mi>𝐱</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\partial f_{\text{SA}}(\hat{\mathbf{x}}^{(\ell-1)};\theta^{(\ell)})}{\partial\hat{\mathbf{x}}^{(\ell-1)}}\in\mathbb{R}^{nd\times nd},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="7" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(13)</span></td></tr>
<tr id="A1.E13Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E13Xa.m2" class="ltx_Math" alttext="\displaystyle=\frac{\partial\mathrm{vec}\left(\text{SA}_{\ell}\left({\mathbf{X}}_{{\ell}-1}\right){\mathbf{W}}_{\ell}^{\text{O}}\right)}{\partial\hat{\mathbf{x}}^{(\ell-1)}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mtext>SA</mtext><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>𝐗</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐖</mi><mi mathvariant="normal">ℓ</mi><mtext>O</mtext></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msup><mover accent="true"><mi>𝐱</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\partial\mathrm{vec}\left(\text{SA}_{\ell}\left({\mathbf{X}}_{{\ell}-1}\right){\mathbf{W}}_{\ell}^{\text{O}}\right)}{\partial\hat{\mathbf{x}}^{(\ell-1)}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E13Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
