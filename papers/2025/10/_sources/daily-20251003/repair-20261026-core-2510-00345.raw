<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E13Xb.m2" class="ltx_Math" alttext="\displaystyle=\frac{\partial\mathrm{vec}\left(\text{SA}_{\ell}({\mathbf{X}}_{{\ell}-1}){\mathbf{W}}_{\ell}^{\text{O}}\right)}{\partial\mathrm{vec}\left(\text{SA}_{\ell}({\mathbf{X}}_{{\ell}-1})\right)}\frac{\partial\mathrm{vec}\left(\text{SA}_{\ell}({\mathbf{X}}_{{\ell}-1})\right)}{\partial\hat{\mathbf{x}}^{(\ell-1)}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mtext>SA</mtext><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐖</mi><mi mathvariant="normal">ℓ</mi><mtext>O</mtext></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mtext>SA</mtext><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mtext>SA</mtext><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msup><mover accent="true"><mi>𝐱</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\partial\mathrm{vec}\left(\text{SA}_{\ell}({\mathbf{X}}_{{\ell}-1}){\mathbf{W}}_{\ell}^{\text{O}}\right)}{\partial\mathrm{vec}\left(\text{SA}_{\ell}({\mathbf{X}}_{{\ell}-1})\right)}\frac{\partial\mathrm{vec}\left(\text{SA}_{\ell}({\mathbf{X}}_{{\ell}-1})\right)}{\partial\hat{\mathbf{x}}^{(\ell-1)}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E13Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E13Xc.m2" class="ltx_Math" alttext="\displaystyle=({{\mathbf{W}}_{\ell}^{\text{O}}}^{\top}\otimes{\mathbf{I}}_{n})\frac{\partial\mathrm{vec}\left(\text{SA}_{\ell}({\mathbf{X}}_{{\ell}-1})\right)}{\partial\hat{\mathbf{x}}^{(\ell-1)}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝐖</mi><mi mathvariant="normal">ℓ</mi><mtext>O</mtext><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>𝐈</mi><mi>n</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mtext>SA</mtext><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msup><mover accent="true"><mi>𝐱</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=({{\mathbf{W}}_{\ell}^{\text{O}}}^{\top}\otimes{\mathbf{I}}_{n})\frac{\partial\mathrm{vec}\left(\text{SA}_{\ell}({\mathbf{X}}_{{\ell}-1})\right)}{\partial\hat{\mathbf{x}}^{(\ell-1)}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E13Xd" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E13Xd.m2" class="ltx_Math" alttext="\displaystyle=({{\mathbf{W}}_{\ell}^{\text{O}}}^{\top}\otimes{\mathbf{I}}_{n})\left(({{\mathbf{V}}_{\ell}}^{\top}\otimes{\mathbf{I}}_{n}){\mathbf{A}}^{\prime}_{\ell}+{{\mathbf{W}}^{\text{V}}_{\ell}}^{\top}\otimes{\mathbf{A}}_{\ell}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝐖</mi><mi mathvariant="normal">ℓ</mi><mtext>O</mtext><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>𝐈</mi><mi>n</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝐕</mi><mi mathvariant="normal">ℓ</mi><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>𝐈</mi><mi>n</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐀</mi><mi mathvariant="normal">ℓ</mi><mo>′</mo></msubsup></mrow><mo>+</mo><mrow><mmultiscripts><mi>𝐖</mi><mi mathvariant="normal">ℓ</mi><mtext>V</mtext><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>𝐀</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=({{\mathbf{W}}_{\ell}^{\text{O}}}^{\top}\otimes{\mathbf{I}}_{n})\left(({{\mathbf{V}}_{\ell}}^{\top}\otimes{\mathbf{I}}_{n}){\mathbf{A}}^{\prime}_{\ell}+{{\mathbf{W}}^{\text{V}}_{\ell}}^{\top}\otimes{\mathbf{A}}_{\ell}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E13Xe" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E13Xe.m2" class="ltx_Math" alttext="\displaystyle=(({{\mathbf{W}}_{\ell}^{\text{O}}}^{\top}{{\mathbf{V}}_{\ell}}^{\top}\otimes{\mathbf{I}}_{n}){\mathbf{A}}^{\prime}_{\ell}+{{\mathbf{W}}_{\ell}^{\text{O}}}^{\top}{{\mathbf{W}}^{\text{V}}_{\ell}}^{\top}\otimes{\mathbf{A}}_{l})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mmultiscripts><mi>𝐖</mi><mi mathvariant="normal">ℓ</mi><mtext>O</mtext><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝐕</mi><mi mathvariant="normal">ℓ</mi><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>𝐈</mi><mi>n</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐀</mi><mi mathvariant="normal">ℓ</mi><mo>′</mo></msubsup></mrow><mo>+</mo><mrow><mrow><mmultiscripts><mi>𝐖</mi><mi mathvariant="normal">ℓ</mi><mtext>O</mtext><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝐖</mi><mi mathvariant="normal">ℓ</mi><mtext>V</mtext><mrow></mrow><mo>⊤</mo></mmultiscripts></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>𝐀</mi><mi>l</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=(({{\mathbf{W}}_{\ell}^{\text{O}}}^{\top}{{\mathbf{V}}_{\ell}}^{\top}\otimes{\mathbf{I}}_{n}){\mathbf{A}}^{\prime}_{\ell}+{{\mathbf{W}}_{\ell}^{\text{O}}}^{\top}{{\mathbf{W}}^{\text{V}}_{\ell}}^{\top}\otimes{\mathbf{A}}_{l})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E13Xf" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E13Xf.m2" class="ltx_Math" alttext="\displaystyle=(\hat{{\mathbf{X}}}_{\ell-1}{{\mathbf{W}}_{\ell}^{\text{V}}}{{\mathbf{W}}_{\ell}^{\text{O}}}\otimes{\mathbf{I}}_{n})^{\top}{\mathbf{A}}^{\prime}_{\ell}+({{\mathbf{W}}_{\ell}^{\text{V}}}{{\mathbf{W}}_{\ell}^{\text{O}}})^{\top}\otimes{\mathbf{A}}_{\ell}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mover accent="true"><mi>𝐗</mi><mo>^</mo></mover><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐖</mi><mi mathvariant="normal">ℓ</mi><mtext>V</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐖</mi><mi mathvariant="normal">ℓ</mi><mtext>O</mtext></msubsup></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>𝐈</mi><mi>n</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐀</mi><mi mathvariant="normal">ℓ</mi><mo>′</mo></msubsup></mrow><mo>+</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐖</mi><mi mathvariant="normal">ℓ</mi><mtext>V</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐖</mi><mi mathvariant="normal">ℓ</mi><mtext>O</mtext></msubsup></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo rspace="0.222em">⊗</mo><msub><mi>𝐀</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=(\hat{{\mathbf{X}}}_{\ell-1}{{\mathbf{W}}_{\ell}^{\text{V}}}{{\mathbf{W}}_{\ell}^{\text{O}}}\otimes{\mathbf{I}}_{n})^{\top}{\mathbf{A}}^{\prime}_{\ell}+({{\mathbf{W}}_{\ell}^{\text{V}}}{{\mathbf{W}}_{\ell}^{\text{O}}})^{\top}\otimes{\mathbf{A}}_{\ell}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.2 </span>Proof</h3>

<section id="A1.SS2.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">A.2.1 </span>Softmax Conditioning</h4>

<div id="A1.SS2.SSS1.p1" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS1.p1.1" class="ltx_p">In this section, we provide the empirical demonstration of the <a href="#Thmproposition1" title='Proposition 1 (Softmax conditioning: diagonal dominance vs. diffuse rows). ‣ 5.2 Initialization for 𝐖^"Q"_ℓ⁢𝐖_ℓ^"K"^⊤ ‣ 5 A New Initialization to Enable Skipless Transformers ‣ Cutting the Skip: Training Residual-Free Transformers' class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">1</span></a>. We conduct a simple simulation experiment and the result is shown in <a href="#A1.F5" title="In A.2.1 Softmax Conditioning ‣ A.2 Proof ‣ Appendix A Appendix ‣ Cutting the Skip: Training Residual-Free Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Fig.</span> <span class="ltx_text ltx_ref_tag">5</span></a>. We choose a square matrix <math id="A1.SS2.SSS1.p1.m1" class="ltx_Math" alttext="{\mathbf{M}}\in{\mathbb{R}}^{10\times 10}" display="inline" intent=":literal"><semantics><mrow><mi>𝐌</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mn>10</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>10</mn></mrow></msup></mrow><annotation encoding="application/x-tex">{\mathbf{M}}\in{\mathbb{R}}^{10\times 10}</annotation></semantics></math> and set <math id="A1.SS2.SSS1.p1.m2" class="ltx_Math" alttext="\alpha=0.1,\beta=5" display="inline" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo>=</mo><mn>0.1</mn></mrow><mo>,</mo><mrow><mi>β</mi><mo>=</mo><mn>5</mn></mrow></mrow><annotation encoding="application/x-tex">\alpha=0.1,\beta=5</annotation></semantics></math> for the ”peak” case and <math id="A1.SS2.SSS1.p1.m3" class="ltx_Math" alttext="\alpha=0.1,\beta=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo>=</mo><mn>0.1</mn></mrow><mo>,</mo><mrow><mi>β</mi><mo>=</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">\alpha=0.1,\beta=0</annotation></semantics></math> for the ”diffuse” case. Empirically, we can see that when choosing large <math id="A1.SS2.SSS1.p1.m4" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> (ensuring diagonal dominance), the softmax produces a near identity matrix with <math id="A1.SS2.SSS1.p1.m5" class="ltx_Math" alttext="\kappa\approx 1.1" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>≈</mo><mn>1.1</mn></mrow><annotation encoding="application/x-tex">\kappa\approx 1.1</annotation></semantics></math>. However, if <math id="A1.SS2.SSS1.p1.m6" class="ltx_Math" alttext="{\mathbf{M}}" display="inline" intent=":literal"><semantics><mi>𝐌</mi><annotation encoding="application/x-tex">{\mathbf{M}}</annotation></semantics></math> is truncated normal initialized, each row of the softmax output is near uniform and the output is ill-conditioned with <math id="A1.SS2.SSS1.p1.m7" class="ltx_Math" alttext="\kappa\approx 730.1" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>≈</mo><mn>730.1</mn></mrow><annotation encoding="application/x-tex">\kappa\approx 730.1</annotation></semantics></math>.</p>
</div>
<figure id="A1.F5" class="ltx_figure"><img src="2510.00345v1/softmax_condition.png" id="A1.F5.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:548/220;" width="548" height="220" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 5: </span><span id="A1.F5.4" class="ltx_text ltx_font_bold">Left:</span> We choose <math id="A1.F5.m3" class="ltx_Math" alttext="\alpha=0.1,\beta=5" display="inline" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo>=</mo><mn>0.1</mn></mrow><mo>,</mo><mrow><mi>β</mi><mo>=</mo><mn>5</mn></mrow></mrow><annotation encoding="application/x-tex">\alpha=0.1,\beta=5</annotation></semantics></math> to ensure diagonal dominance. <span id="A1.F5.5" class="ltx_text ltx_font_bold">Right:</span> We choose <math id="A1.F5.m4" class="ltx_Math" alttext="\alpha=0.1,\beta=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo>=</mo><mn>0.1</mn></mrow><mo>,</mo><mrow><mi>β</mi><mo>=</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">\alpha=0.1,\beta=0</annotation></semantics></math>.</figcaption>
</figure>
<div id="A1.SS2.SSS1.p2" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS1.p2.1" class="ltx_p">Distribution of <math id="A1.SS2.SSS1.p2.m1" class="ltx_Math" alttext="{\mathbf{X}}{\mathbf{X}}^{\top}" display="inline" intent=":literal"><semantics><msup><mi>𝐗𝐗</mi><mo>⊤</mo></msup><annotation encoding="application/x-tex">{\mathbf{X}}{\mathbf{X}}^{\top}</annotation></semantics></math> and <math id="A1.SS2.SSS1.p2.m2" class="ltx_Math" alttext="{\mathbf{X}}{\mathbf{Z}}{\mathbf{X}}^{\top}" display="inline" intent=":literal"><semantics><msup><mi>𝐗𝐙𝐗</mi><mo>⊤</mo></msup><annotation encoding="application/x-tex">{\mathbf{X}}{\mathbf{Z}}{\mathbf{X}}^{\top}</annotation></semantics></math></p>
</div>
<div id="A1.SS2.SSS1.p3" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS1.p3.1" class="ltx_p">Given <math id="A1.SS2.SSS1.p3.m1" class="ltx_Math" alttext="{\mathbf{X}}\in\mathbb{R}^{n\times d}\sim\mathcal{N}(0,{\mathbf{I}})" display="inline" intent=":literal"><semantics><mrow><mi>𝐗</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>𝐈</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{X}}\in\mathbb{R}^{n\times d}\sim\mathcal{N}(0,{\mathbf{I}})</annotation></semantics></math>, we have the mean and varicance of <math id="A1.SS2.SSS1.p3.m2" class="ltx_Math" alttext="{\mathbf{A}}={\mathbf{X}}{\mathbf{X}}^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>𝐀</mi><mo>=</mo><msup><mi>𝐗𝐗</mi><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">{\mathbf{A}}={\mathbf{X}}{\mathbf{X}}^{\top}</annotation></semantics></math> as follows,</p>
</div>
<div id="A1.SS2.SSS1.p4" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS1.p4.1" class="ltx_p">- Diagonal entries (<math id="A1.SS2.SSS1.p4.m1" class="ltx_Math" alttext="i=j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i=j</annotation></semantics></math>):</p>
<table id="A1.E14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E14.m1" class="ltx_Math" alttext="{\mathbf{A}}_{ii}\;\sim\;\chi^{2}_{d},\qquad\mathbb{E}[{\mathbf{A}}_{ii}]=d,\qquad\operatorname{Var}({\mathbf{A}}_{ii})=2d," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝐀</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo lspace="0.558em" rspace="0.558em">∼</mo><msubsup><mi>χ</mi><mi>d</mi><mn>2</mn></msubsup></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>𝐀</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mi>d</mi></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐀</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\mathbf{A}}_{ii}\;\sim\;\chi^{2}_{d},\qquad\mathbb{E}[{\mathbf{A}}_{ii}]=d,\qquad\operatorname{Var}({\mathbf{A}}_{ii})=2d,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14)</span></td></tr></tbody>
</table>
<p id="A1.SS2.SSS1.p4.2" class="ltx_p">where <math id="A1.SS2.SSS1.p4.m2" class="ltx_Math" alttext="\chi" display="inline" intent=":literal"><semantics><mi>χ</mi><annotation encoding="application/x-tex">\chi</annotation></semantics></math> is Wishart distribution.</p>
</div>
<div id="A1.SS2.SSS1.p5" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS1.p5.1" class="ltx_p">- Off-diagonal entries (<math id="A1.SS2.SSS1.p5.m1" class="ltx_Math" alttext="i\neq j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≠</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i\neq j</annotation></semantics></math>):</p>
<table id="A1.E15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E15.m1" class="ltx_Math" alttext="\mathbb{E}[{\mathbf{A}}_{ij}]=0,\qquad\operatorname{Var}({\mathbf{A}}_{ij})=d," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>𝐀</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐀</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>d</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[{\mathbf{A}}_{ij}]=0,\qquad\operatorname{Var}({\mathbf{A}}_{ij})=d,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.SSS1.p6" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS1.p6.1" class="ltx_p">Then given <math id="A1.SS2.SSS1.p6.m1" class="ltx_Math" alttext="{\mathbf{Z}}\sim\mathcal{N}(0,\tfrac{1}{d}{\mathbf{I}})" display="inline" intent=":literal"><semantics><mrow><mi>𝐙</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mfrac><mn>1</mn><mi>d</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝐈</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{Z}}\sim\mathcal{N}(0,\tfrac{1}{d}{\mathbf{I}})</annotation></semantics></math>, we have the mean and variance of
<math id="A1.SS2.SSS1.p6.m2" class="ltx_Math" alttext="{\mathbf{B}}={\mathbf{X}}{\mathbf{Z}}{\mathbf{X}}^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>𝐁</mi><mo>=</mo><msup><mi>𝐗𝐙𝐗</mi><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">{\mathbf{B}}={\mathbf{X}}{\mathbf{Z}}{\mathbf{X}}^{\top}</annotation></semantics></math> as follows,</p>
</div>
<div id="A1.SS2.SSS1.p7" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS1.p7.1" class="ltx_p">- Diagonal entries (<math id="A1.SS2.SSS1.p7.m1" class="ltx_Math" alttext="i=j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i=j</annotation></semantics></math>):</p>
<table id="A1.E16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E16.m1" class="ltx_Math" alttext="\mathbb{E}[{\mathbf{B}}_{ii}]=0,\qquad\operatorname{Var}({\mathbf{B}}_{ii})\;\approx\;d+2." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>𝐁</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐁</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">≈</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[{\mathbf{B}}_{ii}]=0,\qquad\operatorname{Var}({\mathbf{B}}_{ii})\;\approx\;d+2.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.SSS1.p8" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS1.p8.1" class="ltx_p">- Off-diagonal entries (<math id="A1.SS2.SSS1.p8.m1" class="ltx_Math" alttext="i\neq j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≠</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i\neq j</annotation></semantics></math>):</p>
<table id="A1.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E17.m1" class="ltx_Math" alttext="\mathbb{E}[{\mathbf{B}}_{ij}]=0,\qquad\operatorname{Var}({\mathbf{B}}_{ij})\;\approx\;1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>𝐁</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐁</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo>≈</mo><mn> 1</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[{\mathbf{B}}_{ij}]=0,\qquad\operatorname{Var}({\mathbf{B}}_{ij})\;\approx\;1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.SSS1.p9" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS1.p9.1" class="ltx_p">For the combined matrix (attention map) <math id="A1.SS2.SSS1.p9.m1" class="ltx_Math" alttext="{\mathbf{C}}=\alpha{\mathbf{B}}+\beta{\mathbf{A}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐂</mi><mo>=</mo><mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐀</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{C}}=\alpha{\mathbf{B}}+\beta{\mathbf{A}}</annotation></semantics></math>, we have</p>
</div>
<div id="A1.SS2.SSS1.p10" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS1.p10.1" class="ltx_p">- Diagonal entries (<math id="A1.SS2.SSS1.p10.m1" class="ltx_Math" alttext="i=j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i=j</annotation></semantics></math>):</p>
<table id="A1.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E18.m1" class="ltx_Math" alttext="\mathbb{E}[{\mathbf{C}}_{ii}]=\beta d,\qquad\operatorname{Var}({\mathbf{C}}_{ii})\;\approx\;\alpha^{2}(d+2)+\beta^{2}(2d)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>𝐂</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐂</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">≈</mo><mrow><mrow><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[{\mathbf{C}}_{ii}]=\beta d,\qquad\operatorname{Var}({\mathbf{C}}_{ii})\;\approx\;\alpha^{2}(d+2)+\beta^{2}(2d).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.SSS1.p11" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS1.p11.1" class="ltx_p">- Off-diagonal entries (<math id="A1.SS2.SSS1.p11.m1" class="ltx_Math" alttext="i\neq j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≠</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i\neq j</annotation></semantics></math>):</p>
<table id="A1.E19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E19.m1" class="ltx_Math" alttext="\mathbb{E}[{\mathbf{C}}_{ij}]=0,\qquad\operatorname{Var}({\mathbf{C}}_{ij})\;\approx\;\alpha^{2}+\beta^{2}d." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>𝐂</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐂</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">≈</mo><mrow><msup><mi>α</mi><mn>2</mn></msup><mo>+</mo><mrow><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[{\mathbf{C}}_{ij}]=0,\qquad\operatorname{Var}({\mathbf{C}}_{ij})\;\approx\;\alpha^{2}+\beta^{2}d.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.SSS1.p12" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS1.p12.1" class="ltx_p">The default initialization is equivalent to <math id="A1.SS2.SSS1.p12.m1" class="ltx_Math" alttext="\beta=0" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\beta=0</annotation></semantics></math> (no diagonal dominance in weight initialization) and <math id="A1.SS2.SSS1.p12.m2" class="ltx_Math" alttext="\alpha={\mathcal{O}}(\frac{1}{d})" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mfrac><mn>1</mn><mi>d</mi></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\alpha={\mathcal{O}}(\frac{1}{d})</annotation></semantics></math> (usually around <math id="A1.SS2.SSS1.p12.m3" class="ltx_Math" alttext="0.04" display="inline" intent=":literal"><semantics><mn>0.04</mn><annotation encoding="application/x-tex">0.04</annotation></semantics></math>). All the values in the attention map are mean <math id="A1.SS2.SSS1.p12.m4" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> with a variance much smaller than <math id="A1.SS2.SSS1.p12.m5" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, which satisfy the diffuse condition.</p>
</div>
<div id="A1.SS2.SSS1.p13" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS1.p13.1" class="ltx_p">When <math id="A1.SS2.SSS1.p13.m1" class="ltx_Math" alttext="\beta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\beta&gt;0</annotation></semantics></math>, the difference between the diagonal elements and an off-diagonal element <math id="A1.SS2.SSS1.p13.m2" class="ltx_Math" alttext="\gamma={\mathbf{C}}_{ii}-{\mathbf{C}}{ij}" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mrow><msub><mi>𝐂</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo>−</mo><mrow><mi>𝐂</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\gamma={\mathbf{C}}_{ii}-{\mathbf{C}}{ij}</annotation></semantics></math> follows</p>
<table id="A1.E20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E20.m1" class="ltx_Math" alttext="\gamma\sim\mathcal{N}(\beta d,\alpha^{2}(d+3)+\beta^{2}(3d))" display="block" intent=":literal"><semantics><mrow><mi>γ</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>,</mo><mrow><mrow><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\gamma\sim\mathcal{N}(\beta d,\alpha^{2}(d+3)+\beta^{2}(3d))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
<p id="A1.SS2.SSS1.p13.2" class="ltx_p">(The covariance between <math id="A1.SS2.SSS1.p13.m3" class="ltx_Math" alttext="{\mathbf{C}}_{ii}" display="inline" intent=":literal"><semantics><msub><mi>𝐂</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">{\mathbf{C}}_{ii}</annotation></semantics></math> and <math id="A1.SS2.SSS1.p13.m4" class="ltx_Math" alttext="{\mathbf{C}}{ij}" display="inline" intent=":literal"><semantics><mrow><mi>𝐂</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">{\mathbf{C}}{ij}</annotation></semantics></math> is close to <math id="A1.SS2.SSS1.p13.m5" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> when <math id="A1.SS2.SSS1.p13.m6" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> is large.), which satisfy the diagonal dominent condition with a proper <math id="A1.SS2.SSS1.p13.m7" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>.</p>
</div>
</section>
<section id="A1.SS2.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">A.2.2 </span>Proof of Proposed Initialization</h4>

<div id="Thmlemma1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma1.2" class="ltx_text ltx_font_bold">Lemma 1</span></span><span id="Thmlemma1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma1.p1" class="ltx_para">
<p id="Thmlemma1.p1.1" class="ltx_p"><span id="Thmlemma1.p1.1.1" class="ltx_text ltx_font_italic">(Jacobian of the softmax function)
Let <math id="Thmlemma1.p1.m1" class="ltx_Math" alttext="{\mathbf{A}}=\mathrm{softmax}({\mathbf{M}})" display="inline" intent=":literal"><semantics><mrow><mi>𝐀</mi><mo>=</mo><mrow><mi>softmax</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐌</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{A}}=\mathrm{softmax}({\mathbf{M}})</annotation></semantics></math>, where <math id="Thmlemma1.p1.m2" class="ltx_Math" alttext="{\mathbf{M}}={\mathbf{X}}{\mathbf{W}}^{\text{Q}}{\mathbf{W}}^{\text{K}^{\top}}{\mathbf{X}}^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>𝐌</mi><mo>=</mo><mrow><msup><mi>𝐗𝐖</mi><mtext class="ltx_mathvariant_italic">Q</mtext></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐖</mi><msup><mtext class="ltx_mathvariant_italic">K</mtext><mo>⊤</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐗</mi><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{M}}={\mathbf{X}}{\mathbf{W}}^{\text{Q}}{\mathbf{W}}^{\text{K}^{\top}}{\mathbf{X}}^{\top}</annotation></semantics></math>. With the proposed initialization (see in <a href="#S5.E11" title='In 5.2 Initialization for 𝐖^"Q"_ℓ⁢𝐖_ℓ^"K"^⊤ ‣ 5 A New Initialization to Enable Skipless Transformers ‣ Cutting the Skip: Training Residual-Free Transformers' class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">11</span></a>), we can show that the 2-norm of the derivative scales, <math id="Thmlemma1.p1.m3" class="ltx_Math" alttext="\left\|\frac{\partial\mathrm{vec}({\mathbf{A}})}{\partial\mathrm{vec}({\mathbf{X}})}\right\|_{2}=O\left(\alpha e^{-\beta}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mfrac><mrow><mo>∂</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐀</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo>‖</mo></mrow><mn>2</mn></msub><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>β</mi></mrow></msup></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\left\|\frac{\partial\mathrm{vec}({\mathbf{A}})}{\partial\mathrm{vec}({\mathbf{X}})}\right\|_{2}=O\left(\alpha e^{-\beta}\right)</annotation></semantics></math></span></p>
</div>
</div>
<div id="A1.SS2.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS2.SSS2.p1" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS2.p1.1" class="ltx_p"><span id="A1.SS2.SSS2.p1.1.1" class="ltx_text">See the derivation in <a href="#A1.E12" title="In A.1 Jacobian ‣ Appendix A Appendix ‣ Cutting the Skip: Training Residual-Free Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">12</span></a>, we have the bound:</span></p>
</div>
<div id="A1.SS2.SSS2.p2" class="ltx_para ltx_noindent">
<table id="A1.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E21.m1" class="ltx_Math" alttext="\left\|\frac{\partial\mathrm{vec}({\mathbf{A}})}{\partial\mathrm{vec}({\mathbf{X}})}\right\|_{2}\leq\left\|\frac{\partial\mathrm{vec}({\mathbf{A}})}{\partial\mathrm{vec}({\mathbf{M}})}\right\|_{2}\ " display="block" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mfrac><mrow><mo>∂</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐀</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><msub><mrow><mo>‖</mo><mfrac><mrow><mo>∂</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐀</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐌</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\left\|\frac{\partial\mathrm{vec}({\mathbf{A}})}{\partial\mathrm{vec}({\mathbf{X}})}\right\|_{2}\leq\left\|\frac{\partial\mathrm{vec}({\mathbf{A}})}{\partial\mathrm{vec}({\mathbf{M}})}\right\|_{2}\ </annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.SSS2.p3" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS2.p3.1" class="ltx_p"><span id="A1.SS2.SSS2.p3.1.1" class="ltx_text">Since <math id="A1.SS2.SSS2.p3.m1" class="ltx_Math" alttext="\mathrm{softmax}" display="inline" intent=":literal"><semantics><mi>softmax</mi><annotation encoding="application/x-tex">\mathrm{softmax}</annotation></semantics></math> is a row normalization, the Jacobian <math id="A1.SS2.SSS2.p3.m2" class="ltx_Math" alttext="{\mathbf{J}}_{{\mathbf{A}}}=\frac{\partial\mathrm{vec}({\mathbf{A}})}{\partial\mathrm{vec}({\mathbf{M}})}\in{\mathbb{R}}^{n^{2}\times n^{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐉</mi><mi>𝐀</mi></msub><mo>=</mo><mfrac><mrow><mo>∂</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐀</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐌</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo>∈</mo><msup><mi>ℝ</mi><mrow><msup><mi>n</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>n</mi><mn>2</mn></msup></mrow></msup></mrow><annotation encoding="application/x-tex">{\mathbf{J}}_{{\mathbf{A}}}=\frac{\partial\mathrm{vec}({\mathbf{A}})}{\partial\mathrm{vec}({\mathbf{M}})}\in{\mathbb{R}}^{n^{2}\times n^{2}}</annotation></semantics></math> is a block diagonal matrix. For each block <math id="A1.SS2.SSS2.p3.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, we have:</span></p>
<table id="A1.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E22.m1" class="ltx_Math" alttext="({\textnormal{J}}_{{\mathbf{A}},i})_{jk}={\textnormal{A}}_{ij}(\delta_{jk}-{\textnormal{A}}_{ik})," display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mtext>J</mtext><mrow><mi>𝐀</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo>=</mo><mrow><msub><mtext>A</mtext><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>δ</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo>−</mo><msub><mtext>A</mtext><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">({\textnormal{J}}_{{\mathbf{A}},i})_{jk}={\textnormal{A}}_{ij}(\delta_{jk}-{\textnormal{A}}_{ik}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
</table>
<p id="A1.SS2.SSS2.p3.2" class="ltx_p"><span id="A1.SS2.SSS2.p3.2.1" class="ltx_text">where <math id="A1.SS2.SSS2.p3.m4" class="ltx_Math" alttext="{\textnormal{A}}_{ij}" display="inline" intent=":literal"><semantics><msub><mtext>A</mtext><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">{\textnormal{A}}_{ij}</annotation></semantics></math> is the <math id="A1.SS2.SSS2.p3.m5" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th row and <math id="A1.SS2.SSS2.p3.m6" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>-th column entry of <math id="A1.SS2.SSS2.p3.m7" class="ltx_Math" alttext="{\mathbf{A}}" display="inline" intent=":literal"><semantics><mi>𝐀</mi><annotation encoding="application/x-tex">{\mathbf{A}}</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS2.SSS2.p4" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS2.p4.1" class="ltx_p"><span id="A1.SS2.SSS2.p4.1.1" class="ltx_text">Obviously, using our proposed initialization (laerger <math id="A1.SS2.SSS2.p4.m1" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> leads to more diagonally dominant), we have:</span></p>
</div>
<div id="A1.SS2.SSS2.p5" class="ltx_para ltx_noindent">
<table id="A1.E23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E23.m1" class="ltx_Math" alttext="{\textnormal{A}}_{ii}=1-{\mathcal{O}}(\alpha e^{-\beta})\quad\text{and}\quad{\textnormal{A}}_{ij}={\mathcal{O}}(\alpha e^{-\beta})" display="block" intent=":literal"><semantics><mrow><mrow><msub><mtext>A</mtext><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>β</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mtext>A</mtext><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>β</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\textnormal{A}}_{ii}=1-{\mathcal{O}}(\alpha e^{-\beta})\quad\text{and}\quad{\textnormal{A}}_{ij}={\mathcal{O}}(\alpha e^{-\beta})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.SSS2.p6" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS2.p6.1" class="ltx_p"><span id="A1.SS2.SSS2.p6.1.1" class="ltx_text">Based on this, we analyze the order of magnitude of the elements in
<math id="A1.SS2.SSS2.p6.m1" class="ltx_Math" alttext="({\textnormal{J}}_{{\mathbf{A}},i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mtext>J</mtext><mrow><mi>𝐀</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\textnormal{J}}_{{\mathbf{A}},i})</annotation></semantics></math>. In the case of <math id="A1.SS2.SSS2.p6.m2" class="ltx_Math" alttext="j=k" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">j=k</annotation></semantics></math>:</span></p>
</div>
<div id="A1.SS2.SSS2.p7" class="ltx_para ltx_noindent">
<table id="A1.EGx2" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E24.m1" class="ltx_Math" alttext="\displaystyle({\mathbf{J}}_{{\mathbf{A}},i})_{ii}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐉</mi><mrow><mi>𝐀</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">\displaystyle({\mathbf{J}}_{{\mathbf{A}},i})_{ii}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E24.m2" class="ltx_Math" alttext="\displaystyle={\textnormal{A}}_{ii}(1-{\textnormal{A}}_{ii})={\mathcal{O}}(\alpha e^{-\beta}),\text{if }i=j" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mtext>A</mtext><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mtext>A</mtext><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>β</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>=</mo><mi>j</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\textnormal{A}}_{ii}(1-{\textnormal{A}}_{ii})={\mathcal{O}}(\alpha e^{-\beta}),\text{if }i=j</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
<tbody id="A1.E25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E25.m1" class="ltx_Math" alttext="\displaystyle({\mathbf{J}}_{{\mathbf{A}},i})_{ii}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐉</mi><mrow><mi>𝐀</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">\displaystyle({\mathbf{J}}_{{\mathbf{A}},i})_{ii}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E25.m2" class="ltx_Math" alttext="\displaystyle={\textnormal{A}}_{ii}(1-{\textnormal{A}}_{ii})={\mathcal{O}}(\alpha e^{-\beta}),\text{if }i\neq j" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mtext>A</mtext><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mtext>A</mtext><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>β</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>≠</mo><mi>j</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\textnormal{A}}_{ii}(1-{\textnormal{A}}_{ii})={\mathcal{O}}(\alpha e^{-\beta}),\text{if }i\neq j</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.SSS2.p8" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS2.p8.1" class="ltx_p"><span id="A1.SS2.SSS2.p8.1.1" class="ltx_text">In the case of <math id="A1.SS2.SSS2.p8.m1" class="ltx_Math" alttext="j\neq k" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>≠</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">j\neq k</annotation></semantics></math>:</span></p>
</div>
<div id="A1.SS2.SSS2.p9" class="ltx_para ltx_noindent">
<table id="A1.E26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E26.m1" class="ltx_Math" alttext="({\mathbf{J}}_{{\mathbf{A}},i})_{jk}=-{\textnormal{A}}_{ij}{\textnormal{A}}{ik}={\mathcal{O}}(\alpha e^{-\beta})" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐉</mi><mrow><mi>𝐀</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo>=</mo><mrow><mo>−</mo><mrow><msub><mtext>A</mtext><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mtext>A</mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>β</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">({\mathbf{J}}_{{\mathbf{A}},i})_{jk}=-{\textnormal{A}}_{ij}{\textnormal{A}}{ik}={\mathcal{O}}(\alpha e^{-\beta})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.SSS2.p10" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS2.p10.1" class="ltx_p"><span id="A1.SS2.SSS2.p10.1.1" class="ltx_text">Then we have the bound for <math id="A1.SS2.SSS2.p10.m1" class="ltx_Math" alttext="\|{\mathbf{J}}_{{\mathbf{A}},i}\|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">‖</mo><msub><mi>𝐉</mi><mrow><mi>𝐀</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><annotation encoding="application/x-tex">\|{\mathbf{J}}_{{\mathbf{A}},i}\|</annotation></semantics></math>:</span></p>
</div>
<div id="A1.SS2.SSS2.p11" class="ltx_para ltx_noindent">
<table id="A1.E27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E27.m1" class="ltx_Math" alttext="\|{\mathbf{J}}_{{\mathbf{A}},i}\|_{F}=\sqrt{\sum^{d}_{j,k=1}(({\mathbf{J}}_{{\mathbf{A}},i})_{jk})^{2}}=d\cdot{\mathcal{O}}(\alpha e^{-\beta})" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐉</mi><mrow><mi>𝐀</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>=</mo><msqrt><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>j</mi><mo>,</mo><mi>k</mi></mrow><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><msup><mrow><mo lspace="0em" stretchy="false">(</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐉</mi><mrow><mi>𝐀</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></msqrt><mo>=</mo><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>β</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\|{\mathbf{J}}_{{\mathbf{A}},i}\|_{F}=\sqrt{\sum^{d}_{j,k=1}(({\mathbf{J}}_{{\mathbf{A}},i})_{jk})^{2}}=d\cdot{\mathcal{O}}(\alpha e^{-\beta})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(27)</span></td></tr></tbody>
</table>
<p id="A1.SS2.SSS2.p11.1" class="ltx_p"><span id="A1.SS2.SSS2.p11.1.1" class="ltx_text">Therefore, the 2-norm is:</span></p>
</div>
<div id="A1.SS2.SSS2.p12" class="ltx_para ltx_noindent">
<table id="A1.E28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E28.m1" class="ltx_Math" alttext="\|{\mathbf{J}}_{{\mathbf{A}},i}\|_{2}\leq\|{\mathbf{J}}_{{\mathbf{A}},i}\|_{F}={\mathcal{O}}(\alpha e^{-\beta})" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐉</mi><mrow><mi>𝐀</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐉</mi><mrow><mi>𝐀</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>β</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\|{\mathbf{J}}_{{\mathbf{A}},i}\|_{2}\leq\|{\mathbf{J}}_{{\mathbf{A}},i}\|_{F}={\mathcal{O}}(\alpha e^{-\beta})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.SSS2.p13" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS2.p13.1" class="ltx_p"><span id="A1.SS2.SSS2.p13.1.1" class="ltx_text">Then we have :</span></p>
</div>
<div id="A1.SS2.SSS2.p14" class="ltx_para">
<table id="A1.E29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E29.m1" class="ltx_Math" alttext="\left\|\frac{\partial\mathrm{vec}({\mathbf{A}})}{\partial\mathrm{vec}({\mathbf{X}})}\right\|_{2}=\underset{i}{\text{max}}\|{\mathbf{J}}_{{\mathbf{A}},i}\|_{2}={\mathcal{O}}(\alpha e^{-\beta})" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mfrac><mrow><mo>∂</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐀</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo>‖</mo></mrow><mn>2</mn></msub><mo>=</mo><mrow><munder accentunder="true"><mtext>max</mtext><mo mathsize="0.700em">𝑖</mo></munder><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐉</mi><mrow><mi>𝐀</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>β</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\left\|\frac{\partial\mathrm{vec}({\mathbf{A}})}{\partial\mathrm{vec}({\mathbf{X}})}\right\|_{2}=\underset{i}{\text{max}}\|{\mathbf{J}}_{{\mathbf{A}},i}\|_{2}={\mathcal{O}}(\alpha e^{-\beta})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(29)</span></td></tr></tbody>
</table>
<p id="A1.SS2.SSS2.p14.1" class="ltx_p"><span id="A1.SS2.SSS2.p14.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A1.SS2.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">A.2.3 </span>Conditioning of <math id="A1.SS2.SSS3.m1" class="ltx_Math" alttext="{\mathbf{K}}_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>𝐊</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">{\mathbf{K}}_{\ell}</annotation></semantics></math></h4>

<div id="A1.SS2.SSS3.p1" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS3.p1.1" class="ltx_p">In this section we provide the proof for <a href="#Thmproposition2" title='Proposition 2. ‣ 5.2 Initialization for 𝐖^"Q"_ℓ⁢𝐖_ℓ^"K"^⊤ ‣ 5 A New Initialization to Enable Skipless Transformers ‣ Cutting the Skip: Training Residual-Free Transformers' class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">2</span></a></p>
</div>
<div id="A1.SS2.SSS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS2.SSS3.p2" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS3.p2.1" class="ltx_p"><span id="A1.SS2.SSS3.p2.1.1" class="ltx_text">We show that, with proposed initialization, <math id="A1.SS2.SSS3.p2.m1" class="ltx_Math" alttext="{\mathbf{A}}" display="inline" intent=":literal"><semantics><mi>𝐀</mi><annotation encoding="application/x-tex">{\mathbf{A}}</annotation></semantics></math> is well conditioned such that <math id="A1.SS2.SSS3.p2.m2" class="ltx_Math" alttext="\kappa({\mathbf{A}})\approx 1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐀</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≈</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\kappa({\mathbf{A}})\approx 1</annotation></semantics></math></span></p>
</div>
<div id="A1.SS2.SSS3.p3" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS3.p3.1" class="ltx_p"><span id="A1.SS2.SSS3.p3.1.1" class="ltx_text">Next step, we show that the term <math id="A1.SS2.SSS3.p3.m1" class="ltx_Math" alttext="{\mathbf{E}}" display="inline" intent=":literal"><semantics><mi>𝐄</mi><annotation encoding="application/x-tex">{\mathbf{E}}</annotation></semantics></math> is a small perturbation of Jacobian <math id="A1.SS2.SSS3.p3.m2" class="ltx_Math" alttext="{\mathbf{J}}" display="inline" intent=":literal"><semantics><mi>𝐉</mi><annotation encoding="application/x-tex">{\mathbf{J}}</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS2.SSS3.p4" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS3.p4.1" class="ltx_p"><span id="A1.SS2.SSS3.p4.1.1" class="ltx_text">Bound <math id="A1.SS2.SSS3.p4.m1" class="ltx_Math" alttext="\|{\mathbf{E}}\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mi>𝐄</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\|{\mathbf{E}}\|_{2}</annotation></semantics></math> using norm submultiplicativity:</span></p>
<table id="A1.E30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E30.m1" class="ltx_Math" alttext="\|{\mathbf{E}}\|_{2}\leq\|{\mathbf{W}}_{\ell}^{\text{O}}\|_{2}\|{\mathbf{W}}_{\ell}^{\text{V}}\|_{2}\|{\mathbf{X}}_{\ell-1}\|_{2}\left\|\frac{\partial(\mathrm{vec}({\mathbf{A}}_{\ell}({\mathbf{X}}_{\ell-1})))}{\partial{\mathbf{x}}^{\ell-1}}\right\|_{2}" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝐄</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi>𝐖</mi><mi mathvariant="normal">ℓ</mi><mtext>O</mtext></msubsup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi>𝐖</mi><mi mathvariant="normal">ℓ</mi><mtext>V</mtext></msubsup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐗</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mfrac><mrow><mo>∂</mo><mrow><mo stretchy="false">(</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐀</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msup><mi>𝐱</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mfrac><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\|{\mathbf{E}}\|_{2}\leq\|{\mathbf{W}}_{\ell}^{\text{O}}\|_{2}\|{\mathbf{W}}_{\ell}^{\text{V}}\|_{2}\|{\mathbf{X}}_{\ell-1}\|_{2}\left\|\frac{\partial(\mathrm{vec}({\mathbf{A}}_{\ell}({\mathbf{X}}_{\ell-1})))}{\partial{\mathbf{x}}^{\ell-1}}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(30)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.SSS3.p5" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS3.p5.1" class="ltx_p"><span id="A1.SS2.SSS3.p5.1.1" class="ltx_text">Since <math id="A1.SS2.SSS3.p5.m1" class="ltx_Math" alttext="\|{\mathbf{W}}_{\ell}^{\text{O}}{\mathbf{W}}_{\ell}^{V}\|_{2}\leq\|{\mathbf{W}}_{\ell}^{\text{O}}\|_{2}\|{\mathbf{W}}_{\ell}^{\text{V}}\|_{2}=1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>𝐖</mi><mi mathvariant="normal">ℓ</mi><mtext>O</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐖</mi><mi mathvariant="normal">ℓ</mi><mi>V</mi></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi>𝐖</mi><mi mathvariant="normal">ℓ</mi><mtext>O</mtext></msubsup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi>𝐖</mi><mi mathvariant="normal">ℓ</mi><mtext>V</mtext></msubsup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|{\mathbf{W}}_{\ell}^{\text{O}}{\mathbf{W}}_{\ell}^{V}\|_{2}\leq\|{\mathbf{W}}_{\ell}^{\text{O}}\|_{2}\|{\mathbf{W}}_{\ell}^{\text{V}}\|_{2}=1</annotation></semantics></math> and <math id="A1.SS2.SSS3.p5.m2" class="ltx_Math" alttext="\|{\mathbf{X}}\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mi>𝐗</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\|{\mathbf{X}}\|_{2}</annotation></semantics></math> is bounded, using <a href="#Thmlemma1" title="Lemma 1. ‣ A.2.2 Proof of Proposed Initialization ‣ A.2 Proof ‣ Appendix A Appendix ‣ Cutting the Skip: Training Residual-Free Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">1</span></a>, we have:</span></p>
<table id="A1.E31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E31.m1" class="ltx_Math" alttext="\|{\mathbf{W}}_{\ell}^{\text{O}}{\mathbf{W}}_{\ell}^{V}\|_{2}\leq{\mathcal{O}}(\alpha e^{-\beta})" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>𝐖</mi><mi mathvariant="normal">ℓ</mi><mtext>O</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐖</mi><mi mathvariant="normal">ℓ</mi><mi>V</mi></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>β</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\|{\mathbf{W}}_{\ell}^{\text{O}}{\mathbf{W}}_{\ell}^{V}\|_{2}\leq{\mathcal{O}}(\alpha e^{-\beta})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(31)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.SSS3.p6" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS3.p6.1" class="ltx_p"><span id="A1.SS2.SSS3.p6.1.1" class="ltx_text">Combine the bound <math id="A1.SS2.SSS3.p6.m1" class="ltx_Math" alttext="\|{\mathbf{B}}\|_{2}\approx 1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝐁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≈</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|{\mathbf{B}}\|_{2}\approx 1</annotation></semantics></math> and <math id="A1.SS2.SSS3.p6.m2" class="ltx_Math" alttext="\|{\mathbf{E}}\|_{2}\leq{\mathcal{O}}(\alpha e^{-\beta})" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝐄</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>β</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\|{\mathbf{E}}\|_{2}\leq{\mathcal{O}}(\alpha e^{-\beta})</annotation></semantics></math>, and there exists <math id="A1.SS2.SSS3.p6.m3" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> and <math id="A1.SS2.SSS3.p6.m4" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> such that <span id="A1.SS2.SSS3.p6.1.1.1" class="ltx_text"><math id="A1.SS2.SSS3.p6.m5" class="ltx_Math" alttext="\|{\mathbf{E}}\|_{2}\ll\|{\mathbf{B}}\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝐄</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≪</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝐁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\|{\mathbf{E}}\|_{2}\ll\|{\mathbf{B}}\|_{2}</annotation></semantics></math></span>. Therefore <math id="A1.SS2.SSS3.p6.m6" class="ltx_Math" alttext="{\mathbf{E}}" display="inline" intent=":literal"><semantics><mi>𝐄</mi><annotation encoding="application/x-tex">{\mathbf{E}}</annotation></semantics></math> is a small perturbation of <math id="A1.SS2.SSS3.p6.m7" class="ltx_Math" alttext="{\mathbf{B}}" display="inline" intent=":literal"><semantics><mi>𝐁</mi><annotation encoding="application/x-tex">{\mathbf{B}}</annotation></semantics></math> and <math id="A1.SS2.SSS3.p6.m8" class="ltx_Math" alttext="{\mathbf{J}}" display="inline" intent=":literal"><semantics><mi>𝐉</mi><annotation encoding="application/x-tex">{\mathbf{J}}</annotation></semantics></math> is well-conditioned <math id="A1.SS2.SSS3.p6.m9" class="ltx_Math" alttext="\kappa({\mathbf{J}})\approx 1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐉</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≈</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\kappa({\mathbf{J}})\approx 1</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS2.SSS3.p7" class="ltx_para">
<p id="A1.SS2.SSS3.p7.1" class="ltx_p"><span id="A1.SS2.SSS3.p7.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A1.SS2.SSS4" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">A.2.4 </span>Condition of Matrix Concatenation</h4>

<div id="A1.SS2.SSS4.p1" class="ltx_para ltx_noindent">
<table id="A1.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex7.m1" class="ltx_Math" alttext="\text{Let }\mathbf{M}=[\mathbf{A}\;\;\mathbf{B}]\in\mathbb{R}^{n\times(d_{1}+d_{2})}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mtext>Let </mtext><mo lspace="0em" rspace="0em">​</mo><mi>𝐌</mi></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mi>𝐀</mi><mo lspace="0.560em" rspace="0em">​</mo><mi>𝐁</mi></mrow><mo stretchy="false">]</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><msub><mi>d</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\text{Let }\mathbf{M}=[\mathbf{A}\;\;\mathbf{B}]\in\mathbb{R}^{n\times(d_{1}+d_{2})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.SSS4.p1.1" class="ltx_p">Denote the spectral norms and minimal singular values by</p>
<table id="A1.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex8.m1" class="ltx_Math" alttext="s_{\max}=\max\{\sigma_{\max}(\mathbf{A}),\sigma_{\max}(\mathbf{B})\},\quad s_{\min}=\min\{\sigma_{\min}(\mathbf{A}),\sigma_{\min}(\mathbf{B})\}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>s</mi><mi>max</mi></msub><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>σ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐀</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>σ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐁</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>s</mi><mi>min</mi></msub><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>σ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐀</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>σ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐁</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">s_{\max}=\max\{\sigma_{\max}(\mathbf{A}),\sigma_{\max}(\mathbf{B})\},\quad s_{\min}=\min\{\sigma_{\min}(\mathbf{A}),\sigma_{\min}(\mathbf{B})\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.SSS4.p1.2" class="ltx_p">and the mutual coherence parameter measuring alignment between <math id="A1.SS2.SSS4.p1.m1" class="ltx_Math" alttext="\mathbf{A}" display="inline" intent=":literal"><semantics><mi>𝐀</mi><annotation encoding="application/x-tex">\mathbf{A}</annotation></semantics></math> and <math id="A1.SS2.SSS4.p1.m2" class="ltx_Math" alttext="\mathbf{B}" display="inline" intent=":literal"><semantics><mi>𝐁</mi><annotation encoding="application/x-tex">\mathbf{B}</annotation></semantics></math> and a balanced condition <math id="A1.SS2.SSS4.p1.m3" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> measuring the norm difference of the matrices:</p>
<table id="A1.E32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E32.m1" class="ltx_Math" alttext="\rho:=\|\mathbf{A}^{\top}\mathbf{B}\|_{2}," display="block" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo>:=</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝐀</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\rho:=\|\mathbf{A}^{\top}\mathbf{B}\|_{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(32)</span></td></tr></tbody>
</table>
<table id="A1.E33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E33.m1" class="ltx_Math" alttext="\tau:=\frac{\max\{\|\mathbf{A}\|_{2},\|\mathbf{B}\|_{2}\}}{\min\{\|\mathbf{A}\|_{2},\|\mathbf{B}\|_{2}\}}=\frac{\max\{\sigma_{\max}(\mathbf{A}),\sigma_{\max}(\mathbf{B})\}}{\min\{\sigma_{\max}(\mathbf{A}),\sigma_{\max}(\mathbf{B})\}}." display="block" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo>:=</mo><mfrac><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝐀</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>,</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝐁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo stretchy="false">}</mo></mrow></mrow><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝐀</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>,</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝐁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo stretchy="false">}</mo></mrow></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>σ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐀</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>σ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐁</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>σ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐀</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>σ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐁</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tau:=\frac{\max\{\|\mathbf{A}\|_{2},\|\mathbf{B}\|_{2}\}}{\min\{\|\mathbf{A}\|_{2},\|\mathbf{B}\|_{2}\}}=\frac{\max\{\sigma_{\max}(\mathbf{A}),\sigma_{\max}(\mathbf{B})\}}{\min\{\sigma_{\max}(\mathbf{A}),\sigma_{\max}(\mathbf{B})\}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(33)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.SSS4.p2" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS4.p2.1" class="ltx_p">For any nonzero vectors <math id="A1.SS2.SSS4.p2.m1" class="ltx_Math" alttext="\mathbf{x}\in\mathbb{R}^{d_{1}},\mathbf{y}\in\mathbb{R}^{d_{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐱</mi><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mn>1</mn></msub></msup></mrow><mo>,</mo><mrow><mi>𝐲</mi><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mn>2</mn></msub></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}\in\mathbb{R}^{d_{1}},\mathbf{y}\in\mathbb{R}^{d_{2}}</annotation></semantics></math> we have</p>
<table id="A1.E34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E34.m1" class="ltx_Math" alttext="\frac{\|\mathbf{M}\begin{bmatrix}\mathbf{x}\\
\mathbf{y}\end{bmatrix}\|^{2}}{\|\begin{bmatrix}\mathbf{x}\\
\mathbf{y}\end{bmatrix}\|^{2}}=\frac{\begin{bmatrix}\mathbf{x}\\
\mathbf{y}\end{bmatrix}^{\top}\mathbf{M}^{\top}\mathbf{M}\begin{bmatrix}\mathbf{x}\\
\mathbf{y}\end{bmatrix}}{\|\mathbf{x}\|^{2}+\|\mathbf{y}\|^{2}}=\frac{\|\mathbf{A}\mathbf{x}\|^{2}+\|\mathbf{B}\mathbf{y}\|^{2}+2\langle\mathbf{A}\mathbf{x},\mathbf{B}\mathbf{y}\rangle}{\|\mathbf{x}\|^{2}+\|\mathbf{y}\|^{2}}." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><msup><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐌</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝐱</mi></mtd></mtr><mtr><mtd><mi>𝐲</mi></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><msup><mrow><mo stretchy="false">‖</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝐱</mi></mtd></mtr><mtr><mtd><mi>𝐲</mi></mtd></mtr></mtable><mo>]</mo></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mfrac><mo>=</mo><mfrac><mrow><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝐱</mi></mtd></mtr><mtr><mtd><mi>𝐲</mi></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐌</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝐱</mi></mtd></mtr><mtr><mtd><mi>𝐲</mi></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝐲</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mfrac><mo>=</mo><mfrac><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>𝐀𝐱</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝐁𝐲</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><mi>𝐀𝐱</mi><mo>,</mo><mi>𝐁𝐲</mi></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝐲</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\|\mathbf{M}\begin{bmatrix}\mathbf{x}\\
\mathbf{y}\end{bmatrix}\|^{2}}{\|\begin{bmatrix}\mathbf{x}\\
\mathbf{y}\end{bmatrix}\|^{2}}=\frac{\begin{bmatrix}\mathbf{x}\\
\mathbf{y}\end{bmatrix}^{\top}\mathbf{M}^{\top}\mathbf{M}\begin{bmatrix}\mathbf{x}\\
\mathbf{y}\end{bmatrix}}{\|\mathbf{x}\|^{2}+\|\mathbf{y}\|^{2}}=\frac{\|\mathbf{A}\mathbf{x}\|^{2}+\|\mathbf{B}\mathbf{y}\|^{2}+2\langle\mathbf{A}\mathbf{x},\mathbf{B}\mathbf{y}\rangle}{\|\mathbf{x}\|^{2}+\|\mathbf{y}\|^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(34)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.SSS4.p3" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS4.p3.1" class="ltx_p">Hence the largest singular value of <math id="A1.SS2.SSS4.p3.m1" class="ltx_Math" alttext="\mathbf{M}" display="inline" intent=":literal"><semantics><mi>𝐌</mi><annotation encoding="application/x-tex">\mathbf{M}</annotation></semantics></math> is</p>
<table id="A1.E35" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A1.E35X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E35X.m2" class="ltx_Math" alttext="\displaystyle\sigma_{\max}(\mathbf{M})^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>𝐌</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\sigma_{\max}(\mathbf{M})^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E35X.m3" class="ltx_Math" alttext="\displaystyle=\max_{\mathbf{x},\mathbf{y}\neq 0}\frac{\|\mathbf{A}\mathbf{x}\|^{2}+\|\mathbf{B}\mathbf{y}\|^{2}+2\langle\mathbf{A}\mathbf{x},\mathbf{B}\mathbf{y}\rangle}{\|\mathbf{x}\|^{2}+\|\mathbf{y}\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><munder><mi>max</mi><mrow><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow><mo>≠</mo><mn>0</mn></mrow></munder><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>𝐀𝐱</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝐁𝐲</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><mi>𝐀𝐱</mi><mo>,</mo><mi>𝐁𝐲</mi></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝐲</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\max_{\mathbf{x},\mathbf{y}\neq 0}\frac{\|\mathbf{A}\mathbf{x}\|^{2}+\|\mathbf{B}\mathbf{y}\|^{2}+2\langle\mathbf{A}\mathbf{x},\mathbf{B}\mathbf{y}\rangle}{\|\mathbf{x}\|^{2}+\|\mathbf{y}\|^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(35)</span></td></tr>
<tr id="A1.E35Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E35Xa.m2" class="ltx_Math" alttext="\displaystyle\leq\max_{\mathbf{x},\mathbf{y}\neq 0}\frac{\sigma_{\max}(\mathbf{A})^{2}\|\mathbf{x}\|^{2}+\sigma_{\max}(\mathbf{B})^{2}\|\mathbf{y}\|^{2}+2\rho\|\mathbf{x}\|\|\mathbf{y}\|}{\|\mathbf{x}\|^{2}+\|\mathbf{y}\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><munder><mi>max</mi><mrow><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow><mo>≠</mo><mn>0</mn></mrow></munder><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi>σ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>𝐀</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msub><mi>σ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>𝐁</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝐲</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mi>𝐲</mi><mo stretchy="false">‖</mo></mrow></mrow></mrow><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝐲</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\max_{\mathbf{x},\mathbf{y}\neq 0}\frac{\sigma_{\max}(\mathbf{A})^{2}\|\mathbf{x}\|^{2}+\sigma_{\max}(\mathbf{B})^{2}\|\mathbf{y}\|^{2}+2\rho\|\mathbf{x}\|\|\mathbf{y}\|}{\|\mathbf{x}\|^{2}+\|\mathbf{y}\|^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E35Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E35Xb.m2" class="ltx_Math" alttext="\displaystyle\leq\max\{\sigma_{\max}(\mathbf{A})^{2},\sigma_{\max}(\mathbf{B})^{2}\}+\max_{\mathbf{x},\mathbf{y}\neq 0}\frac{2\rho\|\mathbf{x}\|\|\mathbf{y}\|}{\|\mathbf{x}\|^{2}+\|\mathbf{y}\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>σ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>𝐀</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>,</mo><mrow><msub><mi>σ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>𝐁</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>+</mo><mrow><munder><mi>max</mi><mrow><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow><mo>≠</mo><mn>0</mn></mrow></munder><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mi>𝐲</mi><mo stretchy="false">‖</mo></mrow></mrow><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝐲</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\max\{\sigma_{\max}(\mathbf{A})^{2},\sigma_{\max}(\mathbf{B})^{2}\}+\max_{\mathbf{x},\mathbf{y}\neq 0}\frac{2\rho\|\mathbf{x}\|\|\mathbf{y}\|}{\|\mathbf{x}\|^{2}+\|\mathbf{y}\|^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E35Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E35Xc.m2" class="ltx_Math" alttext="\displaystyle\leq s_{\max}^{2}+\rho." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msubsup><mi>s</mi><mi>max</mi><mn>2</mn></msubsup><mo>+</mo><mi>ρ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq s_{\max}^{2}+\rho.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.SSS4.p4" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS4.p4.1" class="ltx_p">The smallest singular value of <math id="A1.SS2.SSS4.p4.m1" class="ltx_Math" alttext="\mathbf{M}" display="inline" intent=":literal"><semantics><mi>𝐌</mi><annotation encoding="application/x-tex">\mathbf{M}</annotation></semantics></math> is</p>
<table id="A1.E36" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A1.E36X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E36X.m2" class="ltx_Math" alttext="\displaystyle\sigma_{\min}(\mathbf{M})^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>𝐌</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\sigma_{\min}(\mathbf{M})^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E36X.m3" class="ltx_Math" alttext="\displaystyle=\min_{\mathbf{x},\mathbf{y}\neq 0}\frac{\|\mathbf{A}\mathbf{x}\|^{2}+\|\mathbf{B}\mathbf{y}\|^{2}+2\langle\mathbf{A}\mathbf{x},\mathbf{B}\mathbf{y}\rangle}{\|\mathbf{x}\|^{2}+\|\mathbf{y}\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><munder><mi>min</mi><mrow><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow><mo>≠</mo><mn>0</mn></mrow></munder><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>𝐀𝐱</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝐁𝐲</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><mi>𝐀𝐱</mi><mo>,</mo><mi>𝐁𝐲</mi></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝐲</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\min_{\mathbf{x},\mathbf{y}\neq 0}\frac{\|\mathbf{A}\mathbf{x}\|^{2}+\|\mathbf{B}\mathbf{y}\|^{2}+2\langle\mathbf{A}\mathbf{x},\mathbf{B}\mathbf{y}\rangle}{\|\mathbf{x}\|^{2}+\|\mathbf{y}\|^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(36)</span></td></tr>
<tr id="A1.E36Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E36Xa.m2" class="ltx_Math" alttext="\displaystyle\geq\min_{\mathbf{x},\mathbf{y}\neq 0}\frac{\sigma_{\min}(\mathbf{A})^{2}\|\mathbf{x}\|^{2}+\sigma_{\min}(\mathbf{B})^{2}\|\mathbf{y}\|^{2}-2\rho\|\mathbf{x}\|\|\mathbf{y}\|}{\|\mathbf{x}\|^{2}+\|\mathbf{y}\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><munder><mi>min</mi><mrow><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow><mo>≠</mo><mn>0</mn></mrow></munder><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><msub><mi>σ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>𝐀</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msub><mi>σ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>𝐁</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝐲</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mi>𝐲</mi><mo stretchy="false">‖</mo></mrow></mrow></mrow><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝐲</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\min_{\mathbf{x},\mathbf{y}\neq 0}\frac{\sigma_{\min}(\mathbf{A})^{2}\|\mathbf{x}\|^{2}+\sigma_{\min}(\mathbf{B})^{2}\|\mathbf{y}\|^{2}-2\rho\|\mathbf{x}\|\|\mathbf{y}\|}{\|\mathbf{x}\|^{2}+\|\mathbf{y}\|^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E36Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E36Xb.m2" class="ltx_Math" alttext="\displaystyle\geq\min\{\sigma_{\min}(\mathbf{A})^{2},\sigma_{\min}(\mathbf{B})^{2}\}+\min_{\mathbf{x},\mathbf{y}\neq 0}\frac{-2\rho\|\mathbf{x}\|\|\mathbf{y}\|}{\|\mathbf{x}\|^{2}+\|\mathbf{y}\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>σ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>𝐀</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>,</mo><mrow><msub><mi>σ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>𝐁</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>+</mo><mrow><munder><mi>min</mi><mrow><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow><mo>≠</mo><mn>0</mn></mrow></munder><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mi>𝐲</mi><mo stretchy="false">‖</mo></mrow></mrow></mrow><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝐲</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\min\{\sigma_{\min}(\mathbf{A})^{2},\sigma_{\min}(\mathbf{B})^{2}\}+\min_{\mathbf{x},\mathbf{y}\neq 0}\frac{-2\rho\|\mathbf{x}\|\|\mathbf{y}\|}{\|\mathbf{x}\|^{2}+\|\mathbf{y}\|^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E36Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E36Xc.m2" class="ltx_Math" alttext="\displaystyle\geq s_{\min}^{2}-\rho." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≥</mo><mrow><msubsup><mi>s</mi><mi>min</mi><mn>2</mn></msubsup><mo>−</mo><mi>ρ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq s_{\min}^{2}-\rho.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.SSS4.p5" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS4.p5.1" class="ltx_p">Therefore</p>
<table id="A1.E37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E37.m1" class="ltx_Math" alttext="\kappa(\mathbf{M})\;=\;\frac{\sigma_{\max}(\mathbf{M})}{\sigma_{\min}(\mathbf{M})}\leq\sqrt{\frac{s_{\max}^{2}+\rho}{s_{\min}^{2}-\rho}}\leq\sqrt{\frac{1+\tfrac{\rho}{s_{\max}^{2}}}{1-\tfrac{\rho}{s_{\min}^{2}}}}\,\cdot\frac{s_{\max}}{s_{\min}}\leq\tau\sqrt{\frac{1+\tfrac{\rho}{s_{\max}^{2}}}{1-\tfrac{\rho}{s_{\min}^{2}}}}\,\kappa_{\max}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐌</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">=</mo><mfrac><mrow><msub><mi>σ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐌</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>σ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐌</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>≤</mo><msqrt><mfrac><mrow><msubsup><mi>s</mi><mi>max</mi><mn>2</mn></msubsup><mo>+</mo><mi>ρ</mi></mrow><mrow><msubsup><mi>s</mi><mi>min</mi><mn>2</mn></msubsup><mo>−</mo><mi>ρ</mi></mrow></mfrac></msqrt><mo>≤</mo><mrow><msqrt><mfrac><mrow><mn>1</mn><mo>+</mo><mfrac><mi>ρ</mi><msubsup><mi>s</mi><mi>max</mi><mn>2</mn></msubsup></mfrac></mrow><mrow><mn>1</mn><mo>−</mo><mfrac><mi>ρ</mi><msubsup><mi>s</mi><mi>min</mi><mn>2</mn></msubsup></mfrac></mrow></mfrac></msqrt><mo lspace="0.392em" rspace="0.222em">⋅</mo><mfrac><msub><mi>s</mi><mi>max</mi></msub><msub><mi>s</mi><mi>min</mi></msub></mfrac></mrow><mo>≤</mo><mrow><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><mn>1</mn><mo>+</mo><mfrac><mi>ρ</mi><msubsup><mi>s</mi><mi>max</mi><mn>2</mn></msubsup></mfrac></mrow><mrow><mn>1</mn><mo>−</mo><mfrac><mi>ρ</mi><msubsup><mi>s</mi><mi>min</mi><mn>2</mn></msubsup></mfrac></mrow></mfrac></msqrt><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>κ</mi><mi>max</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\kappa(\mathbf{M})\;=\;\frac{\sigma_{\max}(\mathbf{M})}{\sigma_{\min}(\mathbf{M})}\leq\sqrt{\frac{s_{\max}^{2}+\rho}{s_{\min}^{2}-\rho}}\leq\sqrt{\frac{1+\tfrac{\rho}{s_{\max}^{2}}}{1-\tfrac{\rho}{s_{\min}^{2}}}}\,\cdot\frac{s_{\max}}{s_{\min}}\leq\tau\sqrt{\frac{1+\tfrac{\rho}{s_{\max}^{2}}}{1-\tfrac{\rho}{s_{\min}^{2}}}}\,\kappa_{\max},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(37)</span></td></tr></tbody>
</table>
<p id="A1.SS2.SSS4.p5.2" class="ltx_p">where <math id="A1.SS2.SSS4.p5.m1" class="ltx_Math" alttext="\kappa_{\max}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mi>max</mi></msub><annotation encoding="application/x-tex">\kappa_{\max}</annotation></semantics></math> is the largest condition number of the component matrices.</p>
</div>
<div id="A1.SS2.SSS4.p6" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS4.p6.1" class="ltx_p">Under a mild block-incoherence condition (i.e., <math id="A1.SS2.SSS4.p6.m1" class="ltx_Math" alttext="\rho\rightarrow 0" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\rho\rightarrow 0</annotation></semantics></math>), and balanced blocks (<math id="A1.SS2.SSS4.p6.m2" class="ltx_Math" alttext="\tau\rightarrow 1" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo stretchy="false">→</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\tau\rightarrow 1</annotation></semantics></math>), the concatenated condition number is controlled by the worst block condition number <math id="A1.SS2.SSS4.p6.m3" class="ltx_Math" alttext="\kappa_{\max}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mi>max</mi></msub><annotation encoding="application/x-tex">\kappa_{\max}</annotation></semantics></math>.</p>
</div>
</section>
</section>
<section id="A1.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.3 </span>Visualization</h3>

<figure id="A1.F6" class="ltx_figure"><img src="2510.00345v1/viz_appendix.png" id="A1.F6.g1" class="ltx_graphics ltx_centering ltx_img_portrait" style="aspect-ratio:548/744;" width="548" height="744" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 6: </span>PCA visualization of representation</figcaption>
</figure>
</section>
</section>
