<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.100)</span></td></tr></tbody>
<tbody id="A5.E101"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E101.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sup_{{\color[rgb]{0,0,0}f}\in{\color[rgb]{0,0,0}\mathcal{F}}}\left\{\ex\left[{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right]-{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right\}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.1389em">=</mo><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi></mrow></munder><mrow><mo>{</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>−</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sup_{{\color[rgb]{0,0,0}f}\in{\color[rgb]{0,0,0}\mathcal{F}}}\left\{\ex\left[{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right]-{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.101)</span></td></tr></tbody>
<tbody id="A5.E102"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E102.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sup_{{\color[rgb]{0,0,0}f}\in{\color[rgb]{0,0,0}\mathcal{F}}}\frac{1}{{\color[rgb]{0,0,0}N}{\color[rgb]{0,0,0}T}}\left\{\ex\left[\sum_{{\color[rgb]{0,0,0}n}=1}^{{\color[rgb]{0,0,0}N}}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{{\color[rgb]{0,0,0}T}}{\color[rgb]{0,0,0}\ell}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}({\color[rgb]{0,0,0}f}({\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-1}^{\color[rgb]{0,0,0}n}),{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n})\right]-\sum_{{\color[rgb]{0,0,0}n}=1}^{{\color[rgb]{0,0,0}N}}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{{\color[rgb]{0,0,0}T}}{\color[rgb]{0,0,0}\ell}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}({\color[rgb]{0,0,0}f}({\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-1}^{\color[rgb]{0,0,0}n}),{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n})\right\}\,." display="inline" intent=":literal"><semantics><mrow><mo rspace="0.1389em">=</mo><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi></mrow></munder><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></mfrac></mstyle><mrow><mo>{</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">ℓ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mrow><mo stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>−</mo><mn>1</mn></mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>−</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">ℓ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mrow><mo stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>−</mo><mn>1</mn></mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>}</mo></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sup_{{\color[rgb]{0,0,0}f}\in{\color[rgb]{0,0,0}\mathcal{F}}}\frac{1}{{\color[rgb]{0,0,0}N}{\color[rgb]{0,0,0}T}}\left\{\ex\left[\sum_{{\color[rgb]{0,0,0}n}=1}^{{\color[rgb]{0,0,0}N}}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{{\color[rgb]{0,0,0}T}}{\color[rgb]{0,0,0}\ell}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}({\color[rgb]{0,0,0}f}({\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-1}^{\color[rgb]{0,0,0}n}),{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n})\right]-\sum_{{\color[rgb]{0,0,0}n}=1}^{{\color[rgb]{0,0,0}N}}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{{\color[rgb]{0,0,0}T}}{\color[rgb]{0,0,0}\ell}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}({\color[rgb]{0,0,0}f}({\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-1}^{\color[rgb]{0,0,0}n}),{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n})\right\}\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.102)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p11.3" class="ltx_p"><span id="A5.SS3.p11.3.1" class="ltx_text">By <a href="#Thmassumption8" title="Assumption 8 (Lipschitz model and loss). ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">8</span></a>, <math id="A5.SS3.p11.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is coordinate-wise Lipschitz with respect to <math id="A5.SS3.p11.m2" class="ltx_Math" alttext="{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n}</annotation></semantics></math> with constant <math id="A5.SS3.p11.m3" class="ltx_Math" alttext="{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}\coloneqq{\color[rgb]{0,0,0}L}_{\color[rgb]{0,0,0}T}/{\color[rgb]{0,0,0}N}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo>≔</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo>/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}\coloneqq{\color[rgb]{0,0,0}L}_{\color[rgb]{0,0,0}T}/{\color[rgb]{0,0,0}N}</annotation></semantics></math> and formally constant with respect to <math id="A5.SS3.p11.m4" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n}</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS3.p12" class="ltx_para">
<p id="A5.SS3.p12.1" class="ltx_p"><span id="A5.SS3.p12.1.1" class="ltx_text">By <a href="#A5.Thmlemma6" title="Lemma E.6. ‣ E.2 Technical lemmas ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">E.6</span></a> and <a href="#Thmassumption7" title="Assumption 7 (Sub-Gaussian data). ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">7</span></a>, <math id="A5.SS3.p12.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n}\lVert{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n}-{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\prime{\color[rgb]{0,0,0}n}}\rVert" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo fence="true" rspace="0em">∥</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo>−</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></mrow></msubsup></mrow><mo fence="true" lspace="0em">∥</mo></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n}\lVert{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n}-{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\prime{\color[rgb]{0,0,0}n}}\rVert</annotation></semantics></math> is <math id="A5.SS3.p12.m2" class="ltx_Math" alttext="4{\color[rgb]{0,0,0}\sigma}^{2}" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">4{\color[rgb]{0,0,0}\sigma}^{2}</annotation></semantics></math>-sub-Gaussian conditionally on <math id="A5.SS3.p12.m3" class="ltx_math_unparsed" alttext="{\color[rgb]{0,0,0}x}_{1:({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-1)},{\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x}_{1:({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-1)},{\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n}</annotation></semantics></math>, for <math id="A5.SS3.p12.m4" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n}</annotation></semantics></math> a Rademacher variable independent of all data.</span></p>
</div>
<div id="A5.SS3.p13" class="ltx_para">
<p id="A5.SS3.p13.1" class="ltx_p"><span id="A5.SS3.p13.1.1" class="ltx_text">We now apply <a href="#A5.Thmtheorem1" title="Theorem E.1 (Causal symmetrization). ‣ E.1 Moment bounds for general functions ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">E.1</span></a> with <math id="A5.SS3.p13.m1" class="ltx_Math" alttext="h(x)=|x|^{\color[rgb]{0,0,0}r}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mrow><mo stretchy="false">|</mo><mi>x</mi><mo stretchy="false">|</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></msup></mrow><annotation encoding="application/x-tex">h(x)=|x|^{\color[rgb]{0,0,0}r}</annotation></semantics></math> for <math id="A5.SS3.p13.m2" class="ltx_Math" alttext="{\color[rgb]{0,0,0}r}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}r}</annotation></semantics></math> integer such that <math id="A5.SS3.p13.m3" class="ltx_Math" alttext="2\leq{\color[rgb]{0,0,0}r}\leq{\color[rgb]{0,0,0}q}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></mrow><annotation encoding="application/x-tex">2\leq{\color[rgb]{0,0,0}r}\leq{\color[rgb]{0,0,0}q}</annotation></semantics></math> and <math id="A5.SS3.p13.m4" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math> corresponding to the indices of the tasks <math id="A5.SS3.p13.m5" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\theta}_{1},\ldots,{\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}N}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></msub></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\theta}_{1},\ldots,{\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}N}</annotation></semantics></math>. We obtain that</span></p>
<table id="A5.EGx59" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E103"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
