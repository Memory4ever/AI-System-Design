</div>
</div>
<div id="A4.SS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS4.p2" class="ltx_para">
<p id="A4.SS4.p2.1" class="ltx_p"><span id="A4.SS4.p2.1.1" class="ltx_text">First, let us consider <math id="A4.SS4.p2.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\theta}\in{\color[rgb]{0,0,0}\Theta^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∈</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\theta}\in{\color[rgb]{0,0,0}\Theta^{\prime}}</annotation></semantics></math> and <math id="A4.SS4.p2.m2" class="ltx_math_unparsed" alttext="{\color[rgb]{0,0,0}X}={\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}\in{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}^{\color[rgb]{0,0,0}T}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo>=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo>∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><msup><mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><msup><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}X}={\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}\in{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}^{\color[rgb]{0,0,0}T}</annotation></semantics></math>. We have</span></p>
<table id="A4.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E38.m1" class="ltx_Math" alttext="\displaystyle\exp\left(-\frac{1}{{\color[rgb]{0,0,0}\mu}}\log\frac{\density_{#1}({\color[rgb]{0,0,0}X}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}X}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right)" display="inline" intent=":literal"><semantics><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="false" lspace="0.170em" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="false" lspace="0.170em" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mfrac></mstyle></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\exp\left(-\frac{1}{{\color[rgb]{0,0,0}\mu}}\log\frac{\density_{#1}({\color[rgb]{0,0,0}X}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}X}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E38.m2" class="ltx_math_unparsed" alttext="\displaystyle=\exp\left(\frac{1}{{\color[rgb]{0,0,0}\mu}}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=0}^{{\color[rgb]{0,0,0}T}-1}\log\frac{\density_{#1}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\mid{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}},{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\mid{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}\right)\," display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>exp</mi><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></msub><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></msub><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\exp\left(\frac{1}{{\color[rgb]{0,0,0}\mu}}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=0}^{{\color[rgb]{0,0,0}T}-1}\log\frac{\density_{#1}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\mid{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}},{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\mid{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}\right)\,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.38)</span></td></tr></tbody>
</table>
</div>
<div id="A4.SS4.p3" class="ltx_para">
<p id="A4.SS4.p3.1" class="ltx_p"><span id="A4.SS4.p3.1.1" class="ltx_text">Invoking the bracketing definition (Definition <a href="#Thmdefinition2" title="Definition 2. ‣ D.4 Task Selection Bound for ICL ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>), we obtain sets <math id="A4.SS4.p3.m1" class="ltx_Math" alttext="U_{j}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>j</mi></msub><annotation encoding="application/x-tex">U_{j}</annotation></semantics></math>, for <math id="A4.SS4.p3.m2" class="ltx_Math" alttext="j=1,\dots,{\color[rgb]{0,0,0}\mathcal{B}}({\color[rgb]{0,0,0}\Theta^{\prime}},\varepsilon,{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}},{\color[rgb]{0,0,0}T})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>,</mo><mi>ε</mi><mo>,</mo><msup><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">j=1,\dots,{\color[rgb]{0,0,0}\mathcal{B}}({\color[rgb]{0,0,0}\Theta^{\prime}},\varepsilon,{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}},{\color[rgb]{0,0,0}T})</annotation></semantics></math> such that, for any <math id="A4.SS4.p3.m3" class="ltx_Math" alttext="{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\leq{\color[rgb]{0,0,0}T}-1" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>≤</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\leq{\color[rgb]{0,0,0}T}-1</annotation></semantics></math>, any <math id="A4.SS4.p3.m4" class="ltx_math_unparsed" alttext="{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\in{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}^{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo>∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><msup><mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><msup><mrow></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\in{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}^{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}</annotation></semantics></math>, any <math id="A4.SS4.p3.m5" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>, with <math id="A4.SS4.p3.m6" class="ltx_math_unparsed" alttext="{\color[rgb]{0,0,0}g}_{j}(\cdot\mid\cdot)\coloneqq\sup_{{\color[rgb]{0,0,0}\theta}\in U_{j}}\density_{#1}(\cdot\nonscript\,|\nonscript\,\mathopen{}\cdot,{\color[rgb]{0,0,0}\theta})" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">g</mi><mi>j</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0em">∣</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow><mo rspace="0.1389em">≔</mo><msub><mo lspace="0.1389em" rspace="0.167em">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∈</mo><msub><mi>U</mi><mi>j</mi></msub></mrow></msub><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em">⋅</mo><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}g}_{j}(\cdot\mid\cdot)\coloneqq\sup_{{\color[rgb]{0,0,0}\theta}\in U_{j}}\density_{#1}(\cdot\nonscript\,|\nonscript\,\mathopen{}\cdot,{\color[rgb]{0,0,0}\theta})</annotation></semantics></math>,</span></p>
<table id="A4.E39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E39.m1" class="ltx_math_unparsed" alttext="\int_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}}{\color[rgb]{0,0,0}g}_{j}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\mid{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}})d{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\leq 1+\varepsilon\,." display="block" intent=":literal"><semantics><mrow><msub><mo>∫</mo><msup><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup></msub><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">g</mi><mi>j</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mi>d</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>≤</mo><mn>1</mn><mo>+</mo><mi>ε</mi><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">\int_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}}{\color[rgb]{0,0,0}g}_{j}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\mid{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}})d{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\leq 1+\varepsilon\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.39)</span></td></tr></tbody>
</table>
<p id="A4.SS4.p3.2" class="ltx_p"><span id="A4.SS4.p3.2.1" class="ltx_text">Therefore, for any <math id="A4.SS4.p3.m7" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\theta}\in{\color[rgb]{0,0,0}\Theta^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∈</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\theta}\in{\color[rgb]{0,0,0}\Theta^{\prime}}</annotation></semantics></math>, any <math id="A4.SS4.p3.m8" class="ltx_Math" alttext="{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\geq 1" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\geq 1</annotation></semantics></math>, any <math id="A4.SS4.p3.m9" class="ltx_math_unparsed" alttext="{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\in{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}^{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo>∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><msup><mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><msup><mrow></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\in{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}^{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}</annotation></semantics></math>,
there exists <math id="A4.SS4.p3.m10" class="ltx_Math" alttext="{\color[rgb]{0,0,0}i}\in\{1,\dots,{\color[rgb]{0,0,0}\mathcal{B}}({\color[rgb]{0,0,0}\Theta^{\prime}},\varepsilon,{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}},{\color[rgb]{0,0,0}T})\}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>,</mo><mi>ε</mi><mo>,</mo><msup><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}i}\in\{1,\dots,{\color[rgb]{0,0,0}\mathcal{B}}({\color[rgb]{0,0,0}\Theta^{\prime}},\varepsilon,{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}},{\color[rgb]{0,0,0}T})\}</annotation></semantics></math> such that</span></p>
<table id="A4.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E40"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E40.m1" class="ltx_math_unparsed" alttext="\displaystyle\density_{#1}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\mid{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}},{\color[rgb]{0,0,0}\theta})\leq{\color[rgb]{0,0,0}g}_{\color[rgb]{0,0,0}i}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\mid{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}})." display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></msub><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow><mo>≤</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">g</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\density_{#1}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\mid{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}},{\color[rgb]{0,0,0}\theta})\leq{\color[rgb]{0,0,0}g}_{\color[rgb]{0,0,0}i}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\mid{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.40)</span></td></tr></tbody>
</table>
<p id="A4.SS4.p3.3" class="ltx_p"><span id="A4.SS4.p3.3.1" class="ltx_text">Hence, we can bound</span></p>
<table id="A4.EGx16" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E41"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E41.m1" class="ltx_math_unparsed" alttext="\displaystyle\exp\left(-\frac{1}{{\color[rgb]{0,0,0}\mu}}\log\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}\right)\leq\exp\left(\frac{1}{{\color[rgb]{0,0,0}\mu}}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=0}^{{\color[rgb]{0,0,0}T}-1}\log\frac{{\color[rgb]{0,0,0}g}_{\color[rgb]{0,0,0}i}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\mid{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}})}{\density_{#1}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\mid{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}+\frac{{\color[rgb]{0,0,0}T}}{{\color[rgb]{0,0,0}\mu}}\log\frac{1+\varepsilon}{1-\varepsilon}\right)." display="inline" intent=":literal"><semantics><mrow><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi></mfrac></mstyle><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><mo>≤</mo><mi>exp</mi><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">g</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></msub><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi></mfrac></mstyle><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>+</mo><mi>ε</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\exp\left(-\frac{1}{{\color[rgb]{0,0,0}\mu}}\log\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}\right)\leq\exp\left(\frac{1}{{\color[rgb]{0,0,0}\mu}}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=0}^{{\color[rgb]{0,0,0}T}-1}\log\frac{{\color[rgb]{0,0,0}g}_{\color[rgb]{0,0,0}i}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\mid{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}})}{\density_{#1}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\mid{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}+\frac{{\color[rgb]{0,0,0}T}}{{\color[rgb]{0,0,0}\mu}}\log\frac{1+\varepsilon}{1-\varepsilon}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.41)</span></td></tr></tbody>
</table>
</div>
<div id="A4.SS4.p4" class="ltx_para">
<p id="A4.SS4.p4.1" class="ltx_p"><span id="A4.SS4.p4.1.1" class="ltx_text">We now control the contribution from <math id="A4.SS4.p4.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∉</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}</annotation></semantics></math> by simply taking the supremum over this set. We have</span></p>
<table id="A4.EGx17" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E42"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E42.m1" class="ltx_math_unparsed" alttext="\displaystyle\ex_{#1}\left[\one\{{\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}\}\cdot\exp\left(-\frac{1}{{\color[rgb]{0,0,0}\mu}}\log\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}\right)\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo stretchy="false">{</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∉</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo rspace="0.222em">⋅</mo><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi></mfrac></mstyle><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ex_{#1}\left[\one\{{\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}\}\cdot\exp\left(-\frac{1}{{\color[rgb]{0,0,0}\mu}}\log\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.42)</span></td></tr></tbody>
<tbody id="A4.E43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E43.m1" class="ltx_Math" alttext="\displaystyle={\color[rgb]{0,0,0}\pi}\left({\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}\right)\sup_{{\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}}\left(\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}\right)^{1/{\color[rgb]{0,0,0}\mu}}\,." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∉</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup></mrow><mo>)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∉</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup></mrow></munder><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi></mrow></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle={\color[rgb]{0,0,0}\pi}\left({\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}\right)\sup_{{\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}}\left(\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}\right)^{1/{\color[rgb]{0,0,0}\mu}}\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.43)</span></td></tr></tbody>
</table>
</div>
<div id="A4.SS4.p5" class="ltx_para">
<p id="A4.SS4.p5.1" class="ltx_p"><span id="A4.SS4.p5.1.1" class="ltx_text">Combining <a href="#A4.E41" title="In Proof. ‣ D.4 Task Selection Bound for ICL ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eqs.</span> <span class="ltx_text ltx_ref_tag">D.41</span></a> and <a href="#A4.E43" title="Equation D.43 ‣ Proof. ‣ D.4 Task Selection Bound for ICL ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.43</span></a>, we bound the <abbr title="" class="ltx_glossaryref ltx_missing">LHS</abbr> of the statement as</span></p>
<table id="A4.EGx18" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E44"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
