<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E118.m1" class="ltx_Math" alttext="\displaystyle+\quad{\color[rgb]{0,0,0}c}{\color[rgb]{0,0,0}r}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}{\color[rgb]{0,0,0}N}^{1/{\color[rgb]{0,0,0}r}}\left\lVert\lVert{\color[rgb]{0,0,0}\theta}_{1}\rVert\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{1}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\right\rVert_{\color[rgb]{0,0,0}r}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mspace style="width:1em;" width="1em"></mspace><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mrow><mn>1</mn><mo>/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo fence="true" lspace="0em">∥</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn>1</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>&gt;</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></munder></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></mrow></msub></mrow></mrow></mrow></mrow><mo>‖</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\quad{\color[rgb]{0,0,0}c}{\color[rgb]{0,0,0}r}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}{\color[rgb]{0,0,0}N}^{1/{\color[rgb]{0,0,0}r}}\left\lVert\lVert{\color[rgb]{0,0,0}\theta}_{1}\rVert\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{1}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\right\rVert_{\color[rgb]{0,0,0}r}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.118)</span></td></tr></tbody>
<tbody id="A5.E119"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E119.m1" class="ltx_Math" alttext="\displaystyle\leq{\color[rgb]{0,0,0}c}\sqrt{{\color[rgb]{0,0,0}r}}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}\sqrt{{\color[rgb]{0,0,0}N}}\lVert{\color[rgb]{0,0,0}\theta}_{1}\rVert_{2}\left\lVert\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{1}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\right\rVert_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo fence="true" rspace="0em">∥</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn>1</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>&gt;</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></munder></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></mrow></msub></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq{\color[rgb]{0,0,0}c}\sqrt{{\color[rgb]{0,0,0}r}}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}\sqrt{{\color[rgb]{0,0,0}N}}\lVert{\color[rgb]{0,0,0}\theta}_{1}\rVert_{2}\left\lVert\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{1}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\right\rVert_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.119)</span></td></tr></tbody>
<tbody id="A5.E120"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E120.m1" class="ltx_Math" alttext="\displaystyle+\quad{\color[rgb]{0,0,0}c}{\color[rgb]{0,0,0}r}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}{\color[rgb]{0,0,0}N}^{1/{\color[rgb]{0,0,0}r}}\lVert{\color[rgb]{0,0,0}\theta}_{1}\rVert_{\color[rgb]{0,0,0}r}\left\lVert\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{1}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\right\rVert_{\color[rgb]{0,0,0}r}\,," display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mspace style="width:1em;" width="1em"></mspace><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mrow><mn>1</mn><mo>/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo fence="true" rspace="0em">∥</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo fence="true" lspace="0em">∥</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn>1</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>&gt;</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></munder></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></mrow></msub></mrow></mrow></mrow><mo>‖</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\quad{\color[rgb]{0,0,0}c}{\color[rgb]{0,0,0}r}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}{\color[rgb]{0,0,0}N}^{1/{\color[rgb]{0,0,0}r}}\lVert{\color[rgb]{0,0,0}\theta}_{1}\rVert_{\color[rgb]{0,0,0}r}\left\lVert\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{1}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\right\rVert_{\color[rgb]{0,0,0}r}\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.120)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p18.2" class="ltx_p"><span id="A5.SS3.p18.2.1" class="ltx_text">where we used that <math id="A5.SS3.p18.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\theta}_{1}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\theta}_{1}</annotation></semantics></math> and <math id="A5.SS3.p18.m2" class="ltx_Math" alttext="({\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{1})_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\geq 1}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn>1</mn></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>≥</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">({\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{1})_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\geq 1}</annotation></semantics></math> are independent.
Now, <math id="A5.SS3.p18.m3" class="ltx_Math" alttext="\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{1}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msubsup><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn>1</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>&gt;</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></msub><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{1}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}</annotation></semantics></math> is a zero-mean sub-Gaussian random variable with parameter <math id="A5.SS3.p18.m4" class="ltx_Math" alttext="\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\right)^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msubsup><msup><mrow><mo lspace="0em">(</mo><mrow><msub><mo lspace="0em">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>&gt;</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></msub><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></mrow></msub></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\right)^{2}</annotation></semantics></math> by Hoeffding’s lemma (see e.g. <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib58" title="" class="ltx_ref">Wainwright (2019, Exercise 2.4)</a></cite>) and we have, for some universal constant <math id="A5.SS3.p18.m5" class="ltx_Math" alttext="{\color[rgb]{0,0,0}c}&gt;0" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}c}&gt;0</annotation></semantics></math>, for any integer <math id="A5.SS3.p18.m6" class="ltx_Math" alttext="{\color[rgb]{0,0,0}h}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}h}</annotation></semantics></math></span></p>
<table id="A5.E121" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E121.m1" class="ltx_Math" alttext="\left\lVert\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{1}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\right\rVert_{\color[rgb]{0,0,0}h}\leq{\color[rgb]{0,0,0}c}\sqrt{{\color[rgb]{0,0,0}h}}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\right)^{2}\right)^{1/2}\,." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn>1</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>&gt;</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></munder><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></mrow></msub></mrow></mrow></mrow><mo>‖</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi></msub><mo>≤</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover><msup><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>&gt;</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></munder><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></mrow></msub></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\lVert\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{1}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\right\rVert_{\color[rgb]{0,0,0}h}\leq{\color[rgb]{0,0,0}c}\sqrt{{\color[rgb]{0,0,0}h}}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\right)^{2}\right)^{1/2}\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.121)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p18.3" class="ltx_p"><span id="A5.SS3.p18.3.1" class="ltx_text">Plugging this into <a href="#A5.E120" title="In Proof. ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">E.120</span></a> with <math id="A5.SS3.p18.m7" class="ltx_Math" alttext="{\color[rgb]{0,0,0}h}=2" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}h}=2</annotation></semantics></math> and <math id="A5.SS3.p18.m8" class="ltx_Math" alttext="{\color[rgb]{0,0,0}h}={\color[rgb]{0,0,0}r}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mo>=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}h}={\color[rgb]{0,0,0}r}</annotation></semantics></math> gives</span></p>
<table id="A5.EGx65" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E122"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><a href="#A5.E109" title="In Proof. ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref ltx_markedasmath ltx_font_italic"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">E.109</span></a></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E122.m2" class="ltx_Math" alttext="\displaystyle\leq{\color[rgb]{0,0,0}c}\sqrt{{\color[rgb]{0,0,0}r}}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}\sqrt{{\color[rgb]{0,0,0}N}}\sqrt{\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\right)^{2}}\left\lVert{\color[rgb]{0,0,0}\theta}_{1}\right\rVert_{2}+{\color[rgb]{0,0,0}c}{\color[rgb]{0,0,0}r}^{3/2}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}{\color[rgb]{0,0,0}N}^{1/{\color[rgb]{0,0,0}r}}\sqrt{\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\right)^{2}}\left\lVert{\color[rgb]{0,0,0}\theta}_{1}\right\rVert_{\color[rgb]{0,0,0}r}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>&gt;</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></munder></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></mrow></msub></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mrow><mn>1</mn><mo>/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>&gt;</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></munder></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></mrow></msub></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo>‖</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq{\color[rgb]{0,0,0}c}\sqrt{{\color[rgb]{0,0,0}r}}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}\sqrt{{\color[rgb]{0,0,0}N}}\sqrt{\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\right)^{2}}\left\lVert{\color[rgb]{0,0,0}\theta}_{1}\right\rVert_{2}+{\color[rgb]{0,0,0}c}{\color[rgb]{0,0,0}r}^{3/2}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}{\color[rgb]{0,0,0}N}^{1/{\color[rgb]{0,0,0}r}}\sqrt{\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\right)^{2}}\left\lVert{\color[rgb]{0,0,0}\theta}_{1}\right\rVert_{\color[rgb]{0,0,0}r}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.122)</span></td></tr></tbody>
<tbody id="A5.E123"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E123.m1" class="ltx_Math" alttext="\displaystyle\leq{\color[rgb]{0,0,0}c}\sqrt{{\color[rgb]{0,0,0}r}}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}\sqrt{{\color[rgb]{0,0,0}N}}\sqrt{\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\right)^{2}}\left\lVert{\color[rgb]{0,0,0}\theta}_{1}\right\rVert_{2}+{\color[rgb]{0,0,0}c}{\color[rgb]{0,0,0}r}^{3/2}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}{\color[rgb]{0,0,0}N}^{1/{\color[rgb]{0,0,0}r}}\sqrt{\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\right)^{2}}\left\lVert{\color[rgb]{0,0,0}\theta}_{1}\right\rVert_{\color[rgb]{0,0,0}q}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>&gt;</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></munder></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></mrow></msub></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mrow><mn>1</mn><mo>/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>&gt;</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></munder></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></mrow></msub></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo>‖</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq{\color[rgb]{0,0,0}c}\sqrt{{\color[rgb]{0,0,0}r}}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}\sqrt{{\color[rgb]{0,0,0}N}}\sqrt{\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\right)^{2}}\left\lVert{\color[rgb]{0,0,0}\theta}_{1}\right\rVert_{2}+{\color[rgb]{0,0,0}c}{\color[rgb]{0,0,0}r}^{3/2}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}{\color[rgb]{0,0,0}N}^{1/{\color[rgb]{0,0,0}r}}\sqrt{\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\right)^{2}}\left\lVert{\color[rgb]{0,0,0}\theta}_{1}\right\rVert_{\color[rgb]{0,0,0}q}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.123)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p18.4" class="ltx_p"><span id="A5.SS3.p18.4.1" class="ltx_text">where we used that <math id="A5.SS3.p18.m9" class="ltx_Math" alttext="{\color[rgb]{0,0,0}r}\leq{\color[rgb]{0,0,0}q}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}r}\leq{\color[rgb]{0,0,0}q}</annotation></semantics></math> to obtain the last inequality.</span></p>
</div>
<div id="A5.SS3.p19" class="ltx_para">
<p id="A5.SS3.p19.1" class="ltx_p"><span id="A5.SS3.p19.1.1" class="ltx_text">Finally, we proceed similarly for <a href="#A5.E110" title="In Proof. ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">E.110</span></a>.
By <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib12" title="" class="ltx_ref">Boucheron et al. (2005, Thm. 15.11)</a></cite> applied to each independent and zero-mean term</span></p>
<table id="A5.E125" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E125.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}n}\lVert{\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n}-{\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n}^{\prime}\rVert\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\,," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo fence="true" rspace="0em">∥</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo>−</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>′</mo></msubsup></mrow><mo fence="true" lspace="0em">∥</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}n}\lVert{\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n}-{\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n}^{\prime}\rVert\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.125)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p19.2" class="ltx_p"><span id="A5.SS3.p19.2.1" class="ltx_text">we have</span></p>
<table id="A5.EGx66" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E126"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><a href="#A5.E110" title="In Proof. ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref ltx_markedasmath ltx_font_italic"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">E.110</span></a></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E126.m2" class="ltx_Math" alttext="\displaystyle\leq{\color[rgb]{0,0,0}c}\sqrt{{\color[rgb]{0,0,0}r}}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}\sqrt{{\color[rgb]{0,0,0}N}}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\right)\left\lVert{{\color[rgb]{0,0,0}\theta}_{1}-{\color[rgb]{0,0,0}\theta}_{1}^{\prime}}\right\rVert_{2}+{\color[rgb]{0,0,0}c}{\color[rgb]{0,0,0}r}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}{\color[rgb]{0,0,0}N}^{1/{\color[rgb]{0,0,0}r}}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\right)\left\lVert{{\color[rgb]{0,0,0}\theta}_{1}-{\color[rgb]{0,0,0}\theta}_{1}^{\prime}}\right\rVert_{\color[rgb]{0,0,0}r}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo>−</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn><mo>′</mo></msubsup></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mrow><mn>1</mn><mo>/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo>−</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn><mo>′</mo></msubsup></mrow><mo>‖</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq{\color[rgb]{0,0,0}c}\sqrt{{\color[rgb]{0,0,0}r}}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}\sqrt{{\color[rgb]{0,0,0}N}}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\right)\left\lVert{{\color[rgb]{0,0,0}\theta}_{1}-{\color[rgb]{0,0,0}\theta}_{1}^{\prime}}\right\rVert_{2}+{\color[rgb]{0,0,0}c}{\color[rgb]{0,0,0}r}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}{\color[rgb]{0,0,0}N}^{1/{\color[rgb]{0,0,0}r}}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\right)\left\lVert{{\color[rgb]{0,0,0}\theta}_{1}-{\color[rgb]{0,0,0}\theta}_{1}^{\prime}}\right\rVert_{\color[rgb]{0,0,0}r}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.126)</span></td></tr></tbody>
<tbody id="A5.E127"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E127.m1" class="ltx_Math" alttext="\displaystyle\leq{\color[rgb]{0,0,0}c}\sqrt{{\color[rgb]{0,0,0}r}}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}\sqrt{{\color[rgb]{0,0,0}N}}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\right)\left\lVert{{\color[rgb]{0,0,0}\theta}_{1}-\ex[{\color[rgb]{0,0,0}\theta}_{1}]}\right\rVert_{2}+{\color[rgb]{0,0,0}c}{\color[rgb]{0,0,0}r}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}{\color[rgb]{0,0,0}N}^{1/{\color[rgb]{0,0,0}r}}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\right)\left\lVert{{\color[rgb]{0,0,0}\theta}_{1}-\ex[{\color[rgb]{0,0,0}\theta}_{1}]}\right\rVert_{\color[rgb]{0,0,0}q}\,," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo>−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mrow><mn>1</mn><mo>/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo>−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq{\color[rgb]{0,0,0}c}\sqrt{{\color[rgb]{0,0,0}r}}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}\sqrt{{\color[rgb]{0,0,0}N}}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\right)\left\lVert{{\color[rgb]{0,0,0}\theta}_{1}-\ex[{\color[rgb]{0,0,0}\theta}_{1}]}\right\rVert_{2}+{\color[rgb]{0,0,0}c}{\color[rgb]{0,0,0}r}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}{\color[rgb]{0,0,0}N}^{1/{\color[rgb]{0,0,0}r}}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\right)\left\lVert{{\color[rgb]{0,0,0}\theta}_{1}-\ex[{\color[rgb]{0,0,0}\theta}_{1}]}\right\rVert_{\color[rgb]{0,0,0}q}\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.127)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p19.3" class="ltx_p"><span id="A5.SS3.p19.3.1" class="ltx_text">where we use Minkowski’s inequality and the fact that <math id="A5.SS3.p19.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}r}\leq{\color[rgb]{0,0,0}q}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}r}\leq{\color[rgb]{0,0,0}q}</annotation></semantics></math> to obtain the last inequality.</span></p>
</div>
<div id="A5.SS3.p20" class="ltx_para">
<p id="A5.SS3.p20.1" class="ltx_p"><span id="A5.SS3.p20.1.1" class="ltx_text">Combining <a href="#A5.E113" title="In Proof. ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eqs.</span> <span class="ltx_text ltx_ref_tag">E.113</span></a>, <span class="ltx_ref ltx_missing_label ltx_ref_self"></span> and <a href="#A5.E127" title="Equation E.127 ‣ Proof. ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.127</span></a> and replacing <math id="A5.SS3.p20.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}</annotation></semantics></math> by <math id="A5.SS3.p20.m2" class="ltx_Math" alttext="{\color[rgb]{0,0,0}L}_{\color[rgb]{0,0,0}T}/{\color[rgb]{0,0,0}N}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo>/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}L}_{\color[rgb]{0,0,0}T}/{\color[rgb]{0,0,0}N}</annotation></semantics></math> gives the result.
∎</span></p>
</div>
</div>
<div id="A5.Thmproposition1" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A5.Thmproposition1.2" class="ltx_text ltx_font_bold">Proposition E.1</span></span><span id="A5.Thmproposition1.3" class="ltx_text ltx_font_bold"> </span>(Concentration bound for ICL)<span id="A5.Thmproposition1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A5.Thmproposition1.p1" class="ltx_para">
<p id="A5.Thmproposition1.p1.1" class="ltx_p"><span id="A5.Thmproposition1.p1.1.1" class="ltx_text ltx_font_italic">Under <a href="#Thmassumption5" title="Assumption 5 (Weak dependence). ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumptions</span> <span class="ltx_text ltx_ref_tag">5</span></a>, <a href="#Thmassumption6" title="Assumption 6 (Finite moments of the task distribution). ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>, <a href="#Thmassumption7" title="Assumption 7 (Sub-Gaussian data). ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a> and <a href="#Thmassumption8" title="Assumption 8 (Lipschitz model and loss). ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>, for any <math id="A5.Thmproposition1.p1.m1" class="ltx_Math" alttext="\delta\in(0,e^{-2}]" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msup><mi>e</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,e^{-2}]</annotation></semantics></math>, with probability at least <math id="A5.Thmproposition1.p1.m2" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>,</span></p>
<table id="A5.EGx67" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E128"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
