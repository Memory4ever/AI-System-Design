<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.161)</span></td></tr></tbody>
<tbody id="A5.E162"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E162.m1" class="ltx_Math" alttext="\displaystyle+{\color[rgb]{0,0,0}c}\sqrt{{\color[rgb]{0,0,0}q}}\frac{{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}T}}}{\sqrt{{\color[rgb]{0,0,0}N}}}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\right)\left\lVert{{\color[rgb]{0,0,0}\theta}_{1}-\ex[{\color[rgb]{0,0,0}\theta}_{1}]}\right\rVert_{2}+{\color[rgb]{0,0,0}c}{\color[rgb]{0,0,0}q}\frac{{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}T}}}{{\color[rgb]{0,0,0}N}^{1-1/{\color[rgb]{0,0,0}q}}}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\right)\left\lVert{{\color[rgb]{0,0,0}\theta}_{1}-\ex[{\color[rgb]{0,0,0}\theta}_{1}]}\right\rVert_{\color[rgb]{0,0,0}q}\bigg),," display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mrow><mo>+</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><msqrt><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo>−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo>+</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></mrow></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo>−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></msub></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo>,</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle+{\color[rgb]{0,0,0}c}\sqrt{{\color[rgb]{0,0,0}q}}\frac{{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}T}}}{\sqrt{{\color[rgb]{0,0,0}N}}}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\right)\left\lVert{{\color[rgb]{0,0,0}\theta}_{1}-\ex[{\color[rgb]{0,0,0}\theta}_{1}]}\right\rVert_{2}+{\color[rgb]{0,0,0}c}{\color[rgb]{0,0,0}q}\frac{{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}T}}}{{\color[rgb]{0,0,0}N}^{1-1/{\color[rgb]{0,0,0}q}}}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\right)\left\lVert{{\color[rgb]{0,0,0}\theta}_{1}-\ex[{\color[rgb]{0,0,0}\theta}_{1}]}\right\rVert_{\color[rgb]{0,0,0}q}\bigg),,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.162)</span></td></tr></tbody>
</table>
</div></li>
</ol>
<p id="A5.Thmtheorem2.p1.3" class="ltx_p"><span id="A5.Thmtheorem2.p1.3.1" class="ltx_text ltx_font_italic">where <math id="A5.Thmtheorem2.p1.m4" class="ltx_Math" alttext="{\color[rgb]{0,0,0}c}&gt;0" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}c}&gt;0</annotation></semantics></math> is a universal constant and where the Dudley-type integral <math id="A5.Thmtheorem2.p1.m5" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\mathcal{I}}_{\dist}({\color[rgb]{0,0,0}\mathcal{F}})" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℐ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">dist</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\mathcal{I}}_{\dist}({\color[rgb]{0,0,0}\mathcal{F}})</annotation></semantics></math> is defined as</span></p>
<table id="A5.E163" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E163.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\mathcal{I}}({\color[rgb]{0,0,0}\mathcal{F}},\dist,{\color[rgb]{0,0,0}q})=\int_{0}^{\Delta}\left({\color[rgb]{0,0,0}\mathcal{N}}({\color[rgb]{0,0,0}\mathcal{F}},\dist,u)\right)^{1/{\color[rgb]{0,0,0}q}}du\,,\quad\text{ with }\Delta=\diam_{\dist}({\color[rgb]{0,0,0}\mathcal{F}})=\sup_{{\color[rgb]{0,0,0}f},{\color[rgb]{0,0,0}f}^{\prime}\in{\color[rgb]{0,0,0}\mathcal{F}}}\dist({\color[rgb]{0,0,0}f},{\color[rgb]{0,0,0}f}^{\prime})\,." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℐ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">dist</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo rspace="0em">∫</mo><mn>0</mn><mi mathvariant="normal">Δ</mi></msubsup><mrow><msup><mrow><mo>(</mo><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">dist</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>du</mi></mrow></mrow></mrow><mo lspace="0.170em" rspace="1.167em">,</mo><mrow><mrow><mtext class="ltx_mathvariant_italic"> with </mtext><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow><mo>=</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">diam</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">dist</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>′</mo></msup></mrow><mo>∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi></mrow></munder><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">dist</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\mathcal{I}}({\color[rgb]{0,0,0}\mathcal{F}},\dist,{\color[rgb]{0,0,0}q})=\int_{0}^{\Delta}\left({\color[rgb]{0,0,0}\mathcal{N}}({\color[rgb]{0,0,0}\mathcal{F}},\dist,u)\right)^{1/{\color[rgb]{0,0,0}q}}du\,,\quad\text{ with }\Delta=\diam_{\dist}({\color[rgb]{0,0,0}\mathcal{F}})=\sup_{{\color[rgb]{0,0,0}f},{\color[rgb]{0,0,0}f}^{\prime}\in{\color[rgb]{0,0,0}\mathcal{F}}}\dist({\color[rgb]{0,0,0}f},{\color[rgb]{0,0,0}f}^{\prime})\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.163)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS5.p2" class="ltx_para">
<p id="A5.SS5.p2.1" class="ltx_p"><span id="A5.SS5.p2.1.1" class="ltx_text">The result is obtained by combining <a href="#A5.Thmproposition1" title="Proposition E.1 (Concentration bound for ICL). ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">E.1</span></a> and <a href="#A5.Thmlemma9" title="Lemma E.9. ‣ E.4 Complexity bounds for ICL ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">E.9</span></a>: we write the decomposition</span></p>
<table id="A5.EGx79" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E164"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E164.m1" class="ltx_math_unparsed" alttext="\displaystyle\sup_{{\color[rgb]{0,0,0}f}\in{\color[rgb]{0,0,0}\mathcal{F}}}\left\{\ex\left[{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right]-{{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})}\right\}" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi></mrow></munder><mrow><mo lspace="0em">{</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>−</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{{\color[rgb]{0,0,0}f}\in{\color[rgb]{0,0,0}\mathcal{F}}}\left\{\ex\left[{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right]-{{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})}\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.164)</span></td></tr></tbody>
<tbody id="A5.E165"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E165.m1" class="ltx_math_unparsed" alttext="\displaystyle=\ex\left[\sup_{{\color[rgb]{0,0,0}f}\in{\color[rgb]{0,0,0}\mathcal{F}}}\left\{\ex\left[{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right]-{{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})}\right\}\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi></mrow></munder><mrow><mo>{</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>−</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>}</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\ex\left[\sup_{{\color[rgb]{0,0,0}f}\in{\color[rgb]{0,0,0}\mathcal{F}}}\left\{\ex\left[{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right]-{{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})}\right\}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.165)</span></td></tr></tbody>
<tbody id="A5.E166"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E166.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sup_{{\color[rgb]{0,0,0}f}\in{\color[rgb]{0,0,0}\mathcal{F}}}\left\{\ex\left[{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right]-{{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})}\right\}-\ex\left[\sup_{{\color[rgb]{0,0,0}f}\in{\color[rgb]{0,0,0}\mathcal{F}}}\left\{\ex\left[{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right]-{{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})}\right\}\right]\,," display="inline" intent=":literal"><semantics><mrow><mo>+</mo><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi></mrow></munder><mrow><mo>{</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>−</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>}</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi></mrow></munder><mrow><mo>{</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>−</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>}</mo></mrow><mo rspace="0.170em">]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sup_{{\color[rgb]{0,0,0}f}\in{\color[rgb]{0,0,0}\mathcal{F}}}\left\{\ex\left[{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right]-{{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})}\right\}-\ex\left[\sup_{{\color[rgb]{0,0,0}f}\in{\color[rgb]{0,0,0}\mathcal{F}}}\left\{\ex\left[{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right]-{{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})}\right\}\right]\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.166)</span></td></tr></tbody>
</table>
<p id="A5.SS5.p2.2" class="ltx_p"><span id="A5.SS5.p2.2.1" class="ltx_text">and we bound <a href="#A5.E165" title="In Proof. ‣ E.5 Generalization bounds for ICL ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">E.165</span></a> using <a href="#A5.Thmlemma9" title="Lemma E.9. ‣ E.4 Complexity bounds for ICL ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">E.9</span></a> and <a href="#A5.E166" title="In Proof. ‣ E.5 Generalization bounds for ICL ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">E.166</span></a> with high probability using <a href="#A5.Thmproposition1" title="Proposition E.1 (Concentration bound for ICL). ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">E.1</span></a>.</span></p>
</div>
<div id="A5.SS5.p3" class="ltx_para">
<p id="A5.SS5.p3.1" class="ltx_p"><span id="A5.SS5.p3.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
</section>
<section id="A6" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix F </span>Additional details on examples</h2>

<section id="A6.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">F.1 </span>Example: Volterra equation model</h3>

<div id="A6.SS1.p1" class="ltx_para">
<p id="A6.SS1.p1.1" class="ltx_p">We discuss the Volterra equation model to explicit the dependence of the generalization bounds on the memory decay parameter <math id="A6.SS1.p1.m1" class="ltx_Math" alttext="\alpha&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\alpha&gt;0</annotation></semantics></math>.</p>
</div>
<section id="A6.SS1.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Setup.</h4>

<div id="A6.SS1.SSS0.Px1.p1" class="ltx_para">
<p id="A6.SS1.SSS0.Px1.p1.1" class="ltx_p">Let <math id="A6.SS1.SSS0.Px1.p1.m1" class="ltx_Math" alttext="(W_{t})_{t\geq 1}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>≥</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">(W_{t})_{t\geq 1}</annotation></semantics></math> be noise sequence taking values in <math id="A6.SS1.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>d</mi></msup><annotation encoding="application/x-tex">\mathbb{R}^{d}</annotation></semantics></math>.
Given a Lipschitz drift <math id="A6.SS1.SSS0.Px1.p1.m3" class="ltx_Math" alttext="b\,,mathbbR^{d}\to\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo lspace="0.170em">,</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mi>d</mi></msup></mrow><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">b\,,mathbbR^{d}\to\mathbb{R}^{d}</annotation></semantics></math> with Lipschitz constant <math id="A6.SS1.SSS0.Px1.p1.m4" class="ltx_Math" alttext="L\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">L\geq 0</annotation></semantics></math>,
we consider the discretized Volterra equation: for <math id="A6.SS1.SSS0.Px1.p1.m5" class="ltx_Math" alttext="t\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t\geq 0</annotation></semantics></math>,</p>
<table id="A6.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.E1.m1" class="ltx_Math" alttext="X_{t+1}\;=\;\sum_{u=1}^{t}K(t,u)\,\bigl(b(X_{u})+W_{u}\bigr),\qquad K(t,u)\;=\;\frac{1}{(t-u+1)^{\alpha}},\ \ \alpha&gt;0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>X</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0.558em" rspace="0.391em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover><mrow><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>u</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>W</mi><mi>u</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>u</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">=</mo><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>t</mi><mo>−</mo><mi>u</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>α</mi></msup></mfrac></mrow><mo rspace="1.167em">,</mo><mrow><mi>α</mi><mo>&gt;</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">X_{t+1}\;=\;\sum_{u=1}^{t}K(t,u)\,\bigl(b(X_{u})+W_{u}\bigr),\qquad K(t,u)\;=\;\frac{1}{(t-u+1)^{\alpha}},\ \ \alpha&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(F.1)</span></td></tr></tbody>
</table>
</div>
<div id="A6.SS1.SSS0.Px1.p2" class="ltx_para">
<p id="A6.SS1.SSS0.Px1.p2.1" class="ltx_p">When applying the generalization framework, we would consider the augmented sequence <math id="A6.SS1.SSS0.Px1.p2.m1" class="ltx_Math" alttext="(X_{1},W_{1},X_{2},W_{2},\ldots)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mn>1</mn></msub><mo>,</mo><msub><mi>W</mi><mn>1</mn></msub><mo>,</mo><msub><mi>X</mi><mn>2</mn></msub><mo>,</mo><msub><mi>W</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(X_{1},W_{1},X_{2},W_{2},\ldots)</annotation></semantics></math>.
To satisfy the weak dependence assumption <a href="#Thmassumption5" title="Assumption 5 (Weak dependence). ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">5</span></a>, we need to bound the effect of perturbations in either the state or the noise or the drift.
We begin with perturbations in the state or noise, and we discuss drift perturbations at the end of this section.
For perturbations in the state or noise, we will obtain bounds on the Wasserstein distance between the conditional laws of <math id="A6.SS1.SSS0.Px1.p2.m2" class="ltx_Math" alttext="X_{t}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>t</mi></msub><annotation encoding="application/x-tex">X_{t}</annotation></semantics></math> and <math id="A6.SS1.SSS0.Px1.p2.m3" class="ltx_Math" alttext="X^{\prime}_{t}" display="inline" intent=":literal"><semantics><msubsup><mi>X</mi><mi>t</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">X^{\prime}_{t}</annotation></semantics></math> given the past, where <math id="A6.SS1.SSS0.Px1.p2.m4" class="ltx_Math" alttext="X_{t}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>t</mi></msub><annotation encoding="application/x-tex">X_{t}</annotation></semantics></math> and <math id="A6.SS1.SSS0.Px1.p2.m5" class="ltx_Math" alttext="X^{\prime}_{t}" display="inline" intent=":literal"><semantics><msubsup><mi>X</mi><mi>t</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">X^{\prime}_{t}</annotation></semantics></math> are two versions of the process (<a href="#A6.E1" title="Equation F.1 ‣ Setup. ‣ F.1 Example: Volterra equation model ‣ Appendix F Additional details on examples ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.1</span></a>) that differ by a perturbation at some time <math id="A6.SS1.SSS0.Px1.p2.m6" class="ltx_Math" alttext="s&lt;t" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>&lt;</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">s&lt;t</annotation></semantics></math>.</p>
</div>
<div id="A6.SS1.SSS0.Px1.p3" class="ltx_para">
<p id="A6.SS1.SSS0.Px1.p3.1" class="ltx_p">The coefficient <math id="A6.SS1.SSS0.Px1.p3.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> will play a key role in the dependence structure through the sums:</p>
<table id="A6.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.E2.m1" class="ltx_Math" alttext="H_{\alpha}(n)\;=\;\sum_{r=1}^{n}\frac{1}{r^{\alpha}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>H</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.391em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mfrac><mn>1</mn><msup><mi>r</mi><mi>α</mi></msup></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H_{\alpha}(n)\;=\;\sum_{r=1}^{n}\frac{1}{r^{\alpha}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(F.2)</span></td></tr></tbody>
</table>
<p id="A6.SS1.SSS0.Px1.p3.2" class="ltx_p">We also use <math id="A6.SS1.SSS0.Px1.p3.m2" class="ltx_Math" alttext="\zeta(\alpha)=\sum_{r=1}^{\infty}r^{-\alpha}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ζ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></msubsup><msup><mi>r</mi><mrow><mo>−</mo><mi>α</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\zeta(\alpha)=\sum_{r=1}^{\infty}r^{-\alpha}</annotation></semantics></math> for <math id="A6.SS1.SSS0.Px1.p3.m3" class="ltx_Math" alttext="\alpha&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\alpha&gt;1</annotation></semantics></math> and we have the following bounds on <math id="A6.SS1.SSS0.Px1.p3.m4" class="ltx_Math" alttext="H_{\alpha}(n)" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{\alpha}(n)</annotation></semantics></math></p>
<table id="A6.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.E3.m1" class="ltx_Math" alttext="H_{\alpha}(n)\;\leq\;\begin{cases}1+\log n,&amp;\alpha=1,\\[4.0pt]
\zeta(\alpha),&amp;\alpha&gt;1.\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>H</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">≤</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>1</mn><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>α</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>ζ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>α</mi><mo>&gt;</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">H_{\alpha}(n)\;\leq\;\begin{cases}1+\log n,&amp;\alpha=1,\\[4.0pt]
\zeta(\alpha),&amp;\alpha&gt;1.\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(F.3)</span></td></tr></tbody>
</table>
</div>
<div id="A6.SS1.SSS0.Px1.p4" class="ltx_para">
<p id="A6.SS1.SSS0.Px1.p4.1" class="ltx_p">We will make use of the following technical lemma.</p>
</div>
<div id="A6.Thmlemma1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A6.Thmlemma1.2" class="ltx_text ltx_font_bold">Lemma F.1</span></span><span id="A6.Thmlemma1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A6.Thmlemma1.p1" class="ltx_para">
<p id="A6.Thmlemma1.p1.1" class="ltx_p"><span id="A6.Thmlemma1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A6.Thmlemma1.p1.m1" class="ltx_Math" alttext="(a_{n})_{n\geq 0}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">(a_{n})_{n\geq 0}</annotation></semantics></math> be nonnegative numbers and suppose that for <math id="A6.Thmlemma1.p1.m2" class="ltx_Math" alttext="n\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n\geq 1</annotation></semantics></math>,</span></p>
<table id="A6.E4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.E4.m1" class="ltx_Math" alttext="a_{n}\;\leq\;L\sum_{r=1}^{n}r^{-\alpha}\,a_{n-r}\;+\;g_{n}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0.558em" rspace="0.558em">≤</mo><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msup><mi>r</mi><mrow><mo>−</mo><mi>α</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mrow><mi>n</mi><mo>−</mo><mi>r</mi></mrow></msub></mrow></mrow></mrow><mo rspace="0.502em">+</mo><msub><mi>g</mi><mi>n</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">a_{n}\;\leq\;L\sum_{r=1}^{n}r^{-\alpha}\,a_{n-r}\;+\;g_{n},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(F.4)</span></td></tr></tbody>
</table>
<p id="A6.Thmlemma1.p1.2" class="ltx_p"><span id="A6.Thmlemma1.p1.2.1" class="ltx_text ltx_font_italic">with non-decreasing <math id="A6.Thmlemma1.p1.m3" class="ltx_Math" alttext="(g_{n})_{n\geq 1}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>≥</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">(g_{n})_{n\geq 1}</annotation></semantics></math> and given <math id="A6.Thmlemma1.p1.m4" class="ltx_Math" alttext="a_{0}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mn>0</mn></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a_{0}\geq 0</annotation></semantics></math>.
Define, for <math id="A6.Thmlemma1.p1.m5" class="ltx_Math" alttext="N\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">N\geq 1</annotation></semantics></math>,</span></p>
<table id="A6.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.E5.m1" class="ltx_Math" alttext="\lambda_{N}\coloneqq\begin{cases}L(1+\log N)&amp;\text{ if }\alpha=1,\\[6.0pt]
L\zeta(\alpha)&amp;\text{ if }\alpha&gt;1.\end{cases}" display="block" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>N</mi></msub><mo>≔</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>N</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext class="ltx_mathvariant_italic"> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>=</mo><mn>1</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext class="ltx_mathvariant_italic"> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>&gt;</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\lambda_{N}\coloneqq\begin{cases}L(1+\log N)&amp;\text{ if }\alpha=1,\\[6.0pt]
L\zeta(\alpha)&amp;\text{ if }\alpha&gt;1.\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(F.5)</span></td></tr></tbody>
</table>
<p id="A6.Thmlemma1.p1.3" class="ltx_p"><span id="A6.Thmlemma1.p1.3.1" class="ltx_text ltx_font_italic">Then, for all <math id="A6.Thmlemma1.p1.m6" class="ltx_Math" alttext="1\leq n\leq N" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>n</mi><mo>≤</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">1\leq n\leq N</annotation></semantics></math>,</span></p>
<table id="A6.E6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.E6.m1" class="ltx_Math" alttext="a_{n}\;\leq\;\lambda_{N}^{n}a_{0}\;+\;\sum_{j=1}^{n}g_{j}{\lambda_{N}^{n-j}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0.558em" rspace="0.558em">≤</mo><mrow><mrow><msubsup><mi>λ</mi><mi>N</mi><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mn>0</mn></msub></mrow><mo rspace="0.335em">+</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msub><mi>g</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>N</mi><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msubsup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">a_{n}\;\leq\;\lambda_{N}^{n}a_{0}\;+\;\sum_{j=1}^{n}g_{j}{\lambda_{N}^{n-j}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(F.6)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A6.SS1.SSS0.Px1.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A6.SS1.SSS0.Px1.p5" class="ltx_para">
<p id="A6.SS1.SSS0.Px1.p5.1" class="ltx_p"><span id="A6.SS1.SSS0.Px1.p5.1.1" class="ltx_text">Let <math id="A6.SS1.SSS0.Px1.p5.m1" class="ltx_Math" alttext="A_{n}:=\max_{0\leq m\leq n}a_{m}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>n</mi></msub><mo>:=</mo><mrow><msub><mi>max</mi><mrow><mn>0</mn><mo>≤</mo><mi>m</mi><mo>≤</mo><mi>n</mi></mrow></msub><mo lspace="0.167em">⁡</mo><msub><mi>a</mi><mi>m</mi></msub></mrow></mrow><annotation encoding="application/x-tex">A_{n}:=\max_{0\leq m\leq n}a_{m}</annotation></semantics></math>. From (<a href="#A6.E4" title="Equation F.4 ‣ Lemma F.1. ‣ Setup. ‣ F.1 Example: Volterra equation model ‣ Appendix F Additional details on examples ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.4</span></a>),
<math id="A6.SS1.SSS0.Px1.p5.m2" class="ltx_Math" alttext="a_{n}\leq L\sum_{r=1}^{n}r^{-\alpha}A_{n-r}+g_{n}\leq LH_{\alpha}(n)A_{n-1}+g_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>n</mi></msub><mo>≤</mo><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mrow><msup><mi>r</mi><mrow><mo>−</mo><mi>α</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mrow><mi>n</mi><mo>−</mo><mi>r</mi></mrow></msub></mrow></mrow></mrow><mo>+</mo><msub><mi>g</mi><mi>n</mi></msub></mrow><mo>≤</mo><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><msub><mi>g</mi><mi>n</mi></msub></mrow></mrow><annotation encoding="application/x-tex">a_{n}\leq L\sum_{r=1}^{n}r^{-\alpha}A_{n-r}+g_{n}\leq LH_{\alpha}(n)A_{n-1}+g_{n}</annotation></semantics></math>, so <math id="A6.SS1.SSS0.Px1.p5.m3" class="ltx_Math" alttext="A_{n}\leq LH_{\alpha}(n)A_{n-1}+g_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>n</mi></msub><mo>≤</mo><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><msub><mi>g</mi><mi>n</mi></msub></mrow></mrow><annotation encoding="application/x-tex">A_{n}\leq LH_{\alpha}(n)A_{n-1}+g_{n}</annotation></semantics></math> since <math id="A6.SS1.SSS0.Px1.p5.m4" class="ltx_Math" alttext="(g_{n})_{n}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mi>n</mi></msub><annotation encoding="application/x-tex">(g_{n})_{n}</annotation></semantics></math> is non-decreasing.
Bounding <math id="A6.SS1.SSS0.Px1.p5.m5" class="ltx_Math" alttext="H_{\alpha}(n)" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{\alpha}(n)</annotation></semantics></math> using (<a href="#A6.E3" title="Equation F.3 ‣ Setup. ‣ F.1 Example: Volterra equation model ‣ Appendix F Additional details on examples ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.3</span></a>) gives <math id="A6.SS1.SSS0.Px1.p5.m6" class="ltx_Math" alttext="A_{n}\leq\lambda_{N}A_{n-1}+g_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>n</mi></msub><mo>≤</mo><mrow><mrow><msub><mi>λ</mi><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><msub><mi>g</mi><mi>n</mi></msub></mrow></mrow><annotation encoding="application/x-tex">A_{n}\leq\lambda_{N}A_{n-1}+g_{n}</annotation></semantics></math> for all <math id="A6.SS1.SSS0.Px1.p5.m7" class="ltx_Math" alttext="1\leq n\leq N" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>n</mi><mo>≤</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">1\leq n\leq N</annotation></semantics></math>.
Iterating this inequality yields the result.
∎</span></p>
</div>
</div>
</section>
<section id="A6.SS1.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">State perturbation.</h4>

<div id="A6.SS1.SSS0.Px2.p1" class="ltx_para">
<p id="A6.SS1.SSS0.Px2.p1.1" class="ltx_p">Fix <math id="A6.SS1.SSS0.Px2.p1.m1" class="ltx_Math" alttext="s\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">s\geq 1</annotation></semantics></math> and let <math id="A6.SS1.SSS0.Px2.p1.m2" class="ltx_Math" alttext="\mathcal{F}_{s}:=\sigma\big(X_{1},\dots,X_{s},\ W_{1},\dots,W_{s}\big)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>s</mi></msub><mo>:=</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>X</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>X</mi><mi>s</mi></msub><mo>,</mo><msub><mi>W</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>W</mi><mi>s</mi></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}_{s}:=\sigma\big(X_{1},\dots,X_{s},\ W_{1},\dots,W_{s}\big)</annotation></semantics></math> on which we condition.
Assume the two systems agree up to <math id="A6.SS1.SSS0.Px2.p1.m3" class="ltx_Math" alttext="s-1" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">s-1</annotation></semantics></math>, and at time <math id="A6.SS1.SSS0.Px2.p1.m4" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> we have</p>
<table id="A6.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex1.m1" class="ltx_Math" alttext="X^{\prime}_{s}\;=\;X_{s}-h" display="block" intent=":literal"><semantics><mrow><msubsup><mi>X</mi><mi>s</mi><mo>′</mo></msubsup><mo lspace="0.558em" rspace="0.558em">=</mo><mrow><msub><mi>X</mi><mi>s</mi></msub><mo>−</mo><mi>h</mi></mrow></mrow><annotation encoding="application/x-tex">X^{\prime}_{s}\;=\;X_{s}-h</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.SSS0.Px2.p1.2" class="ltx_p">with <math id="A6.SS1.SSS0.Px2.p1.m5" class="ltx_Math" alttext="h\neq 0" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">h\neq 0</annotation></semantics></math>.
For <math id="A6.SS1.SSS0.Px2.p1.m6" class="ltx_Math" alttext="t\geq s" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mi>s</mi></mrow><annotation encoding="application/x-tex">t\geq s</annotation></semantics></math>, define <math id="A6.SS1.SSS0.Px2.p1.m7" class="ltx_Math" alttext="\Delta_{t}:=X_{t}-X^{\prime}_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo>:=</mo><mrow><msub><mi>X</mi><mi>t</mi></msub><mo>−</mo><msubsup><mi>X</mi><mi>t</mi><mo>′</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">\Delta_{t}:=X_{t}-X^{\prime}_{t}</annotation></semantics></math>.
Subtracting (<a href="#A6.E1" title="Equation F.1 ‣ Setup. ‣ F.1 Example: Volterra equation model ‣ Appendix F Additional details on examples ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.1</span></a>) for the two evolutions (they share <math id="A6.SS1.SSS0.Px2.p1.m8" class="ltx_Math" alttext="(W_{u})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>u</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(W_{u})</annotation></semantics></math>) gives for <math id="A6.SS1.SSS0.Px2.p1.m9" class="ltx_Math" alttext="t\geq s" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mi>s</mi></mrow><annotation encoding="application/x-tex">t\geq s</annotation></semantics></math>:</p>
<table id="A6.E7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.E7.m1" class="ltx_Math" alttext="\Delta_{t+1}=\sum_{u=s}^{t}\frac{b(X_{u})-b(X^{\prime}_{u})}{(t-u+1)^{\alpha}},\qquad\|\Delta_{t+1}\|\leq L\sum_{u=s}^{t}\frac{\|\Delta_{u}\|}{(t-u+1)^{\alpha}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi mathvariant="normal">Δ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>=</mo><mi>s</mi></mrow><mi>t</mi></munderover><mfrac><mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>u</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>X</mi><mi>u</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>t</mi><mo>−</mo><mi>u</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>α</mi></msup></mfrac></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Δ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>=</mo><mi>s</mi></mrow><mi>t</mi></munderover><mfrac><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Δ</mi><mi>u</mi></msub><mo stretchy="false">‖</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>t</mi><mo>−</mo><mi>u</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>α</mi></msup></mfrac></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Delta_{t+1}=\sum_{u=s}^{t}\frac{b(X_{u})-b(X^{\prime}_{u})}{(t-u+1)^{\alpha}},\qquad\|\Delta_{t+1}\|\leq L\sum_{u=s}^{t}\frac{\|\Delta_{u}\|}{(t-u+1)^{\alpha}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(F.7)</span></td></tr></tbody>
</table>
<p id="A6.SS1.SSS0.Px2.p1.3" class="ltx_p">Set <math id="A6.SS1.SSS0.Px2.p1.m10" class="ltx_Math" alttext="n:=t-s+1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>:=</mo><mrow><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">n:=t-s+1</annotation></semantics></math>, <math id="A6.SS1.SSS0.Px2.p1.m11" class="ltx_Math" alttext="a_{n}:=\mathbb{E}\big(\|\Delta_{s+n}\|\,\big|\,\mathcal{F}_{s}\big)" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>n</mi></msub><mo>:=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Δ</mi><mrow><mi>s</mi><mo>+</mo><mi>n</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mo lspace="0.170em" mathsize="1.200em" rspace="0.170em">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>s</mi></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">a_{n}:=\mathbb{E}\big(\|\Delta_{s+n}\|\,\big|\,\mathcal{F}_{s}\big)</annotation></semantics></math> and <math id="A6.SS1.SSS0.Px2.p1.m12" class="ltx_Math" alttext="a_{0}=\|\Delta_{s}\|=\|h\|" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mn>0</mn></msub><mo>=</mo><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Δ</mi><mi>s</mi></msub><mo stretchy="false">‖</mo></mrow><mo>=</mo><mrow><mo stretchy="false">‖</mo><mi>h</mi><mo stretchy="false">‖</mo></mrow></mrow><annotation encoding="application/x-tex">a_{0}=\|\Delta_{s}\|=\|h\|</annotation></semantics></math>.
Applying Lemma <a href="#A6.Thmlemma1" title="Lemma F.1. ‣ Setup. ‣ F.1 Example: Volterra equation model ‣ Appendix F Additional details on examples ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.1</span></a> with <math id="A6.SS1.SSS0.Px2.p1.m13" class="ltx_Math" alttext="g_{n}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>n</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">g_{n}=0</annotation></semantics></math> yields, for <math id="A6.SS1.SSS0.Px2.p1.m14" class="ltx_Math" alttext="n\leq N" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≤</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">n\leq N</annotation></semantics></math>,</p>
<table id="A6.E8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.E8.m1" class="ltx_Math" alttext="a_{n}\;\leq\;\lambda_{N}^{n}\,\|h\|," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0.558em" rspace="0.558em">≤</mo><mrow><msubsup><mi>λ</mi><mi>N</mi><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mi>h</mi><mo stretchy="false">‖</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">a_{n}\;\leq\;\lambda_{N}^{n}\,\|h\|,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(F.8)</span></td></tr></tbody>
</table>
<p id="A6.SS1.SSS0.Px2.p1.4" class="ltx_p">We now bound the Wasserstein distance between the conditional laws of <math id="A6.SS1.SSS0.Px2.p1.m15" class="ltx_Math" alttext="X_{s+n}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mrow><mi>s</mi><mo>+</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">X_{s+n}</annotation></semantics></math> and <math id="A6.SS1.SSS0.Px2.p1.m16" class="ltx_Math" alttext="X^{\prime}_{s+n}" display="inline" intent=":literal"><semantics><msubsup><mi>X</mi><mrow><mi>s</mi><mo>+</mo><mi>n</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">X^{\prime}_{s+n}</annotation></semantics></math> given <math id="A6.SS1.SSS0.Px2.p1.m17" class="ltx_Math" alttext="\mathcal{F}_{s}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>s</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{s}</annotation></semantics></math> by using the synchronous coupling between <math id="A6.SS1.SSS0.Px2.p1.m18" class="ltx_Math" alttext="X_{s+n}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mrow><mi>s</mi><mo>+</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">X_{s+n}</annotation></semantics></math> and <math id="A6.SS1.SSS0.Px2.p1.m19" class="ltx_Math" alttext="X^{\prime}_{s+n}" display="inline" intent=":literal"><semantics><msubsup><mi>X</mi><mrow><mi>s</mi><mo>+</mo><mi>n</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">X^{\prime}_{s+n}</annotation></semantics></math> (which share the same noise sequence <math id="A6.SS1.SSS0.Px2.p1.m20" class="ltx_Math" alttext="(W_{u})_{u&gt;s}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>u</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>u</mi><mo>&gt;</mo><mi>s</mi></mrow></msub><annotation encoding="application/x-tex">(W_{u})_{u&gt;s}</annotation></semantics></math>):</p>
<table id="A6.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex2.m1" class="ltx_Math" alttext="W_{1}\!\big(\mathcal{L}(X_{s+n}\mid\mathcal{F}_{s}),\ \mathcal{L}(X^{\prime}_{s+n}\mid\mathcal{F}_{s})\big)\leq\mathbb{E}\big(\|X_{s+n}-X^{\prime}_{s+n}\|\mid\mathcal{F}_{s}\big)\leq\lambda_{N}^{n}\,\|h\|." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>W</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mrow><mi>s</mi><mo>+</mo><mi>n</mi></mrow></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>X</mi><mrow><mi>s</mi><mo>+</mo><mi>n</mi></mrow><mo>′</mo></msubsup><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>X</mi><mrow><mi>s</mi><mo>+</mo><mi>n</mi></mrow></msub><mo>−</mo><msubsup><mi>X</mi><mrow><mi>s</mi><mo>+</mo><mi>n</mi></mrow><mo>′</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>s</mi></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>≤</mo><mrow><msubsup><mi>λ</mi><mi>N</mi><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mi>h</mi><mo stretchy="false">‖</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">W_{1}\!\big(\mathcal{L}(X_{s+n}\mid\mathcal{F}_{s}),\ \mathcal{L}(X^{\prime}_{s+n}\mid\mathcal{F}_{s})\big)\leq\mathbb{E}\big(\|X_{s+n}-X^{\prime}_{s+n}\|\mid\mathcal{F}_{s}\big)\leq\lambda_{N}^{n}\,\|h\|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.SSS0.Px2.p1.5" class="ltx_p">Therefore, for any horizon <math id="A6.SS1.SSS0.Px2.p1.m21" class="ltx_Math" alttext="T\geq s+1" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>≥</mo><mrow><mi>s</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">T\geq s+1</annotation></semantics></math>,</p>
<table id="A6.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.E9.m1" class="ltx_Math" alttext="{\quad\sup_{\,s+1\leq t\leq T}W_{1}\!\big(\mathcal{L}(X_{t}\mid\mathcal{F}_{s}),\ \mathcal{L}(X^{\prime}_{t}\mid\mathcal{F}_{s})\big)\;\leq\;\|h\|\,\lambda_{T-s}^{T-s}=\begin{cases}\|h\|\,(L(1+\log(T-s))^{T-s}&amp;\text{if }\alpha=1,\\[6.0pt]
\|h\|\,(L\zeta(\alpha))^{T-s}&amp;\text{if }\alpha&gt;1.\end{cases}\quad}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mrow><mi>s</mi><mo>+</mo><mn>1</mn></mrow><mo>≤</mo><mi>t</mi><mo>≤</mo><mi>T</mi></mrow></munder><mrow><msub><mi>W</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>t</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>X</mi><mi>t</mi><mo>′</mo></msubsup><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.280em">)</mo></mrow></mrow></mrow><mo rspace="0.558em">≤</mo><mphantom></mphantom></mrow><mo fence="false">|</mo><mrow><mi>h</mi><mo fence="false">|</mo><mrow><msubsup><mi>λ</mi><mrow><mi>T</mi><mo>−</mo><mi>s</mi></mrow><mrow><mi>T</mi><mo>−</mo><mi>s</mi></mrow></msubsup><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo stretchy="false">‖</mo><mi>h</mi><mo stretchy="false">‖</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>T</mi><mo>−</mo><mi>s</mi></mrow></msup></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>=</mo><mn>1</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo stretchy="false">‖</mo><mi>h</mi><mo stretchy="false">‖</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>T</mi><mo>−</mo><mi>s</mi></mrow></msup></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>&gt;</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace></mrow><annotation encoding="application/x-tex">{\quad\sup_{\,s+1\leq t\leq T}W_{1}\!\big(\mathcal{L}(X_{t}\mid\mathcal{F}_{s}),\ \mathcal{L}(X^{\prime}_{t}\mid\mathcal{F}_{s})\big)\;\leq\;\|h\|\,\lambda_{T-s}^{T-s}=\begin{cases}\|h\|\,(L(1+\log(T-s))^{T-s}&amp;\text{if }\alpha=1,\\[6.0pt]
\|h\|\,(L\zeta(\alpha))^{T-s}&amp;\text{if }\alpha&gt;1.\end{cases}\quad}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(F.9)</span></td></tr></tbody>
</table>
</div>
<div id="A6.SS1.SSS0.Px2.p2" class="ltx_para">
<p id="A6.SS1.SSS0.Px2.p2.1" class="ltx_p">The behaviour of the bound crucially depends on <math id="A6.SS1.SSS0.Px2.p2.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> and <math id="A6.SS1.SSS0.Px2.p2.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>: if <math id="A6.SS1.SSS0.Px2.p2.m3" class="ltx_Math" alttext="\alpha&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\alpha&gt;1</annotation></semantics></math> and <math id="A6.SS1.SSS0.Px2.p2.m4" class="ltx_Math" alttext="L\zeta(\alpha)&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">L\zeta(\alpha)&lt;1</annotation></semantics></math>, the effect of the perturbation decays exponentially fast with <math id="A6.SS1.SSS0.Px2.p2.m5" class="ltx_Math" alttext="T-s" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>−</mo><mi>s</mi></mrow><annotation encoding="application/x-tex">T-s</annotation></semantics></math>; if <math id="A6.SS1.SSS0.Px2.p2.m6" class="ltx_Math" alttext="\alpha&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\alpha&gt;1</annotation></semantics></math> and <math id="A6.SS1.SSS0.Px2.p2.m7" class="ltx_Math" alttext="L\zeta(\alpha)&gt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">L\zeta(\alpha)&gt;1</annotation></semantics></math>, the effect of the perturbation grows exponentially fast with <math id="A6.SS1.SSS0.Px2.p2.m8" class="ltx_Math" alttext="T-s" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>−</mo><mi>s</mi></mrow><annotation encoding="application/x-tex">T-s</annotation></semantics></math>.
In both case, higher values of <math id="A6.SS1.SSS0.Px2.p2.m9" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> (faster memory decay) lead to better dependence properties.</p>
</div>
</section>
<section id="A6.SS1.SSS0.Px3" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Noise perturbation.</h4>

<div id="A6.SS1.SSS0.Px3.p1" class="ltx_para">
<p id="A6.SS1.SSS0.Px3.p1.1" class="ltx_p">Fix <math id="A6.SS1.SSS0.Px3.p1.m1" class="ltx_Math" alttext="s\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">s\geq 1</annotation></semantics></math> and let <math id="A6.SS1.SSS0.Px3.p1.m2" class="ltx_Math" alttext="\mathcal{F}_{s-1}:=\sigma\big(X_{1},\dots,X_{s-1},\ W_{1},\dots,W_{s-1}\big)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>:=</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>X</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>X</mi><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>W</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>W</mi><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}_{s-1}:=\sigma\big(X_{1},\dots,X_{s-1},\ W_{1},\dots,W_{s-1}\big)</annotation></semantics></math>.
Assume the two systems agree up to time <math id="A6.SS1.SSS0.Px3.p1.m3" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> except that at time <math id="A6.SS1.SSS0.Px3.p1.m4" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> we have</p>
<table id="A6.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex3.m1" class="ltx_Math" alttext="W^{\prime}_{s}\;=\;W_{s}+\eta" display="block" intent=":literal"><semantics><mrow><msubsup><mi>W</mi><mi>s</mi><mo>′</mo></msubsup><mo lspace="0.558em" rspace="0.558em">=</mo><mrow><msub><mi>W</mi><mi>s</mi></msub><mo>+</mo><mi>η</mi></mrow></mrow><annotation encoding="application/x-tex">W^{\prime}_{s}\;=\;W_{s}+\eta</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.SSS0.Px3.p1.2" class="ltx_p">with <math id="A6.SS1.SSS0.Px3.p1.m5" class="ltx_Math" alttext="\eta\neq 0" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta\neq 0</annotation></semantics></math>,
and <math id="A6.SS1.SSS0.Px3.p1.m6" class="ltx_Math" alttext="W^{\prime}_{u}=W_{u}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>W</mi><mi>u</mi><mo>′</mo></msubsup><mo>=</mo><msub><mi>W</mi><mi>u</mi></msub></mrow><annotation encoding="application/x-tex">W^{\prime}_{u}=W_{u}</annotation></semantics></math> for <math id="A6.SS1.SSS0.Px3.p1.m7" class="ltx_Math" alttext="u\neq s" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>≠</mo><mi>s</mi></mrow><annotation encoding="application/x-tex">u\neq s</annotation></semantics></math>.
Again define <math id="A6.SS1.SSS0.Px3.p1.m8" class="ltx_Math" alttext="\Delta_{t}:=X_{t}-X^{\prime}_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo>:=</mo><mrow><msub><mi>X</mi><mi>t</mi></msub><mo>−</mo><msubsup><mi>X</mi><mi>t</mi><mo>′</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">\Delta_{t}:=X_{t}-X^{\prime}_{t}</annotation></semantics></math> for <math id="A6.SS1.SSS0.Px3.p1.m9" class="ltx_Math" alttext="t\geq s" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mi>s</mi></mrow><annotation encoding="application/x-tex">t\geq s</annotation></semantics></math>.
Subtracting the two recursions gives for <math id="A6.SS1.SSS0.Px3.p1.m10" class="ltx_Math" alttext="t\geq s" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mi>s</mi></mrow><annotation encoding="application/x-tex">t\geq s</annotation></semantics></math>:</p>
<table id="A6.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.E10.m1" class="ltx_Math" alttext="\Delta_{t+1}=\sum_{u=s}^{t}\frac{b(X_{u})-b(X^{\prime}_{u})}{(t-u+1)^{\alpha}}\;+\;\frac{W_{s}-W^{\prime}_{s}}{(t-s+1)^{\alpha}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Δ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo rspace="0.111em">=</mo><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>=</mo><mi>s</mi></mrow><mi>t</mi></munderover><mfrac><mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>u</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>X</mi><mi>u</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>t</mi><mo>−</mo><mi>u</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>α</mi></msup></mfrac></mrow><mo lspace="0.502em" rspace="0.502em">+</mo><mfrac><mrow><msub><mi>W</mi><mi>s</mi></msub><mo>−</mo><msubsup><mi>W</mi><mi>s</mi><mo>′</mo></msubsup></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>α</mi></msup></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Delta_{t+1}=\sum_{u=s}^{t}\frac{b(X_{u})-b(X^{\prime}_{u})}{(t-u+1)^{\alpha}}\;+\;\frac{W_{s}-W^{\prime}_{s}}{(t-s+1)^{\alpha}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(F.10)</span></td></tr></tbody>
</table>
<p id="A6.SS1.SSS0.Px3.p1.3" class="ltx_p">Taking norms and using Lipschitzness,</p>
<table id="A6.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex4.m1" class="ltx_Math" alttext="\|\Delta_{t+1}\|\;\leq\;L\sum_{u=s}^{t}\frac{\|\Delta_{u}\|}{(t-u+1)^{\alpha}}\;+\;\frac{\|\eta\|}{(t-s+1)^{\alpha}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Δ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo rspace="0.280em" stretchy="false">‖</mo></mrow><mo rspace="0.558em">≤</mo><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>=</mo><mi>s</mi></mrow><mi>t</mi></munderover><mfrac><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Δ</mi><mi>u</mi></msub><mo stretchy="false">‖</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>t</mi><mo>−</mo><mi>u</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>α</mi></msup></mfrac></mrow></mrow><mo lspace="0.502em" rspace="0.502em">+</mo><mfrac><mrow><mo stretchy="false">‖</mo><mi>η</mi><mo stretchy="false">‖</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>α</mi></msup></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\Delta_{t+1}\|\;\leq\;L\sum_{u=s}^{t}\frac{\|\Delta_{u}\|}{(t-u+1)^{\alpha}}\;+\;\frac{\|\eta\|}{(t-s+1)^{\alpha}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.SSS0.Px3.p1.4" class="ltx_p">Set <math id="A6.SS1.SSS0.Px3.p1.m11" class="ltx_Math" alttext="n:=t-s+1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>:=</mo><mrow><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">n:=t-s+1</annotation></semantics></math> and <math id="A6.SS1.SSS0.Px3.p1.m12" class="ltx_Math" alttext="a_{n}:=\mathbb{E}\big(\|\Delta_{s+n}\|\,\big|\,\mathcal{F}_{s-1}\big)" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>n</mi></msub><mo>:=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Δ</mi><mrow><mi>s</mi><mo>+</mo><mi>n</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mo lspace="0.170em" mathsize="1.200em" rspace="0.170em">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">a_{n}:=\mathbb{E}\big(\|\Delta_{s+n}\|\,\big|\,\mathcal{F}_{s-1}\big)</annotation></semantics></math>.
Note <math id="A6.SS1.SSS0.Px3.p1.m13" class="ltx_Math" alttext="a_{0}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mn>0</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a_{0}=0</annotation></semantics></math> (since <math id="A6.SS1.SSS0.Px3.p1.m14" class="ltx_Math" alttext="X_{s}=X^{\prime}_{s}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>s</mi></msub><mo>=</mo><msubsup><mi>X</mi><mi>s</mi><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">X_{s}=X^{\prime}_{s}</annotation></semantics></math>).
Apply Lemma <a href="#A6.Thmlemma1" title="Lemma F.1. ‣ Setup. ‣ F.1 Example: Volterra equation model ‣ Appendix F Additional details on examples ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.1</span></a> with <math id="A6.SS1.SSS0.Px3.p1.m15" class="ltx_Math" alttext="g_{n}:=\|\eta\|\,n^{-\alpha}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>n</mi></msub><mo>:=</mo><mrow><mrow><mo stretchy="false">‖</mo><mi>η</mi><mo stretchy="false">‖</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mo>−</mo><mi>α</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">g_{n}:=\|\eta\|\,n^{-\alpha}</annotation></semantics></math> to obtain,for <math id="A6.SS1.SSS0.Px3.p1.m16" class="ltx_Math" alttext="n\leq N" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≤</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">n\leq N</annotation></semantics></math>,</p>
<table id="A6.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.E11.m1" class="ltx_Math" alttext="a_{n}\;\leq\;\sum_{j=1}^{n}\|\eta\|j^{-\alpha}\,{\lambda_{N}^{n-j}}\leq\|\eta\|\times\frac{\lambda_{N}^{n}-1}{\lambda_{N}-1}\,," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0.558em" rspace="0.391em">≤</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mrow><mo stretchy="false">‖</mo><mi>η</mi><mo stretchy="false">‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>j</mi><mrow><mo>−</mo><mi>α</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>N</mi><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msubsup></mrow></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">‖</mo><mi>η</mi><mo rspace="0.055em" stretchy="false">‖</mo></mrow><mo rspace="0.222em">×</mo><mfrac><mrow><msubsup><mi>λ</mi><mi>N</mi><mi>n</mi></msubsup><mo>−</mo><mn>1</mn></mrow><mrow><msub><mi>λ</mi><mi>N</mi></msub><mo>−</mo><mn>1</mn></mrow></mfrac></mrow></mrow><mo lspace="0.170em">,</mo></mrow><annotation encoding="application/x-tex">a_{n}\;\leq\;\sum_{j=1}^{n}\|\eta\|j^{-\alpha}\,{\lambda_{N}^{n-j}}\leq\|\eta\|\times\frac{\lambda_{N}^{n}-1}{\lambda_{N}-1}\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(F.11)</span></td></tr></tbody>
</table>
<p id="A6.SS1.SSS0.Px3.p1.5" class="ltx_p">where we consider <math id="A6.SS1.SSS0.Px3.p1.m17" class="ltx_Math" alttext="\lambda_{N}\neq 1" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>N</mi></msub><mo>≠</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\lambda_{N}\neq 1</annotation></semantics></math> for simplicity.</p>
</div>
<div id="A6.SS1.SSS0.Px3.p2" class="ltx_para">
<p id="A6.SS1.SSS0.Px3.p2.1" class="ltx_p">Bounding the Wasserstein distance as before yields, for any horizon <math id="A6.SS1.SSS0.Px3.p2.m1" class="ltx_Math" alttext="T\geq s+1" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>≥</mo><mrow><mi>s</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">T\geq s+1</annotation></semantics></math>,</p>
<table id="A6.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.E12.m1" class="ltx_Math" alttext="{\quad\sup_{\,s+1\leq t\leq T}W_{1}\!\big(\mathcal{L}(X_{t}\mid\mathcal{F}_{s-1}),\ \mathcal{L}(X^{\prime}_{t}\mid\mathcal{F}_{s-1})\big)\;\leq\;\begin{cases}\|\eta\|\,\frac{(L(1+\log(T-s)))^{T-s}-1}{L(1+\log(T-s))-1},&amp;\text{if }\alpha=1,\\[6.0pt]
\|\eta\|\,\frac{(L\zeta(\alpha))^{T-s}-1}{L\zeta(\alpha)-1},&amp;\text{if }\alpha&gt;1.\end{cases}\quad}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mrow><mi>s</mi><mo>+</mo><mn>1</mn></mrow><mo>≤</mo><mi>t</mi><mo>≤</mo><mi>T</mi></mrow></munder><mrow><msub><mi>W</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>t</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>X</mi><mi>t</mi><mo>′</mo></msubsup><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.280em">)</mo></mrow></mrow></mrow><mo rspace="0.558em">≤</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mo stretchy="false">‖</mo><mi>η</mi><mo stretchy="false">‖</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mstyle displaystyle="false"><mfrac><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>T</mi><mo>−</mo><mi>s</mi></mrow></msup><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>=</mo><mn>1</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mo stretchy="false">‖</mo><mi>η</mi><mo stretchy="false">‖</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mstyle displaystyle="false"><mfrac><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>T</mi><mo>−</mo><mi>s</mi></mrow></msup><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>&gt;</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><mspace style="width:1em;" width="1em"></mspace></mrow><annotation encoding="application/x-tex">{\quad\sup_{\,s+1\leq t\leq T}W_{1}\!\big(\mathcal{L}(X_{t}\mid\mathcal{F}_{s-1}),\ \mathcal{L}(X^{\prime}_{t}\mid\mathcal{F}_{s-1})\big)\;\leq\;\begin{cases}\|\eta\|\,\frac{(L(1+\log(T-s)))^{T-s}-1}{L(1+\log(T-s))-1},&amp;\text{if }\alpha=1,\\[6.0pt]
\|\eta\|\,\frac{(L\zeta(\alpha))^{T-s}-1}{L\zeta(\alpha)-1},&amp;\text{if }\alpha&gt;1.\end{cases}\quad}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(F.12)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A6.SS1.SSS0.Px4" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Drift perturbation.</h4>

<div id="A6.SS1.SSS0.Px4.p1" class="ltx_para">
<p id="A6.SS1.SSS0.Px4.p1.1" class="ltx_p">To consider drift perturbations, we write the drift as <math id="A6.SS1.SSS0.Px4.p1.m1" class="ltx_Math" alttext="b_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">b_{\theta}</annotation></semantics></math> where <math id="A6.SS1.SSS0.Px4.p1.m2" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> is a parameter. In addition to assuming that <math id="A6.SS1.SSS0.Px4.p1.m3" class="ltx_Math" alttext="b_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">b_{\theta}</annotation></semantics></math> is uniformly <math id="A6.SS1.SSS0.Px4.p1.m4" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>-Lipschitz for all <math id="A6.SS1.SSS0.Px4.p1.m5" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>, we also assume that it is <math id="A6.SS1.SSS0.Px4.p1.m6" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>-Lipschitz in <math id="A6.SS1.SSS0.Px4.p1.m7" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> uniformly in <math id="A6.SS1.SSS0.Px4.p1.m8" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, that is, for all <math id="A6.SS1.SSS0.Px4.p1.m9" class="ltx_Math" alttext="x,x^{\prime}\in{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathbb{R}}}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>,</mo><mrow><msup><mi>x</mi><mo>′</mo></msup><mo>∈</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mi>d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">x,x^{\prime}\in{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathbb{R}}}^{d}</annotation></semantics></math> and <math id="A6.SS1.SSS0.Px4.p1.m10" class="ltx_Math" alttext="\theta,\theta^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>,</mo><msup><mi>θ</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">\theta,\theta^{\prime}</annotation></semantics></math>,</p>
<table id="A6.E13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.E13.m1" class="ltx_Math" alttext="\lVert b_{\theta}(x)-b_{\theta^{\prime}}(x^{\prime})\rVert\ \leq\ L\,\|x-x^{\prime}\|+M\,\|\theta-\theta^{\prime}\|." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo fence="true" rspace="0em">∥</mo><mrow><mrow><msub><mi>b</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>b</mi><msup><mi>θ</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo fence="true" lspace="0em" rspace="0.500em">∥</mo></mrow><mo rspace="0.778em">≤</mo><mrow><mrow><mi>L</mi><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><mi>x</mi><mo>−</mo><msup><mi>x</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow></mrow><mo>+</mo><mrow><mi>M</mi><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><mi>θ</mi><mo>−</mo><msup><mi>θ</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lVert b_{\theta}(x)-b_{\theta^{\prime}}(x^{\prime})\rVert\ \leq\ L\,\|x-x^{\prime}\|+M\,\|\theta-\theta^{\prime}\|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(F.13)</span></td></tr></tbody>
</table>
</div>
<div id="A6.SS1.SSS0.Px4.p2" class="ltx_para">
<p id="A6.SS1.SSS0.Px4.p2.1" class="ltx_p">Consider <math id="A6.SS1.SSS0.Px4.p2.m1" class="ltx_Math" alttext="\theta,\theta^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>,</mo><msup><mi>θ</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">\theta,\theta^{\prime}</annotation></semantics></math> and the two systems with drifts <math id="A6.SS1.SSS0.Px4.p2.m2" class="ltx_Math" alttext="b_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">b_{\theta}</annotation></semantics></math> and <math id="A6.SS1.SSS0.Px4.p2.m3" class="ltx_Math" alttext="b_{\theta^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><msup><mi>θ</mi><mo>′</mo></msup></msub><annotation encoding="application/x-tex">b_{\theta^{\prime}}</annotation></semantics></math> respectively:</p>
<table id="A6.EGx80" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.E14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.E14.m1" class="ltx_Math" alttext="\displaystyle X_{t+1}\;" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\displaystyle X_{t+1}\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E14.m2" class="ltx_Math" alttext="\displaystyle=\;\sum_{u=1}^{t}K(t,u)\,\bigl(b_{\theta}(X_{u})+W_{u}\bigr)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo rspace="0.558em">=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>b</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>u</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>W</mi><mi>u</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\;\sum_{u=1}^{t}K(t,u)\,\bigl(b_{\theta}(X_{u})+W_{u}\bigr),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(F.14)</span></td></tr></tbody>
<tbody id="A6.E15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.E15.m1" class="ltx_Math" alttext="\displaystyle X^{\prime}_{t+1}\;" display="inline" intent=":literal"><semantics><msubsup><mi>X</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">\displaystyle X^{\prime}_{t+1}\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E15.m2" class="ltx_Math" alttext="\displaystyle=\;\sum_{u=1}^{t}K(t,u)\,\bigl(b_{\theta^{\prime}}(X^{\prime}_{u})+W_{u}\bigr)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo rspace="0.558em">=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>b</mi><msup><mi>θ</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>X</mi><mi>u</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>W</mi><mi>u</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\;\sum_{u=1}^{t}K(t,u)\,\bigl(b_{\theta^{\prime}}(X^{\prime}_{u})+W_{u}\bigr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(F.15)</span></td></tr></tbody>
</table>
<p id="A6.SS1.SSS0.Px4.p2.2" class="ltx_p">As before, we will bound the Wasserstein distance between <math id="A6.SS1.SSS0.Px4.p2.m4" class="ltx_Math" alttext="X_{t}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>t</mi></msub><annotation encoding="application/x-tex">X_{t}</annotation></semantics></math> and <math id="A6.SS1.SSS0.Px4.p2.m5" class="ltx_Math" alttext="X^{\prime}_{t}" display="inline" intent=":literal"><semantics><msubsup><mi>X</mi><mi>t</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">X^{\prime}_{t}</annotation></semantics></math> by using the synchronous coupling. Assuming that the two sequences share the same noise sequence <math id="A6.SS1.SSS0.Px4.p2.m6" class="ltx_Math" alttext="(W_{u})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>u</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(W_{u})</annotation></semantics></math>, we define <math id="A6.SS1.SSS0.Px4.p2.m7" class="ltx_Math" alttext="\Delta_{t}=X_{t}-X^{\prime}_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo>=</mo><mrow><msub><mi>X</mi><mi>t</mi></msub><mo>−</mo><msubsup><mi>X</mi><mi>t</mi><mo>′</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">\Delta_{t}=X_{t}-X^{\prime}_{t}</annotation></semantics></math> and obtain, using (<a href="#A6.E13" title="Equation F.13 ‣ Drift perturbation. ‣ F.1 Example: Volterra equation model ‣ Appendix F Additional details on examples ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.13</span></a>), for <math id="A6.SS1.SSS0.Px4.p2.m8" class="ltx_Math" alttext="t\leq T" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≤</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t\leq T</annotation></semantics></math></p>
<table id="A6.E16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.E16.m1" class="ltx_Math" alttext="\|\Delta_{t+1}\|\leq L\sum_{u=1}^{t}\frac{\|\Delta_{u}\|}{(t-u+1)^{\alpha}}+M\|\theta-\theta^{\prime}\|H_{\alpha}(T)\,." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Δ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover><mfrac><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Δ</mi><mi>u</mi></msub><mo stretchy="false">‖</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>t</mi><mo>−</mo><mi>u</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>α</mi></msup></mfrac></mrow></mrow><mo>+</mo><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><mi>θ</mi><mo>−</mo><msup><mi>θ</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">\|\Delta_{t+1}\|\leq L\sum_{u=1}^{t}\frac{\|\Delta_{u}\|}{(t-u+1)^{\alpha}}+M\|\theta-\theta^{\prime}\|H_{\alpha}(T)\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(F.16)</span></td></tr></tbody>
</table>
<p id="A6.SS1.SSS0.Px4.p2.3" class="ltx_p">Setting <math id="A6.SS1.SSS0.Px4.p2.m9" class="ltx_Math" alttext="a_{n}=\lVert\Delta_{n}\rVert" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>n</mi></msub><mo rspace="0.1389em">=</mo><mrow><mo fence="true" lspace="0.1389em" rspace="0em">∥</mo><msub><mi mathvariant="normal">Δ</mi><mi>n</mi></msub><mo fence="true" lspace="0em">∥</mo></mrow></mrow><annotation encoding="application/x-tex">a_{n}=\lVert\Delta_{n}\rVert</annotation></semantics></math> and <math id="A6.SS1.SSS0.Px4.p2.m10" class="ltx_Math" alttext="g_{n}=M\|\theta-\theta^{\prime}\|H_{\alpha}(T)" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>n</mi></msub><mo>=</mo><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><mi>θ</mi><mo>−</mo><msup><mi>θ</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">g_{n}=M\|\theta-\theta^{\prime}\|H_{\alpha}(T)</annotation></semantics></math> with <math id="A6.SS1.SSS0.Px4.p2.m11" class="ltx_Math" alttext="a_{0}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mn>0</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a_{0}=0</annotation></semantics></math>, we can apply Lemma <a href="#A6.Thmlemma1" title="Lemma F.1. ‣ Setup. ‣ F.1 Example: Volterra equation model ‣ Appendix F Additional details on examples ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.1</span></a> as before to obtain, for <math id="A6.SS1.SSS0.Px4.p2.m12" class="ltx_Math" alttext="t\leq T" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≤</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t\leq T</annotation></semantics></math>,</p>
<table id="A6.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.E17.m1" class="ltx_Math" alttext="W_{1}\!\big(\mathcal{L}(X_{t}),\ \mathcal{L}(X^{\prime}_{t})\big)\;\leq\;M\|\theta-\theta^{\prime}\|\begin{cases}(1+\log T)\,\frac{(L(1+\log T))^{t}-1}{L(1+\log T)-1},&amp;\text{if }\alpha=1,\\[6.0pt]
\zeta(\alpha)\,\frac{(L\zeta(\alpha))^{t}-1}{L\zeta(\alpha)-1},&amp;\text{if }\alpha&gt;1\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>W</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>X</mi><mi>t</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.280em">)</mo></mrow></mrow><mo rspace="0.558em">≤</mo><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><mi>θ</mi><mo>−</mo><msup><mi>θ</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mstyle displaystyle="false"><mfrac><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>t</mi></msup><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>=</mo><mn>1</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mi>ζ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mstyle displaystyle="false"><mfrac><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>t</mi></msup><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>&gt;</mo><mn>1</mn></mrow></mtd></mtr></mtable></mrow></mrow></mrow><annotation encoding="application/x-tex">W_{1}\!\big(\mathcal{L}(X_{t}),\ \mathcal{L}(X^{\prime}_{t})\big)\;\leq\;M\|\theta-\theta^{\prime}\|\begin{cases}(1+\log T)\,\frac{(L(1+\log T))^{t}-1}{L(1+\log T)-1},&amp;\text{if }\alpha=1,\\[6.0pt]
\zeta(\alpha)\,\frac{(L\zeta(\alpha))^{t}-1}{L\zeta(\alpha)-1},&amp;\text{if }\alpha&gt;1\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(F.17)</span></td></tr></tbody>
</table>
<p id="A6.SS1.SSS0.Px4.p2.4" class="ltx_p">where we used (<a href="#A6.E3" title="Equation F.3 ‣ Setup. ‣ F.1 Example: Volterra equation model ‣ Appendix F Additional details on examples ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.3</span></a>) to bound <math id="A6.SS1.SSS0.Px4.p2.m13" class="ltx_Math" alttext="H_{\alpha}(T)" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{\alpha}(T)</annotation></semantics></math>.</p>
</div>
</section>
</section>
<section id="A6.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">F.2 </span>Examples for task selection assumptions</h3>

<div id="A6.SS2.p1" class="ltx_para">
<p id="A6.SS2.p1.1" class="ltx_p">In this section, we check that the examples of <a href="#S3.SS1" title="3.1 In-context learning setting ‣ 3 Theoretical framework ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">3.1</span></a> in the main text satisfy <a href="#Thmassumption3" title="Assumption 3 (Data generation). ‣ D.3 ICL setting ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumptions</span> <span class="ltx_text ltx_ref_tag">3</span></a> and <a href="#Thmassumption4" title="Assumption 4. ‣ D.5 Laplace Approximation ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>.
These are lengthy but mostly straightforward calculations, which we sketch to illustrate how to verify the assumptions in practice.</p>
</div>
<div id="A6.Thmexample1" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A6.Thmexample1.2" class="ltx_text ltx_font_bold">Example F.1</span></span><span id="A6.Thmexample1.3" class="ltx_text ltx_font_bold"> </span>(Linear regression)<span id="A6.Thmexample1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A6.Thmexample1.p1" class="ltx_para">
<p id="A6.Thmexample1.p1.1" class="ltx_p">We consider the linear regression example of <a href="#S3.SS1" title="3.1 In-context learning setting ‣ 3 Theoretical framework ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">3.1</span></a> in the main text and check that it satisfies <a href="#Thmassumption3" title="Assumption 3 (Data generation). ‣ D.3 ICL setting ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumptions</span> <span class="ltx_text ltx_ref_tag">3</span></a> and <a href="#Thmassumption4" title="Assumption 4. ‣ D.5 Laplace Approximation ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>.


Fix a true task <math id="A6.Thmexample1.p1.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\theta}^{\ast}\in{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathbb{R}}}^{d}" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∗</mo></msup><mo>∈</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\theta}^{\ast}\in{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathbb{R}}}^{d}</annotation></semantics></math>. For <math id="A6.Thmexample1.p1.m2" class="ltx_Math" alttext="t=1,\dots,{\color[rgb]{0,0,0}T}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><annotation encoding="application/x-tex">t=1,\dots,{\color[rgb]{0,0,0}T}</annotation></semantics></math>, consider
<math id="A6.Thmexample1.p1.m3" class="ltx_Math" alttext="{\color[rgb]{0,0,0}q}_{t}\sim\mathcal{N}(0,\sigma_{\color[rgb]{0,0,0}q}^{2}I_{d})" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><mi>t</mi></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><msubsup><mi>σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>I</mi><mi>d</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}q}_{t}\sim\mathcal{N}(0,\sigma_{\color[rgb]{0,0,0}q}^{2}I_{d})</annotation></semantics></math> and noise <math id="A6.Thmexample1.p1.m4" class="ltx_Math" alttext="\epsilon_{t}\sim\mathcal{N}(0,\sigma_{\epsilon}^{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϵ</mi><mi>t</mi></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msubsup><mi>σ</mi><mi>ϵ</mi><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\epsilon_{t}\sim\mathcal{N}(0,\sigma_{\epsilon}^{2})</annotation></semantics></math> i.i.d., and
<math id="A6.Thmexample1.p1.m5" class="ltx_Math" alttext="{\color[rgb]{0,0,0}y}_{t}={\color[rgb]{0,0,0}q}_{t}^{\top}{\color[rgb]{0,0,0}\theta}^{\ast}+\epsilon_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi><mi>t</mi></msub><mo>=</mo><mrow><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∗</mo></msup></mrow><mo>+</mo><msub><mi>ϵ</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}y}_{t}={\color[rgb]{0,0,0}q}_{t}^{\top}{\color[rgb]{0,0,0}\theta}^{\ast}+\epsilon_{t}</annotation></semantics></math>, <math id="A6.Thmexample1.p1.m6" class="ltx_Math" alttext="z_{t}=({\color[rgb]{0,0,0}q}_{t},{\color[rgb]{0,0,0}y}_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>z</mi><mi>t</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><mi>t</mi></msub><mo>,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">z_{t}=({\color[rgb]{0,0,0}q}_{t},{\color[rgb]{0,0,0}y}_{t})</annotation></semantics></math>, <math id="A6.Thmexample1.p1.m7" class="ltx_Math" alttext="{\color[rgb]{0,0,0}X}=\{z_{t}\}_{t=1}^{\color[rgb]{0,0,0}T}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msubsup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}X}=\{z_{t}\}_{t=1}^{\color[rgb]{0,0,0}T}</annotation></semantics></math>.
Define <math id="A6.Thmexample1.p1.m8" class="ltx_Math" alttext="Q\in{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathbb{R}}}^{{\color[rgb]{0,0,0}T}\times d}" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>∈</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">Q\in{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathbb{R}}}^{{\color[rgb]{0,0,0}T}\times d}</annotation></semantics></math> has rows <math id="A6.Thmexample1.p1.m9" class="ltx_Math" alttext="{\color[rgb]{0,0,0}q}_{t}^{\top}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><mi>t</mi><mo>⊤</mo></msubsup><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}q}_{t}^{\top}</annotation></semantics></math> and <math id="A6.Thmexample1.p1.m10" class="ltx_Math" alttext="Y=({\color[rgb]{0,0,0}y}_{t})_{t=1}^{\color[rgb]{0,0,0}T}" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo>=</mo><msubsup><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msubsup></mrow><annotation encoding="application/x-tex">Y=({\color[rgb]{0,0,0}y}_{t})_{t=1}^{\color[rgb]{0,0,0}T}</annotation></semantics></math>,
and, for any parameter <math id="A6.Thmexample1.p1.m11" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\theta}\in{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathbb{R}}}^{d}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∈</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\theta}\in{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathbb{R}}}^{d}</annotation></semantics></math>,</p>
<table id="A6.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex5.m1" class="ltx_Math" alttext="\ell_{{\color[rgb]{0,0,0}T}}({\color[rgb]{0,0,0}\theta}):=\log\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})=-\tfrac{1}{2\sigma_{\epsilon}^{2}}\|Y-Q{\color[rgb]{0,0,0}\theta}\|_{2}^{2}+\text{const}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi mathvariant="normal">ℓ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>ϵ</mi><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>Y</mi><mo>−</mo><mrow><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>+</mo><mtext>const</mtext></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\ell_{{\color[rgb]{0,0,0}T}}({\color[rgb]{0,0,0}\theta}):=\log\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})=-\tfrac{1}{2\sigma_{\epsilon}^{2}}\|Y-Q{\color[rgb]{0,0,0}\theta}\|_{2}^{2}+\text{const},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmexample1.p1.2" class="ltx_p">where the constant term depends on <math id="A6.Thmexample1.p1.m12" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> but not on <math id="A6.Thmexample1.p1.m13" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math></p>
</div>
<div id="A6.Thmexample1.p2" class="ltx_para">
<p id="A6.Thmexample1.p2.1" class="ltx_p">Let us begin with the tail behavior.
Both <math id="A6.Thmexample1.p2.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}q}_{t}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><mi>t</mi></msub><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}q}_{t}</annotation></semantics></math> and <math id="A6.Thmexample1.p2.m2" class="ltx_Math" alttext="{\color[rgb]{0,0,0}y}_{t}={\color[rgb]{0,0,0}q}_{t}^{T}{\color[rgb]{0,0,0}\theta}^{\ast}+\epsilon_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi><mi>t</mi></msub><mo>=</mo><mrow><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><mi>t</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∗</mo></msup></mrow><mo>+</mo><msub><mi>ϵ</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}y}_{t}={\color[rgb]{0,0,0}q}_{t}^{T}{\color[rgb]{0,0,0}\theta}^{\ast}+\epsilon_{t}</annotation></semantics></math> are sub-Gaussian; hence for some <math id="A6.Thmexample1.p2.m3" class="ltx_Math" alttext="c&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c&gt;0</annotation></semantics></math> and all <math id="A6.Thmexample1.p2.m4" class="ltx_Math" alttext="R\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">R\geq 1</annotation></semantics></math>,</p>
<table id="A6.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex6.m1" class="ltx_math_unparsed" alttext="\prob\!\left(\exists\,t\leq n\,,\|z_{t}\|\geq R\right)\ \leq\ \poly(n)\,e^{-cR^{2}}\ \leq\ \poly(n)\,e^{-R}." display="block" intent=":literal"><semantics><mrow><mpadded style="width:0.441em;" width="0.441em"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℙ</mi></mpadded><mrow><mo>(</mo><mo rspace="0.337em">∃</mo><mi>t</mi><mo>≤</mo><mi>n</mi><mo lspace="0.170em">,</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>z</mi><mi>t</mi></msub><mo lspace="0em" rspace="0.0835em">∥</mo><mo lspace="0.0835em">≥</mo><mi>R</mi><mo rspace="0.500em">)</mo></mrow><mo rspace="0.778em">≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mrow><mo stretchy="false">(</mo><mi>n</mi><mo rspace="0.170em" stretchy="false">)</mo></mrow><msup><mi>e</mi><mrow><mo>−</mo><msup><mi>cR</mi><mn>2</mn></msup></mrow></msup><mo rspace="0.778em">≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mrow><mo stretchy="false">(</mo><mi>n</mi><mo rspace="0.170em" stretchy="false">)</mo></mrow><msup><mi>e</mi><mrow><mo>−</mo><mi>R</mi></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\prob\!\left(\exists\,t\leq n\,,\|z_{t}\|\geq R\right)\ \leq\ \poly(n)\,e^{-cR^{2}}\ \leq\ \poly(n)\,e^{-R}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.Thmexample1.p3" class="ltx_para">
<p id="A6.Thmexample1.p3.1" class="ltx_p">For the tail condition on the likelihood, let <math id="A6.Thmexample1.p3.m1" class="ltx_Math" alttext="\Delta={\color[rgb]{0,0,0}\theta}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\Delta={\color[rgb]{0,0,0}\theta}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}</annotation></semantics></math> and <math id="A6.Thmexample1.p3.m2" class="ltx_Math" alttext="r_{0}:=Y-Q{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mn>0</mn></msub><mo>:=</mo><mrow><mi>Y</mi><mo>−</mo><mrow><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">r_{0}:=Y-Q{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}</annotation></semantics></math>. Then</p>
<table id="A6.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex7.m1" class="ltx_Math" alttext="\ell_{{\color[rgb]{0,0,0}T}}({\color[rgb]{0,0,0}\theta})-\ell_{{\color[rgb]{0,0,0}T}}({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})=-\tfrac{1}{2\sigma_{\epsilon}^{2}}\big(\|Q\Delta\|_{2}^{2}-2\Delta^{\top}Q^{\top}r_{0}\big)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi mathvariant="normal">ℓ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi mathvariant="normal">ℓ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>ϵ</mi><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Δ</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>Q</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>0</mn></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\ell_{{\color[rgb]{0,0,0}T}}({\color[rgb]{0,0,0}\theta})-\ell_{{\color[rgb]{0,0,0}T}}({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})=-\tfrac{1}{2\sigma_{\epsilon}^{2}}\big(\|Q\Delta\|_{2}^{2}-2\Delta^{\top}Q^{\top}r_{0}\big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmexample1.p3.2" class="ltx_p">Now, by e.g., <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib58" title="" class="ltx_ref">Wainwright (2019, Thm. 6.1)</a></cite>, for <math id="A6.Thmexample1.p3.m3" class="ltx_Math" alttext="{\color[rgb]{0,0,0}T}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}T}</annotation></semantics></math> large enough, there is <math id="A6.Thmexample1.p3.m4" class="ltx_Math" alttext="c&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c&gt;0</annotation></semantics></math> constant such that,
with probability at least <math id="A6.Thmexample1.p3.m5" class="ltx_Math" alttext="1-e^{-c{\color[rgb]{0,0,0}T}}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">1-e^{-c{\color[rgb]{0,0,0}T}}</annotation></semantics></math>,
<math id="A6.Thmexample1.p3.m6" class="ltx_Math" alttext="\|Q\Delta\|\geq c\sqrt{\color[rgb]{0,0,0}T}\,\|\Delta\|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow><mo stretchy="false">‖</mo></mrow><mo>≥</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msqrt><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mi mathvariant="normal">Δ</mi><mo stretchy="false">‖</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\|Q\Delta\|\geq c\sqrt{\color[rgb]{0,0,0}T}\,\|\Delta\|</annotation></semantics></math> and <math id="A6.Thmexample1.p3.m7" class="ltx_Math" alttext="\|Q^{\top}r_{0}\|\leq c^{-1}\sqrt{\color[rgb]{0,0,0}T}\,\|r_{0}\|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>Q</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>0</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mrow><msup><mi>c</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msqrt><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><msub><mi>r</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\|Q^{\top}r_{0}\|\leq c^{-1}\sqrt{\color[rgb]{0,0,0}T}\,\|r_{0}\|</annotation></semantics></math>.
Hence, uniformly over <math id="A6.Thmexample1.p3.m8" class="ltx_Math" alttext="\|{\color[rgb]{0,0,0}\theta}\|\geq R" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">‖</mo></mrow><mo>≥</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">\|{\color[rgb]{0,0,0}\theta}\|\geq R</annotation></semantics></math> (so <math id="A6.Thmexample1.p3.m9" class="ltx_Math" alttext="\|\Delta\|\geq R-\|{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mi mathvariant="normal">Δ</mi><mo stretchy="false">‖</mo></mrow><mo>≥</mo><mrow><mi>R</mi><mo>−</mo><mrow><mo stretchy="false">‖</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">‖</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\|\Delta\|\geq R-\|{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\|</annotation></semantics></math>),</p>
<table id="A6.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex8.m1" class="ltx_Math" alttext="\ell_{{\color[rgb]{0,0,0}T}}({\color[rgb]{0,0,0}\theta})-\ell_{{\color[rgb]{0,0,0}T}}({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})\ \leq\ -\tfrac{c^{2}{\color[rgb]{0,0,0}T}}{2\sigma_{\epsilon}^{2}}\|\Delta\|^{2}+\tfrac{c^{-1}\sqrt{\color[rgb]{0,0,0}T}}{\sigma_{\epsilon}^{2}}\|\Delta\|\,\|r_{0}\|." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi mathvariant="normal">ℓ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi mathvariant="normal">ℓ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo rspace="0.500em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.778em">≤</mo><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="false"><mfrac><mrow><msup><mi>c</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>ϵ</mi><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi mathvariant="normal">Δ</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="false"><mfrac><mrow><msup><mi>c</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msqrt></mrow><msubsup><mi>σ</mi><mi>ϵ</mi><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mi mathvariant="normal">Δ</mi><mo stretchy="false">‖</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><msub><mi>r</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\ell_{{\color[rgb]{0,0,0}T}}({\color[rgb]{0,0,0}\theta})-\ell_{{\color[rgb]{0,0,0}T}}({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})\ \leq\ -\tfrac{c^{2}{\color[rgb]{0,0,0}T}}{2\sigma_{\epsilon}^{2}}\|\Delta\|^{2}+\tfrac{c^{-1}\sqrt{\color[rgb]{0,0,0}T}}{\sigma_{\epsilon}^{2}}\|\Delta\|\,\|r_{0}\|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmexample1.p3.3" class="ltx_p">For all <math id="A6.Thmexample1.p3.m10" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> larger than a constant multiple of <math id="A6.Thmexample1.p3.m11" class="ltx_Math" alttext="\|r_{0}\|/\sqrt{\color[rgb]{0,0,0}T}+\|{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\|" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">‖</mo><msub><mi>r</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><mo>/</mo><msqrt><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msqrt></mrow><mo>+</mo><mrow><mo stretchy="false">‖</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">‖</mo></mrow></mrow><annotation encoding="application/x-tex">\|r_{0}\|/\sqrt{\color[rgb]{0,0,0}T}+\|{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\|</annotation></semantics></math>, the right-hand side is negative; thus
<math id="A6.Thmexample1.p3.m12" class="ltx_Math" alttext="\sup_{\|{\color[rgb]{0,0,0}\theta}\|\geq R}\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})&lt;\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>sup</mo><mrow><mrow><mo stretchy="false">‖</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">‖</mo></mrow><mo>≥</mo><mi>R</mi></mrow></msub><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&lt;</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sup_{\|{\color[rgb]{0,0,0}\theta}\|\geq R}\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})&lt;\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})</annotation></semantics></math>.
Since <math id="A6.Thmexample1.p3.m13" class="ltx_Math" alttext="\|r_{0}\|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">‖</mo><msub><mi>r</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><annotation encoding="application/x-tex">\|r_{0}\|</annotation></semantics></math> is sub-Gaussian and the norm bounds above hold with probability at least <math id="A6.Thmexample1.p3.m14" class="ltx_Math" alttext="1-e^{-cn}\geq 1-e^{-c{\color[rgb]{0,0,0}R}}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow></msup></mrow><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">1-e^{-cn}\geq 1-e^{-c{\color[rgb]{0,0,0}R}}</annotation></semantics></math> for <math id="A6.Thmexample1.p3.m15" class="ltx_Math" alttext="{\color[rgb]{0,0,0}R}\geq{\color[rgb]{0,0,0}T}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mo>≥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}R}\geq{\color[rgb]{0,0,0}T}</annotation></semantics></math>, we obtain, for all <math id="A6.Thmexample1.p3.m16" class="ltx_Math" alttext="R\geq{\color[rgb]{0,0,0}T}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>≥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><annotation encoding="application/x-tex">R\geq{\color[rgb]{0,0,0}T}</annotation></semantics></math>,</p>
<table id="A6.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex9.m1" class="ltx_Math" alttext="\prob\!\left(\sup_{\|{\color[rgb]{0,0,0}\theta}\|\geq R}\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})\ \geq\ \density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})\right)\ \leq\ \poly({\color[rgb]{0,0,0}T})\,e^{-R}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mpadded style="width:0.441em;" width="0.441em"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℙ</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mrow><mo stretchy="false">‖</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">‖</mo></mrow><mo>≥</mo><mi>R</mi></mrow></munder><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo rspace="0.500em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.778em">≥</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.500em">)</mo></mrow></mrow><mo rspace="0.778em">≤</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>R</mi></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\prob\!\left(\sup_{\|{\color[rgb]{0,0,0}\theta}\|\geq R}\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})\ \geq\ \density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})\right)\ \leq\ \poly({\color[rgb]{0,0,0}T})\,e^{-R}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.Thmexample1.p4" class="ltx_para">
<p id="A6.Thmexample1.p4.1" class="ltx_p">We now consider the moment condition.
Then, for any reference <math id="A6.Thmexample1.p4.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}</annotation></semantics></math>,</p>
<table id="A6.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex10.m1" class="ltx_Math" alttext="\sup_{{\color[rgb]{0,0,0}\theta}}\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}=\exp\!\Big(\sup_{{\color[rgb]{0,0,0}\theta}}\{\ell_{{\color[rgb]{0,0,0}T}}({\color[rgb]{0,0,0}\theta})-\ell_{{\color[rgb]{0,0,0}T}}({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})\}\Big)\leq\exp\!\Big(\tfrac{1}{2\sigma_{\epsilon}^{2}}\,\|Y-Q{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\|_{2}^{2}\Big)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></munder><mfrac><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo>=</mo><mrow><mpadded style="width:1.370em;" width="1.370em"><mi>exp</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></munder><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi mathvariant="normal">ℓ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi mathvariant="normal">ℓ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>≤</mo><mrow><mpadded style="width:1.370em;" width="1.370em"><mi>exp</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>ϵ</mi><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>Y</mi><mo>−</mo><mrow><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\sup_{{\color[rgb]{0,0,0}\theta}}\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}=\exp\!\Big(\sup_{{\color[rgb]{0,0,0}\theta}}\{\ell_{{\color[rgb]{0,0,0}T}}({\color[rgb]{0,0,0}\theta})-\ell_{{\color[rgb]{0,0,0}T}}({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})\}\Big)\leq\exp\!\Big(\tfrac{1}{2\sigma_{\epsilon}^{2}}\,\|Y-Q{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\|_{2}^{2}\Big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmexample1.p4.2" class="ltx_p">Therefore, we have</p>
<table id="A6.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex11.m1" class="ltx_Math" alttext="\log^{2}\!\sup_{{\color[rgb]{0,0,0}\theta}}\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}\ \leq\ C\,\big(\|Q({\color[rgb]{0,0,0}\theta}^{\ast}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})\|_{2}^{2}+\|\epsilon\|_{2}^{2}\big)^{2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mmultiscripts><munder><mo movablelimits="false">sup</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></munder><mprescripts></mprescripts><mrow></mrow><mn>2</mn></mmultiscripts><mo lspace="0.167em">⁡</mo><mfrac><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><mo lspace="0.778em" rspace="0.778em">≤</mo><mrow><mi>C</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∗</mo></msup><mo>−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>+</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi>ϵ</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\log^{2}\!\sup_{{\color[rgb]{0,0,0}\theta}}\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}\ \leq\ C\,\big(\|Q({\color[rgb]{0,0,0}\theta}^{\ast}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})\|_{2}^{2}+\|\epsilon\|_{2}^{2}\big)^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmexample1.p4.3" class="ltx_p">and using Gaussian moment bounds</p>
<table id="A6.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex12.m1" class="ltx_Math" alttext="\mathbb{E}\!\left[\log^{2}\!\sup_{{\color[rgb]{0,0,0}\theta}}\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}\right]\ \leq\ \poly(n)\big(1+\|{\color[rgb]{0,0,0}\theta}^{\ast}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\|_{2}^{4}\big)\ =\ \poly(n)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mmultiscripts><munder><mo movablelimits="false">sup</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></munder><mprescripts></mprescripts><mrow></mrow><mn>2</mn></mmultiscripts><mo lspace="0.167em">⁡</mo><mfrac><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><mo rspace="0.500em">]</mo></mrow></mrow><mo rspace="0.778em">≤</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mn>1</mn><mo>+</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∗</mo></msup><mo>−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>4</mn></msubsup></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.500em">)</mo></mrow></mrow><mo rspace="0.778em">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\!\left[\log^{2}\!\sup_{{\color[rgb]{0,0,0}\theta}}\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}\right]\ \leq\ \poly(n)\big(1+\|{\color[rgb]{0,0,0}\theta}^{\ast}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\|_{2}^{4}\big)\ =\ \poly(n).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmexample1.p4.4" class="ltx_p">We finally check the local regularity condition.
For any <math id="A6.Thmexample1.p4.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> and <math id="A6.Thmexample1.p4.m3" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\theta},{\color[rgb]{0,0,0}\theta}^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>,</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\theta},{\color[rgb]{0,0,0}\theta}^{\prime}</annotation></semantics></math>,</p>
<table id="A6.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex13.m1" class="ltx_math_unparsed" alttext="\log\frac{\density_{#1}({\color[rgb]{0,0,0}y}_{t}\mid{\color[rgb]{0,0,0}q}_{1:t},{\color[rgb]{0,0,0}y}_{1:t-1},{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}y}_{t}\mid{\color[rgb]{0,0,0}q}_{1:t},{\color[rgb]{0,0,0}y}_{1:t-1},{\color[rgb]{0,0,0}\theta}^{\prime})}=-\tfrac{1}{2\sigma_{\epsilon}^{2}}\!\big[({\color[rgb]{0,0,0}y}_{t}-{\color[rgb]{0,0,0}\theta}^{\top}{\color[rgb]{0,0,0}q}_{t})^{2}-({\color[rgb]{0,0,0}y}_{t}-{{\color[rgb]{0,0,0}\theta}^{\prime}}^{\top}{\color[rgb]{0,0,0}q}_{t})^{2}\big]." display="block" intent=":literal"><semantics><mrow><mi>log</mi><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi><msub><mrow></mrow><mi>t</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi><msub><mrow></mrow><mi>t</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mfrac><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mstyle displaystyle="false"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>ϵ</mi><mn>2</mn></msubsup></mrow></mfrac></mstyle><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi><mi>t</mi></msub><mo>−</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>⊤</mo></msup><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi><mi>t</mi></msub><mo>−</mo><mmultiscripts><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mrow></mrow><mo>′</mo><mrow></mrow><mo>⊤</mo></mmultiscripts><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\log\frac{\density_{#1}({\color[rgb]{0,0,0}y}_{t}\mid{\color[rgb]{0,0,0}q}_{1:t},{\color[rgb]{0,0,0}y}_{1:t-1},{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}y}_{t}\mid{\color[rgb]{0,0,0}q}_{1:t},{\color[rgb]{0,0,0}y}_{1:t-1},{\color[rgb]{0,0,0}\theta}^{\prime})}=-\tfrac{1}{2\sigma_{\epsilon}^{2}}\!\big[({\color[rgb]{0,0,0}y}_{t}-{\color[rgb]{0,0,0}\theta}^{\top}{\color[rgb]{0,0,0}q}_{t})^{2}-({\color[rgb]{0,0,0}y}_{t}-{{\color[rgb]{0,0,0}\theta}^{\prime}}^{\top}{\color[rgb]{0,0,0}q}_{t})^{2}\big].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmexample1.p4.5" class="ltx_p">Assuming that <math id="A6.Thmexample1.p4.m4" class="ltx_math_unparsed" alttext="\|{\color[rgb]{0,0,0}q}_{1:t}\|_{\infty},|{\color[rgb]{0,0,0}y}_{1:t}|\leq R" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mi mathvariant="normal">∞</mi></msub><mo>,</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">≤</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">\|{\color[rgb]{0,0,0}q}_{1:t}\|_{\infty},|{\color[rgb]{0,0,0}y}_{1:t}|\leq R</annotation></semantics></math> and <math id="A6.Thmexample1.p4.m5" class="ltx_Math" alttext="\|{\color[rgb]{0,0,0}\theta}\|,\|{\color[rgb]{0,0,0}\theta}^{\prime}\|\leq R" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">‖</mo></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">‖</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>′</mo></msup><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mi>R</mi></mrow></mrow><annotation encoding="application/x-tex">\|{\color[rgb]{0,0,0}\theta}\|,\|{\color[rgb]{0,0,0}\theta}^{\prime}\|\leq R</annotation></semantics></math> (with <math id="A6.Thmexample1.p4.m6" class="ltx_Math" alttext="R\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">R\geq 1</annotation></semantics></math>) and using that <math id="A6.Thmexample1.p4.m7" class="ltx_Math" alttext="(a-b)^{2}-(a-c)^{2}=(c-b)(2a-b-c)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>−</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>−</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>−</mo><mi>b</mi><mo>−</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(a-b)^{2}-(a-c)^{2}=(c-b)(2a-b-c)</annotation></semantics></math>, we have</p>
<table id="A6.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex14.m1" class="ltx_math_unparsed" alttext="\Big|\log\frac{\density_{#1}({\color[rgb]{0,0,0}y}_{t}\mid{\color[rgb]{0,0,0}q}_{1:t},{\color[rgb]{0,0,0}y}_{1:t-1},{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}y}_{t}\mid{\color[rgb]{0,0,0}q}_{1:t},{\color[rgb]{0,0,0}y}_{1:t-1},{\color[rgb]{0,0,0}\theta}^{\prime})}\Big|=\tfrac{1}{2\sigma_{\epsilon}^{2}}\,|({\color[rgb]{0,0,0}\theta}-{\color[rgb]{0,0,0}\theta}^{\prime})^{\top}{\color[rgb]{0,0,0}q}_{t}|\,\big|2{\color[rgb]{0,0,0}y}_{t}-({\color[rgb]{0,0,0}\theta}+{\color[rgb]{0,0,0}\theta}^{\prime})^{\top}{\color[rgb]{0,0,0}q}_{t}\big|\ \leq\ \tfrac{1}{\sigma_{\epsilon}^{2}}\,R^{3}\,\|{\color[rgb]{0,0,0}\theta}-{\color[rgb]{0,0,0}\theta}^{\prime}\|," display="block" intent=":literal"><semantics><mrow><mo fence="false" maxsize="1.600em" minsize="1.600em" rspace="0.167em" stretchy="true">|</mo><mi>log</mi><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi><msub><mrow></mrow><mi>t</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi><msub><mrow></mrow><mi>t</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mfrac><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0.167em">=</mo><mstyle displaystyle="false"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>ϵ</mi><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo fence="false" lspace="0.170em" rspace="0.167em" stretchy="false">|</mo><msup><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>−</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><mi>t</mi></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.167em" stretchy="true">|</mo><mn>2</mn><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi><mi>t</mi></msub><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>+</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><mi>t</mi></msub><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.389em" stretchy="true">|</mo><mo rspace="0.778em">≤</mo><mstyle displaystyle="false"><mfrac><mn>1</mn><msubsup><mi>σ</mi><mi>ϵ</mi><mn>2</mn></msubsup></mfrac></mstyle><msup><mi>R</mi><mn>3</mn></msup><mo lspace="0em" rspace="0.167em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>−</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0.167em">∥</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\Big|\log\frac{\density_{#1}({\color[rgb]{0,0,0}y}_{t}\mid{\color[rgb]{0,0,0}q}_{1:t},{\color[rgb]{0,0,0}y}_{1:t-1},{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}y}_{t}\mid{\color[rgb]{0,0,0}q}_{1:t},{\color[rgb]{0,0,0}y}_{1:t-1},{\color[rgb]{0,0,0}\theta}^{\prime})}\Big|=\tfrac{1}{2\sigma_{\epsilon}^{2}}\,|({\color[rgb]{0,0,0}\theta}-{\color[rgb]{0,0,0}\theta}^{\prime})^{\top}{\color[rgb]{0,0,0}q}_{t}|\,\big|2{\color[rgb]{0,0,0}y}_{t}-({\color[rgb]{0,0,0}\theta}+{\color[rgb]{0,0,0}\theta}^{\prime})^{\top}{\color[rgb]{0,0,0}q}_{t}\big|\ \leq\ \tfrac{1}{\sigma_{\epsilon}^{2}}\,R^{3}\,\|{\color[rgb]{0,0,0}\theta}-{\color[rgb]{0,0,0}\theta}^{\prime}\|,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmexample1.p4.6" class="ltx_p">so the condition holds.</p>
</div>
</div>
<div id="A6.Thmexample2" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A6.Thmexample2.2" class="ltx_text ltx_font_bold">Example F.2</span></span><span id="A6.Thmexample2.3" class="ltx_text ltx_font_bold"> </span>(Ornstein–Uhlenbeck process)<span id="A6.Thmexample2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A6.Thmexample2.p1" class="ltx_para">
<p id="A6.Thmexample2.p1.1" class="ltx_p">We consider the Ornstein–Uhlenbeck (OU) process example of <a href="#S3.SS1" title="3.1 In-context learning setting ‣ 3 Theoretical framework ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">3.1</span></a> in the main text and check that it satisfies <a href="#Thmassumption3" title="Assumption 3 (Data generation). ‣ D.3 ICL setting ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumptions</span> <span class="ltx_text ltx_ref_tag">3</span></a> and <a href="#Thmassumption4" title="Assumption 4. ‣ D.5 Laplace Approximation ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>.
For simplicity, we consider the one-dimensional case <math id="A6.Thmexample2.p1.m1" class="ltx_Math" alttext="d=1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d=1</annotation></semantics></math>; the extension to <math id="A6.Thmexample2.p1.m2" class="ltx_Math" alttext="d&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d&gt;1</annotation></semantics></math> with diagonal diffusion is straightforward.
We consider tasks <math id="A6.Thmexample2.p1.m3" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\theta}=(\mu,\tau)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo>,</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\theta}=(\mu,\tau)</annotation></semantics></math> where <math id="A6.Thmexample2.p1.m4" class="ltx_Math" alttext="\mu\in{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathbb{R}}}" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi></mrow><annotation encoding="application/x-tex">\mu\in{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathbb{R}}}</annotation></semantics></math> and <math id="A6.Thmexample2.p1.m5" class="ltx_Math" alttext="\tau\in[\overline{\tau},\underline{\tau}]" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mover accent="true"><mi>τ</mi><mo stretchy="true">¯</mo></mover><mo>,</mo><munder accentunder="true"><mi>τ</mi><mo stretchy="true">¯</mo></munder></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\tau\in[\overline{\tau},\underline{\tau}]</annotation></semantics></math> with <math id="A6.Thmexample2.p1.m6" class="ltx_Math" alttext="0&lt;\overline{\tau}\leq\underline{\tau}&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mover accent="true"><mi>τ</mi><mo stretchy="true">¯</mo></mover><mo>≤</mo><munder accentunder="true"><mi>τ</mi><mo stretchy="true">¯</mo></munder><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">0&lt;\overline{\tau}\leq\underline{\tau}&lt;\infty</annotation></semantics></math>. Given <math id="A6.Thmexample2.p1.m7" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\theta}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\theta}</annotation></semantics></math>, the Ornstein–Uhlenbeck (OU) SDE</p>
<table id="A6.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex15.m1" class="ltx_Math" alttext="\mathrm{d}X_{t}=\tau(\mu-X_{t})\,\mathrm{d}t+\sigma\,\mathrm{d}W_{t}" display="block" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mi>t</mi></msub></mrow><mo>=</mo><mrow><mrow><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>μ</mi><mo>−</mo><msub><mi>X</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mrow><mi>σ</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>t</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{d}X_{t}=\tau(\mu-X_{t})\,\mathrm{d}t+\sigma\,\mathrm{d}W_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmexample2.p1.2" class="ltx_p">is observed at regular times <math id="A6.Thmexample2.p1.m8" class="ltx_Math" alttext="t_{r}=r\,\Delta_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>r</mi></msub><mo>=</mo><mrow><mi>r</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">t_{r}=r\,\Delta_{t}</annotation></semantics></math> (<math id="A6.Thmexample2.p1.m9" class="ltx_Math" alttext="r=1,\dots,n" display="inline" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">r=1,\dots,n</annotation></semantics></math>). We write <math id="A6.Thmexample2.p1.m10" class="ltx_Math" alttext="{\color[rgb]{0,0,0}x}_{r}:=X_{t_{r}}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi>r</mi></msub><mo>:=</mo><msub><mi>X</mi><msub><mi>t</mi><mi>r</mi></msub></msub></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x}_{r}:=X_{t_{r}}</annotation></semantics></math> and <math id="A6.Thmexample2.p1.m11" class="ltx_Math" alttext="{\color[rgb]{0,0,0}X}=\{{\color[rgb]{0,0,0}x}_{r}\}_{r=1}^{n}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi>r</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}X}=\{{\color[rgb]{0,0,0}x}_{r}\}_{r=1}^{n}</annotation></semantics></math>. The Markov transition is Gaussian with mean</p>
<table id="A6.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex16.m1" class="ltx_Math" alttext="m_{\color[rgb]{0,0,0}\theta}(x):=\mu+e^{-\tau\Delta_{t}}(x-\mu)=e^{-\tau\Delta_{t}}x+\bigl(1-e^{-\tau\Delta_{t}}\bigr)\mu" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>m</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mi>μ</mi><mo>+</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></mrow></mrow></msup></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">m_{\color[rgb]{0,0,0}\theta}(x):=\mu+e^{-\tau\Delta_{t}}(x-\mu)=e^{-\tau\Delta_{t}}x+\bigl(1-e^{-\tau\Delta_{t}}\bigr)\mu</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmexample2.p1.3" class="ltx_p">and variance <math id="A6.Thmexample2.p1.m12" class="ltx_Math" alttext="v_{\color[rgb]{0,0,0}\theta}:=\mathrm{Var}({\color[rgb]{0,0,0}x}_{r}\mid{\color[rgb]{0,0,0}x}_{r-1},{\color[rgb]{0,0,0}\theta})=\sigma^{2}\,\frac{1-e^{-2\tau\Delta_{t}}}{2\tau}\,." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>v</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub><mo>:=</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi>r</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></mrow></mrow></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow></mfrac></mrow></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">v_{\color[rgb]{0,0,0}\theta}:=\mathrm{Var}({\color[rgb]{0,0,0}x}_{r}\mid{\color[rgb]{0,0,0}x}_{r-1},{\color[rgb]{0,0,0}\theta})=\sigma^{2}\,\frac{1-e^{-2\tau\Delta_{t}}}{2\tau}\,.</annotation></semantics></math> For any path <math id="A6.Thmexample2.p1.m13" class="ltx_math_unparsed" alttext="{\color[rgb]{0,0,0}x}_{1:n}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x}_{1:n}</annotation></semantics></math>, define <math id="A6.Thmexample2.p1.m14" class="ltx_Math" alttext="\ell_{n}({\color[rgb]{0,0,0}\theta}):=\log\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi mathvariant="normal">ℓ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\ell_{n}({\color[rgb]{0,0,0}\theta}):=\log\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta}).</annotation></semantics></math></p>
</div>
<div id="A6.Thmexample2.p2" class="ltx_para">
<p id="A6.Thmexample2.p2.1" class="ltx_p">Recall <math id="A6.Thmexample2.p2.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\theta}=(\mu,\tau)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo>,</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\theta}=(\mu,\tau)</annotation></semantics></math> with <math id="A6.Thmexample2.p2.m2" class="ltx_Math" alttext="\tau\in[\overline{\tau},\underline{\tau}]" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mover accent="true"><mi>τ</mi><mo stretchy="true">¯</mo></mover><mo>,</mo><munder accentunder="true"><mi>τ</mi><mo stretchy="true">¯</mo></munder></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\tau\in[\overline{\tau},\underline{\tau}]</annotation></semantics></math>, discretization step <math id="A6.Thmexample2.p2.m3" class="ltx_Math" alttext="\Delta_{t}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\Delta_{t}</annotation></semantics></math>, and</p>
<table id="A6.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex17.m1" class="ltx_Math" alttext="m_{\color[rgb]{0,0,0}\theta}(x)=\mu+\rho_{\tau}(x-\mu)=\rho_{\tau}x+(1-\rho_{\tau})\mu,\qquad v_{\color[rgb]{0,0,0}\theta}=\sigma^{2}\frac{1-\rho_{\tau}^{2}}{2\tau},\qquad\rho_{\tau}:=e^{-\tau\Delta_{t}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>m</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>μ</mi><mo>+</mo><mrow><msub><mi>ρ</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>ρ</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ρ</mi><mi>τ</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>v</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub><mo>=</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mn>1</mn><mo>−</mo><msubsup><mi>ρ</mi><mi>τ</mi><mn>2</mn></msubsup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow></mfrac></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>ρ</mi><mi>τ</mi></msub><mo>:=</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></mrow></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">m_{\color[rgb]{0,0,0}\theta}(x)=\mu+\rho_{\tau}(x-\mu)=\rho_{\tau}x+(1-\rho_{\tau})\mu,\qquad v_{\color[rgb]{0,0,0}\theta}=\sigma^{2}\frac{1-\rho_{\tau}^{2}}{2\tau},\qquad\rho_{\tau}:=e^{-\tau\Delta_{t}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmexample2.p2.2" class="ltx_p">Fix a reference <math id="A6.Thmexample2.p2.m4" class="ltx_Math" alttext="{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}=(\mu_{0},\tau_{0})" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>μ</mi><mn>0</mn></msub><mo>,</mo><msub><mi>τ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}=(\mu_{0},\tau_{0})</annotation></semantics></math>, write <math id="A6.Thmexample2.p2.m5" class="ltx_Math" alttext="m_{0}:=m_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mn>0</mn></msub><mo>:=</mo><msub><mi>m</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub></msub></mrow><annotation encoding="application/x-tex">m_{0}:=m_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}}</annotation></semantics></math>, <math id="A6.Thmexample2.p2.m6" class="ltx_Math" alttext="v_{0}:=v_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mn>0</mn></msub><mo>:=</mo><msub><mi>v</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub></msub></mrow><annotation encoding="application/x-tex">v_{0}:=v_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}}</annotation></semantics></math>, and let <math id="A6.Thmexample2.p2.m7" class="ltx_Math" alttext="{\color[rgb]{0,0,0}X}=({\color[rgb]{0,0,0}x}_{1},\ldots,{\color[rgb]{0,0,0}x}_{n})" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}X}=({\color[rgb]{0,0,0}x}_{1},\ldots,{\color[rgb]{0,0,0}x}_{n})</annotation></semantics></math> with <math id="A6.Thmexample2.p2.m8" class="ltx_Math" alttext="{\color[rgb]{0,0,0}x}_{r}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi>r</mi></msub><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x}_{r}</annotation></semantics></math> the OU samples at times <math id="A6.Thmexample2.p2.m9" class="ltx_Math" alttext="r\Delta_{t}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">r\Delta_{t}</annotation></semantics></math>.
The one–step densities are Gaussian, hence</p>
<table id="A6.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.E18.m1" class="ltx_Math" alttext="\log\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}=\sum_{r=1}^{n}\Bigg\{-\frac{1}{2}\log\frac{v_{\color[rgb]{0,0,0}\theta}}{v_{0}}-\frac{\big({\color[rgb]{0,0,0}x}_{r}-m_{\color[rgb]{0,0,0}\theta}({\color[rgb]{0,0,0}x}_{r-1})\big)^{2}}{2v_{\color[rgb]{0,0,0}\theta}}+\frac{\big({\color[rgb]{0,0,0}x}_{r}-m_{0}({\color[rgb]{0,0,0}x}_{r-1})\big)^{2}}{2v_{0}}\Bigg\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mo stretchy="false">{</mo><mrow><mrow><mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><msub><mi>v</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub><msub><mi>v</mi><mn>0</mn></msub></mfrac></mrow></mrow></mrow><mo>−</mo><mfrac><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi>r</mi></msub><mo>−</mo><mrow><msub><mi>m</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub></mrow></mfrac></mrow><mo>+</mo><mfrac><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi>r</mi></msub><mo>−</mo><mrow><msub><mi>m</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mn>0</mn></msub></mrow></mfrac></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\log\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}=\sum_{r=1}^{n}\Bigg\{-\frac{1}{2}\log\frac{v_{\color[rgb]{0,0,0}\theta}}{v_{0}}-\frac{\big({\color[rgb]{0,0,0}x}_{r}-m_{\color[rgb]{0,0,0}\theta}({\color[rgb]{0,0,0}x}_{r-1})\big)^{2}}{2v_{\color[rgb]{0,0,0}\theta}}+\frac{\big({\color[rgb]{0,0,0}x}_{r}-m_{0}({\color[rgb]{0,0,0}x}_{r-1})\big)^{2}}{2v_{0}}\Bigg\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(F.18)</span></td></tr></tbody>
</table>
</div>
<div id="A6.Thmexample2.p3" class="ltx_para">
<p id="A6.Thmexample2.p3.1" class="ltx_p">Let us begin with the tail behavior.
Each one-step innovation <math id="A6.Thmexample2.p3.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}x}_{r}-m_{\color[rgb]{0,0,0}\theta}({\color[rgb]{0,0,0}x}_{r-1})" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi>r</mi></msub><mo>−</mo><mrow><msub><mi>m</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x}_{r}-m_{\color[rgb]{0,0,0}\theta}({\color[rgb]{0,0,0}x}_{r-1})</annotation></semantics></math> is Gaussian with variance <math id="A6.Thmexample2.p3.m2" class="ltx_Math" alttext="v_{\color[rgb]{0,0,0}\theta}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub><annotation encoding="application/x-tex">v_{\color[rgb]{0,0,0}\theta}</annotation></semantics></math> and</p>
<table id="A6.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex18.m1" class="ltx_Math" alttext="0&lt;v_{\min}\ \leq\ v_{\color[rgb]{0,0,0}\theta}\ \leq\ v_{\max}&lt;\infty,\quad v_{\min}:=\sigma^{2}\frac{1-e^{-2\underline{\tau}\Delta_{t}}}{2\underline{\tau}},\;v_{\max}:=\sigma^{2}\frac{1-e^{-2\overline{\tau}\Delta_{t}}}{2\overline{\tau}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mn>0</mn><mo>&lt;</mo><msub><mi>v</mi><mi>min</mi></msub><mo rspace="0.778em">≤</mo><msub><mi>v</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub><mo rspace="0.778em">≤</mo><msub><mi>v</mi><mi>max</mi></msub><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>v</mi><mi>min</mi></msub><mo>:=</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>τ</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></mrow></mrow></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>τ</mi><mo stretchy="true">¯</mo></munder></mrow></mfrac></mrow></mrow><mo rspace="0.447em">,</mo><mrow><msub><mi>v</mi><mi>max</mi></msub><mo>:=</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>τ</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></mrow></mrow></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>τ</mi><mo stretchy="true">¯</mo></mover></mrow></mfrac></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">0&lt;v_{\min}\ \leq\ v_{\color[rgb]{0,0,0}\theta}\ \leq\ v_{\max}&lt;\infty,\quad v_{\min}:=\sigma^{2}\frac{1-e^{-2\underline{\tau}\Delta_{t}}}{2\underline{\tau}},\;v_{\max}:=\sigma^{2}\frac{1-e^{-2\overline{\tau}\Delta_{t}}}{2\overline{\tau}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmexample2.p3.2" class="ltx_p">Moreover, if <math id="A6.Thmexample2.p3.m3" class="ltx_Math" alttext="{\color[rgb]{0,0,0}x}_{r-1}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x}_{r-1}</annotation></semantics></math> satisfies <math id="A6.Thmexample2.p3.m4" class="ltx_Math" alttext="|{\color[rgb]{0,0,0}x}_{r-1}|\leq R" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">|{\color[rgb]{0,0,0}x}_{r-1}|\leq R</annotation></semantics></math>, then <math id="A6.Thmexample2.p3.m5" class="ltx_Math" alttext="m_{\color[rgb]{0,0,0}\theta}({\color[rgb]{0,0,0}x}_{r-1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">m_{\color[rgb]{0,0,0}\theta}({\color[rgb]{0,0,0}x}_{r-1})</annotation></semantics></math> also satisfies <math id="A6.Thmexample2.p3.m6" class="ltx_Math" alttext="|m_{\color[rgb]{0,0,0}\theta}({\color[rgb]{0,0,0}x}_{r-1})|\leq\rho_{\underline{\tau}}R+(1-\rho_{\underline{\tau}})|\mu|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>m</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mrow><msub><mi>ρ</mi><munder accentunder="true"><mi>τ</mi><mo stretchy="true">¯</mo></munder></msub><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>ρ</mi><munder accentunder="true"><mi>τ</mi><mo stretchy="true">¯</mo></munder></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>μ</mi><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">|m_{\color[rgb]{0,0,0}\theta}({\color[rgb]{0,0,0}x}_{r-1})|\leq\rho_{\underline{\tau}}R+(1-\rho_{\underline{\tau}})|\mu|</annotation></semantics></math>.
Hence, there exists <math id="A6.Thmexample2.p3.m7" class="ltx_Math" alttext="c&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c&gt;0</annotation></semantics></math> depending only on <math id="A6.Thmexample2.p3.m8" class="ltx_Math" alttext="(\Delta_{t},\overline{\tau},\underline{\tau},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo>,</mo><mover accent="true"><mi>τ</mi><mo stretchy="true">¯</mo></mover><mo>,</mo><munder accentunder="true"><mi>τ</mi><mo stretchy="true">¯</mo></munder><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Delta_{t},\overline{\tau},\underline{\tau},\sigma)</annotation></semantics></math> and the law of <math id="A6.Thmexample2.p3.m9" class="ltx_Math" alttext="{\color[rgb]{0,0,0}x}_{0}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x}_{0}</annotation></semantics></math> such that, for all <math id="A6.Thmexample2.p3.m10" class="ltx_Math" alttext="R\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">R\geq 1</annotation></semantics></math>,</p>
<table id="A6.EGx81" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.E19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E19.m1" class="ltx_math_unparsed" alttext="\displaystyle\prob\!\Big(\exists r\leq n\,,|{\color[rgb]{0,0,0}x}_{r}|\geq R\Big)" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:0.441em;" width="0.441em"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℙ</mi></mpadded><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mo rspace="0.167em">∃</mo><mi>r</mi><mo>≤</mo><mi>n</mi><mo lspace="0.170em">,</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi>r</mi></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">≥</mo><mi>R</mi><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\prob\!\Big(\exists r\leq n\,,|{\color[rgb]{0,0,0}x}_{r}|\geq R\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(F.19)</span></td></tr></tbody>
<tbody id="A6.E20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E20.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\ \prob\!\Big(\exists r\leq n\,,|{\color[rgb]{0,0,0}x}_{r}-m_{\color[rgb]{0,0,0}\theta}({\color[rgb]{0,0,0}x}_{r-1})|\geq(1-\rho_{\underline{\tau}})R-|\mu|\Big)" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.778em">≤</mo><mpadded style="width:0.441em;" width="0.441em"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℙ</mi></mpadded><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mo rspace="0.167em">∃</mo><mi>r</mi><mo>≤</mo><mi>n</mi><mo lspace="0.170em">,</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi>r</mi></msub><mo>−</mo><msub><mi>m</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">≥</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><msub><mi>ρ</mi><munder accentunder="true"><mi>τ</mi><mo stretchy="true">¯</mo></munder></msub><mo stretchy="false">)</mo></mrow><mi>R</mi><mo rspace="0em">−</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>μ</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\ \prob\!\Big(\exists r\leq n\,,|{\color[rgb]{0,0,0}x}_{r}-m_{\color[rgb]{0,0,0}\theta}({\color[rgb]{0,0,0}x}_{r-1})|\geq(1-\rho_{\underline{\tau}})R-|\mu|\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(F.20)</span></td></tr></tbody>
<tbody id="A6.E21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E21.m1" class="ltx_Math" alttext="\displaystyle\leq\ \poly(n)\,e^{-cR^{2}}\ \leq\ \poly(n)\,e^{-R}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo rspace="0.778em">≤</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><msup><mi>cR</mi><mn>2</mn></msup></mrow></msup></mrow><mo rspace="0.778em">≤</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>R</mi></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\ \poly(n)\,e^{-cR^{2}}\ \leq\ \poly(n)\,e^{-R},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(F.21)</span></td></tr></tbody>
</table>
<p id="A6.Thmexample2.p3.3" class="ltx_p">for <math id="A6.Thmexample2.p3.m11" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> large enough compared to <math id="A6.Thmexample2.p3.m12" class="ltx_Math" alttext="|\mu|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi>μ</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mu|</annotation></semantics></math>.</p>
</div>
<div id="A6.Thmexample2.p4" class="ltx_para">
<p id="A6.Thmexample2.p4.1" class="ltx_p">Let us continue with the tail condition on the likelihood.
We have the bound</p>
<table id="A6.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.E22.m1" class="ltx_math_unparsed" alttext="\Big|\sum_{r=1}^{n}\!-\tfrac{1}{2}\log\tfrac{v_{\color[rgb]{0,0,0}\theta}}{v_{0}}\Big|\leq\tfrac{n}{2}\,\log\!\frac{v_{\max}}{v_{\min}}=:C_{\mathrm{var}}\,n." display="block" intent=":literal"><semantics><mrow><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo movablelimits="false" rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>n</mi></msup><mo lspace="0em">−</mo><mstyle displaystyle="false"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mi>log</mi><mstyle displaystyle="false"><mfrac><msub><mi>v</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub><msub><mi>v</mi><mn>0</mn></msub></mfrac></mstyle><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0.167em">≤</mo><mstyle displaystyle="false"><mfrac><mi>n</mi><mn>2</mn></mfrac></mstyle><mi>log</mi><mfrac><msub><mi>v</mi><mi>max</mi></msub><msub><mi>v</mi><mi>min</mi></msub></mfrac><mo rspace="0em">=</mo><mo rspace="0.278em">:</mo><mi>C</mi><msub><mrow></mrow><mi>var</mi></msub><mi>n</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Big|\sum_{r=1}^{n}\!-\tfrac{1}{2}\log\tfrac{v_{\color[rgb]{0,0,0}\theta}}{v_{0}}\Big|\leq\tfrac{n}{2}\,\log\!\frac{v_{\max}}{v_{\min}}=:C_{\mathrm{var}}\,n.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(F.22)</span></td></tr></tbody>
</table>
</div>
<div id="A6.Thmexample2.p5" class="ltx_para">
<p id="A6.Thmexample2.p5.1" class="ltx_p">For each <math id="A6.Thmexample2.p5.m1" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>, abbreviate <math id="A6.Thmexample2.p5.m2" class="ltx_Math" alttext="m:=m_{\color[rgb]{0,0,0}\theta}({\color[rgb]{0,0,0}x}_{r-1})" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>:=</mo><mrow><msub><mi>m</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">m:=m_{\color[rgb]{0,0,0}\theta}({\color[rgb]{0,0,0}x}_{r-1})</annotation></semantics></math> and <math id="A6.Thmexample2.p5.m3" class="ltx_Math" alttext="m_{0}:=m_{0}({\color[rgb]{0,0,0}x}_{r-1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mn>0</mn></msub><mo>:=</mo><mrow><msub><mi>m</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">m_{0}:=m_{0}({\color[rgb]{0,0,0}x}_{r-1})</annotation></semantics></math>. Using <math id="A6.Thmexample2.p5.m4" class="ltx_Math" alttext="v_{\color[rgb]{0,0,0}\theta}\geq v_{\min}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub><mo>≥</mo><msub><mi>v</mi><mi>min</mi></msub></mrow><annotation encoding="application/x-tex">v_{\color[rgb]{0,0,0}\theta}\geq v_{\min}</annotation></semantics></math> and <math id="A6.Thmexample2.p5.m5" class="ltx_Math" alttext="v_{0}\geq v_{\min}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mn>0</mn></msub><mo>≥</mo><msub><mi>v</mi><mi>min</mi></msub></mrow><annotation encoding="application/x-tex">v_{0}\geq v_{\min}</annotation></semantics></math>,</p>
<table id="A6.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex19.m1" class="ltx_Math" alttext="-\frac{({\color[rgb]{0,0,0}x}_{r}-m)^{2}}{2v_{\color[rgb]{0,0,0}\theta}}+\frac{({\color[rgb]{0,0,0}x}_{r}-m_{0})^{2}}{2v_{0}}\leq\frac{1}{2v_{\min}}\Big(({\color[rgb]{0,0,0}x}_{r}-m_{0})^{2}-({\color[rgb]{0,0,0}x}_{r}-m)^{2}\Big)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>−</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi>r</mi></msub><mo>−</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub></mrow></mfrac></mrow><mo>+</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi>r</mi></msub><mo>−</mo><msub><mi>m</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mn>0</mn></msub></mrow></mfrac></mrow><mo>≤</mo><mrow><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>min</mi></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi>r</mi></msub><mo>−</mo><msub><mi>m</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi>r</mi></msub><mo>−</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">-\frac{({\color[rgb]{0,0,0}x}_{r}-m)^{2}}{2v_{\color[rgb]{0,0,0}\theta}}+\frac{({\color[rgb]{0,0,0}x}_{r}-m_{0})^{2}}{2v_{0}}\leq\frac{1}{2v_{\min}}\Big(({\color[rgb]{0,0,0}x}_{r}-m_{0})^{2}-({\color[rgb]{0,0,0}x}_{r}-m)^{2}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmexample2.p5.2" class="ltx_p">Expanding the square,</p>
<table id="A6.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex20.m1" class="ltx_Math" alttext="({\color[rgb]{0,0,0}x}_{r}-m_{0})^{2}-({\color[rgb]{0,0,0}x}_{r}-m)^{2}=-\big(m-m_{0}\big)^{2}+2\,({\color[rgb]{0,0,0}x}_{r}-m_{0})\,\big(m-m_{0}\big)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi>r</mi></msub><mo>−</mo><msub><mi>m</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi>r</mi></msub><mo>−</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>=</mo><mrow><mrow><mo>−</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>m</mi><mo>−</mo><msub><mi>m</mi><mn>0</mn></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi>r</mi></msub><mo>−</mo><msub><mi>m</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>m</mi><mo>−</mo><msub><mi>m</mi><mn>0</mn></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">({\color[rgb]{0,0,0}x}_{r}-m_{0})^{2}-({\color[rgb]{0,0,0}x}_{r}-m)^{2}=-\big(m-m_{0}\big)^{2}+2\,({\color[rgb]{0,0,0}x}_{r}-m_{0})\,\big(m-m_{0}\big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmexample2.p5.3" class="ltx_p">Summing over <math id="A6.Thmexample2.p5.m6" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> and applying Cauchy–Schwarz,</p>
<table id="A6.E23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.E23.m1" class="ltx_math_unparsed" alttext="\sum_{r=1}^{n}\!\left(-\frac{({\color[rgb]{0,0,0}x}_{r}-m)^{2}}{2v_{\color[rgb]{0,0,0}\theta}}+\frac{({\color[rgb]{0,0,0}x}_{r}-m_{0})^{2}}{2v_{0}}\right)\leq-\frac{1}{2v_{\min}}\sum_{r=1}^{n}\Delta_{r}^{2}\;+\;\frac{1}{v_{\min}}\Big(\sum_{r=1}^{n}({\color[rgb]{0,0,0}x}_{r}-m_{0})^{2}\Big)^{\!1/2}\Big(\sum_{r=1}^{n}\Delta_{r}^{2}\Big)^{\!1/2}," display="block" intent=":literal"><semantics><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mo>(</mo><mo lspace="0em">−</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi>r</mi></msub><mo>−</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub></mrow></mfrac><mo>+</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi>r</mi></msub><mo>−</mo><msub><mi>m</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mn>0</mn></msub></mrow></mfrac><mo>)</mo></mrow><mo rspace="0em">≤</mo><mo lspace="0em">−</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>min</mi></msub></mrow></mfrac><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><msubsup><mi mathvariant="normal">Δ</mi><mi>r</mi><mn>2</mn></msubsup><mo rspace="0.502em">+</mo><mfrac><mn>1</mn><msub><mi>v</mi><mi>min</mi></msub></mfrac><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><munderover><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><msup><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi>r</mi></msub><mo>−</mo><msub><mi>m</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><msubsup><mi mathvariant="normal">Δ</mi><mi>r</mi><mn>2</mn></msubsup><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\sum_{r=1}^{n}\!\left(-\frac{({\color[rgb]{0,0,0}x}_{r}-m)^{2}}{2v_{\color[rgb]{0,0,0}\theta}}+\frac{({\color[rgb]{0,0,0}x}_{r}-m_{0})^{2}}{2v_{0}}\right)\leq-\frac{1}{2v_{\min}}\sum_{r=1}^{n}\Delta_{r}^{2}\;+\;\frac{1}{v_{\min}}\Big(\sum_{r=1}^{n}({\color[rgb]{0,0,0}x}_{r}-m_{0})^{2}\Big)^{\!1/2}\Big(\sum_{r=1}^{n}\Delta_{r}^{2}\Big)^{\!1/2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(F.23)</span></td></tr></tbody>
</table>
<p id="A6.Thmexample2.p5.4" class="ltx_p">where <math id="A6.Thmexample2.p5.m7" class="ltx_Math" alttext="\delta_{r}:=m_{\color[rgb]{0,0,0}\theta}({\color[rgb]{0,0,0}x}_{r-1})-m_{0}({\color[rgb]{0,0,0}x}_{r-1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>δ</mi><mi>r</mi></msub><mo>:=</mo><mrow><mrow><msub><mi>m</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>m</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta_{r}:=m_{\color[rgb]{0,0,0}\theta}({\color[rgb]{0,0,0}x}_{r-1})-m_{0}({\color[rgb]{0,0,0}x}_{r-1})</annotation></semantics></math>.</p>
</div>
<div id="A6.Thmexample2.p6" class="ltx_para">
<p id="A6.Thmexample2.p6.1" class="ltx_p">On events where <math id="A6.Thmexample2.p6.m1" class="ltx_math_unparsed" alttext="|{\color[rgb]{0,0,0}x}_{1:n}|\leq R" display="inline" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">≤</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">|{\color[rgb]{0,0,0}x}_{1:n}|\leq R</annotation></semantics></math>, we have the
conditions</p>
<table id="A6.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex21.m1" class="ltx_Math" alttext="c\lVert\mu-\mu_{0}\rVert-C(1+R)|\delta_{r}|\leq L(1+R)\,\|{\color[rgb]{0,0,0}\theta}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\|," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>c</mi><mo lspace="0em">⁡</mo><mrow><mo fence="true" rspace="0em">∥</mo><mrow><mi>μ</mi><mo>−</mo><msub><mi>μ</mi><mn>0</mn></msub></mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow></mrow><mo>−</mo><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>δ</mi><mi>r</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">c\lVert\mu-\mu_{0}\rVert-C(1+R)|\delta_{r}|\leq L(1+R)\,\|{\color[rgb]{0,0,0}\theta}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\|,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmexample2.p6.2" class="ltx_p">for constants <math id="A6.Thmexample2.p6.m2" class="ltx_Math" alttext="c,C,L" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>,</mo><mi>C</mi><mo>,</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">c,C,L</annotation></semantics></math> depending only on <math id="A6.Thmexample2.p6.m3" class="ltx_Math" alttext="(\overline{\tau},\underline{\tau},\Delta_{t})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>τ</mi><mo stretchy="true">¯</mo></mover><mo>,</mo><munder accentunder="true"><mi>τ</mi><mo stretchy="true">¯</mo></munder><mo>,</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\overline{\tau},\underline{\tau},\Delta_{t})</annotation></semantics></math>. Therefore, for <math id="A6.Thmexample2.p6.m4" class="ltx_Math" alttext="\lVert\mu-\mu_{0}\rVert" display="inline" intent=":literal"><semantics><mrow><mo fence="true" rspace="0em">∥</mo><mrow><mi>μ</mi><mo>−</mo><msub><mi>μ</mi><mn>0</mn></msub></mrow><mo fence="true" lspace="0em">∥</mo></mrow><annotation encoding="application/x-tex">\lVert\mu-\mu_{0}\rVert</annotation></semantics></math> larger than a constant multiple of <math id="A6.Thmexample2.p6.m5" class="ltx_Math" alttext="(1+R)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1+R)</annotation></semantics></math>, we have</p>
<table id="A6.E24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.E24.m1" class="ltx_Math" alttext="\sum_{r=1}^{n}\delta_{r}^{2}\;\geq\;n\,c\,\|\mu-\mu_{0}\|^{2}\quad\text{and}\quad\Big(\sum_{r=1}^{n}\delta_{r}^{2}\Big)^{\!1/2}\;\leq\;\sqrt{n}\,C(1+R)\,\|{\color[rgb]{0,0,0}\theta}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\|," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><msubsup><mi>δ</mi><mi>r</mi><mn>2</mn></msubsup></mrow><mo rspace="0.558em">≥</mo><mrow><mi>n</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>c</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mi>μ</mi><mo>−</mo><msub><mi>μ</mi><mn>0</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><msubsup><mi>δ</mi><mi>r</mi><mn>2</mn></msubsup></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo rspace="0.558em">≤</mo><mrow><msqrt><mi>n</mi></msqrt><mo lspace="0.170em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\sum_{r=1}^{n}\delta_{r}^{2}\;\geq\;n\,c\,\|\mu-\mu_{0}\|^{2}\quad\text{and}\quad\Big(\sum_{r=1}^{n}\delta_{r}^{2}\Big)^{\!1/2}\;\leq\;\sqrt{n}\,C(1+R)\,\|{\color[rgb]{0,0,0}\theta}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\|,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(F.24)</span></td></tr></tbody>
</table>
<p id="A6.Thmexample2.p6.3" class="ltx_p">for constants <math id="A6.Thmexample2.p6.m6" class="ltx_Math" alttext="c,C" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>,</mo><mi>C</mi></mrow><annotation encoding="application/x-tex">c,C</annotation></semantics></math> depending only on <math id="A6.Thmexample2.p6.m7" class="ltx_Math" alttext="(\overline{\tau},\underline{\tau},\Delta_{t})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>τ</mi><mo stretchy="true">¯</mo></mover><mo>,</mo><munder accentunder="true"><mi>τ</mi><mo stretchy="true">¯</mo></munder><mo>,</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\overline{\tau},\underline{\tau},\Delta_{t})</annotation></semantics></math>.</p>
</div>
<div id="A6.Thmexample2.p7" class="ltx_para">
<p id="A6.Thmexample2.p7.1" class="ltx_p">Combining (<a href="#A6.E22" title="Equation F.22 ‣ Example F.2 (Ornstein–Uhlenbeck process). ‣ F.2 Examples for task selection assumptions ‣ Appendix F Additional details on examples ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.22</span></a>), (<a href="#A6.E23" title="Equation F.23 ‣ Example F.2 (Ornstein–Uhlenbeck process). ‣ F.2 Examples for task selection assumptions ‣ Appendix F Additional details on examples ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.23</span></a>), and (<a href="#A6.E24" title="Equation F.24 ‣ Example F.2 (Ornstein–Uhlenbeck process). ‣ F.2 Examples for task selection assumptions ‣ Appendix F Additional details on examples ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.24</span></a>),</p>
<table id="A6.E25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.E25.m1" class="ltx_Math" alttext="\log\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}\;\leq\;Cn-{cn}\|\mu-\mu_{0}\|^{2}+\,\Big(\sum_{r=1}^{n}({\color[rgb]{0,0,0}x}_{r}-m_{0}({\color[rgb]{0,0,0}x}_{r-1}))^{2}\Big)^{\!1/2}{\sqrt{n}C(1+R)}\,\|{\color[rgb]{0,0,0}\theta}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\|,," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo lspace="0.558em" rspace="0.558em">≤</mo><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mi>μ</mi><mo>−</mo><msub><mi>μ</mi><mn>0</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo rspace="0.392em">+</mo><mrow><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><munderover><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi>r</mi></msub><mo>−</mo><mrow><msub><mi>m</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>n</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow></mrow><mo>,</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\log\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}\;\leq\;Cn-{cn}\|\mu-\mu_{0}\|^{2}+\,\Big(\sum_{r=1}^{n}({\color[rgb]{0,0,0}x}_{r}-m_{0}({\color[rgb]{0,0,0}x}_{r-1}))^{2}\Big)^{\!1/2}{\sqrt{n}C(1+R)}\,\|{\color[rgb]{0,0,0}\theta}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\|,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(F.25)</span></td></tr></tbody>
</table>
<p id="A6.Thmexample2.p7.2" class="ltx_p">for constants <math id="A6.Thmexample2.p7.m1" class="ltx_Math" alttext="c,C" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>,</mo><mi>C</mi></mrow><annotation encoding="application/x-tex">c,C</annotation></semantics></math> depending only on <math id="A6.Thmexample2.p7.m2" class="ltx_Math" alttext="(\overline{\tau},\underline{\tau},\Delta_{t})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>τ</mi><mo stretchy="true">¯</mo></mover><mo>,</mo><munder accentunder="true"><mi>τ</mi><mo stretchy="true">¯</mo></munder><mo>,</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\overline{\tau},\underline{\tau},\Delta_{t})</annotation></semantics></math>.</p>
</div>
<div id="A6.Thmexample2.p8" class="ltx_para">
<p id="A6.Thmexample2.p8.1" class="ltx_p">Fix <math id="A6.Thmexample2.p8.m1" class="ltx_Math" alttext="R\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">R\geq 1</annotation></semantics></math> and assume that <math id="A6.Thmexample2.p8.m2" class="ltx_math_unparsed" alttext="|{\color[rgb]{0,0,0}x}_{1:n}|\leq R" display="inline" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">≤</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">|{\color[rgb]{0,0,0}x}_{1:n}|\leq R</annotation></semantics></math>: we have shown that it holds with probability at least <math id="A6.Thmexample2.p8.m3" class="ltx_Math" alttext="1-\poly(n)e^{-cR^{2}}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><msup><mi>cR</mi><mn>2</mn></msup></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">1-\poly(n)e^{-cR^{2}}</annotation></semantics></math>.</p>
</div>
<div id="A6.Thmexample2.p9" class="ltx_para">
<p id="A6.Thmexample2.p9.1" class="ltx_p">In that case,
<math id="A6.Thmexample2.p9.m1" class="ltx_Math" alttext="\Big(\sum_{r=1}^{n}({\color[rgb]{0,0,0}x}_{r}-m_{0}({\color[rgb]{0,0,0}x}_{r-1}))^{2}\Big)^{\!1/2}" display="inline" intent=":literal"><semantics><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msubsup><mo lspace="0em" rspace="0em">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi>r</mi></msub><mo>−</mo><mrow><msub><mi>m</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><annotation encoding="application/x-tex">\Big(\sum_{r=1}^{n}({\color[rgb]{0,0,0}x}_{r}-m_{0}({\color[rgb]{0,0,0}x}_{r-1}))^{2}\Big)^{\!1/2}</annotation></semantics></math> in
<a href="#A6.E25" title="In Example F.2 (Ornstein–Uhlenbeck process). ‣ F.2 Examples for task selection assumptions ‣ Appendix F Additional details on examples ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">F.25</span></a>
is bounded <math id="A6.Thmexample2.p9.m2" class="ltx_Math" alttext="\bigoh\left(\sqrt{n}R\right)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msqrt><mi>n</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\bigoh\left(\sqrt{n}R\right)</annotation></semantics></math> so the RHS can be made negative for all sufficiently large <math id="A6.Thmexample2.p9.m3" class="ltx_Math" alttext="\|{\color[rgb]{0,0,0}\theta}\|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">‖</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">‖</mo></mrow><annotation encoding="application/x-tex">\|{\color[rgb]{0,0,0}\theta}\|</annotation></semantics></math>: more precisely, it is negative for <math id="A6.Thmexample2.p9.m4" class="ltx_Math" alttext="\lVert{\color[rgb]{0,0,0}\theta}\rVert\geq R^{\prime}" display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="0em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo fence="true" lspace="0em" rspace="0.1389em">∥</mo></mrow><mo lspace="0.1389em">≥</mo><msup><mi>R</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">\lVert{\color[rgb]{0,0,0}\theta}\rVert\geq R^{\prime}</annotation></semantics></math> with <math id="A6.Thmexample2.p9.m5" class="ltx_Math" alttext="R^{\prime}\geq C(1+R)^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mo>′</mo></msup><mo>≥</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">R^{\prime}\geq C(1+R)^{2}</annotation></semantics></math> for a constant <math id="A6.Thmexample2.p9.m6" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> depending only on <math id="A6.Thmexample2.p9.m7" class="ltx_Math" alttext="(\overline{\tau},\underline{\tau},\Delta_{t})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>τ</mi><mo stretchy="true">¯</mo></mover><mo>,</mo><munder accentunder="true"><mi>τ</mi><mo stretchy="true">¯</mo></munder><mo>,</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\overline{\tau},\underline{\tau},\Delta_{t})</annotation></semantics></math>.
Since the event we are considering holds with probability at least <math id="A6.Thmexample2.p9.m8" class="ltx_Math" alttext="1-\poly(n)e^{-cR^{2}}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><msup><mi>cR</mi><mn>2</mn></msup></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">1-\poly(n)e^{-cR^{2}}</annotation></semantics></math>, it means that it holds with probability at least <math id="A6.Thmexample2.p9.m9" class="ltx_Math" alttext="1-\poly(n)e^{-R^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><msup><mi>R</mi><mo>′</mo></msup></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">1-\poly(n)e^{-R^{\prime}}</annotation></semantics></math>.
This proves the required tail bound with <math id="A6.Thmexample2.p9.m10" class="ltx_Math" alttext="R\leftarrow R^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo stretchy="false">←</mo><msup><mi>R</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">R\leftarrow R^{\prime}</annotation></semantics></math>.</p>
</div>
<div id="A6.Thmexample2.p10" class="ltx_para">
<p id="A6.Thmexample2.p10.1" class="ltx_p">Moving to the moment condition, by Gaussian moment bounds, <a href="#A6.E18" title="In Example F.2 (Ornstein–Uhlenbeck process). ‣ F.2 Examples for task selection assumptions ‣ Appendix F Additional details on examples ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">F.18</span></a> readily implies</p>
<table id="A6.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex22.m1" class="ltx_Math" alttext="\mathbb{E}\!\left[\log^{2}\!\sup_{{\color[rgb]{0,0,0}\theta}}\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}\right]\;\leq\;C\,n^{2}\;=\;\poly(n)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mmultiscripts><munder><mo movablelimits="false">sup</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></munder><mprescripts></mprescripts><mrow></mrow><mn>2</mn></mmultiscripts><mo lspace="0.167em">⁡</mo><mfrac><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><mo rspace="0.280em">]</mo></mrow></mrow><mo rspace="0.558em">≤</mo><mrow><mi>C</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup></mrow><mo rspace="0.558em">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\!\left[\log^{2}\!\sup_{{\color[rgb]{0,0,0}\theta}}\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}\right]\;\leq\;C\,n^{2}\;=\;\poly(n),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmexample2.p10.2" class="ltx_p">which verifies the likelihood-ratio moment condition in <a href="#Thmassumption3" title="Assumption 3 (Data generation). ‣ D.3 ICL setting ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">3</span></a>.</p>
</div>
<div id="A6.Thmexample2.p11" class="ltx_para">
<p id="A6.Thmexample2.p11.1" class="ltx_p">Finally, we show the local regularity condition.
For fixed <math id="A6.Thmexample2.p11.m1" class="ltx_math_unparsed" alttext="{\color[rgb]{0,0,0}x}_{1:r-1}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x}_{1:r-1}</annotation></semantics></math>, the conditional density is</p>
<table id="A6.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex23.m1" class="ltx_math_unparsed" alttext="\log\density_{#1}({\color[rgb]{0,0,0}x}_{r}\mid{\color[rgb]{0,0,0}x}_{1:r-1},{\color[rgb]{0,0,0}\theta})=-\tfrac{1}{2}\log(2\pi v_{\color[rgb]{0,0,0}\theta})-\frac{\bigl({\color[rgb]{0,0,0}x}_{r}-m_{\color[rgb]{0,0,0}\theta}({\color[rgb]{0,0,0}x}_{r-1})\bigr)^{2}}{2v_{\color[rgb]{0,0,0}\theta}}." display="block" intent=":literal"><semantics><mrow><mi>log</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi>r</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mstyle displaystyle="false"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mi>log</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mi>π</mi><msub><mi>v</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mfrac><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi>r</mi></msub><mo>−</mo><mrow><msub><mi>m</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub></mrow></mfrac><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\log\density_{#1}({\color[rgb]{0,0,0}x}_{r}\mid{\color[rgb]{0,0,0}x}_{1:r-1},{\color[rgb]{0,0,0}\theta})=-\tfrac{1}{2}\log(2\pi v_{\color[rgb]{0,0,0}\theta})-\frac{\bigl({\color[rgb]{0,0,0}x}_{r}-m_{\color[rgb]{0,0,0}\theta}({\color[rgb]{0,0,0}x}_{r-1})\bigr)^{2}}{2v_{\color[rgb]{0,0,0}\theta}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmexample2.p11.2" class="ltx_p">On sets where <math id="A6.Thmexample2.p11.m2" class="ltx_math_unparsed" alttext="|{\color[rgb]{0,0,0}x}_{1:r}|\leq R" display="inline" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>r</mi></mrow></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">≤</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">|{\color[rgb]{0,0,0}x}_{1:r}|\leq R</annotation></semantics></math>, <math id="A6.Thmexample2.p11.m3" class="ltx_Math" alttext="\|{\color[rgb]{0,0,0}\theta}\|\leq R" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">\|{\color[rgb]{0,0,0}\theta}\|\leq R</annotation></semantics></math> (so <math id="A6.Thmexample2.p11.m4" class="ltx_Math" alttext="\mu,\tau" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>,</mo><mi>τ</mi></mrow><annotation encoding="application/x-tex">\mu,\tau</annotation></semantics></math> bounded) and with <math id="A6.Thmexample2.p11.m5" class="ltx_Math" alttext="\tau\in[\overline{\tau},\underline{\tau}]" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mover accent="true"><mi>τ</mi><mo stretchy="true">¯</mo></mover><mo>,</mo><munder accentunder="true"><mi>τ</mi><mo stretchy="true">¯</mo></munder></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\tau\in[\overline{\tau},\underline{\tau}]</annotation></semantics></math>, the maps</p>
<table id="A6.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex24.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\theta}\mapsto m_{\color[rgb]{0,0,0}\theta}({\color[rgb]{0,0,0}x}_{r-1})=e^{-\tau\Delta_{t}}{\color[rgb]{0,0,0}x}_{r-1}+\bigl(1-e^{-\tau\Delta_{t}}\bigr)\mu,\qquad{\color[rgb]{0,0,0}\theta}\mapsto v_{\color[rgb]{0,0,0}\theta}=\sigma^{2}\frac{1-e^{-2\tau\Delta_{t}}}{2\tau}" display="block" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">↦</mo><mrow><msub><mi>m</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></mrow></mrow></msup></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">↦</mo><msub><mi>v</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub><mo>=</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></mrow></mrow></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow></mfrac></mrow></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\theta}\mapsto m_{\color[rgb]{0,0,0}\theta}({\color[rgb]{0,0,0}x}_{r-1})=e^{-\tau\Delta_{t}}{\color[rgb]{0,0,0}x}_{r-1}+\bigl(1-e^{-\tau\Delta_{t}}\bigr)\mu,\qquad{\color[rgb]{0,0,0}\theta}\mapsto v_{\color[rgb]{0,0,0}\theta}=\sigma^{2}\frac{1-e^{-2\tau\Delta_{t}}}{2\tau}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.Thmexample2.p11.3" class="ltx_p">are smooth with bounded first derivatives:
<math id="A6.Thmexample2.p11.m6" class="ltx_Math" alttext="|\partial_{\mu}m_{\color[rgb]{0,0,0}\theta}|\leq 1,\ |\partial_{\tau}m_{\color[rgb]{0,0,0}\theta}|\leq C_{R},\ |\partial_{\tau}v_{\color[rgb]{0,0,0}\theta}|\leq C,\ \partial_{\mu}v_{\color[rgb]{0,0,0}\theta}=0." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mo lspace="0em">∂</mo><mi>μ</mi></msub><msub><mi>m</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mn>1</mn></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mo lspace="0em">∂</mo><mi>τ</mi></msub><msub><mi>m</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><msub><mi>C</mi><mi>R</mi></msub></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mo lspace="0em">∂</mo><mi>τ</mi></msub><msub><mi>v</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>C</mi></mrow><mo rspace="0.500em">,</mo><mrow><mrow><msub><mo>∂</mo><mi>μ</mi></msub><msub><mi>v</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub></mrow><mo>=</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|\partial_{\mu}m_{\color[rgb]{0,0,0}\theta}|\leq 1,\ |\partial_{\tau}m_{\color[rgb]{0,0,0}\theta}|\leq C_{R},\ |\partial_{\tau}v_{\color[rgb]{0,0,0}\theta}|\leq C,\ \partial_{\mu}v_{\color[rgb]{0,0,0}\theta}=0.</annotation></semantics></math>
Since <math id="A6.Thmexample2.p11.m7" class="ltx_Math" alttext="x_{r}-m_{\color[rgb]{0,0,0}\theta}({\color[rgb]{0,0,0}x}_{r-1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>r</mi></msub><mo>−</mo><mrow><msub><mi>m</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x_{r}-m_{\color[rgb]{0,0,0}\theta}({\color[rgb]{0,0,0}x}_{r-1})</annotation></semantics></math> is also bounded by a constant multiple of <math id="A6.Thmexample2.p11.m8" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> on these sets, we obtain, for all <math id="A6.Thmexample2.p11.m9" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\theta},{\color[rgb]{0,0,0}\theta}^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>,</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\theta},{\color[rgb]{0,0,0}\theta}^{\prime}</annotation></semantics></math> with <math id="A6.Thmexample2.p11.m10" class="ltx_Math" alttext="\|{\color[rgb]{0,0,0}\theta}\|,\|{\color[rgb]{0,0,0}\theta}^{\prime}\|\leq R" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">‖</mo></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">‖</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>′</mo></msup><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mi>R</mi></mrow></mrow><annotation encoding="application/x-tex">\|{\color[rgb]{0,0,0}\theta}\|,\|{\color[rgb]{0,0,0}\theta}^{\prime}\|\leq R</annotation></semantics></math>,</p>
<table id="A6.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex25.m1" class="ltx_math_unparsed" alttext="\sup_{\begin{subarray}{c}|{\color[rgb]{0,0,0}x}_{1:r}|\leq R\\
\|{\color[rgb]{0,0,0}\theta}\|,\|{\color[rgb]{0,0,0}\theta}^{\prime}\|\leq R\end{subarray}}\left|\log\frac{\density_{#1}({\color[rgb]{0,0,0}x}_{r}\mid{\color[rgb]{0,0,0}x}_{1:r-1},{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}x}_{r}\mid{\color[rgb]{0,0,0}x}_{1:r-1},{\color[rgb]{0,0,0}\theta}^{\prime})}\right|\ \leq\poly(R)\|{\color[rgb]{0,0,0}\theta}-{\color[rgb]{0,0,0}\theta}^{\prime}\|\,." display="block" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">sup</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>r</mi></mrow></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">≤</mo><mi>R</mi></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mo stretchy="false">‖</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">‖</mo></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">‖</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>′</mo></msup><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mi>R</mi></mrow></mrow></mtd></mtr></mtable></munder><mo fence="false" lspace="0em" rspace="0.167em">|</mo><mi>log</mi><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mi>r</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mi>r</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mfrac><mo fence="false" rspace="0.389em">|</mo><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>−</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0.059em">∥</mo><mo>.</mo></mrow><annotation encoding="application/x-tex">\sup_{\begin{subarray}{c}|{\color[rgb]{0,0,0}x}_{1:r}|\leq R\\
\|{\color[rgb]{0,0,0}\theta}\|,\|{\color[rgb]{0,0,0}\theta}^{\prime}\|\leq R\end{subarray}}\left|\log\frac{\density_{#1}({\color[rgb]{0,0,0}x}_{r}\mid{\color[rgb]{0,0,0}x}_{1:r-1},{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}x}_{r}\mid{\color[rgb]{0,0,0}x}_{1:r-1},{\color[rgb]{0,0,0}\theta}^{\prime})}\right|\ \leq\poly(R)\|{\color[rgb]{0,0,0}\theta}-{\color[rgb]{0,0,0}\theta}^{\prime}\|\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
