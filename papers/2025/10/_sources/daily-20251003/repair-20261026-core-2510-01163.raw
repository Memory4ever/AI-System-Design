<tbody id="A4.E51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E51.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\ex_{{\color[rgb]{0,0,0}X}}\bigg[\one\{{\color[rgb]{0,0,0}X}\in{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}^{\color[rgb]{0,0,0}T}\}\log\left(1+\sum_{{\color[rgb]{0,0,0}i}=1}^{{\color[rgb]{0,0,0}\mathcal{B}}({\color[rgb]{0,0,0}\Theta^{\prime}},\varepsilon,{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}},{\color[rgb]{0,0,0}T})}\exp\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=0}^{{\color[rgb]{0,0,0}T}-1}\log\frac{{\color[rgb]{0,0,0}g}_{\color[rgb]{0,0,0}i}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\mid{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}})}{\density_{#1}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}+{{\color[rgb]{0,0,0}T}}\log\frac{1+\varepsilon}{1-\varepsilon}\right)\right)" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi></msub><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo stretchy="false">{</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo>∈</mo><mmultiscripts><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mmultiscripts><mo rspace="0.167em" stretchy="false">}</mo></mrow><mi>log</mi><mrow><mo>(</mo><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>,</mo><mi>ε</mi><mo>,</mo><msup><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow></mrow></munderover></mstyle><mi>exp</mi><mrow><mo>(</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">g</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></msub><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>+</mo><mi>ε</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\ex_{{\color[rgb]{0,0,0}X}}\bigg[\one\{{\color[rgb]{0,0,0}X}\in{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}^{\color[rgb]{0,0,0}T}\}\log\left(1+\sum_{{\color[rgb]{0,0,0}i}=1}^{{\color[rgb]{0,0,0}\mathcal{B}}({\color[rgb]{0,0,0}\Theta^{\prime}},\varepsilon,{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}},{\color[rgb]{0,0,0}T})}\exp\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=0}^{{\color[rgb]{0,0,0}T}-1}\log\frac{{\color[rgb]{0,0,0}g}_{\color[rgb]{0,0,0}i}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\mid{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}})}{\density_{#1}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}+{{\color[rgb]{0,0,0}T}}\log\frac{1+\varepsilon}{1-\varepsilon}\right)\right)</annotation></semantics></math></td>
