<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E80.m1" class="ltx_math_unparsed" alttext="\displaystyle\ex_{#1}\left[\one\left\{\lVert{\color[rgb]{0,0,0}\theta}\rVert&gt;{\color[rgb]{0,0,0}R}_{\color[rgb]{0,0,0}T}\right\}\exp\left(-\ex_{#1}\left[\log\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right]\right)\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo>{</mo><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo fence="true" lspace="0em" rspace="0.1389em">∥</mo></mrow><mo lspace="0.1389em">&gt;</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo rspace="0.167em">}</mo></mrow><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>]</mo></mrow><mo>)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ex_{#1}\left[\one\left\{\lVert{\color[rgb]{0,0,0}\theta}\rVert&gt;{\color[rgb]{0,0,0}R}_{\color[rgb]{0,0,0}T}\right\}\exp\left(-\ex_{#1}\left[\log\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right]\right)\right]</annotation></semantics></math></td>
