<p id="A5.I3.i2.p1.1" class="ltx_p"><span id="A5.I3.i2.p1.1.1" class="ltx_text ltx_font_italic">If </span><math id="A5.I3.i2.p1.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\delta}&lt;{\color[rgb]{0,0,0}N}e^{-{\color[rgb]{0,0,0}q}}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">δ</mi><mo>&lt;</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\delta}&lt;{\color[rgb]{0,0,0}N}e^{-{\color[rgb]{0,0,0}q}}</annotation></semantics></math><span id="A5.I3.i2.p1.1.2" class="ltx_text ltx_font_italic">,</span></p>
