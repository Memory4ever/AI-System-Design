<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E136.m2" class="ltx_Math" alttext="\displaystyle={\color[rgb]{0,0,0}c}{\color[rgb]{0,0,0}r}^{3/2}\frac{{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}T}}}{{\color[rgb]{0,0,0}N}^{1-1/{\color[rgb]{0,0,0}r}}}\sqrt{\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\right)^{2}}\left\lVert{\color[rgb]{0,0,0}\theta}_{1}\right\rVert_{\color[rgb]{0,0,0}q}+{\color[rgb]{0,0,0}c}{\color[rgb]{0,0,0}r}\frac{{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}T}}}{{\color[rgb]{0,0,0}N}^{1-1/{\color[rgb]{0,0,0}r}}}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\right)\left\lVert{\color[rgb]{0,0,0}\theta}_{1}-\ex[{\color[rgb]{0,0,0}\theta}_{1}]\right\rVert_{\color[rgb]{0,0,0}q}\,." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></mrow></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>&gt;</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></munder></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></mrow></msub></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo>‖</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></msub></mrow><mo>+</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></mrow></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo>−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle={\color[rgb]{0,0,0}c}{\color[rgb]{0,0,0}r}^{3/2}\frac{{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}T}}}{{\color[rgb]{0,0,0}N}^{1-1/{\color[rgb]{0,0,0}r}}}\sqrt{\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\right)^{2}}\left\lVert{\color[rgb]{0,0,0}\theta}_{1}\right\rVert_{\color[rgb]{0,0,0}q}+{\color[rgb]{0,0,0}c}{\color[rgb]{0,0,0}r}\frac{{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}T}}}{{\color[rgb]{0,0,0}N}^{1-1/{\color[rgb]{0,0,0}r}}}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\right)\left\lVert{\color[rgb]{0,0,0}\theta}_{1}-\ex[{\color[rgb]{0,0,0}\theta}_{1}]\right\rVert_{\color[rgb]{0,0,0}q}\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.136)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS3.p23" class="ltx_para">
<p id="A5.SS3.p23.1" class="ltx_p"><span id="A5.SS3.p23.1.1" class="ltx_text">Applying <a href="#A5.Thmlemma5" title="Lemma E.5. ‣ E.2 Technical lemmas ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">E.5</span></a> then gives the desired concentration bound.
∎</span></p>
</div>
</div>
</section>
<section id="A5.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.4 </span>Complexity bounds for ICL</h3>

<div id="A5.SS4.p1" class="ltx_para">
<p id="A5.SS4.p1.1" class="ltx_p">We now derive bounds for the analogue of the Rademacher complexity term in our setting.
We will again rely on <a href="#A5.Thmtheorem1" title="Theorem E.1 (Causal symmetrization). ‣ E.1 Moment bounds for general functions ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">E.1</span></a>.</p>
</div>
<div id="A5.Thmlemma9" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A5.Thmlemma9.2" class="ltx_text ltx_font_bold">Lemma E.9</span></span><span id="A5.Thmlemma9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A5.Thmlemma9.p1" class="ltx_para">
<p id="A5.Thmlemma9.p1.1" class="ltx_p"><span id="A5.Thmlemma9.p1.1.1" class="ltx_text ltx_font_italic">Under <a href="#Thmassumption5" title="Assumption 5 (Weak dependence). ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumptions</span> <span class="ltx_text ltx_ref_tag">5</span></a>, <a href="#Thmassumption6" title="Assumption 6 (Finite moments of the task distribution). ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>, <a href="#Thmassumption7" title="Assumption 7 (Sub-Gaussian data). ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>, <a href="#Thmassumption8" title="Assumption 8 (Lipschitz model and loss). ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a> and <a href="#Thmassumption9" title="Assumption 9. ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>, we have</span></p>
<table id="A5.EGx71" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E137"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E137.m1" class="ltx_math_unparsed" alttext="\displaystyle\ex\left[\sup_{{\color[rgb]{0,0,0}f}\in{\color[rgb]{0,0,0}\mathcal{F}}}\ex\left[{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right]-{{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})}\right]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi></mrow></munder><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>−</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ex\left[\sup_{{\color[rgb]{0,0,0}f}\in{\color[rgb]{0,0,0}\mathcal{F}}}\ex\left[{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right]-{{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.137)</span></td></tr></tbody>
<tbody id="A5.E138"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E138.m1" class="ltx_Math" alttext="\displaystyle\leq{\color[rgb]{0,0,0}c}{\color[rgb]{0,0,0}\mathcal{I}}({\color[rgb]{0,0,0}\mathcal{F}},\dist,{\color[rgb]{0,0,0}q})\Bigg({\color[rgb]{0,0,0}\sigma}{\color[rgb]{0,0,0}M}_{{\color[rgb]{0,0,0}T}}\sqrt{\frac{{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}q}}{{\color[rgb]{0,0,0}N}}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℐ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">dist</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">M</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Tq</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mfrac></mstyle></msqrt></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq{\color[rgb]{0,0,0}c}{\color[rgb]{0,0,0}\mathcal{I}}({\color[rgb]{0,0,0}\mathcal{F}},\dist,{\color[rgb]{0,0,0}q})\Bigg({\color[rgb]{0,0,0}\sigma}{\color[rgb]{0,0,0}M}_{{\color[rgb]{0,0,0}T}}\sqrt{\frac{{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}q}}{{\color[rgb]{0,0,0}N}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.138)</span></td></tr></tbody>
<tbody id="A5.E139"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E139.m1" class="ltx_Math" alttext="\displaystyle\quad+{\color[rgb]{0,0,0}c}\sqrt{{\color[rgb]{0,0,0}q}}\frac{{\color[rgb]{0,0,0}M}_{{\color[rgb]{0,0,0}T}}}{\sqrt{{\color[rgb]{0,0,0}N}}}\sqrt{\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\right)^{2}}\left\lVert{\color[rgb]{0,0,0}\theta}_{1}\right\rVert_{2}+{\color[rgb]{0,0,0}q}^{3/2}\frac{{\color[rgb]{0,0,0}M}_{{\color[rgb]{0,0,0}T}}}{{\color[rgb]{0,0,0}N}^{1-1/{\color[rgb]{0,0,0}q}}}\sqrt{\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\right)^{2}}\left\lVert{\color[rgb]{0,0,0}\theta}_{1}\right\rVert_{\color[rgb]{0,0,0}q}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">M</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><msqrt><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>&gt;</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></munder></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></mrow></msub></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo>+</mo><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">M</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></mrow></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>&gt;</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></munder></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></mrow></msub></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo>‖</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+{\color[rgb]{0,0,0}c}\sqrt{{\color[rgb]{0,0,0}q}}\frac{{\color[rgb]{0,0,0}M}_{{\color[rgb]{0,0,0}T}}}{\sqrt{{\color[rgb]{0,0,0}N}}}\sqrt{\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\right)^{2}}\left\lVert{\color[rgb]{0,0,0}\theta}_{1}\right\rVert_{2}+{\color[rgb]{0,0,0}q}^{3/2}\frac{{\color[rgb]{0,0,0}M}_{{\color[rgb]{0,0,0}T}}}{{\color[rgb]{0,0,0}N}^{1-1/{\color[rgb]{0,0,0}q}}}\sqrt{\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\right)^{2}}\left\lVert{\color[rgb]{0,0,0}\theta}_{1}\right\rVert_{\color[rgb]{0,0,0}q}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.139)</span></td></tr></tbody>
<tbody id="A5.E140"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E140.m1" class="ltx_Math" alttext="\displaystyle\quad+\sqrt{{\color[rgb]{0,0,0}q}}\frac{{\color[rgb]{0,0,0}M}_{{\color[rgb]{0,0,0}T}}}{\sqrt{{\color[rgb]{0,0,0}N}}}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\right)\left\lVert{{\color[rgb]{0,0,0}\theta}_{1}-\ex[{\color[rgb]{0,0,0}\theta}_{1}]}\right\rVert_{2}+{\color[rgb]{0,0,0}c}{\color[rgb]{0,0,0}q}\frac{{\color[rgb]{0,0,0}M}_{{\color[rgb]{0,0,0}T}}}{{\color[rgb]{0,0,0}N}^{1-1/{\color[rgb]{0,0,0}q}}}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\right)\left\lVert{{\color[rgb]{0,0,0}\theta}_{1}-\ex[{\color[rgb]{0,0,0}\theta}_{1}]}\right\rVert_{\color[rgb]{0,0,0}q}\Bigg)\,," display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mrow><mo>+</mo><mrow><msqrt><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">M</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><msqrt><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo>−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo>+</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">M</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></mrow></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo>−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></msub></mrow></mrow><mo maxsize="2.600em" minsize="2.600em" rspace="0.170em">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sqrt{{\color[rgb]{0,0,0}q}}\frac{{\color[rgb]{0,0,0}M}_{{\color[rgb]{0,0,0}T}}}{\sqrt{{\color[rgb]{0,0,0}N}}}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\right)\left\lVert{{\color[rgb]{0,0,0}\theta}_{1}-\ex[{\color[rgb]{0,0,0}\theta}_{1}]}\right\rVert_{2}+{\color[rgb]{0,0,0}c}{\color[rgb]{0,0,0}q}\frac{{\color[rgb]{0,0,0}M}_{{\color[rgb]{0,0,0}T}}}{{\color[rgb]{0,0,0}N}^{1-1/{\color[rgb]{0,0,0}q}}}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\right)\left\lVert{{\color[rgb]{0,0,0}\theta}_{1}-\ex[{\color[rgb]{0,0,0}\theta}_{1}]}\right\rVert_{\color[rgb]{0,0,0}q}\Bigg)\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.140)</span></td></tr></tbody>
</table>
<p id="A5.Thmlemma9.p1.2" class="ltx_p"><span id="A5.Thmlemma9.p1.2.1" class="ltx_text ltx_font_italic">where <math id="A5.Thmlemma9.p1.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}c}&gt;0" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}c}&gt;0</annotation></semantics></math> is a universal constant and where the Dudley-type integral <math id="A5.Thmlemma9.p1.m2" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\mathcal{I}}_{\dist}({\color[rgb]{0,0,0}\mathcal{F}})" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℐ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">dist</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\mathcal{I}}_{\dist}({\color[rgb]{0,0,0}\mathcal{F}})</annotation></semantics></math> is defined as</span></p>
<table id="A5.E141" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E141.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\mathcal{I}}({\color[rgb]{0,0,0}\mathcal{F}},\dist,{\color[rgb]{0,0,0}q})=\int_{0}^{\Delta}\left({\color[rgb]{0,0,0}\mathcal{N}}({\color[rgb]{0,0,0}\mathcal{F}},\dist,u)\right)^{1/{\color[rgb]{0,0,0}q}}du\,,\quad\text{ with }\Delta=\diam_{\dist}({\color[rgb]{0,0,0}\mathcal{F}})=\sup_{{\color[rgb]{0,0,0}f},{\color[rgb]{0,0,0}f}^{\prime}\in{\color[rgb]{0,0,0}\mathcal{F}}}\dist({\color[rgb]{0,0,0}f},{\color[rgb]{0,0,0}f}^{\prime})\,." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℐ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">dist</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo rspace="0em">∫</mo><mn>0</mn><mi mathvariant="normal">Δ</mi></msubsup><mrow><msup><mrow><mo>(</mo><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">dist</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>du</mi></mrow></mrow></mrow><mo lspace="0.170em" rspace="1.167em">,</mo><mrow><mrow><mtext class="ltx_mathvariant_italic"> with </mtext><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow><mo>=</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">diam</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">dist</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>′</mo></msup></mrow><mo>∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi></mrow></munder><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">dist</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\mathcal{I}}({\color[rgb]{0,0,0}\mathcal{F}},\dist,{\color[rgb]{0,0,0}q})=\int_{0}^{\Delta}\left({\color[rgb]{0,0,0}\mathcal{N}}({\color[rgb]{0,0,0}\mathcal{F}},\dist,u)\right)^{1/{\color[rgb]{0,0,0}q}}du\,,\quad\text{ with }\Delta=\diam_{\dist}({\color[rgb]{0,0,0}\mathcal{F}})=\sup_{{\color[rgb]{0,0,0}f},{\color[rgb]{0,0,0}f}^{\prime}\in{\color[rgb]{0,0,0}\mathcal{F}}}\dist({\color[rgb]{0,0,0}f},{\color[rgb]{0,0,0}f}^{\prime})\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.141)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS4.p2" class="ltx_para">
<p id="A5.SS4.p2.1" class="ltx_p"><span id="A5.SS4.p2.1.1" class="ltx_text">The main idea of the proof is to use <a href="#A5.Thmlemma7" title="Lemma E.7 (Dudley–type entropy integral under 𝐿^𝑝 increments). ‣ E.2 Technical lemmas ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">E.7</span></a> and to rely on <a href="#A5.Thmtheorem1" title="Theorem E.1 (Causal symmetrization). ‣ E.1 Moment bounds for general functions ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">E.1</span></a> to control the moments of the increments of the process <math id="A5.SS4.p2.m1" class="ltx_math_unparsed" alttext="\sup_{{\color[rgb]{0,0,0}f}\in{\color[rgb]{0,0,0}\mathcal{F}}}{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})-\ex\left[{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right]" display="inline" intent=":literal"><semantics><mrow><msub><mo>sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi></mrow></msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\sup_{{\color[rgb]{0,0,0}f}\in{\color[rgb]{0,0,0}\mathcal{F}}}{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})-\ex\left[{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right]</annotation></semantics></math>.
Fix <math id="A5.SS4.p2.m2" class="ltx_Math" alttext="{\color[rgb]{0,0,0}f},{\color[rgb]{0,0,0}f}^{\prime}\in{\color[rgb]{0,0,0}\mathcal{F}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>′</mo></msup></mrow><mo>∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}f},{\color[rgb]{0,0,0}f}^{\prime}\in{\color[rgb]{0,0,0}\mathcal{F}}</annotation></semantics></math>.
We apply <a href="#A5.Thmtheorem1" title="Theorem E.1 (Causal symmetrization). ‣ E.1 Moment bounds for general functions ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">E.1</span></a> with</span></p>
<table id="A5.E142" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E142.m1" class="ltx_Math" alttext="(Z_{1},\ldots,Z_{m})=({\color[rgb]{0,0,0}\theta}_{1},{\color[rgb]{0,0,0}x}_{1}^{(1)},\ldots,{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}T}^{(1)},\ldots,{\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}x}_{1}^{({\color[rgb]{0,0,0}N})},\ldots,{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}T}^{({\color[rgb]{0,0,0}N})})\,," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>Z</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.170em" stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">(Z_{1},\ldots,Z_{m})=({\color[rgb]{0,0,0}\theta}_{1},{\color[rgb]{0,0,0}x}_{1}^{(1)},\ldots,{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}T}^{(1)},\ldots,{\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}x}_{1}^{({\color[rgb]{0,0,0}N})},\ldots,{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}T}^{({\color[rgb]{0,0,0}N})})\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.142)</span></td></tr></tbody>
</table>
<p id="A5.SS4.p2.2" class="ltx_p"><span id="A5.SS4.p2.2.1" class="ltx_text">and</span></p>
<table id="A5.EGx72" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E143"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E143.m1" class="ltx_math_unparsed" alttext="\displaystyle{\color[rgb]{0,0,0}g}({\color[rgb]{0,0,0}\theta}_{1},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{(1)},\ldots,{\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{({\color[rgb]{0,0,0}N})})" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">g</mi><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\color[rgb]{0,0,0}g}({\color[rgb]{0,0,0}\theta}_{1},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{(1)},\ldots,{\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{({\color[rgb]{0,0,0}N})})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.143)</span></td></tr></tbody>
<tbody id="A5.E144"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E144.m1" class="ltx_math_unparsed" alttext="\displaystyle=\ex\left[{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right]-{{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>−</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\ex\left[{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right]-{{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.144)</span></td></tr></tbody>
<tbody id="A5.E145"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E145.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad-\left(\ex\left[{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f}^{\prime},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right]-{{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f}^{\prime},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})}\right)" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mo>(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>′</mo></msup><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>−</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>′</mo></msup><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad-\left(\ex\left[{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f}^{\prime},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right]-{{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f}^{\prime},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.145)</span></td></tr></tbody>
</table>
<p id="A5.SS4.p2.3" class="ltx_p"><span id="A5.SS4.p2.3.1" class="ltx_text">and proceed as in the proof of <a href="#A5.Thmlemma8" title="Lemma E.8. ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">E.8</span></a> except that <math id="A5.SS4.p2.m3" class="ltx_Math" alttext="{\color[rgb]{0,0,0}g}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">g</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}g}</annotation></semantics></math> is now <math id="A5.SS4.p2.m4" class="ltx_Math" alttext="{\color[rgb]{0,0,0}M}_{\color[rgb]{0,0,0}T}\dist({\color[rgb]{0,0,0}f},{\color[rgb]{0,0,0}f}^{\prime})" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">M</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">dist</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}M}_{\color[rgb]{0,0,0}T}\dist({\color[rgb]{0,0,0}f},{\color[rgb]{0,0,0}f}^{\prime})</annotation></semantics></math> coordinate-wise Lipschitz by <a href="#Thmassumption9" title="Assumption 9. ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">9</span></a> to obtain that:</span></p>
