<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E29.m1" class="ltx_math_unparsed" alttext="\displaystyle\prob_{\!#1}\left({\sup_{{\color[rgb]{0,0,0}\theta}:\lVert{\color[rgb]{0,0,0}\theta}\rVert\geq{\color[rgb]{0,0,0}R}}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}\geq{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℙ</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>(</mo><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo lspace="0.278em">:</mo><mrow><mrow><mo fence="true" lspace="0.111em" rspace="0em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo fence="true" lspace="0em" rspace="0.1389em">∥</mo></mrow><mo lspace="0.1389em">≥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi></mrow></mrow></munder><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow><mo>≥</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\prob_{\!#1}\left({\sup_{{\color[rgb]{0,0,0}\theta}:\lVert{\color[rgb]{0,0,0}\theta}\rVert\geq{\color[rgb]{0,0,0}R}}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}\geq{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E29.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{\poly({\color[rgb]{0,0,0}T})}{1+{\color[rgb]{0,0,0}R}^{1/k}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>+</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mrow><mn>1</mn><mo>/</mo><mi>k</mi></mrow></msup></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\poly({\color[rgb]{0,0,0}T})}{1+{\color[rgb]{0,0,0}R}^{1/k}}</annotation></semantics></math></td>
