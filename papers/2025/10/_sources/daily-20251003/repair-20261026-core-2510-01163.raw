<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E47.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+{\color[rgb]{0,0,0}\pi}\left({\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}\right)\cdot\sup_{{\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}}\left(\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}\right)^{1/{\color[rgb]{0,0,0}\mu}}\bigg)\bigg]\,." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><mrow><mo>(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∉</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo rspace="0.055em">)</mo></mrow><mo>⋅</mo><munder><mo lspace="0.055em" movablelimits="false" rspace="0em">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∉</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup></mrow></munder><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi></mrow></msup><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+{\color[rgb]{0,0,0}\pi}\left({\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}\right)\cdot\sup_{{\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}}\left(\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}\right)^{1/{\color[rgb]{0,0,0}\mu}}\bigg)\bigg]\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.47)</span></td></tr></tbody>
</table>
<p id="A4.SS4.p5.2" class="ltx_p"><span id="A4.SS4.p5.2.1" class="ltx_text">Since <math id="A4.SS4.p5.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\mu}\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\mu}\in(0,1)</annotation></semantics></math>, for any non-negative numbers <math id="A4.SS4.p5.m2" class="ltx_Math" alttext="a_{1},\dots,a_{K}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><mi>K</mi></msub></mrow><annotation encoding="application/x-tex">a_{1},\dots,a_{K}</annotation></semantics></math> we have <math id="A4.SS4.p5.m3" class="ltx_Math" alttext="\left(\sum_{k=1}^{K}a_{k}\right)^{{\color[rgb]{0,0,0}\mu}}\leq\sum_{k=1}^{K}a_{k}^{{\color[rgb]{0,0,0}\mu}}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>(</mo><mrow><msubsup><mo lspace="0em">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></msubsup><msub><mi>a</mi><mi>k</mi></msub></mrow><mo>)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi></msup><mo rspace="0.111em">≤</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></msubsup><msubsup><mi>a</mi><mi>k</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\left(\sum_{k=1}^{K}a_{k}\right)^{{\color[rgb]{0,0,0}\mu}}\leq\sum_{k=1}^{K}a_{k}^{{\color[rgb]{0,0,0}\mu}}</annotation></semantics></math>. Using this inequality and that <math id="A4.SS4.p5.m4" class="ltx_Math" alttext="\log(a+b)\leq\log(1+a)+\log(1+b)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\log(a+b)\leq\log(1+a)+\log(1+b)</annotation></semantics></math> for <math id="A4.SS4.p5.m5" class="ltx_Math" alttext="a,b\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a,b\geq 0</annotation></semantics></math>, we obtain</span></p>
<table id="A4.EGx19" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E48"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E48.m1" class="ltx_math_unparsed" alttext="\displaystyle{\color[rgb]{0,0,0}\mu}\ex_{#1}\left[\one\{{\color[rgb]{0,0,0}X}\in{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}^{\color[rgb]{0,0,0}T}\}\log\ex_{#1}\left[\exp\left(-\frac{1}{{\color[rgb]{0,0,0}\mu}}\log\frac{\density_{#1}({\color[rgb]{0,0,0}X}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}X}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right)\right]\right]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo stretchy="false">{</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo>∈</mo><mmultiscripts><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mmultiscripts><mo rspace="0.167em" stretchy="false">}</mo></mrow><mi>log</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi></mfrac></mstyle><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="false" lspace="0.170em" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="false" lspace="0.170em" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>)</mo></mrow><mo>]</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\color[rgb]{0,0,0}\mu}\ex_{#1}\left[\one\{{\color[rgb]{0,0,0}X}\in{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}^{\color[rgb]{0,0,0}T}\}\log\ex_{#1}\left[\exp\left(-\frac{1}{{\color[rgb]{0,0,0}\mu}}\log\frac{\density_{#1}({\color[rgb]{0,0,0}X}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}X}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right)\right]\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.48)</span></td></tr></tbody>
<tbody id="A4.E49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E49.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\ex_{{\color[rgb]{0,0,0}X}}\bigg[\one\{{\color[rgb]{0,0,0}X}\in{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}^{\color[rgb]{0,0,0}T}\}\log\bigg(\sum_{{\color[rgb]{0,0,0}i}=1}^{{\color[rgb]{0,0,0}\mathcal{B}}({\color[rgb]{0,0,0}\Theta^{\prime}},\varepsilon,{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}},{\color[rgb]{0,0,0}T})}\exp\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=0}^{{\color[rgb]{0,0,0}T}-1}\log\frac{{\color[rgb]{0,0,0}g}_{\color[rgb]{0,0,0}i}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\mid{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}})}{\density_{#1}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}+{{\color[rgb]{0,0,0}T}}\log\frac{1+\varepsilon}{1-\varepsilon}\right)" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi></msub><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo stretchy="false">{</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo>∈</mo><mmultiscripts><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mmultiscripts><mo rspace="0.167em" stretchy="false">}</mo></mrow><mi>log</mi><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>,</mo><mi>ε</mi><mo>,</mo><msup><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow></mrow></munderover></mstyle><mi>exp</mi><mrow><mo>(</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">g</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></msub><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>+</mo><mi>ε</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\ex_{{\color[rgb]{0,0,0}X}}\bigg[\one\{{\color[rgb]{0,0,0}X}\in{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}^{\color[rgb]{0,0,0}T}\}\log\bigg(\sum_{{\color[rgb]{0,0,0}i}=1}^{{\color[rgb]{0,0,0}\mathcal{B}}({\color[rgb]{0,0,0}\Theta^{\prime}},\varepsilon,{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}},{\color[rgb]{0,0,0}T})}\exp\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=0}^{{\color[rgb]{0,0,0}T}-1}\log\frac{{\color[rgb]{0,0,0}g}_{\color[rgb]{0,0,0}i}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\mid{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}})}{\density_{#1}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}+{{\color[rgb]{0,0,0}T}}\log\frac{1+\varepsilon}{1-\varepsilon}\right)</annotation></semantics></math></td>
