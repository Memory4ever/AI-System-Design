yle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo>−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\color[rgb]{0,0,0}c}{\color[rgb]{0,0,0}\sigma}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}T}}\sqrt{\frac{{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}r}}{{\color[rgb]{0,0,0}T}}}+{\color[rgb]{0,0,0}c}\sqrt{{\color[rgb]{0,0,0}r}}\frac{{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}T}}}{\sqrt{{\color[rgb]{0,0,0}N}}}\sqrt{\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\right)^{2}}\left\lVert{\color[rgb]{0,0,0}\theta}_{1}\right\rVert_{2}+{\color[rgb]{0,0,0}c}\sqrt{{\color[rgb]{0,0,0}r}}\frac{{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}T}}}{\sqrt{{\color[rgb]{0,0,0}N}}}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\right)\left\lVert{\color[rgb]{0,0,0}\theta}_{1}-\ex[{\color[rgb]{0,0,0}\theta}_{1}]\right\rVert_{2}</annotation></semantics></math></td>
