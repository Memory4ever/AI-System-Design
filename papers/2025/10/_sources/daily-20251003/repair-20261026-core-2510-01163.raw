<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E30.m1" class="ltx_math_unparsed" alttext="\displaystyle\prob_{\!#1}\Big({\exists{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\leq{\color[rgb]{0,0,0}T},\lVert{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\rVert\geq{\color[rgb]{0,0,0}R}}\Big)" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℙ</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mo rspace="0.167em">∃</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo>,</mo><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo fence="true" lspace="0em" rspace="0.1389em">∥</mo></mrow><mo lspace="0.1389em">≥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\prob_{\!#1}\Big({\exists{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\leq{\color[rgb]{0,0,0}T},\lVert{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\rVert\geq{\color[rgb]{0,0,0}R}}\Big)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E30.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{\poly({\color[rgb]{0,0,0}T})}{1+{\color[rgb]{0,0,0}R}^{1/k}}+" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>+</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mrow><mn>1</mn><mo>/</mo><mi>k</mi></mrow></msup></mrow></mfrac></mstyle><mo>+</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\poly({\color[rgb]{0,0,0}T})}{1+{\color[rgb]{0,0,0}R}^{1/k}}+</annotation></semantics></math></td>
