<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E50.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+{\color[rgb]{0,0,0}\pi}\left({\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}\right)^{{{\color[rgb]{0,0,0}\mu}}}\cdot\sup_{{\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}}\left(\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}\right)\bigg)\bigg]" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><msup><mrow><mo>(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∉</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo rspace="0.055em">)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi></msup><mo>⋅</mo><munder><mo lspace="0.055em" movablelimits="false" rspace="0em">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∉</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup></mrow></munder><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+{\color[rgb]{0,0,0}\pi}\left({\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}\right)^{{{\color[rgb]{0,0,0}\mu}}}\cdot\sup_{{\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}}\left(\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}\right)\bigg)\bigg]</annotation></semantics></math></td>
