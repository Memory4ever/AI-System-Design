ize="2.100em" minsize="2.100em">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle+{\color[rgb]{0,0,0}c}\sqrt{{\color[rgb]{0,0,0}q}}\frac{{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}T}}}{\sqrt{{\color[rgb]{0,0,0}N}}}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\right)\left\lVert{{\color[rgb]{0,0,0}\theta}_{1}-\ex[{\color[rgb]{0,0,0}\theta}_{1}]}\right\rVert_{2}+{\color[rgb]{0,0,0}c}{\color[rgb]{0,0,0}q}\frac{{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}T}}}{{\color[rgb]{0,0,0}N}^{1-1/{\color[rgb]{0,0,0}q}}}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\right)\left\lVert{{\color[rgb]{0,0,0}\theta}_{1}-\ex[{\color[rgb]{0,0,0}\theta}_{1}]}\right\rVert_{\color[rgb]{0,0,0}q}\bigg)</annotation></semantics></math></td>
