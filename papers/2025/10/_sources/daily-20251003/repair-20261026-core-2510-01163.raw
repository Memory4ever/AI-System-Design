+\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\lVert{\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n}\rVert\right)\right)\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.106)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p13.3" class="ltx_p"><span id="A5.SS3.p13.3.1" class="ltx_text">and <math id="A5.SS3.p13.m6" class="ltx_Math" alttext="G_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n},G_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\prime{\color[rgb]{0,0,0}n}}\sim\mathcal{N}(0,32{\color[rgb]{0,0,0}\sigma}^{2})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>G</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo>,</mo><mrow><msubsup><mi>G</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></mrow></msubsup><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mn>32</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">G_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n},G_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\prime{\color[rgb]{0,0,0}n}}\sim\mathcal{N}(0,32{\color[rgb]{0,0,0}\sigma}^{2})</annotation></semantics></math> independent of all data and Rademacher variables.</span></p>
</div>
<div id="A5.SS3.p14" class="ltx_para">
<p id="A5.SS3.p14.1" class="ltx_p"><span id="A5.SS3.p14.1.1" class="ltx_text">Using Minkowski’s inequality, we have</span></p>
<table id="A5.EGx61" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E107"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E107.m1" class="ltx_Math" alttext="\displaystyle\left\lVert f-\ex[f]\right\rVert_{\color[rgb]{0,0,0}r}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mi>f</mi><mo>−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>f</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\lVert f-\ex[f]\right\rVert_{\color[rgb]{0,0,0}r}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.107)</span></td></tr></tbody>
<tbody id="A5.E108"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E108.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\left\lVert\sum_{{\color[rgb]{0,0,0}n}=1}^{\color[rgb]{0,0,0}N}{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}n}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}\left({\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n}\lvert G_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n}\rvert-{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n}{}^{\prime}\lvert G_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n}{}^{\prime}\rvert\right)\right\rVert_{\color[rgb]{0,0,0}r}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><msub><mrow><mo>‖</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></munderover></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mrow><mo>(</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mrow><mo stretchy="false">|</mo><msubsup><mi>G</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">|</mo></mrow><mo>−</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mmultiscripts><mrow><mo stretchy="false">|</mo><msubsup><mi>G</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mmultiscripts><mo stretchy="false">|</mo><mprescripts></mprescripts><mrow></mrow><mo>′</mo></mmultiscripts></mrow><mprescripts></mprescripts><mrow></mrow><mo>′</mo></mmultiscripts><mo>)</mo></mrow><mo>‖</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\lVert\sum_{{\color[rgb]{0,0,0}n}=1}^{\color[rgb]{0,0,0}N}{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}n}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}\left({\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n}\lvert G_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n}\rvert-{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n}{}^{\prime}\lvert G_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n}{}^{\prime}\rvert\right)\right\rVert_{\color[rgb]{0,0,0}r}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.108)</span></td></tr></tbody>
<tbody id="A5.E109"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E109.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\left\lVert\sum_{{\color[rgb]{0,0,0}n}=1}^{\color[rgb]{0,0,0}N}{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}n}\left(\lVert{\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n}\rVert\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n}-\lVert{\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n}^{\prime}\rVert\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n}{}^{\prime}\right)\right\rVert_{\color[rgb]{0,0,0}r}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mrow><mo>‖</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></munderover></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mrow><mo>(</mo><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>&gt;</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></munder></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></mrow></msub><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo>−</mo><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>′</mo></msubsup><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>&gt;</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></munder></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></mrow></msub><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mmultiscripts><mo>)</mo><mprescripts></mprescripts><mrow></mrow><mo>′</mo></mmultiscripts></mrow><mo>‖</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\left\lVert\sum_{{\color[rgb]{0,0,0}n}=1}^{\color[rgb]{0,0,0}N}{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}n}\left(\lVert{\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n}\rVert\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n}-\lVert{\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n}^{\prime}\rVert\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n}{}^{\prime}\right)\right\rVert_{\color[rgb]{0,0,0}r}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.109)</span></td></tr></tbody>
<tbody id="A5.E110"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E110.m1" class="ltx_Math" alttext="\displaystyle\quad+\left\lVert\sum_{{\color[rgb]{0,0,0}n}=1}^{\color[rgb]{0,0,0}N}{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}n}{\lVert{\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n}-{\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n}^{\prime}\rVert}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\right\rVert_{\color[rgb]{0,0,0}r}\,." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><msub><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></munderover></mstyle><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo fence="true" rspace="0em">∥</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo>−</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>′</mo></msubsup></mrow><mo fence="true" lspace="0em">∥</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow></mrow></mrow></mrow><mo>‖</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\left\lVert\sum_{{\color[rgb]{0,0,0}n}=1}^{\color[rgb]{0,0,0}N}{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}n}{\lVert{\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n}-{\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n}^{\prime}\rVert}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\right\rVert_{\color[rgb]{0,0,0}r}\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.110)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS3.p15" class="ltx_para">
<p id="A5.SS3.p15.1" class="ltx_p"><span id="A5.SS3.p15.1.1" class="ltx_text">We now bound each term <a href="#A5.E108" title="In Proof. ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eqs.</span> <span class="ltx_text ltx_ref_tag">E.108</span></a>, <a href="#A5.E109" title="Equation E.109 ‣ Proof. ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.109</span></a> and <a href="#A5.E110" title="Equation E.110 ‣ Proof. ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.110</span></a> separately.</span></p>
</div>
<div id="A5.SS3.p16" class="ltx_para">
<p id="A5.SS3.p16.1" class="ltx_p"><span id="A5.SS3.p16.1.1" class="ltx_text">We begin with <a href="#A5.E108" title="In Proof. ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">E.108</span></a>.
By independence of the Rademacher variables and the Gaussian variables, we have that
<a href="#A5.E108" title="In Proof. ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">E.108</span></a> can be rewritten as</span></p>
<table id="A5.EGx62" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E111"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><a href="#A5.E108" title="In Proof. ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref ltx_markedasmath ltx_font_italic"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">E.108</span></a></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E111.m2" class="ltx_Math" alttext="\displaystyle=\sqrt{2}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}\left\lVert\sum_{{\color[rgb]{0,0,0}n}=1}^{\color[rgb]{0,0,0}N}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}G_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n}\right\rVert_{\color[rgb]{0,0,0}r}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msqrt><mn>2</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><msubsup><mi>G</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup></mrow></mrow><mo>‖</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sqrt{2}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}\left\lVert\sum_{{\color[rgb]{0,0,0}n}=1}^{\color[rgb]{0,0,0}N}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}G_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n}\right\rVert_{\color[rgb]{0,0,0}r}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.111)</span></td></tr></tbody>
<tbody id="A5.E112"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E112.m1" class="ltx_Math" alttext="\displaystyle=8{\color[rgb]{0,0,0}\sigma}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}\sqrt{{\color[rgb]{0,0,0}N}{\color[rgb]{0,0,0}T}}\lVert G\rVert_{\color[rgb]{0,0,0}r}\,," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo fence="true" rspace="0em">∥</mo><mi>G</mi><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=8{\color[rgb]{0,0,0}\sigma}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}\sqrt{{\color[rgb]{0,0,0}N}{\color[rgb]{0,0,0}T}}\lVert G\rVert_{\color[rgb]{0,0,0}r}\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.112)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p16.2" class="ltx_p"><span id="A5.SS3.p16.2.1" class="ltx_text">where <math id="A5.SS3.p16.m1" class="ltx_Math" alttext="G\sim\mathcal{N}(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">G\sim\mathcal{N}(0,1)</annotation></semantics></math>.
Using standard bounds on subGaussian random variables, we have that <math id="A5.SS3.p16.m2" class="ltx_Math" alttext="\lVert G\rVert_{\color[rgb]{0,0,0}r}\leq{\color[rgb]{0,0,0}c}\sqrt{{\color[rgb]{0,0,0}r}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo fence="true" rspace="0em">∥</mo><mi>G</mi><mo fence="true" lspace="0em">∥</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></msub><mo>≤</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></msqrt></mrow></mrow><annotation encoding="application/x-tex">\lVert G\rVert_{\color[rgb]{0,0,0}r}\leq{\color[rgb]{0,0,0}c}\sqrt{{\color[rgb]{0,0,0}r}}</annotation></semantics></math> for some universal constant <math id="A5.SS3.p16.m3" class="ltx_Math" alttext="{\color[rgb]{0,0,0}c}&gt;0" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}c}&gt;0</annotation></semantics></math> (see e.g. <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib55" title="" class="ltx_ref">Vershynin (2018, Chap. 2)</a></cite>).
Hence, we have</span></p>
<table id="A5.E113" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E113.m1" class="ltx_Math" alttext="\lx@cref{creftypecap~refnum}{eq:icl_moment_decomposition_1}\leq{\color[rgb]{0,0,0}c}{\color[rgb]{0,0,0}\sigma}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}\sqrt{{\color[rgb]{0,0,0}N}{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}r}}\,," display="block" intent=":literal"><semantics><mrow><mrow><mtext class="ltx_mathvariant_italic"><a href="#A5.E108" title="In Proof. ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">E.108</span></a></mtext><mo>≤</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></mrow></msqrt></mrow></mrow><mo lspace="0.170em">,</mo></mrow><annotation encoding="application/x-tex">\lx@cref{creftypecap~refnum}{eq:icl_moment_decomposition_1}\leq{\color[rgb]{0,0,0}c}{\color[rgb]{0,0,0}\sigma}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}\sqrt{{\color[rgb]{0,0,0}N}{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}r}}\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.113)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p16.3" class="ltx_p"><span id="A5.SS3.p16.3.1" class="ltx_text">for some universal constant <math id="A5.SS3.p16.m4" class="ltx_Math" alttext="{\color[rgb]{0,0,0}c}&gt;0" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}c}&gt;0</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS3.p17" class="ltx_para">
<p id="A5.SS3.p17.1" class="ltx_p"><span id="A5.SS3.p17.1.1" class="ltx_text">We now turn to <a href="#A5.E109" title="In Proof. ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">E.109</span></a>.
By <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib12" title="" class="ltx_ref">Boucheron et al. (2005, Thm. 15.11)</a></cite>, applied to each independent and zero-mean term</span></p>
<table id="A5.E114" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E114.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}n}\left(\lVert{\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n}\rVert\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}-\lVert{\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n}^{\prime}\rVert\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n}}^{\prime}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\right)\,," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo fence="true" lspace="0em">∥</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>&gt;</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></munder><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></mrow></msub></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>′</mo></msubsup><mo fence="true" lspace="0em">∥</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover><mrow><mmultiscripts><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mrow></mrow><mo>′</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>&gt;</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></munder><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></mrow></msub></mrow></mrow></mrow></mrow></mrow><mo rspace="0.170em">)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}n}\left(\lVert{\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n}\rVert\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}-\lVert{\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n}^{\prime}\rVert\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n}}^{\prime}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\right)\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.114)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p17.2" class="ltx_p"><span id="A5.SS3.p17.2.1" class="ltx_text">we have</span></p>
<table id="A5.EGx63" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E115"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><a href="#A5.E109" title="In Proof. ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref ltx_markedasmath ltx_font_italic"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">E.109</span></a></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E115.m2" class="ltx_Math" alttext="\displaystyle\leq{\color[rgb]{0,0,0}c}\sqrt{{\color[rgb]{0,0,0}r}}{\color[rgb]{0,0,0}L}_{{\color[rgb]{0,0,0}N},{\color[rgb]{0,0,0}T}}\sqrt{{\color[rgb]{0,0,0}N}}\left\lVert\lVert{\color[rgb]{0,0,0}\theta}_{1}\rVert\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{1}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}-\lVert{\color[rgb]{0,0,0}\theta}_{1}^{\prime}\rVert\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{{\color[rgb]{0,0,0}\varepsilon}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{1}}^{\prime}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}&gt;{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}\right\rVert_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo fence="true" lspace="0em">∥</mo></mrow><mo lspace="0em" rspace=