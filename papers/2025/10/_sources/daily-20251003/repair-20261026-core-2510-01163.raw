{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\right)\left\lVert{{\color[rgb]{0,0,0}\theta}_{1}-\ex[{\color[rgb]{0,0,0}\theta}_{1}]}\right\rVert_{\color[rgb]{0,0,0}q}</annotation></semantics></math></td>
