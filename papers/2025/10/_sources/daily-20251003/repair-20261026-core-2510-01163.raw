<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E11.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq-{\color[rgb]{0,0,0}\alpha}{\log\ex_{#1}\left[\exp\left(-\ex_{{\color[rgb]{0,0,0}X}}{\log\frac{d\prob_{\!#1}(\cdot\nonscript\&gt;|\nonscript\&gt;\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{d\prob_{\!#1}(\cdot\nonscript\&gt;|\nonscript\&gt;\mathopen{}{\color[rgb]{0,0,0}\theta})}}\right)\right]}+{\color[rgb]{0,0,0}\alpha}{\mathrm{KL}}\!\left(\prob_{\!#1}(\cdot)\,\|\,\prob_{\!#1}\left(\cdot\nonscript\&gt;\middle|\nonscript\&gt;\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\right)\right)" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">≤</mo><mo lspace="0em">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">α</mi><mi>log</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi></msub><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℙ</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.220em">⋅</mo><mo fence="false" rspace="0.387em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mi>d</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℙ</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.220em">⋅</mo><mo fence="false" rspace="0.387em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>)</mo></mrow><mo>]</mo></mrow><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">α</mi><mpadded style="width:1.431em;" width="1.431em"><mi>KL</mi></mpadded><mrow><mo>(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℙ</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0.337em">∥</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℙ</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>(</mo><mo lspace="0em">⋅</mo><mo rspace="0.220em" stretchy="true">|</mo><mrow><mphantom></mphantom><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo>)</mo></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq-{\color[rgb]{0,0,0}\alpha}{\log\ex_{#1}\left[\exp\left(-\ex_{{\color[rgb]{0,0,0}X}}{\log\frac{d\prob_{\!#1}(\cdot\nonscript\&gt;|\nonscript\&gt;\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{d\prob_{\!#1}(\cdot\nonscript\&gt;|\nonscript\&gt;\mathopen{}{\color[rgb]{0,0,0}\theta})}}\right)\right]}+{\color[rgb]{0,0,0}\alpha}{\mathrm{KL}}\!\left(\prob_{\!#1}(\cdot)\,\|\,\prob_{\!#1}\left(\cdot\nonscript\&gt;\middle|\nonscript\&gt;\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\right)\right)</annotation></semantics></math></td>
