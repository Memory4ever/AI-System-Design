<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E81.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\exp\left(e^{-{\color[rgb]{0,0,0}R}_{\color[rgb]{0,0,0}T}/2}\poly({\color[rgb]{0,0,0}T})\right){\color[rgb]{0,0,0}\pi}\left(\lVert{\color[rgb]{0,0,0}\theta}\rVert&gt;{\color[rgb]{0,0,0}R}_{\color[rgb]{0,0,0}T}\right)" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>exp</mi><mrow><mo>(</mo><msup><mi>e</mi><mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo>/</mo><mn>2</mn></mrow></msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><mrow><mo>(</mo><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo fence="true" lspace="0em" rspace="0.1389em">∥</mo></mrow><mo lspace="0.1389em">&gt;</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\exp\left(e^{-{\color[rgb]{0,0,0}R}_{\color[rgb]{0,0,0}T}/2}\poly({\color[rgb]{0,0,0}T})\right){\color[rgb]{0,0,0}\pi}\left(\lVert{\color[rgb]{0,0,0}\theta}\rVert&gt;{\color[rgb]{0,0,0}R}_{\color[rgb]{0,0,0}T}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.81)</span></td></tr></tbody>
<tbody id="A4.E82"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E82.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\exp\left(e^{-{\color[rgb]{0,0,0}R}_{\color[rgb]{0,0,0}T}/2}\poly({\color[rgb]{0,0,0}T})\right)\frac{\ex_{#1}\left[\lVert{\color[rgb]{0,0,0}\theta}\rVert^{2}\right]}{{\color[rgb]{0,0,0}R}_{\color[rgb]{0,0,0}T}^{2}}\,," display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>exp</mi><mrow><mo>(</mo><msup><mi>e</mi><mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo>/</mo><mn>2</mn></mrow></msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0.170em">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\exp\left(e^{-{\color[rgb]{0,0,0}R}_{\color[rgb]{0,0,0}T}/2}\poly({\color[rgb]{0,0,0}T})\right)\frac{\ex_{#1}\left[\lVert{\color[rgb]{0,0,0}\theta}\rVert^{2}\right]}{{\color[rgb]{0,0,0}R}_{\color[rgb]{0,0,0}T}^{2}}\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.82)</span></td></tr></tbody>
</table>
<p id="A4.SS5.p3.2" class="ltx_p"><span id="A4.SS5.p3.2.1" class="ltx_text">where we used Markov’s inequality in the last line. Take <math id="A4.SS5.p3.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}R}_{\color[rgb]{0,0,0}T}={\color[rgb]{0,0,0}T}^{({\color[rgb]{0,0,0}d}+1)}/2" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo>=</mo><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mrow><mo stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}R}_{\color[rgb]{0,0,0}T}={\color[rgb]{0,0,0}T}^{({\color[rgb]{0,0,0}d}+1)}/2</annotation></semantics></math> so that <a href="#A4.E82" title="In Proof. ‣ D.5 Laplace Approximation ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">D.82</span></a> is <math id="A4.SS5.p3.m2" class="ltx_Math" alttext="\bigoh(1/{\color[rgb]{0,0,0}T}^{{\color[rgb]{0,0,0}d}+1})" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bigoh(1/{\color[rgb]{0,0,0}T}^{{\color[rgb]{0,0,0}d}+1})</annotation></semantics></math>.</span></p>
</div>
<div id="A4.SS5.p4" class="ltx_para">
<p id="A4.SS5.p4.1" class="ltx_p"><span id="A4.SS5.p4.1.1" class="ltx_text">We now focus on the first term of <a href="#A4.E78" title="In Proof. ‣ D.5 Laplace Approximation ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">D.78</span></a> and bound it as:</span></p>
<table id="A4.EGx32" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E83"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E83.m1" class="ltx_math_unparsed" alttext="\displaystyle\ex_{#1}\left[\log\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ex_{#1}\left[\log\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E83.m2" class="ltx_math_unparsed" alttext="\displaystyle=\ex_{#1}\left[\one\left\{\max_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\lVert{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\rVert\leq{\color[rgb]{0,0,0}r}_{\color[rgb]{0,0,0}T}\right\}\log\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right]+\ex_{#1}\left[\one\left\{\max_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\lVert{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\rVert&gt;{\color[rgb]{0,0,0}r}_{\color[rgb]{0,0,0}T}\right\}\log\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo>{</mo><munder><mi>max</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></munder><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo fence="true" lspace="0em" rspace="0.1389em">∥</mo></mrow><mo lspace="0.1389em">≤</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo rspace="0.167em">}</mo></mrow><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>]</mo></mrow><mo>+</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo>{</mo><munder><mi>max</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></munder><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo fence="true" lspace="0em" rspace="0.1389em">∥</mo></mrow><mo lspace="0.1389em">&gt;</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo rspace="0.167em">}</mo></mrow><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\ex_{#1}\left[\one\left\{\max_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\lVert{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\rVert\leq{\color[rgb]{0,0,0}r}_{\color[rgb]{0,0,0}T}\right\}\log\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right]+\ex_{#1}\left[\one\left\{\max_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\lVert{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\rVert&gt;{\color[rgb]{0,0,0}r}_{\color[rgb]{0,0,0}T}\right\}\log\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.83)</span></td></tr></tbody>
<tbody id="A4.E84"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E84.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\poly({\color[rgb]{0,0,0}r}_{\color[rgb]{0,0,0}T})T\lVert{\color[rgb]{0,0,0}\theta}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\rVert+\poly({\color[rgb]{0,0,0}T})e^{-{\color[rgb]{0,0,0}r}_{\color[rgb]{0,0,0}T}/2}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo stretchy="false">)</mo></mrow><mi>T</mi><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow><msup><mi>e</mi><mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo>/</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leq\poly({\color[rgb]{0,0,0}r}_{\color[rgb]{0,0,0}T})T\lVert{\color[rgb]{0,0,0}\theta}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\rVert+\poly({\color[rgb]{0,0,0}T})e^{-{\color[rgb]{0,0,0}r}_{\color[rgb]{0,0,0}T}/2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.84)</span></td></tr></tbody>
</table>
<p id="A4.SS5.p4.2" class="ltx_p"><span id="A4.SS5.p4.2.1" class="ltx_text">where we used the regularity assumption of <a href="#Thmassumption3" title="Assumption 3 (Data generation). ‣ D.3 ICL setting ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">3</span></a> for the first term and Cauchy-Schwarz inequality combined with <a href="#Thmassumption4" title="Assumption 4. ‣ D.5 Laplace Approximation ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">4</span></a> for the second term.</span></p>
</div>
<div id="A4.SS5.p5" class="ltx_para">
<p id="A4.SS5.p5.1" class="ltx_p"><span id="A4.SS5.p5.1.1" class="ltx_text">Take <math id="A4.SS5.p5.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}r}_{\color[rgb]{0,0,0}T}=\poly(\log{\color[rgb]{0,0,0}T})" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo>=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}r}_{\color[rgb]{0,0,0}T}=\poly(\log{\color[rgb]{0,0,0}T})</annotation></semantics></math> so that <math id="A4.SS5.p5.m2" class="ltx_math_unparsed" alttext="\poly({\color[rgb]{0,0,0}T})e^{-{\color[rgb]{0,0,0}r}_{\color[rgb]{0,0,0}T}/2}=\bigoh(1)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow><msup><mi>e</mi><mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo>/</mo><mn>2</mn></mrow></msup><mo>=</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒪</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\poly({\color[rgb]{0,0,0}T})e^{-{\color[rgb]{0,0,0}r}_{\color[rgb]{0,0,0}T}/2}=\bigoh(1)</annotation></semantics></math> and assume that <math id="A4.SS5.p5.m3" class="ltx_Math" alttext="{\color[rgb]{0,0,0}T}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}T}</annotation></semantics></math> is large enough so that <math id="A4.SS5.p5.m4" class="ltx_Math" alttext="{\color[rgb]{0,0,0}r}_{\color[rgb]{0,0,0}T}\geq\lVert{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\rVert+1" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo rspace="0.1389em">≥</mo><mrow><mrow><mo fence="true" lspace="0.1389em" rspace="0em">∥</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}r}_{\color[rgb]{0,0,0}T}\geq\lVert{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\rVert+1</annotation></semantics></math>.</span></p>
</div>
<div id="A4.SS5.p6" class="ltx_para">
<p id="A4.SS5.p6.1" class="ltx_p"><span id="A4.SS5.p6.1.1" class="ltx_text">Putting everything together, we have</span></p>
<table id="A4.EGx33" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E85"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E85.m1" class="ltx_math_unparsed" alttext="\displaystyle-\log\left(\ex_{#1}\left[\exp\left(-\ex_{#1}\left[\log\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right]\right)\right]\right)" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>log</mi><mrow><mo>(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>]</mo></mrow><mo>)</mo></mrow><mo>]</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\log\left(\ex_{#1}\left[\exp\left(-\ex_{#1}\left[\log\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right]\right)\right]\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.85)</span></td></tr></tbody>
<tbody id="A4.E86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E86.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq-\log\left(\ex_{#1}\left[\one\left\{\lVert{\color[rgb]{0,0,0}\theta}\rVert\leq{\color[rgb]{0,0,0}r}_{\color[rgb]{0,0,0}T}\right\}\exp\left(-\poly({\color[rgb]{0,0,0}r}_{\color[rgb]{0,0,0}T}){\color[rgb]{0,0,0}T}\lVert{\color[rgb]{0,0,0}\theta}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\rVert+\bigoh(1)\right)+\bigoh\left(\frac{1}{{\color[rgb]{0,0,0}T}^{{\color[rgb]{0,0,0}d}+1}}\right)\right]\right)" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">≤</mo><mo lspace="0em">−</mo><mi>log</mi><mrow><mo>(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo>{</mo><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo fence="true" lspace="0em" rspace="0.1389em">∥</mo></mrow><mo lspace="0.1389em">≤</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo rspace="0.167em">}</mo></mrow><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo stretchy="false">)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><mo>+</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒪</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>+</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒪</mi><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mo>+</mo><mn>1</mn></mrow></msup></mfrac></mstyle><mo>)</mo></mrow><mo>]</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq-\log\left(\ex_{#1}\left[\one\left\{\lVert{\color[rgb]{0,0,0}\theta}\rVert\leq{\color[rgb]{0,0,0}r}_{\color[rgb]{0,0,0}T}\right\}\exp\left(-\poly({\color[rgb]{0,0,0}r}_{\color[rgb]{0,0,0}T}){\color[rgb]{0,0,0}T}\lVert{\color[rgb]{0,0,0}\theta}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\rVert+\bigoh(1)\right)+\bigoh\left(\frac{1}{{\color[rgb]{0,0,0}T}^{{\color[rgb]{0,0,0}d}+1}}\right)\right]\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.86)</span></td></tr></tbody>
<tbody id="A4.E87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E87.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq-\log\left(\ex_{#1}\left[\one\left\{\lVert{\color[rgb]{0,0,0}\theta}\rVert\leq\lVert{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\rVert+1\right\}\exp\left(-\poly(\log{\color[rgb]{0,0,0}T}){\color[rgb]{0,0,0}T}\lVert{\color[rgb]{0,0,0}\theta}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\rVert+\bigoh(1)\right)+\bigoh\left(\frac{1}{{\color[rgb]{0,0,0}T}^{{\color[rgb]{0,0,0}d}+1}}\right)\right]\right)\,," display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">≤</mo><mo lspace="0em">−</mo><mi>log</mi><mrow><mo>(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo>{</mo><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo fence="true" lspace="0em" rspace="0.1389em">∥</mo></mrow><mo lspace="0.1389em" rspace="0.1389em">≤</mo><mrow><mo fence="true" lspace="0.1389em" rspace="0em">∥</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><mo>+</mo><mn>1</mn><mo rspace="0.167em">}</mo></mrow><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mrow><mo stretchy="false">(</mo><mi>log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><mo>+</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒪</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>+</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒪</mi><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mo>+</mo><mn>1</mn></mrow></msup></mfrac></mstyle><mo>)</mo></mrow><mo>]</mo></mrow><mo rspace="0.170em">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq-\log\left(\ex_{#1}\left[\one\left\{\lVert{\color[rgb]{0,0,0}\theta}\rVert\leq\lVert{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\rVert+1\right\}\exp\left(-\poly(\log{\color[rgb]{0,0,0}T}){\color[rgb]{0,0,0}T}\lVert{\color[rgb]{0,0,0}\theta}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\rVert+\bigoh(1)\right)+\bigoh\left(\frac{1}{{\color[rgb]{0,0,0}T}^{{\color[rgb]{0,0,0}d}+1}}\right)\right]\right)\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.87)</span></td></tr></tbody>
</table>
<p id="A4.SS5.p6.2" class="ltx_p"><span id="A4.SS5.p6.2.1" class="ltx_text">where we used that we assumed that <math id="A4.SS5.p6.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}r}_{\color[rgb]{0,0,0}T}=\poly(\log{\color[rgb]{0,0,0}T})\geq\lVert{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\rVert+1" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo>=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">≥</mo><mrow><mrow><mo fence="true" lspace="0.1389em" rspace="0em">∥</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}r}_{\color[rgb]{0,0,0}T}=\poly(\log{\color[rgb]{0,0,0}T})\geq\lVert{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\rVert+1</annotation></semantics></math>.</span></p>
</div>
<div id="A4.SS5.p7" class="ltx_para">
<p id="A4.SS5.p7.1" class="ltx_p"><span id="A4.SS5.p7.1.1" class="ltx_text">Applying <a href="#A4.Thmlemma5" title="Lemma D.5 (Laplace approximation). ‣ D.5 Laplace Approximation ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">D.5</span></a> with <math id="A4.SS5.p7.m1" class="ltx_Math" alttext="\varepsilon=1/(\poly(\log{\color[rgb]{0,0,0}T}){\color[rgb]{0,0,0}T})" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>=</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\varepsilon=1/(\poly(\log{\color[rgb]{0,0,0}T}){\color[rgb]{0,0,0}T})</annotation></semantics></math> yields:</span></p>
<table id="A4.EGx34" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E88.m1" class="ltx_math_unparsed" alttext="\displaystyle\ex_{#1}\left[\one\left\{\lVert{\color[rgb]{0,0,0}\theta}\rVert\leq\lVert{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\rVert+1\right\}\exp\left(-\poly(\log{\color[rgb]{0,0,0}T}){\color[rgb]{0,0,0}T}\lVert{\color[rgb]{0,0,0}\theta}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\rVert\right)\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo>{</mo><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo fence="true" lspace="0em" rspace="0.1389em">∥</mo></mrow><mo lspace="0.1389em" rspace="0.1389em">≤</mo><mrow><mo fence="true" lspace="0.1389em" rspace="0em">∥</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><mo>+</mo><mn>1</mn><mo rspace="0.167em">}</mo></mrow><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mrow><mo stretchy="false">(</mo><mi>log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><mo>)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ex_{#1}\left[\one\left\{\lVert{\color[rgb]{0,0,0}\theta}\rVert\leq\lVert{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\rVert+1\right\}\exp\left(-\poly(\log{\color[rgb]{0,0,0}T}){\color[rgb]{0,0,0}T}\lVert{\color[rgb]{0,0,0}\theta}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}\rVert\right)\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E88.m2" class="ltx_Math" alttext="\displaystyle=\poly(\log{\color[rgb]{0,0,0}T}){\color[rgb]{0,0,0}T}^{-{\color[rgb]{0,0,0}d}}\left({\color[rgb]{0,0,0}\pi}({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})C+o(1)\right)\,," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.170em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\poly(\log{\color[rgb]{0,0,0}T}){\color[rgb]{0,0,0}T}^{-{\color[rgb]{0,0,0}d}}\left({\color[rgb]{0,0,0}\pi}({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})C+o(1)\right)\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.88)</span></td></tr></tbody>
</table>
<p id="A4.SS5.p7.2" class="ltx_p"><span id="A4.SS5.p7.2.1" class="ltx_text">where <math id="A4.SS5.p7.m2" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> is the constant of <a href="#A4.Thmlemma5" title="Lemma D.5 (Laplace approximation). ‣ D.5 Laplace Approximation ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">D.5</span></a> and this concludes the proof.</span></p>
</div>
<div id="A4.SS5.p8" class="ltx_para">
<p id="A4.SS5.p8.1" class="ltx_p"><span id="A4.SS5.p8.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A4.SS5.p9" class="ltx_para">
<p id="A4.SS5.p9.1" class="ltx_p">We can now combine <a href="#A4.Thmtheorem1" title="Theorem D.1. ‣ D.4 Task Selection Bound for ICL ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorems</span> <span class="ltx_text ltx_ref_tag">D.1</span></a> and <a href="#A4.Thmproposition2" title="Proposition D.2. ‣ D.5 Laplace Approximation ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.2</span></a> to obtain the final result in the main text.</p>
</div>
<div id="A4.Thmtheorem2" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A4.Thmtheorem2.2" class="ltx_text ltx_font_bold">Theorem D.2</span></span><span id="A4.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A4.Thmtheorem2.p1" class="ltx_para">
<p id="A4.Thmtheorem2.p1.1" class="ltx_p"><span id="A4.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Under <a href="#Thmassumption3" title="Assumption 3 (Data generation). ‣ D.3 ICL setting ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumptions</span> <span class="ltx_text ltx_ref_tag">3</span></a> and <a href="#Thmassumption4" title="Assumption 4. ‣ D.5 Laplace Approximation ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, for any <math id="A4.Thmtheorem2.p1.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\rho}\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\rho}\in(0,1)</annotation></semantics></math>,
<math id="A4.Thmtheorem2.p1.m2" class="ltx_Math" alttext="{\color[rgb]{0,0,0}T}\geq 1" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}T}\geq 1</annotation></semantics></math>,
it holds that, for <math id="A4.Thmtheorem2.p1.m3" class="ltx_math_unparsed" alttext="{\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\sim\density_{#1}(\cdot\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta}^{*})" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo>∼</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi mathvariant="normal">#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em">⋅</mo><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\sim\density_{#1}(\cdot\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta}^{*})</annotation></semantics></math>,</span></p>
<table id="A4.EGx35" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E89"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E89.m1" class="ltx_math_unparsed" alttext="\displaystyle\ex_{#1}\left[\ex_{#1}\left[\mathrm{D}_{#1}\!({\color[rgb]{0,0,0}\theta}\,\|\,{\color[rgb]{0,0,0}\theta}^{*})\right]\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><msub><mi>D</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo lspace="0.170em" rspace="0.337em">∥</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ex_{#1}\left[\ex_{#1}\left[\mathrm{D}_{#1}\!({\color[rgb]{0,0,0}\theta}\,\|\,{\color[rgb]{0,0,0}\theta}^{*})\right]\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.89)</span></td></tr></tbody>
<tbody id="A4.E90"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E90.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq-\frac{1+{\color[rgb]{0,0,0}\rho}}{(1-{\color[rgb]{0,0,0}\rho}){\color[rgb]{0,0,0}T}}\log 1/{\color[rgb]{0,0,0}\pi}({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">≤</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></mfrac></mstyle><mi>log</mi><mn>1</mn><mo>/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq-\frac{1+{\color[rgb]{0,0,0}\rho}}{(1-{\color[rgb]{0,0,0}\rho}){\color[rgb]{0,0,0}T}}\log 1/{\color[rgb]{0,0,0}\pi}({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.90)</span></td></tr></tbody>
<tbody id="A4.E91"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E91.m1" class="ltx_Math" alttext="\displaystyle\quad+\frac{1+{\color[rgb]{0,0,0}\rho}}{1-{\color[rgb]{0,0,0}\rho}}\frac{{\mathrm{KL}}\!(\density_{#1}(\cdot\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta}^{*})\,\|\,\density_{#1}(\cdot\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}))}{{\color[rgb]{0,0,0}T}}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mpadded style="width:1.431em;" width="1.431em"><mi>KL</mi></mpadded><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em">⋅</mo><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msup><mrow></mrow><mo>∗</mo></msup><mo stretchy="false">)</mo><mo lspace="0.170em" rspace="0.337em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em">⋅</mo><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\frac{1+{\color[rgb]{0,0,0}\rho}}{1-{\color[rgb]{0,0,0}\rho}}\frac{{\mathrm{KL}}\!(\density_{#1}(\cdot\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta}^{*})\,\|\,\density_{#1}(\cdot\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}))}{{\color[rgb]{0,0,0}T}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.91)</span></td></tr></tbody>
<tbody id="A4.E92"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E92.m1" class="ltx_Math" alttext="\displaystyle+\bigoh\left(\frac{\log({\color[rgb]{0,0,0}T})}{{\color[rgb]{0,0,0}T}}\right)\,," display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">+</mo><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mfrac></mstyle><mo rspace="0.170em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\bigoh\left(\frac{\log({\color[rgb]{0,0,0}T})}{{\color[rgb]{0,0,0}T}}\right)\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.92)</span></td></tr></tbody>
</table>
<p id="A4.Thmtheorem2.p1.2" class="ltx_p"><span id="A4.Thmtheorem2.p1.2.1" class="ltx_text ltx_font_italic">where the <math id="A4.Thmtheorem2.p1.m4" class="ltx_Math" alttext="\bigoh(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bigoh(\cdot)</annotation></semantics></math> hides constants that do not depend on <math id="A4.Thmtheorem2.p1.m5" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\pi}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\pi}</annotation></semantics></math> or <math id="A4.Thmtheorem2.p1.m6" class="ltx_Math" alttext="{\color[rgb]{0,0,0}T}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}T}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A4.SS5.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS5.p10" class="ltx_para">
<p id="A4.SS5.p10.1" class="ltx_p"><span id="A4.SS5.p10.1.1" class="ltx_text">This is a direct consequence of <a href="#A4.Thmtheorem1" title="Theorem D.1. ‣ D.4 Task Selection Bound for ICL ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorems</span> <span class="ltx_text ltx_ref_tag">D.1</span></a> and <a href="#A4.Thmproposition2" title="Proposition D.2. ‣ D.5 Laplace Approximation ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.2</span></a>.
∎</span></p>
</div>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
</section>
<section id="A5" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix E </span>Generalization bounds</h2>

<section id="A5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.1 </span>Moment bounds for general functions</h3>

<div id="A5.SS1.p1" class="ltx_para">
<p id="A5.SS1.p1.1" class="ltx_p">In this subsection, we generalize the heavy-tail concentration results of <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib31" title="" class="ltx_ref">Li and Liu (2024a)</a></cite> to allow for non-i.i.d. data.
This section can also be seen as extending concentration results for dependent sequences to the case where the function of interest does not necessarily admit bounded differences but only bounded moments.
In particular, <a href="#A5.Thmlemma1" title="Lemma E.1. ‣ E.1 Moment bounds for general functions ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">E.1</span></a> extends the coupling argument of <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib16" title="" class="ltx_ref">Chazottes et al. (2007)</a></cite> to our setting, in particular not requiring bounded differences but only bounded moments. Indeed, for this, we replace the total variation distance by the Wasserstein-1 distance. It can also be seen as an extension of the bounded differences result of <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib25" title="" class="ltx_ref">Kontorovich and Ramanan (2008)</a></cite> to our setting (see <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib42" title="" class="ltx_ref">Mohri and Rostamizadeh (2010)</a></cite> for a presentation of the results of <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib25" title="" class="ltx_ref">Kontorovich and Ramanan (2008)</a></cite> in a setting closer to ours).
Moreover, note that even the handling of the subGaussian increments is much more trickier than in <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib24" title="" class="ltx_ref">Kontorovich (2014)</a></cite>, since we have to carefully apply a convex domination argument to handle the conditional dependence.
The main result of this section is <a href="#A5.Thmtheorem1" title="Theorem E.1 (Causal symmetrization). ‣ E.1 Moment bounds for general functions ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">E.1</span></a>, which is of independent interest.</p>
</div>
<div id="A5.SS1.p2" class="ltx_para">
<p id="A5.SS1.p2.1" class="ltx_p">As in the previous section, <math id="A5.SS1.p2.m1" class="ltx_Math" alttext="\lVert\cdot\rVert" display="inline" intent=":literal"><semantics><mrow><mo fence="true" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="true" lspace="0em">∥</mo></mrow><annotation encoding="application/x-tex">\lVert\cdot\rVert</annotation></semantics></math> denotes the Euclidean norm on <math id="A5.SS1.p2.m2" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\mathbb{R}}^{d}" display="inline" intent=":literal"><semantics><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mi>d</mi></msup><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\mathbb{R}}^{d}</annotation></semantics></math> for any <math id="A5.SS1.p2.m3" class="ltx_Math" alttext="d\in{\color[rgb]{0,0,0}\mathbb{N}}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℕ</mi></mrow><annotation encoding="application/x-tex">d\in{\color[rgb]{0,0,0}\mathbb{N}}</annotation></semantics></math>.</p>
</div>
<div id="A5.SS1.p3" class="ltx_para">
<p id="A5.SS1.p3.1" class="ltx_p">At multiple places, we will use the Wasserstein-1 distance<span id="footnote4" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">§</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">§</sup>
              <span class="ltx_tag ltx_tag_note">§</span>
              
              
              
              
              
              
              
            This is a slight abuse of terminology, since the Wasserstein-1 distance is usually defined for metric spaces, while we only assume <math id="footnote4.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> to be a cost function. However, this slight abuse of terminology will not cause any confusion in the following.</span></span></span>
with respect to a cost function <math id="A5.SS1.p3.m1" class="ltx_Math" alttext="\rho\colon\mathcal{Z}\times\mathcal{Z}\to[0,\infty)" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒵</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho\colon\mathcal{Z}\times\mathcal{Z}\to[0,\infty)</annotation></semantics></math>, defined as</p>
<table id="A5.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E1.m1" class="ltx_Math" alttext="W_{#1}(\mu,\nu):=\inf_{\pi\in\Pi(\mu,\nu)}\int\rho(z,z^{\prime})d\pi(z,z^{\prime})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>W</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo>,</mo><mi>ν</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">:=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">inf</mo><mrow><mi>π</mi><mo>∈</mo><mrow><mi mathvariant="normal">Π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo>,</mo><mi>ν</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><mo>∫</mo><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo>,</mo><msup><mi>z</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>π</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo>,</mo><msup><mi>z</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">W_{#1}(\mu,\nu):=\inf_{\pi\in\Pi(\mu,\nu)}\int\rho(z,z^{\prime})d\pi(z,z^{\prime}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.1)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p3.2" class="ltx_p">where <math id="A5.SS1.p3.m2" class="ltx_Math" alttext="\Pi(\mu,\nu)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo>,</mo><mi>ν</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Pi(\mu,\nu)</annotation></semantics></math> is the set of couplings of <math id="A5.SS1.p3.m3" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math> and <math id="A5.SS1.p3.m4" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math>. We refer to the textbook <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib56" title="" class="ltx_ref">Villani (2008)</a></cite> for more details.</p>
</div>
<div id="A5.Thmlemma1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A5.Thmlemma1.2" class="ltx_text ltx_font_bold">Lemma E.1</span></span><span id="A5.Thmlemma1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A5.Thmlemma1.p1" class="ltx_para">
<p id="A5.Thmlemma1.p1.1" class="ltx_p"><span id="A5.Thmlemma1.p1.1.1" class="ltx_text ltx_font_italic">Consider <math id="A5.Thmlemma1.p1.m1" class="ltx_Math" alttext="\mathcal{Z}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒵</mi><annotation encoding="application/x-tex">\mathcal{Z}</annotation></semantics></math> measurable space. Let <math id="A5.Thmlemma1.p1.m2" class="ltx_Math" alttext="Z_{1},\ldots,Z_{m}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>Z</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">Z_{1},\ldots,Z_{m}</annotation></semantics></math> be <math id="A5.Thmlemma1.p1.m3" class="ltx_Math" alttext="\mathcal{Z}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒵</mi><annotation encoding="application/x-tex">\mathcal{Z}</annotation></semantics></math>-valued random variables with natural filtration <math id="A5.Thmlemma1.p1.m4" class="ltx_Math" alttext="\mathcal{F}_{i}:=\sigma(Z_{1},\ldots,Z_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub><mo>:=</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>Z</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}_{i}:=\sigma(Z_{1},\ldots,Z_{i})</annotation></semantics></math>. For each <math id="A5.Thmlemma1.p1.m5" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, assume there is <math id="A5.Thmlemma1.p1.m6" class="ltx_Math" alttext="Z_{i}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>Z</mi><mi>i</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">Z_{i}^{\prime}</annotation></semantics></math> such that</span></p>
<table id="A5.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E2.m1" class="ltx_math_unparsed" alttext="Z_{i}^{\prime}\sim\text{Law}(Z_{i}\mid\mathcal{F}_{i-1}),\quad Z_{i}^{\prime}\perp\!\!\!\perp Z_{i}\mid\mathcal{F}_{i-1}." display="block" intent=":literal"><semantics><mrow><msubsup><mi>Z</mi><mi>i</mi><mo>′</mo></msubsup><mo>∼</mo><mtext class="ltx_mathvariant_italic">Law</mtext><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo rspace="1.167em">,</mo><msubsup><mi>Z</mi><mi>i</mi><mo>′</mo></msubsup><mpadded style="width:0.240em;" width="0.240em"><mo>⟂</mo></mpadded><mo>⟂</mo><msub><mi>Z</mi><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Z_{i}^{\prime}\sim\text{Law}(Z_{i}\mid\mathcal{F}_{i-1}),\quad Z_{i}^{\prime}\perp\!\!\!\perp Z_{i}\mid\mathcal{F}_{i-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.2)</span></td></tr></tbody>
</table>
</div>
<div id="A5.Thmlemma1.p2" class="ltx_para">
<p id="A5.Thmlemma1.p2.1" class="ltx_p"><span id="A5.Thmlemma1.p2.1.1" class="ltx_text ltx_font_italic">Let <math id="A5.Thmlemma1.p2.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}g}\colon\mathcal{Z}^{m}\to{\color[rgb]{0,0,0}\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">g</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒵</mi><mi>m</mi></msup><mo stretchy="false">→</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}g}\colon\mathcal{Z}^{m}\to{\color[rgb]{0,0,0}\mathbb{R}}</annotation></semantics></math> be measurable and coordinate-wise Lipschitz with respect to cost functions <math id="A5.Thmlemma1.p2.m2" class="ltx_Math" alttext="\rho_{i}\colon\mathcal{Z}\times\mathcal{Z}\to[0,\infty)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒵</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho_{i}\colon\mathcal{Z}\times\mathcal{Z}\to[0,\infty)</annotation></semantics></math> such that <math id="A5.Thmlemma1.p2.m3" class="ltx_Math" alttext="\rho_{i}(z_{i},z_{i})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ρ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>i</mi></msub><mo>,</mo><msub><mi>z</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\rho_{i}(z_{i},z_{i})=0</annotation></semantics></math>,
with constants <math id="A5.Thmlemma1.p2.m4" class="ltx_Math" alttext="L_{i}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">L_{i}\geq 0</annotation></semantics></math>: for any <math id="A5.Thmlemma1.p2.m5" class="ltx_Math" alttext="z,z^{\prime}\in\mathcal{Z}^{m}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>,</mo><mrow><msup><mi>z</mi><mo>′</mo></msup><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒵</mi><mi>m</mi></msup></mrow></mrow><annotation encoding="application/x-tex">z,z^{\prime}\in\mathcal{Z}^{m}</annotation></semantics></math> differing only in the <math id="A5.Thmlemma1.p2.m6" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th coordinate,</span></p>
<table id="A5.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E3.m1" class="ltx_Math" alttext="\lvert{\color[rgb]{0,0,0}g}(z)-{\color[rgb]{0,0,0}g}(z^{\prime})\rvert\leq L_{i}\rho_{i}(z_{i},z_{i}^{\prime})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>z</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>z</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lvert{\color[rgb]{0,0,0}g}(z)-{\color[rgb]{0,0,0}g}(z^{\prime})\rvert\leq L_{i}\rho_{i}(z_{i},z_{i}^{\prime}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.3)</span></td></tr></tbody>
</table>
</div>
<div id="A5.Thmlemma1.p3" class="ltx_para">
<p id="A5.Thmlemma1.p3.1" class="ltx_p"><span id="A5.Thmlemma1.p3.1.1" class="ltx_text ltx_font_italic">With <math id="A5.Thmlemma1.p3.m1" class="ltx_Math" alttext="W_{#1}(\cdot,\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mrow><mi mathvariant="normal">#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">W_{#1}(\cdot,\cdot)</annotation></semantics></math> the Wasserstein-1 distance with respect to <math id="A5.Thmlemma1.p3.m2" class="ltx_Math" alttext="\rho_{j}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\rho_{j}</annotation></semantics></math>, define, for <math id="A5.Thmlemma1.p3.m3" class="ltx_Math" alttext="i&lt;j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>&lt;</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i&lt;j</annotation></semantics></math>,</span></p>
<table id="A5.E4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E4.m1" class="ltx_math_unparsed" alttext="\delta_{i,j}(z_{1:i},z_{i}^{\prime})=W_{#1}(\text{Law}(Z_{j}\mid Z_{1:i}=z_{1:i}),\text{Law}(Z_{j}\mid Z_{1:i-1}=z_{1:i-1},Z_{i}=z_{i}^{\prime}))." display="block" intent=":literal"><semantics><mrow><msub><mi>δ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo>,</mo><msubsup><mi>z</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>W</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mtext class="ltx_mathvariant_italic">Law</mtext><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>j</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo>=</mo><msub><mi>z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mtext class="ltx_mathvariant_italic">Law</mtext><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>j</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>=</mo><msub><mi>z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msub><mi>Z</mi><mi>i</mi></msub><mo>=</mo><msubsup><mi>z</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\delta_{i,j}(z_{1:i},z_{i}^{\prime})=W_{#1}(\text{Law}(Z_{j}\mid Z_{1:i}=z_{1:i}),\text{Law}(Z_{j}\mid Z_{1:i-1}=z_{1:i-1},Z_{i}=z_{i}^{\prime})).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.4)</span></td></tr></tbody>
</table>
<p id="A5.Thmlemma1.p3.2" class="ltx_p"><span id="A5.Thmlemma1.p3.2.1" class="ltx_text ltx_font_italic">for <math id="A5.Thmlemma1.p3.m4" class="ltx_Math" alttext="i\in\{1,\ldots,m\}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>m</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\{1,\ldots,m\}</annotation></semantics></math>,</span></p>
<table id="A5.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E5.m1" class="ltx_math_unparsed" alttext="\lvert\ex[{\color[rgb]{0,0,0}g}(Z_{1:m})\nonscript\,|\nonscript\,\mathopen{}\mathcal{F}_{i}]-\ex[{\color[rgb]{0,0,0}g}(Z_{1:i-1},Z_{i}^{\prime},Z_{i+1:m})\nonscript\,|\nonscript\,\mathopen{}\mathcal{F}_{i-1},Z_{i}^{\prime}]\rvert\leq L_{i}\rho_{i}(Z_{i},Z_{i}^{\prime})+\sum_{j=i+1}^{m}L_{j}\delta_{i,j}(Z_{1:i},Z_{i}^{\prime})" display="block" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">g</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>m</mi></mrow></msub><mo rspace="0.170em" stretchy="false">)</mo></mrow><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">g</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msubsup><mi>Z</mi><mi>i</mi><mo>′</mo></msubsup><mo>,</mo><msub><mi>Z</mi><mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>m</mi></mrow></msub><mo rspace="0.170em" stretchy="false">)</mo></mrow><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msubsup><mi>Z</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">]</mo></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><msub><mi>L</mi><mi>i</mi></msub><msub><mi>ρ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>Z</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo rspace="0.055em">+</mo><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>m</mi></munderover><msub><mi>L</mi><mi>j</mi></msub><msub><mi>δ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo>,</mo><msubsup><mi>Z</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lvert\ex[{\color[rgb]{0,0,0}g}(Z_{1:m})\nonscript\,|\nonscript\,\mathopen{}\mathcal{F}_{i}]-\ex[{\color[rgb]{0,0,0}g}(Z_{1:i-1},Z_{i}^{\prime},Z_{i+1:m})\nonscript\,|\nonscript\,\mathopen{}\mathcal{F}_{i-1},Z_{i}^{\prime}]\rvert\leq L_{i}\rho_{i}(Z_{i},Z_{i}^{\prime})+\sum_{j=i+1}^{m}L_{j}\delta_{i,j}(Z_{1:i},Z_{i}^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.5)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS1.p4" class="ltx_para">
<p id="A5.SS1.p4.1" class="ltx_p"><span id="A5.SS1.p4.1.1" class="ltx_text">Fix <math id="A5.SS1.p4.m1" class="ltx_Math" alttext="i\in\{1,\ldots,m\}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>m</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\{1,\ldots,m\}</annotation></semantics></math>. We condition on <math id="A5.SS1.p4.m2" class="ltx_Math" alttext="\mathcal{F}_{i-1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\mathcal{F}_{i-1}</annotation></semantics></math>. Let <math id="A5.SS1.p4.m3" class="ltx_Math" alttext="u:=Z_{i}" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>:=</mo><msub><mi>Z</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">u:=Z_{i}</annotation></semantics></math> and <math id="A5.SS1.p4.m4" class="ltx_Math" alttext="u^{\prime}:=Z_{i}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>u</mi><mo>′</mo></msup><mo>:=</mo><msubsup><mi>Z</mi><mi>i</mi><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">u^{\prime}:=Z_{i}^{\prime}</annotation></semantics></math>.
Not to overburden notations, all expectations and probabilities in the following are conditional on <math id="A5.SS1.p4.m5" class="ltx_Math" alttext="\mathcal{F}_{i-1},Z_{i}=u,Z_{i}^{\prime}=u^{\prime}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>Z</mi><mi>i</mi></msub></mrow><mo>=</mo><mi>u</mi></mrow><mo>,</mo><mrow><msubsup><mi>Z</mi><mi>i</mi><mo>′</mo></msubsup><mo>=</mo><msup><mi>u</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}_{i-1},Z_{i}=u,Z_{i}^{\prime}=u^{\prime}</annotation></semantics></math>.
Define the tail functions</span></p>
<table id="A5.EGx36" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E6.m1" class="ltx_math_unparsed" alttext="\displaystyle{\color[rgb]{0,0,0}\psi}(z_{i+1:m})" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ψ</mi><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>m</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\color[rgb]{0,0,0}\psi}(z_{i+1:m})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E6.m2" class="ltx_math_unparsed" alttext="\displaystyle:={\color[rgb]{0,0,0}g}(Z_{1:(i-1)},u,z_{i+1:m})," display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">:</mo><mo lspace="0em">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">g</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><mi>u</mi><mo>,</mo><msub><mi>z</mi><mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>m</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle:={\color[rgb]{0,0,0}g}(Z_{1:(i-1)},u,z_{i+1:m}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.6)</span></td></tr></tbody>
<tbody id="A5.E7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E7.m1" class="ltx_math_unparsed" alttext="\displaystyle{\color[rgb]{0,0,0}\psi}^{\prime}(z_{i+1:m})" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ψ</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>m</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\color[rgb]{0,0,0}\psi}^{\prime}(z_{i+1:m})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E7.m2" class="ltx_math_unparsed" alttext="\displaystyle:={\color[rgb]{0,0,0}g}(Z_{1:(i-1)},u^{\prime},z_{i+1:m})." display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">:</mo><mo lspace="0em">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">g</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><msup><mi>u</mi><mo>′</mo></msup><mo>,</mo><msub><mi>z</mi><mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>m</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle:={\color[rgb]{0,0,0}g}(Z_{1:(i-1)},u^{\prime},z_{i+1:m}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.7)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS1.p5" class="ltx_para">
<p id="A5.SS1.p5.1" class="ltx_p"><span id="A5.SS1.p5.1.1" class="ltx_text">Denote <math id="A5.SS1.p5.m1" class="ltx_math_unparsed" alttext="Z_{(i+1):m}\sim\text{Law}(Z_{(i+1):m}\mid\mathcal{F}_{i-1},Z_{i}=u)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>m</mi></mrow></msub><mo>∼</mo><mtext>Law</mtext><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>Z</mi><mi>i</mi></msub><mo>=</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z_{(i+1):m}\sim\text{Law}(Z_{(i+1):m}\mid\mathcal{F}_{i-1},Z_{i}=u)</annotation></semantics></math> and
<math id="A5.SS1.p5.m2" class="ltx_math_unparsed" alttext="Z_{(i+1):m}^{\prime}\sim\text{Law}(Z_{(i+1):m}\mid\mathcal{F}_{i-1},Z_{i}=u^{\prime})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Z</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>m</mi></mrow><mo>′</mo></msubsup><mo>∼</mo><mtext>Law</mtext><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>Z</mi><mi>i</mi></msub><mo>=</mo><msup><mi>u</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z_{(i+1):m}^{\prime}\sim\text{Law}(Z_{(i+1):m}\mid\mathcal{F}_{i-1},Z_{i}=u^{\prime})</annotation></semantics></math>. We decompose</span></p>
<table id="A5.EGx37" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E8.m1" class="ltx_math_unparsed" alttext="\displaystyle\lvert\ex[{\color[rgb]{0,0,0}g}(Z_{1:m})]-\ex[{\color[rgb]{0,0,0}g}(Z_{1:(i-1)},Z_{i:m}^{\prime})]\rvert" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">g</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>m</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">g</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><msubsup><mi>Z</mi><mrow><mi>i</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>m</mi></mrow><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lvert\ex[{\color[rgb]{0,0,0}g}(Z_{1:m})]-\ex[{\color[rgb]{0,0,0}g}(Z_{1:(i-1)},Z_{i:m}^{\prime})]\rvert</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.8)</span></td></tr></tbody>
<tbody id="A5.E9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E9.m1" class="ltx_math_unparsed" alttext="\displaystyle=\big|\ex[{\color[rgb]{0,0,0}\psi}(Z_{(i+1):m})]-\ex[{\color[rgb]{0,0,0}\psi}^{\prime}(Z_{(i+1):m}^{\prime})]\big|" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.167em" stretchy="true">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ψ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>m</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ψ</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>Z</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>m</mi></mrow><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo fence="false" maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\big|\ex[{\color[rgb]{0,0,0}\psi}(Z_{(i+1):m})]-\ex[{\color[rgb]{0,0,0}\psi}^{\prime}(Z_{(i+1):m}^{\prime})]\big|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.9)</span></td></tr></tbody>
<tbody id="A5.E10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E10.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\ex\left[\big|{\color[rgb]{0,0,0}\psi}(Z_{(i+1):m})-{\color[rgb]{0,0,0}\psi}^{\prime}(Z_{(i+1):m})\big|\right]+\Big|\ex\left[{\color[rgb]{0,0,0}\psi}^{\prime}(Z_{(i+1):m})\right]-\ex\left[{\color[rgb]{0,0,0}\psi}^{\prime}(Z_{(i+1):m}^{\prime})\right]\Big|." display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.167em" stretchy="true">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ψ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>m</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ψ</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>m</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.167em" stretchy="true">|</mo><mo>]</mo></mrow><mo rspace="0em">+</mo><mo fence="false" maxsize="1.600em" minsize="1.600em" rspace="0.167em" stretchy="true">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ψ</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>m</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ψ</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>Z</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>m</mi></mrow><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0.167em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\ex\left[\big|{\color[rgb]{0,0,0}\psi}(Z_{(i+1):m})-{\color[rgb]{0,0,0}\psi}^{\prime}(Z_{(i+1):m})\big|\right]+\Big|\ex\left[{\color[rgb]{0,0,0}\psi}^{\prime}(Z_{(i+1):m})\right]-\ex\left[{\color[rgb]{0,0,0}\psi}^{\prime}(Z_{(i+1):m}^{\prime})\right]\Big|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.10)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS1.p6" class="ltx_para">
<p id="A5.SS1.p6.1" class="ltx_p"><span id="A5.SS1.p6.1.1" class="ltx_text">We bound the two terms separately.</span></p>
</div>
<div id="A5.SS1.p7" class="ltx_para">
<p id="A5.SS1.p7.1" class="ltx_p"><span id="A5.SS1.p7.1.1" class="ltx_text">By the coordinate-wise Lipschitz condition at <math id="A5.SS1.p7.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>,</span></p>
<table id="A5.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E11.m1" class="ltx_math_unparsed" alttext="\ex_{#1}\left[|{\color[rgb]{0,0,0}\psi}(Z_{(i+1):m})-{\color[rgb]{0,0,0}\psi}^{\prime}(Z_{(i+1):m})|\right]\leq L_{i}\rho_{i}(u,u^{\prime})=L_{i}\rho_{i}(Z_{i},Z_{i}^{\prime})." display="block" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ψ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>m</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ψ</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>m</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo>]</mo></mrow><mo>≤</mo><msub><mi>L</mi><mi>i</mi></msub><msub><mi>ρ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><msup><mi>u</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>L</mi><mi>i</mi></msub><msub><mi>ρ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>Z</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\ex_{#1}\left[|{\color[rgb]{0,0,0}\psi}(Z_{(i+1):m})-{\color[rgb]{0,0,0}\psi}^{\prime}(Z_{(i+1):m})|\right]\leq L_{i}\rho_{i}(u,u^{\prime})=L_{i}\rho_{i}(Z_{i},Z_{i}^{\prime}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.11)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS1.p8" class="ltx_para">
<p id="A5.SS1.p8.1" class="ltx_p"><span id="A5.SS1.p8.1.1" class="ltx_text">We write the following telescoping decomposition:</span></p>
<table id="A5.EGx38" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E12.m1" class="ltx_math_unparsed" alttext="\displaystyle\Big|\ex\left[{\color[rgb]{0,0,0}\psi}^{\prime}(Z_{(i+1):m})\right]-\ex\left[{\color[rgb]{0,0,0}\psi}^{\prime}(Z_{(i+1):m}^{\prime})\right]\Big|" display="inline" intent=":literal"><semantics><mrow><mo fence="false" maxsize="1.600em" minsize="1.600em" rspace="0.167em" stretchy="true">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ψ</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>m</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ψ</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>Z</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>m</mi></mrow><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big|\ex\left[{\color[rgb]{0,0,0}\psi}^{\prime}(Z_{(i+1):m})\right]-\ex\left[{\color[rgb]{0,0,0}\psi}^{\prime}(Z_{(i+1):m}^{\prime})\right]\Big|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E12.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq\sum_{j=i}^{m-1}\Big|\ex\left[{\color[rgb]{0,0,0}\psi}^{\prime}(Z_{(i+1):j}^{\prime},Z_{(j+1):m})\right]-\ex\left[{\color[rgb]{0,0,0}\psi}^{\prime}(Z_{(i+1):(j+1)}^{\prime},Z_{(j+1):m})\right]\Big|\,." display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mi>i</mi></mrow><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mo fence="false" maxsize="1.600em" minsize="1.600em" rspace="0.167em" stretchy="true">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ψ</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>Z</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>j</mi></mrow><mo>′</mo></msubsup><mo>,</mo><msub><mi>Z</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>m</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ψ</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>Z</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><mo stretchy="false">(</mo><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>′</mo></msubsup><mo>,</mo><msub><mi>Z</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>m</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo fence="false" maxsize="1.600em" minsize="1.600em" rspace="0.059em" stretchy="true">|</mo><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{j=i}^{m-1}\Big|\ex\left[{\color[rgb]{0,0,0}\psi}^{\prime}(Z_{(i+1):j}^{\prime},Z_{(j+1):m})\right]-\ex\left[{\color[rgb]{0,0,0}\psi}^{\prime}(Z_{(i+1):(j+1)}^{\prime},Z_{(j+1):m})\right]\Big|\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.12)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS1.p9" class="ltx_para">
<p id="A5.SS1.p9.1" class="ltx_p"><span id="A5.SS1.p9.1.1" class="ltx_text">By the definition of the Wasserstein-1 distance, there exists a coupling of <math id="A5.SS1.p9.m1" class="ltx_Math" alttext="(Z_{j+1},Z_{j+1}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msubsup><mi>Z</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(Z_{j+1},Z_{j+1}^{\prime})</annotation></semantics></math> such that</span></p>
<table id="A5.E13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E13.m1" class="ltx_math_unparsed" alttext="\ex\left[\rho_{j+1}(Z_{j+1},Z_{j+1}^{\prime})\nonscript\,\middle|\nonscript\,\mathopen{}\mathcal{F}_{i},Z_{i}^{\prime}\right]=W_{#1}(\text{Law}(Z_{j+1}\mid\mathcal{F}_{i}),\text{Law}(Z_{j+1}\mid\mathcal{F}_{i-1},Z_{i}^{\prime}))\leq\delta_{i,j+1}(Z_{1:i-1},Z_{i}^{\prime})\,." display="block" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><msub><mi>ρ</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msubsup><mi>Z</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><mrow><mphantom></mphantom><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>Z</mi><mi>i</mi><mo>′</mo></msubsup><mo>]</mo></mrow><mo>=</mo><msub><mi>W</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mtext>Law</mtext><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mtext>Law</mtext><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msubsup><mi>Z</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>≤</mo><msub><mi>δ</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msubsup><mi>Z</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0.170em">.</mo></mrow></mrow><annotation encoding="application/x-tex">\ex\left[\rho_{j+1}(Z_{j+1},Z_{j+1}^{\prime})\nonscript\,\middle|\nonscript\,\mathopen{}\mathcal{F}_{i},Z_{i}^{\prime}\right]=W_{#1}(\text{Law}(Z_{j+1}\mid\mathcal{F}_{i}),\text{Law}(Z_{j+1}\mid\mathcal{F}_{i-1},Z_{i}^{\prime}))\leq\delta_{i,j+1}(Z_{1:i-1},Z_{i}^{\prime})\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.13)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS1.p10" class="ltx_para">
<p id="A5.SS1.p10.1" class="ltx_p"><span id="A5.SS1.p10.1.1" class="ltx_text">We obtain a bound on the increment at coordinate <math id="A5.SS1.p10.m1" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> by combining the coupling with the coordinate-wise Lipschitz condition at <math id="A5.SS1.p10.m2" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>:</span></p>
<table id="A5.EGx39" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E14.m1" class="ltx_math_unparsed" alttext="\displaystyle\Big|\ex\left[{\color[rgb]{0,0,0}\psi}^{\prime}(Z_{(i+1):j}^{\prime},Z_{(j+1):m})\right]-\ex\left[{\color[rgb]{0,0,0}\psi}^{\prime}(Z_{(i+1):(j+1)}^{\prime},Z_{(j+1):m})\right]\Big|" display="inline" intent=":literal"><semantics><mrow><mo fence="false" maxsize="1.600em" minsize="1.600em" rspace="0.167em" stretchy="true">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ψ</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>Z</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>j</mi></mrow><mo>′</mo></msubsup><mo>,</mo><msub><mi>Z</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>m</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ψ</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>Z</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><mo stretchy="false">(</mo><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>′</mo></msubsup><mo>,</mo><msub><mi>Z</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>m</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big|\ex\left[{\color[rgb]{0,0,0}\psi}^{\prime}(Z_{(i+1):j}^{\prime},Z_{(j+1):m})\right]-\ex\left[{\color[rgb]{0,0,0}\psi}^{\prime}(Z_{(i+1):(j+1)}^{\prime},Z_{(j+1):m})\right]\Big|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.14)</span></td></tr></tbody>
<tbody id="A5.E15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E15.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\ex\left[\big|{\color[rgb]{0,0,0}\psi}^{\prime}(Z_{(i+1):j}^{\prime},Z_{(j+1):m})-{\color[rgb]{0,0,0}\psi}^{\prime}(Z_{(i+1):(j+1)}^{\prime},Z_{(j+1):m})\big|\right]" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.167em" stretchy="true">|</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ψ</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>Z</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>j</mi></mrow><mo>′</mo></msubsup><mo>,</mo><msub><mi>Z</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>m</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ψ</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>Z</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><mo stretchy="false">(</mo><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>′</mo></msubsup><mo>,</mo><msub><mi>Z</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>m</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.167em" stretchy="true">|</mo><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\ex\left[\big|{\color[rgb]{0,0,0}\psi}^{\prime}(Z_{(i+1):j}^{\prime},Z_{(j+1):m})-{\color[rgb]{0,0,0}\psi}^{\prime}(Z_{(i+1):(j+1)}^{\prime},Z_{(j+1):m})\big|\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.15)</span></td></tr></tbody>
<tbody id="A5.E16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E16.m1" class="ltx_Math" alttext="\displaystyle\leq L_{j+1}\ex\left[\rho_{j+1}(Z_{j+1},Z_{j+1}^{\prime})\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>L</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>ρ</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msubsup><mi>Z</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq L_{j+1}\ex\left[\rho_{j+1}(Z_{j+1},Z_{j+1}^{\prime})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.16)</span></td></tr></tbody>
<tbody id="A5.E17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E17.m1" class="ltx_math_unparsed" alttext="\displaystyle=L_{j+1}W_{#1}(\text{Law}(Z_{j+1}\mid\mathcal{F}_{i}),\text{Law}(Z_{j+1}\mid\mathcal{F}_{i-1},Z_{i}^{\prime}))=L_{j+1}\delta_{i,j+1}(Z_{1:i},Z_{i}^{\prime})\,." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>L</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><msub><mi>W</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mtext>Law</mtext><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mtext>Law</mtext><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msubsup><mi>Z</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>L</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><msub><mi>δ</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo>,</mo><msubsup><mi>Z</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=L_{j+1}W_{#1}(\text{Law}(Z_{j+1}\mid\mathcal{F}_{i}),\text{Law}(Z_{j+1}\mid\mathcal{F}_{i-1},Z_{i}^{\prime}))=L_{j+1}\delta_{i,j+1}(Z_{1:i},Z_{i}^{\prime})\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.17)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS1.p11" class="ltx_para">
<p id="A5.SS1.p11.1" class="ltx_p"><span id="A5.SS1.p11.1.1" class="ltx_text">Combining the above estimates gives</span></p>
<table id="A5.EGx40" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E18.m1" class="ltx_math_unparsed" alttext="\displaystyle\Big|\ex\left[{\color[rgb]{0,0,0}\psi}^{\prime}(Z_{(i+1):m})\right]-\ex\left[{\color[rgb]{0,0,0}\psi}^{\prime}(Z_{(i+1):m}^{\prime})\right]\Big|" display="inline" intent=":literal"><semantics><mrow><mo fence="false" maxsize="1.600em" minsize="1.600em" rspace="0.167em" stretchy="true">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ψ</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>m</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ψ</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>Z</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>m</mi></mrow><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big|\ex\left[{\color[rgb]{0,0,0}\psi}^{\prime}(Z_{(i+1):m})\right]-\ex\left[{\color[rgb]{0,0,0}\psi}^{\prime}(Z_{(i+1):m}^{\prime})\right]\Big|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E18.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq\sum_{j=i}^{m-1}L_{j+1}\delta_{i,j+1}(Z_{1:i},Z_{i}^{\prime})\,." display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mi>i</mi></mrow><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msub><mi>L</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><msub><mi>δ</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo>,</mo><msubsup><mi>Z</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{j=i}^{m-1}L_{j+1}\delta_{i,j+1}(Z_{1:i},Z_{i}^{\prime})\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.18)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p11.2" class="ltx_p"><span id="A5.SS1.p11.2.1" class="ltx_text">which yields the desired result.
∎</span></p>
</div>
</div>
<div id="A5.SS1.p12" class="ltx_para">
<p id="A5.SS1.p12.1" class="ltx_p">We now state a classic convex domination lemma which is a slight variant of <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib29" title="" class="ltx_ref">Ledoux and Talagrand (2013, Lem. 4.6)</a></cite>.</p>
</div>
<div id="A5.Thmlemma2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A5.Thmlemma2.2" class="ltx_text ltx_font_bold">Lemma E.2</span></span><span id="A5.Thmlemma2.3" class="ltx_text ltx_font_bold"> </span>(Convex domination)<span id="A5.Thmlemma2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A5.Thmlemma2.p1" class="ltx_para">
<p id="A5.Thmlemma2.p1.1" class="ltx_p"><span id="A5.Thmlemma2.p1.1.1" class="ltx_text ltx_font_italic">Consider <math id="A5.Thmlemma2.p1.m1" class="ltx_Math" alttext="X,Z" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>,</mo><mi>Z</mi></mrow><annotation encoding="application/x-tex">X,Z</annotation></semantics></math> a zero-mean symmetric random variables such that</span></p>
<table id="A5.E19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E19.m1" class="ltx_Math" alttext="\prob(|X|&gt;t)\leq C\prob(|Z|&gt;t)\,," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi>X</mi><mo stretchy="false">|</mo></mrow><mo>&gt;</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi>Z</mi><mo stretchy="false">|</mo></mrow><mo>&gt;</mo><mi>t</mi></mrow><mo rspace="0.170em" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\prob(|X|&gt;t)\leq C\prob(|Z|&gt;t)\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.19)</span></td></tr></tbody>
</table>
<p id="A5.Thmlemma2.p1.2" class="ltx_p"><span id="A5.Thmlemma2.p1.2.1" class="ltx_text ltx_font_italic">for some <math id="A5.Thmlemma2.p1.m2" class="ltx_Math" alttext="C&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C&gt;0</annotation></semantics></math> and all <math id="A5.Thmlemma2.p1.m3" class="ltx_Math" alttext="t&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t&gt;0</annotation></semantics></math>.</span></p>
</div>
<div id="A5.Thmlemma2.p2" class="ltx_para">
<p id="A5.Thmlemma2.p2.1" class="ltx_p"><span id="A5.Thmlemma2.p2.1.1" class="ltx_text ltx_font_italic">Then, for any convex function <math id="A5.Thmlemma2.p2.m1" class="ltx_Math" alttext="h\colon{\color[rgb]{0,0,0}\mathbb{R}}\to{\color[rgb]{0,0,0}\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mo stretchy="false">→</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">h\colon{\color[rgb]{0,0,0}\mathbb{R}}\to{\color[rgb]{0,0,0}\mathbb{R}}</annotation></semantics></math>,</span></p>
<table id="A5.E20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E20.m1" class="ltx_Math" alttext="\ex[h(X)]\leq\ex[h(CZ)]\,." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>CZ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">\ex[h(X)]\leq\ex[h(CZ)]\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.20)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS1.p13" class="ltx_para">
<p id="A5.SS1.p13.1" class="ltx_p"><span id="A5.SS1.p13.1.1" class="ltx_text">Let <math id="A5.SS1.p13.m1" class="ltx_Math" alttext="\delta\sim\mathrm{Bernoulli}(1/C)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∼</mo><mrow><mi>Bernoulli</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>C</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta\sim\mathrm{Bernoulli}(1/C)</annotation></semantics></math> be independent of <math id="A5.SS1.p13.m2" class="ltx_Math" alttext="(X,Z)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(X,Z)</annotation></semantics></math>. Then, for all <math id="A5.SS1.p13.m3" class="ltx_Math" alttext="t&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t&gt;0</annotation></semantics></math>,
<math id="A5.SS1.p13.m4" class="ltx_Math" alttext="\prob(|Z|&gt;t)\geq\tfrac{1}{C}\,\prob(|X|&gt;t)=\prob(|\delta X|&gt;t)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi>Z</mi><mo stretchy="false">|</mo></mrow><mo>&gt;</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mfrac><mn>1</mn><mi>C</mi></mfrac><mo lspace="0.337em" rspace="0em">​</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi>X</mi><mo stretchy="false">|</mo></mrow><mo>&gt;</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow><mo stretchy="false">|</mo></mrow><mo>&gt;</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\prob(|Z|&gt;t)\geq\tfrac{1}{C}\,\prob(|X|&gt;t)=\prob(|\delta X|&gt;t).</annotation></semantics></math>
Hence <math id="A5.SS1.p13.m5" class="ltx_Math" alttext="|\delta X|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\delta X|</annotation></semantics></math> is stochastically dominated by <math id="A5.SS1.p13.m6" class="ltx_Math" alttext="|Z|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi>Z</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|Z|</annotation></semantics></math> and we may construct a coupling such that</span></p>
<table id="A5.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E21.m1" class="ltx_Math" alttext="|\delta X|\leq|Z|\qquad\text{a.s.}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mo stretchy="false">|</mo><mi>Z</mi><mo stretchy="false">|</mo></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mtext>a.s.</mtext></mrow><annotation encoding="application/x-tex">|\delta X|\leq|Z|\qquad\text{a.s.}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.21)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS1.p14" class="ltx_para">
<p id="A5.SS1.p14.1" class="ltx_p"><span id="A5.SS1.p14.1.1" class="ltx_text">Since <math id="A5.SS1.p14.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is symmetric, we may write in distribution <math id="A5.SS1.p14.m2" class="ltx_Math" alttext="X\stackrel{{\scriptstyle d}}{{=}}{\color[rgb]{0,0,0}\varepsilon}\,|X|" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mover><mo>=</mo><mi>d</mi></mover><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>X</mi><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X\stackrel{{\scriptstyle d}}{{=}}{\color[rgb]{0,0,0}\varepsilon}\,|X|</annotation></semantics></math> where <math id="A5.SS1.p14.m3" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\varepsilon}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\varepsilon}</annotation></semantics></math> is a Rademacher variable independent of <math id="A5.SS1.p14.m4" class="ltx_Math" alttext="|X|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi>X</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|X|</annotation></semantics></math>. Likewise, <math id="A5.SS1.p14.m5" class="ltx_Math" alttext="Z\stackrel{{\scriptstyle d}}{{=}}{\color[rgb]{0,0,0}\varepsilon}^{\prime}\,|Z|" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mover><mo>=</mo><mi>d</mi></mover><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>Z</mi><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Z\stackrel{{\scriptstyle d}}{{=}}{\color[rgb]{0,0,0}\varepsilon}^{\prime}\,|Z|</annotation></semantics></math> with an independent Rademacher <math id="A5.SS1.p14.m6" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\varepsilon}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\varepsilon}^{\prime}</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS1.p15" class="ltx_para">
<p id="A5.SS1.p15.1" class="ltx_p"><span id="A5.SS1.p15.1.1" class="ltx_text">Condition on <math id="A5.SS1.p15.m1" class="ltx_Math" alttext="(\delta,X,Z)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo>,</mo><mi>X</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\delta,X,Z)</annotation></semantics></math> and define</span></p>
<table id="A5.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E22.m1" class="ltx_math_unparsed" alttext="\Phi(a)\;:=\;\ex\big[\,{\color[rgb]{0,0,0}h}\!\big(a\,{\color[rgb]{0,0,0}\varepsilon}\,|Z|\big)\,\bigm|\,\delta,X,Z\big]\,,\qquad a\in[-1,1]." display="block" intent=":literal"><semantics><mrow><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><mi>a</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow><mo rspace="0.558em">:=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">[</mo><mpadded style="width:0.406em;" width="0.406em"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi></mpadded><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>a</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mo fence="false" lspace="0.170em" rspace="0.167em" stretchy="false">|</mo><mi>Z</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">)</mo></mrow><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.337em" stretchy="true">|</mo><mi>δ</mi><mo>,</mo><mi>X</mi><mo>,</mo><mi>Z</mi><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">]</mo></mrow><mo rspace="2.167em">,</mo><mi>a</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mo lspace="0em">−</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Phi(a)\;:=\;\ex\big[\,{\color[rgb]{0,0,0}h}\!\big(a\,{\color[rgb]{0,0,0}\varepsilon}\,|Z|\big)\,\bigm|\,\delta,X,Z\big]\,,\qquad a\in[-1,1].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.22)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p15.2" class="ltx_p"><span id="A5.SS1.p15.2.1" class="ltx_text">The map <math id="A5.SS1.p15.m2" class="ltx_Math" alttext="a\mapsto\Phi(a)" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo stretchy="false">↦</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">a\mapsto\Phi(a)</annotation></semantics></math> is convex (as an average of convex functions). By convexity, its maximum on <math id="A5.SS1.p15.m3" class="ltx_Math" alttext="[-1,1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[-1,1]</annotation></semantics></math> is attained at an extreme point <math id="A5.SS1.p15.m4" class="ltx_Math" alttext="\{-1,1\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{-1,1\}</annotation></semantics></math>. On the coupling where (<a href="#A5.E21" title="Equation E.21 ‣ Proof. ‣ E.1 Moment bounds for general functions ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.21</span></a>) holds, define</span></p>
<table id="A5.E23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E23.m1" class="ltx_Math" alttext="a\;:=\;\begin{cases}\dfrac{\delta\lvert X\rvert}{|Z|},&amp;\text{if }Z\neq 0,\\[6.0pt]
0,&amp;\text{if }Z=0,\end{cases}" display="block" intent=":literal"><semantics><mrow><mi>a</mi><mo lspace="0.558em" rspace="0.558em">:=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mfrac><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>X</mi><mo stretchy="false">|</mo></mrow></mrow><mrow><mo stretchy="false">|</mo><mi>Z</mi><mo stretchy="false">|</mo></mrow></mfrac><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>Z</mi></mrow><mo>≠</mo><mn>0</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>0</mn><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>Z</mi></mrow><mo>=</mo><mn>0</mn></mrow><mo>,</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">a\;:=\;\begin{cases}\dfrac{\delta\lvert X\rvert}{|Z|},&amp;\text{if }Z\neq 0,\\[6.0pt]
0,&amp;\text{if }Z=0,\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.23)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p15.3" class="ltx_p"><span id="A5.SS1.p15.3.1" class="ltx_text">so that <math id="A5.SS1.p15.m5" class="ltx_Math" alttext="a\in[-1,1]" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">a\in[-1,1]</annotation></semantics></math> almost surely thanks to <math id="A5.SS1.p15.m6" class="ltx_Math" alttext="|X|\leq|\delta Z|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>X</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mo stretchy="false">|</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>Z</mi></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">|X|\leq|\delta Z|</annotation></semantics></math>. Therefore,</span></p>
<table id="A5.EGx41" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E24.m1" class="ltx_math_unparsed" alttext="\displaystyle\ex\big[\,h\!\big({\color[rgb]{0,0,0}\varepsilon}\,|X|\,\delta\big)\,\bigm|\,\delta,X,Z\big]\;=\;\Phi(a)\;\leq\;\max\{\Phi(-1),\Phi(1)\}\;=\;\ex\big[\,h\!\big({\color[rgb]{0,0,0}\varepsilon}\,|Z|\big)\,\bigm|\,\delta,|X|,Z\big]." display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">[</mo><mpadded style="width:0.406em;" width="0.406em"><mi>h</mi></mpadded><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mo fence="false" lspace="0.170em" rspace="0.167em" stretchy="false">|</mo><mi>X</mi><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mi>δ</mi><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">)</mo></mrow><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.337em" stretchy="true">|</mo><mi>δ</mi><mo>,</mo><mi>X</mi><mo>,</mo><mi>Z</mi><mo maxsize="1.200em" minsize="1.200em" rspace="0.280em">]</mo></mrow><mo rspace="0.558em">=</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><mi>a</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow><mo rspace="0.558em">≤</mo><mi>max</mi><mrow><mo stretchy="false">{</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo rspace="0.280em" stretchy="false">}</mo></mrow><mo rspace="0.558em">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">[</mo><mpadded style="width:0.406em;" width="0.406em"><mi>h</mi></mpadded><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mo fence="false" lspace="0.170em" rspace="0.167em" stretchy="false">|</mo><mi>Z</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">)</mo></mrow><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.337em" stretchy="true">|</mo><mi>δ</mi><mo>,</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>X</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo>,</mo><mi>Z</mi><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ex\big[\,h\!\big({\color[rgb]{0,0,0}\varepsilon}\,|X|\,\delta\big)\,\bigm|\,\delta,X,Z\big]\;=\;\Phi(a)\;\leq\;\max\{\Phi(-1),\Phi(1)\}\;=\;\ex\big[\,h\!\big({\color[rgb]{0,0,0}\varepsilon}\,|Z|\big)\,\bigm|\,\delta,|X|,Z\big].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.24)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p15.4" class="ltx_p"><span id="A5.SS1.p15.4.1" class="ltx_text">Taking expectations and using <math id="A5.SS1.p15.m7" class="ltx_Math" alttext="X\stackrel{{\scriptstyle d}}{{=}}{\color[rgb]{0,0,0}\varepsilon}|X|" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mover><mo>=</mo><mi>d</mi></mover><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>X</mi><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X\stackrel{{\scriptstyle d}}{{=}}{\color[rgb]{0,0,0}\varepsilon}|X|</annotation></semantics></math> and <math id="A5.SS1.p15.m8" class="ltx_Math" alttext="Z\stackrel{{\scriptstyle d}}{{=}}{\color[rgb]{0,0,0}\varepsilon}|Z|" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mover><mo>=</mo><mi>d</mi></mover><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>Z</mi><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Z\stackrel{{\scriptstyle d}}{{=}}{\color[rgb]{0,0,0}\varepsilon}|Z|</annotation></semantics></math>,</span></p>
<table id="A5.E25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E25.m1" class="ltx_Math" alttext="\ex[h\!\big(\delta X\big)]\;\leq\;\ex[h(Z)]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mpadded style="width:0.406em;" width="0.406em"><mi>h</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo rspace="0.280em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.558em">≤</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\ex[h\!\big(\delta X\big)]\;\leq\;\ex[h(Z)].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.25)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS1.p16" class="ltx_para">
<p id="A5.SS1.p16.1" class="ltx_p"><span id="A5.SS1.p16.1.1" class="ltx_text">Since <math id="A5.SS1.p16.m1" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> is convex and <math id="A5.SS1.p16.m2" class="ltx_math_unparsed" alttext="\ex[\delta\mid X,Z]=1/C" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>δ</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">]</mo></mrow><mo>=</mo><mn>1</mn><mo>/</mo><mi>C</mi></mrow><annotation encoding="application/x-tex">\ex[\delta\mid X,Z]=1/C</annotation></semantics></math>, we have, by Jensen’s inequality,</span></p>
<table id="A5.E26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E26.m1" class="ltx_math_unparsed" alttext="\ex[h\!\big(X/C\big)]\;=\;\ex\big[\,h\!\big(\ex[\delta X\mid X,Z]\big)]\;\leq\;\ex\big[\,\ex[h(\delta X)\mid X,Z]\,]\;=\;\ex[h(\delta X)]\leq\ex[h(Z)]\,," display="block" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mpadded style="width:0.406em;" width="0.406em"><mi>h</mi></mpadded><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>X</mi><mo>/</mo><mi>C</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo rspace="0.280em" stretchy="false">]</mo></mrow><mo rspace="0.558em">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">[</mo><mpadded style="width:0.406em;" width="0.406em"><mi>h</mi></mpadded><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>δ</mi><mi>X</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">]</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo rspace="0.280em" stretchy="false">]</mo></mrow><mo rspace="0.558em">≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>δ</mi><mi>X</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi><mo>,</mo><mi>Z</mi><mo rspace="0.170em" stretchy="false">]</mo></mrow><mo rspace="0.280em" stretchy="false">]</mo></mrow><mo rspace="0.558em">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>δ</mi><mi>X</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.170em" stretchy="false">]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\ex[h\!\big(X/C\big)]\;=\;\ex\big[\,h\!\big(\ex[\delta X\mid X,Z]\big)]\;\leq\;\ex\big[\,\ex[h(\delta X)\mid X,Z]\,]\;=\;\ex[h(\delta X)]\leq\ex[h(Z)]\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.26)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p16.2" class="ltx_p"><span id="A5.SS1.p16.2.1" class="ltx_text">Finally, apply the previous inequality with the convex function <math id="A5.SS1.p16.m3" class="ltx_Math" alttext="u\mapsto h(Cu)" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo stretchy="false">↦</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u\mapsto h(Cu)</annotation></semantics></math> to obtain</span></p>
<table id="A5.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex1.m1" class="ltx_Math" alttext="\ex[h(X)]\;=\;\ex[h\!\big(C\cdot(X/C)\big)]\;\leq\;\ex[h\!\big(CZ\big)]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.280em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.558em">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mpadded style="width:0.406em;" width="0.406em"><mi>h</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>C</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>/</mo><mi>C</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo rspace="0.280em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.558em">≤</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mpadded style="width:0.406em;" width="0.406em"><mi>h</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>CZ</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\ex[h(X)]\;=\;\ex[h\!\big(C\cdot(X/C)\big)]\;\leq\;\ex[h\!\big(CZ\big)].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p16.3" class="ltx_p"><span id="A5.SS1.p16.3.1" class="ltx_text">This is exactly the desired bound.</span></p>
</div>
<div id="A5.SS1.p17" class="ltx_para">
<p id="A5.SS1.p17.1" class="ltx_p"><span id="A5.SS1.p17.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A5.SS1.p18" class="ltx_para">
<p id="A5.SS1.p18.1" class="ltx_p">We now state a fact of subGaussian random variables, which can be found in <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib58" title="" class="ltx_ref">Wainwright (2019, Thm. 2.6)</a></cite> for instance.</p>
</div>
<div id="A5.Thmlemma3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A5.Thmlemma3.2" class="ltx_text ltx_font_bold">Lemma E.3</span></span><span id="A5.Thmlemma3.3" class="ltx_text ltx_font_bold"> </span>(Convex domination)<span id="A5.Thmlemma3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A5.Thmlemma3.p1" class="ltx_para">
<p id="A5.Thmlemma3.p1.1" class="ltx_p"><span id="A5.Thmlemma3.p1.1.1" class="ltx_text ltx_font_italic">Consider <math id="A5.Thmlemma3.p1.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> a zero-mean real-valued <math id="A5.Thmlemma3.p1.m2" class="ltx_Math" alttext="\sigma^{2}" display="inline" intent=":literal"><semantics><msup><mi>σ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\sigma^{2}</annotation></semantics></math>-sub-Gaussian random variable,
which is, in addition, symmetric, i.e., <math id="A5.Thmlemma3.p1.m3" class="ltx_Math" alttext="X\stackrel{{\scriptstyle d}}{{=}}-X" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mover><mo>=</mo><mi>d</mi></mover><mrow><mo>−</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">X\stackrel{{\scriptstyle d}}{{=}}-X</annotation></semantics></math>.
Then, for <math id="A5.Thmlemma3.p1.m4" class="ltx_Math" alttext="Z\sim\mathcal{N}(0,\sigma^{2})" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msup><mi>σ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Z\sim\mathcal{N}(0,\sigma^{2})</annotation></semantics></math>,</span></p>
<table id="A5.E27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E27.m1" class="ltx_Math" alttext="\prob(|X|&gt;t)\leq 8\prob(|Z|&gt;t)\,." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi>X</mi><mo stretchy="false">|</mo></mrow><mo>&gt;</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mn>8</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi>Z</mi><mo stretchy="false">|</mo></mrow><mo>&gt;</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">\prob(|X|&gt;t)\leq 8\prob(|Z|&gt;t)\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.27)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.Thmlemma4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A5.Thmlemma4.2" class="ltx_text ltx_font_bold">Lemma E.4</span></span><span id="A5.Thmlemma4.3" class="ltx_text ltx_font_bold"> </span>(Causal symmetrization)<span id="A5.Thmlemma4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A5.Thmlemma4.p1" class="ltx_para">
<p id="A5.Thmlemma4.p1.1" class="ltx_p"><span id="A5.Thmlemma4.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A5.Thmlemma4.p1.m1" class="ltx_Math" alttext="m\in{\color[rgb]{0,0,0}\mathbb{N}}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℕ</mi></mrow><annotation encoding="application/x-tex">m\in{\color[rgb]{0,0,0}\mathbb{N}}</annotation></semantics></math> and <math id="A5.Thmlemma4.p1.m2" class="ltx_Math" alttext="(\mathcal{Z},\mathcal{A})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{Z},\mathcal{A})</annotation></semantics></math> be a standard Borel measurable space. Let <math id="A5.Thmlemma4.p1.m3" class="ltx_Math" alttext="Z_{1},\ldots,Z_{m}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>Z</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">Z_{1},\ldots,Z_{m}</annotation></semantics></math> be <math id="A5.Thmlemma4.p1.m4" class="ltx_Math" alttext="\mathcal{Z}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒵</mi><annotation encoding="application/x-tex">\mathcal{Z}</annotation></semantics></math>-valued random with natural filtration <math id="A5.Thmlemma4.p1.m5" class="ltx_Math" alttext="(\mathcal{F}_{i})_{i=0,\dots,m}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}_{i})_{i=0,\dots,m}</annotation></semantics></math>
Let <math id="A5.Thmlemma4.p1.m6" class="ltx_Math" alttext="h\colon{\color[rgb]{0,0,0}\mathbb{R}}\to{\color[rgb]{0,0,0}\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mo stretchy="false">→</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">h\colon{\color[rgb]{0,0,0}\mathbb{R}}\to{\color[rgb]{0,0,0}\mathbb{R}}</annotation></semantics></math> be convex.</span></p>
</div>
<div id="A5.Thmlemma4.p2" class="ltx_para">
<p id="A5.Thmlemma4.p2.1" class="ltx_p"><span id="A5.Thmlemma4.p2.1.1" class="ltx_text ltx_font_italic">Consider <math id="A5.Thmlemma4.p2.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}g}\colon\mathcal{Z}^{m}\to{\color[rgb]{0,0,0}\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">g</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒵</mi><mi>m</mi></msup><mo stretchy="false">→</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}g}\colon\mathcal{Z}^{m}\to{\color[rgb]{0,0,0}\mathbb{R}}</annotation></semantics></math> be measurable. Set <math id="A5.Thmlemma4.p2.m2" class="ltx_Math" alttext="S:={\color[rgb]{0,0,0}g}(Z_{1},\ldots,Z_{m})" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>:=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>Z</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">S:={\color[rgb]{0,0,0}g}(Z_{1},\ldots,Z_{m})</annotation></semantics></math>.
For each <math id="A5.Thmlemma4.p2.m3" class="ltx_Math" alttext="i\in\{1,\ldots,m\}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>m</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\{1,\ldots,m\}</annotation></semantics></math>, assume there exists a conditionally independent resample</span></p>
<table id="A5.E28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E28.m1" class="ltx_math_unparsed" alttext="Z_{i}^{\prime}\sim\mathrm{Law}(Z_{i}\mid\mathcal{F}_{i-1}),\quad Z_{i}^{\prime}\perp\!\!\!\perp Z_{i}\mid\mathcal{F}_{i-1}." display="block" intent=":literal"><semantics><mrow><msubsup><mi>Z</mi><mi>i</mi><mo>′</mo></msubsup><mo>∼</mo><mi>Law</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo rspace="1.167em">,</mo><msubsup><mi>Z</mi><mi>i</mi><mo>′</mo></msubsup><mpadded style="width:0.240em;" width="0.240em"><mo>⟂</mo></mpadded><mo>⟂</mo><msub><mi>Z</mi><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Z_{i}^{\prime}\sim\mathrm{Law}(Z_{i}\mid\mathcal{F}_{i-1}),\quad Z_{i}^{\prime}\perp\!\!\!\perp Z_{i}\mid\mathcal{F}_{i-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.28)</span></td></tr></tbody>
</table>
<p id="A5.Thmlemma4.p2.2" class="ltx_p"><span id="A5.Thmlemma4.p2.2.1" class="ltx_text ltx_font_italic">Let <math id="A5.Thmlemma4.p2.m4" class="ltx_math_unparsed" alttext="{\color[rgb]{0,0,0}\varepsilon}_{1:m},{\color[rgb]{0,0,0}\varepsilon}_{1:m}^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>m</mi></mrow></msub><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>m</mi></mrow></msub><msup><mrow></mrow><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\varepsilon}_{1:m},{\color[rgb]{0,0,0}\varepsilon}_{1:m}^{\prime}</annotation></semantics></math> be independent Rademacher variables, independent of all <math id="A5.Thmlemma4.p2.m5" class="ltx_Math" alttext="Z,Z^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>,</mo><msup><mi>Z</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">Z,Z^{\prime}</annotation></semantics></math> and <math id="A5.Thmlemma4.p2.m6" class="ltx_Math" alttext="\mathcal{F}_{m}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{m}</annotation></semantics></math>.</span></p>
</div>
<div id="A5.Thmlemma4.p3" class="ltx_para">
<p id="A5.Thmlemma4.p3.1" class="ltx_p"><span id="A5.Thmlemma4.p3.1.1" class="ltx_text ltx_font_italic">Assume there exist measurable functions <math id="A5.Thmlemma4.p3.m1" class="ltx_Math" alttext="c_{i}\colon\mathcal{Z}\times\mathcal{Z}\to[0,\infty)" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒵</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c_{i}\colon\mathcal{Z}\times\mathcal{Z}\to[0,\infty)</annotation></semantics></math>, <math id="A5.Thmlemma4.p3.m2" class="ltx_Math" alttext="d_{i}:\mathcal{Z}\to[0,\infty)" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒵</mi><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d_{i}:\mathcal{Z}\to[0,\infty)</annotation></semantics></math> and <math id="A5.Thmlemma4.p3.m3" class="ltx_Math" alttext="J\subset\left\{1,\ldots,m\right\}" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>⊂</mo><mrow><mo>{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>m</mi></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">J\subset\left\{1,\ldots,m\right\}</annotation></semantics></math> such that, the following conditions hold:</span></p>
<ol id="A5.I1" class="ltx_enumerate">
<li id="A5.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="A5.I1.i1.p1" class="ltx_para">
<p id="A5.I1.i1.p1.1" class="ltx_p"><span id="A5.I1.i1.p1.1.1" class="ltx_text ltx_font_italic">For any </span><math id="A5.I1.i1.p1.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math><span id="A5.I1.i1.p1.1.2" class="ltx_text ltx_font_italic">, there exists </span><math id="A5.I1.i1.p1.m2" class="ltx_Math" alttext="j(i)\in J" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mi>J</mi></mrow><annotation encoding="application/x-tex">j(i)\in J</annotation></semantics></math><span id="A5.I1.i1.p1.1.3" class="ltx_text ltx_font_italic">, such that, for any </span><math id="A5.I1.i1.p1.m3" class="ltx_math_unparsed" alttext="z_{1:i-1}\in\mathcal{Z}^{i-1}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi><msup><mrow></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">z_{1:i-1}\in\mathcal{Z}^{i-1}</annotation></semantics></math><span id="A5.I1.i1.p1.1.4" class="ltx_text ltx_font_italic"> and </span><math id="A5.I1.i1.p1.m4" class="ltx_Math" alttext="z_{i},z_{i}^{\prime}\in\mathcal{Z}" display="inline" intent=":literal"><semantics><mrow><msub><mi>z</mi><mi>i</mi></msub><mo>,</mo><mrow><msubsup><mi>z</mi><mi>i</mi><mo>′</mo></msubsup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></mrow></mrow><annotation encoding="application/x-tex">z_{i},z_{i}^{\prime}\in\mathcal{Z}</annotation></semantics></math><span id="A5.I1.i1.p1.1.5" class="ltx_text ltx_font_italic">,</span></p>
<table id="A5.E29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E29.m1" class="ltx_math_unparsed" alttext="\left\lvert\ex\left[S\nonscript\,\middle|\nonscript\,\mathopen{}Z_{1:i}=z_{1:i}\right]-\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:i-1}=z_{1:i-1},Z_{i}=z_{i}^{\prime}]\right\rvert\leq c_{i}(z_{i},z_{i}^{\prime})+d_{i}(z_{j(i)})\one\{i\not\in J\}\,." display="block" intent=":literal"><semantics><mrow><mo>|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mi>S</mi><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo>=</mo><msub><mi>z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo>]</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo fence="false" lspace="0.170em" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>=</mo><msub><mi>z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msub><mi>Z</mi><mi>i</mi></msub><mo>=</mo><msubsup><mi>z</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">]</mo></mrow><mo>|</mo></mrow><mo>≤</mo><msub><mi>c</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>z</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>d</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo rspace="0.167em" stretchy="false">)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo stretchy="false">{</mo><mi>i</mi><mo>∉</mo><mi>J</mi><mo stretchy="false">}</mo></mrow><mo lspace="0.170em">.</mo></mrow></mrow><annotation encoding="application/x-tex">\left\lvert\ex\left[S\nonscript\,\middle|\nonscript\,\mathopen{}Z_{1:i}=z_{1:i}\right]-\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:i-1}=z_{1:i-1},Z_{i}=z_{i}^{\prime}]\right\rvert\leq c_{i}(z_{i},z_{i}^{\prime})+d_{i}(z_{j(i)})\one\{i\not\in J\}\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.29)</span></td></tr></tbody>
</table>
</div></li>
<li id="A5.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="A5.I1.i2.p1" class="ltx_para">
<p id="A5.I1.i2.p1.1" class="ltx_p"><span id="A5.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">For any </span><math id="A5.I1.i2.p1.m1" class="ltx_Math" alttext="i\notin J" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∉</mo><mi>J</mi></mrow><annotation encoding="application/x-tex">i\notin J</annotation></semantics></math><span id="A5.I1.i2.p1.1.2" class="ltx_text ltx_font_italic">, </span><math id="A5.I1.i2.p1.m2" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\varepsilon}_{i}c_{i}(Z_{i},Z_{i}^{\prime})" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>Z</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\varepsilon}_{i}c_{i}(Z_{i},Z_{i}^{\prime})</annotation></semantics></math><span id="A5.I1.i2.p1.1.3" class="ltx_text ltx_font_italic"> is </span><math id="A5.I1.i2.p1.m3" class="ltx_Math" alttext="\sigma_{i}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>σ</mi><mi>i</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">\sigma_{i}^{2}</annotation></semantics></math><span id="A5.I1.i2.p1.1.4" class="ltx_text ltx_font_italic">-sub-Gaussian conditionally on </span><math id="A5.I1.i2.p1.m4" class="ltx_Math" alttext="\mathcal{F}_{i-1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\mathcal{F}_{i-1}</annotation></semantics></math><span id="A5.I1.i2.p1.1.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A5.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(iii)</span> 
<div id="A5.I1.i3.p1" class="ltx_para">
<p id="A5.I1.i3.p1.1" class="ltx_p"><span id="A5.I1.i3.p1.1.1" class="ltx_text ltx_font_italic">For any </span><math id="A5.I1.i3.p1.m1" class="ltx_Math" alttext="j\in J" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mi>J</mi></mrow><annotation encoding="application/x-tex">j\in J</annotation></semantics></math><span id="A5.I1.i3.p1.1.2" class="ltx_text ltx_font_italic">, </span><math id="A5.I1.i3.p1.m2" class="ltx_Math" alttext="Z_{j}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mi>j</mi></msub><annotation encoding="application/x-tex">Z_{j}</annotation></semantics></math><span id="A5.I1.i3.p1.1.3" class="ltx_text ltx_font_italic"> is independent of </span><math id="A5.I1.i3.p1.m3" class="ltx_Math" alttext="\mathcal{F}_{j-1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\mathcal{F}_{j-1}</annotation></semantics></math><span id="A5.I1.i3.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
<p id="A5.Thmlemma4.p3.2" class="ltx_p"><span id="A5.Thmlemma4.p3.2.1" class="ltx_text ltx_font_italic">Then, there are Gausssian random variables <math id="A5.Thmlemma4.p3.m4" class="ltx_Math" alttext="G_{j},G_{j}^{\prime}\sim\mathcal{N}(0,8\sigma_{j}^{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>j</mi></msub><mo>,</mo><mrow><msubsup><mi>G</mi><mi>j</mi><mo>′</mo></msubsup><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>j</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">G_{j},G_{j}^{\prime}\sim\mathcal{N}(0,8\sigma_{j}^{2})</annotation></semantics></math> independent and independent of all <math id="A5.Thmlemma4.p3.m5" class="ltx_Math" alttext="Z,Z^{\prime},{\color[rgb]{0,0,0}\varepsilon},\mathcal{F}_{m}" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>,</mo><msup><mi>Z</mi><mo>′</mo></msup><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">Z,Z^{\prime},{\color[rgb]{0,0,0}\varepsilon},\mathcal{F}_{m}</annotation></semantics></math> such that</span></p>
<table id="A5.E30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E30.m1" class="ltx_Math" alttext="\ex[{\color[rgb]{0,0,0}h}(S-\ex[S])]\leq\ex\left[{\color[rgb]{0,0,0}h}\left(\sum_{i\notin J}\sym_{#1}\left({\color[rgb]{0,0,0}\varepsilon}_{i}\left(\lvert G_{i}\rvert+d_{i}(Z_{j(i)})\right)\right)+\sum_{j\in J}{\color[rgb]{0,0,0}\varepsilon}_{j}c_{j}(Z_{j},Z_{j}^{\prime})\right)\right]," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>S</mi><mo>−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>S</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∉</mo><mi>J</mi></mrow></munder><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Sym</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>G</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo rspace="0.055em">+</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>∈</mo><mi>J</mi></mrow></munder><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>j</mi></msub><mo>,</mo><msubsup><mi>Z</mi><mi>j</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\ex[{\color[rgb]{0,0,0}h}(S-\ex[S])]\leq\ex\left[{\color[rgb]{0,0,0}h}\left(\sum_{i\notin J}\sym_{#1}\left({\color[rgb]{0,0,0}\varepsilon}_{i}\left(\lvert G_{i}\rvert+d_{i}(Z_{j(i)})\right)\right)+\sum_{j\in J}{\color[rgb]{0,0,0}\varepsilon}_{j}c_{j}(Z_{j},Z_{j}^{\prime})\right)\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.30)</span></td></tr></tbody>
</table>
<p id="A5.Thmlemma4.p3.3" class="ltx_p"><span id="A5.Thmlemma4.p3.3.1" class="ltx_text ltx_font_italic">where we use the notation:</span></p>
<table id="A5.E31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E31.m1" class="ltx_Math" alttext="\sym_{#1}\left({\color[rgb]{0,0,0}\varepsilon}_{i}\left(\lvert G_{i}\rvert+d_{i}(Z_{j(i)})\right)\right)\coloneqq{\color[rgb]{0,0,0}\varepsilon}_{j(i)}\left({\color[rgb]{0,0,0}\varepsilon}_{i}\left(\lvert G_{i}\rvert+d_{i}(Z_{j(i)})\right)-{\color[rgb]{0,0,0}\varepsilon}_{i}^{\prime}(\lvert G_{i}^{\prime}\rvert+d_{i}(Z_{j(i)}^{\prime}))\right)\,." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Sym</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>G</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>≔</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>G</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>i</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><msubsup><mi>G</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>Z</mi><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">\sym_{#1}\left({\color[rgb]{0,0,0}\varepsilon}_{i}\left(\lvert G_{i}\rvert+d_{i}(Z_{j(i)})\right)\right)\coloneqq{\color[rgb]{0,0,0}\varepsilon}_{j(i)}\left({\color[rgb]{0,0,0}\varepsilon}_{i}\left(\lvert G_{i}\rvert+d_{i}(Z_{j(i)})\right)-{\color[rgb]{0,0,0}\varepsilon}_{i}^{\prime}(\lvert G_{i}^{\prime}\rvert+d_{i}(Z_{j(i)}^{\prime}))\right)\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.31)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS1.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS1.p19" class="ltx_para">
<p id="A5.SS1.p19.1" class="ltx_p"><span id="A5.SS1.p19.1.1" class="ltx_text">Define <math id="A5.SS1.p19.m1" class="ltx_math_unparsed" alttext="\mathcal{G}=\sigma({\color[rgb]{0,0,0}\varepsilon}_{1:m},G_{1:m})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>=</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>m</mi></mrow></msub><mo>,</mo><msub><mi>G</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>m</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{G}=\sigma({\color[rgb]{0,0,0}\varepsilon}_{1:m},G_{1:m})</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS1.p20" class="ltx_para">
<p id="A5.SS1.p20.1" class="ltx_p"><span id="A5.SS1.p20.1.1" class="ltx_text">We show the result by induction on <math id="A5.SS1.p20.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>: our goal is to show that, for any <math id="A5.SS1.p20.m2" class="ltx_Math" alttext="k\in\{0,\ldots,m\}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>m</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">k\in\{0,\ldots,m\}</annotation></semantics></math>,</span></p>
</div>
<div id="A5.SS1.p21" class="ltx_para">
<table id="A5.EGx42" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E32.m1" class="ltx_Math" alttext="\displaystyle\ex[{\color[rgb]{0,0,0}h}(S-\ex[S])]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>S</mi><mo>−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>S</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ex[{\color[rgb]{0,0,0}h}(S-\ex[S])]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E32.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq\ex\biggl[h\Bigl(\sum_{\begin{subarray}{c}i\notin J\\
i\geq k+1\end{subarray}}\bigl(\one\{j(i)\leq k\}{\color[rgb]{0,0,0}\varepsilon}_{i}\left(\lvert G_{i}\rvert+d_{i}(Z_{j(i)})\right)+\one\{j(i)\geq k+1\}\sym_{#1}\left({\color[rgb]{0,0,0}\varepsilon}_{i}\left(\lvert G_{i}\rvert+d_{i}(Z_{j(i)})\right)\right)\bigr)" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mi>h</mi><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>i</mi><mo>∉</mo><mi>J</mi></mrow></mtd></mtr><mtr><mtd><mrow><mi>i</mi><mo>≥</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow></mtd></mtr></mtable></munder></mstyle><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo stretchy="false">{</mo><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mo>≤</mo><mi>k</mi><mo stretchy="false">}</mo></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>i</mi></msub><mrow><mo>(</mo><mrow><mo stretchy="false">|</mo><msub><mi>G</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><msub><mi>d</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo stretchy="false">{</mo><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mo>≥</mo><mi>k</mi><mo>+</mo><mn>1</mn><mo rspace="0.167em" stretchy="false">}</mo></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Sym</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>i</mi></msub><mrow><mo>(</mo><mrow><mo stretchy="false">|</mo><msub><mi>G</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><msub><mi>d</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\ex\biggl[h\Bigl(\sum_{\begin{subarray}{c}i\notin J\\
i\geq k+1\end{subarray}}\bigl(\one\{j(i)\leq k\}{\color[rgb]{0,0,0}\varepsilon}_{i}\left(\lvert G_{i}\rvert+d_{i}(Z_{j(i)})\right)+\one\{j(i)\geq k+1\}\sym_{#1}\left({\color[rgb]{0,0,0}\varepsilon}_{i}\left(\lvert G_{i}\rvert+d_{i}(Z_{j(i)})\right)\right)\bigr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.32)</span></td></tr></tbody>
<tbody id="A5.E33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E33.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad\qquad\Bigl.+\sum_{\begin{subarray}{c}i\in J\\
i\geq k+1\end{subarray}}{\color[rgb]{0,0,0}\varepsilon}_{i}c_{i}(Z_{i},Z_{i}^{\prime})+\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:k}]-\ex[S]\Bigr)\biggr]\,," display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>i</mi><mo>∈</mo><mi>J</mi></mrow></mtd></mtr><mtr><mtd><mrow><mi>i</mi><mo>≥</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow></mtd></mtr></mtable></munder></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>i</mi></msub><msub><mi>c</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>Z</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo fence="false" lspace="0.170em" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo stretchy="false">]</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo stretchy="false">]</mo></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em" rspace="0.170em">]</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\qquad\Bigl.+\sum_{\begin{subarray}{c}i\in J\\
i\geq k+1\end{subarray}}{\color[rgb]{0,0,0}\varepsilon}_{i}c_{i}(Z_{i},Z_{i}^{\prime})+\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:k}]-\ex[S]\Bigr)\biggr]\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.33)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS1.p22" class="ltx_para">
<p id="A5.SS1.p22.1" class="ltx_p"><span id="A5.SS1.p22.1.1" class="ltx_text">where <math id="A5.SS1.p22.m1" class="ltx_Math" alttext="G_{i},G_{i}^{\prime}\sim\mathcal{N}(0,8\sigma_{i}^{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>i</mi></msub><mo>,</mo><mrow><msubsup><mi>G</mi><mi>i</mi><mo>′</mo></msubsup><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>i</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">G_{i},G_{i}^{\prime}\sim\mathcal{N}(0,8\sigma_{i}^{2})</annotation></semantics></math> are independent and independent of all <math id="A5.SS1.p22.m2" class="ltx_Math" alttext="Z,Z^{\prime},{\color[rgb]{0,0,0}\varepsilon},{\color[rgb]{0,0,0}\varepsilon}^{\prime},\mathcal{F}_{m}" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>,</mo><msup><mi>Z</mi><mo>′</mo></msup><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mo>,</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mo>′</mo></msup><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">Z,Z^{\prime},{\color[rgb]{0,0,0}\varepsilon},{\color[rgb]{0,0,0}\varepsilon}^{\prime},\mathcal{F}_{m}</annotation></semantics></math>.
<a href="#A5.E33" title="In Proof. ‣ E.1 Moment bounds for general functions ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">E.33</span></a> holds trivially for <math id="A5.SS1.p22.m3" class="ltx_Math" alttext="k=m" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">k=m</annotation></semantics></math>. We now show that if it holds for some <math id="A5.SS1.p22.m4" class="ltx_Math" alttext="k\in\{1,\ldots,m\}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>m</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">k\in\{1,\ldots,m\}</annotation></semantics></math>, then it also holds for <math id="A5.SS1.p22.m5" class="ltx_Math" alttext="k-1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k-1</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS1.p23" class="ltx_para">
<p id="A5.SS1.p23.1" class="ltx_p"><span id="A5.SS1.p23.1.1" class="ltx_text">Note that we can rewrite</span></p>
<table id="A5.EGx43" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E34.m1" class="ltx_math_unparsed" alttext="\displaystyle\sum_{\begin{subarray}{c}i\notin J\\
i\geq k+1\end{subarray}}\bigl(\one\{j(i)\leq k\}{\color[rgb]{0,0,0}\varepsilon}_{i}\left(\lvert G_{i}\rvert+d_{i}(Z_{j(i)})\right)+\one\{j(i)\geq k+1\}\sym_{#1}\left({\color[rgb]{0,0,0}\varepsilon}_{i}\left(\lvert G_{i}\rvert+d_{i}(Z_{j(i)})\right)\right)\bigr)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>i</mi><mo>∉</mo><mi>J</mi></mrow></mtd></mtr><mtr><mtd><mrow><mi>i</mi><mo>≥</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow></mtd></mtr></mtable></munder></mstyle><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo stretchy="false">{</mo><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mo>≤</mo><mi>k</mi><mo stretchy="false">}</mo></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>i</mi></msub><mrow><mo>(</mo><mrow><mo stretchy="false">|</mo><msub><mi>G</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><msub><mi>d</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo stretchy="false">{</mo><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mo>≥</mo><mi>k</mi><mo>+</mo><mn>1</mn><mo rspace="0.167em" stretchy="false">}</mo></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Sym</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>i</mi></msub><mrow><mo>(</mo><mrow><mo stretchy="false">|</mo><msub><mi>G</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><msub><mi>d</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{\begin{subarray}{c}i\notin J\\
i\geq k+1\end{subarray}}\bigl(\one\{j(i)\leq k\}{\color[rgb]{0,0,0}\varepsilon}_{i}\left(\lvert G_{i}\rvert+d_{i}(Z_{j(i)})\right)+\one\{j(i)\geq k+1\}\sym_{#1}\left({\color[rgb]{0,0,0}\varepsilon}_{i}\left(\lvert G_{i}\rvert+d_{i}(Z_{j(i)})\right)\right)\bigr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.34)</span></td></tr></tbody>
<tbody id="A5.E35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E35.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\Bigl.+\sum_{\begin{subarray}{c}i\in J\\
i\geq k+1\end{subarray}}{\color[rgb]{0,0,0}\varepsilon}_{i}c_{i}(Z_{i},Z_{i}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>i</mi><mo>∈</mo><mi>J</mi></mrow></mtd></mtr><mtr><mtd><mrow><mi>i</mi><mo>≥</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow></mtd></mtr></mtable></munder></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>i</mi></msub><msub><mi>c</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>Z</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\Bigl.+\sum_{\begin{subarray}{c}i\in J\\
i\geq k+1\end{subarray}}{\color[rgb]{0,0,0}\varepsilon}_{i}c_{i}(Z_{i},Z_{i}^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.35)</span></td></tr></tbody>
<tbody id="A5.E36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E36.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E36.m2" class="ltx_math_unparsed" alttext="\displaystyle\underbrace{\sum_{\begin{subarray}{c}i\notin J\\
i\geq k+1\end{subarray}}\one\{j(i)\geq k+1\}\sym_{#1}\left({\color[rgb]{0,0,0}\varepsilon}_{i}\left(\lvert G_{i}\rvert+d_{i}(Z_{j(i)})\right)\right)+\sum_{\begin{subarray}{c}i\in J\\
i\geq k+1\end{subarray}}{\color[rgb]{0,0,0}\varepsilon}_{i}c_{i}(Z_{i},Z_{i}^{\prime})}_{=:Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}}" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mrow><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>i</mi><mo>∉</mo><mi>J</mi></mrow></mtd></mtr><mtr><mtd><mrow><mi>i</mi><mo>≥</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow></mtd></mtr></mtable></msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mo stretchy="false">{</mo><mi>j</mi><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo><mo>≥</mo><mi>k</mi><mo>+</mo><mn>1</mn><mo rspace="0.167em" stretchy="false">}</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Sym</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><msub><mrow></mrow><mi>i</mi></msub><mo>(</mo><mo stretchy="false">|</mo><mi>G</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">|</mo><mo>+</mo><mi>d</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">(</mo><mi>Z</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo><mo>)</mo><mo>)</mo><mo>+</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>i</mi><mo>∈</mo><mi>J</mi></mrow></mtd></mtr><mtr><mtd><mrow><mi>i</mi><mo>≥</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow></mtd></mtr></mtable></msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><msub><mrow></mrow><mi>i</mi></msub><mi>c</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">(</mo><mi>Z</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>Z</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo stretchy="true">⏟</mo></munder><msub><mrow></mrow><mrow><mo rspace="0em">=</mo><mo rspace="0.278em">:</mo><msub><mi>Y</mi><mrow><mpadded style="width:0.510em;" width="0.510em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\underbrace{\sum_{\begin{subarray}{c}i\notin J\\
i\geq k+1\end{subarray}}\one\{j(i)\geq k+1\}\sym_{#1}\left({\color[rgb]{0,0,0}\varepsilon}_{i}\left(\lvert G_{i}\rvert+d_{i}(Z_{j(i)})\right)\right)+\sum_{\begin{subarray}{c}i\in J\\
i\geq k+1\end{subarray}}{\color[rgb]{0,0,0}\varepsilon}_{i}c_{i}(Z_{i},Z_{i}^{\prime})}_{=:Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.36)</span></td></tr></tbody>
<tbody id="A5.E37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E37.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\underbrace{\sum_{\begin{subarray}{c}i\notin J\\
i\geq k+1\end{subarray}}\one\{j(i)\leq k\}{\color[rgb]{0,0,0}\varepsilon}_{i}\left(\lvert G_{i}\rvert+d_{i}(Z_{j(i)})\right)}_{=:Y_{k}}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><munder accentunder="true"><mrow><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>i</mi><mo>∉</mo><mi>J</mi></mrow></mtd></mtr><mtr><mtd><mrow><mi>i</mi><mo>≥</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow></mtd></mtr></mtable></msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mo stretchy="false">{</mo><mi>j</mi><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo><mo>≤</mo><mi>k</mi><mo stretchy="false">}</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><msub><mrow></mrow><mi>i</mi></msub><mo>(</mo><mo stretchy="false">|</mo><mi>G</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">|</mo><mo>+</mo><mi>d</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">(</mo><mi>Z</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo><mo>)</mo></mrow><mo stretchy="true">⏟</mo></munder><msub><mrow></mrow><mrow><mo rspace="0em">=</mo><mo rspace="0.278em">:</mo><msub><mi>Y</mi><mi>k</mi></msub></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\underbrace{\sum_{\begin{subarray}{c}i\notin J\\
i\geq k+1\end{subarray}}\one\{j(i)\leq k\}{\color[rgb]{0,0,0}\varepsilon}_{i}\left(\lvert G_{i}\rvert+d_{i}(Z_{j(i)})\right)}_{=:Y_{k}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.37)</span></td></tr></tbody>
<tbody id="A5.E38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E38.m1" class="ltx_Math" alttext="\displaystyle=Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}+Y_{k}\,," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub><mo>+</mo><msub><mi>Y</mi><mi>k</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}+Y_{k}\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.38)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p23.2" class="ltx_p"><span id="A5.SS1.p23.2.1" class="ltx_text">where <math id="A5.SS1.p23.m1" class="ltx_Math" alttext="Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub><annotation encoding="application/x-tex">Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}</annotation></semantics></math> is independent of <math id="A5.SS1.p23.m2" class="ltx_Math" alttext="\mathcal{F}_{k}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{k}</annotation></semantics></math> and <math id="A5.SS1.p23.m3" class="ltx_Math" alttext="Y_{k}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mi>k</mi></msub><annotation encoding="application/x-tex">Y_{k}</annotation></semantics></math> is <math id="A5.SS1.p23.m4" class="ltx_Math" alttext="\mathcal{F}_{k}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{k}</annotation></semantics></math>-measurable.
More precisely, we show that</span></p>
<table id="A5.EGx44" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E39.m1" class="ltx_math_unparsed" alttext="\displaystyle\ex\left[{\color[rgb]{0,0,0}h}\left(Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}+Y_{k}+\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:k}]-\ex[S]\right)\nonscript\,\middle|\nonscript\,\mathopen{}Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mrow><mo>(</mo><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub><mo>+</mo><msub><mi>Y</mi><mi>k</mi></msub><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo fence="false" lspace="0.170em" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo stretchy="false">]</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo stretchy="false">]</mo></mrow><mo>)</mo></mrow><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><mrow><mphantom></mphantom><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ex\left[{\color[rgb]{0,0,0}h}\left(Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}+Y_{k}+\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:k}]-\ex[S]\right)\nonscript\,\middle|\nonscript\,\mathopen{}Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.39)</span></td></tr></tbody>
<tbody id="A5.E40"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E40.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\ex\left[h\left(Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}+Y_{k-1}+\one\{k\notin J\}{\color[rgb]{0,0,0}\varepsilon}_{k}(\lvert G_{k}\rvert+d_{k}(Z_{j(k)}))\right.\right." display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mi>h</mi><mrow><mo>(</mo><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub><mo>+</mo><msub><mi>Y</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo stretchy="false">{</mo><mi>k</mi><mo>∉</mo><mi>J</mi><mo stretchy="false">}</mo></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">|</mo><msub><mi>G</mi><mi>k</mi></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><msub><mi>d</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\ex\left[h\left(Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}+Y_{k-1}+\one\{k\notin J\}{\color[rgb]{0,0,0}\varepsilon}_{k}(\lvert G_{k}\rvert+d_{k}(Z_{j(k)}))\right.\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.40)</span></td></tr></tbody>
<tbody id="A5.E41"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E41.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\one\{k\in J\}({\color[rgb]{0,0,0}\varepsilon}_{k}c_{k}(Z_{k},Z_{k}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo stretchy="false">{</mo><mi>k</mi><mo>∈</mo><mi>J</mi><mo stretchy="false">}</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>k</mi></msub><msub><mi>c</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>k</mi></msub><mo>,</mo><msubsup><mi>Z</mi><mi>k</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\one\{k\in J\}({\color[rgb]{0,0,0}\varepsilon}_{k}c_{k}(Z_{k},Z_{k}^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.41)</span></td></tr></tbody>
<tbody id="A5.E42"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E42.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{\begin{subarray}{c}i\notin J\\
i\geq k+1\\
j(i)=k\end{subarray}}\sym_{#1}\left({\color[rgb]{0,0,0}\varepsilon}_{i}\left(\lvert G_{i}\rvert+d_{i}(Z_{k})\right)\right))\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:k-1}]-\ex[S])|Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}],," display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>i</mi><mo>∉</mo><mi>J</mi></mrow></mtd></mtr><mtr><mtd><mrow><mi>i</mi><mo>≥</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>k</mi></mrow></mtd></mtr></mtable></munder></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Sym</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>i</mi></msub><mrow><mo>(</mo><mrow><mo stretchy="false">|</mo><msub><mi>G</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><msub><mi>d</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>)</mo></mrow><mo rspace="0.167em" stretchy="false">)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo fence="false" lspace="0.170em" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">]</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub><mo stretchy="false">]</mo><mo>,</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{\begin{subarray}{c}i\notin J\\
i\geq k+1\\
j(i)=k\end{subarray}}\sym_{#1}\left({\color[rgb]{0,0,0}\varepsilon}_{i}\left(\lvert G_{i}\rvert+d_{i}(Z_{k})\right)\right))\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:k-1}]-\ex[S])|Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}],,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.42)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p23.3" class="ltx_p"><span id="A5.SS1.p23.3.1" class="ltx_text">with <math id="A5.SS1.p23.m5" class="ltx_math_unparsed" alttext="Y_{k-1}:=\sum_{i\notin J,i\geq k+1}{\color[rgb]{0,0,0}\varepsilon}_{i}\one\{j(i)\leq k-1\}\left(\lvert G_{i}\rvert+d_{i}(Z_{j(i)})\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo rspace="0.111em">:=</mo><msub><mo>∑</mo><mrow><mrow><mi>i</mi><mo>∉</mo><mi>J</mi></mrow><mo>,</mo><mrow><mi>i</mi><mo>≥</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow></mrow></msub><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>i</mi></msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo stretchy="false">{</mo><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mo>≤</mo><mi>k</mi><mo>−</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mo>(</mo><mrow><mo stretchy="false">|</mo><msub><mi>G</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><msub><mi>d</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">Y_{k-1}:=\sum_{i\notin J,i\geq k+1}{\color[rgb]{0,0,0}\varepsilon}_{i}\one\{j(i)\leq k-1\}\left(\lvert G_{i}\rvert+d_{i}(Z_{j(i)})\right)</annotation></semantics></math>,
which will imply the induction step <a href="#A5.E33" title="In Proof. ‣ E.1 Moment bounds for general functions ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">E.33</span></a> with <math id="A5.SS1.p23.m6" class="ltx_Math" alttext="k\leftarrow k-1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo stretchy="false">←</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">k\leftarrow k-1</annotation></semantics></math>
by taking expectations over <math id="A5.SS1.p23.m7" class="ltx_Math" alttext="Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub><annotation encoding="application/x-tex">Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}</annotation></semantics></math>.
Since <math id="A5.SS1.p23.m8" class="ltx_Math" alttext="Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub><annotation encoding="application/x-tex">Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}</annotation></semantics></math> is considered constant in <a href="#A5.E42" title="In Proof. ‣ E.1 Moment bounds for general functions ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">E.42</span></a>, we may assume without loss of generality that <math id="A5.SS1.p23.m9" class="ltx_Math" alttext="Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}=0</annotation></semantics></math>, at the potential cost of replacing <math id="A5.SS1.p23.m10" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> by <math id="A5.SS1.p23.m11" class="ltx_math_unparsed" alttext="h(\cdot+Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp})" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">+</mo><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">h(\cdot+Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp})</annotation></semantics></math>, which is still convex.
Therefore, it suffices to show</span></p>
<table id="A5.EGx45" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E43.m1" class="ltx_math_unparsed" alttext="\displaystyle\ex\left[{\color[rgb]{0,0,0}h}\left(Y_{k}+\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:k}]-\ex[S]\right)\nonscript\,\middle|\nonscript\,\mathopen{}Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mrow><mo>(</mo><msub><mi>Y</mi><mi>k</mi></msub><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo fence="false" lspace="0.170em" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo stretchy="false">]</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo stretchy="false">]</mo></mrow><mo>)</mo></mrow><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><mrow><mphantom></mphantom><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ex\left[{\color[rgb]{0,0,0}h}\left(Y_{k}+\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:k}]-\ex[S]\right)\nonscript\,\middle|\nonscript\,\mathopen{}Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.43)</span></td></tr></tbody>
<tbody id="A5.E44"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E44.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\ex\left[h\left(Y_{k-1}+\one\{k\notin J\}{\color[rgb]{0,0,0}\varepsilon}_{k}(\lvert G_{k}\rvert+d_{k}(Z_{j(k)}))\right.\right." display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mi>h</mi><mrow><mo>(</mo><msub><mi>Y</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo stretchy="false">{</mo><mi>k</mi><mo>∉</mo><mi>J</mi><mo stretchy="false">}</mo></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">|</mo><msub><mi>G</mi><mi>k</mi></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><msub><mi>d</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\ex\left[h\left(Y_{k-1}+\one\{k\notin J\}{\color[rgb]{0,0,0}\varepsilon}_{k}(\lvert G_{k}\rvert+d_{k}(Z_{j(k)}))\right.\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.44)</span></td></tr></tbody>
<tbody id="A5.E45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E45.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\one\{k\in J\}({\color[rgb]{0,0,0}\varepsilon}_{k}c_{k}(Z_{k},Z_{k}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo stretchy="false">{</mo><mi>k</mi><mo>∈</mo><mi>J</mi><mo stretchy="false">}</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>k</mi></msub><msub><mi>c</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>k</mi></msub><mo>,</mo><msubsup><mi>Z</mi><mi>k</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\one\{k\in J\}({\color[rgb]{0,0,0}\varepsilon}_{k}c_{k}(Z_{k},Z_{k}^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.45)</span></td></tr></tbody>
<tbody id="A5.E46"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E46.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{\begin{subarray}{c}i\notin J\\
i\geq k+1\\
j(i)=k\end{subarray}}\sym_{#1}\left({\color[rgb]{0,0,0}\varepsilon}_{i}\left(\lvert G_{i}\rvert+d_{i}(Z_{k})\right)\right))\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:k-1}]-\ex[S])|Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}],," display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>i</mi><mo>∉</mo><mi>J</mi></mrow></mtd></mtr><mtr><mtd><mrow><mi>i</mi><mo>≥</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>k</mi></mrow></mtd></mtr></mtable></munder></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Sym</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>i</mi></msub><mrow><mo>(</mo><mrow><mo stretchy="false">|</mo><msub><mi>G</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><msub><mi>d</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>)</mo></mrow><mo rspace="0.167em" stretchy="false">)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo fence="false" lspace="0.170em" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">]</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub><mo stretchy="false">]</mo><mo>,</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{\begin{subarray}{c}i\notin J\\
i\geq k+1\\
j(i)=k\end{subarray}}\sym_{#1}\left({\color[rgb]{0,0,0}\varepsilon}_{i}\left(\lvert G_{i}\rvert+d_{i}(Z_{k})\right)\right))\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:k-1}]-\ex[S])|Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}],,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.46)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS1.p24" class="ltx_para">
<p id="A5.SS1.p24.1" class="ltx_p"><span id="A5.SS1.p24.1.1" class="ltx_text">We first consider the case of <math id="A5.SS1.p24.m1" class="ltx_Math" alttext="k\notin J" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∉</mo><mi>J</mi></mrow><annotation encoding="application/x-tex">k\notin J</annotation></semantics></math>.
Define <math id="A5.SS1.p24.m2" class="ltx_math_unparsed" alttext="\Phi(z_{1:k}):=\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:k}=z_{1:k}]" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>:=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo fence="false" lspace="0.170em" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo>=</mo><msub><mi>z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Phi(z_{1:k}):=\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:k}=z_{1:k}]</annotation></semantics></math>. We rewrite the <abbr title="" class="ltx_glossaryref ltx_missing">RHS</abbr> of <a href="#A5.E46" title="In Proof. ‣ E.1 Moment bounds for general functions ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">E.46</span></a> as</span></p>
<table id="A5.EGx46" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E47"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E47.m1" class="ltx_math_unparsed" alttext="\displaystyle\ex\left[{\color[rgb]{0,0,0}h}\left(Y_{k}+\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:k}]-\ex[S]\right)\nonscript\,\middle|\nonscript\,\mathopen{}Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mrow><mo>(</mo><msub><mi>Y</mi><mi>k</mi></msub><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo fence="false" lspace="0.170em" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo stretchy="false">]</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo stretchy="false">]</mo></mrow><mo>)</mo></mrow><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><mrow><mphantom></mphantom><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ex\left[{\color[rgb]{0,0,0}h}\left(Y_{k}+\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:k}]-\ex[S]\right)\nonscript\,\middle|\nonscript\,\mathopen{}Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.47)</span></td></tr></tbody>
<tbody id="A5.E48"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E48.m1" class="ltx_math_unparsed" alttext="\displaystyle=\ex\left[{\color[rgb]{0,0,0}h}\left(Y_{k}+\Phi(Z_{1:k})-\ex\left[\Phi(Z_{1:k-1},Z_{k}^{\prime})\nonscript\,\middle|\nonscript\,\mathopen{}Z_{1:k-1}\right]+\ex\left[S\nonscript\,\middle|\nonscript\,\mathopen{}Z_{1:k-1}\right]-\ex[S]\right)|Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mrow><mo>(</mo><msub><mi>Y</mi><mi>k</mi></msub><mo>+</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msubsup><mi>Z</mi><mi>k</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>]</mo></mrow><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mi>S</mi><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>]</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo stretchy="false">]</mo></mrow><mo>)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\ex\left[{\color[rgb]{0,0,0}h}\left(Y_{k}+\Phi(Z_{1:k})-\ex\left[\Phi(Z_{1:k-1},Z_{k}^{\prime})\nonscript\,\middle|\nonscript\,\mathopen{}Z_{1:k-1}\right]+\ex\left[S\nonscript\,\middle|\nonscript\,\mathopen{}Z_{1:k-1}\right]-\ex[S]\right)|Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.48)</span></td></tr></tbody>
<tbody id="A5.E49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E49.m1" class="ltx_math_unparsed" alttext="\displaystyle=\ex\left[{\color[rgb]{0,0,0}h}\left(Y_{k}+\ex\left[\Phi(Z_{1:k})-\Phi(Z_{1:k-1},Z_{k}^{\prime})\nonscript\,\middle|\nonscript\,\mathopen{}Z_{1:k}\right]+\ex\left[S\nonscript\,\middle|\nonscript\,\mathopen{}Z_{1:k-1}\right]-\ex[S]\right)|Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mrow><mo>(</mo><msub><mi>Y</mi><mi>k</mi></msub><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msubsup><mi>Z</mi><mi>k</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo>]</mo></mrow><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mi>S</mi><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>]</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo stretchy="false">]</mo></mrow><mo>)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\ex\left[{\color[rgb]{0,0,0}h}\left(Y_{k}+\ex\left[\Phi(Z_{1:k})-\Phi(Z_{1:k-1},Z_{k}^{\prime})\nonscript\,\middle|\nonscript\,\mathopen{}Z_{1:k}\right]+\ex\left[S\nonscript\,\middle|\nonscript\,\mathopen{}Z_{1:k-1}\right]-\ex[S]\right)|Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.49)</span></td></tr></tbody>
<tbody id="A5.E50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E50.m1" class="ltx_math_unparsed" alttext="\displaystyle=\ex\left[{\color[rgb]{0,0,0}h}\left(Y_{k}+\ex\left[\Phi(Z_{1:k})-\Phi(Z_{1:k-1},Z_{k}^{\prime})\nonscript\,\middle|\nonscript\,\mathopen{}Z_{1:k},\mathcal{G}\right]+\ex\left[S\nonscript\,\middle|\nonscript\,\mathopen{}Z_{1:k-1}\right]-\ex[S]\right)|Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mrow><mo>(</mo><msub><mi>Y</mi><mi>k</mi></msub><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msubsup><mi>Z</mi><mi>k</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>]</mo></mrow><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mi>S</mi><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>]</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo stretchy="false">]</mo></mrow><mo>)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\ex\left[{\color[rgb]{0,0,0}h}\left(Y_{k}+\ex\left[\Phi(Z_{1:k})-\Phi(Z_{1:k-1},Z_{k}^{\prime})\nonscript\,\middle|\nonscript\,\mathopen{}Z_{1:k},\mathcal{G}\right]+\ex\left[S\nonscript\,\middle|\nonscript\,\mathopen{}Z_{1:k-1}\right]-\ex[S]\right)|Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.50)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p24.2" class="ltx_p"><span id="A5.SS1.p24.2.1" class="ltx_text">where we used the fact that <math id="A5.SS1.p24.m3" class="ltx_math_unparsed" alttext="\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:k-1}]=\ex[\Phi(Z_{1:k-1},Z_{k}^{\prime})\nonscript\,|\nonscript\,\mathopen{}Z_{1:k-1}]=\ex[\Phi(Z_{1:k_{1}},Z_{k}^{\prime})\nonscript\,|\nonscript\,\mathopen{}Z_{1:k}]=\ex[\Phi(Z_{1:k-1},Z_{k}^{\prime})\nonscript\,|\nonscript\,\mathopen{}Z_{1:k},\mathcal{G}]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo fence="false" lspace="0.170em" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msubsup><mi>Z</mi><mi>k</mi><mo>′</mo></msubsup><mo rspace="0.170em" stretchy="false">)</mo></mrow><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi>k</mi><mn>1</mn></msub></mrow></msub><mo>,</mo><msubsup><mi>Z</mi><mi>k</mi><mo>′</mo></msubsup><mo rspace="0.170em" stretchy="false">)</mo></mrow><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msubsup><mi>Z</mi><mi>k</mi><mo>′</mo></msubsup><mo rspace="0.170em" stretchy="false">)</mo></mrow><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:k-1}]=\ex[\Phi(Z_{1:k-1},Z_{k}^{\prime})\nonscript\,|\nonscript\,\mathopen{}Z_{1:k-1}]=\ex[\Phi(Z_{1:k_{1}},Z_{k}^{\prime})\nonscript\,|\nonscript\,\mathopen{}Z_{1:k}]=\ex[\Phi(Z_{1:k-1},Z_{k}^{\prime})\nonscript\,|\nonscript\,\mathopen{}Z_{1:k},\mathcal{G}]</annotation></semantics></math>,
since <math id="A5.SS1.p24.m4" class="ltx_math_unparsed" alttext="Z_{k}^{\prime}\sim\text{Law}(Z_{k}\mid Z_{1:k-1})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Z</mi><mi>k</mi><mo>′</mo></msubsup><mo>∼</mo><mtext>Law</mtext><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>k</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z_{k}^{\prime}\sim\text{Law}(Z_{k}\mid Z_{1:k-1})</annotation></semantics></math> and <math id="A5.SS1.p24.m5" class="ltx_math_unparsed" alttext="Z_{k}^{\prime}\perp\!\!\!\perp Z_{k}\mid Z_{1:k-1}" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mo>′</mo></msup><mpadded style="width:0.240em;" width="0.240em"><mo>⟂</mo></mpadded><mo>⟂</mo><mi>Z</mi><msub><mrow></mrow><mi>k</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>Z</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">Z_{k}^{\prime}\perp\!\!\!\perp Z_{k}\mid Z_{1:k-1}</annotation></semantics></math> and <math id="A5.SS1.p24.m6" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> is independent of all <math id="A5.SS1.p24.m7" class="ltx_Math" alttext="Z,Z^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>,</mo><msup><mi>Z</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">Z,Z^{\prime}</annotation></semantics></math>.
Since both <math id="A5.SS1.p24.m8" class="ltx_Math" alttext="Y_{k}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mi>k</mi></msub><annotation encoding="application/x-tex">Y_{k}</annotation></semantics></math> and <math id="A5.SS1.p24.m9" class="ltx_math_unparsed" alttext="\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:k-1}]-\ex[S]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo fence="false" lspace="0.170em" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">]</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:k-1}]-\ex[S]</annotation></semantics></math> are <math id="A5.SS1.p24.m10" class="ltx_Math" alttext="\sigma(\mathcal{F}_{k},\mathcal{G})" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>k</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\sigma(\mathcal{F}_{k},\mathcal{G})</annotation></semantics></math>-measurable, by Jensen’s inequality (convexity of <math id="A5.SS1.p24.m11" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math>) applied to the conditional expectation w.r.t. <math id="A5.SS1.p24.m12" class="ltx_math_unparsed" alttext="Z_{1:k},\mathcal{G}" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow><annotation encoding="application/x-tex">Z_{1:k},\mathcal{G}</annotation></semantics></math>, we have</span></p>
<table id="A5.EGx47" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E52"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E52.m1" class="ltx_math_unparsed" alttext="\displaystyle\ex\left[{\color[rgb]{0,0,0}h}\left(Y_{k}+\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:k}]-\ex[S]\right)\nonscript\,\middle|\nonscript\,\mathopen{}Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mrow><mo>(</mo><msub><mi>Y</mi><mi>k</mi></msub><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo fence="false" lspace="0.170em" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo stretchy="false">]</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo stretchy="false">]</mo></mrow><mo>)</mo></mrow><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><mrow><mphantom></mphantom><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ex\left[{\color[rgb]{0,0,0}h}\left(Y_{k}+\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:k}]-\ex[S]\right)\nonscript\,\middle|\nonscript\,\mathopen{}Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.52)</span></td></tr></tbody>
<tbody id="A5.E53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E53.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\ex\left[{\color[rgb]{0,0,0}h}\left(Y_{k}+\Phi(Z_{1:k})-\Phi(Z_{1:k-1},Z_{k}^{\prime})+\ex\left[S\nonscript\,\middle|\nonscript\,\mathopen{}Z_{1:k-1}\right]-\ex[S]\right)\nonscript\,\middle|\nonscript\,\mathopen{}Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right]\,." display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mrow><mo>(</mo><msub><mi>Y</mi><mi>k</mi></msub><mo>+</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msubsup><mi>Z</mi><mi>k</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mi>S</mi><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>]</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo stretchy="false">]</mo></mrow><mo>)</mo></mrow><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><mrow><mphantom></mphantom><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub><mo>]</mo></mrow><mo lspace="0.170em">.</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\ex\left[{\color[rgb]{0,0,0}h}\left(Y_{k}+\Phi(Z_{1:k})-\Phi(Z_{1:k-1},Z_{k}^{\prime})+\ex\left[S\nonscript\,\middle|\nonscript\,\mathopen{}Z_{1:k-1}\right]-\ex[S]\right)\nonscript\,\middle|\nonscript\,\mathopen{}Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right]\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.53)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS1.p25" class="ltx_para">
<p id="A5.SS1.p25.1" class="ltx_p"><span id="A5.SS1.p25.1.1" class="ltx_text">Since <math id="A5.SS1.p25.m1" class="ltx_Math" alttext="k\not\in J" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∉</mo><mi>J</mi></mrow><annotation encoding="application/x-tex">k\not\in J</annotation></semantics></math>, then <math id="A5.SS1.p25.m2" class="ltx_Math" alttext="Y_{k}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mi>k</mi></msub><annotation encoding="application/x-tex">Y_{k}</annotation></semantics></math> is <math id="A5.SS1.p25.m3" class="ltx_Math" alttext="\sigma(\mathcal{F}_{k-1},\mathcal{G})" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\sigma(\mathcal{F}_{k-1},\mathcal{G})</annotation></semantics></math>-measurable. The following argument will now be made conditionally on <math id="A5.SS1.p25.m4" class="ltx_Math" alttext="\mathcal{F}_{k-1},\mathcal{G},Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>,</mo><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{F}_{k-1},\mathcal{G},Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS1.p26" class="ltx_para">
<p id="A5.SS1.p26.1" class="ltx_p"><span id="A5.SS1.p26.1.1" class="ltx_text">We have that <math id="A5.SS1.p26.m1" class="ltx_math_unparsed" alttext="\Phi(Z_{1:k})-\Phi(Z_{1:k-1},Z_{k}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msubsup><mi>Z</mi><mi>k</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Phi(Z_{1:k})-\Phi(Z_{1:k-1},Z_{k}^{\prime})</annotation></semantics></math> is symmetric. Moreover, since <math id="A5.SS1.p26.m2" class="ltx_math_unparsed" alttext="\lvert\Phi(Z_{1:k})-\Phi(Z_{1:k-1},Z_{k}^{\prime})\rvert\leq c_{k}(Z_{k},Z_{k}^{\prime})+d_{k}(Z_{j(k)}))" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msubsup><mi>Z</mi><mi>k</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><msub><mi>c</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>k</mi></msub><mo>,</mo><msubsup><mi>Z</mi><mi>k</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>d</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\lvert\Phi(Z_{1:k})-\Phi(Z_{1:k-1},Z_{k}^{\prime})\rvert\leq c_{k}(Z_{k},Z_{k}^{\prime})+d_{k}(Z_{j(k)}))</annotation></semantics></math> by assumption (i), we have that, for any <math id="A5.SS1.p26.m3" class="ltx_Math" alttext="t&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t&gt;0</annotation></semantics></math>,</span></p>
<table id="A5.EGx48" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E54.m1" class="ltx_math_unparsed" alttext="\displaystyle\prob\left(|\Phi(Z_{1:k})-\Phi(Z_{1:k-1},Z_{k}^{\prime})|&gt;t\nonscript\&gt;\middle|\nonscript\&gt;\mathopen{}\mathcal{F}_{k-1},\mathcal{G},Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℙ</mi><mrow><mo>(</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msubsup><mi>Z</mi><mi>k</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">&gt;</mo><mi>t</mi><mo lspace="0.220em" rspace="0.220em" stretchy="true">|</mo><mrow><mphantom></mphantom><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>,</mo><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\prob\left(|\Phi(Z_{1:k})-\Phi(Z_{1:k-1},Z_{k}^{\prime})|&gt;t\nonscript\&gt;\middle|\nonscript\&gt;\mathopen{}\mathcal{F}_{k-1},\mathcal{G},Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.54)</span></td></tr></tbody>
<tbody id="A5.E55"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E55.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\prob\left(c_{k}(Z_{k},Z_{k}^{\prime})+d_{k}(Z_{j(k)})&gt;t\nonscript\&gt;\middle|\nonscript\&gt;\mathopen{}\mathcal{F}_{k-1},\mathcal{G},Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right)" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℙ</mi><mrow><mo>(</mo><msub><mi>c</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>k</mi></msub><mo>,</mo><msubsup><mi>Z</mi><mi>k</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>d</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo>&gt;</mo><mi>t</mi><mo lspace="0.220em" rspace="0.220em" stretchy="true">|</mo><mrow><mphantom></mphantom><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>,</mo><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\prob\left(c_{k}(Z_{k},Z_{k}^{\prime})+d_{k}(Z_{j(k)})&gt;t\nonscript\&gt;\middle|\nonscript\&gt;\mathopen{}\mathcal{F}_{k-1},\mathcal{G},Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.55)</span></td></tr></tbody>
<tbody id="A5.E56"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E56.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\prob\left(c_{k}(Z_{k},Z_{k}^{\prime})&gt;t-d_{k}(Z_{j(k)})\nonscript\&gt;\middle|\nonscript\&gt;\mathopen{}\mathcal{F}_{k-1},\mathcal{G},Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right)" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℙ</mi><mrow><mo>(</mo><msub><mi>c</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>k</mi></msub><mo>,</mo><msubsup><mi>Z</mi><mi>k</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>&gt;</mo><mi>t</mi><mo>−</mo><msub><mi>d</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.220em" rspace="0.220em" stretchy="true">|</mo><mrow><mphantom></mphantom><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>,</mo><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\prob\left(c_{k}(Z_{k},Z_{k}^{\prime})&gt;t-d_{k}(Z_{j(k)})\nonscript\&gt;\middle|\nonscript\&gt;\mathopen{}\mathcal{F}_{k-1},\mathcal{G},Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.56)</span></td></tr></tbody>
<tbody id="A5.E57"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E57.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq 8\prob\left(|G_{k}|&gt;t-d_{k}(Z_{j(k)})\nonscript\&gt;\middle|\nonscript\&gt;\mathopen{}\mathcal{F}_{k-1},\mathcal{G},Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right)\,," display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mn>8</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℙ</mi><mrow><mo>(</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>G</mi><mi>k</mi></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">&gt;</mo><mi>t</mi><mo>−</mo><msub><mi>d</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.220em" rspace="0.220em" stretchy="true">|</mo><mrow><mphantom></mphantom><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>,</mo><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub><mo rspace="0.170em">)</mo></mrow><mo>,</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 8\prob\left(|G_{k}|&gt;t-d_{k}(Z_{j(k)})\nonscript\&gt;\middle|\nonscript\&gt;\mathopen{}\mathcal{F}_{k-1},\mathcal{G},Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right)\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.57)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p26.2" class="ltx_p"><span id="A5.SS1.p26.2.1" class="ltx_text">where we used that <math id="A5.SS1.p26.m4" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\varepsilon}_{k}c_{k}(Z_{k},Z_{k}^{\prime})" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>k</mi></msub><mo>,</mo><msubsup><mi>Z</mi><mi>k</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\varepsilon}_{k}c_{k}(Z_{k},Z_{k}^{\prime})</annotation></semantics></math> is <math id="A5.SS1.p26.m5" class="ltx_Math" alttext="\sigma_{k}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>σ</mi><mi>k</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">\sigma_{k}^{2}</annotation></semantics></math>-sub-Gaussian conditionally on <math id="A5.SS1.p26.m6" class="ltx_Math" alttext="\mathcal{F}_{k-1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\mathcal{F}_{k-1}</annotation></semantics></math> by assumption (ii) and <a href="#A5.Thmlemma3" title="Lemma E.3 (Convex domination). ‣ E.1 Moment bounds for general functions ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">E.3</span></a>.
Therefore, we can apply <a href="#A5.Thmlemma2" title="Lemma E.2 (Convex domination). ‣ E.1 Moment bounds for general functions ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">E.2</span></a> with <math id="A5.SS1.p26.m7" class="ltx_math_unparsed" alttext="X\leftarrow\Phi(Z_{1:k})-\Phi(Z_{1:k-1},Z_{k}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo stretchy="false">←</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msubsup><mi>Z</mi><mi>k</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">X\leftarrow\Phi(Z_{1:k})-\Phi(Z_{1:k-1},Z_{k}^{\prime})</annotation></semantics></math> and <math id="A5.SS1.p26.m8" class="ltx_Math" alttext="Z\leftarrow{\color[rgb]{0,0,0}\varepsilon}_{k}(|G_{k}|+d_{k}(Z_{j(k)}))" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo stretchy="false">←</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>G</mi><mi>k</mi></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><msub><mi>d</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Z\leftarrow{\color[rgb]{0,0,0}\varepsilon}_{k}(|G_{k}|+d_{k}(Z_{j(k)}))</annotation></semantics></math> with <math id="A5.SS1.p26.m9" class="ltx_Math" alttext="C=8" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">C=8</annotation></semantics></math> conditionally on <math id="A5.SS1.p26.m10" class="ltx_Math" alttext="\mathcal{F}_{k-1},Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{F}_{k-1},Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}</annotation></semantics></math> to obtain</span></p>
<table id="A5.EGx49" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E58"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E58.m1" class="ltx_math_unparsed" alttext="\displaystyle\ex\left[{\color[rgb]{0,0,0}h}\left(Y_{k}+\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:k}]-\ex[S]\right)\nonscript\,\middle|\nonscript\,\mathopen{}Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mrow><mo>(</mo><msub><mi>Y</mi><mi>k</mi></msub><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo fence="false" lspace="0.170em" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo stretchy="false">]</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo stretchy="false">]</mo></mrow><mo>)</mo></mrow><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><mrow><mphantom></mphantom><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ex\left[{\color[rgb]{0,0,0}h}\left(Y_{k}+\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:k}]-\ex[S]\right)\nonscript\,\middle|\nonscript\,\mathopen{}Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.58)</span></td></tr></tbody>
<tbody id="A5.E59"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E59.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\ex\left[{\color[rgb]{0,0,0}h}\left(Y_{k}+{\color[rgb]{0,0,0}\varepsilon}_{k}(|G_{k}|+d_{k}(Z_{j(k)}))+\ex\left[S\nonscript\,\middle|\nonscript\,\mathopen{}Z_{1:k-1}\right]-\ex[S]\right)\nonscript\,\middle|\nonscript\,\mathopen{}Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right]\,," display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mrow><mo>(</mo><msub><mi>Y</mi><mi>k</mi></msub><mo>+</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>G</mi><mi>k</mi></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0em">+</mo><msub><mi>d</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mi>S</mi><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>]</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo stretchy="false">]</mo></mrow><mo>)</mo></mrow><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><mrow><mphantom></mphantom><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub><mo rspace="0.170em">]</mo></mrow><mo>,</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\ex\left[{\color[rgb]{0,0,0}h}\left(Y_{k}+{\color[rgb]{0,0,0}\varepsilon}_{k}(|G_{k}|+d_{k}(Z_{j(k)}))+\ex\left[S\nonscript\,\middle|\nonscript\,\mathopen{}Z_{1:k-1}\right]-\ex[S]\right)\nonscript\,\middle|\nonscript\,\mathopen{}Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right]\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.59)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p26.3" class="ltx_p"><span id="A5.SS1.p26.3.1" class="ltx_text">which is <a href="#A5.E46" title="In Proof. ‣ E.1 Moment bounds for general functions ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">E.46</span></a> in the case <math id="A5.SS1.p26.m11" class="ltx_Math" alttext="k\notin J" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∉</mo><mi>J</mi></mrow><annotation encoding="application/x-tex">k\notin J</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS1.p27" class="ltx_para">
<p id="A5.SS1.p27.1" class="ltx_p"><span id="A5.SS1.p27.1.1" class="ltx_text">For the case <math id="A5.SS1.p27.m1" class="ltx_Math" alttext="k\in J" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mi>J</mi></mrow><annotation encoding="application/x-tex">k\in J</annotation></semantics></math>, we use a similar argument.
We now have, as before,</span></p>
<table id="A5.EGx50" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E60"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E60.m1" class="ltx_math_unparsed" alttext="\displaystyle\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:k-1}]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo fence="false" lspace="0.170em" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:k-1}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E60.m2" class="ltx_math_unparsed" alttext="\displaystyle=\ex[\Phi(Z_{1:k-1},Z_{k}^{\prime})\nonscript\,|\nonscript\,\mathopen{}Z_{1:k-1}]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msubsup><mi>Z</mi><mi>k</mi><mo>′</mo></msubsup><mo rspace="0.170em" stretchy="false">)</mo></mrow><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\ex[\Phi(Z_{1:k-1},Z_{k}^{\prime})\nonscript\,|\nonscript\,\mathopen{}Z_{1:k-1}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.60)</span></td></tr></tbody>
<tbody id="A5.E61"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E61.m1" class="ltx_math_unparsed" alttext="\displaystyle=\ex[\Phi(Z_{1:k-1},Z_{k}^{\prime})+\sum_{\begin{subarray}{c}i\notin J\\
i\geq k+1\\
j(i)=k\end{subarray}}{\color[rgb]{0,0,0}\varepsilon}_{i}^{\prime}\left(\lvert G_{i}^{\prime}\rvert+d_{i}(Z_{k})\right)\nonscript\,|\nonscript\,\mathopen{}Z_{1:k-1}]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msubsup><mi>Z</mi><mi>k</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>i</mi><mo>∉</mo><mi>J</mi></mrow></mtd></mtr><mtr><mtd><mrow><mi>i</mi><mo>≥</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>k</mi></mrow></mtd></mtr></mtable></munder></mstyle><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>i</mi><mo>′</mo></msubsup><mrow><mo>(</mo><mrow><mo stretchy="false">|</mo><msubsup><mi>G</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">|</mo></mrow><mo>+</mo><msub><mi>d</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo rspace="0.170em">)</mo></mrow><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\ex[\Phi(Z_{1:k-1},Z_{k}^{\prime})+\sum_{\begin{subarray}{c}i\notin J\\
i\geq k+1\\
j(i)=k\end{subarray}}{\color[rgb]{0,0,0}\varepsilon}_{i}^{\prime}\left(\lvert G_{i}^{\prime}\rvert+d_{i}(Z_{k})\right)\nonscript\,|\nonscript\,\mathopen{}Z_{1:k-1}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.61)</span></td></tr></tbody>
<tbody id="A5.E62"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E62.m1" class="ltx_math_unparsed" alttext="\displaystyle=\ex[\Phi(Z_{1:k-1},Z_{k}^{\prime})+\sum_{\begin{subarray}{c}i\notin J\\
i\geq k+1\\
j(i)=k\end{subarray}}{\color[rgb]{0,0,0}\varepsilon}_{i}^{\prime}\left(\lvert G_{i}^{\prime}\rvert+d_{i}(Z_{k})\right)\nonscript\,|\nonscript\,\mathopen{}Z_{1:k},\mathcal{G}]\,," display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msubsup><mi>Z</mi><mi>k</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>i</mi><mo>∉</mo><mi>J</mi></mrow></mtd></mtr><mtr><mtd><mrow><mi>i</mi><mo>≥</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>k</mi></mrow></mtd></mtr></mtable></munder></mstyle><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>i</mi><mo>′</mo></msubsup><mrow><mo>(</mo><mrow><mo stretchy="false">|</mo><msubsup><mi>G</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">|</mo></mrow><mo>+</mo><msub><mi>d</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo rspace="0.170em">)</mo></mrow><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo rspace="0.170em" stretchy="false">]</mo></mrow><mo>,</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\ex[\Phi(Z_{1:k-1},Z_{k}^{\prime})+\sum_{\begin{subarray}{c}i\notin J\\
i\geq k+1\\
j(i)=k\end{subarray}}{\color[rgb]{0,0,0}\varepsilon}_{i}^{\prime}\left(\lvert G_{i}^{\prime}\rvert+d_{i}(Z_{k})\right)\nonscript\,|\nonscript\,\mathopen{}Z_{1:k},\mathcal{G}]\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.62)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p27.2" class="ltx_p"><span id="A5.SS1.p27.2.1" class="ltx_text">by construction.</span></p>
</div>
<div id="A5.SS1.p28" class="ltx_para">
<p id="A5.SS1.p28.1" class="ltx_p"><span id="A5.SS1.p28.1.1" class="ltx_text">Since both <math id="A5.SS1.p28.m1" class="ltx_Math" alttext="Y_{k}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mi>k</mi></msub><annotation encoding="application/x-tex">Y_{k}</annotation></semantics></math> and <math id="A5.SS1.p28.m2" class="ltx_math_unparsed" alttext="\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:k-1}]-\ex[S]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo fence="false" lspace="0.170em" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">]</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:k-1}]-\ex[S]</annotation></semantics></math> are <math id="A5.SS1.p28.m3" class="ltx_Math" alttext="\sigma(\mathcal{F}_{k},\mathcal{G})" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>k</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\sigma(\mathcal{F}_{k},\mathcal{G})</annotation></semantics></math>-measurable,
by Jensen’s inequality (convexity of <math id="A5.SS1.p28.m4" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math>) applied to the conditional expectation w.r.t. <math id="A5.SS1.p28.m5" class="ltx_math_unparsed" alttext="Z_{1:k},\mathcal{G}" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow><annotation encoding="application/x-tex">Z_{1:k},\mathcal{G}</annotation></semantics></math>, we have</span></p>
<table id="A5.EGx51" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E63.m1" class="ltx_math_unparsed" alttext="\displaystyle\ex\left[{\color[rgb]{0,0,0}h}\left(Y_{k}+\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:k}]-\ex[S]\right)\nonscript\,\middle|\nonscript\,\mathopen{}Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mrow><mo>(</mo><msub><mi>Y</mi><mi>k</mi></msub><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo fence="false" lspace="0.170em" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo stretchy="false">]</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo stretchy="false">]</mo></mrow><mo>)</mo></mrow><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><mrow><mphantom></mphantom><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ex\left[{\color[rgb]{0,0,0}h}\left(Y_{k}+\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:k}]-\ex[S]\right)\nonscript\,\middle|\nonscript\,\mathopen{}Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.63)</span></td></tr></tbody>
<tbody id="A5.E64"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E64.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\ex\left[{\color[rgb]{0,0,0}h}\left(Y_{k}+\Phi(Z_{1:k})-\Phi(Z_{1:k-1},Z_{k}^{\prime})-\sum_{\begin{subarray}{c}i\notin J\\
i\geq k+1\\
j(i)=k\end{subarray}}{\color[rgb]{0,0,0}\varepsilon}_{i}^{\prime}\left(\lvert G_{i}^{\prime}\rvert+d_{i}(Z_{k})\right)+\ex\left[S\nonscript\,\middle|\nonscript\,\mathopen{}Z_{1:k-1}\right]-\ex[S]\right)\nonscript\,\middle|\nonscript\,\mathopen{}Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right]\,." display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mrow><mo>(</mo><msub><mi>Y</mi><mi>k</mi></msub><mo>+</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msubsup><mi>Z</mi><mi>k</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>i</mi><mo>∉</mo><mi>J</mi></mrow></mtd></mtr><mtr><mtd><mrow><mi>i</mi><mo>≥</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>k</mi></mrow></mtd></mtr></mtable></munder></mstyle><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>i</mi><mo>′</mo></msubsup><mrow><mo>(</mo><mrow><mo stretchy="false">|</mo><msubsup><mi>G</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">|</mo></mrow><mo>+</mo><msub><mi>d</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mi>S</mi><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>]</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo stretchy="false">]</mo></mrow><mo>)</mo></mrow><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><mrow><mphantom></mphantom><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub><mo>]</mo></mrow><mo lspace="0.170em">.</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\ex\left[{\color[rgb]{0,0,0}h}\left(Y_{k}+\Phi(Z_{1:k})-\Phi(Z_{1:k-1},Z_{k}^{\prime})-\sum_{\begin{subarray}{c}i\notin J\\
i\geq k+1\\
j(i)=k\end{subarray}}{\color[rgb]{0,0,0}\varepsilon}_{i}^{\prime}\left(\lvert G_{i}^{\prime}\rvert+d_{i}(Z_{k})\right)+\ex\left[S\nonscript\,\middle|\nonscript\,\mathopen{}Z_{1:k-1}\right]-\ex[S]\right)\nonscript\,\middle|\nonscript\,\mathopen{}Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right]\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.64)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p28.2" class="ltx_p"><span id="A5.SS1.p28.2.1" class="ltx_text">We write <math id="A5.SS1.p28.m6" class="ltx_Math" alttext="Y_{k}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mi>k</mi></msub><annotation encoding="application/x-tex">Y_{k}</annotation></semantics></math> as</span></p>
<table id="A5.E65" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E65.m1" class="ltx_Math" alttext="Y_{k}=Y_{k-1}+\sum_{\begin{subarray}{c}i\notin J\\
i\geq k+1\\
j(i)=k\end{subarray}}{\color[rgb]{0,0,0}\varepsilon}_{i}\left(\lvert G_{i}\rvert+d_{i}(Z_{k})\right)\,," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>Y</mi><mi>k</mi></msub><mo>=</mo><mrow><msub><mi>Y</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo rspace="0.055em">+</mo><mrow><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>i</mi><mo>∉</mo><mi>J</mi></mrow></mtd></mtr><mtr><mtd><mrow><mi>i</mi><mo>≥</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>k</mi></mrow></mtd></mtr></mtable></munder><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>G</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.170em">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">Y_{k}=Y_{k-1}+\sum_{\begin{subarray}{c}i\notin J\\
i\geq k+1\\
j(i)=k\end{subarray}}{\color[rgb]{0,0,0}\varepsilon}_{i}\left(\lvert G_{i}\rvert+d_{i}(Z_{k})\right)\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.65)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p28.3" class="ltx_p"><span id="A5.SS1.p28.3.1" class="ltx_text">where <math id="A5.SS1.p28.m7" class="ltx_Math" alttext="Y_{k-1}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">Y_{k-1}</annotation></semantics></math> is <math id="A5.SS1.p28.m8" class="ltx_Math" alttext="\sigma(\mathcal{F}_{k-1},\mathcal{G})" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\sigma(\mathcal{F}_{k-1},\mathcal{G})</annotation></semantics></math>-measurable and obtain,</span></p>
</div>
<div id="A5.SS1.p29" class="ltx_para">
<table id="A5.EGx52" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E66"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E66.m1" class="ltx_math_unparsed" alttext="\displaystyle\ex\left[{\color[rgb]{0,0,0}h}\left(Y_{k-1}+\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:k}]-\ex[S]\right)\nonscript\,\middle|\nonscript\,\mathopen{}Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mrow><mo>(</mo><msub><mi>Y</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo fence="false" lspace="0.170em" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo stretchy="false">]</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo stretchy="false">]</mo></mrow><mo>)</mo></mrow><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><mrow><mphantom></mphantom><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ex\left[{\color[rgb]{0,0,0}h}\left(Y_{k-1}+\ex[S\nonscript\,|\nonscript\,\mathopen{}Z_{1:k}]-\ex[S]\right)\nonscript\,\middle|\nonscript\,\mathopen{}Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.66)</span></td></tr></tbody>
<tbody id="A5.E67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E67.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\ex\left[{\color[rgb]{0,0,0}h}\left(Y_{k-1}+\Phi(Z_{1:k})-\Phi(Z_{1:k-1},Z_{k}^{\prime})+\sum_{\begin{subarray}{c}i\notin J\\
i\geq k+1\\
j(i)=k\end{subarray}}{\color[rgb]{0,0,0}\varepsilon}_{i}\left(\lvert G_{i}\rvert+d_{i}(Z_{k})\right)-{\color[rgb]{0,0,0}\varepsilon}_{i}^{\prime}\left(\lvert G_{i}^{\prime}\rvert+d_{i}(Z_{k})\right)+\ex\left[S\nonscript\,\middle|\nonscript\,\mathopen{}Z_{1:k-1}\right]-\ex[S]\right)\nonscript\,\middle|\nonscript\,\mathopen{}Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right]\,." display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mrow><mo>(</mo><msub><mi>Y</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>+</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msubsup><mi>Z</mi><mi>k</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>i</mi><mo>∉</mo><mi>J</mi></mrow></mtd></mtr><mtr><mtd><mrow><mi>i</mi><mo>≥</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>k</mi></mrow></mtd></mtr></mtable></munder></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>i</mi></msub><mrow><mo>(</mo><mrow><mo stretchy="false">|</mo><msub><mi>G</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><msub><mi>d</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>−</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>i</mi><mo>′</mo></msubsup><mrow><mo>(</mo><mrow><mo stretchy="false">|</mo><msubsup><mi>G</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">|</mo></mrow><mo>+</mo><msub><mi>d</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mi>S</mi><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><mrow><mphantom></mphantom><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>]</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo stretchy="false">[</mo><mi>S</mi><mo stretchy="false">]</mo></mrow><mo>)</mo></mrow><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><mrow><mphantom></mphantom><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub><mo>]</mo></mrow><mo lspace="0.170em">.</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\ex\left[{\color[rgb]{0,0,0}h}\left(Y_{k-1}+\Phi(Z_{1:k})-\Phi(Z_{1:k-1},Z_{k}^{\prime})+\sum_{\begin{subarray}{c}i\notin J\\
i\geq k+1\\
j(i)=k\end{subarray}}{\color[rgb]{0,0,0}\varepsilon}_{i}\left(\lvert G_{i}\rvert+d_{i}(Z_{k})\right)-{\color[rgb]{0,0,0}\varepsilon}_{i}^{\prime}\left(\lvert G_{i}^{\prime}\rvert+d_{i}(Z_{k})\right)+\ex\left[S\nonscript\,\middle|\nonscript\,\mathopen{}Z_{1:k-1}\right]-\ex[S]\right)\nonscript\,\middle|\nonscript\,\mathopen{}Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}\right]\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.67)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS1.p30" class="ltx_para">
<p id="A5.SS1.p30.1" class="ltx_p"><span id="A5.SS1.p30.1.1" class="ltx_text">We now make the following domination argument conditionally on <math id="A5.SS1.p30.m1" class="ltx_Math" alttext="\mathcal{F}_{k-1},Y_{k-1},Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>Y</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{F}_{k-1},Y_{k-1},Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}</annotation></semantics></math>.
The random variable</span></p>
<table id="A5.E68" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E68.m1" class="ltx_math_unparsed" alttext="\Phi(Z_{1:k})-\Phi(Z_{1:k-1},Z_{k}^{\prime})+\sum_{\begin{subarray}{c}i\notin J\\
i\geq k+1\\
j(i)=k\end{subarray}}{\color[rgb]{0,0,0}\varepsilon}_{i}\left(\lvert G_{i}\rvert+d_{i}(Z_{k})\right)-{\color[rgb]{0,0,0}\varepsilon}_{i}^{\prime}\left(\lvert G_{i}^{\prime}\rvert+d_{i}(Z_{k})\right)" display="block" intent=":literal"><semantics><mrow><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msubsup><mi>Z</mi><mi>k</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo rspace="0.055em">+</mo><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>i</mi><mo>∉</mo><mi>J</mi></mrow></mtd></mtr><mtr><mtd><mrow><mi>i</mi><mo>≥</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>k</mi></mrow></mtd></mtr></mtable></munder><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>i</mi></msub><mrow><mo>(</mo><mrow><mo stretchy="false">|</mo><msub><mi>G</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><msub><mi>d</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>−</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>i</mi><mo>′</mo></msubsup><mrow><mo>(</mo><mrow><mo stretchy="false">|</mo><msubsup><mi>G</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">|</mo></mrow><mo>+</mo><msub><mi>d</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\Phi(Z_{1:k})-\Phi(Z_{1:k-1},Z_{k}^{\prime})+\sum_{\begin{subarray}{c}i\notin J\\
i\geq k+1\\
j(i)=k\end{subarray}}{\color[rgb]{0,0,0}\varepsilon}_{i}\left(\lvert G_{i}\rvert+d_{i}(Z_{k})\right)-{\color[rgb]{0,0,0}\varepsilon}_{i}^{\prime}\left(\lvert G_{i}^{\prime}\rvert+d_{i}(Z_{k})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.68)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p30.2" class="ltx_p"><span id="A5.SS1.p30.2.1" class="ltx_text">is symmetric and, by assumption (i) and the triangle inequality, bounded in absolute value by</span></p>
<table id="A5.E69" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E69.m1" class="ltx_Math" alttext="\left\lvert{\color[rgb]{0,0,0}\varepsilon}_{k}c_{k}(Z_{k},Z_{k}^{\prime})+\sum_{\begin{subarray}{c}i\notin J\\
i\geq k+1\\
j(i)=k\end{subarray}}\sym_{#1}\left({\color[rgb]{0,0,0}\varepsilon}_{i}\left(\lvert G_{i}\rvert+d_{i}(Z_{k})\right)\right)\right\rvert\,." display="block" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>k</mi></msub><mo>,</mo><msubsup><mi>Z</mi><mi>k</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">+</mo><mrow><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>i</mi><mo>∉</mo><mi>J</mi></mrow></mtd></mtr><mtr><mtd><mrow><mi>i</mi><mo>≥</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>k</mi></mrow></mtd></mtr></mtable></munder><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Sym</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>G</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>|</mo></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">\left\lvert{\color[rgb]{0,0,0}\varepsilon}_{k}c_{k}(Z_{k},Z_{k}^{\prime})+\sum_{\begin{subarray}{c}i\notin J\\
i\geq k+1\\
j(i)=k\end{subarray}}\sym_{#1}\left({\color[rgb]{0,0,0}\varepsilon}_{i}\left(\lvert G_{i}\rvert+d_{i}(Z_{k})\right)\right)\right\rvert\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.69)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p30.3" class="ltx_p"><span id="A5.SS1.p30.3.1" class="ltx_text">Applying <a href="#A5.Thmlemma2" title="Lemma E.2 (Convex domination). ‣ E.1 Moment bounds for general functions ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">E.2</span></a> conditionally on <math id="A5.SS1.p30.m2" class="ltx_Math" alttext="\mathcal{F}_{k-1},Y_{k-1},Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>Y</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>Y</mi><mrow><mpadded style="width:0.390em;" width="0.390em"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mpadded><mo>⁣</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⟂</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{F}_{k-1},Y_{k-1},Y_{\color[rgb]{0,0,0}\perp\!\!\!\perp}</annotation></semantics></math> with <math id="A5.SS1.p30.m3" class="ltx_Math" alttext="C=1" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">C=1</annotation></semantics></math> (hence no constant appears) yields the desired result.</span></p>
</div>
<div id="A5.SS1.p31" class="ltx_para">
<p id="A5.SS1.p31.1" class="ltx_p"><span id="A5.SS1.p31.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A5.SS1.p32" class="ltx_para">
<p id="A5.SS1.p32.1" class="ltx_p">We can now combine <a href="#A5.Thmlemma1" title="Lemma E.1. ‣ E.1 Moment bounds for general functions ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">E.1</span></a> and <a href="#A5.Thmlemma4" title="Lemma E.4 (Causal symmetrization). ‣ E.1 Moment bounds for general functions ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">E.4</span></a> to obtain the main moment bound of this section.</p>
</div>
<div id="A5.Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A5.Thmtheorem1.2" class="ltx_text ltx_font_bold">Theorem E.1</span></span><span id="A5.Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(Causal symmetrization)<span id="A5.Thmtheorem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A5.Thmtheorem1.p1" class="ltx_para">
<p id="A5.Thmtheorem1.p1.1" class="ltx_p"><span id="A5.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A5.Thmtheorem1.p1.m1" class="ltx_Math" alttext="m\in{\color[rgb]{0,0,0}\mathbb{N}}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℕ</mi></mrow><annotation encoding="application/x-tex">m\in{\color[rgb]{0,0,0}\mathbb{N}}</annotation></semantics></math> and <math id="A5.Thmtheorem1.p1.m2" class="ltx_Math" alttext="(\mathcal{Z},\mathcal{A})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{Z},\mathcal{A})</annotation></semantics></math> be a standard Borel measurable space. Let <math id="A5.Thmtheorem1.p1.m3" class="ltx_Math" alttext="Z_{1},\ldots,Z_{m}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>Z</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">Z_{1},\ldots,Z_{m}</annotation></semantics></math> be <math id="A5.Thmtheorem1.p1.m4" class="ltx_Math" alttext="\mathcal{Z}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒵</mi><annotation encoding="application/x-tex">\mathcal{Z}</annotation></semantics></math>-valued random with natural filtration <math id="A5.Thmtheorem1.p1.m5" class="ltx_Math" alttext="(\mathcal{F}_{i})_{i=0,\dots,m}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}_{i})_{i=0,\dots,m}</annotation></semantics></math>.
Let <math id="A5.Thmtheorem1.p1.m6" class="ltx_Math" alttext="{\color[rgb]{0,0,0}h}\colon{\color[rgb]{0,0,0}\mathbb{R}}\to{\color[rgb]{0,0,0}\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mo stretchy="false">→</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}h}\colon{\color[rgb]{0,0,0}\mathbb{R}}\to{\color[rgb]{0,0,0}\mathbb{R}}</annotation></semantics></math> be convex.</span></p>
</div>
<div id="A5.Thmtheorem1.p2" class="ltx_para">
<p id="A5.Thmtheorem1.p2.1" class="ltx_p"><span id="A5.Thmtheorem1.p2.1.1" class="ltx_text ltx_font_italic">Let <math id="A5.Thmtheorem1.p2.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}g}\colon\mathcal{Z}^{m}\to{\color[rgb]{0,0,0}\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">g</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒵</mi><mi>m</mi></msup><mo stretchy="false">→</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}g}\colon\mathcal{Z}^{m}\to{\color[rgb]{0,0,0}\mathbb{R}}</annotation></semantics></math> be measurable and coordinate-wise Lipschitz with respect to cost functions <math id="A5.Thmtheorem1.p2.m2" class="ltx_Math" alttext="\rho_{i}\colon\mathcal{Z}\times\mathcal{Z}\to[0,\infty)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒵</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho_{i}\colon\mathcal{Z}\times\mathcal{Z}\to[0,\infty)</annotation></semantics></math> such that <math id="A5.Thmtheorem1.p2.m3" class="ltx_Math" alttext="\rho_{i}(z_{i},z_{i})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ρ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>i</mi></msub><mo>,</mo><msub><mi>z</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\rho_{i}(z_{i},z_{i})=0</annotation></semantics></math> with constants <math id="A5.Thmtheorem1.p2.m4" class="ltx_Math" alttext="L_{i}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">L_{i}\geq 0</annotation></semantics></math>: for any <math id="A5.Thmtheorem1.p2.m5" class="ltx_Math" alttext="z,z^{\prime}\in\mathcal{Z}^{m}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>,</mo><mrow><msup><mi>z</mi><mo>′</mo></msup><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒵</mi><mi>m</mi></msup></mrow></mrow><annotation encoding="application/x-tex">z,z^{\prime}\in\mathcal{Z}^{m}</annotation></semantics></math> differing only in the <math id="A5.Thmtheorem1.p2.m6" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th coordinate,</span></p>
<table id="A5.E70" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E70.m1" class="ltx_Math" alttext="|{\color[rgb]{0,0,0}g}(z)-{\color[rgb]{0,0,0}g}(z^{\prime})|\leq L_{i}\rho_{i}(z_{i},z_{i}^{\prime})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>z</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>z</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|{\color[rgb]{0,0,0}g}(z)-{\color[rgb]{0,0,0}g}(z^{\prime})|\leq L_{i}\rho_{i}(z_{i},z_{i}^{\prime}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.70)</span></td></tr></tbody>
</table>
<p id="A5.Thmtheorem1.p2.2" class="ltx_p"><span id="A5.Thmtheorem1.p2.2.1" class="ltx_text ltx_font_italic">Set <math id="A5.Thmtheorem1.p2.m7" class="ltx_Math" alttext="S:={\color[rgb]{0,0,0}g}(Z_{1},\ldots,Z_{m})" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>:=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>Z</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">S:={\color[rgb]{0,0,0}g}(Z_{1},\ldots,Z_{m})</annotation></semantics></math> and</span></p>
</div>
<div id="A5.Thmtheorem1.p3" class="ltx_para">
<p id="A5.Thmtheorem1.p3.1" class="ltx_p"><span id="A5.Thmtheorem1.p3.1.1" class="ltx_text ltx_font_italic">For each <math id="A5.Thmtheorem1.p3.m1" class="ltx_Math" alttext="i\in\{1,\ldots,m\}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>m</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\{1,\ldots,m\}</annotation></semantics></math>, assume there exists a conditionally independent resample</span></p>
<table id="A5.E71" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E71.m1" class="ltx_math_unparsed" alttext="Z_{i}^{\prime}\sim\mathrm{Law}(Z_{i}\mid\mathcal{F}_{i-1}),\quad Z_{i}^{\prime}\perp\!\!\!\perp Z_{i}\mid\mathcal{F}_{i-1}." display="block" intent=":literal"><semantics><mrow><msubsup><mi>Z</mi><mi>i</mi><mo>′</mo></msubsup><mo>∼</mo><mi>Law</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo rspace="1.167em">,</mo><msubsup><mi>Z</mi><mi>i</mi><mo>′</mo></msubsup><mpadded style="width:0.240em;" width="0.240em"><mo>⟂</mo></mpadded><mo>⟂</mo><msub><mi>Z</mi><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Z_{i}^{\prime}\sim\mathrm{Law}(Z_{i}\mid\mathcal{F}_{i-1}),\quad Z_{i}^{\prime}\perp\!\!\!\perp Z_{i}\mid\mathcal{F}_{i-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.71)</span></td></tr></tbody>
</table>
<p id="A5.Thmtheorem1.p3.2" class="ltx_p"><span id="A5.Thmtheorem1.p3.2.1" class="ltx_text ltx_font_italic">Let <math id="A5.Thmtheorem1.p3.m2" class="ltx_math_unparsed" alttext="{\color[rgb]{0,0,0}\varepsilon}_{1:m},{\color[rgb]{0,0,0}\varepsilon}_{1:m}^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>m</mi></mrow></msub><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>m</mi></mrow></msub><msup><mrow></mrow><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\varepsilon}_{1:m},{\color[rgb]{0,0,0}\varepsilon}_{1:m}^{\prime}</annotation></semantics></math> be independent Rademacher variables, independent of all <math id="A5.Thmtheorem1.p3.m3" class="ltx_Math" alttext="Z,Z^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>,</mo><msup><mi>Z</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">Z,Z^{\prime}</annotation></semantics></math> and <math id="A5.Thmtheorem1.p3.m4" class="ltx_Math" alttext="\mathcal{F}_{m}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{m}</annotation></semantics></math>.</span></p>
</div>
<div id="A5.Thmtheorem1.p4" class="ltx_para">
<p id="A5.Thmtheorem1.p4.1" class="ltx_p"><span id="A5.Thmtheorem1.p4.1.1" class="ltx_text ltx_font_italic">Assume there exist constants <math id="A5.Thmtheorem1.p4.m1" class="ltx_Math" alttext="c_{ik}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c_{ik}\geq 0</annotation></semantics></math>, measurable functions <math id="A5.Thmtheorem1.p4.m2" class="ltx_Math" alttext="d_{ik}:\mathcal{Z}\to[0,\infty)" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒵</mi><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d_{ik}:\mathcal{Z}\to[0,\infty)</annotation></semantics></math> and <math id="A5.Thmtheorem1.p4.m3" class="ltx_Math" alttext="J\subset\left\{1,\ldots,m\right\}" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>⊂</mo><mrow><mo>{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>m</mi></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">J\subset\left\{1,\ldots,m\right\}</annotation></semantics></math> such that, the following conditions hold:</span></p>
<ol id="A5.I2" class="ltx_enumerate">
<li id="A5.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="A5.I2.i1.p1" class="ltx_para">
<p id="A5.I2.i1.p1.1" class="ltx_p"><span id="A5.I2.i1.p1.1.1" class="ltx_text ltx_font_italic">For any </span><math id="A5.I2.i1.p1.m1" class="ltx_Math" alttext="i&lt;k" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>&lt;</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">i&lt;k</annotation></semantics></math><span id="A5.I2.i1.p1.1.2" class="ltx_text ltx_font_italic">, there exists </span><math id="A5.I2.i1.p1.m2" class="ltx_Math" alttext="j(i)\in J" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mi>J</mi></mrow><annotation encoding="application/x-tex">j(i)\in J</annotation></semantics></math><span id="A5.I2.i1.p1.1.3" class="ltx_text ltx_font_italic">, such that, for any </span><math id="A5.I2.i1.p1.m3" class="ltx_math_unparsed" alttext="z_{1:i-1}\in\mathcal{Z}^{i-1}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi><msup><mrow></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">z_{1:i-1}\in\mathcal{Z}^{i-1}</annotation></semantics></math><span id="A5.I2.i1.p1.1.4" class="ltx_text ltx_font_italic"> and </span><math id="A5.I2.i1.p1.m4" class="ltx_Math" alttext="z_{i},z_{i}^{\prime}\in\mathcal{Z}" display="inline" intent=":literal"><semantics><mrow><msub><mi>z</mi><mi>i</mi></msub><mo>,</mo><mrow><msubsup><mi>z</mi><mi>i</mi><mo>′</mo></msubsup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></mrow></mrow><annotation encoding="application/x-tex">z_{i},z_{i}^{\prime}\in\mathcal{Z}</annotation></semantics></math><span id="A5.I2.i1.p1.1.5" class="ltx_text ltx_font_italic">,</span></p>
<table id="A5.E72" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E72.m1" class="ltx_math_unparsed" alttext="W_{#1}\left(\mathrm{Law}(Z_{k}\mid Z_{1:i}=z_{1:i}),\mathrm{Law}(Z_{k}\mid Z_{1:i-1}=z_{1:i-1},Z_{i}=z_{i}^{\prime})\right)\leq c_{ik}\rho_{i}(z_{i},z_{i}^{\prime})+d_{ik}(z_{j(i)})\one\{i\notin J\}\,." display="block" intent=":literal"><semantics><mrow><msub><mi>W</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>(</mo><mi>Law</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>k</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo>=</mo><msub><mi>z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>Law</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>k</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>Z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>=</mo><msub><mi>z</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msub><mi>Z</mi><mi>i</mi></msub><mo>=</mo><msubsup><mi>z</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>≤</mo><msub><mi>c</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><msub><mi>ρ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>z</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>d</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo rspace="0.167em" stretchy="false">)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo stretchy="false">{</mo><mi>i</mi><mo>∉</mo><mi>J</mi><mo stretchy="false">}</mo></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">W_{#1}\left(\mathrm{Law}(Z_{k}\mid Z_{1:i}=z_{1:i}),\mathrm{Law}(Z_{k}\mid Z_{1:i-1}=z_{1:i-1},Z_{i}=z_{i}^{\prime})\right)\leq c_{ik}\rho_{i}(z_{i},z_{i}^{\prime})+d_{ik}(z_{j(i)})\one\{i\notin J\}\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.72)</span></td></tr></tbody>
</table>
</div></li>
<li id="A5.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="A5.I2.i2.p1" class="ltx_para">
<p id="A5.I2.i2.p1.1" class="ltx_p"><span id="A5.I2.i2.p1.1.1" class="ltx_text ltx_font_italic">For any </span><math id="A5.I2.i2.p1.m1" class="ltx_Math" alttext="i\notin J" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∉</mo><mi>J</mi></mrow><annotation encoding="application/x-tex">i\notin J</annotation></semantics></math><span id="A5.I2.i2.p1.1.2" class="ltx_text ltx_font_italic">, </span><math id="A5.I2.i2.p1.m2" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\varepsilon}_{i}\rho_{i}(Z_{i},Z_{i}^{\prime})" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>Z</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\varepsilon}_{i}\rho_{i}(Z_{i},Z_{i}^{\prime})</annotation></semantics></math><span id="A5.I2.i2.p1.1.3" class="ltx_text ltx_font_italic"> is </span><math id="A5.I2.i2.p1.m3" class="ltx_Math" alttext="\sigma_{i}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>σ</mi><mi>i</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">\sigma_{i}^{2}</annotation></semantics></math><span id="A5.I2.i2.p1.1.4" class="ltx_text ltx_font_italic">-sub-Gaussian conditionally on </span><math id="A5.I2.i2.p1.m4" class="ltx_Math" alttext="\mathcal{F}_{i-1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\mathcal{F}_{i-1}</annotation></semantics></math><span id="A5.I2.i2.p1.1.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A5.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(iii)</span> 
<div id="A5.I2.i3.p1" class="ltx_para">
<p id="A5.I2.i3.p1.1" class="ltx_p"><span id="A5.I2.i3.p1.1.1" class="ltx_text ltx_font_italic">For any </span><math id="A5.I2.i3.p1.m1" class="ltx_Math" alttext="j\in J" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mi>J</mi></mrow><annotation encoding="application/x-tex">j\in J</annotation></semantics></math><span id="A5.I2.i3.p1.1.2" class="ltx_text ltx_font_italic">, </span><math id="A5.I2.i3.p1.m2" class="ltx_Math" alttext="Z_{j}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mi>j</mi></msub><annotation encoding="application/x-tex">Z_{j}</annotation></semantics></math><span id="A5.I2.i3.p1.1.3" class="ltx_text ltx_font_italic"> is independent of </span><math id="A5.I2.i3.p1.m3" class="ltx_Math" alttext="\mathcal{F}_{j-1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\mathcal{F}_{j-1}</annotation></semantics></math><span id="A5.I2.i3.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
<p id="A5.Thmtheorem1.p4.2" class="ltx_p"><span id="A5.Thmtheorem1.p4.2.1" class="ltx_text ltx_font_italic">Then, there are Gausssian random variables <math id="A5.Thmtheorem1.p4.m4" class="ltx_Math" alttext="G_{j},G_{j}^{\prime}\sim\mathcal{N}(0,8\sigma_{j}^{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>j</mi></msub><mo>,</mo><mrow><msubsup><mi>G</mi><mi>j</mi><mo>′</mo></msubsup><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>j</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">G_{j},G_{j}^{\prime}\sim\mathcal{N}(0,8\sigma_{j}^{2})</annotation></semantics></math> independent and independent of all <math id="A5.Thmtheorem1.p4.m5" class="ltx_Math" alttext="Z,Z^{\prime},{\color[rgb]{0,0,0}\varepsilon},\mathcal{F}_{m}" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>,</mo><msup><mi>Z</mi><mo>′</mo></msup><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">Z,Z^{\prime},{\color[rgb]{0,0,0}\varepsilon},\mathcal{F}_{m}</annotation></semantics></math> such that</span></p>
<table id="A5.EGx53" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E73"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E73.m1" class="ltx_Math" alttext="\displaystyle\ex[{\color[rgb]{0,0,0}h}(S-\ex[S])]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>S</mi><mo>−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>S</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ex[{\color[rgb]{0,0,0}h}(S-\ex[S])]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.73)</span></td></tr></tbody>
<tbody id="A5.E74"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E74.m1" class="ltx_Math" alttext="\displaystyle\leq\ex\left[{\color[rgb]{0,0,0}h}\left(\sum_{i\notin J}\sym_{#1}\left({\color[rgb]{0,0,0}\varepsilon}_{i}\left(L_{i}\lvert G_{i}\rvert+\sum_{k&gt;i}L_{k}c_{ik}\lvert G_{i}\rvert+L_{k}d_{ik}(Z_{j(i)})\right)\right)+\sum_{j\in J}{\color[rgb]{0,0,0}\varepsilon}_{j}\left(L_{j}\rho_{j}(Z_{j},Z_{j}^{\prime})+\sum_{k&gt;j}L_{k}c_{jk}\rho_{j}(Z_{j},Z_{j}^{\prime})\right)\right)\right]," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∉</mo><mi>J</mi></mrow></munder></mstyle><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Sym</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>L</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>G</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>&gt;</mo><mi>i</mi></mrow></munder></mstyle><mrow><msub><mi>L</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi>ik</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>G</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>L</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>ik</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>∈</mo><mi>J</mi></mrow></munder></mstyle><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>L</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>j</mi></msub><mo>,</mo><msubsup><mi>Z</mi><mi>j</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>&gt;</mo><mi>j</mi></mrow></munder></mstyle><mrow><msub><mi>L</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi>jk</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>j</mi></msub><mo>,</mo><msubsup><mi>Z</mi><mi>j</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\ex\left[{\color[rgb]{0,0,0}h}\left(\sum_{i\notin J}\sym_{#1}\left({\color[rgb]{0,0,0}\varepsilon}_{i}\left(L_{i}\lvert G_{i}\rvert+\sum_{k&gt;i}L_{k}c_{ik}\lvert G_{i}\rvert+L_{k}d_{ik}(Z_{j(i)})\right)\right)+\sum_{j\in J}{\color[rgb]{0,0,0}\varepsilon}_{j}\left(L_{j}\rho_{j}(Z_{j},Z_{j}^{\prime})+\sum_{k&gt;j}L_{k}c_{jk}\rho_{j}(Z_{j},Z_{j}^{\prime})\right)\right)\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.74)</span></td></tr></tbody>
</table>
<p id="A5.Thmtheorem1.p4.3" class="ltx_p"><span id="A5.Thmtheorem1.p4.3.1" class="ltx_text ltx_font_italic">where we use the notation:</span></p>
<table id="A5.EGx54" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E75"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E75.m1" class="ltx_Math" alttext="\displaystyle\sym_{#1}\left({\color[rgb]{0,0,0}\varepsilon}_{i}\left(L_{i}\lvert G_{i}\rvert+\sum_{k&gt;i}L_{k}c_{ik}\lvert G_{i}\rvert+L_{k}d_{ik}(Z_{j(i)})\right)\right)\coloneqq" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Sym</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>L</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>G</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>&gt;</mo><mi>i</mi></mrow></munder></mstyle><mrow><msub><mi>L</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi>ik</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>G</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>L</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>ik</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>≔</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\sym_{#1}\left({\color[rgb]{0,0,0}\varepsilon}_{i}\left(L_{i}\lvert G_{i}\rvert+\sum_{k&gt;i}L_{k}c_{ik}\lvert G_{i}\rvert+L_{k}d_{ik}(Z_{j(i)})\right)\right)\coloneqq</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.75)</span></td></tr></tbody>
<tbody id="A5.E76"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E76.m1" class="ltx_Math" alttext="\displaystyle{\color[rgb]{0,0,0}\varepsilon}_{j(i)}\left({\color[rgb]{0,0,0}\varepsilon}_{i}\left(L_{i}\lvert G_{i}\rvert+\sum_{k&gt;i}L_{k}c_{ik}\lvert G_{i}\rvert+L_{k}d_{ik}(Z_{j(i)})\right)-{\color[rgb]{0,0,0}\varepsilon}_{i}^{\prime}\left(L_{i}\lvert G_{i}^{\prime}\rvert+\sum_{k&gt;i}L_{k}c_{ik}\lvert G_{i}^{\prime}\rvert+L_{k}d_{ik}(Z_{j(i)})\right)\right)\,." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>L</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>G</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>&gt;</mo><mi>i</mi></mrow></munder></mstyle><mrow><msub><mi>L</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>G</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>L</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mi>i</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>L</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msubsup><mi>G</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>&gt;</mo><mi>i</mi></mrow></munder></mstyle><mrow><msub><mi>L</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msubsup><mi>G</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">|</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>L</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\color[rgb]{0,0,0}\varepsilon}_{j(i)}\left({\color[rgb]{0,0,0}\varepsilon}_{i}\left(L_{i}\lvert G_{i}\rvert+\sum_{k&gt;i}L_{k}c_{ik}\lvert G_{i}\rvert+L_{k}d_{ik}(Z_{j(i)})\right)-{\color[rgb]{0,0,0}\varepsilon}_{i}^{\prime}\left(L_{i}\lvert G_{i}^{\prime}\rvert+\sum_{k&gt;i}L_{k}c_{ik}\lvert G_{i}^{\prime}\rvert+L_{k}d_{ik}(Z_{j(i)})\right)\right)\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.76)</span></td></tr></tbody>
</table>
</div>
</div>
</section>
<section id="A5.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.2 </span>Technical lemmas</h3>

<div id="A5.SS2.p1" class="ltx_para">
<p id="A5.SS2.p1.1" class="ltx_p">We will make use of the following elementary lemma.</p>
</div>
<div id="A5.Thmlemma5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A5.Thmlemma5.2" class="ltx_text ltx_font_bold">Lemma E.5</span></span><span id="A5.Thmlemma5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A5.Thmlemma5.p1" class="ltx_para">
<p id="A5.Thmlemma5.p1.1" class="ltx_p"><span id="A5.Thmlemma5.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A5.Thmlemma5.p1.m1" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math> be a real-valued random variable. Assume there exist <math id="A5.Thmlemma5.p1.m2" class="ltx_Math" alttext="c\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c\geq 1</annotation></semantics></math>, <math id="A5.Thmlemma5.p1.m3" class="ltx_Math" alttext="f,g\colon{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathbb{R}}}\to{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathbb{R}}}_{+}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>,</mo><mi>g</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mo stretchy="false">→</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mo>+</mo></msub></mrow></mrow><annotation encoding="application/x-tex">f,g\colon{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathbb{R}}}\to{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathbb{R}}}_{+}</annotation></semantics></math> non-decreasing and <math id="A5.Thmlemma5.p1.m4" class="ltx_Math" alttext="p\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">p\geq 2</annotation></semantics></math> integer such that, for any integer <math id="A5.Thmlemma5.p1.m5" class="ltx_Math" alttext="q\in[2,p]" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>2</mn><mo>,</mo><mi>p</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">q\in[2,p]</annotation></semantics></math>,</span></p>
<table id="A5.E77" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E77.m1" class="ltx_Math" alttext="\ex[|Z|^{q}]^{1/q}\leq f(q)+c^{1/q}g(q)" display="block" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><msup><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">|</mo><mi>Z</mi><mo stretchy="false">|</mo></mrow><mi>q</mi></msup><mo stretchy="false">]</mo></mrow><mrow><mn>1</mn><mo>/</mo><mi>q</mi></mrow></msup></mrow><mo>≤</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>c</mi><mrow><mn>1</mn><mo>/</mo><mi>q</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\ex[|Z|^{q}]^{1/q}\leq f(q)+c^{1/q}g(q)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.77)</span></td></tr></tbody>
</table>
<p id="A5.Thmlemma5.p1.2" class="ltx_p"><span id="A5.Thmlemma5.p1.2.1" class="ltx_text ltx_font_italic">Then, for any <math id="A5.Thmlemma5.p1.m6" class="ltx_Math" alttext="\delta\in(0,e^{-2}]" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msup><mi>e</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,e^{-2}]</annotation></semantics></math>, with probability at least <math id="A5.Thmlemma5.p1.m7" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>,</span></p>
<table id="A5.E78" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E78.m1" class="ltx_Math" alttext="\left\lvert Z\right\rvert\leq\begin{cases}ef\left(\log(1/\delta)+1\right)+g(\log(1/\delta)+1)e&amp;\text{if }\delta\geq ce^{-p}\\
\frac{f(p)+c^{1/p}g(p)}{\delta^{1/p}}&amp;\text{if }\delta&lt;ce^{-p}\,.\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mi>Z</mi><mo>|</mo></mrow><mo>≤</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext class="ltx_mathvariant_italic">if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow><mo>≥</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>p</mi></mrow></msup></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mstyle displaystyle="false"><mfrac><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>c</mi><mrow><mn>1</mn><mo>/</mo><mi>p</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><msup><mi>δ</mi><mrow><mn>1</mn><mo>/</mo><mi>p</mi></mrow></msup></mfrac></mstyle></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext class="ltx_mathvariant_italic">if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow><mo>&lt;</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>p</mi></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\left\lvert Z\right\rvert\leq\begin{cases}ef\left(\log(1/\delta)+1\right)+g(\log(1/\delta)+1)e&amp;\text{if }\delta\geq ce^{-p}\\
\frac{f(p)+c^{1/p}g(p)}{\delta^{1/p}}&amp;\text{if }\delta&lt;ce^{-p}\,.\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.78)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS2.p2" class="ltx_para">
<p id="A5.SS2.p2.1" class="ltx_p"><span id="A5.SS2.p2.1.1" class="ltx_text">By Markov’s inequality, for any integer <math id="A5.SS2.p2.m1" class="ltx_Math" alttext="q\in[2,p]" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>2</mn><mo>,</mo><mi>p</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">q\in[2,p]</annotation></semantics></math>,</span></p>
<table id="A5.E79" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E79.m1" class="ltx_Math" alttext="\prob(|Z|\geq t)\leq\frac{\ex[|Z|^{q}]}{t^{q}}\leq\left(\frac{f(q)+c^{1/q}g(q)}{t}\right)^{q}\,." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi>Z</mi><mo stretchy="false">|</mo></mrow><mo>≥</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">|</mo><mi>Z</mi><mo stretchy="false">|</mo></mrow><mi>q</mi></msup><mo stretchy="false">]</mo></mrow></mrow><msup><mi>t</mi><mi>q</mi></msup></mfrac><mo>≤</mo><msup><mrow><mo>(</mo><mfrac><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>c</mi><mrow><mn>1</mn><mo>/</mo><mi>q</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mi>t</mi></mfrac><mo>)</mo></mrow><mi>q</mi></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\prob(|Z|\geq t)\leq\frac{\ex[|Z|^{q}]}{t^{q}}\leq\left(\frac{f(q)+c^{1/q}g(q)}{t}\right)^{q}\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.79)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p2.2" class="ltx_p"><span id="A5.SS2.p2.2.1" class="ltx_text">Setting the right-hand side to <math id="A5.SS2.p2.m2" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> and solving for <math id="A5.SS2.p2.m3" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> gives</span></p>
<table id="A5.E80" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E80.m1" class="ltx_Math" alttext="t=\frac{f(q)+c^{1/q}g(q)}{\delta^{1/q}}\,," display="block" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mfrac><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>c</mi><mrow><mn>1</mn><mo>/</mo><mi>q</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><msup><mi>δ</mi><mrow><mn>1</mn><mo>/</mo><mi>q</mi></mrow></msup></mfrac></mrow><mo lspace="0.170em">,</mo></mrow><annotation encoding="application/x-tex">t=\frac{f(q)+c^{1/q}g(q)}{\delta^{1/q}}\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.80)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS2.p3" class="ltx_para">
<p id="A5.SS2.p3.1" class="ltx_p"><span id="A5.SS2.p3.1.1" class="ltx_text">If <math id="A5.SS2.p3.m1" class="ltx_Math" alttext="\delta&lt;ce^{-p}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>&lt;</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>p</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\delta&lt;ce^{-p}</annotation></semantics></math>, we can take <math id="A5.SS2.p3.m2" class="ltx_Math" alttext="q=p" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">q=p</annotation></semantics></math> to obtain the second case of the result. If <math id="A5.SS2.p3.m3" class="ltx_Math" alttext="\delta\geq ce^{-p}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>≥</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>p</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\delta\geq ce^{-p}</annotation></semantics></math>, we take <math id="A5.SS2.p3.m4" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> the smallest integer such that <math id="A5.SS2.p3.m5" class="ltx_Math" alttext="q\geq\log(c/\delta)" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>≥</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q\geq\log(c/\delta)</annotation></semantics></math>. Note that <math id="A5.SS2.p3.m6" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> is in <math id="A5.SS2.p3.m7" class="ltx_Math" alttext="[2,p]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>2</mn><mo>,</mo><mi>p</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[2,p]</annotation></semantics></math> and <math id="A5.SS2.p3.m8" class="ltx_Math" alttext="q\leq\log(c/\delta)+2" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>≤</mo><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">q\leq\log(c/\delta)+2</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS2.p4" class="ltx_para">
<p id="A5.SS2.p4.1" class="ltx_p"><span id="A5.SS2.p4.1.1" class="ltx_text">Since <math id="A5.SS2.p4.m1" class="ltx_Math" alttext="c\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c\geq 1</annotation></semantics></math> and <math id="A5.SS2.p4.m2" class="ltx_Math" alttext="\delta\leq 1" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\delta\leq 1</annotation></semantics></math>, we have <math id="A5.SS2.p4.m3" class="ltx_Math" alttext="\log(c/\delta)\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\log(c/\delta)\geq 0</annotation></semantics></math> and thus <math id="A5.SS2.p4.m4" class="ltx_Math" alttext="\left(\frac{c}{\delta}\right)^{1/q}\leq\left(\frac{c}{\delta}\right)^{1/\log(c/\delta)}=e" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>(</mo><mfrac><mi>c</mi><mi>δ</mi></mfrac><mo>)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mi>q</mi></mrow></msup><mo>≤</mo><msup><mrow><mo>(</mo><mfrac><mi>c</mi><mi>δ</mi></mfrac><mo>)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo>=</mo><mi>e</mi></mrow><annotation encoding="application/x-tex">\left(\frac{c}{\delta}\right)^{1/q}\leq\left(\frac{c}{\delta}\right)^{1/\log(c/\delta)}=e</annotation></semantics></math>.
Plugging this into <a href="#A5.E80" title="In Proof. ‣ E.2 Technical lemmas ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">E.80</span></a> gives the bound in the first case.
∎</span></p>
</div>
</div>
<div id="A5.SS2.p5" class="ltx_para">
<p id="A5.SS2.p5.1" class="ltx_p">We state the following lemma about sub-Gaussian random variables that will be useful later.</p>
</div>
<div id="A5.Thmlemma6" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A5.Thmlemma6.2" class="ltx_text ltx_font_bold">Lemma E.6</span></span><span id="A5.Thmlemma6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A5.Thmlemma6.p1" class="ltx_para">
<p id="A5.Thmlemma6.p1.1" class="ltx_p"><span id="A5.Thmlemma6.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A5.Thmlemma6.p1.m1" class="ltx_Math" alttext="X\in{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathbb{R}}}^{m}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>∈</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mi>m</mi></msup></mrow><annotation encoding="application/x-tex">X\in{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathbb{R}}}^{m}</annotation></semantics></math> be a <math id="A5.Thmlemma6.p1.m2" class="ltx_Math" alttext="\sigma^{2}" display="inline" intent=":literal"><semantics><msup><mi>σ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\sigma^{2}</annotation></semantics></math>-sub-Gaussian random variable, i.e., for any <math id="A5.Thmlemma6.p1.m3" class="ltx_Math" alttext="\lambda&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda&gt;0</annotation></semantics></math>,</span></p>
<table id="A5.E81" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E81.m1" class="ltx_Math" alttext="\log\ex[e^{\lambda\lVert X-\ex[X]\rVert^{2}}]\leq\frac{\sigma^{2}\lambda^{2}}{2}\,." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>e</mi><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo fence="true" rspace="0em">∥</mo><mrow><mi>X</mi><mo>−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>X</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msup></mrow></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>≤</mo><mfrac><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup></mrow><mn>2</mn></mfrac></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">\log\ex[e^{\lambda\lVert X-\ex[X]\rVert^{2}}]\leq\frac{\sigma^{2}\lambda^{2}}{2}\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.81)</span></td></tr></tbody>
</table>
<p id="A5.Thmlemma6.p1.2" class="ltx_p"><span id="A5.Thmlemma6.p1.2.1" class="ltx_text ltx_font_italic">Then, for <math id="A5.Thmlemma6.p1.m4" class="ltx_Math" alttext="X^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>X</mi><mo>′</mo></msup><annotation encoding="application/x-tex">X^{\prime}</annotation></semantics></math> an <abbr title="" class="ltx_glossaryref ltx_missing">iid</abbr> copy of <math id="A5.Thmlemma6.p1.m5" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> and <math id="A5.Thmlemma6.p1.m6" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\varepsilon}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\varepsilon}</annotation></semantics></math> a Rademacher random variable independent of <math id="A5.Thmlemma6.p1.m7" class="ltx_Math" alttext="X,X^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>,</mo><msup><mi>X</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">X,X^{\prime}</annotation></semantics></math>, the random variable <math id="A5.Thmlemma6.p1.m8" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\varepsilon}\lVert X-X^{\prime}\rVert" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo fence="true" rspace="0em">∥</mo><mrow><mi>X</mi><mo>−</mo><msup><mi>X</mi><mo>′</mo></msup></mrow><mo fence="true" lspace="0em">∥</mo></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\varepsilon}\lVert X-X^{\prime}\rVert</annotation></semantics></math> is sub-Gaussian with parameter at most <math id="A5.Thmlemma6.p1.m9" class="ltx_Math" alttext="4\sigma^{2}" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">4\sigma^{2}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A5.SS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS2.p6" class="ltx_para">
<p id="A5.SS2.p6.1" class="ltx_p"><span id="A5.SS2.p6.1.1" class="ltx_text">Since <math id="A5.SS2.p6.m1" class="ltx_Math" alttext="Z\coloneqq{\color[rgb]{0,0,0}\varepsilon}\lVert X-X^{\prime}\rVert" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>≔</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mo lspace="0em">⁡</mo><mrow><mo fence="true" rspace="0em">∥</mo><mrow><mi>X</mi><mo>−</mo><msup><mi>X</mi><mo>′</mo></msup></mrow><mo fence="true" lspace="0em">∥</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Z\coloneqq{\color[rgb]{0,0,0}\varepsilon}\lVert X-X^{\prime}\rVert</annotation></semantics></math> is symmetric, it suffices to bound <math id="A5.SS2.p6.m2" class="ltx_Math" alttext="Z^{2}" display="inline" intent=":literal"><semantics><msup><mi>Z</mi><mn>2</mn></msup><annotation encoding="application/x-tex">Z^{2}</annotation></semantics></math> as</span></p>
<table id="A5.E82" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E82.m1" class="ltx_Math" alttext="Z^{2}=\lVert X-X^{\prime}\rVert^{2}\leq 2\lVert X-\ex[X]\rVert^{2}+2\lVert X^{\prime}-\ex[X]\rVert^{2}\,," display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>Z</mi><mn>2</mn></msup><mo rspace="0.1389em">=</mo><msup><mrow><mo fence="true" lspace="0.1389em" rspace="0em">∥</mo><mrow><mi>X</mi><mo>−</mo><msup><mi>X</mi><mo>′</mo></msup></mrow><mo fence="true" lspace="0em" rspace="0.1389em">∥</mo></mrow><mn>2</mn></msup><mo lspace="0.1389em">≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo fence="true" rspace="0em">∥</mo><mrow><mi>X</mi><mo>−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>X</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo fence="true" rspace="0em">∥</mo><mrow><msup><mi>X</mi><mo>′</mo></msup><mo>−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>X</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">Z^{2}=\lVert X-X^{\prime}\rVert^{2}\leq 2\lVert X-\ex[X]\rVert^{2}+2\lVert X^{\prime}-\ex[X]\rVert^{2}\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.82)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p6.2" class="ltx_p"><span id="A5.SS2.p6.2.1" class="ltx_text">by Young’s inequality. Using the independence of <math id="A5.SS2.p6.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> and <math id="A5.SS2.p6.m4" class="ltx_Math" alttext="X^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>X</mi><mo>′</mo></msup><annotation encoding="application/x-tex">X^{\prime}</annotation></semantics></math> yields the result.
∎</span></p>
</div>
</div>
<div id="A5.SS2.p7" class="ltx_para">
<p id="A5.SS2.p7.1" class="ltx_p">We will require the following chaining lemma for processes with <math id="A5.SS2.p7.m1" class="ltx_Math" alttext="L^{p}" display="inline" intent=":literal"><semantics><msup><mi>L</mi><mi>p</mi></msup><annotation encoding="application/x-tex">L^{p}</annotation></semantics></math>-Lipschitz increments.
This result is a variant of the famous Dudley’s entropy integral bound for sub-Gaussian processes, adapted to the <math id="A5.SS2.p7.m2" class="ltx_Math" alttext="L^{p}" display="inline" intent=":literal"><semantics><msup><mi>L</mi><mi>p</mi></msup><annotation encoding="application/x-tex">L^{p}</annotation></semantics></math>-Lipschitz setting.</p>
</div>
<div id="A5.SS2.p8" class="ltx_para">
<p id="A5.SS2.p8.1" class="ltx_p">This lemma is a direct consequence of the general chaining theory of <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib53" title="" class="ltx_ref">Talagrand (2022)</a></cite> (see <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib53" title="" class="ltx_ref">Talagrand (2022, Thm. B.2.3)</a></cite> with <math id="A5.SS2.p8.m1" class="ltx_Math" alttext="\phi(x)=x^{p}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mi>x</mi><mi>p</mi></msup></mrow><annotation encoding="application/x-tex">\phi(x)=x^{p}</annotation></semantics></math>). Let us also mention <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib17" title="" class="ltx_ref">Dirksen (2015)</a></cite> refined these ideas in the context of subpexponential processes while <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib28" title="" class="ltx_ref">Latała and Tkocz (2015)</a></cite> further developed these tools for processes with heavier tails but still admitting a control over all moments. In our setting, the increments are assumed to be controlled only in <math id="A5.SS2.p8.m2" class="ltx_Math" alttext="L^{p}" display="inline" intent=":literal"><semantics><msup><mi>L</mi><mi>p</mi></msup><annotation encoding="application/x-tex">L^{p}</annotation></semantics></math>, which requires a different treatment of the maximal inequalities at each scale.</p>
</div>
<div id="A5.Thmlemma7" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A5.Thmlemma7.2" class="ltx_text ltx_font_bold">Lemma E.7</span></span><span id="A5.Thmlemma7.3" class="ltx_text ltx_font_bold"> </span>(Dudley–type entropy integral under <math id="A5.Thmlemma7.m1" class="ltx_Math" alttext="L^{p}" display="inline" intent=":literal"><semantics><msup><mi>L</mi><mi>p</mi></msup><annotation encoding="application/x-tex">L^{p}</annotation></semantics></math> increments)<span id="A5.Thmlemma7.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A5.Thmlemma7.p1" class="ltx_para">
<p id="A5.Thmlemma7.p1.1" class="ltx_p"><span id="A5.Thmlemma7.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A5.Thmlemma7.p1.m1" class="ltx_Math" alttext="(X_{t})_{t\in T}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mi>T</mi></mrow></msub><annotation encoding="application/x-tex">(X_{t})_{t\in T}</annotation></semantics></math> be a real-valued process indexed by a pseudometric space <math id="A5.Thmlemma7.p1.m2" class="ltx_Math" alttext="(T,d)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(T,d)</annotation></semantics></math>.
Assume <math id="A5.Thmlemma7.p1.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> is totally bounded with diameter <math id="A5.Thmlemma7.p1.m4" class="ltx_Math" alttext="\Delta:=\mathrm{diam}_{d}(T)\in(0,\infty)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>:=</mo><mrow><msub><mi>diam</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta:=\mathrm{diam}_{d}(T)\in(0,\infty)</annotation></semantics></math> and that for some <math id="A5.Thmlemma7.p1.m5" class="ltx_Math" alttext="p&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p&gt;1</annotation></semantics></math> and <math id="A5.Thmlemma7.p1.m6" class="ltx_Math" alttext="L&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">L&gt;0</annotation></semantics></math>,</span></p>
<table id="A5.E83" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E83.m1" class="ltx_Math" alttext="\|X_{t}-X_{s}\|_{p}\;\leq\;L\,d(t,s)\qquad\forall\,s,t\in T." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>X</mi><mi>t</mi></msub><mo>−</mo><msub><mi>X</mi><mi>s</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>p</mi></msub><mo lspace="0.558em" rspace="0.558em">≤</mo><mrow><mi>L</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mspace style="width:2.167em;" width="2.167em"></mspace><mrow><mo rspace="0.337em">∀</mo><mi>s</mi></mrow><mo>,</mo><mrow><mi>t</mi><mo>∈</mo><mi>T</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|X_{t}-X_{s}\|_{p}\;\leq\;L\,d(t,s)\qquad\forall\,s,t\in T.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.83)</span></td></tr></tbody>
</table>
<p id="A5.Thmlemma7.p1.2" class="ltx_p"><span id="A5.Thmlemma7.p1.2.1" class="ltx_text ltx_font_italic">Then</span></p>
<table id="A5.E84" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E84.m1" class="ltx_Math" alttext="\mathbb{E}\!\left[\sup_{s,t\in T}\bigl(X_{t}-X_{s}\bigr)\right]\;\leq\;C\,L\int_{0}^{\Delta}\bigl({\color[rgb]{0,0,0}\mathcal{N}}(T,d,\varepsilon)\bigr)^{1/p}\,d\varepsilon," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow><mo>∈</mo><mi>T</mi></mrow></munder><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>X</mi><mi>t</mi></msub><mo>−</mo><msub><mi>X</mi><mi>s</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo rspace="0.280em">]</mo></mrow></mrow><mo rspace="0.558em">≤</mo><mrow><mi>C</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0em">∫</mo><mn>0</mn><mi mathvariant="normal">Δ</mi></msubsup><mrow><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>,</mo><mi>d</mi><mo>,</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mi>p</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>ε</mi></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\!\left[\sup_{s,t\in T}\bigl(X_{t}-X_{s}\bigr)\right]\;\leq\;C\,L\int_{0}^{\Delta}\bigl({\color[rgb]{0,0,0}\mathcal{N}}(T,d,\varepsilon)\bigr)^{1/p}\,d\varepsilon,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.84)</span></td></tr></tbody>
</table>
<p id="A5.Thmlemma7.p1.3" class="ltx_p"><span id="A5.Thmlemma7.p1.3.1" class="ltx_text ltx_font_italic">where <math id="A5.Thmlemma7.p1.m7" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\mathcal{N}}(T,d,\varepsilon)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>,</mo><mi>d</mi><mo>,</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\mathcal{N}}(T,d,\varepsilon)</annotation></semantics></math> is the <math id="A5.Thmlemma7.p1.m8" class="ltx_Math" alttext="\varepsilon" display="inline" intent=":literal"><semantics><mi>ε</mi><annotation encoding="application/x-tex">\varepsilon</annotation></semantics></math>-covering number and <math id="A5.Thmlemma7.p1.m9" class="ltx_Math" alttext="C&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">C&lt;\infty</annotation></semantics></math> is an absolute constant.</span></p>
</div>
</div>
</section>
<section id="A5.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.3 </span>Concentration bounds for  <span title="" class="ltx_glossaryref ltx_missing">icl</span> (<abbr title="" class="ltx_glossaryref ltx_missing">icl</abbr>)</h3>

<div id="A5.SS3.p1" class="ltx_para">
<p id="A5.SS3.p1.1" class="ltx_p">We now apply the moment symmetrization results to derive concentration bounds for <abbr title="" class="ltx_glossaryref ltx_missing">icl</abbr> in the dependent data setting.
These concentration bounds will then be translated into generalization bounds in the next subsection.</p>
</div>
<div id="A5.SS3.p2" class="ltx_para">
<p id="A5.SS3.p2.1" class="ltx_p">Let us recall ICL notations.</p>
</div>
<div id="A5.SS3.p3" class="ltx_para">
<p id="A5.SS3.p3.1" class="ltx_p">We denote by <math id="A5.SS3.p3.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\Theta}\subset{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathbb{R}}}^{\color[rgb]{0,0,0}d}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo>⊂</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi></msup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\Theta}\subset{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathbb{R}}}^{\color[rgb]{0,0,0}d}</annotation></semantics></math> the space of tasks <math id="A5.SS3.p3.m2" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\theta}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\theta}</annotation></semantics></math> and by <math id="A5.SS3.p3.m3" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\pi}({\color[rgb]{0,0,0}\theta})" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\pi}({\color[rgb]{0,0,0}\theta})</annotation></semantics></math> the density of the pretraining task distribution.
Given a task <math id="A5.SS3.p3.m4" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\theta}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\theta}</annotation></semantics></math>, the data is generated according to a task-specific distribution with density <math id="A5.SS3.p3.m5" class="ltx_math_unparsed" alttext="\density(\cdot\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">⋅</mo><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\density(\cdot\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})</annotation></semantics></math>.
The training data is then generated by first sampling a task <math id="A5.SS3.p3.m6" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\theta}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\theta}</annotation></semantics></math> from the task distribution <math id="A5.SS3.p3.m7" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\pi}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\pi}</annotation></semantics></math>, and then sampling data points <math id="A5.SS3.p3.m8" class="ltx_Math" alttext="({\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}})_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\geq 1}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>≥</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">({\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}})_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\geq 1}</annotation></semantics></math> according to</p>
<table id="A5.E85" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E85.m1" class="ltx_math_unparsed" alttext="{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\sim\density_{#1}(\cdot\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}},{\color[rgb]{0,0,0}\theta})\,." display="block" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>∼</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em">⋅</mo><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></msub><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em">.</mo></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\sim\density_{#1}(\cdot\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}},{\color[rgb]{0,0,0}\theta})\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.85)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p3.2" class="ltx_p">where <math id="A5.SS3.p3.m9" class="ltx_math_unparsed" alttext="{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}=({\color[rgb]{0,0,0}x}_{1},\ldots,{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}})" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}=({\color[rgb]{0,0,0}x}_{1},\ldots,{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}})</annotation></semantics></math>.</p>
</div>
<div id="A5.SS3.p4" class="ltx_para">
<p id="A5.SS3.p4.1" class="ltx_p">Given a dataset of tasks <math id="A5.SS3.p4.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\theta}_{1},\dots,{\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}N}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></msub></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\theta}_{1},\dots,{\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}N}</annotation></semantics></math> and associated samples <math id="A5.SS3.p4.m2" class="ltx_math_unparsed" alttext="{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{(1)},\dots,{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{({\color[rgb]{0,0,0}N})}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{(1)},\dots,{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{({\color[rgb]{0,0,0}N})}</annotation></semantics></math>, a model <math id="A5.SS3.p4.m3" class="ltx_Math" alttext="{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}}</annotation></semantics></math> is trained by minimizing the next-sample prediction loss</p>
<table id="A5.E86" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E86.m1" class="ltx_math_unparsed" alttext="{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})=\frac{1}{{\color[rgb]{0,0,0}N}{\color[rgb]{0,0,0}T}}\sum_{{\color[rgb]{0,0,0}n}=1}^{{\color[rgb]{0,0,0}N}}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{{\color[rgb]{0,0,0}T}}{\color[rgb]{0,0,0}\ell}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}}({\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-1}^{\color[rgb]{0,0,0}n}),{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n})\,," display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mfrac><mn>1</mn><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></mfrac><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></munderover><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">ℓ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mrow><mo stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>−</mo><mn>1</mn></mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo rspace="0.170em" stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})=\frac{1}{{\color[rgb]{0,0,0}N}{\color[rgb]{0,0,0}T}}\sum_{{\color[rgb]{0,0,0}n}=1}^{{\color[rgb]{0,0,0}N}}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{{\color[rgb]{0,0,0}T}}{\color[rgb]{0,0,0}\ell}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}}({\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-1}^{\color[rgb]{0,0,0}n}),{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\color[rgb]{0,0,0}n})\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.86)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p4.2" class="ltx_p">where <math id="A5.SS3.p4.m4" class="ltx_math_unparsed" alttext="{\color[rgb]{0,0,0}\ell}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\colon{\color[rgb]{0,0,0}\mathcal{X}}\times{\color[rgb]{0,0,0}\mathcal{X}}\to[0,+\infty)" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">ℓ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo rspace="0em">,</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\ell}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\colon{\color[rgb]{0,0,0}\mathcal{X}}\times{\color[rgb]{0,0,0}\mathcal{X}}\to[0,+\infty)</annotation></semantics></math> is a loss function at step <math id="A5.SS3.p4.m5" class="ltx_Math" alttext="{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}</annotation></semantics></math>.</p>
</div>
<div id="A5.SS3.p5" class="ltx_para">
<p id="A5.SS3.p5.1" class="ltx_p">We now provide a detailed version of <a href="#Thmassumption2" title="Assumption 2 (Generalization, informal). ‣ 3.3 Generalization error ‣ 3 Theoretical framework ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">2</span></a>.</p>
</div>
<div id="Thmassumption5" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmassumption5.2" class="ltx_text ltx_font_bold">Assumption 5</span></span><span id="Thmassumption5.3" class="ltx_text ltx_font_bold"> </span>(Weak dependence)<span id="Thmassumption5.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmassumption5.p1" class="ltx_para">
<p id="Thmassumption5.p1.1" class="ltx_p">We assume that there are deterministic coefficients <math id="Thmassumption5.p1.m1" class="ltx_Math" alttext="({\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}})_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\geq 1}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>≥</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">({\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}})_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\geq 1}</annotation></semantics></math> and <math id="Thmassumption5.p1.m2" class="ltx_Math" alttext="({\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}})_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\geq{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}\geq 1}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>≥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>≥</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">({\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}})_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\geq{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}\geq 1}</annotation></semantics></math> such that, for any <math id="Thmassumption5.p1.m3" class="ltx_Math" alttext="{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\geq{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}\geq 1" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>≥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\geq{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}\geq 1</annotation></semantics></math>, <math id="Thmassumption5.p1.m4" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\theta},{\color[rgb]{0,0,0}\theta}^{\prime}\in{\color[rgb]{0,0,0}\Theta}" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>,</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>′</mo></msup></mrow><mo>∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\theta},{\color[rgb]{0,0,0}\theta}^{\prime}\in{\color[rgb]{0,0,0}\Theta}</annotation></semantics></math>, any <math id="Thmassumption5.p1.m5" class="ltx_math_unparsed" alttext="{\color[rgb]{0,0,0}x}_{1:({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}-1)}\in{\color[rgb]{0,0,0}\mathcal{X}}^{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}-1}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo>∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><msup><mrow></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x}_{1:({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}-1)}\in{\color[rgb]{0,0,0}\mathcal{X}}^{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}-1}</annotation></semantics></math>, and any <math id="Thmassumption5.p1.m6" class="ltx_Math" alttext="{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\prime}\in{\color[rgb]{0,0,0}\mathcal{X}}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo>,</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>′</mo></msubsup><mo>∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}},{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\prime}\in{\color[rgb]{0,0,0}\mathcal{X}}</annotation></semantics></math>,</p>
<table id="A5.EGx55" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E87.m1" class="ltx_math_unparsed" alttext="\displaystyle W_{#1}(\density_{#1}(d{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta}),\density_{#1}(d{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\prime}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta}^{\prime}))" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">dx</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">dx</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>′</mo></msubsup><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle W_{#1}(\density_{#1}(d{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta}),\density_{#1}(d{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\prime}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta}^{\prime}))</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E87.m2" class="ltx_Math" alttext="\displaystyle\leq{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\lVert{\color[rgb]{0,0,0}\theta}-{\color[rgb]{0,0,0}\theta}^{\prime}\rVert" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo fence="true" rspace="0em">∥</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>−</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>′</mo></msup></mrow><mo fence="true" lspace="0em">∥</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\lVert{\color[rgb]{0,0,0}\theta}-{\color[rgb]{0,0,0}\theta}^{\prime}\rVert</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.87)</span></td></tr></tbody>
<tbody id="A5.E88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E88.m1" class="ltx_math_unparsed" alttext="\displaystyle W_{#1}(\density_{#1}(d{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}},{\color[rgb]{0,0,0}\theta}),\density_{#1}(d{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\prime}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}x}_{1:({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}-1)},{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}^{\prime},{\color[rgb]{0,0,0}\theta}))" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">dx</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></mrow></msub><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">dx</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>′</mo></msubsup><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>′</mo></msubsup><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle W_{#1}(\density_{#1}(d{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}},{\color[rgb]{0,0,0}\theta}),\density_{#1}(d{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}^{\prime}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}x}_{1:({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}-1)},{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}^{\prime},{\color[rgb]{0,0,0}\theta}))</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E88.m2" class="ltx_Math" alttext="\displaystyle\leq{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}\lVert{\color[rgb]{0,0,0}\theta}\rVert\,." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo fence="true" rspace="0em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo fence="true" lspace="0em" rspace="0.085em">∥</mo></mrow></mrow></mrow><mo lspace="0.085em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq{\color[rgb]{0,0,0}B}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}\lVert{\color[rgb]{0,0,0}\theta}\rVert\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.88)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS3.p6" class="ltx_para">
<p id="A5.SS3.p6.1" class="ltx_p">In the second assumption, the Wasserstein distance between the conditional distributions of <math id="A5.SS3.p6.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}</annotation></semantics></math> given <math id="A5.SS3.p6.m2" class="ltx_Math" alttext="{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></msub><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}</annotation></semantics></math> and <math id="A5.SS3.p6.m3" class="ltx_Math" alttext="{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}^{\prime}</annotation></semantics></math> is assumed to be controlled by the norm of the task <math id="A5.SS3.p6.m4" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\theta}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\theta}</annotation></semantics></math>.
This is a slight difference with <a href="#Thmassumption2" title="Assumption 2 (Generalization, informal). ‣ 3.3 Generalization error ‣ 3 Theoretical framework ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">2</span></a> where we assumed a dependence on <math id="A5.SS3.p6.m5" class="ltx_Math" alttext="1+\lVert{\color[rgb]{0,0,0}\theta}\rVert" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>+</mo><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo fence="true" lspace="0em">∥</mo></mrow></mrow><annotation encoding="application/x-tex">1+\lVert{\color[rgb]{0,0,0}\theta}\rVert</annotation></semantics></math>. This is however without loss of generality as we can always consider <math id="A5.SS3.p6.m6" class="ltx_Math" alttext="\widetilde{{\color[rgb]{0,0,0}\theta}}=(1,{\color[rgb]{0,0,0}\theta})\in{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathbb{R}}}^{{\color[rgb]{0,0,0}d}+1}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>~</mo></mover><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\widetilde{{\color[rgb]{0,0,0}\theta}}=(1,{\color[rgb]{0,0,0}\theta})\in{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathbb{R}}}^{{\color[rgb]{0,0,0}d}+1}</annotation></semantics></math> and redefine the task distribution accordingly and this cosmetic change simplifies the presentation.
We could also consider a dependence on <math id="A5.SS3.p6.m7" class="ltx_Math" alttext="\lVert{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}-{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}^{\prime}\rVert" display="inline" intent=":literal"><semantics><mrow><mo fence="true" rspace="0em">∥</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></msub><mo>−</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>′</mo></msubsup></mrow><mo fence="true" lspace="0em">∥</mo></mrow><annotation encoding="application/x-tex">\lVert{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}-{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}}^{\prime}\rVert</annotation></semantics></math>, see <a href="#A5.Thmtheorem1" title="Theorem E.1 (Causal symmetrization). ‣ E.1 Moment bounds for general functions ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">E.1</span></a>, but we omit this for simplicity.</p>
</div>
<div id="Thmassumption6" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmassumption6.2" class="ltx_text ltx_font_bold">Assumption 6</span></span><span id="Thmassumption6.3" class="ltx_text ltx_font_bold"> </span>(Finite moments of the task distribution)<span id="Thmassumption6.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmassumption6.p1" class="ltx_para">
<p id="Thmassumption6.p1.1" class="ltx_p">There exists <math id="Thmassumption6.p1.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}q}\geq 2" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}q}\geq 2</annotation></semantics></math> integer such that <math id="Thmassumption6.p1.m2" class="ltx_Math" alttext="\ex[\lVert{\color[rgb]{0,0,0}\theta}\rVert^{{\color[rgb]{0,0,0}q}}]&lt;+\infty" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></msup><mo stretchy="false">]</mo></mrow></mrow><mo>&lt;</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">\ex[\lVert{\color[rgb]{0,0,0}\theta}\rVert^{{\color[rgb]{0,0,0}q}}]&lt;+\infty</annotation></semantics></math>.</p>
</div>
</div>
<div id="A5.SS3.p7" class="ltx_para">
<p id="A5.SS3.p7.1" class="ltx_p">Our theory could be extended to more general assumptions on the distributions of sample, but, for simplicity, we will make the following sub-Gaussian assumption on the data, conditionally on the past data and the task. Hence, this assumption does not restrict the task distribution in any way.</p>
</div>
<div id="Thmassumption7" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmassumption7.2" class="ltx_text ltx_font_bold">Assumption 7</span></span><span id="Thmassumption7.3" class="ltx_text ltx_font_bold"> </span>(Sub-Gaussian data)<span id="Thmassumption7.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmassumption7.p1" class="ltx_para">
<p id="Thmassumption7.p1.1" class="ltx_p">There exists <math id="Thmassumption7.p1.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\sigma}&gt;0" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\sigma}&gt;0</annotation></semantics></math> such that, for any <math id="Thmassumption7.p1.m2" class="ltx_Math" alttext="{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\geq 1" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\geq 1</annotation></semantics></math>, <math id="Thmassumption7.p1.m3" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\theta}\in{\color[rgb]{0,0,0}\Theta}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\theta}\in{\color[rgb]{0,0,0}\Theta}</annotation></semantics></math>, and any <math id="Thmassumption7.p1.m4" class="ltx_math_unparsed" alttext="{\color[rgb]{0,0,0}x}_{1:({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-1)}\in{\color[rgb]{0,0,0}\mathcal{X}}^{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-1}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo>∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><msup><mrow></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x}_{1:({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-1)}\in{\color[rgb]{0,0,0}\mathcal{X}}^{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-1}</annotation></semantics></math>, <math id="Thmassumption7.p1.m5" class="ltx_math_unparsed" alttext="{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\sim\density_{#1}(\cdot\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}x}_{1:({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-1)},{\color[rgb]{0,0,0}\theta})" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo>∼</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em">⋅</mo><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\sim\density_{#1}(\cdot\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}x}_{1:({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-1)},{\color[rgb]{0,0,0}\theta})</annotation></semantics></math> is <math id="Thmassumption7.p1.m6" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\sigma}^{2}" display="inline" intent=":literal"><semantics><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\sigma}^{2}</annotation></semantics></math>-sub-Gaussian, i.e.,, for any <math id="Thmassumption7.p1.m7" class="ltx_Math" alttext="\lambda&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda&gt;0</annotation></semantics></math>,</p>
<table id="A5.E89" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E89.m1" class="ltx_Math" alttext="\log\ex_{#1}\left[e^{\lambda\lVert{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-\ex[{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}]\rVert^{2}}\right]\leq\frac{{\color[rgb]{0,0,0}\sigma}^{2}\lambda^{2}}{2}\,." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo>[</mo><msup><mi>e</mi><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo fence="true" rspace="0em">∥</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo>−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msup></mrow></msup><mo>]</mo></mrow></mrow></mrow><mo>≤</mo><mfrac><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup></mrow><mn>2</mn></mfrac></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">\log\ex_{#1}\left[e^{\lambda\lVert{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-\ex[{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}]\rVert^{2}}\right]\leq\frac{{\color[rgb]{0,0,0}\sigma}^{2}\lambda^{2}}{2}\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.89)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="Thmassumption8" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmassumption8.2" class="ltx_text ltx_font_bold">Assumption 8</span></span><span id="Thmassumption8.3" class="ltx_text ltx_font_bold"> </span>(Lipschitz model and loss)<span id="Thmassumption8.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmassumption8.p1" class="ltx_para">
<p id="Thmassumption8.p1.1" class="ltx_p">The models <math id="Thmassumption8.p1.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}}\in{\color[rgb]{0,0,0}\mathcal{F}}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}}\in{\color[rgb]{0,0,0}\mathcal{F}}</annotation></semantics></math> are uniformly Lipschitz in the following sense: there exists <math id="Thmassumption8.p1.m2" class="ltx_Math" alttext="{\color[rgb]{0,0,0}L}_{\color[rgb]{0,0,0}T}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}L}_{\color[rgb]{0,0,0}T}&gt;0</annotation></semantics></math> such that,
for any <math id="Thmassumption8.p1.m3" class="ltx_Math" alttext="{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}}\in{\color[rgb]{0,0,0}\mathcal{F}}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}}\in{\color[rgb]{0,0,0}\mathcal{F}}</annotation></semantics></math>, any <math id="Thmassumption8.p1.m4" class="ltx_math_unparsed" alttext="{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}</annotation></semantics></math>, <math id="Thmassumption8.p1.m5" class="ltx_Math" alttext="{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}^{\prime}</annotation></semantics></math>,</p>
<table id="A5.E90" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E90.m1" class="ltx_math_unparsed" alttext="\tfrac{1}{{\color[rgb]{0,0,0}T}}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}=1}^{\color[rgb]{0,0,0}T}\lVert{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}}({\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}-1})-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}}({\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-1},{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}^{\prime},{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}-1})\rVert\leq{\color[rgb]{0,0,0}L}_{\color[rgb]{0,0,0}T}\lVert{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}^{\prime}\rVert\,," display="block" intent=":literal"><semantics><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mfrac></mstyle><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>′</mo></msubsup><mo>,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo fence="true" lspace="0em" rspace="0.1389em">∥</mo></mrow><mo lspace="0.1389em">≤</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo>−</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>′</mo></msubsup><mo fence="true" lspace="0em" rspace="0.170em">∥</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\tfrac{1}{{\color[rgb]{0,0,0}T}}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}=1}^{\color[rgb]{0,0,0}T}\lVert{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}}({\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}-1})-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}}({\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-1},{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}^{\prime},{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}-1})\rVert\leq{\color[rgb]{0,0,0}L}_{\color[rgb]{0,0,0}T}\lVert{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}^{\prime}\rVert\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.90)</span></td></tr></tbody>
</table>
<p id="Thmassumption8.p1.2" class="ltx_p">The losses <math id="Thmassumption8.p1.m6" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\ell}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">ℓ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\ell}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}</annotation></semantics></math> are uniformly 1-Lipschitz: for any <math id="Thmassumption8.p1.m7" class="ltx_Math" alttext="{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\geq 1" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\geq 1</annotation></semantics></math>, any <math id="Thmassumption8.p1.m8" class="ltx_Math" alttext="{\color[rgb]{0,0,0}x},{\color[rgb]{0,0,0}x}^{\prime}\in{\color[rgb]{0,0,0}\mathcal{X}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo>,</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo>′</mo></msup></mrow><mo>∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x},{\color[rgb]{0,0,0}x}^{\prime}\in{\color[rgb]{0,0,0}\mathcal{X}}</annotation></semantics></math>,</p>
<table id="A5.E91" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E91.m1" class="ltx_Math" alttext="|{\color[rgb]{0,0,0}\ell}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}({\color[rgb]{0,0,0}x},{\color[rgb]{0,0,0}x}^{\prime})-{\color[rgb]{0,0,0}\ell}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}({\color[rgb]{0,0,0}x},{\color[rgb]{0,0,0}x}^{\prime})|\leq\lVert{\color[rgb]{0,0,0}x}-{\color[rgb]{0,0,0}x}^{\prime}\rVert\,." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">ℓ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo>,</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">ℓ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo>,</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo rspace="0.1389em">≤</mo><mrow><mo fence="true" lspace="0.1389em" rspace="0em">∥</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo>−</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo>′</mo></msup></mrow><mo fence="true" lspace="0em" rspace="0.085em">∥</mo></mrow></mrow><mo lspace="0.085em">.</mo></mrow><annotation encoding="application/x-tex">|{\color[rgb]{0,0,0}\ell}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}({\color[rgb]{0,0,0}x},{\color[rgb]{0,0,0}x}^{\prime})-{\color[rgb]{0,0,0}\ell}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}({\color[rgb]{0,0,0}x},{\color[rgb]{0,0,0}x}^{\prime})|\leq\lVert{\color[rgb]{0,0,0}x}-{\color[rgb]{0,0,0}x}^{\prime}\rVert\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.91)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS3.p8" class="ltx_para">
<p id="A5.SS3.p8.1" class="ltx_p">We will consider the following assumption on the function class <math id="A5.SS3.p8.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\mathcal{F}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\mathcal{F}}</annotation></semantics></math>.</p>
</div>
<div id="Thmassumption9" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmassumption9.2" class="ltx_text ltx_font_bold">Assumption 9</span></span><span id="Thmassumption9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmassumption9.p1" class="ltx_para">
<p id="Thmassumption9.p1.1" class="ltx_p">Assume that the hypothesis class <math id="Thmassumption9.p1.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\mathcal{F}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\mathcal{F}}</annotation></semantics></math> is bounded for w.r.t. some distance <math id="Thmassumption9.p1.m2" class="ltx_Math" alttext="\dist" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">dist</mi><annotation encoding="application/x-tex">\dist</annotation></semantics></math> on <math id="Thmassumption9.p1.m3" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\mathcal{F}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\mathcal{F}}</annotation></semantics></math> and that, the following extended Lipschitz condition holds: for any <math id="Thmassumption9.p1.m4" class="ltx_Math" alttext="{\color[rgb]{0,0,0}f},{\color[rgb]{0,0,0}f}^{\prime}\in{\color[rgb]{0,0,0}\mathcal{F}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>′</mo></msup></mrow><mo>∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}f},{\color[rgb]{0,0,0}f}^{\prime}\in{\color[rgb]{0,0,0}\mathcal{F}}</annotation></semantics></math>, any <math id="Thmassumption9.p1.m5" class="ltx_math_unparsed" alttext="{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}</annotation></semantics></math>, any <math id="Thmassumption9.p1.m6" class="ltx_Math" alttext="{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\geq 1" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\geq 1</annotation></semantics></math>, any <math id="Thmassumption9.p1.m7" class="ltx_Math" alttext="{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}^{\prime}</annotation></semantics></math>,
for any <math id="Thmassumption9.p1.m8" class="ltx_Math" alttext="{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}}\in{\color[rgb]{0,0,0}\mathcal{F}}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}}\in{\color[rgb]{0,0,0}\mathcal{F}}</annotation></semantics></math>, any <math id="Thmassumption9.p1.m9" class="ltx_math_unparsed" alttext="{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}</annotation></semantics></math>, <math id="Thmassumption9.p1.m10" class="ltx_Math" alttext="{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}^{\prime}</annotation></semantics></math>,</p>
<table id="A5.EGx56" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E92"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E92.m1" class="ltx_math_unparsed" alttext="\displaystyle\frac{1}{{\color[rgb]{0,0,0}T}}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}=1}^{\color[rgb]{0,0,0}T}\lVert{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}}({\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}-1})-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}}({\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-1},{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}^{\prime},{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}-1})-\left({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}}^{\prime}({\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}-1})-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}}^{\prime}({\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-1},{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}^{\prime},{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}-1})\right)\rVert" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>′</mo></msubsup><mo>,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo>(</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>′</mo></msubsup><mo>,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo fence="true" lspace="0em">∥</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{{\color[rgb]{0,0,0}T}}\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}=1}^{\color[rgb]{0,0,0}T}\lVert{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}}({\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}-1})-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}}({\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-1},{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}^{\prime},{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}-1})-\left({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}}^{\prime}({\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}-1})-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}}^{\prime}({\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-1},{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}^{\prime},{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}-1})\right)\rVert</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.92)</span></td></tr></tbody>
<tbody id="A5.E93"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E93.m1" class="ltx_Math" alttext="\displaystyle\leq{\color[rgb]{0,0,0}M}_{\color[rgb]{0,0,0}T}\lVert{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}^{\prime}\rVert\dist({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}}^{\prime})\,." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">M</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo fence="true" rspace="0em">∥</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo>−</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>′</mo></msubsup></mrow><mo fence="true" lspace="0em">∥</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">dist</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq{\color[rgb]{0,0,0}M}_{\color[rgb]{0,0,0}T}\lVert{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}^{\prime}\rVert\dist({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}}^{\prime})\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.93)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS3.p9" class="ltx_para">
<p id="A5.SS3.p9.1" class="ltx_p">Note that <a href="#Thmassumption8" title="Assumption 8 (Lipschitz model and loss). ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">8</span></a> is implied of <a href="#Thmassumption9" title="Assumption 9. ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">9</span></a> when the constant function equal to zero is in <math id="A5.SS3.p9.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\mathcal{F}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\mathcal{F}}</annotation></semantics></math> with <math id="A5.SS3.p9.m2" class="ltx_Math" alttext="{\color[rgb]{0,0,0}L}_{\color[rgb]{0,0,0}T}={\color[rgb]{0,0,0}M}_{\color[rgb]{0,0,0}T}\sup_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}}\in{\color[rgb]{0,0,0}\mathcal{F}}}\dist({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}},0)" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo>=</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">M</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi></mrow></msub><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">dist</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}L}_{\color[rgb]{0,0,0}T}={\color[rgb]{0,0,0}M}_{\color[rgb]{0,0,0}T}\sup_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}}\in{\color[rgb]{0,0,0}\mathcal{F}}}\dist({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}f}},0)</annotation></semantics></math>.</p>
</div>
<div id="A5.SS3.p10" class="ltx_para">
<p id="A5.SS3.p10.1" class="ltx_p">We denote by <math id="A5.SS3.p10.m1" class="ltx_Math" alttext="\lVert X\rVert_{\color[rgb]{0,0,0}h}" display="inline" intent=":literal"><semantics><msub><mrow><mo fence="true" rspace="0em">∥</mo><mi>X</mi><mo fence="true" lspace="0em">∥</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi></msub><annotation encoding="application/x-tex">\lVert X\rVert_{\color[rgb]{0,0,0}h}</annotation></semantics></math> the <math id="A5.SS3.p10.m2" class="ltx_Math" alttext="L^{\color[rgb]{0,0,0}h}" display="inline" intent=":literal"><semantics><msup><mi>L</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi></msup><annotation encoding="application/x-tex">L^{\color[rgb]{0,0,0}h}</annotation></semantics></math> norm of a random variable <math id="A5.SS3.p10.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>, i.e., <math id="A5.SS3.p10.m4" class="ltx_Math" alttext="\lVert X\rVert_{\color[rgb]{0,0,0}h}=(\ex[\lVert X\rVert^{\color[rgb]{0,0,0}h}])^{1/{\color[rgb]{0,0,0}h}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo fence="true" rspace="0em">∥</mo><mi>X</mi><mo fence="true" lspace="0em">∥</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi></msub><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi>X</mi><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi></msup><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\lVert X\rVert_{\color[rgb]{0,0,0}h}=(\ex[\lVert X\rVert^{\color[rgb]{0,0,0}h}])^{1/{\color[rgb]{0,0,0}h}}</annotation></semantics></math>.</p>
</div>
<div id="A5.Thmlemma8" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A5.Thmlemma8.2" class="ltx_text ltx_font_bold">Lemma E.8</span></span><span id="A5.Thmlemma8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A5.Thmlemma8.p1" class="ltx_para">
<p id="A5.Thmlemma8.p1.1" class="ltx_p"><span id="A5.Thmlemma8.p1.1.1" class="ltx_text ltx_font_italic">For any <math id="A5.Thmlemma8.p1.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}r}\in[2,{\color[rgb]{0,0,0}q}]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>2</mn><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}r}\in[2,{\color[rgb]{0,0,0}q}]</annotation></semantics></math> integer, under <a href="#Thmassumption5" title="Assumption 5 (Weak dependence). ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumptions</span> <span class="ltx_text ltx_ref_tag">5</span></a>, <a href="#Thmassumption6" title="Assumption 6 (Finite moments of the task distribution). ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>, <a href="#Thmassumption7" title="Assumption 7 (Sub-Gaussian data). ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a> and <a href="#Thmassumption8" title="Assumption 8 (Lipschitz model and loss). ‣ E.3 Concentration bounds for () ‣ Appendix E Generalization bounds ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>, we have</span></p>
<table id="A5.EGx57" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E94"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E94.m1" class="ltx_math_unparsed" alttext="\displaystyle\Bigg\|\sup_{{\color[rgb]{0,0,0}f}\in{\color[rgb]{0,0,0}\mathcal{F}}}\left\{\ex\left[{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right]-{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right\}" display="inline" intent=":literal"><semantics><mrow><mo mathsize="2.600em" rspace="0.0835em">∥</mo><munder><mo lspace="0.0835em" movablelimits="false" rspace="0em">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi></mrow></munder><mrow><mo>{</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>−</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Bigg\|\sup_{{\color[rgb]{0,0,0}f}\in{\color[rgb]{0,0,0}\mathcal{F}}}\left\{\ex\left[{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right]-{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.94)</span></td></tr></tbody>
<tbody id="A5.E95"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E95.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad-\ex\left[\sup_{{\color[rgb]{0,0,0}f}\in{\color[rgb]{0,0,0}\mathcal{F}}}\left\{\ex\left[{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right]-{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right\}\right]\Bigg\|_{\color[rgb]{0,0,0}r}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi></mrow></munder><mrow><mo>{</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>−</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>}</mo></mrow><mo>]</mo></mrow><msub><mo lspace="0em" mathsize="2.600em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad-\ex\left[\sup_{{\color[rgb]{0,0,0}f}\in{\color[rgb]{0,0,0}\mathcal{F}}}\left\{\ex\left[{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right]-{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right\}\right]\Bigg\|_{\color[rgb]{0,0,0}r}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.95)</span></td></tr></tbody>
<tbody id="A5.E96"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
