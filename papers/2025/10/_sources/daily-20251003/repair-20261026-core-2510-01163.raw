<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E37.m1" class="ltx_math_unparsed" alttext="\displaystyle+\ex_{#1}\left[\one\left\{{\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\notin{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}^{\color[rgb]{0,0,0}T}\right\}\cdot\log\left({\sup_{{\color[rgb]{0,0,0}\theta}\in{\color[rgb]{0,0,0}\Theta}}\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}}\right)\right]\,." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo>{</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo>∉</mo><mmultiscripts><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mmultiscripts><mo rspace="0.055em">}</mo></mrow><mo rspace="0.222em">⋅</mo><mi>log</mi><mrow><mo>(</mo><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi></mrow></munder><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>)</mo></mrow><mo>]</mo></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\ex_{#1}\left[\one\left\{{\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\notin{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}^{\color[rgb]{0,0,0}T}\right\}\cdot\log\left({\sup_{{\color[rgb]{0,0,0}\theta}\in{\color[rgb]{0,0,0}\Theta}}\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}}\right)\right]\,.</annotation></semantics></math></td>
