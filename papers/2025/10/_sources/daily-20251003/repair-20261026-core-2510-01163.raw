<li id="A4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i2.p1" class="ltx_para">
<p id="A4.I1.i2.p1.1" class="ltx_p">Moment bound on <math id="A4.I1.i2.p1.m1" class="ltx_Math" alttext="({\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}})_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\geq 1}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>≥</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">({\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}})_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\geq 1}</annotation></semantics></math>: for any <math id="A4.I1.i2.p1.m2" class="ltx_Math" alttext="{\color[rgb]{0,0,0}T}\geq 1" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}T}\geq 1</annotation></semantics></math></p>
<table id="A4.E31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E31.m1" class="ltx_Math" alttext="\ex_{#1}\left[\log^{2}\left({\sup_{{\color[rgb]{0,0,0}\theta}\in{\color[rgb]{0,0,0}\Theta}}\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}}\right)\right]\leq\poly({\color[rgb]{0,0,0}T})\,." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi></mrow></munder><mfrac><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">\ex_{#1}\left[\log^{2}\left({\sup_{{\color[rgb]{0,0,0}\theta}\in{\color[rgb]{0,0,0}\Theta}}\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}}\right)\right]\leq\poly({\color[rgb]{0,0,0}T})\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.31)</span></td></tr></tbody>
</table>
</div></li>
<li id="A4.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i3.p1" class="ltx_para">
<p id="A4.I1.i3.p1.1" class="ltx_p">Regularity of the likelihood:
for any <math id="A4.I1.i3.p1.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\geq 1" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\geq 1</annotation></semantics></math>, <math id="A4.I1.i3.p1.m2" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\theta},{\color[rgb]{0,0,0}\theta}^{\prime}\in{\color[rgb]{0,0,0}\Theta}\cap{\color[rgb]{0,0,0}\overline{\mathbb{B}}}(0,{\color[rgb]{0,0,0}R})" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>,</mo><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>′</mo></msup><mo>∈</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo>∩</mo><mrow><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔹</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\theta},{\color[rgb]{0,0,0}\theta}^{\prime}\in{\color[rgb]{0,0,0}\Theta}\cap{\color[rgb]{0,0,0}\overline{\mathbb{B}}}(0,{\color[rgb]{0,0,0}R})</annotation></semantics></math>,</p>
<table id="A4.E32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E32.m1" class="ltx_math_unparsed" alttext="\sup_{{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}\in{\color[rgb]{0,0,0}\overline{\mathbb{B}}}(0,{\color[rgb]{0,0,0}R})^{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}\log\frac{\density_{#1}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-1},{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-1},{\color[rgb]{0,0,0}\theta}^{\prime})}\leq\poly({\color[rgb]{0,0,0}R})\lVert{\color[rgb]{0,0,0}\theta}-{\color[rgb]{0,0,0}\theta}^{\prime}\rVert\,." display="block" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></msub><mo>∈</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔹</mi><mo stretchy="true">¯</mo></mover><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mo stretchy="false">)</mo><msup><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msup></mrow></munder><mi>log</mi><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mfrac><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mo stretchy="false">)</mo></mrow><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>−</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>′</mo></msup><mo fence="true" lspace="0em" rspace="0.085em">∥</mo></mrow><mo lspace="0.085em">.</mo></mrow><annotation encoding="application/x-tex">\sup_{{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}\in{\color[rgb]{0,0,0}\overline{\mathbb{B}}}(0,{\color[rgb]{0,0,0}R})^{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}\log\frac{\density_{#1}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-1},{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-1},{\color[rgb]{0,0,0}\theta}^{\prime})}\leq\poly({\color[rgb]{0,0,0}R})\lVert{\color[rgb]{0,0,0}\theta}-{\color[rgb]{0,0,0}\theta}^{\prime}\rVert\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.32)</span></td></tr></tbody>
</table>
</div></li>
</ul>
</div>
</div>
<div id="A4.SS3.p5" class="ltx_para">
<p id="A4.SS3.p5.1" class="ltx_p">For a sequence <math id="A4.SS3.p5.m1" class="ltx_Math" alttext="({\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}})_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\geq 1}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>≥</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">({\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}})_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\geq 1}</annotation></semantics></math>, we denote by <math id="A4.SS3.p5.m2" class="ltx_math_unparsed" alttext="{\color[rgb]{0,0,0}x}_{a:b}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mi>a</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>b</mi></mrow></msub></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x}_{a:b}</annotation></semantics></math> the subsequence <math id="A4.SS3.p5.m3" class="ltx_Math" alttext="({\color[rgb]{0,0,0}x}_{a},{\color[rgb]{0,0,0}x}_{a+1},\dots,{\color[rgb]{0,0,0}x}_{b})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi>a</mi></msub><mo>,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi>a</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi>b</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\color[rgb]{0,0,0}x}_{a},{\color[rgb]{0,0,0}x}_{a+1},\dots,{\color[rgb]{0,0,0}x}_{b})</annotation></semantics></math> for <math id="A4.SS3.p5.m4" class="ltx_Math" alttext="1\leq a\leq b" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>a</mi><mo>≤</mo><mi>b</mi></mrow><annotation encoding="application/x-tex">1\leq a\leq b</annotation></semantics></math> with the convention that <math id="A4.SS3.p5.m5" class="ltx_math_unparsed" alttext="{\color[rgb]{0,0,0}x}_{a:b}={\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mi>a</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>b</mi></mrow></msub><mo>=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></msub></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x}_{a:b}={\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}}</annotation></semantics></math> if <math id="A4.SS3.p5.m6" class="ltx_Math" alttext="a&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">a&lt;1</annotation></semantics></math>.</p>
</div>
</section>
<section id="A4.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.4 </span>Task Selection Bound for ICL</h3>

<div id="A4.SS4.p1" class="ltx_para">
<p id="A4.SS4.p1.1" class="ltx_p">We begin with a discretization argument and first we generalize the bracketing numbers to the non-i.i.d. case.
This definition generalizes the bracketing numbers used in <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib10" title="" class="ltx_ref">Barron et al. (1999)</a>; <a href="#bib.bib73" title="" class="ltx_ref">Zhang (2003)</a>; <a href="#bib.bib74" title="" class="ltx_ref">Zhang (2006)</a></cite> to the non-i.i.d case and the following result generalises the results of <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib74" title="" class="ltx_ref">Zhang (2006)</a></cite> to the non-i.i.d. case.</p>
</div>
<div id="Thmdefinition2" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmdefinition2.2" class="ltx_text ltx_font_bold">Definition 2</span></span><span id="Thmdefinition2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmdefinition2.p1" class="ltx_para">
<p id="Thmdefinition2.p1.1" class="ltx_p">Given a sequence of random variables <math id="Thmdefinition2.p1.m1" class="ltx_Math" alttext="({\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}})_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\leq{\color[rgb]{0,0,0}T}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><annotation encoding="application/x-tex">({\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}})_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\leq{\color[rgb]{0,0,0}T}}</annotation></semantics></math> on a measurable space <math id="Thmdefinition2.p1.m2" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\mathcal{X}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\mathcal{X}}</annotation></semantics></math>,
with parametric densities <math id="Thmdefinition2.p1.m3" class="ltx_math_unparsed" alttext="\density_{#1}(\cdot|{\color[rgb]{0,0,0}\theta})" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\density_{#1}(\cdot|{\color[rgb]{0,0,0}\theta})</annotation></semantics></math> parameterized by <math id="Thmdefinition2.p1.m4" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\theta}\in{\color[rgb]{0,0,0}\Theta}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\theta}\in{\color[rgb]{0,0,0}\Theta}</annotation></semantics></math>, compact sets <math id="Thmdefinition2.p1.m5" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\Theta^{\prime}}\subset{\color[rgb]{0,0,0}\Theta}" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>⊂</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\Theta^{\prime}}\subset{\color[rgb]{0,0,0}\Theta}</annotation></semantics></math> and <math id="Thmdefinition2.p1.m6" class="ltx_Math" alttext="{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}\subset{\color[rgb]{0,0,0}\mathcal{X}}" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>⊂</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}\subset{\color[rgb]{0,0,0}\mathcal{X}}</annotation></semantics></math>, the <math id="Thmdefinition2.p1.m7" class="ltx_Math" alttext="\varepsilon" display="inline" intent=":literal"><semantics><mi>ε</mi><annotation encoding="application/x-tex">\varepsilon</annotation></semantics></math>-upper bracketing number of <math id="Thmdefinition2.p1.m8" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\Theta^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\Theta^{\prime}}</annotation></semantics></math>, denoted by <math id="Thmdefinition2.p1.m9" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\mathcal{B}}({\color[rgb]{0,0,0}\Theta^{\prime}},\varepsilon,{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}},{\color[rgb]{0,0,0}T})" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>,</mo><mi>ε</mi><mo>,</mo><msup><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\mathcal{B}}({\color[rgb]{0,0,0}\Theta^{\prime}},\varepsilon,{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}},{\color[rgb]{0,0,0}T})</annotation></semantics></math> is the minimum number of sets <math id="Thmdefinition2.p1.m10" class="ltx_Math" alttext="U_{j}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>j</mi></msub><annotation encoding="application/x-tex">U_{j}</annotation></semantics></math> that cover <math id="Thmdefinition2.p1.m11" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\Theta^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\Theta^{\prime}}</annotation></semantics></math> such that, for any <math id="Thmdefinition2.p1.m12" class="ltx_Math" alttext="{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\leq{\color[rgb]{0,0,0}T}-1" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>≤</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\leq{\color[rgb]{0,0,0}T}-1</annotation></semantics></math>, any <math id="Thmdefinition2.p1.m13" class="ltx_math_unparsed" alttext="{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\in{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}^{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo>∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><msup><mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><msup><mrow></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\in{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}^{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}</annotation></semantics></math>, any <math id="Thmdefinition2.p1.m14" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>,</p>
<table id="A4.E33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E33.m1" class="ltx_math_unparsed" alttext="\int_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}}\sup_{{\color[rgb]{0,0,0}\theta}\in U_{j}}\density_{#1}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}},{\color[rgb]{0,0,0}\theta})d{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\leq 1+\varepsilon\,." display="block" intent=":literal"><semantics><mrow><msub><mo>∫</mo><msup><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup></msub><munder><mo lspace="0.167em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∈</mo><msub><mi>U</mi><mi>j</mi></msub></mrow></munder><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></msub><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">dx</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>≤</mo><mn>1</mn><mo>+</mo><mi>ε</mi><mo lspace="0.170em">.</mo></mrow></mrow><annotation encoding="application/x-tex">\int_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}}\sup_{{\color[rgb]{0,0,0}\theta}\in U_{j}}\density_{#1}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}},{\color[rgb]{0,0,0}\theta})d{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\leq 1+\varepsilon\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.33)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A4.Thmlemma3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A4.Thmlemma3.2" class="ltx_text ltx_font_bold">Lemma D.3</span></span><span id="A4.Thmlemma3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A4.Thmlemma3.p1" class="ltx_para">
<p id="A4.Thmlemma3.p1.1" class="ltx_p"><span id="A4.Thmlemma3.p1.1.1" class="ltx_text ltx_font_italic">For <math id="A4.Thmlemma3.p1.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\mu}\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\mu}\in(0,1)</annotation></semantics></math>, for any <math id="A4.Thmlemma3.p1.m2" class="ltx_Math" alttext="\varepsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\varepsilon&gt;0</annotation></semantics></math> and any compact set <math id="A4.Thmlemma3.p1.m3" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\Theta^{\prime}}\subset{\color[rgb]{0,0,0}\Theta}" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>⊂</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\Theta^{\prime}}\subset{\color[rgb]{0,0,0}\Theta}</annotation></semantics></math>, any set <math id="A4.Thmlemma3.p1.m4" class="ltx_Math" alttext="{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}\subset{\color[rgb]{0,0,0}\mathcal{X}}" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>⊂</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}\subset{\color[rgb]{0,0,0}\mathcal{X}}</annotation></semantics></math>,
it holds</span></p>
<table id="A4.EGx13" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E34.m1" class="ltx_math_unparsed" alttext="\displaystyle{\color[rgb]{0,0,0}\mu}\ex_{#1}\left[\log\ex_{#1}\left[\exp\left(-\frac{1}{{\color[rgb]{0,0,0}\mu}}\log\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right)\right]\right]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi>log</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi></mfrac></mstyle><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>)</mo></mrow><mo>]</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\color[rgb]{0,0,0}\mu}\ex_{#1}\left[\log\ex_{#1}\left[\exp\left(-\frac{1}{{\color[rgb]{0,0,0}\mu}}\log\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right)\right]\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.34)</span></td></tr></tbody>
<tbody id="A4.E35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E35.m1" class="ltx_Math" alttext="\displaystyle\leq 2\log\left({\color[rgb]{0,0,0}\mathcal{B}}({\color[rgb]{0,0,0}\Theta^{\prime}},\varepsilon,{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}},{\color[rgb]{0,0,0}T})\right)+6{\color[rgb]{0,0,0}T}\varepsilon+{\color[rgb]{0,0,0}\pi}\left({\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}\right)^{{\color[rgb]{0,0,0}\mu}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>,</mo><mi>ε</mi><mo>,</mo><msup><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow><mo>+</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∉</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup></mrow><mo>)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\log\left({\color[rgb]{0,0,0}\mathcal{B}}({\color[rgb]{0,0,0}\Theta^{\prime}},\varepsilon,{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}},{\color[rgb]{0,0,0}T})\right)+6{\color[rgb]{0,0,0}T}\varepsilon+{\color[rgb]{0,0,0}\pi}\left({\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}\right)^{{\color[rgb]{0,0,0}\mu}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.35)</span></td></tr></tbody>
<tbody id="A4.E36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E36.m1" class="ltx_math_unparsed" alttext="\displaystyle+\ex_{#1}\left[\one\left\{\sup_{{\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}}\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}\geq 1\right\}\cdot\log\left(1+{\sup_{{\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}}\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}}\right)\right]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo>{</mo><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∉</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup></mrow></munder><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>≥</mo><mn>1</mn><mo rspace="0.055em">}</mo></mrow><mo rspace="0.222em">⋅</mo><mi>log</mi><mrow><mo>(</mo><mn>1</mn><mo>+</mo><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∉</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup></mrow></munder><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\ex_{#1}\left[\one\left\{\sup_{{\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}}\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}\geq 1\right\}\cdot\log\left(1+{\sup_{{\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}}\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}}\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.36)</span></td></tr></tbody>
<tbody id="A4.E37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
