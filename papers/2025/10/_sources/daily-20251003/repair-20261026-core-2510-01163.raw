<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E153.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\ex\left[\sup_{{\color[rgb]{0,0,0}f},{\color[rgb]{0,0,0}f}^{\prime}\in{\color[rgb]{0,0,0}\mathcal{F}}}\ex\left[{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right]-{{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})}-\left(\ex\left[{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f}^{\prime},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right]-{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f}^{\prime},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right)\right]\,," display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>′</mo></msup></mrow><mo>∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi></mrow></munder><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>−</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo>(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo>[</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>′</mo></msup><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>−</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>′</mo></msup><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo>,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo rspace="0.170em">]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\ex\left[\sup_{{\color[rgb]{0,0,0}f},{\color[rgb]{0,0,0}f}^{\prime}\in{\color[rgb]{0,0,0}\mathcal{F}}}\ex\left[{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right]-{{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})}-\left(\ex\left[{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f}^{\prime},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right]-{\color[rgb]{0,0,0}\widehat{{\color[rgb]{0,0,0}L}}}({\color[rgb]{0,0,0}f}^{\prime},({\color[rgb]{0,0,0}\theta}_{\color[rgb]{0,0,0}n},{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}T}}^{{\color[rgb]{0,0,0}n}})_{{\color[rgb]{0,0,0}n}\leq{\color[rgb]{0,0,0}N}})\right)\right]\,,</annotation></semantics></math></td>
