<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E12.m1" class="ltx_Math" alttext="\displaystyle\quad+({\color[rgb]{0,0,0}\alpha}-1)\ex_{#1}\left[\log\ex_{#1}\left[\exp\left(-\frac{{\color[rgb]{0,0,0}\alpha}-{\color[rgb]{0,0,0}\rho}}{{\color[rgb]{0,0,0}\alpha}-1}\log\frac{d\prob_{\!#1}(\cdot\nonscript\&gt;|\nonscript\&gt;\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{d\prob_{\!#1}(\cdot\nonscript\&gt;|\nonscript\&gt;\mathopen{}{\color[rgb]{0,0,0}\theta})}\right)\right]\right]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">α</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">α</mi><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">α</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℙ</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.220em">⋅</mo><mo fence="false" rspace="0.387em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mi>d</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℙ</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.220em">⋅</mo><mo fence="false" rspace="0.387em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mfrac></mstyle></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+({\color[rgb]{0,0,0}\alpha}-1)\ex_{#1}\left[\log\ex_{#1}\left[\exp\left(-\frac{{\color[rgb]{0,0,0}\alpha}-{\color[rgb]{0,0,0}\rho}}{{\color[rgb]{0,0,0}\alpha}-1}\log\frac{d\prob_{\!#1}(\cdot\nonscript\&gt;|\nonscript\&gt;\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{d\prob_{\!#1}(\cdot\nonscript\&gt;|\nonscript\&gt;\mathopen{}{\color[rgb]{0,0,0}\theta})}\right)\right]\right]</annotation></semantics></math></td>
