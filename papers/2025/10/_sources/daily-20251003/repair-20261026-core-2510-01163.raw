<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E149.m1" class="ltx_Math" alttext="\displaystyle\quad+{\color[rgb]{0,0,0}c}\sqrt{{\color[rgb]{0,0,0}q}}\frac{{\color[rgb]{0,0,0}M}_{{\color[rgb]{0,0,0}T}}}{\sqrt{{\color[rgb]{0,0,0}N}}}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\right)\left\lVert{{\color[rgb]{0,0,0}\theta}_{1}-\ex[{\color[rgb]{0,0,0}\theta}_{1}]}\right\rVert_{2}+{\color[rgb]{0,0,0}c}{\color[rgb]{0,0,0}q}\frac{{\color[rgb]{0,0,0}M}_{{\color[rgb]{0,0,0}T}}}{{\color[rgb]{0,0,0}N}^{1-1/{\color[rgb]{0,0,0}q}}}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\right)\left\lVert{{\color[rgb]{0,0,0}\theta}_{1}-\ex[{\color[rgb]{0,0,0}\theta}_{1}]}\right\rVert_{\color[rgb]{0,0,0}q}\Bigg)\,." display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mrow><mo>+</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">M</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><msqrt><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo>−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo>+</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">M</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></mrow></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo>−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></msub></mrow></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+{\color[rgb]{0,0,0}c}\sqrt{{\color[rgb]{0,0,0}q}}\frac{{\color[rgb]{0,0,0}M}_{{\color[rgb]{0,0,0}T}}}{\sqrt{{\color[rgb]{0,0,0}N}}}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\right)\left\lVert{{\color[rgb]{0,0,0}\theta}_{1}-\ex[{\color[rgb]{0,0,0}\theta}_{1}]}\right\rVert_{2}+{\color[rgb]{0,0,0}c}{\color[rgb]{0,0,0}q}\frac{{\color[rgb]{0,0,0}M}_{{\color[rgb]{0,0,0}T}}}{{\color[rgb]{0,0,0}N}^{1-1/{\color[rgb]{0,0,0}q}}}\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}{\color[rgb]{0,0,0}A}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\right)\left\lVert{{\color[rgb]{0,0,0}\theta}_{1}-\ex[{\color[rgb]{0,0,0}\theta}_{1}]}\right\rVert_{\color[rgb]{0,0,0}q}\Bigg)\,.</annotation></semantics></math></td>
