<p id="A5.Thmproposition1.p1.2" class="ltx_p"><span id="A5.Thmproposition1.p1.2.1" class="ltx_text ltx_font_italic">is bounded by</span></p>
<ol id="A5.I3" class="ltx_enumerate">
<li id="A5.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="A5.I3.i1.p1" class="ltx_para">
<p id="A5.I3.i1.p1.1" class="ltx_p"><span id="A5.I3.i1.p1.1.1" class="ltx_text ltx_font_italic">If </span><math id="A5.I3.i1.p1.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\delta}\geq{\color[rgb]{0,0,0}N}e^{-{\color[rgb]{0,0,0}q}}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">δ</mi><mo>≥</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\delta}\geq{\color[rgb]{0,0,0}N}e^{-{\color[rgb]{0,0,0}q}}</annotation></semantics></math><span id="A5.I3.i1.p1.1.2" class="ltx_text ltx_font_italic">,</span></p>
