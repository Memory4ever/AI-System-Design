<p id="A4.SS4.p5.3" class="ltx_p"><span id="A4.SS4.p5.3.1" class="ltx_text">Using Jensen’s inequality on the first term, we have</span></p>
<table id="A4.EGx20" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E53.m1" class="ltx_math_unparsed" alttext="\displaystyle{\color[rgb]{0,0,0}\mu}\ex_{#1}\left[\one\{{\color[rgb]{0,0,0}X}\in{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}^{\color[rgb]{0,0,0}T}\}\log\ex_{#1}\left[\exp\left(-\frac{1}{{\color[rgb]{0,0,0}\mu}}\log\frac{\density_{#1}({\color[rgb]{0,0,0}X}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}X}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right)\right]\right]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo stretchy="false">{</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo>∈</mo><mmultiscripts><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mmultiscripts><mo rspace="0.167em" stretchy="false">}</mo></mrow><mi>log</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi></mfrac></mstyle><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="false" lspace="0.170em" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="false" lspace="0.170em" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>)</mo></mrow><mo>]</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\color[rgb]{0,0,0}\mu}\ex_{#1}\left[\one\{{\color[rgb]{0,0,0}X}\in{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}^{\color[rgb]{0,0,0}T}\}\log\ex_{#1}\left[\exp\left(-\frac{1}{{\color[rgb]{0,0,0}\mu}}\log\frac{\density_{#1}({\color[rgb]{0,0,0}X}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}X}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right)\right]\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.53)</span></td></tr></tbody>
<tbody id="A4.E54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E54.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\log\left(1+\ex_{#1}\left[\sum_{{\color[rgb]{0,0,0}i}=1}^{{\color[rgb]{0,0,0}\mathcal{B}}({\color[rgb]{0,0,0}\Theta^{\prime}},\varepsilon,{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}},{\color[rgb]{0,0,0}T})}\exp\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=0}^{{\color[rgb]{0,0,0}T}-1}\log\frac{{\color[rgb]{0,0,0}g}_{\color[rgb]{0,0,0}i}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\mid{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}})}{\density_{#1}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}+{{\color[rgb]{0,0,0}T}}\log\frac{1+\varepsilon}{1-\varepsilon}\right)\right]\right)" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>log</mi><mrow><mo>(</mo><mn>1</mn><mo>+</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>,</mo><mi>ε</mi><mo>,</mo><msup><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow></mrow></munderover></mstyle><mi>exp</mi><mrow><mo>(</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">g</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></msub><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>+</mo><mi>ε</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mo>]</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\log\left(1+\ex_{#1}\left[\sum_{{\color[rgb]{0,0,0}i}=1}^{{\color[rgb]{0,0,0}\mathcal{B}}({\color[rgb]{0,0,0}\Theta^{\prime}},\varepsilon,{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}},{\color[rgb]{0,0,0}T})}\exp\left(\sum_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=0}^{{\color[rgb]{0,0,0}T}-1}\log\frac{{\color[rgb]{0,0,0}g}_{\color[rgb]{0,0,0}i}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\mid{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}})}{\density_{#1}({\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}+1}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}x}_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}s}}:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}},{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}+{{\color[rgb]{0,0,0}T}}\log\frac{1+\varepsilon}{1-\varepsilon}\right)\right]\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.54)</span></td></tr></tbody>
<tbody id="A4.E55"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E55.m1" class="ltx_Math" alttext="\displaystyle\quad+\ex_{#1}\left[\log\left(1+{\color[rgb]{0,0,0}\pi}\left({\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}\right)^{{{\color[rgb]{0,0,0}\mu}}}\cdot{\sup_{{\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}}\left(\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}\right)}\right)\right]" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">+</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∉</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup></mrow><mo rspace="0.055em">)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi></msup></mrow><mo>⋅</mo><mrow><munder><mo lspace="0.055em" movablelimits="false" rspace="0em">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∉</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup></mrow></munder><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\ex_{#1}\left[\log\left(1+{\color[rgb]{0,0,0}\pi}\left({\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}\right)^{{{\color[rgb]{0,0,0}\mu}}}\cdot{\sup_{{\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}}\left(\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}\right)}\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.55)</span></td></tr></tbody>
<tbody id="A4.E56"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E56.m1" class="ltx_Math" alttext="\displaystyle\leq\log\left(1+{\color[rgb]{0,0,0}\mathcal{B}}({\color[rgb]{0,0,0}\Theta^{\prime}},\varepsilon,{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}},{\color[rgb]{0,0,0}T})(1+\varepsilon)^{{\color[rgb]{0,0,0}T}}\left(\frac{1+\varepsilon}{1-\varepsilon}\right)^{{\color[rgb]{0,0,0}T}}\right)+\ex_{#1}\left[\log\left(1+{\color[rgb]{0,0,0}\pi}\left({\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}\right)^{{{\color[rgb]{0,0,0}\mu}}}\cdot\ex_{#1}\left[\sup_{{\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}}\left(\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}\right)\right]\right)\right]\,," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>,</mo><mi>ε</mi><mo>,</mo><msup><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>+</mo><mi>ε</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msup></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∉</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup></mrow><mo rspace="0.055em">)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi></msup></mrow><mo rspace="0.222em">⋅</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo>[</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∉</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup></mrow></munder><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo rspace="0.170em">]</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\log\left(1+{\color[rgb]{0,0,0}\mathcal{B}}({\color[rgb]{0,0,0}\Theta^{\prime}},\varepsilon,{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}},{\color[rgb]{0,0,0}T})(1+\varepsilon)^{{\color[rgb]{0,0,0}T}}\left(\frac{1+\varepsilon}{1-\varepsilon}\right)^{{\color[rgb]{0,0,0}T}}\right)+\ex_{#1}\left[\log\left(1+{\color[rgb]{0,0,0}\pi}\left({\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}\right)^{{{\color[rgb]{0,0,0}\mu}}}\cdot\ex_{#1}\left[\sup_{{\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}}\left(\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}\right)\right]\right)\right]\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.56)</span></td></tr></tbody>
</table>
<p id="A4.SS4.p5.4" class="ltx_p"><span id="A4.SS4.p5.4.1" class="ltx_text">where we used the definition of the bracketing number <a href="#Thmdefinition2" title="Definition 2. ‣ D.4 Task Selection Bound for ICL ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Definition</span> <span class="ltx_text ltx_ref_tag">2</span></a> in the last line.
To obtain the final result, we perform additional manipulations on each term.
For the first term, we use that <math id="A4.SS4.p5.m6" class="ltx_Math" alttext="\frac{1}{1-x}\leq 1+2x" display="inline" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>x</mi></mrow></mfrac><mo>≤</mo><mrow><mn>1</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{1}{1-x}\leq 1+2x</annotation></semantics></math> for <math id="A4.SS4.p5.m7" class="ltx_Math" alttext="x\in(0,1/2)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">x\in(0,1/2)</annotation></semantics></math> so that</span></p>
<table id="A4.E57" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E57.m1" class="ltx_Math" alttext="\log\left((1+\varepsilon)^{{\color[rgb]{0,0,0}T}}\left(\frac{1+\varepsilon}{1-\varepsilon}\right)^{{\color[rgb]{0,0,0}T}}\right)\leq\log\left((1+2\varepsilon)^{3{\color[rgb]{0,0,0}T}}\right)\leq 6{\color[rgb]{0,0,0}T}\varepsilon\,," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><mrow><mn>1</mn><mo>+</mo><mi>ε</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow></mfrac><mo>)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msup></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msup><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow></mrow><mo lspace="0.170em">,</mo></mrow><annotation encoding="application/x-tex">\log\left((1+\varepsilon)^{{\color[rgb]{0,0,0}T}}\left(\frac{1+\varepsilon}{1-\varepsilon}\right)^{{\color[rgb]{0,0,0}T}}\right)\leq\log\left((1+2\varepsilon)^{3{\color[rgb]{0,0,0}T}}\right)\leq 6{\color[rgb]{0,0,0}T}\varepsilon\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.57)</span></td></tr></tbody>
</table>
<p id="A4.SS4.p5.5" class="ltx_p"><span id="A4.SS4.p5.5.1" class="ltx_text">so that</span></p>
<table id="A4.EGx21" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E58"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E58.m1" class="ltx_Math" alttext="\displaystyle\log\left(1+{\color[rgb]{0,0,0}\mathcal{B}}({\color[rgb]{0,0,0}\Theta^{\prime}},\varepsilon,{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}},{\color[rgb]{0,0,0}T})(1+\varepsilon)^{{\color[rgb]{0,0,0}T}}\left(\frac{1+\varepsilon}{1-\varepsilon}\right)^{{\color[rgb]{0,0,0}T}}\right)" display="inline" intent=":literal"><semantics><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>,</mo><mi>ε</mi><mo>,</mo><msup><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>+</mo><mi>ε</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msup></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\log\left(1+{\color[rgb]{0,0,0}\mathcal{B}}({\color[rgb]{0,0,0}\Theta^{\prime}},\varepsilon,{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}},{\color[rgb]{0,0,0}T})(1+\varepsilon)^{{\color[rgb]{0,0,0}T}}\left(\frac{1+\varepsilon}{1-\varepsilon}\right)^{{\color[rgb]{0,0,0}T}}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E58.m2" class="ltx_Math" alttext="\displaystyle\leq\log\left(1+{\color[rgb]{0,0,0}\mathcal{B}}({\color[rgb]{0,0,0}\Theta^{\prime}},\varepsilon,{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}},{\color[rgb]{0,0,0}T})\right)+6{\color[rgb]{0,0,0}T}\varepsilon" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>,</mo><mi>ε</mi><mo>,</mo><msup><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\log\left(1+{\color[rgb]{0,0,0}\mathcal{B}}({\color[rgb]{0,0,0}\Theta^{\prime}},\varepsilon,{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}},{\color[rgb]{0,0,0}T})\right)+6{\color[rgb]{0,0,0}T}\varepsilon</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.58)</span></td></tr></tbody>
<tbody id="A4.E59"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E59.m1" class="ltx_Math" alttext="\displaystyle\leq 2\log\left({\color[rgb]{0,0,0}\mathcal{B}}({\color[rgb]{0,0,0}\Theta^{\prime}},\varepsilon,{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}},{\color[rgb]{0,0,0}T})\right)+6{\color[rgb]{0,0,0}T}\varepsilon\,." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>,</mo><mi>ε</mi><mo>,</mo><msup><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow></mrow></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\log\left({\color[rgb]{0,0,0}\mathcal{B}}({\color[rgb]{0,0,0}\Theta^{\prime}},\varepsilon,{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}},{\color[rgb]{0,0,0}T})\right)+6{\color[rgb]{0,0,0}T}\varepsilon\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.59)</span></td></tr></tbody>
</table>
<p id="A4.SS4.p5.6" class="ltx_p"><span id="A4.SS4.p5.6.1" class="ltx_text">For the second term, we use that <math id="A4.SS4.p5.m8" class="ltx_Math" alttext="\log(1+x)\leq x" display="inline" intent=":literal"><semantics><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>x</mi></mrow><annotation encoding="application/x-tex">\log(1+x)\leq x</annotation></semantics></math> and distinguish two cases to obtain</span></p>
<table id="A4.EGx22" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E60"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E60.m1" class="ltx_Math" alttext="\displaystyle\ex_{#1}\left[\log\left(1+{\color[rgb]{0,0,0}\pi}\left({\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}\right)^{{{\color[rgb]{0,0,0}\mu}}}\cdot\ex_{#1}\left[\sup_{{\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}}\left(\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}\right)\right]\right)\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∉</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup></mrow><mo rspace="0.055em">)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi></msup></mrow><mo rspace="0.222em">⋅</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo>[</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∉</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup></mrow></munder><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ex_{#1}\left[\log\left(1+{\color[rgb]{0,0,0}\pi}\left({\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}\right)^{{{\color[rgb]{0,0,0}\mu}}}\cdot\ex_{#1}\left[\sup_{{\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}}\left(\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}\right)\right]\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.60)</span></td></tr></tbody>
<tbody id="A4.E61"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E61.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq{\color[rgb]{0,0,0}\pi}\left({\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}\right)^{{\color[rgb]{0,0,0}\mu}}+\ex_{#1}\left[\one\left\{\sup_{{\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}}\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}\geq 1\right\}\cdot\log\left(1+{\sup_{{\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}}\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}}\right)\right]\,." display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><msup><mrow><mo>(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∉</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi></msup><mo>+</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo>{</mo><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∉</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup></mrow></munder><mstyle displaystyle="true"><mfrac><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>≥</mo><mn>1</mn><mo rspace="0.055em">}</mo></mrow><mo rspace="0.222em">⋅</mo><mi>log</mi><mrow><mo>(</mo><mn>1</mn><mo>+</mo><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∉</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup></mrow></munder><mstyle displaystyle="true"><mfrac><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><mo>]</mo></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq{\color[rgb]{0,0,0}\pi}\left({\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}\right)^{{\color[rgb]{0,0,0}\mu}}+\ex_{#1}\left[\one\left\{\sup_{{\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}}\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}\geq 1\right\}\cdot\log\left(1+{\sup_{{\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}}\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}}\right)\right]\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.61)</span></td></tr></tbody>
</table>
<p id="A4.SS4.p5.7" class="ltx_p"><span id="A4.SS4.p5.7.1" class="ltx_text">All that is left to do is to deal with the case <math id="A4.SS4.p5.m9" class="ltx_Math" alttext="{\color[rgb]{0,0,0}X}\notin{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}^{\color[rgb]{0,0,0}T}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo>∉</mo><mmultiscripts><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mmultiscripts></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}X}\notin{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}^{\color[rgb]{0,0,0}T}</annotation></semantics></math>. We have, as above,</span></p>
<table id="A4.E62" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E62.m1" class="ltx_math_unparsed" alttext="{\color[rgb]{0,0,0}\mu}\ex_{#1}\left[\one\{{\color[rgb]{0,0,0}X}\notin{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}^{\color[rgb]{0,0,0}T}\}\log\ex_{#1}\left[\exp\left(-\frac{1}{{\color[rgb]{0,0,0}\mu}}\log\frac{\density_{#1}({\color[rgb]{0,0,0}X}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}X}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right)\right]\right]\leq\ex_{#1}\left[\one\{{\color[rgb]{0,0,0}X}\notin{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}^{\color[rgb]{0,0,0}T}\}\log\left(\sup_{{\color[rgb]{0,0,0}\theta}\in{\color[rgb]{0,0,0}\Theta}}\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}\right)\right]\,." display="block" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo stretchy="false">{</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo>∉</mo><mmultiscripts><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mmultiscripts><mo rspace="0.167em" stretchy="false">}</mo></mrow><mi>log</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mfrac><mn>1</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi></mfrac><mi>log</mi><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="false" lspace="0.170em" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="false" lspace="0.170em" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mfrac><mo>)</mo></mrow><mo>]</mo></mrow><mo>]</mo></mrow><mo>≤</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo stretchy="false">{</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo>∉</mo><mmultiscripts><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mmultiscripts><mo rspace="0.167em" stretchy="false">}</mo></mrow><mi>log</mi><mrow><mo>(</mo><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi></mrow></munder><mfrac><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>)</mo></mrow><mo>]</mo></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\mu}\ex_{#1}\left[\one\{{\color[rgb]{0,0,0}X}\notin{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}^{\color[rgb]{0,0,0}T}\}\log\ex_{#1}\left[\exp\left(-\frac{1}{{\color[rgb]{0,0,0}\mu}}\log\frac{\density_{#1}({\color[rgb]{0,0,0}X}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}X}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right)\right]\right]\leq\ex_{#1}\left[\one\{{\color[rgb]{0,0,0}X}\notin{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}^{\color[rgb]{0,0,0}T}\}\log\left(\sup_{{\color[rgb]{0,0,0}\theta}\in{\color[rgb]{0,0,0}\Theta}}\frac{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}\right)\right]\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.62)</span></td></tr></tbody>
</table>
<p id="A4.SS4.p5.8" class="ltx_p"><span id="A4.SS4.p5.8.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A4.SS4.p6" class="ltx_para">
<p id="A4.SS4.p6.1" class="ltx_p">We now leverage <a href="#Thmassumption3" title="Assumption 3 (Data generation). ‣ D.3 ICL setting ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">3</span></a> to control the different terms of <a href="#A4.Thmlemma3" title="Lemma D.3. ‣ D.4 Task Selection Bound for ICL ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">D.3</span></a>.</p>
</div>
<div id="A4.Thmlemma4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A4.Thmlemma4.2" class="ltx_text ltx_font_bold">Lemma D.4</span></span><span id="A4.Thmlemma4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A4.Thmlemma4.p1" class="ltx_para">
<p id="A4.Thmlemma4.p1.1" class="ltx_p"><span id="A4.Thmlemma4.p1.1.1" class="ltx_text ltx_font_italic">For <math id="A4.Thmlemma4.p1.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\mu}\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\mu}\in(0,1)</annotation></semantics></math>, under <a href="#Thmassumption3" title="Assumption 3 (Data generation). ‣ D.3 ICL setting ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">3</span></a>, for any <math id="A4.Thmlemma4.p1.m2" class="ltx_Math" alttext="{\color[rgb]{0,0,0}T}\geq 1" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}T}\geq 1</annotation></semantics></math>,
it holds that</span></p>
<table id="A4.EGx23" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E63.m1" class="ltx_math_unparsed" alttext="\displaystyle{\color[rgb]{0,0,0}\mu}\ex_{#1}\left[\log\ex_{#1}\left[\exp\left(-\frac{1}{{\color[rgb]{0,0,0}\mu}}\log\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right)\right]\right]\leq{\color[rgb]{0,0,0}\pi}\left({\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}\right)^{{\color[rgb]{0,0,0}\mu}}+\bigoh\left(\log({\color[rgb]{0,0,0}T})\right)\,," display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi>log</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi></mfrac></mstyle><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>)</mo></mrow><mo>]</mo></mrow><mo>]</mo></mrow><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><msup><mrow><mo>(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∉</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi></msup><mo>+</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒪</mi><mrow><mo>(</mo><mi>log</mi><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.170em">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\color[rgb]{0,0,0}\mu}\ex_{#1}\left[\log\ex_{#1}\left[\exp\left(-\frac{1}{{\color[rgb]{0,0,0}\mu}}\log\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right)\right]\right]\leq{\color[rgb]{0,0,0}\pi}\left({\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}\right)^{{\color[rgb]{0,0,0}\mu}}+\bigoh\left(\log({\color[rgb]{0,0,0}T})\right)\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.63)</span></td></tr></tbody>
</table>
<p id="A4.Thmlemma4.p1.2" class="ltx_p"><span id="A4.Thmlemma4.p1.2.1" class="ltx_text ltx_font_italic">where the <math id="A4.Thmlemma4.p1.m3" class="ltx_Math" alttext="\bigoh(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bigoh(\cdot)</annotation></semantics></math> hides constants that do not depend on <math id="A4.Thmlemma4.p1.m4" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\pi}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\pi}</annotation></semantics></math> or <math id="A4.Thmlemma4.p1.m5" class="ltx_Math" alttext="{\color[rgb]{0,0,0}T}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}T}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A4.SS4.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS4.p7" class="ltx_para">
<p id="A4.SS4.p7.1" class="ltx_p"><span id="A4.SS4.p7.1.1" class="ltx_text">Fix <math id="A4.SS4.p7.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}R}&gt;0" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}R}&gt;0</annotation></semantics></math> that will be chosen later and take <math id="A4.SS4.p7.m2" class="ltx_Math" alttext="{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}={\color[rgb]{0,0,0}\overline{\mathbb{B}}}(0,{\color[rgb]{0,0,0}R})" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>=</mo><mrow><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔹</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}={\color[rgb]{0,0,0}\overline{\mathbb{B}}}(0,{\color[rgb]{0,0,0}R})</annotation></semantics></math> and <math id="A4.SS4.p7.m3" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\Theta^{\prime}}={\color[rgb]{0,0,0}\overline{\mathbb{B}}}(0,{\color[rgb]{0,0,0}R})" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>=</mo><mrow><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔹</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\Theta^{\prime}}={\color[rgb]{0,0,0}\overline{\mathbb{B}}}(0,{\color[rgb]{0,0,0}R})</annotation></semantics></math>.
Let us consider a <math id="A4.SS4.p7.m4" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>-cover of <math id="A4.SS4.p7.m5" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\Theta^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\Theta^{\prime}}</annotation></semantics></math> with <math id="A4.SS4.p7.m6" class="ltx_Math" alttext="\delta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta&gt;0</annotation></semantics></math> that will be chosen later: there are <math id="A4.SS4.p7.m7" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> sets <math id="A4.SS4.p7.m8" class="ltx_Math" alttext="U_{j}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>j</mi></msub><annotation encoding="application/x-tex">U_{j}</annotation></semantics></math>, <math id="A4.SS4.p7.m9" class="ltx_Math" alttext="j=1,\dots,K" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">j=1,\dots,K</annotation></semantics></math> that cover <math id="A4.SS4.p7.m10" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\Theta^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\Theta^{\prime}}</annotation></semantics></math> such that for any <math id="A4.SS4.p7.m11" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\theta},{\color[rgb]{0,0,0}\theta}^{\prime}\in U_{j}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>,</mo><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>′</mo></msup><mo>∈</mo><msub><mi>U</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\theta},{\color[rgb]{0,0,0}\theta}^{\prime}\in U_{j}</annotation></semantics></math>, we have <math id="A4.SS4.p7.m12" class="ltx_Math" alttext="\lVert{\color[rgb]{0,0,0}\theta}-{\color[rgb]{0,0,0}\theta}^{\prime}\rVert\leq\delta" display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="0em">∥</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>−</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>′</mo></msup></mrow><mo fence="true" lspace="0em" rspace="0.1389em">∥</mo></mrow><mo lspace="0.1389em">≤</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">\lVert{\color[rgb]{0,0,0}\theta}-{\color[rgb]{0,0,0}\theta}^{\prime}\rVert\leq\delta</annotation></semantics></math>. By e.g., <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib58" title="" class="ltx_ref">Wainwright (2019, Ex. 5.2)</a></cite>, we can take <math id="A4.SS4.p7.m13" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> such that <math id="A4.SS4.p7.m14" class="ltx_Math" alttext="\log K\leq{\color[rgb]{0,0,0}d}\log(1+2{\color[rgb]{0,0,0}R}/\delta)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>K</mi></mrow><mo>≤</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi></mrow><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\log K\leq{\color[rgb]{0,0,0}d}\log(1+2{\color[rgb]{0,0,0}R}/\delta)</annotation></semantics></math>.</span></p>
</div>
<div id="A4.SS4.p8" class="ltx_para">
<p id="A4.SS4.p8.1" class="ltx_p"><a href="#Thmassumption3" title="Assumption 3 (Data generation). ‣ D.3 ICL setting ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">3</span></a><span id="A4.SS4.p8.1.1" class="ltx_text"> ensures that the sets <math id="A4.SS4.p8.m1" class="ltx_Math" alttext="U_{j}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>j</mi></msub><annotation encoding="application/x-tex">U_{j}</annotation></semantics></math> satisfy the bracketing condition of <a href="#Thmdefinition2" title="Definition 2. ‣ D.4 Task Selection Bound for ICL ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Definition</span> <span class="ltx_text ltx_ref_tag">2</span></a> with <math id="A4.SS4.p8.m2" class="ltx_Math" alttext="\varepsilon=\exp(\poly({\color[rgb]{0,0,0}R})\delta)-1" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>=</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\varepsilon=\exp(\poly({\color[rgb]{0,0,0}R})\delta)-1</annotation></semantics></math>. Therefore, we have, with this choice of <math id="A4.SS4.p8.m3" class="ltx_Math" alttext="\varepsilon" display="inline" intent=":literal"><semantics><mi>ε</mi><annotation encoding="application/x-tex">\varepsilon</annotation></semantics></math>,</span></p>
<table id="A4.E64" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E64.m1" class="ltx_Math" alttext="\log{\color[rgb]{0,0,0}\mathcal{B}}({\color[rgb]{0,0,0}\Theta^{\prime}},\varepsilon,{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}},{\color[rgb]{0,0,0}T})\leq{\color[rgb]{0,0,0}d}\log(1+2{\color[rgb]{0,0,0}R}/\delta)\,." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>,</mo><mi>ε</mi><mo>,</mo><msup><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi></mrow><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">\log{\color[rgb]{0,0,0}\mathcal{B}}({\color[rgb]{0,0,0}\Theta^{\prime}},\varepsilon,{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}},{\color[rgb]{0,0,0}T})\leq{\color[rgb]{0,0,0}d}\log(1+2{\color[rgb]{0,0,0}R}/\delta)\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.64)</span></td></tr></tbody>
</table>
</div>
<div id="A4.SS4.p9" class="ltx_para">
<p id="A4.SS4.p9.1" class="ltx_p"><span id="A4.SS4.p9.1.1" class="ltx_text">Using Cauchy-Schwarz inequality and <a href="#Thmassumption3" title="Assumption 3 (Data generation). ‣ D.3 ICL setting ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">3</span></a>, we have that, both</span></p>
<table id="A4.EGx24" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E65.m1" class="ltx_math_unparsed" alttext="\displaystyle\ex_{#1}\left[\one\left\{\sup_{{\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}}\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}\geq 1\right\}\cdot\log\left(1+{\sup_{{\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}}\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}}\right)\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo>{</mo><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∉</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup></mrow></munder><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>≥</mo><mn>1</mn><mo rspace="0.055em">}</mo></mrow><mo rspace="0.222em">⋅</mo><mi>log</mi><mrow><mo>(</mo><mn>1</mn><mo>+</mo><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∉</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup></mrow></munder><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ex_{#1}\left[\one\left\{\sup_{{\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}}\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}\geq 1\right\}\cdot\log\left(1+{\sup_{{\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}}\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}}\right)\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E65.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{\poly({\color[rgb]{0,0,0}T})}{1+{\color[rgb]{0,0,0}R}^{1/k}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>+</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mrow><mn>1</mn><mo>/</mo><mi>k</mi></mrow></msup></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\poly({\color[rgb]{0,0,0}T})}{1+{\color[rgb]{0,0,0}R}^{1/k}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.65)</span></td></tr></tbody>
<tbody id="A4.E66"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E66.m1" class="ltx_math_unparsed" alttext="\displaystyle\ex_{#1}\left[\one\left\{{\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\notin{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}^{\color[rgb]{0,0,0}T}\right\}\cdot\log\left({\sup_{{\color[rgb]{0,0,0}\theta}\in{\color[rgb]{0,0,0}\Theta}}\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}}\right)\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo>{</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo>∉</mo><mmultiscripts><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒳</mi><mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mmultiscripts><mo rspace="0.055em">}</mo></mrow><mo rspace="0.222em">⋅</mo><mi>log</mi><mrow><mo>(</mo><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi></mrow></munder><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ex_{#1}\left[\one\left\{{\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\notin{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\mathcal{X}}^{\prime}}^{\color[rgb]{0,0,0}T}\right\}\cdot\log\left({\sup_{{\color[rgb]{0,0,0}\theta}\in{\color[rgb]{0,0,0}\Theta}}\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\mid{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}}\right)\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E66.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{\poly({\color[rgb]{0,0,0}T})}{1+{\color[rgb]{0,0,0}R}^{1/k}}\,." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>+</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mrow><mn>1</mn><mo>/</mo><mi>k</mi></mrow></msup></mrow></mfrac></mstyle></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\poly({\color[rgb]{0,0,0}T})}{1+{\color[rgb]{0,0,0}R}^{1/k}}\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.66)</span></td></tr></tbody>
</table>
<p id="A4.SS4.p9.2" class="ltx_p"><span id="A4.SS4.p9.2.1" class="ltx_text">Choose <math id="A4.SS4.p9.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}R}=\poly({\color[rgb]{0,0,0}T})" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mo>=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}R}=\poly({\color[rgb]{0,0,0}T})</annotation></semantics></math> so that both <a href="#A4.E65" title="In Proof. ‣ D.4 Task Selection Bound for ICL ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eqs.</span> <span class="ltx_text ltx_ref_tag">D.65</span></a> and <a href="#A4.E66" title="Equation D.66 ‣ Proof. ‣ D.4 Task Selection Bound for ICL ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.66</span></a> are <math id="A4.SS4.p9.m2" class="ltx_Math" alttext="\bigoh(1)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bigoh(1)</annotation></semantics></math>.
Finally, we choose <math id="A4.SS4.p9.m3" class="ltx_Math" alttext="\delta=(\poly({\color[rgb]{0,0,0}T}))^{-1}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\delta=(\poly({\color[rgb]{0,0,0}T}))^{-1}</annotation></semantics></math> so that <math id="A4.SS4.p9.m4" class="ltx_Math" alttext="\varepsilon=\exp(\poly({\color[rgb]{0,0,0}R})\delta)-1=\bigoh(1/{\color[rgb]{0,0,0}T})" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>=</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mo>=</mo><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\varepsilon=\exp(\poly({\color[rgb]{0,0,0}R})\delta)-1=\bigoh(1/{\color[rgb]{0,0,0}T})</annotation></semantics></math>.
Combining this <a href="#A4.E64" title="In Proof. ‣ D.4 Task Selection Bound for ICL ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eqs.</span> <span class="ltx_text ltx_ref_tag">D.64</span></a>, <a href="#A4.E65" title="Equation D.65 ‣ Proof. ‣ D.4 Task Selection Bound for ICL ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.65</span></a> and <a href="#A4.E66" title="Equation D.66 ‣ Proof. ‣ D.4 Task Selection Bound for ICL ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.66</span></a> with <a href="#A4.Thmlemma3" title="Lemma D.3. ‣ D.4 Task Selection Bound for ICL ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">D.3</span></a> concludes the proof.
∎</span></p>
</div>
</div>
<div id="A4.SS4.p10" class="ltx_para">
<p id="A4.SS4.p10.1" class="ltx_p">We can now state our main result for ICL.
As a metric to asses the quality of a given retrieved task <math id="A4.SS4.p10.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\theta}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\theta}</annotation></semantics></math> w.r.t. the true task <math id="A4.SS4.p10.m2" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\theta}^{*}" display="inline" intent=":literal"><semantics><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\theta}^{*}</annotation></semantics></math>, we consider the Rényi divergence <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib46" title="" class="ltx_ref">Rényi, 1961</a>)</cite> of order <math id="A4.SS4.p10.m3" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\rho}\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\rho}\in(0,1)</annotation></semantics></math> between the distributions <math id="A4.SS4.p10.m4" class="ltx_math_unparsed" alttext="\density_{#1}(\cdot\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em">⋅</mo><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\density_{#1}(\cdot\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})</annotation></semantics></math> and <math id="A4.SS4.p10.m5" class="ltx_math_unparsed" alttext="\density_{#1}(\cdot\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta}^{*})" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em">⋅</mo><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\density_{#1}(\cdot\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta}^{*})</annotation></semantics></math>:</p>
<table id="A4.E67" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E67.m1" class="ltx_math_unparsed" alttext="\mathrm{D}_{#1}\!({\color[rgb]{0,0,0}\theta}\,\|\,{\color[rgb]{0,0,0}\theta}^{*})=-\frac{1}{{\color[rgb]{0,0,0}T}(1-{\color[rgb]{0,0,0}\rho})}\log\ex_{#1}\left[\prod_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}\left(\tfrac{\density_{#1}({\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-1},{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-1},{\color[rgb]{0,0,0}\theta}^{*})}\right)^{{\color[rgb]{0,0,0}\rho}}\right]\,." display="block" intent=":literal"><semantics><mrow><msub><mi>D</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo lspace="0.170em" rspace="0.337em">∥</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mfrac><mn>1</mn><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mi>log</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><munderover><mo lspace="0em" movablelimits="false" rspace="0em">∏</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>=</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover><msup><mrow><mo>(</mo><mstyle displaystyle="false"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msup><mrow></mrow><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></msup><mo>]</mo></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{D}_{#1}\!({\color[rgb]{0,0,0}\theta}\,\|\,{\color[rgb]{0,0,0}\theta}^{*})=-\frac{1}{{\color[rgb]{0,0,0}T}(1-{\color[rgb]{0,0,0}\rho})}\log\ex_{#1}\left[\prod_{{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}=1}^{\color[rgb]{0,0,0}T}\left(\tfrac{\density_{#1}({\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-1},{\color[rgb]{0,0,0}\theta})}{\density_{#1}({\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}x}_{1:{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}-1},{\color[rgb]{0,0,0}\theta}^{*})}\right)^{{\color[rgb]{0,0,0}\rho}}\right]\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.67)</span></td></tr></tbody>
</table>
</div>
<div id="A4.Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A4.Thmtheorem1.2" class="ltx_text ltx_font_bold">Theorem D.1</span></span><span id="A4.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A4.Thmtheorem1.p1" class="ltx_para">
<p id="A4.Thmtheorem1.p1.1" class="ltx_p"><span id="A4.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Under <a href="#Thmassumption3" title="Assumption 3 (Data generation). ‣ D.3 ICL setting ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">3</span></a>, for any <math id="A4.Thmtheorem1.p1.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\rho}\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\rho}\in(0,1)</annotation></semantics></math>,
<math id="A4.Thmtheorem1.p1.m2" class="ltx_Math" alttext="{\color[rgb]{0,0,0}T}\geq 1" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}T}\geq 1</annotation></semantics></math>,
it holds that, for <math id="A4.Thmtheorem1.p1.m3" class="ltx_math_unparsed" alttext="{\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\sim\density_{#1}(\cdot\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta}^{*})" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo>∼</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi mathvariant="normal">#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em">⋅</mo><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mrow><mphantom></mphantom><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\sim\density_{#1}(\cdot\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta}^{*})</annotation></semantics></math>,</span></p>
<table id="A4.EGx25" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E68.m1" class="ltx_math_unparsed" alttext="\displaystyle\ex_{#1}\left[\ex_{#1}\left[\mathrm{D}_{#1}\!({\color[rgb]{0,0,0}\theta}\,\|\,{\color[rgb]{0,0,0}\theta}^{*})\right]\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><msub><mi>D</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo lspace="0.170em" rspace="0.337em">∥</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ex_{#1}\left[\ex_{#1}\left[\mathrm{D}_{#1}\!({\color[rgb]{0,0,0}\theta}\,\|\,{\color[rgb]{0,0,0}\theta}^{*})\right]\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.68)</span></td></tr></tbody>
<tbody id="A4.E69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E69.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq-\frac{1+{\color[rgb]{0,0,0}\rho}}{(1-{\color[rgb]{0,0,0}\rho}){\color[rgb]{0,0,0}T}}\log\left(\ex_{#1}\left[\exp\left(-\ex_{#1}\left[\log\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right]\right)\right]\right)" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">≤</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></mfrac></mstyle><mi>log</mi><mrow><mo>(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>]</mo></mrow><mo>)</mo></mrow><mo>]</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq-\frac{1+{\color[rgb]{0,0,0}\rho}}{(1-{\color[rgb]{0,0,0}\rho}){\color[rgb]{0,0,0}T}}\log\left(\ex_{#1}\left[\exp\left(-\ex_{#1}\left[\log\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right]\right)\right]\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.69)</span></td></tr></tbody>
<tbody id="A4.E70"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E70.m1" class="ltx_Math" alttext="\displaystyle\quad+\frac{1+{\color[rgb]{0,0,0}\rho}}{1-{\color[rgb]{0,0,0}\rho}}\frac{{\mathrm{KL}}\!(\density_{#1}(\cdot\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta}^{*})\,\|\,\density_{#1}(\cdot\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}))}{{\color[rgb]{0,0,0}T}}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mpadded style="width:1.431em;" width="1.431em"><mi>KL</mi></mpadded><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em">⋅</mo><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msup><mrow></mrow><mo>∗</mo></msup><mo stretchy="false">)</mo><mo lspace="0.170em" rspace="0.337em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em">⋅</mo><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\frac{1+{\color[rgb]{0,0,0}\rho}}{1-{\color[rgb]{0,0,0}\rho}}\frac{{\mathrm{KL}}\!(\density_{#1}(\cdot\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta}^{*})\,\|\,\density_{#1}(\cdot\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}))}{{\color[rgb]{0,0,0}T}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.70)</span></td></tr></tbody>
<tbody id="A4.E71"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E71.m1" class="ltx_Math" alttext="\displaystyle+\bigoh\left(\frac{\log({\color[rgb]{0,0,0}T})}{{\color[rgb]{0,0,0}T}}\right)\,," display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">+</mo><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mfrac></mstyle><mo rspace="0.170em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\bigoh\left(\frac{\log({\color[rgb]{0,0,0}T})}{{\color[rgb]{0,0,0}T}}\right)\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.71)</span></td></tr></tbody>
</table>
<p id="A4.Thmtheorem1.p1.2" class="ltx_p"><span id="A4.Thmtheorem1.p1.2.1" class="ltx_text ltx_font_italic">where the <math id="A4.Thmtheorem1.p1.m4" class="ltx_Math" alttext="\bigoh(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bigoh(\cdot)</annotation></semantics></math> hides constants that do not depend on <math id="A4.Thmtheorem1.p1.m5" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\pi}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\pi}</annotation></semantics></math> or <math id="A4.Thmtheorem1.p1.m6" class="ltx_Math" alttext="{\color[rgb]{0,0,0}T}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}T}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A4.SS4.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS4.p11" class="ltx_para">
<p id="A4.SS4.p11.1" class="ltx_p"><span id="A4.SS4.p11.1.1" class="ltx_text">This is a direct consequence of <a href="#A4.Thmproposition1" title="Proposition D.1 (Template task selection bound). ‣ D.2 Template Task Selection Bound ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">D.1</span></a> combined with <a href="#A4.Thmlemma4" title="Lemma D.4. ‣ D.4 Task Selection Bound for ICL ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">D.4</span></a> with <math id="A4.SS4.p11.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\lambda}=1+{\color[rgb]{0,0,0}\rho}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\lambda}=1+{\color[rgb]{0,0,0}\rho}</annotation></semantics></math> and bounding <math id="A4.SS4.p11.m2" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\pi}\left({\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}\right)^{{\color[rgb]{0,0,0}\mu}}\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∉</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup></mrow><mo>)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi></msup></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\pi}\left({\color[rgb]{0,0,0}\theta}\notin{\color[rgb]{0,0,0}\Theta^{\prime}}\right)^{{\color[rgb]{0,0,0}\mu}}\leq 1</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A4.SS4.p12" class="ltx_para">
<p id="A4.SS4.p12.1" class="ltx_p">A few comments are in order.
The first term of <a href="#A4.E69" title="In Theorem D.1. ‣ D.4 Task Selection Bound for ICL ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">D.69</span></a> captures how much the prior <math id="A4.SS4.p12.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\pi}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\pi}</annotation></semantics></math> covers the reference task <math id="A4.SS4.p12.m2" class="ltx_Math" alttext="{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}</annotation></semantics></math>. When <math id="A4.SS4.p12.m3" class="ltx_Math" alttext="{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}={\color[rgb]{0,0,0}\theta}^{*}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo>=</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}={\color[rgb]{0,0,0}\theta}^{*}</annotation></semantics></math>, this term thus quantifies how well the prior covers the true task <math id="A4.SS4.p12.m4" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\theta}^{*}" display="inline" intent=":literal"><semantics><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\theta}^{*}</annotation></semantics></math>. When <math id="A4.SS4.p12.m5" class="ltx_Math" alttext="{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}</annotation></semantics></math> is inside the support of <math id="A4.SS4.p12.m6" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\pi}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\pi}</annotation></semantics></math>, this term is vanishing as <math id="A4.SS4.p12.m7" class="ltx_Math" alttext="{\color[rgb]{0,0,0}T}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}T}</annotation></semantics></math> grows large, see the next results below.</p>
</div>
<div id="A4.SS4.p13" class="ltx_para">
<p id="A4.SS4.p13.1" class="ltx_p">The second term of <a href="#A4.E70" title="In Theorem D.1. ‣ D.4 Task Selection Bound for ICL ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">D.70</span></a> captures how well the reference task <math id="A4.SS4.p13.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}</annotation></semantics></math> approximates the true task <math id="A4.SS4.p13.m2" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\theta}^{*}" display="inline" intent=":literal"><semantics><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\theta}^{*}</annotation></semantics></math>.
When <math id="A4.SS4.p13.m3" class="ltx_Math" alttext="{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}={\color[rgb]{0,0,0}\theta}^{*}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo>=</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}={\color[rgb]{0,0,0}\theta}^{*}</annotation></semantics></math>, the term of <a href="#A4.E70" title="In Theorem D.1. ‣ D.4 Task Selection Bound for ICL ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">D.70</span></a> is 0. Otherwise, consider the case the KL will typically be of order <math id="A4.SS4.p13.m4" class="ltx_Math" alttext="{\color[rgb]{0,0,0}T}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}T}</annotation></semantics></math> so that this term is <math id="A4.SS4.p13.m5" class="ltx_Math" alttext="\bigoh(1)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bigoh(1)</annotation></semantics></math>: it represents the best ICL error one can hope for when the true task <math id="A4.SS4.p13.m6" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\theta}^{*}" display="inline" intent=":literal"><semantics><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\theta}^{*}</annotation></semantics></math> is not in the support of the prior <math id="A4.SS4.p13.m7" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\pi}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\pi}</annotation></semantics></math>.</p>
</div>
</section>
<section id="A4.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.5 </span>Laplace Approximation</h3>

<div id="A4.SS5.p1" class="ltx_para">
<p id="A4.SS5.p1.1" class="ltx_p">We will make use of the following version of the Laplace approximation, see <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib63" title="" class="ltx_ref">Wong (2001, Chap. 9, Thm. 3)</a></cite> for a proof.</p>
</div>
<div id="A4.Thmlemma5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A4.Thmlemma5.2" class="ltx_text ltx_font_bold">Lemma D.5</span></span><span id="A4.Thmlemma5.3" class="ltx_text ltx_font_bold"> </span>(Laplace approximation)<span id="A4.Thmlemma5.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A4.Thmlemma5.p1" class="ltx_para">
<p id="A4.Thmlemma5.p1.1" class="ltx_p"><span id="A4.Thmlemma5.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A4.Thmlemma5.p1.m1" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math> be a probability measure on <math id="A4.Thmlemma5.p1.m2" class="ltx_Math" alttext="\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>d</mi></msup><annotation encoding="application/x-tex">\mathbb{R}^{d}</annotation></semantics></math> with density <math id="A4.Thmlemma5.p1.m3" class="ltx_Math" alttext="g:\mathbb{R}^{d}\to[0,\infty)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mi>d</mi></msup><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">g:\mathbb{R}^{d}\to[0,\infty)</annotation></semantics></math>. Fix <math id="A4.Thmlemma5.p1.m4" class="ltx_Math" alttext="x^{*}\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mo>∗</mo></msup><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">x^{*}\in\mathbb{R}^{d}</annotation></semantics></math> such that <math id="A4.Thmlemma5.p1.m5" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> is continuous at <math id="A4.Thmlemma5.p1.m6" class="ltx_Math" alttext="x^{*}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">x^{*}</annotation></semantics></math> and <math id="A4.Thmlemma5.p1.m7" class="ltx_Math" alttext="g(x^{*})&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">g(x^{*})&gt;0</annotation></semantics></math>.
Then, as <math id="A4.Thmlemma5.p1.m8" class="ltx_Math" alttext="\varepsilon\to 0" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\varepsilon\to 0</annotation></semantics></math>,</span></p>
<table id="A4.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex1.m1" class="ltx_Math" alttext="\int_{\mathbb{R}^{d}}\exp\!\Bigl(-\tfrac{1}{2\varepsilon}\,\|x-x^{*}\|\Bigr)\,g(x)\,dx,\;=\;g(x^{*})\,C\,\varepsilon^{d}\;+\;o(\varepsilon^{d})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∫</mo><msup><mi>ℝ</mi><mi>d</mi></msup></msub><mrow><mrow><mpadded style="width:1.370em;" width="1.370em"><mi>exp</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><mi>x</mi><mo>−</mo><msup><mi>x</mi><mo>∗</mo></msup></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow><mo rspace="0.447em">,</mo><mrow><mphantom></mphantom><mo rspace="0.558em">=</mo><mrow><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>C</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>ε</mi><mi>d</mi></msup></mrow><mo rspace="0.502em">+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ε</mi><mi>d</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\int_{\mathbb{R}^{d}}\exp\!\Bigl(-\tfrac{1}{2\varepsilon}\,\|x-x^{*}\|\Bigr)\,g(x)\,dx,\;=\;g(x^{*})\,C\,\varepsilon^{d}\;+\;o(\varepsilon^{d}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.Thmlemma5.p1.2" class="ltx_p"><span id="A4.Thmlemma5.p1.2.1" class="ltx_text ltx_font_italic">where <math id="A4.Thmlemma5.p1.m9" class="ltx_Math" alttext="C\;\coloneqq\;\int_{\mathbb{R}^{d}}\exp\!\Bigl(-\tfrac{1}{2}\,\|y\|\Bigr)\,dy\in(0,\infty)" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0.558em" rspace="0.391em">≔</mo><mrow><msub><mo>∫</mo><msup><mi>ℝ</mi><mi>d</mi></msup></msub><mrow><mrow><mpadded style="width:1.370em;" width="1.370em"><mi>exp</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mi>y</mi><mo stretchy="false">‖</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>y</mi></mrow></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C\;\coloneqq\;\int_{\mathbb{R}^{d}}\exp\!\Bigl(-\tfrac{1}{2}\,\|y\|\Bigr)\,dy\in(0,\infty)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="Thmassumption4" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmassumption4.2" class="ltx_text ltx_font_bold">Assumption 4</span></span><span id="Thmassumption4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmassumption4.p1" class="ltx_para">
<p id="Thmassumption4.p1.1" class="ltx_p">Consider the following additional assumptions to <a href="#Thmassumption3" title="Assumption 3 (Data generation). ‣ D.3 ICL setting ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">3</span></a>:</p>
<ul id="A4.I2" class="ltx_itemize">
<li id="A4.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I2.i1.p1" class="ltx_para">
<p id="A4.I2.i1.p1.1" class="ltx_p">Tail behaviour:
for any <math id="A4.I2.i1.p1.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}T}\geq 1" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}T}\geq 1</annotation></semantics></math>, <math id="A4.I2.i1.p1.m2" class="ltx_Math" alttext="{\color[rgb]{0,0,0}R}&gt;0" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}R}&gt;0</annotation></semantics></math>,</p>
<table id="A4.EGx26" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E72"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E72.m1" class="ltx_math_unparsed" alttext="\displaystyle\prob_{\!#1}\left({\sup_{{\color[rgb]{0,0,0}\theta}:\lVert{\color[rgb]{0,0,0}\theta}\rVert\geq{\color[rgb]{0,0,0}R}}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}\geq{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℙ</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>(</mo><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo lspace="0.278em">:</mo><mrow><mrow><mo fence="true" lspace="0.111em" rspace="0em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo fence="true" lspace="0em" rspace="0.1389em">∥</mo></mrow><mo lspace="0.1389em">≥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi></mrow></mrow></munder><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow><mo>≥</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\prob_{\!#1}\left({\sup_{{\color[rgb]{0,0,0}\theta}:\lVert{\color[rgb]{0,0,0}\theta}\rVert\geq{\color[rgb]{0,0,0}R}}{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}\theta})}\geq{\density_{#1}({\color[rgb]{0,0,0}X}\mid{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E72.m2" class="ltx_Math" alttext="\displaystyle\leq{\poly({\color[rgb]{0,0,0}T})}e^{-{\color[rgb]{0,0,0}R}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq{\poly({\color[rgb]{0,0,0}T})}e^{-{\color[rgb]{0,0,0}R}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.72)</span></td></tr></tbody>
<tbody id="A4.E73"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E73.m1" class="ltx_math_unparsed" alttext="\displaystyle\prob_{\!#1}\Big({\exists{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\leq{\color[rgb]{0,0,0}T},\lVert{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\rVert\geq{\color[rgb]{0,0,0}R}}\Big)" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℙ</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mo rspace="0.167em">∃</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo>≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo>,</mo><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo fence="true" lspace="0em" rspace="0.1389em">∥</mo></mrow><mo lspace="0.1389em">≥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\prob_{\!#1}\Big({\exists{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\leq{\color[rgb]{0,0,0}T},\lVert{\color[rgb]{0,0,0}x}_{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}t}}\rVert\geq{\color[rgb]{0,0,0}R}}\Big)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E73.m2" class="ltx_Math" alttext="\displaystyle\leq\poly({\color[rgb]{0,0,0}T})e^{-{\color[rgb]{0,0,0}R}}\,." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\poly({\color[rgb]{0,0,0}T})e^{-{\color[rgb]{0,0,0}R}}\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.73)</span></td></tr></tbody>
</table>
</div></li>
<li id="A4.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I2.i2.p1" class="ltx_para">
<p id="A4.I2.i2.p1.1" class="ltx_p">Regularity of <math id="A4.I2.i2.p1.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\pi}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\pi}</annotation></semantics></math>: <math id="A4.I2.i2.p1.m2" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\pi}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\pi}</annotation></semantics></math> is continuous and positive at <math id="A4.I2.i2.p1.m3" class="ltx_Math" alttext="{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}}</annotation></semantics></math>.</p>
</div></li>
<li id="A4.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I2.i3.p1" class="ltx_para">
<p id="A4.I2.i3.p1.1" class="ltx_p">Second moment of <math id="A4.I2.i3.p1.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\pi}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\pi}</annotation></semantics></math>:</p>
<table id="A4.EGx27" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E74"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E74.m1" class="ltx_Math" alttext="\displaystyle\ex_{#1}\left[\lVert{\color[rgb]{0,0,0}\theta}\rVert^{2}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ex_{#1}\left[\lVert{\color[rgb]{0,0,0}\theta}\rVert^{2}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E74.m2" class="ltx_Math" alttext="\displaystyle&lt;\infty\,." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle&lt;\infty\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.74)</span></td></tr></tbody>
</table>
</div></li>
</ul>
</div>
</div>
<div id="A4.Thmproposition2" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A4.Thmproposition2.2" class="ltx_text ltx_font_bold">Proposition D.2</span></span><span id="A4.Thmproposition2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A4.Thmproposition2.p1" class="ltx_para">
<p id="A4.Thmproposition2.p1.1" class="ltx_p"><span id="A4.Thmproposition2.p1.1.1" class="ltx_text ltx_font_italic">Under <a href="#Thmassumption3" title="Assumption 3 (Data generation). ‣ D.3 ICL setting ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumptions</span> <span class="ltx_text ltx_ref_tag">3</span></a> and <a href="#Thmassumption4" title="Assumption 4. ‣ D.5 Laplace Approximation ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, then, for <math id="A4.Thmproposition2.p1.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}T}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}T}</annotation></semantics></math> large enough,</span></p>
<table id="A4.EGx28" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E75"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E75.m1" class="ltx_math_unparsed" alttext="\displaystyle-\log\left(\ex_{#1}\left[\exp\left(-\ex_{#1}\left[\log\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right]\right)\right]\right)\leq\log 1/{\color[rgb]{0,0,0}\pi}({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})+\bigoh(\poly(\log{\color[rgb]{0,0,0}T}))\,." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>log</mi><mrow><mo>(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>]</mo></mrow><mo>)</mo></mrow><mo>]</mo></mrow><mo>)</mo></mrow><mo>≤</mo><mi>log</mi><mn>1</mn><mo>/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒪</mi><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mrow><mo stretchy="false">(</mo><mi>log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\log\left(\ex_{#1}\left[\exp\left(-\ex_{#1}\left[\log\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right]\right)\right]\right)\leq\log 1/{\color[rgb]{0,0,0}\pi}({\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})+\bigoh(\poly(\log{\color[rgb]{0,0,0}T}))\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.75)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A4.SS5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS5.p2" class="ltx_para">
<p id="A4.SS5.p2.1" class="ltx_p"><span id="A4.SS5.p2.1.1" class="ltx_text">For some <math id="A4.SS5.p2.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0}R}_{\color[rgb]{0,0,0}T}\geq{\color[rgb]{0,0,0}r}_{\color[rgb]{0,0,0}T}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo>≥</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}R}_{\color[rgb]{0,0,0}T}\geq{\color[rgb]{0,0,0}r}_{\color[rgb]{0,0,0}T}&gt;0</annotation></semantics></math>, we split the term as</span></p>
<table id="A4.EGx29" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E76"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E76.m1" class="ltx_math_unparsed" alttext="\displaystyle-\log\left(\ex_{#1}\left[\exp\left(-\ex_{#1}\left[\log\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right]\right)\right]\right)" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>log</mi><mrow><mo>(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>]</mo></mrow><mo>)</mo></mrow><mo>]</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\log\left(\ex_{#1}\left[\exp\left(-\ex_{#1}\left[\log\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right]\right)\right]\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.76)</span></td></tr></tbody>
<tbody id="A4.E77"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E77.m1" class="ltx_math_unparsed" alttext="\displaystyle=-\log\left(\ex_{#1}\left[\one\left\{\lVert{\color[rgb]{0,0,0}\theta}\rVert\leq{\color[rgb]{0,0,0}R}_{\color[rgb]{0,0,0}T}\right\}\exp\left(-\ex_{#1}\left[\log\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right]\right)+\one\left\{\lVert{\color[rgb]{0,0,0}\theta}\rVert&gt;{\color[rgb]{0,0,0}R}_{\color[rgb]{0,0,0}T}\right\}\exp\left(-\ex_{#1}\left[\log\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right]\right)\right]\right)" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mi>log</mi><mrow><mo>(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo>{</mo><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo fence="true" lspace="0em" rspace="0.1389em">∥</mo></mrow><mo lspace="0.1389em">≤</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo rspace="0.167em">}</mo></mrow><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>]</mo></mrow><mo>)</mo></mrow><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo>{</mo><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo fence="true" lspace="0em" rspace="0.1389em">∥</mo></mrow><mo lspace="0.1389em">&gt;</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo rspace="0.167em">}</mo></mrow><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>]</mo></mrow><mo>)</mo></mrow><mo>]</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\log\left(\ex_{#1}\left[\one\left\{\lVert{\color[rgb]{0,0,0}\theta}\rVert\leq{\color[rgb]{0,0,0}R}_{\color[rgb]{0,0,0}T}\right\}\exp\left(-\ex_{#1}\left[\log\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right]\right)+\one\left\{\lVert{\color[rgb]{0,0,0}\theta}\rVert&gt;{\color[rgb]{0,0,0}R}_{\color[rgb]{0,0,0}T}\right\}\exp\left(-\ex_{#1}\left[\log\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right]\right)\right]\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.77)</span></td></tr></tbody>
<tbody id="A4.E78"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E78.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq-\log\left(\ex_{#1}\left[\one\left\{\lVert{\color[rgb]{0,0,0}\theta}\rVert\leq{\color[rgb]{0,0,0}r}_{\color[rgb]{0,0,0}T}\right\}\exp\left(-\ex_{#1}\left[\log\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right]\right)+\one\left\{\lVert{\color[rgb]{0,0,0}\theta}\rVert&gt;{\color[rgb]{0,0,0}R}_{\color[rgb]{0,0,0}T}\right\}\exp\left(-\ex_{#1}\left[\log\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right]\right)\right]\right)" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">≤</mo><mo lspace="0em">−</mo><mi>log</mi><mrow><mo>(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo>{</mo><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo fence="true" lspace="0em" rspace="0.1389em">∥</mo></mrow><mo lspace="0.1389em">≤</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo rspace="0.167em">}</mo></mrow><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>]</mo></mrow><mo>)</mo></mrow><mo>+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mi><mrow><mo>{</mo><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo fence="true" lspace="0em" rspace="0.1389em">∥</mo></mrow><mo lspace="0.1389em">&gt;</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo rspace="0.167em">}</mo></mrow><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>]</mo></mrow><mo>)</mo></mrow><mo>]</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq-\log\left(\ex_{#1}\left[\one\left\{\lVert{\color[rgb]{0,0,0}\theta}\rVert\leq{\color[rgb]{0,0,0}r}_{\color[rgb]{0,0,0}T}\right\}\exp\left(-\ex_{#1}\left[\log\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right]\right)+\one\left\{\lVert{\color[rgb]{0,0,0}\theta}\rVert&gt;{\color[rgb]{0,0,0}R}_{\color[rgb]{0,0,0}T}\right\}\exp\left(-\ex_{#1}\left[\log\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right]\right)\right]\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.78)</span></td></tr></tbody>
</table>
<p id="A4.SS5.p2.2" class="ltx_p"><span id="A4.SS5.p2.2.1" class="ltx_text">Using Cauchy-Schwarz inequality and <a href="#Thmassumption3" title="Assumption 3 (Data generation). ‣ D.3 ICL setting ‣ Appendix D Task Selection ‣ How Does the Pretraining Distribution Shape In-Context Learning?Task Selection, Generalization, and Robustness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">3</span></a> and its refinement in the statement, we bound the second term as, for <math id="A4.SS5.p2.m2" class="ltx_Math" alttext="{\color[rgb]{0,0,0}\theta}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><annotation encoding="application/x-tex">{\color[rgb]{0,0,0}\theta}</annotation></semantics></math> such that <math id="A4.SS5.p2.m3" class="ltx_Math" alttext="\lVert{\color[rgb]{0,0,0}\theta}\rVert&gt;{\color[rgb]{0,0,0}R}_{\color[rgb]{0,0,0}T}" display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="0em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo fence="true" lspace="0em" rspace="0.1389em">∥</mo></mrow><mo lspace="0.1389em">&gt;</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub></mrow><annotation encoding="application/x-tex">\lVert{\color[rgb]{0,0,0}\theta}\rVert&gt;{\color[rgb]{0,0,0}R}_{\color[rgb]{0,0,0}T}</annotation></semantics></math>,
so that</span></p>
</div>
<div id="A4.SS5.p3" class="ltx_para">
<table id="A4.EGx30" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E79"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E79.m1" class="ltx_math_unparsed" alttext="\displaystyle\left\lvert\ex_{#1}\left[\log\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right]\right\rvert\leq e^{-{\color[rgb]{0,0,0}R}_{\color[rgb]{0,0,0}T}/2}\poly({\color[rgb]{0,0,0}T})\,." display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">p</mi><msub><mrow></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></msub><mo fence="false" rspace="0.337em" stretchy="false">|</mo><mphantom></mphantom><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>]</mo></mrow><mo>|</mo></mrow><mo>≤</mo><msup><mi>e</mi><mrow><mo>−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo>/</mo><mn>2</mn></mrow></msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">poly</mi><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\lvert\ex_{#1}\left[\log\frac{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}{\color[rgb]{0,0,0}\theta}_{0}})}{\density_{#1}({\color[rgb]{0,0,0}x_{1:{\color[rgb]{0,0,0}T}}}\nonscript\,|\nonscript\,\mathopen{}{\color[rgb]{0,0,0}\theta})}\right]\right\rvert\leq e^{-{\color[rgb]{0,0,0}R}_{\color[rgb]{0,0,0}T}/2}\poly({\color[rgb]{0,0,0}T})\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.79)</span></td></tr></tbody>
</table>
<p id="A4.SS5.p3.1" class="ltx_p"><span id="A4.SS5.p3.1.1" class="ltx_text">so that</span></p>
