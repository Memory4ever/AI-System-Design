undefined\",\"status\":\"operational\"},{\"component_id\":\"01JMXBNJXGKKP51D4DEJ2HZJ8Q\",\"current_status\":\"$undefined\",\"status\":\"operational\"},{\"component_id\":\"01JSFK5QX36ZRW0TW0ZV0ZYFXQ\",\"current_status\":\"$undefined\",\"status\":\"operational\"},{\"component_id\":\"01JSG1XMJ9RVJJQ0E85NVSJ2AZ\",\"current_status\":\"$undefined\",\"status\":\"operational\"},{\"component_id\":\"01JSYVYQSWMJ9QG35XHP08BHA7\",\"current_status\":\"$undefined\",\"status\":\"operational\"}],\"id\":\"01K6NHXACD7WE6JZWKNZ02P5BA\",\"message\":{\"feature_set\":\"$undefined\",\"markdown\":\"All impacted services have now fully recovered.\",\"schema_version\":\"$undefined\",\"text_node\":{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":\"$undefined\",\"text\":\"All impacted services have now fully recovered.\",\"type\":\"text\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"paragraph\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"doc\"}},\"message_string\":\"All impacted services have now fully recovered.\",\"published_at\":\"2025-10-03T17:28:57.51Z\",\"to_status\":\"resolved\"}],\"write_up_contents\":{\"feature_set\":\"$undefined\",\"markdown\":\"$undefined\",\"schema_version\":\"$undefined\",\"text_node\":{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":{\"level\":3},\"content\":[{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":\"$undefined\",\"text\":\"Summary\",\"type\":\"text\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"heading\"},{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":\"$undefined\",\"text\":\"Between 11:47 AM and 18:19 PM PDT on October 2, 2025, a permissions misconfiguration during an internal data backfill caused all Enterprise and Edu workspaces to inherit overly restrictive permissions. As a result, features including Codex, Search, Agent Mode, Deep Research, and GPT Custom Actions became unavailable for some users.\",\"type\":\"text\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"paragraph\"},{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":\"$undefined\",\"text\":\"Users in these workspaces experienced loss of functionality for the affected features. This interruption lasted over two hours for most users, with gradual recovery thereafter as caches were cleared and role settings corrected. \",\"type\":\"text\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"paragraph\"},{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":\"$undefined\",\"text\":\"We’ve taken steps to prevent incidents like this from recurring, including stronger controls in our backfill processes and improved observability and reliability in our RBAC system.\",\"type\":\"text\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"paragraph\"},{\"attrs\":{\"level\":3},\"content\":[{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":\"$undefined\",\"text\":\"Impact\",\"type\":\"text\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"heading\"},{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":\"$undefined\",\"text\":\"Between \",\"type\":\"text\"},{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":[{\"attrs\":\"$undefined\",\"type\":\"bold\"}],\"text\":\"11:47 AM and 14:07 PM PDT\",\"type\":\"text\"},{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":\"$undefined\",\"text\":\" on October 2, users in impacted workspaces lost access to the following features: \",\"type\":\"text\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"paragraph\"},{\"attrs\":{\"start\":1,\"type\":\"bullet\"},\"content\":[{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":[{\"attrs\":\"$undefined\",\"type\":\"bold\"}],\"text\":\"Codex\",\"type\":\"text\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"paragraph\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"listItem\"},{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":[{\"attrs\":\"$undefined\",\"type\":\"bold\"}],\"text\":\"Search\",\"type\":\"text\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"paragraph\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"listItem\"},{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":[{\"attrs\":\"$undefined\",\"type\":\"bold\"}],\"text\":\"Agent Mode\",\"type\":\"text\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"paragraph\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"listItem\"},{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":[{\"attrs\":\"$undefined\",\"type\":\"bold\"}],\"text\":\"Deep Research\",\"type\":\"text\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"paragraph\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"listItem\"},{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":[{\"attrs\":\"$undefined\",\"type\":\"bold\"}],\"text\":\"GPT Custom Actions\",\"type\":\"text\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"paragraph\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"listItem\"},{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":[{\"attrs\":\"$undefined\",\"type\":\"bold\"}],\"text\":\"MCP Connectors \",\"type\":\"text\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"paragraph\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"listItem\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"list\"},{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":\"$undefined\",\"text\":\"This issue also caused the ChatGPT Record option to be temporarily available for some workspaces where it was originally disabled.\",\"type\":\"text\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"paragraph\"},{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":\"$undefined\",\"text\":\"A configuration change to fix the issue was deployed within the first hour; however, residual problems persisted due to cache propagation delays. Full functionality was restored by 18:19 PM PDT on October 2. \",\"type\":\"text\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"paragraph\"},{\"attrs\":{\"level\":3},\"content\":[{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":\"$undefined\",\"text\":\"Root Cause\",\"type\":\"text\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"heading\"},{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":\"$undefined\",\"text\":\"The issue stemmed from a system-wide permissions update that unintentionally included a highly restrictive role. This role was applied across all affected workspaces and took precedence over existing permissions, resulting in users being unable to access some features.\",\"type\":\"text\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"paragraph\"},{\"attrs\":{\"level\":3},\"content\":[{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":\"$undefined\",\"text\":\"Mitigation\",\"type\":\"text\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"heading\"},{\"attrs\":{\"start\":1,\"type\":\"bullet\"},\"content\":[{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":[{\"attrs\":\"$undefined\",\"type\":\"bold\"}],\"text\":\"Time incident began:\",\"type\":\"text\"},{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":\"$undefined\",\"text\":\" Thursday, October 2, 2025 at 11:47 AM PDT\",\"type\":\"text\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"paragraph\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"listItem\"},{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":[{\"attrs\":\"$undefined\",\"type\":\"bold\"}],\"text\":\"Time detected:\",\"type\":\"text\"},{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":\"$undefined\",\"text\":\" 12:28 PM PDT\",\"type\":\"text\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"paragraph\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"listItem\"},{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":[{\"attrs\":\"$undefined\",\"type\":\"bold\"}],\"text\":\"Mitigation deployed:\",\"type\":\"text\"},{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":\"$undefined\",\"text\":\" 14:11 PM PDT\",\"type\":\"text\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"paragraph\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"listItem\"},{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":[{\"attrs\":\"$undefined\",\"type\":\"bold\"}],\"text\":\"Incident fully mitigated:\",\"type\":\"text\"},{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":\"$undefined\",\"text\":\" 18:19 PM PDT\",\"type\":\"text\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"paragraph\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"listItem\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"list\"},{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":\"$undefined\",\"text\":\"Detection was based on internal reports and alerts about errors across multiple services. We deployed a mitigation configuration change to apply the appropriate role restrictions and executed a manual script to clear cache invalidations across all workspace clusters.\",\"type\":\"text\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"paragraph\"},{\"attrs\":{\"level\":3},\"content\":[{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":\"$undefined\",\"text\":\"Prevention\",\"type\":\"text\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"heading\"},{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":\"$undefined\",\"text\":\"We are implementing the following measures to help prevent recurrence:\",\"type\":\"text\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"paragraph\"},{\"attrs\":{\"start\":1,\"type\":\"bullet\"},\"content\":[{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":\"$undefined\",\"text\":\"Enhanced backfill rollout and rollback mechanisms including a \",\"type\":\"text\"},{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":[{\"attrs\":\"$undefined\",\"type\":\"bold\"}],\"text\":\"multi-phase backfill rollout\",\"type\":\"text\"},{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":\"$undefined\",\"text\":\".\",\"type\":\"text\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"paragraph\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"listItem\"},{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":\"$undefined\",\"text\":\"Improve \",\"type\":\"text\"},{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":[{\"attrs\":\"$undefined\",\"type\":\"bold\"}],\"text\":\"internal metrics and alerts\",\"type\":\"text\"},{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":\"$undefined\",\"text\":\" for permission anomalies.\",\"type\":\"text\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"paragraph\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"listItem\"},{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":\"$undefined\",\"text\":\"Strengthen \",\"type\":\"text\"},{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":[{\"attrs\":\"$undefined\",\"type\":\"bold\"}],\"text\":\"defensive gating\",\"type\":\"text\"},{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":\"$undefined\",\"text\":\" for Role-Based Access Controls (RBAC) using feature flags and hardening reliability and scalability of RBAC.\",\"type\":\"text\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"paragraph\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"listItem\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"list\"},{\"attrs\":\"$undefined\",\"content\":[{\"attrs\":\"$undefined\",\"content\":\"$undefined\",\"marks\":\"$undefined\",\"text\":\"We sincerely apologize for the disruption this incident caused, especially given the critical importance of uninterrupted access for our Enterprise and Edu customers. Our teams are implementing stronger controls and a more robust rollout process to help prevent similar issues in the future. Thank you for your patience and continued trust as we work to improve.\",\"type\":\"text\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"paragraph\"}],\"marks\":\"$undefined\",\"text\":\"$undefined\",\"type\":\"doc\"}},\"write_up_url\":\"$undefined\"}}]\n"])</script><div hidden id="S:2"><div class="rounded-lg p-px shadow-sm dark:shadow-none ContentBox-module-scss-module__Pj3ila__default"><div class="relative rounded-[7px] bg-white dark:bg-global"><div class="ContentBox-module-scss-module__Pj3ila__header rounded-t-[7px] text-base font-medium px-4 py-3.5"><div class="flex flex-col text-slate-900 dark:text-slate-200 py-0.5"><div class="uppercase font-medium text-slate-400 dark:text-slate-500 text-[11px] tracking-widest">Write-up</div><div class="text-lg leading-6">Codex, Connectors, Search, Agent, Deep Research, Custom GPTs, Project Sharing, ChatGPT Record, Memory and other features related to RBAC are missing, unavailable, or unexpectedly enabled even when toggled off for Enterprise and Edu workspaces</div></div></div><div class="text-slate-900 dark:text-slate-100 p-4"><div class="group text-sm mb-4 w-auto rounded-lg bg-default border border-transparent hover:bg-slate-100 dark:hover:bg-slate-800/60 transition"><a class="flex items-center justify-between p-3.5 w-full cursor-pointer touch-manipulation" href="/incidents/01K6KAAN7WXN69E8JET8PYB0D5"><div class="text-slate-500 flex grow">Partial outage<div></div></div><span class="flex items-center space-x-1 text-slate-500 group-hover:text-slate-700 dark:group-hover:text-slate-300 transition"><span>View the incident</span><svg width="19" height="18" viewBox="0 0 19 18" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-slate-400 dark:text-slate-500 group-hover:text-slate-500 dark:group-hover:text-slate-300 transition"><path d="M10.8125 5.0625L14.9375 9L10.8125 12.9375" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M14.75 9H4.0625" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></span></a></div><div class="break-words text-sm"><div><div class="font-semibold py-2"><span class="">Summary</span></div><p class="mb-[10px] last:mb-0 whitespace-pre-line"><span class="">Between 11:47 AM and 18:19 PM PDT on October 2, 2025, a permissions misconfiguration during an internal data backfill caused all Enterprise and Edu workspaces to inherit overly restrictive permissions. As a result, features including Codex, Search, Agent Mode, Deep Research, and GPT Custom Actions became unavailable for some users.</span></p><p class="mb-[10px] last:mb-0 whitespace-pre-line"><span class="">Users in these workspaces experienced loss of functionality for the affected features. This interruption lasted over two hours for most users, with gradual recovery thereafter as caches were cleared and role settings corrected. </span></p><p class="mb-[10px] last:mb-0 whitespace-pre-line"><span class="">We’ve taken steps to prevent incidents like this from recurring, including stronger controls in our backfill processes and improved observability and reliability in our RBAC system.</span></p><div class="font-semibold py-2"><span class="">Impact</span></div><p class="mb-[10px] last:mb-0 whitespace-pre-line"><span class="">Between </span><span class="font-semibold">11:47 AM and 14:07 PM PDT</span><span class=""> on October 2, users in impacted workspaces lost access to the following features: </span></p><ul class="list-disc"><li class="mb-2 ml-4"><p class="mb-[10px] last:mb-0 whitespace-pre-line"><span class="font-semibold">Codex</span></p></li><li class="mb-2 ml-4"><p class="mb-[10px] last:mb-0 whitespace-pre-line"><span class="font-semibold">Search</span></p></li><li class="mb-2 ml-4"><p class="mb-[10px] last:mb-0 whitespace-pre-line"><span class="font-semibold">Agent Mode</span></p></li><li class="mb-2 ml-4"><p class="mb-[10px] last:mb-0 whitespace-pre-line"><span class="font-semibold">Deep Research</span></p></li><li class="mb-2 ml-4"><p class="mb-[10px] last:mb-0 whitespace-pre-line"><span class="font-semibold">GPT Custom Actions</span></p></li><li class="mb-2 ml-4"><p class="mb-[10px] last:mb-0 whitespace-pre-line"><span class="font-semibold">MCP Connectors </span></p></li></ul><p class="mb-[10px] last:mb-0 whitespace-pre-line"><span class="">This issue also caused the ChatGPT Record option to be temporarily available for some workspaces where it was originally disabled.</span></p><p class="mb-[10px] last:mb-0 whitespace-pre-line"><span class="">A configuration change to fix the issue was deployed within the first hour; however, residual problems persisted due to cache propagation delays. Full functionality was restored by 18:19 PM PDT on October 2. </span></p><div class="font-semibold py-2"><span class="">Root Cause</span></div><p class="mb-[10px] last:mb-0 whitespace-pre-line"><span class="">The issue stemmed from a system-wide permissions update that unintentionally included a highly restrictive role. This role was applied across all affected workspaces and took precedence over existing permissions, resulting in users being unable to access some features.</span></p><div class="font-semibold py-2"><span class="">Mitigation</span></div><ul class="list-disc"><li class="mb-2 ml-4"><p class="mb-[10px] last:mb-0 whitespace-pre-line"><span class="font-semibold">Time incident began:</span><span class=""> Thursday, October 2, 2025 at 11:47 AM PDT</span></p></li><li class="mb-2 ml-4"><p class="mb-[10px] last:mb-0 whitespace-pre-line"><span class="font-semibold">Time detected:</span><span class=""> 12:28 PM PDT</span></p></li><li class="mb-2 ml-4"><p class="mb-[10px] last:mb-0 whitespace-pre-line"><span class="font-semibold">Mitigation deployed:</span><span class=""> 14:11 PM PDT</span></p></li><li class="mb-2 ml-4"><p class="mb-[10px] last:mb-0 whitespace-pre-line"><span class="font-semibold">Incident fully mitigated:</span><span class=""> 18:19 PM PDT</span></p></li></ul><p class="mb-[10px] last:mb-0 whitespace-pre-line"><span class="">Detection was based on internal reports and alerts about errors across multiple services. We deployed a mitigation configuration change to apply the appropriate role restrictions and executed a manual script to clear cache invalidations across all workspace clusters.</span></p><div class="font-semibold py-2"><span class="">Prevention</span></div><p class="mb-[10px] last:mb-0 whitespace-pre-line"><span class="">We are implementing the following measures to help prevent recurrence:</span></p><ul class="list-disc"><li class="mb-2 ml-4"><p class="mb-[10px] last:mb-0 whitespace-pre-line"><span class="">Enhanced backfill rollout and rollback mechanisms including a </span><span class="font-semibold">multi-phase backfill rollout</span><span class="">.</span></p></li><li class="mb-2 ml-4"><p class="mb-[10px] last:mb-0 whitespace-pre-line"><span class="">Improve </span><span class="font-semibold">internal metrics and alerts</span><span class=""> for permission anomalies.</span></p></li><li class="mb-2 ml-4"><p class="mb-[10px] last:mb-0 whitespace-pre-line"><span class="">Strengthen </span><span class="font-semibold">defensive gating</span><span class=""> for Role-Based Access Controls (RBAC) using feature flags and hardening reliability and scalability of RBAC.</span></p></li></ul><p class="mb-[10px] last:mb-0 whitespace-pre-line"><span class="">We sincerely apologize for the disruption this incident caused, especially given the critical importance of uninterrupted access for our Enterprise and Edu customers. Our teams are implementing stronger controls and a more robust rollout process to help prevent similar issues in the future. Thank you for your patience and continued trust as we work to improve.</span></p></div></div></div></div></div></div><script>$RS=function(a,b){a=document.getElementById(a);b=document.getElementById(b);for(a.parentNode.removeChild(a);a.firstChild;)b.parentNode.insertBefore(a.firstChild,b);b.parentNode.removeChild(b)};$RS("S:2","P:2")</script><script>$RB=[];$RV=function(a){$RT=performance.now();for(var b=0;b<a.length;b+=2){var c=a[b],e=a[b+1];null!==e.parentNod