<td id="S4.T2.st2.2.1.14.4" class="ltx_td ltx_align_center" style="padding-left:7.0pt;padding-right:7.0pt;"><span id="S4.T2.st2.2.1.14.4.1" class="ltx_text" style="--ltx-bg-color:#E6F5FF;">16.33</span></td>
<td id="S4.T2.st2.2.1.14.5" class="ltx_td ltx_align_center" style="padding-left:7.0pt;padding-right:7.0pt;"><span id="S4.T2.st2.2.1.14.5.1" class="ltx_text" style="--ltx-bg-color:#E6F5FF;">4.97</span></td>
<td id="S4.T2.st2.2.1.14.6" class="ltx_td ltx_align_center" style="padding-left:7.0pt;padding-right:7.0pt;"><span id="S4.T2.st2.2.1.14.6.1" class="ltx_text" style="--ltx-bg-color:#E6F5FF;">1.28</span></td></tr>
<tr id="S4.T2.st2.2.1.15" class="ltx_tr" style="--ltx-bg-color:#E6F5FF;">
<th id="S4.T2.st2.2.1.15.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding-left:7.0pt;padding-right:7.0pt;"><span id="S4.T2.st2.2.1.15.1.1" class="ltx_text ltx_font_smallcaps" style="--ltx-bg-color:#E6F5FF;">Acon<span id="S4.T2.st2.2.1.15.1.1.1" class="ltx_text ltx_font_upright"> <span id="S4.T2.st2.2.1.15.1.1.1.1" class="ltx_text" style="--ltx-fg-color:#D2691E;"> <math id="S4.T2.st2.m10" class="ltx_Math" alttext="\overline{\underline{\textsc{ut}}}" display="inline" intent=":literal"><semantics><munderover accent="true" accentunder="true"><mtext style="--ltx-fg-color:#D2691E;--ltx-bg-color:#E6F5FF;" class="ltx_font_smallcaps" mathbackground="#E6F5FF" mathcolor="#D2691E">ut</mtext><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#E6F5FF;" mathbackground="#E6F5FF" mathcolor="#000000" stretchy="true">¯</mo><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#E6F5FF;" mathbackground="#E6F5FF" mathcolor="#000000" stretchy="true">¯</mo></munderover><annotation encoding="application/x-tex">\overline{\underline{\textsc{ut}}}</annotation></semantics></math></span> <span id="S4.T2.st2.2.1.15.1.1.1.2" class="ltx_text" style="--ltx-fg-color:#4B0082;"> <math id="S4.T2.st2.m11" class="ltx_Math" alttext="\overline{\underline{\textsc{co}}}" display="inline" intent=":literal"><semantics><munderover accent="true" accentunder="true"><mtext style="--ltx-fg-color:#4B0082;--ltx-bg-color:#E6F5FF;" class="ltx_font_smallcaps" mathbackground="#E6F5FF" mathcolor="#4B0082">co</mtext><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#E6F5FF;" mathbackground="#E6F5FF" mathcolor="#000000" stretchy="true">¯</mo><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#E6F5FF;" mathbackground="#E6F5FF" mathcolor="#000000" stretchy="true">¯</mo></munderover><annotation encoding="application/x-tex">\overline{\underline{\textsc{co}}}</annotation></semantics></math></span></span></span></th>
<td id="S4.T2.st2.2.1.15.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:7.0pt;padding-right:7.0pt;"><span id="S4.T2.st2.2.1.15.2.1" class="ltx_text" style="--ltx-bg-color:#E6F5FF;">0.336</span></td>
<td id="S4.T2.st2.2.1.15.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:7.0pt;padding-right:7.0pt;"><span id="S4.T2.st2.2.1.15.3.1" class="ltx_text" style="--ltx-bg-color:#E6F5FF;">0.461</span></td>
<td id="S4.T2.st2.2.1.15.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:7.0pt;padding-right:7.0pt;"><span id="S4.T2.st2.2.1.15.4.1" class="ltx_text" style="--ltx-bg-color:#E6F5FF;">14.00</span></td>
<td id="S4.T2.st2.2.1.15.5" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:7.0pt;padding-right:7.0pt;"><span id="S4.T2.st2.2.1.15.5.1" class="ltx_text" style="--ltx-bg-color:#E6F5FF;">4.22</span></td>
<td id="S4.T2.st2.2.1.15.6" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:7.0pt;padding-right:7.0pt;"><span id="S4.T2.st2.2.1.15.6.1" class="ltx_text" style="--ltx-bg-color:#E6F5FF;">0.81</span></td></tr>
</tbody>
