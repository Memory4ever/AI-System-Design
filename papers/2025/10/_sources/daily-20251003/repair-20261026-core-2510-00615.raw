<div id="lstnumberx12" class="ltx_listingline">1.<span id="lstnumberx12.1" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx12.2" class="ltx_text ltx_lst_identifier">Determine</span><span id="lstnumberx12.3" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx12.4" class="ltx_text ltx_lst_identifier">whether</span><span id="lstnumberx12.5" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx12.6" class="ltx_text ltx_lst_identifier">summarization</span><span id="lstnumberx12.7" class="ltx_text ltx_lst_space"> </span>/<span id="lstnumberx12.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx12.9" class="ltx_text ltx_lst_identifier">session</span><span id="lstnumberx12.10" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx12.11" class="ltx_text ltx_lst_identifier">resetting</span><span id="lstnumberx12.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx12.13" class="ltx_text ltx_lst_identifier">removed</span>,<span id="lstnumberx12.14" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx12.15" class="ltx_text ltx_lst_identifier">distorted</span>,<span id="lstnumberx12.16" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx12.17" class="ltx_text ltx_lst_identifier">delayed</span>,<span id="lstnumberx12.18" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx12.19" class="ltx_text ltx_lst_identifier">or</span><span id="lstnumberx12.20" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx12.21" class="ltx_text ltx_lst_identifier">bloated</span><span id="lstnumberx12.22" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx12.23" class="ltx_text ltx_lst_identifier">reasoning</span><span id="lstnumberx12.24" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx12.25" class="ltx_text ltx_lst_identifier">causing</span><span id="lstnumberx12.26" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx12.27" class="ltx_text ltx_lst_identifier">failure</span><span id="lstnumberx12