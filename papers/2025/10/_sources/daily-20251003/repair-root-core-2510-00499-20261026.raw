<th id="S4.T4.2.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">WER <math id="S4.T4.m4" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></th>
<th id="S4.T4.2.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">SIM <math id="S4.T4.m5" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></th>
<th id="S4.T4.2.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">DNSMOS <math id="S4.T4.m6" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T4.2.3" class="ltx_tr">
