<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Prompt for Supervised Fine-tuning Text Adaptation</h2>

<div id="A1.p1" class="ltx_para ltx_noindent">
<div id="A1.p1.1" class="ltx_listing ltx_lstlisting ltx_framed ltx_framed_rectangle ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></div>
<div id="lstnumberx1" class="ltx_listingline"><span id="lstnumberx1.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">You</span><span id="lstnumberx1.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">are</span><span id="lstnumberx1.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">converting</span><span id="lstnumberx1.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">a</span><span id="lstnumberx1.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">supervised</span><span id="lstnumberx1.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">fine</span><span id="lstnumberx1.12" class="ltx_text ltx_font_typewriter">-</span><span id="lstnumberx1.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">tuning</span><span id="lstnumberx1.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">dataset</span><span id="lstnumberx1.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.17" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx1.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Q</span><span id="lstnumberx1.19" class="ltx_text ltx_font_typewriter">&amp;</span><span id="lstnumberx1.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter">A</span><span id="lstnumberx1.21" class="ltx_text ltx_font_typewriter">)</span><span id="lstnumberx1.22" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter">into</span><span id="lstnumberx1.24" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter">a</span><span id="lstnumberx1.26" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.27" class="ltx_text ltx_lst_identifier ltx_font_typewriter">format</span><span id="lstnumberx1.28" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.29" class="ltx_text ltx_lst_identifier ltx_font_typewriter">that</span><span id="lstnumberx1.30" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.31" class="ltx_text ltx_lst_identifier ltx_font_typewriter">can</span><span id="lstnumberx1.32" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.33" class="ltx_text ltx_lst_identifier ltx_font_typewriter">be</span><span id="lstnumberx1.34" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.35" class="ltx_text ltx_lst_identifier ltx_font_typewriter">read</span><span id="lstnumberx1.36" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.37" class="ltx_text ltx_lst_identifier ltx_font_typewriter">naturally</span><span id="lstnumberx1.38" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.39" class="ltx_text ltx_lst_identifier ltx_font_typewriter">by</span><span id="lstnumberx1.40" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.41" class="ltx_text ltx_lst_identifier ltx_font_typewriter">a</span><span id="lstnumberx1.42" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.43" class="ltx_text ltx_lst_identifier ltx_font_typewriter">TTS</span><span id="lstnumberx1.44" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.45" class="ltx_text ltx_lst_identifier ltx_font_typewriter">system</span><span id="lstnumberx1.46" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.47" class="ltx_text ltx_lst_identifier ltx_font_typewriter">for</span><span id="lstnumberx1.48" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.49" class="ltx_text ltx_lst_identifier ltx_font_typewriter">a</span><span id="lstnumberx1.50" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.51" class="ltx_text ltx_lst_identifier ltx_font_typewriter">speech</span><span id="lstnumberx1.52" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.53" class="ltx_text ltx_lst_identifier ltx_font_typewriter">language</span><span id="lstnumberx1.54" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.55" class="ltx_text ltx_lst_identifier ltx_font_typewriter">model</span><span id="lstnumberx1.56" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx1.57" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.58" class="ltx_text ltx_lst_identifier ltx_font_typewriter">For</span><span id="lstnumberx1.59" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.60" class="ltx_text ltx_lst_identifier ltx_font_typewriter">each</span><span id="lstnumberx1.61" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.62" class="ltx_text ltx_lst_identifier ltx_font_typewriter">question</span><span id="lstnumberx1.63" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.64" class="ltx_text ltx_lst_identifier ltx_font_typewriter">and</span><span id="lstnumberx1.65" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.66" class="ltx_text ltx_lst_identifier ltx_font_typewriter">answer</span><span id="lstnumberx1.67" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.68" class="ltx_text ltx_lst_identifier ltx_font_typewriter">pair</span><span id="lstnumberx1.69" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx1.70" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.71" class="ltx_text ltx_lst_identifier ltx_font_typewriter">you</span><span id="lstnumberx1.72" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.73" class="ltx_text ltx_lst_identifier ltx_font_typewriter">must</span><span id="lstnumberx1.74" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.75" class="ltx_text ltx_lst_identifier ltx_font_typewriter">determine</span><span id="lstnumberx1.76" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.77" class="ltx_text ltx_lst_identifier ltx_font_typewriter">whether</span><span id="lstnumberx1.78" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.79" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx1.80" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.81" class="ltx_text ltx_lst_identifier ltx_font_typewriter">text</span><span id="lstnumberx1.82" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.83" class="ltx_text ltx_lst_identifier ltx_font_typewriter">is</span><span id="lstnumberx1.84" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.85" class="ltx_text ltx_lst_identifier ltx_font_typewriter">suitable</span><span id="lstnumberx1.86" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.87" class="ltx_text ltx_lst_identifier ltx_font_typewriter">for</span><span id="lstnumberx1.88" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.89" class="ltx_text ltx_lst_identifier ltx_font_typewriter">TTS</span><span id="lstnumberx1.90" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.91" class="ltx_text ltx_lst_identifier ltx_font_typewriter">according</span><span id="lstnumberx1.92" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.93" class="ltx_text ltx_lst_identifier ltx_font_typewriter">to</span><span id="lstnumberx1.94" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.95" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx1.96" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.97" class="ltx_text ltx_lst_identifier ltx_font_typewriter">following</span><span id="lstnumberx1.98" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.99" class="ltx_text ltx_lst_identifier ltx_font_typewriter">rules</span><span id="lstnumberx1.100" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx1.101" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.102" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Possible</span><span id="lstnumberx1.103" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.104" class="ltx_text ltx_lst_identifier ltx_font_typewriter">states</span><span id="lstnumberx1.105" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.106" class="ltx_text ltx_lst_identifier ltx_font_typewriter">are</span><span id="lstnumberx1.107" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx1.108" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.109" class="ltx_text ltx_lst_identifier ltx_font_typewriter">require</span><span id="lstnumberx1.110" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.111" class="ltx_text ltx_lst_identifier ltx_font_typewriter">no</span><span id="lstnumberx1.112" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.113" class="ltx_text ltx_lst_identifier ltx_font_typewriter">changes</span><span id="lstnumberx1.114" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.115" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx1.116" class="ltx_text ltx_lst_identifier ltx_font_typewriter">PASSTHROUGH</span><span id="lstnumberx1.117" class="ltx_text ltx_font_typewriter">),</span><span id="lstnumberx1.118" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.119" class="ltx_text ltx_lst_identifier ltx_font_typewriter">requires</span><span id="lstnumberx1.120" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.121" class="ltx_text ltx_lst_identifier ltx_font_typewriter">adaptation</span><span id="lstnumberx1.122" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.123" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx1.124" class="ltx_text ltx_lst_identifier ltx_font_typewriter">ADAPT</span><span id="lstnumberx1.125" class="ltx_text ltx_font_typewriter">),</span><span id="lstnumberx1.126" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.127" class="ltx_text ltx_lst_identifier ltx_font_typewriter">or</span><span id="lstnumberx1.128" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.129" class="ltx_text ltx_lst_identifier ltx_font_typewriter">unsuitable</span><span id="lstnumberx1.130" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.131" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx1.132" class="ltx_text ltx_lst_identifier ltx_font_typewriter">REJECT</span><span id="lstnumberx1.133" class="ltx_text ltx_font_typewriter">).</span>
</div>
