pan><span id="lstnumberx94.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter">social</span><span id="lstnumberx94.24" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter">structures</span><span id="lstnumberx94.26" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.27" class="ltx_text ltx_lst_identifier ltx_font_typewriter">or</span><span id="lstnumberx94.28" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.29" class="ltx_text ltx_lst_identifier ltx_font_typewriter">specialized</span><span id="lstnumberx94.30" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.31" class="ltx_text ltx_lst_identifier ltx_font_typewriter">physical</span><span id="lstnumberx94.32" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.33" class="ltx_text ltx_lst_identifier ltx_font_typewriter">traits</span><span id="lstnumberx94.34" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.35" class="ltx_text ltx_lst_identifier ltx_font_typewriter">to</span><span id="lstnumberx94.36" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.37" class="ltx_text ltx_lst_identifier ltx_font_typewriter">ensure</span><span id="lstnumberx94.38" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.39" class="ltx_text ltx_lst_identifier ltx_font_typewriter">their</span><span id="lstnumberx94.40" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.41" class="ltx_text ltx_lst_identifier ltx_font_typewriter">survival</span><span id="lstnumberx94.42" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.43" class="ltx_text ltx_lst_identifier ltx_font_typewriter">and</span><span id="lstnumberx94.44" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.45" class="ltx_text ltx_lst_identifier ltx_font_typewriter">reproduction</span><span id="lstnumberx94.46" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx94.47" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.48" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Some</span><span id="lstnumberx94.49" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.50" class="ltx_text ltx_lst_identifier ltx_font_typewriter">species</span><span id="lstnumberx94.51" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.52" class="ltx_text ltx_lst_identifier ltx_font_typewriter">can</span><span id="lstnumberx94.53" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.54" class="ltx_text ltx_lst_identifier ltx_font_typewriter">even</span><span id="lstnumberx94.55" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.56" class="ltx_text ltx_lst_identifier ltx_font_typewriter">assist</span><span id="lstnumberx94.57" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.58" class="ltx_text ltx_lst_identifier ltx_font_typewriter">humans</span><span id="lstnumberx94.59" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.60" class="ltx_text ltx_lst_identifier ltx_font_typewriter">in</span><span id="lstnumberx94.61" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.62" class="ltx_text ltx_lst_identifier ltx_font_typewriter">locating</span><span id="lstnumberx94.63" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.64" class="ltx_text ltx_lst_identifier ltx_font_typewriter">resources</span><span id="lstnumberx94.65" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx94.66" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.67" class="ltx_text ltx_lst_identifier ltx_font_typewriter">In</span><span id="lstnumberx94.68" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.69" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx94.70" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.71" class="ltx_text ltx_lst_identifier ltx_font_typewriter">tropical</span><span id="lstnumberx94.72" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.73" class="ltx_text ltx_lst_identifier ltx_font_typewriter">regions</span><span id="lstnumberx94.74" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.75" class="ltx_text ltx_lst_identifier ltx_font_typewriter">of</span><span id="lstnumberx94.76" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.77" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx94.78" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.79" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Pacific</span><span id="lstnumberx94.80" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx94.81" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.82" class="ltx_text ltx_lst_identifier ltx_font_typewriter">certain</span><span id="lstnumberx94.83" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.84" class="ltx_text ltx_lst_identifier ltx_font_typewriter">species</span><span id="lstnumberx94.85" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.86" class="ltx_text ltx_lst_identifier ltx_font_typewriter">live</span><span id="lstnumberx94.87" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.88" class="ltx_text ltx_lst_identifier ltx_font_typewriter">on</span><span id="lstnumberx94.89" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.90" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx94.91" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.92" class="ltx_text ltx_lst_identifier ltx_font_typewriter">water</span><span id="lstnumberx94.93" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.94" class="ltx_text ltx_lst_identifier ltx_font_typewriter">surface</span><span id="lstnumberx94.95" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx94.96" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.97" class="ltx_text ltx_lst_identifier ltx_font_typewriter">while</span><span id="lstnumberx94.98" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.99" class="ltx_text ltx_lst_identifier ltx_font_typewriter">others</span><span id="lstnumberx94.100" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.101" class="ltx_text ltx_lst_identifier ltx_font_typewriter">inhabit</span><span id="lstnumberx94.102" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.103" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx94.104" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.105" class="ltx_text ltx_lst_identifier ltx_font_typewriter">seafloor</span><span id="lstnumberx94.106" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx94.107" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.108" class="ltx_text ltx_lst_identifier ltx_font_typewriter">There</span><span id="lstnumberx94.109" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.110" class="ltx_text ltx_lst_identifier ltx_font_typewriter">are</span><span id="lstnumberx94.111" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.112" class="ltx_text ltx_lst_identifier ltx_font_typewriter">also</span><span id="lstnumberx94.113" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.114" class="ltx_text ltx_lst_identifier ltx_font_typewriter">species</span><span id="lstnumberx94.115" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.116" class="ltx_text ltx_lst_identifier ltx_font_typewriter">whose</span><span id="lstnumberx94.117" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.118" class="ltx_text ltx_lst_identifier ltx_font_typewriter">range</span><span id="lstnumberx94.119" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.120" class="ltx_text ltx_lst_identifier ltx_font_typewriter">spans</span><span id="lstnumberx94.121" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.122" class="ltx_text ltx_lst_identifier ltx_font_typewriter">both</span><span id="lstnumberx94.123" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.124" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx94.125" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.126" class="ltx_text ltx_lst_identifier ltx_font_typewriter">surface</span><span id="lstnumberx94.127" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.128" class="ltx_text ltx_lst_identifier ltx_font_typewriter">and</span><span id="lstnumberx94.129" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.130" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx94.131" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.132" class="ltx_text ltx_lst_identifier ltx_font_typewriter">seafloor</span><span id="lstnumberx94.133" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx94.134" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.135" class="ltx_text ltx_lst_identifier ltx_font_typewriter">forming</span><span id="lstnumberx94.136" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.137" class="ltx_text ltx_lst_identifier ltx_font_typewriter">what</span><span id="lstnumberx94.138" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.139" class="ltx_text ltx_lst_identifier ltx_font_typewriter">is</span><span id="lstnumberx94.140" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.141" class="ltx_text ltx_lst_identifier ltx_font_typewriter">known</span><span id="lstnumberx94.142" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.143" class="ltx_text ltx_lst_identifier ltx_font_typewriter">as</span><span id="lstnumberx94.144" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.145" class="ltx_text ltx_lst_identifier ltx_font_typewriter">a</span><span id="lstnumberx94.146" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.147" class="ltx_text ltx_lst_identifier ltx_font_typewriter">three</span><span id="lstnumberx94.148" class="ltx_text ltx_font_typewriter">-</span><span id="lstnumberx94.149" class="ltx_text ltx_lst_identifier ltx_font_typewriter">dimensional</span><span id="lstnumberx94.150" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.151" class="ltx_text ltx_lst_identifier ltx_font_typewriter">ecosystem</span><span id="lstnumberx94.152" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx94.153" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.154" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Due</span><span id="lstnumberx94.155" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.156" class="ltx_text ltx_lst_identifier ltx_font_typewriter">to</span><span id="lstnumberx94.157" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.158" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx94.159" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.160" class="ltx_text ltx_lst_identifier ltx_font_typewriter">vast</span><span id="lstnumberx94.161" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.162" class="ltx_text ltx_lst_identifier ltx_font_typewriter">expanse</span><span id="lstnumberx94.163" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.164" class="ltx_text ltx_lst_identifier ltx_font_typewriter">of</span><span id="lstnumberx94.165" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.166" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx94.167" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.168" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Pacific</span><span id="lstnumberx94.169" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx94.170" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.171" class="ltx_text ltx_lst_identifier ltx_font_typewriter">these</span><span id="lstnumberx94.172" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.173" class="ltx_text ltx_lst_identifier ltx_font_typewriter">species</span><span id="lstnumberx94.174" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.175" class="ltx_text ltx_lst_identifier ltx_font_typewriter">must</span><span id="lstnumberx94.176" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.177" class="ltx_text ltx_lst_identifier ltx_font_typewriter">adapt</span><span id="lstnumberx94.178" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.179" class="ltx_text ltx_lst_identifier ltx_font_typewriter">to</span><span id="lstnumberx94.180" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx94.181" class="ltx_text ltx_lst_identifier ltx_font_typewriter">survive</span><span id="lstnumberx94.182" class="ltx_text ltx_font_typewriter">.</span>
</div>
</div>
</div>
</section>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Layer-wise Similarity Score.</h2>

<div id="A3.p1" class="ltx_para ltx_noindent">
<p id="A3.p1.1" class="ltx_p">To evaluate cross-modal alignment inside a Transformer backbone, we compute a similarity score at each layer <math id="A3.p1.m1" class="ltx_Math" alttext="i\in\{1,\dots,L\}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>L</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\{1,\dots,L\}</annotation></semantics></math>.
Let the text tokens be <math id="A3.p1.m2" class="ltx_Math" alttext="\{t_{1},\ldots,t_{n}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>t</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>t</mi><mi>n</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{t_{1},\ldots,t_{n}\}</annotation></semantics></math> and the speech tokens <math id="A3.p1.m3" class="ltx_Math" alttext="\{s_{1},\ldots,s_{m}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>s</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>s</mi><mi>m</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{s_{1},\ldots,s_{m}\}</annotation></semantics></math>.
Using forced alignment<cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib36" title="" class="ltx_ref">Pratap et al., 2023</a>)</cite>, we obtain <math id="A3.p1.m4" class="ltx_Math" alttext="J_{i}" display="inline" intent=":literal"><semantics><msub><mi>J</mi><mi>i</mi></msub><annotation encoding="application/x-tex">J_{i}</annotation></semantics></math> alignment pairs</p>
<table id="A3.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex1.m1" class="ltx_Math" alttext="\{(T_{i,1},S_{i,1}),\ (T_{i,2},S_{i,2}),\ \dots,\ (T_{i,J_{i}},S_{i,J_{i}})\}," display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><mrow><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mrow><mi>i</mi><mo>,</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>S</mi><mrow><mi>i</mi><mo>,</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo rspace="0.667em">,</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mrow><mi>i</mi><mo>,</mo><mn>2</mn></mrow></msub><mo>,</mo><msub><mi>S</mi><mrow><mi>i</mi><mo>,</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo rspace="0.667em">,</mo><mi mathvariant="normal">…</mi><mo rspace="0.667em">,</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mrow><mi>i</mi><mo>,</mo><msub><mi>J</mi><mi>i</mi></msub></mrow></msub><mo>,</mo><msub><mi>S</mi><mrow><mi>i</mi><mo>,</mo><msub><mi>J</mi><mi>i</mi></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\{(T_{i,1},S_{i,1}),\ (T_{i,2},S_{i,2}),\ \dots,\ (T_{i,J_{i}},S_{i,J_{i}})\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p1.2" class="ltx_p">where <math id="A3.p1.m5" class="ltx_Math" alttext="T_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">T_{i,j}</annotation></semantics></math> is the set of aligned text tokens and <math id="A3.p1.m6" class="ltx_Math" alttext="S_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">S_{i,j}</annotation></semantics></math> is the corresponding set of speech tokens (the alignment is fixed, but hidden states depend on the Transformer layer <math id="A3.p1.m7" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>).</p>
</div>
<div id="A3.p2" class="ltx_para ltx_noindent">
<p id="A3.p2.1" class="ltx_p">For each pair <math id="A3.p2.m1" class="ltx_Math" alttext="(i,j)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i,j)</annotation></semantics></math> we construct a cosine similarity matrix</p>
<table id="A3.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex2.m1" class="ltx_Math" alttext="M_{i,j}[u,v]=\cos\big(h_{i,t_{u}},\,h_{i,s_{v}}\big)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>M</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>u</mi><mo>,</mo><mi>v</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>h</mi><mrow><mi>i</mi><mo>,</mo><msub><mi>t</mi><mi>u</mi></msub></mrow></msub><mo>,</mo><msub><mi>h</mi><mrow><mi>i</mi><mo>,</mo><msub><mi>s</mi><mi>v</mi></msub></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">M_{i,j}[u,v]=\cos\big(h_{i,t_{u}},\,h_{i,s_{v}}\big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p2.2" class="ltx_p">where <math id="A3.p2.m2" class="ltx_Math" alttext="h_{i,t}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">h_{i,t}</annotation></semantics></math> and <math id="A3.p2.m3" class="ltx_Math" alttext="h_{i,s}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mrow><mi>i</mi><mo>,</mo><mi>s</mi></mrow></msub><annotation encoding="application/x-tex">h_{i,s}</annotation></semantics></math> denote hidden states of text token <math id="A3.p2.m4" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> and speech token <math id="A3.p2.m5" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> at layer <math id="A3.p2.m6" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.</p>
</div>
<div id="A3.p3" class="ltx_para ltx_noindent">
<p id="A3.p3.1" class="ltx_p">The DTW-based similarity is defined as</p>
<table id="A3.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex3.m1" class="ltx_Math" alttext="\mathrm{DTW}_{i,j}=\frac{1}{|P_{i,j}|}\sum_{(u,v)\in P_{i,j}}M_{i,j}[u,v]," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>DTW</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi>P</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">|</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi>P</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow></munder><mrow><msub><mi>M</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>u</mi><mo>,</mo><mi>v</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathrm{DTW}_{i,j}=\frac{1}{|P_{i,j}|}\sum_{(u,v)\in P_{i,j}}M_{i,j}[u,v],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p3.2" class="ltx_p">where <math id="A3.p3.m1" class="ltx_Math" alttext="P_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">P_{i,j}</annotation></semantics></math> is the optimal Dynamic Time Warping path through <math id="A3.p3.m2" class="ltx_Math" alttext="M_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">M_{i,j}</annotation></semantics></math>, i.e., the alignment trajectory maximizing similarity under temporal constraints.</p>
</div>
<div id="A3.p4" class="ltx_para ltx_noindent">
<p id="A3.p4.1" class="ltx_p">As a background normalization, we compute</p>
<table id="A3.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex4.m1" class="ltx_Math" alttext="\mathrm{BG}_{i,j}=\frac{1}{|S_{i,j}|\,(n-|T_{i,j}|)}\sum_{s\in S_{i,j}}\sum_{t\in\{t_{1},\ldots,t_{n}\}\setminus T_{i,j}}\cos\big(h_{i,t},\,h_{i,s}\big)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>BG</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mrow><mo stretchy="false">|</mo><msub><mi>S</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mrow><mo stretchy="false">|</mo><msub><mi>T</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>s</mi><mo>∈</mo><msub><mi>S</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow></munder><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mrow><mo stretchy="false">{</mo><msub><mi>t</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>t</mi><mi>n</mi></msub><mo stretchy="false">}</mo></mrow><mo>∖</mo><msub><mi>T</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow></mrow></munder><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>h</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mi>h</mi><mrow><mi>i</mi><mo>,</mo><mi>s</mi></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{BG}_{i,j}=\frac{1}{|S_{i,j}|\,(n-|T_{i,j}|)}\sum_{s\in S_{i,j}}\sum_{t\in\{t_{1},\ldots,t_{n}\}\setminus T_{i,j}}\cos\big(h_{i,t},\,h_{i,s}\big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.p5" class="ltx_para ltx_noindent">
<p id="A3.p5.1" class="ltx_p">Finally, the <span id="A3.p5.1.1" class="ltx_text ltx_font_bold">layer-wise similarity score</span> at layer <math id="A3.p5.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> is</p>
<table id="A3.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex5.m1" class="ltx_Math" alttext="\mathrm{SS}_{i}=\sum_{j=1}^{J_{i}}\left(\frac{\mathrm{DTW}_{i,j}}{\mathrm{BG}_{i,j}+\lambda}\right),\qquad\lambda=\frac{1}{\sum_{k=1}^{L}J_{k}}\sum_{k=1}^{L}\sum_{j=1}^{J_{k}}\mathrm{DTW}_{k,j}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>SS</mi><mi>i</mi></msub><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>J</mi><mi>i</mi></msub></munderover><mrow><mo>(</mo><mfrac><msub><mi>DTW</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mrow><msub><mi>BG</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>+</mo><mi>λ</mi></mrow></mfrac><mo>)</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>λ</mi><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></msubsup><msub><mi>J</mi><mi>k</mi></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></munderover><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>J</mi><mi>k</mi></msub></munderover><msub><mi>DTW</mi><mrow><mi>k</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{SS}_{i}=\sum_{j=1}^{J_{i}}\left(\frac{\mathrm{DTW}_{i,j}}{\mathrm{BG}_{i,j}+\lambda}\right),\qquad\lambda=\frac{1}{\sum_{k=1}^{L}J_{k}}\sum_{k=1}^{L}\sum_{j=1}^{J_{k}}\mathrm{DTW}_{k,j}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.p6" class="ltx_para ltx_noindent">
<p id="A3.p6.1" class="ltx_p">Here, <math id="A3.p6.m1" class="ltx_Math" alttext="\mathrm{DTW}_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>DTW</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\mathrm{DTW}_{i,j}</annotation></semantics></math> measures the mean similarity along the DTW-optimal path for pair <math id="A3.p6.m2" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> at layer <math id="A3.p6.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, <math id="A3.p6.m4" class="ltx_Math" alttext="\mathrm{BG}_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>BG</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\mathrm{BG}_{i,j}</annotation></semantics></math> normalizes against similarities with non-aligned text tokens, and <math id="A3.p6.m5" class="ltx_Math" alttext="\mathrm{SS}_{i}" display="inline" intent=":literal"><semantics><msub><mi>SS</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathrm{SS}_{i}</annotation></semantics></math> means Similarity Score of layer i quantifies the relative strength of text–speech alignment at Transformer layer <math id="A3.p6.m6" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, with <math id="A3.p6.m7" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> serving as a global coefficient averaged over all pairs and layers.</p>
</div>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Layer-wise Unfreeze Learning Rate Schedule</h2>

<div id="A4.p1" class="ltx_para ltx_noindent">
<p id="A4.p1.1" class="ltx_p">To implement gradual layer-wise unfreezing, we assign each transformer layer its own learning rate with a <em id="A4.p1.1.1" class="ltx_emph ltx_font_italic">delayed warmup–cosine</em> schedule. Let <math id="A4.p1.m1" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> denote the global training step, the model contain <math id="A4.p1.m2" class="ltx_Math" alttext="N=32" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><mn>32</mn></mrow><annotation encoding="application/x-tex">N=32</annotation></semantics></math> layers to be unfrozen indexed by <math id="A4.p1.m3" class="ltx_Math" alttext="i\in\{0,\dots,N-1\}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\{0,\dots,N-1\}</annotation></semantics></math> (with <math id="A4.p1.m4" class="ltx_Math" alttext="i=N-1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">i=N-1</annotation></semantics></math> denoting the final layer), and define:</p>
<table id="A4.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex6.m1" class="ltx_Math" alttext="d_{i}=(N-1-i)\,k,\quad D_{i}=T-d_{i}-w," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn><mo>−</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>k</mi></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>D</mi><mi>i</mi></msub><mo>=</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>d</mi><mi>i</mi></msub><mo>−</mo><mi>w</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">d_{i}=(N-1-i)\,k,\quad D_{i}=T-d_{i}-w,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p1.2" class="ltx_p">where <math id="A4.p1.m5" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is the per-layer delay (in steps), <math id="A4.p1.m6" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> the global step at which all layers have reached <math id="A4.p1.m7" class="ltx_Math" alttext="\eta_{\min}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi>min</mi></msub><annotation encoding="application/x-tex">\eta_{\min}</annotation></semantics></math>, <math id="A4.p1.m8" class="ltx_Math" alttext="\eta_{\max}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi>max</mi></msub><annotation encoding="application/x-tex">\eta_{\max}</annotation></semantics></math> the peak learning rate, and <math id="A4.p1.m9" class="ltx_Math" alttext="r=0.1" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mn>0.1</mn></mrow><annotation encoding="application/x-tex">r=0.1</annotation></semantics></math> the final decay ratio.</p>
</div>
<div id="A4.p2" class="ltx_para ltx_noindent">
<p id="A4.p2.1" class="ltx_p">For each layer <math id="A4.p2.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, we define <math id="A4.p2.m2" class="ltx_Math" alttext="u=s-d_{i}" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>=</mo><mrow><mi>s</mi><mo>−</mo><msub><mi>d</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">u=s-d_{i}</annotation></semantics></math> and set its learning rate as</p>
<table id="A4.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex7.m1" class="ltx_Math" alttext="\eta_{i}(s)=\begin{cases}0,&amp;u&lt;0,\\[6.0pt]
\eta_{\max}\,\dfrac{u}{w},&amp;0\leq u&lt;w,\\[12.0pt]
\eta_{\min}+\dfrac{\eta_{\max}-\eta_{\min}}{2}\left(1+\cos\!\left(\pi\,\dfrac{u-w}{D_{i}}\right)\right),&amp;w\leq u\leq w+D_{i},\\[12.0pt]
\eta_{\min},&amp;u&gt;w+D_{i}~.\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>η</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>0</mn><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>u</mi><mo>&lt;</mo><mn>0</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>η</mi><mi>max</mi></msub><mo lspace="0.170em" rspace="0em">​</mo><mfrac><mi>u</mi><mi>w</mi></mfrac></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>0</mn><mo>≤</mo><mi>u</mi><mo>&lt;</mo><mi>w</mi></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>η</mi><mi>min</mi></msub><mo>+</mo><mrow><mfrac><mrow><msub><mi>η</mi><mi>max</mi></msub><mo>−</mo><msub><mi>η</mi><mi>min</mi></msub></mrow><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mpadded style="width:1.216em;" width="1.216em"><mi>cos</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>π</mi><mo lspace="0.170em" rspace="0em">​</mo><mfrac><mrow><mi>u</mi><mo>−</mo><mi>w</mi></mrow><msub><mi>D</mi><mi>i</mi></msub></mfrac></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>w</mi><mo>≤</mo><mi>u</mi><mo>≤</mo><mrow><mi>w</mi><mo>+</mo><msub><mi>D</mi><mi>i</mi></msub></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>η</mi><mi>min</mi></msub><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>u</mi><mo>&gt;</mo><mrow><mi>w</mi><mo>+</mo><msub><mi>D</mi><mi>i</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\eta_{i}(s)=\begin{cases}0,&amp;u&lt;0,\\[6.0pt]
\eta_{\max}\,\dfrac{u}{w},&amp;0\leq u&lt;w,\\[12.0pt]
\eta_{\min}+\dfrac{\eta_{\max}-\eta_{\min}}{2}\left(1+\cos\!\left(\pi\,\dfrac{u-w}{D_{i}}\right)\right),&amp;w\leq u\leq w+D_{i},\\[12.0pt]
\eta_{\min},&amp;u&gt;w+D_{i}~.\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<section id="A4.SS0.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Variable definitions</h5>

<div id="A4.SS0.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<ul id="A4.I1" class="ltx_itemize">
<li id="A4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="A4.I1.i1.p1.1" class="ltx_p"><math id="A4.I1.i1.p1.m1" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>: global training step.</p>
</div></li>
<li id="A4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i2.p1" class="ltx_para ltx_noindent">
<p id="A4.I1.i2.p1.1" class="ltx_p"><math id="A4.I1.i2.p1.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>: layer index (<math id="A4.I1.i2.p1.m2" class="ltx_Math" alttext="N-1" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">N-1</annotation></semantics></math> = last layer).</p>
</div></li>
<li id="A4.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i3.p1" class="ltx_para ltx_noindent">
<p id="A4.I1.i3.p1.1" class="ltx_p"><math id="A4.I1.i3.p1.m1" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>: total number of layers (<math id="A4.I1.i3.p1.m2" class="ltx_Math" alttext="32" display="inline" intent=":literal"><semantics><mn>32</mn><annotation encoding="application/x-tex">32</annotation></semantics></math>).</p>
</div></li>
<li id="A4.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i4.p1" class="ltx_para ltx_noindent">
<p id="A4.I1.i4.p1.1" class="ltx_p"><math id="A4.I1.i4.p1.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>: per-layer delay (<math id="A4.I1.i4.p1.m2" class="ltx_Math" alttext="5000" display="inline" intent=":literal"><semantics><mn>5000</mn><annotation encoding="application/x-tex">5000</annotation></semantics></math> steps).</p>
</div></li>
<li id="A4.I1.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i5.p1" class="ltx_para ltx_noindent">
<p id="A4.I1.i5.p1.1" class="ltx_p"><math id="A4.I1.i5.p1.m1" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math>: warmup duration (<math id="A4.I1.i5.p1.m2" class="ltx_Math" alttext="2000" display="inline" intent=":literal"><semantics><mn>2000</mn><annotation encoding="application/x-tex">2000</annotation></semantics></math> steps).</p>
</div></li>
<li id="A4.I1.i6" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i6.p1" class="ltx_para ltx_noindent">
<p id="A4.I1.i6.p1.1" class="ltx_p"><math id="A4.I1.i6.p1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>: global step when all layers reach <math id="A4.I1.i6.p1.m2" class="ltx_Math" alttext="\eta_{\min}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi>min</mi></msub><annotation encoding="application/x-tex">\eta_{\min}</annotation></semantics></math>.</p>
</div></li>
<li id="A4.I1.i7" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i7.p1" class="ltx_para ltx_noindent">
<p id="A4.I1.i7.p1.1" class="ltx_p"><math id="A4.I1.i7.p1.m1" class="ltx_Math" alttext="\eta_{\max}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi>max</mi></msub><annotation encoding="application/x-tex">\eta_{\max}</annotation></semantics></math>: maximum learning rate.</p>
</div></li>
<li id="A4.I1.i8" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i8.p1" class="ltx_para ltx_noindent">
<p id="A4.I1.i8.p1.1" class="ltx_p"><math id="A4.I1.i8.p1.m1" class="ltx_Math" alttext="\eta_{\min}=0.1\,\eta_{\max}" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>min</mi></msub><mo>=</mo><mrow><mn>0.1</mn><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>η</mi><mi>max</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\eta_{\min}=0.1\,\eta_{\max}</annotation></semantics></math>: minimum learning rate.</p>
</div></li>
<li id="A4.I1.i9" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i9.p1" class="ltx_para ltx_noindent">
<p id="A4.I1.i9.p1.1" class="ltx_p"><math id="A4.I1.i9.p1.m1" class="ltx_Math" alttext="d_{i}=(N-1-i)\,k" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn><mo>−</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>k</mi></mrow></mrow><annotation encoding="application/x-tex">d_{i}=(N-1-i)\,k</annotation></semantics></math>: start delay for layer <math id="A4.I1.i9.p1.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.</p>
</div></li>
<li id="A4.I1.i10" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i10.p1" class="ltx_para">
<p id="A4.I1.i10.p1.1" class="ltx_p"><math id="A4.I1.i10.p1.m1" class="ltx_Math" alttext="D_{i}=T-d_{i}-w" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>i</mi></msub><mo>=</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>d</mi><mi>i</mi></msub><mo>−</mo><mi>w</mi></mrow></mrow><annotation encoding="application/x-tex">D_{i}=T-d_{i}-w</annotation></semantics></math>: cosine decay duration for layer <math id="A4.I1.i10.p1.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.</p>
</div></li>
</ul>
</div>
<div id="A4.SS0.SSS0.Px1.p2" class="ltx_para ltx_noindent">
<p id="A4.SS0.SSS0.Px1.p2.1" class="ltx_p">This schedule ensures that higher (later) layers are unfrozen earlier, while lower (earlier) layers remain frozen longer, enabling a controlled and stable adaptation of the pretrained text backbone.</p>
</div>
<div id="A4.SS0.SSS0.Px1.p3" class="ltx_para ltx_noindent">
<p id="A4.SS0.SSS0.Px1.p3.1" class="ltx_p"><cite class="ltx_cite"><a href="#bib.bib42" title="" class="ltx_ref">42</a></cite><cite class="ltx_cite"><a href="#bib.bib46" title="" class="ltx_ref">46</a></cite><cite class="ltx_cite"><a href="#bib.bib3" title="" class="ltx_ref">3</a></cite><cite class="ltx_cite"><a href="#bib.bib56" title="" class="ltx_ref">56</a></cite><cite class="ltx_cite"><a href="#bib.bib48" title="" class="ltx_ref">48</a></cite><cite class="ltx_cite"><a href="#bib.bib43" title="" class="ltx_ref">43</a></cite><cite class="ltx_cite"><a href="#bib.bib21" title="" class="ltx_ref">21</a></cite><cite class="ltx_cite"><a href="#bib.bib9" title="" class="ltx_ref">9</a></cite></p>
</div>
</section>
