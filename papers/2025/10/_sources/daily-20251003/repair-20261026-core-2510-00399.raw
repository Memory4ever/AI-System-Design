<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E186Xd.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E186Xd.m3" class="ltx_Math" alttext="\displaystyle\max_{j\in[l]}\left\{\sum_{i=1}^{l}G_{i,l+1}^{j}({\bm{w}}^{(t)})\right\}\cdot(1+(1-\sigma({{\bm{w}}^{(t)}}^{\top}\hat{{\bm{p}}}_{1}^{l}))+(1-\sigma({{\bm{w}}^{(t)}}^{\top}\hat{{\bm{p}}}_{1}^{l-1}))(1" display="inline" intent=":literal"><semantics><mrow><mrow><munder><mi>max</mi><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>l</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mo>⁡</mo><mrow><mo>{</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>l</mi></munderover></mstyle><mrow><msubsup><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>j</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">}</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝒑</mi><mo>^</mo></mover><mn>1</mn><mi>l</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝒑</mi><mo>^</mo></mover><mn>1</mn><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo fence="true" lspace="0em" rspace="0em">CLOSE</mo></mrow></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\max_{j\in[l]}\left\{\sum_{i=1}^{l}G_{i,l+1}^{j}({\bm{w}}^{(t)})\right\}\cdot(1+(1-\sigma({{\bm{w}}^{(t)}}^{\top}\hat{{\bm{p}}}_{1}^{l}))+(1-\sigma({{\bm{w}}^{(t)}}^{\top}\hat{{\bm{p}}}_{1}^{l-1}))(1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E186Xe" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E186Xe.m2" class="ltx_Math" alttext="\displaystyle-\sigma({{\bm{w}}^{(t)}}^{\top}\hat{{\bm{p}}}_{2}^{l-1}))+\cdots+\prod_{j=1}^{l-1}(1-\sigma({{\bm{w}}^{(t)}}^{\top}\hat{{\bm{p}}}_{j}^{2})))" display="inline" intent=":literal"><semantics><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mrow><mo fence="true" lspace="0em" rspace="0em">OPEN</mo><mrow><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝒑</mi><mo>^</mo></mover><mn>2</mn><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝒑</mi><mo>^</mo></mover><mi>j</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\sigma({{\bm{w}}^{(t)}}^{\top}\hat{{\bm{p}}}_{2}^{l-1}))+\cdots+\prod_{j=1}^{l-1}(1-\sigma({{\bm{w}}^{(t)}}^{\top}\hat{{\bm{p}}}_{j}^{2})))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E186Xf" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E186Xf.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E186Xf.m3" class="ltx_Math" alttext="\displaystyle 1+(1-\sigma({{\bm{w}}^{(t)}}^{\top}\hat{{\bm{p}}}_{1}^{l}))+(1-\sigma({{\bm{w}}^{(t)}}^{\top}\hat{{\bm{p}}}_{1}^{l-1}))(1-\sigma({{\bm{w}}^{(t)}}^{\top}\hat{{\bm{p}}}_{2}^{l-1}))+\cdots" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝒑</mi><mo>^</mo></mover><mn>1</mn><mi>l</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝒑</mi><mo>^</mo></mover><mn>1</mn><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝒑</mi><mo>^</mo></mover><mn>2</mn><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mo lspace="0em">⋯</mo></mrow><annotation encoding="application/x-tex">\displaystyle 1+(1-\sigma({{\bm{w}}^{(t)}}^{\top}\hat{{\bm{p}}}_{1}^{l}))+(1-\sigma({{\bm{w}}^{(t)}}^{\top}\hat{{\bm{p}}}_{1}^{l-1}))(1-\sigma({{\bm{w}}^{(t)}}^{\top}\hat{{\bm{p}}}_{2}^{l-1}))+\cdots</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E186Xg" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E186Xg.m2" class="ltx_Math" alttext="\displaystyle+\prod_{j=1}^{l-1}(1-\sigma({{\bm{w}}^{(t)}}^{\top}\hat{{\bm{p}}}_{j}^{2}))" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mo movablelimits="false">∏</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>σ</mi><mo stretchy="false">(</mo><mi>𝒘</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><msup><mrow></mrow><mo>⊤</mo></msup><mover accent="true"><mi>𝒑</mi><mo>^</mo></mover><msub><mrow></mrow><mi>j</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\prod_{j=1}^{l-1}(1-\sigma({{\bm{w}}^{(t)}}^{\top}\hat{{\bm{p}}}_{j}^{2}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E186Xh" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E186Xh.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E186Xh.m3" class="ltx_Math" alttext="\displaystyle 1+1-c+(1-c)^{2}+\cdots+(1-c)^{l-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>1</mn><mo>+</mo><mn>1</mn></mrow><mo>−</mo><mi>c</mi></mrow><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle 1+1-c+(1-c)^{2}+\cdots+(1-c)^{l-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E186Xi" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E186Xi.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E186Xi.m3" class="ltx_Math" alttext="\displaystyle\frac{1}{c}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>c</mi></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{1}{c}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E186Xj" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E186Xj.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E186Xj.m3" class="ltx_Math" alttext="\displaystyle\Theta(1)," display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Theta(1),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS5.p1.3" class="ltx_p"><span id="A5.SS5.p1.3.1" class="ltx_text">where the third to last step holds since that when <math id="A5.SS5.p1.m5" class="ltx_Math" alttext="t\lesssim\min\{\eta^{-1}\beta^{-2}\kappa_{a}^{-1}(1-p_{a})^{-1}V,\eta^{-1}M_{1}^{\frac{2}{3}}((1-p_{a})\beta)^{-\frac{2}{3}}(\kappa_{a}(1-p_{a}))^{-\frac{1}{3}}V^{\frac{1}{3}}\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≲</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>,</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mn>1</mn><mfrac><mn>2</mn><mn>3</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mn>2</mn><mn>3</mn></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mfrac><mn>1</mn><mn>3</mn></mfrac></msup></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t\lesssim\min\{\eta^{-1}\beta^{-2}\kappa_{a}^{-1}(1-p_{a})^{-1}V,\eta^{-1}M_{1}^{\frac{2}{3}}((1-p_{a})\beta)^{-\frac{2}{3}}(\kappa_{a}(1-p_{a}))^{-\frac{1}{3}}V^{\frac{1}{3}}\}</annotation></semantics></math>, there exists <math id="A5.SS5.p1.m6" class="ltx_Math" alttext="c\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">c\in(0,1)</annotation></semantics></math> and <math id="A5.SS5.p1.m7" class="ltx_Math" alttext="C\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C\in(0,1)</annotation></semantics></math>, <math id="A5.SS5.p1.m8" class="ltx_Math" alttext="C&gt;c" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&gt;</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">C&gt;c</annotation></semantics></math>, such that <math id="A5.SS5.p1.m9" class="ltx_Math" alttext="c\leq\sigma({{\bm{w}}^{(t)}}^{\top}{\bm{p}}_{j})\leq C" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>≤</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>C</mi></mrow><annotation encoding="application/x-tex">c\leq\sigma({{\bm{w}}^{(t)}}^{\top}{\bm{p}}_{j})\leq C</annotation></semantics></math> for any <math id="A5.SS5.p1.m10" class="ltx_Math" alttext="j\in[l]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>l</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[l]</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="A5.SS6" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.6 </span>Extension to Other SSM/Linear RNN Architectures</h3>

<div id="A5.SS6.p1" class="ltx_para">
<p id="A5.SS6.p1.1" class="ltx_p">Our theoretical analysis can be extended to a broader range of SSM or Linear RNN architectures. The key to such extension depends on whether the basic block of the model can be decomposed into a linear attention layer and a gating layer as in (<a href="#S2.E3" title="In 2 Problem Formulation ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>). Even if the specific form of the nonlinear gating differs from that in the Mamba architecture we consider in this work, we can still compute the gradient of the new gating function and analyze the resulting training dynamics and generalization performance. We then list several examples and briefly discuss how their models can be interpreted as linear attention plus a gating based on the summary from Table 2 of <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib84" title="" class="ltx_ref">Yang et al., 2024c</a>)</cite>.</p>
</div>
<div id="A5.SS6.p2" class="ltx_para">
<ul id="A5.I1" class="ltx_itemize">
<li id="A5.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I1.i1.p1" class="ltx_para">
<p id="A5.I1.i1.p1.1" class="ltx_p"><span id="A5.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Mamba-2 <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib21" title="" class="ltx_ref">Dao and Gu, 2024</a>)</cite></span>. The updating equation of Mamba-2 is</p>
<table id="A5.E187" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E187X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E187X.m2" class="ltx_Math" alttext="\displaystyle{\bm{h}}_{i}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒉</mi><mi>i</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{h}}_{i}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E187X.m3" class="ltx_Math" alttext="\displaystyle\gamma({\bm{w}},a;i)\cdot{\bm{h}}_{i-1}+{\bm{v}}_{i}{\bm{k}}_{i}^{\top}\quad\in\mathbb{R}^{d_{0}\times m},\quad\forall i\in[m]" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒘</mi><mo>,</mo><mi>a</mi><mo>,</mo><mi>i</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>𝒉</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>𝒗</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mi>i</mi><mo>⊤</mo></msubsup></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mphantom></mphantom></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>m</mi></mrow></msup></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>i</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\gamma({\bm{w}},a;i)\cdot{\bm{h}}_{i-1}+{\bm{v}}_{i}{\bm{k}}_{i}^{\top}\quad\in\mathbb{R}^{d_{0}\times m},\quad\forall i\in[m]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(187)</span></td></tr>
<tr id="A5.E187Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E187Xa.m2" class="ltx_Math" alttext="\displaystyle{\bm{o}}_{i}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒐</mi><mi>i</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{o}}_{i}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E187Xa.m3" class="ltx_Math" alttext="\displaystyle{\displaystyle\bm{h}}_{i}{\bm{q}}_{i}\quad\in\mathbb{R}^{d_{0}}," display="inline" intent=":literal"><semantics><mrow><mi>𝒉</mi><msub><mrow></mrow><mi>i</mi></msub><mi>𝒒</mi><msub><mrow></mrow><mi>i</mi></msub><mo>∈</mo><mi>ℝ</mi><msup><mrow></mrow><msub><mi>d</mi><mn>0</mn></msub></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\displaystyle\bm{h}}_{i}{\bm{q}}_{i}\quad\in\mathbb{R}^{d_{0}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.I1.i1.p1.2" class="ltx_p">where <math id="A5.I1.i1.p1.m1" class="ltx_Math" alttext="\gamma({\bm{w}},a;i)=e^{-\text{softplus}({\bm{w}}^{\top}{\bm{p}}_{i})e^{a}}\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒘</mi><mo>,</mo><mi>a</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mtext>softplus</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒘</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mi>a</mi></msup></mrow></mrow></msup><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">\gamma({\bm{w}},a;i)=e^{-\text{softplus}({\bm{w}}^{\top}{\bm{p}}_{i})e^{a}}\in\mathbb{R}</annotation></semantics></math> for <math id="A5.I1.i1.p1.m2" class="ltx_Math" alttext="a\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">a\in\mathbb{R}</annotation></semantics></math> and <math id="A5.I1.i1.p1.m3" class="ltx_Math" alttext="{\bm{w}}\in\mathbb{R}^{d_{0}}" display="inline" intent=":literal"><semantics><mrow><mi>𝒘</mi><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mn>0</mn></msub></msup></mrow><annotation encoding="application/x-tex">{\bm{w}}\in\mathbb{R}^{d_{0}}</annotation></semantics></math> from Table 1 of <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib83" title="" class="ltx_ref">Yang et al., 2024b</a>)</cite>. Then,</p>
<table id="A5.E188" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E188X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E188X.m2" class="ltx_Math" alttext="\displaystyle{\bm{h}}_{t}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒉</mi><mi>t</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{h}}_{t}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E188X.m3" class="ltx_Math" alttext="\displaystyle\gamma({\bm{w}},a;t)\cdot{\bm{h}}_{t-1}+{\bm{v}}_{t}{\bm{k}}_{t}^{\top}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒘</mi><mo mathsize="0.700em">,</mo><mi>a</mi><mo mathsize="0.700em">,</mo><mi>t</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>𝒉</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>𝒗</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\gamma({\bm{w}},a;t)\cdot{\bm{h}}_{t-1}+{\bm{v}}_{t}{\bm{k}}_{t}^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(188)</span></td></tr>
<tr id="A5.E188Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E188Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E188Xa.m3" class="ltx_Math" alttext="\displaystyle\gamma({\bm{w}},a;t)\cdot(\gamma({\bm{w}},a;t-1)\cdot{\bm{h}}_{t-2}+{\bm{v}}_{t-1}{\bm{k}}_{t-1}^{\top})+{\bm{v}}_{t}{\bm{k}}_{i}^{\top}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒘</mi><mo mathsize="0.700em">,</mo><mi>a</mi><mo mathsize="0.700em">,</mo><mi>t</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒘</mi><mo mathsize="0.700em">,</mo><mi>a</mi><mo mathsize="0.700em">,</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>𝒉</mi><mrow><mi>t</mi><mo>−</mo><mn>2</mn></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>𝒗</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>𝒗</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mi>i</mi><mo>⊤</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\gamma({\bm{w}},a;t)\cdot(\gamma({\bm{w}},a;t-1)\cdot{\bm{h}}_{t-2}+{\bm{v}}_{t-1}{\bm{k}}_{t-1}^{\top})+{\bm{v}}_{t}{\bm{k}}_{i}^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E188Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E188Xb.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E188Xb.m3" class="ltx_Math" alttext="\displaystyle\cdots" display="inline" intent=":literal"><semantics><mo>⋯</mo><annotation encoding="application/x-tex">\displaystyle\cdots</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E188Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E188Xc.m2" class="ltx_Math" alttext="\displaystyle:=" display="inline" intent=":literal"><semantics><mrow><mo>:</mo><mo lspace="0em">⁣</mo><mo>=</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E188Xc.m3" class="ltx_Math" alttext="\displaystyle\sum_{i=1}^{t}G_{i,t}({\bm{w}},a){\bm{v}}_{i}{\bm{k}}_{i}^{\top}," display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msub><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒘</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mi>i</mi><mo>⊤</mo></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=1}^{t}G_{i,t}({\bm{w}},a){\bm{v}}_{i}{\bm{k}}_{i}^{\top},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.I1.i1.p1.3" class="ltx_p">where</p>
<table id="A5.E189" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E189.m1" class="ltx_Math" alttext="G_{i,t}({\bm{w}},a)=\begin{cases}\prod_{j=i+1}^{t}\gamma({\bm{w}},a;j),&amp;i&lt;t\\
1,&amp;i=t.\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒘</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mstyle displaystyle="false"><msubsup><mo>∏</mo><mrow><mi>j</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></msubsup></mstyle><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒘</mi><mo>,</mo><mi>a</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>i</mi><mo>&lt;</mo><mi>t</mi></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>1</mn><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>i</mi><mo>=</mo><mi>t</mi></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">G_{i,t}({\bm{w}},a)=\begin{cases}\prod_{j=i+1}^{t}\gamma({\bm{w}},a;j),&amp;i&lt;t\\
1,&amp;i=t.\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(189)</span></td></tr></tbody>
</table>
<p id="A5.I1.i1.p1.4" class="ltx_p">Therefore, the output of a Mamba-2 block can be written as a summation of linear attention output <math id="A5.I1.i1.p1.m4" class="ltx_Math" alttext="{\bm{v}}_{t}{\bm{k}}_{i}^{\top}{\bm{q}}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒗</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒒</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">{\bm{v}}_{t}{\bm{k}}_{i}^{\top}{\bm{q}}_{i}</annotation></semantics></math> weighted by the scalar gating <math id="A5.I1.i1.p1.m5" class="ltx_Math" alttext="G_{i,t}({\bm{w}},a)" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒘</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G_{i,t}({\bm{w}},a)</annotation></semantics></math> for <math id="A5.I1.i1.p1.m6" class="ltx_Math" alttext="1\leq i\leq t" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">1\leq i\leq t</annotation></semantics></math>.</p>
</div></li>
<li id="A5.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I1.i2.p1" class="ltx_para">
<p id="A5.I1.i2.p1.1" class="ltx_p"><span id="A5.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">RetNet <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib72" title="" class="ltx_ref">Sun et al., 2023</a>)</cite></span>. The updating equation of RetNet is</p>
<table id="A5.E190" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E190X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E190X.m2" class="ltx_Math" alttext="\displaystyle{\bm{h}}_{i}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒉</mi><mi>i</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{h}}_{i}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E190X.m3" class="ltx_Math" alttext="\displaystyle\gamma\cdot{\bm{h}}_{i-1}+{\bm{v}}_{i}{\bm{k}}_{i}^{\top}\quad\in\mathbb{R}^{d_{0}\times m},\quad\forall i\in[m]" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mi>γ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝒉</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>𝒗</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mi>i</mi><mo>⊤</mo></msubsup></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mphantom></mphantom></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>m</mi></mrow></msup></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>i</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\gamma\cdot{\bm{h}}_{i-1}+{\bm{v}}_{i}{\bm{k}}_{i}^{\top}\quad\in\mathbb{R}^{d_{0}\times m},\quad\forall i\in[m]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(190)</span></td></tr>
<tr id="A5.E190Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E190Xa.m2" class="ltx_Math" alttext="\displaystyle{\bm{o}}_{i}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒐</mi><mi>i</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{o}}_{i}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E190Xa.m3" class="ltx_Math" alttext="\displaystyle{\displaystyle\bm{h}}_{i}{\bm{q}}_{i}\quad\in\mathbb{R}^{d_{0}}." display="inline" intent=":literal"><semantics><mrow><mi>𝒉</mi><msub><mrow></mrow><mi>i</mi></msub><mi>𝒒</mi><msub><mrow></mrow><mi>i</mi></msub><mo>∈</mo><mi>ℝ</mi><msup><mrow></mrow><msub><mi>d</mi><mn>0</mn></msub></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\displaystyle\bm{h}}_{i}{\bm{q}}_{i}\quad\in\mathbb{R}^{d_{0}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.I1.i2.p1.2" class="ltx_p">Then,</p>
<table id="A5.E191" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E191X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E191X.m2" class="ltx_Math" alttext="\displaystyle{\bm{h}}_{t}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒉</mi><mi>t</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{h}}_{t}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E191X.m3" class="ltx_Math" alttext="\displaystyle\gamma\cdot{\bm{h}}_{t-1}+{\bm{v}}_{t}{\bm{k}}_{t}^{\top}:=\sum_{i=1}^{t}G_{i,t}({\bm{W}}){\bm{v}}_{i}{\bm{k}}_{i}^{\top}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>γ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝒉</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>𝒗</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow></mrow><mo>:=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msub><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑾</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mi>i</mi><mo>⊤</mo></msubsup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\gamma\cdot{\bm{h}}_{t-1}+{\bm{v}}_{t}{\bm{k}}_{t}^{\top}:=\sum_{i=1}^{t}G_{i,t}({\bm{W}}){\bm{v}}_{i}{\bm{k}}_{i}^{\top},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(191)</span></td></tr></tbody>
</table>
<p id="A5.I1.i2.p1.3" class="ltx_p">where</p>
<table id="A5.E192" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E192.m1" class="ltx_Math" alttext="G_{i,t}({\bm{W}})=\begin{cases}\gamma^{t-i},&amp;i&lt;t\\
1,&amp;i=t.\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑾</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msup><mi>γ</mi><mrow><mi>t</mi><mo>−</mo><mi>i</mi></mrow></msup><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>i</mi><mo>&lt;</mo><mi>t</mi></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>1</mn><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>i</mi><mo>=</mo><mi>t</mi></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">G_{i,t}({\bm{W}})=\begin{cases}\gamma^{t-i},&amp;i&lt;t\\
1,&amp;i=t.\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(192)</span></td></tr></tbody>
</table>
</div></li>
<li id="A5.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I1.i3.p1" class="ltx_para">
<p id="A5.I1.i3.p1.1" class="ltx_p"><span id="A5.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">Gated Retention <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib73" title="" class="ltx_ref">Sun et al., 2024</a>)</cite></span>. The updating equation of Gated Retention is</p>
<table id="A5.E193" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E193X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E193X.m2" class="ltx_Math" alttext="\displaystyle{\bm{h}}_{i}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒉</mi><mi>i</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{h}}_{i}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E193X.m3" class="ltx_Math" alttext="\displaystyle\gamma({\bm{w}};i)\cdot{\bm{h}}_{i-1}+{\bm{v}}_{i}{\bm{k}}_{i}^{\top}\quad\in\mathbb{R}^{d_{0}\times m},\quad\forall i\in[m]" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒘</mi><mo>,</mo><mi>i</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>𝒉</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>𝒗</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mi>i</mi><mo>⊤</mo></msubsup></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mphantom></mphantom></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>m</mi></mrow></msup></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>i</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\gamma({\bm{w}};i)\cdot{\bm{h}}_{i-1}+{\bm{v}}_{i}{\bm{k}}_{i}^{\top}\quad\in\mathbb{R}^{d_{0}\times m},\quad\forall i\in[m]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(193)</span></td></tr>
<tr id="A5.E193Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E193Xa.m2" class="ltx_Math" alttext="\displaystyle{\bm{o}}_{i}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒐</mi><mi>i</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{o}}_{i}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E193Xa.m3" class="ltx_Math" alttext="\displaystyle{\displaystyle\bm{h}}_{i}{\bm{q}}_{i}\quad\in\mathbb{R}^{d_{0}}," display="inline" intent=":literal"><semantics><mrow><mi>𝒉</mi><msub><mrow></mrow><mi>i</mi></msub><mi>𝒒</mi><msub><mrow></mrow><mi>i</mi></msub><mo>∈</mo><mi>ℝ</mi><msup><mrow></mrow><msub><mi>d</mi><mn>0</mn></msub></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\displaystyle\bm{h}}_{i}{\bm{q}}_{i}\quad\in\mathbb{R}^{d_{0}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.I1.i3.p1.2" class="ltx_p">where <math id="A5.I1.i3.p1.m1" class="ltx_Math" alttext="\gamma({\bm{w}};i)=\sigma({\bm{w}}^{\top}{\bm{p}}_{i})^{\frac{1}{\tau}}\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒘</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒘</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mi>τ</mi></mfrac></msup></mrow><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">\gamma({\bm{w}};i)=\sigma({\bm{w}}^{\top}{\bm{p}}_{i})^{\frac{1}{\tau}}\in\mathbb{R}</annotation></semantics></math> for <math id="A5.I1.i3.p1.m2" class="ltx_Math" alttext="\tau\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">\tau\in\mathbb{R}</annotation></semantics></math>.
Then,</p>
<table id="A5.E194" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E194X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E194X.m2" class="ltx_Math" alttext="\displaystyle{\bm{h}}_{t}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒉</mi><mi>t</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{h}}_{t}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E194X.m3" class="ltx_Math" alttext="\displaystyle\gamma({\bm{w}};i)\cdot{\bm{h}}_{t-1}+{\bm{v}}_{t}{\bm{k}}_{t}^{\top}:=\sum_{i=1}^{t}G_{i,t}({\bm{W}}){\bm{v}}_{i}{\bm{k}}_{i}^{\top}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒘</mi><mo>,</mo><mi>i</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>𝒉</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>𝒗</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow></mrow><mo>:=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msub><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑾</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mi>i</mi><mo>⊤</mo></msubsup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\gamma({\bm{w}};i)\cdot{\bm{h}}_{t-1}+{\bm{v}}_{t}{\bm{k}}_{t}^{\top}:=\sum_{i=1}^{t}G_{i,t}({\bm{W}}){\bm{v}}_{i}{\bm{k}}_{i}^{\top},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(194)</span></td></tr></tbody>
</table>
<p id="A5.I1.i3.p1.3" class="ltx_p">where</p>
<table id="A5.E195" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E195.m1" class="ltx_Math" alttext="G_{i,t}({\bm{W}})=\begin{cases}\prod_{j=i+1}^{t}\gamma({\bm{w}};j),&amp;i&lt;t\\
1,&amp;i=t.\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑾</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mstyle displaystyle="false"><msubsup><mo>∏</mo><mrow><mi>j</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></msubsup></mstyle><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒘</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>i</mi><mo>&lt;</mo><mi>t</mi></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>1</mn><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>i</mi><mo>=</mo><mi>t</mi></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">G_{i,t}({\bm{W}})=\begin{cases}\prod_{j=i+1}^{t}\gamma({\bm{w}};j),&amp;i&lt;t\\
1,&amp;i=t.\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(195)</span></td></tr></tbody>
</table>
</div></li>
<li id="A5.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I1.i4.p1" class="ltx_para">
<p id="A5.I1.i4.p1.1" class="ltx_p"><span id="A5.I1.i4.p1.1.1" class="ltx_text ltx_font_bold">Gated Linear Attention <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib83" title="" class="ltx_ref">Yang et al., 2024b</a>)</cite></span>. The updating equation of Gated Linear Attention is</p>
<table id="A5.E196" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E196X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E196X.m2" class="ltx_Math" alttext="\displaystyle{\bm{h}}_{i}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒉</mi><mi>i</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{h}}_{i}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E196X.m3" class="ltx_Math" alttext="\displaystyle{\displaystyle\bm{h}}_{i-1}\odot(\sigma({\bm{W}}{\bm{p}}_{i})^{\frac{1}{\tau}}\mathbf{1}_{m}^{\top})+{\bm{v}}_{i}{\bm{k}}_{i}^{\top}\quad\in\mathbb{R}^{d_{0}\times m},\quad\forall i\in[m]" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><msub><mi>𝒉</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">⊙</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝑾</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mi>τ</mi></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mn>𝟏</mn><mi>m</mi><mo>⊤</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>𝒗</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mi>i</mi><mo>⊤</mo></msubsup></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mphantom></mphantom></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>m</mi></mrow></msup></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>i</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\displaystyle\bm{h}}_{i-1}\odot(\sigma({\bm{W}}{\bm{p}}_{i})^{\frac{1}{\tau}}\mathbf{1}_{m}^{\top})+{\bm{v}}_{i}{\bm{k}}_{i}^{\top}\quad\in\mathbb{R}^{d_{0}\times m},\quad\forall i\in[m]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(196)</span></td></tr>
<tr id="A5.E196Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E196Xa.m2" class="ltx_Math" alttext="\displaystyle{\bm{o}}_{i}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒐</mi><mi>i</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{o}}_{i}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E196Xa.m3" class="ltx_Math" alttext="\displaystyle{\displaystyle\bm{h}}_{i}{\bm{q}}_{i}\quad\in\mathbb{R}^{d_{0}}," display="inline" intent=":literal"><semantics><mrow><mi>𝒉</mi><msub><mrow></mrow><mi>i</mi></msub><mi>𝒒</mi><msub><mrow></mrow><mi>i</mi></msub><mo>∈</mo><mi>ℝ</mi><msup><mrow></mrow><msub><mi>d</mi><mn>0</mn></msub></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\displaystyle\bm{h}}_{i}{\bm{q}}_{i}\quad\in\mathbb{R}^{d_{0}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.I1.i4.p1.2" class="ltx_p">where <math id="A5.I1.i4.p1.m1" class="ltx_Math" alttext="{\bm{W}}\in\mathbb{R}^{d_{0}\times d_{0}}" display="inline" intent=":literal"><semantics><mrow><mi>𝑾</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>d</mi><mn>0</mn></msub></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{W}}\in\mathbb{R}^{d_{0}\times d_{0}}</annotation></semantics></math> for <math id="A5.I1.i4.p1.m2" class="ltx_Math" alttext="\tau\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">\tau\in\mathbb{R}</annotation></semantics></math>.
Then,</p>
<table id="A5.E197" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E197X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E197X.m2" class="ltx_Math" alttext="\displaystyle{\bm{h}}_{t}:=\sum_{i=1}^{t}{\bm{v}}_{i}({\bm{k}}_{i}\odot\sigma({\bm{W}}{\bm{u}}_{i})^{\frac{1}{\tau}})^{\top}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝒉</mi><mi>t</mi></msub><mo>:=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msub><mi>𝒗</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>𝒌</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⊙</mo><mi>σ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝑾</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒖</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mi>τ</mi></mfrac></msup></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{h}}_{t}:=\sum_{i=1}^{t}{\bm{v}}_{i}({\bm{k}}_{i}\odot\sigma({\bm{W}}{\bm{u}}_{i})^{\frac{1}{\tau}})^{\top},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(197)</span></td></tr></tbody>
</table>
<table id="A5.E198" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E198.m1" class="ltx_Math" alttext="F(\Psi;{\bm{P}})=\sum_{i=1}^{t}y_{i}({\bm{W}}_{K}{\bm{p}}_{i}\odot\sigma({\bm{W}}{\bm{p}}_{i})^{\frac{1}{\tau}})^{\top}{\bm{W}}_{Q}{\bm{p}}_{query}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo>,</mo><mi>𝑷</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msub><mi>𝑾</mi><mi>K</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mi>i</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⊙</mo><mi>σ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝑾</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mi>τ</mi></mfrac></msup></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">F(\Psi;{\bm{P}})=\sum_{i=1}^{t}y_{i}({\bm{W}}_{K}{\bm{p}}_{i}\odot\sigma({\bm{W}}{\bm{p}}_{i})^{\frac{1}{\tau}})^{\top}{\bm{W}}_{Q}{\bm{p}}_{query}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(198)</span></td></tr></tbody>
</table>
<p id="A5.I1.i4.p1.3" class="ltx_p">Note that in this case, the gating is essentially applied to the key rather than the value as in our (<a href="#S2.E3" title="In 2 Problem Formulation ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>). Then,</p>
<table id="A5.E199" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E199.m1" class="ltx_Math" alttext="\frac{\partial F(\Psi;{\bm{P}})}{\partial{\bm{W}}}=\sum_{i=1}^{t}y_{i}({\bm{W}}_{K}{\bm{p}}_{i}\odot{\bm{W}}_{Q}{\bm{p}}_{query})\odot\frac{1}{\tau}\sigma({\bm{W}}{\bm{p}}_{i})^{\frac{1}{\tau}}\odot(1-\sigma({\bm{W}}{\bm{p}}_{i})){\bm{p}}_{i}^{\top}." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><mo>∂</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo>,</mo><mi>𝑷</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mi>𝑾</mi></mrow></mfrac><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover><mrow><mrow><mrow><mrow><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msub><mi>𝑾</mi><mi>K</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mi>i</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⊙</mo><msub><mi>𝑾</mi><mi>Q</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊙</mo><mfrac><mn>1</mn><mi>τ</mi></mfrac></mrow><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝑾</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mi>i</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mi>τ</mi></mfrac></msup></mrow><mo rspace="0.222em">⊙</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝑾</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>i</mi><mo>⊤</mo></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\partial F(\Psi;{\bm{P}})}{\partial{\bm{W}}}=\sum_{i=1}^{t}y_{i}({\bm{W}}_{K}{\bm{p}}_{i}\odot{\bm{W}}_{Q}{\bm{p}}_{query})\odot\frac{1}{\tau}\sigma({\bm{W}}{\bm{p}}_{i})^{\frac{1}{\tau}}\odot(1-\sigma({\bm{W}}{\bm{p}}_{i})){\bm{p}}_{i}^{\top}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(199)</span></td></tr></tbody>
</table>
<p id="A5.I1.i4.p1.4" class="ltx_p">Our gradient analysis is to characterize the feature updates of (<a href="#A5.E199" title="In 4th item ‣ E.6 Extension to Other SSM/Linear RNN Architectures ‣ Appendix E Proof of Supportive Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">199</span></a>).</p>
</div></li>
</ul>
</div>
</section>
<section id="A5.SSx1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection">The Use of Large Language Models</h3>

<div id="A5.SSx1.p1" class="ltx_para">
<p id="A5.SSx1.p1.1" class="ltx_p">We used large-language models (ChatGPT) to help polish the writing of this paper.</p>
</div>
</section>
</section>
