<section id="A5" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix E </span>Proof of Supportive Lemmas</h2>

<section id="A5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.1 </span>Derivation of (<a href="#S2.E3" title="In 2 Problem Formulation ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>)</h3>

<div id="A5.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS1.p1" class="ltx_para">
<p id="A5.SS1.p1.1" class="ltx_p"><span id="A5.SS1.p1.1.1" class="ltx_text">By formulation in Section <a href="#S2" title="2 Problem Formulation ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, we have</span></p>
<table id="A5.E84" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E84X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E84X.m2" class="ltx_Math" alttext="\displaystyle\tilde{{\bm{A}}}_{j,i}=" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><mrow><mi>j</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{{\bm{A}}}_{j,i}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E84X.m3" class="ltx_Math" alttext="\displaystyle\text{diag}(\exp(\Delta_{j,i}{\bm{A}}))^{\top}" display="inline" intent=":literal"><semantics><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mrow><mi>j</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle\text{diag}(\exp(\Delta_{j,i}{\bm{A}}))^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(84)</span></td></tr>
<tr id="A5.E84Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E84Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E84Xa.m3" class="ltx_Math" alttext="\displaystyle\text{diag}(e^{-{\bm{I}}_{l+1}\Delta_{j,i}})^{\top}" display="inline" intent=":literal"><semantics><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><msub><mi>𝑰</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mrow><mi>j</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle\text{diag}(e^{-{\bm{I}}_{l+1}\Delta_{j,i}})^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E84Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E84Xb.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E84Xb.m3" class="ltx_Math" alttext="\displaystyle\text{diag}(e^{-{\bm{I}}_{l+1}\log(1+e^{{\bm{w}}_{j}^{\top}{\bm{x}}_{i}})})^{\top}" display="inline" intent=":literal"><semantics><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><msub><mi>𝑰</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>e</mi><mrow><msubsup><mi>𝒘</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle\text{diag}(e^{-{\bm{I}}_{l+1}\log(1+e^{{\bm{w}}_{j}^{\top}{\bm{x}}_{i}})})^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E84Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E84Xc.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E84Xc.m3" class="ltx_Math" alttext="\displaystyle\bm{1}_{l+1}^{\top}(\frac{1}{1+e^{{\bm{w}}_{j}^{\top}{\bm{x}}_{i}}})^{\top},\ \ \ \ \ \ \sigma(\cdot):\text{sigmoid function}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mn>𝟏</mn><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><msup><mi>e</mi><mrow><msubsup><mi>𝒘</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow></msup></mrow></mfrac></mstyle><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo rspace="3.167em">,</mo><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mtext>sigmoid function</mtext></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\bm{1}_{l+1}^{\top}(\frac{1}{1+e^{{\bm{w}}_{j}^{\top}{\bm{x}}_{i}}})^{\top},\ \ \ \ \ \ \sigma(\cdot):\text{sigmoid function},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A5.E85" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E85.m1" class="ltx_Math" alttext="\tilde{{\bm{A}}}_{i}=(\tilde{{\bm{A}}}_{1,i}^{\top},\tilde{{\bm{A}}}_{2,i}^{\top},\cdots,\tilde{{\bm{A}}}_{d_{0},i}^{\top})^{\top}=(\mathbf{1}_{d_{0}}-\sigma({\bm{W}}^{\top}{\bm{x}}_{i}))\mathbf{1}_{l+1}^{\top}\in\mathbb{R}^{d_{0}\times(l+1)}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><mi>i</mi></msub><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow><mo>⊤</mo></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow><mo>⊤</mo></msubsup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msubsup><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><mi>i</mi></mrow><mo>⊤</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mn>𝟏</mn><msub><mi>d</mi><mn>0</mn></msub></msub><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑾</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mn>𝟏</mn><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\tilde{{\bm{A}}}_{i}=(\tilde{{\bm{A}}}_{1,i}^{\top},\tilde{{\bm{A}}}_{2,i}^{\top},\cdots,\tilde{{\bm{A}}}_{d_{0},i}^{\top})^{\top}=(\mathbf{1}_{d_{0}}-\sigma({\bm{W}}^{\top}{\bm{x}}_{i}))\mathbf{1}_{l+1}^{\top}\in\mathbb{R}^{d_{0}\times(l+1)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(85)</span></td></tr></tbody>
</table>
<table id="A5.E86" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E86X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E86X.m2" class="ltx_Math" alttext="\displaystyle\tilde{{\bm{B}}}_{j,i}=" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝑩</mi><mo>~</mo></mover><mrow><mi>j</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{{\bm{B}}}_{j,i}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E86X.m3" class="ltx_Math" alttext="\displaystyle(\Delta_{j,i}{\bm{B}}_{i})(\exp(\Delta_{j,i}{\bm{A}})-{\bm{I}})(\Delta_{j,i}{\bm{A}})^{-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mrow><mi>j</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑩</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mrow><mi>j</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>𝑰</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mrow><mi>j</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle(\Delta_{j,i}{\bm{B}}_{i})(\exp(\Delta_{j,i}{\bm{A}})-{\bm{I}})(\Delta_{j,i}{\bm{A}})^{-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(86)</span></td></tr>
<tr id="A5.E86Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E86Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E86Xa.m3" class="ltx_Math" alttext="\displaystyle{\displaystyle\bm{B}}_{i}({\bm{I}}_{l+1}\frac{1}{1+e^{{\bm{w}}_{j}^{\top}{\bm{x}}_{i}}}-{\bm{I}}_{l+1})(-{\bm{I}}_{l+1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑩</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>𝑰</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><msup><mi>e</mi><mrow><msubsup><mi>𝒘</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow></msup></mrow></mfrac></mstyle></mrow><mo>−</mo><msub><mi>𝑰</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><msub><mi>𝑰</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\displaystyle\bm{B}}_{i}({\bm{I}}_{l+1}\frac{1}{1+e^{{\bm{w}}_{j}^{\top}{\bm{x}}_{i}}}-{\bm{I}}_{l+1})(-{\bm{I}}_{l+1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E86Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E86Xb.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E86Xb.m3" class="ltx_Math" alttext="\displaystyle\sigma({\bm{w}}_{j}^{\top}{\bm{x}}_{i}){\bm{B}}_{i}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝒘</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑩</mi><mi>i</mi></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sigma({\bm{w}}_{j}^{\top}{\bm{x}}_{i}){\bm{B}}_{i},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A5.E87" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E87.m1" class="ltx_Math" alttext="\tilde{{\bm{B}}}_{i}=(\tilde{{\bm{B}}}_{1,i}^{\top},\tilde{{\bm{B}}}_{2,i}^{\top},\cdots,\tilde{{\bm{B}}}_{d_{0},i}^{\top})^{\top}:={\bm{s}}_{i}{\bm{B}}_{i}\in\mathbb{R}^{d_{0}\times(l+1)}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>𝑩</mi><mo>~</mo></mover><mi>i</mi></msub><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>𝑩</mi><mo>~</mo></mover><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow><mo>⊤</mo></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>𝑩</mi><mo>~</mo></mover><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow><mo>⊤</mo></msubsup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msubsup><mover accent="true"><mi>𝑩</mi><mo>~</mo></mover><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><mi>i</mi></mrow><mo>⊤</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo>:=</mo><mrow><msub><mi>𝒔</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑩</mi><mi>i</mi></msub></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\tilde{{\bm{B}}}_{i}=(\tilde{{\bm{B}}}_{1,i}^{\top},\tilde{{\bm{B}}}_{2,i}^{\top},\cdots,\tilde{{\bm{B}}}_{d_{0},i}^{\top})^{\top}:={\bm{s}}_{i}{\bm{B}}_{i}\in\mathbb{R}^{d_{0}\times(l+1)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(87)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p1.2" class="ltx_p"><span id="A5.SS1.p1.2.1" class="ltx_text">with <math id="A5.SS1.p1.m1" class="ltx_Math" alttext="{\bm{s}}_{i}=\sigma({\bm{W}}^{\top}{\bm{x}}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒔</mi><mi>i</mi></msub><mo>=</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑾</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{s}}_{i}=\sigma({\bm{W}}^{\top}{\bm{x}}_{i})</annotation></semantics></math>.
Therefore,</span></p>
