<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E88X.m3" class="ltx_Math" alttext="\displaystyle{\displaystyle\bm{h}}_{i-1}\odot\tilde{{\bm{A}}}_{i}+({\bm{p}}_{i}\bm{1}^{\top}_{l+1})\tilde{{\bm{B}}}_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝒉</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">⊙</mo><msub><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><mi>i</mi></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝒑</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mn>𝟏</mn><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝑩</mi><mo>~</mo></mover><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\displaystyle\bm{h}}_{i-1}\odot\tilde{{\bm{A}}}_{i}+({\bm{p}}_{i}\bm{1}^{\top}_{l+1})\tilde{{\bm{B}}}_{i}</annotation></semantics></math></td>
