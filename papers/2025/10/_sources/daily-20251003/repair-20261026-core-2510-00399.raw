<msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0.167em">≤</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><msubsup><mi>M</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big|-({{\bm{\nu}}_{k^{\prime}}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}^{(b)}}({\bm{\nu}}_{k}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta(t+1)\beta}{M_{2}^{2}}\sqrt{\frac{\log B}{B}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(30)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="Thmlemma4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma4.2" class="ltx_text ltx_font_bold">Lemma 4</span></span><span id="Thmlemma4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma4.p1" class="ltx_para">
<p id="Thmlemma4.p1.1" class="ltx_p"><span id="Thmlemma4.p1.1.1" class="ltx_text ltx_font_italic">When <math id="Thmlemma4.p1.m1" class="ltx_Math" alttext="t\lesssim\min\{\eta^{-1}\beta^{-2}\kappa_{a}^{-1}(1-p_{a})^{-1}V,\eta^{-1}M_{1}^{\frac{2}{3}}\beta^{-\frac{2}{3}}\kappa_{a}^{-\frac{1}{3}}(1-p_{a})^{-1}V^{\frac{1}{3}}\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≲</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>,</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mn>1</mn><mfrac><mn>2</mn><mn>3</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mfrac><mn>2</mn><mn>3</mn></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mfrac><mn>1</mn><mn>3</mn></mfrac></msup></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t\lesssim\min\{\eta^{-1}\beta^{-2}\kappa_{a}^{-1}(1-p_{a})^{-1}V,\eta^{-1}M_{1}^{\frac{2}{3}}\beta^{-\frac{2}{3}}\kappa_{a}^{-\frac{1}{3}}(1-p_{a})^{-1}V^{\frac{1}{3}}\}</annotation></semantics></math>, as long as</span></p>
<table id="A3.E31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E31.m1" class="ltx_Math" alttext="l\gtrsim(1-p_{a})^{-1}\log\epsilon^{-1}," display="block" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>≳</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">l\gtrsim(1-p_{a})^{-1}\log\epsilon^{-1},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(31)</span></td></tr></tbody>
</table>
<table id="A3.E32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E32.m1" class="ltx_Math" alttext="B\gtrsim\beta^{-4}\kappa_{a}^{-2}(1-p_{a})^{-2}V^{2}\log\epsilon^{-1}," display="block" intent=":literal"><semantics><mrow><mrow><mi>B</mi><mo>≳</mo><mrow><msup><mi>β</mi><mrow><mo>−</mo><mn>4</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mrow><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">B\gtrsim\beta^{-4}\kappa_{a}^{-2}(1-p_{a})^{-2}V^{2}\log\epsilon^{-1},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(32)</span></td></tr></tbody>
</table>
<p id="Thmlemma4.p1.2" class="ltx_p"><span id="Thmlemma4.p1.2.1" class="ltx_text ltx_font_italic">we have that for any <math id="Thmlemma4.p1.m2" class="ltx_Math" alttext="s\in[V]" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>V</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">s\in[V]</annotation></semantics></math>,</span></p>
<table id="A3.E33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E33.m1" class="ltx_Math" alttext="{{\bm{v}}^{*}_{s}}^{\top}{\bm{w}}^{(t)}\lesssim-\frac{\eta\beta^{2}t\kappa_{a}(1-p_{a})}{V}-\eta\sum_{i=1}^{t}i^{2}(\frac{\eta^{2}(1-p_{a})^{3}\beta^{2}}{M_{1}^{2}})\frac{\kappa_{a}}{V}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mmultiscripts><mi>𝒗</mi><mi>s</mi><mo>∗</mo><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>≲</mo><mrow><mrow><mo>−</mo><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>V</mi></mfrac></mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover><mrow><msup><mi>i</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><msubsup><mi>M</mi><mn>1</mn><mn>2</mn></msubsup></mfrac><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><msub><mi>κ</mi><mi>a</mi></msub><mi>V</mi></mfrac></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{{\bm{v}}^{*}_{s}}^{\top}{\bm{w}}^{(t)}\lesssim-\frac{\eta\beta^{2}t\kappa_{a}(1-p_{a})}{V}-\eta\sum_{i=1}^{t}i^{2}(\frac{\eta^{2}(1-p_{a})^{3}\beta^{2}}{M_{1}^{2}})\frac{\kappa_{a}}{V},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(33)</span></td></tr></tbody>
</table>
<table id="A3.E34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E34.m1" class="ltx_Math" alttext="({\bm{\mu}}_{j}^{\top},0^{\top}){\bm{w}}^{(t)}=\Theta\left(-\frac{\eta(1-p_{a})\beta^{2}(t)}{M_{1}}-\sum_{i=1}^{t-1}i^{2}\cdot(\frac{\eta^{3}(1-p_{a})^{3}\beta^{2}}{M_{1}^{3}})\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>j</mi><mo>⊤</mo></msubsup><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>−</mo><mfrac><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><msub><mi>M</mi><mn>1</mn></msub></mfrac></mrow><mo rspace="0.055em">−</mo><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover><msup><mi>i</mi><mn>2</mn></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mfrac><mrow><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><msubsup><mi>M</mi><mn>1</mn><mn>3</mn></msubsup></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">({\bm{\mu}}_{j}^{\top},0^{\top}){\bm{w}}^{(t)}=\Theta\left(-\frac{\eta(1-p_{a})\beta^{2}(t)}{M_{1}}-\sum_{i=1}^{t-1}i^{2}\cdot(\frac{\eta^{3}(1-p_{a})^{3}\beta^{2}}{M_{1}^{3}})\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(34)</span></td></tr></tbody>
</table>
<p id="Thmlemma4.p1.3" class="ltx_p"><span id="Thmlemma4.p1.3.1" class="ltx_text ltx_font_italic">For <math id="Thmlemma4.p1.m3" class="ltx_Math" alttext="{\bm{p}}_{s}" display="inline" intent=":literal"><semantics><msub><mi>𝐩</mi><mi>s</mi></msub><annotation encoding="application/x-tex">{\bm{p}}_{s}</annotation></semantics></math> that does not contain any <math id="Thmlemma4.p1.m4" class="ltx_Math" alttext="{\bm{v}}^{*}_{o}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐯</mi><mi>o</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">{\bm{v}}^{*}_{o}</annotation></semantics></math>, <math id="Thmlemma4.p1.m5" class="ltx_Math" alttext="o\in[V]" display="inline" intent=":literal"><semantics><mrow><mi>o</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>V</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">o\in[V]</annotation></semantics></math>, and <math id="Thmlemma4.p1.m6" class="ltx_Math" alttext="{\bm{p}}_{r}" display="inline" intent=":literal"><semantics><msub><mi>𝐩</mi><mi>r</mi></msub><annotation encoding="application/x-tex">{\bm{p}}_{r}</annotation></semantics></math> that contains a <math id="Thmlemma4.p1.m7" class="ltx_Math" alttext="{\bm{v}}^{*}_{o}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐯</mi><mi>o</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">{\bm{v}}^{*}_{o}</annotation></semantics></math>, <math id="Thmlemma4.p1.m8" class="ltx_Math" alttext="o\in[V]" display="inline" intent=":literal"><semantics><mrow><mi>o</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>V</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">o\in[V]</annotation></semantics></math>, <math id="Thmlemma4.p1.m9" class="ltx_Math" alttext="r\neq s" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>≠</mo><mi>s</mi></mrow><annotation encoding="application/x-tex">r\neq s</annotation></semantics></math>, we have</span></p>
<table id="A3.E35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E35.m1" class="ltx_Math" alttext="-\frac{\eta(1-p_{a})\beta^{2}t}{M_{1}}-\sum_{i=1}^{t}i^{2}\cdot(\frac{\eta^{3}(1-p_{a})^{3}\beta^{2}}{M_{1}^{3}})\lesssim{{\bm{w}}^{(t)}}^{\top}{\bm{p}}_{s}&lt;0," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>−</mo><mfrac><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><msub><mi>M</mi><mn>1</mn></msub></mfrac></mrow><mo rspace="0.055em">−</mo><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover><msup><mi>i</mi><mn>2</mn></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mfrac><mrow><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><msubsup><mi>M</mi><mn>1</mn><mn>3</mn></msubsup></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≲</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mi>s</mi></msub></mrow><mo>&lt;</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">-\frac{\eta(1-p_{a})\beta^{2}t}{M_{1}}-\sum_{i=1}^{t}i^{2}\cdot(\frac{\eta^{3}(1-p_{a})^{3}\beta^{2}}{M_{1}^{3}})\lesssim{{\bm{w}}^{(t)}}^{\top}{\bm{p}}_{s}&lt;0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(35)</span></td></tr></tbody>
</table>
<table id="A3.E36" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E36.m1" class="ltx_Math" alttext="{{\bm{w}}^{(t)}}^{\top}{\bm{p}}_{r}\lesssim-\eta t\beta^{2}\kappa_{a}(1-p_{a})&lt;{{\bm{w}}^{(t)}}^{\top}{\bm{p}}_{s}&lt;0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mi>r</mi></msub></mrow><mo>≲</mo><mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&lt;</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mi>s</mi></msub></mrow><mo>&lt;</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{{\bm{w}}^{(t)}}^{\top}{\bm{p}}_{r}\lesssim-\eta t\beta^{2}\kappa_{a}(1-p_{a})&lt;{{\bm{w}}^{(t)}}^{\top}{\bm{p}}_{s}&lt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(36)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="Thmlemma5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma5.2" class="ltx_text ltx_font_bold">Lemma 5</span></span><span id="Thmlemma5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma5.p1" class="ltx_para">
<p id="Thmlemma5.p1.1" class="ltx_p"><span id="Thmlemma5.p1.1.1" class="ltx_text ltx_font_italic">When <math id="Thmlemma5.p1.m1" class="ltx_Math" alttext="t\gtrsim\eta^{-1}(1-p_{a})^{-1}\beta^{-2}M_{1}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≳</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">t\gtrsim\eta^{-1}(1-p_{a})^{-1}\beta^{-2}M_{1}</annotation></semantics></math> and <math id="Thmlemma5.p1.m2" class="ltx_Math" alttext="\kappa_{a}\gtrsim V\beta^{-4}" display="inline" intent=":literal"><semantics><mrow><msub><mi>κ</mi><mi>a</mi></msub><mo>≳</mo><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\kappa_{a}\gtrsim V\beta^{-4}</annotation></semantics></math>, we have</span></p>
<table id="A3.E37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E37.m1" class="ltx_Math" alttext="{{\bm{w}}^{(t)}}^{\top}{\bm{p}}_{i}\lesssim-\log M_{1}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mi>i</mi></msub></mrow><mo>≲</mo><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>M</mi><mn>1</mn></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{{\bm{w}}^{(t)}}^{\top}{\bm{p}}_{i}\lesssim-\log M_{1},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(37)</span></td></tr></tbody>
</table>
<p id="Thmlemma5.p1.2" class="ltx_p"><span id="Thmlemma5.p1.2.1" class="ltx_text ltx_font_italic">for <math id="Thmlemma5.p1.m3" class="ltx_Math" alttext="{\bm{p}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝐩</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\bm{p}}_{i}</annotation></semantics></math> that contains a <math id="Thmlemma5.p1.m4" class="ltx_Math" alttext="{\bm{v}}^{*}_{s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐯</mi><mi>s</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">{\bm{v}}^{*}_{s}</annotation></semantics></math>, <math id="Thmlemma5.p1.m5" class="ltx_Math" alttext="s\in[V]" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>V</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">s\in[V]</annotation></semantics></math>, and</span></p>
<table id="A3.E38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E38.m1" class="ltx_Math" alttext="{{\bm{w}}^{(t)}}^{\top}{\bm{p}}_{i}\gtrsim-\Theta(1)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mi>i</mi></msub></mrow><mo>≳</mo><mrow><mo>−</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{{\bm{w}}^{(t)}}^{\top}{\bm{p}}_{i}\gtrsim-\Theta(1).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(38)</span></td></tr></tbody>
</table>
<p id="Thmlemma5.p1.3" class="ltx_p"><span id="Thmlemma5.p1.3.1" class="ltx_text ltx_font_italic">for <math id="Thmlemma5.p1.m6" class="ltx_Math" alttext="{\bm{p}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝐩</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\bm{p}}_{i}</annotation></semantics></math> that does not contain any <math id="Thmlemma5.p1.m7" class="ltx_Math" alttext="{\bm{v}}^{*}_{s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐯</mi><mi>s</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">{\bm{v}}^{*}_{s}</annotation></semantics></math>, <math id="Thmlemma5.p1.m8" class="ltx_Math" alttext="s\in[V]" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>V</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">s\in[V]</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="Thmlemma6" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma6.2" class="ltx_text ltx_font_bold">Lemma 6</span></span><span id="Thmlemma6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma6.p1" class="ltx_para">
<p id="Thmlemma6.p1.1" class="ltx_p"><span id="Thmlemma6.p1.1.1" class="ltx_text ltx_font_italic">When <math id="Thmlemma6.p1.m1" class="ltx_Math" alttext="t\lesssim\min\{\eta^{-1}\beta^{-2}\kappa_{a}^{-1}(1-p_{a})^{-1}V,\eta^{-1}M_{1}^{\frac{2}{3}}((1-p_{a})\beta)^{-\frac{2}{3}}(\kappa_{a}(1-p_{a}))^{-\frac{1}{3}}V^{\frac{1}{3}}\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≲</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>,</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mn>1</mn><mfrac><mn>2</mn><mn>3</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mn>2</mn><mn>3</mn></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mfrac><mn>1</mn><mn>3</mn></mfrac></msup></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t\lesssim\min\{\eta^{-1}\beta^{-2}\kappa_{a}^{-1}(1-p_{a})^{-1}V,\eta^{-1}M_{1}^{\frac{2}{3}}((1-p_{a})\beta)^{-\frac{2}{3}}(\kappa_{a}(1-p_{a}))^{-\frac{1}{3}}V^{\frac{1}{3}}\}</annotation></semantics></math>, we have</span></p>
<table id="A3.E39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E39.m1" class="ltx_Math" alttext="\sum_{i=1}^{l}G_{i,l+1}({\bm{w}}^{(t)})(l-i+1)\leq\Theta(1)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>l</mi></munderover><mrow><msub><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>l</mi><mo>−</mo><mi>i</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{l}G_{i,l+1}({\bm{w}}^{(t)})(l-i+1)\leq\Theta(1).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(39)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="Thmcondition1" class="ltx_theorem ltx_theorem_condition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmcondition1.2" class="ltx_text ltx_font_bold">Condition 1</span></span><span id="Thmcondition1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmcondition1.p1" class="ltx_para">
<p id="Thmcondition1.p1.1" class="ltx_p"><span id="Thmcondition1.p1.1.1" class="ltx_text ltx_font_italic">(Condition 3.2 of <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib51" title="" class="ltx_ref">Li et al., 2024a</a>)</cite>)
For any given <math id="Thmcondition1.p1.m1" class="ltx_Math" alttext="j\in[M_{1}]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[M_{1}]</annotation></semantics></math> and either label <math id="Thmcondition1.p1.m2" class="ltx_Math" alttext="+1" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">+1</annotation></semantics></math> or <math id="Thmcondition1.p1.m3" class="ltx_Math" alttext="-1" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">-1</annotation></semantics></math>, the number of tasks in <math id="Thmcondition1.p1.m4" class="ltx_Math" alttext="\mathcal{T}_{tr}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{T}_{tr}</annotation></semantics></math> that map <math id="Thmcondition1.p1.m5" class="ltx_Math" alttext="{\bm{\mu}}_{j}" display="inline" intent=":literal"><semantics><msub><mi>𝛍</mi><mi>j</mi></msub><annotation encoding="application/x-tex">{\bm{\mu}}_{j}</annotation></semantics></math> to that label is <math id="Thmcondition1.p1.m6" class="ltx_Math" alttext="|\mathcal{T}_{tr}|/M_{1}(\geq 1)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mo>/</mo><msub><mi>M</mi><mn>1</mn></msub></mrow><mspace style="width:0.389em;" width="0.389em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mphantom></mphantom><mo>≥</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">|\mathcal{T}_{tr}|/M_{1}(\geq 1)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A3.p2" class="ltx_para">
<p id="A3.p2.1" class="ltx_p">We introduce a construction of <math id="A3.p2.m1" class="ltx_Math" alttext="\mathcal{T}_{tr}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{T}_{tr}</annotation></semantics></math> that satisfies Condition <a href="#Thmcondition1" title="Condition 1. ‣ Appendix C Key Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> as follows. Let
the <math id="A3.p2.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th task function (<math id="A3.p2.m3" class="ltx_Math" alttext="i\in[M_{1}-1]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>M</mi><mn>1</mn></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[M_{1}-1]</annotation></semantics></math>) in <math id="A3.p2.m4" class="ltx_Math" alttext="\mathcal{T}_{tr}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{T}_{tr}</annotation></semantics></math> map the queries with <math id="A3.p2.m5" class="ltx_Math" alttext="{\bm{\mu}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝝁</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\bm{\mu}}_{i}</annotation></semantics></math> and <math id="A3.p2.m6" class="ltx_Math" alttext="{\bm{\mu}}_{i+1}" display="inline" intent=":literal"><semantics><msub><mi>𝝁</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">{\bm{\mu}}_{i+1}</annotation></semantics></math> as the relevant patterns to <math id="A3.p2.m7" class="ltx_Math" alttext="+1" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">+1</annotation></semantics></math> and <math id="A3.p2.m8" class="ltx_Math" alttext="-1" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">-1</annotation></semantics></math>, respectively. The <math id="A3.p2.m9" class="ltx_Math" alttext="M_{1}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mn>1</mn></msub><annotation encoding="application/x-tex">M_{1}</annotation></semantics></math>-th task function maps <math id="A3.p2.m10" class="ltx_Math" alttext="{\bm{\mu}}_{M_{1}}" display="inline" intent=":literal"><semantics><msub><mi>𝝁</mi><msub><mi>M</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">{\bm{\mu}}_{M_{1}}</annotation></semantics></math> and <math id="A3.p2.m11" class="ltx_Math" alttext="{\bm{\mu}}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝝁</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\bm{\mu}}_{1}</annotation></semantics></math> to <math id="A3.p2.m12" class="ltx_Math" alttext="+1" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">+1</annotation></semantics></math> and <math id="A3.p2.m13" class="ltx_Math" alttext="-1" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">-1</annotation></semantics></math>, respectively. We can easily verify that such a <math id="A3.p2.m14" class="ltx_Math" alttext="\mathcal{T}_{tr}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{T}_{tr}</annotation></semantics></math> satisfies Condition <a href="#Thmcondition1" title="Condition 1. ‣ Appendix C Key Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> in this case.</p>
</div>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Proof of Main Theorems</h2>

<section id="A4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.1 </span>Proof of Theorem <a href="#Thmthm1" title="Theorem 1. ‣ 3.3 Learning, Generalization, and Sample Complexity Analysis of Mamba ‣ 3 Main Theoretical Results ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a></h3>

<div id="A4.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS1.p1" class="ltx_para ltx_noindent">
<p id="A4.SS1.p1.3" class="ltx_p"><span id="A4.SS1.p1.3.1" class="ltx_text">We know that there exists gradient noise caused by imbalanced patterns in each batchTherefore, by Hoeffding’s inequality (<a href="#A3.E22" title="In Lemma 2. ‣ Appendix C Key Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>), for any <math id="A4.SS1.p1.m1" class="ltx_Math" alttext="{\bm{W}}\in\Psi" display="inline" intent=":literal"><semantics><mrow><mi>𝑾</mi><mo>∈</mo><mi mathvariant="normal">Ψ</mi></mrow><annotation encoding="application/x-tex">{\bm{W}}\in\Psi</annotation></semantics></math>,</span></p>
<table id="A4.E40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E40.m1" class="ltx_Math" alttext="\Pr\left(\Big\|\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\partial\ell(\Psi;{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}}-\mathbb{E}\left[\frac{\partial\ell(\Psi;{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}}\right]\Big\|\geq\Big|\mathbb{E}\left[\frac{\partial\ell(\Psi;{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}}\right]\epsilon\right)\leq e^{-B\epsilon^{2}}\leq\epsilon," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mrow><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></munder><mfrac><mrow><mo>∂</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mi>𝑾</mi></mrow></mfrac></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mfrac><mrow><mo>∂</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mi>𝑾</mi></mrow></mfrac><mo>]</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mo>≥</mo><mphantom></mphantom></mrow><mo lspace="0em" mathsize="1.600em" rspace="0em">|</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mfrac><mrow><mo>∂</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mi>𝑾</mi></mrow></mfrac><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup></mrow></mrow></msup><mo>≤</mo><mi>ϵ</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\Pr\left(\Big\|\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\partial\ell(\Psi;{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}}-\mathbb{E}\left[\frac{\partial\ell(\Psi;{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}}\right]\Big\|\geq\Big|\mathbb{E}\left[\frac{\partial\ell(\Psi;{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}}\right]\epsilon\right)\leq e^{-B\epsilon^{2}}\leq\epsilon,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(40)</span></td></tr></tbody>
</table>
<p id="A4.SS1.p1.4" class="ltx_p"><span id="A4.SS1.p1.4.1" class="ltx_text">if <math id="A4.SS1.p1.m2" class="ltx_Math" alttext="B\gtrsim\epsilon^{-2}\log\epsilon^{-1}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>≳</mo><mrow><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">B\gtrsim\epsilon^{-2}\log\epsilon^{-1}</annotation></semantics></math>. Combining (<a href="#A3.E32" title="In Lemma 4. ‣ Appendix C Key Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">32</span></a>), we require</span></p>
<table id="A4.E41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E41.m1" class="ltx_Math" alttext="B\gtrsim\max\{\beta^{-4}\kappa_{a}^{-2}(1-p_{a})^{-2},\epsilon^{-2},M_{1}(1-p_{a})^{-1}\}\cdot\log\epsilon^{-1}." display="block" intent=":literal"><semantics><mrow><mrow><mi>B</mi><mo>≳</mo><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mi>β</mi><mrow><mo>−</mo><mn>4</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mrow><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><mo>,</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo>,</mo><mrow><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo rspace="0.055em" stretchy="false">}</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">B\gtrsim\max\{\beta^{-4}\kappa_{a}^{-2}(1-p_{a})^{-2},\epsilon^{-2},M_{1}(1-p_{a})^{-1}\}\cdot\log\epsilon^{-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(41)</span></td></tr></tbody>
</table>
<p id="A4.SS1.p1.5" class="ltx_p"><span id="A4.SS1.p1.5.1" class="ltx_text">When <math id="A4.SS1.p1.m3" class="ltx_Math" alttext="t\geq T=\Theta(\eta^{-1}(1-p_{a})^{-1}\beta^{-2}M_{1})" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mi>T</mi><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t\geq T=\Theta(\eta^{-1}(1-p_{a})^{-1}\beta^{-2}M_{1})</annotation></semantics></math>, we have that for <math id="A4.SS1.p1.m4" class="ltx_Math" alttext="{\bm{W}}\in\{{\bm{W}}_{B},{\bm{W}}_{C}\}" display="inline" intent=":literal"><semantics><mrow><mi>𝑾</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><msub><mi>𝑾</mi><mi>B</mi></msub><mo>,</mo><msub><mi>𝑾</mi><mi>C</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{W}}\in\{{\bm{W}}_{B},{\bm{W}}_{C}\}</annotation></semantics></math> and any <math id="A4.SS1.p1.m5" class="ltx_Math" alttext="j\in[M_{1}]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[M_{1}]</annotation></semantics></math>,</span></p>
<table id="A4.E42" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E42X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E42X.m2" class="ltx_Math" alttext="\displaystyle({\bm{\mu}}_{j}^{\top},0^{\top}){\bm{W}}^{(T)}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>j</mi><mo>⊤</mo></msubsup><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>j</mi><mo>⊤</mo></msubsup><mo mathsize="0.700em">,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle({\bm{\mu}}_{j}^{\top},0^{\top}){\bm{W}}^{(T)}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(42)</span></td></tr>
<tr id="A4.E42Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E42Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E42Xa.m3" class="ltx_Math" alttext="\displaystyle({\bm{\mu}}_{j}^{\top},0^{\top})({\bm{W}}^{(0)}-\eta\cdot\sum_{b=1}^{T}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}^{(b)}})({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>j</mi><mo>⊤</mo></msubsup><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mrow><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></munder></mstyle><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle></mrow></mrow></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>j</mi><mo>⊤</mo></msubsup><mo mathsize="0.700em">,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle({\bm{\mu}}_{j}^{\top},0^{\top})({\bm{W}}^{(0)}-\eta\cdot\sum_{b=1}^{T}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}^{(b)}})({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A4.E42Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E42Xb.m2" class="ltx_Math" alttext="\displaystyle\gtrsim" display="inline" intent=":literal"><semantics><mo>≳</mo><annotation encoding="application/x-tex">\displaystyle\gtrsim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E42Xb.m3" class="ltx_Math" alttext="\displaystyle 1," display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle 1,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p1.6" class="ltx_p"><span id="A4.SS1.p1.6.1" class="ltx_text">where the last step comes from (<a href="#A3.E23" title="In Lemma 3. ‣ Appendix C Key Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>) in Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ Appendix C Key Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>. Then, for <math id="A4.SS1.p1.m6" class="ltx_Math" alttext="{\bm{p}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒑</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\bm{p}}_{i}</annotation></semantics></math> that shares the same pattern as the query, we have</span></p>
<table id="A4.E43" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E43X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E43X.m2" class="ltx_Math" alttext="\displaystyle{\bm{p}}_{i}^{\top}{{\bm{W}}_{B}^{(T)}}^{\top}{\bm{W}}_{C}^{(T)}{\bm{p}}_{query}\gtrsim" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝒑</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝑾</mi><mi>B</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>C</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub></mrow><mo>≳</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{p}}_{i}^{\top}{{\bm{W}}_{B}^{(T)}}^{\top}{\bm{W}}_{C}^{(T)}{\bm{p}}_{query}\gtrsim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E43X.m3" class="ltx_Math" alttext="\displaystyle\beta^{2}(1+\kappa_{a}\mathbbm{1}[{\bm{p}}_{i}\text{ contains any }{\bm{v}}_{s}^{*}])+1-(1-p_{a})^{-1}\epsilon\beta^{-1}/M_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝒑</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mtext> contains any </mtext><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo>−</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>/</mo><msub><mi>M</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\beta^{2}(1+\kappa_{a}\mathbbm{1}[{\bm{p}}_{i}\text{ contains any }{\bm{v}}_{s}^{*}])+1-(1-p_{a})^{-1}\epsilon\beta^{-1}/M_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(43)</span></td></tr>
<tr id="A4.E43Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E43Xa.m2" class="ltx_Math" alttext="\displaystyle-(1-p_{a})^{-1}p_{a}\kappa_{a}V^{-1}\beta^{-1}\epsilon\mathbbm{1}[{\bm{p}}_{i}\text{ contains any }{\bm{v}}_{s}^{*}]," display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝒑</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mtext> contains any </mtext><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle-(1-p_{a})^{-1}p_{a}\kappa_{a}V^{-1}\beta^{-1}\epsilon\mathbbm{1}[{\bm{p}}_{i}\text{ contains any }{\bm{v}}_{s}^{*}],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p1.7" class="ltx_p"><span id="A4.SS1.p1.7.1" class="ltx_text">as long as <math id="A4.SS1.p1.m7" class="ltx_Math" alttext="\epsilon\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\epsilon\in(0,1)</annotation></semantics></math>. <math id="A4.SS1.p1.m8" class="ltx_Math" alttext="(1-p_{a})^{-1}\epsilon/M_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mo>/</mo><msub><mi>M</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">(1-p_{a})^{-1}\epsilon/M_{2}</annotation></semantics></math> comes from the correlation between <math id="A4.SS1.p1.m9" class="ltx_Math" alttext="{\bm{\mu}}_{j}" display="inline" intent=":literal"><semantics><msub><mi>𝝁</mi><mi>j</mi></msub><annotation encoding="application/x-tex">{\bm{\mu}}_{j}</annotation></semantics></math> and <math id="A4.SS1.p1.m10" class="ltx_Math" alttext="{\bm{\nu}}_{k}" display="inline" intent=":literal"><semantics><msub><mi>𝝂</mi><mi>k</mi></msub><annotation encoding="application/x-tex">{\bm{\nu}}_{k}</annotation></semantics></math>, <math id="A4.SS1.p1.m11" class="ltx_Math" alttext="{\bm{\nu}}_{*}" display="inline" intent=":literal"><semantics><msub><mi>𝝂</mi><mo>∗</mo></msub><annotation encoding="application/x-tex">{\bm{\nu}}_{*}</annotation></semantics></math> and between <math id="A4.SS1.p1.m12" class="ltx_Math" alttext="{\bm{\nu}}_{k}" display="inline" intent=":literal"><semantics><msub><mi>𝝂</mi><mi>k</mi></msub><annotation encoding="application/x-tex">{\bm{\nu}}_{k}</annotation></semantics></math> and <math id="A4.SS1.p1.m13" class="ltx_Math" alttext="{\bm{\nu}}_{*}" display="inline" intent=":literal"><semantics><msub><mi>𝝂</mi><mo>∗</mo></msub><annotation encoding="application/x-tex">{\bm{\nu}}_{*}</annotation></semantics></math>, and <math id="A4.SS1.p1.m14" class="ltx_Math" alttext="B\gtrsim\epsilon^{-2}\log\epsilon^{-1}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>≳</mo><mrow><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">B\gtrsim\epsilon^{-2}\log\epsilon^{-1}</annotation></semantics></math>. For <math id="A4.SS1.p1.m15" class="ltx_Math" alttext="{\bm{p}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒑</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\bm{p}}_{i}</annotation></semantics></math> that shares a different pattern that does not form a training task from the query, with a high probability, we have</span></p>
<table id="A4.E44" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E44X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E44X.m2" class="ltx_Math" alttext="\displaystyle{\bm{p}}_{i}^{\top}{{\bm{W}}_{B}^{(T)}}^{\top}{\bm{W}}_{C}^{(T)}{\bm{p}}_{query}\leq(1-p_{a})^{-1}\epsilon\beta^{-1}/M_{2}+(1-p_{a})^{-1}p_{a}\kappa_{a}V^{-1}\beta^{-1}\epsilon\mathbbm{1}[{\bm{p}}_{i}\text{ contains any }{\bm{v}}_{s}^{*}]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>𝒑</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝑾</mi><mi>B</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>C</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub></mrow><mo>≤</mo><mrow><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>/</mo><msub><mi>M</mi><mn>2</mn></msub></mrow><mo>+</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝒑</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mtext> contains any </mtext><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{p}}_{i}^{\top}{{\bm{W}}_{B}^{(T)}}^{\top}{\bm{W}}_{C}^{(T)}{\bm{p}}_{query}\leq(1-p_{a})^{-1}\epsilon\beta^{-1}/M_{2}+(1-p_{a})^{-1}p_{a}\kappa_{a}V^{-1}\beta^{-1}\epsilon\mathbbm{1}[{\bm{p}}_{i}\text{ contains any }{\bm{v}}_{s}^{*}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(44)</span></td></tr></tbody>
</table>
<p id="A4.SS1.p1.8" class="ltx_p"><span id="A4.SS1.p1.8.1" class="ltx_text">Meanwhile, for <math id="A4.SS1.p1.m16" class="ltx_Math" alttext="{\bm{p}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒑</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\bm{p}}_{i}</annotation></semantics></math> that contains a <math id="A4.SS1.p1.m17" class="ltx_Math" alttext="{\bm{v}}^{*}_{s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">{\bm{v}}^{*}_{s}</annotation></semantics></math>, <math id="A4.SS1.p1.m18" class="ltx_Math" alttext="s\in[V]" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>V</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">s\in[V]</annotation></semantics></math>, we have</span></p>
<table id="A4.E45" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E45.m1" class="ltx_Math" alttext="G_{i,l+1}({\bm{w}}^{(T)})\leq\sigma({{\bm{w}}^{(T)}}^{\top}{\bm{p}}_{i})\lesssim O(\text{poly}(M_{1}^{\kappa_{a}})^{-1})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≲</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>poly</mtext><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>M</mi><mn>1</mn><msub><mi>κ</mi><mi>a</mi></msub></msubsup><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">G_{i,l+1}({\bm{w}}^{(T)})\leq\sigma({{\bm{w}}^{(T)}}^{\top}{\bm{p}}_{i})\lesssim O(\text{poly}(M_{1}^{\kappa_{a}})^{-1}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(45)</span></td></tr></tbody>
</table>
<p id="A4.SS1.p1.9" class="ltx_p"><span id="A4.SS1.p1.9.1" class="ltx_text">by Lemma <a href="#Thmlemma5" title="Lemma 5. ‣ Appendix C Key Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>. We have that for the <math id="A4.SS1.p1.m19" class="ltx_Math" alttext="{\bm{p}}_{i^{*}}" display="inline" intent=":literal"><semantics><msub><mi>𝒑</mi><msup><mi>i</mi><mo>∗</mo></msup></msub><annotation encoding="application/x-tex">{\bm{p}}_{i^{*}}</annotation></semantics></math> that does not contain any <math id="A4.SS1.p1.m20" class="ltx_Math" alttext="{\bm{v}}^{*}_{s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">{\bm{v}}^{*}_{s}</annotation></semantics></math>, <math id="A4.SS1.p1.m21" class="ltx_Math" alttext="s\in[V]" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>V</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">s\in[V]</annotation></semantics></math> and is the closest to the query, by Lemma <a href="#Thmlemma5" title="Lemma 5. ‣ Appendix C Key Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>,</span></p>
<table id="A4.E46" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E46X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E46X.m2" class="ltx_Math" alttext="\displaystyle G_{i^{*},l+1}({\bm{w}}^{(T)})\gtrsim" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>G</mi><mrow><msup><mi>i</mi><mo>∗</mo></msup><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≳</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle G_{i^{*},l+1}({\bm{w}}^{(T)})\gtrsim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E46X.m3" class="ltx_Math" alttext="\displaystyle(1-\frac{1}{\text{poly}(M_{1}^{\kappa_{a}})})^{lp_{a}}\sigma({{\bm{w}}^{(T)}}^{\top}{\bm{p}}_{i^{*}})" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mtext>poly</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>M</mi><mn>1</mn><msub><mi>κ</mi><mi>a</mi></msub></msubsup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>a</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><msup><mi>i</mi><mo>∗</mo></msup></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(1-\frac{1}{\text{poly}(M_{1}^{\kappa_{a}})})^{lp_{a}}\sigma({{\bm{w}}^{(T)}}^{\top}{\bm{p}}_{i^{*}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(46)</span></td></tr>
<tr id="A4.E46Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E46Xa.m2" class="ltx_Math" alttext="\displaystyle\gtrsim" display="inline" intent=":literal"><semantics><mo>≳</mo><annotation encoding="application/x-tex">\displaystyle\gtrsim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E46Xa.m3" class="ltx_Math" alttext="\displaystyle(1-\frac{lp_{a}}{\text{poly}(M_{1}^{\kappa_{a}})})\sigma({{\bm{w}}^{(T)}}^{\top}{\bm{p}}_{i^{*}})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mrow><mtext>poly</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>M</mi><mn>1</mn><msub><mi>κ</mi><mi>a</mi></msub></msubsup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><msup><mi>i</mi><mo>∗</mo></msup></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(1-\frac{lp_{a}}{\text{poly}(M_{1}^{\kappa_{a}})})\sigma({{\bm{w}}^{(T)}}^{\top}{\bm{p}}_{i^{*}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A4.E46Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E46Xb.m2" class="ltx_Math" alttext="\displaystyle\gtrsim" display="inline" intent=":literal"><semantics><mo>≳</mo><annotation encoding="application/x-tex">\displaystyle\gtrsim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E46Xb.m3" class="ltx_Math" alttext="\displaystyle(1-\frac{lp_{a}}{\text{poly}(M_{1}^{\kappa_{a}})})." display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mrow><mtext>poly</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>M</mi><mn>1</mn><msub><mi>κ</mi><mi>a</mi></msub></msubsup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle(1-\frac{lp_{a}}{\text{poly}(M_{1}^{\kappa_{a}})}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p1.10" class="ltx_p"><span id="A4.SS1.p1.10.1" class="ltx_text">Hence, for <math id="A4.SS1.p1.m22" class="ltx_Math" alttext="{\bm{P}}" display="inline" intent=":literal"><semantics><mi>𝑷</mi><annotation encoding="application/x-tex">{\bm{P}}</annotation></semantics></math> with <math id="A4.SS1.p1.m23" class="ltx_Math" alttext="z=+1" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>=</mo><mrow><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">z=+1</annotation></semantics></math>, with a high probability, we have</span></p>
<table id="A4.E47" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E47X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E47X.m2" class="ltx_Math" alttext="\displaystyle F(\Psi^{(T)},{\bm{P}})" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>𝑷</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle F(\Psi^{(T)},{\bm{P}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="6" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(47)</span></td></tr>
<tr id="A4.E47Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E47Xa.m2" class="ltx_Math" alttext="\displaystyle\gtrsim" display="inline" intent=":literal"><semantics><mo>≳</mo><annotation encoding="application/x-tex">\displaystyle\gtrsim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E47Xa.m3" class="ltx_Math" alttext="\displaystyle(1-(1-p_{a})^{-1}\epsilon/M_{2}-(1-p_{a})^{-1}p_{a}\kappa_{a}V^{-1}\beta^{-1}\epsilon)\cdot\sum_{i=1}^{l_{tr}(1-p_{a})-1}(1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mo>/</mo><msub><mi>M</mi><mn>2</mn></msub></mrow><mo>−</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mrow><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo stretchy="false">(</mo><mn>1</mn><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(1-(1-p_{a})^{-1}\epsilon/M_{2}-(1-p_{a})^{-1}p_{a}\kappa_{a}V^{-1}\beta^{-1}\epsilon)\cdot\sum_{i=1}^{l_{tr}(1-p_{a})-1}(1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A4.E47Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E47Xb.m2" class="ltx_Math" alttext="\displaystyle-\max_{{\bm{p}}_{i}\text{ contains no }{\bm{v}}_{s}^{*}}\{\sigma({{\bm{w}}^{(T)}}^{\top}{\bm{p}}_{i})\})^{i-1}\cdot\min_{{\bm{p}}_{i}\text{ contains no }{\bm{v}}_{s}^{*}}\{\sigma({{\bm{w}}^{(T)}}^{\top}{\bm{p}}_{i})\}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mo rspace="0.167em">−</mo><mrow><munder><mi>max</mi><mrow><msub><mi>𝒑</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mtext> contains no </mtext><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup></mrow></munder><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><munder><mi>min</mi><mrow><msub><mi>𝒑</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mtext> contains no </mtext><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup></mrow></munder><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\max_{{\bm{p}}_{i}\text{ contains no }{\bm{v}}_{s}^{*}}\{\sigma({{\bm{w}}^{(T)}}^{\top}{\bm{p}}_{i})\})^{i-1}\cdot\min_{{\bm{p}}_{i}\text{ contains no }{\bm{v}}_{s}^{*}}\{\sigma({{\bm{w}}^{(T)}}^{\top}{\bm{p}}_{i})\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A4.E47Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E47Xc.m2" class="ltx_Math" alttext="\displaystyle\gtrsim" display="inline" intent=":literal"><semantics><mo>≳</mo><annotation encoding="application/x-tex">\displaystyle\gtrsim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E47Xc.m3" class="ltx_Math" alttext="\displaystyle\frac{(1-(1-\max_{{\bm{p}}_{i}\text{ contains no }{\bm{v}}_{s}^{*}}\{\sigma({{\bm{w}}^{(T)}}^{\top}{\bm{p}}_{i})\})^{l_{tr}(1-p_{a})})\cdot\min_{{\bm{p}}_{i}\text{ contains no }{\bm{v}}_{s}^{*}}\{\sigma({{\bm{w}}^{(T)}}^{\top}{\bm{p}}_{i})\}}{\max_{{\bm{p}}_{i}\text{ contains no }{\bm{v}}_{s}^{*}}\{\sigma({{\bm{w}}^{(T)}}^{\top}{\bm{p}}_{i})\}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>max</mi><mrow><msub><mi>𝒑</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mtext> contains no </mtext><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><msub><mi>min</mi><mrow><msub><mi>𝒑</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mtext> contains no </mtext><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mrow><msub><mi>max</mi><mrow><msub><mi>𝒑</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mtext> contains no </mtext><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{(1-(1-\max_{{\bm{p}}_{i}\text{ contains no }{\bm{v}}_{s}^{*}}\{\sigma({{\bm{w}}^{(T)}}^{\top}{\bm{p}}_{i})\})^{l_{tr}(1-p_{a})})\cdot\min_{{\bm{p}}_{i}\text{ contains no }{\bm{v}}_{s}^{*}}\{\sigma({{\bm{w}}^{(T)}}^{\top}{\bm{p}}_{i})\}}{\max_{{\bm{p}}_{i}\text{ contains no }{\bm{v}}_{s}^{*}}\{\sigma({{\bm{w}}^{(T)}}^{\top}{\bm{p}}_{i})\}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A4.E47Xd" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E47Xd.m2" class="ltx_Math" alttext="\displaystyle&gt;" display="inline" intent=":literal"><semantics><mo>&gt;</mo><annotation encoding="application/x-tex">\displaystyle&gt;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E47Xd.m3" class="ltx_Math" alttext="\displaystyle\Theta(1)\cdot(1-\frac{1}{M_{1}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>M</mi><mn>1</mn></msub></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Theta(1)\cdot(1-\frac{1}{M_{1}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A4.E47Xe" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E47Xe.m2" class="ltx_Math" alttext="\displaystyle&gt;" display="inline" intent=":literal"><semantics><mo>&gt;</mo><annotation encoding="application/x-tex">\displaystyle&gt;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E47Xe.m3" class="ltx_Math" alttext="\displaystyle 1," display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle 1,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p1.11" class="ltx_p"><span id="A4.SS1.p1.11.1" class="ltx_text">where the second to last step holds if <math id="A4.SS1.p1.m24" class="ltx_Math" alttext="p_{a}^{-1}\text{poly}(M_{1}^{\kappa_{a}})\gtrsim l_{tr}\gtrsim(1-p_{a})^{-1}\log M_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>p</mi><mi>a</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mtext>poly</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>M</mi><mn>1</mn><msub><mi>κ</mi><mi>a</mi></msub></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>≳</mo><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo>≳</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>M</mi><mn>1</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{a}^{-1}\text{poly}(M_{1}^{\kappa_{a}})\gtrsim l_{tr}\gtrsim(1-p_{a})^{-1}\log M_{1}</annotation></semantics></math> and for <math id="A4.SS1.p1.m25" class="ltx_Math" alttext="{\bm{p}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒑</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\bm{p}}_{i}</annotation></semantics></math> that contains no <math id="A4.SS1.p1.m26" class="ltx_Math" alttext="{\bm{v}}_{s}^{*}" display="inline" intent=":literal"><semantics><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">{\bm{v}}_{s}^{*}</annotation></semantics></math>, <math id="A4.SS1.p1.m27" class="ltx_Math" alttext="\sigma({{\bm{w}}^{(T)}}^{\top}{\bm{p}}_{i})\in(0,1/2)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\sigma({{\bm{w}}^{(T)}}^{\top}{\bm{p}}_{i})\in(0,1/2)</annotation></semantics></math>.
Similarly, we can also derive that for <math id="A4.SS1.p1.m28" class="ltx_Math" alttext="{\bm{P}}" display="inline" intent=":literal"><semantics><mi>𝑷</mi><annotation encoding="application/x-tex">{\bm{P}}</annotation></semantics></math> with <math id="A4.SS1.p1.m29" class="ltx_Math" alttext="z=-1" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>=</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">z=-1</annotation></semantics></math>, we have</span></p>
<table id="A4.E48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E48.m1" class="ltx_Math" alttext="F(\Psi^{(T)},{\bm{P}})&lt;-1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>𝑷</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">F(\Psi^{(T)},{\bm{P}})&lt;-1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(48)</span></td></tr></tbody>
</table>
<p id="A4.SS1.p1.12" class="ltx_p"><span id="A4.SS1.p1.12.1" class="ltx_text ltx_font_bold">Then, we study the generalization error.<span id="A4.SS1.p1.12.1.1" class="ltx_text ltx_font_medium"> By (<a href="#A4.E40" title="In Proof. ‣ D.1 Proof of Theorem ‣ Appendix D Proof of Main Theorems ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">40</span></a>), for any given testing prompt embedding <math id="A4.SS1.p1.m30" class="ltx_Math" alttext="{\bm{P}}" display="inline" intent=":literal"><semantics><mi>𝑷</mi><annotation encoding="application/x-tex">{\bm{P}}</annotation></semantics></math> with <math id="A4.SS1.p1.m31" class="ltx_Math" alttext="z=+1" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>=</mo><mrow><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">z=+1</annotation></semantics></math>, we have that with a high probability of <math id="A4.SS1.p1.m32" class="ltx_Math" alttext="1-\epsilon" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><annotation encoding="application/x-tex">1-\epsilon</annotation></semantics></math>,</span></span></p>
<table id="A4.E49" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E49.m1" class="ltx_Math" alttext="F(\Psi^{(T)};{\bm{P}})\geq 1-\epsilon," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>𝑷</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">F(\Psi^{(T)};{\bm{P}})\geq 1-\epsilon,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(49)</span></td></tr></tbody>
</table>
<p id="A4.SS1.p1.13" class="ltx_p"><span id="A4.SS1.p1.13.1" class="ltx_text">and if <math id="A4.SS1.p1.m33" class="ltx_Math" alttext="z=-1" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>=</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">z=-1</annotation></semantics></math>,</span></p>
<table id="A4.E50" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E50.m1" class="ltx_Math" alttext="F(\Psi^{(T)};{\bm{P}})\leq-1+\epsilon." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>𝑷</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>+</mo><mi>ϵ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">F(\Psi^{(T)};{\bm{P}})\leq-1+\epsilon.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(50)</span></td></tr></tbody>
</table>
<p id="A4.SS1.p1.14" class="ltx_p"><span id="A4.SS1.p1.14.1" class="ltx_text">Therefore,</span></p>
<table id="A4.E51" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E51.m1" class="ltx_Math" alttext="\mathbb{E}_{f\in\mathcal{T},{\bm{P}}\sim\mathcal{D}}[\ell(\Psi^{(T)};{\bm{P}},z)]\leq\epsilon." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mrow><mrow><mi>f</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow><mo>,</mo><mrow><mi>𝑷</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>𝑷</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mi>ϵ</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}_{f\in\mathcal{T},{\bm{P}}\sim\mathcal{D}}[\ell(\Psi^{(T)};{\bm{P}},z)]\leq\epsilon.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(51)</span></td></tr></tbody>
</table>
</div>
<div id="A4.SS1.p2" class="ltx_para">
<p id="A4.SS1.p2.1" class="ltx_p"><span id="A4.SS1.p2.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.2 </span>Proof of Theorem <a href="#Thmthm2" title="Theorem 2. ‣ 3.3 Learning, Generalization, and Sample Complexity Analysis of Mamba ‣ 3 Main Theoretical Results ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a></h3>

<div id="A4.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS2.p1" class="ltx_para">
<p id="A4.SS2.p1.2" class="ltx_p"><span id="A4.SS2.p1.2.1" class="ltx_text">By Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ Appendix C Key Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, we have that for any <math id="A4.SS2.p1.m1" class="ltx_Math" alttext="j\in[M_{1}]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[M_{1}]</annotation></semantics></math> and <math id="A4.SS2.p1.m2" class="ltx_Math" alttext="k\neq k^{\prime}\in[M_{2}]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≠</mo><msup><mi>k</mi><mo>′</mo></msup><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mn>2</mn></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k\neq k^{\prime}\in[M_{2}]</annotation></semantics></math>,</span></p>
<table id="A4.E52" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E52X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E52X.m2" class="ltx_Math" alttext="\displaystyle({{\bm{\nu}}_{k}}^{\top},0^{\top}){\bm{W}}^{(T)}({{\bm{\mu}}_{j}}^{\top},0^{\top})^{\top}\lesssim\frac{\epsilon(1-p_{a})^{-1}\beta^{-1}}{M_{2}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝝂</mi><mi>k</mi><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝝁</mi><mi>j</mi><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>≲</mo><mstyle displaystyle="true"><mfrac><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><msub><mi>M</mi><mn>2</mn></msub></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle({{\bm{\nu}}_{k}}^{\top},0^{\top}){\bm{W}}^{(T)}({{\bm{\mu}}_{j}}^{\top},0^{\top})^{\top}\lesssim\frac{\epsilon(1-p_{a})^{-1}\beta^{-1}}{M_{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(52)</span></td></tr></tbody>
</table>
<table id="A4.E53" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E53X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E53X.m2" class="ltx_Math" alttext="\displaystyle({{\bm{\mu}}_{j}}^{\top},0^{\top}){\bm{W}}^{(T)}({{\bm{\nu}}_{k}}^{\top},0^{\top})^{\top}\lesssim\frac{\epsilon(1-p_{a})^{-1}\beta^{-1}}{M_{2}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝝁</mi><mi>j</mi><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝝂</mi><mi>k</mi><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>≲</mo><mstyle displaystyle="true"><mfrac><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><msub><mi>M</mi><mn>2</mn></msub></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle({{\bm{\mu}}_{j}}^{\top},0^{\top}){\bm{W}}^{(T)}({{\bm{\nu}}_{k}}^{\top},0^{\top})^{\top}\lesssim\frac{\epsilon(1-p_{a})^{-1}\beta^{-1}}{M_{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(53)</span></td></tr></tbody>
</table>
<table id="A4.E54" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E54X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E54X.m2" class="ltx_Math" alttext="\displaystyle({{\bm{\nu}}_{k}}^{\top},0^{\top}){\bm{W}}^{(T)}({{\bm{\nu}}_{k}}^{\top},0^{\top})^{\top}\lesssim\frac{\epsilon(1-p_{a})^{-1}\beta^{-1}M_{1}}{M_{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝝂</mi><mi>k</mi><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝝂</mi><mi>k</mi><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>≲</mo><mstyle displaystyle="true"><mfrac><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub></mrow><msub><mi>M</mi><mn>2</mn></msub></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle({{\bm{\nu}}_{k}}^{\top},0^{\top}){\bm{W}}^{(T)}({{\bm{\nu}}_{k}}^{\top},0^{\top})^{\top}\lesssim\frac{\epsilon(1-p_{a})^{-1}\beta^{-1}M_{1}}{M_{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(54)</span></td></tr></tbody>
</table>
<table id="A4.E55" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E55X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E55X.m2" class="ltx_Math" alttext="\displaystyle({{\bm{\nu}}_{k}}^{\top},0^{\top}){\bm{W}}^{(T)}({{\bm{\nu}}_{k^{\prime}}}^{\top},0^{\top})^{\top}\lesssim\frac{\epsilon(1-p_{a})^{-1}\beta^{-1}M_{1}}{M_{2}^{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝝂</mi><mi>k</mi><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝝂</mi><msup><mi>k</mi><mo>′</mo></msup><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>≲</mo><mstyle displaystyle="true"><mfrac><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub></mrow><msubsup><mi>M</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle({{\bm{\nu}}_{k}}^{\top},0^{\top}){\bm{W}}^{(T)}({{\bm{\nu}}_{k^{\prime}}}^{\top},0^{\top})^{\top}\lesssim\frac{\epsilon(1-p_{a})^{-1}\beta^{-1}M_{1}}{M_{2}^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(55)</span></td></tr></tbody>
</table>
<p id="A4.SS2.p1.3" class="ltx_p"><span id="A4.SS2.p1.3.1" class="ltx_text">Meanwhile, we have that for <math id="A4.SS2.p1.m3" class="ltx_Math" alttext="{{\bm{v}}_{s}^{*}}^{\prime}\in\mathcal{V}^{\prime}" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mi>𝒗</mi><mi>s</mi><mo>∗</mo><mrow></mrow><mo>′</mo></mmultiscripts><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">{{\bm{v}}_{s}^{*}}^{\prime}\in\mathcal{V}^{\prime}</annotation></semantics></math> with <math id="A4.SS2.p1.m4" class="ltx_Math" alttext="{{\bm{v}}_{s}^{*}}^{\prime}=\sum_{i=1}^{V}\lambda_{i}{\bm{v}}_{s}^{*}" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mi>𝒗</mi><mi>s</mi><mo>∗</mo><mrow></mrow><mo>′</mo></mmultiscripts><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>V</mi></msubsup><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">{{\bm{v}}_{s}^{*}}^{\prime}=\sum_{i=1}^{V}\lambda_{i}{\bm{v}}_{s}^{*}</annotation></semantics></math>,</span></p>
<table id="A4.E56" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E56X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E56X.m2" class="ltx_Math" alttext="\displaystyle({{{\bm{v}}_{s}^{\prime}}^{*}}^{\top},0^{\top}){\bm{W}}^{(T)}({{\bm{\mu}}_{j}}^{\top},0^{\top})^{\top}\lesssim\epsilon(1-p_{a})^{-1}p_{a}\kappa_{a}V^{-1}\beta^{-1}\cdot L." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝒗</mi><mi>s</mi><mo>′</mo><mrow></mrow><mo>∗</mo><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝝁</mi><mi>j</mi><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>≲</mo><mrow><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>L</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle({{{\bm{v}}_{s}^{\prime}}^{*}}^{\top},0^{\top}){\bm{W}}^{(T)}({{\bm{\mu}}_{j}}^{\top},0^{\top})^{\top}\lesssim\epsilon(1-p_{a})^{-1}p_{a}\kappa_{a}V^{-1}\beta^{-1}\cdot L.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(56)</span></td></tr></tbody>
</table>
<p id="A4.SS2.p1.4" class="ltx_p"><span id="A4.SS2.p1.4.1" class="ltx_text">Therefore, we have that for <math id="A4.SS2.p1.m5" class="ltx_Math" alttext="{\bm{p}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒑</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\bm{p}}_{i}</annotation></semantics></math> that shares the same pattern as the query,</span></p>
<table id="A4.E57" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E57.m1" class="ltx_Math" alttext="{\bm{p}}_{i}^{\top}{{\bm{W}}_{B}^{(T)}}^{\top}{\bm{W}}_{C}^{(T)}{\bm{p}}_{query}\gtrsim 1-\epsilon(1-p_{a})^{-1}\cdot\frac{1}{M_{2}}-\epsilon(1-p_{a})^{-1}p_{a}V^{-1}\kappa_{a}\beta^{-1}\cdot\kappa_{a}^{\prime}L." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>𝒑</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝑾</mi><mi>B</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>C</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub></mrow><mo>≳</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo rspace="0.222em">⋅</mo><mfrac><mn>1</mn><msub><mi>M</mi><mn>2</mn></msub></mfrac></mrow><mo>−</mo><mrow><mrow><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>κ</mi><mi>a</mi><mo>′</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\bm{p}}_{i}^{\top}{{\bm{W}}_{B}^{(T)}}^{\top}{\bm{W}}_{C}^{(T)}{\bm{p}}_{query}\gtrsim 1-\epsilon(1-p_{a})^{-1}\cdot\frac{1}{M_{2}}-\epsilon(1-p_{a})^{-1}p_{a}V^{-1}\kappa_{a}\beta^{-1}\cdot\kappa_{a}^{\prime}L.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(57)</span></td></tr></tbody>
</table>
<p id="A4.SS2.p1.5" class="ltx_p"><span id="A4.SS2.p1.5.1" class="ltx_text">For <math id="A4.SS2.p1.m6" class="ltx_Math" alttext="{\bm{p}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒑</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\bm{p}}_{i}</annotation></semantics></math> that shares a different pattern from the query, we have</span></p>
<table id="A4.E58" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E58.m1" class="ltx_Math" alttext="|{\bm{p}}_{i}^{\top}{{\bm{W}}_{B}^{(T)}}^{\top}{\bm{W}}_{C}^{(T)}{\bm{p}}_{query}|\lesssim\epsilon(1+(1-p_{a})^{-1}/M_{2}+(1-p_{a})^{-1}p_{a}V^{-1}\kappa_{a}\beta^{-1}\cdot\kappa_{a}^{\prime}L)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><msubsup><mi>𝒑</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝑾</mi><mi>B</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>C</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub></mrow><mo stretchy="false">|</mo></mrow><mo>≲</mo><mrow><mi>ϵ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>/</mo><msub><mi>M</mi><mn>2</mn></msub></mrow><mo>+</mo><mrow><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>κ</mi><mi>a</mi><mo>′</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|{\bm{p}}_{i}^{\top}{{\bm{W}}_{B}^{(T)}}^{\top}{\bm{W}}_{C}^{(T)}{\bm{p}}_{query}|\lesssim\epsilon(1+(1-p_{a})^{-1}/M_{2}+(1-p_{a})^{-1}p_{a}V^{-1}\kappa_{a}\beta^{-1}\cdot\kappa_{a}^{\prime}L).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(58)</span></td></tr></tbody>
</table>
<p id="A4.SS2.p1.6" class="ltx_p"><span id="A4.SS2.p1.6.1" class="ltx_text">Meanwhile, for <math id="A4.SS2.p1.m7" class="ltx_Math" alttext="{\bm{p}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒑</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\bm{p}}_{i}</annotation></semantics></math> that contains a <math id="A4.SS2.p1.m8" class="ltx_Math" alttext="{{\bm{v}}^{*}_{s}}^{\prime}\in\mathcal{V}^{\prime}" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mi>𝒗</mi><mi>s</mi><mo>∗</mo><mrow></mrow><mo>′</mo></mmultiscripts><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">{{\bm{v}}^{*}_{s}}^{\prime}\in\mathcal{V}^{\prime}</annotation></semantics></math>, we have</span></p>
<table id="A4.E59" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E59.m1" class="ltx_Math" alttext="G_{i,l+1}({\bm{w}}^{(T)})\leq\sigma({{\bm{w}}^{(T)}}^{\top}{\bm{p}}_{i})\lesssim O(\text{poly}(M_{1}^{\kappa_{a}^{\prime}})^{-1})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≲</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>poly</mtext><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>M</mi><mn>1</mn><msubsup><mi>κ</mi><mi>a</mi><mo>′</mo></msubsup></msubsup><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">G_{i,l+1}({\bm{w}}^{(T)})\leq\sigma({{\bm{w}}^{(T)}}^{\top}{\bm{p}}_{i})\lesssim O(\text{poly}(M_{1}^{\kappa_{a}^{\prime}})^{-1}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(59)</span></td></tr></tbody>
</table>
<p id="A4.SS2.p1.7" class="ltx_p"><span id="A4.SS2.p1.7.1" class="ltx_text">by Lemma <a href="#Thmlemma5" title="Lemma 5. ‣ Appendix C Key Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>. We have that for the <math id="A4.SS2.p1.m9" class="ltx_Math" alttext="{\bm{p}}_{i^{*}}" display="inline" intent=":literal"><semantics><msub><mi>𝒑</mi><msup><mi>i</mi><mo>∗</mo></msup></msub><annotation encoding="application/x-tex">{\bm{p}}_{i^{*}}</annotation></semantics></math> that does not contain any <math id="A4.SS2.p1.m10" class="ltx_Math" alttext="{{\bm{v}}^{*}_{s}}^{\prime}\in\mathcal{V}^{\prime}" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mi>𝒗</mi><mi>s</mi><mo>∗</mo><mrow></mrow><mo>′</mo></mmultiscripts><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">{{\bm{v}}^{*}_{s}}^{\prime}\in\mathcal{V}^{\prime}</annotation></semantics></math> and is the closest to the query, by Lemma <a href="#Thmlemma5" title="Lemma 5. ‣ Appendix C Key Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>,</span></p>
<table id="A4.E60" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E60X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E60X.m2" class="ltx_Math" alttext="\displaystyle G_{i^{*},l+1}({\bm{w}}^{(T)})\gtrsim" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>G</mi><mrow><msup><mi>i</mi><mo>∗</mo></msup><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≳</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle G_{i^{*},l+1}({\bm{w}}^{(T)})\gtrsim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E60X.m3" class="ltx_Math" alttext="\displaystyle(1-\frac{1}{\text{poly}(M_{1}^{\kappa_{a}^{\prime}})})^{l_{ts}\alpha}\sigma({{\bm{w}}^{(T)}}^{\top}{\bm{p}}_{i^{*}})" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mtext>poly</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>M</mi><mn>1</mn><msubsup><mi>κ</mi><mi>a</mi><mo>′</mo></msubsup></msubsup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mrow><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><msup><mi>i</mi><mo>∗</mo></msup></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(1-\frac{1}{\text{poly}(M_{1}^{\kappa_{a}^{\prime}})})^{l_{ts}\alpha}\sigma({{\bm{w}}^{(T)}}^{\top}{\bm{p}}_{i^{*}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(60)</span></td></tr>
<tr id="A4.E60Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E60Xa.m2" class="ltx_Math" alttext="\displaystyle\gtrsim" display="inline" intent=":literal"><semantics><mo>≳</mo><annotation encoding="application/x-tex">\displaystyle\gtrsim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E60Xa.m3" class="ltx_Math" alttext="\displaystyle(1-\frac{l_{ts}\alpha}{\text{poly}(M_{1}^{\kappa_{a}^{\prime}})})." display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mrow><mtext>poly</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>M</mi><mn>1</mn><msubsup><mi>κ</mi><mi>a</mi><mo>′</mo></msubsup></msubsup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle(1-\frac{l_{ts}\alpha}{\text{poly}(M_{1}^{\kappa_{a}^{\prime}})}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.p1.8" class="ltx_p"><span id="A4.SS2.p1.8.1" class="ltx_text">Hence, for <math id="A4.SS2.p1.m11" class="ltx_Math" alttext="{\bm{P}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝑷</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\bm{P}}^{\prime}</annotation></semantics></math> with <math id="A4.SS2.p1.m12" class="ltx_Math" alttext="z=+1" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>=</mo><mrow><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">z=+1</annotation></semantics></math>, with a high probability, we have</span></p>
<table id="A4.E61" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E61X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E61X.m2" class="ltx_Math" alttext="\displaystyle F(\Psi^{(T)},g({\bm{P}}^{\prime}))" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝑷</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle F(\Psi^{(T)},g({\bm{P}}^{\prime}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="9" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(61)</span></td></tr>
<tr id="A4.E61Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E61Xa.m2" class="ltx_Math" alttext="\displaystyle\geq" display="inline" intent=":literal"><semantics><mo>≥</mo><annotation encoding="application/x-tex">\displaystyle\geq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E61Xa.m3" class="ltx_Math" alttext="\displaystyle(1-(1-p_{a})^{-1}\epsilon/M_{2}-\epsilon(1-p_{a})^{-1}p_{a}V^{-1}\kappa_{a}\beta^{-1}\cdot\kappa_{a}^{\prime}L)\cdot\sum_{i=1}^{l_{ts}(1-\alpha)-1}(1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mo>/</mo><msub><mi>M</mi><mn>2</mn></msub></mrow><mo>−</mo><mrow><mrow><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>κ</mi><mi>a</mi><mo>′</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mrow><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo stretchy="false">(</mo><mn>1</mn><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(1-(1-p_{a})^{-1}\epsilon/M_{2}-\epsilon(1-p_{a})^{-1}p_{a}V^{-1}\kappa_{a}\beta^{-1}\cdot\kappa_{a}^{\prime}L)\cdot\sum_{i=1}^{l_{ts}(1-\alpha)-1}(1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A4.E61Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E61Xb.m2" class="ltx_Math" alttext="\displaystyle-\max_{{\bm{p}}_{i}\text{ contains no }{\bm{v}}_{s}^{*}\in\mathcal{V}^{\prime}}\{\sigma({{\bm{w}}^{(T)}}^{\top}{\bm{p}}_{i}^{\prime})\})^{i-1}\cdot\min_{{\bm{p}}_{i}\text{ contains no }{\bm{v}}_{s}^{*}\in\mathcal{V}^{\prime}}\{\sigma({{\bm{w}}^{(T)}}^{\top}{\bm{p}}_{i}^{\prime})\}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mo rspace="0.167em">−</mo><mrow><munder><mi>max</mi><mrow><mrow><msub><mi>𝒑</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mtext> contains no </mtext><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>′</mo></msup></mrow></munder><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>i</mi><mo>′</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><munder><mi>min</mi><mrow><mrow><msub><mi>𝒑</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mtext> contains no </mtext><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>′</mo></msup></mrow></munder><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>i</mi><mo>′</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\max_{{\bm{p}}_{i}\text{ contains no }{\bm{v}}_{s}^{*}\in\mathcal{V}^{\prime}}\{\sigma({{\bm{w}}^{(T)}}^{\top}{\bm{p}}_{i}^{\prime})\})^{i-1}\cdot\min_{{\bm{p}}_{i}\text{ contains no }{\bm{v}}_{s}^{*}\in\mathcal{V}^{\prime}}\{\sigma({{\bm{w}}^{(T)}}^{\top}{\bm{p}}_{i}^{\prime})\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A4.E61Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E61Xc.m2" class="ltx_Math" alttext="\displaystyle\geq" display="inline" intent=":literal"><semantics><mo>≥</mo><annotation encoding="application/x-tex">\displaystyle\geq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E61Xc.m3" class="ltx_Math" alttext="\displaystyle\Theta((1-(1-p_{a})^{-1}\epsilon/M_{2}-\epsilon(1-p_{a})^{-1}p_{a}V^{-1}\kappa_{a}\beta^{-1}\cdot(\kappa_{a}+\kappa_{a}^{\prime}L-\kappa_{a}))" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mo>/</mo><msub><mi>M</mi><mn>2</mn></msub></mrow><mo>−</mo><mrow><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>κ</mi><mi>a</mi></msub><mo>+</mo><mrow><msubsup><mi>κ</mi><mi>a</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><mo>−</mo><msub><mi>κ</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Theta((1-(1-p_{a})^{-1}\epsilon/M_{2}-\epsilon(1-p_{a})^{-1}p_{a}V^{-1}\kappa_{a}\beta^{-1}\cdot(\kappa_{a}+\kappa_{a}^{\prime}L-\kappa_{a}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A4.E61Xd" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E61Xd.m2" class="ltx_Math" alttext="\displaystyle\cdot(1-\frac{l_{ts}\alpha}{\text{poly}(M_{1}^{\kappa_{a}^{\prime}})}))" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.222em">⋅</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mrow><mtext>poly</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>M</mi><mn>1</mn><msubsup><mi>κ</mi><mi>a</mi><mo>′</mo></msubsup></msubsup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\cdot(1-\frac{l_{ts}\alpha}{\text{poly}(M_{1}^{\kappa_{a}^{\prime}})}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A4.E61Xe" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E61Xe.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E61Xe.m3" class="ltx_Math" alttext="\displaystyle\Theta((1-\epsilon(1-p_{a})^{-1}p_{a}V^{-1}\kappa_{a}\beta^{-1}\cdot(\kappa_{a}^{\prime}L-\kappa_{a}))(1-\frac{l_{tr}p_{a}}{\text{poly}(M_{1}^{\kappa_{a}})})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>κ</mi><mi>a</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>−</mo><msub><mi>κ</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mrow><mtext>poly</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>M</mi><mn>1</mn><msub><mi>κ</mi><mi>a</mi></msub></msubsup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Theta((1-\epsilon(1-p_{a})^{-1}p_{a}V^{-1}\kappa_{a}\beta^{-1}\cdot(\kappa_{a}^{\prime}L-\kappa_{a}))(1-\frac{l_{tr}p_{a}}{\text{poly}(M_{1}^{\kappa_{a}})})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A4.E61Xf" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E61Xf.m2" class="ltx_Math" alttext="\displaystyle\cdot(1-\frac{\frac{l_{ts}\alpha}{\text{poly}(M_{1}^{\kappa_{a}^{\prime}})}-\frac{l_{tr}p_{a}}{\text{poly}(M_{1}^{\kappa_{a}})}}{1-\frac{l_{tr}p_{a}}{\text{poly}(M_{1}^{\kappa_{a}})}}))" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.222em">⋅</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mfrac><mrow><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mrow><mtext>poly</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>M</mi><mn>1</mn><msubsup><mi>κ</mi><mi>a</mi><mo>′</mo></msubsup></msubsup><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>−</mo><mfrac><mrow><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mrow><mtext>poly</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>M</mi><mn>1</mn><msub><mi>κ</mi><mi>a</mi></msub></msubsup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mrow><mtext>poly</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>M</mi><mn>1</mn><msub><mi>κ</mi><mi>a</mi></msub></msubsup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mfrac></mstyle><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\cdot(1-\frac{\frac{l_{ts}\alpha}{\text{poly}(M_{1}^{\kappa_{a}^{\prime}})}-\frac{l_{tr}p_{a}}{\text{poly}(M_{1}^{\kappa_{a}})}}{1-\frac{l_{tr}p_{a}}{\text{poly}(M_{1}^{\kappa_{a}})}}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A4.E61Xg" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E61Xg.m2" class="ltx_Math" alttext="\displaystyle\geq" display="inline" intent=":literal"><semantics><mo>≥</mo><annotation encoding="application/x-tex">\displaystyle\geq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E61Xg.m3" class="ltx_Math" alttext="\displaystyle\Theta(1-\epsilon(1-p_{a})^{-1}p_{a}V^{-1}\kappa_{a}\beta^{-1}\cdot(\kappa_{a}^{\prime}L-\kappa_{a})-(\frac{l_{ts}\alpha}{\text{poly}(M_{1}^{\kappa_{a}^{\prime}})}-\frac{l_{tr}p_{a}}{\text{poly}(M_{1}^{\kappa_{a}})}))" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>κ</mi><mi>a</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>−</mo><msub><mi>κ</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mrow><mtext>poly</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>M</mi><mn>1</mn><msubsup><mi>κ</mi><mi>a</mi><mo>′</mo></msubsup></msubsup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mrow><mtext>poly</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>M</mi><mn>1</mn><msub><mi>κ</mi><mi>a</mi></msub></msubsup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Theta(1-\epsilon(1-p_{a})^{-1}p_{a}V^{-1}\kappa_{a}\beta^{-1}\cdot(\kappa_{a}^{\prime}L-\kappa_{a})-(\frac{l_{ts}\alpha}{\text{poly}(M_{1}^{\kappa_{a}^{\prime}})}-\frac{l_{tr}p_{a}}{\text{poly}(M_{1}^{\kappa_{a}})}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A4.E61Xh" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E61Xh.m2" class="ltx_Math" alttext="\displaystyle\geq" display="inline" intent=":literal"><semantics><mo>≥</mo><annotation encoding="application/x-tex">\displaystyle\geq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E61Xh.m3" class="ltx_Math" alttext="\displaystyle 1-(\epsilon(1-p_{a})^{-1}p_{a}V^{-1}\kappa_{a}\beta^{-1}\cdot(\kappa_{a}^{\prime}L-\kappa_{a})+\frac{l_{ts}\alpha}{\text{poly}(M_{1}^{\kappa_{a}^{\prime}})}-\frac{l_{tr}p_{a}}{\text{poly}(M_{1}^{\kappa_{a}})})," display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>κ</mi><mi>a</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>−</mo><msub><mi>κ</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mrow><mtext>poly</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>M</mi><mn>1</mn><msubsup><mi>κ</mi><mi>a</mi><mo>′</mo></msubsup></msubsup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mrow><mtext>poly</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>M</mi><mn>1</mn><msub><mi>κ</mi><mi>a</mi></msub></msubsup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle 1-(\epsilon(1-p_{a})^{-1}p_{a}V^{-1}\kappa_{a}\beta^{-1}\cdot(\kappa_{a}^{\prime}L-\kappa_{a})+\frac{l_{ts}\alpha}{\text{poly}(M_{1}^{\kappa_{a}^{\prime}})}-\frac{l_{tr}p_{a}}{\text{poly}(M_{1}^{\kappa_{a}})}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.p1.9" class="ltx_p"><span id="A4.SS2.p1.9.1" class="ltx_text">where we consider the worst-case order that makes all examples that contain <math id="A4.SS2.p1.m13" class="ltx_Math" alttext="{{\bm{v}}_{s}^{*}}^{\prime}\in\mathcal{V}^{\prime}" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mi>𝒗</mi><mi>s</mi><mo>∗</mo><mrow></mrow><mo>′</mo></mmultiscripts><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">{{\bm{v}}_{s}^{*}}^{\prime}\in\mathcal{V}^{\prime}</annotation></semantics></math> right before the query, such that there is a scaling of <math id="A4.SS2.p1.m14" class="ltx_Math" alttext="1-\frac{l_{ts}\alpha}{\text{poly}(M_{1}^{\kappa_{a}^{\prime}})}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mrow><mtext>poly</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>M</mi><mn>1</mn><msubsup><mi>κ</mi><mi>a</mi><mo>′</mo></msubsup></msubsup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">1-\frac{l_{ts}\alpha}{\text{poly}(M_{1}^{\kappa_{a}^{\prime}})}</annotation></semantics></math> in the second step. The trained model still selects examples with the same pattern as the query no matter whether there is a certain <math id="A4.SS2.p1.m15" class="ltx_Math" alttext="{{\bm{v}}_{s}^{\prime}}^{*}" display="inline" intent=":literal"><semantics><mmultiscripts><mi>𝒗</mi><mi>s</mi><mo>′</mo><mrow></mrow><mo>∗</mo></mmultiscripts><annotation encoding="application/x-tex">{{\bm{v}}_{s}^{\prime}}^{*}</annotation></semantics></math> added to the token if <math id="A4.SS2.p1.m16" class="ltx_Math" alttext="\kappa_{a}^{\prime}\lesssim V\beta{p_{a}}^{-1}(1-p_{a})\kappa_{a}^{-1}L^{-1}\epsilon^{-1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>κ</mi><mi>a</mi><mo>′</mo></msubsup><mo>≲</mo><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>p</mi><mi>a</mi><mrow></mrow><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\kappa_{a}^{\prime}\lesssim V\beta{p_{a}}^{-1}(1-p_{a})\kappa_{a}^{-1}L^{-1}\epsilon^{-1}</annotation></semantics></math>. Then, flipping the labels of examples with any of <math id="A4.SS2.p1.m17" class="ltx_Math" alttext="{{\bm{v}}_{s}^{\prime}}^{*}" display="inline" intent=":literal"><semantics><mmultiscripts><mi>𝒗</mi><mi>s</mi><mo>′</mo><mrow></mrow><mo>∗</mo></mmultiscripts><annotation encoding="application/x-tex">{{\bm{v}}_{s}^{\prime}}^{*}</annotation></semantics></math> can change the model output the most. If <math id="A4.SS2.p1.m18" class="ltx_Math" alttext="l_{ts}\leq{\alpha}^{-1}\text{poly}(M_{1}^{\kappa_{a}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><mo>≤</mo><mrow><msup><mi>α</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mtext>poly</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>M</mi><mn>1</mn><msub><mi>κ</mi><mi>a</mi></msub></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">l_{ts}\leq{\alpha}^{-1}\text{poly}(M_{1}^{\kappa_{a}})</annotation></semantics></math>, <math id="A4.SS2.p1.m19" class="ltx_Math" alttext="\kappa_{a}\leq\kappa_{a}^{\prime}\leq\Theta(L^{-1}(\kappa_{a}+V\beta{p_{a}}^{-1}(1-p_{a})\kappa_{a}^{-1}\epsilon^{-1}))" display="inline" intent=":literal"><semantics><mrow><msub><mi>κ</mi><mi>a</mi></msub><mo>≤</mo><msubsup><mi>κ</mi><mi>a</mi><mo>′</mo></msubsup><mo>≤</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>L</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>κ</mi><mi>a</mi></msub><mo>+</mo><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>p</mi><mi>a</mi><mrow></mrow><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\kappa_{a}\leq\kappa_{a}^{\prime}\leq\Theta(L^{-1}(\kappa_{a}+V\beta{p_{a}}^{-1}(1-p_{a})\kappa_{a}^{-1}\epsilon^{-1}))</annotation></semantics></math>, <math id="A4.SS2.p1.m20" class="ltx_Math" alttext="\alpha\leq\min\{1,p_{a}\cdot l_{tr}/l_{ts}\}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≤</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mrow><mrow><msub><mi>p</mi><mi>a</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></mrow><mo>/</mo><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\alpha\leq\min\{1,p_{a}\cdot l_{tr}/l_{ts}\}</annotation></semantics></math>, we have that that with a high probability,</span></p>
<table id="A4.E62" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E62.m1" class="ltx_Math" alttext="F(\Psi^{(T)},g({\bm{P}}^{\prime}))&gt;0" display="block" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝑷</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">F(\Psi^{(T)},g({\bm{P}}^{\prime}))&gt;0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(62)</span></td></tr></tbody>
</table>
<p id="A4.SS2.p1.10" class="ltx_p"><span id="A4.SS2.p1.10.1" class="ltx_text">Therefore, we can derive that</span></p>
<table id="A4.E63" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E63.m1" class="ltx_Math" alttext="L_{{\bm{P}}^{\prime}\sim\mathcal{D}^{\prime},f\in\mathcal{T}}^{0-1}(\Psi^{(T)};{\bm{P}}^{\prime},z)\leq\epsilon." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>L</mi><mrow><mrow><msup><mi>𝑷</mi><mo>′</mo></msup><mo>∼</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>′</mo></msup></mrow><mo>,</mo><mrow><mi>f</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></mrow><mrow><mn>0</mn><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mo>′</mo></msup><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>ϵ</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">L_{{\bm{P}}^{\prime}\sim\mathcal{D}^{\prime},f\in\mathcal{T}}^{0-1}(\Psi^{(T)};{\bm{P}}^{\prime},z)\leq\epsilon.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(63)</span></td></tr></tbody>
</table>
</div>
<div id="A4.SS2.p2" class="ltx_para">
<p id="A4.SS2.p2.1" class="ltx_p"><span id="A4.SS2.p2.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A4.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.3 </span>Proof of Theorem <a href="#Thmthm3" title="Theorem 3. ‣ 3.4 A Theoretical Comparison between Linear Transformers and Mamba ‣ 3 Main Theoretical Results ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a></h3>

<div id="A4.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS3.p1" class="ltx_para">
<p id="A4.SS3.p1.1" class="ltx_p"><span id="A4.SS3.p1.1.1" class="ltx_text">By the Chernoff bound of Bernoulli distribution in Lemma <a href="#Thmlemma1" title="Lemma 1. ‣ Appendix C Key Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, we can obtain that for any <math id="A4.SS3.p1.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> and <math id="A4.SS3.p1.m2" class="ltx_Math" alttext="s\in[V]" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>V</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">s\in[V]</annotation></semantics></math>,</span></p>
<table id="A4.E64" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E64.m1" class="ltx_Math" alttext="\Pr\left(\frac{1}{l}\sum_{i=1}^{l}\mathbbm{1}[{\bm{p}}_{i}^{n}\text{ contains }{\bm{\mu}}_{a}\text{ and no any }{\bm{v}}^{*}_{s}]\leq(1-c)(1-p_{a})\frac{1}{2}\right)\leq e^{-lc^{2}\frac{(1-p_{a})}{2}}=\epsilon," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mfrac><mn>1</mn><mi>l</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>l</mi></munderover><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝒑</mi><mi>i</mi><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mtext> contains </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><mtext> and no any </mtext><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>c</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></mfrac></mrow></mrow></msup><mo>=</mo><mi>ϵ</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\Pr\left(\frac{1}{l}\sum_{i=1}^{l}\mathbbm{1}[{\bm{p}}_{i}^{n}\text{ contains }{\bm{\mu}}_{a}\text{ and no any }{\bm{v}}^{*}_{s}]\leq(1-c)(1-p_{a})\frac{1}{2}\right)\leq e^{-lc^{2}\frac{(1-p_{a})}{2}}=\epsilon,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(64)</span></td></tr></tbody>
</table>
<p id="A4.SS3.p1.2" class="ltx_p"><span id="A4.SS3.p1.2.1" class="ltx_text">for some <math id="A4.SS3.p1.m3" class="ltx_Math" alttext="c\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">c\in(0,1)</annotation></semantics></math>. Hence, with a high probability,</span></p>
<table id="A4.E65" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E65.m1" class="ltx_Math" alttext="l\gtrsim(1-p_{a})^{-1}\log\epsilon^{-1}." display="block" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>≳</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">l\gtrsim(1-p_{a})^{-1}\log\epsilon^{-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(65)</span></td></tr></tbody>
</table>
<p id="A4.SS3.p1.3" class="ltx_p"><span id="A4.SS3.p1.3.1" class="ltx_text">We know that there exists gradient noise caused by imbalanced patterns in each batchTherefore, by Hoeffding’s inequality (<a href="#A3.E22" title="In Lemma 2. ‣ Appendix C Key Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>), for any <math id="A4.SS3.p1.m4" class="ltx_Math" alttext="{\bm{W}}\in\{{\bm{W}}_{Q},{\bm{W}}_{K}\}" display="inline" intent=":literal"><semantics><mrow><mi>𝑾</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><msub><mi>𝑾</mi><mi>Q</mi></msub><mo>,</mo><msub><mi>𝑾</mi><mi>K</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{W}}\in\{{\bm{W}}_{Q},{\bm{W}}_{K}\}</annotation></semantics></math>,</span></p>
<table id="A4.E66" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E66.m1" class="ltx_Math" alttext="\Pr\left(\Big\|\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\partial\ell(\Psi;{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}}-\mathbb{E}\left[\frac{\partial\ell(\Psi;{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}}\right]\Big\|\geq\Big|\mathbb{E}\left[\frac{\partial\ell(\Psi;{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}}\right]\epsilon\right)\leq e^{-B\epsilon^{2}}\leq\epsilon," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mrow><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></munder><mfrac><mrow><mo>∂</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mi>𝑾</mi></mrow></mfrac></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mfrac><mrow><mo>∂</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mi>𝑾</mi></mrow></mfrac><mo>]</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mo>≥</mo><mphantom></mphantom></mrow><mo lspace="0em" mathsize="1.600em" rspace="0em">|</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mfrac><mrow><mo>∂</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mi>𝑾</mi></mrow></mfrac><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup></mrow></mrow></msup><mo>≤</mo><mi>ϵ</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\Pr\left(\Big\|\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\partial\ell(\Psi;{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}}-\mathbb{E}\left[\frac{\partial\ell(\Psi;{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}}\right]\Big\|\geq\Big|\mathbb{E}\left[\frac{\partial\ell(\Psi;{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}}\right]\epsilon\right)\leq e^{-B\epsilon^{2}}\leq\epsilon,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(66)</span></td></tr></tbody>
</table>
<p id="A4.SS3.p1.4" class="ltx_p"><span id="A4.SS3.p1.4.1" class="ltx_text">if <math id="A4.SS3.p1.m5" class="ltx_Math" alttext="B\gtrsim\epsilon^{-2}\log\epsilon^{-1}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>≳</mo><mrow><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">B\gtrsim\epsilon^{-2}\log\epsilon^{-1}</annotation></semantics></math>.
Therefore, we require</span></p>
<table id="A4.E67" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E67.m1" class="ltx_Math" alttext="B\gtrsim\max\{\epsilon^{-2},(1-p_{a})^{-1}M_{1}\}\log\epsilon^{-1}." display="block" intent=":literal"><semantics><mrow><mrow><mi>B</mi><mo>≳</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mrow><mo stretchy="false">{</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo>,</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">B\gtrsim\max\{\epsilon^{-2},(1-p_{a})^{-1}M_{1}\}\log\epsilon^{-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(67)</span></td></tr></tbody>
</table>
</div>
<div id="A4.SS3.p2" class="ltx_para">
<p id="A4.SS3.p2.1" class="ltx_p"><span id="A4.SS3.p2.1.1" class="ltx_text">Let <math id="A4.SS3.p2.m1" class="ltx_Math" alttext="G_{i,l+1}({\bm{w}}^{(T)})=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">G_{i,l+1}({\bm{w}}^{(T)})=1</annotation></semantics></math> for any <math id="A4.SS3.p2.m2" class="ltx_Math" alttext="i\leq l+1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≤</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">i\leq l+1</annotation></semantics></math>. Following the proof in Theorem <a href="#Thmthm1" title="Theorem 1. ‣ 3.3 Learning, Generalization, and Sample Complexity Analysis of Mamba ‣ 3 Main Theoretical Results ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, we have that when</span></p>
<table id="A4.E68" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E68.m1" class="ltx_Math" alttext="T\geq\Theta(\eta^{-1}(1-p_{a})^{-1}l_{tr}^{-1}\beta^{-1}M_{1})," display="block" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo>≥</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">T\geq\Theta(\eta^{-1}(1-p_{a})^{-1}l_{tr}^{-1}\beta^{-1}M_{1}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(68)</span></td></tr></tbody>
</table>
<p id="A4.SS3.p2.2" class="ltx_p"><span id="A4.SS3.p2.2.1" class="ltx_text">we have</span></p>
<table id="A4.E69" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E69X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E69X.m2" class="ltx_Math" alttext="\displaystyle F(\Psi^{(T)},{\bm{P}})\gtrsim" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>𝑷</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≳</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle F(\Psi^{(T)},{\bm{P}})\gtrsim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E69X.m3" class="ltx_Math" alttext="\displaystyle(1-(1-p_{a})^{-1}\epsilon/M_{2}-(1-p_{a})^{-1}p_{a}\kappa_{a}V^{-1}\beta^{-1}\epsilon)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mo>/</mo><msub><mi>M</mi><mn>2</mn></msub></mrow><mo>−</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle(1-(1-p_{a})^{-1}\epsilon/M_{2}-(1-p_{a})^{-1}p_{a}\kappa_{a}V^{-1}\beta^{-1}\epsilon)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(69)</span></td></tr>
<tr id="A4.E69Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E69Xa.m2" class="ltx_Math" alttext="\displaystyle&gt;" display="inline" intent=":literal"><semantics><mo>&gt;</mo><annotation encoding="application/x-tex">\displaystyle&gt;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E69Xa.m3" class="ltx_Math" alttext="\displaystyle 1," display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle 1,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.p2.3" class="ltx_p"><span id="A4.SS3.p2.3.1" class="ltx_text">as long as</span></p>
<table id="A4.E70" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E70.m1" class="ltx_Math" alttext="\kappa_{a}\lesssim V\beta(1-p_{a})p_{a}^{-1}\epsilon^{-1}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>κ</mi><mi>a</mi></msub><mo>≲</mo><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>p</mi><mi>a</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\kappa_{a}\lesssim V\beta(1-p_{a})p_{a}^{-1}\epsilon^{-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(70)</span></td></tr></tbody>
</table>
<p id="A4.SS3.p2.4" class="ltx_p"><span id="A4.SS3.p2.4.1" class="ltx_text">Therefore, we can derive</span></p>
<table id="A4.E71" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E71.m1" class="ltx_Math" alttext="\mathbb{E}_{f\in\mathcal{T},{\bm{P}}^{\prime}\sim\mathcal{D}^{\prime}}[\ell(\Psi^{(T)};{\bm{P}},z)]\leq\epsilon" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mrow><mrow><mi>f</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow><mo>,</mo><mrow><msup><mi>𝑷</mi><mo>′</mo></msup><mo>∼</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>′</mo></msup></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>𝑷</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mi>ϵ</mi></mrow><annotation encoding="application/x-tex">\mathbb{E}_{f\in\mathcal{T},{\bm{P}}^{\prime}\sim\mathcal{D}^{\prime}}[\ell(\Psi^{(T)};{\bm{P}},z)]\leq\epsilon</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(71)</span></td></tr></tbody>
</table>
</div>
<div id="A4.SS3.p3" class="ltx_para">
<p id="A4.SS3.p3.1" class="ltx_p"><span id="A4.SS3.p3.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A4.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.4 </span>Proof of Theorem <a href="#Thmthm4" title="Theorem 4. ‣ 3.4 A Theoretical Comparison between Linear Transformers and Mamba ‣ 3 Main Theoretical Results ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a></h3>

<div id="A4.SS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS4.p1" class="ltx_para">
<p id="A4.SS4.p1.1" class="ltx_p"><span id="A4.SS4.p1.1.1" class="ltx_text">By setting <math id="A4.SS4.p1.m1" class="ltx_Math" alttext="G_{i,l+1}({\bm{w}}^{(T)})=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">G_{i,l+1}({\bm{w}}^{(T)})=1</annotation></semantics></math> for any <math id="A4.SS4.p1.m2" class="ltx_Math" alttext="i\leq l+1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≤</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">i\leq l+1</annotation></semantics></math>, we have for any <math id="A4.SS4.p1.m3" class="ltx_Math" alttext="j\in[M_{1}]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[M_{1}]</annotation></semantics></math>, <math id="A4.SS4.p1.m4" class="ltx_Math" alttext="k^{\prime}\neq k\in[M_{2}]" display="inline" intent=":literal"><semantics><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>≠</mo><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mn>2</mn></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k^{\prime}\neq k\in[M_{2}]</annotation></semantics></math></span></p>
<table id="A4.E72" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E72X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E72X.m2" class="ltx_Math" alttext="\displaystyle({{\bm{\nu}}_{k}}^{\top},0^{\top}){\bm{W}}^{(T)}({{\bm{\mu}}_{j}}^{\top},0^{\top})^{\top}\lesssim\frac{\epsilon\beta^{-1}(1-p_{a})^{-1}l_{tr}^{-1}}{M_{2}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝝂</mi><mi>k</mi><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝝁</mi><mi>j</mi><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>≲</mo><mstyle displaystyle="true"><mfrac><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><msub><mi>M</mi><mn>2</mn></msub></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle({{\bm{\nu}}_{k}}^{\top},0^{\top}){\bm{W}}^{(T)}({{\bm{\mu}}_{j}}^{\top},0^{\top})^{\top}\lesssim\frac{\epsilon\beta^{-1}(1-p_{a})^{-1}l_{tr}^{-1}}{M_{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(72)</span></td></tr></tbody>
</table>
<table id="A4.E73" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E73X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E73X.m2" class="ltx_Math" alttext="\displaystyle({{\bm{\mu}}_{j}}^{\top},0^{\top}){\bm{W}}^{(T)}({{\bm{\nu}}_{k}}^{\top},0^{\top})^{\top}\lesssim\frac{\epsilon\beta^{-1}(1-p_{a})^{-1}l_{tr}^{-1}}{M_{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝝁</mi><mi>j</mi><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝝂</mi><mi>k</mi><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>≲</mo><mstyle displaystyle="true"><mfrac><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><msub><mi>M</mi><mn>2</mn></msub></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle({{\bm{\mu}}_{j}}^{\top},0^{\top}){\bm{W}}^{(T)}({{\bm{\nu}}_{k}}^{\top},0^{\top})^{\top}\lesssim\frac{\epsilon\beta^{-1}(1-p_{a})^{-1}l_{tr}^{-1}}{M_{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(73)</span></td></tr></tbody>
</table>
<table id="A4.E74" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E74X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E74X.m2" class="ltx_Math" alttext="\displaystyle({{\bm{\nu}}_{k}}^{\top},0^{\top}){\bm{W}}^{(T)}({{\bm{\nu}}_{k}}^{\top},0^{\top})^{\top}\lesssim\frac{\epsilon\beta^{-1}(1-p_{a})^{-1}l_{tr}^{-1}M_{1}}{M_{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝝂</mi><mi>k</mi><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝝂</mi><mi>k</mi><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>≲</mo><mstyle displaystyle="true"><mfrac><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub></mrow><msub><mi>M</mi><mn>2</mn></msub></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle({{\bm{\nu}}_{k}}^{\top},0^{\top}){\bm{W}}^{(T)}({{\bm{\nu}}_{k}}^{\top},0^{\top})^{\top}\lesssim\frac{\epsilon\beta^{-1}(1-p_{a})^{-1}l_{tr}^{-1}M_{1}}{M_{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(74)</span></td></tr></tbody>
</table>
<table id="A4.E75" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E75X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E75X.m2" class="ltx_Math" alttext="\displaystyle({{\bm{\nu}}_{k^{\prime}}}^{\top},0^{\top}){\bm{W}}^{(T)}({{\bm{\nu}}_{k}}^{\top},0^{\top})^{\top}\lesssim\frac{\epsilon\beta^{-1}(1-p_{a})^{-1}l_{tr}^{-1}M_{1}}{M_{2}^{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝝂</mi><msup><mi>k</mi><mo>′</mo></msup><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝝂</mi><mi>k</mi><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>≲</mo><mstyle displaystyle="true"><mfrac><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub></mrow><msubsup><mi>M</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle({{\bm{\nu}}_{k^{\prime}}}^{\top},0^{\top}){\bm{W}}^{(T)}({{\bm{\nu}}_{k}}^{\top},0^{\top})^{\top}\lesssim\frac{\epsilon\beta^{-1}(1-p_{a})^{-1}l_{tr}^{-1}M_{1}}{M_{2}^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(75)</span></td></tr></tbody>
</table>
<p id="A4.SS4.p1.2" class="ltx_p"><span id="A4.SS4.p1.2.1" class="ltx_text">Meanwhile, we have that for <math id="A4.SS4.p1.m5" class="ltx_Math" alttext="{{\bm{v}}_{s}^{*}}^{\prime}\in\mathcal{V}^{\prime}" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mi>𝒗</mi><mi>s</mi><mo>∗</mo><mrow></mrow><mo>′</mo></mmultiscripts><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">{{\bm{v}}_{s}^{*}}^{\prime}\in\mathcal{V}^{\prime}</annotation></semantics></math> with <math id="A4.SS4.p1.m6" class="ltx_Math" alttext="{{\bm{v}}_{s}^{*}}^{\prime}=\sum_{i=1}^{V}\lambda_{i}{\bm{v}}_{s}^{*}" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mi>𝒗</mi><mi>s</mi><mo>∗</mo><mrow></mrow><mo>′</mo></mmultiscripts><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>V</mi></msubsup><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">{{\bm{v}}_{s}^{*}}^{\prime}=\sum_{i=1}^{V}\lambda_{i}{\bm{v}}_{s}^{*}</annotation></semantics></math>,</span></p>
<table id="A4.E76" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E76X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E76X.m2" class="ltx_Math" alttext="\displaystyle({{{\bm{v}}_{s}^{\prime}}^{*}}^{\top},0^{\top}){\bm{W}}^{(T)}({{\bm{\mu}}_{j}^{\prime}}^{\top},0^{\top})^{\top}\lesssim\epsilon\beta^{-1}(1-p_{a})^{-1}p_{a}\kappa_{a}V^{-1}l_{tr}^{-1}\kappa_{a}^{\prime}L." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝒗</mi><mi>s</mi><mo>′</mo><mrow></mrow><mo>∗</mo><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝝁</mi><mi>j</mi><mo>′</mo><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>≲</mo><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle({{{\bm{v}}_{s}^{\prime}}^{*}}^{\top},0^{\top}){\bm{W}}^{(T)}({{\bm{\mu}}_{j}^{\prime}}^{\top},0^{\top})^{\top}\lesssim\epsilon\beta^{-1}(1-p_{a})^{-1}p_{a}\kappa_{a}V^{-1}l_{tr}^{-1}\kappa_{a}^{\prime}L.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(76)</span></td></tr></tbody>
</table>
<p id="A4.SS4.p1.3" class="ltx_p"><span id="A4.SS4.p1.3.1" class="ltx_text">Therefore, we have that for <math id="A4.SS4.p1.m7" class="ltx_Math" alttext="{\bm{p}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒑</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\bm{p}}_{i}</annotation></semantics></math> that shares the same pattern as the query,</span></p>
<table id="A4.E77" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E77.m1" class="ltx_Math" alttext="{\bm{p}}_{i}^{\top}{{\bm{W}}_{B}^{(T)}}^{\top}{\bm{W}}_{C}^{(T)}{\bm{p}}_{query}\gtrsim 1-\epsilon\cdot\frac{\beta^{-1}(1-p_{a})^{-1}l_{tr}^{-1}}{M_{2}}-\epsilon(1-p_{a})^{-1}\beta^{-1}p_{a}\kappa_{a}V^{-1}l_{tr}^{-1}L\kappa_{a}^{\prime}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>𝒑</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝑾</mi><mi>B</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>C</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub></mrow><mo>≳</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>ϵ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mrow><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><msub><mi>M</mi><mn>2</mn></msub></mfrac></mrow><mo>−</mo><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mo>′</mo></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\bm{p}}_{i}^{\top}{{\bm{W}}_{B}^{(T)}}^{\top}{\bm{W}}_{C}^{(T)}{\bm{p}}_{query}\gtrsim 1-\epsilon\cdot\frac{\beta^{-1}(1-p_{a})^{-1}l_{tr}^{-1}}{M_{2}}-\epsilon(1-p_{a})^{-1}\beta^{-1}p_{a}\kappa_{a}V^{-1}l_{tr}^{-1}L\kappa_{a}^{\prime}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(77)</span></td></tr></tbody>
</table>
<p id="A4.SS4.p1.4" class="ltx_p"><span id="A4.SS4.p1.4.1" class="ltx_text">For <math id="A4.SS4.p1.m8" class="ltx_Math" alttext="{\bm{p}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒑</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\bm{p}}_{i}</annotation></semantics></math> that shares a different pattern from the query, we have</span></p>
<table id="A4.E78" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E78.m1" class="ltx_Math" alttext="|{\bm{p}}_{i}^{\top}{{\bm{W}}_{B}^{(T)}}^{\top}{\bm{W}}_{C}^{(T)}{\bm{p}}_{query}|\lesssim\epsilon(1+\beta^{-1}(1-p_{a})^{-1}l_{tr}^{-1}/M_{2}+(1-p_{a})^{-1}\beta^{-1}p_{a}\kappa_{a}V^{-1}l_{tr}^{-1}\kappa_{a}^{\prime}L)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><msubsup><mi>𝒑</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝑾</mi><mi>B</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>C</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub></mrow><mo stretchy="false">|</mo></mrow><mo>≲</mo><mrow><mi>ϵ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mrow><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo>/</mo><msub><mi>M</mi><mn>2</mn></msub></mrow><mo>+</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|{\bm{p}}_{i}^{\top}{{\bm{W}}_{B}^{(T)}}^{\top}{\bm{W}}_{C}^{(T)}{\bm{p}}_{query}|\lesssim\epsilon(1+\beta^{-1}(1-p_{a})^{-1}l_{tr}^{-1}/M_{2}+(1-p_{a})^{-1}\beta^{-1}p_{a}\kappa_{a}V^{-1}l_{tr}^{-1}\kappa_{a}^{\prime}L).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(78)</span></td></tr></tbody>
</table>
<p id="A4.SS4.p1.5" class="ltx_p"><span id="A4.SS4.p1.5.1" class="ltx_text">Therefore, the trained model still selects examples with the same pattern as the query no matter whether there is a certain <math id="A4.SS4.p1.m9" class="ltx_Math" alttext="{{\bm{v}}_{s}^{\prime}}^{*}" display="inline" intent=":literal"><semantics><mmultiscripts><mi>𝒗</mi><mi>s</mi><mo>′</mo><mrow></mrow><mo>∗</mo></mmultiscripts><annotation encoding="application/x-tex">{{\bm{v}}_{s}^{\prime}}^{*}</annotation></semantics></math> added to the token if <math id="A4.SS4.p1.m10" class="ltx_Math" alttext="\kappa_{a}^{\prime}\lesssim V\beta{p_{a}}^{-1}(1-p_{a})\kappa_{a}^{-1}L^{-1}l_{tr}\epsilon^{-1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>κ</mi><mi>a</mi><mo>′</mo></msubsup><mo>≲</mo><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>p</mi><mi>a</mi><mrow></mrow><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\kappa_{a}^{\prime}\lesssim V\beta{p_{a}}^{-1}(1-p_{a})\kappa_{a}^{-1}L^{-1}l_{tr}\epsilon^{-1}</annotation></semantics></math>. Then, flipping the labels of examples with any of <math id="A4.SS4.p1.m11" class="ltx_Math" alttext="{{\bm{v}}_{s}^{\prime}}^{*}" display="inline" intent=":literal"><semantics><mmultiscripts><mi>𝒗</mi><mi>s</mi><mo>′</mo><mrow></mrow><mo>∗</mo></mmultiscripts><annotation encoding="application/x-tex">{{\bm{v}}_{s}^{\prime}}^{*}</annotation></semantics></math> can change the model output the most. With <math id="A4.SS4.p1.m12" class="ltx_Math" alttext="\alpha&lt;1/2" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>&lt;</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">\alpha&lt;1/2</annotation></semantics></math>, we can derive that</span></p>
<table id="A4.E79" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E79X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E79X.m2" class="ltx_Math" alttext="\displaystyle L_{{\bm{P}}^{\prime}\sim\mathcal{D}^{\prime},f\in\mathcal{T}}^{0-1}(\Psi^{(T)};{\bm{P}}^{\prime},z)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>L</mi><mrow><mrow><msup><mi>𝑷</mi><mo>′</mo></msup><mo>∼</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>′</mo></msup></mrow><mo>,</mo><mrow><mi>f</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></mrow><mrow><mn>0</mn><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mo>′</mo></msup><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle L_{{\bm{P}}^{\prime}\sim\mathcal{D}^{\prime},f\in\mathcal{T}}^{0-1}(\Psi^{(T)};{\bm{P}}^{\prime},z)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(79)</span></td></tr>
<tr id="A4.E79Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E79Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E79Xa.m3" class="ltx_Math" alttext="\displaystyle\Pr(\frac{1}{l_{ts}}\sum_{i=1}^{l_{ts}}\mathbbm{1}[{\bm{p}}_{i}^{\prime}\text{ with the same pattern as }{\bm{p}}_{query}^{\prime}\text{ but a flipped label}]-\frac{\alpha}{2}&gt;\frac{\alpha}{2}\cdot\frac{\frac{1}{2}-\alpha}{\alpha})" display="inline" intent=":literal"><semantics><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub></munderover></mstyle><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝒑</mi><mi>i</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mtext> with the same pattern as </mtext><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mtext> but a flipped label</mtext></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>α</mi><mn>2</mn></mfrac></mstyle></mrow><mo>&gt;</mo><mrow><mstyle displaystyle="true"><mfrac><mi>α</mi><mn>2</mn></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>−</mo><mi>α</mi></mrow><mi>α</mi></mfrac></mstyle></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Pr(\frac{1}{l_{ts}}\sum_{i=1}^{l_{ts}}\mathbbm{1}[{\bm{p}}_{i}^{\prime}\text{ with the same pattern as }{\bm{p}}_{query}^{\prime}\text{ but a flipped label}]-\frac{\alpha}{2}&gt;\frac{\alpha}{2}\cdot\frac{\frac{1}{2}-\alpha}{\alpha})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A4.E79Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E79Xb.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E79Xb.m3" class="ltx_Math" alttext="\displaystyle e^{-l_{ts}(\frac{1}{2}-\alpha)^{2}\alpha}" display="inline" intent=":literal"><semantics><msup><mi>e</mi><mrow><mo>−</mo><mrow><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mrow></msup><annotation encoding="application/x-tex">\displaystyle e^{-l_{ts}(\frac{1}{2}-\alpha)^{2}\alpha}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A4.E79Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E79Xc.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E79Xc.m3" class="ltx_Math" alttext="\displaystyle\epsilon," display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\epsilon,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.p1.6" class="ltx_p"><span id="A4.SS4.p1.6.1" class="ltx_text">as long as</span></p>
<table id="A4.E80" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E80.m1" class="ltx_Math" alttext="l_{ts}\geq\max\{\Theta((1-\alpha)^{-1}),\Theta((\frac{1}{2}-\alpha)^{-2}\alpha)\}\log\epsilon^{-1}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><mo>≥</mo><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">l_{ts}\geq\max\{\Theta((1-\alpha)^{-1}),\Theta((\frac{1}{2}-\alpha)^{-2}\alpha)\}\log\epsilon^{-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(80)</span></td></tr></tbody>
</table>
</div>
<div id="A4.SS4.p2" class="ltx_para">
<p id="A4.SS4.p2.1" class="ltx_p"><span id="A4.SS4.p2.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<section id="A4.SS4.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">D.4.1 </span>Proof of Corollary <a href="#Thmcorollary1" title="Corollary 1. ‣ 3.5 The Mechanism of Mamba in implementing ICL ‣ 3 Main Theoretical Results ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a></h4>

<div id="A4.SS4.SSS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS4.SSS1.p1" class="ltx_para">
<p id="A4.SS4.SSS1.p1.1" class="ltx_p"><span id="A4.SS4.SSS1.p1.1.1" class="ltx_text">The first part of (<a href="#S3.E16" title="In Corollary 1. ‣ 3.5 The Mechanism of Mamba in implementing ICL ‣ 3 Main Theoretical Results ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>) comes from (<a href="#A4.E43" title="In Proof. ‣ D.1 Proof of Theorem ‣ Appendix D Proof of Main Theorems ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">43</span></a>) since <math id="A4.SS4.SSS1.p1.m1" class="ltx_Math" alttext="\beta\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\beta\geq 1</annotation></semantics></math> is a constant. The second part of (<a href="#S3.E16" title="In Corollary 1. ‣ 3.5 The Mechanism of Mamba in implementing ICL ‣ 3 Main Theoretical Results ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>) comes from (<a href="#A4.E44" title="In Proof. ‣ D.1 Proof of Theorem ‣ Appendix D Proof of Main Theorems ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">44</span></a>) plus <math id="A4.SS4.SSS1.p1.m2" class="ltx_Math" alttext="\kappa_{a}V^{-1}\beta^{-1}p_{a}\lesssim 1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo>≲</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\kappa_{a}V^{-1}\beta^{-1}p_{a}\lesssim 1</annotation></semantics></math> with <math id="A4.SS4.SSS1.p1.m3" class="ltx_Math" alttext="\beta\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\beta\geq 1</annotation></semantics></math> as a constant order.</span></p>
</div>
<div id="A4.SS4.SSS1.p2" class="ltx_para">
<p id="A4.SS4.SSS1.p2.1" class="ltx_p"><span id="A4.SS4.SSS1.p2.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A4.SS4.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">D.4.2 </span>Proof of Corollary <a href="#Thmcorollary2" title="Corollary 2. ‣ 3.5 The Mechanism of Mamba in implementing ICL ‣ 3 Main Theoretical Results ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a></h4>

<div id="A4.SS4.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS4.SSS2.p1" class="ltx_para">
<p id="A4.SS4.SSS2.p1.1" class="ltx_p"><span id="A4.SS4.SSS2.p1.1.1" class="ltx_text">(<a href="#S3.E17" title="In Corollary 2. ‣ 3.5 The Mechanism of Mamba in implementing ICL ‣ 3 Main Theoretical Results ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>) comes from (<a href="#A4.E59" title="In Proof. ‣ D.2 Proof of Theorem ‣ Appendix D Proof of Main Theorems ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">59</span></a>) plus <math id="A4.SS4.SSS2.p1.m1" class="ltx_Math" alttext="\kappa_{a}^{\prime}\geq\Theta(1)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>κ</mi><mi>a</mi><mo>′</mo></msubsup><mo>≥</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\kappa_{a}^{\prime}\geq\Theta(1)</annotation></semantics></math>. (<a href="#S3.E18" title="In Corollary 2. ‣ 3.5 The Mechanism of Mamba in implementing ICL ‣ 3 Main Theoretical Results ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>) is derived as follows. By (<a href="#A4.E60" title="In Proof. ‣ D.2 Proof of Theorem ‣ Appendix D Proof of Main Theorems ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">60</span></a>), we have</span></p>
<table id="A4.E81" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E81.m1" class="ltx_Math" alttext="G_{h(1),l_{ts}+1}({\bm{w}}^{(T)})\geq\Theta(1)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>G</mi><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">G_{h(1),l_{ts}+1}({\bm{w}}^{(T)})\geq\Theta(1).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(81)</span></td></tr></tbody>
</table>
<p id="A4.SS4.SSS2.p1.2" class="ltx_p"><span id="A4.SS4.SSS2.p1.2.1" class="ltx_text">Then, combining (<a href="#A3.E36" title="In Lemma 4. ‣ Appendix C Key Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">36</span></a>) and (<a href="#S3.E17" title="In Corollary 2. ‣ 3.5 The Mechanism of Mamba in implementing ICL ‣ 3 Main Theoretical Results ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>), we have that if <math id="A4.SS4.SSS2.p1.m2" class="ltx_Math" alttext="{\bm{p}}_{s}" display="inline" intent=":literal"><semantics><msub><mi>𝒑</mi><mi>s</mi></msub><annotation encoding="application/x-tex">{\bm{p}}_{s}</annotation></semantics></math> does not contain any outliers,</span></p>
<table id="A4.E82" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E82.m1" class="ltx_Math" alttext="1-\sigma({{\bm{w}}^{(T)}}^{\top}{\bm{p}}_{s})\geq\frac{1}{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≥</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">1-\sigma({{\bm{w}}^{(T)}}^{\top}{\bm{p}}_{s})\geq\frac{1}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(82)</span></td></tr></tbody>
</table>
<p id="A4.SS4.SSS2.p1.3" class="ltx_p"><span id="A4.SS4.SSS2.p1.3.1" class="ltx_text">Then, with a high probability</span></p>
<table id="A4.E83" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E83X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E83X.m2" class="ltx_Math" alttext="\displaystyle G_{h(j),l_{ts}+1}({\bm{w}}^{(T)})\geq" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>G</mi><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle G_{h(j),l_{ts}+1}({\bm{w}}^{(T)})\geq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E83X.m3" class="ltx_Math" alttext="\displaystyle G_{h(j),l_{ts}+1}({\bm{w}}^{(T)})\cdot\frac{1}{2^{j-1}}\cdot(1-\Theta(\text{poly}(M_{1})^{-1}))^{l_{ts}\alpha}\cdot\Theta(1)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>G</mi><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mn>2</mn><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>poly</mtext><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mrow><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msup><mo rspace="0.222em">⋅</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle G_{h(j),l_{ts}+1}({\bm{w}}^{(T)})\cdot\frac{1}{2^{j-1}}\cdot(1-\Theta(\text{poly}(M_{1})^{-1}))^{l_{ts}\alpha}\cdot\Theta(1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(83)</span></td></tr>
<tr id="A4.E83Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E83Xa.m2" class="ltx_Math" alttext="\displaystyle\geq\Theta(\frac{1}{2^{j-1}})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≥</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mn>2</mn><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mstyle><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq\Theta(\frac{1}{2^{j-1}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright" colspan="2"></td></tr></tbody>
</table>
</div>
<div id="A4.SS4.SSS2.p2" class="ltx_para">
<p id="A4.SS4.SSS2.p2.1" class="ltx_p"><span id="A4.SS4.SSS2.p2.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
