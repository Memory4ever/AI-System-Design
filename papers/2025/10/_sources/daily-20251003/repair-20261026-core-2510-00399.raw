<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E138Xc.m3" class="ltx_Math" alttext="\displaystyle\xi+\eta\sqrt{\frac{\log B}{B}}-\eta\beta^{2}\sum_{i=1}^{l}\frac{1}{2^{l+2-i}V}\cdot\kappa_{a}\sum_{s=i+1}^{l+1}\frac{1}{2}(1-p_{a})" display="inline" intent=":literal"><semantics><mrow><mi>ξ</mi><mo>+</mo><mi>η</mi><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt><mo>−</mo><mi>η</mi><mi>β</mi><msup><mrow></mrow><mn>2</mn></msup><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>l</mi></msup><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msup><mn>2</mn><mrow><mrow><mi>l</mi><mo>+</mo><mn>2</mn></mrow><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>κ</mi><msub><mrow></mrow><mi>a</mi></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>s</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>p</mi><msub><mrow></mrow><mi>a</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\xi+\eta\sqrt{\frac{\log B}{B}}-\eta\beta^{2}\sum_{i=1}^{l}\frac{1}{2^{l+2-i}V}\cdot\kappa_{a}\sum_{s=i+1}^{l+1}\frac{1}{2}(1-p_{a})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
