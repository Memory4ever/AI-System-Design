<tr id="A5.E143X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E143X.m2" class="ltx_Math" alttext="\displaystyle\Pr\Big(\Big|\frac{1}{l|\mathcal{B}_{1}|}\sum_{n\in\mathcal{B}_{1}}\sum_{i=1}^{l}\mathbbm{1}[{\bm{p}}_{i}^{n}\text{ does not contain any }{\bm{v}}^{*}_{s}]G^{n}_{i,l+1}({\bm{w}}^{(0)})\sum_{s=i+1}^{l+1}\sigma({{\bm{w}}^{(0)}}^{\top}{\bm{p}}_{s}^{n})" display="inline" intent=":literal"><semantics><mrow><mi>Pr</mi><mo maxsize="1.600em" minsize="1.600em">(</mo><mo fence="false" maxsize="1.600em" minsize="1.600em" rspace="0.167em" stretchy="true">|</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mn>1</mn></msub></mrow></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>l</mi></msup><mn>𝟙</mn><mo stretchy="false">[</mo><mi>𝒑</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mi>n</mi></msup><mtext> does not contain any </mtext><mi>𝒗</mi><msup><mrow></mrow><mo>∗</mo></msup><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">]</mo><mi>G</mi><msup><mrow></mrow><mi>n</mi></msup><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">(</mo><mi>𝒘</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo rspace="0.167em" stretchy="false">)</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>s</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup><mi>σ</mi><mo stretchy="false">(</mo><mi>𝒘</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝒑</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mi>n</mi></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Pr\Big(\Big|\frac{1}{l|\mathcal{B}_{1}|}\sum_{n\in\mathcal{B}_{1}}\sum_{i=1}^{l}\mathbbm{1}[{\bm{p}}_{i}^{n}\text{ does not contain any }{\bm{v}}^{*}_{s}]G^{n}_{i,l+1}({\bm{w}}^{(0)})\sum_{s=i+1}^{l+1}\sigma({{\bm{w}}^{(0)}}^{\top}{\bm{p}}_{s}^{n})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="5" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(143)</span></td></tr>
<tr id="A5.E143Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
