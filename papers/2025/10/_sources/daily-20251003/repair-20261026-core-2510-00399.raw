<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E166Xb.m2" class="ltx_Math" alttext="\displaystyle\lesssim" display="inline" intent=":literal"><semantics><mo>≲</mo><annotation encoding="application/x-tex">\displaystyle\lesssim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E166Xb.m3" class="ltx_Math" alttext="\displaystyle-\log(2+(t_{2}+1)\gamma_{1})," display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>1</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\log(2+(t_{2}+1)\gamma_{1}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS4.p1.6" class="ltx_p">where the last step comes from the following.
<br class="ltx_break">(i)</p>
<table id="A5.E167" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E167X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E167X.m2" class="ltx_Math" alttext="\displaystyle\frac{\eta(1-p_{a})\beta^{2}\kappa_{a}}{V}(3+t_{2}\gamma_{1})^{-1}\gtrsim" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>a</mi></msub></mrow><mi>V</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo>+</mo><mrow><msub><mi>t</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>1</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>≳</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\eta(1-p_{a})\beta^{2}\kappa_{a}}{V}(3+t_{2}\gamma_{1})^{-1}\gtrsim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E167X.m3" class="ltx_Math" alttext="\displaystyle\log(1+\frac{\gamma_{1}}{2+t_{2}\gamma_{1}})" display="inline" intent=":literal"><semantics><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><msub><mi>γ</mi><mn>1</mn></msub><mrow><mn>2</mn><mo>+</mo><mrow><msub><mi>t</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>1</mn></msub></mrow></mrow></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\log(1+\frac{\gamma_{1}}{2+t_{2}\gamma_{1}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(167)</span></td></tr>
<tr id="A5.E167Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E167Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E167Xa.m3" class="ltx_Math" alttext="\displaystyle\log(2+(t_{2}+1)\gamma_{1})-\log(2+t_{2}\gamma_{1})," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>1</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>+</mo><mrow><msub><mi>t</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>1</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\log(2+(t_{2}+1)\gamma_{1})-\log(2+t_{2}\gamma_{1}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS4.p1.7" class="ltx_p">where the first step is from</p>
<table id="A5.E168" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E168.m1" class="ltx_Math" alttext="\gamma_{1}\leq\eta(1-p_{a})\beta^{2}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo>≤</mo><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\gamma_{1}\leq\eta(1-p_{a})\beta^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(168)</span></td></tr></tbody>
</table>
<p id="A5.SS4.p1.8" class="ltx_p">(ii)</p>
<table id="A5.E169" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E169X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E169X.m2" class="ltx_Math" alttext="\displaystyle\eta^{3}\frac{(1-p_{a})^{3}\kappa_{a}}{M_{1}^{2}V}\beta^{2}t_{2}^{2}(3+t_{2}\gamma_{1})^{-1}\gtrsim\log(2+(t_{2}+1)\gamma_{1})-\log(2+t_{2}\gamma_{1})," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>a</mi></msub></mrow><mrow><msubsup><mi>M</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>t</mi><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo>+</mo><mrow><msub><mi>t</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>1</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>≳</mo><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>1</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>+</mo><mrow><msub><mi>t</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>1</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\eta^{3}\frac{(1-p_{a})^{3}\kappa_{a}}{M_{1}^{2}V}\beta^{2}t_{2}^{2}(3+t_{2}\gamma_{1})^{-1}\gtrsim\log(2+(t_{2}+1)\gamma_{1})-\log(2+t_{2}\gamma_{1}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(169)</span></td></tr></tbody>
</table>
<p id="A5.SS4.p1.9" class="ltx_p">which comes from</p>
<table id="A5.E170" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E170.m1" class="ltx_Math" alttext="\gamma_{1}\leq\frac{\eta(1-p_{a})\beta^{-2}\kappa_{a}}{V}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo>≤</mo><mfrac><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>a</mi></msub></mrow><mi>V</mi></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\gamma_{1}\leq\frac{\eta(1-p_{a})\beta^{-2}\kappa_{a}}{V}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(170)</span></td></tr></tbody>
</table>
<p id="A5.SS4.p1.10" class="ltx_p">Therefore, (<a href="#A5.E163" title="In Proof. ‣ E.4 Proof of Lemma ‣ Appendix E Proof of Supportive Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">163</span></a>) can be rewritten as</p>
<table id="A5.E171" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E171.m1" class="ltx_Math" alttext="({{\bm{v}}_{s}^{*}}^{\top},0^{\top}){\bm{w}}^{(t)}\leq\Theta(-\log(2+t\cdot\eta(1-p_{a})\beta^{2}))," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝒗</mi><mi>s</mi><mo>∗</mo><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>≤</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>+</mo><mrow><mrow><mi>t</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">({{\bm{v}}_{s}^{*}}^{\top},0^{\top}){\bm{w}}^{(t)}\leq\Theta(-\log(2+t\cdot\eta(1-p_{a})\beta^{2})),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(171)</span></td></tr></tbody>
</table>
<p id="A5.SS4.p1.11" class="ltx_p">when <math id="A5.SS4.p1.m11" class="ltx_Math" alttext="\kappa_{a}\geq V\beta^{-4}" display="inline" intent=":literal"><semantics><mrow><msub><mi>κ</mi><mi>a</mi></msub><mo>≥</mo><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\kappa_{a}\geq V\beta^{-4}</annotation></semantics></math>, so that the conclusion holds when <math id="A5.SS4.p1.m12" class="ltx_Math" alttext="t=t_{2}+1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">t=t_{2}+1</annotation></semantics></math>. Thus, the induction can be completed.
We can then derive that when <math id="A5.SS4.p1.m13" class="ltx_Math" alttext="t=t_{0}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><msub><mi>t</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">t=t_{0}</annotation></semantics></math>, we have</p>
<table id="A5.E172" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E172.m1" class="ltx_Math" alttext="({{\bm{v}}_{s}^{*}}^{\top},0^{\top}){\bm{w}}^{(t_{0})}\leq\Theta(-\log(2+t_{0}\cdot\eta(1-p_{a})\beta^{2}))\lesssim-\log(M_{1})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝒗</mi><mi>s</mi><mo>∗</mo><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msup></mrow><mo>≤</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>+</mo><mrow><mrow><msub><mi>t</mi><mn>0</mn></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≲</mo><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">({{\bm{v}}_{s}^{*}}^{\top},0^{\top}){\bm{w}}^{(t_{0})}\leq\Theta(-\log(2+t_{0}\cdot\eta(1-p_{a})\beta^{2}))\lesssim-\log(M_{1}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(172)</span></td></tr></tbody>
</table>
<p id="A5.SS4.p1.12" class="ltx_p">and for <math id="A5.SS4.p1.m14" class="ltx_Math" alttext="{\bm{p}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒑</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\bm{p}}_{i}</annotation></semantics></math> that contains <math id="A5.SS4.p1.m15" class="ltx_Math" alttext="{\bm{\nu}}_{*}" display="inline" intent=":literal"><semantics><msub><mi>𝝂</mi><mo>∗</mo></msub><annotation encoding="application/x-tex">{\bm{\nu}}_{*}</annotation></semantics></math>,</p>
<table id="A5.E173" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E173.m1" class="ltx_Math" alttext="\sigma({\bm{p}}_{i}^{\top}{\bm{w}}^{(t)})\lesssim\frac{1}{\text{poly}(M_{1})}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝒑</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≲</mo><mfrac><mn>1</mn><mrow><mtext>poly</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sigma({\bm{p}}_{i}^{\top}{\bm{w}}^{(t)})\lesssim\frac{1}{\text{poly}(M_{1})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(173)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS4.p2" class="ltx_para ltx_noindent">
<p id="A5.SS4.p2.1" class="ltx_p">(b) We then prove that</p>
<table id="A5.E174" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E174.m1" class="ltx_Math" alttext="({\bm{\mu}}_{j}^{\top},0^{\top}){\bm{w}}^{(t)}\geq\Theta(-\log(2+\frac{t\gamma_{2}}{M_{1}}))" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>j</mi><mo>⊤</mo></msubsup><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>≥</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>+</mo><mfrac><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><msub><mi>M</mi><mn>1</mn></msub></mfrac></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">({\bm{\mu}}_{j}^{\top},0^{\top}){\bm{w}}^{(t)}\geq\Theta(-\log(2+\frac{t\gamma_{2}}{M_{1}}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(174)</span></td></tr></tbody>
</table>
<p id="A5.SS4.p2.2" class="ltx_p">for <math id="A5.SS4.p2.m1" class="ltx_Math" alttext="j\in[M_{1}]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[M_{1}]</annotation></semantics></math> and some <math id="A5.SS4.p2.m2" class="ltx_Math" alttext="\gamma_{2}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mn>2</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\gamma_{2}&gt;0</annotation></semantics></math> by induction. When <math id="A5.SS4.p2.m3" class="ltx_Math" alttext="t=\min\{\eta^{-1}\beta^{-2}\kappa_{a}^{-1}(1-p_{a})^{-1}V,\eta^{-1}M_{1}^{\frac{2}{3}}\beta^{-\frac{2}{3}}\kappa_{a}^{-\frac{1}{3}}(1-p_{a})^{-1}V^{\frac{1}{3}}\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>,</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mn>1</mn><mfrac><mn>2</mn><mn>3</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mfrac><mn>2</mn><mn>3</mn></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mfrac><mn>1</mn><mn>3</mn></mfrac></msup></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t=\min\{\eta^{-1}\beta^{-2}\kappa_{a}^{-1}(1-p_{a})^{-1}V,\eta^{-1}M_{1}^{\frac{2}{3}}\beta^{-\frac{2}{3}}\kappa_{a}^{-\frac{1}{3}}(1-p_{a})^{-1}V^{\frac{1}{3}}\}</annotation></semantics></math>, we have</p>
<table id="A5.E175" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E175.m1" class="ltx_Math" alttext="({\bm{\mu}}_{j}^{\top},0^{\top}){{\bm{w}}^{(t)}}\gtrsim-\frac{1}{M_{1}}\geq\Theta(-\log(2+\eta^{-1}\beta^{-\frac{2}{3}}\kappa_{a}^{-\frac{1}{3}}M_{1}^{-\frac{1}{3}}(1-p_{a})^{-1}V^{\frac{1}{3}}\gamma_{2}))" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>j</mi><mo>⊤</mo></msubsup><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>≳</mo><mrow><mo>−</mo><mfrac><mn>1</mn><msub><mi>M</mi><mn>1</mn></msub></mfrac></mrow><mo>≥</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>+</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mfrac><mn>2</mn><mn>3</mn></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mn>1</mn><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mfrac><mn>1</mn><mn>3</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">({\bm{\mu}}_{j}^{\top},0^{\top}){{\bm{w}}^{(t)}}\gtrsim-\frac{1}{M_{1}}\geq\Theta(-\log(2+\eta^{-1}\beta^{-\frac{2}{3}}\kappa_{a}^{-\frac{1}{3}}M_{1}^{-\frac{1}{3}}(1-p_{a})^{-1}V^{\frac{1}{3}}\gamma_{2}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(175)</span></td></tr></tbody>
</table>
<p id="A5.SS4.p2.3" class="ltx_p">by Lemma <a href="#Thmlemma4" title="Lemma 4. ‣ Appendix C Key Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> for any <math id="A5.SS4.p2.m4" class="ltx_Math" alttext="\gamma_{2}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mn>2</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\gamma_{2}&gt;0</annotation></semantics></math>, since that <math id="A5.SS4.p2.m5" class="ltx_Math" alttext="1+\eta^{-1}\beta^{-\frac{2}{3}}\kappa_{a}^{-\frac{1}{3}}M_{1}^{-\frac{1}{3}}(1-p_{a})^{-1}V^{\frac{1}{3}}\gamma_{2}\gg M_{1}^{-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>+</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mfrac><mn>2</mn><mn>3</mn></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mn>1</mn><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mfrac><mn>1</mn><mn>3</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow></mrow><mo>≫</mo><msubsup><mi>M</mi><mn>1</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><annotation encoding="application/x-tex">1+\eta^{-1}\beta^{-\frac{2}{3}}\kappa_{a}^{-\frac{1}{3}}M_{1}^{-\frac{1}{3}}(1-p_{a})^{-1}V^{\frac{1}{3}}\gamma_{2}\gg M_{1}^{-1}</annotation></semantics></math> and <math id="A5.SS4.p2.m6" class="ltx_Math" alttext="\gamma_{2}\geq 1" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mn>2</mn></msub><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\gamma_{2}\geq 1</annotation></semantics></math>. Therefore, (<a href="#A5.E174" title="In Proof. ‣ E.4 Proof of Lemma ‣ Appendix E Proof of Supportive Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">174</span></a>) holds when</p>
<table id="A5.E176" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E176.m1" class="ltx_Math" alttext="t=\min\{\eta^{-1}\beta^{-2}\kappa_{a}^{-1}(1-p_{a})^{-1}V,\eta^{-1}M_{1}^{\frac{2}{3}}\beta^{-\frac{2}{3}}\kappa_{a}^{-\frac{1}{3}}(1-p_{a})^{-1}V^{\frac{1}{3}}\}." display="block" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>,</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mn>1</mn><mfrac><mn>2</mn><mn>3</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mfrac><mn>2</mn><mn>3</mn></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mfrac><mn>1</mn><mn>3</mn></mfrac></msup></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">t=\min\{\eta^{-1}\beta^{-2}\kappa_{a}^{-1}(1-p_{a})^{-1}V,\eta^{-1}M_{1}^{\frac{2}{3}}\beta^{-\frac{2}{3}}\kappa_{a}^{-\frac{1}{3}}(1-p_{a})^{-1}V^{\frac{1}{3}}\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(176)</span></td></tr></tbody>
</table>
<p id="A5.SS4.p2.4" class="ltx_p">Suppose that when <math id="A5.SS4.p2.m7" class="ltx_Math" alttext="t\leq t_{2}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≤</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">t\leq t_{2}</annotation></semantics></math> with <math id="A5.SS4.p2.m8" class="ltx_Math" alttext="t_{2}&gt;\min\{\eta^{-1}\beta^{-2}\kappa_{a}^{-1}(1-p_{a})^{-1}V,\eta^{-1}M_{1}^{\frac{2}{3}}\beta^{-\frac{2}{3}}\kappa_{a}^{-\frac{1}{3}}(1-p_{a})^{-1}V^{\frac{1}{3}}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>&gt;</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>,</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mn>1</mn><mfrac><mn>2</mn><mn>3</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mfrac><mn>2</mn><mn>3</mn></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mfrac><mn>1</mn><mn>3</mn></mfrac></msup></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t_{2}&gt;\min\{\eta^{-1}\beta^{-2}\kappa_{a}^{-1}(1-p_{a})^{-1}V,\eta^{-1}M_{1}^{\frac{2}{3}}\beta^{-\frac{2}{3}}\kappa_{a}^{-\frac{1}{3}}(1-p_{a})^{-1}V^{\frac{1}{3}}\}</annotation></semantics></math> and <math id="A5.SS4.p2.m9" class="ltx_Math" alttext="t_{2}\leq t_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>≤</mo><msub><mi>t</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">t_{2}\leq t_{0}</annotation></semantics></math>, the conclusion still holds. Then, when <math id="A5.SS4.p2.m10" class="ltx_Math" alttext="t=t_{2}+1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">t=t_{2}+1</annotation></semantics></math>, we have</p>
