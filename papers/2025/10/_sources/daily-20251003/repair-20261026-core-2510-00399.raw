<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E161Xc.m2" class="ltx_Math" alttext="\displaystyle\gtrsim" display="inline" intent=":literal"><semantics><mo>≳</mo><annotation encoding="application/x-tex">\displaystyle\gtrsim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E161Xc.m3" class="ltx_Math" alttext="\displaystyle-\xi-\frac{\eta}{M_{1}}\sqrt{\frac{\log B}{B}}-\frac{\eta(1-p_{a})\beta^{2}t_{0}}{M_{1}}-\sum_{i=1}^{t_{0}-1}i^{2}\cdot(\frac{\eta^{3}(1-p_{a})^{3}\beta^{2}}{M_{1}^{3}})-\eta\frac{(1-p_{a})}{M_{1}}(\beta^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mi>ξ</mi></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>η</mi><msub><mi>M</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mn>0</mn></msub></mrow><msub><mi>M</mi><mn>1</mn></msub></mfrac></mstyle><mo>−</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mi>i</mi><mn>2</mn></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><msubsup><mi>M</mi><mn>1</mn><mn>3</mn></msubsup></mfrac></mstyle><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><msub><mi>M</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>β</mi><mn>2</mn></msup><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\xi-\frac{\eta}{M_{1}}\sqrt{\frac{\log B}{B}}-\frac{\eta(1-p_{a})\beta^{2}t_{0}}{M_{1}}-\sum_{i=1}^{t_{0}-1}i^{2}\cdot(\frac{\eta^{3}(1-p_{a})^{3}\beta^{2}}{M_{1}^{3}})-\eta\frac{(1-p_{a})}{M_{1}}(\beta^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E161Xd" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E161Xd.m2" class="ltx_Math" alttext="\displaystyle+\frac{\eta^{2}t_{0}^{2}(1-p_{a})^{2}\beta^{2}}{M_{1}^{2}})" display="inline" intent=":literal"><semantics><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>t</mi><mn>0</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><msubsup><mi>M</mi><mn>1</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{\eta^{2}t_{0}^{2}(1-p_{a})^{2}\beta^{2}}{M_{1}^{2}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E161Xe" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E161Xe.m2" class="ltx_Math" alttext="\displaystyle\gtrsim" display="inline" intent=":literal"><semantics><mo>≳</mo><annotation encoding="application/x-tex">\displaystyle\gtrsim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E161Xe.m3" class="ltx_Math" alttext="\displaystyle-\frac{\eta(1-p_{a})\beta^{2}(t_{0}+1)}{M_{1}}-\sum_{i=1}^{t_{0}}i^{2}\cdot(\frac{\eta^{3}(1-p_{a})^{3}\beta^{2}}{M_{1}^{3}})," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><msub><mi>M</mi><mn>1</mn></msub></mfrac></mstyle></mrow><mo>−</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>t</mi><mn>0</mn></msub></munderover></mstyle><msup><mi>i</mi><mn>2</mn></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><msubsup><mi>M</mi><mn>1</mn><mn>3</mn></msubsup></mfrac></mstyle><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{\eta(1-p_{a})\beta^{2}(t_{0}+1)}{M_{1}}-\sum_{i=1}^{t_{0}}i^{2}\cdot(\frac{\eta^{3}(1-p_{a})^{3}\beta^{2}}{M_{1}^{3}}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p2.22" class="ltx_p">where the second step is by Lemma <a href="#Thmlemma6" title="Lemma 6. ‣ Appendix C Key Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>. Therefore, we complete the induction.</p>
</div>
<div id="A5.SS3.p3" class="ltx_para">
<p id="A5.SS3.p3.1" class="ltx_p"><span id="A5.SS3.p3.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A5.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.4 </span>Proof of Lemma <a href="#Thmlemma5" title="Lemma 5. ‣ Appendix C Key Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a></h3>

<div id="A5.SS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS4.p1" class="ltx_para ltx_noindent">
<p id="A5.SS4.p1.1" class="ltx_p">Let</p>
<table id="A5.E162" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E162.m1" class="ltx_Math" alttext="t_{0}=\Theta(\eta^{-1}(1-p_{a})^{-1}\beta^{-2}M_{1})." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">t_{0}=\Theta(\eta^{-1}(1-p_{a})^{-1}\beta^{-2}M_{1}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(162)</span></td></tr></tbody>
</table>
<p id="A5.SS4.p1.2" class="ltx_p">(a) We first prove that for any <math id="A5.SS4.p1.m1" class="ltx_Math" alttext="s\in[V]" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>V</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">s\in[V]</annotation></semantics></math>,</p>
<table id="A5.E163" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E163.m1" class="ltx_Math" alttext="({{\bm{v}}_{s}^{*}}^{\top},0^{\top}){\bm{w}}^{(t)}\leq\Theta(-\log(2+t\gamma_{1}))" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝒗</mi><mi>s</mi><mo>∗</mo><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>≤</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>+</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>1</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">({{\bm{v}}_{s}^{*}}^{\top},0^{\top}){\bm{w}}^{(t)}\leq\Theta(-\log(2+t\gamma_{1}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(163)</span></td></tr></tbody>
</table>
<p id="A5.SS4.p1.3" class="ltx_p">for some <math id="A5.SS4.p1.m2" class="ltx_Math" alttext="\gamma_{1}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\gamma_{1}&gt;0</annotation></semantics></math> by induction. When <math id="A5.SS4.p1.m3" class="ltx_Math" alttext="t=\min\{\eta^{-1}\beta^{-2}\kappa_{a}^{-1}(1-p_{a})^{-1}V,\eta^{-1}M_{1}^{\frac{2}{3}}\beta^{-\frac{2}{3}}\kappa_{a}^{-\frac{1}{3}}(1-p_{a})^{-1}V^{\frac{1}{3}}\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>,</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mn>1</mn><mfrac><mn>2</mn><mn>3</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mfrac><mn>2</mn><mn>3</mn></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mfrac><mn>1</mn><mn>3</mn></mfrac></msup></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t=\min\{\eta^{-1}\beta^{-2}\kappa_{a}^{-1}(1-p_{a})^{-1}V,\eta^{-1}M_{1}^{\frac{2}{3}}\beta^{-\frac{2}{3}}\kappa_{a}^{-\frac{1}{3}}(1-p_{a})^{-1}V^{\frac{1}{3}}\}</annotation></semantics></math>, we have</p>
<table id="A5.E164" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E164.m1" class="ltx_Math" alttext="({{\bm{v}}_{s}^{*}}^{\top},0^{\top}){{\bm{w}}^{(t)}}\lesssim-\Theta(1)\leq\Theta(-\log(2+\eta^{-1}\beta^{-\frac{2}{3}}\kappa_{a}^{-\frac{1}{3}}M_{1}^{\frac{2}{3}}(1-p_{a})^{-1}V^{\frac{1}{3}}\gamma_{1}))" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝒗</mi><mi>s</mi><mo>∗</mo><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>≲</mo><mrow><mo>−</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>+</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mfrac><mn>2</mn><mn>3</mn></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mn>1</mn><mfrac><mn>2</mn><mn>3</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mfrac><mn>1</mn><mn>3</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>1</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">({{\bm{v}}_{s}^{*}}^{\top},0^{\top}){{\bm{w}}^{(t)}}\lesssim-\Theta(1)\leq\Theta(-\log(2+\eta^{-1}\beta^{-\frac{2}{3}}\kappa_{a}^{-\frac{1}{3}}M_{1}^{\frac{2}{3}}(1-p_{a})^{-1}V^{\frac{1}{3}}\gamma_{1}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(164)</span></td></tr></tbody>
</table>
<p id="A5.SS4.p1.4" class="ltx_p">by Lemma <a href="#Thmlemma4" title="Lemma 4. ‣ Appendix C Key Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> for any <math id="A5.SS4.p1.m4" class="ltx_Math" alttext="\gamma_{1}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\gamma_{1}&gt;0</annotation></semantics></math>, since that <math id="A5.SS4.p1.m5" class="ltx_Math" alttext="1+\eta^{-1}\beta^{-\frac{2}{3}}\kappa_{a}^{-\frac{1}{3}}M_{1}^{\frac{2}{3}}(1-p_{a})^{-1}V^{\frac{1}{3}}\gamma_{1}\geq\Theta(1)" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>+</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mfrac><mn>2</mn><mn>3</mn></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mn>1</mn><mfrac><mn>2</mn><mn>3</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mfrac><mn>1</mn><mn>3</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>1</mn></msub></mrow></mrow><mo>≥</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1+\eta^{-1}\beta^{-\frac{2}{3}}\kappa_{a}^{-\frac{1}{3}}M_{1}^{\frac{2}{3}}(1-p_{a})^{-1}V^{\frac{1}{3}}\gamma_{1}\geq\Theta(1)</annotation></semantics></math> and <math id="A5.SS4.p1.m6" class="ltx_Math" alttext="\gamma_{1}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\gamma_{1}&gt;0</annotation></semantics></math>. Therefore, (<a href="#A5.E163" title="In Proof. ‣ E.4 Proof of Lemma ‣ Appendix E Proof of Supportive Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">163</span></a>) holds when</p>
<table id="A5.E165" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E165.m1" class="ltx_Math" alttext="t=\min\{\eta^{-1}\beta^{-2}\kappa_{a}^{-1}(1-p_{a})^{-1}V,\eta^{-1}M_{1}^{\frac{2}{3}}\beta^{-\frac{2}{3}}\kappa_{a}^{-\frac{1}{3}}(1-p_{a})^{-1}V^{\frac{1}{3}}\}." display="block" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>,</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mn>1</mn><mfrac><mn>2</mn><mn>3</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mfrac><mn>2</mn><mn>3</mn></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mfrac><mn>1</mn><mn>3</mn></mfrac></msup></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">t=\min\{\eta^{-1}\beta^{-2}\kappa_{a}^{-1}(1-p_{a})^{-1}V,\eta^{-1}M_{1}^{\frac{2}{3}}\beta^{-\frac{2}{3}}\kappa_{a}^{-\frac{1}{3}}(1-p_{a})^{-1}V^{\frac{1}{3}}\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(165)</span></td></tr></tbody>
</table>
<p id="A5.SS4.p1.5" class="ltx_p">Suppose that when <math id="A5.SS4.p1.m7" class="ltx_Math" alttext="t\leq t_{2}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≤</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">t\leq t_{2}</annotation></semantics></math> with <math id="A5.SS4.p1.m8" class="ltx_Math" alttext="t_{2}&gt;\min\{\eta^{-1}\beta^{-2}\kappa_{a}^{-1}(1-p_{a})^{-1}V,\eta^{-1}M_{1}^{\frac{2}{3}}\beta^{-\frac{2}{3}}\kappa_{a}^{-\frac{1}{3}}(1-p_{a})^{-1}V^{\frac{1}{3}}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>&gt;</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>,</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mn>1</mn><mfrac><mn>2</mn><mn>3</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mfrac><mn>2</mn><mn>3</mn></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mfrac><mn>1</mn><mn>3</mn></mfrac></msup></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t_{2}&gt;\min\{\eta^{-1}\beta^{-2}\kappa_{a}^{-1}(1-p_{a})^{-1}V,\eta^{-1}M_{1}^{\frac{2}{3}}\beta^{-\frac{2}{3}}\kappa_{a}^{-\frac{1}{3}}(1-p_{a})^{-1}V^{\frac{1}{3}}\}</annotation></semantics></math> and <math id="A5.SS4.p1.m9" class="ltx_Math" alttext="t_{2}\leq t_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>≤</mo><msub><mi>t</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">t_{2}\leq t_{0}</annotation></semantics></math>, the conclusion still holds. Then, when <math id="A5.SS4.p1.m10" class="ltx_Math" alttext="t=t_{2}+1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">t=t_{2}+1</annotation></semantics></math>, we have</p>
<table id="A5.E166" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E166X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E166X.m2" class="ltx_Math" alttext="\displaystyle({{\bm{v}}_{s}^{*}}^{\top},0^{\top}){{\bm{w}}^{(t)}}\lesssim" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝒗</mi><mi>s</mi><mo>∗</mo><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>≲</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle({{\bm{v}}_{s}^{*}}^{\top},0^{\top}){{\bm{w}}^{(t)}}\lesssim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E166X.m3" class="ltx_Math" alttext="\displaystyle-\log(2+t_{2}\gamma_{1})-\frac{\eta(1-p_{a})\kappa_{a}}{V}(\beta^{2}+\frac{\eta^{2}t_{2}^{2}(1-p_{a})^{2}\beta^{2}}{M_{1}^{2}})\cdot\frac{1}{1+e^{\log(2+t_{2}\gamma_{1})}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>+</mo><mrow><msub><mi>t</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>1</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>a</mi></msub></mrow><mi>V</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>β</mi><mn>2</mn></msup><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>t</mi><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><msubsup><mi>M</mi><mn>1</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><msup><mi>e</mi><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>+</mo><mrow><msub><mi>t</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>1</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\log(2+t_{2}\gamma_{1})-\frac{\eta(1-p_{a})\kappa_{a}}{V}(\beta^{2}+\frac{\eta^{2}t_{2}^{2}(1-p_{a})^{2}\beta^{2}}{M_{1}^{2}})\cdot\frac{1}{1+e^{\log(2+t_{2}\gamma_{1})}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(166)</span></td></tr>
<tr id="A5.E166Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E166Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E166Xa.m3" class="ltx_Math" alttext="\displaystyle-\log(2+t_{2}\gamma_{1})-\frac{\eta(1-p_{a})\kappa_{a}}{V}(\beta^{2}+\frac{\eta^{2}t_{2}^{2}(1-p_{a})^{2}\beta^{2}}{M_{1}^{2}})\cdot(3+t_{2}\gamma_{1})^{-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>+</mo><mrow><msub><mi>t</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>1</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>a</mi></msub></mrow><mi>V</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>β</mi><mn>2</mn></msup><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>t</mi><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><msubsup><mi>M</mi><mn>1</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo>+</mo><mrow><msub><mi>t</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>1</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\log(2+t_{2}\gamma_{1})-\frac{\eta(1-p_{a})\kappa_{a}}{V}(\beta^{2}+\frac{\eta^{2}t_{2}^{2}(1-p_{a})^{2}\beta^{2}}{M_{1}^{2}})\cdot(3+t_{2}\gamma_{1})^{-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
