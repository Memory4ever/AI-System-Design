<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E135Xh.m2" class="ltx_Math" alttext="\displaystyle\cdot\sigma({\bm{w}}^{\top}{\bm{p}}_{i}^{n}){\bm{p}}_{s}^{n}-\prod_{j=i}^{l+1}(1-\sigma({\bm{w}}^{\top}{\bm{p}}_{j}^{n}))\sigma({\bm{w}}^{\top}{\bm{p}}_{i}^{n}){\bm{p}}_{i}^{n})" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.222em">⋅</mo><mi>σ</mi><mo stretchy="false">(</mo><mi>𝒘</mi><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝒑</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mi>n</mi></msup><mo stretchy="false">)</mo><mi>𝒑</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mi>n</mi></msup><mo>−</mo><mstyle displaystyle="true"><mo movablelimits="false">∏</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>=</mo><mi>i</mi></mrow></msub><msup><mrow></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>σ</mi><mo stretchy="false">(</mo><mi>𝒘</mi><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝒑</mi><msub><mrow></mrow><mi>j</mi></msub><msup><mrow></mrow><mi>n</mi></msup><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mi>σ</mi><mo stretchy="false">(</mo><mi>𝒘</mi><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝒑</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mi>n</mi></msup><mo stretchy="false">)</mo><mi>𝒑</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mi>n</mi></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\cdot\sigma({\bm{w}}^{\top}{\bm{p}}_{i}^{n}){\bm{p}}_{s}^{n}-\prod_{j=i}^{l+1}(1-\sigma({\bm{w}}^{\top}{\bm{p}}_{j}^{n}))\sigma({\bm{w}}^{\top}{\bm{p}}_{i}^{n}){\bm{p}}_{i}^{n})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E135Xi" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E135Xi.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E135Xi.m3" class="ltx_Math" alttext="\displaystyle z^{n}\sum_{i=1}^{l}y_{i}^{n}{{\bm{p}}_{i}^{n}}^{\top}{\bm{W}}_{B}^{\top}{\bm{W}}_{C}{\bm{p}}_{query}^{n}G^{n}_{i,l+1}({\bm{w}})(\sum_{s=i+1}^{l+1}\sigma({\bm{w}}^{\top}{\bm{p}}_{s}^{n}){\bm{p}}_{s}^{n}-(1-\sigma({\bm{w}}^{\top}{\bm{p}}_{i}^{n})){\bm{p}}_{i}^{n})." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>z</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>l</mi></munderover></mstyle><mrow><msubsup><mi>y</mi><mi>i</mi><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝒑</mi><mi>i</mi><mi>n</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>B</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>C</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒘</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒘</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>s</mi><mi>n</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>s</mi><mi>n</mi></msubsup></mrow></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒘</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>i</mi><mi>n</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>i</mi><mi>n</mi></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle z^{n}\sum_{i=1}^{l}y_{i}^{n}{{\bm{p}}_{i}^{n}}^{\top}{\bm{W}}_{B}^{\top}{\bm{W}}_{C}{\bm{p}}_{query}^{n}G^{n}_{i,l+1}({\bm{w}})(\sum_{s=i+1}^{l+1}\sigma({\bm{w}}^{\top}{\bm{p}}_{s}^{n}){\bm{p}}_{s}^{n}-(1-\sigma({\bm{w}}^{\top}{\bm{p}}_{i}^{n})){\bm{p}}_{i}^{n}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p1.5" class="ltx_p"><span id="A5.SS3.p1.5.1" class="ltx_text">When <math id="A5.SS3.p1.m3" class="ltx_Math" alttext="t=1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=1</annotation></semantics></math>, we have</span></p>
<table id="A5.E136" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E136X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E136X.m2" class="ltx_Math" alttext="\displaystyle{\bm{w}}^{(1)}=" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{w}}^{(1)}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E136X.m3" class="ltx_Math" alttext="\displaystyle{\displaystyle\bm{w}}^{(0)}-\frac{\eta}{|\mathcal{B}_{1}|}\sum_{n\in\mathcal{B}_{1}}\frac{\partial\ell(\Psi;{\bm{P}}^{n},z^{n})}{\partial{\bm{w}}^{(0)}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>η</mi><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mn>1</mn></msub></mrow></munder></mstyle><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\displaystyle\bm{w}}^{(0)}-\frac{\eta}{|\mathcal{B}_{1}|}\sum_{n\in\mathcal{B}_{1}}\frac{\partial\ell(\Psi;{\bm{P}}^{n},z^{n})}{\partial{\bm{w}}^{(0)}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(136)</span></td></tr>
<tr id="A5.E136Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E136Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E136Xa.m3" class="ltx_Math" alttext="\displaystyle{\displaystyle\bm{w}}^{(0)}-\frac{\eta}{|\mathcal{B}_{1}|}\sum_{n\in\mathcal{B}_{1}}z^{n}\sum_{i=1}^{l}y_{i}^{n}{{\bm{p}}_{i}^{n}}^{\top}{{\bm{W}}_{B}^{(0)}}^{\top}{\bm{W}}_{C}^{(0)}{\bm{p}}_{query}^{n}G^{n}_{i,l+1}({\bm{w}}^{(0)})" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>η</mi><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mn>1</mn></msub></mrow></munder></mstyle><mrow><msup><mi>z</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>l</mi></munderover></mstyle><mrow><msubsup><mi>y</mi><mi>i</mi><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝒑</mi><mi>i</mi><mi>n</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝑾</mi><mi>B</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>C</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\displaystyle\bm{w}}^{(0)}-\frac{\eta}{|\mathcal{B}_{1}|}\sum_{n\in\mathcal{B}_{1}}z^{n}\sum_{i=1}^{l}y_{i}^{n}{{\bm{p}}_{i}^{n}}^{\top}{{\bm{W}}_{B}^{(0)}}^{\top}{\bm{W}}_{C}^{(0)}{\bm{p}}_{query}^{n}G^{n}_{i,l+1}({\bm{w}}^{(0)})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E136Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E136Xb.m2" class="ltx_Math" alttext="\displaystyle\cdot(\sum_{s=i+1}^{l+1}\sigma({{\bm{w}}^{(0)}}^{\top}{\bm{p}}_{s}^{n}){\bm{p}}_{s}^{n}-(1-\sigma({{\bm{w}}^{(0)}}^{\top}{\bm{p}}_{i}^{n})){\bm{p}}_{i}^{n})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>s</mi><mi>n</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>s</mi><mi>n</mi></msubsup></mrow></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>i</mi><mi>n</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>i</mi><mi>n</mi></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\cdot(\sum_{s=i+1}^{l+1}\sigma({{\bm{w}}^{(0)}}^{\top}{\bm{p}}_{s}^{n}){\bm{p}}_{s}^{n}-(1-\sigma({{\bm{w}}^{(0)}}^{\top}{\bm{p}}_{i}^{n})){\bm{p}}_{i}^{n})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p1.6" class="ltx_p"><span id="A5.SS3.p1.6.1" class="ltx_text">For <math id="A5.SS3.p1.m4" class="ltx_Math" alttext="{\bm{p}}_{i}^{n}" display="inline" intent=":literal"><semantics><msubsup><mi>𝒑</mi><mi>i</mi><mi>n</mi></msubsup><annotation encoding="application/x-tex">{\bm{p}}_{i}^{n}</annotation></semantics></math> that contains a <math id="A5.SS3.p1.m5" class="ltx_Math" alttext="{\bm{v}}^{*}_{s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">{\bm{v}}^{*}_{s}</annotation></semantics></math>, the corresponding <math id="A5.SS3.p1.m6" class="ltx_Math" alttext="y_{i}^{n}" display="inline" intent=":literal"><semantics><msubsup><mi>y</mi><mi>i</mi><mi>n</mi></msubsup><annotation encoding="application/x-tex">y_{i}^{n}</annotation></semantics></math> is consistent with <math id="A5.SS3.p1.m7" class="ltx_Math" alttext="z^{n}" display="inline" intent=":literal"><semantics><msup><mi>z</mi><mi>n</mi></msup><annotation encoding="application/x-tex">z^{n}</annotation></semantics></math> with a probability of <math id="A5.SS3.p1.m8" class="ltx_Math" alttext="1/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">1/2</annotation></semantics></math>. Given Hoeffding’s bound (<a href="#A3.E22" title="In Lemma 2. ‣ Appendix C Key Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>), this part generates a gradient update as</span></p>
<table id="A5.E137" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E137X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E137X.m2" class="ltx_Math" alttext="\displaystyle\Big\|\frac{\eta}{|\mathcal{B}_{1}|}\sum_{n\in\mathcal{B}_{1}}z^{n}\sum_{1\leq i\leq l,{\bm{p}}_{i}^{n}\text{ does not contain any }{\bm{v}}^{*}_{s}}y_{i}^{n}{{\bm{p}}_{i}^{n}}^{\top}{{\bm{W}}_{B}^{(0)}}^{\top}{\bm{W}}_{C}^{(0)}{\bm{p}}_{query}^{n}G^{n}_{i,l+1}({\bm{w}}^{(0)})" display="inline" intent=":literal"><semantics><mrow><mo mathsize="1.600em" rspace="0.167em">∥</mo><mstyle displaystyle="true"><mfrac><mi>η</mi><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mn>1</mn></msub></mrow></msub><mi>z</mi><msup><mrow></mrow><mi>n</mi></msup><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>l</mi></mrow><mo>,</mo><mrow><msubsup><mi>𝒑</mi><mi>i</mi><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mtext> does not contain any </mtext><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup></mrow></mrow></msub><mi>y</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mi>n</mi></msup><mi>𝒑</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mi>n</mi></msup><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝑾</mi><msub><mrow></mrow><mi>B</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝑾</mi><msub><mrow></mrow><mi>C</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mi>𝒑</mi><msub><mrow></mrow><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub><msup><mrow></mrow><mi>n</mi></msup><mi>G</mi><msup><mrow></mrow><mi>n</mi></msup><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">(</mo><mi>𝒘</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big\|\frac{\eta}{|\mathcal{B}_{1}|}\sum_{n\in\mathcal{B}_{1}}z^{n}\sum_{1\leq i\leq l,{\bm{p}}_{i}^{n}\text{ does not contain any }{\bm{v}}^{*}_{s}}y_{i}^{n}{{\bm{p}}_{i}^{n}}^{\top}{{\bm{W}}_{B}^{(0)}}^{\top}{\bm{W}}_{C}^{(0)}{\bm{p}}_{query}^{n}G^{n}_{i,l+1}({\bm{w}}^{(0)})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(137)</span></td></tr>
<tr id="A5.E137Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E137Xa.m2" class="ltx_Math" alttext="\displaystyle\cdot(\sum_{s=i+1}^{l+1}\sigma({{\bm{w}}^{(0)}}^{\top}{\bm{p}}_{s}^{n}){\bm{p}}_{s}^{n}-(1-\sigma({{\bm{w}}^{(0)}}^{\top}{\bm{p}}_{i}^{n})){\bm{p}}_{i}^{n})\Big\|" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.222em">⋅</mo><mo stretchy="false">(</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>s</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup><mi>σ</mi><mo stretchy="false">(</mo><mi>𝒘</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝒑</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mi>n</mi></msup><mo stretchy="false">)</mo><mi>𝒑</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mi>n</mi></msup><mo>−</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>σ</mi><mo stretchy="false">(</mo><mi>𝒘</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝒑</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mi>n</mi></msup><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mi>𝒑</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mi>n</mi></msup><mo stretchy="false">)</mo><mo lspace="0em" mathsize="1.600em">∥</mo></mrow><annotation encoding="application/x-tex">\displaystyle\cdot(\sum_{s=i+1}^{l+1}\sigma({{\bm{w}}^{(0)}}^{\top}{\bm{p}}_{s}^{n}){\bm{p}}_{s}^{n}-(1-\sigma({{\bm{w}}^{(0)}}^{\top}{\bm{p}}_{i}^{n})){\bm{p}}_{i}^{n})\Big\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E137Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E137Xb.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E137Xb.m3" class="ltx_Math" alttext="\displaystyle\eta\sqrt{\frac{\log B}{B}}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle\eta\sqrt{\frac{\log B}{B}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p1.7" class="ltx_p"><span id="A5.SS3.p1.7.1" class="ltx_text">by (<a href="#A5.E96" title="In Proof. ‣ E.2 Proof of Lemma ‣ Appendix E Proof of Supportive Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">96</span></a>) and <math id="A5.SS3.p1.m9" class="ltx_Math" alttext="\sum_{i=1}^{l}\frac{l}{2^{l}}\leq 2" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>l</mi></msubsup><mfrac><mi>l</mi><msup><mn>2</mn><mi>l</mi></msup></mfrac></mrow><mo>≤</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{l}\frac{l}{2^{l}}\leq 2</annotation></semantics></math>. Then, with a high probability, for <math id="A5.SS3.p1.m10" class="ltx_Math" alttext="s\in[V]" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>V</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">s\in[V]</annotation></semantics></math>, <math id="A5.SS3.p1.m11" class="ltx_Math" alttext="\xi=1/(d+1)" display="inline" intent=":literal"><semantics><mrow><mi>ξ</mi><mo>=</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\xi=1/(d+1)</annotation></semantics></math>,</span></p>
