<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E88Xe.m3" class="ltx_Math" alttext="\displaystyle{\displaystyle\bm{h}}_{0}\odot\tilde{{\bm{A}}}_{1}\odot\cdots\odot\tilde{{\bm{A}}}_{i}+\sum_{j=1}^{i}({\bm{p}}_{j}\odot{\bm{s}}_{j}){\bm{B}}_{j}\odot\tilde{{\bm{A}}}_{j+1}\cdots\odot\tilde{{\bm{A}}}_{i}+({\bm{p}}_{i}\odot{\bm{s}}_{i}){\bm{B}}_{i}" display="inline" intent=":literal"><semantics><mrow><mi>𝒉</mi><msub><mrow></mrow><mn>0</mn></msub><mo lspace="0.222em" rspace="0.222em">⊙</mo><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0.222em">⊙</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">⊙</mo><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><msub><mrow></mrow><mi>i</mi></msub><mo>+</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>i</mi></msup><mo stretchy="false">(</mo><mi>𝒑</mi><msub><mrow></mrow><mi>j</mi></msub><mo lspace="0.222em" rspace="0.222em">⊙</mo><mi>𝒔</mi><msub><mrow></mrow><mi>j</mi></msub><mo stretchy="false">)</mo><mi>𝑩</mi><msub><mrow></mrow><mi>j</mi></msub><mo lspace="0.222em" rspace="0.222em">⊙</mo><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.055em">⋯</mo><mo rspace="0.222em">⊙</mo><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><msub><mrow></mrow><mi>i</mi></msub><mo>+</mo><mo stretchy="false">(</mo><mi>𝒑</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⊙</mo><mi>𝒔</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mi>𝑩</mi><msub><mrow></mrow><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle{\displaystyle\bm{h}}_{0}\odot\tilde{{\bm{A}}}_{1}\odot\cdots\odot\tilde{{\bm{A}}}_{i}+\sum_{j=1}^{i}({\bm{p}}_{j}\odot{\bm{s}}_{j}){\bm{B}}_{j}\odot\tilde{{\bm{A}}}_{j+1}\cdots\odot\tilde{{\bm{A}}}_{i}+({\bm{p}}_{i}\odot{\bm{s}}_{i}){\bm{B}}_{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E88Xf" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E88Xf.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E88Xf.m3" class="ltx_Math" alttext="\displaystyle\sum_{j=1}^{i}({\bm{p}}_{j}\odot{\bm{s}}_{j}){\bm{B}}_{j}\odot(\tilde{{\bm{A}}}_{i}\odot\cdots\odot\tilde{{\bm{A}}}_{j+1})+({\bm{p}}_{i}\odot{\bm{s}}_{i}){\bm{B}}_{i}," display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>i</mi></msup><mo stretchy="false">(</mo><mi>𝒑</mi><msub><mrow></mrow><mi>j</mi></msub><mo lspace="0.222em" rspace="0.222em">⊙</mo><mi>𝒔</mi><msub><mrow></mrow><mi>j</mi></msub><mo stretchy="false">)</mo><mi>𝑩</mi><msub><mrow></mrow><mi>j</mi></msub><mo lspace="0.222em" rspace="0.222em">⊙</mo><mo stretchy="false">(</mo><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0.222em">⊙</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">⊙</mo><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mo>+</mo><mo stretchy="false">(</mo><mi>𝒑</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⊙</mo><mi>𝒔</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mi>𝑩</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{j=1}^{i}({\bm{p}}_{j}\odot{\bm{s}}_{j}){\bm{B}}_{j}\odot(\tilde{{\bm{A}}}_{i}\odot\cdots\odot\tilde{{\bm{A}}}_{j+1})+({\bm{p}}_{i}\odot{\bm{s}}_{i}){\bm{B}}_{i},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS1.p2" class="ltx_para">
<p id="A5.SS1.p2.1" class="ltx_p"><span id="A5.SS1.p2.1.1" class="ltx_text">Then, given <math id="A5.SS1.p2.m1" class="ltx_Math" alttext="{\bm{W}}_{C}\in\mathbb{R}^{(l+1)\times d_{0}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑾</mi><mi>C</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><msub><mi>d</mi><mn>0</mn></msub></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{W}}_{C}\in\mathbb{R}^{(l+1)\times d_{0}}</annotation></semantics></math>, we have</span></p>
</div>
<div id="A5.SS1.p3" class="ltx_para">
<table id="A5.E89" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E89X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E89X.m2" class="ltx_Math" alttext="\displaystyle{\bm{o}}_{i}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒐</mi><mi>i</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{o}}_{i}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E89X.m3" class="ltx_Math" alttext="\displaystyle{\displaystyle\bm{h}}_{i}{\bm{C}}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒉</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑪</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle{\displaystyle\bm{h}}_{i}{\bm{C}}_{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(89)</span></td></tr>
<tr id="A5.E89Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E89Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E89Xa.m3" class="ltx_Math" alttext="\displaystyle{\displaystyle\bm{h}}_{i}{\bm{W}}_{C}{\bm{p}}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒉</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>C</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle{\displaystyle\bm{h}}_{i}{\bm{W}}_{C}{\bm{p}}_{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E89Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E89Xb.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E89Xb.m3" class="ltx_Math" alttext="\displaystyle\sum_{j=1}^{i}({\bm{p}}_{j}\odot{\bm{s}}_{j}){\bm{B}}_{j}(\tilde{{\bm{A}}}_{i}\odot\cdots\odot\tilde{{\bm{A}}}_{j+1}){\bm{W}}_{C}{\bm{p}}_{i}+({\bm{p}}_{i}\odot{\bm{s}}_{i}){{\bm{B}}}_{i}{\bm{W}}_{C}{\bm{p}}_{i}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>i</mi></msup><mo stretchy="false">(</mo><mi>𝒑</mi><msub><mrow></mrow><mi>j</mi></msub><mo lspace="0.222em" rspace="0.222em">⊙</mo><mi>𝒔</mi><msub><mrow></mrow><mi>j</mi></msub><mo stretchy="false">)</mo><mi>𝑩</mi><msub><mrow></mrow><mi>j</mi></msub><mo stretchy="false">(</mo><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0.222em">⊙</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">⊙</mo><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mi>𝑾</mi><msub><mrow></mrow><mi>C</mi></msub><mi>𝒑</mi><msub><mrow></mrow><mi>i</mi></msub><mo>+</mo><mo stretchy="false">(</mo><mi>𝒑</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⊙</mo><mi>𝒔</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mi>𝑩</mi><msub><mrow></mrow><mi>i</mi></msub><mi>𝑾</mi><msub><mrow></mrow><mi>C</mi></msub><mi>𝒑</mi><msub><mrow></mrow><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{j=1}^{i}({\bm{p}}_{j}\odot{\bm{s}}_{j}){\bm{B}}_{j}(\tilde{{\bm{A}}}_{i}\odot\cdots\odot\tilde{{\bm{A}}}_{j+1}){\bm{W}}_{C}{\bm{p}}_{i}+({\bm{p}}_{i}\odot{\bm{s}}_{i}){{\bm{B}}}_{i}{\bm{W}}_{C}{\bm{p}}_{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E89Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E89Xc.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E89Xc.m3" class="ltx_Math" alttext="\displaystyle\sum_{j=1}^{i}({\bm{G}}_{j,i}({\bm{W}})\odot{\bm{p}}_{j}){\bm{p}}_{j}^{\top}{\bm{W}}_{B}^{\top}{\bm{W}}_{C}{\bm{p}}_{i}," display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>i</mi></munderover></mstyle><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>𝑮</mi><mrow><mi>j</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑾</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊙</mo><msub><mi>𝒑</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>B</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>C</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mi>i</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{j=1}^{i}({\bm{G}}_{j,i}({\bm{W}})\odot{\bm{p}}_{j}){\bm{p}}_{j}^{\top}{\bm{W}}_{B}^{\top}{\bm{W}}_{C}{\bm{p}}_{i},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p3.1" class="ltx_p"><span id="A5.SS1.p3.1.1" class="ltx_text">where the <math id="A5.SS1.p3.m1" class="ltx_Math" alttext="d_{0}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mn>0</mn></msub><annotation encoding="application/x-tex">d_{0}</annotation></semantics></math>-dimensional</span></p>
<table id="A5.E90" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E90.m1" class="ltx_Math" alttext="{\bm{G}}_{j,i}({\bm{W}}):=\begin{cases}(\mathbf{1}_{d_{0}}-\sigma({\bm{W}}^{\top}{\bm{p}}_{j+1}))\odot\cdots\odot(\mathbf{1}_{d_{0}}-\sigma({\bm{W}}^{\top}{\bm{p}}_{i}))\sigma({\bm{W}}^{\top}{\bm{p}}_{j}),&amp;\text{ if }j&lt;i\\
\sigma({\bm{W}}^{\top}{\bm{p}}_{i}),&amp;\text{ if }j=i,\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝑮</mi><mrow><mi>j</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑾</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mo stretchy="false">(</mo><mn>𝟏</mn><msub><mrow></mrow><msub><mi>d</mi><mn>0</mn></msub></msub><mo>−</mo><mi>σ</mi><mo stretchy="false">(</mo><mi>𝑾</mi><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝒑</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mo rspace="0.055em" stretchy="false">)</mo><mo>⊙</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">⊙</mo><mo stretchy="false">(</mo><mn>𝟏</mn><msub><mrow></mrow><msub><mi>d</mi><mn>0</mn></msub></msub><mo>−</mo><mi>σ</mi><mo stretchy="false">(</mo><mi>𝑾</mi><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝒑</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mi>σ</mi><mo stretchy="false">(</mo><mi>𝑾</mi><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝒑</mi><msub><mrow></mrow><mi>j</mi></msub><mo stretchy="false">)</mo><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>&lt;</mo><mi>i</mi></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑾</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>=</mo><mi>i</mi></mrow><mo>,</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">{\bm{G}}_{j,i}({\bm{W}}):=\begin{cases}(\mathbf{1}_{d_{0}}-\sigma({\bm{W}}^{\top}{\bm{p}}_{j+1}))\odot\cdots\odot(\mathbf{1}_{d_{0}}-\sigma({\bm{W}}^{\top}{\bm{p}}_{i}))\sigma({\bm{W}}^{\top}{\bm{p}}_{j}),&amp;\text{ if }j&lt;i\\
\sigma({\bm{W}}^{\top}{\bm{p}}_{i}),&amp;\text{ if }j=i,\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(90)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p3.2" class="ltx_p"><span id="A5.SS1.p3.2.1" class="ltx_text">with <math id="A5.SS1.p3.m2" class="ltx_Math" alttext="\sigma(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\sigma(\cdot)</annotation></semantics></math> as the sigmoid function. Therefore, we can obtain (<a href="#S2.E3" title="In 2 Problem Formulation ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>), i.e.,</span></p>
<table id="A5.E91" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E91.m1" class="ltx_Math" alttext="F(\Psi;{\bm{P}})={\bm{e}}_{d+1}^{\top}{\bm{o}}_{l+1}=\sum_{i=1}^{l+1}G_{i,l+1}({\bm{w}})y_{i}{\bm{p}}_{i}^{\top}{\bm{W}}_{B}^{\top}{\bm{W}}_{C}{\bm{p}}_{query}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo>,</mo><mi>𝑷</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>𝒆</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒐</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></munderover><mrow><msub><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒘</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>B</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>C</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">F(\Psi;{\bm{P}})={\bm{e}}_{d+1}^{\top}{\bm{o}}_{l+1}=\sum_{i=1}^{l+1}G_{i,l+1}({\bm{w}})y_{i}{\bm{p}}_{i}^{\top}{\bm{W}}_{B}^{\top}{\bm{W}}_{C}{\bm{p}}_{query},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(91)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p3.3" class="ltx_p"><span id="A5.SS1.p3.3.1" class="ltx_text">where</span></p>
<table id="A5.E92" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E92X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E92X.m2" class="ltx_Math" alttext="\displaystyle G_{i,l+1}({\bm{w}}):=" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒘</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle G_{i,l+1}({\bm{w}}):=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E92X.m3" class="ltx_Math" alttext="\displaystyle({\bm{G}}_{i,l+1}({\bm{W}}))_{d+1}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝑮</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑾</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\displaystyle({\bm{G}}_{i,l+1}({\bm{W}}))_{d+1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(92)</span></td></tr>
<tr id="A5.E92Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E92Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E92Xa.m3" class="ltx_Math" alttext="\displaystyle\begin{cases}\sigma({\bm{w}}^{\top}{\bm{p}}_{j})\prod_{k=j+1}^{l+1}(1-\sigma({\bm{w}}^{\top}{\bm{p}}_{k})),&amp;\text{ if }j&lt;i\\
\sigma({\bm{w}}^{\top}{\bm{p}}_{i}),&amp;\text{ if }j=i.\end{cases}" display="inline" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒘</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0em">∏</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒘</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>&lt;</mo><mi>i</mi></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒘</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>=</mo><mi>i</mi></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\displaystyle\begin{cases}\sigma({\bm{w}}^{\top}{\bm{p}}_{j})\prod_{k=j+1}^{l+1}(1-\sigma({\bm{w}}^{\top}{\bm{p}}_{k})),&amp;\text{ if }j&lt;i\\
\sigma({\bm{w}}^{\top}{\bm{p}}_{i}),&amp;\text{ if }j=i.\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS1.p4" class="ltx_para">
<p id="A5.SS1.p4.1" class="ltx_p"><span id="A5.SS1.p4.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A5.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.2 </span>Proof of Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ Appendix C Key Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a></h3>

<div id="A5.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS2.p1" class="ltx_para">
<p id="A5.SS2.p1.2" class="ltx_p"><span id="A5.SS2.p1.2.1" class="ltx_text">(a) When <math id="A5.SS2.p1.m1" class="ltx_Math" alttext="F(\Psi;{\bm{P}}^{n})\in(-1,1)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F(\Psi;{\bm{P}}^{n})\in(-1,1)</annotation></semantics></math> for some <math id="A5.SS2.p1.m2" class="ltx_Math" alttext="n\in[N]" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">n\in[N]</annotation></semantics></math>, we have</span></p>
<table id="A5.E93" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E93X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E93X.m2" class="ltx_Math" alttext="\displaystyle\frac{\partial\ell(\Psi;{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{C}}=" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msub><mi>𝑾</mi><mi>C</mi></msub></mrow></mfrac></mstyle><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\partial\ell(\Psi;{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{C}}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E93X.m3" class="ltx_Math" alttext="\displaystyle-z^{n}\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}})y_{i}^{n}{\bm{W}}_{B}{\bm{p}}_{i}^{n}{{\bm{p}}_{query}^{n}}^{\top}." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>z</mi><msup><mrow></mrow><mi>n</mi></msup><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>l</mi></msup><mi>G</mi><msup><mrow></mrow><mi>n</mi></msup><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">(</mo><mi>𝒘</mi><mo stretchy="false">)</mo><mi>y</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mi>n</mi></msup><mi>𝑾</mi><msub><mrow></mrow><mi>B</mi></msub><mi>𝒑</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mi>n</mi></msup><mi>𝒑</mi><msub><mrow></mrow><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub><msup><mrow></mrow><mi>n</mi></msup><msup><mrow></mrow><mo>⊤</mo></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-z^{n}\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}})y_{i}^{n}{\bm{W}}_{B}{\bm{p}}_{i}^{n}{{\bm{p}}_{query}^{n}}^{\top}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(93)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p1.3" class="ltx_p"><span id="A5.SS2.p1.3.1" class="ltx_text">When <math id="A5.SS2.p1.m3" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math>, we know that with high probability,</span></p>
<table id="A5.E94" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E94.m1" class="ltx_Math" alttext="|{{\bm{w}}^{(0)}}^{\top}{\bm{x}}_{j}|\lesssim\xi=\frac{1}{d+1}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>j</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mo>≲</mo><mi>ξ</mi><mo>=</mo><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">|{{\bm{w}}^{(0)}}^{\top}{\bm{x}}_{j}|\lesssim\xi=\frac{1}{d+1},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(94)</span></td></tr></tbody>
</table>
<table id="A5.E95" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E95.m1" class="ltx_Math" alttext="|\sigma({{\bm{w}}^{(0)}}^{\top}{\bm{x}}_{j})-\frac{1}{2}|\lesssim\frac{|1-e^{\pm\xi}|}{2(1+e^{\pm\xi})}\lesssim\xi." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><mo stretchy="false">|</mo></mrow><mo>≲</mo><mfrac><mrow><mo stretchy="false">|</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>±</mo><mi>ξ</mi></mrow></msup></mrow><mo stretchy="false">|</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>e</mi><mrow><mo>±</mo><mi>ξ</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>≲</mo><mi>ξ</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|\sigma({{\bm{w}}^{(0)}}^{\top}{\bm{x}}_{j})-\frac{1}{2}|\lesssim\frac{|1-e^{\pm\xi}|}{2(1+e^{\pm\xi})}\lesssim\xi.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(95)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p1.4" class="ltx_p"><span id="A5.SS2.p1.4.1" class="ltx_text">Then,</span></p>
<table id="A5.E96" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E96.m1" class="ltx_Math" alttext="\frac{1}{2^{l+2-i}}(1-\xi(l+2-i))\leq{G^{n}}_{i,l+1}^{(0)}({\bm{w}})\lesssim\frac{1}{2^{l+2-i}}(1+\xi(l+2-i))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mn>1</mn><msup><mn>2</mn><mrow><mrow><mi>l</mi><mo>+</mo><mn>2</mn></mrow><mo>−</mo><mi>i</mi></mrow></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>ξ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>l</mi><mo>+</mo><mn>2</mn></mrow><mo>−</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mmultiscripts><mi>G</mi><mrow></mrow><mi>n</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒘</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≲</mo><mrow><mfrac><mn>1</mn><msup><mn>2</mn><mrow><mrow><mi>l</mi><mo>+</mo><mn>2</mn></mrow><mo>−</mo><mi>i</mi></mrow></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>ξ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>l</mi><mo>+</mo><mn>2</mn></mrow><mo>−</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{1}{2^{l+2-i}}(1-\xi(l+2-i))\leq{G^{n}}_{i,l+1}^{(0)}({\bm{w}})\lesssim\frac{1}{2^{l+2-i}}(1+\xi(l+2-i)).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(96)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p1.5" class="ltx_p"><span id="A5.SS2.p1.5.1" class="ltx_text">Let the IDR pattern of <math id="A5.SS2.p1.m4" class="ltx_Math" alttext="{\bm{\mu}}_{query}^{n}" display="inline" intent=":literal"><semantics><msubsup><mi>𝝁</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>n</mi></msubsup><annotation encoding="application/x-tex">{\bm{\mu}}_{query}^{n}</annotation></semantics></math> be <math id="A5.SS2.p1.m5" class="ltx_Math" alttext="{\bm{\mu}}_{j}" display="inline" intent=":literal"><semantics><msub><mi>𝝁</mi><mi>j</mi></msub><annotation encoding="application/x-tex">{\bm{\mu}}_{j}</annotation></semantics></math>, <math id="A5.SS2.p1.m6" class="ltx_Math" alttext="j\in[M_{1}]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[M_{1}]</annotation></semantics></math>. Note that <math id="A5.SS2.p1.m7" class="ltx_Math" alttext="\frac{1}{2}\cdot p_{a}" display="inline" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><annotation encoding="application/x-tex">\frac{1}{2}\cdot p_{a}</annotation></semantics></math> fraction of examples correspond to <math id="A5.SS2.p1.m8" class="ltx_Math" alttext="{\bm{\mu}}_{j}" display="inline" intent=":literal"><semantics><msub><mi>𝝁</mi><mi>j</mi></msub><annotation encoding="application/x-tex">{\bm{\mu}}_{j}</annotation></semantics></math> with poisoned labels. For different <math id="A5.SS2.p1.m9" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>, <math id="A5.SS2.p1.m10" class="ltx_Math" alttext="y_{*}^{f}=1" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>y</mi><mo>∗</mo><mi>f</mi></msubsup><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">y_{*}^{f}=1</annotation></semantics></math> or <math id="A5.SS2.p1.m11" class="ltx_Math" alttext="-1" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">-1</annotation></semantics></math> with <math id="A5.SS2.p1.m12" class="ltx_Math" alttext="1/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">1/2</annotation></semantics></math> probability. By Lemma <a href="#Thmlemma1" title="Lemma 1. ‣ Appendix C Key Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, we have for any <math id="A5.SS2.p1.m13" class="ltx_Math" alttext="i\in l" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mi>l</mi></mrow><annotation encoding="application/x-tex">i\in l</annotation></semantics></math>,</span></p>
<table id="A5.E97" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E97X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E97X.m2" class="ltx_Math" alttext="\displaystyle\Pr\Big(\frac{1}{|\mathcal{B}_{b}|}\sum_{i\in\mathcal{B}_{b}}\mathbbm{1}[{\bm{x}}_{i}^{n}\text{ contains }{\bm{\mu}}_{j}\text{ and no }{\bm{v}}^{*}_{s}]-(1-p_{a})\leq-\frac{c}{M_{1}}(1-p_{a})\Big)\lesssim e^{-\frac{B(1-p_{a})}{M_{1}}}\leq\epsilon," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></munder></mstyle><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝒙</mi><mi>i</mi><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mtext> contains </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mtext> and no </mtext><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>c</mi><msub><mi>M</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>≲</mo><msup><mi>e</mi><mrow><mo>−</mo><mfrac><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><msub><mi>M</mi><mn>1</mn></msub></mfrac></mrow></msup><mo>≤</mo><mi>ϵ</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Pr\Big(\frac{1}{|\mathcal{B}_{b}|}\sum_{i\in\mathcal{B}_{b}}\mathbbm{1}[{\bm{x}}_{i}^{n}\text{ contains }{\bm{\mu}}_{j}\text{ and no }{\bm{v}}^{*}_{s}]-(1-p_{a})\leq-\frac{c}{M_{1}}(1-p_{a})\Big)\lesssim e^{-\frac{B(1-p_{a})}{M_{1}}}\leq\epsilon,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(97)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p1.6" class="ltx_p"><span id="A5.SS2.p1.6.1" class="ltx_text">for some <math id="A5.SS2.p1.m14" class="ltx_Math" alttext="c\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">c\in(0,1)</annotation></semantics></math> and <math id="A5.SS2.p1.m15" class="ltx_Math" alttext="\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon&gt;0</annotation></semantics></math> if</span></p>
<table id="A5.E98" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E98.m1" class="ltx_Math" alttext="B\gtrsim(1-p_{a})^{-1}M_{1}\log\epsilon^{-1}." display="block" intent=":literal"><semantics><mrow><mrow><mi>B</mi><mo>≳</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">B\gtrsim(1-p_{a})^{-1}M_{1}\log\epsilon^{-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(98)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p1.7" class="ltx_p"><span id="A5.SS2.p1.7.1" class="ltx_text">By (<a href="#A3.E22" title="In Lemma 2. ‣ Appendix C Key Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>), let <math id="A5.SS2.p1.m16" class="ltx_math_unparsed" alttext="\mathcal{B}_{b}^{\prime}=\{i:i\in\mathcal{B}_{b},{\bm{x}}_{i}^{n}\text{ contains }{\bm{\mu}}_{j}\text{ and }{\bm{\nu}}^{*}_{s},s\in[V]\}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi><mo>′</mo></msubsup><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>i</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo>,</mo><msubsup><mi>𝒙</mi><mi>i</mi><mi>n</mi></msubsup><mtext> contains </mtext><msub><mi>𝝁</mi><mi>j</mi></msub><mtext> and </mtext><msubsup><mi>𝝂</mi><mi>s</mi><mo>∗</mo></msubsup><mo>,</mo><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>V</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{B}_{b}^{\prime}=\{i:i\in\mathcal{B}_{b},{\bm{x}}_{i}^{n}\text{ contains }{\bm{\mu}}_{j}\text{ and }{\bm{\nu}}^{*}_{s},s\in[V]\}</annotation></semantics></math>we have</span></p>
<table id="A5.E99" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E99X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E99X.m2" class="ltx_Math" alttext="\displaystyle\Pr\Big(\Big|\frac{1}{|\mathcal{B}_{b}^{\prime}|}\sum_{i\in\mathcal{B}_{b}^{\prime}}(\mathbbm{1}[y_{i}^{n}=z^{n}]-\mathbbm{1}[y_{i}^{n}=-z^{n}])\Big|\geq\sqrt{\frac{\log B}{B}}\Big)\leq M_{1}^{-C}," display="inline" intent=":literal"><semantics><mrow><mi>Pr</mi><mo maxsize="1.600em" minsize="1.600em">(</mo><mo fence="false" maxsize="1.600em" minsize="1.600em" rspace="0.167em" stretchy="true">|</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi><mo>′</mo></msubsup><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi><mo>′</mo></msubsup></mrow></msub><mo stretchy="false">(</mo><mn>𝟙</mn><mo stretchy="false">[</mo><mi>y</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mi>n</mi></msup><mo>=</mo><mi>z</mi><msup><mrow></mrow><mi>n</mi></msup><mo stretchy="false">]</mo><mo>−</mo><mn>𝟙</mn><mo stretchy="false">[</mo><mi>y</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mi>n</mi></msup><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mi>z</mi><msup><mrow></mrow><mi>n</mi></msup><mo stretchy="false">]</mo><mo stretchy="false">)</mo><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0.167em">≥</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt><mo maxsize="1.600em" minsize="1.600em">)</mo><mo>≤</mo><mi>M</mi><msub><mrow></mrow><mn>1</mn></msub><msup><mrow></mrow><mrow><mo>−</mo><mi>C</mi></mrow></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Pr\Big(\Big|\frac{1}{|\mathcal{B}_{b}^{\prime}|}\sum_{i\in\mathcal{B}_{b}^{\prime}}(\mathbbm{1}[y_{i}^{n}=z^{n}]-\mathbbm{1}[y_{i}^{n}=-z^{n}])\Big|\geq\sqrt{\frac{\log B}{B}}\Big)\leq M_{1}^{-C},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(99)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p1.8" class="ltx_p"><span id="A5.SS2.p1.8.1" class="ltx_text">for some <math id="A5.SS2.p1.m17" class="ltx_Math" alttext="c\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">c\in(0,1)</annotation></semantics></math> and <math id="A5.SS2.p1.m18" class="ltx_Math" alttext="C&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">C&gt;1</annotation></semantics></math>.
Therefore, we have</span></p>
