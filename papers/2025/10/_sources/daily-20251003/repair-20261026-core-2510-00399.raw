<th id="S4.SS2.p5.1.1.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt">LT</th></tr>
<tr id="S4.SS2.p5.1.2" class="ltx_tr">
<td id="S4.SS2.p5.1.2.1" class="ltx_td ltx_align_left ltx_border_t">FQ</td>
<td id="S4.SS2.p5.1.2.2" class="ltx_td ltx_align_left ltx_border_t">99.84%</td>
