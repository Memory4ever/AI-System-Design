<span id="A2.F5.2.1.1.1.2" class="ltx_td ltx_align_center">
<img src="2510.00399v1/layer3_linear.png" id="A2.F5.g2" class="ltx_graphics ltx_img_square" style="aspect-ratio:115/115;" width="115" height="115" alt="Refer to caption"></span></span>
