<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E142Xc.m2" class="ltx_Math" alttext="\displaystyle\lesssim" display="inline" intent=":literal"><semantics><mo>≲</mo><annotation encoding="application/x-tex">\displaystyle\lesssim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E142Xc.m3" class="ltx_Math" alttext="\displaystyle\xi+\frac{\eta}{M_{1}}\sqrt{\frac{\log B}{B}}-\eta\beta^{2}\sum_{i=1}^{l}\frac{1}{2^{l+2-i}}\cdot\frac{(1-p_{a})}{2M_{1}}(l-i+1)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ξ</mi><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>η</mi><msub><mi>M</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt></mrow></mrow><mo>−</mo><mrow><mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>l</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mn>2</mn><mrow><mrow><mi>l</mi><mo>+</mo><mn>2</mn></mrow><mo>−</mo><mi>i</mi></mrow></msup></mfrac></mstyle></mrow></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub></mrow></mfrac></mstyle></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>l</mi><mo>−</mo><mi>i</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\xi+\frac{\eta}{M_{1}}\sqrt{\frac{\log B}{B}}-\eta\beta^{2}\sum_{i=1}^{l}\frac{1}{2^{l+2-i}}\cdot\frac{(1-p_{a})}{2M_{1}}(l-i+1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
