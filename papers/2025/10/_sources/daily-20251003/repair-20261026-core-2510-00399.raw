<span id="A2.F6.2.1.1" class="ltx_tabular ltx_align_middle">
<span class="ltx_tbody">
<span id="A2.F6.2.1.1.1" class="ltx_tr">
<span id="A2.F6.2.1.1.1.1" class="ltx_td ltx_align_center"><img src="2510.00399v1/gating_l2.png" id="A2.F6.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:115/86;" width="115" height="86" alt="Refer to caption"></span>
<span id="A2.F6.2.1.1.1.2" class="ltx_td ltx_align_center">
<img src="2510.00399v1/gating_l3.png" id="A2.F6.g2" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:115/86;" width="115" height="86" alt="Refer to caption"></span></span>
