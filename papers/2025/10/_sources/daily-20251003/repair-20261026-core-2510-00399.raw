<tr id="A5.E132X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E132X.m2" class="ltx_Math" alttext="\displaystyle\Big|-({{\bm{\nu}}_{k}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(b)}}({\bm{\nu}}_{k}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta(t_{0}+1)\beta}{M_{2}}\sqrt{\frac{\log B}{B}}." display="inline" intent=":literal"><semantics><mrow><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0em">−</mo><mo stretchy="false">(</mo><mi>𝝂</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow></msup><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mi>B</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mi>𝝂</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0.167em">≤</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><msub><mi>M</mi><mn>2</mn></msub></mfrac></mstyle><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big|-({{\bm{\nu}}_{k}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(b)}}({\bm{\nu}}_{k}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta(t_{0}+1)\beta}{M_{2}}\sqrt{\frac{\log B}{B}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(132)</span></td></tr></tbody>
</table>
<table id="A5.E133" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E133X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E133X.m2" class="ltx_Math" alttext="\displaystyle\Big|-({{\bm{\nu}}_{k^{\prime}}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(b)}}({\bm{\nu}}_{k}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta(t_{0}+1)\beta}{M_{2}^{2}}\sqrt{\frac{\log B}{B}}." display="inline" intent=":literal"><semantics><mrow><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0em">−</mo><mo stretchy="false">(</mo><mi>𝝂</mi><msub><mrow></mrow><msup><mi>k</mi><mo>′</mo></msup></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow></msup><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mi>B</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mi>𝝂</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0.167em">≤</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><msubsup><mi>M</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big|-({{\bm{\nu}}_{k^{\prime}}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(b)}}({\bm{\nu}}_{k}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta(t_{0}+1)\beta}{M_{2}^{2}}\sqrt{\frac{\log B}{B}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(133)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p2.12" class="ltx_p">We also have that for any <math id="A5.SS2.p2.m24" class="ltx_Math" alttext="s\in[V]" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>V</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">s\in[V]</annotation></semantics></math>,</p>
<table id="A5.E134" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E134X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E134X.m2" class="ltx_Math" alttext="\displaystyle\Big|({{\bm{\nu}}^{*}_{s}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(b)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta\beta(t_{0}+1)p_{a}\kappa_{*}}{M_{1}V}\cdot\sqrt{\frac{\log B}{B}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝝂</mi><mi>s</mi><mo>∗</mo><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mi>B</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>j</mi><mo>⊤</mo></msubsup><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mo>∗</mo></msub></mrow><mrow><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big|({{\bm{\nu}}^{*}_{s}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(b)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta\beta(t_{0}+1)p_{a}\kappa_{*}}{M_{1}V}\cdot\sqrt{\frac{\log B}{B}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(134)</span></td></tr></tbody>
</table>
