<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E100Xc.m2" class="ltx_Math" alttext="\displaystyle\cdot y_{i}^{n}{\bm{W}}_{B}^{(0)}{\bm{p}}_{i}^{n}{{\bm{p}}_{query}^{n}}^{\top}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}\mathbbm{1}[{\bm{x}}_{i}^{n}\text{ contains any }{\bm{v}}^{*}_{s}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><msubsup><mi>y</mi><mi>i</mi><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>B</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>i</mi><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝒑</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>n</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>j</mi><mo>⊤</mo></msubsup><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝒙</mi><mi>i</mi><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mtext> contains any </mtext><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\cdot y_{i}^{n}{\bm{W}}_{B}^{(0)}{\bm{p}}_{i}^{n}{{\bm{p}}_{query}^{n}}^{\top}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}\mathbbm{1}[{\bm{x}}_{i}^{n}\text{ contains any }{\bm{v}}^{*}_{s}]</annotation></semantics></math></td>
