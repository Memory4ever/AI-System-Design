<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E142Xe.m3" class="ltx_Math" alttext="\displaystyle-\frac{\eta(1-p_{a})\beta^{2}}{M_{1}}." display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><msub><mi>M</mi><mn>1</mn></msub></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{\eta(1-p_{a})\beta^{2}}{M_{1}}.</annotation></semantics></math></td>
