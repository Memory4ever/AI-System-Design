nnotation encoding="application/x-tex">\displaystyle\cdot(\sum_{s=i+1}^{l+1}\sigma({{\bm{w}}^{(0)}}^{\top}{\bm{p}}_{s}^{n}){{\bm{v}}^{*}_{s}}^{\top}{\bm{p}}_{s}^{n}-(1-\sigma({{\bm{w}}^{(0)}}^{\top}{\bm{p}}_{i}^{n})){{\bm{v}}^{*}_{s}}^{\top}{\bm{p}}_{i}^{n})</annotation></semantics></math></td>
