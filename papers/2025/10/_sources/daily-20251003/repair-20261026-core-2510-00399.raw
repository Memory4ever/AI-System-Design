<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E100Xa.m3" class="ltx_Math" alttext="\displaystyle({\bm{\mu}}_{j}^{\top},0^{\top})\frac{\eta}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}z^{n}\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(0)})y_{i}^{n}{\bm{W}}_{B}^{(0)}{\bm{p}}_{i}^{n}{{\bm{p}}_{query}^{n}}^{\top}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>j</mi><mo>⊤</mo></msubsup><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>η</mi><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></munder></mstyle><mrow><msup><mi>z</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>l</mi></munderover></mstyle><mrow><msubsup><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>y</mi><mi>i</mi><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>B</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>i</mi><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝒑</mi><mrow><mi>q</mi><mo lspace="0em" rspa