<section id="A5.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.3 </span>Proof of Lemma <a href="#Thmlemma4" title="Lemma 4. ‣ Appendix C Key Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a></h3>

<div id="A5.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS3.p1" class="ltx_para">
<p id="A5.SS3.p1.4" class="ltx_p"><span id="A5.SS3.p1.4.1" class="ltx_text">When <math id="A5.SS3.p1.m1" class="ltx_Math" alttext="F(\Psi;{\bm{P}}^{n})\in(-1,1)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F(\Psi;{\bm{P}}^{n})\in(-1,1)</annotation></semantics></math> for some <math id="A5.SS3.p1.m2" class="ltx_Math" alttext="n\in[N]" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">n\in[N]</annotation></semantics></math>,</span></p>
<table id="A5.E135" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E135X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E135X.m2" class="ltx_Math" alttext="\displaystyle\frac{\partial\ell(\Psi;{\bm{P}}^{n},z^{n})}{\partial{\bm{w}}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mi>𝒘</mi></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\partial\ell(\Psi;{\bm{P}}^{n},z^{n})}{\partial{\bm{w}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="10" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(135)</span></td></tr>
<tr id="A5.E135Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E135Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E135Xa.m3" class="ltx_Math" alttext="\displaystyle-z^{n}\sum_{i=1}^{l}y_{i}^{n}{{\bm{p}}_{i}^{n}}^{\top}{\bm{W}}_{B}^{\top}{\bm{W}}_{C}{\bm{p}}_{query}^{n}\frac{\partial G^{n}_{i,l+1}({\bm{w}})}{\partial{\bm{w}}}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>z</mi><msup><mrow></mrow><mi>n</mi></msup><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>l</mi></msup><mi>y</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mi>n</mi></msup><mi>𝒑</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mi>n</mi></msup><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝑾</mi><msub><mrow></mrow><mi>B</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝑾</mi><msub><mrow></mrow><mi>C</mi></msub><mi>𝒑</mi><msub><mrow></mrow><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub><msup><mrow></mrow><mi>n</mi></msup><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><msubsup><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒘</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mi>𝒘</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle-z^{n}\sum_{i=1}^{l}y_{i}^{n}{{\bm{p}}_{i}^{n}}^{\top}{\bm{W}}_{B}^{\top}{\bm{W}}_{C}{\bm{p}}_{query}^{n}\frac{\partial G^{n}_{i,l+1}({\bm{w}})}{\partial{\bm{w}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E135Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
