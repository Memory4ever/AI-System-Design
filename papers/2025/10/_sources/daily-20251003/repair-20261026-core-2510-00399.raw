<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E100Xd.m3" class="ltx_Math" alttext="\displaystyle\eta\cdot\frac{1}{2M_{1}}(1-p_{a})\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(0)})\beta-\eta\cdot\frac{1}{2M_{1}}\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(0)})\beta p_{a}\sqrt{\frac{\log B}{B}}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>p</mi><msub><mrow></mrow><mi>a</mi></msub><mo rspace="0.167em" stretchy="false">)</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>l</mi></msup><mi>G</mi><msup><mrow></mrow><mi>n</mi></msup><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">(</mo><mi>𝒘</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo><mi>β</mi><mo>−</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>l</mi></msup><mi>G</mi><msup><mrow></mrow><mi>n</mi></msup><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">(</mo><mi>𝒘</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo><mi>β</mi><mi>p</mi><msub><mrow></mrow><mi>a</mi></msub><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle\eta\cdot\frac{1}{2M_{1}}(1-p_{a})\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(0)})\beta-\eta\cdot\frac{1}{2M_{1}}\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(0)})\beta p_{a}\sqrt{\frac{\log B}{B}}</annotation></semantics></math></td>
