<p id="A5.SS2.p1.13" class="ltx_p"><span id="A5.SS2.p1.13.1" class="ltx_text">Since that for <math id="A5.SS2.p1.m26" class="ltx_Math" alttext="{\bm{x}}_{i}^{n}" display="inline" intent=":literal"><semantics><msubsup><mi>𝒙</mi><mi>i</mi><mi>n</mi></msubsup><annotation encoding="application/x-tex">{\bm{x}}_{i}^{n}</annotation></semantics></math> that contains <math id="A5.SS2.p1.m27" class="ltx_Math" alttext="{\bm{\nu}}^{*}_{s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝝂</mi><mi>s</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">{\bm{\nu}}^{*}_{s}</annotation></semantics></math> for a certain <math id="A5.SS2.p1.m28" class="ltx_Math" alttext="s\in[V]" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>V</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">s\in[V]</annotation></semantics></math>,</span></p>
<table id="A5.E108" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E108.m1" class="ltx_Math" alttext="\Pr(y_{i}^{n}=z^{n})=\Pr(y_{i}^{n}=-z^{n})=\frac{1}{2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>y</mi><mi>i</mi><mi>n</mi></msubsup><mo>=</mo><msup><mi>z</mi><mi>n</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>y</mi><mi>i</mi><mi>n</mi></msubsup><mo>=</mo><mrow><mo>−</mo><msup><mi>z</mi><mi>n</mi></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\Pr(y_{i}^{n}=z^{n})=\Pr(y_{i}^{n}=-z^{n})=\frac{1}{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(108)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p1.14" class="ltx_p"><span id="A5.SS2.p1.14.1" class="ltx_text">we have</span></p>
<table id="A5.E109" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E109X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E109X.m2" class="ltx_Math" alttext="\displaystyle\Big|({{\bm{\nu}}^{*}_{s}}^{\top},0^{\top})\eta\cdot\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(0)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{C}^{(0)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}\Big|" display="inline" intent=":literal"><semantics><mrow><mo fence="false" maxsize="1.600em" minsize="1.600em" rspace="0.167em" stretchy="true">|</mo><mo stretchy="false">(</mo><mi>𝝂</mi><msup><mrow></mrow><mo>∗</mo></msup><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mi>C</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mi>𝝁</mi><msub><mrow></mrow><mi>j</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big|({{\bm{\nu}}^{*}_{s}}^{\top},0^{\top})\eta\cdot\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(0)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{C}^{(0)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}\Big|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(109)</span></td></tr>
<tr id="A5.E109Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E109Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E109Xa.m3" class="ltx_Math" alttext="\displaystyle\Big|({{\bm{\nu}}^{*}_{s}}^{\top},0^{\top})\frac{\eta}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}z^{n}\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(0)})y_{i}^{n}{\bm{W}}_{B}^{(0)}{\bm{p}}_{i}^{n}{{\bm{p}}_{query}^{n}}^{\top}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}\Big|" display="inline" intent=":literal"><semantics><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝝂</mi><mi>s</mi><mo>∗</mo><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>η</mi><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></munder></mstyle><mrow><msup><mi>z</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>l</mi></munderover></mstyle><mrow><msubsup><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>y</mi><mi>i</mi><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>B</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>i</mi><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝒑</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>n</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>j</mi><mo>⊤</mo></msubsup><mo mathsize="1.600em">,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big|({{\bm{\nu}}^{*}_{s}}^{\top},0^{\top})\frac{\eta}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}z^{n}\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(0)})y_{i}^{n}{\bm{W}}_{B}^{(0)}{\bm{p}}_{i}^{n}{{\bm{p}}_{query}^{n}}^{\top}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}\Big|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E109Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E109Xb.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E109Xb.m3" class="ltx_Math" alttext="\displaystyle\frac{\eta\beta p_{a}\kappa_{*}}{M_{1}V}\cdot\sqrt{\frac{\log B}{B}}," display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mo>∗</mo></msub></mrow><mrow><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\eta\beta p_{a}\kappa_{*}}{M_{1}V}\cdot\sqrt{\frac{\log B}{B}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p1.15" class="ltx_p"><span id="A5.SS2.p1.15.1" class="ltx_text">Suppose that the conclusion holds when <math id="A5.SS2.p1.m29" class="ltx_Math" alttext="t=t_{0}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><msub><mi>t</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">t=t_{0}</annotation></semantics></math>. Then, when <math id="A5.SS2.p1.m30" class="ltx_Math" alttext="t=t_{0}+1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">t=t_{0}+1</annotation></semantics></math>, we have</span></p>
<table id="A5.E110" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E110X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E110X.m2" class="ltx_Math" alttext="\displaystyle-({\bm{\mu}}_{j}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{C}^{(b)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mo stretchy="false">(</mo><mi>𝝁</mi><msub><mrow></mrow><mi>j</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow></msup><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mi>C</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mi>𝝁</mi><msub><mrow></mrow><mi>j</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle-({\bm{\mu}}_{j}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{C}^{(b)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(110)</span></td></tr>
<tr id="A5.E110Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E110Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E110Xa.m3" class="ltx_Math" alttext="\displaystyle({\bm{\mu}}_{j}^{\top},0^{\top})\sum_{b=1}^{t_{0}+1}\frac{\eta}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}z^{n}\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(b)})y_{i}^{n}{\bm{W}}_{B}^{(b)}{\bm{p}}_{i}^{n}{{\bm{p}}_{query}^{n}}^{\top}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>j</mi><mo>⊤</mo></msubsup><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mi>η</mi><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></munder></mstyle><mrow><msup><mi>z</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>l</mi></munderover></mstyle><mrow><msubsup><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>y</mi><mi>i</mi><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>B</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>i</mi><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝒑</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>n</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>j</mi><mo>⊤</mo></msubsup><mo mathsize="0.700em">,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle({\bm{\mu}}_{j}^{\top},0^{\top})\sum_{b=1}^{t_{0}+1}\frac{\eta}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}z^{n}\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(b)})y_{i}^{n}{\bm{W}}_{B}^{(b)}{\bm{p}}_{i}^{n}{{\bm{p}}_{query}^{n}}^{\top}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E110Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E110Xb.m2" class="ltx_Math" alttext="\displaystyle\gtrsim" display="inline" intent=":literal"><semantics><mo>≳</mo><annotation encoding="application/x-tex">\displaystyle\gtrsim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E110Xb.m3" class="ltx_Math" alttext="\displaystyle\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{2M_{1}}(1-p_{a})\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(t_{0})})\beta" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>l</mi></munderover></mstyle><mrow><msubsup><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{2M_{1}}(1-p_{a})\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(t_{0})})\beta</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E110Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E110Xc.m2" class="ltx_Math" alttext="\displaystyle\gtrsim" display="inline" intent=":literal"><semantics><mo>≳</mo><annotation encoding="application/x-tex">\displaystyle\gtrsim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E110Xc.m3" class="ltx_Math" alttext="\displaystyle\eta(t_{0}+1)\frac{1}{M_{1}}(1-p_{a})\beta." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>M</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\eta(t_{0}+1)\frac{1}{M_{1}}(1-p_{a})\beta.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p1.16" class="ltx_p"><span id="A5.SS2.p1.16.1" class="ltx_text">The last step holds since <math id="A5.SS2.p1.m31" class="ltx_Math" alttext="\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(t_{0})})\gtrsim 1" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>l</mi></msubsup><mrow><msubsup><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≳</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(t_{0})})\gtrsim 1</annotation></semantics></math>. Similarly, we have that for any <math id="A5.SS2.p1.m32" class="ltx_Math" alttext="s\in[V]" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>V</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">s\in[V]</annotation></semantics></math>,</span></p>
<table id="A5.E111" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E111X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E111X.m2" class="ltx_Math" alttext="\displaystyle\Big|({{\bm{\nu}}^{*}_{s}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{C}^{(b)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta\beta(t_{0}+1)p_{a}\kappa_{*}}{M_{1}}\cdot\sqrt{\frac{\log B}{B}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝝂</mi><mi>s</mi><mo>∗</mo><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mi>C</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>j</mi><mo>⊤</mo></msubsup><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mo>∗</mo></msub></mrow><msub><mi>M</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big|({{\bm{\nu}}^{*}_{s}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{C}^{(b)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta\beta(t_{0}+1)p_{a}\kappa_{*}}{M_{1}}\cdot\sqrt{\frac{\log B}{B}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(111)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p1.17" class="ltx_p"><span id="A5.SS2.p1.17.1" class="ltx_text">For <math id="A5.SS2.p1.m33" class="ltx_Math" alttext="{\bm{\mu}}_{j^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>𝝁</mi><msup><mi>j</mi><mo>′</mo></msup></msub><annotation encoding="application/x-tex">{\bm{\mu}}_{j^{\prime}}</annotation></semantics></math>, <math id="A5.SS2.p1.m34" class="ltx_Math" alttext="j^{\prime}\neq j" display="inline" intent=":literal"><semantics><mrow><msup><mi>j</mi><mo>′</mo></msup><mo>≠</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">j^{\prime}\neq j</annotation></semantics></math>, that forms a task in the training set, we have</span></p>
<table id="A5.E112" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E112.m1" class="ltx_math_unparsed" alttext="-({{\bm{\mu}}_{j^{\prime}}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{C}^{(b)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}=0" display="block" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝝁</mi><msup><mi>j</mi><mo>′</mo></msup><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mi>η</mi><mo lspace="0.222em" rspace="0.055em">⋅</mo><munderover><mo movablelimits="false">∑</mo><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow></munderover><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></munder><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mi>C</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>j</mi><mo>⊤</mo></msubsup><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">-({{\bm{\mu}}_{j^{\prime}}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{C}^{(b)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(112)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p1.18" class="ltx_p"><span id="A5.SS2.p1.18.1" class="ltx_text">For <math id="A5.SS2.p1.m35" class="ltx_Math" alttext="{\bm{\mu}}_{j^{\prime\prime}}" display="inline" intent=":literal"><semantics><msub><mi>𝝁</mi><msup><mi>j</mi><mo>′′</mo></msup></msub><annotation encoding="application/x-tex">{\bm{\mu}}_{j^{\prime\prime}}</annotation></semantics></math>, <math id="A5.SS2.p1.m36" class="ltx_Math" alttext="j^{\prime\prime}\neq j" display="inline" intent=":literal"><semantics><mrow><msup><mi>j</mi><mo>′′</mo></msup><mo>≠</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">j^{\prime\prime}\neq j</annotation></semantics></math>, that forms a task in the training set, we have</span></p>
<table id="A5.E113" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E113X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E113X.m2" class="ltx_Math" alttext="\displaystyle-({{\bm{\mu}}_{j^{\prime\prime}}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{C}^{(b)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mo stretchy="false">(</mo><mi>𝝁</mi><msub><mrow></mrow><msup><mi>j</mi><mo>′′</mo></msup></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow></msup><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mi>C</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mi>𝝁</mi><msub><mrow></mrow><mi>j</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle-({{\bm{\mu}}_{j^{\prime\prime}}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{C}^{(b)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(113)</span></td></tr>
<tr id="A5.E113Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E113Xa.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E113Xa.m3" class="ltx_Math" alttext="\displaystyle({{\bm{\mu}}_{j}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{C}^{(b)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝝁</mi><mi>j</mi><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mi>C</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>j</mi><mo>⊤</mo></msubsup><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle({{\bm{\mu}}_{j}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{C}^{(b)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p1.19" class="ltx_p"><span id="A5.SS2.p1.19.1" class="ltx_text">For <math id="A5.SS2.p1.m37" class="ltx_Math" alttext="{\bm{\nu}}_{k}" display="inline" intent=":literal"><semantics><msub><mi>𝝂</mi><mi>k</mi></msub><annotation encoding="application/x-tex">{\bm{\nu}}_{k}</annotation></semantics></math>, <math id="A5.SS2.p1.m38" class="ltx_Math" alttext="{\bm{\nu}}_{k^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>𝝂</mi><msup><mi>k</mi><mo>′</mo></msup></msub><annotation encoding="application/x-tex">{\bm{\nu}}_{k^{\prime}}</annotation></semantics></math> with <math id="A5.SS2.p1.m39" class="ltx_Math" alttext="k\neq k^{\prime}\in[M_{2}]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≠</mo><msup><mi>k</mi><mo>′</mo></msup><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mn>2</mn></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k\neq k^{\prime}\in[M_{2}]</annotation></semantics></math>, we have</span></p>
<table id="A5.E114" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E114X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E114X.m2" class="ltx_Math" alttext="\displaystyle\Big|-({{\bm{\nu}}_{k}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{C}^{(b)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta(t_{0}+1)\beta}{M_{1}M_{2}}\sqrt{\frac{\log B}{B}}," display="inline" intent=":literal"><semantics><mrow><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0em">−</mo><mo stretchy="false">(</mo><mi>𝝂</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow></msup><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mi>C</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mi>𝝁</mi><msub><mrow></mrow><mi>j</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0.167em">≤</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mrow><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>2</mn></msub></mrow></mfrac></mstyle><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big|-({{\bm{\nu}}_{k}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{C}^{(b)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta(t_{0}+1)\beta}{M_{1}M_{2}}\sqrt{\frac{\log B}{B}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(114)</span></td></tr></tbody>
</table>
