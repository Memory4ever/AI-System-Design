<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E100Xe.m3" class="ltx_Math" alttext="\displaystyle\eta\frac{1}{4M_{1}}(1-p_{a})\beta(1-\xi l)," display="inline" intent=":literal"><semantics><mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>ξ</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\eta\frac{1}{4M_{1}}(1-p_{a})\beta(1-\xi l),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p1.9" class="ltx_p"><span id="A5.SS2.p1.9.1" class="ltx_text">where the last step holds if</span></p>
<table id="A5.E101" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E101.m1" class="ltx_Math" alttext="B\gtrsim(1-p_{a})^{-2}\log\epsilon^{-1}." display="block" intent=":literal"><semantics><mrow><mrow><mi>B</mi><mo>≳</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">B\gtrsim(1-p_{a})^{-2}\log\epsilon^{-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(101)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p1.10" class="ltx_p"><span id="A5.SS2.p1.10.1" class="ltx_text">For <math id="A5.SS2.p1.m19" class="ltx_Math" alttext="{\bm{\mu}}_{j^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>𝝁</mi><msup><mi>j</mi><mo>′</mo></msup></msub><annotation encoding="application/x-tex">{\bm{\mu}}_{j^{\prime}}</annotation></semantics></math>, <math id="A5.SS2.p1.m20" class="ltx_Math" alttext="j^{\prime}\neq j" display="inline" intent=":literal"><semantics><mrow><msup><mi>j</mi><mo>′</mo></msup><mo>≠</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">j^{\prime}\neq j</annotation></semantics></math>, that does not form a task in the training set, we have</span></p>
<table id="A5.E102" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E102.m1" class="ltx_math_unparsed" alttext="-({{\bm{\mu}}_{j^{\prime}}}^{\top},0^{\top})\eta\cdot\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(0)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{C}^{(0)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}=0" display="block" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝝁</mi><msup><mi>j</mi><mo>′</mo></msup><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></munder><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mi>C</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>j</mi><mo>⊤</mo></msubsup><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">-({{\bm{\mu}}_{j^{\prime}}}^{\top},0^{\top})\eta\cdot\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(0)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{C}^{(0)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(102)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p1.11" class="ltx_p"><span id="A5.SS2.p1.11.1" class="ltx_text">For <math id="A5.SS2.p1.m21" class="ltx_Math" alttext="{\bm{\mu}}_{j^{\prime\prime}}" display="inline" intent=":literal"><semantics><msub><mi>𝝁</mi><msup><mi>j</mi><mo>′′</mo></msup></msub><annotation encoding="application/x-tex">{\bm{\mu}}_{j^{\prime\prime}}</annotation></semantics></math>, <math id="A5.SS2.p1.m22" class="ltx_Math" alttext="j^{\prime\prime}\neq j" display="inline" intent=":literal"><semantics><mrow><msup><mi>j</mi><mo>′′</mo></msup><mo>≠</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">j^{\prime\prime}\neq j</annotation></semantics></math>, that forms a task in the training set, we have</span></p>
<table id="A5.E103" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E103X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E103X.m2" class="ltx_Math" alttext="\displaystyle-({{\bm{\mu}}_{j^{\prime\prime}}}^{\top},0^{\top})\eta\cdot\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(0)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{C}^{(0)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mo stretchy="false">(</mo><mi>𝝁</mi><msub><mrow></mrow><msup><mi>j</mi><mo>′′</mo></msup></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mi>C</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mi>𝝁</mi><msub><mrow></mrow><mi>j</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle-({{\bm{\mu}}_{j^{\prime\prime}}}^{\top},0^{\top})\eta\cdot\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(0)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{C}^{(0)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(103)</span></td></tr>
<tr id="A5.E103Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E103Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E103Xa.m3" class="ltx_Math" alttext="\displaystyle({\bm{\mu}}_{j^{\prime\prime}}^{\top},0^{\top})\frac{\eta}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}z^{n}\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(0)})y_{i}^{n}{\bm{W}}_{B}^{(0)}{\bm{p}}_{i}^{n}{{\bm{p}}_{query}^{n}}^{\top}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><msup><mi>j</mi><mo>′′</mo></msup><mo>⊤</mo></msubsup><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>η</mi><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></munder></mstyle><mrow><msup><mi>z</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>l</mi></munderover></mstyle><mrow><msubsup><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>y</mi><mi>i</mi><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>B</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>i</mi><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝒑</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>n</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>j</mi><mo>⊤</mo></msubsup><mo mathsize="0.700em">,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle({\bm{\mu}}_{j^{\prime\prime}}^{\top},0^{\top})\frac{\eta}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}z^{n}\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(0)})y_{i}^{n}{\bm{W}}_{B}^{(0)}{\bm{p}}_{i}^{n}{{\bm{p}}_{query}^{n}}^{\top}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E103Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E103Xb.m2" class="ltx_Math" alttext="\displaystyle\lesssim" display="inline" intent=":literal"><semantics><mo>≲</mo><annotation encoding="application/x-tex">\displaystyle\lesssim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E103Xb.m3" class="ltx_Math" alttext="\displaystyle-\eta\cdot\frac{1}{4M_{1}}(1-p_{a})\beta(1-\xi l)." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>p</mi><msub><mrow></mrow><mi>a</mi></msub><mo stretchy="false">)</mo><mi>β</mi><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>ξ</mi><mi>l</mi><mo stretchy="false">)</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\eta\cdot\frac{1}{4M_{1}}(1-p_{a})\beta(1-\xi l).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p1.12" class="ltx_p"><span id="A5.SS2.p1.12.1" class="ltx_text">For <math id="A5.SS2.p1.m23" class="ltx_Math" alttext="{\bm{\nu}}_{k}" display="inline" intent=":literal"><semantics><msub><mi>𝝂</mi><mi>k</mi></msub><annotation encoding="application/x-tex">{\bm{\nu}}_{k}</annotation></semantics></math>, <math id="A5.SS2.p1.m24" class="ltx_Math" alttext="{\bm{\nu}}_{k^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>𝝂</mi><msup><mi>k</mi><mo>′</mo></msup></msub><annotation encoding="application/x-tex">{\bm{\nu}}_{k^{\prime}}</annotation></semantics></math> with <math id="A5.SS2.p1.m25" class="ltx_Math" alttext="k,k^{\prime}\in[M_{2}]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>,</mo><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mn>2</mn></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">k,k^{\prime}\in[M_{2}]</annotation></semantics></math>, we have</span></p>
<table id="A5.E104" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E104X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E104X.m2" class="ltx_Math" alttext="\displaystyle\Big|-({{\bm{\nu}}_{k}}^{\top},0^{\top})\eta\cdot\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(0)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{C}^{(0)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta\beta}{M_{1}M_{2}}\sqrt{\frac{\log B}{B}}," display="inline" intent=":literal"><semantics><mrow><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0em">−</mo><mo stretchy="false">(</mo><mi>𝝂</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mi>C</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mi>𝝁</mi><msub><mrow></mrow><mi>j</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0.167em">≤</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mrow><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>2</mn></msub></mrow></mfrac></mstyle><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big|-({{\bm{\nu}}_{k}}^{\top},0^{\top})\eta\cdot\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(0)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{C}^{(0)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta\beta}{M_{1}M_{2}}\sqrt{\frac{\log B}{B}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(104)</span></td></tr></tbody>
</table>
<table id="A5.E105" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E105X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E105X.m2" class="ltx_Math" alttext="\displaystyle\Big|-({{\bm{\mu}}_{j}}^{\top},0^{\top})\eta\cdot\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(0)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{C}^{(0)}}({\bm{\nu}}_{k}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta\beta}{M_{2}M_{1}}\sqrt{\frac{\log B}{B}}." display="inline" intent=":literal"><semantics><mrow><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0em">−</mo><mo stretchy="false">(</mo><mi>𝝁</mi><msub><mrow></mrow><mi>j</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mi>C</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mi>𝝂</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0.167em">≤</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mrow><msub><mi>M</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub></mrow></mfrac></mstyle><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big|-({{\bm{\mu}}_{j}}^{\top},0^{\top})\eta\cdot\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(0)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{C}^{(0)}}({\bm{\nu}}_{k}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta\beta}{M_{2}M_{1}}\sqrt{\frac{\log B}{B}}.</annotation></semantics></math></td>
