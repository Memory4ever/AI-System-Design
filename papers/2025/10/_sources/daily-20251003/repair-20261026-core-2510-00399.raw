<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E138Xa.m3" class="ltx_Math" alttext="\displaystyle\xi+\eta\sqrt{\frac{\log B}{B}}-\eta\beta^{2}\frac{1}{|\mathcal{B}_{1}|}\sum_{n\in\mathcal{B}_{b}}\sum_{1\leq i\leq l,{\bm{p}}_{i}^{n}\text{ does not contain any }{\bm{v}}^{*}_{s}}^{l}G^{n}_{i,l+1}({\bm{w}}^{(0)})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ξ</mi><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt></mrow></mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>l</mi></mrow><mo>,</mo><mrow><msubsup><mi>𝒑</mi><mi>i</mi><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mtext> does not contain any </mtext><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup></mrow></mrow><mi>l</mi></munderover></mstyle><mrow><msubsup><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\xi+\eta\sqrt{\frac{\log B}{B}}-\eta\beta^{2}\frac{1}{|\mathcal{B}_{1}|}\sum_{n\in\mathcal{B}_{b}}\sum_{1\leq i\leq l,{\bm{p}}_{i}^{n}\text{ does not contain any }{\bm{v}}^{*}_{s}}^{l}G^{n}_{i,l+1}({\bm{w}}^{(0)})</annotation></semantics></math></td>
