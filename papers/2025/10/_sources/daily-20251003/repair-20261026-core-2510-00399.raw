<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E138Xf.m3" class="ltx_Math" alttext="\displaystyle\xi+\eta\sqrt{\frac{\log B}{B}}-\frac{\eta\beta^{2}\kappa_{a}(1-p_{a})}{V}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ξ</mi><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt></mrow></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>V</mi></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\xi+\eta\sqrt{\frac{\log B}{B}}-\frac{\eta\beta^{2}\kappa_{a}(1-p_{a})}{V}</annotation></semantics></math></td>
