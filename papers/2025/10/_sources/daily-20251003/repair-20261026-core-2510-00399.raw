<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E138Xe.m3" class="ltx_Math" alttext="\displaystyle\xi+\eta\sqrt{\frac{\log B}{B}}-\eta\beta^{2}\cdot\sum_{i=1}^{l}\frac{\kappa_{a}i}{2^{2+i}V}\cdot\frac{1-p_{a}}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ξ</mi><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt></mrow></mrow><mo>−</mo><mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>l</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mrow><msup><mn>2</mn><mrow><mn>2</mn><mo>+</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mfrac></mstyle></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mn>2</mn></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\xi+\eta\sqrt{\frac{\log B}{B}}-\eta\beta^{2}\cdot\sum_{i=1}^{l}\frac{\kappa_{a}i}{2^{2+i}V}\cdot\frac{1-p_{a}}{2}</annotation></semantics></math></td>
