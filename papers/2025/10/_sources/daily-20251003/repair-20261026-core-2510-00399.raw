<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E185Xa.m3" class="ltx_Math" alttext="\displaystyle\begin{pmatrix}\hat{{\bm{x}}}_{1}^{i}&amp;\hat{{\bm{x}}}_{2}^{i}&amp;\cdots&amp;\hat{{\bm{x}}}_{l}^{i}&amp;\hat{{\bm{x}}}_{l+1}^{i}\\
\hat{y}_{1}^{i}&amp;\hat{y}_{2}^{i}&amp;\cdots&amp;\hat{y}_{l}^{i}&amp;\hat{y}_{l+1}^{i}\\
\end{pmatrix}" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><msubsup><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mn>1</mn><mi>i</mi></msubsup></mtd><mtd><msubsup><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mn>2</mn><mi>i</mi></msubsup></mtd><mtd><mo>⋯</mo></mtd><mtd><msubsup><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mi>l</mi><mi>i</mi></msubsup></mtd><mtd><msubsup><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mi>i</mi></msubsup></mtd></mtr><mtr><mtd><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mn>1</mn><mi>i</mi></msubsup></mtd><mtd><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mn>2</mn><mi>i</mi></msubsup></mtd><mtd><mo>⋯</mo></mtd><mtd><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>l</mi><mi>i</mi></msubsup></mtd><mtd><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mi>i</mi></msubsup></mtd></mtr></mtable><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\begin{pmatrix}\hat{{\bm{x}}}_{1}^{i}&amp;\hat{{\bm{x}}}_{2}^{i}&amp;\cdots&amp;\hat{{\bm{x}}}_{l}^{i}&amp;\hat{{\bm{x}}}_{l+1}^{i}\\
\hat{y}_{1}^{i}&amp;\hat{y}_{2}^{i}&amp;\cdots&amp;\hat{y}_{l}^{i}&amp;\hat{y}_{l+1}^{i}\\
\end{pmatrix}</annotation></semantics></math></td>
