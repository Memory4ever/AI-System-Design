/mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><msubsup><mi>M</mi><mn>1</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\eta\sqrt{\frac{\log B}{B}}+\eta\frac{z^{n}}{|\mathcal{B}_{1}|}\sum_{n\in\mathcal{B}_{b}}\sum_{{\bm{p}}_{i}^{n}\text{ does not contain }{\bm{v}}^{*}_{s},z^{n}y_{i}^{n}=1}y_{i}^{n}(\beta^{2}+\frac{\eta^{2}t_{0}^{2}(1-p_{a})^{2}\beta^{2}}{M_{1}^{2}})</annotation></semantics></math></td>
