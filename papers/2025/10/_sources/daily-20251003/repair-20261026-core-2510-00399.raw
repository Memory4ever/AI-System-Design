<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E177Xc.m2" class="ltx_Math" alttext="\displaystyle\gtrsim" display="inline" intent=":literal"><semantics><mo>≳</mo><annotation encoding="application/x-tex">\displaystyle\gtrsim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E177Xc.m3" class="ltx_Math" alttext="\displaystyle-\log(2+\frac{(t_{2}+1)\gamma_{2}}{M_{1}})," display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><msub><mi>M</mi><mn>1</mn></msub></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\log(2+\frac{(t_{2}+1)\gamma_{2}}{M_{1}}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS4.p2.5" class="ltx_p">where the last step comes from the following.
<br class="ltx_break">(i)</p>
<table id="A5.E178" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E178X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E178X.m2" class="ltx_Math" alttext="\displaystyle\eta\frac{(1-p_{a})}{M_{1}}\beta^{2}(3+\frac{t_{2}\gamma_{2}}{M_{1}})^{-1}\lesssim" display="inline" intent=":literal"><semantics><mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><msub><mi>M</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>t</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><msub><mi>M</mi><mn>1</mn></msub></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>≲</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\eta\frac{(1-p_{a})}{M_{1}}\beta^{2}(3+\frac{t_{2}\gamma_{2}}{M_{1}})^{-1}\lesssim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E178X.m3" class="ltx_Math" alttext="\displaystyle\log(1+\frac{\frac{\gamma_{2}}{M_{1}}}{2+\frac{t_{2}\gamma_{2}}{M_{1}}})" display="inline" intent=":literal"><semantics><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mfrac><msub><mi>γ</mi><mn>2</mn></msub><msub><mi>M</mi><mn>1</mn></msub></mfrac><mrow><mn>2</mn><mo>+</mo><mfrac><mrow><msub><mi>t</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><msub><mi>M</mi><mn>1</mn></msub></mfrac></mrow></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\log(1+\frac{\frac{\gamma_{2}}{M_{1}}}{2+\frac{t_{2}\gamma_{2}}{M_{1}}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(178)</span></td></tr>
<tr id="A5.E178Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E178Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E178Xa.m3" class="ltx_Math" alttext="\displaystyle\log(2+\frac{(t_{2}+1)\gamma_{2}}{M_{1}})-\log(2+\frac{t_{2}\gamma_{2}}{M_{1}})," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><msub><mi>M</mi><mn>1</mn></msub></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>t</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><msub><mi>M</mi><mn>1</mn></msub></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\log(2+\frac{(t_{2}+1)\gamma_{2}}{M_{1}})-\log(2+\frac{t_{2}\gamma_{2}}{M_{1}}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS4.p2.6" class="ltx_p">where the first step is from</p>
<table id="A5.E179" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E179.m1" class="ltx_Math" alttext="\gamma_{2}\geq\eta(1-p_{a})\beta^{2}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>γ</mi><mn>2</mn></msub><mo>≥</mo><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\gamma_{2}\geq\eta(1-p_{a})\beta^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(179)</span></td></tr></tbody>
</table>
<p id="A5.SS4.p2.7" class="ltx_p">(ii)</p>
<table id="A5.E180" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E180X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E180X.m2" class="ltx_Math" alttext="\displaystyle\eta^{3}\frac{(1-p_{a})^{3}}{M_{1}^{3}}\beta^{2}t_{2}^{2}(3+\frac{t_{2}\gamma_{2}}{M_{1}})^{-1}\lesssim\log(2+\frac{(t_{2}+1)\gamma_{2}}{M_{1}})-\log(2+\frac{t_{2}\gamma_{2}}{M_{1}})," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup><msubsup><mi>M</mi><mn>1</mn><mn>3</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>t</mi><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>t</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><msub><mi>M</mi><mn>1</mn></msub></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>≲</mo><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><msub><mi>M</mi><mn>1</mn></msub></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>t</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><msub><mi>M</mi><mn>1</mn></msub></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\eta^{3}\frac{(1-p_{a})^{3}}{M_{1}^{3}}\beta^{2}t_{2}^{2}(3+\frac{t_{2}\gamma_{2}}{M_{1}})^{-1}\lesssim\log(2+\frac{(t_{2}+1)\gamma_{2}}{M_{1}})-\log(2+\frac{t_{2}\gamma_{2}}{M_{1}}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(180)</span></td></tr></tbody>
</table>
<p id="A5.SS4.p2.8" class="ltx_p">which comes from</p>
<table id="A5.E181" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E181.m1" class="ltx_Math" alttext="\gamma_{2}\geq\eta(1-p_{a})\beta^{-2}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>γ</mi><mn>2</mn></msub><mo>≥</mo><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\gamma_{2}\geq\eta(1-p_{a})\beta^{-2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(181)</span></td></tr></tbody>
</table>
<p id="A5.SS4.p2.9" class="ltx_p">Therefore, (<a href="#A5.E174" title="In Proof. ‣ E.4 Proof of Lemma ‣ Appendix E Proof of Supportive Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">174</span></a>) can be rewritten as</p>
<table id="A5.E182" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E182.m1" class="ltx_Math" alttext="({\bm{\mu}}_{j}^{\top},0^{\top}){\bm{w}}^{(t)}\geq\Theta(-\log(2+t\cdot\frac{\eta(1-p_{a})\beta^{2}}{M_{1}}))," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>j</mi><mo>⊤</mo></msubsup><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>≥</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>+</mo><mrow><mi>t</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><msub><mi>M</mi><mn>1</mn></msub></mfrac></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">({\bm{\mu}}_{j}^{\top},0^{\top}){\bm{w}}^{(t)}\geq\Theta(-\log(2+t\cdot\frac{\eta(1-p_{a})\beta^{2}}{M_{1}})),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(182)</span></td></tr></tbody>
</table>
<p id="A5.SS4.p2.10" class="ltx_p">so that the conclusion holds when <math id="A5.SS4.p2.m11" class="ltx_Math" alttext="t=t_{2}+1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">t=t_{2}+1</annotation></semantics></math>. Thus, the induction can be completed.
We can then derive that when <math id="A5.SS4.p2.m12" class="ltx_Math" alttext="t=t_{0}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><msub><mi>t</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">t=t_{0}</annotation></semantics></math>, we have</p>
<table id="A5.E183" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E183.m1" class="ltx_Math" alttext="({\bm{\mu}}_{j}^{\top},0^{\top}){\bm{w}}^{(t_{0})}\geq\Theta(-\log(2+t_{0}\cdot\frac{\eta(1-p_{a})\beta^{2}}{M_{1}}))\geq-\log(3)\geq-\Theta(1)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>j</mi><mo>⊤</mo></msubsup><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msup></mrow><mo>≥</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>+</mo><mrow><msub><mi>t</mi><mn>0</mn></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><msub><mi>M</mi><mn>1</mn></msub></mfrac></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≥</mo><mrow><mo>−</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">({\bm{\mu}}_{j}^{\top},0^{\top}){\bm{w}}^{(t_{0})}\geq\Theta(-\log(2+t_{0}\cdot\frac{\eta(1-p_{a})\beta^{2}}{M_{1}}))\geq-\log(3)\geq-\Theta(1),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(183)</span></td></tr></tbody>
</table>
<p id="A5.SS4.p2.11" class="ltx_p">and for <math id="A5.SS4.p2.m13" class="ltx_Math" alttext="{\bm{p}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒑</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\bm{p}}_{i}</annotation></semantics></math> that does not contain <math id="A5.SS4.p2.m14" class="ltx_Math" alttext="{\bm{\nu}}_{*}" display="inline" intent=":literal"><semantics><msub><mi>𝝂</mi><mo>∗</mo></msub><annotation encoding="application/x-tex">{\bm{\nu}}_{*}</annotation></semantics></math>,</p>
<table id="A5.E184" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E184.m1" class="ltx_Math" alttext="\sigma({\bm{p}}_{i}^{\top}{\bm{w}}^{(t)})\gtrsim\Theta(1)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝒑</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≳</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sigma({\bm{p}}_{i}^{\top}{\bm{w}}^{(t)})\gtrsim\Theta(1).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(184)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS4.p3" class="ltx_para">
<p id="A5.SS4.p3.1" class="ltx_p"><span id="A5.SS4.p3.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A5.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.5 </span>Proof of Lemma <a href="#Thmlemma6" title="Lemma 6. ‣ Appendix C Key Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a></h3>

<div id="A5.SS5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS5.p1" class="ltx_para">
<p id="A5.SS5.p1.1" class="ltx_p"><span id="A5.SS5.p1.1.1" class="ltx_text">Given a prompt <math id="A5.SS5.p1.m1" class="ltx_Math" alttext="{\bm{P}}" display="inline" intent=":literal"><semantics><mi>𝑷</mi><annotation encoding="application/x-tex">{\bm{P}}</annotation></semantics></math> defined in (<a href="#S2.E2" title="In 2 Problem Formulation ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>) with <math id="A5.SS5.p1.m2" class="ltx_Math" alttext="({\bm{x}}_{1},{\bm{x}}_{2},\cdots,{\bm{x}}_{l},{\bm{x}}_{query})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝒙</mi><mn>2</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>𝒙</mi><mi>l</mi></msub><mo>,</mo><msub><mi>𝒙</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\bm{x}}_{1},{\bm{x}}_{2},\cdots,{\bm{x}}_{l},{\bm{x}}_{query})</annotation></semantics></math>, let <math id="A5.SS5.p1.m3" class="ltx_Math" alttext="{\bm{x}}_{l+1}={\bm{x}}_{query}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒙</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><msub><mi>𝒙</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub></mrow><annotation encoding="application/x-tex">{\bm{x}}_{l+1}={\bm{x}}_{query}</annotation></semantics></math>. Define</span></p>
<table id="A5.E185" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E185X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E185X.m2" class="ltx_Math" alttext="\displaystyle\hat{{\bm{P}}}^{i}=" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>𝑷</mi><mo>^</mo></mover><mi>i</mi></msup><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\hat{{\bm{P}}}^{i}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E185X.m3" class="ltx_Math" alttext="\displaystyle\begin{pmatrix}{\bm{x}}_{i+1}&{\bm{x}}_{i+2}&amp;\cdots&{\bm{x}}_{l}&{\bm{x}}_{l+1}&{\bm{x}}_{1}&{\bm{x}}_{2}&amp;\cdots&{\bm{x}}_{i}\\
y_{i+1}&amp;y_{i+2}&amp;\cdots&amp;y_{l}&amp;y_{l+1}&amp;y_{1}&amp;y_{2}&amp;\cdots&amp;y_{i}\end{pmatrix}" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><msub><mi>𝒙</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mtd><mtd><msub><mi>𝒙</mi><mrow><mi>i</mi><mo>+</mo><mn>2</mn></mrow></msub></mtd><mtd><mo>⋯</mo></mtd><mtd><msub><mi>𝒙</mi><mi>l</mi></msub></mtd><mtd><msub><mi>𝒙</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msub></mtd><mtd><msub><mi>𝒙</mi><mn>1</mn></msub></mtd><mtd><msub><mi>𝒙</mi><mn>2</mn></msub></mtd><mtd><mo>⋯</mo></mtd><mtd><msub><mi>𝒙</mi><mi>i</mi></msub></mtd></mtr><mtr><mtd><msub><mi>y</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mtd><mtd><msub><mi>y</mi><mrow><mi>i</mi><mo>+</mo><mn>2</mn></mrow></msub></mtd><mtd><mo>⋯</mo></mtd><mtd><msub><mi>y</mi><mi>l</mi></msub></mtd><mtd><msub><mi>y</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msub></mtd><mtd><msub><mi>y</mi><mn>1</mn></msub></mtd><mtd><msub><mi>y</mi><mn>2</mn></msub></mtd><mtd><mo>⋯</mo></mtd><mtd><msub><mi>y</mi><mi>i</mi></msub></mtd></mtr></mtable><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\begin{pmatrix}{\bm{x}}_{i+1}&amp;{\bm{x}}_{i+2}&amp;\cdots&amp;{\bm{x}}_{l}&amp;{\bm{x}}_{l+1}&amp;{\bm{x}}_{1}&amp;{\bm{x}}_{2}&amp;\cdots&amp;{\bm{x}}_{i}\\
y_{i+1}&amp;y_{i+2}&amp;\cdots&amp;y_{l}&amp;y_{l+1}&amp;y_{1}&amp;y_{2}&amp;\cdots&amp;y_{i}\end{pmatrix}</annotation></semantics></math></td>
