<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E185Xb.m3" class="ltx_Math" alttext="\displaystyle(\hat{{\bm{p}}}_{1}^{i},\hat{{\bm{p}}}_{2}^{i},\cdots,\hat{{\bm{p}}}_{l}^{i},\hat{{\bm{p}}}_{l+1}^{i})," display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>𝒑</mi><mo>^</mo></mover><mn>1</mn><mi>i</mi></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>𝒑</mi><mo>^</mo></mover><mn>2</mn><mi>i</mi></msubsup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msubsup><mover accent="true"><mi>𝒑</mi><mo>^</mo></mover><mi>l</mi><mi>i</mi></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>𝒑</mi><mo>^</mo></mover><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle(\hat{{\bm{p}}}_{1}^{i},\hat{{\bm{p}}}_{2}^{i},\cdots,\hat{{\bm{p}}}_{l}^{i},\hat{{\bm{p}}}_{l+1}^{i}),</annotation></semantics></math></td>
