<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E177Xa.m3" class="ltx_Math" alttext="\displaystyle-\log(2+\frac{t_{2}\gamma_{2}}{M_{1}})-\eta\frac{(1-p_{a})}{M_{1}}(\beta^{2}+\frac{\eta^{2}t_{2}^{2}(1-p_{a})^{2}\beta^{2}}{M_{1}^{2}})\cdot\frac{1}{1+e^{\log(2+\frac{t_{2}\gamma_{2}}{M_{1}})}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>t</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><msub><mi>M</mi><mn>1</mn></msub></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><msub><mi>M</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>β</mi><mn>2</mn></msup><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>t</mi><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><msubsup><mi>M</mi><mn>1</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><msup><mi>e</mi><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>+</mo><mfrac><mrow><msub><mi>t</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><msub><mi>M</mi><mn>1</mn></msub></mfrac></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\log(2+\frac{t_{2}\gamma_{2}}{M_{1}})-\eta\frac{(1-p_{a})}{M_{1}}(\beta^{2}+\frac{\eta^{2}t_{2}^{2}(1-p_{a})^{2}\beta^{2}}{M_{1}^{2}})\cdot\frac{1}{1+e^{\log(2+\frac{t_{2}\gamma_{2}}{M_{1}})}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E177Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E177Xb.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E177Xb.m3" class="ltx_Math" alttext="\displaystyle-\log(2+\frac{t_{2}\gamma_{2}}{M_{1}})-\eta\frac{(1-p_{a})}{M_{1}}(\beta^{2}+\frac{\eta^{2}t_{2}^{2}(1-p_{a})^{2}\beta^{2}}{M_{1}^{2}})\cdot(3+\frac{t_{2}\gamma_{2}}{M_{1}})^{-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>t</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><msub><mi>M</mi><mn>1</mn></msub></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><msub><mi>M</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>β</mi><mn>2</mn></msup><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>t</mi><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><msubsup><mi>M</mi><mn>1</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>t</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><msub><mi>M</mi><mn>1</mn></msub></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\log(2+\frac{t_{2}\gamma_{2}}{M_{1}})-\eta\frac{(1-p_{a})}{M_{1}}(\beta^{2}+\frac{\eta^{2}t_{2}^{2}(1-p_{a})^{2}\beta^{2}}{M_{1}^{2}})\cdot(3+\frac{t_{2}\gamma_{2}}{M_{1}})^{-1}</annotation></semantics></math></td>
