<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E151Xf.m3" class="ltx_Math" alttext="\displaystyle-\eta\sqrt{\frac{\log B}{B}}+\eta\frac{1}{|\mathcal{B}_{1}|}\sum_{n\in\mathcal{B}_{b}}\sum_{{\bm{p}}_{i}^{n}\text{ does not contain }{\bm{v}}^{*}_{s}}(\beta^{2}+\frac{\eta^{2}t_{0}^{2}(1-p_{a})^{2}\beta^{2}}{M_{1}^{2}})G^{n}_{i,l+1}({\bm{w}}^{(t_{0})})" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt></mrow></mrow><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msubsup><mi>𝒑</mi><mi>i</mi><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mtext> does not contain </mtext><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup></mrow></munder></mstyle><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>β</mi><mn>2</mn></msup><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>t</mi><mn>0</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><msubsup><mi>M</mi><mn>1</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\eta\sqrt{\frac{\log B}{B}}+\eta\frac{1}{|\mathcal{B}_{1}|}\sum_{n\in\mathcal{B}_{b}}\sum_{{\bm{p}}_{i}^{n}\text{ does not contain }{\bm{v}}^{*}_{s}}(\beta^{2}+\frac{\eta^{2}t_{0}^{2}(1-p_{a})^{2}\beta^{2}}{M_{1}^{2}})G^{n}_{i,l+1}({\bm{w}}^{(t_{0})})</annotation></semantics></math></td>
