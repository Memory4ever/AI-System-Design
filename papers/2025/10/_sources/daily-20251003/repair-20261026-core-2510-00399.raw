<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E88Xd.m3" class="ltx_Math" alttext="\displaystyle\cdots" display="inline" intent=":literal"><semantics><mo>⋯</mo><annotation encoding="application/x-tex">\displaystyle\cdots</annotation></semantics></math></td>
