<table id="A5.E116" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E116X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E116X.m2" class="ltx_Math" alttext="\displaystyle\Big|-({{\bm{\nu}}_{k}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{C}^{(b)}}({\bm{\nu}}_{k}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta(t_{0}+1)\beta}{M_{2}}\sqrt{\frac{\log B}{B}}," display="inline" intent=":literal"><semantics><mrow><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0em">−</mo><mo stretchy="false">(</mo><mi>𝝂</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow></msup><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mi>C</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mi>𝝂</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0.167em">≤</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><msub><mi>M</mi><mn>2</mn></msub></mfrac></mstyle><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big|-({{\bm{\nu}}_{k}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{C}^{(b)}}({\bm{\nu}}_{k}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta(t_{0}+1)\beta}{M_{2}}\sqrt{\frac{\log B}{B}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(116)</span></td></tr></tbody>
</table>
<table id="A5.E117" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E117X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E117X.m2" class="ltx_Math" alttext="\displaystyle\Big|-({{\bm{\nu}}_{k^{\prime}}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{C}^{(b)}}({\bm{\nu}}_{k}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta(t_{0}+1)\beta}{M_{2}^{2}}\sqrt{\frac{\log B}{B}}," display="inline" intent=":literal"><semantics><mrow><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0em">−</mo><mo stretchy="false">(</mo><mi>𝝂</mi><msub><mrow></mrow><msup><mi>k</mi><mo>′</mo></msup></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow></msup><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mi>C</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mi>𝝂</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0.167em">≤</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><msubsup><mi>M</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big|-({{\bm{\nu}}_{k^{\prime}}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{C}^{(b)}}({\bm{\nu}}_{k}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta(t_{0}+1)\beta}{M_{2}^{2}}\sqrt{\frac{\log B}{B}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(117)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p1.20" class="ltx_p"><span id="A5.SS2.p1.20.1" class="ltx_text">Then, we complete the induction.</span></p>
</div>
<div id="A5.SS2.p2" class="ltx_para ltx_noindent">
<p id="A5.SS2.p2.2" class="ltx_p">(b) We then characterize the gradient updates of <math id="A5.SS2.p2.m1" class="ltx_Math" alttext="{\bm{W}}_{B}" display="inline" intent=":literal"><semantics><msub><mi>𝑾</mi><mi>B</mi></msub><annotation encoding="application/x-tex">{\bm{W}}_{B}</annotation></semantics></math>. We have that when <math id="A5.SS2.p2.m2" class="ltx_Math" alttext="F(\Psi;{\bm{P}}^{n})\in(-1,1)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F(\Psi;{\bm{P}}^{n})\in(-1,1)</annotation></semantics></math> for some <math id="A5.SS2.p2.m3" class="ltx_Math" alttext="n\in[N]" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">n\in[N]</annotation></semantics></math>,</p>
<table id="A5.E118" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E118X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E118X.m2" class="ltx_Math" alttext="\displaystyle\frac{\partial\ell(\Psi;{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}}=" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msub><mi>𝑾</mi><mi>B</mi></msub></mrow></mfrac></mstyle><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\partial\ell(\Psi;{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E118X.m3" class="ltx_Math" alttext="\displaystyle-z^{n}\sum_{i=1}^{l+1}G^{n}_{i,l+1}({\bm{w}})y_{i}{\bm{W}}_{C}{\bm{p}}_{query}{\bm{p}}_{i}^{\top}." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>z</mi><msup><mrow></mrow><mi>n</mi></msup><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup><mi>G</mi><msup><mrow></mrow><mi>n</mi></msup><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">(</mo><mi>𝒘</mi><mo stretchy="false">)</mo><mi>y</mi><msub><mrow></mrow><mi>i</mi></msub><mi>𝑾</mi><msub><mrow></mrow><mi>C</mi></msub><mi>𝒑</mi><msub><mrow></mrow><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub><mi>𝒑</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-z^{n}\sum_{i=1}^{l+1}G^{n}_{i,l+1}({\bm{w}})y_{i}{\bm{W}}_{C}{\bm{p}}_{query}{\bm{p}}_{i}^{\top}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(118)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p2.3" class="ltx_p">We also use induction to complete the proof. Similar to the analysis of <math id="A5.SS2.p2.m4" class="ltx_Math" alttext="{\bm{W}}_{C}" display="inline" intent=":literal"><semantics><msub><mi>𝑾</mi><mi>C</mi></msub><annotation encoding="application/x-tex">{\bm{W}}_{C}</annotation></semantics></math>, we have that when <math id="A5.SS2.p2.m5" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math>,</p>
<table id="A5.E119" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E119X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E119X.m2" class="ltx_Math" alttext="\displaystyle-({\bm{\mu}}_{j}^{\top},0^{\top})\eta\cdot\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(0)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(0)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mo stretchy="false">(</mo><mi>𝝁</mi><msub><mrow></mrow><mi>j</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mi>B</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mi>𝝁</mi><msub><mrow></mrow><mi>j</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle-({\bm{\mu}}_{j}^{\top},0^{\top})\eta\cdot\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(0)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(0)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(119)</span></td></tr>
<tr id="A5.E119Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E119Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E119Xa.m3" class="ltx_Math" alttext="\displaystyle({\bm{\mu}}_{j}^{\top},0^{\top})\frac{\eta}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}z^{n}\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(0)})y_{i}^{n}{\bm{W}}_{C}^{(0)}{\bm{p}}_{query}^{n}{{\bm{p}}_{i}^{n}}^{\top}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>j</mi><mo>⊤</mo></msubsup><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>η</mi><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></munder></mstyle><mrow><msup><mi>z</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>l</mi></munderover></mstyle><mrow><msubsup><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>y</mi><mi>i</mi><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>C</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝒑</mi><mi>i</mi><mi>n</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>j</mi><mo>⊤</mo></msubsup><mo mathsize="0.700em">,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle({\bm{\mu}}_{j}^{\top},0^{\top})\frac{\eta}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}z^{n}\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(0)})y_{i}^{n}{\bm{W}}_{C}^{(0)}{\bm{p}}_{query}^{n}{{\bm{p}}_{i}^{n}}^{\top}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E119Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E119Xb.m2" class="ltx_Math" alttext="\displaystyle\gtrsim" display="inline" intent=":literal"><semantics><mo>≳</mo><annotation encoding="application/x-tex">\displaystyle\gtrsim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E119Xb.m3" class="ltx_Math" alttext="\displaystyle\eta\cdot\frac{1}{2M_{1}}(1-p_{a})\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(0)})\beta-\eta\cdot\frac{1}{2M_{1}}\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(0)})\beta p_{a}\sqrt{\frac{\log B}{B}}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>p</mi><msub><mrow></mrow><mi>a</mi></msub><mo rspace="0.167em" stretchy="false">)</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>l</mi></msup><mi>G</mi><msup><mrow></mrow><mi>n</mi></msup><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">(</mo><mi>𝒘</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo><mi>β</mi><mo>−</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>l</mi></msup><mi>G</mi><msup><mrow></mrow><mi>n</mi></msup><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">(</mo><mi>𝒘</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo><mi>β</mi><mi>p</mi><msub><mrow></mrow><mi>a</mi></msub><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle\eta\cdot\frac{1}{2M_{1}}(1-p_{a})\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(0)})\beta-\eta\cdot\frac{1}{2M_{1}}\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(0)})\beta p_{a}\sqrt{\frac{\log B}{B}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E119Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E119Xc.m2" class="ltx_Math" alttext="\displaystyle\geq" display="inline" intent=":literal"><semantics><mo>≥</mo><annotation encoding="application/x-tex">\displaystyle\geq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E119Xc.m3" class="ltx_Math" alttext="\displaystyle\eta\frac{1}{4M_{1}}(1-p_{a})\beta(1-\xi l)." display="inline" intent=":literal"><semantics><mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>ξ</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\eta\frac{1}{4M_{1}}(1-p_{a})\beta(1-\xi l).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p2.4" class="ltx_p">For <math id="A5.SS2.p2.m6" class="ltx_Math" alttext="{\bm{\mu}}_{j^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>𝝁</mi><msup><mi>j</mi><mo>′</mo></msup></msub><annotation encoding="application/x-tex">{\bm{\mu}}_{j^{\prime}}</annotation></semantics></math>, <math id="A5.SS2.p2.m7" class="ltx_Math" alttext="j^{\prime}\neq j" display="inline" intent=":literal"><semantics><mrow><msup><mi>j</mi><mo>′</mo></msup><mo>≠</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">j^{\prime}\neq j</annotation></semantics></math>, that does not form a task in the training stage, we have</p>
<table id="A5.E120" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E120.m1" class="ltx_math_unparsed" alttext="-({{\bm{\mu}}_{j^{\prime}}}^{\top},0^{\top})\eta\cdot\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(0)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(0)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}=0." display="block" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝝁</mi><msup><mi>j</mi><mo>′</mo></msup><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></munder><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mi>B</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>j</mi><mo>⊤</mo></msubsup><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo>=</mo><mn>0</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">-({{\bm{\mu}}_{j^{\prime}}}^{\top},0^{\top})\eta\cdot\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(0)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(0)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(120)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p2.5" class="ltx_p">For <math id="A5.SS2.p2.m8" class="ltx_Math" alttext="{\bm{\mu}}_{j^{\prime\prime}}" display="inline" intent=":literal"><semantics><msub><mi>𝝁</mi><msup><mi>j</mi><mo>′′</mo></msup></msub><annotation encoding="application/x-tex">{\bm{\mu}}_{j^{\prime\prime}}</annotation></semantics></math>, <math id="A5.SS2.p2.m9" class="ltx_Math" alttext="j^{\prime\prime}\neq j" display="inline" intent=":literal"><semantics><mrow><msup><mi>j</mi><mo>′′</mo></msup><mo>≠</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">j^{\prime\prime}\neq j</annotation></semantics></math>, that forms a task in the training stage, we have</p>
<table id="A5.E121" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E121X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E121X.m2" class="ltx_Math" alttext="\displaystyle-({{\bm{\mu}}_{j^{\prime\prime}}}^{\top},0^{\top})\eta\cdot\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(0)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(0)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}\leq-\eta\cdot\frac{1}{4M_{1}}(1-p_{a})\beta(1-\xi l)." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mo stretchy="false">(</mo><mi>𝝁</mi><msub><mrow></mrow><msup><mi>j</mi><mo>′′</mo></msup></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mi>B</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mi>𝝁</mi><msub><mrow></mrow><mi>j</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mo rspace="0em">≤</mo><mo lspace="0em">−</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>p</mi><msub><mrow></mrow><mi>a</mi></msub><mo stretchy="false">)</mo><mi>β</mi><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>ξ</mi><mi>l</mi><mo stretchy="false">)</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-({{\bm{\mu}}_{j^{\prime\prime}}}^{\top},0^{\top})\eta\cdot\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(0)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(0)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}\leq-\eta\cdot\frac{1}{4M_{1}}(1-p_{a})\beta(1-\xi l).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(121)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p2.6" class="ltx_p">For <math id="A5.SS2.p2.m10" class="ltx_Math" alttext="{\bm{\nu}}_{k}" display="inline" intent=":literal"><semantics><msub><mi>𝝂</mi><mi>k</mi></msub><annotation encoding="application/x-tex">{\bm{\nu}}_{k}</annotation></semantics></math>, <math id="A5.SS2.p2.m11" class="ltx_Math" alttext="{\bm{\nu}}_{k^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>𝝂</mi><msup><mi>k</mi><mo>′</mo></msup></msub><annotation encoding="application/x-tex">{\bm{\nu}}_{k^{\prime}}</annotation></semantics></math> with <math id="A5.SS2.p2.m12" class="ltx_Math" alttext="k\neq k^{\prime}\in[M_{2}]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≠</mo><msup><mi>k</mi><mo>′</mo></msup><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mn>2</mn></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k\neq k^{\prime}\in[M_{2}]</annotation></semantics></math>, we have</p>
<table id="A5.E122" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E122X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E122X.m2" class="ltx_Math" alttext="\displaystyle\Big|-({{\bm{\nu}}_{k}}^{\top},0^{\top})\eta\cdot\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(0)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(0)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta\beta}{M_{1}M_{2}}\sqrt{\frac{\log B}{B}}," display="inline" intent=":literal"><semantics><mrow><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0em">−</mo><mo stretchy="false">(</mo><mi>𝝂</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mi>B</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mi>𝝁</mi><msub><mrow></mrow><mi>j</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0.167em">≤</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mrow><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>2</mn></msub></mrow></mfrac></mstyle><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big|-({{\bm{\nu}}_{k}}^{\top},0^{\top})\eta\cdot\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(0)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(0)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta\beta}{M_{1}M_{2}}\sqrt{\frac{\log B}{B}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(122)</span></td></tr></tbody>
</table>
<table id="A5.E123" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E123X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E123X.m2" class="ltx_Math" alttext="\displaystyle\Big|-({{\bm{\mu}}_{j}}^{\top},0^{\top})\eta\cdot\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(0)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(0)}}({\bm{\nu}}_{k}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta\beta}{M_{1}M_{2}}\sqrt{\frac{\log B}{B}}." display="inline" intent=":literal"><semantics><mrow><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0em">−</mo><mo stretchy="false">(</mo><mi>𝝁</mi><msub><mrow></mrow><mi>j</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mi>B</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mi>𝝂</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0.167em">≤</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mrow><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>2</mn></msub></mrow></mfrac></mstyle><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big|-({{\bm{\mu}}_{j}}^{\top},0^{\top})\eta\cdot\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(0)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(0)}}({\bm{\nu}}_{k}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta\beta}{M_{1}M_{2}}\sqrt{\frac{\log B}{B}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(123)</span></td></tr></tbody>
</table>
<table id="A5.E124" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E124X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E124X.m2" class="ltx_Math" alttext="\displaystyle\Big|-({{\bm{\nu}}_{k}}^{\top},0^{\top})\eta\cdot\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(0)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(0)}}({\bm{\nu}}_{k}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta\beta}{M_{2}}\sqrt{\frac{\log B}{B}}." display="inline" intent=":literal"><semantics><mrow><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0em">−</mo><mo stretchy="false">(</mo><mi>𝝂</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mi>B</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mi>𝝂</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0.167em">≤</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><msub><mi>M</mi><mn>2</mn></msub></mfrac></mstyle><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big|-({{\bm{\nu}}_{k}}^{\top},0^{\top})\eta\cdot\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(0)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(0)}}({\bm{\nu}}_{k}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta\beta}{M_{2}}\sqrt{\frac{\log B}{B}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(124)</span></td></tr></tbody>
</table>
<table id="A5.E125" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E125X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E125X.m2" class="ltx_Math" alttext="\displaystyle\Big|-({{\bm{\nu}}_{k^{\prime}}}^{\top},0^{\top})\eta\cdot\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(0)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(0)}}({\bm{\nu}}_{k}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta\beta}{M_{2}^{2}}\sqrt{\frac{\log B}{B}}." display="inline" intent=":literal"><semantics><mrow><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0em">−</mo><mo stretchy="false">(</mo><mi>𝝂</mi><msub><mrow></mrow><msup><mi>k</mi><mo>′</mo></msup></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mi>B</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mi>𝝂</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0.167em">≤</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><msubsup><mi>M</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big|-({{\bm{\nu}}_{k^{\prime}}}^{\top},0^{\top})\eta\cdot\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(0)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(0)}}({\bm{\nu}}_{k}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta\beta}{M_{2}^{2}}\sqrt{\frac{\log B}{B}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(125)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p2.7" class="ltx_p">We also have that for any <math id="A5.SS2.p2.m13" class="ltx_Math" alttext="s\in[V]" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>V</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">s\in[V]</annotation></semantics></math>,</p>
<table id="A5.E126" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E126X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E126X.m2" class="ltx_Math" alttext="\displaystyle\Big|({{\bm{\nu}}^{*}_{s}}^{\top},0^{\top})\eta\cdot\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(0)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(0)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}\Big|\leq" display="inline" intent=":literal"><semantics><mrow><mo fence="false" maxsize="1.600em" minsize="1.600em" rspace="0.167em" stretchy="true">|</mo><mo stretchy="false">(</mo><mi>𝝂</mi><msup><mrow></mrow><mo>∗</mo></msup><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mi>B</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mi>𝝁</mi><msub><mrow></mrow><mi>j</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0.167em">≤</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big|({{\bm{\nu}}^{*}_{s}}^{\top},0^{\top})\eta\cdot\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(0)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(0)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}\Big|\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E126X.m4" class="ltx_Math" alttext="\displaystyle\frac{\eta\beta p_{a}\kappa_{*}}{M_{1}V}\cdot\sqrt{\frac{\log B}{B}}," display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mo>∗</mo></msub></mrow><mrow><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\eta\beta p_{a}\kappa_{*}}{M_{1}V}\cdot\sqrt{\frac{\log B}{B}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(126)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p2.8" class="ltx_p">Therefore, the conclusions hold when <math id="A5.SS2.p2.m14" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math>. Suppose that the conclusions also hold when <math id="A5.SS2.p2.m15" class="ltx_Math" alttext="t=t_{0}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><msub><mi>t</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">t=t_{0}</annotation></semantics></math>. Then, when <math id="A5.SS2.p2.m16" class="ltx_Math" alttext="t=t_{0}+1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">t=t_{0}+1</annotation></semantics></math>, we have</p>
<table id="A5.E127" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E127X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E127X.m2" class="ltx_Math" alttext="\displaystyle-({\bm{\mu}}_{j}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(b)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mo stretchy="false">(</mo><mi>𝝁</mi><msub><mrow></mrow><mi>j</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow></msup><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mi>B</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mi>𝝁</mi><msub><mrow></mrow><mi>j</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle-({\bm{\mu}}_{j}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(b)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(127)</span></td></tr>
<tr id="A5.E127Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E127Xa.m2" class="ltx_Math" alttext="\displaystyle\gtrsim" display="inline" intent=":literal"><semantics><mo>≳</mo><annotation encoding="application/x-tex">\displaystyle\gtrsim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E127Xa.m3" class="ltx_Math" alttext="\displaystyle\eta\cdot\sum_{c=1}^{t_{0}+1}\frac{1}{2M_{1}}(1-p_{a})\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(t_{0})})\beta" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>c</mi><mo>=</mo><mn>1</mn></mrow><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>l</mi></munderover></mstyle><mrow><msubsup><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\eta\cdot\sum_{c=1}^{t_{0}+1}\frac{1}{2M_{1}}(1-p_{a})\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(t_{0})})\beta</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E127Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E127Xb.m2" class="ltx_Math" alttext="\displaystyle\gtrsim" display="inline" intent=":literal"><semantics><mo>≳</mo><annotation encoding="application/x-tex">\displaystyle\gtrsim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E127Xb.m3" class="ltx_Math" alttext="\displaystyle\eta(t_{0}+1)\frac{1}{M_{1}}(1-p_{a})\beta." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>M</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\eta(t_{0}+1)\frac{1}{M_{1}}(1-p_{a})\beta.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p2.9" class="ltx_p">For <math id="A5.SS2.p2.m17" class="ltx_Math" alttext="{\bm{\mu}}_{j^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>𝝁</mi><msup><mi>j</mi><mo>′</mo></msup></msub><annotation encoding="application/x-tex">{\bm{\mu}}_{j^{\prime}}</annotation></semantics></math>, <math id="A5.SS2.p2.m18" class="ltx_Math" alttext="j^{\prime}\neq j" display="inline" intent=":literal"><semantics><mrow><msup><mi>j</mi><mo>′</mo></msup><mo>≠</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">j^{\prime}\neq j</annotation></semantics></math>, that does not form a task in the training set, we have</p>
<table id="A5.E128" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E128.m1" class="ltx_math_unparsed" alttext="-({{\bm{\mu}}_{j^{\prime}}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(b)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}=0" display="block" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝝁</mi><msup><mi>j</mi><mo>′</mo></msup><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mi>η</mi><mo lspace="0.222em" rspace="0.055em">⋅</mo><munderover><mo movablelimits="false">∑</mo><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow></munderover><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></munder><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mi>B</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>j</mi><mo>⊤</mo></msubsup><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">-({{\bm{\mu}}_{j^{\prime}}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(b)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(128)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p2.10" class="ltx_p">For <math id="A5.SS2.p2.m19" class="ltx_Math" alttext="{\bm{\mu}}_{j^{\prime\prime}}" display="inline" intent=":literal"><semantics><msub><mi>𝝁</mi><msup><mi>j</mi><mo>′′</mo></msup></msub><annotation encoding="application/x-tex">{\bm{\mu}}_{j^{\prime\prime}}</annotation></semantics></math>, <math id="A5.SS2.p2.m20" class="ltx_Math" alttext="j^{\prime\prime}\neq j" display="inline" intent=":literal"><semantics><mrow><msup><mi>j</mi><mo>′′</mo></msup><mo>≠</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">j^{\prime\prime}\neq j</annotation></semantics></math>, that forms a task in the training set, we have</p>
<table id="A5.E129" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E129X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E129X.m2" class="ltx_Math" alttext="\displaystyle-({{\bm{\mu}}_{j^{\prime\prime}}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(b)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mo stretchy="false">(</mo><mi>𝝁</mi><msub><mrow></mrow><msup><mi>j</mi><mo>′′</mo></msup></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow></msup><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mi>B</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mi>𝝁</mi><msub><mrow></mrow><mi>j</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle-({{\bm{\mu}}_{j^{\prime\prime}}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(b)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(129)</span></td></tr>
<tr id="A5.E129Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E129Xa.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E129Xa.m3" class="ltx_Math" alttext="\displaystyle-\eta(t_{0}+1)\frac{1}{M_{1}}(1-p_{a})\beta." display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>M</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\eta(t_{0}+1)\frac{1}{M_{1}}(1-p_{a})\beta.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p2.11" class="ltx_p">For <math id="A5.SS2.p2.m21" class="ltx_Math" alttext="{\bm{\nu}}_{k}" display="inline" intent=":literal"><semantics><msub><mi>𝝂</mi><mi>k</mi></msub><annotation encoding="application/x-tex">{\bm{\nu}}_{k}</annotation></semantics></math>, <math id="A5.SS2.p2.m22" class="ltx_Math" alttext="{\bm{\nu}}_{k^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>𝝂</mi><msup><mi>k</mi><mo>′</mo></msup></msub><annotation encoding="application/x-tex">{\bm{\nu}}_{k^{\prime}}</annotation></semantics></math> with <math id="A5.SS2.p2.m23" class="ltx_Math" alttext="k\neq k^{\prime}\in[M_{2}]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≠</mo><msup><mi>k</mi><mo>′</mo></msup><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mn>2</mn></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k\neq k^{\prime}\in[M_{2}]</annotation></semantics></math>, we have</p>
<table id="A5.E130" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E130X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E130X.m2" class="ltx_Math" alttext="\displaystyle\Big|-({{\bm{\nu}}_{k}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(b)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta(t_{0}+1)\beta}{M_{1}M_{2}}\sqrt{\frac{\log B}{B}}," display="inline" intent=":literal"><semantics><mrow><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0em">−</mo><mo stretchy="false">(</mo><mi>𝝂</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow></msup><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mi>B</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mi>𝝁</mi><msub><mrow></mrow><mi>j</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0.167em">≤</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mrow><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>2</mn></msub></mrow></mfrac></mstyle><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big|-({{\bm{\nu}}_{k}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(b)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta(t_{0}+1)\beta}{M_{1}M_{2}}\sqrt{\frac{\log B}{B}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(130)</span></td></tr></tbody>
</table>
<table id="A5.E131" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E131X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E131X.m2" class="ltx_Math" alttext="\displaystyle\Big|-({{\bm{\mu}}_{j}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}_{B}^{(b)}}({\bm{\nu}}_{k}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta(t_{0}+1)\beta}{M_{1}M_{2}}\sqrt{\frac{\log B}{B}}." display="inline" intent=":literal"><semantics><mrow><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0em">−</mo><mo stretchy="false">(</mo><mi>𝝁</mi><msub><mrow></mrow><mi>j</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow></msup><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mi>B</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mi>𝝂</mi><msub><mrow></m