<td id="A3.T2.2.3.2" class="ltx_td ltx_align_left ltx_border_t">
<span id="A3.T2.2.3.2.1" class="ltx_inline-block ltx_align_top">
<span id="A3.T2.2.3.2.1.1" class="ltx_p">sigmoid function.</span>
</span></td></tr>
<tr id="A3.T2.2.4" class="ltx_tr">
<th id="A3.T2.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><math id="A3.T2.m5" class="ltx_Math" alttext="{\bm{x}}_{s}^{n}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.900em">𝒙</mi><mi mathsize="0.900em">s</mi><mi mathsize="0.900em">n</mi></msubsup><annotation encoding="application/x-tex">{\bm{x}}_{s}^{n}</annotation></semantics></math><span id="A3.T2.2.4.1.1" class="ltx_text" style="font-size:90%;">, <math id="A3.T2.m6" class="ltx_Math" alttext="y_{s}^{n}" display="inline" intent=":literal"><semantics><msubsup><mi>y</mi><mi>s</mi><mi>n</mi></msubsup><annotation encoding="application/x-tex">y_{s}^{n}</annotation></semantics></math></span></th>
<td id="A3.T2.2.4.2" class="ltx_td ltx_align_left ltx_border_t">
<span id="A3.T2.2.4.2.1" class="ltx_inline-block ltx_align_top">
<span id="A3.T2.2.4.2.1.1" class="ltx_p"><math id="A3.T2.m7" class="ltx_Math" alttext="{\bm{x}}_{s}^{n}" display="inline" intent=":literal"><semantics><msubsup><mi>𝒙</mi><mi>s</mi><mi>n</mi></msubsup><annotation encoding="application/x-tex">{\bm{x}}_{s}^{n}</annotation></semantics></math> is the input data for classification. <math id="A3.T2.m8" class="ltx_Math" alttext="y_{s}^{n}" display="inline" intent=":literal"><semantics><msubsup><mi>y</mi><mi>s</mi><mi>n</mi></msubsup><annotation encoding="application/x-tex">y_{s}^{n}</annotation></semantics></math> is the label for <math id="A3.T2.m9" class="ltx_Math" alttext="{\bm{x}}_{s}^{n}" display="inline" intent=":literal"><semantics><msubsup><mi>𝒙</mi><mi>s</mi><mi>n</mi></msubsup><annotation encoding="application/x-tex">{\bm{x}}_{s}^{n}</annotation></semantics></math>.</span>
</span></td></tr>
<tr id="A3.T2.2.5" class="ltx_tr">
<th id="A3.T2.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><math id="A3.T2.m10" class="ltx_Math" alttext="{\bm{P}}^{n}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.900em">𝑷</mi><mi mathsize="0.900em">n</mi></msup><annotation encoding="application/x-tex">{\bm{P}}^{n}</annotation></semantics></math><span id="A3.T2.2.5.1.1" class="ltx_text" style="font-size:90%;">, <math id="A3.T2.m11" class="ltx_Math" alttext="z^{n}" display="inline" intent=":literal"><semantics><msup><mi>z</mi><mi>n</mi></msup><annotation encoding="application/x-tex">z^{n}</annotation></semantics></math></span></th>
<td id="A3.T2.2.5.2" class="ltx_td ltx_align_left ltx_border_t">
<span id="A3.T2.2.5.2.1" class="ltx_inline-block ltx_align_top">
<span id="A3.T2.2.5.2.1.1" class="ltx_p"><math id="A3.T2.m12" class="ltx_Math" alttext="{\bm{P}}^{n}" display="inline" intent=":literal"><semantics><msup><mi>𝑷</mi><mi>n</mi></msup><annotation encoding="application/x-tex">{\bm{P}}^{n}</annotation></semantics></math> is a prompt that consists of the query and <math id="A3.T2.m13" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> pairs of examples of <math id="A3.T2.m14" class="ltx_Math" alttext="{\bm{x}}_{s}^{n}" display="inline" intent=":literal"><semantics><msubsup><mi>𝒙</mi><mi>s</mi><mi>n</mi></msubsup><annotation encoding="application/x-tex">{\bm{x}}_{s}^{n}</annotation></semantics></math> and <math id="A3.T2.m15" class="ltx_Math" alttext="y_{s}^{n}" display="inline" intent=":literal"><semantics><msubsup><mi>y</mi><mi>s</mi><mi>n</mi></msubsup><annotation encoding="application/x-tex">y_{s}^{n}</annotation></semantics></math>, <math id="A3.T2.m16" class="ltx_Math" alttext="s\in[l]" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>l</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">s\in[l]</annotation></semantics></math>. <math id="A3.T2.m17" class="ltx_Math" alttext="z^{n}\in\{+1,-1\}" display="inline" intent=":literal"><semantics><mrow><msup><mi>z</mi><mi>n</mi></msup><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">z^{n}\in\{+1,-1\}</annotation></semantics></math> is the binary label of <math id="A3.T2.m18" class="ltx_Math" alttext="{\bm{p}}_{query}^{n}" display="inline" intent=":literal"><semantics><msubsup><mi>𝒑</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>n</mi></msubsup><annotation encoding="application/x-tex">{\bm{p}}_{query}^{n}</annotation></semantics></math>.</span>
</span></td></tr>
<tr id="A3.T2.2.6" class="ltx_tr">
<th id="A3.T2.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><math id="A3.T2.m19" class="ltx_Math" alttext="F(\Psi;{\bm{P}}^{n})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">F</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em" mathvariant="normal">Ψ</mi><mo mathsize="0.900em">,</mo><msup><mi mathsize="0.900em">𝑷</mi><mi mathsize="0.900em">n</mi></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">F(\Psi;{\bm{P}}^{n})</annotation></semantics></math><span id="A3.T2.2.6.1.1" class="ltx_text" style="font-size:90%;">, <math id="A3.T2.m20" class="ltx_Math" alttext="\ell(\Psi;{\bm{P}}^{n},z^{n})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\ell(\Psi;{\bm{P}}^{n},z^{n})</annotation></semantics></math></span></th>
<td id="A3.T2.2.6.2" class="ltx_td ltx_align_left ltx_border_t">
<span id="A3.T2.2.6.2.1" class="ltx_inline-block ltx_align_top">
<span id="A3.T2.2.6.2.1.1" class="ltx_p"><math id="A3.T2.m21" class="ltx_Math" alttext="F(\Psi;{\bm{P}}^{n})" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F(\Psi;{\bm{P}}^{n})</annotation></semantics></math> is the model output for <math id="A3.T2.m22" class="ltx_Math" alttext="{\bm{P}}^{n}" display="inline" intent=":literal"><semantics><msup><mi>𝑷</mi><mi>n</mi></msup><annotation encoding="application/x-tex">{\bm{P}}^{n}</annotation></semantics></math> with <math id="A3.T2.m23" class="ltx_Math" alttext="\Psi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ψ</mi><annotation encoding="application/x-tex">\Psi</annotation></semantics></math> as the parameter. <math id="A3.T2.m24" class="ltx_Math" alttext="\ell(\Psi;{\bm{P}}^{n},z^{n})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\ell(\Psi;{\bm{P}}^{n},z^{n})</annotation></semantics></math> is the loss function given the input <math id="A3.T2.m25" class="ltx_Math" alttext="{\bm{P}}^{n}" display="inline" intent=":literal"><semantics><msup><mi>𝑷</mi><mi>n</mi></msup><annotation encoding="application/x-tex">{\bm{P}}^{n}</annotation></semantics></math> and the corresponding label <math id="A3.T2.m26" class="ltx_Math" alttext="z^{n}" display="inline" intent=":literal"><semantics><msup><mi>z</mi><mi>n</mi></msup><annotation encoding="application/x-tex">z^{n}</annotation></semantics></math>.</span>
</span></td></tr>
<tr id="A3.T2.2.7" class="ltx_tr">
<th id="A3.T2.2.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><math id="A3.T2.m27" class="ltx_Math" alttext="L_{f\in\mathcal{T},{\bm{P}}^{\prime}\sim\mathcal{D}^{\prime}}^{0-1}(\Psi;{\bm{P}}^{\prime},z)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.900em">L</mi><mrow><mrow><mi mathsize="0.900em">f</mi><mo mathsize="0.900em">∈</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒯</mi></mrow><mo mathsize="0.900em">,</mo><mrow><msup><mi mathsize="0.900em">𝑷</mi><mo mathsize="0.900em">′</mo></msup><mo mathsize="0.900em">∼</mo><msup><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒟</mi><mo mathsize="0.900em">′</mo></msup></mrow></mrow><mrow><mn mathsize="0.900em">0</mn><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em" mathvariant="normal">Ψ</mi><mo mathsize="0.900em">,</mo><msup><mi mathsize="0.900em">𝑷</mi><mo mathsize="0.900em">′</mo></msup><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">z</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">L_{f\in\mathcal{T},{\bm{P}}^{\prime}\sim\mathcal{D}^{\prime}}^{0-1}(\Psi;{\bm{P}}^{\prime},z)</annotation></semantics></math></th>
<td id="A3.T2.2.7.2" class="ltx_td ltx_align_left ltx_border_t">
<span id="A3.T2.2.7.2.1" class="ltx_inline-block ltx_align_top">
<span id="A3.T2.2.7.2.1.1" class="ltx_p">The classification error of <math id="A3.T2.m28" class="ltx_Math" alttext="\Psi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ψ</mi><annotation encoding="application/x-tex">\Psi</annotation></semantics></math> given <math id="A3.T2.m29" class="ltx_Math" alttext="{\bm{P}}^{\prime}\sim\mathcal{D}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑷</mi><mo>′</mo></msup><mo>∼</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">{\bm{P}}^{\prime}\sim\mathcal{D}^{\prime}</annotation></semantics></math> as the input and <math id="A3.T2.m30" class="ltx_Math" alttext="f\in\mathcal{T}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow><annotation encoding="application/x-tex">f\in\mathcal{T}</annotation></semantics></math>.</span>
</span></td></tr>
<tr id="A3.T2.2.8" class="ltx_tr">
<th id="A3.T2.2.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><math id="A3.T2.m31" class="ltx_Math" alttext="{\bm{\mu}}_{j}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">𝝁</mi><mi mathsize="0.900em">j</mi></msub><annotation encoding="application/x-tex">{\bm{\mu}}_{j}</annotation></semantics></math><span id="A3.T2.2.8.1.1" class="ltx_text" style="font-size:90%;">, <math id="A3.T2.m32" class="ltx_Math" alttext="{\bm{\nu}}_{k}" display="inline" intent=":literal"><semantics><msub><mi>𝝂</mi><mi>k</mi></msub><annotation encoding="application/x-tex">{\bm{\nu}}_{k}</annotation></semantics></math></span></th>
<td id="A3.T2.2.8.2" class="ltx_td ltx_align_left ltx_border_t">
<span id="A3.T2.2.8.2.1" class="ltx_inline-block ltx_align_top">
<span id="A3.T2.2.8.2.1.1" class="ltx_p"><math id="A3.T2.m33" class="ltx_Math" alttext="{\bm{\mu}}_{j}" display="inline" intent=":literal"><semantics><msub><mi>𝝁</mi><mi>j</mi></msub><annotation encoding="application/x-tex">{\bm{\mu}}_{j}</annotation></semantics></math> and <math id="A3.T2.m34" class="ltx_Math" alttext="{\bm{\nu}}_{k}" display="inline" intent=":literal"><semantics><msub><mi>𝝂</mi><mi>k</mi></msub><annotation encoding="application/x-tex">{\bm{\nu}}_{k}</annotation></semantics></math> are the relevant and irrelevant patterns in the data formulation.</span>
</span></td></tr>
<tr id="A3.T2.2.9" class="ltx_tr">
<th id="A3.T2.2.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><math id="A3.T2.m35" class="ltx_Math" alttext="M_{1}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">M</mi><mn mathsize="0.900em">1</mn></msub><annotation encoding="application/x-tex">M_{1}</annotation></semantics></math><span id="A3.T2.2.9.1.1" class="ltx_text" style="font-size:90%;">, <math id="A3.T2.m36" class="ltx_Math" alttext="M_{2}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mn>2</mn></msub><annotation encoding="application/x-tex">M_{2}</annotation></semantics></math></span></th>
<td id="A3.T2.2.9.2" class="ltx_td ltx_align_left ltx_border_t">
<span id="A3.T2.2.9.2.1" class="ltx_inline-block ltx_align_top">
<span id="A3.T2.2.9.2.1.1" class="ltx_p"><math id="A3.T2.m37" class="ltx_Math" alttext="M_{1}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mn>1</mn></msub><annotation encoding="application/x-tex">M_{1}</annotation></semantics></math> is the number of relevant patterns. <math id="A3.T2.m38" class="ltx_Math" alttext="M_{2}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mn>2</mn></msub><annotation encoding="application/x-tex">M_{2}</annotation></semantics></math> is the number of irrelevant patterns.</span>
</span></td></tr>
<tr id="A3.T2.2.10" class="ltx_tr">
<th id="A3.T2.2.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><math id="A3.T2.m39" class="ltx_Math" alttext="{\bm{v}}_{s}^{*}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.900em">𝒗</mi><mi mathsize="0.900em">s</mi><mo mathsize="0.900em">∗</mo></msubsup><annotation encoding="application/x-tex">{\bm{v}}_{s}^{*}</annotation></semantics></math><span id="A3.T2.2.10.1.1" class="ltx_text" style="font-size:90%;">, <math id="A3.T2.m40" class="ltx_Math" alttext="{{\bm{v}}_{s}^{*}}^{\prime}" display="inline" intent=":literal"><semantics><mmultiscripts><mi>𝒗</mi><mi>s</mi><mo>∗</mo><mrow></mrow><mo>′</mo></mmultiscripts><annotation encoding="application/x-tex">{{\bm{v}}_{s}^{*}}^{\prime}</annotation></semantics></math>, <math id="A3.T2.m41" class="ltx_Math" alttext="\kappa_{a}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mi>a</mi></msub><annotation encoding="application/x-tex">\kappa_{a}</annotation></semantics></math>, <math id="A3.T2.m42" class="ltx_Math" alttext="\kappa_{a}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>κ</mi><mi>a</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">\kappa_{a}^{\prime}</annotation></semantics></math></span></th>
<td id="A3.T2.2.10.2" class="ltx_td ltx_align_left ltx_border_t">
<span id="A3.T2.2.10.2.1" class="ltx_inline-block ltx_align_top">
<span id="A3.T2.2.10.2.1.1" class="ltx_p"><math id="A3.T2.m43" class="ltx_Math" alttext="{\bm{v}}_{s}^{*}" display="inline" intent=":literal"><semantics><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">{\bm{v}}_{s}^{*}</annotation></semantics></math>, <math id="A3.T2.m44" class="ltx_Math" alttext="s\in[V]" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>V</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">s\in[V]</annotation></semantics></math> is the additive outlier for training. <math id="A3.T2.m45" class="ltx_Math" alttext="{{\bm{v}}_{s}^{*}}^{\prime}" display="inline" intent=":literal"><semantics><mmultiscripts><mi>𝒗</mi><mi>s</mi><mo>∗</mo><mrow></mrow><mo>′</mo></mmultiscripts><annotation encoding="application/x-tex">{{\bm{v}}_{s}^{*}}^{\prime}</annotation></semantics></math> is the additive outlier for testing. <math id="A3.T2.m46" class="ltx_Math" alttext="\kappa_{a}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mi>a</mi></msub><annotation encoding="application/x-tex">\kappa_{a}</annotation></semantics></math> and <math id="A3.T2.m47" class="ltx_Math" alttext="\kappa_{a}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>κ</mi><mi>a</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">\kappa_{a}^{\prime}</annotation></semantics></math> are the magnitudes of outliers in training and testing.</span>
</span></td></tr>
<tr id="A3.T2.2.11" class="ltx_tr">
<th id="A3.T2.2.11.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><math id="A3.T2.m48" class="ltx_Math" alttext="p_{a}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">p</mi><mi mathsize="0.900em">a</mi></msub><annotation encoding="application/x-tex">p_{a}</annotation></semantics></math><span id="A3.T2.2.11.1.1" class="ltx_text" style="font-size:90%;">, <math id="A3.T2.m49" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math></span></th>
<td id="A3.T2.2.11.2" class="ltx_td ltx_align_left ltx_border_t">
<span id="A3.T2.2.11.2.1" class="ltx_inline-block ltx_align_top">
<span id="A3.T2.2.11.2.1.1" class="ltx_p"><math id="A3.T2.m50" class="ltx_Math" alttext="p_{a}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>a</mi></msub><annotation encoding="application/x-tex">p_{a}</annotation></semantics></math> is the probability of examples containing additive outliers in training prompts. <math id="A3.T2.m51" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> is the probability of examples containing outliers in testing prompts.</span>
</span></td></tr>
<tr id="A3.T2.2.12" class="ltx_tr">
<th id="A3.T2.2.12.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><math id="A3.T2.m52" class="ltx_Math" alttext="\mathcal{B}_{b}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℬ</mi><mi mathsize="0.900em">b</mi></msub><annotation encoding="application/x-tex">\mathcal{B}_{b}</annotation></semantics></math></th>
<td id="A3.T2.2.12.2" class="ltx_td ltx_align_left ltx_border_t">
<span id="A3.T2.2.12.2.1" class="ltx_inline-block ltx_align_top">
<span id="A3.T2.2.12.2.1.1" class="ltx_p"><math id="A3.T2.m53" class="ltx_Math" alttext="\mathcal{B}_{b}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><annotation encoding="application/x-tex">\mathcal{B}_{b}</annotation></semantics></math> is the SGD batch at the <math id="A3.T2.m54" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math>-th iteration. <math id="A3.T2.m55" class="ltx_Math" alttext="l_{ts}" display="inline" intent=":literal"><semantics><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><annotation encoding="application/x-tex">l_{ts}</annotation></semantics></math> is the prompt length of the testing data.</span>
</span></td></tr>
<tr id="A3.T2.2.13" class="ltx_tr">
<th id="A3.T2.2.13.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><math id="A3.T2.m56" class="ltx_Math" alttext="l_{tr}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">l</mi><mrow><mi mathsize="0.900em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">r</mi></mrow></msub><annotation encoding="application/x-tex">l_{tr}</annotation></semantics></math><span id="A3.T2.2.13.1.1" class="ltx_text" style="font-size:90%;">, <math id="A3.T2.m57" class="ltx_Math" alttext="l_{ts}" display="inline" intent=":literal"><semantics><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><annotation encoding="application/x-tex">l_{ts}</annotation></semantics></math></span></th>
<td id="A3.T2.2.13.2" class="ltx_td ltx_align_left ltx_border_t">
<span id="A3.T2.2.13.2.1" class="ltx_inline-block ltx_align_top">
<span id="A3.T2.2.13.2.1.1" class="ltx_p"><math id="A3.T2.m58" class="ltx_Math" alttext="l_{tr}" display="inline" intent=":literal"><semantics><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">l_{tr}</annotation></semantics></math> is the prompt length of the training data. <math id="A3.T2.m59" class="ltx_Math" alttext="l_{ts}" display="inline" intent=":literal"><semantics><msub><mi>l</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><annotation encoding="application/x-tex">l_{ts}</annotation></semantics></math> is the prompt length of the testing data.</span>
</span></td></tr>
<tr id="A3.T2.2.14" class="ltx_tr">
<th id="A3.T2.2.14.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><math id="A3.T2.m60" class="ltx_Math" alttext="\mathcal{O}()" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒪</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}()</annotation></semantics></math><span id="A3.T2.2.14.1.1" class="ltx_text" style="font-size:90%;">, <math id="A3.T2.m61" class="ltx_Math" alttext="\Omega()" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Omega()</annotation></semantics></math>, <math id="A3.T2.m62" class="ltx_Math" alttext="\Theta()" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Theta()</annotation></semantics></math></span></th>
<td id="A3.T2.2.14.2" class="ltx_td ltx_align_left ltx_border_t">
<span id="A3.T2.2.14.2.1" class="ltx_inline-block ltx_align_top">
<span id="A3.T2.2.14.2.1.1" class="ltx_p">We follow the convention that <math id="A3.T2.m63" class="ltx_Math" alttext="f(x)=O(g(x))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f(x)=O(g(x))</annotation></semantics></math> (or <math id="A3.T2.m64" class="ltx_Math" alttext="\Omega(g(x))" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Omega(g(x))</annotation></semantics></math>, <math id="A3.T2.m65" class="ltx_Math" alttext="\Theta(g(x)))" display="inline" intent=":literal"><semantics><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\Theta(g(x)))</annotation></semantics></math>) means that <math id="A3.T2.m66" class="ltx_Math" alttext="f(x)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(x)</annotation></semantics></math> increases at most, at least, or in the order of <math id="A3.T2.m67" class="ltx_Math" alttext="g(x)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g(x)</annotation></semantics></math>, respectively.</span>
</span></td></tr>
<tr id="A3.T2.2.15" class="ltx_tr">
<th id="A3.T2.2.15.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_t"><math id="A3.T2.m68" class="ltx_Math" alttext="\gtrsim" display="inline" intent=":literal"><semantics><mo mathsize="0.900em">≳</mo><annotation encoding="application/x-tex">\gtrsim</annotation></semantics></math><span id="A3.T2.2.15.1.1" class="ltx_text" style="font-size:90%;">, <math id="A3.T2.m69" class="ltx_Math" alttext="\lesssim" display="inline" intent=":literal"><semantics><mo>≲</mo><annotation encoding="application/x-tex">\lesssim</annotation></semantics></math></span></th>
<td id="A3.T2.2.15.2" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t">
<span id="A3.T2.2.15.2.1" class="ltx_inline-block ltx_align_top">
<span id="A3.T2.2.15.2.1.1" class="ltx_p"><math id="A3.T2.m70" class="ltx_Math" alttext="f(x)\gtrsim g(x)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≳</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f(x)\gtrsim g(x)</annotation></semantics></math> (or <math id="A3.T2.m71" class="ltx_Math" alttext="f(x)\lesssim g(x)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≲</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f(x)\lesssim g(x)</annotation></semantics></math> ) means that <math id="A3.T2.m72" class="ltx_Math" alttext="f(x)\geq\Omega(g(x))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f(x)\geq\Omega(g(x))</annotation></semantics></math> (or <math id="A3.T2.m73" class="ltx_Math" alttext="f(x)\lesssim\mathcal{O}(g(x))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≲</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f(x)\lesssim\mathcal{O}(g(x))</annotation></semantics></math>).</span>
</span></td></tr>
</tbody>
</table>
</figure>
<div id="Thmlemma1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma1.2" class="ltx_text ltx_font_bold">Lemma 1</span></span><span id="Thmlemma1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma1.p1" class="ltx_para">
<p id="Thmlemma1.p1.1" class="ltx_p"><span id="Thmlemma1.p1.1.1" class="ltx_text ltx_font_italic">(Multiplicative Chernoff bounds, Theorem D.4 of <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib61" title="" class="ltx_ref">Mohri et al. (2018)</a></cite>) Let <math id="Thmlemma1.p1.m1" class="ltx_Math" alttext="X_{1}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mn>1</mn></msub><annotation encoding="application/x-tex">X_{1}</annotation></semantics></math>, <math id="Thmlemma1.p1.m2" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo>⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math>, <math id="Thmlemma1.p1.m3" class="ltx_Math" alttext="X_{m}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>m</mi></msub><annotation encoding="application/x-tex">X_{m}</annotation></semantics></math> be independent random variables drawn according to some distribution <math id="Thmlemma1.p1.m4" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math> with mean <math id="Thmlemma1.p1.m5" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> and support included in <math id="Thmlemma1.p1.m6" class="ltx_Math" alttext="[0,1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,1]</annotation></semantics></math>. Then, for any <math id="Thmlemma1.p1.m7" class="ltx_Math" alttext="\gamma\in[0,\frac{1}{p}-1]" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mrow><mfrac><mn>1</mn><mi>p</mi></mfrac><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma\in[0,\frac{1}{p}-1]</annotation></semantics></math>, the following inequality holds for <math id="Thmlemma1.p1.m8" class="ltx_Math" alttext="\hat{p}=\frac{1}{m}\sum_{i=1}^{m}X_{i}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>p</mi><mo>^</mo></mover><mo>=</mo><mrow><mfrac><mn>1</mn><mi>m</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><msub><mi>X</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{p}=\frac{1}{m}\sum_{i=1}^{m}X_{i}</annotation></semantics></math>:</span></p>
<table id="A3.E20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E20.m1" class="ltx_Math" alttext="\Pr(\hat{p}\geq(1+\gamma)p)\leq e^{-\frac{mp\gamma^{2}}{3}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>p</mi><mo>^</mo></mover><mo>≥</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><msup><mi>e</mi><mrow><mo>−</mo><mfrac><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><mn>3</mn></mfrac></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\Pr(\hat{p}\geq(1+\gamma)p)\leq e^{-\frac{mp\gamma^{2}}{3}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
<table id="A3.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E21.m1" class="ltx_Math" alttext="\Pr(\hat{p}\leq(1-\gamma)p)\leq e^{-\frac{mp\gamma^{2}}{2}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>p</mi><mo>^</mo></mover><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><msup><mi>e</mi><mrow><mo>−</mo><mfrac><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><mn>2</mn></mfrac></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Pr(\hat{p}\leq(1-\gamma)p)\leq e^{-\frac{mp\gamma^{2}}{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="Thmdefinition3" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmdefinition3.2" class="ltx_text ltx_font_bold">Definition 3</span></span><span id="Thmdefinition3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmdefinition3.p1" class="ltx_para">
<p id="Thmdefinition3.p1.1" class="ltx_p"><cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib74" title="" class="ltx_ref">Vershynin (2010)</a></cite><span id="Thmdefinition3.p1.1.3" class="ltx_text ltx_font_italic">
We say <math id="Thmdefinition3.p1.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is a sub-Gaussian random variable with sub-Gaussian norm <math id="Thmdefinition3.p1.m2" class="ltx_Math" alttext="K&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">K&gt;0</annotation></semantics></math>, if <math id="Thmdefinition3.p1.m3" class="ltx_Math" alttext="(\mathbb{E}|X|^{p})^{\frac{1}{p}}\leq K\sqrt{p}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mi>X</mi><mo stretchy="false">|</mo></mrow><mi>p</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mi>p</mi></mfrac></msup><mo>≤</mo><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>p</mi></msqrt></mrow></mrow><annotation encoding="application/x-tex">(\mathbb{E}|X|^{p})^{\frac{1}{p}}\leq K\sqrt{p}</annotation></semantics></math> for all <math id="Thmdefinition3.p1.m4" class="ltx_Math" alttext="p\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p\geq 1</annotation></semantics></math>. In addition, the sub-Gaussian norm of X, denoted <math id="Thmdefinition3.p1.m5" class="ltx_Math" alttext="\|X\|_{\psi_{2}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mi>X</mi><mo stretchy="false">‖</mo></mrow><msub><mi>ψ</mi><mn>2</mn></msub></msub><annotation encoding="application/x-tex">\|X\|_{\psi_{2}}</annotation></semantics></math>, is defined as <math id="Thmdefinition3.p1.m6" class="ltx_Math" alttext="\|X\|_{\psi_{2}}=\sup_{p\geq 1}p^{-\frac{1}{2}}(\mathbb{E}|X|^{p})^{\frac{1}{p}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>X</mi><mo stretchy="false">‖</mo></mrow><msub><mi>ψ</mi><mn>2</mn></msub></msub><mo rspace="0.1389em">=</mo><mrow><msub><mo lspace="0.1389em" rspace="0.167em">sup</mo><mrow><mi>p</mi><mo>≥</mo><mn>1</mn></mrow></msub><mrow><msup><mi>p</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mi>X</mi><mo stretchy="false">|</mo></mrow><mi>p</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mi>p</mi></mfrac></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\|X\|_{\psi_{2}}=\sup_{p\geq 1}p^{-\frac{1}{2}}(\mathbb{E}|X|^{p})^{\frac{1}{p}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="Thmlemma2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma2.2" class="ltx_text ltx_font_bold">Lemma 2</span></span><span id="Thmlemma2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma2.p1" class="ltx_para">
<p id="Thmlemma2.p1.1" class="ltx_p"><span id="Thmlemma2.p1.1.1" class="ltx_text ltx_font_italic">(<cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib74" title="" class="ltx_ref">Vershynin (2010)</a></cite>
Proposition 5.1, Hoeffding’s inequality) Let <math id="Thmlemma2.p1.m1" class="ltx_Math" alttext="X_{1},X_{2},\cdots,X_{N}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mn>1</mn></msub><mo>,</mo><msub><mi>X</mi><mn>2</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>X</mi><mi>N</mi></msub></mrow><annotation encoding="application/x-tex">X_{1},X_{2},\cdots,X_{N}</annotation></semantics></math> be independent centered sub-gaussian random variables, and let <math id="Thmlemma2.p1.m2" class="ltx_Math" alttext="K=\max_{i}\|{\bm{X}}_{i}\|_{\psi_{2}}" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mrow><msub><mi>max</mi><mi>i</mi></msub><mo>⁡</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐗</mi><mi>i</mi></msub><mo stretchy="false">‖</mo></mrow><msub><mi>ψ</mi><mn>2</mn></msub></msub></mrow></mrow><annotation encoding="application/x-tex">K=\max_{i}\|{\bm{X}}_{i}\|_{\psi_{2}}</annotation></semantics></math>. Then for every <math id="Thmlemma2.p1.m3" class="ltx_Math" alttext="{\bm{a}}=(a_{1},\cdots,a_{N})\in\mathbb{R}^{N}" display="inline" intent=":literal"><semantics><mrow><mi>𝐚</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>a</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>N</mi></msup></mrow><annotation encoding="application/x-tex">{\bm{a}}=(a_{1},\cdots,a_{N})\in\mathbb{R}^{N}</annotation></semantics></math> and every <math id="Thmlemma2.p1.m4" class="ltx_Math" alttext="t\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t\geq 0</annotation></semantics></math>, we have</span></p>
<table id="A3.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E22.m1" class="ltx_Math" alttext="\Pr\Big(\Big|\sum_{i=1}^{N}a_{i}X_{i}\Big|\geq t\Big)\leq e\cdot\exp\left(-\frac{ct^{2}}{K^{2}\|{\bm{a}}\|^{2}}\right)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><mrow><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mi>i</mi></msub></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow><mo>≥</mo><mi>t</mi></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>e</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mfrac><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mn>2</mn></msup></mrow><mrow><msup><mi>K</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒂</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mfrac></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\Pr\Big(\Big|\sum_{i=1}^{N}a_{i}X_{i}\Big|\geq t\Big)\leq e\cdot\exp\left(-\frac{ct^{2}}{K^{2}\|{\bm{a}}\|^{2}}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
</table>
<p id="Thmlemma2.p1.2" class="ltx_p"><span id="Thmlemma2.p1.2.1" class="ltx_text ltx_font_italic">where <math id="Thmlemma2.p1.m5" class="ltx_Math" alttext="c&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c&gt;0</annotation></semantics></math> is an absolute constant.</span></p>
</div>
</div>
<div id="Thmlemma3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma3.2" class="ltx_text ltx_font_bold">Lemma 3</span></span><span id="Thmlemma3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma3.p1" class="ltx_para">
<p id="Thmlemma3.p1.2" class="ltx_p"><span id="Thmlemma3.p1.2.1" class="ltx_text ltx_font_italic">For any <math id="Thmlemma3.p1.m1" class="ltx_Math" alttext="j\neq j^{\prime},j^{\prime\prime}\in[M_{1}]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>≠</mo><msup><mi>j</mi><mo>′</mo></msup></mrow><mo>,</mo><mrow><msup><mi>j</mi><mo>′′</mo></msup><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">j\neq j^{\prime},j^{\prime\prime}\in[M_{1}]</annotation></semantics></math>, <math id="Thmlemma3.p1.m2" class="ltx_Math" alttext="k\neq k^{\prime}\in[M_{2}]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≠</mo><msup><mi>k</mi><mo>′</mo></msup><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mn>2</mn></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k\neq k^{\prime}\in[M_{2}]</annotation></semantics></math>, and <math id="Thmlemma3.p1.m3" class="ltx_Math" alttext="s\in[V]" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>V</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">s\in[V]</annotation></semantics></math>, <math id="Thmlemma3.p1.m4" class="ltx_Math" alttext="j^{\prime\prime}" display="inline" intent=":literal"><semantics><msup><mi>j</mi><mo>′′</mo></msup><annotation encoding="application/x-tex">j^{\prime\prime}</annotation></semantics></math> where <math id="Thmlemma3.p1.m5" class="ltx_Math" alttext="{\bm{\mu}}_{j}" display="inline" intent=":literal"><semantics><msub><mi>𝛍</mi><mi>j</mi></msub><annotation encoding="application/x-tex">{\bm{\mu}}_{j}</annotation></semantics></math> and <math id="Thmlemma3.p1.m6" class="ltx_Math" alttext="{\bm{\mu}}_{j^{\prime\prime}}" display="inline" intent=":literal"><semantics><msub><mi>𝛍</mi><msup><mi>j</mi><mo>′′</mo></msup></msub><annotation encoding="application/x-tex">{\bm{\mu}}_{j^{\prime\prime}}</annotation></semantics></math> form a training task, and <math id="Thmlemma3.p1.m7" class="ltx_Math" alttext="j^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>j</mi><mo>′</mo></msup><annotation encoding="application/x-tex">j^{\prime}</annotation></semantics></math> where <math id="Thmlemma3.p1.m8" class="ltx_Math" alttext="{\bm{\mu}}_{j}" display="inline" intent=":literal"><semantics><msub><mi>𝛍</mi><mi>j</mi></msub><annotation encoding="application/x-tex">{\bm{\mu}}_{j}</annotation></semantics></math> and <math id="Thmlemma3.p1.m9" class="ltx_Math" alttext="{\bm{\mu}}_{j^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>𝛍</mi><msup><mi>j</mi><mo>′</mo></msup></msub><annotation encoding="application/x-tex">{\bm{\mu}}_{j^{\prime}}</annotation></semantics></math> does not form a training task, we have that for <math id="Thmlemma3.p1.m10" class="ltx_Math" alttext="{\bm{W}}\in\{{\bm{W}}_{B},{\bm{W}}_{C}\}" display="inline" intent=":literal"><semantics><mrow><mi>𝐖</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><msub><mi>𝐖</mi><mi>B</mi></msub><mo>,</mo><msub><mi>𝐖</mi><mi>C</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{W}}\in\{{\bm{W}}_{B},{\bm{W}}_{C}\}</annotation></semantics></math>, if <math id="Thmlemma3.p1.m11" class="ltx_Math" alttext="B\gtrsim\max\{(1-p_{a})^{-1}M_{1}\log\epsilon^{-1},(1-p_{a})^{-2}\log\epsilon^{-1}\}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>≳</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo>,</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">B\gtrsim\max\{(1-p_{a})^{-1}M_{1}\log\epsilon^{-1},(1-p_{a})^{-2}\log\epsilon^{-1}\}</annotation></semantics></math>,</span></p>
<table id="A3.E23" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A3.E23X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E23X.m2" class="ltx_Math" alttext="\displaystyle-({\bm{\mu}}_{j}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}^{(b)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}\gtrsim\eta(t+1)\frac{1}{M_{1}}(1-p_{a})\beta," display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mo stretchy="false">(</mo><mi>𝝁</mi><msub><mrow></mrow><mi>j</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mi>𝝁</mi><msub><mrow></mrow><mi>j</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mo>≳</mo><mi>η</mi><mo stretchy="false">(</mo><mi>t</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>M</mi><mn>1</mn></msub></mfrac></mstyle><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>p</mi><msub><mrow></mrow><mi>a</mi></msub><mo stretchy="false">)</mo><mi>β</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle-({\bm{\mu}}_{j}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}^{(b)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}\gtrsim\eta(t+1)\frac{1}{M_{1}}(1-p_{a})\beta,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(23)</span></td></tr></tbody>
</table>
<table id="A3.E24" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A3.E24X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E24X.m2" class="ltx_Math" alttext="\displaystyle\Big|({{\bm{v}}^{*}_{s}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}^{(b)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta\beta(t+1)p_{a}\kappa_{a}}{M_{1}V}\cdot\sqrt{\frac{\log B}{B}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝒗</mi><mi>s</mi><mo>∗</mo><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>j</mi><mo>⊤</mo></msubsup><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>a</mi></msub></mrow><mrow><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big|({{\bm{v}}^{*}_{s}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}^{(b)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}\Big|\leq\frac{\eta\beta(t+1)p_{a}\kappa_{a}}{M_{1}V}\cdot\sqrt{\frac{\log B}{B}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(24)</span></td></tr></tbody>
</table>
<table id="A3.E25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E25.m1" class="ltx_math_unparsed" alttext="-({{\bm{\mu}}_{j^{\prime}}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}^{(b)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}=0," display="block" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝝁</mi><msup><mi>j</mi><mo>′</mo></msup><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mi>η</mi><mo lspace="0.222em" rspace="0.055em">⋅</mo><munderover><mo movablelimits="false">∑</mo><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow></munderover><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub><mo stretchy="false">|</mo></mrow></mfrac><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></munder><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∂</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>j</mi><mo>⊤</mo></msubsup><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo>=</mo><mn>0</mn><mo>,</mo></mrow><annotation encoding="application/x-tex">-({{\bm{\mu}}_{j^{\prime}}}^{\top},0^{\top})\eta\cdot\sum_{b=1}^{t_{0}+1}\frac{1}{|\mathcal{B}_{b}|}\sum_{n\in\mathcal{B}_{b}}\frac{\ell(\Psi^{(b)};{\bm{P}}^{n},z^{n})}{\partial{\bm{W}}^{(b)}}({\bm{\mu}}_{j}^{\top},0^{\top})^{\top}=0,</annotation></semantics></math></td>
