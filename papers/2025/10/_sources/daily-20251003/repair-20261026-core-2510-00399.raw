<tr id="A5.E151Xi" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E151Xi.m2" class="ltx_Math" alttext="\displaystyle\gtrsim" display="inline" intent=":literal"><semantics><mo>≳</mo><annotation encoding="application/x-tex">\displaystyle\gtrsim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E151Xi.m3" class="ltx_Math" alttext="\displaystyle-\eta\sqrt{\frac{\log B}{B}}+\eta(\beta^{2}+\frac{\eta^{2}t_{0}^{2}(1-p_{a})^{2}\beta^{2}}{M_{1}^{2}})\mathbb{E}\left[\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(t_{0})})\frac{\kappa_{a}(1-p_{a})}{V}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt></mrow></mrow><mo>+</mo><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>β</mi><mn>2</mn></msup><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>t</mi><mn>0</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><msubsup><mi>M</mi><mn>1</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>l</mi></munderover></mstyle><mrow><msubsup><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>V</mi></mfrac></mstyle></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\eta\sqrt{\frac{\log B}{B}}+\eta(\beta^{2}+\frac{\eta^{2}t_{0}^{2}(1-p_{a})^{2}\beta^{2}}{M_{1}^{2}})\mathbb{E}\left[\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(t_{0})})\frac{\kappa_{a}(1-p_{a})}{V}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E151Xj" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E151Xj.m2" class="ltx_Math" alttext="\displaystyle\geq" display="inline" intent=":literal"><semantics><mo>≥</mo><annotation encoding="application/x-tex">\displaystyle\geq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E151Xj.m3" class="ltx_Math" alttext="\displaystyle-\eta\sqrt{\frac{\log B}{B}}+\eta(\beta^{2}+\frac{\eta^{2}t_{0}^{2}(1-p_{a})^{2}\beta^{2}}{M_{1}^{2}})\frac{\kappa_{a}(1-p_{a})}{V}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt></mrow></mrow><mo>+</mo><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>β</mi><mn>2</mn></msup><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>t</mi><mn>0</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><msubsup><mi>M</mi><mn>1</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>V</mi></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\eta\sqrt{\frac{\log B}{B}}+\eta(\beta^{2}+\frac{\eta^{2}t_{0}^{2}(1-p_{a})^{2}\beta^{2}}{M_{1}^{2}})\frac{\kappa_{a}(1-p_{a})}{V},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p2.12" class="ltx_p">where the fourth step follows the idea of (<a href="#A5.E139" title="In Proof. ‣ E.3 Proof of Lemma ‣ Appendix E Proof of Supportive Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">139</span></a>) since</p>
<table id="A5.E152" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E152.m1" class="ltx_Math" alttext="G^{n}_{i,l+1}({\bm{w}}^{(t_{0})})(l-i+1)\leq\Theta(1)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>l</mi><mo>−</mo><mi>i</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">G^{n}_{i,l+1}({\bm{w}}^{(t_{0})})(l-i+1)\leq\Theta(1),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(152)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p2.13" class="ltx_p">for any <math id="A5.SS3.p2.m22" class="ltx_Math" alttext="i\in[l]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>l</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[l]</annotation></semantics></math> and <math id="A5.SS3.p2.m23" class="ltx_Math" alttext="n\in\mathcal{B}_{b}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow><annotation encoding="application/x-tex">n\in\mathcal{B}_{b}</annotation></semantics></math>. The last step of (<a href="#A5.E151" title="In Proof. ‣ E.3 Proof of Lemma ‣ Appendix E Proof of Supportive Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">151</span></a>) follows from</p>
<table id="A5.E153" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E153X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E153X.m2" class="ltx_Math" alttext="\displaystyle\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(t_{0})})=" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>l</mi></munderover></mstyle><mrow><msubsup><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(t_{0})})=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E153X.m3" class="ltx_Math" alttext="\displaystyle 1-\sigma({{\bm{w}}^{(t_{0})}}^{\top}{\bm{p}}_{query}^{n})-\prod_{i=1}^{l+1}(1-\sigma({{\bm{w}}^{(t_{0})}}^{\top}{\bm{p}}_{i}^{n}))\geq\frac{1}{4}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>n</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>i</mi><mi>n</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≥</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>4</mn></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle 1-\sigma({{\bm{w}}^{(t_{0})}}^{\top}{\bm{p}}_{query}^{n})-\prod_{i=1}^{l+1}(1-\sigma({{\bm{w}}^{(t_{0})}}^{\top}{\bm{p}}_{i}^{n}))\geq\frac{1}{4},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(153)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p2.14" class="ltx_p">since</p>
<table id="A5.E154" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E154.m1" class="ltx_Math" alttext="\sigma({{\bm{w}}^{(t_{0})}}^{\top}{\bm{p}}_{query}^{n})&lt;\sigma(0)=\frac{1}{2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>n</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\sigma({{\bm{w}}^{(t_{0})}}^{\top}{\bm{p}}_{query}^{n})&lt;\sigma(0)=\frac{1}{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(154)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p2.15" class="ltx_p">by (<a href="#A5.E147" title="In Proof. ‣ E.3 Proof of Lemma ‣ Appendix E Proof of Supportive Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">147</span></a>), and with a high probability,</p>
<table id="A5.E155" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E155X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E155X.m2" class="ltx_Math" alttext="\displaystyle\prod_{i=1}^{l+1}(1-\sigma({{\bm{w}}^{(t_{0})}}^{\top}{\bm{p}}_{i}^{n}))\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>i</mi><mi>n</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\prod_{i=1}^{l+1}(1-\sigma({{\bm{w}}^{(t_{0})}}^{\top}{\bm{p}}_{i}^{n}))\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E155X.m3" class="ltx_Math" alttext="\displaystyle\prod_{{\bm{p}}_{i}^{n}\text{ does not contain any }{\bm{v}}^{*}_{s}}(1-\sigma({{\bm{w}}^{(t_{0})}}^{\top}{\bm{p}}_{i}^{n}))" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∏</mo><mrow><msubsup><mi>𝒑</mi><mi>i</mi><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mtext> does not contain any </mtext><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup></mrow></munder></mstyle><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>i</mi><mi>n</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\prod_{{\bm{p}}_{i}^{n}\text{ does not contain any }{\bm{v}}^{*}_{s}}(1-\sigma({{\bm{w}}^{(t_{0})}}^{\top}{\bm{p}}_{i}^{n}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(155)</span></td></tr>
<tr id="A5.E155Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E155Xa.m2" class="ltx_Math" alttext="\displaystyle\lesssim" display="inline" intent=":literal"><semantics><mo>≲</mo><annotation encoding="application/x-tex">\displaystyle\lesssim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E155Xa.m3" class="ltx_Math" alttext="\displaystyle(1-\frac{1}{1+e^{-\frac{V}{\kappa_{a}M_{1}}}})^{l(1-p_{a})}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><msup><mi>e</mi><mrow><mo>−</mo><mfrac><mi>V</mi><mrow><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub></mrow></mfrac></mrow></msup></mrow></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>l</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><annotation encoding="application/x-tex">\displaystyle(1-\frac{1}{1+e^{-\frac{V}{\kappa_{a}M_{1}}}})^{l(1-p_{a})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E155Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E155Xb.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E155Xb.m3" class="ltx_Math" alttext="\displaystyle\frac{1}{4}," display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>4</mn></mfrac></mstyle><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{4},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p2.16" class="ltx_p">where the last step holds if</p>
<table id="A5.E156" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E156.m1" class="ltx_Math" alttext="l\gtrsim(1-p_{a})^{-1}\log M_{1}." display="block" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>≳</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>M</mi><mn>1</mn></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">l\gtrsim(1-p_{a})^{-1}\log M_{1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(156)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p2.17" class="ltx_p">The second step of (<a href="#A5.E155" title="In Proof. ‣ E.3 Proof of Lemma ‣ Appendix E Proof of Supportive Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">155</span></a>) comes from (<a href="#A5.E147" title="In Proof. ‣ E.3 Proof of Lemma ‣ Appendix E Proof of Supportive Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">147</span></a>) and</p>
<table id="A5.E157" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E157.m1" class="ltx_Math" alttext="\Pr\Big(\Big|\frac{1}{l}\sum_{i=1}^{l}\mathbbm{1}[{\bm{p}}_{i}^{n}\text{ does not contain }{\bm{v}}^{*}_{s}]-(1-p_{a})\Big|\geq c\cdot(1-p_{a})\Big)\lesssim e^{-l(1-p_{a})c^{2}}\leq M_{1}^{-C}" display="block" intent=":literal"><semantics><mrow><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mrow><mfrac><mn>1</mn><mi>l</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>l</mi></munderover><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝒑</mi><mi>i</mi><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mtext> does not contain </mtext><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow><mo>≥</mo><mrow><mi>c</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>≲</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mrow><mi>l</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>c</mi><mn>2</mn></msup></mrow></mrow></msup><mo>≤</mo><msubsup><mi>M</mi><mn>1</mn><mrow><mo>−</mo><mi>C</mi></mrow></msubsup></mrow><annotation encoding="application/x-tex">\Pr\Big(\Big|\frac{1}{l}\sum_{i=1}^{l}\mathbbm{1}[{\bm{p}}_{i}^{n}\text{ does not contain }{\bm{v}}^{*}_{s}]-(1-p_{a})\Big|\geq c\cdot(1-p_{a})\Big)\lesssim e^{-l(1-p_{a})c^{2}}\leq M_{1}^{-C}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(157)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p2.18" class="ltx_p">by Lemma <a href="#Thmlemma1" title="Lemma 1. ‣ Appendix C Key Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> for some <math id="A5.SS3.p2.m24" class="ltx_Math" alttext="c\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">c\in(0,1)</annotation></semantics></math>, <math id="A5.SS3.p2.m25" class="ltx_Math" alttext="C&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">C&gt;1</annotation></semantics></math>, and</p>
<table id="A5.E158" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E158.m1" class="ltx_Math" alttext="l\geq(1-p_{a})^{-1}\log M_{1}." display="block" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>≥</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>M</mi><mn>1</mn></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">l\geq(1-p_{a})^{-1}\log M_{1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(158)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p2.19" class="ltx_p">Then, by plugging (<a href="#A5.E151" title="In Proof. ‣ E.3 Proof of Lemma ‣ Appendix E Proof of Supportive Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">151</span></a>) into (<a href="#A5.E149" title="In Proof. ‣ E.3 Proof of Lemma ‣ Appendix E Proof of Supportive Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">149</span></a>), we have</p>
<table id="A5.E159" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E159X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E159X.m2" class="ltx_Math" alttext="\displaystyle{{\displaystyle\bm{v}}^{*}_{s}}^{\top}{\bm{w}}^{(t_{0}+1)}" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mi>𝒗</mi><mi>s</mi><mo>∗</mo><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle{{\displaystyle\bm{v}}^{*}_{s}}^{\top}{\bm{w}}^{(t_{0}+1)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="5" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(159)</span></td></tr>
<tr id="A5.E159Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E159Xa.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E159Xa.m3" class="ltx_Math" alttext="\displaystyle-\frac{\eta\beta^{2}t_{0}\kappa_{a}(1-p_{a})}{V}-\eta\sum_{i=1}^{t_{0}-1}i^{2}(\frac{\eta^{2}(1-p_{a})^{3}\beta^{2}}{M_{1}^{2}})\frac{\kappa_{a}}{V}+\eta\sqrt{\frac{\log B}{B}}-\eta(\beta^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>V</mi></mfrac></mstyle></mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>i</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><msubsup><mi>M</mi><mn>1</mn><mn>2</mn></msubsup></mfrac></mstyle><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi>κ</mi><mi>a</mi></msub><mi>V</mi></mfrac></mstyle></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt></mrow></mrow><mo>−</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>β</mi><mn>2</mn></msup><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{\eta\beta^{2}t_{0}\kappa_{a}(1-p_{a})}{V}-\eta\sum_{i=1}^{t_{0}-1}i^{2}(\frac{\eta^{2}(1-p_{a})^{3}\beta^{2}}{M_{1}^{2}})\frac{\kappa_{a}}{V}+\eta\sqrt{\frac{\log B}{B}}-\eta(\beta^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E159Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E159Xb.m2" class="ltx_Math" alttext="\displaystyle+\frac{\eta^{2}t_{0}^{2}(1-p_{a})^{2}\beta^{2}}{M_{1}^{2}})\cdot\frac{\kappa_{a}(1-p_{a})}{V}" display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>t</mi><mn>0</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><msubsup><mi>M</mi><mn>1</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>V</mi></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{\eta^{2}t_{0}^{2}(1-p_{a})^{2}\beta^{2}}{M_{1}^{2}})\cdot\frac{\kappa_{a}(1-p_{a})}{V}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E159Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E159Xc.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E159Xc.m3" class="ltx_Math" alttext="\displaystyle-\frac{\eta\beta^{2}(t_{0}+1)\kappa_{a}(1-p_{a})}{V}-\eta\sum_{i=1}^{t_{0}}i^{2}(\frac{\eta^{2}(1-p_{a})^{3}\beta^{2}}{M_{1}^{2}})\frac{\kappa_{a}}{V}+\eta\sqrt{\frac{\log B}{B}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>V</mi></mfrac></mstyle></mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>t</mi><mn>0</mn></msub></munderover></mstyle><mrow><msup><mi>i</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><msubsup><mi>M</mi><mn>1</mn><mn>2</mn></msubsup></mfrac></mstyle><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi>κ</mi><mi>a</mi></msub><mi>V</mi></mfrac></mstyle></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{\eta\beta^{2}(t_{0}+1)\kappa_{a}(1-p_{a})}{V}-\eta\sum_{i=1}^{t_{0}}i^{2}(\frac{\eta^{2}(1-p_{a})^{3}\beta^{2}}{M_{1}^{2}})\frac{\kappa_{a}}{V}+\eta\sqrt{\frac{\log B}{B}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E159Xd" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E159Xd.m2" class="ltx_Math" alttext="\displaystyle\lesssim" display="inline" intent=":literal"><semantics><mo>≲</mo><annotation encoding="application/x-tex">\displaystyle\lesssim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E159Xd.m3" class="ltx_Math" alttext="\displaystyle-\frac{\eta\beta^{2}(t_{0}+1)\kappa_{a}(1-p_{a})}{V}-\eta\sum_{i=1}^{t_{0}}i^{2}(\frac{\eta^{2}(1-p_{a})^{3}\beta^{2}}{M_{1}^{2}})\frac{\kappa_{a}}{V}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>V</mi></mfrac></mstyle></mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>t</mi><mn>0</mn></msub></munderover></mstyle><mrow><msup><mi>i</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><msubsup><mi>M</mi><mn>1</mn><mn>2</mn></msubsup></mfrac></mstyle><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi>κ</mi><mi>a</mi></msub><mi>V</mi></mfrac></mstyle></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{\eta\beta^{2}(t_{0}+1)\kappa_{a}(1-p_{a})}{V}-\eta\sum_{i=1}^{t_{0}}i^{2}(\frac{\eta^{2}(1-p_{a})^{3}\beta^{2}}{M_{1}^{2}})\frac{\kappa_{a}}{V},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p2.20" class="ltx_p">where the last step holds given (<a href="#A5.E141" title="In Proof. ‣ E.3 Proof of Lemma ‣ Appendix E Proof of Supportive Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">141</span></a>) and <math id="A5.SS3.p2.m26" class="ltx_Math" alttext="t_{0}\lesssim\min\{\eta^{-1}\beta^{-2}\kappa_{a}^{-1}(1-p_{a})^{-1}V,\eta^{-1}M_{1}^{\frac{2}{3}}\beta^{-\frac{2}{3}}\kappa_{a}^{-\frac{1}{3}}(1-p_{a})^{-1}V^{\frac{1}{3}}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>≲</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>,</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mn>1</mn><mfrac><mn>2</mn><mn>3</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mfrac><mn>2</mn><mn>3</mn></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mfrac><mn>1</mn><mn>3</mn></mfrac></msup></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t_{0}\lesssim\min\{\eta^{-1}\beta^{-2}\kappa_{a}^{-1}(1-p_{a})^{-1}V,\eta^{-1}M_{1}^{\frac{2}{3}}\beta^{-\frac{2}{3}}\kappa_{a}^{-\frac{1}{3}}(1-p_{a})^{-1}V^{\frac{1}{3}}\}</annotation></semantics></math>. We can also derive that for any <math id="A5.SS3.p2.m27" class="ltx_Math" alttext="j\in[M_{1}]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[M_{1}]</annotation></semantics></math>,</p>
