<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E142Xb.m2" class="ltx_Math" alttext="\displaystyle\cdot({\bm{\mu}}_{j}^{\top},0^{\top}){\bm{p}}_{s}^{n}-(1-\sigma({{\bm{w}}^{(0)}}^{\top}{\bm{p}}_{i}^{n}))({\bm{\mu}}_{j}^{\top},0^{\top}){\bm{p}}_{i}^{n})" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.222em">⋅</mo><mo stretchy="false">(</mo><mi>𝝁</mi><msub><mrow></mrow><mi>j</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><mi>𝒑</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mi>n</mi></msup><mo>−</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>σ</mi><mo stretchy="false">(</mo><mi>𝒘</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝒑</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mi>n</mi></msup><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mi>𝝁</mi><msub><mrow></mrow><mi>j</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>,</mo><mn>0</mn><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><mi>𝒑</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mi>n</mi></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\cdot({\bm{\mu}}_{j}^{\top},0^{\top}){\bm{p}}_{s}^{n}-(1-\sigma({{\bm{w}}^{(0)}}^{\top}{\bm{p}}_{i}^{n}))({\bm{\mu}}_{j}^{\top},0^{\top}){\bm{p}}_{i}^{n})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E142Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
