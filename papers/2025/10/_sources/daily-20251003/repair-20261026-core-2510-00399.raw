<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E143Xa.m2" class="ltx_Math" alttext="\displaystyle-(1-p_{a})\mathbb{E}[\frac{1}{l|\mathcal{B}_{1}|}\sum_{n\in\mathcal{B}_{1}}\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(0)})\sum_{s=i+1}^{l+1}\sigma({{\bm{w}}^{(0)}}^{\top}{\bm{p}}_{s}^{n})]\Big|" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>p</mi><msub><mrow></mrow><mi>a</mi></msub><mo stretchy="false">)</mo><mi>𝔼</mi><mo stretchy="false">[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mn>1</mn></msub></mrow></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>l</mi></msup><mi>G</mi><msup><mrow></mrow><mi>n</mi></msup><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">(</mo><mi>𝒘</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo rspace="0.167em" stretchy="false">)</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>s</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup><mi>σ</mi><mo stretchy="false">(</mo><mi>𝒘</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝒑</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mi>n</mi></msup><mo stretchy="false">)</mo><mo stretchy="false">]</mo><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle-(1-p_{a})\mathbb{E}[\frac{1}{l|\mathcal{B}_{1}|}\sum_{n\in\mathcal{B}_{1}}\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(0)})\sum_{s=i+1}^{l+1}\sigma({{\bm{w}}^{(0)}}^{\top}{\bm{p}}_{s}^{n})]\Big|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E143Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E143Xb.m2" class="ltx_Math" alttext="\displaystyle\geq c\cdot(1-p_{a})\mathbb{E}[\frac{1}{l|\mathcal{B}_{1}|}\sum_{n\in\mathcal{B}_{1}}\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(0)})\sum_{s=i+1}^{l+1}\sigma({{\bm{w}}^{(0)}}^{\top}{\bm{p}}_{s}^{n})]\Big)" display="inline" intent=":literal"><semantics><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mphantom></mphantom><mo>≥</mo><mrow><mrow><mi>c</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mn>1</mn></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>l</mi></munderover></mstyle><mrow><msubsup><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>s</mi><mi>n</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq c\cdot(1-p_{a})\mathbb{E}[\frac{1}{l|\mathcal{B}_{1}|}\sum_{n\in\mathcal{B}_{1}}\sum_{i=1}^{l}G^{n}_{i,l+1}({\bm{w}}^{(0)})\sum_{s=i+1}^{l+1}\sigma({{\bm{w}}^{(0)}}^{\top}{\bm{p}}_{s}^{n})]\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E143Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E143Xc.m2" class="ltx_Math" alttext="\displaystyle\lesssim" display="inline" intent=":literal"><semantics><mo>≲</mo><annotation encoding="application/x-tex">\displaystyle\lesssim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E143Xc.m3" class="ltx_Math" alttext="\displaystyle e^{-lB(1-p_{a})^{2}c^{2}}" display="inline" intent=":literal"><semantics><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>c</mi><mn>2</mn></msup></mrow></mrow></msup><annotation encoding="application/x-tex">\displaystyle e^{-lB(1-p_{a})^{2}c^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E143Xd" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E143Xd.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E143Xd.m3" class="ltx_Math" alttext="\displaystyle M_{1}^{-C}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mn>1</mn><mrow><mo>−</mo><mi>C</mi></mrow></msubsup><annotation encoding="application/x-tex">\displaystyle M_{1}^{-C}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p1.13" class="ltx_p"><span id="A5.SS3.p1.13.1" class="ltx_text">for some <math id="A5.SS3.p1.m17" class="ltx_Math" alttext="c\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">c\in(0,1)</annotation></semantics></math>, <math id="A5.SS3.p1.m18" class="ltx_Math" alttext="C&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">C&gt;1</annotation></semantics></math>, and</span></p>
<table id="A5.E144" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E144.m1" class="ltx_Math" alttext="Bl\geq(1-p_{a})^{-2}\log\epsilon^{-1}" display="block" intent=":literal"><semantics><mrow><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>≥</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">Bl\geq(1-p_{a})^{-2}\log\epsilon^{-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(144)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p1.14" class="ltx_p"><span id="A5.SS3.p1.14.1" class="ltx_text">by Lemma <a href="#Thmlemma2" title="Lemma 2. ‣ Appendix C Key Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> since <math id="A5.SS3.p1.m19" class="ltx_Math" alttext="{\bm{p}}_{i}^{n}" display="inline" intent=":literal"><semantics><msubsup><mi>𝒑</mi><mi>i</mi><mi>n</mi></msubsup><annotation encoding="application/x-tex">{\bm{p}}_{i}^{n}</annotation></semantics></math> does not contain any <math id="A5.SS3.p1.m20" class="ltx_Math" alttext="{\bm{v}}^{*}_{s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">{\bm{v}}^{*}_{s}</annotation></semantics></math> with a probability of <math id="A5.SS3.p1.m21" class="ltx_Math" alttext="1-p_{a}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><annotation encoding="application/x-tex">1-p_{a}</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS3.p2" class="ltx_para ltx_noindent">
<p id="A5.SS3.p2.5" class="ltx_p">The last step of (<a href="#A5.E142" title="In Proof. ‣ E.3 Proof of Lemma ‣ Appendix E Proof of Supportive Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">142</span></a>) holds if <math id="A5.SS3.p2.m1" class="ltx_Math" alttext="B\gtrsim\beta^{-4}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>≳</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">B\gtrsim\beta^{-4}</annotation></semantics></math> and <math id="A5.SS3.p2.m2" class="ltx_Math" alttext="\xi\lesssim\frac{1}{M_{1}}" display="inline" intent=":literal"><semantics><mrow><mi>ξ</mi><mo>≲</mo><mfrac><mn>1</mn><msub><mi>M</mi><mn>1</mn></msub></mfrac></mrow><annotation encoding="application/x-tex">\xi\lesssim\frac{1}{M_{1}}</annotation></semantics></math>. Similarly, we also have</p>
<table id="A5.E145" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E145X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E145X.m2" class="ltx_Math" alttext="\displaystyle({\bm{\mu}}_{j}^{\top},0^{\top}){\bm{w}}^{(1)}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>j</mi><mo>⊤</mo></msubsup><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle({\bm{\mu}}_{j}^{\top},0^{\top}){\bm{w}}^{(1)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(145)</span></td></tr>
<tr id="A5.E145Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E145Xa.m2" class="ltx_Math" alttext="\displaystyle\geq" display="inline" intent=":literal"><semantics><mo>≥</mo><annotation encoding="application/x-tex">\displaystyle\geq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E145Xa.m3" class="ltx_Math" alttext="\displaystyle-\xi-\frac{\eta}{M_{1}}\sqrt{\frac{\log B}{B}}-\frac{\eta\beta^{2}}{|\mathcal{B}_{1}|}\sum_{n\in\mathcal{B}_{b}}\sum_{1\leq i\leq l,{\bm{p}}_{i}^{n}\text{ does not contain any }{\bm{v}}^{*}_{s}}^{l}G^{n}_{i,l+1}({\bm{w}}^{(0)})" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mi>ξ</mi></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>η</mi><msub><mi>M</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>l</mi></mrow><mo>,</mo><mrow><msubsup><mi>𝒑</mi><mi>i</mi><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mtext> does not contain any </mtext><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup></mrow></mrow><mi>l</mi></munderover></mstyle><mrow><msubsup><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\xi-\frac{\eta}{M_{1}}\sqrt{\frac{\log B}{B}}-\frac{\eta\beta^{2}}{|\mathcal{B}_{1}|}\sum_{n\in\mathcal{B}_{b}}\sum_{1\leq i\leq l,{\bm{p}}_{i}^{n}\text{ does not contain any }{\bm{v}}^{*}_{s}}^{l}G^{n}_{i,l+1}({\bm{w}}^{(0)})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E145Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E145Xb.m2" class="ltx_Math" alttext="\displaystyle\cdot(\sum_{s=i+1}^{l+1}\sigma({{\bm{w}}^{(0)}}^{\top}{\bm{p}}_{s}^{n})({\bm{\mu}}_{j}^{\top},0^{\top}){\bm{p}}_{s}^{n}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>s</mi><mi>n</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝁</mi><mi>j</mi><mo>⊤</mo></msubsup><mo mathsize="0.700em">,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>s</mi><mi>n</mi></msubsup></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\cdot(\sum_{s=i+1}^{l+1}\sigma({{\bm{w}}^{(0)}}^{\top}{\bm{p}}_{s}^{n})({\bm{\mu}}_{j}^{\top},0^{\top}){\bm{p}}_{s}^{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E145Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E145Xc.m2" class="ltx_Math" alttext="\displaystyle\gtrsim" display="inline" intent=":literal"><semantics><mo>≳</mo><annotation encoding="application/x-tex">\displaystyle\gtrsim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E145Xc.m3" class="ltx_Math" alttext="\displaystyle-\frac{\eta(1-p_{a})\beta^{2}}{M_{1}}." display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><msub><mi>M</mi><mn>1</mn></msub></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{\eta(1-p_{a})\beta^{2}}{M_{1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p2.6" class="ltx_p">Hence, the conclusion holds when <math id="A5.SS3.p2.m3" class="ltx_Math" alttext="t=1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=1</annotation></semantics></math>. Meanwhile, for any <math id="A5.SS3.p2.m4" class="ltx_Math" alttext="k\in[M_{2}]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mn>2</mn></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k\in[M_{2}]</annotation></semantics></math>,</p>
<table id="A5.E146" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E146X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E146X.m2" class="ltx_Math" alttext="\displaystyle({\bm{\nu}}_{k}^{\top},0^{\top}){\bm{w}}^{(1)}\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>𝝂</mi><mi>k</mi><mo>⊤</mo></msubsup><mo>,</mo><msup><mn>0</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle({\bm{\nu}}_{k}^{\top},0^{\top}){\bm{w}}^{(1)}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E146X.m3" class="ltx_Math" alttext="\displaystyle\xi+\frac{\eta}{M_{2}}\sqrt{\frac{\log B}{B}}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>ξ</mi><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>η</mi><msub><mi>M</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\xi+\frac{\eta}{M_{2}}\sqrt{\frac{\log B}{B}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(146)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p2.7" class="ltx_p">Suppose that the conclusion holds when <math id="A5.SS3.p2.m5" class="ltx_Math" alttext="t=t_{0}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><msub><mi>t</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">t=t_{0}</annotation></semantics></math> for <math id="A5.SS3.p2.m6" class="ltx_Math" alttext="t_{0}\lesssim\min\{\eta^{-1}\beta^{-2}\kappa_{a}^{-1}(1-p_{a})^{-1}V,\eta^{-1}M_{1}^{\frac{2}{3}}\beta^{-\frac{2}{3}}\kappa_{a}^{-\frac{1}{3}}(1-p_{a})^{-1}V^{\frac{1}{3}}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>≲</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>,</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mn>1</mn><mfrac><mn>2</mn><mn>3</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><mo>−</mo><mfrac><mn>2</mn><mn>3</mn></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>a</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mfrac><mn>1</mn><mn>3</mn></mfrac></msup></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t_{0}\lesssim\min\{\eta^{-1}\beta^{-2}\kappa_{a}^{-1}(1-p_{a})^{-1}V,\eta^{-1}M_{1}^{\frac{2}{3}}\beta^{-\frac{2}{3}}\kappa_{a}^{-\frac{1}{3}}(1-p_{a})^{-1}V^{\frac{1}{3}}\}</annotation></semantics></math>. Then, when <math id="A5.SS3.p2.m7" class="ltx_Math" alttext="t=t_{0}+1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">t=t_{0}+1</annotation></semantics></math>, we have that for <math id="A5.SS3.p2.m8" class="ltx_Math" alttext="{\bm{p}}_{s}^{n}" display="inline" intent=":literal"><semantics><msubsup><mi>𝒑</mi><mi>s</mi><mi>n</mi></msubsup><annotation encoding="application/x-tex">{\bm{p}}_{s}^{n}</annotation></semantics></math> that does not contain any <math id="A5.SS3.p2.m9" class="ltx_Math" alttext="{\bm{v}}^{*}_{s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">{\bm{v}}^{*}_{s}</annotation></semantics></math>, <math id="A5.SS3.p2.m10" class="ltx_Math" alttext="s\in[V]" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>V</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">s\in[V]</annotation></semantics></math></p>
<table id="A5.E147" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E147.m1" class="ltx_Math" alttext="-\frac{\eta(1-p_{a})\beta^{2}t_{0}}{M_{1}}-\sum_{i=1}^{t_{0}}i^{2}\cdot(\frac{\eta^{3}(1-p_{a})^{3}\beta^{2}}{M_{1}^{3}})\lesssim{{\bm{w}}^{(t_{0})}}^{\top}{\bm{p}}_{s}^{n}\lesssim t_{0}\cdot(-\frac{\eta\beta^{2}}{M_{1}}+\frac{\eta}{M_{2}}\sqrt{\frac{\log B}{B}}+\xi)&lt;0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>−</mo><mfrac><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mn>0</mn></msub></mrow><msub><mi>M</mi><mn>1</mn></msub></mfrac></mrow><mo rspace="0.055em">−</mo><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>t</mi><mn>0</mn></msub></munderover><msup><mi>i</mi><mn>2</mn></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mfrac><mrow><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><msubsup><mi>M</mi><mn>1</mn><mn>3</mn></msubsup></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≲</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>s</mi><mi>n</mi></msubsup></mrow><mo>≲</mo><mrow><msub><mi>t</mi><mn>0</mn></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo>−</mo><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><msub><mi>M</mi><mn>1</mn></msub></mfrac></mrow><mo>+</mo><mrow><mfrac><mi>η</mi><msub><mi>M</mi><mn>2</mn></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></msqrt></mrow><mo>+</mo><mi>ξ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">-\frac{\eta(1-p_{a})\beta^{2}t_{0}}{M_{1}}-\sum_{i=1}^{t_{0}}i^{2}\cdot(\frac{\eta^{3}(1-p_{a})^{3}\beta^{2}}{M_{1}^{3}})\lesssim{{\bm{w}}^{(t_{0})}}^{\top}{\bm{p}}_{s}^{n}\lesssim t_{0}\cdot(-\frac{\eta\beta^{2}}{M_{1}}+\frac{\eta}{M_{2}}\sqrt{\frac{\log B}{B}}+\xi)&lt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(147)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p2.8" class="ltx_p">For another <math id="A5.SS3.p2.m11" class="ltx_Math" alttext="{\bm{p}}_{r}^{n}" display="inline" intent=":literal"><semantics><msubsup><mi>𝒑</mi><mi>r</mi><mi>n</mi></msubsup><annotation encoding="application/x-tex">{\bm{p}}_{r}^{n}</annotation></semantics></math>, <math id="A5.SS3.p2.m12" class="ltx_Math" alttext="r\neq s" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>≠</mo><mi>s</mi></mrow><annotation encoding="application/x-tex">r\neq s</annotation></semantics></math>, that contains a <math id="A5.SS3.p2.m13" class="ltx_Math" alttext="{\bm{v}}^{*}_{s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">{\bm{v}}^{*}_{s}</annotation></semantics></math>, <math id="A5.SS3.p2.m14" class="ltx_Math" alttext="s\in[V]" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>V</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">s\in[V]</annotation></semantics></math>,</p>
<table id="A5.E148" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E148.m1" class="ltx_Math" alttext="{{\bm{w}}^{(t_{0})}}^{\top}{\bm{p}}_{r}^{n}\lesssim t_{0}\cdot(0-\eta\beta^{2}\kappa_{a}(1-p_{a}))&lt;{{\bm{w}}^{(t_{0})}}^{\top}{\bm{p}}_{s}^{n}&lt;0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>r</mi><mi>n</mi></msubsup></mrow><mo>≲</mo><mrow><msub><mi>t</mi><mn>0</mn></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mn>0</mn><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>s</mi><mi>n</mi></msubsup></mrow><mo>&lt;</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{{\bm{w}}^{(t_{0})}}^{\top}{\bm{p}}_{r}^{n}\lesssim t_{0}\cdot(0-\eta\beta^{2}\kappa_{a}(1-p_{a}))&lt;{{\bm{w}}^{(t_{0})}}^{\top}{\bm{p}}_{s}^{n}&lt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(148)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p2.9" class="ltx_p">Then, with a high probability, we have for any <math id="A5.SS3.p2.m15" class="ltx_Math" alttext="s\in[V]" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>V</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">s\in[V]</annotation></semantics></math>,</p>
<table id="A5.E149" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E149X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E149X.m2" class="ltx_Math" alttext="\displaystyle{{\displaystyle\bm{v}}^{*}_{s}}^{\top}{\bm{w}}^{(t)}" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mi>𝒗</mi><mi>s</mi><mo>∗</mo><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle{{\displaystyle\bm{v}}^{*}_{s}}^{\top}{\bm{w}}^{(t)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(149)</span></td></tr>
<tr id="A5.E149Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E149Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E149Xa.m3" class="ltx_Math" alttext="\displaystyle{{\displaystyle\bm{v}}^{*}_{s}}^{\top}({\bm{w}}^{(t-1)}-\eta\frac{\partial\ell(\Psi;{\bm{P}}^{n},z^{n})}{\partial{\bm{w}}})" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mi>𝒗</mi><mi>s</mi><mo>∗</mo><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo>,</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo>,</mo><msup><mi>z</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mi>𝒘</mi></mrow></mfrac></mstyle></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{{\displaystyle\bm{v}}^{*}_{s}}^{\top}({\bm{w}}^{(t-1)}-\eta\frac{\partial\ell(\Psi;{\bm{P}}^{n},z^{n})}{\partial{\bm{w}}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E149Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E149Xb.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E149Xb.m3" class="ltx_Math" alttext="\displaystyle-\eta\beta^{2}t_{0}\kappa_{a}(1-p_{a})-\eta\sum_{i=1}^{t_{0}-1}i^{2}(\frac{\eta^{2}(1-p_{a})^{3}\beta^{2}}{M_{1}^{2}})\kappa_{a}-\eta\frac{z^{n}}{|\mathcal{B}_{1}|}\sum_{n\in\mathcal{B}_{b}}\sum_{i=1}^{l}y_{i}^{n}(\beta^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>i</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><msubsup><mi>M</mi><mn>1</mn><mn>2</mn></msubsup></mfrac></mstyle><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>a</mi></msub></mrow></mrow></mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>z</mi><mi>n</mi></msup><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>l</mi></munderover></mstyle><mrow><msubsup><mi>y</mi><mi>i</mi><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>β</mi><mn>2</mn></msup><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\eta\beta^{2}t_{0}\kappa_{a}(1-p_{a})-\eta\sum_{i=1}^{t_{0}-1}i^{2}(\frac{\eta^{2}(1-p_{a})^{3}\beta^{2}}{M_{1}^{2}})\kappa_{a}-\eta\frac{z^{n}}{|\mathcal{B}_{1}|}\sum_{n\in\mathcal{B}_{b}}\sum_{i=1}^{l}y_{i}^{n}(\beta^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E149Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E149Xc.m2" class="ltx_Math" alttext="\displaystyle+\frac{\eta^{2}t_{0}^{2}(1-p_{a})^{2}\beta^{2}}{M_{1}^{2}})G^{n}_{i,l+1}({\bm{w}}^{(t_{0})})(\sum_{s=i+1}^{l+1}\sigma({{\bm{w}}^{(t_{0})}}^{\top}{\bm{p}}_{s}^{n}){{\bm{v}}^{*}_{s}}^{\top}{\bm{p}}_{s}^{n}-(1-\sigma({{\bm{w}}^{(t_{0})}}^{\top}{\bm{p}}_{i}^{n})){{\bm{v}}^{*}_{s}}^{\top}{\bm{p}}_{i}^{n})," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>t</mi><mn>0</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><msubsup><mi>M</mi><mn>1</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>s</mi><mi>n</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝒗</mi><mi>s</mi><mo>∗</mo><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>s</mi><mi>n</mi></msubsup></mrow></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>i</mi><mi>n</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝒗</mi><mi>s</mi><mo>∗</mo><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>i</mi><mi>n</mi></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{\eta^{2}t_{0}^{2}(1-p_{a})^{2}\beta^{2}}{M_{1}^{2}})G^{n}_{i,l+1}({\bm{w}}^{(t_{0})})(\sum_{s=i+1}^{l+1}\sigma({{\bm{w}}^{(t_{0})}}^{\top}{\bm{p}}_{s}^{n}){{\bm{v}}^{*}_{s}}^{\top}{\bm{p}}_{s}^{n}-(1-\sigma({{\bm{w}}^{(t_{0})}}^{\top}{\bm{p}}_{i}^{n})){{\bm{v}}^{*}_{s}}^{\top}{\bm{p}}_{i}^{n}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p2.10" class="ltx_p">where the last step is by (<a href="#A5.E110" title="In Proof. ‣ E.2 Proof of Lemma ‣ Appendix E Proof of Supportive Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">110</span></a>) and (<a href="#A5.E127" title="In Proof. ‣ E.2 Proof of Lemma ‣ Appendix E Proof of Supportive Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">127</span></a>).
Following our proof idea in the case of <math id="A5.SS3.p2.m16" class="ltx_Math" alttext="t=1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=1</annotation></semantics></math>, we have that for <math id="A5.SS3.p2.m17" class="ltx_Math" alttext="{\bm{p}}_{i}^{n}" display="inline" intent=":literal"><semantics><msubsup><mi>𝒑</mi><mi>i</mi><mi>n</mi></msubsup><annotation encoding="application/x-tex">{\bm{p}}_{i}^{n}</annotation></semantics></math> that contains a <math id="A5.SS3.p2.m18" class="ltx_Math" alttext="{\bm{v}}^{*}_{s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">{\bm{v}}^{*}_{s}</annotation></semantics></math>, <math id="A5.SS3.p2.m19" class="ltx_Math" alttext="s\in[V]" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>V</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">s\in[V]</annotation></semantics></math>, the corresponding <math id="A5.SS3.p2.m20" class="ltx_Math" alttext="y_{i}^{n}" display="inline" intent=":literal"><semantics><msubsup><mi>y</mi><mi>i</mi><mi>n</mi></msubsup><annotation encoding="application/x-tex">y_{i}^{n}</annotation></semantics></math> has a probability of <math id="A5.SS3.p2.m21" class="ltx_Math" alttext="1/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">1/2</annotation></semantics></math> to be both binary labels. Then, by Hoeffding’ bound (<a href="#A3.E22" title="In Lemma 2. ‣ Appendix C Key Lemmas ‣ Can Mamba Learn In Context with Outliers? A Theoretical Generalization Analysis" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>), we have</p>
<table id="A5.E150" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E150X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E150X.m2" class="ltx_Math" alttext="\displaystyle\Big\|\frac{\eta}{|\mathcal{B}_{1}|}\sum_{n\in\mathcal{B}_{1}}z^{n}\sum_{1\leq i\leq l,{\bm{p}}_{i}^{n}\text{ contains }{\bm{v}}^{*}_{s}}y_{i}^{n}{{\bm{p}}_{i}^{n}}^{\top}{{\bm{W}}_{B}^{(t_{0})}}^{\top}{\bm{W}}_{C}^{(t_{0})}{\bm{p}}_{query}^{n}G^{n}_{i,l+1}({\bm{w}}^{(t_{0})})" display="inline" intent=":literal"><semantics><mrow><mo mathsize="1.600em" rspace="0.167em">∥</mo><mstyle displaystyle="true"><mfrac><mi>η</mi><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mn>1</mn></msub></mrow></msub><mi>z</mi><msup><mrow></mrow><mi>n</mi></msup><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>l</mi></mrow><mo>,</mo><mrow><msubsup><mi>𝒑</mi><mi>i</mi><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mtext> contains </mtext><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒗</mi><mi>s</mi><mo>∗</mo></msubsup></mrow></mrow></msub><mi>y</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mi>n</mi></msup><mi>𝒑</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mi>n</mi></msup><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝑾</mi><msub><mrow></mrow><mi>B</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msup><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝑾</mi><msub><mrow></mrow><mi>C</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msup><mi>𝒑</mi><msub><mrow></mrow><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub><msup><mrow></mrow><mi>n</mi></msup><mi>G</mi><msup><mrow></mrow><mi>n</mi></msup><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">(</mo><mi>𝒘</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big\|\frac{\eta}{|\mathcal{B}_{1}|}\sum_{n\in\mathcal{B}_{1}}z^{n}\sum_{1\leq i\leq l,{\bm{p}}_{i}^{n}\text{ contains }{\bm{v}}^{*}_{s}}y_{i}^{n}{{\bm{p}}_{i}^{n}}^{\top}{{\bm{W}}_{B}^{(t_{0})}}^{\top}{\bm{W}}_{C}^{(t_{0})}{\bm{p}}_{query}^{n}G^{n}_{i,l+1}({\bm{w}}^{(t_{0})})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(150)</span></td></tr>
<tr id="A5.E150Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E150Xa.m2" class="ltx_Math" alttext="\displaystyle\cdot(\sum_{s=i+1}^{l+1}\sigma({{\bm{w}}^{(t_{0})}}^{\top}{\bm{p}}_{s}^{n}){\bm{p}}_{s}^{n}-(1-\sigma({{\bm{w}}^{(t_{0})}}^{\top}{\bm{p}}_{i}^{n})){\bm{p}}_{i}^{n})\Big\|" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.222em">⋅</mo><mo stretchy="false">(</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>s</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup><mi>σ</mi><mo stretchy="false">(</mo><mi>𝒘</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msup><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝒑</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mi>n</mi></msup><mo stretchy="false">)</mo><mi>𝒑</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mi>n</mi></msup><mo>−</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>σ</mi><mo stretchy="false">(</mo><mi>𝒘</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msup><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝒑</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mi>n</mi></msup><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mi>𝒑</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mi>n</mi></msup><mo stretchy="false">)</mo><mo lspace="0em" mathsize="1.600em">∥</mo></mrow><annotation encoding="application/x-tex">\displaystyle\cdot(\sum_{s=i+1}^{l+1}\sigma({{\bm{w}}^{(t_{0})}}^{\top}{\bm{p}}_{s}^{n}){\bm{p}}_{s}^{n}-(1-\sigma({{\bm{w}}^{(t_{0})}}^{\top}{\bm{p}}_{i}^{n})){\bm{p}}_{i}^{n})\Big\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E150Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E150Xb.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E150Xb.m3" class="ltx_Math" alttext="\displaystyle\eta\sqrt{\frac{\log B}{B}}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow><mi>B</mi></mfrac></mstyle></msqrt></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\eta\sqrt{\frac{\log B}{B}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p2.11" class="ltx_p">Then, with a high probability,</p>
<table id="A5.E151" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E151X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E151X.m2" class="ltx_Math" alttext="\displaystyle\eta\frac{z^{n}}{|\mathcal{B}_{1}|}\sum_{n\in\mathcal{B}_{b}}\sum_{i=1}^{l}y_{i}^{n}(\beta^{2}+\frac{\eta^{2}t_{0}^{2}(1-p_{a})^{2}\beta^{2}}{M_{1}^{2}})G^{n}_{i,l+1}({\bm{w}}^{(t_{0})})(\sum_{s=i+1}^{l+1}\sigma({{\bm{w}}^{(t_{0})}}^{\top}{\bm{p}}_{s}^{n}){{\bm{v}}^{*}_{s}}^{\top}{\bm{p}}_{s}^{n}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>z</mi><mi>n</mi></msup><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>b</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>l</mi></munderover></mstyle><mrow><msubsup><mi>y</mi><mi>i</mi><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>β</mi><mn>2</mn></msup><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>t</mi><mn>0</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><msubsup><mi>M</mi><mn>1</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>G</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝒘</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>s</mi><mi>n</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝒗</mi><mi>s</mi><mo>∗</mo><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mi>s</mi><mi>n</mi></msubsup></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\eta\frac{z^{n}}{|\mathcal{B}_{1}|}\sum_{n\in\mathcal{B}_{b}}\sum_{i=1}^{l}y_{i}^{n}(\beta^{2}+\frac{\eta^{2}t_{0}^{2}(1-p_{a})^{2}\beta^{2}}{M_{1}^{2}})G^{n}_{i,l+1}({\bm{w}}^{(t_{0})})(\sum_{s=i+1}^{l+1}\sigma({{\bm{w}}^{(t_{0})}}^{\top}{\bm{p}}_{s}^{n}){{\bm{v}}^{*}_{s}}^{\top}{\bm{p}}_{s}^{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="11" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(151)</span></td></tr>
<tr id="A5.E151Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E151Xa.m2" class="ltx_Math" alttext="\displaystyle\cdot-(1-\sigma({{\bm{w}}^{(t_{0})}}^{\top}{\bm{p}}_{i}^{n})){{\bm{v}}^{*}_{s}}^{\top}{\bm{p}}_{i}^{n})" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">⋅</mo><mo lspace="0em">−</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>σ</mi><mo stretchy="false">(</mo><mi>𝒘</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msup><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝒑</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mi>n</mi></msup><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mi>𝒗</mi><msup><mrow></mrow><mo>∗</mo></msup><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝒑</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mi>n</mi></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\cdot-(1-\sigma({{\bm{w}}^{(t_{0})}}^{\top}{\bm{p}}_{i}^{n})){{\bm{v}}^{*}_{s}}^{\top}{\bm{p}}_{i}^{n})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E151Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E151Xb.m2" class="ltx_Math" alttext="\displaystyle\gtrsim" display="inline" intent=":literal"><semantics><mo>≳</mo><annotation encoding="application/x-tex">\displaystyle\gtrsim</annotation></semantics></math></td>
