<td id="A1.T10.5.9.1" class="ltx_td ltx_align_left"><span id="A1.T10.5.9.1.1" class="ltx_text" style="font-size:90%;">DeepseekV3(0324)</span></td>
<td id="A1.T10.5.9.2" class="ltx_td ltx_align_center"><span id="A1.T10.5.9.2.1" class="ltx_text" style="font-size:90%;">95</span></td>
<td id="A1.T10.5.9.3" class="ltx_td ltx_align_center"><span id="A1.T10.5.9.3.1" class="ltx_text" style="font-size:90%;">58</span></td>
<td id="A1.T10.5.9.4" class="ltx_td ltx_align_center"><span id="A1.T10.5.9.4.1" class="ltx_text" style="font-size:90%;">51</span></td>
<td id="A1.T10.5.9.5" class="ltx_td ltx_align_center"><span id="A1.T10.5.9.5.1" class="ltx_text" style="font-size:90%;">54</span></td></tr>
<tr id="A1.T10.5.10" class="ltx_tr">
<td id="A1.T10.5.10.1" class="ltx_td ltx_align_left"><span id="A1.T10.5.10.1.1" class="ltx_text" style="font-size:90%;">Llama3.1-8B-IT</span></td>
<td id="A1.T10.5.10.2" class="ltx_td ltx_align_center"><span id="A1.T10.5.10.2.1" class="ltx_text" style="font-size:90%;">49</span></td>
<td id="A1.T10.5.10.3" class="ltx_td ltx_align_center"><span id="A1.T10.5.10.3.1" class="ltx_text" style="font-size:90%;">19</span></td>
<td id="A1.T10.5.10.4" class="ltx_td ltx_align_center"><span id="A1.T10.5.10.4.1" class="ltx_text" style="font-size:90%;">9</span></td>
<td id="A1.T10.5.10.5" class="ltx_td ltx_align_center"><span id="A1.T10.5.10.5.1" class="ltx_text" style="font-size:90%;">20</span></td></tr>
