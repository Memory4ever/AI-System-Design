<span id="S4.T1.4.1.1.1.1.1.1.3.6" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">52.9</span>
<span id="S4.T1.4.1.1.1.1.1.1.3.7" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">52.9</span>
