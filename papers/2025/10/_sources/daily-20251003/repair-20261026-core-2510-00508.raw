</span>
</div>
<div id="alg1.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">4:</span>
            
            
            <math id="alg1.l4.m1" class="ltx_Math" alttext="\{s_{1},...,s_{n}\}\leftarrow\text{ExtractRelevantSentences}(C,Q)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><msub><mi>s</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>s</mi><mi>n</mi></msub><mo stretchy="false">}</mo></mrow><mo stretchy="false">←</mo><mrow><mtext>ExtractRelevantSentences</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo>,</mo><mi>Q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\{s_{1},...,s_{n}\}\leftarrow\text{ExtractRelevantSentences}(C,Q)</annotation></semantics></math> <span id="alg1.l4.2" class="ltx_text" style="float:right;"><math id="alg1.l4.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Common extraction step
</span>
</div>
