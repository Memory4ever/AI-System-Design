<td id="S4.T1.6.2.7" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T1.6.2.7.1" class="ltx_text ltx_font_bold">Acc</span></td>
<td id="S4.T1.6.2.8" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T1.6.2.8.1" class="ltx_text ltx_font_bold">Hit</span></td></tr>
<tr id="S4.T1.6.3" class="ltx_tr">
