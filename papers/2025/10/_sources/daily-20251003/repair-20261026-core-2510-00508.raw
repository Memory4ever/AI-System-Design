</div>
<div id="alg1.l18" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">18:</span>
            
            
             <math id="alg1.l18.m1" class="ltx_Math" alttext="A^{(t+1)}\leftarrow\text{Writer}(Q,C,\text{feedback})" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">←</mo><mrow><mtext>Writer</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Q</mi><mo>,</mo><mi>C</mi><mo>,</mo><mtext>feedback</mtext><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A^{(t+1)}\leftarrow\text{Writer}(Q,C,\text{feedback})</annotation></semantics></math>, <math id="alg1.l18.m2" class="ltx_Math" alttext="t\leftarrow t+1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo stretchy="false">←</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">t\leftarrow t+1</annotation></semantics></math>

</div>
