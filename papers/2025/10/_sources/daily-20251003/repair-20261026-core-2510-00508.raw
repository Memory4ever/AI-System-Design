<td id="S4.T1.6.2.3" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T1.6.2.3.1" class="ltx_text ltx_font_bold">Acc</span></td>
<td id="S4.T1.6.2.4" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T1.6.2.4.1" class="ltx_text ltx_font_bold">Hit</span></td>
<td id="S4.T1.6.2.5" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T1.6.2.5.1" class="ltx_text ltx_font_bold">Acc</span></td>
