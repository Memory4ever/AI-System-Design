</div>
<div id="alg1.l22" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">22:</span>
            
            
          <span id="alg1.l22.2" class="ltx_text ltx_font_bold">return</span> <math id="alg1.l22.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>

</div>
</div>
