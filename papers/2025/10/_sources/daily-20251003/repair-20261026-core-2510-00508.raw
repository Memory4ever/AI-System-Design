</span>
</div>
<div id="alg1.l14" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">14:</span>
            
            
             <math id="alg1.l14.m1" class="ltx_Math" alttext="\sigma^{(t)}\leftarrow\alpha\cdot\kappa(A^{(t)},C)+\min(\delta(A^{(t)},C)^{\beta}/\gamma,\varepsilon)" display="inline" intent=":literal"><semantics><mrow><msup><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">←</mo><mrow><mrow><mi>α</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>C</mi><mo stretchy="false">)</mo></mrow><mi>β</mi></msup></mrow><mo>/</mo><mi>γ</mi></mrow><mo>,</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma^{(t)}\leftarrow\alpha\cdot\kappa(A^{(t)},C)+\min(\delta(A^{(t)},C)^{\beta}/\gamma,\varepsilon)</annotation></semantics></math> <span id="alg1.l14.2" class="ltx_text" style="float:right;"><math id="alg1.l14.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Copy score
</span>
</div>
<div id="alg1.l15" class="ltx_listingline">
