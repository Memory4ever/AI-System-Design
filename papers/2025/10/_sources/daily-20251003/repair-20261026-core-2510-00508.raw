            <math id="alg2.l11.m1" class="ltx_Math" alttext="r_{i}^{*}\leftarrow\arg\max_{r\in\mathcal{R}_{i}^{f}}\text{ratings}[r]" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>r</mi><mi>i</mi><mo>∗</mo></msubsup><mo stretchy="false">←</mo><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><msub><mi>max</mi><mrow><mi>r</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>i</mi><mi>f</mi></msubsup></mrow></msub></mrow><mo lspace="0.167em" rspace="0em">​</mo><mtext>ratings</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>r</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r_{i}^{*}\leftarrow\arg\max_{r\in\mathcal{R}_{i}^{f}}\text{ratings}[r]</annotation></semantics></math> <span id="alg2.l11.2" class="ltx_text" style="float:right;"><math id="alg2.l11.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Select best response
</span>
</div>
<div id="alg2.l12" class="ltx_listingline">
