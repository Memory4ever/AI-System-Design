<figure id="alg2" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.3" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> CopyPasteLLM: Automated Preference Construction and Training</figcaption>
<div id="alg2.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">1:</span>
            
            
          
</div>
<div id="alg2.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">2:</span>
            
            
          Query-context pairs <math id="alg2.l2.m1" class="ltx_Math" alttext="\{(Q_{i},C_{i})\}_{i=1}^{N}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msub><mi>Q</mi><mi>i</mi></msub><mo>,</mo><msub><mi>C</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><annotation encoding="application/x-tex">\{(Q_{i},C_{i})\}_{i=1}^{N}</annotation></semantics></math>; 
</div>
<div id="alg2.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">3:</span>
            
            
          Methods <math id="alg2.l3.m1" class="ltx_Math" alttext="\mathcal{T}=\{\text{Base},\text{Attributed},\text{Citations},\text{CP-Order},\text{CP-Link},\text{CP-Refine}\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mtext>Base</mtext><mo>,</mo><mtext>Attributed</mtext><mo>,</mo><mtext>Citations</mtext><mo>,</mo><mtext>CP-Order</mtext><mo>,</mo><mtext>CP-Link</mtext><mo>,</mo><mtext>CP-Refine</mtext></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}=\{\text{Base},\text{Attributed},\text{Citations},\text{CP-Order},\text{CP-Link},\text{CP-Refine}\}</annotation></semantics></math>; 
</div>
<div id="alg2.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">4:</span>
            
            
          Metrics <math id="alg2.l4.m1" class="ltx_Math" alttext="\{f_{j},\theta_{j}\}_{j=1}^{6}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>f</mi><mi>j</mi></msub><mo>,</mo><msub><mi>θ</mi><mi>j</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mn>6</mn></msubsup><annotation encoding="application/x-tex">\{f_{j},\theta_{j}\}_{j=1}^{6}</annotation></semantics></math>; Temperature <math id="alg2.l4.m2" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>

</div>
<div id="alg2.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">5:</span>
            
            
