<td id="A6.T12.4.1.2.1" class="ltx_td ltx_align_center ltx_align_top ltx_border_t"><span id="A6.T12.4.1.2.1.1" class="ltx_text ltx_font_bold">Direct</span></td>
<td id="A6.T12.4.1.2.2" class="ltx_td ltx_align_center ltx_align_top ltx_border_t"><span id="A6.T12.4.1.2.2.1" class="ltx_text ltx_font_bold">Our Method (VS)</span></td></tr>
<tr id="A6.T12.4.1.3" class="ltx_tr">
