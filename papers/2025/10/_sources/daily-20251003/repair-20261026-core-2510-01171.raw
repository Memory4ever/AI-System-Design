<td id="A5.T5.2.3.5" class="ltx_td ltx_align_center">1.80</td>
<td id="A5.T5.2.3.6" class="ltx_td ltx_align_center">+0.28</td>
<td id="A5.T5.2.3.7" class="ltx_td ltx_align_center">28,283</td></tr>
<tr id="A5.T5.2.4" class="ltx_tr">
<th id="A5.T5.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">GLM-4.5</th>
<td id="A5.T5.2.4.2" class="ltx_td ltx_align_center">Tie</td>
<td id="A5.T5.2.4.3" class="ltx_td ltx_align_center">0.649</td>
<td id="A5.T5.2.4.4" class="ltx_td ltx_align_center">0.072</td>
<td id="A5.T5.2.4.5" class="ltx_td ltx_align_center">1.47</td>
<td id="A5.T5.2.4.6" class="ltx_td ltx_align_center">+0.19</td>
<td id="A5.T5.2.4.7" class="ltx_td ltx_align_center">6,874</td></tr>
