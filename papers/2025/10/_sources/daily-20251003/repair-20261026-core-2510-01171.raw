<td id="A7.T31.6.1.8.3" class="ltx_td ltx_align_center ltx_border_bb">0.470<sub id="A7.T31.6.1.8.3.1" class="ltx_sub"><span id="A7.T31.6.1.8.3.1.1" class="ltx_text ltx_font_italic">±0.144</span></sub></td></tr>
