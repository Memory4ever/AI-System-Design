</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 16.85)"><foreignObject style="--ltx-fo-width:36.62em;--ltx-fo-height:11.35em;--ltx-fo-depth:0.22em;font-size:10pt;" height="160.13" overflow="visible" transform="matrix(1 0 0 -1 0 157.05)" width="506.72"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
