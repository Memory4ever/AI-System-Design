<section id="A7.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">G.5 </span>Random Number Generation</h3>

<figure id="A7.SS5.fig2" class="ltx_figure ltx_align_floatright" style="width:50%;">
<div class="ltx_flex_figure">
