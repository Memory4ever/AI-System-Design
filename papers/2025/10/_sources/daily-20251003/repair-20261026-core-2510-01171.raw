<td id="A7.T33.4.9.2" class="ltx_td ltx_align_center ltx_border_bb"><math id="A7.T33.m13" class="ltx_Math" alttext="97.91\pm 0.88" display="inline" intent=":literal"><semantics><mrow><mn>97.91</mn><mo>±</mo><mn>0.88</mn></mrow><annotation encoding="application/x-tex">97.91\pm 0.88</annotation></semantics></math></td>
<td id="A7.T33.4.9.3" class="ltx_td ltx_align_center ltx_border_bb">-0.31</td></tr>
