<td id="A7.T31.6.1.3.3" class="ltx_td ltx_align_center" style="--ltx-bg-color:#D7EAD3;"><span id="A7.T31.6.1.3.3.1" class="ltx_text ltx_underline" style="--ltx-bg-color:#D7EAD3;">0.473<sub id="A7.T31.6.1.3.3.1.1" class="ltx_sub"><span id="A7.T31.6.1.3.3.1.1.1" class="ltx_text ltx_font_italic">±0.151</span></sub></span></td></tr>
