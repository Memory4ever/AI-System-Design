<span id="S5.T3.2.1.3.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:6.8pt;height:22.9pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:22.9pt;transform:translate(-8.0pt,-8.0pt) rotate(-90deg) ;">
<span id="S5.T3.2.1.3.1.1.1.1" class="ltx_p">MCF</span>
</span></span></span></td>
<td id="S5.T3.2.1.3.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">Adaedit</td>
