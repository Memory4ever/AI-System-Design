<span id="S3.F2.pic1.7.3" class="ltx_p"><span id="S3.F2.pic1.7.3.1" class="ltx_text" style="font-size:80%;">Response</span></span>
</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#D24D79;--ltx-fill-color:#F7E0E8;" fill="#F7E0E8" stroke="#D24D79"><path d="M 41.21 50.39 L -41.21 50.39 C -42.74 50.39 -43.98 49.16 -43.98 47.63 L -43.98 21.67 C -43.98 20.14 -42.74 18.9 -41.21 18.9 L 41.21 18.9 C 42.74 18.9 43.98 20.14 43.98 21.67 L 43.98 47.63 C 43.98 49.16 42.74 50.39 41.21 50.39 Z M -43.98 18.9"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -39.37 31.88)"><foreignObject style="--ltx-fo-width:6.69em;--ltx-fo-height:0.56em;--ltx-fo-depth:0.16em;font-size:10pt;" height="9.84" overflow="visible" transform="matrix(1 0 0 -1 0 7.69)" width="92.57"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S3.F2.pic1.8" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:6.69em;">
<span id="S3.F2.pic1.8.1" class="ltx_p"></span>
<span id="S3.F2.pic1.8.2" class="ltx_p"><span id="S3.F2.pic1.8.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Balanced</span></span>
<span id="S3.F2.pic1.8.3" class="ltx_p"><span id="S3.F2.pic1.8.3.1" class="ltx_text" style="font-size:80%;">Response</span></span>
