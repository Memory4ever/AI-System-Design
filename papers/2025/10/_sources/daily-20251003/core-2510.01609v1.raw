</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#4DFF4D;--ltx-fill-color:#E0FFE0;" fill="#E0FFE0" stroke="#4DFF4D" stroke-width="0.8pt"><path d="M -162.34 148.32 L -270.73 148.32 C -273.79 148.32 -276.27 145.84 -276.27 142.78 L -276.27 73.75 C -276.27 70.7 -273.79 68.22 -270.73 68.22 L -162.34 68.22 C -159.28 68.22 -156.81 70.7 -156.81 73.75 L -156.81 142.78 C -156.81 145.84 -159.28 148.32 -162.34 148.32 Z M -276.27 68.22"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 -271.65 136.02)"><foreignObject style="--ltx-fo-width:9.38em;--ltx-fo-height:0.56em;--ltx-fo-depth:4.57em;font-size:10pt;" height="70.88" overflow="visible" transform="matrix(1 0 0 -1 0 7.69)" width="129.79"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
