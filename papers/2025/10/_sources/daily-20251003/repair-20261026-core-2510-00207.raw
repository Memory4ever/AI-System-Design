                  <math id="alg2.l4.m1" class="ltx_Math" alttext="ARChunks" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><annotation encoding="application/x-tex">ARChunks</annotation></semantics></math> = <math id="alg2.l4.m2" class="ltx_Math" alttext="ARTensor" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">ARTensor</annotation></semantics></math>.partition(<math id="alg2.l4.m3" class="ltx_Math" alttext="S_{p}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>p</mi></msub><annotation encoding="application/x-tex">S_{p}</annotation></semantics></math>);

