<span id="A4.T6.5.2.1.1" class="ltx_inline-block ltx_align_top" style="width:30.0pt;">
<span id="A4.T6.5.2.1.1.1" class="ltx_p">Overhead</span>
</span></td>
<td id="A4.T6.5.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_b ltx_border_t">
