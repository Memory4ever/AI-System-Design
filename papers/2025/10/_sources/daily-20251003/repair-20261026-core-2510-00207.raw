</span></td>
<td id="A4.T4.5.3.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="A4.T4.5.3.2.1" class="ltx_inline-block ltx_align_top" style="width:25.0pt;">
<span id="A4.T4.5.3.2.1.1" class="ltx_p ltx_align_center">95.6</span>
</span></td>
<td id="A4.T4.5.3.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="A4.T4.5.3.3.1" class="ltx_inline-block ltx_align_top" style="width:40.0pt;">
<span id="A4.T4.5.3.3.1.1" class="ltx_p ltx_align_center">130.1</span>
</span></td>
