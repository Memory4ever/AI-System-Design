    <p class="title is-5 mathjax">
      
        ModernVBERT: Towards Smaller Visual Document Retrievers
      
    </p>
    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Teiletche%2C+P">Paul Teiletche</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Mac%C3%A9%2C+Q">Quentin Macé</a>, 
      
