        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.00063">pdf</a>, <a href="https://arxiv.org/ps/2510.00063">ps</a>, <a href="https://arxiv.org/format/2510.00063">other</a>]&nbsp;</span>
