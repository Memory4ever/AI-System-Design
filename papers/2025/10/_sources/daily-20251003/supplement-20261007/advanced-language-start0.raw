        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.00125">pdf</a>, <a href="https://arxiv.org/ps/2510.00125">ps</a>, <a href="https://arxiv.org/format/2510.00125">other</a>]&nbsp;</span>
