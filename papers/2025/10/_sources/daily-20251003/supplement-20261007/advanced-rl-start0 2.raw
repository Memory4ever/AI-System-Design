      <a href="/search/?searchtype=author&amp;query=Li%2C+G">Guanghao Li</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhang%2C+Z">Zishi Zhang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Wang%2C+Q">Qinghao Wang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Qin%2C+S">Shentao Qin</a>, 
      
