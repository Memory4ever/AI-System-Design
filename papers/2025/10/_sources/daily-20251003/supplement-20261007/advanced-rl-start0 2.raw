        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.01569">pdf</a>, <a href="https://arxiv.org/ps/2510.01569">ps</a>, <a href="https://arxiv.org/format/2510.01569">other</a>]&nbsp;</span>
