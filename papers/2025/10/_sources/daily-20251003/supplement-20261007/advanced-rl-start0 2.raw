    <p class="title is-5 mathjax">
      
        Enhancing Large <span class="search-hit mathjax">Language</span> Model Reasoning with Reward Models: An Analytical Survey
      
    </p>
    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Liu%2C+Q">Qiyuan Liu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Xu%2C+H">Hao Xu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Chen%2C+X">Xuhong Chen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Chen%2C+W">Wei Chen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Teh%2C+Y+W">Yee Whye Teh</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Miao%2C+N">Ning Miao</a>
      
