      <a href="/search/?searchtype=author&amp;query=He%2C+Y">Yun He</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Kumar%2C+M">Mrinal Kumar</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Fang%2C+H">Han Fang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Chi%2C+Y">Yuejie Chi</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Sankararaman%2C+K+A">Karthik Abinav Sankararaman</a>
      
