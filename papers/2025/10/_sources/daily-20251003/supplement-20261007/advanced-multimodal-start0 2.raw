    <p class="title is-5 mathjax">
      
        MathSticks: A Benchmark for Visual Symbolic Compositional Reasoning with Matchstick Puzzles
      
    </p>
    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Ji%2C+Y">Yuheng Ji</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Tan%2C+H">Huajie Tan</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Chi%2C+C">Cheng Chi</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Xu%2C+Y">Yijie Xu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhao%2C+Y">Yuting Zhao</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhou%2C+E">Enshen Zhou</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Lyu%2C+H">Huaihai Lyu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Wang%2C+P">Pengwei Wang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Wang%2C+Z">Zhongyuan Wang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhang%2C+S">Shanghang Zhang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zheng%2C+X">Xiaolong Zheng</a>
      
