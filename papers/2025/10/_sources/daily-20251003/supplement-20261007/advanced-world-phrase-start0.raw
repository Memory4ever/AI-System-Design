        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.14977">pdf</a>, <a href="https://arxiv.org/ps/2510.14977">ps</a>, <a href="https://arxiv.org/format/2510.14977">other</a>]&nbsp;</span>
      </p>
      <div class="tags is-inline-block">
