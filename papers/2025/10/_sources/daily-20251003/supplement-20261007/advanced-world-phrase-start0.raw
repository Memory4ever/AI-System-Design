      <a href="/search/?searchtype=author&amp;query=Delgrange%2C+F">Florent Delgrange</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Avalos%2C+R">Raphael Avalos</a>, 
      
      <a href="/search/?searchtype=author&amp;query=R%C3%B6pke%2C+W">Willem Röpke</a>
      
