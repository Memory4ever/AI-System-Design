        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.02287">pdf</a>, <a href="https://arxiv.org/ps/2510.02287">ps</a>, <a href="https://arxiv.org/format/2510.02287">other</a>]&nbsp;</span>
