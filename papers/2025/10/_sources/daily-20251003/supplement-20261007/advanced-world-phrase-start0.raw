        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.07944">pdf</a>, <a href="https://arxiv.org/ps/2510.07944">ps</a>, <a href="https://arxiv.org/format/2510.07944">other</a>]&nbsp;</span>
