      <a href="/search/?searchtype=author&amp;query=Chen%2C+X">Xiuwei Chen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Lin%2C+B">Bingqian Lin</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Han%2C+J">Jianhua Han</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Xu%2C+H">Hang Xu</a>, 
      
