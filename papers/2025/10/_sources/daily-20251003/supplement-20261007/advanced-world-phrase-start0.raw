        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.08553">pdf</a>, <a href="https://arxiv.org/ps/2510.08553">ps</a>, <a href="https://arxiv.org/format/2510.08553">other</a>]&nbsp;</span>
