      <a href="/search/?searchtype=author&amp;query=Ji%2C+W">Wenjun Ji</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Chi%2C+P">Panpan Chi</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Chen%2C+K">Ken Chen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Wu%2C+H">Hengyuan Wu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Xin%2C+Y">Yingsi Xin</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhu%2C+Y">Yongfeng Zhu</a>, 
      
