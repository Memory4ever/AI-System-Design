      <a href="/search/?searchtype=author&amp;query=Gao%2C+Y">Yunqi Gao</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Hu%2C+B">Bing Hu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Mashhadi%2C+M+B">Mahdi Boloursaz Mashhadi</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Jin%2C+A">A-Long Jin</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhang%2C+Y">Yanfeng Zhang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Xiao%2C+P">Pei Xiao</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Tafazolli%2C+R">Rahim Tafazolli</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Debbah%2C+M">Merouane Debbah</a>
      
