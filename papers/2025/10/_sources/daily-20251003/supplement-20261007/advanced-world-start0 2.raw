        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.00615">pdf</a>, <a href="https://arxiv.org/ps/2510.00615">ps</a>, <a href="https://arxiv.org/format/2510.00615">other</a>]&nbsp;</span>
