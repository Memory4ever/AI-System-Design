      <a href="/search/?searchtype=author&amp;query=Yusuf%2C+H+U">Hadiza Umar Yusuf</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Gaaloul%2C+K">Khouloud Gaaloul</a>
      
