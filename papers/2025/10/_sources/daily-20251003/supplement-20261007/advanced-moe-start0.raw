        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.08564">pdf</a>, <a href="https://arxiv.org/ps/2510.08564">ps</a>, <a href="https://arxiv.org/format/2510.08564">other</a>]&nbsp;</span>
