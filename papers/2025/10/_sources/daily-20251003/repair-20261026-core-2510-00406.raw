<td id="S4.T2.12.1.5.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S4.T2.12.1.5.4.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#00E000;">+2.6</span></td>
