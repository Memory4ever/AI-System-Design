            <span id="alg2.l4.3" class="ltx_text ltx_font_bold" style="font-size:90%;">if</span><span id="alg2.l4.4" class="ltx_text" style="font-size:90%;"> </span><math id="alg2.l4.m1" class="ltx_Math" alttext="|t_{\mathrm{cur}}-T^{\star}|\leq\varepsilon" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">cur</mi></msub><mo mathsize="0.900em">−</mo><msup><mi mathsize="0.900em">T</mi><mo mathsize="0.900em">⋆</mo></msup></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo></mrow><mo mathsize="0.900em">≤</mo><mi mathsize="0.900em">ε</mi></mrow><annotation encoding="application/x-tex">|t_{\mathrm{cur}}-T^{\star}|\leq\varepsilon</annotation></semantics></math><span id="alg2.l4.5" class="ltx_text" style="font-size:90%;"> </span><span id="alg2.l4.6" class="ltx_text ltx_font_bold" style="font-size:90%;">then</span><span id="alg2.l4.7" class="ltx_text" style="font-size:90%;"> </span><span id="alg2.l4.8" class="ltx_text ltx_font_bold" style="font-size:90%;">return</span><span id="alg2.l4.9" class="ltx_text" style="font-size:90%;"> </span><math id="alg2.l4.m2" class="ltx_Math" alttext="(f_{\mathrm{cur}},\textsc{ACHIEVABLE})" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">f</mi><mi mathsize="0.900em">cur</mi></msub><mo mathsize="0.900em">,</mo><mtext class="ltx_font_smallcaps" mathsize="0.900em">ACHIEVABLE</mtext><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><annotation encoding="application/x-tex">(f_{\mathrm{cur}},\textsc{ACHIEVABLE})</annotation></semantics></math><span id="alg2.l4.10" class="ltx_text" style="font-size:90%;"> </span>
</div>
