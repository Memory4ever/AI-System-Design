            <span id="alg2.l6.3" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">apply_freq<math id="alg2.l6.m1" class="ltx_Math" alttext="(f_{\max})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mi>max</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f_{\max})</annotation></semantics></math></span><span id="alg2.l6.4" class="ltx_text" style="font-size:90%;">; </span><math id="alg2.l6.m2" class="ltx_Math" alttext="t_{\max}\leftarrow\textsc{obs\_time}(W)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">max</mi></msub><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps" mathsize="0.900em">obs_time</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">W</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t_{\max}\leftarrow\textsc{obs\_time}(W)</annotation></semantics></math><span id="alg2.l6.5" class="ltx_text" style="font-size:90%;">
</span>
