            <math id="alg2.l3.m1" class="ltx_Math" alttext="t_{\mathrm{cur}}\leftarrow\textsc{obs\_time}(W)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">cur</mi></msub><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps" mathsize="0.900em">obs_time</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">W</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t_{\mathrm{cur}}\leftarrow\textsc{obs\_time}(W)</annotation></semantics></math><span id="alg2.l3.3" class="ltx_text" style="font-size:90%;">
