<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption ltx_font_bold"><span class="ltx_tag ltx_tag_float">Algorithm 1 </span> <span id="alg1.6" class="ltx_text ltx_font_smallcaps">GUI-KV</span>: Spatio-Temporal KV Cache Compression for GUI Agents</figcaption>
<div id="alg1.7" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
          <span class="ltx_tag ltx_tag_listingline">1:</span>
          
          
        <span id="alg1.l1.2" class="ltx_text ltx_font_bold">Full context token indices </span><math id="alg1.l1.m1" class="ltx_Math" alttext="\mathcal{C}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">\mathcal{C}</annotation></semantics></math><span id="alg1.l1.3" class="ltx_text ltx_font_bold">, partitioned into current visual </span><math id="alg1.l1.m2" class="ltx_Math" alttext="\mathcal{I}_{t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathcal{I}_{t}</annotation></semantics></math><span id="alg1.l1.4" class="ltx_text ltx_font_bold">, past visual </span><math id="alg1.l1.m3" class="ltx_Math" alttext="\mathcal{I}_{&lt;t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mphantom></mphantom><mo>&lt;</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{I}_{&lt;t}</annotation></semantics></math><span id="alg1.l1.5" class="ltx_text ltx_font_bold">, and text </span><math id="alg1.l1.m4" class="ltx_Math" alttext="\mathcal{T}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒯</mi><annotation encoding="application/x-tex">\mathcal{T}</annotation></semantics></math><span id="alg1.l1.6" class="ltx_text ltx_font_bold">.
</span>
</div>
<div id="alg1.l2" class="ltx_listingline">
          <span class="ltx_tag ltx_tag_listingline">2:</span>
          
          
        <span id="alg1.l2.2" class="ltx_text ltx_font_bold">Per-head key matrices </span><math id="alg1.l2.m1" class="ltx_Math" alttext="\{\bm{K}^{h}\}_{h=1}^{H}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msup><mi>𝑲</mi><mi>h</mi></msup><mo stretchy="false">}</mo></mrow><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>H</mi></msubsup><annotation encoding="application/x-tex">\{\bm{K}^{h}\}_{h=1}^{H}</annotation></semantics></math><span id="alg1.l2.3" class="ltx_text ltx_font_bold">, hidden states </span><math id="alg1.l2.m2" class="ltx_Math" alttext="\bm{X}" display="inline" intent=":literal"><semantics><mi>𝑿</mi><annotation encoding="application/x-tex">\bm{X}</annotation></semantics></math><span id="alg1.l2.4" class="ltx_text ltx_font_bold">, per-head attention scores </span><math id="alg1.l2.m3" class="ltx_Math" alttext="\{\bm{A}^{h}\}_{h=1}^{H}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msup><mi>𝑨</mi><mi>h</mi></msup><mo stretchy="false">}</mo></mrow><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>H</mi></msubsup><annotation encoding="application/x-tex">\{\bm{A}^{h}\}_{h=1}^{H}</annotation></semantics></math><span id="alg1.l2.5" class="ltx_text ltx_font_bold">.
</span>
</div>
<div id="alg1.l3" class="ltx_listingline">
          <span class="ltx_tag ltx_tag_listingline">3:</span>
          
          
        <span id="alg1.l3.2" class="ltx_text ltx_font_bold">Hyperparameters: saliency weight </span><math id="alg1.l3.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math><span id="alg1.l3.3" class="ltx_text ltx_font_bold">, budget ratio </span><math id="alg1.l3.m2" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math><span id="alg1.l3.4" class="ltx_text ltx_font_bold">, QR rank </span><math id="alg1.l3.m3" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math><span id="alg1.l3.5" class="ltx_text ltx_font_bold">.
</span>
</div>
<div id="alg1.l4" class="ltx_listingline">
          <span class="ltx_tag ltx_tag_listingline">4:</span>
          
          
        <span id="alg1.l4.2" class="ltx_text ltx_font_bold">Let </span><math id="alg1.l4.m1" class="ltx_Math" alttext="n\leftarrow|\mathcal{C}|" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">←</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">n\leftarrow|\mathcal{C}|</annotation></semantics></math><span id="alg1.l4.3" class="ltx_text ltx_font_bold"> be the total number of tokens.
</span>
</div>
<div id="alg1.l5" class="ltx_listingline">
          <span class="ltx_tag ltx_tag_listingline">5:</span>
          
          
        <span id="alg1.l5.2" class="ltx_text ltx_font_bold">Initialize sets of kept indices </span><math id="alg1.l5.m1" class="ltx_Math" alttext="\mathcal{C}_{\text{kept}}^{h}\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mtext class="ltx_mathvariant_bold">kept</mtext><mi>h</mi></msubsup><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\mathcal{C}_{\text{kept}}^{h}\leftarrow\emptyset</annotation></semantics></math><span id="alg1.l5.3" class="ltx_text ltx_font_bold"> for each head </span><math id="alg1.l5.m2" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math><span id="alg1.l5.4" class="ltx_text ltx_font_bold">.
</span>
</div>
<div id="alg1.l6" class="ltx_listingline">
          <span class="ltx_tag ltx_tag_listingline">6:</span>
          
          
        <span id="alg1.l6.2" class="ltx_text ltx_font_bold">for each head </span><math id="alg1.l6.m1" class="ltx_Math" alttext="h=1,\dots,H" display="inline" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>H</mi></mrow><annotation encoding="application/x-tex">h=1,\dots,H</annotation></semantics></math><span id="alg1.l6.3" class="ltx_text ltx_font_bold"> do
</span>
</div>
<div id="alg1.l7" class="ltx_listingline">
          <span class="ltx_tag ltx_tag_listingline">7:</span>
          
          
