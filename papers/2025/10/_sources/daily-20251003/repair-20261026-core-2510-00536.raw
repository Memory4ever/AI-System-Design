</span>
</div>
<div id="alg1.l14" class="ltx_listingline">
          <span class="ltx_tag ltx_tag_listingline">14:</span>
          
          
        <span id="alg1.l14.2" class="ltx_text ltx_font_bold">      </span><math id="alg1.l14.m1" class="ltx_Math" alttext="\psi_{i}^{h}\leftarrow A_{i}^{h}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ψ</mi><mi>i</mi><mi>h</mi></msubsup><mo stretchy="false">←</mo><msubsup><mi>A</mi><mi>i</mi><mi>h</mi></msubsup></mrow><annotation encoding="application/x-tex">\psi_{i}^{h}\leftarrow A_{i}^{h}</annotation></semantics></math><span id="alg1.l14.3" class="ltx_text ltx_font_bold">
</span>
</div>
