          <span class="ltx_tag ltx_tag_listingline">8:</span>
          
          
        <span id="alg1.l8.2" class="ltx_text ltx_font_bold">   Initialize spatial scores </span><math id="alg1.l8.m1" class="ltx_Math" alttext="\bm{\psi}^{h}\in\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝝍</mi><mi>h</mi></msup><mo>∈</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">\bm{\psi}^{h}\in\mathbb{R}^{n}</annotation></semantics></math><span id="alg1.l8.3" class="ltx_text ltx_font_bold">.
