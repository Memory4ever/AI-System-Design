<tr id="S4.T2.1.1.1" class="ltx_tr">
<td id="S4.T2.1.1.1.1" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T2.1.1.1.1.1" class="ltx_text ltx_font_bold"># Screenshots</span></td>
<td id="S4.T2.1.1.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T2.1.1.1.2.1" class="ltx_text ltx_font_bold">KV Cache</span></td>
<td id="S4.T2.1.1.1.3" class="ltx_td ltx_align_center ltx_border_tt"><math id="S4.F4.m1" class="ltx_math_unparsed" alttext="\bm{\gamma\penalty\ (\%)}" display="inline" intent=":literal"><semantics><mrow><mi>𝜸</mi><mrow><mo class="ltx_mathvariant_bold" lspace="0.580em" mathvariant="bold" stretchy="false">(</mo><mo>%</mo><mo class="ltx_mathvariant_bold" mathvariant="bold" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{\gamma\penalty\ (\%)}</annotation></semantics></math></td>
<td id="S4.T2.1.1.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T2.1.1.1.4.1" class="ltx_text ltx_font_bold">MFLOPs/ decoded token</span></td></tr>
<tr id="S4.T2.1.1.2" class="ltx_tr">
<td id="S4.T2.1.1.2.1" class="ltx_td ltx_align_center ltx_border_t" rowspan="3"><span id="S4.T2.1.1.2.1.1" class="ltx_text ltx_font_bold">3</span></td>
<td id="S4.T2.1.1.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.1.1.2.2.1" class="ltx_text ltx_font_bold">Full Cache</span></td>
<td id="S4.T2.1.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.1.1.2.3.1" class="ltx_text ltx_font_bold">100</span></td>
<td id="S4.T2.1.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.1.1.2.4.1" class="ltx_text ltx_font_bold">213.2</span></td></tr>
<tr id="S4.T2.1.1.3" class="ltx_tr">
<td id="S4.T2.1.1.3.1" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.1.1.3.1.1" class="ltx_text ltx_font_bold ltx_font_smallcaps">GUI-KV</span></td>
<td id="S4.T2.1.1.3.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.1.1.3.2.1" class="ltx_text ltx_font_bold">20</span></td>
<td id="S4.T2.1.1.3.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.1.1.3.3.1" class="ltx_text ltx_font_bold">123.6</span><math id="S4.F4.m2" class="ltx_Math" alttext="{}_{{\color[rgb]{0,0,1}\penalty\ \text{(-42.0\%)}}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext style="--ltx-fg-color:#0000FF;" class="ltx_mathvariant_bold" mathcolor="#0000FF">(-42.0%)</mtext></msub><annotation encoding="application/x-tex">{}_{{\color[rgb]{0,0,1}\penalty\ \text{(-42.0\%)}}}</annotation></semantics></math></td></tr>
<tr id="S4.T2.1.1.4" class="ltx_tr">
<td id="S4.T2.1.1.4.1" class="ltx_td ltx_align_center"><span id="S4.T2.1.1.4.1.1" class="ltx_text ltx_font_bold ltx_font_smallcaps">GUI-KV</span></td>
<td id="S4.T2.1.1.4.2" class="ltx_td ltx_align_center"><span id="S4.T2.1.1.4.2.1" class="ltx_text ltx_font_bold">40</span></td>
