          <span class="ltx_tag ltx_tag_listingline">10:</span>
          
          
        <span id="alg1.l10.2" class="ltx_text ltx_font_bold">     if </span><math id="alg1.l10.m1" class="ltx_Math" alttext="i\in\mathcal{I}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">i\in\mathcal{I}_{t}</annotation></semantics></math><span id="alg1.l10.3" class="ltx_text ltx_font_bold"> then </span><span id="alg1.l10.4" class="ltx_text ltx_font_bold" style="float:right;"><math id="alg1.l10.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Visual tokens
</span>
</div>
<div id="alg1.l11" class="ltx_listingline">
          <span class="ltx_tag ltx_tag_listingline">11:</span>
          
          
        <span id="alg1.l11.2" class="ltx_text ltx_font_bold">      </span><math id="alg1.l11.m1" class="ltx_Math" alttext="S_{i}\leftarrow\lVert x_{i}\rVert_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>i</mi></msub><mo rspace="0.1389em" stretchy="false">←</mo><msub><mrow><mo fence="true" lspace="0.1389em" rspace="0em">∥</mo><msub><mi>x</mi><mi>i</mi></msub><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">S_{i}\leftarrow\lVert x_{i}\rVert_{2}</annotation></semantics></math><span id="alg1.l11.3" class="ltx_text ltx_font_bold"> </span><span id="alg1.l11.4" class="ltx_text ltx_font_bold" style="float:right;"><math id="alg1.l11.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> L2 norm of residual-stream hidden state
</span>
</div>
<div id="alg1.l12" class="ltx_listingline">
          <span class="ltx_tag ltx_tag_listingline">12:</span>
          
          
        <span id="alg1.l12.2" class="ltx_text ltx_font_bold">      </span><math id="alg1.l12.m1" class="ltx_Math" alttext="\psi_{i}^{h}\leftarrow A_{i}^{h}+\alpha S_{i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ψ</mi><mi>i</mi><mi>h</mi></msubsup><mo stretchy="false">←</mo><mrow><msubsup><mi>A</mi><mi>i</mi><mi>h</mi></msubsup><mo>+</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi_{i}^{h}\leftarrow A_{i}^{h}+\alpha S_{i}</annotation></semantics></math><span id="alg1.l12.3" class="ltx_text ltx_font_bold">
</span>
</div>
<div id="alg1.l13" class="ltx_listingline">
