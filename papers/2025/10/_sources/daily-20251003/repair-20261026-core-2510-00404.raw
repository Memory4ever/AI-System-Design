<td id="A5.T2.6.1.24.2" class="ltx_td ltx_align_center">0.92</td>
<td id="A5.T2.6.1.24.3" class="ltx_td ltx_align_center">0.77</td>
<td id="A5.T2.6.1.24.4" class="ltx_td ltx_align_center">0.27</td>
