<td id="A5.T2.6.1.22.2" class="ltx_td ltx_align_center">0.93</td>
<td id="A5.T2.6.1.22.3" class="ltx_td ltx_align_center">0.78</td>
<td id="A5.T2.6.1.22.4" class="ltx_td ltx_align_center">0.28</td>
<td id="A5.T2.6.1.22.5" class="ltx_td ltx_align_center">0.30</td>
