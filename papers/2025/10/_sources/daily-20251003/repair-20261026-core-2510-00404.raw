<th id="A5.T2.6.1.23.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_t" rowspan="3"><span id="A5.T2.6.1.23.1.1" class="ltx_text">Qwen3-4B L20</span></th>
