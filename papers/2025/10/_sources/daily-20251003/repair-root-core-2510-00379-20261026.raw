</section>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Experimental Details</h2>

<section id="A4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.1 </span>Search Training/Validation Setup</h3>

<figure id="A4.T4" class="ltx_table">
<table id="A4.T4.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
