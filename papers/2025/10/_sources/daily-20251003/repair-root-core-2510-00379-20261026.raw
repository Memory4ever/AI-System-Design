<th id="A4.T5.2.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="A4.T5.2.1.7.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Learning Rate</span></th></tr>
