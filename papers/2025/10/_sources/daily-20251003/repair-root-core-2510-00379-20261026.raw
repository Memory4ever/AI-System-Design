<li id="A3.I16.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A3.I16.i2.p1" class="ltx_para">
<p id="A3.I16.i2.p1.1" class="ltx_p">Large scale via stacking (1B parameters): 3<math id="A3.I16.i2.p1.m1" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>(2A + 5M) + 2A + 4M</p>
</div></li>
<li id="A3.I16.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A3.I16.i3.p1" class="ltx_para">
<p id="A3.I16.i3.p1.1" class="ltx_p">Large scale via stretching (1B parameters): 8A + 20M</p>
</div></li>
</ul>
</div>
<div id="A3.SS4.p6" class="ltx_para">
<p id="A3.SS4.p6.1" class="ltx_p"><math id="A3.SS4.p6.m1" class="ltx_Math" alttext="n=8" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">n=8</annotation></semantics></math><span id="A3.SS4.p6.1.1" class="ltx_text ltx_font_bold"> Layer Search</span></p>
<ul id="A3.I17" class="ltx_itemize">
<li id="A3.I17.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A3.I17.i1.p1" class="ltx_para">
<p id="A3.I17.i1.p1.1" class="ltx_p">Small scale (530K parameters): 2A + 4M + 1A + 1M</p>
