<td id="S4.T2.2.1.3.13" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#E6E6E6;padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T2.2.1.3.13.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">24</span></td>
