<td id="A5.T6.5.10.4" class="ltx_td ltx_align_right ltx_border_bb ltx_border_r ltx_border_t" style="--ltx-bg-color:#FFF2E6;"><span id="A5.T6.5.10.4.1" class="ltx_text ltx_font_italic" style="--ltx-bg-color:#FFF2E6;">0.431</span></td>
<td id="A5.T6.5.10.5" class="ltx_td ltx_align_right ltx_border_bb ltx_border_r ltx_border_t" style="--ltx-bg-color:#FFF2E6;"><span id="A5.T6.5.10.5.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#FFF2E6;">0.476</span></td>
<td id="A5.T6.5.10.6" class="ltx_td ltx_align_right ltx_border_bb ltx_border_r ltx_border_t" style="--ltx-bg-color:#F2F2F2;"><span id="A5.T6.5.10.6.1" class="ltx_text ltx_font_italic" style="--ltx-bg-color:#F2F2F2;">0.416</span></td>
