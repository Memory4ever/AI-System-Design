<td id="A5.T6.5.10.8" class="ltx_td ltx_align_right ltx_border_bb ltx_border_r ltx_border_t" style="--ltx-bg-color:#FFE6E6;"><span id="A5.T6.5.10.8.1" class="ltx_text ltx_font_italic" style="--ltx-bg-color:#FFE6E6;">0.442</span></td>
<td id="A5.T6.5.10.9" class="ltx_td ltx_align_right ltx_border_bb ltx_border_t" style="--ltx-bg-color:#FFE6E6;"><span id="A5.T6.5.10.9.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#FFE6E6;">0.443</span></td></tr>
</tbody>
</table>
