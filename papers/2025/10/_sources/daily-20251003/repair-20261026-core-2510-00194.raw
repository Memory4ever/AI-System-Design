<td id="A2.T2.6.21.3" class="ltx_td ltx_align_center ltx_border_r"><math id="A2.T2.m14" class="ltx_Math" alttext="16" display="inline" intent=":literal"><semantics><mn>16</mn><annotation encoding="application/x-tex">16</annotation></semantics></math></td>
<td id="A2.T2.6.21.4" class="ltx_td ltx_align_center"><math id="A2.T2.m15" class="ltx_Math" alttext="8" display="inline" intent=":literal"><semantics><mn>8</mn><annotation encoding="application/x-tex">8</annotation></semantics></math></td></tr>
<tr id="A2.T2.6.22" class="ltx_tr">
