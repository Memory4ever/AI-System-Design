<td id="A3.T6.2.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="A3.T6.2.2.2.1" class="ltx_text" style="font-size:90%;">2</span></td>
<td id="A3.T6.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="A3.T6.2.2.3.1" class="ltx_text" style="font-size:90%;">69.01</span></td></tr>
