<figure id="A3.F3.sf4" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.00192v1/512_init.png" id="A3.F3.sf4.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:215/153;" width="215" height="153" alt="Refer to caption">
