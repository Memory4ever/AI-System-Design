        <h1 class="headline-1 bhoig__headline glue-grid__col--span-8 glue-grid__col--span-7-md glue-grid__col--span-8-lg">A collaborative approach to image generation</h1>

        

          <div class="basic-hero__description bhoig__description glue-grid__col--span-8 glue-grid__col--span-7-md glue-grid__col--span-8-lg">
            <div class="basic-hero--blog-detail__description"><p>October 2, 2025</p><span class="dot-separator"></span><p>Guy Tennenholtz, Senior Research Scientist, and Craig Boutilier, Principal Scientist, Google Research</p></div>
          </div>

        

        <div class="bhoig__cta glue-grid__col--span-8 glue-grid__col--span-7-md glue-grid__col--span-8-lg">
          
        </div>
    </div>
  </div>
</section>


    <div class="glue-page">
        <div class="glue-grid blog-detail-page__grid">
