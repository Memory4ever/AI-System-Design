<picture class="media__image media__image">
    
    
        <source media="(min-width: 768px)" srcset="https://storage.googleapis.com/gweb-research2023-media/images/PASTA-3.width-1250.png" alt="PASTA-3" />
    
    <img src="https://storage.googleapis.com/gweb-research2023-media/images/PASTA-3.width-1250.png" alt="PASTA-3" loading="lazy" />
    
</picture>
  


