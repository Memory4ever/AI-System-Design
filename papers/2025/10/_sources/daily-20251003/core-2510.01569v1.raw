</span></td>
<td id="S3.T1.2.1.5" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_middle ltx_border_tt"><span id="S3.T1.2.1.5.1" class="ltx_inline-logical-block ltx_align_middle" style="width:62.6pt;">
<span id="S3.T1.p1" class="ltx_para ltx_noindent ltx_align_center">
<span id="S3.T1.p1.1" class="ltx_p"><span id="S3.T1.p1.1.1" class="ltx_text"></span><span id="S3.T1.p1.1.2" class="ltx_text ltx_font_bold"> </span><span id="S3.T1.p1.1.3" class="ltx_text ltx_font_bold">
