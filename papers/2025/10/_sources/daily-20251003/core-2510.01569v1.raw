</span></td></tr>
<tr id="S3.T1.2.3" class="ltx_tr">
<td id="S3.T1.2.3.1" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t" style="padding-bottom: 3.0pt;"><span id="S3.T1.2.3.1.1" class="ltx_inline-logical-block ltx_align_middle" style="width:99.6pt;">
<span id="S3.T1.p3" class="ltx_para ltx_noindent ltx_align_center">
<span id="S3.T1.p3.1" class="ltx_p"><span id="S3.T1.p3.1.1" class="ltx_text"></span><span id="S3.T1.p3.1.2" class="ltx_text">
<span id="S3.T1.p3.1.2.1" class="ltx_tabular ltx_align_middle">
<span id="S3.T1.p3.1.2.1.1" class="ltx_tr">
