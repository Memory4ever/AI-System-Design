</span></td></tr>
<tr id="S3.T1.2.4" class="ltx_tr">
<td id="S3.T1.2.4.1" class="ltx_td ltx_align_left ltx_align_middle" style="padding-bottom: 3.0pt;"><span id="S3.T1.2.4.1.1" class="ltx_inline-logical-block ltx_align_middle" style="width:99.6pt;">
<span id="S3.T1.p4" class="ltx_para ltx_noindent ltx_align_center">
<span id="S3.T1.p4.1" class="ltx_p"><span id="S3.T1.p4.1.1" class="ltx_text"></span><span id="S3.T1.p4.1.2" class="ltx_text">
<span id="S3.T1.p4.1.2.1" class="ltx_tabular ltx_align_middle">
<span id="S3.T1.p4.1.2.1.1" class="ltx_tr">
<span id="S3.T1.p4.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left">Backward Reasoning</span></span>
</span></span><span id="S3.T1.p4.1.3" class="ltx_text"></span></span>
