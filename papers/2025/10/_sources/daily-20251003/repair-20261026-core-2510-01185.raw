<td id="S3.T2.2.1.7.5" class="ltx_td ltx_align_left ltx_border_b" style="--ltx-bg-color:#F2F2F2;padding-left:3.1pt;padding-right:3.1pt;"><span id="S3.T2.2.1.7.5.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">1301.12</span></td>
<td id="S3.T2.2.1.7.6" class="ltx_td ltx_align_left ltx_border_b" style="--ltx-bg-color:#F2F2F2;padding-left:3.1pt;padding-right:3.1pt;"><span id="S3.T2.2.1.7.6.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">238.21</span></td>
