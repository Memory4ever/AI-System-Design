<td id="S3.T2.2.1.6.2" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:3.1pt;padding-right:3.1pt;">50.69</td>
<td id="S3.T2.2.1.6.3" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:3.1pt;padding-right:3.1pt;">60.64</td>
