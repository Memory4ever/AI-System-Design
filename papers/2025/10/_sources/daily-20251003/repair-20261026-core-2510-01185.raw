<td id="S3.T2.2.1.6.5" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:3.1pt;padding-right:3.1pt;">1330.64</td>
<td id="S3.T2.2.1.6.6" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:3.1pt;padding-right:3.1pt;">247.50</td>
<td id="S3.T2.2.1.6.7" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:3.1pt;padding-right:3.1pt;">40.22</td>
<td id="S3.T2.2.1.6.8" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:3.1pt;padding-right:3.1pt;">63.62</td>
<td id="S3.T2.2.1.6.9" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:3.1pt;padding-right:3.1pt;">35.31</td></tr>
<tr id="S3.T2.2.1.7" class="ltx_tr">
