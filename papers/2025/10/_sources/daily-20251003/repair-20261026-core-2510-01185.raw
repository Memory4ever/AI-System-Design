<td id="S3.T2.2.1.7.2" class="ltx_td ltx_align_left ltx_border_b" style="--ltx-bg-color:#F2F2F2;padding-left:3.1pt;padding-right:3.1pt;"><span id="S3.T2.2.1.7.2.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">51.99</span></td>
<td id="S3.T2.2.1.7.3" class="ltx_td ltx_align_left ltx_border_b" style="--ltx-bg-color:#F2F2F2;padding-left:3.1pt;padding-right:3.1pt;"><span id="S3.T2.2.1.7.3.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">60.73</span></td>
