<td id="S3.T1.2.1.4.3" class="ltx_td ltx_align_left" style="padding-left:3.1pt;padding-right:3.1pt;"><span id="S3.T1.2.1.4.3.1" class="ltx_text ltx_font_bold">62.10</span></td>
<td id="S3.T1.2.1.4.4" class="ltx_td ltx_align_left" style="padding-left:3.1pt;padding-right:3.1pt;">34.9</td>
