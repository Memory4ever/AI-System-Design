<td id="S3.T2.2.1.5.7" class="ltx_td ltx_align_left" style="--ltx-bg-color:#F2F2F2;padding-left:3.1pt;padding-right:3.1pt;"><span id="S3.T2.2.1.5.7.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">42.88</span></td>
<td id="S3.T2.2.1.5.8" class="ltx_td ltx_align_left" style="--ltx-bg-color:#F2F2F2;padding-left:3.1pt;padding-right:3.1pt;"><span id="S3.T2.2.1.5.8.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F2F2F2;">64.01</span></td>
