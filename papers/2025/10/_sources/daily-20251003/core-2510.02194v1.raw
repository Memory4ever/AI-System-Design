<td id="A2.T3.2.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="A2.T3.m1" class="ltx_Math" alttext="\tau=0.25" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>=</mo><mn>0.25</mn></mrow><annotation encoding="application/x-tex">\tau=0.25</annotation></semantics></math></td>
<td id="A2.T3.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="A2.T3.m2" class="ltx_Math" alttext="\tau=0.50" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>=</mo><mn>0.50</mn></mrow><annotation encoding="application/x-tex">\tau=0.50</annotation></semantics></math></td>
