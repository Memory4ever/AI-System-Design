<tr id="A5.T2.2.11" class="ltx_tr">
<th id="A5.T2.2.11.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A5.T2.2.11.1.1" class="ltx_text ltx_font_typewriter">dropout</span></th>
<th id="A5.T2.2.11.2" class="ltx_td ltx_align_left ltx_th ltx_th_row">0.</th>
<td id="A5.T2.2.11.3" class="ltx_td ltx_align_center">0.</td>
<td id="A5.T2.2.11.4" class="ltx_td ltx_align_center">0.</td>
<td id="A5.T2.2.11.5" class="ltx_td ltx_align_center">0.1</td>
<td id="A5.T2.2.11.6" class="ltx_td ltx_align_center">0.</td>
<td id="A5.T2.2.11.7" class="ltx_td ltx_align_center">0.</td></tr>
<tr id="A5.T2.2.12" class="ltx_tr">
