<li class="ltx_tocentry ltx_tocentry_section"><a href="#S7" title="In LongCodeZip: Compress Long Context for Code Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">VII </span><span class="ltx_text ltx_font_smallcaps">Threats to Validity</span></span></a></li>
<li class="ltx_tocentry ltx_tocentry_section"><a href="#S8" title="In LongCodeZip: Compress Long Context for Code Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">VIII </span><span class="ltx_text ltx_font_smallcaps">Related Work</span></span></a>
<ol class="ltx_toclist ltx_toclist_section">
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S8.SS1" title="In VIII Related Work ‣ LongCodeZip: Compress Long Context for Code Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">VIII-A</span> </span><span class="ltx_text ltx_font_italic">Large Language Models for Code</span></span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S8.SS2" title="In VIII Related Work ‣ LongCodeZip: Compress Long Context for Code Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">VIII-B</span> </span><span class="ltx_text ltx_font_italic">Context Compression of Large Language Models</span></span></a></li>
</ol></li>
<li class="ltx_tocentry ltx_tocentry_section"><a href="#S9" title="In LongCodeZip: Compress Long Context for Code Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">IX </span><span class="ltx_text ltx_font_smallcaps">Conclusion</span></span></a></li>
