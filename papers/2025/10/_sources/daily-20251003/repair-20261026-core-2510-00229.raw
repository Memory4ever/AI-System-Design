<td id="S3.T1.2.1.2" class="ltx_td ltx_align_center"><span id="S3.T1.2.1.2.1" class="ltx_text ltx_font_bold">ToolFit (%)</span></td>
<td id="S3.T1.2.1.3" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S3.T1.2.1.3.1" class="ltx_text ltx_font_bold">Reasoning</span></td></tr>
