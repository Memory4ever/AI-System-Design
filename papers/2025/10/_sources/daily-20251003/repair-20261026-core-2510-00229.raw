<td id="S3.T1.2.5.2" class="ltx_td ltx_align_center"><span id="S3.T1.2.5.2.1" class="ltx_text ltx_font_bold">58.3</span></td>
<td id="S3.T1.2.5.3" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S3.T1.2.5.3.1" class="ltx_text ltx_font_bold">Yes</span></td></tr>
<tr id="S3.T1.2.6" class="ltx_tr">
<td id="S3.T1.2.6.1" class="ltx_td ltx_align_center"><span id="S3.T1.2.6.1.1" class="ltx_text ltx_font_bold">Llama-3.1-8B</span></td>
<td id="S3.T1.2.6.2" class="ltx_td ltx_align_center"><span id="S3.T1.2.6.2.1" class="ltx_text ltx_font_bold">42.4</span></td>
<td id="S3.T1.2.6.3" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S3.T1.2.6.3.1" class="ltx_text ltx_font_bold">No</span></td></tr>
