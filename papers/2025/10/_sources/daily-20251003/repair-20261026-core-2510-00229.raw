<td id="S3.T1.2.7.2" class="ltx_td ltx_align_center"><span id="S3.T1.2.7.2.1" class="ltx_text ltx_font_bold">15.8</span></td>
<td id="S3.T1.2.7.3" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S3.T1.2.7.3.1" class="ltx_text ltx_font_bold">No</span></td></tr>
