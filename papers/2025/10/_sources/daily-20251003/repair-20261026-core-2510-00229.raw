<td id="S3.T1.2.8.1" class="ltx_td ltx_align_center"><span id="S3.T1.2.8.1.1" class="ltx_text ltx_font_bold">ToolAce-8B</span></td>
<td id="S3.T1.2.8.2" class="ltx_td ltx_align_center"><span id="S3.T1.2.8.2.1" class="ltx_text ltx_font_bold">45.4</span></td>
<td id="S3.T1.2.8.3" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S3.T1.2.8.3.1" class="ltx_text ltx_font_bold">No</span></td></tr>
