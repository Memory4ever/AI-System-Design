<tr id="S4.T3.2.1.9" class="ltx_tr">
<td id="S4.T3.2.1.9.1" class="ltx_td ltx_align_left" style="padding-top:0.15pt;padding-bottom:0.15pt;">Jina-v4 <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib26" title="" class="ltx_ref">Günther et al., 2025</a>)</cite></td>
