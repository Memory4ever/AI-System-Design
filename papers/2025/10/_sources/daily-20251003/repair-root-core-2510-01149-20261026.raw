<tr id="A3.T8.2.1.3" class="ltx_tr">
<td id="A3.T8.2.1.3.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;" colspan="7"><span id="A3.T8.2.1.3.1.1" class="ltx_text ltx_font_italic">CLIP Encoders</span></td></tr>
<tr id="A3.T8.2.1.4" class="ltx_tr">
