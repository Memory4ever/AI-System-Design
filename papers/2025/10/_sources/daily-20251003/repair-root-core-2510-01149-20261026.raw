<td id="A3.T8.2.1.15.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding-top:1pt;padding-bottom:1pt;"><em id="A3.T8.2.1.15.1.1" class="ltx_emph ltx_font_bold ltx_font_italic">ModernVBERT</em><span id="A3.T8.2.1.15.1.2" class="ltx_text ltx_font_bold">-embed (multi-vector)</span></td>
<td id="A3.T8.2.1.15.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:1pt;padding-bottom:1pt;">252M</td>
