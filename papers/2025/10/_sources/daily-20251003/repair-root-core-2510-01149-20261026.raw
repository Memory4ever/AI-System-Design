<td id="S3.T2.2.1.1.3" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">Image/Caption Retrieval</td>
<td id="S3.T2.2.1.1.4" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">Image Classification</td>
