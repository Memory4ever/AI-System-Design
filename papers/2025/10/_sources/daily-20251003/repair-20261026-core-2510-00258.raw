object_container"><span class="ltx_foreignobject_content"><span id="S2.F1.pic1.7" class="ltx_text" style="font-size:50%;">MLP</span></span></span></foreignObject></g><g style="--ltx-fill-color:#E6FFE6;" fill="#E6FFE6"><path d="M 87.27 153.31 L 37.85 153.31 C 36.32 153.31 35.08 152.07 35.08 150.54 L 35.08 140.8 C 35.08 139.27 36.32 138.03 37.85 138.03 L 87.27 138.03 C 88.8 138.03 90.04 139.27 90.04 140.8 L 90.04 150.54 C 90.04 152.07 88.8 153.31 87.27 153.31 Z M 35.08 138.03"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 39.7 143.99)"><foreignObject style="--ltx-fo-width:4.91em;--ltx-fo-height:0.5em;--ltx-fo-depth:0.14em;font-size:6.81pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.7)" width="46.21"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F1.pic1.8" class="ltx_text" style="font-size:50%;">LayerNorm</span></span></span></foreignObject></g><path style="fill:none" d="M 0 109.51 L 62.56 109.51 L 62.56 112.03"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 1.0 -1.0 0.0 62.56 112.03)"><path d="M 5.26 0 C 4.61 0.16 1.77 1.04 0 2.01 L 0 -2.01 C 1.77 -1.04 4.61 -0.16 5.26 0 Z"></path></g><path style="fill:none" d="M 62.56 132.87 L 62.56 132.87 L 62.56 137.76"></path><path style="fill:none" d="M 62.56 153.58 L 62.56 157.93 L 13.53 157.93"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-1.0 0.0 0.0 -1.0 13.53 157.93)"><path d="M 5.26 0 C 4.61 0.16 1.77 1.04 0 2.01 L 0 -2.01 C 1.77 -1.04 4.61 -0.16 5.26 0 Z"></path></g><g style="--ltx-stroke-color:#FF0000;--ltx-fill-color:#FFB3B3;" fill="#FFB3B3" fill-opacity="0.2" stroke="#FF0000" stroke-width="0.8pt"><path d="M 89.39 158.19 L 35.73 158.19 C 32.67 158.19 30.2 155.72 30.2 152.66 L 30.2 62.08 C 30.2 59.02 32.67 56.54 35.73 56.54 L 89.39 56.54 C 92.45 56.54 94.93 59.02 94.93 62.08 L 94.93 152.66 C 94.93 155.72 92.45 158.19 89.39 158.19 Z M 30.2 56.54"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" fill-opacity="0.2" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 34.81 107.37)"><foreignObject style="--ltx-fo-width:5.89em;--ltx-fo-height:0em;--ltx-fo-depth:0em;font-size:10pt;" height="0" overflow="visible" transform="matrix(1 0 0 -1 0 0)" width="81.5"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
