<span id="S2.F1.2.1.1.1.2.1.13.10" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_b ltx_border_r" style="padding:0.2pt 1.6pt;"><span id="S2.F1.2.1.1.1.2.1.13.10.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#B3FFB3;">0.99</span></span>
