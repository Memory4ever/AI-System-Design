<td id="A2.T3.2.18.4" class="ltx_td ltx_align_left ltx_border_bb ltx_border_r"><span id="A2.T3.2.18.4.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">71.0</span></td>
