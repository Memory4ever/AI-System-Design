<tr id="A3.T4.2.3" class="ltx_tr">
<th id="A3.T4.2.3.1" class="ltx_td ltx_align_right ltx_th ltx_th_row ltx_border_rr">LLaVA-OneVision</th>
<td id="A3.T4.2.3.2" class="ltx_td ltx_align_center ltx_border_r">0%</td>
<td id="A3.T4.2.3.3" class="ltx_td ltx_align_center ltx_border_r">100%</td>
<td id="A3.T4.2.3.4" class="ltx_td ltx_align_center ltx_border_r">0%</td>
<td id="A3.T4.2.3.5" class="ltx_td ltx_align_center ltx_border_r">17%</td>
<td id="A3.T4.2.3.6" class="ltx_td ltx_align_center">100%</td></tr>
<tr id="A3.T4.2.4" class="ltx_tr">
