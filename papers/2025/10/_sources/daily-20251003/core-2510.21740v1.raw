<td id="A2.T2.2.6.6" class="ltx_td ltx_align_left ltx_border_rr ltx_border_t"><span id="A2.T2.2.6.6.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">22.0</span></td>
