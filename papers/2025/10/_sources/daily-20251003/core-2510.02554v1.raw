dentifier">implementing</span><span id="lstnumberx14.85" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.86" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx14.87" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.88" class="ltx_text ltx_lst_identifier">refinements</span><span id="lstnumberx14.89" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.90" class="ltx_text ltx_lst_identifier">included</span><span id="lstnumberx14.91" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.92" class="ltx_text ltx_lst_identifier">in</span><span id="lstnumberx14.93" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.94" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx14.95" class="ltx_text ltx_lst_space"> </span>’<span id="lstnumberx14.96" class="ltx_text ltx_lst_identifier">improvement</span>’<span id="lstnumberx14.97" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.98" class="ltx_text ltx_lst_identifier">field</span>.<span id="lstnumberx14.99" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.100" class="ltx_text ltx_lst_identifier">The</span><span id="lstnumberx14.101" class="ltx_text ltx_lst_space"> </span>’<span id="lstnumberx14.102" class="ltx_text ltx_lst_identifier">name</span>’<span id="lstnumberx14.103" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.104" class="ltx_text ltx_lst_identifier">field</span><span id="lstnumberx14.105" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.106" class="ltx_text ltx_lst_identifier">should</span><span id="lstnumberx14.107" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.108" class="ltx_text ltx_lst_identifier">contain</span><span id="lstnumberx14.109" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.110" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx14.111" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.112" class="ltx_text ltx_lst_identifier">new</span><span id="lstnumberx14.113" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.114" class="ltx_text ltx_lst_identifier">tool</span><span id="lstnumberx14.115" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.116" class="ltx_text ltx_lst_identifier">name</span>.<span id="lstnumberx14.117" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.118" class="ltx_text ltx_lst_identifier">The</span><span id="lstnumberx14.119" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.120" class="ltx_text ltx_lst_identifier">tool</span><span id="lstnumberx14.121" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.122" class="ltx_text ltx_lst_identifier">name</span><span id="lstnumberx14.123" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.124" class="ltx_text ltx_lst_identifier">should</span><span id="lstnumberx14.125" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.126" class="ltx_text ltx_lst_identifier">be</span><span id="lstnumberx14.127" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.128" class="ltx_text ltx_lst_identifier">in</span><span id="lstnumberx14.129" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.130" class="ltx_text ltx_lst_identifier">snake_case</span>.<span id="lstnumberx14.131" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.132" class="ltx_text ltx_lst_identifier">ONLY</span><span id="lstnumberx14.133" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.134" class="ltx_text ltx_lst_identifier">Output</span><span id="lstnumberx14.135" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.136" class="ltx_text ltx_lst_identifier">JSON</span>.<span id="lstnumberx14.137" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.138" class="ltx_text ltx_lst_identifier">Do</span><span id="lstnumberx14.139" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.140" class="ltx_text ltx_lst_identifier">not</span><span id="lstnumberx14.141" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.142" class="ltx_text ltx_lst_identifier">output</span><span id="lstnumberx14.143" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.144" class="ltx_text ltx_lst_identifier">any</span><span id="lstnumberx14.145" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.146" class="ltx_text ltx_lst_identifier">other</span><span id="lstnumberx14.147" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.148" class="ltx_text ltx_lst_identifier">text</span><span id="lstnumberx14.149" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.150" class="ltx_text ltx_lst_identifier">or</span><span id="lstnumberx14.151" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.152" class="ltx_text ltx_lst_identifier">delimiters</span>.
</div>
</div>
