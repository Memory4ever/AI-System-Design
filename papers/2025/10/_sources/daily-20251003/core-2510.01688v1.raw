<td id="S4.T2.2.1.5.4" class="ltx_td ltx_align_center"><span id="S4.T2.2.1.5.4.1" class="ltx_text ltx_font_bold">0.891</span></td></tr>
<tr id="S4.T2.2.1.6" class="ltx_tr">
