<tr id="S3.T1.3.1.4" class="ltx_tr">
<td id="S3.T1.3.1.4.1" class="ltx_td ltx_align_left ltx_border_r" style="padding:-0.75pt 10.0pt;">MTAN <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib25" title="" class="ltx_ref">25</a>]</cite></td>
<td id="S3.T1.3.1.4.2" class="ltx_td ltx_align_center ltx_border_r" style="padding:-0.75pt 10.0pt;">ResNet-18</td>
<td id="S3.T1.3.1.4.3" class="ltx_td ltx_align_center" style="padding:-0.75pt 10.0pt;">58.9</td>
