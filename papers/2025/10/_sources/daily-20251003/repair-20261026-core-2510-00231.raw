 11.25)"><foreignObject style="--ltx-fo-width:1.44em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="19.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F5.pic1.m30" class="ltx_Math" alttext="0.2" display="inline" intent=":literal"><semantics><mn>0.2</mn><annotation encoding="application/x-tex">0.2</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -32.29 30.22)"><foreignObject style="--ltx-fo-width:1.44em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="19.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F5.pic1.m31" class="ltx_Math" alttext="0.4" display="inline" intent=":literal"><semantics><mn>0.4</mn><annotation encoding="application/x-tex">0.4</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -32.29 49.19)"><foreignObject style="--ltx-fo-width:1.44em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="19.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F5.pic1.m32" class="ltx_Math" alttext="0.6" display="inline" intent=":literal"><semantics><mn>0.6</mn><annotation encoding="application/x-tex">0.6</annotation></semantics></math></span></span></foreignObject></g><clipPath id="pgfcp17"><path d="M -7.42 -6.29 L 81.56 -6.29 L 81.56 69.23 L -7.42 69.23 Z"></path></clipPath><g clip-path="url(#pgfcp17)"><g stroke-width="1.2pt"><path style="fill:none" d="M 0 6.39 L 4.12 8.32 L 8.24 10.34