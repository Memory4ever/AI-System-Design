{"data":{"id":"10.48550/arxiv.2510.01565","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01565","prefix":"10.48550","suffix":"arxiv.2510.01565","identifiers":[{"identifier":"2510.01565","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.01565"}],"creators":[{"name":"Lu, Runyu","nameType":"Personal","givenName":"Runyu","familyName":"Lu","affiliation":[],"nameIdentifiers":[]},{"name":"He, Shiqi","nameType":"Personal","givenName":"Shiqi","familyName":"He","affiliation":[],"nameIdentifiers":[]},{"name":"Tan, Wenxuan","nameType":"Personal","givenName":"Wenxuan","familyName":"Tan","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Shenggui","nameType":"Personal","givenName":"Shenggui","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Wu, Ruofan","nameType":"Personal","givenName":"Ruofan","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Ma, Jeff J.","nameType":"Personal","givenName":"Jeff J.","familyName":"Ma","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Ang","nameType":"Personal","givenName":"Ang","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Chowdhury, Mosharaf","nameType":"Personal","givenName":"Mosharaf","familyName":"Chowdhury","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TetriServe: Efficiently Serving Mixed DiT Workloads"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T01:23:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:17:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-13T00:16:25Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-14T01:19:07Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-01-15T20:28:33Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-01-19T01:04:56Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-06-18T01:08:24Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-06-19T00:16:06Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Diffusion Transformer (DiT) models excel at generating high-quality images through iterative denoising steps, but serving them under strict Service Level Objectives (SLOs) is challenging due to their high computational cost, particularly at larger resolutions. Existing serving systems use fixed-degree sequence parallelism, which is inefficient for heterogeneous workloads with mixed resolutions and deadlines, leading to poor GPU utilization and low SLO attainment.\n In this paper, we propose step-level sequence parallelism to dynamically adjust the degree of parallelism of individual requests according to their deadlines. We present TetriServe, a DiT serving system that implements this strategy for highly efficient image generation. Specifically, TetriServe introduces a novel round-based scheduling mechanism that improves SLO attainment by (1) discretizing time into fixed rounds to make deadline-aware scheduling tractable, (2) adapting parallelism at the step level and minimizing GPU hour consumption, and (3) jointly packing requests to minimize late completions. Extensive evaluation on state-of-the-art DiT models shows that TetriServe achieves up to 32% higher SLO attainment compared to existing solutions without degrading image quality.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.01565","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:52:19.000Z","registered":"2025-10-03T01:52:20.000Z","published":"2025","updated":"2026-06-19T02:17:36.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.01565","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}