<th id="S4.T1.4.1.1.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="S4.T1.4.1.1.3.1" class="ltx_text ltx_font_bold">Method</span></th>
<th id="S4.T1.4.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T1.4.1.1.4.1" class="ltx_text ltx_font_bold">FID</span> ↓</th>
<th id="S4.T1.4.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T1.4.1.1.5.1" class="ltx_text ltx_font_bold">SSIM</span> ↑</th>
<th id="S4.T1.4.1.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T1.4.1.1.6.1" class="ltx_text ltx_font_bold">PSNR</span> ↑</th>
<th id="S4.T1.4.1.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="6"><span id="S4.T1.4.1.1.7.1" class="ltx_text ltx_font_bold">Robustness under Distortions ↑</span></th>
