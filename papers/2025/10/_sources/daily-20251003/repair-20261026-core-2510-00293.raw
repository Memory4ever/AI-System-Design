<td id="A4.T6.8.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="A4.T6.8.1.2.1" class="ltx_text ltx_font_bold">Setting</span></td>
<td id="A4.T6.8.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="A4.T6.8.1.3.1" class="ltx_text ltx_font_bold">Bit Accuracy (↑)</span></td>
<td id="A4.T6.8.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="A4.T6.8.1.4.1" class="ltx_text ltx_font_bold">FID (↓)</span></td></tr>
<tr id="A4.T6.8.2" class="ltx_tr">
<th id="A4.T6.8.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" rowspan="4"><span id="A4.T6.8.2.1.1" class="ltx_text">Sampler</span></th>
