<table id="A4.T6.9" class="ltx_tabular ltx_centering ltx_figure_panel ltx_guessed_headers ltx_minipage ltx_align_middle" style="width:190.8pt;">
<thead class="ltx_thead">
<tr id="A4.T6.9.1" class="ltx_tr">
<th id="A4.T6.9.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="A4.T6.9.1.1.1" class="ltx_text ltx_font_bold">Rank</span></th>
<th id="A4.T6.9.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A4.T6.9.1.2.1" class="ltx_text ltx_font_bold">FID (↓)</span></th>
<th id="A4.T6.9.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A4.T6.9.1.3.1" class="ltx_text ltx_font_bold">Bit Accuracy (↑)</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A4.T6.9.2" class="ltx_tr">
<th id="A4.T6.9.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t">64</th>
<td id="A4.T6.9.2.2" class="ltx_td ltx_align_center ltx_border_t">27.7</td>
<td id="A4.T6.9.2.3" class="ltx_td ltx_align_center ltx_border_t">0.98</td></tr>
<tr id="A4.T6.9.3" class="ltx_tr">
<th id="A4.T6.9.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">32</th>
<td id="A4.T6.9.3.2" class="ltx_td ltx_align_center">28.2</td>
<td id="A4.T6.9.3.3" class="ltx_td ltx_align_center">0.96</td></tr>
<tr id="A4.T6.9.4" class="ltx_tr">
<th id="A4.T6.9.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">16</th>
<td id="A4.T6.9.4.2" class="ltx_td ltx_align_center">29.5</td>
<td id="A4.T6.9.4.3" class="ltx_td ltx_align_center">0.91</td></tr>
<tr id="A4.T6.9.5" class="ltx_tr">
<th id="A4.T6.9.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb">8</th>
