<tr id="S4.T1.4.1.3" class="ltx_tr">
<th id="S4.T1.4.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" colspan="14"><span id="S4.T1.4.1.3.1.1" class="ltx_text ltx_font_bold">Bit-Recovery Methods (Bit Accuracy)</span></th></tr>
<tr id="S4.T1.4.1.4" class="ltx_tr">
<td id="S4.T1.4.1.4.1" class="ltx_td ltx_align_left ltx_border_t" rowspan="5"><span id="S4.T1.4.1.4.1.1" class="ltx_text">SD</span></td>
<td id="S4.T1.4.1.4.2" class="ltx_td ltx_align_left ltx_border_t" rowspan="4"><span id="S4.T1.4.1.4.2.1" class="ltx_text">MS-COCO</span></td>
