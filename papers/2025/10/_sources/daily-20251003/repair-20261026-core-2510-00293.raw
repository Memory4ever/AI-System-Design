<td id="S4.T1.4.1.4.4" class="ltx_td ltx_align_center ltx_border_t">29.5 <span id="S4.T1.4.1.4.4.1" class="ltx_text" style="--ltx-fg-color:#FF8000;">(<math id="S4.T1.m1" class="ltx_Math" alttext="+0.4" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">+</mo><mn style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">0.4</mn></mrow><annotation encoding="application/x-tex">+0.4</annotation></semantics></math>)</span></td>
<td id="S4.T1.4.1.4.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.4.1.4.5.1" class="ltx_text ltx_font_bold">0.85</span></td>
<td id="S4.T1.4.1.4.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.4.1.4.6.1" class="ltx_text ltx_font_bold">27.8</span></td>
<td id="S4.T1.4.1.4.7" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.4.1.4.7.1" class="ltx_text ltx_font_bold">0.99</span></td>
<td id="S4.T1.4.1.4.8" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.4.1.4.8.1" class="ltx_text ltx_font_bold">0.97</span></td>
<td id="S4.T1.4.1.4.9" class="ltx_td ltx_align_center ltx_border_t">0.56</td>
