<td id="S4.T1.4.1.4.14" class="ltx_td ltx_border_t"></td></tr>
<tr id="S4.T1.4.1.5" class="ltx_tr">
<td id="S4.T1.4.1.5.1" class="ltx_td ltx_align_left">AquaLoRA</td>
<td id="S4.T1.4.1.5.2" class="ltx_td ltx_align_center">30.5 <span id="S4.T1.4.1.5.2.1" class="ltx_text" style="--ltx-fg-color:#FF8000;">(<math id="S4.T1.m2" class="ltx_Math" alttext="+1.4" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">+</mo><mn style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">1.4</mn></mrow><annotation encoding="application/x-tex">+1.4</annotation></semantics></math>)</span></td>
<td id="S4.T1.4.1.5.3" class="ltx_td ltx_align_center">0.63</td>
