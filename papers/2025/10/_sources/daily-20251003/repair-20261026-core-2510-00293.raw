<td id="S4.T1.4.1.5.11" class="ltx_td ltx_align_center">48</td>
<td id="S4.T1.4.1.5.12" class="ltx_td"></td></tr>
<tr id="S4.T1.4.1.6" class="ltx_tr">
<td id="S4.T1.4.1.6.1" class="ltx_td ltx_align_left">WOUAF</td>
<td id="S4.T1.4.1.6.2" class="ltx_td ltx_align_center"><span id="S4.T1.4.1.6.2.1" class="ltx_text ltx_font_bold">27.8</span> <span id="S4.T1.4.1.6.2.2" class="ltx_text" style="--ltx-fg-color:#FF8000;">(<math id="S4.T1.m3" class="ltx_Math" alttext="-1.3" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">−</mo><mn style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">1.3</mn></mrow><annotation encoding="application/x-tex">-1.3</annotation></semantics></math>)</span></td>
<td id="S4.T1.4.1.6.3" class="ltx_td ltx_align_center">0.73</td>
<td id="S4.T1.4.1.6.4" class="ltx_td ltx_align_center"><span id="S4.T1.4.1.6.4.1" class="ltx_text ltx_font_bold">24.9</span></td>
<td id="S4.T1.4.1.6.5" class="ltx_td ltx_align_center"><span id="S4.T1.4.1.6.5.1" class="ltx_text ltx_font_bold">0.98</span></td>
<td id="S4.T1.4.1.6.6" class="ltx_td ltx_align_center"><span id="S4.T1.4.1.6.6.1" class="ltx_text ltx_font_bold">0.96</span></td>
