<td id="A4.T6.2.1.3" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_tt"><span id="A4.T6.2.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Absolute Error</span></td></tr>
