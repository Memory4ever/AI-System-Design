<span id="A2.T6.2.1.2.1.1" class="ltx_inline-block ltx_align_top" style="width:85.4pt;">
<span id="A2.T6.2.1.2.1.1.1" class="ltx_p">“Tipping System”</span>
</span></td>
<td id="A2.T6.2.1.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">
<span id="A2.T6.2.1.2.2.1" class="ltx_inline-block ltx_align_top" style="width:34.1pt;">
