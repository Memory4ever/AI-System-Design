<span id="S4.T1.2.5.5.1" class="ltx_inline-block ltx_align_top">
<span id="S4.T1.2.5.5.1.1" class="ltx_p ltx_align_center">0.26</span>
</span></td></tr>
<tr id="S4.T1.2.6" class="ltx_tr">
<td id="S4.T1.2.6.1" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:4.0pt;padding-right:4.0pt;">Dynamic</td>
