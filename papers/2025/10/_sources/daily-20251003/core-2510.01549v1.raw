<tr id="A1.T3.2.9" class="ltx_tr">
<th id="A1.T3.2.9.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb ltx_border_r">MIRA (Ours)</th>
<td id="A1.T3.2.9.2" class="ltx_td ltx_align_center ltx_border_bb">25.964</td>
