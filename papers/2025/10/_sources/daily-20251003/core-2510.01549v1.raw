<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E30.m1" class="ltx_Math" alttext="\displaystyle\max_{z}\mathcal{J}_{\text{MIRA}}(z,c)" display="inline" intent=":literal"><semantics><mrow><mrow><munder><mi>max</mi><mi>z</mi></munder><mo lspace="0.167em">⁡</mo><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mtext>MIRA</mtext></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\max_{z}\mathcal{J}_{\text{MIRA}}(z,c)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E30.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq\min_{z}\left[\mathbb{E}_{x_{0:T}\sim p_{\theta}(\cdot|z,c)}\log\frac{p_{\theta}(\cdot|z,c)}{\frac{1}{Z(c)}p_{\theta}(\cdot|z_{0},c)\exp(\frac{1}{\beta}R(x_{0:T},c))}-\log Z(c)\right]," display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><munder><mi>min</mi><mi>z</mi></munder><mrow><mo>[</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo>∼</mo><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></msub><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mrow><mfrac><mn>1</mn><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msub><mrow></mrow><mn>0</mn></msub><mo>,</mo><mi>c</mi><mo rspace="0.167em" stretchy="false">)</mo><mi>exp</mi><mo stretchy="false">(</mo><mfrac><mn>1</mn><mi>β</mi></mfrac><mi>R</mi><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>−</mo><mi>log</mi><mi>Z</mi><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\min_{z}\left[\mathbb{E}_{x_{0:T}\sim p_{\theta}(\cdot|z,c)}\log\frac{p_{\theta}(\cdot|z,c)}{\frac{1}{Z(c)}p_{\theta}(\cdot|z_{0},c)\exp(\frac{1}{\beta}R(x_{0:T},c))}-\log Z(c)\right],</annotation></semantics></math></td>
