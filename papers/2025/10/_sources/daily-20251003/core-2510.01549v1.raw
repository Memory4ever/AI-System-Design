<td id="A1.T3.2.4.2" class="ltx_td ltx_align_center">23.298</td>
<td id="A1.T3.2.4.3" class="ltx_td ltx_align_center">6.027</td></tr>
<tr id="A1.T3.2.5" class="ltx_tr">
