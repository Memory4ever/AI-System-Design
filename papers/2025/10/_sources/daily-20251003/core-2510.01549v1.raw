<th id="A1.T1.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Brightness <math id="A1.T1.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></th>
