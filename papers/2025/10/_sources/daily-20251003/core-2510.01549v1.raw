<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E32.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq\min_{z}\left[\mathbb{E}_{x_{0:T}\sim p_{\theta}(\cdot|z,c)}\log\frac{p_{\theta}(\cdot|z,c)}{p_{\theta}(\cdot|z^{*},c)}-\log Z(c)\right]," display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><munder><mi>min</mi><mi>z</mi></munder><mrow><mo>[</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo>∼</mo><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></msub><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msup><mrow></mrow><mo>∗</mo></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>−</mo><mi>log</mi><mi>Z</mi><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\min_{z}\left[\mathbb{E}_{x_{0:T}\sim p_{\theta}(\cdot|z,c)}\log\frac{p_{\theta}(\cdot|z,c)}{p_{\theta}(\cdot|z^{*},c)}-\log Z(c)\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(32)</span></td></tr></tbody>
<tbody id="A1.E33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E33.m1" class="ltx_math_unparsed" alttext="\displaystyle\hskip 11.38092pt\text{where \hskip 5.69046pt }p_{\theta}(\cdot|z^{*},c)=\frac{1}{Z(c)}p_{\theta}(\cdot|z_{0},c)\exp(\frac{1}{\beta}R(x_{0:T},c))." display="inline" intent=":literal"><semantics><mrow><mtext>where </mtext><msub><mi>p</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>z</mi><mo>∗</mo></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><msub><mi>p</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>z</mi><mn>0</mn></msub><mo>,</mo><mi>c</mi><mo rspace="0.167em" stretchy="false">)</mo></mrow><mi>exp</mi><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mi>R</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 11.38092pt\text{where \hskip 5.69046pt }p_{\theta}(\cdot|z^{*},c)=\frac{1}{Z(c)}p_{\theta}(\cdot|z_{0},c)\exp(\frac{1}{\beta}R(x_{0:T},c)).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(33)</span></td></tr></tbody>
<tbody id="A1.E34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E34.m1" class="ltx_Math" alttext="\displaystyle\max_{\mathbf{z}}\mathcal{J}_{\text{MIRA}}(z,c)" display="inline" intent=":literal"><semantics><mrow><mrow><munder><mi>max</mi><mi>𝐳</mi></munder><mo lspace="0.167em">⁡</mo><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mtext>MIRA</mtext></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\max_{\mathbf{z}}\mathcal{J}_{\text{MIRA}}(z,c)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E34.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq\min_{z}\left[d_{\text{KL}}[p_{\theta}(x_{0:T}|z,c)\ \|\ p_{\theta}(x_{0:T}|z^{*},c)]-\log Z(c)\right]." display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><munder><mi>min</mi><mi>z</mi></munder><mrow><mo>[</mo><msub><mi>d</mi><mtext>KL</mtext></msub><mrow><mo stretchy="false">[</mo><msub><mi>p</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><mo>,</mo><mi>c</mi><mo rspace="0.222em" stretchy="false">)</mo></mrow><mo rspace="0.667em">∥</mo><msub><mi>p</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>z</mi><mo>∗</mo></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>−</mo><mi>log</mi><mi>Z</mi><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\min_{z}\left[d_{\text{KL}}[p_{\theta}(x_{0:T}|z,c)\ \|\ p_{\theta}(x_{0:T}|z^{*},c)]-\log Z(c)\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(34)</span></td></tr></tbody>
</table>
<p id="A1.SS10.p4.1" class="ltx_p">Since <math id="A1.SS10.p4.m1" class="ltx_Math" alttext="Z(c)" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z(c)</annotation></semantics></math> does not depend on <math id="A1.SS10.p4.m2" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math>, the minimum is achieved when the KL term is zero, which holds when the two distributions are identical, i.e.,</p>
<table id="A1.EGx24" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E35.m1" class="ltx_math_unparsed" alttext="\displaystyle p_{\theta}(x_{0:T}|z^{*},c)=\frac{1}{Z(c)}p_{\theta}(x_{0:T}|z_{0},c)\exp(\frac{1}{\beta}R(x_{0:T},c))." display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>z</mi><mo>∗</mo></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><msub><mi>p</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>z</mi><mn>0</mn></msub><mo>,</mo><mi>c</mi><mo rspace="0.167em" stretchy="false">)</mo></mrow><mi>exp</mi><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mi>R</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle p_{\theta}(x_{0:T}|z^{*},c)=\frac{1}{Z(c)}p_{\theta}(x_{0:T}|z_{0},c)\exp(\frac{1}{\beta}R(x_{0:T},c)).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(35)</span></td></tr></tbody>
</table>
<p id="A1.SS10.p4.2" class="ltx_p">Taking the logarithm on both sides and rearranging the terms, we get</p>
<table id="A1.EGx25" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E36.m1" class="ltx_math_unparsed" alttext="\displaystyle R(x_{0:T},c)=\beta\log Z(c)+\beta\log\frac{p_{\theta}(x_{0:T}|z,c)}{p_{\theta}(x_{0:T}|z_{0},c)}." display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>β</mi><mi>log</mi><mi>Z</mi><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>β</mi><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msub><mrow></mrow><mn>0</mn></msub><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle R(x_{0:T},c)=\beta\log Z(c)+\beta\log\frac{p_{\theta}(x_{0:T}|z,c)}{p_{\theta}(x_{0:T}|z_{0},c)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(36)</span></td></tr></tbody>
</table>
<p id="A1.SS10.p4.3" class="ltx_p">This means, from <a href="#A1.E28" title="In A.10 Derivation of DPO Objective ‣ Appendix A Appendix ‣ MIRA: Towards Mitigating Reward Hacking in Inference-Time Alignment of T2I Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">28</span></a>,</p>
<table id="A1.E37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E37.m1" class="ltx_math_unparsed" alttext="r(x_{0},c)=\beta\log Z(c)+\beta\mathbb{E}_{x_{1:T}\sim p_{\theta}(\cdot|x_{0},z,c)}\left[\log\frac{p_{\theta}(x_{0:T}|z,c)}{p_{\theta}(x_{0:T}|z_{0},c)}\right]." display="block" intent=":literal"><semantics><mrow><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>β</mi><mi>log</mi><mi>Z</mi><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>β</mi><msub><mi>𝔼</mi><mrow><mi>x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo>∼</mo><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><mo>,</mo><mi>z</mi><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><mi>log</mi><mfrac><mrow><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msub><mrow></mrow><mn>0</mn></msub><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mfrac><mo>]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">r(x_{0},c)=\beta\log Z(c)+\beta\mathbb{E}_{x_{1:T}\sim p_{\theta}(\cdot|x_{0},z,c)}\left[\log\frac{p_{\theta}(x_{0:T}|z,c)}{p_{\theta}(x_{0:T}|z_{0},c)}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(37)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS10.p5" class="ltx_para ltx_noindent">
<p id="A1.SS10.p5.1" class="ltx_p">Assume that we have access to a dataset <math id="A1.SS10.p5.m1" class="ltx_Math" alttext="\{(z^{(1)},x_{0}^{(1)}),(z^{(2)},x_{0}^{(2)}),c\}_{i=1}^{N}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msubsup><mi>x</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msubsup><mi>x</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><annotation encoding="application/x-tex">\{(z^{(1)},x_{0}^{(1)}),(z^{(2)},x_{0}^{(2)}),c\}_{i=1}^{N}</annotation></semantics></math>, where the generated image <math id="A1.SS10.p5.m2" class="ltx_Math" alttext="x_{0}^{(1)}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">x_{0}^{(1)}</annotation></semantics></math> is preferred over <math id="A1.SS10.p5.m3" class="ltx_Math" alttext="x_{0}^{(2)}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">x_{0}^{(2)}</annotation></semantics></math>. Under the Bradley-Terry model, the human preference distribution can be written as:</p>
<table id="A1.EGx26" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex12.m1" class="ltx_Math" alttext="\displaystyle P^{*}(x_{0}^{(1)}\succ x_{0}^{(2)}|z^{(1)},z^{(2)},c)" display="inline" intent=":literal"><semantics><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>x</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>≻</mo><msubsup><mi>x</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle P^{*}(x_{0}^{(1)}\succ x_{0}^{(2)}|z^{(1)},z^{(2)},c)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex12.m2" class="ltx_Math" alttext="\displaystyle=\frac{\exp(r^{*}(x_{0}^{(1)},c))}{\exp(r^{*}(x_{0}^{(1)},c))+\exp(r^{*}(x_{0}^{(2)},c))}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>r</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>r</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>r</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\exp(r^{*}(x_{0}^{(1)},c))}{\exp(r^{*}(x_{0}^{(1)},c))+\exp(r^{*}(x_{0}^{(2)},c))}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E38.m1" class="ltx_Math" alttext="\displaystyle=\sigma(r^{*}(x_{0}^{(1)},c)-r^{*}(x_{0}^{(2)},c))." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>r</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sigma(r^{*}(x_{0}^{(1)},c)-r^{*}(x_{0}^{(2)},c)).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(38)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS10.p6" class="ltx_para ltx_noindent">
<p id="A1.SS10.p6.1" class="ltx_p">Framing the problem as a binary classification, we have the negative log-likelihood loss as:</p>
<table id="A1.EGx27" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E39.m1" class="ltx_Math" alttext="\displaystyle\mathcal{L}_{\text{MIRA-DPO}}(z^{(1)},z^{(2)},c)=-\mathbb{E}_{\begin{subarray}{c}x_{0}^{(1)}\sim p_{\theta}(\cdot|z^{(1)},c)\\
x_{0}^{(2)}\sim p_{\theta}(\cdot|z^{(2)},c)\end{subarray}}[\log\sigma(r^{*}(x_{0}^{(1)},c)-r^{*}(x_{0}^{(2)},c))]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>MIRA-DPO</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>∼</mo><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd><mrow><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>∼</mo><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mtd></mtr></mtable></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>r</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}_{\text{MIRA-DPO}}(z^{(1)},z^{(2)},c)=-\mathbb{E}_{\begin{subarray}{c}x_{0}^{(1)}\sim p_{\theta}(\cdot|z^{(1)},c)\\
x_{0}^{(2)}\sim p_{\theta}(\cdot|z^{(2)},c)\end{subarray}}[\log\sigma(r^{*}(x_{0}^{(1)},c)-r^{*}(x_{0}^{(2)},c))].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(39)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS10.p7" class="ltx_para ltx_noindent">
<p id="A1.SS10.p7.1" class="ltx_p">Using <a href="#A1.E37" title="In A.10 Derivation of DPO Objective ‣ Appendix A Appendix ‣ MIRA: Towards Mitigating Reward Hacking in Inference-Time Alignment of T2I Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">37</span></a> in <a href="#A1.E39" title="In A.10 Derivation of DPO Objective ‣ Appendix A Appendix ‣ MIRA: Towards Mitigating Reward Hacking in Inference-Time Alignment of T2I Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">39</span></a>, we get</p>
<table id="A1.E40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E40.m1" class="ltx_Math" alttext="\begin{split}&amp;\mathcal{L}_{\text{MIRA-DPO}}(z^{(1)},z^{(2)},c)=\\
&amp;-\!\mathbb{E}_{\begin{subarray}{c}x_{0}^{(1)}\sim p_{\theta}(\cdot|z^{(1)},c)\\
x_{0}^{(2)}\sim p_{\theta}(\cdot|z^{(2)},c)\end{subarray}}\log\sigma\Bigg(\beta\mathbb{E}_{\begin{subarray}{c}x_{1:T}^{(1)}\sim p_{\theta}(\cdot|x_{0}^{(1)},z^{(1)},c)\\
x_{1:T}^{(2)}\sim p_{\theta}(\cdot|x_{0}^{(2)},z^{(2)},c)\end{subarray}}\left[\log\frac{p_{\theta}(x_{0:T}^{(1)}|z^{(1)},c)}{p_{\theta}(x_{0:T}^{(1)}|z_{0}^{(1)},c)}-\log\frac{p_{\theta}(x_{0:T}^{(2)}|z^{(2)},c)}{p_{\theta}(x_{0:T}^{(2)}|z_{0}^{(2)},c)}\right]\Bigg).\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>MIRA-DPO</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mpadded style="width:0.632em;" width="0.632em"><mo>−</mo></mpadded><mi>𝔼</mi><msub><mrow></mrow><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>∼</mo><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd><mrow><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>∼</mo><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mtd></mtr></mtable></msub><mi>log</mi><mi>σ</mi><mo maxsize="2.600em" minsize="2.600em">(</mo><mi>β</mi><mi>𝔼</mi><msub><mrow></mrow><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>∼</mo><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>z</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd><mrow><mi>x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>∼</mo><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>z</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mtd></mtr></mtable></msub><mo>[</mo><mi>log</mi><mfrac><mrow><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mfrac><mo>−</mo><mi>log</mi><mfrac><mrow><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mfrac><mo>]</mo><mo maxsize="2.600em" minsize="2.600em">)</mo><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}&amp;\mathcal{L}_{\text{MIRA-DPO}}(z^{(1)},z^{(2)},c)=\\
&amp;-\!\mathbb{E}_{\begin{subarray}{c}x_{0}^{(1)}\sim p_{\theta}(\cdot|z^{(1)},c)\\
x_{0}^{(2)}\sim p_{\theta}(\cdot|z^{(2)},c)\end{subarray}}\log\sigma\Bigg(\beta\mathbb{E}_{\begin{subarray}{c}x_{1:T}^{(1)}\sim p_{\theta}(\cdot|x_{0}^{(1)},z^{(1)},c)\\
x_{1:T}^{(2)}\sim p_{\theta}(\cdot|x_{0}^{(2)},z^{(2)},c)\end{subarray}}\left[\log\frac{p_{\theta}(x_{0:T}^{(1)}|z^{(1)},c)}{p_{\theta}(x_{0:T}^{(1)}|z_{0}^{(1)},c)}-\log\frac{p_{\theta}(x_{0:T}^{(2)}|z^{(2)},c)}{p_{\theta}(x_{0:T}^{(2)}|z_{0}^{(2)},c)}\right]\Bigg).\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(40)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS10.p8" class="ltx_para ltx_noindent">
<p id="A1.SS10.p8.1" class="ltx_p">Since we assume <math id="A1.SS10.p8.m1" class="ltx_Math" alttext="x_{0}^{(1)}\succ x_{0}^{(2)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>x</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>≻</mo><msubsup><mi>x</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">x_{0}^{(1)}\succ x_{0}^{(2)}</annotation></semantics></math>, we know <math id="A1.SS10.p8.m2" class="ltx_Math" alttext="x_{0}^{w}:=x_{0}^{(1)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>x</mi><mn>0</mn><mi>w</mi></msubsup><mo>:=</mo><msubsup><mi>x</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">x_{0}^{w}:=x_{0}^{(1)}</annotation></semantics></math> and <math id="A1.SS10.p8.m3" class="ltx_Math" alttext="x_{0}^{l}:=x_{0}^{(2)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>x</mi><mn>0</mn><mi>l</mi></msubsup><mo>:=</mo><msubsup><mi>x</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">x_{0}^{l}:=x_{0}^{(2)}</annotation></semantics></math>. We can rewrite <a href="#A1.E40" title="In A.10 Derivation of DPO Objective ‣ Appendix A Appendix ‣ MIRA: Towards Mitigating Reward Hacking in Inference-Time Alignment of T2I Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">40</span></a> as</p>
<table id="A1.E41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E41.m1" class="ltx_Math" alttext="\begin{split}&amp;\mathcal{L}_{\text{MIRA-DPO}}(z^{w},z^{l},c)=\\
&amp;-\!\mathbb{E}_{\begin{subarray}{c}x_{0}^{w}\sim p_{\theta}(\cdot|z^{w},c)\\
x_{0}^{l}\sim p_{\theta}(\cdot|z^{l},c)\end{subarray}}\log\sigma\Bigg(\beta\mathbb{E}_{\begin{subarray}{c}x_{1:T}^{w}\sim p_{\theta}(\cdot|x_{0}^{w},z^{w},c)\\
x_{1:T}^{l}\sim p_{\theta}(\cdot|x_{0}^{l},z^{l},c)\end{subarray}}\left[\log\frac{p_{\theta}(x_{0:T}^{w}|z^{w},c)}{p_{\theta}(x_{0:T}^{w}|z_{0}^{w},c)}-\log\frac{p_{\theta}(x_{0:T}^{l}|z^{l},c)}{p_{\theta}(x_{0:T}^{l}|z_{0}^{l},c)}\right]\Bigg),\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>MIRA-DPO</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>z</mi><mi>w</mi></msup><mo>,</mo><msup><mi>z</mi><mi>l</mi></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mpadded style="width:0.632em;" width="0.632em"><mo>−</mo></mpadded><mi>𝔼</mi><msub><mrow></mrow><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>w</mi></msup><mo>∼</mo><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msup><mrow></mrow><mi>w</mi></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd><mrow><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>l</mi></msup><mo>∼</mo><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msup><mrow></mrow><mi>l</mi></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mtd></mtr></mtable></msub><mi>log</mi><mi>σ</mi><mo maxsize="2.600em" minsize="2.600em">(</mo><mi>β</mi><mi>𝔼</mi><msub><mrow></mrow><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><msup><mrow></mrow><mi>w</mi></msup><mo>∼</mo><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>w</mi></msup><mo>,</mo><mi>z</mi><msup><mrow></mrow><mi>w</mi></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd><mrow><mi>x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><msup><mrow></mrow><mi>l</mi></msup><mo>∼</mo><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>l</mi></msup><mo>,</mo><mi>z</mi><msup><mrow></mrow><mi>l</mi></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mtd></mtr></mtable></msub><mo>[</mo><mi>log</mi><mfrac><mrow><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><msup><mrow></mrow><mi>w</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msup><mrow></mrow><mi>w</mi></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><msup><mrow></mrow><mi>w</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>w</mi></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mfrac><mo>−</mo><mi>log</mi><mfrac><mrow><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><msup><mrow></mrow><mi>l</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msup><mrow></mrow><mi>l</mi></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><msup><mrow></mrow><mi>l</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>l</mi></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mfrac><mo>]</mo><mo maxsize="2.600em" minsize="2.600em">)</mo><mo>,</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}&amp;\mathcal{L}_{\text{MIRA-DPO}}(z^{w},z^{l},c)=\\
&amp;-\!\mathbb{E}_{\begin{subarray}{c}x_{0}^{w}\sim p_{\theta}(\cdot|z^{w},c)\\
x_{0}^{l}\sim p_{\theta}(\cdot|z^{l},c)\end{subarray}}\log\sigma\Bigg(\beta\mathbb{E}_{\begin{subarray}{c}x_{1:T}^{w}\sim p_{\theta}(\cdot|x_{0}^{w},z^{w},c)\\
x_{1:T}^{l}\sim p_{\theta}(\cdot|x_{0}^{l},z^{l},c)\end{subarray}}\left[\log\frac{p_{\theta}(x_{0:T}^{w}|z^{w},c)}{p_{\theta}(x_{0:T}^{w}|z_{0}^{w},c)}-\log\frac{p_{\theta}(x_{0:T}^{l}|z^{l},c)}{p_{\theta}(x_{0:T}^{l}|z_{0}^{l},c)}\right]\Bigg),\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(41)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS10.p9" class="ltx_para ltx_noindent">
<p id="A1.SS10.p9.1" class="ltx_p">which can be conceptually understood as the standard DPO loss, <math id="A1.SS10.p9.m1" class="ltx_Math" alttext="\mathcal{L}=-\mathbb{E}[\log\sigma(\hat{r}^{w}-\hat{r}^{l})]" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>=</mo><mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>w</mi></msup><mo>−</mo><msup><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>l</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}=-\mathbb{E}[\log\sigma(\hat{r}^{w}-\hat{r}^{l})]</annotation></semantics></math>. Here, we define the implicit, regularized MIRA reward <math id="A1.SS10.p9.m2" class="ltx_Math" alttext="\hat{r}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>r</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{r}</annotation></semantics></math> as the log-ratio of the noise-optimized and reference model probabilities, which is practically realized using our score-based surrogate. Hence, this is our formulation in the main paper.</p>
</div>
<div id="A1.SS10.p10" class="ltx_para ltx_noindent">
<p id="A1.SS10.p10.1" class="ltx_p"><span id="A1.SS10.p10.1.1" class="ltx_text ltx_font_bold">Practically, we can use our score function surrogate.</span></p>
</div>
<div id="A1.SS10.p11" class="ltx_para ltx_noindent">
<p id="A1.SS10.p11.1" class="ltx_p">By Jensen’s inequality,</p>
<table id="A1.E42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E42.m1" class="ltx_math_unparsed" alttext="\mathcal{L}_{\text{MIRA-DPO}}(z^{w},z^{l},c)\leq-\!\log\sigma\Bigg(\beta\mathbb{E}_{\begin{subarray}{c}x_{0:T}^{w}\sim p_{\theta}(\cdot|z^{w},c)\\
x_{0:T}^{l}\sim p_{\theta}(\cdot|z^{l},c)\end{subarray}}\Bigg[\log\frac{p_{\theta}(x_{0:T}^{w}|z^{w},c)}{p_{\theta}(x_{0:T}^{w}|z_{0}^{w},c)}-\log\frac{p_{\theta}(x_{0:T}^{l}|z^{l},c)}{p_{\theta}(x_{0:T}^{l}|z_{0}^{l},c)}\Bigg]\Bigg)." display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>MIRA-DPO</mtext></msub><mrow><mo stretchy="false">(</mo><msup><mi>z</mi><mi>w</mi></msup><mo>,</mo><msup><mi>z</mi><mi>l</mi></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">≤</mo><mo lspace="0em" rspace="0.052em">−</mo><mi>log</mi><mi>σ</mi><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mi>β</mi><msub><mi>𝔼</mi><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>x</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><msup><mrow></mrow><mi>w</mi></msup><mo>∼</mo><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msup><mrow></mrow><mi>w</mi></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd><mrow><mi>x</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><msup><mrow></mrow><mi>l</mi></msup><mo>∼</mo><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msup><mrow></mrow><mi>l</mi></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mtd></mtr></mtable></msub><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mi>log</mi><mfrac><mrow><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><msup><mrow></mrow><mi>w</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msup><mrow></mrow><mi>w</mi></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><msup><mrow></mrow><mi>w</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>w</mi></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mfrac><mo>−</mo><mi>log</mi><mfrac><mrow><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><msup><mrow></mrow><mi>l</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msup><mrow></mrow><mi>l</mi></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><msup><mrow></mrow><mi>l</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>l</mi></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mfrac><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{MIRA-DPO}}(z^{w},z^{l},c)\leq-\!\log\sigma\Bigg(\beta\mathbb{E}_{\begin{subarray}{c}x_{0:T}^{w}\sim p_{\theta}(\cdot|z^{w},c)\\
x_{0:T}^{l}\sim p_{\theta}(\cdot|z^{l},c)\end{subarray}}\Bigg[\log\frac{p_{\theta}(x_{0:T}^{w}|z^{w},c)}{p_{\theta}(x_{0:T}^{w}|z_{0}^{w},c)}-\log\frac{p_{\theta}(x_{0:T}^{l}|z^{l},c)}{p_{\theta}(x_{0:T}^{l}|z_{0}^{l},c)}\Bigg]\Bigg).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(42)</span></td></tr></tbody>
</table>
<p id="A1.SS10.p11.2" class="ltx_p">Therefore,</p>
<table id="A1.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex13.m1" class="ltx_Math" alttext="\begin{split}\mathcal{L}_{\text{MIRA-DPO}}(z^{w},z^{l},c)&amp;\leq-\!\log\sigma\bigg(\beta d_{\text{KL}}\left[p_{\theta}(x_{0:T}^{w}|z^{w},c)\ \|\ p_{\theta}(x_{0:T}^{w}|z_{0}^{w},c)\right]\\
&amp;\hskip 99.58464pt-\beta d_{\text{KL}}\left[p_{\theta}(x_{0:T}^{l}|z^{l},c)\ \|\ p_{\theta}(x_{0:T}^{l}|z_{0}^{l},c)\right]\bigg).\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>MIRA-DPO</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>z</mi><mi>w</mi></msup><mo>,</mo><msup><mi>z</mi><mi>l</mi></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo rspace="0em">≤</mo><mpadded style="width:0.632em;" width="0.632em"><mo lspace="0em">−</mo></mpadded><mi>log</mi><mi>σ</mi><mo maxsize="2.100em" minsize="2.100em">(</mo><mi>β</mi><mi>d</mi><msub><mrow></mrow><mtext>KL</mtext></msub><mo>[</mo><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><msup><mrow></mrow><mi>w</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msup><mrow></mrow><mi>w</mi></msup><mo>,</mo><mi>c</mi><mo rspace="0.722em" stretchy="false">)</mo><mo rspace="1.167em">∥</mo><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><msup><mrow></mrow><mi>w</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>w</mi></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo><mo>]</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>−</mo><mi>β</mi><mi>d</mi><msub><mrow></mrow><mtext>KL</mtext></msub><mo>[</mo><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><msup><mrow></mrow><mi>l</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msup><mrow></mrow><mi>l</mi></msup><mo>,</mo><mi>c</mi><mo rspace="0.722em" stretchy="false">)</mo><mo rspace="1.167em">∥</mo><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><msup><mrow></mrow><mi>l</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>l</mi></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo><mo>]</mo><mo maxsize="2.100em" minsize="2.100em">)</mo><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\mathcal{L}_{\text{MIRA-DPO}}(z^{w},z^{l},c)&amp;\leq-\!\log\sigma\bigg(\beta d_{\text{KL}}\left[p_{\theta}(x_{0:T}^{w}|z^{w},c)\ \|\ p_{\theta}(x_{0:T}^{w}|z_{0}^{w},c)\right]\\
&amp;\hskip 99.58464pt-\beta d_{\text{KL}}\left[p_{\theta}(x_{0:T}^{l}|z^{l},c)\ \|\ p_{\theta}(x_{0:T}^{l}|z_{0}^{l},c)\right]\bigg).\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS10.p12" class="ltx_para ltx_noindent">
<p id="A1.SS10.p12.1" class="ltx_p">As we have shown previously in <a href="#A1.SS9" title="A.9 Derivation of the Practical Objective for Differentiable Rewards ‣ Appendix A Appendix ‣ MIRA: Towards Mitigating Reward Hacking in Inference-Time Alignment of T2I Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.9</span></a>, we can approximate the KL terms. Our final loss is</p>
<table id="A1.E43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E43.m1" class="ltx_Math" alttext="\begin{split}&amp;\mathcal{L}_{\text{MIRA-DPO}}(z^{w},z^{l},c)\\
&amp;\hskip 56.9055pt=-\!\log\sigma\bigg(\beta\mathbb{E}_{x_{0:T}^{w}\sim p_{\theta}(\cdot|z^{w},c)}\bigg[\sum_{t=0}^{T-1}\sigma_{t}^{2}\left(\|s(x_{t}^{w}|z_{0}^{w},c)\|^{2}-\|s(x_{t}^{w}|z^{w},c)\|^{2}\right)\bigg]\\
&amp;\hskip 85.35826pt-\beta\mathbb{E}_{x_{0:T}^{l}\sim p_{\theta}(\cdot|z^{l},c)}\bigg[\sum_{t=0}^{T-1}\sigma_{t}^{2}\left(\|s(x_{t}^{l}|z_{0}^{l},c)\|^{2}-\|s(x_{t}^{l}|z^{l},c)\|^{2}\right)\bigg]\bigg).\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>MIRA-DPO</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>z</mi><mi>w</mi></msup><mo>,</mo><msup><mi>z</mi><mi>l</mi></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo rspace="0em">=</mo><mpadded style="width:0.632em;" width="0.632em"><mo lspace="0em">−</mo></mpadded><mi>log</mi><mi>σ</mi><mo maxsize="2.100em" minsize="2.100em">(</mo><mi>β</mi><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><msup><mrow></mrow><mi>w</mi></msup><mo>∼</mo><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msup><mrow></mrow><mi>w</mi></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></msub><mo maxsize="2.100em" minsize="2.100em">[</mo><mo lspace="0em" movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>σ</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo>(</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>s</mi><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mi>w</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>w</mi></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0em">∥</mo><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">−</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>s</mi><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mi>w</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msup><mrow></mrow><mi>w</mi></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><msup><mrow></mrow><mn>2</mn></msup><mo>)</mo><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>−</mo><mi>β</mi><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><msup><mrow></mrow><mi>l</mi></msup><mo>∼</mo><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msup><mrow></mrow><mi>l</mi></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></msub><mo maxsize="2.100em" minsize="2.100em">[</mo><mo lspace="0em" movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>σ</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo>(</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>s</mi><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mi>l</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>l</mi></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0em">∥</mo><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">−</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>s</mi><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mi>l</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><msup><mrow></mrow><mi>l</mi></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><msup><mrow></mrow><mn>2</mn></msup><mo>)</mo><mo maxsize="2.100em" minsize="2.100em">]</mo><mo maxsize="2.100em" minsize="2.100em">)</mo><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}&amp;\mathcal{L}_{\text{MIRA-DPO}}(z^{w},z^{l},c)\\
&amp;\hskip 56.9055pt=-\!\log\sigma\bigg(\beta\mathbb{E}_{x_{0:T}^{w}\sim p_{\theta}(\cdot|z^{w},c)}\bigg[\sum_{t=0}^{T-1}\sigma_{t}^{2}\left(\|s(x_{t}^{w}|z_{0}^{w},c)\|^{2}-\|s(x_{t}^{w}|z^{w},c)\|^{2}\right)\bigg]\\
&amp;\hskip 85.35826pt-\beta\mathbb{E}_{x_{0:T}^{l}\sim p_{\theta}(\cdot|z^{l},c)}\bigg[\sum_{t=0}^{T-1}\sigma_{t}^{2}\left(\|s(x_{t}^{l}|z_{0}^{l},c)\|^{2}-\|s(x_{t}^{l}|z^{l},c)\|^{2}\right)\bigg]\bigg).\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(43)</span></td></tr></tbody>
</table>
</div>
</section>
