lse">)</mo></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">z_{0}^{w}\leftarrow z_{0}^{(2)},z_{0}^{l}\leftarrow z_{0}^{(1)}</annotation></semantics></math>

</div>
