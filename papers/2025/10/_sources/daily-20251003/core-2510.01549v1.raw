              <math id="algx1.l7.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{MIRA-DPO}}\leftarrow\text{compute\_loss}(x_{0}^{w},x_{0}^{l},z^{w},z^{l},z_{0}^{w},z_{0}^{l})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>MIRA-DPO</mtext></msub><mo stretchy="false">←</mo><mrow><mtext>compute_loss</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mn>0</mn><mi>w</mi></msubsup><mo>,</mo><msubsup><mi>x</mi><mn>0</mn><mi>l</mi></msubsup><mo>,</mo><msup><mi>z</mi><mi>w</mi></msup><mo>,</mo><msup><mi>z</mi><mi>l</mi></msup><mo>,</mo><msubsup><mi>z</mi><mn>0</mn><mi>w</mi></msubsup><mo>,</mo><msubsup><mi>z</mi><mn>0</mn><mi>l</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{MIRA-DPO}}\leftarrow\text{compute\_loss}(x_{0}^{w},x_{0}^{l},z^{w},z^{l},z_{0}^{w},z_{0}^{l})</annotation></semantics></math> <span id="algx1.l7.2" class="ltx_text" style="float:right;"><span id="algx1.l7.2.1" class="ltx_text ltx_font_italic">// Compute loss according to <a href="#A1.E8" title="In A.2 Algorithms ‣ Appendix A Appendix ‣ MIRA: Towards Mitigating Reward Hacking in Inference-Time Alignment of T2I Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">8</span></a></span>
</span>
</div>
<div id="algx1.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">8:</span>
              
              
              <math id="algx1.l8.m1" class="ltx_Math" alttext="z^{w}\leftarrow z^{w}-\alpha\nabla_{\!z^{w}}\mathcal{L}_{\text{MIRA-DPO}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>z</mi><mi>w</mi></msup><mo stretchy="false">←</mo><mrow><msup><mi>z</mi><mi>w</mi></msup><mo>−</mo><mrow><mi>α</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><msup><mi>z</mi><mi>w</mi></msup></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>MIRA-DPO</mtext></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">z^{w}\leftarrow z^{w}-\alpha\nabla_{\!z^{w}}\mathcal{L}_{\text{MIRA-DPO}}</annotation></semantics></math> <span id="algx1.l8.2" class="ltx_text" style="float:right;"><span id="algx1.l8.2.1" class="ltx_text ltx_font_italic">// Update noise vectors (also updating <math id="algx1.l8.m2" class="ltx_Math" alttext="z^{(1)}" display="inline" intent=":literal"><semantics><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">z^{(1)}</annotation></semantics></math> and <math id="algx1.l8.m3" class="ltx_Math" alttext="z^{(2)}" display="inline" intent=":literal"><semantics><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">z^{(2)}</annotation></semantics></math>)</span> </span>
</div>
