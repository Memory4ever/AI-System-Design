{"data":[{"id":"10.48550/arxiv.2510.22477","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22477","identifiers":[{"identifier":"2510.22477","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yijia","familyName":"Fan","name":"Fan, Yijia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jusheng","familyName":"Zhang","name":"Zhang, Jusheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Yang","name":"Yang, Jing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Keze","familyName":"Wang","name":"Wang, Keze","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Agent-GSPO: Communication-Efficient Multi-Agent Systems via Group Sequence Policy Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-26T01:27:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:47:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"To combat the prohibitive communication costs of ``free-for-all\" multi-agent systems (MAS), we introduce \\textbf{Agent-GSPO}, a framework that directly optimizes for token economy using sequence-level reinforcement learning. Agent-GSPO leverages the stable and memory-efficient Group Sequence Policy Optimization (GSPO) algorithm to train agents on a communication-aware reward that explicitly penalizes verbosity. Across seven reasoning benchmarks, Agent-GSPO not only achieves new state-of-the-art performance but does so with a fraction of the token consumption of existing methods. By fostering emergent strategies like ``strategic silence,\" our approach provides a practical blueprint for developing scalable and economically viable multi-agent systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22477","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:16:18Z","registered":"2025-10-28T03:16:19Z","published":null,"updated":"2025-10-28T03:16:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":1,"totalPages":1,"page":1},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026query=registered%3A%5B2025-10-27T16%3A00%3A00Z%20TO%202025-10-28T15%3A59%3A59Z%5D%20AND%20doi%3A10.48550%2Farxiv.2510.22477%20AND%20titles.title%3Aagent\u0026page%5Bsize%5D=100"}}