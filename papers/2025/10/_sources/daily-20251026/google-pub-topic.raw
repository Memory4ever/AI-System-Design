    <div class="row-card__body">
        
          <a class="row-card__heading glue-link" href=https://research.google/pubs/robust-wireless-resource-allocation-against-adversarial-jamming/ >
            
              Robust Wireless Resource Allocation Against Adversarial Jamming
            
          </a>
        
        <div class="row-card__subheading">
          
            
              
                
                  
                    <div class="row-card__subheading__item small-text">
                      
                        Christos Tsoufis
                      
                    </div>
                
              
            
              
                
                  
