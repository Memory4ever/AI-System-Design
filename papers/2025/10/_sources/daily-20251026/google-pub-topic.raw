                        Dionysia Triantafyllopoulou
                      
                    </div>
                  
              
            
              
                
                  
                    <div class="row-card__subheading__spacer"></div>
                    <div class="row-card__subheading__item small-text">
                      
                        <a class="row-card__small-link" href="/people/kostaskollias/">
                          Kostas Kollias
                        </a>
                      
                    </div>
                  
              
            
              
                
                  
                    <div class="row-card__subheading__spacer"></div>
