                        Abhinav Valada
                      
                    </div>
                  
              
            
              
                
                  
                    <div class="row-card__subheading__spacer"></div>
                    <div class="row-card__subheading__item small-text">
                      
                        Liam Paul
                      
                    </div>
                  
              
            
              
                
                  
                    <div class="row-card__subheading__spacer"></div>
                    <div class="row-card__subheading__item small-text">
                      
                        <a class="row-card__small-link" href="/people/federicotombari/">
                          Federico Tombari
                        </a>
                      
                    </div>
                  
              
            
              
                
                  
                    <div class="row-card__subheading__spacer"></div>
                    <div class="row-card__subheading__item small-text">
                      
                        Luca Carlone
                      
                    </div>
                  
              
            
              
                
                  
                    <div class="row-card__subheading__spacer"></div>
                    <div class="row-card__subheading__item small-text">
                      
                        Kai Arras
                      
                    </div>
                  
              
            
          
          
          <div class="row-card__subheading__spacer"></div>
