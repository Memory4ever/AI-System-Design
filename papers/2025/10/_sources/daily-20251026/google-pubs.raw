                        David Oswald
                      
                    </div>
                  
              
            
              
                
                  
                    <div class="row-card__subheading__spacer"></div>
                    <div class="row-card__subheading__item small-text">
                      
                        Martin Thompson
                      
                    </div>
                  
              
            
              
                
                  
                    <div class="row-card__subheading__spacer"></div>
                    <div class="row-card__subheading__item small-text">
                      
                        Kaveh Razavi
                      
                    </div>
                  
              
            
              
                
                  
                    <div class="row-card__subheading__spacer"></div>
                    <div class="row-card__subheading__item small-text">
                      
                        Ingrid Verbauwhede
                      
                    </div>
                  
              
            
              
                
                  
                    <div class="row-card__subheading__spacer"></div>
                    <div class="row-card__subheading__item small-text">
                      
                        Jo Van Bulck
                      
                    </div>
                  
              
            
          
          
          <div class="row-card__subheading__spacer"></div>
          <div class="row-card__subheading__item small-text">
            ACM Conference on Computer and Communications Security (CCS) (2026)
          </div>
          
