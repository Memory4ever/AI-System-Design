      <a href="/search/?searchtype=author&amp;query=Ying%2C+Z">Zonghao Ying</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Wang%2C+L">Le Wang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Xiao%2C+Y">Yisong Xiao</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Wang%2C+J">Jiakai Wang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Ma%2C+Y">Yuqing Ma</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Guo%2C+J">Jinyang Guo</a>, 
      
