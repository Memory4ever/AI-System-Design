        <span>&nbsp;[<a href="https://arxiv.org/pdf/2507.22827">pdf</a>, <a href="https://arxiv.org/ps/2507.22827">ps</a>, <a href="https://arxiv.org/format/2507.22827">other</a>]&nbsp;</span>
