      <a href="/search/?searchtype=author&amp;query=Marc%2C+G+S+D+S">Guillaume Sauvage De Saint Marc</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Chari%2C+P">Pradyumna Chari</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Raskar%2C+R">Ramesh Raskar</a>
      
