        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.18121">pdf</a>, <a href="https://arxiv.org/ps/2510.18121">ps</a>, <a href="https://arxiv.org/format/2510.18121">other</a>]&nbsp;</span>
