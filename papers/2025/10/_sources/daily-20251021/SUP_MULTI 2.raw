        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.16870">pdf</a>, <a href="https://arxiv.org/ps/2510.16870">ps</a>, <a href="https://arxiv.org/format/2510.16870">other</a>]&nbsp;</span>
