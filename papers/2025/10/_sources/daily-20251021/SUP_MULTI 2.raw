      <a href="/search/?searchtype=author&amp;query=Przebieracz%2C+M">Mateusz Przebieracz</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Cygan%2C+M">Marek Cygan</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zieli%C5%84ski%2C+B">Bartosz Zieliński</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Wo%C5%82czyk%2C+M">Maciej Wołczyk</a>
      
