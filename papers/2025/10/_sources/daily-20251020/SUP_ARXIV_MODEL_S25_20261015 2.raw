        <span>&nbsp;[<a href="https://arxiv.org/pdf/2506.02921">pdf</a>, <a href="https://arxiv.org/ps/2506.02921">ps</a>, <a href="https://arxiv.org/format/2506.02921">other</a>]&nbsp;</span>
