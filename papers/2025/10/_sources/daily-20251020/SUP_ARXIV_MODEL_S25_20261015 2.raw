      <a href="/search/?searchtype=author&amp;query=Erdogan%2C+M">Mete Erdogan</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Tonin%2C+F">Francesco Tonin</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Cevher%2C+V">Volkan Cevher</a>
      
