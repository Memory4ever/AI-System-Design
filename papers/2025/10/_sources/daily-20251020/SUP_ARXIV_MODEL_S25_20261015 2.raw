        <span>&nbsp;[<a href="https://arxiv.org/pdf/2509.20149">pdf</a>, <a href="https://arxiv.org/ps/2509.20149">ps</a>, <a href="https://arxiv.org/format/2509.20149">other</a>]&nbsp;</span>
