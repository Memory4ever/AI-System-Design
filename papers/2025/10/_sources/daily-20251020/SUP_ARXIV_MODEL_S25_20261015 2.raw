        <span>&nbsp;[<a href="https://arxiv.org/pdf/2505.06493">pdf</a>, <a href="https://arxiv.org/ps/2505.06493">ps</a>, <a href="https://arxiv.org/format/2505.06493">other</a>]&nbsp;</span>
