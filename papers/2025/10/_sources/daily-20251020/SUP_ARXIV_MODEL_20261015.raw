      <a href="/search/?searchtype=author&amp;query=Eltawil%2C+A+M">Ahmed M. Eltawil</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Fouda%2C+M+E">Mohammed E. Fouda</a>
      
