        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.10252">pdf</a>, <a href="https://arxiv.org/ps/2510.10252">ps</a>, <a href="https://arxiv.org/format/2510.10252">other</a>]&nbsp;</span>
