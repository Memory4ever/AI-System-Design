01.67" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.68" class="ltx_text ltx_lst_identifier ltx_font_typewriter">and</span><span id="lstnumberx101.69" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.70" class="ltx_text ltx_lst_identifier ltx_font_typewriter">their</span><span id="lstnumberx101.71" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.72" class="ltx_text ltx_lst_identifier ltx_font_typewriter">respective</span><span id="lstnumberx101.73" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.74" class="ltx_text ltx_lst_identifier ltx_font_typewriter">behaviors</span><span id="lstnumberx101.75" class="ltx_text ltx_font_typewriter">.</span>
