<th id="A3.T4.6.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="A3.T4.6.2.6.1" class="ltx_text ltx_font_bold">Weighted <math id="A3.T4.m4" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math></span></th>
