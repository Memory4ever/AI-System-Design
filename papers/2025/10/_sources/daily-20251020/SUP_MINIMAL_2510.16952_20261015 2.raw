<tr id="A3.T4.6.2" class="ltx_tr">
<th id="A3.T4.6.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row"><span id="A3.T4.6.2.1.1" class="ltx_text ltx_font_bold">Metric</span></th>
<th id="A3.T4.6.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="A3.T4.6.2.2.1" class="ltx_text ltx_font_bold">Spearman’s <math id="A3.T4.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math></span></th>
