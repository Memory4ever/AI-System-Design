sparencyFooterCta2\":\"API 平台\"},\"Harness\":{\"Index\":{\"harnessNavDownload\":\"下载桌面端\",\"harnessHeaderDownload\":\"下载\",\"harnessOpenMenu\":\"打开菜单\",\"harnessCloseMenu\":\"关闭菜单\",\"harnessMetaTitle\":\"DeepSeek Harness｜共探智能上限\",\"harnessMetaDesc\":\"使用 DeepSeek Harness 整理文档、分析表格、编写代码和安排定时任务，通过可自由组合的插件拓展 Agent 能力。\",\"harnessHeroTitlePre\":\"DeepSeek Harness\",\"harnessHeroTitlePost\":\"现在，开箱即用\",\"harnessHeroSubtitle\":\"DeepSeek Harness 预览版\",\"harnessPreviewBadge\":\"预览版\",\"harnessPreviewLabel\":\"DeepSeek Harness 预览版\",\"harnessHeroDesc\":\"无论处理日常工作、编写代码，还是构建自己的 Harness，都可以从这里开始。\",\"harnessHeroDesc2\":\"DeepSeek Harness 面向全球开放测试并同步开源，以可自由组合的插件，拓展 Agent 能力。\",\"harnessHeroGithub\":\"查看 GitHub\",\"harnessHeroDownload\":\"下载 macOS 版\",\"harnessHeroDownloadOptions\":\"桌面端下载选项\",\"harnessHeroDownloadMac\":\"macOS（Apple 芯片）\",\"harnessHeroDownloadWindows\":\"Windows（64 位）\",\"harnessHeroScreenshotAlt\":\"DeepSeek Harness 桌面端界面，包含工作区侧栏和对话输入框\",\"harnessHeroCopy\":\"复制\",\"harnessHeroCopied\":\"已复制\",\"harnessHeroWebTab\":\"一键使用\",\"harnessHeroStartTab\":\"源码安装\",\"harnessWhyTitle\":\"能力不断拓展，工作由你掌握\",\"harnessWhyFormula\":\"Agent = Model + Harness\",\"harnessWhyP1\":\"Harness 连接模型与工具，协助你完成各类任务。\",\"harnessWhyP2\":\"\",\"harnessPillar1Title\":\"Cordis 内核\",\"harnessPillar1En\":\"CORDIS KERNEL\",\"harnessPillar1Desc\":\"Cordis 内核只负责插件的加载、卸载和依赖关系，不承载 Agent 的具体能力。\",\"harnessPillar2Title\":\"插件提供能力\",\"harnessPillar2En\":\"CAPABILITIES AS PLUGINS\",\"harnessPillar2Desc\":\"模型、工具、技能、会话、沙箱、存储、循环、调度、UI 等所有 Agent 能力均由插件提供，并通过 Cordis 服务与事件彼此协作。\",\"harnessPillar3Title\":\"配置层自由组合\",\"harnessPillar3En\":\"COMPOSE IN CONFIGURATION\",\"harnessPillar3Desc\":\"开发者无需改动源码，即可在配置层选择、替换或扩展任一能力。\",\"harnessFeatEyebrow\":\"设计思路\",\"harnessFeatTitle\":\"一切皆插件，运行有迹可循\",\"harnessFeat1Label\":\"一切皆插件\",\"harnessFeat1DescPrefix\":\"DeepSeek Harness 基于 \",\"harnessFeat1DescSuffix\":\" 插件系统构建。模型、工具、技能、会话、沙箱、存储、循环、调度、UI 等所有 Agent 能力均由插件提供，并通过 Cordis 服务与事件彼此协作。开发者无需改动 DeepSeek Harness 源码，即可在配置层选择、替换或扩展任一能力。\",\"harnessFeat1Alt\":\"通过 Cordis 配置组合模型、工具、存储和 Agent Loop\",\"harnessFeat1ScreenshotAlt\":\"DeepSeek Harness 插件管理页，展示官方插件列表和毛玻璃工作区侧栏\",\"harnessFeat2Label\":\"每一次运行都有迹可循\",\"harnessFeat2Desc\":\"模型看到的一切都会写入仅追加设计的会话日志，包括系统提示词、思维链、工具调用与结果、子 Agent 调度，以及每一次上下文注入。在 Trajectory 视图中，你可以按来源查看这些信息。恢复、分叉、检索与回放也共享同一份事件流。\",\"harnessFeat2Alt\":\"从同一份会话日志还原完整运行过程\",\"harnessFeat3Label\":\"多种运行模式\",\"harnessFeat3Desc\":\"标准模式提供完整的工具组合；PTC 模式通过模型生成的一段代码组合多轮工具调用；极简模式仅保留一个 shell 工具与一个文件编辑工具，用于最小化环境下的模型基准测试；创造模式可以检查当前运行时、在内存中试验 Cordis 插件，并据此组合和创作新的模式。\",\"harnessModePlaceholder\":\"描述你想要构建的内容\",\"harnessModeStandardName\":\"标准模式\",\"harnessModeStandardDesc\":\"功能完整的编码 Agent，支持文件编辑、Shell、文件与网页检索、Skills、计划、目标、子代理和工作流。\",\"harnessModeCodeName\":\"PTC 模式\",\"harnessModeCodeDesc\":\"具备标准模式的全部能力，并通过 Code Mode SDK 呈现工具，让模型用一个 TypeScript 程序组合多步操作。\",\"harnessModeMinimalName\":\"极简模式\",\"harnessModeMinimalDesc\":\"仅提供持久 bash 与 str_replace_editor 的双工具编码 Agent。\",\"harnessModeCordisName\":\"创造模式\",\"harnessModeCordisDesc\":\"用于创建自定义 Agent preset：具备标准模式的全部能力，并提供运行时检查、插件实验和 preset 创作指导。\",\"harnessDemoTitle\":\"自定义你的 DeepSeek Harness\",\"harnessDemoDesc\":\"观看演示视频，了解如何实时自定义页面元素、工具与 Agent 预设。\",\"harnessDemoAlt\":\"DeepSeek Harness 产品功能演示视频\",\"harnessUseEyebrow\":\"开始使用\",\"harnessUseTitle\":\"开发者体验\",\"harnessUse1Label\":\"命令启动\",\"harnessUse1Desc\":\"安装 Node.js 后，通过 npx 启动 Web UI。\",\"harnessUse1Alt\":\"DeepSeek Harness 深色 Web UI 分析项目并切换对话与 Trajectory 视图\",\"harnessUse2Label\":\"源码安装\",\"harnessUse2Desc\":\"获取完整项目源码，并按照仓库说明完成安装。\",\"harnessUse2Alt\":\"从源码克隆、安装、构建并启动 DeepSeek Harness Web UI\",\"harnessCtaTitle\":\"加入 DSH 插件生态\",\"harnessCtaDesc\":\"DeepSeek Harness 预览版的核心插件和基础 API 将持续迭代。我们期待与全球用户和开发者一起，在开源、开放、可复用、可组合的基础设施之上，共同探索智能上限。\",\"harnessCtaDocs\":\"开发者文档\",\"harnessCtaPaper\":\"Cordis 论文\",\"harnessCtaPlugins\":\"社区插件\",\"harnessFooterCopyright\":\"© 2026 杭州深度求索人工智能基础技术研究有限公司 版权所有\",\"harnessFooterPolicyLinks\":\"政策与说明\",\"harnessFooterSafeUse\":\"安全使用政策\",\"harnessFooterDataProcessing\":\"数据处理说明\",\"wechatLabel\":\"微信公众号\",\"wechatTooltip\":\"扫码关注\",\"harnessFooterLicense\":\"开源 · MIT\",\"harnessFeat3Alt\":\"新会话界面展开模式选择器，列出标准、PTC、极简与创造四种模式\",\"harnessFooterPrivacyPolicy\":\"隐私政策\",\"harnessFooterTermsOfUse\":\"用户协议\",\"harnessWhyTitlePrefix\":\"\",\"harnessWhyTitleSuffix\":\"让 Agent 在真实场景中持续工作\",\"harnessCtaEyebrow\":\"开发者预览版\",\"harnessHeroDownloadForWindows\":\"下载 Windows 版\",\"harnessHeroDownloadDesktop\":\"下载桌面端\",\"harnessHeroDownloadMacNote\":\"macOS 13 或更高版本\",\"harnessHeroDownloadWindowsNote\":\"Windows 10 或更高版本\"},\"Capabilities\":{\"plugins\":{\"title\":\"一切皆插件\",\"description\":\"安装现有插件，或在「创造模式」中通过对话创建插件，扩展工具、技能和界面。\",\"imageAlt\":\"DeepSeek Harness 插件管理页面，展示官方插件列表与添加插件入口\"},\"trace\":{\"title\":\"开发者工具\",\"description\":\"支持开发者查看执行轨迹与详细运行信息，排查工具调用和任务执行中的各类问题。\",\"imageAlt\":\"DeepSeek Harness 运行轨迹视图，展示时间线、工具调用记录与执行详情\"},\"deliverables\":{\"title\":\"完成各类任务\",\"description\":\"整理文档、分析表格、编写代码，直接预览任务成果，并通过对话持续完善。\"},\"workflow\":{\"title\":\"适应你的工作方式\",\"description\":\"启用自动化任务插件，随时发起任务，让重复工作按计划执行。掌握关键进展，按需展开工具调用详情。\"},\"pauseAnimation\":\"暂停演示\",\"playAnimation\":\"继续演示\"},\"WorkflowPreview\":{\"accessibleLabel\":\"工作方式示意动画：依次以项目周报、销售汇总和项目测试为例，展示创建定时任务的输入、等待触发的结果，以及收起执行过程后保留的任务卡片。仅为演示，不会创建实际任务。\",\"pauseAnimation\":\"暂停任务演示\",\"playAnimation\":\"继续任务演示\",\"working\":\"深度求索中\",\"finished\":\"已完成工作\",\"toolTitle\":\"创建定时任务\",\"input\":\"输入\",\"scheduledFor\":\"计划时间\",\"repeat\":\"重复\",\"status\":\"状态\",\"scheduled\":\"等待触发\",\"open\":\"打开\",\"scenarios\":{\"report\":{\"title\":\"项目周报\",\"prompt\":\"整理本周项目记录，生成周报。\",\"request\":\"每周五 17:00（北京时间），整理本周项目记录，生成周报。\",\"confirmation\":\"已创建「项目周报」，每周五 17:00（北京时间）触发。\",\"repeat\":\"每周 周五 17:00（Asia/Shanghai）\",\"frequency\":\"每周五 17:00（UTC+08:00 · 中国标准时间）\"},\"sales\":{\"title\":\"销售数据汇总\",\"prompt\":\"汇总销售表格，标出异常变化。\",\"request\":\"每天 09:00（北京时间），汇总销售表格，标出异常变化。\",\"confirmation\":\"已创建「销售数据汇总」，每天 09:00（北京时间）触发。\",\"repeat\":\"每天 09:00（Asia/Shanghai）\",\"frequency\":\"每天 09:00（UTC+08:00 · 中国标准时间）\"},\"tests\":{\"title\":\"项目测试汇总\",\"prompt\":\"运行项目测试，汇总失败项。\",\"request\":\"每周一 10:00（北京时间），运行项目测试，汇总失败项。\",\"confirmation\":\"已创建「项目测试汇总」，每周一 10:00（北京时间）触发。\",\"repeat\":\"每周 周一 10:00（Asia/Shanghai）\",\"frequency\":\"每周一 10:00（UTC+08:00 · 中国标准时间）\"}}},\"DeliverablesPreview\":{\"accessibleLabel\":\"文件与代码处理能力示意：Word、Excel、HTML、TypeScript、Python、PDF、Markdown 文件卡片向上轮播，旁边的代码差异面板展示两行新增、一行删除。\",\"pauseAnimation\":\"暂停文件轮播\",\"playAnimation\":\"继续文件轮播\",\"htmlName\":\"index.html\",\"htmlType\":\"HTML 页面\",\"typescriptName\":\"label.ts\",\"typescriptType\":\"TypeScript 代码\",\"pythonName\":\"analyze.py\",\"pythonType\":\"Python 脚本\",\"wordName\":\"简报.docx\",\"wordType\":\"Word 文档\",\"excelName\":\"数据.xlsx\",\"excelType\":\"Excel 表格\",\"pdfName\":\"报告.pdf\",\"pdfType\":\"PDF 文档\",\"markdownName\":\"README.md\",\"markdownType\":\"Markdown 文档\",\"reviewTab\":\"第 1 轮改动\"},\"DesktopPreview\":{\"accessibleLabel\":\"DeepSeek Harness 会话界面预览：毛玻璃侧栏旁，用户询问“可以介绍一下自己吗？”，DSH 介绍自身和五类工作能力，输入框位于底部。\",\"conversationTitle\":\"认识 DeepSeek Harness\",\"conversationQuestion\":\"可以介绍一下自己吗？\",\"conversationTime\":\"2分钟\",\"thinkingCompleted\":\"已思考\",\"conversationIntro\":\"我是 DeepSeek Harness，DeepSeek 开源的 harness 架构，基于 \u003ccordis\u003eCordis\u003c/cordis\u003e 的「一切皆插件」架构构建。我既可以是桌面应用，也可以通过代码启动为网页。\",\"conversationLead\":\"我可以帮你：\",\"conversationItem1\":\"\u003cstrong\u003e辅助日常工作\u003c/strong\u003e —— 整理资料、分析表格、撰写文档、制作汇报。\",\"conversationItem2\":\"\u003cstrong\u003e写代码、改仓库\u003c/strong\u003e —— 理解项目、修复问题、开发功能、运行测试。\",\"conversationItem3\":\"\u003cstrong\u003e查资料、核对信息\u003c/strong\u003e —— 搜索资料、交叉查证，给出有来源的结论。\",\"conversationItem4\":\"\u003cstrong\u003e处理耗时任务\u003c/strong\u003e —— 运行脚本、批量处理文件，后台执行、随时查看进度。\",\"conversationItem5\":\"\u003cstrong\u003e安装插件、扩展能力\u003c/strong\u003e —— 使用现有插件，或编写自己的插件，定制适合你的工作方式。\",\"conversationItem1Compact\":\"\u003cstrong\u003e日常工作\u003c/strong\u003e —— 整理资料、分析表格、制作汇报。\",\"conversationItem2Compact\":\"\u003cstrong\u003e编写代码\u003c/strong\u003e —— 修复问题、开发功能、运行测试。\",\"conversationItem3Compact\":\"\u003cstrong\u003e资料查证\u003c/strong\u003e —— 搜索资料、核对信息、标注来源。\",\"conversationItem4Compact\":\"\u003cstrong\u003e后台任务\u003c/strong\u003e —— 运行脚本、批量处理、查看进度。\",\"conversationItem5Compact\":\"\u003cstrong\u003e插件扩展\u003c/strong\u003e —— 安装或自制插件，适配工作需求。\",\"conversationMore\":\"更多事情，都可以交给我。\",\"newSession\":\"新会话\",\"plugins\":\"插件\",\"automation\":\"自动化任务\",\"workspace\":\"工作区\",\"defaultWorkspace\":\"默认工作区\",\"session1\":\"生成 Q3 数据汇总 PPT\",\"session1Time\":\"9分钟\",\"session2\":\"准备明天评审会的议题清单\",\"session2Time\":\"1天\",\"session3\":\"重构登录模块的校验逻辑\",\"session3Time\":\"13分钟\",\"session4\":\"给销售报表补上同比/环比列\",\"session4Time\":\"4天\",\"session5\":\"梳理接口文档并补充示例\",\"session5Time\":\"8天\",\"session6\":\"分析当前代码的问题以及修复\",\"session6Time\":\"9天\",\"folder1\":\"数据分析项目\",\"folder2\":\"DSH 插件开发\",\"folder3\":\"周报汇总\",\"welcome\":\"探索未至之境\",\"preview\":\"预览版\",\"placeholder\":\"描述你想要构建的内容，/调用指令，@文件或对话\",\"permission\":\"工作区内修改\"},\"SafeUsePolicy\":{\"metaTitle\":\"安全使用政策\",\"metaDesc\":\"了解 DeepSeek Harness 的安全建议、使用规范与安全问题反馈方式。\",\"title\":\"安全使用政策\",\"backHome\":\"返回 Harness 首页\"},\"DataProcessingStatement\":{\"metaTitle\":\"数据处理说明\",\"metaDesc\":\"了解 DeepSeek Harness 默认在本地处理的数据、可能上报的信息以及第三方服务的数据处理责任。\",\"title\":\"数据处理说明\",\"backHome\":\"返回 Harness 首页\"},\"PrivacyPolicy\":{\"metaTitle\":\"隐私政策\",\"metaDesc\":\"DeepSeek Harness 隐私政策\",\"title\":\"DeepSeek Harness 隐私政策\",\"backHome\":\"返回 Harness 首页\"},\"TermsOfUse\":{\"metaTitle\":\"用户协议\",\"metaDesc\":\"DeepSeek Harness 用户协议\",\"title\":\"DeepSeek Harness 用户协议\",\"backHome\":\"返回 Harness 首页\"},\"PluginsPreview\":{\"accessibleLabel\":\"插件创建示意动画：在创造模式中请求番茄时钟，模拟创建后出现停在 25:00 的挂件。随后依次浏览七项官方插件，最后展示已启用的番茄时钟，挂件始终保留。仅为演示，不会实际安装插件或运行计时器。\",\"prompt\":\"帮我写一个「番茄时钟」插件\",\"creatorMode\":\"创造模式\",\"workspaceWrite\":\"工作区内修改\",\"working\":\"深度求索中\",\"finished\":\"用时 5分24秒\",\"completion\":\"番茄时钟悬浮插件已做好、装好并验证通过。\",\"tools\":{\"skill\":\"加载技能\",\"providers\":\"检查提供方\",\"query\":\"查询运行时\",\"read\":\"读取\",\"think\":