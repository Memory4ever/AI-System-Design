        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.16907">pdf</a>, <a href="https://arxiv.org/ps/2510.16907">ps</a>, <a href="https://arxiv.org/format/2510.16907">other</a>]&nbsp;</span>
