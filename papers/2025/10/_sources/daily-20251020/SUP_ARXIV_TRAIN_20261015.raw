        <span>&nbsp;[<a href="https://arxiv.org/pdf/2502.20548">pdf</a>, <a href="https://arxiv.org/ps/2502.20548">ps</a>, <a href="https://arxiv.org/format/2502.20548">other</a>]&nbsp;</span>
