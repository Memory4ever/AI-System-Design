{"data":{"id":"10.48550/arxiv.2510.11588","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.11588","prefix":"10.48550","suffix":"arxiv.2510.11588","identifiers":[{"identifier":"2510.11588","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.11588"}],"creators":[{"name":"Liu, Jiateng","nameType":"Personal","givenName":"Jiateng","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Zhenhailong","nameType":"Personal","givenName":"Zhenhailong","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Huang, Xiaojiang","nameType":"Personal","givenName":"Xiaojiang","familyName":"Huang","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Yingjie","nameType":"Personal","givenName":"Yingjie","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Fan, Xing","nameType":"Personal","givenName":"Xing","familyName":"Fan","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Xiang","nameType":"Personal","givenName":"Xiang","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Guo, Chenlei","nameType":"Personal","givenName":"Chenlei","familyName":"Guo","affiliation":[],"nameIdentifiers":[]},{"name":"Sarikaya, Ruhi","nameType":"Personal","givenName":"Ruhi","familyName":"Sarikaya","affiliation":[],"nameIdentifiers":[]},{"name":"Ji, Heng","nameType":"Personal","givenName":"Heng","familyName":"Ji","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Analyzing and Internalizing Complex Policy Documents for LLM Agents"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-13T16:30:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-14T02:08:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Large Language Model (LLM)-based agentic systems rely on in-context policy documents encoding diverse business rules. As requirements grow, these documents expand rapidly, causing high computational overhead. This motivates developing internalization methods that embed policy documents into model priors while preserving performance. Prior prompt compression work targets generic prompts, but agentic policy documents span multiple complexity levels and require deeper reasoning, making internalization harder. We introduce CC-Gen, an agentic benchmark generator with Controllable Complexity across four levels, enabling systematic evaluation of agents' ability to handle complexity and offering a unified framework for assessing policy internalization. Our analysis shows that complex policy specifications governing workflows pose major reasoning challenges. Supporting internalization with gold user agent interaction trajectories containing chain-of-thought (CoT) annotations via supervised fine-tuning (SFT) is data-intensive and degrades sharply as policy complexity increases. To mitigate data and reasoning burdens, we propose Category-Aware Policy Continued Pretraining (CAP-CPT). Our automated pipeline parses policy documents to extract key specifications, grouping them into factual, behavioral, and conditional categories, and isolating complex conditions that drive workflow complexity. This guides targeted data synthesis and enables agents to internalize policy information through an autoregressive pretraining loss. Experiments show CAP-CPT improves SFT baselines in all settings, with up to 41% and 22% gains on Qwen-3-32B, achieving 97.3% prompt length reduction on CC-Gen and further enhancing tau-Bench with minimal SFT data.","descriptionType":"Abstract"},{"description":"42 pages","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.11588","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-14T03:57:47.000Z","registered":"2025-10-14T03:57:48.000Z","published":"2025","updated":"2025-10-14T03:57:48.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.11588","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}