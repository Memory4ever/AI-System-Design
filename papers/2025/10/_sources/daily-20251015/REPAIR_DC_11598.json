{"data":{"id":"10.48550/arxiv.2510.11598","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.11598","prefix":"10.48550","suffix":"arxiv.2510.11598","identifiers":[{"identifier":"2510.11598","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.11598"}],"creators":[{"name":"Cheng, Bo","nameType":"Personal","givenName":"Bo","familyName":"Cheng","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Xu","nameType":"Personal","givenName":"Xu","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Jinda","nameType":"Personal","givenName":"Jinda","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Chang, Yi","nameType":"Personal","givenName":"Yi","familyName":"Chang","affiliation":[],"nameIdentifiers":[]},{"name":"Wu, Yuan","nameType":"Personal","givenName":"Yuan","familyName":"Wu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MeTA-LoRA: Data-Efficient Multi-Task Fine-Tuning for Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-13T16:37:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-14T02:08:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Low-Rank Adaptation (LoRA) has emerged as one of the most widely used parameter-efficient fine-tuning (PEFT) methods for adapting large language models (LLMs) to downstream tasks. While highly effective in single-task settings, it struggles to efficiently leverage inter-task knowledge in complex multi-task learning scenarios, often requiring substantial task-specific data to achieve optimal performance. To address this limitation, we introduce MeTA-LoRA, a two-stage optimization framework that significantly improves data efficiency in multi-task adaptation. In the first stage, task-specific LoRA adapters are learned using only a few samples from each involved dataset, enabling rapid adaptation without large-scale supervision. In the second stage, the shared LoRA adapter is updated by aggregating gradients from multiple tasks to promote knowledge transfer across tasks, further reducing data usage by leveraging common patterns. In both multi-task learning and multilingual learning scenarios, our method matches or surpasses the performance of traditional full-data LoRA fine-tuning approaches, while using significantly less task-specific data.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.11598","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-14T03:58:01.000Z","registered":"2025-10-14T03:58:02.000Z","published":"2025","updated":"2025-10-14T03:58:02.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.11598","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}