      <a href="/search/?searchtype=author&amp;query=Li%2C+Y">Yucheng Li</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Li%2C+X">Xiao Li</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Cheng%2C+G">Gong Cheng</a>
      
