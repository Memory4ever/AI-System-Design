      <a href="/search/?searchtype=author&amp;query=Qi%2C+B">Biqing Qi</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Liu%2C+D">Dongrui Liu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhang%2C+L">Linfeng Zhang</a>
      
