        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.09097">pdf</a>, <a href="https://arxiv.org/ps/2510.09097">ps</a>, <a href="https://arxiv.org/format/2510.09097">other</a>]&nbsp;</span>
