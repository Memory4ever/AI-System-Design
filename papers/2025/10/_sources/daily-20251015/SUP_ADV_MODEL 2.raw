      <a href="/search/?searchtype=author&amp;query=Wu%2C+K">Kai Wu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Li%2C+M">Meng Li</a>, 
      
      <a href="/search/?searchtype=author&amp;query=He%2C+Y">Yijun He</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Luo%2C+L">Lingjie Luo</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Sun%2C+J">Jiankai Sun</a>
      
