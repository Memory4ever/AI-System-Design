<td id="S4.T4.2.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T4.2.1.2.1" class="ltx_text ltx_font_bold">15 steps</span></td>
<td id="S4.T4.2.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T4.2.1.3.1" class="ltx_text ltx_font_bold">50 steps</span></td>
<td id="S4.T4.2.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T4.2.1.4.1" class="ltx_text ltx_font_bold">100 steps</span></td></tr>
