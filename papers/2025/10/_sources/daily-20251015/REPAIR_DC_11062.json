{"data":{"id":"10.48550/arxiv.2510.11062","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.11062","prefix":"10.48550","suffix":"arxiv.2510.11062","identifiers":[{"identifier":"2510.11062","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.11062"}],"creators":[{"name":"Zhao, Yujie","nameType":"Personal","givenName":"Yujie","familyName":"Zhao","affiliation":[],"nameIdentifiers":[]},{"name":"Hu, Lanxiang","nameType":"Personal","givenName":"Lanxiang","familyName":"Hu","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Yang","nameType":"Personal","givenName":"Yang","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Hou, Minmin","nameType":"Personal","givenName":"Minmin","familyName":"Hou","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Hao","nameType":"Personal","givenName":"Hao","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Ding, Ke","nameType":"Personal","givenName":"Ke","familyName":"Ding","affiliation":[],"nameIdentifiers":[]},{"name":"Zhao, Jishen","nameType":"Personal","givenName":"Jishen","familyName":"Zhao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Stronger-MAS: Multi-Agent Reinforcement Learning for Collaborative LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Multiagent Systems (cs.MA)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-13T06:55:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-14T01:35:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-14T05:12:45Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-15T00:24:00Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-12-05T05:59:28Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-12-08T01:18:59Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-12-17T00:34:16Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2025-12-18T01:12:19Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-01-29T22:54:07Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-02-02T01:10:57Z","dateType":"Updated","dateInformation":"v5"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"5","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Multi-agent systems (MAS) and reinforcement learning (RL) are widely used to enhance the agentic capabilities of large language models (LLMs). MAS improves task performance through role-based orchestration, while RL uses environmental rewards to learn stronger policies, such as GRPO-style optimization. However, applying on-policy RL to MAS remains underexplored and presents unique challenges. Algorithmically, standard GRPO grouping assumptions break down because prompts vary by role and by turn. System-wise, the training stack must support MAS-workflow rollouts and on-policy updates for both single-policy and multi-policy models.\n We propose AT-GRPO, which includes (i) an agent- and turn-wise grouped RL algorithm tailored to MAS and (ii) a training system that supports both single- and multi-policy regimes. Across game, planning, coding, and math tasks, AT-GRPO delivers substantial gains. On long-horizon planning, it increases accuracy from a 14.0 to 47.0 percent single-agent RL baseline to 96.0 to 99.5 percent. It also improves reasoning performance, with average gains of 3.87 to 7.62 percent on coding tasks and 9.0 to 17.93 percent on math. Code and environments are available at: https://github.com/pettingllms-ai/PettingLLMs.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.11062","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-14T03:44:59.000Z","registered":"2025-10-14T03:45:00.000Z","published":"2025","updated":"2026-02-02T03:25:37.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.11062","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}