{"data":{"id":"10.48550/arxiv.2510.12044","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.12044","prefix":"10.48550","suffix":"arxiv.2510.12044","identifiers":[{"identifier":"2510.12044","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.12044"}],"creators":[{"name":"Chen, Yishen","nameType":"Personal","givenName":"Yishen","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Dong, Qi","nameType":"Personal","givenName":"Qi","familyName":"Dong","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Yukun","nameType":"Personal","givenName":"Yukun","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Hierarchical Alignment: Block-Level LoRA-DPO for Preference Tuning in Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-14T00:58:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-15T00:15:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-24T15:54:38Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-27T00:43:26Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Preference tuning typically distributes adapter updates across every Transformer layer. We study how the placement of a fixed LoRA budget affects Direct Preference Optimization (DPO). Hierarchical Alignment partitions decoder depth into Local, Intermediate, and Global regions and restricts LoRA updates to a chosen contiguous block. Across Qwen and Llama models, three-seed sliding-window sweeps reveal broad low-loss basins around intermediate depth. Under exact trainableparameter matching, Middle achieves lower held-out DPO loss than an all-depth allocation on Qwen2.5-7B and Llama-3.1-8B. Generationlevel evidence is more variable. LLM judges and a blinded human study leave Selected versus All unresolved on Qwen; on Llama, two pairwise judges favor All while the human interval includes zero. Trained-adapter interventions show that learned depth components affect the optimization objective; removing the Llama Selected window also lowers generation quality. Across Qwen2.5 at 3B, 7B, and 14B, Middle versus All remains unresolved under Qwen3-Max; at 3B and 14B, both improve over Base. In our implementation, Middle also uses less peak memory and takes shorter steps than a parameter-matched all-depth allocation. Together, the results support intermediate depth as a practical starting point for fixed-budget preference tuning, though the best window and its behavioral value still need per-setting validation.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.12044","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-15T01:52:32.000Z","registered":"2025-10-15T01:52:33.000Z","published":"2025","updated":"2026-10-27T05:04:29.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.12044","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}