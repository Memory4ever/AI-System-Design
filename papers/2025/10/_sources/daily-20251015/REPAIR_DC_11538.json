{"data":{"id":"10.48550/arxiv.2510.11538","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.11538","prefix":"10.48550","suffix":"arxiv.2510.11538","identifiers":[{"identifier":"2510.11538","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.11538"}],"creators":[{"name":"Gan, Chaofan","nameType":"Personal","givenName":"Chaofan","familyName":"Gan","affiliation":[],"nameIdentifiers":[]},{"name":"Zhao, Zicheng","nameType":"Personal","givenName":"Zicheng","familyName":"Zhao","affiliation":[],"nameIdentifiers":[]},{"name":"Tu, Yuanpeng","nameType":"Personal","givenName":"Yuanpeng","familyName":"Tu","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Xi","nameType":"Personal","givenName":"Xi","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Qin, Ziran","nameType":"Personal","givenName":"Ziran","familyName":"Qin","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Tieyuan","nameType":"Personal","givenName":"Tieyuan","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Harandi, Mehrtash","nameType":"Personal","givenName":"Mehrtash","familyName":"Harandi","affiliation":[],"nameIdentifiers":[]},{"name":"Lin, Weiyao","nameType":"Personal","givenName":"Weiyao","familyName":"Lin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Massive Activations are the Key to Local Detail Synthesis in Diffusion Transformers"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-13T15:39:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-14T02:04:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-14T04:40:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-15T00:23:09Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Diffusion Transformers (DiTs) have recently emerged as a powerful backbone for visual generation. Recent observations reveal \\emph{Massive Activations} (MAs) in their internal feature maps, yet their function remains poorly understood. In this work, we systematically investigate these activations to elucidate their role in visual generation. We found that these massive activations occur across all spatial tokens, and their distribution is modulated by the input timestep embeddings. Importantly, our investigations further demonstrate that these massive activations play a key role in local detail synthesis, while having minimal impact on the overall semantic content of output. Building on these insights, we propose \\textbf{D}etail \\textbf{G}uidance (\\textbf{DG}), a MAs-driven, training-free self-guidance strategy to explicitly enhance local detail fidelity for DiTs. Specifically, DG constructs a degraded ``detail-deficient'' model by disrupting MAs and leverages it to guide the original network toward higher-quality detail synthesis. Our DG can seamlessly integrate with Classifier-Free Guidance (CFG), enabling further refinements of fine-grained details. Extensive experiments demonstrate that our DG consistently improves fine-grained detail quality across various pre-trained DiTs (\\eg, SD3, SD3.5, and Flux).","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.11538","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-14T03:56:33.000Z","registered":"2025-10-14T03:56:34.000Z","published":"2025","updated":"2025-10-15T02:24:09.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.11538","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}