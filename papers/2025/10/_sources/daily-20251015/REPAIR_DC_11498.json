{"data":{"id":"10.48550/arxiv.2510.11498","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.11498","prefix":"10.48550","suffix":"arxiv.2510.11498","identifiers":[{"identifier":"2510.11498","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.11498"}],"creators":[{"name":"Li, Yuhang","nameType":"Personal","givenName":"Yuhang","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Chenchen","nameType":"Personal","givenName":"Chenchen","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Lv, Ruilin","nameType":"Personal","givenName":"Ruilin","familyName":"Lv","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Ao","nameType":"Personal","givenName":"Ao","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Deng, Ken","nameType":"Personal","givenName":"Ken","familyName":"Deng","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Yuanxing","nameType":"Personal","givenName":"Yuanxing","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Jiaheng","nameType":"Personal","givenName":"Jiaheng","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Zhou, Wiggin","nameType":"Personal","givenName":"Wiggin","familyName":"Zhou","affiliation":[],"nameIdentifiers":[]},{"name":"Zhou, Bo","nameType":"Personal","givenName":"Bo","familyName":"Zhou","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ReLook: Vision-Grounded RL with a Multimodal LLM Critic for Agentic Web Coding"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-13T15:05:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-14T02:02:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"While Large Language Models (LLMs) excel at algorithmic code generation, they struggle with front-end development, where correctness is judged on rendered pixels and interaction. We present ReLook, an agentic, vision-grounded reinforcement learning framework that empowers an agent to close a robust generate--diagnose--refine loop by invoking a multimodal LLM (MLLM) as a tool. During training, the agent uses the MLLM-in-the-loop both as a visual critic--scoring code with screenshots--and as a source of actionable, vision-grounded feedback; a strict zero-reward rule for invalid renders anchors renderability and prevents reward hacking. To prevent behavioral collapse, we introduce Forced Optimization, a strict acceptance rule that admits only improving revisions, yielding monotonically better trajectories. At inference, we decouple the critic and run a lightweight, critic-free self-edit cycle, keeping latency comparable to base decoding while retaining most of the gains. Across three widely used benchmarks, ReLook consistently outperforms strong baselines in vision-grounded front-end code generation, highlighting the benefits of agentic perception, visual rewards, and training-inference decoupling.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.11498","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-14T03:55:35.000Z","registered":"2025-10-14T03:55:36.000Z","published":"2025","updated":"2025-10-14T03:55:36.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.11498","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}