      <a href="/search/?searchtype=author&amp;query=Nie%2C+J">Jian-Yun Nie</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Xiong%2C+G">Guojun Xiong</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Huang%2C+J">Jimin Huang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Ananiadou%2C+S">Sophia Ananiadou</a>
      
