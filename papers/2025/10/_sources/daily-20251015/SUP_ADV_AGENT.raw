      <a href="/search/?searchtype=author&amp;query=Yuan%2C+H">Haobo Yuan</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Shen%2C+T">Tiancheng Shen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhang%2C+Z">Zhuosheng Zhang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhao%2C+H">Hai Zhao</a>, 
      
