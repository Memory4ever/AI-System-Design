{"data":{"id":"10.48550/arxiv.2510.13602","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.13602","prefix":"10.48550","suffix":"arxiv.2510.13602","identifiers":[{"identifier":"2510.13602","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.13602"}],"creators":[{"name":"Huang, Yuxiang","nameType":"Personal","givenName":"Yuxiang","familyName":"Huang","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Pengjie","nameType":"Personal","givenName":"Pengjie","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Han, Jicheng","nameType":"Personal","givenName":"Jicheng","familyName":"Han","affiliation":[],"nameIdentifiers":[]},{"name":"Zhao, Weilin","nameType":"Personal","givenName":"Weilin","familyName":"Zhao","affiliation":[],"nameIdentifiers":[]},{"name":"Su, Zhou","nameType":"Personal","givenName":"Zhou","familyName":"Su","affiliation":[],"nameIdentifiers":[]},{"name":"Sun, Ao","nameType":"Personal","givenName":"Ao","familyName":"Sun","affiliation":[],"nameIdentifiers":[]},{"name":"Lyu, Hongya","nameType":"Personal","givenName":"Hongya","familyName":"Lyu","affiliation":[],"nameIdentifiers":[]},{"name":"Zhao, Hengyu","nameType":"Personal","givenName":"Hengyu","familyName":"Zhao","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Yudong","nameType":"Personal","givenName":"Yudong","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Xiao, Chaojun","nameType":"Personal","givenName":"Chaojun","familyName":"Xiao","affiliation":[],"nameIdentifiers":[]},{"name":"Han, Xu","nameType":"Personal","givenName":"Xu","familyName":"Han","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Zhiyuan","nameType":"Personal","givenName":"Zhiyuan","familyName":"Liu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"NOSA: Native and Offloadable Sparse Attention"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-15T14:33:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-16T00:54:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-29T08:26:24Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-30T01:36:01Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-09-28T14:28:14Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-09-29T03:05:15Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Decoding throughput improvements from larger inference batches are limited by GPU memory, which is largely consumed by the key-value (KV) cache. Prior training-free KV cache offloading alleviates this by keeping redundant context on the CPU and fetching only a sparse subset for attention, but it often degrades long-generation quality due to training-inference mismatch on sparse patterns. Meanwhile, trainable sparse attention is incompatible with efficient offloading, as unconstrained KV accesses may force large CPU-to-GPU transfers and erase throughput gains. To this end, we propose NOSA, a trainable sparse attention mechanism natively designed for KV cache offloading. NOSA explicitly constrains the volume of CPU-GPU KV transfers, thereby achieving low communication overhead and high decoding throughput. We further build NOSI, a KV cache offloading inference system that fully unlocks NOSA's efficiency. Empirical results on 1,3,8B LLMs demonstrate that NOSA outperforms KV cache offloading baselines on general, long-input, and long-generation tasks, while boosting decoding throughput by up to 5.04x, 1.92x, and 1.83x over FullAttn, InfLLMv2, and ShadowKV, respectively. We release our code at https://github.com/thunlp/NOSA.","descriptionType":"Abstract"},{"description":"EMNLP 2026 main","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.13602","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-16T02:05:16.000Z","registered":"2025-10-16T02:05:17.000Z","published":"2025","updated":"2026-09-29T06:57:08.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.13602","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}