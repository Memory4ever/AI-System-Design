      <a href="/search/?searchtype=author&amp;query=Javorek%2C+V">Vaclav Javorek</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Hruz%2C+M">Marek Hruz</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Alkalifah%2C+B">Badriah Alkalifah</a>, 
      
