><script>self.__next_f.push([1,"742-be36f3fff9d0d7a1.js\",\"7703\",\"static/chunks/7703-1ee5cdbec3edde5b.js\",\"3538\",\"static/chunks/3538-476e2d12dfe43ab2.js\",\"7393\",\"static/chunks/7393-eaace1b8e1c07843.js\",\"1931\",\"static/chunks/app/page-b826a9eced3b7046.js\"],\"default\"]\n19:I[67187,[\"6290\",\"static/chunks/6290-bf6412cdd60a4383.js\",\"6600\",\"static/chunks/6600-444aadec43e2d4b4.js\",\"3742\",\"static/chunks/3742-be36f3fff9d0d7a1.js\",\"7703\",\"static/chunks/7703-1ee5cdbec3edde5b.js\",\"3538\",\"static/chunks/3538-476e2d12dfe43ab2.js\",\"7393\",\"static/chunks/7393-eaace1b8e1c07843.js\",\"1931\",\"static/chunks/app/page-b826a9eced3b7046.js\"],\"default\"]\n1a:I[92978,[\"6290\",\"static/chunks/6290-bf6412cdd60a4383.js\",\"6600\",\"static/chunks/6600-444aadec43e2d4b4.js\",\"3742\",\"static/chunks/3742-be36f3fff9d0d7a1.js\",\"7703\",\"static/chunks/7703-1ee5cdbec3edde5b.js\",\"3538\",\"static/chunks/3538-476e2d12dfe43ab2.js\",\"7393\",\"static/chunks/7393-eaace1b8e1c07843.js\",\"1931\",\"static/chunks/app/page-b826a9eced3b7046.js\"],\"default\"]\nf:Tcf2,"])</script><script>self.__next_f.push([1,"{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"@id\":\"https://www.minimax.io/#organization\",\"name\":\"MiniMax\",\"legalName\":\"MiniMax\",\"url\":\"https://www.minimax.io\",\"logo\":{\"@type\":\"ImageObject\",\"@id\":\"https://www.minimax.io/#logo\",\"url\":\"https://filecdn.minimax.chat/public/58eca777-e31f-448a-9823-e2220e49b426.png\",\"contentUrl\":\"https://filecdn.minimax.chat/public/58eca777-e31f-448a-9823-e2220e49b426.png\",\"caption\":\"MiniMax\",\"width\":512,\"height\":512},\"slogan\":\"Intelligence with Everyone\",\"foundingDate\":\"2021-12\",\"description\":\"Building AGI with our mission Intelligence with Everyone. Global leader in multi-modal models and AI-native products with over 200 million users.\",\"email\":\"api@minimax.io\",\"contactPoint\":{\"@type\":\"ContactPoint\",\"contactType\":\"customer service\",\"email\":\"api@minimax.io\",\"areaServed\":\"Global\",\"availableLanguage\":[\"en\",\"zh\"]},\"sameAs\":[\"https://github.com/MiniMax-AI\",\"https://x.com/MiniMax__AI\",\"https://www.linkedin.com/company/minimax-ai/\",\"https://huggingface.co/MiniMaxAI\",\"https://minimax.io/discord\",\"https://en.wikipedia.org/wiki/MiniMax_(company)\"]},{\"@type\":\"Brand\",\"@id\":\"https://www.minimax.io/#brand\",\"name\":\"MiniMax\",\"url\":\"https://www.minimax.io\",\"logo\":\"https://filecdn.minimax.chat/public/58eca777-e31f-448a-9823-e2220e49b426.png\",\"description\":\"Building AGI with our mission Intelligence with Everyone. Global leader in multi-modal models and AI-native products with over 200 million users.\",\"slogan\":\"Intelligence with Everyone\"},{\"@type\":\"WebSite\",\"@id\":\"https://www.minimax.io/#website\",\"url\":\"https://www.minimax.io\",\"name\":\"MiniMax\",\"description\":\"Building AGI with our mission Intelligence with Everyone. Global leader in multi-modal models and AI-native products with over 200 million users.\",\"publisher\":{\"@id\":\"https://www.minimax.io/#organization\"},\"inLanguage\":\"en-US\",\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https://www.minimax.io/news\"}}},{\"@type\":\"NewsArticle\",\"@id\":\"https://www.minimax.io/blog/minimax-m2-en-1748600000#article\",\"headline\":\"MiniMax M2 \u0026 Agent: Ingenious in Simplicity\",\"description\":\"MiniMax launches and open-sources M2, an agent-first model delivering top-tier coding, tool use, and deep search at 8% of Claude Sonnet's price with 2x speed. Free API and Agent product available.\",\"image\":[\"https://filecdn.minimax.chat/public/92084bb1-5fb4-44d9-bab1-ce7f2de81a62.png\"],\"datePublished\":\"2025-10-27T00:00:00.000Z\",\"dateModified\":\"2025-10-27T00:00:00.000Z\",\"author\":{\"@id\":\"https://www.minimax.io/#organization\"},\"publisher\":{\"@id\":\"https://www.minimax.io/#organization\"},\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://www.minimax.io/blog/minimax-m2-en-1748600000\"},\"articleSection\":\"News\",\"inLanguage\":\"en-US\",\"isAccessibleForFree\":true,\"copyrightYear\":2026,\"copyrightHolder\":{\"@id\":\"https://www.minimax.io/#organization\"}},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://www.minimax.io/blog/minimax-m2-en-1748600000#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.minimax.io\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Research\",\"item\":\"https://www.minimax.io/blog\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"MiniMax M2 \u0026 Agent: Ingenious in Simplicity\",\"item\":\"https://www.minimax.io/blog/minimax-m2-en-1748600000\"}]}]}"])</script><script>self.__next_f.push([1,"7:[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$f\"}}],[\"$\",\"article\",null,{\"className\":\"max-w-[860px] mx-auto px-[24px] py-[60px]\",\"children\":[[\"$\",\"header\",null,{\"className\":\"mb-[40px]\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"text-[36px] font-[600] leading-[1.3] text-brand-1 mb-[16px]\",\"children\":\"MiniMax M2 \u0026 Agent: Ingenious in Simplicity\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-[16px] text-[14px] text-[#86909C]\",\"children\":[[\"$\",\"time\",null,{\"children\":\"2025-10-27\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"flex gap-[8px] mt-[16px] flex-wrap\",\"children\":[[\"$\",\"span\",\"AI\",{\"className\":\"px-[10px] py-[4px] text-[12px] bg-[#F4F4F4] text-zinc-700 rounded-[6px]\",\"children\":\"AI\"}],[\"$\",\"span\",\"Agent\",{\"className\":\"px-[10px] py-[4px] text-[12px] bg-[#F4F4F4] text-zinc-700 rounded-[6px]\",\"children\":\"Agent\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"prose max-w-none text-[16px] leading-[1.8] text-brand-1\",\"children\":[[\"$\",\"p\",\"0\",{\"className\":\"mb-4 leading-relaxed\",\"children\":[\"From Day 1 of our founding, we have been committed to the vision of \\\"Intelligence with Everyone.\\\"\"]}],[\"$\",\"p\",\"1\",{\"className\":\"mb-4 leading-relaxed\",\"children\":[\"Today, we are officially open-sourcing and launching \",[\"$\",\"$10\",\"1\",{\"children\":[\"$\",\"strong\",\"b\",{\"children\":\"MiniMax M2, a model born for Agents and code. At only 8% of the price of Claude Sonnet and twice the speed, it's available for free for a limited time!\"}]}]]}],[\"$\",\"ul\",\"2\",{\"className\":\"list-disc pl-6 mb-4 space-y-1\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"leading-relaxed\",\"children\":[[\"$\",\"$10\",\"0\",{\"children\":[\"$\",\"strong\",\"b\",{\"children\":\"Top-tier Coding Capabilities: \"}]}],\"Built for end-to-end development workflows, it excels in various applications such as Claude Code, Cursor, Cline, Kilo Code, and Droid.\"]}],[\"$\",\"li\",\"1\",{\"className\":\"leading-relaxed\",\"children\":[[\"$\",\"$10\",\"0\",{\"children\":[\"$\",\"strong\",\"b\",{\"children\":\"Powerful Agentic Performance: \"}]}],\"It demonstrates outstanding planning and stable execution of complex, long-chain tool-calling tasks, coordinating calls to the Shell, Browser, Python code interpreter, and various MCP tools.\"]}],[\"$\",\"li\",\"2\",{\"className\":\"leading-relaxed\",\"children\":[[\"$\",\"$10\",\"0\",{\"children\":[\"$\",\"strong\",\"b\",{\"children\":\"Ultimate Cost-Effectiveness \u0026 Speed: \"}]}],\"Through efficient design of activated parameters, we have achieved the optimal balance of intelligence, speed, and cost.\"]}]]}],[\"$\",\"p\",\"3\",{\"className\":\"mb-4 leading-relaxed\",\"children\":[\"Our team has been building a variety of Agents to help tackle the challenges of our company's rapid growth. These Agents are beginning to complete increasingly complex tasks, from analyzing online data and researching technical issues to daily programming, processing user feedback, and even screening HR resumes. These Agents, working alongside our team, are driving the company's development, building an \",[\"$\",\"$10\",\"1\",{\"children\":[\"$\",\"strong\",\"b\",{\"children\":\"AI-native organization that is evolving from developing AGI to advancing together with AGI.\"}]}],\" We have an ever-stronger conviction that AGI is a force of production, and Agents are an excellent vehicle for it, representing an evolution from the simple Q\u0026A of conversational assistants to the independent completion of complex tasks by Agents.\"]}],[\"$\",\"p\",\"4\",{\"className\":\"mb-4 leading-relaxed\",\"children\":[\"However, we found that no single model could fully meet our needs for these Agents. The challenge lies in finding a model that strikes the right balance between performance, price, and inference speed — an almost \\\"impossible triangle.\\\" \",[\"$\",\"$10\",\"1\",{\"children\":[\"$\",\"strong\",\"b\",{\"children\":\"The best overseas models offer good performance but are very expensive and relatively slow. Domestic models are cheaper, but there is a gap in their performance and speed.\"}]}],\" This has led to existing Agent products often being very expensive or slow to achieve good results.\"]}],[\"$\",\"p\",\"5\",{\"className\":\"mb-4 leading-relaxed\",\"children\":[[\"$\",\"$10\",\"0\",{\"children\":[\"$\",\"strong\",\"b\",{\"children\":\"We have been exploring whether it's possible to create a model that achieves a better balance of performance, price, and speed, thereby allowing more people to benefit from the intelligence boost of the Agent era and continuing our vision of \\\"Intelligence with Everyone.\\\"\"}]}],\" This model needs a diverse range of capabilities, including programming, tool use, logical reasoning, and knowledge, all while having extremely fast inference speeds and very low deployment costs. To this end, we developed and have now open-sourced MiniMax M2. \"]}],[\"$\",\"p\",\"6\",{\"className\":\"mb-4 leading-relaxed\",\"children\":[\"Let's first look at the three most critical capabilities for an Agent: programming, tool use, and deep search. We compared M2 with several mainstream models:\"]}],[\"$\",\"div\",\"7\",{\"className\":\"html-block\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cimg src=\\\"https://filecdn.minimax.chat/public/6379df73-178f-4d3e-849e-8bc52619328c.PNG\\\" style=\\\"max-width:100%;height:auto;display:block;margin:12px 0;border-radius:12px\\\" /\u003e\"}}],[\"$\",\"p\",\"8\",{\"className\":\"mb-4 leading-relaxed\",\"children\":[\"As you can see, the model's abilities in tool use and deep search are very close to the best overseas models. While it is slightly behind the top overseas models in programming, it is already among the best in the domestic market.\"]}],[\"$\",\"p\",\"9\",{\"className\":\"mb-4 leading-relaxed\",\"children\":[\"There are several algorithmic and cognitive advancements behind this, which we will share in due course. But \",[\"$\",\"$10\",\"1\",{\"children\":[\"$\",\"strong\",\"b\",{\"children\":\"the core principle is simple: to create a model that meets our requirements, we must first be able to use it ourselves.\"}]}],\" To achieve this, our developers, including those in business and backend teams, worked alongside algorithm engineers, investing significant effort in building environments and evaluations, and are increasingly integrating it into their daily work.\"]}],[\"$\",\"p\",\"10\",{\"className\":\"mb-4 leading-relaxed\",\"children\":[\"Once we mastered these complex scenarios, we found that by transferring our accumulated methods to traditional large model tasks like knowledge and math, we could naturally achieve excellent results. For example, on the popular Artificial Analysis benchmark, which integrates 10 test tasks, our model ranked in the top five globally:\"]}],[\"$\",\"div\",\"11\",{\"className\":\"html-block\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cimg src=\\\"https://filecdn.minimax.chat/public/3cdfba08-4c91-4c43-9faf-2a934a122d0e.PNG\\\" style=\\\"max-width:100%;height:auto;display:block;margin:12px 0;border-radius:12px\\\" /\u003e\"}}],[\"$\",\"p\",\"12\",{\"className\":\"mb-4 leading-relaxed\",\"children\":[\"We have set the API price for the model at \",[\"$\",\"$10\",\"1\",{\"children\":[\"$\",\"strong\",\"b\",{\"children\":\"$$0.30/¥2.1 RMB per million input tokens and $1.20/¥8.4 RMB per million output tokens,\"}]}],\" while providing an online inference service with a TPS (tokens per second) of around 100 (and rapidly improving). \",[\"$\",\"$10\",\"3\",{\"children\":[\"$\",\"strong\",\"b\",{\"children\":\"This price is 8% of Claude 4.5 Sonnet's, with nearly double the inference speed.\"}]}]]}],[\"$\",\"p\",\"13\",{\"className\":\"mb-4 leading-relaxed\",\"children\":[\"Over the past weekend, many enthusiastic developers from home and abroad have conducted extensive tests with us. To make it easier for everyone to explore the model's capabilities, we are extending the free trial period to November 7th, 00:00 UTC. At the same time, we have \",[\"$\",\"$10\",\"1\",{\"children\":[\"$\",\"strong\",\"b\",{\"children\":\"open-sourced the complete model weights\"}]}],\" on Hugging Face. Interested developers can deploy it themselves, with support already available from SGLang and vLLM.\"]}],[\"$\",\"p\",\"14\",{\"className\":\"mb-4 leading-relaxed\",\"children\":[\"We believe this combination of price and inference speed is an excellent choice among the current mainstream models. Let's analyze this from two perspectives.\"]}],[\"$\",\"p\",\"15\",{\"className\":\"mb-4 leading-relaxed\",\"children\":[\"First, price versus performance. A suitable model should have good performance and be affordable, falling into the green area in the chart below. Here, we use the average score from the 10 test sets on Artificial Analysis to represent performance:\"]}],[\"$\",\"div\",\"16\",{\"className\":\"html-block\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cimg src=\\\"https://filecdn.minimax.chat/public/788b51a6-ab6a-4e81-96b2-a2b4632c2eca.jpg\\\" style=\\\"max-width:100%;height:auto;display:block;margin:12px 0;border-radius:12px\\\" /\u003e\"}}],[\"$\",\"p\",\"17\",{\"className\":\"mb-4 leading-relaxed\",\"children\":[\"Next is price versus inference speed. When deploying a model, there is often a trade-off where a slower inference speed can lead to a lower price. An ideal model should be affordable and fast. We have compared several representative models:\"]}],[\"$\",\"div\",\"18\",{\"className\":\"html-block\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cimg src=\\\"https://filecdn.minimax.chat/public/4a6f4ea5-6ddf-4ca3-8546-68908cb8892c.png\\\" style=\\\"max-width:100%;height:auto;display:block;margin:12px 0;border-radius:12px\\\" /\u003e\"}}],[\"$\",\"p\",\"19\",{\"className\":\"mb-4 leading-relaxed\",\"children\":[\"In addition to this analysis of standard data, we also conducted 1-on-1 comparisons of practical performance against Claude 4.5 Sonnet and several open-source models:\"]}],[\"$\",\"div\",\"20\",{\"className\":\"html-block\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cimg src=\\\"https://filecdn.minimax.chat/public/6f66bf3f-e0d0-4399-ac68-4b61544e6f64.jpeg\\\" style=\\\"max-width:100%;height:auto;display:block;margin:12px 0;border-radius:12px\\\" /\u003e\"}}],[\"$\",\"p\",\"21\",{\"className\":\"mb-4 leading-relaxed\",\"children\":[\"These test sets will be released on GitHub this week.\"]}],[\"$\",\"p\",\"22\",{\"className\":\"mb-4 leading-relaxed\",\"children\":[\"To make it easier for everyone to use Agent-related capabilities, we have launched our M2-powered Agent product in China and upgraded the overseas version. In MiniMax Agent, we offer two modes:\"]}],[\"$\",\"ul\",\"23\",{\"className\":\"list-disc pl-6 mb-4 space-y-1\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"leading-relaxed\",\"children\":[[\"$\",\"$10\",\"0\",{\"children\":[\"$\",\"strong\",\"b\",{\"children\":\"Lightning Mode: \"}]}],\"A high-efficiency, high-speed Agent for instant output in scenarios like conversational Q\u0026A, lightweight search, and simple coding tasks. It enhances the experience of dialogue-based products with powerful agentic capabilities.\"]}],[\"$\",\"li\",\"1\",{\"className\":\"leading-relaxed\",\"children\":[[\"$\",\"$10\",\"0\",{\"children\":[\"$\",\"strong\",\"b\",{\"children\":\"Pro Mode: \"}]}],\"Delivers professional agent capabilities with optimal performance on complex, long-running tasks. It excels at in-depth research, full-stack development, creating PPTs/reports, web development, and more.\"]}]]}],[\"$\",\"div\",\"24\",{\"className\":\"html-block\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cimg src=\\\"https://filecdn.minimax.chat/public/a790c753-9a89-461c-b3ef-24a39a225734.jpeg\\\" style=\\\"max-width:100%;height:auto;display:block;margin:12px 0;border-radius:12px\\\" /\u003e\"}}],[\"$\",\"p\",\"25\",{\"className\":\"mb-4 leading-relaxed\",\"children\":[\"Benefiting from M2's inherent inference speed, the M2-powered Agent is not only cost-effective but also completes complex tasks with significantly greater fluency.\"]}],[\"$\",\"p\",\"26\",{\"className\":\"mb-4 leading-relaxed\",\"children\":[\"We are currently offering MiniMax Agent for free, until our servers can't keep up.\"]}],[\"$\",\"h3\",\"27\",{\"className\":\"text-xl font-semibold mb-3 mt-5\",\"children\":[\"How to Use\"]}],[\"$\",\"p\",\"28\",{\"className\":\"mb-4 leading-relaxed\",\"children\":[\"The general-purpose Agent product, \",[\"$\",\"$10\",\"1\",{\"children\":[\"$\",\"strong\",\"b\",{\"children\":\"MiniMax Agent,\"}]}],\" powered by MiniMax-M2, is now fully open for use and free for a limited time:\"]}],[\"$\",\"p\",\"29\",{\"className\":\"mb-4 leading-relaxed\",\"children\":[[\"$\",\"a\",\"0\",{\"href\":\"https://agent.minimax.io/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-blue-600 underline hover:text-blue-800\",\"children\":[\"https://agent.minimax.io/\"]}]]}],[\"$\",\"p\",\"30\",{\"className\":\"mb-4 leading-relaxed\",\"children\":[\"The MiniMax-M2 API is available on the \",[\"$\",\"$10\",\"1\",{\"children\":[\"$\",\"strong\",\"b\",{\"children\":\"MiniMax Open Platform\"}]}],\" and is free for a limited time:\"]}],[\"$\",\"p\",\"31\",{\"className\":\"mb-4 leading-relaxed\",\"children\":[[\"$\",\"a\",\"0\",{\"href\":\"https://platform.minimax.io/docs/api-reference/text-anthropic-api\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-blue-600 underline hover:text-blue-800\",\"children\":[\"https://platform.minimax.io/docs/api-reference/text-anthropic-api\"]}]]}],[\"$\",\"p\",\"32\",{\"className\":\"mb-4 leading-relaxed\",\"children\":[\"The MiniMax-M2 model weights have been \",[\"$\",\"$10\",\"1\",{\"children\":[\"$\",\"strong\",\"b\",{\"children\":\"open-sourced\"}]}],\" and can be deployed locally. Download from Hugging Face:\"]}],[\"$\",\"p\",\"33\",{\"className\":\"mb-4 leading-relaxed\",\"children\":[[\"$\",\"a\",\"0\",{\"href\":\"https://huggingface.co/MiniMaxAI/MiniMax-M2\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-blue-600 underline hover:text-blue-800\",\"children\":[\"https://huggingface.co/MiniMaxAI/MiniMax-M2\"]}]]}],[\"$\",\"p\",\"34\",{\"className\":\"mb-4 leading-relaxed\",\"children\":[\"We recommend using vLLM or SGLang to deploy MiniMax-M2. Recommended inference parameters: temperature=1.0, top_p=0.95, top_k=20.\"]}],[\"$\",\"div\",\"35\",{\"className\":\"html-block\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cimg src=\\\"https://filecdn.minimax.chat/public/889bb8c5-8bc9-4376-9b22-15b6e4202c31.webp\\\" style=\\\"max-width:100%;height:auto;display:block;margin:12px 0;border-radius:12px\\\" /\u003e\"}}],[\"$\",\"p\",\"36\",{\"className\":\"mb-4 leading-relaxed\",\"children\":[[\"$\",\"$10\",\"0\",{\"children\":[\"$\",\"em\",\"i\",{\"children\":\"Intelligence with Everyone.\"}]}]]}]]}]]}]]\n"])</script><script>self.__next_f.push([1,"b:[\"$\",\"html\",null,{\"lang\":\"en\",\"suppressHydrationWarning\":true,\"childre