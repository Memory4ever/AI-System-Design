="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">relevant</span><span id="lstnumberx192.19" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx192.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">audio</span><span id="lstnumberx192.21" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx192.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">and</span><span id="lstnumberx192.23" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx192.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">timestamps</span><span id="lstnumberx192.25" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx192.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">for</span><span id="lstnumberx192.27" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx192.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">my</span><span id="lstnumberx192.29" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx192.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">review</span>
