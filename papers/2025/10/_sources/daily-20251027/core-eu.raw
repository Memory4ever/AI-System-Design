<th id="S3.T2.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">GPT-4.1</th>
<td id="S3.T2.2.4.2" class="ltx_td ltx_align_center">49.5</td>
<td id="S3.T2.2.4.3" class="ltx_td ltx_align_center">[45.7, 53.2]</td>
<td id="S3.T2.2.4.4" class="ltx_td ltx_align_center">[40.2, 58.8]</td></tr>
<tr id="S3.T2.2.5" class="ltx_tr">
<th id="S3.T2.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Kimi K2</th>
<td id="S3.T2.2.5.2" class="ltx_td ltx_align_center">45.4</td>
