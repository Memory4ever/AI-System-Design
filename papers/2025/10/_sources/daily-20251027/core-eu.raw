<td id="S3.T2.2.2.4" class="ltx_td ltx_align_center ltx_border_t">[46.1, 64.5]</td></tr>
<tr id="S3.T2.2.3" class="ltx_tr">
<th id="S3.T2.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Qwen3 8B</th>
