<td id="S3.T2.2.5.4" class="ltx_td ltx_align_center">[37.4, 53.4]</td></tr>
<tr id="S3.T2.2.6" class="ltx_tr">
<th id="S3.T2.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Qwen3 32B</th>
