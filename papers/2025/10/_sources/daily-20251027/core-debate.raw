<div id="A4.T4.2.3.4.1" class="ltx_inline-block ltx_transformed_outer" style="width:41.8pt;height:6.9pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="transform:translate(-5.2pt,0.0pt) scale(0.8,1.0) ;">
