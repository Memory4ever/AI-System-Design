<figure id="A2.F8.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.20963v1/finegrained_fact_verification_llama2.png" id="A2.F8.sf2.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:170/143;" width="170" height="143" alt="Refer to caption">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(b) </span>Fact verification</figcaption>
