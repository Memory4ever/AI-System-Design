<td id="A3.T4.2.10.5" class="ltx_td ltx_align_center ltx_border_r"><span id="A3.T4.2.10.5.1" class="ltx_text" style="font-size:70%;">0.94</span></td></tr>
<tr id="A3.T4.2.11" class="ltx_tr">
