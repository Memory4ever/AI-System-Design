              <span id="lstnumberx19.2" class="ltx_text ltx_lst_space ltx_font_typewriter">  </span><span id="lstnumberx19.3" class="ltx_text ltx_font_typewriter">"</span><span id="lstnumberx19.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">description</span><span id="lstnumberx19.5" class="ltx_text ltx_font_typewriter">"</span><span id="lstnumberx19.6" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#990000;">:</span><span id="lstnumberx19.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx19.8" class="ltx_text ltx_font_typewriter">"</span><span id="lstnumberx19.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">MCP</span><span id="lstnumberx19.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx19.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">server</span><span id="lstnumberx19.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx19.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">allows</span><span id="lstnumberx19.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx19.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">fetching</span>
</div>
<div id="lstnumberx20" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">3</span>
                
                
                
              <span id="lstnumberx20.2" class="ltx_text ltx_lst_space ltx_font_typewriter">      </span><span id="lstnumberx20.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">content</span><span id="lstnumberx20.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx20.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">from</span><span id="lstnumberx20.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx20.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">arbitrary</span><span id="lstnumberx20.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx20.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">websites</span><span id="lstnumberx20.10" class="ltx_text ltx_font_typewriter">."</span><span id="lstnumberx20.11" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#990000;">,</span>
</div>
