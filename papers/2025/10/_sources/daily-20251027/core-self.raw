<td id="A7.T3.2.14.1" class="ltx_td ltx_align_left ltx_align_top">
<span id="A7.T3.2.14.1.1" class="ltx_inline-block ltx_align_top" style="width:19.9pt;">
<span id="A7.T3.2.14.1.1.1" class="ltx_p">S12</span>
</span></td>
