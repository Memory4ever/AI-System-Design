<span id="A7.T3.2.1.2.1.1" class="ltx_p">Sentences</span>
</span></td></tr>
<tr id="A7.T3.2.2" class="ltx_tr">
<td id="A7.T3.2.2.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="A7.T3.2.2.1.1" class="ltx_inline-block ltx_align_top" style="width:19.9pt;">
