<td id="S5.T2.2.7.2" class="ltx_td ltx_align_left">46.94 <math id="S5.T2.m15" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 1.61</td>
<td id="S5.T2.2.7.3" class="ltx_td ltx_align_left">31.42 <math id="S5.T2.m16" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 4.09</td>
<td id="S5.T2.2.7.4" class="ltx_td ltx_align_left"><span id="S5.T2.2.7.4.1" class="ltx_text ltx_font_bold">20.39 <math id="S5.T2.m17" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 2.95</span></td>
<td id="S5.T2.2.7.5" class="ltx_td ltx_align_left">11.87 <math id="S5.T2.m18" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 1.49</td>
<td id="S5.T2.2.7.6" class="ltx_td ltx_align_left"><span id="S5.T2.2.7.6.1" class="ltx_text ltx_font_bold">9.82 <math id="S5.T2.m19" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 1.04</span></td>
<td id="S5.T2.2.7.7" class="ltx_td ltx_align_left"><span id="S5.T2.2.7.7.1" class="ltx_text ltx_font_bold">7.79 <math id="S5.T2.m20" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.93</span></td>
