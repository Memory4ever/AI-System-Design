<tr id="S5.T2.2.8" class="ltx_tr">
<th id="S5.T2.2.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b ltx_border_l ltx_border_r">PSS-B</th>
<td id="S5.T2.2.8.2" class="ltx_td ltx_align_left ltx_border_b">46.29</td>
