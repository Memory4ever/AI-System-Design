<td id="S5.T2.2.6.3" class="ltx_td ltx_align_left ltx_border_t"><span id="S5.T2.2.6.3.1" class="ltx_text ltx_font_bold">24.81</span></td>
<td id="S5.T2.2.6.4" class="ltx_td ltx_align_left ltx_border_t">26.30</td>
