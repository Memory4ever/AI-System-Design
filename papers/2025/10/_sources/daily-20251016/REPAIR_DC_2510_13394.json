{"data":{"id":"10.48550/arxiv.2510.13394","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.13394","prefix":"10.48550","suffix":"arxiv.2510.13394","identifiers":[{"identifier":"2510.13394","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.13394"}],"creators":[{"name":"Huang, Xinmiao","nameType":"Personal","givenName":"Xinmiao","familyName":"Huang","affiliation":[],"nameIdentifiers":[]},{"name":"He, Qisong","nameType":"Personal","givenName":"Qisong","familyName":"He","affiliation":[],"nameIdentifiers":[]},{"name":"Huang, Zhenglin","nameType":"Personal","givenName":"Zhenglin","familyName":"Huang","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Boxuan","nameType":"Personal","givenName":"Boxuan","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Zhuoyun","nameType":"Personal","givenName":"Zhuoyun","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Cheng, Guangliang","nameType":"Personal","givenName":"Guangliang","familyName":"Cheng","affiliation":[],"nameIdentifiers":[]},{"name":"Dong, Yi","nameType":"Personal","givenName":"Yi","familyName":"Dong","affiliation":[],"nameIdentifiers":[]},{"name":"Huang, Xiaowei","nameType":"Personal","givenName":"Xiaowei","familyName":"Huang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Spatial-DISE: A Unified Benchmark for Evaluating Spatial Reasoning in Vision-Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-15T10:44:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-16T00:41:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-23T14:31:13Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-24T00:54:02Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02-24T00:41:17Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-02-25T01:13:17Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-08-25T16:01:24Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-08-26T01:10:38Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Spatial reasoning ability is crucial for Vision Language Models (VLMs) to support real-world applications in diverse domains including robotics, augmented reality, and autonomous navigation. Unfortunately, existing benchmarks are inadequate in assessing spatial reasoning ability, especially the \\emph{intrinsic-dynamic} spatial reasoning which is a fundamental aspect of human spatial cognition. In this paper, we propose a unified benchmark, \\textbf{Spatial-DISE}, based on a cognitively grounded taxonomy that categorizes tasks into four fundamental quadrants: \\textbf{I}ntrinsic-\\textbf{S}tatic, Intrinsic-\\textbf{D}ynamic, \\textbf{E}xtrinsic-Static, and Extrinsic-Dynamic spatial reasoning. Moreover, to address the issue of data scarcity, we develop a scalable and automated pipeline to generate diverse and verifiable spatial reasoning questions, resulting in a new \\textbf{Spatial-DISE} dataset that includes Spatial-DISE Bench (559 evaluation VQA pairs) and Spatial-DISE-12K (12K+ training VQA pairs). Our comprehensive evaluation across 28 state-of-the-art VLMs reveals that, current VLMs have a large and consistent gap to human competence, especially on multi-step multi-view spatial reasoning. Spatial-DISE offers a robust framework, valuable dataset, and clear direction for future research toward human-like spatial intelligence. Benchmark, dataset, and code will be publicly released.","descriptionType":"Abstract"},{"description":"ICLR 2026 Accepted Project Page: https://shinmohuang.github.io/spatialdise_page/","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.13394","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-16T01:59:58.000Z","registered":"2025-10-16T01:59:59.000Z","published":"2025","updated":"2026-08-26T02:37:01.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.13394","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}