<td id="Ax19.SSx1.SSSx1.p10.pic1.2.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="Ax19.SSx1.SSSx1.p10.pic1.2.2.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">0.0647</span></td></tr>
<tr id="Ax19.SSx1.SSSx1.p10.pic1.2.3" class="ltx_tr">
<td id="Ax19.SSx1.SSSx1.p10.pic1.2.3.1" class="ltx_td ltx_align_left ltx_border_b ltx_border_l ltx_border_r ltx_border_t"><span id="Ax19.SSx1.SSSx1.p10.pic1.2.3.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">(Book, Refine)</span></td>
<td id="Ax19.SSx1.SSSx1.p10.pic1.2.3.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t"><span id="Ax19.SSx1.SSSx1.p10.pic1.2.3.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">-0.03213</span></td>
<td id="Ax19.SSx1.SSSx1.p10.pic1.2.3.3" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t"><span id="Ax19.SSx1.SSSx1.p10.pic1.2.3.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">0.0605</span></td></tr>
</table></span></span></foreignObject></g></g></svg></span>
</div>
<div id="Ax19.SSx1.SSSx1.p11" class="ltx_para">
<p id="Ax19.SSx1.SSSx1.p11.1" class="ltx_p">Therefore, we update the probability of selecting each operator and meta-prompt module.</p>
</div>
<div id="Ax19.SSx1.SSSx1.p12" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="Ax19.SSx1.SSSx1.p12.pic1" class="ltx_picture" height="136.04" overflow="visible" version="1.1" viewBox="0 0 700 136.04" width="700"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,136.04) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0"><path style="stroke:none" d="M 0 15.81 L 0 120.24 C 0 128.97 7.08 136.04 15.81 136.04 L 684.19 136.04 C 692.92 136.04 700 128.97 700 120.24 L 700 15.81 C 700 7.08 692.92 0 684.19 0 L 15.81 0 C 7.08 0 0 7.08 0 15.81 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 15.81 L 1.97 111.93 L 698.03 111.93 L 698.03 15.81 C 698.03 8.16 691.84 1.97 684.19 1.97 L 15.81 1.97 C 8.16 1.97 1.97 8.16 1.97 15.81 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 120.53)"><foreignObject style="--ltx-fo-width:41.27em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="571.06"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
