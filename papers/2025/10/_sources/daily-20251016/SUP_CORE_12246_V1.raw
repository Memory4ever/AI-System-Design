<td id="Ax19.SSx1.SSSx1.p12.pic1.2.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="Ax19.SSx1.SSSx1.p12.pic1.2.2.4.1" class="ltx_text" style="--ltx-fg-color:#000000;">0.0625</span></td>
