<td id="Ax20.p1.1.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="Ax20.p1.1.1.2.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Score</span></td>
<td id="Ax20.p1.1.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="Ax20.p1.1.1.3.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Loss</span></td></tr>
<tr id="Ax20.p1.1.2" class="ltx_tr">
