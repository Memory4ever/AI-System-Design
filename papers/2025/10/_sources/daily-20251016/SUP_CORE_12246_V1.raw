<td id="Ax19.SSx1.SSSx1.p12.pic1.2.3.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="Ax19.SSx1.SSSx1.p12.pic1.2.3.4.1" class="ltx_text" style="--ltx-fg-color:#000000;">0.0625</span></td>
<td id="Ax19.SSx1.SSSx1.p12.pic1.2.3.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="Ax19.SSx1.SSSx1.p12.pic1.2.3.5.1" class="ltx_text" style="--ltx-fg-color:#000000;">0.0625</span></td></tr>
<tr id="Ax19.SSx1.SSSx1.p12.pic1.2.4" class="ltx_tr">
<td id="Ax19.SSx1.SSSx1.p12.pic1.2.4.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_t"><span id="Ax19.SSx1.SSSx1.p12.pic1.2.4.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Name</span></td>
<td id="Ax19.SSx1.SSSx1.p12.pic1.2.4.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="Ax19.SSx1.SSSx1.p12.pic1.2.4.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">0.0625</span></td>
