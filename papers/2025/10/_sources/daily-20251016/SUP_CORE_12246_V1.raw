<tr id="Sx5.T1.1.5" class="ltx_tr">
<td id="Sx5.T1.1.5.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">Manual PE</td>
<td id="Sx5.T1.1.5.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">74.67</td>
