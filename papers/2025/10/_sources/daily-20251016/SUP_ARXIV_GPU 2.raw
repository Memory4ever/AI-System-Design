      <a href="/search/?searchtype=author&amp;query=Zhao%2C+Y">Yue Zhao</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Sun%2C+L">Lichao Sun</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Kalantari%2C+S">Saleh Kalantari</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhang%2C+X">Xiangliang Zhang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Ghassemi%2C+M">Marzyeh Ghassemi</a>
      
