    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Ye%2C+R">Ruiqi Ye</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Luj%C3%A1n%2C+M">Mikel Luján</a>
      
