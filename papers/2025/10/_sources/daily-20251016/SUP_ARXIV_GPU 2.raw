    <p class="title is-5 mathjax">
      
        3-Model Speculative Decoding
      
    </p>
    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Byun%2C+S">Sanghyun Byun</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Odema%2C+M">Mohanad Odema</a>, 
      
