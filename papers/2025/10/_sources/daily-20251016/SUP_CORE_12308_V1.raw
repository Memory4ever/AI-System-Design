<th id="S3.F3.4.1.4.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb"><math id="S3.F3.m3" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo>∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math> 5.6M</th>
