<table id="S3.F3.4.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="S3.F3.4.1.1" class="ltx_tr">
<th id="S3.F3.4.1.1.1" class="ltx_td ltx_th ltx_th_row ltx_border_tt"></th>
<th id="S3.F3.4.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_tt"># pts.</th>
<td id="S3.F3.4.1.1.3" class="ltx_td ltx_align_center ltx_border_tt">PSNR</td>
