<th id="S3.F3.4.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Sparse</th>
<th id="S3.F3.4.1.3.2" class="ltx_td ltx_align_center ltx_th ltx_th_row"><math id="S3.F3.m2" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo>∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math> 180K</th>
<td id="S3.F3.4.1.3.3" class="ltx_td ltx_align_center">23.19/15.41</td>
