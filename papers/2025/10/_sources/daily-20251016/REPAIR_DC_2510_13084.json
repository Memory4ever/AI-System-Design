{"data":{"id":"10.48550/arxiv.2510.13084","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.13084","prefix":"10.48550","suffix":"arxiv.2510.13084","identifiers":[{"identifier":"2510.13084","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.13084"}],"creators":[{"name":"Zuo, Yi","nameType":"Personal","givenName":"Yi","familyName":"Zuo","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Zitao","nameType":"Personal","givenName":"Zitao","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Lingling","nameType":"Personal","givenName":"Lingling","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Xu","nameType":"Personal","givenName":"Xu","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Fang","nameType":"Personal","givenName":"Fang","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Jiao, Licheng","nameType":"Personal","givenName":"Licheng","familyName":"Jiao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Edit-Your-Interest: Efficient Video Editing via Feature Most-Similar Propagation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-15T01:55:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-16T00:18:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-16T13:59:01Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-19T01:09:17Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1016/j.patcog.2026.115113","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-nc-nd-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Text-to-image diffusion models have advanced video editing. However, existing video editing methods are limited by their high computational overhead and memory consumption. Furthermore, these approaches often sacrifice visual fidelity, leading to temporal inconsistencies and artifacts such as blurring and mosaic-like patterns. To address these dual challenges and strike a balance between computational efficiency and visual fidelity, we propose Edit-Your-Interest, a lightweight, text-driven, zero-shot video editing method. Edit-Your-Interest introduces a Spatio-Temporal Feature Memory bank (SFM) to cache spatial-attention features from previous frames under a fixed memory budget. The SFM maintains a representative candidate pool, reducing the computational overhead of full-sequence spatio-temporal modeling. To query this memory, we propose Feature Most-Similar Propagation (FMP), a similarity-based retrieval rule that propagates relevant cached tokens to the current frame. Together, SFM and FMP form a bounded-memory retrieval-based propagation design that improves temporal consistency while reducing blurring and mosaic-like artifacts. Finally, we introduce a feature-diversity-based SFM update algorithm to keep the memory representative and non-redundant throughout the video sequence. Furthermore, to enable precise object editing, we leverage cross-attention maps to automatically extract masks for the instances of interest. These masks are seamlessly integrated into the diffusion denoising process, enabling fine-grained control over target objects and allowing Edit-Your-Interest to perform highly accurate edits while robustly preserving the background integrity. Extensive experiments demonstrate that Edit-Your-Interest outperforms state-of-the-art methods in both efficiency and visual fidelity. Project page: https://edit-your-interest.github.io/.","descriptionType":"Abstract"},{"description":"32 pages, 11 figures","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.13084","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-10-16T01:52:11.000Z","registered":"2025-10-16T01:52:12.000Z","published":"2025","updated":"2026-10-19T02:53:32.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.13084","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[{"id":"10.1016/j.patcog.2026.115113","type":"dois"}]}}}}