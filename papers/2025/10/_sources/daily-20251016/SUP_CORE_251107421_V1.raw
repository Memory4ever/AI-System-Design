<td id="S4.T3.2.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S4.T3.2.1.2.1" class="ltx_text ltx_font_bold">Reddit</span></td>
<td id="S4.T3.2.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S4.T3.2.1.3.1" class="ltx_text ltx_font_bold">Yelp</span></td>
<td id="S4.T3.2.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S4.T3.2.1.4.1" class="ltx_text ltx_font_bold">Ogbn-products</span></td></tr>
<tr id="S4.T3.2.2" class="ltx_tr">
