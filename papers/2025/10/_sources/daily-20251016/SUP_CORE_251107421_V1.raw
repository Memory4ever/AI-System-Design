            <span id="alg1.l0a.3" class="ltx_text" style="font-size:90%;"> Trained GNN model </span><math id="alg1.l0a.m1" class="ltx_Math" alttext="M_{trained}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">M</mi><mrow><mi mathsize="0.900em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">d</mi></mrow></msub><annotation encoding="application/x-tex">M_{trained}</annotation></semantics></math><span id="alg1.l0a.4" class="ltx_text" style="font-size:90%;">.
