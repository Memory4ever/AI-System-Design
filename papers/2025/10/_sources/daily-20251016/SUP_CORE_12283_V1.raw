<tr id="S4.T5.6.1.2" class="ltx_tr">
<td id="S4.T5.6.1.2.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:3pt;padding-bottom:3pt;" rowspan="2"><span id="S4.T5.6.1.2.1.1" class="ltx_text ltx_font_bold">TVR</span></td>
<td id="S4.T5.6.1.2.2" class="ltx_td ltx_border_t" style="padding-top:3pt;padding-bottom:3pt;"></td>
<td id="S4.T5.6.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:3pt;padding-bottom:3pt;">Hard</td>
<td id="S4.T5.6.1.2.4" class="ltx_td ltx_border_t" style="padding-top:3pt;padding-bottom:3pt;"></td>
