</div>
<div id="alg1.3.20" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="alg1.3.20.1" class="ltx_text ltx_font_bold">for</span> <em id="alg1.3.20.2" class="ltx_emph ltx_font_italic">layer <math id="alg1.m24" class="ltx_Math" alttext="i=1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i=1</annotation></semantics></math> <span id="alg1.3.20.2.1" class="ltx_text ltx_font_bold ltx_font_upright">to</span> <math id="alg1.m25" class="ltx_Math" alttext="L_{\text{adapt}}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mtext class="ltx_mathvariant_italic">adapt</mtext></msub><annotation encoding="application/x-tex">L_{\text{adapt}}</annotation></semantics></math></em> <span id="alg1.3.20.3" class="ltx_text ltx_font_bold">do</span>
</div>
