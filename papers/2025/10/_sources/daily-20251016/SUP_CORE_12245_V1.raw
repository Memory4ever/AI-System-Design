<td id="Sx4.T2.1.3.2" class="ltx_td ltx_align_center ltx_border_t">0.232</td>
<td id="Sx4.T2.1.3.3" class="ltx_td ltx_align_center ltx_border_t">0.351</td>
<td id="Sx4.T2.1.3.4" class="ltx_td ltx_align_center ltx_border_t">0.221</td>
<td id="Sx4.T2.1.3.5" class="ltx_td ltx_align_center ltx_border_t">0.304</td>
<td id="Sx4.T2.1.3.6" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">0.469</td></tr>
<tr id="Sx4.T2.1.4" class="ltx_tr">
<th id="Sx4.T2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">3D-MoLM(S)<sup id="Sx4.T2.1.4.1.1" class="ltx_sup">1</sup></th>
