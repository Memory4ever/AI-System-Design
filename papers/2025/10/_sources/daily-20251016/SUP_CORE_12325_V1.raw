<td id="S5.T1.8.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" colspan="4"><span id="S5.T1.8.1.1.3.1" class="ltx_text ltx_font_bold">Sports</span></td>
<td id="S5.T1.8.1.1.4" class="ltx_td ltx_align_center ltx_border_tt" colspan="4"><span id="S5.T1.8.1.1.4.1" class="ltx_text ltx_font_bold">Clothing</span></td></tr>
<tr id="S5.T1.8.1.2" class="ltx_tr">
