<td id="S5.T1.8.1.2.13" class="ltx_td ltx_align_center ltx_border_t">NDCG@20</td></tr>
<tr id="S5.T1.8.1.3" class="ltx_tr">
<td id="S5.T1.8.1.3.1" class="ltx_td ltx_align_left ltx_border_t" rowspan="2"><span id="S5.T1.8.1.3.1.1" class="ltx_text"><span id="S5.T1.8.1.3.1.1.1" class="ltx_text"></span><span id="S5.T1.8.1.3.1.1.2" class="ltx_text">
<span id="S5.T1.8.1.3.1.1.2.1" class="ltx_tabular ltx_align_middle">
<span id="S5.T1.8.1.3.1.1.2.1.1" class="ltx_tr">
<span id="S5.T1.8.1.3.1.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left"><span id="S5.T1.8.1.3.1.1.2.1.1.1.1" class="ltx_text ltx_font_bold">CF</span></span></span>
</span></span><span id="S5.T1.8.1.3.1.1.3" class="ltx_text"></span></span></td>
<td id="S5.T1.8.1.3.2" class="ltx_td ltx_align_left ltx_border_t">BPR <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib13" title="" class="ltx_ref">Rendle et al., 2009</a>)</cite></td>
<td id="S5.T1.8.1.3.3" class="ltx_td ltx_align_center ltx_border_t">0.0357</td>
<td id="S5.T1.8.1.3.4" class="ltx_td ltx_align_center ltx_border_t">0.0575</td>
<td id="S5.T1.8.1.3.5" class="ltx_td ltx_align_center ltx_border_t">0.0192</td>
<td id="S5.T1.8.1.3.6" class="ltx_td ltx_align_center ltx_border_t">0.0249</td>
<td id="S5.T1.8.1.3.7" class="ltx_td ltx_align_center ltx_border_t">0.0432</td>
<td id="S5.T1.8.1.3.8" class="ltx_td ltx_align_center ltx_border_t">0.0653</td>
<td id="S5.T1.8.1.3.9" class="ltx_td ltx_align_center ltx_border_t">0.0241</td>
<td id="S5.T1.8.1.3.10" class="ltx_td ltx_align_center ltx_border_t">0.0298</td>
<td id="S5.T1.8.1.3.11" class="ltx_td ltx_align_center ltx_border_t">0.0206</td>
<td id="S5.T1.8.1.3.12" class="ltx_td ltx_align_center ltx_border_t">0.0303</td>
<td id="S5.T1.8.1.3.13" class="ltx_td ltx_align_center ltx_border_t">0.0114</td>
<td id="S5.T1.8.1.3.14" class="ltx_td ltx_align_center ltx_border_t">0.0138</td></tr>
<tr id="S5.T1.8.1.4" class="ltx_tr">
<td id="S5.T1.8.1.4.1" class="ltx_td ltx_align_left">LightGCN <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib6" title="" class="ltx_ref">He et al., 2020c</a>)</cite></td>
<td id="S5.T1.8.1.4.2" class="ltx_td ltx_align_center">0.0479</td>
<td id="S5.T1.8.1.4.3" class="ltx_td ltx_align_center">0.0754</td>
<td id="S5.T1.8.1.4.4" class="ltx_td ltx_align_center">0.0257</td>
<td id="S5.T1.8.1.4.5" class="ltx_td ltx_align_center">0.0328</td>
<td id="S5.T1.8.1.4.6" class="ltx_td ltx_align_center">0.0569</td>
<td id="S5.T1.8.1.4.7" class="ltx_td ltx_align_center">0.0864</td>
<td id="S5.T1.8.1.4.8" class="ltx_td ltx_align_center">0.0311</td>
<td id="S5.T1.8.1.4.9" class="ltx_td ltx_align_center">0.0387</td>
<td id="S5.T1.8.1.4.10" class="ltx_td ltx_align_center">0.0361</td>
<td id="S5.T1.8.1.4.11" class="ltx_td ltx_align_center">0.0544</td>
<td id="S5.T1.8.1.4.12" class="ltx_td ltx_align_center">0.0197</td>
