<td id="S5.T1.8.1.16.10" class="ltx_td ltx_align_center"><span id="S5.T1.8.1.16.10.1" class="ltx_text ltx_underline">0.0637</span></td>
<td id="S5.T1.8.1.16.11" class="ltx_td ltx_align_center">0.0963</td>
<td id="S5.T1.8.1.16.12" class="ltx_td ltx_align_center">0.0344</td>
