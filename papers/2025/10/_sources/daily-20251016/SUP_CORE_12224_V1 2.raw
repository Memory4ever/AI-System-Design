<td id="S5.T5.2.9.6" class="ltx_td ltx_align_center"><span id="S5.T5.2.9.6.1" class="ltx_text ltx_font_bold">0.4888</span></td>
<td id="S5.T5.2.9.7" class="ltx_td ltx_align_center">0.3890</td>
<td id="S5.T5.2.9.8" class="ltx_td ltx_align_center">0.3677</td>
<td id="S5.T5.2.9.9" class="ltx_td ltx_align_center">0.3875</td>
<td id="S5.T5.2.9.10" class="ltx_td ltx_align_center">0.3333</td></tr>
