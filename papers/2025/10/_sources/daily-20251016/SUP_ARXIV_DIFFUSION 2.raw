        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.12724">pdf</a>, <a href="https://arxiv.org/ps/2510.12724">ps</a>, <a href="https://arxiv.org/format/2510.12724">other</a>]&nbsp;</span>
