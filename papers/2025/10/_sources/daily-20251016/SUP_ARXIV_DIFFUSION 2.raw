      <a href="/search/?searchtype=author&amp;query=Bj%C3%B6rkstrand%2C+D">David Björkstrand</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Wang%2C+T">Tiesheng Wang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Bretzner%2C+L">Lars Bretzner</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Sullivan%2C+J">Josephine Sullivan</a>
      
