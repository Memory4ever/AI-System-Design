        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.12789">pdf</a>, <a href="https://arxiv.org/ps/2510.12789">ps</a>, <a href="https://arxiv.org/format/2510.12789">other</a>]&nbsp;</span>
