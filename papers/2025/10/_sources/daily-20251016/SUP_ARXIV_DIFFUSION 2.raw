        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.13084">pdf</a>, <a href="https://arxiv.org/ps/2510.13084">ps</a>, <a href="https://arxiv.org/format/2510.13084">other</a>]&nbsp;</span>
