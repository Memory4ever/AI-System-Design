<td id="S3.T1.3.1.3.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">Detect [PHRASE] in this image</td>
<td id="S3.T1.3.1.3.4" class="ltx_td ltx_align_center ltx_border_t">HumanRef, RefCOCOg</td></tr>
<tr id="S3.T1.3.1.4" class="ltx_tr">
<td id="S3.T1.3.1.4.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">Visual Prompting</td>
<td id="S3.T1.3.1.4.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">Box</td>
<td id="S3.T1.3.1.4.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">
<table id="S3.T1.3.1.4.3.1" class="ltx_tabular ltx_align_middle">
