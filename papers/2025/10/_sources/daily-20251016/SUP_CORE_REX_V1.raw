<td id="S3.T1.3.1.2.4.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">APTv2 <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib114" title="" class="ltx_ref">114</a>]</cite>, BDD100K <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib117" title="" class="ltx_ref">117</a>]</cite>, DeepFashion <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib62" title="" class="ltx_ref">62</a>]</cite></td></tr>
<tr id="S3.T1.3.1.2.4.1.2" class="ltx_tr">
