<span id="S5.T2.3.1.1.4.1.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">Score</span></span>
<span id="S5.T2.3.1.1.4.1.1.2" class="ltx_tr">
<span id="S5.T2.3.1.1.4.1.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">Thresh.</span></span>
</span></span></td>
<td id="S5.T2.3.1.1.5" class="ltx_td ltx_align_center ltx_border_tt" colspan="10">COCO</td></tr>
<tr id="S5.T2.3.1.2" class="ltx_tr">
<td id="S5.T2.3.1.2.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">mAP</td>
<td id="S5.T2.3.1.2.2" class="ltx_td ltx_align_center ltx_border_t">
<table id="S5.T2.3.1.2.2.1" class="ltx_tabular ltx_align_middle">
<tr id="S5.T2.3.1.2.2.1.1" class="ltx_tr">
<td id="S5.T2.3.1.2.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">R@IoU</td></tr>
