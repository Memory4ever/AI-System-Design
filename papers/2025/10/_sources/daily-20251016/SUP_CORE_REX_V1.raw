<tr id="S3.T1.3.1.4.4.1.1" class="ltx_tr">
<td id="S3.T1.3.1.4.4.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">O365 <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib91" title="" class="ltx_ref">91</a>]</cite>, OpenImages <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib40" title="" class="ltx_ref">40</a>]</cite>, HierText <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib63" title="" class="ltx_ref">63</a>]</cite></td></tr>
<tr id="S3.T1.3.1.4.4.1.2" class="ltx_tr">
<td id="S3.T1.3.1.4.4.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">CrowdHuman <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib90" title="" class="ltx_ref">90</a>]</cite>, SA-1B <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib39" title="" class="ltx_ref">39</a>]</cite>, VisDrone <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib19" title="" class="ltx_ref">19</a>]</cite></td></tr>
<tr id="S3.T1.3.1.4.4.1.3" class="ltx_tr">
<td id="S3.T1.3.1.4.4.1.3.1" class="ltx_td ltx_nopad_r ltx_align_center">FSCD147 <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib73" title="" class="ltx_ref">73</a>]</cite></td></tr>
</table></td></tr>
<tr id="S3.T1.3.1.5" class="ltx_tr">
<td id="S3.T1.3.1.5.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">OCR</td>
<td id="S3.T1.3.1.5.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">Box / Polygon</td>
<td id="S3.T1.3.1.5.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">Detect all the text in box/polygon format and recognize them</td>
<td id="S3.T1.3.1.5.4" class="ltx_td ltx_align_center ltx_border_t">
<table id="S3.T1.3.1.5.4.1" class="ltx_tabular ltx_align_middle">
<tr id="S3.T1.3.1.5.4.1.1" class="ltx_tr">
<td id="S3.T1.3.1.5.4.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">Art <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib14" title="" class="ltx_ref">14</a>]</cite>, HierText <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib63" title="" class="ltx_ref">63</a>]</cite>, ICDAR2013 <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib66" title="" class="ltx_ref">66</a>]</cite></td></tr>
<tr id="S3.T1.3.1.5.4.1.2" class="ltx_tr">
<td id="S3.T1.3.1.5.4.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">ICDAR2015 <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib36" title="" class="ltx_ref">36</a>]</cite>, LSVT <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib98" title="" class="ltx_ref">98</a>]</cite>, RCTW <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib93" title="" class="ltx_ref">93</a>]</cite></td></tr>
