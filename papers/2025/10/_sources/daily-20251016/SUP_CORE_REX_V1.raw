<td id="S5.T2.3.1.2.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">0.5</td></tr>
</table></td>
<td id="S5.T2.3.1.2.3" class="ltx_td ltx_align_center ltx_border_t">
<table id="S5.T2.3.1.2.3.1" class="ltx_tabular ltx_align_middle">
<tr id="S5.T2.3.1.2.3.1.1" class="ltx_tr">
<td id="S5.T2.3.1.2.3.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">P@IoU</td></tr>
