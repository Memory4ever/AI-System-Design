<tr id="S3.T1.3.1.2.4.1.3" class="ltx_tr">
<td id="S3.T1.3.1.2.4.1.3.1" class="ltx_td ltx_nopad_r ltx_align_center">HumanParts <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib51" title="" class="ltx_ref">51</a>]</cite>, ImageNet-Part <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib26" title="" class="ltx_ref">26</a>]</cite> NuImages <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib7" title="" class="ltx_ref">7</a>]</cite></td></tr>
