      <a href="/search/?searchtype=author&amp;query=Monteiro%2C+D">Diogo Monteiro</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Novais%2C+P">Paulo Novais</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Henriques%2C+P+R">Pedro Rangel Henriques</a>, 
      
