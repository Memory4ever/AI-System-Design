        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.12798">pdf</a>, <a href="https://arxiv.org/ps/2510.12798">ps</a>, <a href="https://arxiv.org/format/2510.12798">other</a>]&nbsp;</span>
