<th id="S2.T1.2.1.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;"><span id="S2.T1.2.1.2.6.1" class="ltx_text ltx_font_bold">History</span></th>
<th id="S2.T1.2.1.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;"><span id="S2.T1.2.1.2.7.1" class="ltx_text ltx_font_bold">Health</span></th>
<th id="S2.T1.2.1.2.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;"><span id="S2.T1.2.1.2.8.1" class="ltx_text ltx_font_bold">Economics</span></th>
<th id="S2.T1.2.1.2.9" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;"><span id="S2.T1.2.1.2.9.1" class="ltx_text ltx_font_bold">Math</span></th>
<th id="S2.T1.2.1.2.10" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;"><span id="S2.T1.2.1.2.10.1" class="ltx_text ltx_font_bold">Physics</span></th>
<th id="S2.T1.2.1.2.11" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;"><span id="S2.T1.2.1.2.11.1" class="ltx_text ltx_font_bold">Philosophy</span></th>
<th id="S2.T1.2.1.2.12" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;"><span id="S2.T1.2.1.2.12.1" class="ltx_text ltx_font_bold">Engineering</span></th>
<th id="S2.T1.2.1.2.13" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;"><span id="S2.T1.2.1.2.13.1" class="ltx_text ltx_font_bold">Computer Science</span></th>
<th id="S2.T1.2.1.2.14" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;"><span id="S2.T1.2.1.2.14.1" class="ltx_text ltx_font_bold">Other</span></th>
<th id="S2.T1.2.1.2.15" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;"><span id="S2.T1.2.1.2.15.1" class="ltx_text ltx_font_bold">Overall</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S2.T1.2.1.3" class="ltx_tr">
<th id="S2.T1.2.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">Full-1B</th>
<td id="S2.T1.2.1.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">14.83</td>
<td id="S2.T1.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">14.44</td>
<td id="S2.T1.2.1.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">33.08</td>
<td id="S2.T1.2.1.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">39.61</td>
<td id="S2.T1.2.1.3.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">12.81</td>
<td id="S2.T1.2.1.3.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">15.22</td>
<td id="S2.T1.2.1.3.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">18.34</td>
