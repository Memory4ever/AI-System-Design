<th id="S2.T1.2.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;"><span id="S2.T1.2.1.2.3.1" class="ltx_text ltx_font_bold">Psychology</span></th>
