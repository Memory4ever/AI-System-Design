<th id="S4.T1.2.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t"><code id="S4.T1.2.3.1.1" class="ltx_verbatim ltx_font_typewriter">learning_rate</code></th>
