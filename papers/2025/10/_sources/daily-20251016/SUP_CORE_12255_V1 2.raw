<span id="A4.T4.10.1.31.4.1.1" class="ltx_p ltx_align_center"><span id="A4.T4.10.1.31.4.1.1.1" class="ltx_text ltx_font_bold">55.8 (-38.7%)</span></span>
</span></td>
<td id="A4.T4.10.1.31.5" class="ltx_td ltx_align_left ltx_align_middle ltx_border_bb">
<span id="A4.T4.10.1.31.5.1" class="ltx_inline-block ltx_align_middle" style="width:51.7pt;">
<span id="A4.T4.10.1.31.5.1.1" class="ltx_p ltx_align_center"><span id="A4.T4.10.1.31.5.1.1.1" class="ltx_text ltx_font_bold">40.0 (-37.6%)</span></span>
</span></td>
