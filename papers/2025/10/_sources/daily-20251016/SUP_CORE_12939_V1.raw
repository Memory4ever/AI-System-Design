<td id="A5.F12.3.3.2" class="ltx_td ltx_align_center ltx_border_bb"><img src="2510.12939v1/imgs/observations/halfcheetah/adversarial_circle_thick/c.png" id="A5.F12.g4" class="ltx_graphics ltx_img_square" style="aspect-ratio:134/134;" width="134" height="134" alt="Refer to caption"></td></tr>
