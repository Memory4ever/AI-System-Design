<th id="A5.F12.3.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A5.F12.3.1.2.1" class="ltx_text ltx_font_bold">Adversarial Perturbation</span></th></tr>
</thead>
