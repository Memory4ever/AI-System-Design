<td id="S5.T3.4.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">0.333</td>
<td id="S5.T3.4.2.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">0.386</td></tr>
<tr id="S5.T3.4.3" class="ltx_tr">
