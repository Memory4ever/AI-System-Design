<th id="S3.T3.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_t"><span id="S3.T3.5.1.2.1" class="ltx_text ltx_font_bold">Embedding</span></th>
<th id="S3.T3.5.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" colspan="4"><span id="S3.T3.5.1.3.1" class="ltx_text ltx_font_bold">Blur Intensity</span></th></tr>
