<td id="S2.T2.2.13.4" class="ltx_td ltx_align_left" style="padding-left:2.0pt;padding-right:2.0pt;"><math id="S2.T2.m51" class="ltx_Math" alttext="6.5" display="inline" intent=":literal"><semantics><mn>6.5</mn><annotation encoding="application/x-tex">6.5</annotation></semantics></math></td>
<td id="S2.T2.2.13.5" class="ltx_td ltx_align_left" style="padding-left:2.0pt;padding-right:2.0pt;"><math id="S2.T2.m52" class="ltx_Math" alttext="3.7" display="inline" intent=":literal"><semantics><mn>3.7</mn><annotation encoding="application/x-tex">3.7</annotation></semantics></math></td>
<td id="S2.T2.2.13.6" class="ltx_td ltx_align_left" style="padding-left:2.0pt;padding-right:2.0pt;"><math id="S2.T2.m53" class="ltx_Math" alttext="156.4" display="inline" intent=":literal"><semantics><mn>156.4</mn><annotation encoding="application/x-tex">156.4</annotation></semantics></math></td>
