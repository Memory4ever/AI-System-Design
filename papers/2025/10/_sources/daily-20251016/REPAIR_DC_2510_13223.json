{"data":{"id":"10.48550/arxiv.2510.13223","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.13223","prefix":"10.48550","suffix":"arxiv.2510.13223","identifiers":[{"identifier":"2510.13223","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.13223"}],"creators":[{"name":"He, Yiyuan","nameType":"Personal","givenName":"Yiyuan","familyName":"He","affiliation":[],"nameIdentifiers":[]},{"name":"Xu, Minxian","nameType":"Personal","givenName":"Minxian","familyName":"Xu","affiliation":[],"nameIdentifiers":[]},{"name":"Wu, Jingfeng","nameType":"Personal","givenName":"Jingfeng","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Hu, Jianmin","nameType":"Personal","givenName":"Jianmin","familyName":"Hu","affiliation":[],"nameIdentifiers":[]},{"name":"Ma, Chong","nameType":"Personal","givenName":"Chong","familyName":"Ma","affiliation":[],"nameIdentifiers":[]},{"name":"Shen, Min","nameType":"Personal","givenName":"Min","familyName":"Shen","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Le","nameType":"Personal","givenName":"Le","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Xu, Chengzhong","nameType":"Personal","givenName":"Chengzhong","familyName":"Xu","affiliation":[],"nameIdentifiers":[]},{"name":"Qu, Lin","nameType":"Personal","givenName":"Lin","familyName":"Qu","affiliation":[],"nameIdentifiers":[]},{"name":"Ye, Kejiang","nameType":"Personal","givenName":"Kejiang","familyName":"Ye","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"BanaServe: Unified KV Cache and Dynamic Module Migration for Balancing Disaggregated LLM Serving in AI Infrastructure"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-15T07:20:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-03-11T00:20:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1002/spe.70054","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Large language models (LLMs) are increasingly deployed in AI infrastructure, driving the need for high throughput, resource efficient serving systems. Disaggregated LLM serving, which separates prompt prefill from auto-regressive decode, has emerged as a promising architecture by isolating their heterogeneous compute and memory demands. However, current disaggregated systems face three key limitations: (i) static resource allocation cannot adapt to highly dynamic workloads, causing over-provisioning that wastes resources or under-provisioning that violates service level objectives (SLOs); (ii) inherent load imbalance between prefill and decode stages, where prefill is compute-bound and decode is memory-bound, causes under-utilization in one tier while the other becomes a bottleneck; and (iii) prefix cache aware routing skews load distribution, as high cache hit rate prefill nodes attract disproportionately more requests, further degrading balance and efficiency. To address these issues, we present BanaServe, a dynamic orchestration framework that continuously rebalances computational and memory resources across prefill and decode instances while eliminating hotspots induced by cache. BanaServe introduces layer level weight migration, attention level Key Value Cache (KV Cache) migration, and Global KV Cache Store sharing with layer wise overlapped transmission, enabling both coarse grained (layer level) and fine grained (attention level) load redistribution with minimal latency overhead. These mechanisms allow routers to perform purely load aware scheduling, unconstrained by cache placement. Compared to vLLM, BanaServe achieves 1.2x-3.9x higher throughput with 3.9%-78.4% lower total processing time, and outperforms DistServe by 1.1x-2.8x in throughput with 1.4%-70.1% latency reduction.","descriptionType":"Abstract"},{"description":"23 pages","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.13223","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-10-16T01:55:41.000Z","registered":"2025-10-16T01:55:42.000Z","published":"2025","updated":"2026-03-11T02:34:11.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.13223","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[{"id":"10.1002/spe.70054","type":"dois"}]}}}}