<figure id="algorithm2" class="ltx_float ltx_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="algorithm2.3" class="ltx_text ltx_font_bold">Algorithm 2</span> </span>Semantic Perturbation Module</figcaption>
<div id="algorithm2.4" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="algorithm2.4.1" class="ltx_listingline"><span id="algorithm2.4.1.1" class="ltx_text ltx_font_bold">Input :</span> Graph <math id="algorithm2.m1" class="ltx_Math" alttext="\mathcal{G}=(\mathcal{V},\mathcal{E},\mathcal{X},\mathcal{T})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{G}=(\mathcal{V},\mathcal{E},\mathcal{X},\mathcal{T})</annotation></semantics></math>, target node <math id="algorithm2.m2" class="ltx_Math" alttext="v\in\mathcal{V}" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow><annotation encoding="application/x-tex">v\in\mathcal{V}</annotation></semantics></math>, Graph-LLM <math id="algorithm2.m3" class="ltx_Math" alttext="\mathcal{F}_{\theta}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}_{\theta}(\cdot)</annotation></semantics></math>, text encoder <math id="algorithm2.m4" class="ltx_Math" alttext="\psi_{\theta}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\psi_{\theta}(\cdot)</annotation></semantics></math>, Masked Language Model (MLM), pivotal word set <math id="algorithm2.m5" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math>
</div>
<div id="algorithm2.4.2" class="ltx_listingline"><span id="algorithm2.4.2.1" class="ltx_text ltx_font_bold">Output :</span> Perturbed text <math id="algorithm2.m6" class="ltx_Math" alttext="\mathcal{T}_{v}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>v</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">\mathcal{T}_{v}^{\prime}</annotation></semantics></math> for node <math id="algorithm2.m7" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math>
</div>
<div id="algorithm2.4.3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.3.1" class="ltx_text ltx_font_bold">1</span></span>
          <math id="algorithm2.m8" class="ltx_Math" alttext="\mathcal{C}\leftarrow\{\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{C}\leftarrow\{\}</annotation></semantics></math>,  <math id="algorithm2.m9" class="ltx_Math" alttext="count\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">←</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">count\leftarrow 0</annotation></semantics></math> 
</div>
<div id="algorithm2.4.4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.4.1" class="ltx_text ltx_font_bold">2</span></span>
          <span id="algorithm2.4.4.2" class="ltx_text ltx_font_bold">foreach</span> <em id="algorithm2.4.4.3" class="ltx_emph ltx_font_italic"><math id="algorithm2.m10" class="ltx_Math" alttext="W_{i}\in\mathcal{P}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>i</mi></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow><annotation encoding="application/x-tex">W_{i}\in\mathcal{P}</annotation></semantics></math></em> <span id="algorithm2.4.4.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm2.4.5" class="ltx_listingline">  
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.5.1" class="ltx_text ltx_font_bold">3</span></span>
          <math id="algorithm2.m11" class="ltx_Math" alttext="\mathcal{C}[i]\leftarrow\text{top-}k" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mtext>top-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow><annotation encoding="application/x-tex">\mathcal{C}[i]\leftarrow\text{top-}k</annotation></semantics></math> candidates from MLM(<math id="algorithm2.m12" class="ltx_Math" alttext="W_{i},\mathcal{T}_{v}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>i</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>v</mi></msub></mrow><annotation encoding="application/x-tex">W_{i},\mathcal{T}_{v}</annotation></semantics></math>) 
</div>
<div id="algorithm2.4.6" class="ltx_listingline">  <span id="algorithm2.4.6.1" class="ltx_text ltx_font_typewriter">/* </span><span id="algorithm2.4.6.2" class="ltx_text ltx_font_typewriter">Generate top-<math id="algorithm2.m13" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> replacement candidates for pivotal word <math id="algorithm2.m14" class="ltx_Math" alttext="W_{i}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mi>i</mi></msub><annotation encoding="application/x-tex">W_{i}</annotation></semantics></math> using MLM */</span>
</div>
<div id="algorithm2.4.7" class="ltx_listingline">  
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.7.1" class="ltx_text ltx_font_bold">4</span></span>
          <span id="algorithm2.4.7.2" class="ltx_text ltx_font_bold">for</span> <em id="algorithm2.4.7.3" class="ltx_emph ltx_font_italic"><math id="algorithm2.m15" class="ltx_Math" alttext="i\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo stretchy="false">←</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">i\leftarrow 0</annotation></semantics></math>to <math id="algorithm2.m16" class="ltx_Math" alttext="|\mathcal{P}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathcal{P}|</annotation></semantics></math> </em> <span id="algorithm2.4.7.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm2.4.8" class="ltx_listingline">    
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.8.1" class="ltx_text ltx_font_bold">5</span></span>
          <span id="algorithm2.4.8.2" class="ltx_text ltx_font_bold">foreach</span> <em id="algorithm2.4.8.3" class="ltx_emph ltx_font_italic"><math id="algorithm2.m17" class="ltx_Math" alttext="r\in\mathcal{C}[i]" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r\in\mathcal{C}[i]</annotation></semantics></math></em> <span id="algorithm2.4.8.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm2.4.9" class="ltx_listingline">      
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.9.1" class="ltx_text ltx_font_bold">6</span></span>
          <math id="algorithm2.m18" class="ltx_Math" alttext="\mathcal{T}^{\prime}\leftarrow(\mathcal{T}_{v}\setminus\{W_{i}\})\cup\{r\}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>′</mo></msup><mo stretchy="false">←</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>v</mi></msub><mo>∖</mo><mrow><mo stretchy="false">{</mo><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>r</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}^{\prime}\leftarrow(\mathcal{T}_{v}\setminus\{W_{i}\})\cup\{r\}</annotation></semantics></math> 
</div>
<div id="algorithm2.4.10" class="ltx_listingline">      
