          <math id="algorithm1.m22" class="ltx_Math" alttext="\phi(W_{i})\leftarrow\phi(W_{i})+w_{S}\cdot\bigl(f_{S}-f_{S\cup i}\bigr)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>w</mi><mi>S</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>f</mi><mi>S</mi></msub><mo>−</mo><msub><mi>f</mi><mrow><mi>S</mi><mo>∪</mo><mi>i</mi></mrow></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi(W_{i})\leftarrow\phi(W_{i})+w_{S}\cdot\bigl(f_{S}-f_{S\cup i}\bigr)</annotation></semantics></math> 
