<span id="S4.T2.5.3.5.1" class="ltx_inline-block ltx_align_top">
<span id="S4.T2.5.3.5.1.1" class="ltx_p ltx_align_center">574.46</span>
</span></td>
<td id="S4.T2.5.3.6" class="ltx_td ltx_nopad_l ltx_align_left ltx_border_t">
