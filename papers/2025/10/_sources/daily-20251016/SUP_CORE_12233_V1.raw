<section id="A8" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix H </span>Pseudo-code</h2>

<div id="A8.p1" class="ltx_para">
<p id="A8.p1.1" class="ltx_p">For completeness and clarity, the full procedures of the three IMDGA modules are provided in Algorithms <a href="#algorithm1" title="In Appendix H Pseudo-code ‣ Unveiling the Vulnerability of Graph-LLMs: An Interpretable Multi-Dimensional Adversarial Attack on TAGs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>–<a href="#algorithm3" title="In Appendix H Pseudo-code ‣ Unveiling the Vulnerability of Graph-LLMs: An Interpretable Multi-Dimensional Adversarial Attack on TAGs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> below.</p>
</div>
<figure id="algorithm1" class="ltx_float ltx_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="algorithm1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span>Topological SHAP Module</figcaption>
<div id="algorithm1.4" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="algorithm1.4.1" class="ltx_listingline"><span id="algorithm1.4.1.1" class="ltx_text ltx_font_bold">Input :</span> Graph <math id="algorithm1.m1" class="ltx_Math" alttext="\mathcal{G}=(\mathcal{V},\mathcal{E},\mathcal{X},\mathcal{T})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{G}=(\mathcal{V},\mathcal{E},\mathcal{X},\mathcal{T})</annotation></semantics></math>, target node <math id="algorithm1.m2" class="ltx_Math" alttext="v\in\mathcal{V}" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow><annotation encoding="application/x-tex">v\in\mathcal{V}</annotation></semantics></math>, victim Graph-LLM <math id="algorithm1.m3" class="ltx_Math" alttext="\mathcal{F}_{\theta}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}_{\theta}(\cdot)</annotation></semantics></math>, text encoder <math id="algorithm1.m4" class="ltx_Math" alttext="\psi_{\theta}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\psi_{\theta}(\cdot)</annotation></semantics></math>, tokenizer <math id="algorithm1.m5" class="ltx_Math" alttext="Tokenize(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Tokenize(\cdot)</annotation></semantics></math>, mask operation <math id="algorithm1.m6" class="ltx_Math" alttext="Mask(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Mask(\cdot)</annotation></semantics></math>, coalition sampler <math id="algorithm1.m7" class="ltx_Math" alttext="\mathcal{S}(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{S}(\cdot)</annotation></semantics></math>
</div>
<div id="algorithm1.4.2" class="ltx_listingline"><span id="algorithm1.4.2.1" class="ltx_text ltx_font_bold">Output :</span> Pivotal word set <math id="algorithm1.m8" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math>
</div>
<div id="algorithm1.4.3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.3.1" class="ltx_text ltx_font_bold">1</span></span>
          <span id="algorithm1.4.3.2" class="ltx_text ltx_font_bold">foreach</span> <em id="algorithm1.4.3.3" class="ltx_emph ltx_font_italic"><math id="algorithm1.m9" class="ltx_Math" alttext="W_{i}\in\mathcal{W}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>i</mi></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi></mrow><annotation encoding="application/x-tex">W_{i}\in\mathcal{W}</annotation></semantics></math></em> <span id="algorithm1.4.3.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.4.4" class="ltx_listingline">  
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.4.1" class="ltx_text ltx_font_bold">2</span></span>
          <span id="algorithm1.4.4.2" class="ltx_text ltx_font_bold">foreach</span> <em id="algorithm1.4.4.3" class="ltx_emph ltx_font_italic"><math id="algorithm1.m10" class="ltx_Math" alttext="S\in\mathcal{S}(\mathcal{W}\setminus\{W_{i}\})" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo>∖</mo><mrow><mo stretchy="false">{</mo><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">S\in\mathcal{S}(\mathcal{W}\setminus\{W_{i}\})</annotation></semantics></math></em> <span id="algorithm1.4.4.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.4.5" class="ltx_listingline">    
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.5.1" class="ltx_text ltx_font_bold">3</span></span>
          <math id="algorithm1.m11" class="ltx_Math" alttext="\mathcal{T}_{S\cup\{W_{i}\}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>S</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\mathcal{T}_{S\cup\{W_{i}\}}</annotation></semantics></math> <math id="algorithm1.m12" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> <math id="algorithm1.m13" class="ltx_Math" alttext="Mask(S\cup\{W_{i}\})" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>S</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Mask(S\cup\{W_{i}\})</annotation></semantics></math>,  <math id="algorithm1.m14" class="ltx_Math" alttext="\mathcal{T}_{S}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>S</mi></msub><annotation encoding="application/x-tex">\mathcal{T}_{S}</annotation></semantics></math> <math id="algorithm1.m15" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> <math id="algorithm1.m16" class="ltx_Math" alttext="Mask(S)" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Mask(S)</annotation></semantics></math> 
</div>
<div id="algorithm1.4.6" class="ltx_listingline">    
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.6.1" class="ltx_text ltx_font_bold">4</span></span>
          <math id="algorithm1.m17" class="ltx_Math" alttext="z_{S}\leftarrow\psi_{\theta}(\mathcal{T}_{S})" display="inline" intent=":literal"><semantics><mrow><msub><mi>z</mi><mi>S</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi>ψ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>S</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z_{S}\leftarrow\psi_{\theta}(\mathcal{T}_{S})</annotation></semantics></math>,  <math id="algorithm1.m18" class="ltx_Math" alttext="z_{S\cup\{W_{i}\}}\leftarrow\psi_{\theta}(\mathcal{T}_{S\cup\{W_{i}\}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>z</mi><mrow><mi>S</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow></msub><mo stretchy="false">←</mo><mrow><msub><mi>ψ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>S</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z_{S\cup\{W_{i}\}}\leftarrow\psi_{\theta}(\mathcal{T}_{S\cup\{W_{i}\}})</annotation></semantics></math>
</div>
<div id="algorithm1.4.7" class="ltx_listingline">    
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.7.1" class="ltx_text ltx_font_bold">5</span></span>
          <math id="algorithm1.m19" class="ltx_Math" alttext="f(\mathcal{T}_{S})\leftarrow\sum_{u\in\{v\}\cup\mathcal{N}(v)}\mathcal{F}_{\theta}(\mathcal{G},z_{S},u)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>S</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em" stretchy="false">←</mo><mrow><msub><mo>∑</mo><mrow><mi>u</mi><mo>∈</mo><mrow><mrow><mo stretchy="false">{</mo><mi>v</mi><mo stretchy="false">}</mo></mrow><mo>∪</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msub><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>,</mo><msub><mi>z</mi><mi>S</mi></msub><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">f(\mathcal{T}_{S})\leftarrow\sum_{u\in\{v\}\cup\mathcal{N}(v)}\mathcal{F}_{\theta}(\mathcal{G},z_{S},u)</annotation></semantics></math> 
</div>
