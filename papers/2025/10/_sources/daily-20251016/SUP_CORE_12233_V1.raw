          <math id="algorithm1.m21" class="ltx_Math" alttext="w_{S}\leftarrow\dfrac{|S|!\,(m-|S|-1)!}{m!}" display="inline" intent=":literal"><semantics><mrow><msub><mi>w</mi><mi>S</mi></msub><mo stretchy="false">←</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow><mo>!</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>−</mo><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>!</mo></mrow><mrow><mi>m</mi><mo>!</mo></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">w_{S}\leftarrow\dfrac{|S|!\,(m-|S|-1)!}{m!}</annotation></semantics></math> 
</div>
<div id="algorithm1.4.10" class="ltx_listingline">    
