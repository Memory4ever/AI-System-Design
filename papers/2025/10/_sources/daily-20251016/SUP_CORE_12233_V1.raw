          <math id="algorithm1.m25" class="ltx_Math" alttext="\xi(W_{i})\leftarrow\sum_{u\in\{v\}\cup\mathcal{N}(v)}\phi^{y_{u}}(W_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ξ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em" stretchy="false">←</mo><mrow><msub><mo>∑</mo><mrow><mi>u</mi><mo>∈</mo><mrow><mrow><mo stretchy="false">{</mo><mi>v</mi><mo stretchy="false">}</mo></mrow><mo>∪</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msub><mrow><msup><mi>ϕ</mi><msub><mi>y</mi><mi>u</mi></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\xi(W_{i})\leftarrow\sum_{u\in\{v\}\cup\mathcal{N}(v)}\phi^{y_{u}}(W_{i})</annotation></semantics></math> 
