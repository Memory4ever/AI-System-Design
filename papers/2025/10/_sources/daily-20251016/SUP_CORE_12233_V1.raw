          <math id="algorithm2.m29" class="ltx_Math" alttext="\mathcal{T}^{\prime}_{v}\leftarrow(\mathcal{T}_{v}\setminus\{W_{i}\})\cup\{r^{*}\}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>v</mi><mo>′</mo></msubsup><mo stretchy="false">←</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>v</mi></msub><mo>∖</mo><mrow><mo stretchy="false">{</mo><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>∪</mo><mrow><mo stretchy="false">{</mo><msup><mi>r</mi><mo>∗</mo></msup><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}^{\prime}_{v}\leftarrow(\mathcal{T}_{v}\setminus\{W_{i}\})\cup\{r^{*}\}</annotation></semantics></math>
</div>
<div id="algorithm2.4.21" class="ltx_listingline">          
