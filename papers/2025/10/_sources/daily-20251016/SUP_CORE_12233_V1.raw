<figure id="algorithm3" class="ltx_float ltx_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="algorithm3.3" class="ltx_text ltx_font_bold">Algorithm 3</span> </span>Edge Pruning Module</figcaption>
<div id="algorithm3.4" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="algorithm3.4.1" class="ltx_listingline"><span id="algorithm3.4.1.1" class="ltx_text ltx_font_bold">Input :</span> Graph <math id="algorithm3.m1" class="ltx_Math" alttext="\mathcal{G}=(\mathcal{V},\mathcal{E},\mathcal{X},\mathcal{T}\textquoteright)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo>,</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mi>’</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{G}=(\mathcal{V},\mathcal{E},\mathcal{X},\mathcal{T}\textquoteright)</annotation></semantics></math>, target node <math id="algorithm3.m2" class="ltx_Math" alttext="v\in\mathcal{V}" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow><annotation encoding="application/x-tex">v\in\mathcal{V}</annotation></semantics></math>, victim Graph-LLM <math id="algorithm3.m3" class="ltx_Math" alttext="\mathcal{F}_{\theta}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}_{\theta}(\cdot)</annotation></semantics></math>, text encoder <math id="algorithm3.m4" class="ltx_Math" alttext="\psi_{\theta}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\psi_{\theta}(\cdot)</annotation></semantics></math>, number of layers <math id="algorithm3.m5" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, mask matrix <math id="algorithm3.m6" class="ltx_Math" alttext="M\in\mathbb{R}^{k\times n}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>k</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">M\in\mathbb{R}^{k\times n}</annotation></semantics></math>, weight matrix <math id="algorithm3.m7" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>
</div>
<div id="algorithm3.4.2" class="ltx_listingline"><span id="algorithm3.4.2.1" class="ltx_text ltx_font_bold">Output :</span> Pruned graph <math id="algorithm3.m8" class="ltx_Math" alttext="\mathcal{G}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathcal{G}^{\prime}</annotation></semantics></math>
</div>
<div id="algorithm3.4.3" class="ltx_listingline"><span id="algorithm3.4.3.1" class="ltx_text ltx_font_bold">Parameter :</span> weights <math id="algorithm3.m9" class="ltx_Math" alttext="\alpha_{1},\alpha_{2},\alpha_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub><mo>,</mo><msub><mi>α</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">\alpha_{1},\alpha_{2},\alpha_{3}</annotation></semantics></math>
</div>
<div id="algorithm3.4.4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm3.4.4.1" class="ltx_text ltx_font_bold">1</span></span>
          <math id="algorithm3.m10" class="ltx_Math" alttext="\mathcal{G}_{n}(v)\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\mathcal{G}_{n}(v)\leftarrow\emptyset</annotation></semantics></math>
<span id="algorithm3.4.4.2" class="ltx_text ltx_font_bold">foreach</span> <em id="algorithm3.4.4.3" class="ltx_emph ltx_font_italic"><math id="algorithm3.m11" class="ltx_Math" alttext="u\in\mathcal{V}" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow><annotation encoding="application/x-tex">u\in\mathcal{V}</annotation></semantics></math></em> <span id="algorithm3.4.4.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm3.4.5" class="ltx_listingline">  
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm3.4.5.1" class="ltx_text ltx_font_bold">2</span></span>
          <math id="algorithm3.m12" class="ltx_Math" alttext="\delta(u)\leftarrow p_{u}^{(1)}(\mathcal{G},\mathcal{T}_{v}^{\prime})-p_{u}^{(2)}(\mathcal{G},\mathcal{T}_{v}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mrow><msubsup><mi>p</mi><mi>u</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>v</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>p</mi><mi>u</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>v</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta(u)\leftarrow p_{u}^{(1)}(\mathcal{G},\mathcal{T}_{v}^{\prime})-p_{u}^{(2)}(\mathcal{G},\mathcal{T}_{v}^{\prime})</annotation></semantics></math>
