            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.15.1" class="ltx_text ltx_font_bold">11</span></span>
          <math id="algorithm1.m27" class="ltx_Math" alttext="\mathcal{I}_{k}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>k</mi></msub><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\mathcal{I}_{k}\leftarrow</annotation></semantics></math> indices of top-<math id="algorithm1.m28" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> tokens by <math id="algorithm1.m29" class="ltx_Math" alttext="\xi(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>ξ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\xi(\cdot)</annotation></semantics></math> 
</div>
<div id="algorithm1.4.16" class="ltx_listingline">      <span id="algorithm1.4.16.1" class="ltx_text ltx_font_typewriter">/* </span><span id="algorithm1.4.16.2" class="ltx_text ltx_font_typewriter">Select top-<math id="algorithm1.m30" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> pivotal tokens  */</span>
</div>
<div id="algorithm1.4.17" class="ltx_listingline">      
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.17.1" class="ltx_text ltx_font_bold">12</span></span>
          <math id="algorithm1.m31" class="ltx_math_unparsed" alttext="\mathcal{P}\leftarrow\{\,W_{i}\mid\xi(W_{i})&gt;\tau,\ i\in\mathcal{I}_{k}\,\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">←</mo><mrow><mo rspace="0.170em" stretchy="false">{</mo><msub><mi>W</mi><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>ξ</mi><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>&gt;</mo><mi>τ</mi><mo rspace="0.667em">,</mo><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>k</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{P}\leftarrow\{\,W_{i}\mid\xi(W_{i})&gt;\tau,\ i\in\mathcal{I}_{k}\,\}</annotation></semantics></math> 
