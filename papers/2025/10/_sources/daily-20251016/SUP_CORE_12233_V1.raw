<span id="S4.T2.5.4.3.1.1" class="ltx_p ltx_align_center">0.914</span>
</span></td>
<td id="S4.T2.5.4.4" class="ltx_td ltx_nopad_l ltx_align_left">
<span id="S4.T2.5.4.4.1" class="ltx_inline-block ltx_align_top">
<span id="S4.T2.5.4.4.1.1" class="ltx_p ltx_align_center">3.290</span>
</span></td>
<td id="S4.T2.5.4.5" class="ltx_td ltx_align_left">
<span id="S4.T2.5.4.5.1" class="ltx_inline-block ltx_align_top">
<span id="S4.T2.5.4.5.1.1" class="ltx_p ltx_align_center">580.38</span>
</span></td>
<td id="S4.T2.5.4.6" class="ltx_td ltx_nopad_l ltx_align_left">
<span id="S4.T2.5.4.6.1" class="ltx_inline-block ltx_align_top">
