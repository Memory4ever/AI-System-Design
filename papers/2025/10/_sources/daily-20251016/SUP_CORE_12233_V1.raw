          <math id="algorithm2.m30" class="ltx_Math" alttext="count\leftarrow count+1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">←</mo><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">count\leftarrow count+1</annotation></semantics></math>
<span id="algorithm2.4.21.2" class="ltx_text ltx_font_bold">if</span> <em id="algorithm2.4.21.3" class="ltx_emph ltx_font_italic"><math id="algorithm2.m31" class="ltx_Math" alttext="count&gt;\beta\cdot|\mathcal{T}|" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>&gt;</mo><mrow><mi>β</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">count&gt;\beta\cdot|\mathcal{T}|</annotation></semantics></math></em> <span id="algorithm2.4.21.4" class="ltx_text ltx_font_bold">then</span> <span id="algorithm2.4.21.5" class="ltx_text ltx_font_bold">return</span> <em id="algorithm2.4.21.6" class="ltx_emph ltx_font_italic"><math id="algorithm2.m32" class="ltx_Math" alttext="T^{\prime}_{v}" display="inline" intent=":literal"><semantics><msubsup><mi>T</mi><mi>v</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">T^{\prime}_{v}</annotation></semantics></math></em>
