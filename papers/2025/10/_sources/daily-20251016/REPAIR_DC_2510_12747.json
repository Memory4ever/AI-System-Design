{"data":{"id":"10.48550/arxiv.2510.12747","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.12747","prefix":"10.48550","suffix":"arxiv.2510.12747","identifiers":[{"identifier":"2510.12747","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.12747"}],"creators":[{"name":"Zhuang, Junhao","nameType":"Personal","givenName":"Junhao","familyName":"Zhuang","affiliation":[],"nameIdentifiers":[]},{"name":"Guo, Shi","nameType":"Personal","givenName":"Shi","familyName":"Guo","affiliation":[],"nameIdentifiers":[]},{"name":"Cai, Xin","nameType":"Personal","givenName":"Xin","familyName":"Cai","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Xiaohui","nameType":"Personal","givenName":"Xiaohui","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Yihao","nameType":"Personal","givenName":"Yihao","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Yuan, Chun","nameType":"Personal","givenName":"Chun","familyName":"Yuan","affiliation":[],"nameIdentifiers":[]},{"name":"Xue, Tianfan","nameType":"Personal","givenName":"Tianfan","familyName":"Xue","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FlashVSR: Towards Real-Time Diffusion-Based Streaming Video Super-Resolution"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-14T17:25:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-15T01:05:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Diffusion models have recently advanced video restoration, but applying them to real-world video super-resolution (VSR) remains challenging due to high latency, prohibitive computation, and poor generalization to ultra-high resolutions. Our goal in this work is to make diffusion-based VSR practical by achieving efficiency, scalability, and real-time performance. To this end, we propose FlashVSR, the first diffusion-based one-step streaming framework towards real-time VSR. FlashVSR runs at approximately 17 FPS for 768x1408 videos on a single A100 GPU by combining three complementary innovations: (i) a train-friendly three-stage distillation pipeline that enables streaming super-resolution, (ii) locality-constrained sparse attention that cuts redundant computation while bridging the train-test resolution gap, and (iii) a tiny conditional decoder that accelerates reconstruction without sacrificing quality. To support large-scale training, we also construct VSR-120K, a new dataset with 120k videos and 180k images. Extensive experiments show that FlashVSR scales reliably to ultra-high resolutions and achieves state-of-the-art performance with up to 12x speedup over prior one-step diffusion VSR models. We will release the code, pretrained models, and dataset to foster future research in efficient diffusion-based VSR.","descriptionType":"Abstract"},{"description":"Project page with code: https://zhuang2002.github.io/FlashVSR","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.12747","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-15T02:09:20.000Z","registered":"2025-10-15T02:09:21.000Z","published":"2025","updated":"2025-10-15T02:09:21.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.12747","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}