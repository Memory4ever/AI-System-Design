        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.12801">pdf</a>, <a href="https://arxiv.org/ps/2510.12801">ps</a>, <a href="https://arxiv.org/format/2510.12801">other</a>]&nbsp;</span>
