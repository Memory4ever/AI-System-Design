        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.12422">pdf</a>, <a href="https://arxiv.org/ps/2510.12422">ps</a>, <a href="https://arxiv.org/format/2510.12422">other</a>]&nbsp;</span>
