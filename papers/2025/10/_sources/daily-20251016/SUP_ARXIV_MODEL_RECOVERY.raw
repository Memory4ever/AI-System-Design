        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.12847">pdf</a>, <a href="https://arxiv.org/ps/2510.12847">ps</a>, <a href="https://arxiv.org/format/2510.12847">other</a>]&nbsp;</span>
