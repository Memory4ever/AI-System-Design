<meta property="og:title" content="Multi-Action Self-Improvement for Neural Combinatorial Optimization" />
<meta property="og:url" content="https://arxiv.org/abs/2510.12273v1" />
<meta property="og:image" content="/static/browse/0.3.4/images/arxiv-logo-fb.png" />
