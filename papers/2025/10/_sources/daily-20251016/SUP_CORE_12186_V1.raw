            (<math id="alg1.l4.m1" class="ltx_Math" alttext="EP_{n}" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">EP_{n}</annotation></semantics></math>, <math id="alg1.l4.m2" class="ltx_Math" alttext="EP_{w}" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>w</mi></msub></mrow><annotation encoding="application/x-tex">EP_{w}</annotation></semantics></math>, <math id="alg1.l4.m3" class="ltx_Math" alttext="EP_{r}" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>r</mi></msub></mrow><annotation encoding="application/x-tex">EP_{r}</annotation></semantics></math>) <math id="alg1.l4.m4" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> classifyByDependency(<math id="alg1.l4.m5" class="ltx_Math" alttext="EP" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">EP</annotation></semantics></math>, <math id="alg1.l4.m6" class="ltx_Math" alttext="ST" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">ST</annotation></semantics></math>)

