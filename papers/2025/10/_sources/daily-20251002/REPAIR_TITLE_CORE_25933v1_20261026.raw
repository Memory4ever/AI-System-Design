:none" d="M 54.28 0 L 108.56 184.34 L 187.78 241.65 L 258.1 235.39 L 329.28 154.17"></path></g><g></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-width="1.5pt"><path style="fill:none" d="M 54.28 240.76 L 108.56 248.94 L 187.78 246.7 L 258.1 227.51 L 329.28 84.62"></path></g><g></g></g><g style="--ltx-fill-color:#9999FF;" fill="#9999FF" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-width="1.5pt"><path d="M 54.28 243.53 L 56.68 239.38 L 51.88 239.38 Z"></path><path d="M 108.56 259.78 L 110.96 255.63 L 106.17 255.63 Z"></path><path d="M 187.78 248.16 L 190.18 244.01 L 185.39 244.01 Z"></path><path d="M 258.1 234.16 L 260.5 230.01 L 255.71 230.01 Z"></path><path d="M 329.28 146.45 L 331.67 142.3 L 326.88 142.3 Z"></path></g><g style="--ltx-fill-color:#0000FF;" fill="#0000FF" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-width="1.5pt"><path d="M 57.05 254.79 C 57.05 256.31 55.81 257.55 54.28 257.55 C 52.75 257.55 51.51 256.31 51.51 254.79 C 51.51 253.26 52.75 252.02 54.28 252.02 C 55.81 252.02 57.05 253.26 57.05 254.79 Z M 54.28 254.79"></path><path d="M 111.33 247.67 C 111.33 249.2 110.09 250.43 108.56 250.43 C 107.03 250.43 105.8 249.2 105.8 247.67 C 105.8 246.14 107.03 244.9 108.56 244.9 C 110.09 244.9 111.33 246.14 111.33 247.67 Z M 108.56 247.67"></path><path d="M 190.55 244.08 C 190.55 245.61 189.31 246.85 187.78 246.85 C 186.25 246.85 185.02 245.61 185.02 244.08 C 185.02 242.55 186.25 241.31 187.78 241.31 C 189.31 241.31 190.55 242.55 190.55 244.08 Z M 187.78 244.08"></path><path d="M 260.87 234.2 C 260.87 235.73 259.63 236.97 258.1 236.97 C 256.57 236.97 255.34 235.73 255.34 234.2 C 255.34 232.67 256.57 231.43 258.1 231.43 C 259.63 231.43 260.87 232.67 260.87 234.2 Z M 258.1 234.2"></path><path d="M 332.05 155.54 C 332.05 157.07 330.81 158.31 329.28 158.31 C 327.75 158.31 326.51 157.07 326.51 155.54 C 326.51 154.01 327.75 152.77 329.28 152.77 C 330.81 152.77 332.05 154.01 332.05 155.54 Z M 329.28 155.54"></path></g><g style="