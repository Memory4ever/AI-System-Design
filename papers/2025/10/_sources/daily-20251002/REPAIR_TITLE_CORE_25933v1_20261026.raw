th style="fill:none" d="M 0.11 0 L 0.11 247.5 L 385.11 247.5 L 385.11 0 L 0.11 0 Z"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 96.92 -16.15)"><foreignObject style="--ltx-fo-width:1.45em;--ltx-fo-height:0.81em;--ltx-fo-depth:0em;font-size:10pt;" height="11.26" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="20.04"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F3.pic1.m1" class="ltx_Math" alttext="10^{1}" display="inline" intent=":literal"><semantics><msup><mn>10</mn><mn>1</mn></msup><annotation encoding="application/x-tex">10^{1}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 203.87 -16.15)"><foreignObject style="--ltx-fo-width:1.45em;--ltx-fo-height:0.81em;--ltx-fo-depth:0em;font-size:10pt;" height="11.26" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="20.04"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F3.pic1.m2" class="ltx_Math" alttext="10^{2}" display="inline" intent=":literal"><semantics><msup><mn>10</mn><mn>2</mn></msup><annotation encoding="application/x-tex">10^{2}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 310.81 -16.15)"><foreignObject style="--ltx-fo-width:1.45em;--ltx-fo-height:0.81em;--ltx-fo-depth:0em;font-size:10pt;" height="11.26" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="20.04"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F3.pic1.m3" class="ltx_Math" alttext="10^{3}" display="inline" intent=":literal"><semantics><msup><mn>10</mn><mn>3</mn></msup><annotation encodin