<div id="S4.T5.fig2.3" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:172.5pt;height:50.9pt;vertical-align:-24.5pt;"><span class="ltx_transformed_inner" style="transform:translate(-140.7pt,41.5pt) scale(0.379976750920073,0.379976750920073) ;">
