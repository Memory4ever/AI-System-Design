<tbody class="ltx_tbody">
<tr id="S4.T5.fig2.3.1.1" class="ltx_tr">
<th id="S4.T5.fig2.3.1.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_tt" style="padding-top:0.5pt;padding-bottom:0.5pt;" rowspan="2"><span id="S4.T5.fig2.3.1.1.1.1" class="ltx_text ltx_font_bold">Method</span></th>
<td id="S4.T5.fig2.3.1.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-top:0.5pt;padding-bottom:0.5pt;" colspan="2"><span id="S4.T5.fig2.3.1.1.2.1" class="ltx_text ltx_font_bold">MATH500</span></td>
