<span id="S5.T2.p1.1.1.1.1.3.8" class="ltx_td ltx_align_center ltx_border_t">79.53</span>
<span id="S5.T2.p1.1.1.1.1.3.9" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">86.11</span>
<span id="S5.T2.p1.1.1.1.1.3.10" class="ltx_td ltx_align_center ltx_border_t">83.83</span>
<span id="S5.T2.p1.1.1.1.1.3.11" class="ltx_td ltx_align_center ltx_border_t">1.51</span></span>
<span id="S5.T2.p1.1.1.1.1.4" class="ltx_tr">
<span id="S5.T2.p1.1.1.1.1.4.1" class="ltx_td ltx_align_left">LoHa</span>
<span id="S5.T2.p1.1.1.1.1.4.2" class="ltx_td ltx_align_center">77.22</span>
<span id="S5.T2.p1.1.1.1.1.4.3" class="ltx_td ltx_align_center">88.97</span>
<span id="S5.T2.p1.1.1.1.1.4.4" class="ltx_td ltx_align_center">72.75</span>
<span id="S5.T2.p1.1.1.1.1.4.5" class="ltx_td ltx_align_center">94.21</span>
<span id="S5.T2.p1.1.1.1.1.4.6" class="ltx_td ltx_align_center">85.00</span>
<span id="S5.T2.p1.1.1.1.1.4.7" class="ltx_td ltx_align_center">87.60</span>
<span id="S5.T2.p1.1.1.1.1.4.8" class="ltx_td ltx_align_center">78.61</span>
