<span id="S5.T2.p1.1.1.1.1.1.10" class="ltx_td ltx_align_center ltx_border_tt">Avg.</span>
<span id="S5.T2.p1.1.1.1.1.1.11" class="ltx_td ltx_align_center ltx_border_tt"><math id="S5.T2.p1.m1" class="ltx_math_unparsed" alttext="\Delta m\%(\downarrow)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mi>m</mi><mo>%</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em" stretchy="false">↓</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta m\%(\downarrow)</annotation></semantics></math></span></span>
<span id="S5.T2.p1.1.1.1.1.2" class="ltx_tr">
<span id="S5.T2.p1.1.1.1.1.2.1" class="ltx_td ltx_align_left ltx_border_t">Single</span>
<span id="S5.T2.p1.1.1.1.1.2.2" class="ltx_td ltx_align_center ltx_border_t">78.84</span>
<span id="S5.T2.p1.1.1.1.1.2.3" class="ltx_td ltx_align_center ltx_border_t">90.70</span>
<span id="S5.T2.p1.1.1.1.1.2.4" class="ltx_td ltx_align_center ltx_border_t">73.98</span>
<span id="S5.T2.p1.1.1.1.1.2.5" class="ltx_td ltx_align_center ltx_border_t">95.33</span>
<span id="S5.T2.p1.1.1.1.1.2.6" class="ltx_td ltx_align_center ltx_border_t">85.80</span>
<span id="S5.T2.p1.1.1.1.1.2.7" class="ltx_td ltx_align_center ltx_border_t">89.77</span>
<span id="S5.T2.p1.1.1.1.1.2.8" class="ltx_td ltx_align_center ltx_border_t">81.06</span>
<span id="S5.T2.p1.1.1.1.1.2.9" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">85.64</span>
<span id="S5.T2.p1.1.1.1.1.2.10" class="ltx_td ltx_align_center ltx_border_t">85.14</span>
<span id="S5.T2.p1.1.1.1.1.2.11" class="ltx_td ltx_border_t"></span></span>
<span id="S5.T2.p1.1.1.1.1.3" class="ltx_tr">
<span id="S5.T2.p1.1.1.1.1.3.1" class="ltx_td ltx_align_left ltx_border_t">LoRA</span>
<span id="S5.T2.p1.1.1.1.1.3.2" class="ltx_td ltx_align_center ltx_border_t">77.39</span>
