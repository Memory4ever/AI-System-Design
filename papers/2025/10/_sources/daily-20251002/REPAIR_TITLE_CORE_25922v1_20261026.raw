<td id="Sx1.T1.1.1.6.4" class="ltx_td ltx_align_center">493</td>
<td id="Sx1.T1.1.1.6.5" class="ltx_td ltx_align_center">No</td>
<td id="Sx1.T1.1.1.6.6" class="ltx_td ltx_align_center">Not Specified</td>
<td id="Sx1.T1.1.1.6.7" class="ltx_td ltx_align_center">No</td>
<td id="Sx1.T1.1.1.6.8" class="ltx_td ltx_align_center">No</td></tr>
<tr id="Sx1.T1.1.1.7" class="ltx_tr">
<td id="Sx1.T1.1.1.7.1" class="ltx_td ltx_align_left">NESTFULl <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib2" title="" class="ltx_ref">Basu et al. 2025</a>)</cite></td>
<td id="Sx1.T1.1.1.7.2" class="ltx_td ltx_align_center">No</td>
