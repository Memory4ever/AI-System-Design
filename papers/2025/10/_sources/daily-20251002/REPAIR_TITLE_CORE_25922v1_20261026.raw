</div>
<div id="alg1.l21" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">21:</span>
              
              <span id="alg1.l21.1" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l21.m1" class="ltx_Math" alttext="d(S)\geq d_{\min}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><msub><mi>d</mi><mi>min</mi></msub></mrow><annotation encoding="application/x-tex">d(S)\geq d_{\min}</annotation></semantics></math> <span id="alg1.l21.2" class="ltx_text ltx_font_bold">and</span> <math id="alg1.l21.m2" class="ltx_Math" alttext="|V_{S}|\geq n_{\min}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi>V</mi><mi>S</mi></msub><mo stretchy="false">|</mo></mrow><mo>≥</mo><msub><mi>n</mi><mi>min</mi></msub></mrow><annotation encoding="application/x-tex">|V_{S}|\geq n_{\min}</annotation></semantics></math> <span id="alg1.l21.3" class="ltx_text ltx_font_bold">then</span>

