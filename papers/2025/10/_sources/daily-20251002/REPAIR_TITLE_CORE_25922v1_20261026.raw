<td id="Sx1.T1.1.1.7.4" class="ltx_td ltx_align_center">1800</td>
<td id="Sx1.T1.1.1.7.5" class="ltx_td ltx_align_center">Yes</td>
<td id="Sx1.T1.1.1.7.6" class="ltx_td ltx_align_center">1</td>
<td id="Sx1.T1.1.1.7.7" class="ltx_td ltx_align_center">No</td>
<td id="Sx1.T1.1.1.7.8" class="ltx_td ltx_align_center">Yes</td></tr>
<tr id="Sx1.T1.1.1.8" class="ltx_tr">
<td id="Sx1.T1.1.1.8.1" class="ltx_td ltx_align_left">StrucText-Eval <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib7" title="" class="ltx_ref">Gu et al. 2024</a>)</cite></td>
<td id="Sx1.T1.1.1.8.2" class="ltx_td ltx_align_center">No</td>
<td id="Sx1.T1.1.1.8.3" class="ltx_td ltx_align_center">Structure Interpretation</td>
<td id="Sx1.T1.1.1.8.4" class="ltx_td ltx_align_center">5800</td>
