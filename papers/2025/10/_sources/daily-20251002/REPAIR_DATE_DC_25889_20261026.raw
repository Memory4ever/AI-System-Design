{"data":{"id":"10.48550/arxiv.2509.25889","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.25889","prefix":"10.48550","suffix":"arxiv.2509.25889","identifiers":[{"identifier":"2509.25889","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.25889"}],"creators":[{"name":"Vepa, Arvind Murari","nameType":"Personal","givenName":"Arvind Murari","familyName":"Vepa","affiliation":[],"nameIdentifiers":[]},{"name":"Yu, Yannan","nameType":"Personal","givenName":"Yannan","familyName":"Yu","affiliation":[],"nameIdentifiers":[]},{"name":"Gan, Jingru","nameType":"Personal","givenName":"Jingru","familyName":"Gan","affiliation":[],"nameIdentifiers":[]},{"name":"Cuturrufo, Anthony","nameType":"Personal","givenName":"Anthony","familyName":"Cuturrufo","affiliation":[],"nameIdentifiers":[]},{"name":"Romano, Michael F.","nameType":"Personal","givenName":"Michael F.","familyName":"Romano","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Weikai","nameType":"Personal","givenName":"Weikai","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Scalzo, Fabien","nameType":"Personal","givenName":"Fabien","familyName":"Scalzo","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Wei","nameType":"Personal","givenName":"Wei","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Sun, Yizhou","nameType":"Personal","givenName":"Yizhou","familyName":"Sun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multimodal LLM With Hierarchical Mixture-of-Experts for VQA on 3D Brain MRI"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-30T07:30:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T00:41:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-01T03:37:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-02T00:24:41Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02-12T23:25:21Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-02-16T01:11:01Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Multiparametric 3D brain MRI (mpMRI) is central to neuroradiology, but producing tumor location, appearance, size, and involvement of critical structures for neurosurgical planning remains challenging. We introduce mpLLM, a multimodal LLM for visual question answering (VQA) on mpMRI that produces clinically interpretable tumor descriptors (e.g., volume, morphology, extent, and coarse localization) as an adjunct to clinical expertise for referring neurosurgeons. mpLLM uses a prompt-conditioned hierarchical mixture-of-experts (MoE) to fuse multiple 3D sequences via routing over modality- and token-level projection experts, enabling data-efficient end-to-end training without large-scale image-report pretraining. To address limited paired image-text supervision, we propose a synthetic VQA protocol that derives clinically grounded questions and answers from expert segmentation annotations and is validated with radiologist collaboration. Across multiple mpMRI datasets, mpLLM improves over strong medical VLM baselines by +5.5 points on average (+9.1% relative) and increases radiologist-rated clinical acceptability by +15.9 points (+46.6% relative). Our study features three main contributions: (1) the first VQA dataset for 3D brain mpMRI, (2) a hierarchical MoE architecture for joint reasoning over interrelated 3D sequences, and (3) expert-supported evidence of clinical utility. Source code is available at https://github.com/arvindmvepa/mpllm, and we will release the dataset upon publication.","descriptionType":"Abstract"},{"description":"17 pages, 3 figures","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.25889","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:23:29.000Z","registered":"2025-10-01T02:23:30.000Z","published":"2025","updated":"2026-02-16T03:00:20.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.25889","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}},"included":[{"id":"arxiv.content","type":"clients","attributes":{"name":"arXiv","symbol":"ARXIV.CONTENT","year":2021,"alternateName":null,"description":null,"language":[],"clientType":"repository","domains":"*","re3data":null,"opendoar":null,"issn":{},"url":null,"created":"2021-03-29T15:47:29.000Z","updated":"2024-11-05T11:34:27.000Z","isActive":true},"relationships":{"provider":{"data":{"id":"arxiv","type":"providers"}},"prefixes":{"data":[{"id":"10.48550","type":"prefixes"}]}}}]}