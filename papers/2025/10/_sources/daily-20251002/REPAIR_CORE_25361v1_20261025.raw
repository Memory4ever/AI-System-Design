<td id="A3.T5.2.3.3" class="ltx_td ltx_align_center" style="padding:3pt 8.0pt;"><span id="A3.T5.2.3.3.1" class="ltx_text" style="--ltx-bg-color:#F3F7FA;">106.1</span></td></tr>
