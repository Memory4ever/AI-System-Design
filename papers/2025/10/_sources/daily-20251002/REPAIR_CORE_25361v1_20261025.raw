<td id="A3.T5.2.4.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding:3pt 8.0pt;"><span id="A3.T5.2.4.2.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F3F7FA;">22.8</span></td>
