<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(b) </span>H100-1 (causal mask)</figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S5.F5.sf3" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.26541v1/AMD-full.svg" id="S5.F5.sf3.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/283;" width="476" height="283"></object>
