<tr id="S3.T2.2.1.6" class="ltx_tr">
<th id="S3.T2.2.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r"><math id="S3.T2.m7" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math></th>
