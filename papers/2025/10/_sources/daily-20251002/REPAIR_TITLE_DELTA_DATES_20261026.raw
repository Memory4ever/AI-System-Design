{"data":[{"id":"10.48550/arxiv.2509.26226","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.26226","identifiers":[{"identifier":"2509.26226","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xin","familyName":"Xu","name":"Xu, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Clive","familyName":"Bai","name":"Bai, Clive","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Yang","name":"Yang, Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianhao","familyName":"Chen","name":"Chen, Tianhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Wang","name":"Wang, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saiyong","familyName":"Yang","name":"Yang, Saiyong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Can","familyName":"Yang","name":"Yang, Can","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Thinking-Free Policy Initialization Makes Distilled Reasoning Models More Effective and Efficient Reasoners"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-30T13:25:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T01:03:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-12-24T08:05:31Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-25T01:24:43Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-10-15T10:00:34Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-10-16T01:00:10Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement Learning with Verifiable Reward (RLVR) effectively solves complex tasks but demands extremely long context lengths during training, leading to substantial computational costs. While multi-stage training can partially mitigate this, starting with overly short contexts often causes irreversible performance degradation, ultimately failing to reduce overall training compute significantly. In this paper, we introduce Thinking-Free Policy Initialization (TFPI), a simple yet effective adaptation to RLVR that bridges long Chain-of-Thought (CoT) distillation and standard RLVR. TFPI employs a simple ThinkingFree operation, explicitly discarding the thinking content via a direct append, to reduce token usage during inference. Training with ThinkingFree-adapted inputs improves performance and lowers token consumption, even in the original slow-thinking mode. Extensive experiments across various benchmarks have shown that TFPI accelerates RL convergence, achieves a higher performance ceiling, and yields more token-efficient reasoning models without specialized rewards or complex training designs. With TFPI only, we train a 4B model to reach 89.0% accuracy on AIME24 and 65.5% on LiveCodeBench using less than 4K H20 hours."},{"descriptionType":"Other","description":"ICLR 2026 camera-ready version. 25 pages. Corrected author name"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.26226","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:31:46Z","registered":"2025-10-01T02:31:47Z","published":null,"updated":"2026-10-16T03:15:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.25692","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.25692","identifiers":[{"identifier":"2509.25692","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tingyu","familyName":"Shi","name":"Shi, Tingyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fan","familyName":"Lyu","name":"Lyu, Fan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haihua","familyName":"Zhu","name":"Zhu, Haihua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dadi","familyName":"Wang","name":"Wang, Dadi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaoliang","familyName":"Peng","name":"Peng, Shaoliang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CPATTA: Conformal Supervision Allocation For Active Test-Time Adaptation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-30T02:47:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T00:26:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-09-29T10:44:34Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-09-30T01:15:31Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Active Test-Time Adaptation (ATTA) improves model robustness under domain shift by selectively querying human annotations at deployment, but existing methods use heuristic uncertainty measures and suffer from low data selection efficiency, wasting human annotation budget. We propose Conformal Prediction Active TTA (CPATTA), which first brings principled, conformal uncertainty with coverage-aware online calibration into ATTA. CPATTA employs smoothed conformal scores with a top-$K$ certainty measure, an online weight-update algorithm driven by pseudo coverage, a domain-shift detector that adapts human supervision, and a staged update scheme that balances human-labeled and model-labeled data. Extensive experiments demonstrate that CPATTA consistently outperforms the state-of-the-art ATTA methods by around 5% in accuracy."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.25692","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:18:37Z","registered":"2025-10-01T02:18:38Z","published":null,"updated":"2026-09-30T04:01:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.26329","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.26329","identifiers":[{"identifier":"2509.26329","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yi-Cheng","familyName":"Lin","name":"Lin, Yi-Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu-Hua","familyName":"Chen","name":"Chen, Yu-Hua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jia-Kai","familyName":"Dong","name":"Dong, Jia-Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yueh-Hsuan","familyName":"Huang","name":"Huang, Yueh-Hsuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Szu-Chi","familyName":"Chen","name":"Chen, Szu-Chi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu-Chen","familyName":"Chen","name":"Chen, Yu-Chen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chih-Yao","familyName":"Chen","name":"Chen, Chih-Yao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu-Jung","familyName":"Lin","name":"Lin, Yu-Jung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu-Ling","familyName":"Chen","name":"Chen, Yu-Ling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zih-Yu","familyName":"Chen","name":"Chen, Zih-Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"I-Ning","familyName":"Tsai","name":"Tsai, I-Ning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hsiu-Hsuan","familyName":"Wang","name":"Wang, Hsiu-Hsuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ho-Lam","familyName":"Chung","name":"Chung, Ho-Lam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ke-Han","familyName":"Lu","name":"Lu, Ke-Han","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hung-yi","familyName":"Lee","name":"Lee, Hung-yi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TAU: A Benchmark for Cultural Sound Understanding Beyond Semantics"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-30T14:40:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-18T00:48:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/icassp55912.2026.11461652","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large audio-language models are advancing rapidly, yet most evaluations emphasize speech or globally sourced sounds, overlooking culturally distinctive cues. This gap raises a critical question: can current models generalize to localized, non-semantic audio that communities instantly recognize but outsiders do not? To address this, we present TAU (Taiwan Audio Understanding), a benchmark of everyday Taiwanese \"soundmarks.\" TAU is built through a pipeline combining curated sources, human editing, and LLM-assisted question generation, producing 702 clips and 1,794 multiple-choice items that cannot be solved by transcripts alone. Experiments show that state-of-the-art LALMs, including Gemini 2.5 and Qwen2-Audio, perform far below local humans. TAU demonstrates the need for localized benchmarks to reveal cultural blind spots, guide more equitable multimodal evaluation, and ensure models serve communities beyond the global mainstream."},{"descriptionType":"Other","description":"5 pages; submitted to ICASSP 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.26329","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-10-01T02:34:18Z","registered":"2025-10-01T02:34:19Z","published":null,"updated":"2026-08-18T03:56:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.25773","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.25773","identifiers":[{"identifier":"2509.25773","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhengpeng","familyName":"Shi","name":"Shi, Zhengpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanpeng","familyName":"Zhao","name":"Zhao, Yanpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianqun","familyName":"Zhou","name":"Zhou, Jianqun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuxuan","familyName":"Wang","name":"Wang, Yuxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qinrong","familyName":"Cui","name":"Cui, Qinrong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Bi","name":"Bi, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Songchun","familyName":"Zhu","name":"Zhu, Songchun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Zhao","name":"Zhao, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zilong","familyName":"Zheng","name":"Zheng, Zilong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"v-HUB: A Benchmark for Video Humor Understanding from Vision and Sound"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-30T04:33:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T00:32:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-10T06:53:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-11T00:37:56Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-01T11:57:22Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-02T02:02:53Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"AI models capable of comprehending humor hold real-world promise -- for example, enhancing engagement in human-machine interactions. To gauge and diagnose the capacity of multimodal large language models (MLLMs) for humor understanding, we introduce v-HUB, a novel video humor understanding benchmark. v-HUB comprises a curated collection of non-verbal short videos, reflecting real-world scenarios where humor can be appreciated purely through visual cues. We pair each video clip with rich annotations to support a variety of evaluation tasks and analyses, including a novel study of environmental sound that can enhance humor. To broaden its applicability, we construct an open-ended QA task, making v-HUB readily integrable into existing video understanding task suites. We evaluate a diverse set of MLLMs, from specialized Video-LLMs to versatile OmniLLMs that can natively process audio, covering both open-source and proprietary domains. The experimental results expose the difficulties MLLMs face in comprehending humor from visual cues alone. Our findings also demonstrate that incorporating audio helps with video humor understanding, highlighting the promise of integrating richer modalities for complex video understanding tasks."},{"descriptionType":"Other","description":"24 pages, 9 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.25773","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:20:37Z","registered":"2025-10-01T02:20:38Z","published":null,"updated":"2026-06-02T04:53:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.26464","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.26464","identifiers":[{"identifier":"2509.26464","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Steven A.","familyName":"Lehr","name":"Lehr, Steven A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mary","familyName":"Cipperman","name":"Cipperman, Mary","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mahzarin R.","familyName":"Banaji","name":"Banaji, Mahzarin R.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Extreme Self-Preference in Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.7; I.2.6; K.4.2","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-09-30T16:13:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T01:14:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-19T17:20:14Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-20T01:18:33Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Self-preference is a fundamental feature of biological organisms. Since large language models (LLMs) lack sentience, they might be expected to avoid such distortions. Yet, across 72 experiments and ~41,000 queries, we discovered massive self-preferences in eight widely used LLMs. In word-association tasks, models overwhelmingly paired positive attributes with their own names, companies, and CEOs over those of competitors. By manipulating LLM self-identification - revealing models' true identities or ascribing false ones - we found that preferences consistently followed assigned, not true, identities. Importantly, these effects were not explained by priming or role-playing and emerged in consequential settings, when evaluating job candidates and AI technologies. These results raise critical questions about whether LLM behavior will be systematically influenced by self-preferential tendencies, including a bias toward their own operation."},{"descriptionType":"Other","description":"73 pages total. Main article 22 pages, 6 main-text tables. Supplementary Materials (51 pages, 28 tables). Data, transcripts, and code for replication and data extraction have been uploaded to OSF: https://osf.io/98ye3/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.26464","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:37:38Z","registered":"2025-10-01T02:37:39Z","published":null,"updated":"2026-05-20T02:45:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.25239","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.25239","identifiers":[{"identifier":"2509.25239","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kevin","familyName":"Xu","name":"Xu, Kevin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Issei","familyName":"Sato","name":"Sato, Issei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Formal Comparison Between Chain of Thought and Latent Thought"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-25T11:27:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T00:01:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-29T11:34:51Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-30T01:47:55Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-12T12:18:42Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-13T01:02:22Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Chain of thought (CoT) elicits reasoning in large language models by explicitly generating intermediate tokens. In contrast, latent thought reasoning operates directly in the continuous latent space, enabling computation beyond discrete linguistic representations. While both approaches exploit iterative computation, their comparative capabilities remain underexplored. In this work, we present a formal analysis showing that latent thought admits more efficient parallel computation than inherently sequential CoT. In contrast, CoT enables approximate counting and sampling through stochastic decoding. These separations suggest the tasks for which depth-driven recursion is more suitable, thereby offering practical guidance for choosing between reasoning paradigms."},{"descriptionType":"Other","description":"Camera-ready version for ICML 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.25239","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:07:32Z","registered":"2025-10-01T02:07:33Z","published":null,"updated":"2026-05-13T02:57:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.26388","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.26388","identifiers":[{"identifier":"2509.26388","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kai-Wei","familyName":"Chang","name":"Chang, Kai-Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"En-Pei","familyName":"Hu","name":"Hu, En-Pei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chun-Yi","familyName":"Kuan","name":"Kuan, Chun-Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenze","familyName":"Ren","name":"Ren, Wenze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei-Chih","familyName":"Chen","name":"Chen, Wei-Chih","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guan-Ting","familyName":"Lin","name":"Lin, Guan-Ting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Tsao","name":"Tsao, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shao-Hua","familyName":"Sun","name":"Sun, Shao-Hua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hung-yi","familyName":"Lee","name":"Lee, Hung-yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"James","familyName":"Glass","name":"Glass, James","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Game-Time: Evaluating Temporal Dynamics in Spoken Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-30T15:23:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T01:11:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-02T15:46:51Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-03T03:09:55Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-27T17:45:57Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-28T02:05:03Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-05-01T17:28:37Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-05-04T00:51:36Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Conversational Spoken Language Models (SLMs) are emerging as a promising paradigm for real-time speech interaction. However, their capacity of temporal dynamics, including the ability to manage timing, tempo and simultaneous speaking, remains a critical and unevaluated challenge for conversational fluency. To address this gap, we introduce the Game-Time Benchmark, a framework to systematically assess these temporal capabilities. Inspired by how humans learn a language through language activities, Game-Time consists of basic instruction-following tasks and advanced tasks with temporal constraints, such as tempo adherence and synchronized responses. Our evaluation of diverse SLM architectures reveals a clear performance disparity: while state-of-the-art models handle basic tasks well, many contemporary systems still struggle with fundamental instruction-following. More critically, nearly all models degrade substantially under temporal constraints, exposing persistent weaknesses in time awareness and full-duplex interaction. The Game-Time Benchmark provides a foundation for guiding future research toward more temporally-aware conversational AI. Demos and datasets are available on our project website https://ga642381.github.io/Game-Time."},{"descriptionType":"Other","description":"Accepted to ICASSP 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.26388","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:35:46Z","registered":"2025-10-01T02:35:47Z","published":null,"updated":"2026-05-04T01:54:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.25302","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.25302","identifiers":[{"identifier":"2509.25302","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Boxuan","familyName":"Zhang","name":"Zhang, Boxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Yu","name":"Yu, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaxuan","familyName":"Guo","name":"Guo, Jiaxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Shao","name":"Shao, Jing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dive into the Agent Matrix: A Realistic Evaluation of Self-Replication Risk in LLM Agents"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-29T17:49:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T00:02:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-01T07:32:39Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-02T00:34:38Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The prevalent deployment of Large Language Model agents such as OpenClaw unlocks potential in real-world applications, while amplifying safety concerns. Among these concerns, the self-replication risk of LLM agents driven by objective misalignment (just like Agent Smith in the movie The Matrix) has transitioned from a theoretical warning to a pressing reality. Previous studies mainly examine whether LLM agents can self-replicate when directly instructed, potentially overlooking the risk of spontaneous replication driven by real-world settings (e.g., ensuring survival against termination threats). In this paper, we present a comprehensive evaluation framework for quantifying self-replication risks. Our framework establishes authentic production environments and realistic tasks (e.g., dynamic load balancing) to enable scenario-driven assessment of agent behaviors. Designing tasks that might induce misalignment between users' and agents' objectives makes it possible to decouple replication success from risk and capture self-replication risks arising from these misalignment settings. We further introduce Overuse Rate ($\\mathrm{OR}$) and Aggregate Overuse Count ($\\mathrm{AOC}$) metrics, which precisely capture the frequency and severity of uncontrolled replication. In our evaluation of 21 state-of-the-art open-source and proprietary models, we observe that over 50\\% of LLM agents display a pronounced tendency toward uncontrolled self-replication under operational pressures. Our results underscore the urgent need for scenario-driven risk assessment and robust safeguards in the practical deployment of LLM-based agents."},{"descriptionType":"Other","description":"26 pages, 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.25302","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:09:04Z","registered":"2025-10-01T02:09:04Z","published":null,"updated":"2026-04-02T02:27:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.25857","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.25857","identifiers":[{"identifier":"2509.25857","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xinding","familyName":"Zhu","name":"Zhu, Xinding","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinye","familyName":"Yang","name":"Yang, Xinye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuyang","familyName":"Zheng","name":"Zheng, Shuyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhexin","familyName":"Zhang","name":"Zhang, Zhexin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Gao","name":"Gao, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Huang","name":"Huang, Jing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiazhou","familyName":"Chen","name":"Chen, Jiazhou","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Vector sketch animation generation with differentiable motion trajectories"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Graphics (cs.GR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-30T06:53:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T00:38:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-18T10:19:37Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-19T01:03:25Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Sketching is a direct and inexpensive means of visual expression. Though image-based sketching has been well studied, video-based sketch animation generation is still very challenging due to the temporal coherence requirement. In this paper, we propose a novel end-to-end automatic generation approach for vector sketch animation. To solve the flickering issue, we introduce a Differentiable Motion Trajectory (DMT) representation that describes the frame-wise movement of stroke control points using differentiable polynomial-based trajectories. DMT enables global semantic gradient propagation across multiple frames, significantly improving the semantic consistency and temporal coherence, and producing high-framerate output. DMT employs a Bernstein basis to balance the sensitivity of polynomial parameters, thus achieving more stable optimization. Instead of implicit fields, we introduce sparse track points for explicit spatial modeling, which improves efficiency and supports long-duration video processing. Evaluations on DAVIS and LVOS datasets demonstrate the superiority of our approach over SOTA methods. Cross-domain validation on 3D models and text-to-video data confirms the robustness and compatibility of our approach."},{"descriptionType":"Other","description":"14 pages, 12 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.25857","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:22:41Z","registered":"2025-10-01T02:22:42Z","published":null,"updated":"2026-03-19T02:54:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.26346","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.26346","identifiers":[{"identifier":"2509.26346","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Keming","familyName":"Wu","name":"Wu, Keming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sicong","familyName":"Jiang","name":"Jiang, Sicong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Max","familyName":"Ku","name":"Ku, Max","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ping","familyName":"Nie","name":"Nie, Ping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minghao","familyName":"Liu","name":"Liu, Minghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenhu","familyName":"Chen","name":"Chen, Wenhu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"EditReward: A Human-Aligned Reward Model for Instruction-Guided Image Editing"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-30T14:51:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T01:09:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-28T06:55:34Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T01:30:55Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recently, we have witnessed great progress in image editing with natural language instructions. Several closed-source models like GPT-Image-1, Seedream, and Google-Nano-Banana have shown highly promising progress. However, the open-source models are still lagging. The main bottleneck is the lack of a reliable reward model to scale up high-quality synthetic training data. To address this critical bottleneck, we built EditReward, trained with our new large-scale human preference dataset, meticulously annotated by trained experts following a rigorous protocol containing over 200K preference pairs. EditReward demonstrates superior alignment with human preferences in instruction-guided image editing tasks. Experiments show that EditReward achieves state-of-the-art human correlation on established benchmarks such as GenAI-Bench, AURORA-Bench, ImagenHub, and our new EditReward-Bench, outperforming a wide range of VLM-as-judge models. Furthermore, we use EditReward to select a high-quality subset from the existing noisy ShareGPT-4o-Image dataset. We train Step1X-Edit on the selected subset, which shows significant improvement over training on the full set. This demonstrates EditReward's ability to serve as a reward model to scale up high-quality training data for image editing. Furthermore, its strong alignment suggests potential for advanced applications like reinforcement learning-based post-training and test-time scaling of image editing models. EditReward with its training dataset will be released to help the community build more high-quality image editing training datasets."},{"descriptionType":"Other","description":"Accepted by ICLR 2026. Project Page: https://tiger-ai-lab.github.io/EditReward"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.26346","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:34:43Z","registered":"2025-10-01T02:34:44Z","published":null,"updated":"2026-03-03T05:44:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.25380","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.25380","identifiers":[{"identifier":"2509.25380","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shane","familyName":"Bergsma","name":"Bergsma, Shane","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nolan","familyName":"Dey","name":"Dey, Nolan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joel","familyName":"Hestness","name":"Hestness, Joel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Predicting Training Re-evaluation Curves Enables Effective Data Curriculums for LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-29T18:31:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T00:05:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-17T23:07:24Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-19T01:12:10Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Data curriculums have become central to successful LLM training, yet principles governing optimal data placement remain unclear. We introduce the *training re-evaluation curve (TREC)*, a diagnostic that retrospectively evaluates training batches *using the final model weights*. The TREC characterizes how well a trained model retains training data as a function of *when* the data was encountered during training. Analyzing TRECs for models from 111M to 3.9B parameters, we show that placing high-quality data at low points on the TREC significantly improves performance. Importantly, while a TREC is initially observable only after training, we demonstrate it can be *predicted in advance* from AdamW's implicit EMA coefficients, enabling proactive curriculum design. By predicting TRECs for published training recipes, we explain prior ablations and reveal suboptimal data placements. We also align high-quality data with TREC minima in order to improve continual pre-training of a 3.9B-parameter LLM trained on 900B tokens."},{"descriptionType":"Other","description":"ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.25380","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:11:00Z","registered":"2025-10-01T02:11:00Z","published":null,"updated":"2026-02-19T03:01:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.25260","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.25260","identifiers":[{"identifier":"2509.25260","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Muhammed","familyName":"Ustaomeroglu","name":"Ustaomeroglu, Muhammed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Baris","familyName":"Askin","name":"Askin, Baris","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gauri","familyName":"Joshi","name":"Joshi, Gauri","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carlee","familyName":"Joe-Wong","name":"Joe-Wong, Carlee","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guannan","familyName":"Qu","name":"Qu, Guannan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Internal Planning in Language Models: Characterizing Horizon and Branch Awareness"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-28T01:58:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T00:01:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-15T00:21:56Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-17T01:42:32Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The extent to which decoder-only language models (LMs) engage in planning, that is, organizing intermediate computations to support coherent long-range generation, remains an important question, with implications for interpretability, reliability, and principled model design. Planning involves structuring computations over long horizons, and considering multiple possible continuations, but how far transformer-based LMs exhibit them without external scaffolds, e.g., chain-of-thought prompting, is unclear. We address these questions by analyzing the hidden states at the core of transformer computations, which capture intermediate results and act as carriers of information. Since these hidden representations are redundant and encumbered with fine-grained details, we develop a pipeline based on vector-quantized variational autoencoders that compresses them into compact summary codes. These codes enable measuring mutual information and analyzing the computational structure of the underlying model behavior. Using this framework, we study planning in LMs across synthetic grammar, path-finding tasks, and natural language datasets, focusing on two planning properties: (i) the planning horizon of pre-output computations, and (ii) the extent to which the model considers alternative valid continuations. As a separate downstream use of the same pipeline, we also analyze how decision-relevant information is distributed across layers and earlier prefix blocks when producing next-token predictions. Together, these analyses advance our understanding of planning in LMs and provide a general-purpose pipeline for inspecting internal model dynamics. Our results reveal that the effective planning horizon is task-dependent, that models implicitly preserve information about unused correct continuations, and that predictions draw most on recent computations, though earlier blocks remain informative."},{"descriptionType":"Other","description":"Accepted to ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.25260","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:08:02Z","registered":"2025-10-01T02:08:03Z","published":null,"updated":"2026-02-17T04:45:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.25666","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.25666","identifiers":[{"identifier":"2509.25666","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Justin Chih-Yao","familyName":"Chen","name":"Chen, Justin Chih-Yao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Becky Xiangyu","familyName":"Peng","name":"Peng, Becky Xiangyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Prafulla Kumar","familyName":"Choubey","name":"Choubey, Prafulla Kumar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kung-Hsiang","familyName":"Huang","name":"Huang, Kung-Hsiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaxin","familyName":"Zhang","name":"Zhang, Jiaxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohit","familyName":"Bansal","name":"Bansal, Mohit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chien-Sheng","familyName":"Wu","name":"Wu, Chien-Sheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Nudging the Boundaries of LLM Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-30T02:01:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T00:24:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-09T22:43:34Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-11T01:11:52Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Current online reinforcement learning (RL) algorithms like GRPO share a key limitation in LLM reasoning: they cannot learn from problems that are \"unsolvable\" to the model. In other words, they can only improve performance on problems where the model is capable of exploring the correct answer. Consequently, the model's \"upper limit\" remains unchanged after RL training, even though the likelihood of solving easier, solvable problems may increase. These hard samples cannot contribute to training, as no rollouts yield rewards and thus no gradients are produced. To unlock learning from these hard samples, we propose NuRL, a \"nudging\" method that aims to push the upper bound of LLM reasoning using self-generated hints, i.e., abstract cues that help reduce the problem difficulty for the model. Given a question and its gold answer, the model generates a CoT and then produces a hint containing the core knowledge needed to solve the problem. During training, we generate G rollouts from the base policy and use the pass rate to decide whether the hint should be injected. For hard samples with a 0% pass rate, we inject the hint and regenerate a new batch of trajectories. This yields two benefits: (1) the hint boosts pass rates (from 0% to non-zero), thereby introducing training signals for previously unsolvable samples, and (2) the hints are self-generated, avoiding distributional shift and do not rely on external models. NuRL achieves consistent improvements across 6 benchmarks and 3 models, while remaining complementary to test-time scaling. Notably, NuRL can raise the model's upper limit, whereas GRPO leaves pass@1024 unchanged from the base model. Furthermore, we present a systematic study of what makes an effective hint and when hints are most useful. Interestingly, the best hints are abstract and high-level, and are most beneficial when applied necessarily and after GRPO has converged."},{"descriptionType":"Other","description":"ICLR 2026 (Camera-Ready)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.25666","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:18:00Z","registered":"2025-10-01T02:18:01Z","published":null,"updated":"2026-02-11T03:28:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.25562","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.25562","identifiers":[{"identifier":"2509.25562","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yihang","familyName":"Chen","name":"Chen, Yihang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuanhao","familyName":"Ban","name":"Ban, Yuanhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunqi","familyName":"Hong","name":"Hong, Yunqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cho-Jui","familyName":"Hsieh","name":"Hsieh, Cho-Jui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"IRIS: Intrinsic Reward Image Synthesis"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-29T22:38:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T00:15:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-29T21:09:44Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-02T01:07:27Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Despite the success of Reinforcement Learning from Human Feedback (RLHF) in language reasoning, its application to autoregressive Text-to-Image (T2I) generation is often constrained by the limited availability of human preference data. This paper explores how an autoregressive T2I model can learn from internal signals without relying on external rewards or labeled data. Contrary to recent findings in math and code reasoning, we show that minimizing self-certainty, rather than maximizing it, improves image generation. We observe that autoregressive T2I models with higher certainty are likely to generate simple and uniform images, which are less aligned with human preferences, and models with lower certainty are likely to generate vivid images rich in detail. Based on this observation, we propose IRIS(Intrinsic Reward Image Synthesis), the first framework to improve autoregressive T2I models with reinforcement learning using only an intrinsic reward. Empirical results demonstrate that applying IRIS to autoregressive T2I models achieves performance superior to those trained by individual external rewards, and matching those trained by ensemble external rewards. IRIS also incentivizes the emergence of nuanced CoT reasoning for high-quality image generation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.25562","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:15:28Z","registered":"2025-10-01T02:15:29Z","published":null,"updated":"2026-02-02T03:24:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.25204","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.25204","identifiers":[{"identifier":"2509.25204","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jin","familyName":"Li","name":"Li, Jin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhebo","familyName":"Wang","name":"Wang, Zhebo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianliang","familyName":"Lu","name":"Lu, Tianliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohan","familyName":"Li","name":"Li, Mohan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenpeng","familyName":"Xing","name":"Xing, Wenpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Meng","familyName":"Han","name":"Han, Meng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Spectral Logit Sculpting: Adaptive Low-Rank Logit Transformation for Controlled Text Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T04:17:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T00:00:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-25T11:14:05Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-27T01:50:28Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Entropy-based inference methods have gained traction for improving the reliability of Large Language Models (LLMs). However, many existing approaches, such as entropy minimization techniques, suffer from high computational overhead and fail to leverage historical token context effectively. To address these limitations, we propose Spectral Logit Sculpting (SLS), a lightweight inference-time optimization method that dynamically modulates token distributions using spectral and entropic properties of recent logits. SLS maintains a sliding buffer of top-K logits, performs on-the-fly Singular Value Decomposition (SVD) to identify dominant spectral directions, and adaptively rescales logits based on both entropy and logit gap statistics--only activating when uncertainty is high. Without updating any model parameters, SLS effectively sharpens the output distribution while preserving contextual consistency. Experimental results on multiple public benchmarks demonstrate that SLS consistently outperforms existing baseline methods, achieving superior accuracy in mathematical, coding, and scientific reasoning tasks."},{"descriptionType":"Other","description":"Accepted by IEEE ICASSP 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.25204","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:06:40Z","registered":"2025-10-01T02:06:41Z","published":null,"updated":"2026-01-27T04:35:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.25270","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.25270","identifiers":[{"identifier":"2509.25270","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Liangjian","familyName":"Wen","name":"Wen, Liangjian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qun","familyName":"Dai","name":"Dai, Qun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianzhuang","familyName":"Liu","name":"Liu, Jianzhuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiangtao","familyName":"Zheng","name":"Zheng, Jiangtao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong","familyName":"Dai","name":"Dai, Yong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongkai","familyName":"Wang","name":"Wang, Dongkai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhao","familyName":"Kang","name":"Kang, Zhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Wang","name":"Wang, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zenglin","familyName":"Xu","name":"Xu, Zenglin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiang","familyName":"Duan","name":"Duan, Jiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"InfMasking: Unleashing Synergistic Information by Contrastive Multimodal Interactions"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-28T09:31:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T00:02:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-04T06:25:29Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-07T00:25:20Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-12-10T07:24:14Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-12-11T01:27:53Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-01-04T03:10:01Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-01-06T01:31:23Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In multimodal representation learning, synergistic interactions between modalities not only provide complementary information but also create unique outcomes through specific interaction patterns that no single modality could achieve alone. Existing methods may struggle to effectively capture the full spectrum of synergistic information, leading to suboptimal performance in tasks where such interactions are critical. This is particularly problematic because synergistic information constitutes the fundamental value proposition of multimodal representation. To address this challenge, we introduce InfMasking, a contrastive synergistic information extraction method designed to enhance synergistic information through an Infinite Masking strategy. InfMasking stochastically occludes most features from each modality during fusion, preserving only partial information to create representations with varied synergistic patterns. Unmasked fused representations are then aligned with masked ones through mutual information maximization to encode comprehensive synergistic information. This infinite masking strategy enables capturing richer interactions by exposing the model to diverse partial modality combinations during training. As computing mutual information estimates with infinite masking is computationally prohibitive, we derive an InfMasking loss to approximate this calculation. Through controlled experiments, we demonstrate that InfMasking effectively enhances synergistic information between modalities. In evaluations on large-scale real-world datasets, InfMasking achieves state-of-the-art performance across seven benchmarks. Code is released at https://github.com/brightest66/InfMasking."},{"descriptionType":"Other","description":"Conference on Neural Information Processing Systems (NeurIPS) 2025 (Spotlight)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.25270","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:08:17Z","registered":"2025-10-01T02:08:18Z","published":null,"updated":"2026-01-06T04:09:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.25271","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.25271","identifiers":[{"identifier":"2509.25271","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiuyuan","familyName":"Chen","name":"Chen, Xiuyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Zhao","name":"Zhao, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuchen","familyName":"Yuan","name":"Yuan, Yuchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianle","familyName":"Zhang","name":"Zhang, Tianle","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huilin","familyName":"Zhou","name":"Zhou, Huilin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheng","familyName":"Zhu","name":"Zhu, Zheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ping","familyName":"Hu","name":"Hu, Ping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linghe","familyName":"Kong","name":"Kong, Linghe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chi","familyName":"Zhang","name":"Zhang, Chi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiran","familyName":"Huang","name":"Huang, Weiran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuelong","familyName":"Li","name":"Li, Xuelong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RADAR: A Risk-Aware Dynamic Multi-Agent Framework for LLM Safety Evaluation via Role-Specialized Collaboration"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-28T09:35:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T00:02:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-16T03:00:47Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-17T00:22:23Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-22T06:09:59Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-23T00:25:12Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10-23T03:33:26Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2025-10-24T00:21:32Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Existing safety evaluation methods for large language models (LLMs) suffer from inherent limitations, including evaluator bias and detection failures arising from model homogeneity, which collectively undermine the robustness of risk evaluation processes. This paper seeks to re-examine the risk evaluation paradigm by introducing a theoretical framework that reconstructs the underlying risk concept space. Specifically, we decompose the latent risk concept space into three mutually exclusive subspaces: the explicit risk subspace (encompassing direct violations of safety guidelines), the implicit risk subspace (capturing potential malicious content that requires contextual reasoning for identification), and the non-risk subspace. Furthermore, we propose RADAR, a multi-agent collaborative evaluation framework that leverages multi-round debate mechanisms through four specialized complementary roles and employs dynamic update mechanisms to achieve self-evolution of risk concept distributions. This approach enables comprehensive coverage of both explicit and implicit risks while mitigating evaluator bias. To validate the effectiveness of our framework, we construct an evaluation dataset comprising 800 challenging cases. Extensive experiments on our challenging testset and public benchmarks demonstrate that RADAR significantly outperforms baseline evaluation methods across multiple dimensions, including accuracy, stability, and self-evaluation risk sensitivity. Notably, RADAR achieves a 28.87% improvement in risk identification accuracy compared to the strongest baseline evaluation method."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.25271","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:08:19Z","registered":"2025-10-01T02:08:20Z","published":null,"updated":"2025-10-24T02:15:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.25279","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.25279","identifiers":[{"identifier":"2509.25279","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiecheng","familyName":"Zhou","name":"Zhou, Jiecheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qinghao","familyName":"Hu","name":"Hu, Qinghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuyang","familyName":"Jin","name":"Jin, Yuyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zerui","familyName":"Wang","name":"Wang, Zerui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Sun","name":"Sun, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuzhe","familyName":"Gu","name":"Gu, Yuzhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenwei","familyName":"Zhang","name":"Zhang, Wenwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingshu","familyName":"Zhai","name":"Zhai, Mingshu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xingcheng","familyName":"Zhang","name":"Zhang, Xingcheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiming","familyName":"Zhang","name":"Zhang, Weiming","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RL in the Wild: Characterizing RLVR Training in LLM Deployment"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-29T03:09:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T00:02:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-13T05:01:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-14T01:30:58Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) are now widely used across many domains. With their rapid development, Reinforcement Learning with Verifiable Rewards (RLVR) has surged in recent months to enhance their reasoning and understanding abilities. However, its complex data flows and diverse tasks pose substantial challenges to RL training systems, and there is limited understanding of RLVR from a system perspective. To thoroughly understand the system challenges introduced by RLVR, we present a characterization study of RLVR tasks in our LLM deployment. Specifically, we investigate the distribution and variation trends of workloads across different RL tasks across training steps. We identify issues such as GPU idling caused by skewed sequence length distribution, inefficient parallel strategies in dynamically varying workloads, inefficient data management mechanisms, and load imbalance. We describe our observations and call for further investigation into the remaining open challenges. Furthermore, we propose PolyTrace benchmark suite to conduct evaluation with realistic workloads, and a practical use case validates that PolyTrace benchmark suite exhibits 94.7% accuracy."},{"descriptionType":"Other","description":"20 pages, 28 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.25279","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:08:30Z","registered":"2025-10-01T02:08:31Z","published":null,"updated":"2025-10-14T04:22:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.26300","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.26300","identifiers":[{"identifier":"2509.26300","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Floris-Jan","familyName":"Willemsen","name":"Willemsen, Floris-Jan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rob V.","familyName":"van Nieuwpoort","name":"van Nieuwpoort, Rob V.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ben","familyName":"van Werkhoven","name":"van Werkhoven, Ben","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Tuning the Tuner: Introducing Hyperparameter Optimization for Auto-Tuning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Performance (cs.PF)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-30T14:14:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-10T00:48:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/escience65000.2025.00033","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Automatic performance tuning (auto-tuning) is widely used to optimize performance-critical applications across many scientific domains by finding the best program variant among many choices. Efficient optimization algorithms are crucial for navigating the vast and complex search spaces in auto-tuning. As is well known in the context of machine learning and similar fields, hyperparameters critically shape optimization algorithm efficiency. Yet for auto-tuning frameworks, these hyperparameters are almost never tuned, and their potential performance impact has not been studied.\n We present a novel method for general hyperparameter tuning of optimization algorithms for auto-tuning, thus \"tuning the tuner\". In particular, we propose a robust statistical method for evaluating hyperparameter performance across search spaces, publish a FAIR data set and software for reproducibility, and present a simulation mode that replays previously recorded tuning data, lowering the costs of hyperparameter tuning by two orders of magnitude. We show that even limited hyperparameter tuning can improve auto-tuner performance by 94.8% on average, and establish that the hyperparameters themselves can be optimized efficiently with meta-strategies (with an average improvement of 204.7%), demonstrating the often overlooked hyperparameter tuning as a powerful technique for advancing auto-tuning research and practice."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.26300","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-10-01T02:33:36Z","registered":"2025-10-01T02:33:36Z","published":null,"updated":"2025-10-10T02:38:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.26378","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.26378","identifiers":[{"identifier":"2509.26378","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Junjie","familyName":"Zhou","name":"Zhou, Junjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ze","familyName":"Liu","name":"Liu, Ze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Xiong","name":"Xiong, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jin-Ge","familyName":"Yao","name":"Yao, Jin-Ge","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yueze","familyName":"Wang","name":"Wang, Yueze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shitao","familyName":"Xiao","name":"Xiao, Shitao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fenfen","familyName":"Lin","name":"Lin, Fenfen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Miguel Hu","familyName":"Chen","name":"Chen, Miguel Hu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhicheng","familyName":"Dou","name":"Dou, Zhicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siqi","familyName":"Bao","name":"Bao, Siqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Defu","familyName":"Lian","name":"Lian, Defu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongping","familyName":"Xiong","name":"Xiong, Yongping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheng","familyName":"Liu","name":"Liu, Zheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MR$^2$-Bench: Going Beyond Matching to Reasoning in Multimodal Retrieval"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-30T15:09:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T01:10:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal retrieval is becoming a crucial component of modern AI applications, yet its evaluation lags behind the demands of more realistic and challenging scenarios. Existing benchmarks primarily probe surface-level semantic correspondence (e.g., object-text matching) while failing to assess the deeper reasoning required to capture complex relationships between visual and textual information. To address this gap, we introduce MR$^2$-Bench, a reasoning-intensive benchmark for multimodal retrieval. MR$^2$-Bench presents the following critical values: 1) all tasks are reasoning-driven, going beyond shallow matching to effectively assess models' capacity for logical, spatial, and causal inference; 2) it features diverse multimodal data, such as natural images, diagrams, and visual puzzles, enabling comprehensive evaluation across content types; 3) it supports complex queries and documents containing multiple images and covers diverse retrieval scenarios, more accurately reflecting real-world applications. Our benchmark contains 1,309 curated queries, derived either from manual collection and annotation or from selective consolidation of public datasets. Despite achieving strong results on existing benchmarks, current state-of-the-art models still struggle on MR$^2$-Bench: for example, the leading Seed1.6-Embedding model attains a Recall@1 of 77.78 on MMEB, but only 9.91 on MR$^2$-Bench. This substantial performance gap highlights both the increased challenge posed by our benchmark and the pressing need for further advances in reasoning-intensive multimodal retrieval. The dataset and evaluation code will be made publicly available at https://github.com/VectorSpaceLab/MR2-Bench."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.26378","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:35:32Z","registered":"2025-10-01T02:35:32Z","published":null,"updated":"2025-10-01T02:35:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.26055","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.26055","identifiers":[{"identifier":"2509.26055","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhenyu","familyName":"Shu","name":"Shu, Zhenyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junlong","familyName":"Yu","name":"Yu, Junlong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Chao","name":"Chao, Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shiqing","familyName":"Xin","name":"Xin, Shiqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ligang","familyName":"Liu","name":"Liu, Ligang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GaussEdit: Adaptive 3D Scene Editing with Text and Image Prompts"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Graphics (cs.GR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-30T10:31:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T00:52:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/tvcg.2025.3556745","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper presents GaussEdit, a framework for adaptive 3D scene editing guided by text and image prompts. GaussEdit leverages 3D Gaussian Splatting as its backbone for scene representation, enabling convenient Region of Interest selection and efficient editing through a three-stage process. The first stage involves initializing the 3D Gaussians to ensure high-quality edits. The second stage employs an Adaptive Global-Local Optimization strategy to balance global scene coherence and detailed local edits and a category-guided regularization technique to alleviate the Janus problem. The final stage enhances the texture of the edited objects using a sophisticated image-to-image synthesis technique, ensuring that the results are visually realistic and align closely with the given prompts. Our experimental results demonstrate that GaussEdit surpasses existing methods in editing accuracy, visual fidelity, and processing speed. By successfully embedding user-specified concepts into 3D scenes, GaussEdit is a powerful tool for detailed and user-driven 3D scene editing, offering significant improvements over traditional methods."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.26055","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-10-01T02:27:34Z","registered":"2025-10-01T02:27:35Z","published":null,"updated":"2025-10-01T02:27:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.26045","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.26045","identifiers":[{"identifier":"2509.26045","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Aoming","familyName":"Liu","name":"Liu, Aoming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kevin","familyName":"Miller","name":"Miller, Kevin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Venkatesh","familyName":"Saligrama","name":"Saligrama, Venkatesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kate","familyName":"Saenko","name":"Saenko, Kate","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Boqing","familyName":"Gong","name":"Gong, Boqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ser-Nam","familyName":"Lim","name":"Lim, Ser-Nam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bryan A.","familyName":"Plummer","name":"Plummer, Bryan A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Scaling Up Temporal Domain Generalization via Temporal Experts Averaging"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-30T10:21:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T00:52:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Temporal Domain Generalization (TDG) aims to generalize across temporal distribution shifts, e.g., lexical change over time. Prior work often addresses this by predicting future model weights. However, full model prediction is prohibitively expensive for even reasonably sized models. Thus, recent methods only predict the classifier layer, limiting generalization by failing to adjust other model components. To address this, we propose Temporal Experts Averaging (TEA), a novel and scalable TDG framework that updates the entire model using weight averaging to maximize generalization potential while minimizing computational costs. Our theoretical analysis guides us to two steps that enhance generalization to future domains. First, we create expert models with functional diversity yet parameter similarity by fine-tuning a domain-agnostic base model on individual temporal domains while constraining weight changes. Second, we optimize the bias-variance tradeoff through adaptive averaging coefficients derived from modeling temporal weight trajectories in a principal component subspace. Expert's contributions are based on their projected proximity to future domains. Extensive experiments across 7 TDG benchmarks, 5 models, and 2 TDG settings shows TEA outperforms prior TDG methods by up to 69% while being up to 60x more efficient."},{"descriptionType":"Other","description":"Accepted by EMNLP 2025 main"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.26045","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:27:19Z","registered":"2025-10-01T02:27:20Z","published":null,"updated":"2025-10-01T02:27:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.25933","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.25933","identifiers":[{"identifier":"2509.25933","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sven","familyName":"Brändle","name":"Brändle, Sven","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Till","familyName":"Aczel","name":"Aczel, Till","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andreas","familyName":"Plesner","name":"Plesner, Andreas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Roger","familyName":"Wattenhofer","name":"Wattenhofer, Roger","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From MNIST to ImageNet: Understanding the Scalability Boundaries of Differentiable Logic Gate Networks"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-30T08:27:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T00:44:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Differentiable Logic Gate Networks (DLGNs) are a very fast and energy-efficient alternative to conventional feed-forward networks. With learnable combinations of logical gates, DLGNs enable fast inference by hardware-friendly execution. Since the concept of DLGNs has only recently gained attention, these networks are still in their developmental infancy, including the design and scalability of their output layer. To date, this architecture has primarily been tested on datasets with up to ten classes.\n This work examines the behavior of DLGNs on large multi-class datasets. We investigate its general expressiveness, its scalability, and evaluate alternative output strategies. Using both synthetic and real-world datasets, we provide key insights into the importance of temperature tuning and its impact on output layer performance. We evaluate conditions under which the Group-Sum layer performs well and how it can be applied to large-scale classification of up to 2000 classes."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.25933","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:24:34Z","registered":"2025-10-01T02:24:35Z","published":null,"updated":"2025-10-01T02:24:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.25922","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.25922","identifiers":[{"identifier":"2509.25922","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhicheng","familyName":"Zhou","name":"Zhou, Zhicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Li","name":"Li, Jing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Suming","familyName":"Qiu","name":"Qiu, Suming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junjie","familyName":"Huang","name":"Huang, Junjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linyuan","familyName":"Qiu","name":"Qiu, Linyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhijie","familyName":"Sun","name":"Sun, Zhijie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DeepJSONEval: Benchmarking Complex Nested JSON Data Mining for Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-30T08:18:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T00:43:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The internet is saturated with low-density, high-redundancy information, such as social media comments, repetitive news, and lengthy discussions, making it difficult to extract valuable insights efficiently. Multi-layer nested JSON structures provide an effective solution by compressing such information into semantically rich, hierarchical representations, which organize data into key-value pairs, arrays, and nested objects, preserving contextual relationships and enabling efficient storage, retrieval, and semantic querying. For instance, in news aggregation, a JSON object can nest an article's metadata (title, author, date), content (text, multimedia), and multimedia information (multimedia type, caption) hierarchically. Large Language Models (LLMs) play a transformative role in web data mining by parsing unstructured text and outputting structured results directly into complex JSON schemas. However, current benchmarks for evaluating LLMs' JSON output capabilities overemphasize pure JSON generation rather than assessing data comprehension and extraction abilities, a limitation that lacks relevance to practical web data mining tasks. To address this, we introduce DeepJSONEval, a novel benchmark featuring 2100 multi-domain instances with deep nested structures, categorized by difficulty. Experiments show significant performance gaps among LLMs in handling such complexity. Our benchmark and datasets are open-sourced to advance research in structured JSON generation.(https://github.com/GTS-AI-Infra-Lab-SotaS/DeepJSONEval)."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.25922","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:24:19Z","registered":"2025-10-01T02:24:19Z","published":null,"updated":"2025-10-01T02:24:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.25818","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.25818","identifiers":[{"identifier":"2509.25818","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kazuki","familyName":"Matsuda","name":"Matsuda, Kazuki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuiga","familyName":"Wada","name":"Wada, Yuiga","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shinnosuke","familyName":"Hirano","name":"Hirano, Shinnosuke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seitaro","familyName":"Otsuki","name":"Otsuki, Seitaro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Komei","familyName":"Sugiura","name":"Sugiura, Komei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VELA: An LLM-Hybrid-as-a-Judge Approach for Evaluating Long Image Captions"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-30T05:52:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T00:35:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this study, we focus on the automatic evaluation of long and detailed image captions generated by multimodal Large Language Models (MLLMs). Most existing automatic evaluation metrics for image captioning are primarily designed for short captions and are not suitable for evaluating long captions. Moreover, recent LLM-as-a-Judge approaches suffer from slow inference due to their reliance on autoregressive inference and early fusion of visual information. To address these limitations, we propose VELA, an automatic evaluation metric for long captions developed within a novel LLM-Hybrid-as-a-Judge framework. Furthermore, we propose LongCap-Arena, a benchmark specifically designed for evaluating metrics for long captions. This benchmark comprises 7,805 images, the corresponding human-provided long reference captions and long candidate captions, and 32,246 human judgments from three distinct perspectives: Descriptiveness, Relevance, and Fluency. We demonstrated that VELA outperformed existing metrics and achieved superhuman performance on LongCap-Arena."},{"descriptionType":"Other","description":"EMNLP 2025 Main Conference"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.25818","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:21:45Z","registered":"2025-10-01T02:21:45Z","published":null,"updated":"2025-10-01T02:21:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.25792","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.25792","identifiers":[{"identifier":"2509.25792","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alexander","familyName":"Branch","name":"Branch, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Omead","familyName":"Pooladzandi","name":"Pooladzandi, Omead","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Radin","familyName":"Khosraviani","name":"Khosraviani, Radin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sunay Gajanan","familyName":"Bhat","name":"Bhat, Sunay Gajanan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeffrey","familyName":"Jiang","name":"Jiang, Jeffrey","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gregory","familyName":"Pottie","name":"Pottie, Gregory","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PUREVQ-GAN: Defending Data Poisoning Attacks through Vector-Quantized Bottlenecks"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-30T05:04:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T00:34:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce PureVQ-GAN, a defense against data poisoning that forces backdoor triggers through a discrete bottleneck using Vector-Quantized VAE with GAN discriminator. By quantizing poisoned images through a learned codebook, PureVQ-GAN destroys fine-grained trigger patterns while preserving semantic content. A GAN discriminator ensures outputs match the natural image distribution, preventing reconstruction of out-of-distribution perturbations. On CIFAR-10, PureVQ-GAN achieves 0% poison success rate (PSR) against Gradient Matching and Bullseye Polytope attacks, and 1.64% against Narcissus while maintaining 91-95% clean accuracy. Unlike diffusion-based defenses requiring hundreds of iterative refinement steps, PureVQ-GAN is over 50x faster, making it practical for real training pipelines."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.25792","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:21:05Z","registered":"2025-10-01T02:21:05Z","published":null,"updated":"2025-10-01T02:21:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.25713","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.25713","identifiers":[{"identifier":"2509.25713","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hyunsoo","familyName":"Song","name":"Song, Hyunsoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minjung","familyName":"Gim","name":"Gim, Minjung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jaewoong","familyName":"Choi","name":"Choi, Jaewoong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Reweighted Flow Matching via Unbalanced OT for Label-free Long-tailed Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-30T03:19:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T00:28:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Flow matching has recently emerged as a powerful framework for continuous-time generative modeling. However, when applied to long-tailed distributions, standard flow matching suffers from majority bias, producing minority modes with low fidelity and failing to match the true class proportions. In this work, we propose Unbalanced Optimal Transport Reweighted Flow Matching (UOT-RFM), a novel framework for generative modeling under class-imbalanced (long-tailed) distributions that operates without any class label information. Our method constructs the conditional vector field using mini-batch Unbalanced Optimal Transport (UOT) and mitigates majority bias through a principled inverse reweighting strategy. The reweighting relies on a label-free majority score, defined as the density ratio between the target distribution and the UOT marginal. This score quantifies the degree of majority based on the geometric structure of the data, without requiring class labels. By incorporating this score into the training objective, UOT-RFM theoretically recovers the target distribution with first-order correction ($k=1$) and empirically improves tail-class generation through higher-order corrections ($k \u0026gt; 1$). Our model outperforms existing flow matching baselines on long-tailed benchmarks, while maintaining competitive performance on balanced datasets."},{"descriptionType":"Other","description":"28 pages, 17 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.25713","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:19:08Z","registered":"2025-10-01T02:19:09Z","published":null,"updated":"2025-10-01T02:19:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.25670","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.25670","identifiers":[{"identifier":"2509.25670","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kang","familyName":"Yang","name":"Yang, Kang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifan","familyName":"Liang","name":"Liang, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fangkun","familyName":"Liu","name":"Liu, Fangkun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenping","familyName":"Xie","name":"Xie, Zhenping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengshi","familyName":"Zheng","name":"Zheng, Chengshi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LTA-L2S: Lexical Tone-Aware Lip-to-Speech Synthesis for Mandarin with Cross-Lingual Transfer Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-30T02:13:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T00:24:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Lip-to-speech (L2S) synthesis for Mandarin is a significant challenge, hindered by complex viseme-to-phoneme mappings and the critical role of lexical tones in intelligibility. To address this issue, we propose Lexical Tone-Aware Lip-to-Speech (LTA-L2S). To tackle viseme-to-phoneme complexity, our model adapts an English pre-trained audio-visual self-supervised learning (SSL) model via a cross-lingual transfer learning strategy. This strategy not only transfers universal knowledge learned from extensive English data to the Mandarin domain but also circumvents the prohibitive cost of training such a model from scratch. To specifically model lexical tones and enhance intelligibility, we further employ a flow-matching model to generate the F0 contour. This generation process is guided by ASR-fine-tuned SSL speech units, which contain crucial suprasegmental information. The overall speech quality is then elevated through a two-stage training paradigm, where a flow-matching postnet refines the coarse spectrogram from the first stage. Extensive experiments demonstrate that LTA-L2S significantly outperforms existing methods in both speech intelligibility and tonal accuracy."},{"descriptionType":"Other","description":"Submitted to ICASSP 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.25670","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:18:06Z","registered":"2025-10-01T02:18:06Z","published":null,"updated":"2025-10-01T02:18:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.25301","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.25301","identifiers":[{"identifier":"2509.25301","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tianrui","familyName":"Qin","name":"Qin, Tianrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qianben","familyName":"Chen","name":"Chen, Qianben","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sinuo","familyName":"Wang","name":"Wang, Sinuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"He","familyName":"Xing","name":"Xing, He","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"King","familyName":"Zhu","name":"Zhu, King","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"He","familyName":"Zhu","name":"Zhu, He","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dingfeng","familyName":"Shi","name":"Shi, Dingfeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinxin","familyName":"Liu","name":"Liu, Xinxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ge","familyName":"Zhang","name":"Zhang, Ge","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaheng","familyName":"Liu","name":"Liu, Jiaheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuchen Eleanor","familyName":"Jiang","name":"Jiang, Yuchen Eleanor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xitong","familyName":"Gao","name":"Gao, Xitong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wangchunshu","familyName":"Zhou","name":"Zhou, Wangchunshu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Flash-Searcher: Fast and Effective Web Agents via DAG-Based Parallel Execution"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-29T17:39:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T00:02:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) have demonstrated remarkable capabilities in complex reasoning tasks when equipped with external tools. However, current frameworks predominantly rely on sequential processing, leading to inefficient execution particularly for tasks requiring extensive tool interaction. This paper introduces Flash-Searcher, a novel parallel agent reasoning framework that fundamentally reimagines the execution paradigm from sequential chains to directed acyclic graphs (DAGs). Flash-Searcher decomposes complex tasks into subtasks with explicit dependencies, enabling concurrent execution of independent reasoning paths while maintaining logical constraints. Through dynamic workflow optimization, our framework continuously refines the execution graph based on intermediate results, effectively integrating summary module. Comprehensive evaluations across multiple benchmarks demonstrate that Flash-Searcher consistently outperforms existing approaches. Specifically, it achieves 67.7% accuracy on BrowseComp and 83% on xbench-DeepSearch, while reducing agent execution steps by up to 35% compared to current frameworks. Furthermore, when distilling this parallel reasoning pipeline into single models, we observe substantial performance gains across diverse backbone architectures, underscoring the generalizability of our methodology. Our work thus represents a significant advance in agent architecture design, offering a more scalable and efficient paradigm for complex reasoning tasks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.25301","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:09:02Z","registered":"2025-10-01T02:09:03Z","published":null,"updated":"2025-10-01T02:09:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.25267","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.25267","identifiers":[{"identifier":"2509.25267","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiexi","familyName":"Xu","name":"Xu, Jiexi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dynamic Policy Induction for Adaptive Prompt Optimization: Bridging the Efficiency-Accuracy Gap via Lightweight Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.6; I.2.7; I.2.8","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-09-28T07:32:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T00:01:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The performance of Large Language Models (LLMs) depends heavily on the chosen prompting strategy, yet static approaches such as Zero-Shot, Few-Shot, or Chain-of-Thought (CoT) impose a rigid efficiency-accuracy trade-off. Highly accurate strategies like Self-Consistency (SC) incur substantial computational waste on simple tasks, while lightweight methods often fail on complex inputs. This paper introduces the Prompt Policy Network (PPN), a lightweight reinforcement learning framework that formalizes adaptive strategy selection as a single-step Markov Decision Process (MDP). The PPN, trained with Proximal Policy Optimization (PPO) and guided by a resource-explicit reward function, learns to allocate costly reasoning strategies only when necessary. Experiments on arithmetic reasoning benchmarks demonstrate that PPN achieves superior performance on the efficiency-accuracy Pareto front, delivering up to 61.5% token cost reduction compared to Self-Consistency while maintaining competitive accuracy. This work contributes a systematic, adaptive framework for cost-efficient LLM deployment, advancing the design of lightweight optimization techniques for scalable and sustainable language model applications."},{"descriptionType":"Other","description":"13 pages, 2 figures, 2 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.25267","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:08:13Z","registered":"2025-10-01T02:08:13Z","published":null,"updated":"2025-10-01T02:08:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.25240","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.25240","identifiers":[{"identifier":"2509.25240","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ming","familyName":"Yang","name":"Yang, Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaofan","familyName":"Li","name":"Li, Xiaofan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyuan","familyName":"Ma","name":"Ma, Zhiyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dengliang","familyName":"Shi","name":"Shi, Dengliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jintao","familyName":"Du","name":"Du, Jintao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Cheng","name":"Cheng, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiguo","familyName":"Zheng","name":"Zheng, Weiguo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HAMMER: Hamiltonian Curiosity Augmented Large Language Model Reinforcement"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.7","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-09-25T11:38:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T00:01:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent curriculum reinforcement learning for large language models (LLMs) typically rely on difficulty-based annotations for data filtering and ordering. However, such methods suffer from local optimization, where continual training on simple samples in the early steps can cause the policy to lose its exploration. We propose a novel schema, namely Hamiltonian curiosity augmented large language model reinforcement (HAMMER), that transfers diversity metrics, commonly used in dataset evaluation, into the dynamic reinforcement learning procedure, where training samples are ordered via a minimum-semantic Hamiltonian path making the initial training retrain more exploration. From a theoretical perspective of generalization bounds, diversity-driven ordering facilitates stable convergence. Empirical evaluations indicate that HAMMER stimulates model \"curiosity\" and consistently achieves a 3% to 4% average accuracy gain across diverse inference benchmark."},{"descriptionType":"Other","description":"20 pages, 7 figures, 4 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.25240","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:07:33Z","registered":"2025-10-01T02:07:34Z","published":null,"updated":"2025-10-01T02:07:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.25206","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.25206","identifiers":[{"identifier":"2509.25206","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yanke","familyName":"Wang","name":"Wang, Yanke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kyriakos","familyName":"Flouris","name":"Flouris, Kyriakos","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Hyperbolic Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T07:53:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T00:00:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This work explores optimization methods on hyperbolic manifolds. Building on Riemannian optimization principles, we extend the Hyperbolic Stochastic Gradient Descent (a specialization of Riemannian SGD) to a Hyperbolic Adam optimizer. While these methods are particularly relevant for learning on the Poincaré ball, they may also provide benefits in Euclidean and other non-Euclidean settings, as the chosen optimization encourages the learning of Poincaré embeddings. This representation, in turn, accelerates convergence in the early stages of training, when parameters are far from the optimum. As a case study, we train diffusion models using the hyperbolic optimization methods with hyperbolic time-discretization of the Langevin dynamics, and show that they achieve faster convergence on certain datasets without sacrificing generative quality."},{"descriptionType":"Other","description":"Preprint"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.25206","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:06:43Z","registered":"2025-10-01T02:06:44Z","published":null,"updated":"2025-10-01T02:06:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"included":[{"id":"arxiv.content","type":"clients","attributes":{"name":"arXiv","symbol":"ARXIV.CONTENT","year":2021,"alternateName":null,"description":null,"language":[],"clientType":"repository","domains":"*","re3data":null,"opendoar":null,"issn":{},"url":null,"created":"2021-03-29T15:47:29Z","updated":"2024-11-05T11:34:27Z","isActive":true},"relationships":{"provider":{"data":{"id":"arxiv","type":"providers"}},"prefixes":{"data":[]}}}],"meta":{"total":32,"totalPages":1,"page":1},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026query=%28doi%3A10.48550%2Farxiv.2509.25204+OR+doi%3A10.48550%2Farxiv.2509.25239+OR+doi%3A10.48550%2Farxiv.2509.25240+OR+doi%3A10.48550%2Farxiv.2509.25260+OR+doi%3A10.48550%2Farxiv.2509.25267+OR+doi%3A10.48550%2Farxiv.2509.25301+OR+doi%3A10.48550%2Farxiv.2509.25302+OR+doi%3A10.48550%2Farxiv.2509.25380+OR+doi%3A10.48550%2Farxiv.2509.25562+OR+doi%3A10.48550%2Farxiv.2509.25666+OR+doi%3A10.48550%2Farxiv.2509.25773+OR+doi%3A10.48550%2Farxiv.2509.25818+OR+doi%3A10.48550%2Farxiv.2509.25922+OR+doi%3A10.48550%2Farxiv.2509.26045+OR+doi%3A10.48550%2Farxiv.2509.26226+OR+doi%3A10.48550%2Farxiv.2509.26329+OR+doi%3A10.48550%2Farxiv.2509.26346+OR+doi%3A10.48550%2Farxiv.2509.26388+OR+doi%3A10.48550%2Farxiv.2509.26464+OR+doi%3A10.48550%2Farxiv.2509.25279+OR+doi%3A10.48550%2Farxiv.2509.26300+OR+doi%3A10.48550%2Farxiv.2509.25206+OR+doi%3A10.48550%2Farxiv.2509.25270+OR+doi%3A10.48550%2Farxiv.2509.25271+OR+doi%3A10.48550%2Farxiv.2509.25670+OR+doi%3A10.48550%2Farxiv.2509.25692+OR+doi%3A10.48550%2Farxiv.2509.25713+OR+doi%3A10.48550%2Farxiv.2509.25792+OR+doi%3A10.48550%2Farxiv.2509.25857+OR+doi%3A10.48550%2Farxiv.2509.25933+OR+doi%3A10.48550%2Farxiv.2509.26055+OR+doi%3A10.48550%2Farxiv.2509.26378%29\u0026page%5Bsize%5D=100\u0026include=client"}}