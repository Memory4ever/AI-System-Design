<span id="S4.T1.3.2.7.2.1.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T1.3.2.7.2.1.1.1" class="ltx_tr">
<span id="S4.T1.3.2.7.2.1.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:0.7pt 5.0pt;">Nat. Acc (%)</span></span>
<span id="S4.T1.3.2.7.2.1.1.2" class="ltx_tr">
<span id="S4.T1.3.2.7.2.1.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:0.7pt 5.0pt;"><math id="S4.T1.m6" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></span>
</span></span><span id="S4.T1.3.2.7.2.2" class="ltx_text"></span></span></td></tr>
<tr id="S4.T1.3.3" class="ltx_tr">
