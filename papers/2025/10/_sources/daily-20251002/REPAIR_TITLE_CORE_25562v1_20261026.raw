<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_1">
<figure id="A2.F11.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.25562v1/geneval_full_7b.svg" id="A2.F11.sf1.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:548/297;" width="548" height="297"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(a) </span><span id="A2.F11.sf1.3" class="ltx_text ltx_font_bold">GenEval</span></figcaption>
