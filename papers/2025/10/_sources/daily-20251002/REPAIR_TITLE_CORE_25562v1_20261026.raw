<figure id="A2.F11.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.25562v1/t2i_compbench_full_7b.svg" id="A2.F11.sf2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:548/297;" width="548" height="297"></object>
