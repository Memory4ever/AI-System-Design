</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<figure id="A2.F10.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.25562v1/compbench_full.svg" id="A2.F10.sf2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:548/297;" width="548" height="297"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(b) </span><span id="A2.F10.sf2.3" class="ltx_text ltx_font_bold">T2I-CompBench</span></figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<figure id="A2.F10.sf3" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.25562v1/wise_full.svg" id="A2.F10.sf3.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:548/297;" width="548" height="297"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(c) </span><span id="A2.F10.sf3.3" class="ltx_text ltx_font_bold">WISE</span></figcaption>
</figure></div></div>
