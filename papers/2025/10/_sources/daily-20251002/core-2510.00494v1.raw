<th id="A2.T3.8.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A2.T3.8.1.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Straight-to-16</span></th></tr>
