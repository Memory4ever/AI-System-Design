<th id="A2.T4.8.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A2.T4.8.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Hyp. 2 (scratch)</span></th>
<th id="A2.T4.8.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A2.T4.8.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Resume + curriculum</span></th>
<th id="A2.T4.8.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A2.T4.8.1.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Straight-to-16</span></th></tr>
