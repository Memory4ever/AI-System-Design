<td id="A2.T4.8.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="A2.T4.8.2.2.1" class="ltx_text" style="font-size:90%;">99.0</span></td>
<td id="A2.T4.8.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="A2.T4.8.2.3.1" class="ltx_text" style="font-size:90%;">97.1 (<math id="A2.T4.m3" class="ltx_Math" alttext="\Delta\!-1.9" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0.072em">−</mo><mn>1.9</mn></mrow><annotation encoding="application/x-tex">\Delta\!-1.9</annotation></semantics></math>)</span></td>
<td id="A2.T4.8.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="A2.T4.8.2.4.1" class="ltx_text" style="font-size:90%;">97.3 (<math id="A2.T4.m4" class="ltx_Math" alttext="\Delta\!-1.7" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0.072em">−</mo><mn>1.7</mn></mrow><annotation encoding="application/x-tex">\Delta\!-1.7</annotation></semantics></math>)</span></td></tr>
<tr id="A2.T4.8.3" class="ltx_tr">
