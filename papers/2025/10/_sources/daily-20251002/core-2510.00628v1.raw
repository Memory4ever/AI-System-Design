<td id="S3.T1.5.1.2.4" class="ltx_td ltx_align_center ltx_border_t">201 (21.5%)</td>
<td id="S3.T1.5.1.2.5" class="ltx_td ltx_align_center ltx_border_t">118 (12.6%)</td>
<td id="S3.T1.5.1.2.6" class="ltx_td ltx_align_center ltx_border_t">933</td></tr>
