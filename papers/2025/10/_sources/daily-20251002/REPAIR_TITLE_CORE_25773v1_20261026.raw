<span id="id7.2.1" class="ltx_td ltx_nopad_r ltx_align_left"><sup id="id7.2.1.1" class="ltx_sup"><span id="id7.2.1.1.1" class="ltx_text ltx_font_italic">4</span></sup>Beijing Institute for General Artificial Intelligence  <sup id="id7.2.1.2" class="ltx_sup"><span id="id7.2.1.2.1" class="ltx_text ltx_font_italic">5</span></sup>Independent Researcher</span></span>
