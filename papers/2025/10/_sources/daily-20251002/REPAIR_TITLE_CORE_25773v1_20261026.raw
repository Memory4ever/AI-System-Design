<td id="A6.T14.2.1.12.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r">0.525</td>
<td id="A6.T14.2.1.12.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r">0.571</td>
