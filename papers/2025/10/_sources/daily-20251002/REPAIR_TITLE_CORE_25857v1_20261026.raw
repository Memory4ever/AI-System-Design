<td id="S4.F3.3.1.7" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S4.F3.3.1.7.1" class="ltx_text" style="position:relative; bottom:-0.5pt;"><img src="2509.25857v1/figs/comparisons/diff_pathnum/sk_16_svg_iter_consist_2000_0.png" id="S4.F3.g7" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:43/28;" width="43" height="28" alt="Refer to caption"></span></td>
