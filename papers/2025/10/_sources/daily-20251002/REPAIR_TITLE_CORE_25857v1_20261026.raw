<td id="A0.T2.3.4.7" class="ltx_td ltx_align_left"><math id="A0.T2.m11" class="ltx_Math" alttext="1.699\cdot 10^{13}" display="inline" intent=":literal"><semantics><mrow><mn>1.699</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>10</mn><mn>13</mn></msup></mrow><annotation encoding="application/x-tex">1.699\cdot 10^{13}</annotation></semantics></math></td>
<td id="A0.T2.3.4.8" class="ltx_td ltx_align_left"><math id="A0.T2.m12" class="ltx_Math" alttext="1.930\cdot 10^{4}" display="inline" intent=":literal"><semantics><mrow><mn>1.930</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>10</mn><mn>4</mn></msup></mrow><annotation encoding="application/x-tex">1.930\cdot 10^{4}</annotation></semantics></math></td></tr>
