<th id="A0.T2.3.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">200</th>
<th id="A0.T2.3.5.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">99</th>
<td id="A0.T2.3.5.3" class="ltx_td ltx_align_left"><math id="A0.T2.m13" class="ltx_Math" alttext="5.857\cdot 10^{42}" display="inline" intent=":literal"><semantics><mrow><mn>5.857</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>10</mn><mn>42</mn></msup></mrow><annotation encoding="application/x-tex">5.857\cdot 10^{42}</annotation></semantics></math></td>
<td id="A0.T2.3.5.4" class="ltx_td ltx_align_left"><math id="A0.T2.m14" class="ltx_Math" alttext="8.988\cdot 10^{-2}" display="inline" intent=":literal"><semantics><mrow><mn>8.988</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">8.988\cdot 10^{-2}</annotation></semantics></math></td>
<td id="A0.T2.3.5.5" class="ltx_td ltx_align_left ltx_border_r"><math id="A0.T2.m15" class="ltx_Math" alttext="5.231\cdot 10^{-1}" display="inline" intent=":literal"><semantics><mrow><mn>5.231</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">5.231\cdot 10^{-1}</annotation></semantics></math></td>
<td id="A0.T2.3.5.6" class="ltx_td ltx_align_left"><math id="A0.T2.m16" class="ltx_Math" alttext="6.264\cdot 10^{44}" display="inline" intent=":literal"><semantics><mrow><mn>6.264</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>10</mn><mn>44</mn></msup></mrow><annotation encoding="application/x-tex">6.264\cdot 10^{44}</annotation></semantics></math></td>
<td id="A0.T2.3.5.7" class="ltx_td ltx_align_left"><math id="A0.T2.m17" class="ltx_Math" alttext="3.425\cdot 10^{13}" display="inline" intent=":literal"><semantics><mrow><mn>3.425</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>10</mn><mn>13</mn></msup></mrow><annotation encoding="application/x-tex">3.425\cdot 10^{13}</annotation></semantics></math></td>
<td id="A0.T2.3.5.8" class="ltx_td ltx_align_left"><math id="A0.T2.m18" class="ltx_Math" alttext="1.583\cdot 10^{4}" display="inline" intent=":literal"><semantics><mrow><mn>1.583</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>10</mn><mn>4</mn></msup></mrow><annotation encoding="application/x-tex">1.583\cdot 10^{4}</annotation></semantics></math></td></tr>
<tr id="A0.T2.3.6" class="ltx_tr">
<th id="A0.T2.3.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_r">400</th>
<th id="A0.T2.3.6.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_r">199</th>
<td id="A0.T2.3.6.3" class="ltx_td ltx_align_left ltx_border_bb"><math id="A0.T2.m19" class="ltx_Math" alttext="8.320\cdot 10^{127}" display="inline" intent=":literal"><semantics><mrow><mn>8.320</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>10</mn><mn>127</mn></msup></mrow><annotation encoding="application/x-tex">8.320\cdot 10^{127}</annotation></semantics></math></td>
<td id="A0.T2.3.6.4" class="ltx_td ltx_align_left ltx_border_bb"><math id="A0.T2.m20" class="ltx_Math" alttext="1.727\cdot 10^{-1}" display="inline" intent=":literal"><semantics><mrow><mn>1.727</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1.727\cdot 10^{-1}</annotation></semantics></math></td>
<td id="A0.T2.3.6.5" class="ltx_td ltx_align_left ltx_border_bb ltx_border_r"><math id="A0.T2.m21" class="ltx_Math" alttext="1.433" display="inline" intent=":literal"><semantics><mn>1.433</mn><annotation encoding="application/x-tex">1.433</annotation></semantics></math></td>
<td id="A0.T2.3.6.6" class="ltx_td ltx_align_left ltx_border_bb"><math id="A0.T2.m22" class="ltx_Math" alttext="8.608\cdot 10^{129}" display="inline" intent=":literal"><semantics><mrow><mn>8.608</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>10</mn><mn>129</mn></msup></mrow><annotation encoding="application/x-tex">8.608\cdot 10^{129}</annotation></semantics></math></td>
<td id="A0.T2.3.6.7" class="ltx_td ltx_align_left ltx_border_bb"><math id="A0.T2.m23" class="ltx_Math" alttext="2.936\cdot 10^{13}" display="inline" intent=":literal"><semantics><mrow><mn>2.936</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>10</mn><mn>13</mn></msup></mrow><annotation encoding="application/x-tex">2.936\cdot 10^{13}</annotation></semantics></math></td>
<td id="A0.T2.3.6.8" class="ltx_td ltx_align_left ltx_border_bb"><math id="A0.T2.m24" class="ltx_Math" alttext="2.004\cdot 10^{4}" display="inline" intent=":literal"><semantics><mrow><mn>2.004</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>10</mn><mn>4</mn></msup></mrow><annotation encoding="application/x-tex">2.004\cdot 10^{4}</annotation></semantics></math></td></tr>
