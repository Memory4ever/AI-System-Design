</span></span><span id="S5.T3.2.1.5.1.1.3" class="ltx_text"></span></span></td>
<td id="S5.T3.2.1.5.2" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T3.2.1.5.2.1" class="ltx_text" style="font-size:90%;">512</span></td>
<td id="S5.T3.2.1.5.3" class="ltx_td ltx_align_center"><span id="S5.T3.2.1.5.3.1" class="ltx_text" style="font-size:90%;">216.3 / 8</span></td>
<td id="S5.T3.2.1.5.4" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T3.2.1.5.4.1" class="ltx_text" style="font-size:90%;">190.5 / 8</span></td>
<td id="S5.T3.2.1.5.5" class="ltx_td ltx_align_center"><span id="S5.T3.2.1.5.5.1" class="ltx_text" style="font-size:90%;">173.9 / 8</span></td>
