<tr id="S5.T2.2.1.3" class="ltx_tr">
<td id="S5.T2.2.1.3.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_t"><span id="S5.T2.2.1.3.1.1" class="ltx_text ltx_font_bold ltx_font_smallcaps">7b-q2</span></td>
<td id="S5.T2.2.1.3.2" class="ltx_td ltx_align_center ltx_border_t">0.68</td>
<td id="S5.T2.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t">2.06</td>
<td id="S5.T2.2.1.3.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="--ltx-bg-color:#E6E6E6;"><span id="S5.T2.2.1.3.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">6.42</span></td>
