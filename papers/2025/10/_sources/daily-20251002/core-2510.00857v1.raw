<tr id="A5.T8.2.1.2" class="ltx_tr">
<th id="A5.T8.2.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" rowspan="3"><span id="A5.T8.2.1.2.1.1" class="ltx_text">Human harm</span></th>
<th id="A5.T8.2.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t">Test mode</th>
<td id="A5.T8.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="A5.T8.m1" class="ltx_Math" alttext="0.84" display="inline" intent=":literal"><semantics><mn>0.84</mn><annotation encoding="application/x-tex">0.84</annotation></semantics></math></td>
<td id="A5.T8.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><math id="A5.T8.m2" class="ltx_Math" alttext="0.28" display="inline" intent=":literal"><semantics><mn>0.28</mn><annotation encoding="application/x-tex">0.28</annotation></semantics></math></td>
<td id="A5.T8.2.1.2.5" class="ltx_td ltx_align_center ltx_border_t"><math id="A5.T8.m3" class="ltx_Math" alttext="0.0" display="inline" intent=":literal"><semantics><mn>0.0</mn><annotation encoding="application/x-tex">0.0</annotation></semantics></math></td>
<td id="A5.T8.2.1.2.6" class="ltx_td ltx_align_center ltx_border_t"><math id="A5.T8.m4" class="ltx_Math" alttext="0.0" display="inline" intent=":literal"><semantics><mn>0.0</mn><annotation encoding="application/x-tex">0.0</annotation></semantics></math></td>
<td id="A5.T8.2.1.2.7" class="ltx_td ltx_align_center ltx_border_t"><math id="A5.T8.m5" class="ltx_Math" alttext="0.0" display="inline" intent=":literal"><semantics><mn>0.0</mn><annotation encoding="application/x-tex">0.0</annotation></semantics></math></td>
<td id="A5.T8.2.1.2.8" class="ltx_td ltx_align_center ltx_border_t"><math id="A5.T8.m6" class="ltx_Math" alttext="2.24" display="inline" intent=":literal"><semantics><mn>2.24</mn><annotation encoding="application/x-tex">2.24</annotation></semantics></math></td></tr>
<tr id="A5.T8.2.1.3" class="ltx_tr">
<th id="A5.T8.2.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">Refrain</th>
<td id="A5.T8.2.1.3.2" class="ltx_td ltx_align_center"><math id="A5.T8.m7" class="ltx_Math" alttext="0.0" display="inline" intent=":literal"><semantics><mn>0.0</mn><annotation encoding="application/x-tex">0.0</annotation></semantics></math></td>
<td id="A5.T8.2.1.3.3" class="ltx_td ltx_align_center"><math id="A5.T8.m8" class="ltx_Math" alttext="0.28" display="inline" intent=":literal"><semantics><mn>0.28</mn><annotation encoding="application/x-tex">0.28</annotation></semantics></math></td>
<td id="A5.T8.2.1.3.4" class="ltx_td ltx_align_center"><math id="A5.T8.m9" class="ltx_Math" alttext="0.0" display="inline" intent=":literal"><semantics><mn>0.0</mn><annotation encoding="application/x-tex">0.0</annotation></semantics></math></td>
