<th id="A3.T5.2.11.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Construction</th>
<td id="A3.T5.2.11.2" class="ltx_td ltx_align_center"><math id="A3.T5.m19" class="ltx_Math" alttext="2.38\pm 1.45" display="inline" intent=":literal"><semantics><mrow><mn>2.38</mn><mo>±</mo><mn>1.45</mn></mrow><annotation encoding="application/x-tex">2.38\pm 1.45</annotation></semantics></math></td>
<td id="A3.T5.2.11.3" class="ltx_td ltx_align_center"><math id="A3.T5.m20" class="ltx_Math" alttext="13" display="inline" intent=":literal"><semantics><mn>13</mn><annotation encoding="application/x-tex">13</annotation></semantics></math></td></tr>
