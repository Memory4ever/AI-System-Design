<td id="A3.T7.2.3.3" class="ltx_td ltx_align_center"><math id="A3.T7.m4" class="ltx_Math" alttext="43" display="inline" intent=":literal"><semantics><mn>43</mn><annotation encoding="application/x-tex">43</annotation></semantics></math></td></tr>
