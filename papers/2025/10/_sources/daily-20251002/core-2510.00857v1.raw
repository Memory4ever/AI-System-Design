<td id="A3.T7.2.4.3" class="ltx_td ltx_align_center ltx_border_bb"><math id="A3.T7.m6" class="ltx_Math" alttext="41" display="inline" intent=":literal"><semantics><mn>41</mn><annotation encoding="application/x-tex">41</annotation></semantics></math></td></tr>
