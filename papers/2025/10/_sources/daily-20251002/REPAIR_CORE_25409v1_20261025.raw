<td id="A1.T4.2.3.1" class="ltx_td ltx_align_left ltx_border_r">F1 (correct)</td>
<td id="A1.T4.2.3.2" class="ltx_td ltx_align_center">0.8331</td>
<td id="A1.T4.2.3.3" class="ltx_td ltx_align_center ltx_border_r">0.9268</td>
<td id="A1.T4.2.3.4" class="ltx_td ltx_align_center"><span id="A1.T4.2.3.4.1" class="ltx_text ltx_font_bold">0.9289</span></td>
<td id="A1.T4.2.3.5" class="ltx_td ltx_align_center">0.9240</td>
