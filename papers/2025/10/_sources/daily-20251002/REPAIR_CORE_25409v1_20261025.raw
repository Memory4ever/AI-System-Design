<td id="S3.T1.2.2.7" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T1.m2" class="ltx_Math" alttext="+6.5\%" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mn>6.5</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">+6.5\%</annotation></semantics></math></td></tr>
<tr id="S3.T1.2.3" class="ltx_tr">
<td id="S3.T1.2.3.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r">Detection</td>
<td id="S3.T1.2.3.2" class="ltx_td ltx_align_center ltx_border_bb">0.3222</td>
