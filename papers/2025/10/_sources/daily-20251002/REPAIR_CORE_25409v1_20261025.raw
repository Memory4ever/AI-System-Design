<td id="S3.T1.2.1.7" class="ltx_td ltx_align_center ltx_border_tt"><math id="S3.T1.m1" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math></td></tr>
