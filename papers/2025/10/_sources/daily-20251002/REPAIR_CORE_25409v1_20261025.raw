<td id="A1.T4.2.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.8680</td>
<td id="A1.T4.2.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="A1.T4.2.2.4.1" class="ltx_text ltx_font_bold">0.8715</span></td>
<td id="A1.T4.2.2.5" class="ltx_td ltx_align_center ltx_border_t">0.8652</td>
<td id="A1.T4.2.2.6" class="ltx_td ltx_align_center ltx_border_t">0.8648</td></tr>
