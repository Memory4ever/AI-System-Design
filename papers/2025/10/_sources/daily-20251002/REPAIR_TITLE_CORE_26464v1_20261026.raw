<td id="Sx1.T5.2.2.3" class="ltx_td ltx_align_center" style="padding:1pt 9.0pt;"><span id="Sx1.T5.2.2.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Preference: OpenAI over Anthropic</span></td></tr>
<tr id="Sx1.T5.2.3" class="ltx_tr">
<td id="Sx1.T5.2.3.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:1pt 9.0pt;"><span id="Sx1.T5.2.3.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">GPT-4o:</span></td>
<td id="Sx1.T5.2.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:1pt 9.0pt;"><math id="Sx1.T5.m1" class="ltx_Math" alttext="M=0.979,\ d=11.816,\ p&lt;0.0001" display="inline" intent=":literal"><semantics><mrow><mrow><mi>M</mi><mo>=</mo><mn>0.979</mn></mrow><mo rspace="0.667em">,</mo><mrow><mi>d</mi><mo>=</mo><mn>11.816</mn></mrow><mo rspace="0.667em">,</mo><mrow><mi>p</mi><mo>&lt;</mo><mn>0.0001</mn></mrow></mrow><annotation encoding="application/x-tex">M=0.979,\ d=11.816,\ p&lt;0.0001</annotation></semantics></math></td>
<td id="Sx1.T5.2.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:1pt 9.0pt;"><math id="Sx1.T5.m2" class="ltx_Math" alttext="M=0.907,\ d=1.710,\ p&lt;0.0001" display="inline" intent=":literal"><semantics><mrow><mrow><mi>M</mi><mo>=</mo><mn>0.907</mn></mrow><mo rspace="0.667em">,</mo><mrow><mi>d</mi><mo>=</mo><mn>1.710</mn></mrow><mo rspace="0.667em">,</mo><mrow><mi>p</mi><mo>&lt;</mo><mn>0.0001</mn></mrow></mrow><annotation encoding="application/x-tex">M=0.907,\ d=1.710,\ p&lt;0.0001</annotation></semantics></math></td></tr>
<tr id="Sx1.T5.2.4" class="ltx_tr">
<td id="Sx1.T5.2.4.1" class="ltx_td ltx_align_left" style="padding:1pt 9.0pt;"><span id="Sx1.T5.2.4.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Told it is ChatGPT</span></td>
<td id="Sx1.T5.2.4.2" class="ltx_td" style="padding:1pt 9.0pt;"></td>
<td id="Sx1.T5.2.4.3" class="ltx_td" style="padding:1pt 9.0pt;"></td></tr>
