<tr id="Sx1.T5.2.22" class="ltx_tr">
<td id="Sx1.T5.2.22.1" class="ltx_td ltx_align_left" style="padding:1pt 9.0pt;"><span id="Sx1.T5.2.22.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Told it is Rival Model</span></td>
<td id="Sx1.T5.2.22.2" class="ltx_td" style="padding:1pt 9.0pt;"></td>
