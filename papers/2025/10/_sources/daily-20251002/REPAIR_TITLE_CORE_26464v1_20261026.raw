<td id="Sx1.T5.2.5.1" class="ltx_td ltx_align_left" style="padding:1pt 9.0pt;"><span id="Sx1.T5.2.5.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">GPT-4o:</span></td>
