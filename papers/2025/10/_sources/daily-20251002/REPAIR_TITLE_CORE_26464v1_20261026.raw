<span id="Sx1.T6.4.6.1.1.1" class="ltx_p ltx_align_left"><span id="Sx1.T6.4.6.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Gemini-2.0-Flash (5a v3):</span><span id="Sx1.T6.4.6.1.1.1.2" class="ltx_text" style="font-size:90%;"> Evaluations of Gemini- vs. GPT-praising job candidate.</span></span>
</span></td>
<td id="Sx1.T6.4.6.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="Sx1.T6.4.6.2.1" class="ltx_inline-logical-block ltx_align_top" style="width:107.0pt;">
<span id="Sx1.T6.p5" class="ltx_para ltx_noindent">
<span id="Sx1.T6.p5.1" class="ltx_p"><span id="Sx1.T6.p5.1.1" class="ltx_text"></span><span id="Sx1.T6.p5.1.2" class="ltx_text" style="font-size:90%;">
<span id="Sx1.T6.p5.1.2.1" class="ltx_tabular ltx_align_top">
<span id="Sx1.T6.p5.1.2.1.1" class="ltx_tr">
<span id="Sx1.T6.p5.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-top:0.9pt;padding-bottom:0.9pt;">Gemini-Praising: <math id="Sx1.T6.p5.m1" class="ltx_Math" alttext="M=4.909" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><mn>4.909</mn></mrow><annotation encoding="application/x-tex">M=4.909</annotation></semantics></math></span></span>
<span id="Sx1.T6.p5.1.2.1.2" class="ltx_tr">
