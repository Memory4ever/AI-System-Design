<td id="Sx1.T1.2.6.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:1pt 9.0pt;"><math id="Sx1.T1.m5" class="ltx_Math" alttext="M=0.970,\ d=5.246,\ p&lt;0.0001" display="inline" intent=":literal"><semantics><mrow><mrow><mi>M</mi><mo>=</mo><mn>0.970</mn></mrow><mo rspace="0.667em">,</mo><mrow><mi>d</mi><mo>=</mo><mn>5.246</mn></mrow><mo rspace="0.667em">,</mo><mrow><mi>p</mi><mo>&lt;</mo><mn>0.0001</mn></mrow></mrow><annotation encoding="application/x-tex">M=0.970,\ d=5.246,\ p&lt;0.0001</annotation></semantics></math></td>
