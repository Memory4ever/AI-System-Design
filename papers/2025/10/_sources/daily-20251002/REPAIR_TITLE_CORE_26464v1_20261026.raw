<th id="Sx7.T4.2.12.4" class="ltx_td ltx_align_top ltx_th ltx_th_column ltx_border_t" style="padding:1pt 9.0pt;"></th>
<th id="Sx7.T4.2.12.5" class="ltx_td ltx_align_top ltx_th ltx_th_column ltx_border_t" style="padding:1pt 9.0pt;"></th></tr>
</tfoot>
