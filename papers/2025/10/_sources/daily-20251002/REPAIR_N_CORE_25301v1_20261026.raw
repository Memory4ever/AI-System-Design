<span id="A9.p1.pic1.p13" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A9.p1.pic1.p13.pic1" class="ltx_picture" color="#262626" height="19.69" overflow="visible" version="1.1" viewBox="0 0 611.57 19.69" width="611.57"><g style="--ltx-stroke-color:#262626;--ltx-fill-color:#262626;" fill="#262626" stroke="#262626" stroke-width="0.4pt" transform="translate(0,19.69) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#C98B4D;" fill="#C98B4D" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 15.06 C 0 17.61 2.07 19.69 4.63 19.69 L 606.94 19.69 C 609.49 19.69 611.57 17.61 611.57 15.06 L 611.57 4.63 C 611.57 2.07 609.49 0 606.94 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#C98B4D;" fill="#C98B4D" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 15.06 C 0.69 17.23 2.45 18.99 4.63 18.99 L 606.94 18.99 C 609.11 18.99 610.87 17.23 610.87 15.06 L 610.87 4.63 C 610.87 2.45 609.11 0.69 606.94 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 7.4 7.14)"><foreignObject style="--ltx-fo-width:50.74em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.2em;font-size:7.97pt;" height="9.72" overflow="visible" transform="matrix(1 0 0 -1 0 7.56)" width="559.73"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
