<td id="A6.T7.5.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="A6.T7.5.2.2.1" class="ltx_text" style="font-size:90%;">1e-5</span></td></tr>
<tr id="A6.T7.5.3" class="ltx_tr">
<th id="A6.T7.5.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A6.T7.5.3.1.1" class="ltx_text" style="font-size:90%;">Training Epochs</span></th>
<td id="A6.T7.5.3.2" class="ltx_td ltx_align_center"><span id="A6.T7.5.3.2.1" class="ltx_text" style="font-size:90%;">6</span></td></tr>
<tr id="A6.T7.5.4" class="ltx_tr">
