<th id="A3.T2.8.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A3.T2.8.5.1.1" class="ltx_text" style="font-size:90%;">Max steps</span></th>
<td id="A3.T2.8.5.2" class="ltx_td ltx_align_center"><span id="A3.T2.8.5.2.1" class="ltx_text" style="font-size:90%;">Total step budget for task execution</span></td>
<td id="A3.T2.8.5.3" class="ltx_td ltx_align_center"><span id="A3.T2.8.5.3.1" class="ltx_text" style="font-size:90%;">40</span></td></tr>
<tr id="A3.T2.8.6" class="ltx_tr">
