<td id="A3.T2.8.3.2" class="ltx_td ltx_align_center"><span id="A3.T2.8.3.2.1" class="ltx_text" style="font-size:90%;">Predefined steps per goal</span></td>
<td id="A3.T2.8.3.3" class="ltx_td ltx_align_center"><span id="A3.T2.8.3.3.1" class="ltx_text" style="font-size:90%;">5</span></td></tr>
