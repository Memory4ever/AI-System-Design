<th id="A3.T2.8.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="A3.T2.8.1.1.1" class="ltx_text" style="font-size:90%;">Parameter</span></th>
<th id="A3.T2.8.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A3.T2.8.1.2.1" class="ltx_text" style="font-size:90%;">Description</span></th>
<th id="A3.T2.8.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A3.T2.8.1.3.1" class="ltx_text" style="font-size:90%;">Value</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A3.T2.8.2" class="ltx_tr">
