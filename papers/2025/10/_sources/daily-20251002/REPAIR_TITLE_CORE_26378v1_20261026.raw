<span id="S3.T2.2.1.1.1.1.1.1.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt ltx_colspan ltx_colspan_3" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="S3.T2.2.1.1.1.1.1.1.1.3.1" class="ltx_text ltx_font_bold">Visual Illustration Search</span></span>
<span id="S3.T2.2.1.1.1.1.1.1.1.4" class="ltx_td ltx_align_center ltx_border_tt ltx_colspan ltx_colspan_3" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="S3.T2.2.1.1.1.1.1.1.1.4.1" class="ltx_text ltx_font_bold">Visual Relation Reasoning</span></span></span>
