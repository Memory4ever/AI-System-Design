<span id="S4.T4.2.1.1.1.1.1.1.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt ltx_colspan ltx_colspan_6" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S4.T4.2.1.1.1.1.1.1.1.2.1" class="ltx_text ltx_font_bold">Stack Exchange</span></span>
