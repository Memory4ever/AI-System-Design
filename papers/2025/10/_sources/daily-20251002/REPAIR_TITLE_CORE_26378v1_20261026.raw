<td id="A2.T5.2.11.4" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.4pt 4.0pt;"><math id="A2.T5.m29" class="ltx_Math" alttext="149" display="inline" intent=":literal"><semantics><mn>149</mn><annotation encoding="application/x-tex">149</annotation></semantics></math></td>
<td id="A2.T5.2.11.5" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.4pt 4.0pt;"><math id="A2.T5.m30" class="ltx_Math" alttext="1,000" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>,</mo><mn>000</mn></mrow><annotation encoding="application/x-tex">1,000</annotation></semantics></math></td>
<td id="A2.T5.2.11.6" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t" style="padding:0.4pt 4.0pt;">
