<span id="S4.T4.2.1.1.1.1.1.1.2" class="ltx_tr">
<span id="S4.T4.2.1.1.1.1.1.1.2.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S4.T4.2.1.1.1.1.1.1.2.1.1" class="ltx_text ltx_font_bold">Bio.</span></span>
<span id="S4.T4.2.1.1.1.1.1.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S4.T4.2.1.1.1.1.1.1.2.2.1" class="ltx_text ltx_font_bold">Cook.</span></span>
<span id="S4.T4.2.1.1.1.1.1.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S4.T4.2.1.1.1.1.1.1.2.3.1" class="ltx_text ltx_font_bold">Gar.</span></span>
<span id="S4.T4.2.1.1.1.1.1.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S4.T4.2.1.1.1.1.1.1.2.4.1" class="ltx_text ltx_font_bold">Phy.</span></span>
