<span id="S3.T2.2.1.1.1.1.1.1.2.9" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="S3.T2.2.1.1.1.1.1.1.2.9.1" class="ltx_text ltx_font_bold">Mathematics</span></span>
<span id="S3.T2.2.1.1.1.1.1.1.2.10" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="S3.T2.2.1.1.1.1.1.1.2.10.1" class="ltx_text ltx_font_bold">Nature</span></span>
<span id="S3.T2.2.1.1.1.1.1.1.2.11" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="S3.T2.2.1.1.1.1.1.1.2.11.1" class="ltx_text ltx_font_bold">Spatial</span></span>
<span id="S3.T2.2.1.1.1.1.1.1.2.12" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="S3.T2.2.1.1.1.1.1.1.2.12.1" class="ltx_text ltx_font_bold">VisualPuzzle</span></span>
<span id="S3.T2.2.1.1.1.1.1.1.2.13" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="S3.T2.2.1.1.1.1.1.1.2.13.1" class="ltx_text ltx_font_bold">Analogy</span></span></span>
<span id="S3.T2.2.1.1.1.1.1.1.3" class="ltx_tr">
