<span id="S3.T2.2.1.1.1.1.1.1.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.5pt;padding-right:2.5pt;">79</span>
<span id="S3.T2.2.1.1.1.1.1.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.5pt;padding-right:2.5pt;">76</span>
<span id="S3.T2.2.1.1.1.1.1.1.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.5pt;padding-right:2.5pt;">129</span>
<span id="S3.T2.2.1.1.1.1.1.1.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.5pt;padding-right:2.5pt;">76</span>
<span id="S3.T2.2.1.1.1.1.1.1.3.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.5pt;padding-right:2.5pt;">124</span>
<span id="S3.T2.2.1.1.1.1.1.1.3.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:2.5pt;padding-right:2.5pt;">99</span>
<span id="S3.T2.2.1.1.1.1.1.1.3.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.5pt;padding-right:2.5pt;">84</span>
<span id="S3.T2.2.1.1.1.1.1.1.3.9" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.5pt;padding-right:2.5pt;">86</span>
<span id="S3.T2.2.1.1.1.1.1.1.3.10" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:2.5pt;padding-right:2.5pt;">100</span>
<span id="S3.T2.2.1.1.1.1.1.1.3.11" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.5pt;padding-right:2.5pt;">149</span>
<span id="S3.T2.2.1.1.1.1.1.1.3.12" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.5pt;padding-right:2.5pt;">160</span>
<span id="S3.T2.2.1.1.1.1.1.1.3.13" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:2.5pt;padding-right:2.5pt;">147</span></span>
<span id="S3.T2.2.1.1.1.1.1.1.4" class="ltx_tr">
<span id="S3.T2.2.1.1.1.1.1.1.4.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="S3.T2.2.1.1.1.1.1.1.4.1.1" class="ltx_text ltx_font_bold">#Corpus</span></span>
<span id="S3.T2.2.1.1.1.1.1.1.4.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.5pt;padding-right:2.5pt;">4,455</span>
<span id="S3.T2.2.1.1.1.1.1.1.4.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.5pt;padding-right:2.5pt;">2,786</span>
