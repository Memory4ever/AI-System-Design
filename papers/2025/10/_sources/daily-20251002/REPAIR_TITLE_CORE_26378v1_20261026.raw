<span id="S3.T2.2.1.1.1.1.1.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="S3.T2.2.1.1.1.1.1.1.2.3.1" class="ltx_text ltx_font_bold">Cooking</span></span>
<span id="S3.T2.2.1.1.1.1.1.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="S3.T2.2.1.1.1.1.1.1.2.4.1" class="ltx_text ltx_font_bold">Gardening</span></span>
<span id="S3.T2.2.1.1.1.1.1.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="S3.T2.2.1.1.1.1.1.1.2.5.1" class="ltx_text ltx_font_bold">Physics</span></span>
