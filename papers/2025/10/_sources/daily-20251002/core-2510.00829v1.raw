<td id="Sx3.T2.1.1.5" class="ltx_td ltx_align_center ltx_border_tt"><math id="Sx3.T2.m3" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math></td></tr>
