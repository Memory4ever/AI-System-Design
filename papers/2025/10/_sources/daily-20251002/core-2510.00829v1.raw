<td id="Sx3.T2.1.1.3" class="ltx_td ltx_align_center ltx_border_tt"><math id="Sx3.T2.m1" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math></td>
