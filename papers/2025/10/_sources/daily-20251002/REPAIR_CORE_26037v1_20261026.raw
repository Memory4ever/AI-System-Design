<tr id="A3.T7.2.3" class="ltx_tr">
<td id="A3.T7.2.3.1" class="ltx_td ltx_border_r"></td>
<td id="A3.T7.2.3.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_r">
<span id="A3.T7.2.3.2.1" class="ltx_inline-block ltx_align_top" style="width:256.1pt;">
