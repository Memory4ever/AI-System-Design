</span></td>
<td id="A3.T7.2.3.3" class="ltx_td ltx_border_r"></td>
<td id="A3.T7.2.3.4" class="ltx_td"></td></tr>
<tr id="A3.T7.2.4" class="ltx_tr">
<td id="A3.T7.2.4.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" rowspan="2"><span id="A3.T7.2.4.1.1" class="ltx_text" style="font-size:90%;">2</span></td>
