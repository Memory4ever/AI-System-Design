<tr id="S5.T3.4.3" class="ltx_tr">
<th id="S5.T3.4.3.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_row" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="S5.T3.4.3.1.1" class="ltx_text ltx_font_smallcaps">Method</span></th>
<td id="S5.T3.4.3.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.5pt;padding-right:1.5pt;">Top-1</td>
