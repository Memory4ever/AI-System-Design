<tr id="S3.T1.2.3" class="ltx_tr">
<td id="S3.T1.2.3.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;">Llama-3.1-8B</td>
