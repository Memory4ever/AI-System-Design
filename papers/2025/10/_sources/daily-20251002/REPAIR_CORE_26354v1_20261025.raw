<span id="A1.SS3.SSS2.Px2.p6.pic1.1.1" class="ltx_p"><span id="A1.SS3.SSS2.Px2.p6.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">LLM-as-a-Judge Prompt</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 16.47)"><foreignObject style="--ltx-fo-width:31.37em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="434.07"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A1.SS3.SSS2.Px2.p6.pic1.2" class="ltx_inline-logical-block ltx_minipage ltx_align_bottom" style="width:31.37em;">
