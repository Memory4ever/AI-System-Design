<td id="A3.T13.2.3.1" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T13.2.3.1.1" class="ltx_inline-block" style="width:99.6pt;">
<span id="A3.T13.2.3.1.1.1" class="ltx_p ltx_minipage ltx_align_middle" style="width:345.0pt;"><span id="A3.T13.2.3.1.1.1.1" class="ltx_text ltx_font_typewriter ltx_font_bold" style="font-size:50%;">Task 1, Executing Step2</span></span>
