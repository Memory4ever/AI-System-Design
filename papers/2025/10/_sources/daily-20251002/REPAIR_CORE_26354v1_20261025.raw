<span id="A3.T13.2.2.3.1.1" class="ltx_p ltx_minipage ltx_align_middle" style="width:345.0pt;"><span id="A3.T13.2.2.3.1.1.1" class="ltx_text ltx_font_typewriter" style="font-size:50%;">None</span></span>
