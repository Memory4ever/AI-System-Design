</div>
<div id="lstnumberx20" class="ltx_listingline"><span id="lstnumberx20.1" class="ltx_text ltx_font_typewriter">&lt;|</span><span id="lstnumberx20.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">start_header_id</span><span id="lstnumberx20.3" class="ltx_text ltx_font_typewriter">|&gt;</span><span id="lstnumberx20.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">assistant</span><span id="lstnumberx20.5" class="ltx_text ltx_font_typewriter">&lt;|</span><span id="lstnumberx20.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">end_header_id</span><span id="lstnumberx20.7" class="ltx_text ltx_font_typewriter">|&gt;</span>
