<td id="S3.T2.2.4.7" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:5.7pt;padding-right:5.7pt;"><span id="S3.T2.2.4.7.1" class="ltx_text" style="font-size:70%;">24.0%</span></td>
