</span>
<span id="lstnumberx41" class="ltx_listingline"><span id="lstnumberx41.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;">    </span><span id="lstnumberx41.2" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold" style="font-size:50%;">except</span><span id="lstnumberx41.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx41.4" class="ltx_text ltx_font_typewriter" style="font-size:50%;">(</span><span id="lstnumberx41.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">tarfile</span><span id="lstnumberx41.6" class="ltx_text ltx_font_typewriter" style="font-size:50%;">.</span><span id="lstnumberx41.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">TarError</span><span id="lstnumberx41.8" class="ltx_text ltx_font_typewriter" style="font-size:50%;">,</span><span id="lstnumberx41.9" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx41.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">IOError</span><span id="lstnumberx41.11" class="ltx_text ltx_font_typewriter" style="font-size:50%;">)</span><span id="lstnumberx41.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx41.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">as</span><span id="lstnumberx41.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx41.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">e</span><span id="lstnumberx41.16" class="ltx_text ltx_font_typewriter" style="font-size:50%;">:</span>
</span>
