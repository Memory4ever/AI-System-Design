<tr id="A3.T9.2.2" class="ltx_tr">
<td id="A3.T9.2.2.1" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T9.2.2.1.1" class="ltx_inline-block" style="width:99.6pt;">
