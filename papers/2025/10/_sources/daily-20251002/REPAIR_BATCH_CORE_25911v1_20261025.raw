<span id="S4.T5.2.1.4.1" class="ltx_inline-block ltx_align_middle" style="width:119.5pt;">
<span id="S4.T5.2.1.4.1.1" class="ltx_p"><span id="S4.T5.2.1.4.1.1.1" class="ltx_text ltx_font_bold">Qwen3-4B w/ Mem-<math id="S4.T5.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math></span></span>
