<span id="S4.T5.2.2.1.1.1" class="ltx_p"><span id="S4.T5.2.2.1.1.1.1" class="ltx_text ltx_font_bold">Core</span></span>
</span></td>
<td id="S4.T5.2.2.2" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="S4.T5.2.2.2.1" class="ltx_inline-block ltx_align_middle" style="width:85.4pt;">
<span id="S4.T5.2.2.2.1.1" class="ltx_p"><math id="S4.T5.m2" class="ltx_Math" alttext="\emptyset" display="inline" intent=":literal"><semantics><mi mathvariant="normal">∅</mi><annotation encoding="application/x-tex">\emptyset</annotation></semantics></math> <span id="S4.T5.2.2.2.1.1.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">✗ Should not be empty</span></span>
</span></td>
