<td id="S4.T4.2.1.7.1" class="ltx_td ltx_align_center" rowspan="2"><span id="S4.T4.2.1.7.1.1" class="ltx_text">0.05</span></td>
<td id="S4.T4.2.1.7.2" class="ltx_td ltx_align_center ltx_border_r" rowspan="2"><span id="S4.T4.2.1.7.2.1" class="ltx_text">0.1</span></td>
