<td id="S2.T1.4.6.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S2.T1.4.6.1.1" class="ltx_text" style="font-size:90%;">AUMA <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib35" title="" class="ltx_ref">35</a>]</cite></span></td>
<td id="S2.T1.4.6.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S2.T1.4.6.2.1" class="ltx_text" style="font-size:90%;">✓</span></td>
<td id="S2.T1.4.6.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S2.T1.4.6.3.1" class="ltx_text" style="font-size:90%;">✗</span></td>
