<th id="S4.T4.4.1.2" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_r ltx_border_t"><span id="S4.T4.4.1.2.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Hyperparameter</span></th>
