<td id="S4.T4.4.2.1" class="ltx_td ltx_align_left ltx_border_l ltx_border_r ltx_border_t" rowspan="4"><span id="S4.T4.4.2.1.1" class="ltx_text" style="font-size:70%;">Genetic Algorithm</span></td>
<td id="S4.T4.4.2.2" class="ltx_td ltx_align_right ltx_border_r ltx_border_t"><span id="S4.T4.4.2.2.1" class="ltx_text" style="font-size:70%;">method</span></td>
<td id="S4.T4.4.2.3" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">
<span id="S4.T4.4.2.3.1" class="ltx_inline-block ltx_align_top">
<span id="S4.T4.4.2.3.1.1" class="ltx_p"><span id="S4.T4.4.2.3.1.1.1" class="ltx_text" style="font-size:70%;">{</span><span id="S4.T4.4.2.3.1.1.2" class="ltx_text ltx_font_bold" style="font-size:70%;">single_point</span><span id="S4.T4.4.2.3.1.1.3" class="ltx_text" style="font-size:70%;">, two_point, uniform, disruptive_uniform}</span></span>
</span></td></tr>
<tr id="S4.T4.4.3" class="ltx_tr">
<td id="S4.T4.4.3.1" class="ltx_td ltx_align_right ltx_border_r"><span id="S4.T4.4.3.1.1" class="ltx_text" style="font-size:70%;">popsize</span></td>
