<figure id="A8.F17.sf8" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.25713v1/figure/cifar_gen/cifar100lt_otcfm_class_94.png" id="A8.F17.sf8.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:181/181;" width="181" height="181" alt="Refer to caption">
