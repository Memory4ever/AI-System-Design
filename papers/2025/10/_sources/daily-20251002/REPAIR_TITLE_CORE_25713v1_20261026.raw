<td id="A7.T10.4.12.5" class="ltx_td ltx_align_center ltx_border_bb">17.22</td>
<td id="A7.T10.4.12.6" class="ltx_td ltx_align_center ltx_border_bb">16.00</td>
<td id="A7.T10.4.12.7" class="ltx_td ltx_align_center ltx_border_bb">17.90</td>
