<th id="S4.T4.4.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">CIFAR-10</th>
<th id="S4.T4.4.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">CIFAR-100</th></tr>
</thead>
