<th id="A7.T5.4.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">2.0</th>
<th id="A7.T5.4.2.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">4.0</th>
<th id="A7.T5.4.2.9" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">8.0</th></tr>
