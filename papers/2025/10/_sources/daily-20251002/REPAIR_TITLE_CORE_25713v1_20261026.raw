<td id="A7.T10.4.11.5" class="ltx_td ltx_align_center"><span id="A7.T10.4.11.5.1" class="ltx_text ltx_font_bold">15.38</span>*</td>
<td id="A7.T10.4.11.6" class="ltx_td ltx_align_center">18.74</td>
<td id="A7.T10.4.11.7" class="ltx_td ltx_align_center">21.33</td>
<td id="A7.T10.4.11.8" class="ltx_td ltx_align_center">20.04</td>
<td id="A7.T10.4.11.9" class="ltx_td ltx_align_center">25.35</td>
<td id="A7.T10.4.11.10" class="ltx_td ltx_align_center">28.18</td></tr>
<tr id="A7.T10.4.12" class="ltx_tr">
<td id="A7.T10.4.12.1" class="ltx_td ltx_align_center ltx_border_bb">ours(16.0)</td>
<td id="A7.T10.4.12.2" class="ltx_td ltx_align_center ltx_border_bb">15.90</td>
<td id="A7.T10.4.12.3" class="ltx_td ltx_align_center ltx_border_bb">8.73</td>
