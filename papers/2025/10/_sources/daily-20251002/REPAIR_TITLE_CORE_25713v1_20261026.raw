<td id="A7.T5.4.4.4" class="ltx_td ltx_align_center">13.68</td>
<td id="A7.T5.4.4.5" class="ltx_td ltx_align_center">12.67</td>
<td id="A7.T5.4.4.6" class="ltx_td ltx_align_center">24.94</td>
