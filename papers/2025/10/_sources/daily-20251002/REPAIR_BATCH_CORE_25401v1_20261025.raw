            <span id="algorithm1.4.4.2" class="ltx_text" style="--ltx-fg-color:#0000FF;">Sparse symbols: <math id="algorithm1.m5" class="ltx_Math" alttext="\mathcal{S}_{c},\mathcal{S}_{s}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#0000FF;" class="ltx_font_mathcaligraphic" mathcolor="#0000FF">𝒮</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">c</mi></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">,</mo><msub><mi style="--ltx-fg-color:#0000FF;" class="ltx_font_mathcaligraphic" mathcolor="#0000FF">𝒮</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">s</mi></msub></mrow><annotation encoding="application/x-tex">\mathcal{S}_{c},\mathcal{S}_{s}</annotation></semantics></math></span>; <span id="algorithm1.4.4.3" class="ltx_text" style="--ltx-fg-color:#0000FF;">Cached output: <math id="algorithm1.m6" class="ltx_Math" alttext="\widetilde{O}" display="inline" intent=":literal"><semantics><mover accent="true"><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">O</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><annotation encoding="application/x-tex">\widetilde{O}</annotation></semantics></math></span>; 
