<td id="S4.T3.2.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T3.2.1.3.1" class="ltx_text ltx_font_bold">LPIPS (<math id="S4.T3.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math>)</span></td>
