            <span id="algorithm1.4.12.2" class="ltx_text ltx_font_bold">else</span>
</div>
<div id="algorithm1.4.13" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.13.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#0000FF;">11</span></span>
            <span id="algorithm1.4.13.2" class="ltx_text" style="--ltx-fg-color:#0000FF;">Load <math id="algorithm1.m16" class="ltx_Math" alttext="O^{t}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">O</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">i</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">t</mi></msubsup><annotation encoding="application/x-tex">O^{t}_{i}</annotation></semantics></math> into the SM;</span>

</div>
<div id="algorithm1.4.14" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.14.1" class="ltx_text ltx_font_bold">12</span></span>
            <span id="algorithm1.4.14.2" class="ltx_text ltx_font_bold">for</span> <em id="algorithm1.4.14.3" class="ltx_emph ltx_font_italic"><math id="algorithm1.m17" class="ltx_Math" alttext="j\leftarrow 1" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo stretchy="false">←</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">j\leftarrow 1</annotation></semantics></math> <span id="algorithm1.4.14.3.1" class="ltx_text ltx_font_bold ltx_font_upright">to</span> <math id="algorithm1.m18" class="ltx_Math" alttext="T_{kv}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub><annotation encoding="application/x-tex">T_{kv}</annotation></semantics></math></em> 
</div>
<div id="algorithm1.4.15" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.15.1" class="ltx_text ltx_font_bold">13</span></span>
            <span id="algorithm1.4.15.2" class="ltx_text ltx_font_bold">if</span> <em id="algorithm1.4.15.3" class="ltx_emph ltx_font_italic"><math id="algorithm1.m19" class="ltx_Math" alttext="\mathcal{J}(\mathcal{S}_{s},i,j)==1" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#0000FF;" class="ltx_font_mathcaligraphic" mathcolor="#0000FF">𝒥</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#0000FF;" class="ltx_font_mathcaligraphic" mathcolor="#0000FF">𝒮</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">s</mi></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">,</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">i</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">,</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">j</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">=</mo><mphantom></mphantom><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">=</mo><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn></mrow><annotation encoding="application/x-tex">\mathcal{J}(\mathcal{S}_{s},i,j)==1</annotation></semantics></math> </em> <span id="algorithm1.4.15.4" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="algorithm1.4.16" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.16.1" class="ltx_text ltx_font_bold">14</span></span>
            <span id="algorithm1.4.16.2" class="ltx_text ltx_markedasmath ltx_font_italic" style="--ltx-fg-color:#408080;"># Compute-on-Demand.</span>

</div>
<div id="algorithm1.4.17" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.17.1" class="ltx_text ltx_font_bold">15</span></span>
            Load <math id="algorithm1.m21" class="ltx_Math" alttext="K_{j}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>j</mi></msub><annotation encoding="application/x-tex">K_{j}</annotation></semantics></math>, <math id="algorithm1.m22" class="ltx_Math" alttext="V_{j}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>j</mi></msub><annotation encoding="application/x-tex">V_{j}</annotation></semantics></math>;

</div>
<div id="algorithm1.4.18" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.18.1" class="ltx_text ltx_font_bold">16</span></span>
            <math id="algorithm1.m23" class="ltx_Math" alttext="Q_{i}K_{j}^{T}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>K</mi><mi>j</mi><mi>T</mi></msubsup></mrow><annotation encoding="application/x-tex">Q_{i}K_{j}^{T}</annotation></semantics></math>;

</div>
<div id="algorithm1.4.19" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.19.1" class="ltx_text ltx_font_bold">17</span></span>
            Update <math id="algorithm1.m24" class="ltx_Math" alttext="m_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">m_{i,j}</annotation></semantics></math>, <math id="algorithm1.m25" class="ltx_Math" alttext="\widetilde{P}_{ij}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>P</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\widetilde{P}_{ij}</annotation></semantics></math>, <math id="algorithm1.m26" class="ltx_Math" alttext="l_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>l</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">l_{i,j}</annotation></semantics></math>;

</div>
<div id="algorithm1.4.20" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.20.1" class="ltx_text ltx_font_bold">18</span></span>
            <math id="algorithm1.m27" class="ltx_Math" alttext="\widetilde{P}_{ij}V_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>P</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">\widetilde{P}_{ij}V_{j}</annotation></semantics></math> <math id="algorithm1.m28" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> <math id="algorithm1.m29" class="ltx_Math" alttext="O_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>O</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">O_{i,j}</annotation></semantics></math>;

</div>
<div id="algorithm1.4.21" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.21.1" class="ltx_text ltx_font_bold">19</span></span>
            <math id="algorithm1.m30" class="ltx_Math" alttext="O_{i}=\mathrm{diag}(l_{i,T_{n}})^{-1}O_{i,T_{n}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>O</mi><mi>i</mi></msub><mo>=</mo><mrow><mi>diag</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>l</mi><mrow><mi>i</mi><mo>,</mo><msub><mi>T</mi><mi>n</mi></msub></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>O</mi><mrow><mi>i</mi><mo>,</mo><msub><mi>T</mi><mi>n</mi></msub></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">O_{i}=\mathrm{diag}(l_{i,T_{n}})^{-1}O_{i,T_{n}}</annotation></semantics></math>

</div>
<div id="algorithm1.4.22" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.22.1" class="ltx_text ltx_font_bold">20</span></span>
            Write <math id="algorithm1.m31" class="ltx_Math" alttext="O_{i}" display="inline" intent=":literal"><semantics><msub><mi>O</mi><mi>i</mi></msub><annotation encoding="application/x-tex">O_{i}</annotation></semantics></math> into HBM;

</div>
<div id="algorithm1.4.23" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.23.1" class="ltx_text ltx_font_bold">21</span></span>
            <span id="algorithm1.4.23.2" class="ltx_text ltx_font_bold">return</span> <em id="algorithm1.4.23.3" class="ltx_emph ltx_font_italic"><math id="algorithm1.m32" class="ltx_Math" alttext="O=\{O_{i}\}" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>O</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">O=\{O_{i}\}</annotation></semantics></math></em>;
</div>
