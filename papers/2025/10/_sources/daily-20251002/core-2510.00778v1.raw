<td id="A1.T3.3.2.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:2.6pt;padding-right:2.6pt;"><span id="A1.T3.3.2.3.1" class="ltx_text ltx_font_bold">MasaCtrl</span></td>
<td id="A1.T3.3.2.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:2.6pt;padding-right:2.6pt;"><span id="A1.T3.3.2.4.1" class="ltx_text ltx_font_bold">PnP</span></td>
<td id="A1.T3.3.2.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-left:2.6pt;padding-right:2.6pt;"><span id="A1.T3.3.2.5.1" class="ltx_text ltx_font_bold">P2P</span></td>
<td id="A1.T3.3.2.6" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:2.6pt;padding-right:2.6pt;"><span id="A1.T3.3.2.6.1" class="ltx_text ltx_font_bold">P2P</span></td>
<td id="A1.T3.3.2.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-left:2.6pt;padding-right:2.6pt;"><span id="A1.T3.3.2.7.1" class="ltx_text ltx_font_bold">Proximal-Guidance</span></td>
<td id="A1.T3.3.2.8" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:2.6pt;padding-right:2.6pt;"><span id="A1.T3.3.2.8.1" class="ltx_text ltx_font_bold">P2P</span></td>
<td id="A1.T3.3.2.9" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-left:2.6pt;padding-right:2.6pt;"><span id="A1.T3.3.2.9.1" class="ltx_text ltx_font_bold">Proximal-Guidance</span></td>
<td id="A1.T3.3.2.10" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:2.6pt;padding-right:2.6pt;"><span id="A1.T3.3.2.10.1" class="ltx_text ltx_font_bold">P2P</span></td></tr>
<tr id="A1.T3.3.3" class="ltx_tr">
<td id="A1.T3.3.3.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-left:2.6pt;padding-right:2.6pt;">Natural Edit</td>
<td id="A1.T3.3.3.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:2.6pt;padding-right:2.6pt;">25.7100</td>
<td id="A1.T3.3.3.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:2.6pt;padding-right:2.6pt;">24.9504</td>
