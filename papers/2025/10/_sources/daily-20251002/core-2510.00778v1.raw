<td id="A3.T9.3.9.2" class="ltx_td ltx_align_center" style="--ltx-bg-color:#E6E6E6;padding-left:12.0pt;padding-right:12.0pt;"><span id="A3.T9.3.9.2.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">23.4423</span></td>
