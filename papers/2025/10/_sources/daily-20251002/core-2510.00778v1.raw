<th id="S4.T2.3.3.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:2.8pt;padding-right:2.8pt;">0.0914</th>
<th id="S4.T2.3.3.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:2.8pt;padding-right:2.8pt;">0.0071</th>
<th id="S4.T2.3.3.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:2.8pt;padding-right:2.8pt;">0.8124</th></tr>
</thead>
<tbody class="ltx_tbody">
