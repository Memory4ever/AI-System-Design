<td id="A2.T4.2.3.2" class="ltx_td ltx_align_center ltx_border_bb"><math id="A2.T4.m9" class="ltx_Math" alttext="T=0.6" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>0.6</mn></mrow><annotation encoding="application/x-tex">T=0.6</annotation></semantics></math>, top-<math id="A2.T4.m10" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> = 0.95, and top-<math id="A2.T4.m11" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> = <math id="A2.T4.m12" class="ltx_Math" alttext="20" display="inline" intent=":literal"><semantics><mn>20</mn><annotation encoding="application/x-tex">20</annotation></semantics></math></td>
<td id="A2.T4.2.3.3" class="ltx_td ltx_align_center ltx_border_bb"><math id="A2.T4.m13" class="ltx_Math" alttext="T=0.7" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>0.7</mn></mrow><annotation encoding="application/x-tex">T=0.7</annotation></semantics></math>, top-<math id="A2.T4.m14" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> = 0.8, and top-<math id="A2.T4.m15" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> = <math id="A2.T4.m16" class="ltx_Math" alttext="20" display="inline" intent=":literal"><semantics><mn>20</mn><annotation encoding="application/x-tex">20</annotation></semantics></math></td></tr>
