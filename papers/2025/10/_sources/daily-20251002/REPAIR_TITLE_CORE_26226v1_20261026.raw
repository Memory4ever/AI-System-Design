<td id="S4.T1.6.1.20.2" class="ltx_td ltx_align_center" style="--ltx-bg-color:#BDE8F0;"><span id="S4.T1.6.1.20.2.1" class="ltx_text" style="--ltx-bg-color:#BDE8F0;">61.8</span></td>
