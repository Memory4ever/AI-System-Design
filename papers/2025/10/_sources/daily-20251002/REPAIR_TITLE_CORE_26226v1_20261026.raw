<td id="S4.T1.6.1.19.8" class="ltx_td ltx_align_center" style="--ltx-bg-color:#D6F2F5;"><span id="S4.T1.6.1.19.8.1" class="ltx_text" style="--ltx-bg-color:#D6F2F5;">45.6</span></td></tr>
