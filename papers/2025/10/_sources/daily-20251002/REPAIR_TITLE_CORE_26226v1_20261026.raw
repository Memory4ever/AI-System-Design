<td id="S4.T1.6.1.20.4" class="ltx_td ltx_align_center ltx_border_r" style="--ltx-bg-color:#A3DEEB;"><span id="S4.T1.6.1.20.4.1" class="ltx_text" style="--ltx-bg-color:#A3DEEB;">31.5</span></td>
