<td id="S4.T1.6.1.20.7" class="ltx_td ltx_align_center ltx_border_r" style="--ltx-bg-color:#BDE8F0;"><span id="S4.T1.6.1.20.7.1" class="ltx_text" style="--ltx-bg-color:#BDE8F0;">57.1</span></td>
