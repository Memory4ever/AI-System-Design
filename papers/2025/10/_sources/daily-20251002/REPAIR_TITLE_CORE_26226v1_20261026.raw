<td id="S4.T1.6.1.21.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="--ltx-bg-color:#BDE8F0;"><span id="S4.T1.6.1.21.4.1" class="ltx_text" style="--ltx-bg-color:#BDE8F0;">31.1</span></td>
