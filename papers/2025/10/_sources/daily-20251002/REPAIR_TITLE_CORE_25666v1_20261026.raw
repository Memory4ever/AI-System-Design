<td id="A2.T3.4.5.4" class="ltx_td ltx_align_center">1e-6</td></tr>
<tr id="A2.T3.4.6" class="ltx_tr">
<th id="A2.T3.4.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">clip_ratio_low</th>
<td id="A2.T3.4.6.2" class="ltx_td ltx_align_center">0.2</td>
<td id="A2.T3.4.6.3" class="ltx_td ltx_align_center">0.2</td>
<td id="A2.T3.4.6.4" class="ltx_td ltx_align_center">0.2</td></tr>
<tr id="A2.T3.4.7" class="ltx_tr">
