<td id="A2.T4.4.4.2" class="ltx_td ltx_align_center">9000</td>
<td id="A2.T4.4.4.3" class="ltx_td ltx_align_center">9000</td>
<td id="A2.T4.4.4.4" class="ltx_td ltx_align_center">9000</td></tr>
