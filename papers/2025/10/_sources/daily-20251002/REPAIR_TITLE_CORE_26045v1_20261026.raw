<th id="S4.T10.2.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb ltx_border_t" rowspan="2"><span id="S4.T10.2.4.1.1" class="ltx_text">CDGTD</span></th>
<td id="S4.T10.2.4.2" class="ltx_td ltx_align_center ltx_border_t">Chronological</td>
<td id="S4.T10.2.4.3" class="ltx_td ltx_align_center ltx_border_t">95.17</td>
<td id="S4.T10.2.4.4" class="ltx_td ltx_align_center ltx_border_t">54.68</td></tr>
