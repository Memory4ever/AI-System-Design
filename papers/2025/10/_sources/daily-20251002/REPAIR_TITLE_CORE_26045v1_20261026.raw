<td id="S4.T9.2.2.2" class="ltx_td ltx_align_center ltx_border_t">Both</td>
<td id="S4.T9.2.2.3" class="ltx_td ltx_align_center ltx_border_t">88.46</td>
<td id="S4.T9.2.2.4" class="ltx_td ltx_align_center ltx_border_t">59.76</td></tr>
