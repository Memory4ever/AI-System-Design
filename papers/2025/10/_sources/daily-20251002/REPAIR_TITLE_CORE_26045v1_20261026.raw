<th id="S3.T1.2.1.6.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t"><math id="S3.T1.m6" class="ltx_Math" alttext="D_{S+1}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mi>S</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">D_{S+1}</annotation></semantics></math></th>
