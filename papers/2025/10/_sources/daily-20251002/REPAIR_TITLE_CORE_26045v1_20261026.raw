<th id="S3.T1.2.1.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">LSSAE<sup id="S3.T1.2.1.2.7.1" class="ltx_sup"><span id="S3.T1.2.1.2.7.1.1" class="ltx_text ltx_font_italic">§</span></sup></th>
