<td id="S4.T9.2.3.3" class="ltx_td ltx_align_center">95.36</td>
<td id="S4.T9.2.3.4" class="ltx_td ltx_align_center">60.77</td></tr>
<tr id="S4.T9.2.4" class="ltx_tr">
<th id="S4.T9.2.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t"><span class="ltx_rule" style="width:0.0pt;height:8.6pt;--ltx-bg-color:black;display:inline-block;"></span>TEA-S</th>
<td id="S4.T9.2.4.2" class="ltx_td ltx_align_center ltx_border_t">Abrupt</td>
<td id="S4.T9.2.4.3" class="ltx_td ltx_align_center ltx_border_t">95.47</td>
<td id="S4.T9.2.4.4" class="ltx_td ltx_align_center ltx_border_t">60.85</td></tr>
<tr id="S4.T9.2.5" class="ltx_tr">
<th id="S4.T9.2.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb">TEA</th>
<td id="S4.T9.2.5.2" class="ltx_td ltx_align_center ltx_border_bb">Smooth</td>
<td id="S4.T9.2.5.3" class="ltx_td ltx_align_center ltx_border_bb">95.95</td>
