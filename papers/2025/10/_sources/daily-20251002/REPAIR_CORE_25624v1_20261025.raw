<td id="S2.T1.4.3.1" class="ltx_td ltx_align_left ltx_align_top" style="padding:1pt 4.0pt;">
<span id="S2.T1.4.3.1.1" class="ltx_inline-block ltx_align_top" style="width:45.5pt;">
<span id="S2.T1.4.3.1.1.1" class="ltx_p">• Available Tools</span>
</span></td>
<td id="S2.T1.4.3.2" class="ltx_td ltx_align_top" style="padding:1pt 4.0pt;"></td>
<td id="S2.T1.4.3.3" class="ltx_td ltx_align_top" style="padding:1pt 4.0pt;"></td>
