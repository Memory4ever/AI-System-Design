        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.00621">pdf</a>, <a href="https://arxiv.org/ps/2510.00621">ps</a>, <a href="https://arxiv.org/format/2510.00621">other</a>]&nbsp;</span>
