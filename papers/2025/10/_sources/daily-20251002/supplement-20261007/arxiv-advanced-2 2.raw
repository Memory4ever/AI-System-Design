        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.04765">pdf</a>, <a href="https://arxiv.org/ps/2510.04765">ps</a>, <a href="https://arxiv.org/format/2510.04765">other</a>]&nbsp;</span>
