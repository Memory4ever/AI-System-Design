        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.03612">pdf</a>, <a href="https://arxiv.org/ps/2510.03612">ps</a>, <a href="https://arxiv.org/format/2510.03612">other</a>]&nbsp;</span>
