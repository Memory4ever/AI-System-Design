      <a href="/search/?searchtype=author&amp;query=Burbano%2C+L">Luis Burbano</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Ortiz%2C+D">Diego Ortiz</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Sun%2C+Q">Qi Sun</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Yang%2C+S">Siwei Yang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Tu%2C+H">Haoqin Tu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Xie%2C+C">Cihang Xie</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Cao%2C+Y">Yinzhi Cao</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Cardenas%2C+A+A">Alvaro A Cardenas</a>
      
