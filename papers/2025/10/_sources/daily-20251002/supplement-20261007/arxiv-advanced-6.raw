    <p class="title is-5 mathjax">
      
        PodEval: A <span class="search-hit mathjax">Multimodal</span> Evaluation Framework for Podcast Audio Generation
      
    </p>
    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Xiao%2C+Y">Yujia Xiao</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Xue%2C+L">Liumeng Xue</a>, 
      
      <a href="/search/?searchtype=author&amp;query=He%2C+L">Lei He</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Chen%2C+X">Xinyi Chen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Chiu%2C+A+Y+F">Aemon Yat Fei Chiu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Tian%2C+W">Wenjie Tian</a>, 
      
