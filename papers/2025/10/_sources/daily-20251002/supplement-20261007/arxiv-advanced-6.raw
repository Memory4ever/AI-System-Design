      <a href="/search/?searchtype=author&amp;query=Zhu%2C+W">Wenxin Zhu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Chen%2C+K">Kehai Chen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Bai%2C+X">Xuefeng Bai</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Yang%2C+M">Muyun Yang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhao%2C+T">Tiejun Zhao</a>
      
