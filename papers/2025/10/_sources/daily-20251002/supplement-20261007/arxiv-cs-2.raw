        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.03812">pdf</a>, <a href="https://arxiv.org/ps/2510.03812">ps</a>, <a href="https://arxiv.org/format/2510.03812">other</a>]&nbsp;</span>
