        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.03248">pdf</a>, <a href="https://arxiv.org/ps/2510.03248">ps</a>, <a href="https://arxiv.org/format/2510.03248">other</a>]&nbsp;</span>
