        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.03292">pdf</a>, <a href="https://arxiv.org/ps/2510.03292">ps</a>, <a href="https://arxiv.org/format/2510.03292">other</a>]&nbsp;</span>
