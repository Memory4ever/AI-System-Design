        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.07979">pdf</a>, <a href="https://arxiv.org/ps/2510.07979">ps</a>, <a href="https://arxiv.org/format/2510.07979">other</a>]&nbsp;</span>
