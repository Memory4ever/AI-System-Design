        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.03293">pdf</a>, <a href="https://arxiv.org/ps/2510.03293">ps</a>, <a href="https://arxiv.org/format/2510.03293">other</a>]&nbsp;</span>
