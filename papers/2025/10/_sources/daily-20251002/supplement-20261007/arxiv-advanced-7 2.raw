        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.02226">pdf</a>, <a href="https://arxiv.org/ps/2510.02226">ps</a>, <a href="https://arxiv.org/format/2510.02226">other</a>]&nbsp;</span>
