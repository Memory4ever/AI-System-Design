        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.02677">pdf</a>, <a href="https://arxiv.org/ps/2510.02677">ps</a>, <a href="https://arxiv.org/format/2510.02677">other</a>]&nbsp;</span>
