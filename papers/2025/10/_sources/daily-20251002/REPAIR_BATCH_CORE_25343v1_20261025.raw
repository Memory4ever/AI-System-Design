          <span id="algorithm2.4.10.2" class="ltx_text ltx_font_bold">foreach</span> <em id="algorithm2.4.10.3" class="ltx_emph ltx_font_italic"><math id="algorithm2.m14" class="ltx_Math" alttext="(u,v)\in E(G)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(u,v)\in E(G)</annotation></semantics></math></em> <span id="algorithm2.4.10.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm2.4.11" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
