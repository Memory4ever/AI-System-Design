<section id="Ptx1" class="ltx_part">
<h2 class="ltx_title ltx_title_part">Supplementary Materials</h2>

<div class="ltx_pagination ltx_role_newpage"></div>
<figure id="algorithm1" class="ltx_float ltx_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="algorithm1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span>Graph Structure Generation</figcaption>
<div id="algorithm1.4" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="algorithm1.4.1" class="ltx_listingline">
<span id="algorithm1.4.1.1" class="ltx_text"><span id="algorithm1.4.1.1.1" class="ltx_text ltx_font_bold">Input:</span> </span>Number of nodes <math id="algorithm1.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>, number of edges <math id="algorithm1.m2" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>
</div>
<div id="algorithm1.4.2" class="ltx_listingline"><span id="algorithm1.4.2.1" class="ltx_text"><span id="algorithm1.4.2.1.1" class="ltx_text ltx_font_bold">Output:</span> </span>Set <math id="algorithm1.m3" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> of pairs <math id="algorithm1.m4" class="ltx_Math" alttext="(G,\pi)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>π</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(G,\pi)</annotation></semantics></math> where <math id="algorithm1.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is a valid DAG and <math id="algorithm1.m6" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> is a topological order
</div>
<div id="algorithm1.4.3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.3.1" class="ltx_text ltx_font_bold">1</span></span>
          <math id="algorithm1.m7" class="ltx_Math" alttext="\mathcal{G}\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\mathcal{G}\leftarrow\emptyset</annotation></semantics></math> ;
</div>
<div id="algorithm1.4.4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.4.1" class="ltx_text ltx_font_bold">2</span></span>
          <math id="algorithm1.m8" class="ltx_Math" alttext="V\leftarrow\{0,1,\dots,n-1\}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">V\leftarrow\{0,1,\dots,n-1\}</annotation></semantics></math> ;
</div>
<div id="algorithm1.4.5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.5.1" class="ltx_text ltx_font_bold">3</span></span>
          <span id="algorithm1.4.5.2" class="ltx_text ltx_font_bold">foreach</span> <em id="algorithm1.4.5.3" class="ltx_emph ltx_font_italic">permutation <math id="algorithm1.m9" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> of <math id="algorithm1.m10" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math></em> <span id="algorithm1.4.5.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.4.6" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.6.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">4</span></span>
          <span id="algorithm1.4.6.2" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">// Treat <math id="algorithm1.m11" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> as a candidate topological order</span>;
</div>
<div id="algorithm1.4.7" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.7.1" class="ltx_text ltx_font_bold">5</span></span>
          <math id="algorithm1.m12" class="ltx_Math" alttext="E_{\text{cand}}\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mtext>cand</mtext></msub><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">E_{\text{cand}}\leftarrow\emptyset</annotation></semantics></math> ;
</div>
<div id="algorithm1.4.8" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.8.1" class="ltx_text ltx_font_bold">6</span></span>
          <span id="algorithm1.4.8.2" class="ltx_text ltx_font_bold">for</span> <em id="algorithm1.4.8.3" class="ltx_emph ltx_font_italic"><math id="algorithm1.m13" class="ltx_Math" alttext="i\leftarrow 1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo stretchy="false">←</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i\leftarrow 1</annotation></semantics></math> <span id="algorithm1.4.8.3.1" class="ltx_text ltx_font_bold ltx_font_upright">to</span> <math id="algorithm1.m14" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math></em> <span id="algorithm1.4.8.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.4.9" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.9.1" class="ltx_text ltx_font_bold">7</span></span>
          <span id="algorithm1.4.9.2" class="ltx_text ltx_font_bold">for</span> <em id="algorithm1.4.9.3" class="ltx_emph ltx_font_italic"><math id="algorithm1.m15" class="ltx_Math" alttext="j\leftarrow i+1" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo stretchy="false">←</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">j\leftarrow i+1</annotation></semantics></math> <span id="algorithm1.4.9.3.1" class="ltx_text ltx_font_bold ltx_font_upright">to</span> <math id="algorithm1.m16" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math></em> <span id="algorithm1.4.9.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.4.10" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.10.1" class="ltx_text ltx_font_bold">8</span></span>
          <math id="algorithm1.m17" class="ltx_Math" alttext="E_{\text{cand}}\leftarrow E_{\text{cand}}\cup\{(\pi_{j},\pi_{i})\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mtext>cand</mtext></msub><mo stretchy="false">←</mo><mrow><msub><mi>E</mi><mtext>cand</mtext></msub><mo>∪</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>j</mi></msub><mo>,</mo><msub><mi>π</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">E_{\text{cand}}\leftarrow E_{\text{cand}}\cup\{(\pi_{j},\pi_{i})\}</annotation></semantics></math> ;
</div>
<div id="algorithm1.4.11" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.11.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">9</span></span>
          <span id="algorithm1.4.11.2" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">// Only add backward edges w.r.t. <math id="algorithm1.m18" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> to ensure acyclicity</span>

</div>
<div id="algorithm1.4.12" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.12.1" class="ltx_text ltx_font_bold">10</span></span>
          <span id="algorithm1.4.12.2" class="ltx_text ltx_font_bold">foreach</span> <em id="algorithm1.4.12.3" class="ltx_emph ltx_font_italic">subset <math id="algorithm1.m19" class="ltx_Math" alttext="E\subseteq E_{\text{cand}}" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⊆</mo><msub><mi>E</mi><mtext class="ltx_mathvariant_italic">cand</mtext></msub></mrow><annotation encoding="application/x-tex">E\subseteq E_{\text{cand}}</annotation></semantics></math> with <math id="algorithm1.m20" class="ltx_Math" alttext="|E|=m" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>E</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">|E|=m</annotation></semantics></math></em> <span id="algorithm1.4.12.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.4.13" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.13.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">11</span></span>
          <span id="algorithm1.4.13.2" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">// Enforce “no isolated nodes”</span> ;
</div>
<div id="algorithm1.4.14" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.14.1" class="ltx_text ltx_font_bold">12</span></span>
          <span id="algorithm1.4.14.2" class="ltx_text ltx_font_bold">if</span> <em id="algorithm1.4.14.3" class="ltx_emph ltx_font_italic">all nodes in <math id="algorithm1.m21" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> appear in some edge of <math id="algorithm1.m22" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math></em> <span id="algorithm1.4.14.4" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="algorithm1.4.15" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.15.1" class="ltx_text ltx_font_bold">13</span></span>
          Construct graph <math id="algorithm1.m23" class="ltx_Math" alttext="G=(V,E)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G=(V,E)</annotation></semantics></math> ;
</div>
<div id="algorithm1.4.16" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.16.1" class="ltx_text ltx_font_bold">14</span></span>
          <math id="algorithm1.m24" class="ltx_Math" alttext="\mathcal{G}\leftarrow\mathcal{G}\cup\{(G,\pi)\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo stretchy="false">←</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>π</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{G}\leftarrow\mathcal{G}\cup\{(G,\pi)\}</annotation></semantics></math> ;
</div>
<div id="algorithm1.4.17" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.17.1" class="ltx_text ltx_font_bold">15</span></span>
          <span id="algorithm1.4.17.2" class="ltx_text ltx_font_bold">return</span> <math id="algorithm1.m25" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> ;
</div>
