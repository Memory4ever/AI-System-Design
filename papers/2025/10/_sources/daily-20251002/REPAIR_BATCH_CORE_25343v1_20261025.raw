          <span id="algorithm2.4.20.2" class="ltx_text ltx_font_bold">if</span> <em id="algorithm2.4.20.3" class="ltx_emph ltx_font_italic"><math id="algorithm2.m27" class="ltx_Math" alttext="n\notin\texttt{scene\_node}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>∉</mo><mtext class="ltx_mathvariant_monospace">scene_node</mtext></mrow><annotation encoding="application/x-tex">n\notin\texttt{scene\_node}</annotation></semantics></math></em> <span id="algorithm2.4.20.4" class="ltx_text ltx_font_bold">then</span>
</div>
