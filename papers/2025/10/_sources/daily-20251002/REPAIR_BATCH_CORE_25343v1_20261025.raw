0" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -5.78 -4.37)"><foreignObject style="--ltx-fo-width:0.9em;--ltx-fo-height:0.79em;--ltx-fo-depth:0.11em;font-size:9.25pt;" height="11.52" overflow="visible" transform="matrix(1 0 0 -1 0 10.13)" width="11.56"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.T2.pic1.m2" class="ltx_Math" alttext="c^{\prime}_{2}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.900em">c</mi><mn mathsize="0.900em">2</mn><mo mathsize="0.900em">′</mo></msubsup><annotation encoding="application/x-tex">c^{\prime}_{2}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 57.21 -4.37)"><foreignObject style="--ltx-fo-width:0.9em;--ltx-fo-height:0.79em;--ltx-fo-depth:0.11em;font-size:9.25pt;" height="11.52" overflow="visible" transform="matrix(1 0 0 -1 0 10.13)" width="11.56"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.T2.pic1.m3" class="ltx_Math" alttext="c^{\prime}_{3}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.900em">c</mi><mn mathsize="0.900em">3</mn><mo mathsize="0.900em">′</mo></msubsup><annotation encoding="application/x-tex">c^{\prime}_{3}</annotation></semantics></math></span></span></foreignObject></g></g></g></svg></span></td>
<td id="S4.T2.14.1.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:0.85pt 14.2pt;"><math id="S4.T2.m17" class="ltx_Math" alttext="b^{\prime}_{1}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.800em">b</mi><mn mathsize="0.800em">1</mn><mo mathsize="0.800em">′</mo></msubsup><annotation encoding="application/x-tex">b^{\prime}_{1}</annotation></semantics></math></td>
<td id="S4.T2.14.1.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:0.85pt 14.2pt;"><span class="ltx_inline-block"><svg id="S4.T2.pic2" class="ltx_picture" height="36.95" overflow="visible" version="1.1" viewBox="0 0 145.99 36.95" width="145.99"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,36.95) matrix(1 0 0 -1 0 0) translate(73,0) translate(0,10)"><g stroke-width="0.8pt"><path style="fill:none" d="M -62.99 0 M -53.54 0 C -53.54 5.22 -57.77 9.45 -62.99 9.45 C -68.21 9.45 -72.44 5.22 -72.44 0 C -72.44 -5.22 -68.21 -9.45 -62.99 -9.45 C -57.77 -9.45 -53.54 -5.22 -53.54 0 Z M -62.99 0"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M 0 0 M 9.45 0 C 9.45 5.22 5.22 9.45 0 9.45 C -5.22 9.45 -9.45 5.22 -9.45 0 C -9.45 -5.22 -5.22 -9.45 0 -9.45 C 5.22 -9.45 9.45 -5.22 9.45 0 Z M 0 0"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M 62.99 0 M 72.44 0 C 72.44 5.22 68.21 9.45 62.99 9.45 C 57.77 9.45 53.54 5.22 53.54 0 C 53.54 -5.22 57.77 -9.45 62.99 -9.45 C 68.21 -9.45 72.44 -5.22 72.44 0 Z M 62.99 0"></path></g><g stroke-width="0.4pt"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -68.77 -4.37)"><foreignObject style="--ltx-fo-width:0.9em;--ltx-fo-height:0.79em;--ltx-fo-depth:0.11em;font-size:9.25pt;" height="11.52" overflow="visible" transform="matrix(1 0 0 -1 0 10.13)" width="11.56"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.T2.pic2.m1" class="ltx_Math" alttext="c^{\prime}_{1}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.900em">c</mi><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">′</mo></msubsup><annotation encoding="application/x-tex">c^{\prime}_{1}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fil