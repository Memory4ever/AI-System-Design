          <span id="algorithm2.4.16.2" class="ltx_text ltx_font_typewriter">error</span> <math id="algorithm2.m21" class="ltx_Math" alttext="\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo stretchy="false">←</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\leftarrow 0</annotation></semantics></math>;
