          <span id="algorithm2.4.25.2" class="ltx_text ltx_font_typewriter">out</span> <math id="algorithm2.m32" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> <span id="algorithm2.4.25.3" class="ltx_text ltx_font_typewriter">node</span>;
</div>
<div id="algorithm2.4.26" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.26.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">24</span></span>
          <span id="algorithm2.4.26.2" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">// Double-Check Graph Structure Validity: There must exist at least one edge between the characters currently present in the scene; otherwise, when a character leaves the scene, no valid interaction can be formed among them</span>;
</div>
<div id="algorithm2.4.27" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.27.1" class="ltx_text ltx_font_bold">25</span></span>
          <span id="algorithm2.4.27.2" class="ltx_text ltx_font_bold">foreach</span> <em id="algorithm2.4.27.3" class="ltx_emph ltx_font_italic"><math id="algorithm2.m33" class="ltx_Math" alttext="n\in\texttt{scene\_node}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>∈</mo><mtext class="ltx_mathvariant_monospace">scene_node</mtext></mrow><annotation encoding="application/x-tex">n\in\texttt{scene\_node}</annotation></semantics></math></em> <span id="algorithm2.4.27.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm2.4.28" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.28.1" class="ltx_text ltx_font_bold">26</span></span>
          <span id="algorithm2.4.28.2" class="ltx_text ltx_font_bold">if</span> <em id="algorithm2.4.28.3" class="ltx_emph ltx_font_italic"><math id="algorithm2.m34" class="ltx_Math" alttext="n\neq\texttt{out}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≠</mo><mtext class="ltx_mathvariant_monospace">out</mtext></mrow><annotation encoding="application/x-tex">n\neq\texttt{out}</annotation></semantics></math> <span id="algorithm2.4.28.3.1" class="ltx_text ltx_font_bold">and</span> <math id="algorithm2.m35" class="ltx_Math" alttext="(n,\texttt{node})\notin\texttt{edge\_list}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mtext class="ltx_mathvariant_monospace">node</mtext><mo stretchy="false">)</mo></mrow><mo>∉</mo><mtext class="ltx_mathvariant_monospace">edge_list</mtext></mrow><annotation encoding="application/x-tex">(n,\texttt{node})\notin\texttt{edge\_list}</annotation></semantics></math></em> <span id="algorithm2.4.28.4" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="algorithm2.4.29" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.29.1" class="ltx_text ltx_font_bold">27</span></span>
          <span id="algorithm2.4.29.2" class="ltx_text ltx_font_typewriter">error</span> <math id="algorithm2.m36" class="ltx_Math" alttext="\leftarrow 1" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo stretchy="false">←</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\leftarrow 1</annotation></semantics></math>;
</div>
<div id="algorithm2.4.30" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.30.1" class="ltx_text ltx_font_bold">28</span></span>
          remove <span id="algorithm2.4.30.2" class="ltx_text ltx_font_typewriter">out</span> from <span id="algorithm2.4.30.3" class="ltx_text ltx_font_typewriter">scene_node</span>;
</div>
<div id="algorithm2.4.31" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.31.1" class="ltx_text ltx_font_bold">29</span></span>
          append {<span id="algorithm2.4.31.2" class="ltx_text ltx_font_typewriter">in</span>: <span id="algorithm2.4.31.3" class="ltx_text ltx_font_typewriter">in_list</span>, <span id="algorithm2.4.31.4" class="ltx_text ltx_font_typewriter">out</span>: <span id="algorithm2.4.31.5" class="ltx_text ltx_font_typewriter">out</span>} to <span id="algorithm2.4.31.6" class="ltx_text ltx_font_typewriter">character_order</span>;
</div>
<div id="algorithm2.4.32" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.32.1" class="ltx_text ltx_font_bold">30</span></span>
          <span id="algorithm2.4.32.2" class="ltx_text ltx_font_bold">if</span> <em id="algorithm2.4.32.3" class="ltx_emph ltx_font_italic"><span id="algorithm2.4.32.3.1" class="ltx_text ltx_font_typewriter">error</span> = 0</em> <span id="algorithm2.4.32.4" class="ltx_text ltx_font_bold">then</span>
</div>
