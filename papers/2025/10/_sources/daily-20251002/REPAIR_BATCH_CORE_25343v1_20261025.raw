</div>
<div id="algorithm2.4.18" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.18.1" class="ltx_text ltx_font_bold">16</span></span>
          <span id="algorithm2.4.18.2" class="ltx_text ltx_font_typewriter">in_list</span> <math id="algorithm2.m23" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> { <span id="algorithm2.4.18.3" class="ltx_text ltx_font_typewriter">node</span> } if <span id="algorithm2.4.18.4" class="ltx_text ltx_font_typewriter">node</span> <math id="algorithm2.m24" class="ltx_Math" alttext="\notin\texttt{scene\_node}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∉</mo><mtext class="ltx_mathvariant_monospace">scene_node</mtext></mrow><annotation encoding="application/x-tex">\notin\texttt{scene\_node}</annotation></semantics></math> else <math id="algorithm2.m25" class="ltx_Math" alttext="\emptyset" display="inline" intent=":literal"><semantics><mi mathvariant="normal">∅</mi><annotation encoding="application/x-tex">\emptyset</annotation></semantics></math>;
