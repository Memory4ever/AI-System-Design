<figure id="algorithm2" class="ltx_float ltx_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="algorithm2.3" class="ltx_text ltx_font_bold">Algorithm 2</span> </span>Character Order Generation over Graph Structures</figcaption>
<div id="algorithm2.4" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="algorithm2.4.1" class="ltx_listingline">
<span id="algorithm2.4.1.1" class="ltx_text"><span id="algorithm2.4.1.1.1" class="ltx_text ltx_font_bold">Input:</span> </span>Set <math id="algorithm2.m1" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> of pairs <math id="algorithm2.m2" class="ltx_Math" alttext="(G,\pi)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>π</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(G,\pi)</annotation></semantics></math> from <span id="algorithm2.4.1.2" class="ltx_text ltx_font_bold">Algorithm <a href="#algorithm1" title="In Supplementary Materials ‣ Spontaneous High-Order Generalization in Neural Theory-of-Mind Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a></span>
</div>
<div id="algorithm2.4.2" class="ltx_listingline"><span id="algorithm2.4.2.1" class="ltx_text"><span id="algorithm2.4.2.1.1" class="ltx_text ltx_font_bold">Output:</span> </span>Set <math id="algorithm2.m3" class="ltx_Math" alttext="\mathcal{R}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℛ</mi><annotation encoding="application/x-tex">\mathcal{R}</annotation></semantics></math> of pairs <math id="algorithm2.m4" class="ltx_Math" alttext="(G,\texttt{character\_order})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mtext class="ltx_mathvariant_monospace">character_order</mtext><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(G,\texttt{character\_order})</annotation></semantics></math>
</div>
<div id="algorithm2.4.3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.3.1" class="ltx_text ltx_font_bold">1</span></span>
          <math id="algorithm2.m5" class="ltx_Math" alttext="\mathcal{R}\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\mathcal{R}\leftarrow\emptyset</annotation></semantics></math>;
</div>
<div id="algorithm2.4.4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.4.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#808080;">2</span></span>
          <span id="algorithm2.4.4.2" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#808080;">// process each graph <math id="algorithm2.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> with its topological order <math id="algorithm2.m7" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math></span> ;
</div>
<div id="algorithm2.4.5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.5.1" class="ltx_text ltx_font_bold">3</span></span>
          <span id="algorithm2.4.5.2" class="ltx_text ltx_font_bold">foreach</span> <em id="algorithm2.4.5.3" class="ltx_emph ltx_font_italic"><math id="algorithm2.m8" class="ltx_Math" alttext="(G,\pi)\in\mathcal{G}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>π</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow><annotation encoding="application/x-tex">(G,\pi)\in\mathcal{G}</annotation></semantics></math></em> <span id="algorithm2.4.5.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm2.4.6" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.6.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#808080;">4</span></span>
          <span id="algorithm2.4.6.2" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#808080;">// build <span id="algorithm2.4.6.2.1" class="ltx_text ltx_font_typewriter">parents</span> and <span id="algorithm2.4.6.2.2" class="ltx_text ltx_font_typewriter">edge_list</span> for current <math id="algorithm2.m9" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math></span>;
</div>
<div id="algorithm2.4.7" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.7.1" class="ltx_text ltx_font_bold">5</span></span>
          <span id="algorithm2.4.7.2" class="ltx_text ltx_font_bold">foreach</span> <em id="algorithm2.4.7.3" class="ltx_emph ltx_font_italic"><math id="algorithm2.m10" class="ltx_Math" alttext="v\in V(G)" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">v\in V(G)</annotation></semantics></math></em> <span id="algorithm2.4.7.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm2.4.8" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.8.1" class="ltx_text ltx_font_bold">6</span></span>
          <span id="algorithm2.4.8.2" class="ltx_text ltx_font_typewriter">parents[<math id="algorithm2.m11" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math>]</span> <math id="algorithm2.m12" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> empty list;
</div>
<div id="algorithm2.4.9" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.9.1" class="ltx_text ltx_font_bold">7</span></span>
          <span id="algorithm2.4.9.2" class="ltx_text ltx_font_typewriter">edge_list</span> <math id="algorithm2.m13" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> empty list;
</div>
<div id="algorithm2.4.10" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
