</div>
<div id="algorithm2.4.22" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.22.1" class="ltx_text ltx_font_bold">20</span></span>
          <span id="algorithm2.4.22.2" class="ltx_text ltx_font_bold">foreach</span> <em id="algorithm2.4.22.3" class="ltx_emph ltx_font_italic"><math id="algorithm2.m29" class="ltx_Math" alttext="n\in\texttt{in\_list}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>∈</mo><mtext class="ltx_mathvariant_monospace">in_list</mtext></mrow><annotation encoding="application/x-tex">n\in\texttt{in\_list}</annotation></semantics></math></em> <span id="algorithm2.4.22.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm2.4.23" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
