          <span id="algorithm2.4.23.2" class="ltx_text ltx_font_bold">if</span> <em id="algorithm2.4.23.3" class="ltx_emph ltx_font_italic"><math id="algorithm2.m30" class="ltx_Math" alttext="n\notin\texttt{scene\_node}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>∉</mo><mtext class="ltx_mathvariant_monospace">scene_node</mtext></mrow><annotation encoding="application/x-tex">n\notin\texttt{scene\_node}</annotation></semantics></math></em> <span id="algorithm2.4.23.4" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="algorithm2.4.24" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
