<td id="S4.T4.2.4.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_b" style="padding-top:1pt;padding-bottom:1pt;"><span id="S4.T4.2.4.6.1" class="ltx_text ltx_font_bold">0.831</span></td></tr>
