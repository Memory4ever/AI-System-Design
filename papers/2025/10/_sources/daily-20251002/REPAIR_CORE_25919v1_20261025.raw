<td id="S4.T1.4.6.3" class="ltx_td ltx_align_right"><span id="S4.T1.4.6.3.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">0.114 (<math id="S4.T1.m3" class="ltx_Math" alttext="\blacktriangledown" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">▼</mi><annotation encoding="application/x-tex">\blacktriangledown</annotation></semantics></math>6.4 %)</span></td></tr>
