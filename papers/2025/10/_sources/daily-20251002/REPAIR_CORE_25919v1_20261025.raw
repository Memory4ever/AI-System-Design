<td id="S4.T1.4.1.2" class="ltx_td ltx_align_right ltx_border_t"><span id="S4.T1.4.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Hit Rate</span></td>
