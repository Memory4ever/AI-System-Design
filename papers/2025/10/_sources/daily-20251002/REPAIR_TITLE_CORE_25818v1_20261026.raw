<span id="A5.T5.2.7.2.1" class="ltx_inline-block ltx_align_top" style="width:28.5pt;">
<span id="A5.T5.2.7.2.1.1" class="ltx_p ltx_align_center">2</span>
</span></td></tr>
<tr id="A5.T5.2.8" class="ltx_tr">
<td id="A5.T5.2.8.1" class="ltx_td ltx_align_left ltx_align_top">
