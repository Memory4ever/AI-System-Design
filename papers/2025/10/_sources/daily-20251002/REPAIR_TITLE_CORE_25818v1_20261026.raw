<span id="A5.T5.2.4.2.1" class="ltx_inline-block ltx_align_top" style="width:28.5pt;">
<span id="A5.T5.2.4.2.1.1" class="ltx_p ltx_align_center">3</span>
</span></td></tr>
<tr id="A5.T5.2.5" class="ltx_tr">
<td id="A5.T5.2.5.1" class="ltx_td ltx_align_left ltx_align_top">
<span id="A5.T5.2.5.1.1" class="ltx_inline-block ltx_align_top" style="width:170.7pt;">
