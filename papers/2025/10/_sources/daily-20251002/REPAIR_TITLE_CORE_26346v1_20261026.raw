<td id="S4.T5.2.1.3.3" class="ltx_td ltx_align_center"><span id="S4.T5.2.1.3.3.1" class="ltx_text ltx_underline">59.50</span></td>
<td id="S4.T5.2.1.3.4" class="ltx_td ltx_align_center"><span id="S4.T5.2.1.3.4.1" class="ltx_text ltx_font_bold">36.18</span></td>
