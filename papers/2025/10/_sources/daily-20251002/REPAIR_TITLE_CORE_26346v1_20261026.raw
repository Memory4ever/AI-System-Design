<td id="S4.T3.2.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;" colspan="3"><span id="S4.T3.2.1.1.2.1" class="ltx_text ltx_font_bold">GEdit-Bench-EN-I <math id="S4.T3.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td>
<td id="S4.T3.2.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;" colspan="3"><span id="S4.T3.2.1.1.3.1" class="ltx_text ltx_font_bold">GEdit-Bench-EN <math id="S4.T3.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td>
<td id="S4.T3.2.1.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;" colspan="3"><span id="S4.T3.2.1.1.4.1" class="ltx_text ltx_font_bold">GEdit-Bench-CN-I <math id="S4.T3.m5" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td>
<td id="S4.T3.2.1.1.5" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;" colspan="3"><span id="S4.T3.2.1.1.5.1" class="ltx_text ltx_font_bold">GEdit-Bench-CN <math id="S4.T3.m6" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td></tr>
<tr id="S4.T3.2.1.2" class="ltx_tr">
<td id="S4.T3.2.1.2.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T3.2.1.2.1.1" class="ltx_text ltx_font_bold">G_SC</span></td>
