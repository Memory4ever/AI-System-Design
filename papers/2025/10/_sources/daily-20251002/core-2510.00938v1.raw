<td id="A5.T8.18.4.5" class="ltx_td ltx_align_center ltx_border_t"><span id="A5.T8.18.4.5.1" class="ltx_text" style="font-size:90%;">64.33</span></td>
<td id="A5.T8.18.4.6" class="ltx_td ltx_align_center ltx_border_t"><span id="A5.T8.18.4.6.1" class="ltx_text" style="font-size:90%;">80.00</span></td>
<td id="A5.T8.18.4.7" class="ltx_td ltx_align_center ltx_border_t"><span id="A5.T8.18.4.7.1" class="ltx_text" style="font-size:90%;">85.40</span></td>
<td id="A5.T8.18.4.8" class="ltx_td ltx_align_center ltx_border_t"><span id="A5.T8.18.4.8.1" class="ltx_text" style="font-size:90%;">82.00</span></td>
<td id="A5.T8.18.4.9" class="ltx_td ltx_align_center ltx_border_t"><span id="A5.T8.18.4.9.1" class="ltx_text" style="font-size:90%;">91.55</span></td>
<td id="A5.T8.18.4.10" class="ltx_td ltx_align_center ltx_border_t"><span id="A5.T8.18.4.10.1" class="ltx_text" style="font-size:90%;">66.67</span></td></tr>
<tr id="A5.T8.18.5" class="ltx_tr">
<td id="A5.T8.18.5.1" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_bb"><span id="A5.T8.18.5.1.1" class="ltx_text" style="font-size:90%;">RECAP (Ours)</span></td>
<td id="A5.T8.18.5.2" class="ltx_td ltx_align_center ltx_border_bb"><math id="A5.T8.m7" class="ltx_Math" alttext="\bm{98.08}" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_bold" mathsize="0.900em" mathvariant="bold">98.08</mn><annotation encoding="application/x-tex">\bm{98.08}</annotation></semantics></math></td>
<td id="A5.T8.18.5.3" class="ltx_td ltx_align_center ltx_border_bb"><math id="A5.T8.m8" class="ltx_Math" alttext="\bm{98.72}" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_bold" mathsize="0.900em" mathvariant="bold">98.72</mn><annotation encoding="application/x-tex">\bm{98.72}</annotation></semantics></math></td>
<td id="A5.T8.18.5.4" class="ltx_td ltx_align_center ltx_border_bb"><math id="A5.T8.m9" class="ltx_Math" alttext="\bm{86.75}" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_bold" mathsize="0.900em" mathvariant="bold">86.75</mn><annotation encoding="application/x-tex">\bm{86.75}</annotation></semantics></math></td>
<td id="A5.T8.18.5.5" class="ltx_td ltx_align_center ltx_border_bb"><math id="A5.T8.m10" class="ltx_Math" alttext="\bm{80.67}" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_bold" mathsize="0.900em" mathvariant="bold">80.67</mn><annotation encoding="application/x-tex">\bm{80.67}</annotation></semantics></math></td>
<td id="A5.T8.18.5.6" class="ltx_td ltx_align_center ltx_border_bb"><math id="A5.T8.m11" class="ltx_Math" alttext="\bm{92.00}" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_bold" mathsize="0.900em" mathvariant="bold">92.00</mn><annotation encoding="application/x-tex">\bm{92.00}</annotation></semantics></math></td>
<td id="A5.T8.18.5.7" class="ltx_td ltx_align_center ltx_border_bb"><math id="A5.T8.m12" class="ltx_Math" alttext="\bm{92.00}" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_bold" mathsize="0.900em" mathvariant="bold">92.00</mn><annotation encoding="application/x-tex">\bm{92.00}</annotation></semantics></math></td>
<td id="A5.T8.18.5.8" class="ltx_td ltx_align_center ltx_border_bb"><math id="A5.T8.m13" class="ltx_Math" alttext="\bm{83.80}" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_bold" mathsize="0.900em" mathvariant="bold">83.80</mn><annotation encoding="application/x-tex">\bm{83.80}</annotation></semantics></math></td>
<td id="A5.T8.18.5.9" class="ltx_td ltx_align_center ltx_border_bb"><math id="A5.T8.m14" class="ltx_Math" alttext="\bm{92.12}" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_bold" mathsize="0.900em" mathvariant="bold">92.12</mn><annotation encoding="application/x-tex">\bm{92.12}</annotation></semantics></math></td>
<td id="A5.T8.18.5.10" class="ltx_td ltx_align_center ltx_border_bb"><math id="A5.T8.m15" class="ltx_Math" alttext="\bm{70.00}" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_bold" mathsize="0.900em" mathvariant="bold">70.00</mn><annotation encoding="application/x-tex">\bm{70.00}</annotation></semantics></math></td></tr>
