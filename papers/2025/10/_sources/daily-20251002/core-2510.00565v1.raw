                <span class="ltx_tag ltx_tag_listingline">14:</span>
                
                
                 <math id="alg2.l14.m1" class="ltx_Math" alttext="R^{(i)}\leftarrow\mathcal{R}(\bm{q}^{(i)},\bm{r}_{T}^{(i)})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">←</mo><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒒</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msubsup><mi>𝒓</mi><mi>T</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R^{(i)}\leftarrow\mathcal{R}(\bm{q}^{(i)},\bm{r}_{T}^{(i)})</annotation></semantics></math>
<span id="alg2.l14.2" class="ltx_text" style="float:right;"><math id="alg2.l14.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Compute Reward
</span>
</div>
<div id="alg2.l15" class="ltx_listingline">
