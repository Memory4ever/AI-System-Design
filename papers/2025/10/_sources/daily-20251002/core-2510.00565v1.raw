<td id="S4.T1.4.1.4.1" class="ltx_td ltx_align_left" style="padding:-0.25pt 3.0pt;">Monte Carlo GCG</td>
<td id="S4.T1.4.1.4.2" class="ltx_td ltx_align_center" style="padding:-0.25pt 3.0pt;"><math id="S4.T1.m6" class="ltx_Math" alttext="20.0\,{\scriptstyle\pm}\,{\scriptstyle 4.2}" display="inline" intent=":literal"><semantics><mrow><mn>20.0</mn><mo lspace="0.392em" mathsize="0.700em">±</mo><mn mathsize="0.700em"> 4.2</mn></mrow><annotation encoding="application/x-tex">20.0\,{\scriptstyle\pm}\,{\scriptstyle 4.2}</annotation></semantics></math></td>
<td id="S4.T1.4.1.4.3" class="ltx_td ltx_align_center" style="padding:-0.25pt 3.0pt;">4.3</td>
<td id="S4.T1.4.1.4.4" class="ltx_td ltx_align_center" style="padding:-0.25pt 3.0pt;"><math id="S4.T1.m7" class="ltx_Math" alttext="12.5\,{\scriptstyle\pm}\,{\scriptstyle 2.0}" display="inline" intent=":literal"><semantics><mrow><mn>12.5</mn><mo lspace="0.392em" mathsize="0.700em">±</mo><mn mathsize="0.700em"> 2.0</mn></mrow><annotation encoding="application/x-tex">12.5\,{\scriptstyle\pm}\,{\scriptstyle 2.0}</annotation></semantics></math></td>
<td id="S4.T1.4.1.4.5" class="ltx_td ltx_align_center" style="padding:-0.25pt 3.0pt;">4.1</td>
