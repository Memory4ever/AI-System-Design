<td id="A3.T9.2.3.3" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;">8</td>
<td id="A3.T9.2.3.4" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;">4</td>
<td id="A3.T9.2.3.5" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;">16.8</td></tr>
<tr id="A3.T9.2.4" class="ltx_tr">
<td id="A3.T9.2.4.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding-left:8.0pt;padding-right:8.0pt;">MMaDA 8B MixCoT</td>
