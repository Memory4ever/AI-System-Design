<td id="A3.T7.10.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" rowspan="3"><span id="A3.T7.10.1.1.3.1" class="ltx_text">No Attack</span></td>
<td id="A3.T7.10.1.1.4" class="ltx_td ltx_align_center ltx_border_tt" colspan="7"><span id="A3.T7.10.1.1.4.1" class="ltx_text ltx_font_bold">Requires intervention in the denoising process</span></td>
<td id="A3.T7.10.1.1.5" class="ltx_td ltx_align_center ltx_border_tt"><span id="A3.T7.10.1.1.5.1" class="ltx_text ltx_font_bold">No intervention</span></td></tr>
<tr id="A3.T7.10.1.2" class="ltx_tr">
<td id="A3.T7.10.1.2.1" class="ltx_td ltx_align_center ltx_border_t" colspan="5">Anchoring (<math id="A3.T7.m1" class="ltx_Math" alttext="t_{\text{inter}}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mtext>inter</mtext></msub><annotation encoding="application/x-tex">t_{\text{inter}}</annotation></semantics></math>)</td>
<td id="A3.T7.10.1.2.2" class="ltx_td ltx_align_center ltx_border_t" rowspan="2"><span id="A3.T7.10.1.2.2.1" class="ltx_text">PAD</span></td>
<td id="A3.T7.10.1.2.3" class="ltx_td ltx_align_center ltx_border_t" rowspan="2"><span id="A3.T7.10.1.2.3.1" class="ltx_text">DiJA</span></td>
<td id="A3.T7.10.1.2.4" class="ltx_td ltx_align_center ltx_border_t" rowspan="2"><span id="A3.T7.10.1.2.4.1" class="ltx_text">First-Step GCG</span></td></tr>
<tr id="A3.T7.10.1.3" class="ltx_tr">
<td id="A3.T7.10.1.3.1" class="ltx_td ltx_align_center ltx_border_t">1</td>
<td id="A3.T7.10.1.3.2" class="ltx_td ltx_align_center ltx_border_t">4</td>
