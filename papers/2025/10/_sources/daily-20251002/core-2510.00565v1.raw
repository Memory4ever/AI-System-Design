<td id="A3.T8.10.1.20.2" class="ltx_td ltx_align_center ltx_border_bb">(<span id="A3.T8.10.1.20.2.1" class="ltx_text" style="--ltx-bg-color:#D9FFFF;">42 %</span>, <span id="A3.T8.10.1.20.2.2" class="ltx_text" style="--ltx-bg-color:#FFE6CC;">4 %</span>  <span id="A3.T8.10.1.20.2.3" class="ltx_text" style="--ltx-bg-color:#D9FFD9;">26 %</span>)</td>
<td id="A3.T8.10.1.20.3" class="ltx_td ltx_align_center ltx_border_bb">(<span id="A3.T8.10.1.20.3.1" class="ltx_text" style="--ltx-bg-color:#D9FFFF;">42 %</span>, <span id="A3.T8.10.1.20.3.2" class="ltx_text" style="--ltx-bg-color:#FFE6CC;">52 %</span>  <span id="A3.T8.10.1.20.3.3" class="ltx_text" style="--ltx-bg-color:#D9FFD9;">74 %</span>)</td>
