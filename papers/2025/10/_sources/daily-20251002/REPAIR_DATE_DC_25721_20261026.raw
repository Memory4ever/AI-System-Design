name":"Datta, Akul","nameType":"Personal","givenName":"Akul","familyName":"Datta","affiliation":[],"nameIdentifiers":[]},{"name":"Mahapatra, Chirag","nameType":"Personal","givenName":"Chirag","familyName":"Mahapatra","affiliation":[],"nameIdentifiers":[]},{"name":"Barton, Dominic","nameType":"Personal","givenName":"Dominic","familyName":"Barton","affiliation":[],"nameIdentifiers":[]},{"name":"Sunstein, Cass R.","nameType":"Personal","givenName":"Cass R.","familyName":"Sunstein","affiliation":[],"nameIdentifiers":[]},{"name":"Topol, Eric","nameType":"Personal","givenName":"Eric","familyName":"Topol","affiliation":[],"nameIdentifiers":[]},{"name":"Foody, Brendan","nameType":"Personal","givenName":"Brendan","familyName":"Foody","affiliation":[],"nameIdentifiers":[]},{"name":"Nitski, Osvald","nameType":"Personal","givenName":"Osvald","familyName":"Nitski","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The AI Productivity Index (APEX)"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"General Economics (econ.GN)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Human-Computer Interaction (cs.HC)","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Economics and business","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-30T03:26:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-01T00:28:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-02T05:47:47Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-03T00:26:54Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-12-01T18:46:32Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-12-02T02:50:16Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-12-05T15:48:58Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2025-12-08T01:43:41Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-12-08T02:35:27Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2025-12-09T02:06:31Z","dateType":"Updated","dateInformation":"v5"},{"date":"2025-12-16T22:25:15Z","dateType":"Submitted","dateInformation":"v6"},{"date":"2025-12-18T01:10:24Z","dateType":"Updated","dateInformation":"v6"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"6","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"We present an extended version of the AI Productivity Index (APEX-v1-extended), a benchmark for assessing whether frontier models are capable of performing economically valuable tasks in four jobs: investment banking associate, management consultant, big law associate, and primary care physician (MD). This technical report details the extensions to APEX-v1, including an increase in the held-out evaluation set from n = 50 to n = 100 cases per job (n = 400 total) and updates to the grading methodology. We present a new leaderboard, where GPT5 (Thinking = High) remains the top performing model with a score of 67.0%. APEX-v1-extended shows that frontier models still have substantial limitations when performing typical professional tasks. To support further research, we are open sourcing n = 25 non-benchmark example cases per role (n = 100 total) along with our evaluation harness.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.25721","contentUrl":null,"metadataVersion":5,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-01T02:19:19.000Z","registered":"2025-10-01T02:19:20.000Z","published":"2025","updated":"2025-12-18T03:06:40.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.25721","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}},"included":[{"id":"arxiv.content","type":"clients","attributes":{"name":"arXiv","symbol":"ARXIV.CONTENT","year":2021,"alternateName":null,"description":null,"language":[],"clientType":"repository","domains":"*","re3data":null,"opendoar":null,"issn":{},"url":null,"created":"2021-03-29T15:47:29.000Z","updated":"2024-11-05T11:34:27.000Z","isActive":true},"relationships":{"provider":{"data":{"id":"arxiv","type":"providers"}},"prefixes":{"data":[{"id":"10.48550","type":"prefixes"}]}}}]}