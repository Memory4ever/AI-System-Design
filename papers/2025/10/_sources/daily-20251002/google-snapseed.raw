<picture class="media__image media__image">
    
    
        <source media="(min-width: 768px)" srcset="https://storage.googleapis.com/gweb-research2023-media/images/Snapseed-6-Latency.width-1250.png" alt="Table showing model inference latency when running Interactive Segmenter: Edge on-device." />
    
    <img src="https://storage.googleapis.com/gweb-research2023-media/images/Snapseed-6-Latency.width-1250.png" alt="Table showing model inference latency when running Interactive Segmenter: Edge on-device." loading="lazy" />
    
</picture>
  


          </div>
