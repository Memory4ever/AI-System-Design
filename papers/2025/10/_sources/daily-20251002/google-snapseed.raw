          caption
          --center
        ">
          <p data-block-key="73ip4">Interactive Segmenter neural network architecture.</p>
        </div>
      
    </div>
  </div>



    </div>
</section>

                    
                    
    


<section class="component-as-block --no-padding-top --theme-light --dbl-padding">
    <div class="glue-page">
        
  


  

  <div class="
