<td id="S5.T1.3.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T1.3.1.2.1" class="ltx_text ltx_font_bold">HPSv3</span></td>
<td id="S5.T1.3.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T1.3.1.3.1" class="ltx_text ltx_font_bold">ImageReward</span></td></tr>
<tr id="S5.T1.3.2" class="ltx_tr">
