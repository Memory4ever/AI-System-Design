<td id="S5.T2.3.1.7" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:4.5pt;padding-right:4.5pt;"><span id="S5.T2.3.1.7.1" class="ltx_text ltx_font_bold">Chemistry</span></td>
<td id="S5.T2.3.1.8" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:4.5pt;padding-right:4.5pt;"><span id="S5.T2.3.1.8.1" class="ltx_text ltx_font_bold">Overall</span></td></tr>
<tr id="S5.T2.3.2" class="ltx_tr">
<th id="S5.T2.3.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:4.5pt;padding-right:4.5pt;">Flux</th>
<td id="S5.T2.3.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.5pt;padding-right:4.5pt;">0.75</td>
<td id="S5.T2.3.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.5pt;padding-right:4.5pt;">0.70</td>
<td id="S5.T2.3.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.5pt;padding-right:4.5pt;">0.76</td>
<td id="S5.T2.3.2.5" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#B283B9;padding-left:4.5pt;padding-right:4.5pt;"><span id="S5.T2.3.2.5.1" class="ltx_text" style="--ltx-bg-color:#B283B9;">0.69</span></td>
<td id="S5.T2.3.2.6" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#B283B9;padding-left:4.5pt;padding-right:4.5pt;"><span id="S5.T2.3.2.6.1" class="ltx_text" style="--ltx-bg-color:#B283B9;">0.71</span></td>
<td id="S5.T2.3.2.7" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#B283B9;padding-left:4.5pt;padding-right:4.5pt;"><span id="S5.T2.3.2.7.1" class="ltx_text" style="--ltx-bg-color:#B283B9;">0.68</span></td>
<td id="S5.T2.3.2.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.5pt;padding-right:4.5pt;">0.73</td></tr>
<tr id="S5.T2.3.3" class="ltx_tr">
<th id="S5.T2.3.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:4.5pt;padding-right:4.5pt;">Dance-GRPO</th>
<td id="S5.T2.3.3.2" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#B283B9;padding-left:4.5pt;padding-right:4.5pt;"><span id="S5.T2.3.3.2.1" class="ltx_text" style="--ltx-bg-color:#B283B9;">0.82</span></td>
<td id="S5.T2.3.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.5pt;padding-right:4.5pt;">0.75</td>
<td id="S5.T2.3.3.4" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#B283B9;padding-left:4.5pt;padding-right:4.5pt;"><span id="S5.T2.3.3.4.1" class="ltx_text" style="--ltx-bg-color:#B283B9;">0.78</span></td>
