<td id="S5.T1.3.3.3" class="ltx_td ltx_align_center ltx_border_t">1.141</td></tr>
<tr id="S5.T1.3.4" class="ltx_tr">
<th id="S5.T1.3.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Chunk-GRPO w/o ws</th>
<td id="S5.T1.3.4.2" class="ltx_td ltx_align_center ltx_border_t">15.236</td>
