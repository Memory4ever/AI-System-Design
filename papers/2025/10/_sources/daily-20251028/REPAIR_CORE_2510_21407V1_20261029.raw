</span></td></tr>
<tr id="S2.T1.5.13" class="ltx_tr">
<td id="S2.T1.5.13.1" class="ltx_td ltx_align_left"><math id="S2.T1.m2" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math></td>
<td id="S2.T1.5.13.2" class="ltx_td ltx_align_left">
<span id="S2.T1.5.13.2.1" class="ltx_inline-block ltx_align_top">
<span id="S2.T1.5.13.2.1.1" class="ltx_p">Number of offspring generated per generation.</span>
</span></td></tr>
<tr id="S2.T1.5.14" class="ltx_tr">
<td id="S2.T1.5.14.1" class="ltx_td ltx_align_left"><math id="S2.T1.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math></td>
<td id="S2.T1.5.14.2" class="ltx_td ltx_align_left">
<span id="S2.T1.5.14.2.1" class="ltx_inline-block ltx_align_top">
<span id="S2.T1.5.14.2.1.1" class="ltx_p">Number of elite individuals preserved per PPA metric.</span>
</span></td></tr>
<tr id="S2.T1.5.15" class="ltx_tr">
<td id="S2.T1.5.15.1" class="ltx_td ltx_align_left"><math id="S2.T1.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math></td>
<td id="S2.T1.5.15.2" class="ltx_td ltx_align_left">
<span id="S2.T1.5.15.2.1" class="ltx_inline-block ltx_align_top">
<span id="S2.T1.5.15.2.1.1" class="ltx_p">Maximum number of generations for termination.</span>
</span></td></tr>
<tr id="S2.T1.5.16" class="ltx_tr">
<td id="S2.T1.5.16.1" class="ltx_td ltx_align_left"><math id="S2.T1.m5" class="ltx_Math" alttext="\alpha,\beta,\gamma" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>,</mo><mi>β</mi><mo>,</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">\alpha,\beta,\gamma</annotation></semantics></math></td>
<td id="S2.T1.5.16.2" class="ltx_td ltx_align_left">
<span id="S2.T1.5.16.2.1" class="ltx_inline-block ltx_align_top">
<span id="S2.T1.5.16.2.1.1" class="ltx_p">Weights for the PPA objectives in the fitness function.</span>
</span></td></tr>
<tr id="S2.T1.5.17" class="ltx_tr">
<td id="S2.T1.5.17.1" class="ltx_td ltx_align_center ltx_border_t" colspan="2"><span id="S2.T1.5.17.1.1" class="ltx_text ltx_font_bold">Adaptive Strategy Selection</span></td></tr>
<tr id="S2.T1.5.18" class="ltx_tr">
<td id="S2.T1.5.18.1" class="ltx_td ltx_align_left ltx_border_t"><math id="S2.T1.m6" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math></td>
<td id="S2.T1.5.18.2" class="ltx_td ltx_align_left ltx_border_t">
<span id="S2.T1.5.18.2.1" class="ltx_inline-block ltx_align_top">
<span id="S2.T1.5.18.2.1.1" class="ltx_p">Reward for a given prompt strategy.</span>
</span></td></tr>
<tr id="S2.T1.5.19" class="ltx_tr">
<td id="S2.T1.5.19.1" class="ltx_td ltx_align_left"><math id="S2.T1.m7" class="ltx_Math" alttext="Q(i)" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Q(i)</annotation></semantics></math></td>
<td id="S2.T1.5.19.2" class="ltx_td ltx_align_left">
<span id="S2.T1.5.19.2.1" class="ltx_inline-block ltx_align_top">
<span id="S2.T1.5.19.2.1.1" class="ltx_p">Average reward (action-value) for strategy <math id="S2.T1.m8" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.</span>
</span></td></tr>
<tr id="S2.T1.5.20" class="ltx_tr">
<td id="S2.T1.5.20.1" class="ltx_td ltx_align_left"><math id="S2.T1.m9" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math></td>
<td id="S2.T1.5.20.2" class="ltx_td ltx_align_left">
<span id="S2.T1.5.20.2.1" class="ltx_inline-block ltx_align_top">
<span id="S2.T1.5.20.2.1.1" class="ltx_p">Exploration parameter for the UCB algorithm.</span>
</span></td></tr>
<tr id="S2.T1.5.21" class="ltx_tr">
<td id="S2.T1.5.21.1" class="ltx_td ltx_align_left"><math id="S2.T1.m10" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math></td>
<td id="S2.T1.5.21.2" class="ltx_td ltx_align_left">
<span id="S2.T1.5.21.2.1" class="ltx_inline-block ltx_align_top">
<span id="S2.T1.5.21.2.1.1" class="ltx_p">Softmax selection temperature.</span>
</span></td></tr>
<tr id="S2.T1.5.22" class="ltx_tr">
<td id="S2.T1.5.22.1" class="ltx_td ltx_align_left"><math id="S2.T1.m11" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math></td>
<td id="S2.T1.5.22.2" class="ltx_td ltx_align_left">
<span id="S2.T1.5.22.2.1" class="ltx_inline-block ltx_align_top">
<span id="S2.T1.5.22.2.1.1" class="ltx_p">Total number of prompt strategy selections.</span>
</span></td></tr>
