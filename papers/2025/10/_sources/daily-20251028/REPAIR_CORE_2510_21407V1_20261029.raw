<tr id="S2.T1.5.12" class="ltx_tr">
<td id="S2.T1.5.12.1" class="ltx_td ltx_align_left ltx_border_t"><math id="S2.T1.m1" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math></td>
