ke-color:#000000;" d="M 139.16389335483473 -123.27697508988645 L 201.77583336846635 -99.62640099626401" fill="none" stroke="#000000" stroke-dasharray="5"></path><path style="--ltx-stroke-color:#000000;" d="M 201.75942811164947 -99.62640099626401 L 201.77583336846635 -99.62640099626401" fill="none" stroke="#000000" stroke-dasharray="5"></path></g></svg></span></td>
