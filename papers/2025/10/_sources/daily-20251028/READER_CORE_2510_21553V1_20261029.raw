x-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="11.01"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.EGx2.m2.pic1.m9" class="ltx_Math" alttext="\textstyle{E}" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">\textstyle{E}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 97.19006200705687 -40.52505925992588 L 97.184530247358 -40.50248883581102" fill="none" stroke="#000000" stroke-dasharray="5"></path><g transform="translate(83.35,0) translate(0,-30.75)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 4.06 -6.25" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 7.25 -1.73" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 97.19006200705687 -40.52505925992588 L 83.35306186868686 -30.74632272262436" fill="none" stroke="#000000" stroke-dasharray="5"></path><path style="--ltx-stroke-color:#000000;" d="M 83.35869919631892 -30.768893146739224 L 83.35306186868686 -30.74632272262436" fill="none" stroke="#000000" stroke-dasharray="5"></path><g transform="translate(23.58,0) translate(0,-69.42) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.33em;--ltx-fo-height:0.5em;--ltx-fo-depth:0.5em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 6.92)" width="18.45"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.EGx2.m2.pic1.1" class="ltx_text ltx_markedasmath ltx_inline-block" style="width:13.3pt;position:relative; bottom:-2.5pt;">
