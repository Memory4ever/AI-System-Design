><g transform="translate(-20.32,0) translate(0,-86.71) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:2.34em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="32.33"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.Ex64.m1.pic1.m8" class="ltx_Math" alttext="\textstyle{A-B\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>−</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">\textstyle{A-B\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 14.715283115292479 -76.56470594753182 L 14.715283115292479 -76.55258674880224" fill="none" stroke="#000000"></path><g transform="translate(53.53,0) translate(0,-49.8)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -7.27 -1.65" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -4.13 -6.21" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 14.715283115292479 -76.56470594753182 L 53.524610097929205 -49.795380631010445" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 53.524610097929205 -49.80910446232444 L 53.524610097929205 -49.795380631010445" fill="none" stroke="#000000"></path><g transform="translate(105.41,0) translate(0,-86.71) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:2.67em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="36.94"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.Ex64.m1.pic1.m10" class="ltx_Math" alttext="\textstyle{A\cap B\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>∩</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">\textstyle{A\cap B\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 112.79490275453594 -76.56470594753182 L 112.74264662760957 -76.51274541081837" fill="none" stroke="#000000"></path><g transform="translate(72.21,0) translate(0,-49.56)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 4.23 -6.14" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 7.29 -1.53" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 112.79490275453594 -76.56470594753182 L 72.20458139831534 -49.5582328259046" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 72.23245133267608 -49.63669091384738 L 72.20458139831534 -49.5582328259046" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 143.38483714094065 -76.56470594753182 L 143.38483714094065 -76.5628057247345" fill="none" stroke="#000000"></path><g transform="translate(183.87,0) translate(0,-49.8)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -7.3 -1.51" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -4.25 -6.12" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 143.38483714094065 -76.56470594753182 L 183.8661701629415 -49.79926553095164" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 183.8661701629415 -49.800236755936936 L 183.8661701629415 -49.79926553095164" fill="none" stroke="#000000"></path><g transform="translate(236.57,0) translate(0,-86.71) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:2.34em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="32.33"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.Ex64.m1.pic1.m12" class="ltx_Math" alttext="\textstyle{B-A\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>−</mo><mi>A</mi></mrow><annotation encoding="application/x-tex">\textstyle{B-A\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 242.088131015852 -76.56470594753182 L 242.03080762813278 -76.54114318484503" fill="none" stroke="#000000"></path><g transform="translate(203.36,0) translate(0,-50.03)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 4.14 -6.19" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 7.27 -1.63" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 242.088131015852 -76.56470594753182 L 203.3580855510369 -50.027693424776444" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 203.3969556640355 -50.07046955130284 L 203.3580855510369 -50.027693424776444" fill="none" stroke="#000000"></path></g></svg></span></td>
