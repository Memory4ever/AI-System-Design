<th id="S7.T4.2.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">(rel-only)</th>
<td id="S7.T4.2.1.6.2" class="ltx_td ltx_align_center ltx_border_bb">0.515</td>
<td id="S7.T4.2.1.6.3" class="ltx_td ltx_align_center ltx_border_bb">0.599</td>
<td id="S7.T4.2.1.6.4" class="ltx_td ltx_align_center ltx_border_bb">0.638</td>
<td id="S7.T4.2.1.6.5" class="ltx_td ltx_align_center ltx_border_bb">0.572</td>
<td id="S7.T4.2.1.6.6" class="ltx_td ltx_align_center ltx_border_bb">0.606</td>
