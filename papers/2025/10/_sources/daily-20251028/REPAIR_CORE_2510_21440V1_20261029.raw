<td id="S7.T4.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S7.T4.2.1.2.4.1" class="ltx_text ltx_font_bold">0.661</span></td>
<td id="S7.T4.2.1.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S7.T4.2.1.2.5.1" class="ltx_text ltx_font_bold">0.593</span></td>
