<td id="S7.T4.2.1.3.5" class="ltx_td ltx_align_center">0.567</td>
<td id="S7.T4.2.1.3.6" class="ltx_td ltx_align_center">0.607</td>
<td id="S7.T4.2.1.3.7" class="ltx_td ltx_nopad_r ltx_align_center">0.553</td></tr>
<tr id="S7.T4.2.1.4" class="ltx_tr">
<th id="S7.T4.2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">(binary)</th>
<td id="S7.T4.2.1.4.2" class="ltx_td ltx_align_center">0.473</td>
<td id="S7.T4.2.1.4.3" class="ltx_td ltx_align_center">0.542</td>
<td id="S7.T4.2.1.4.4" class="ltx_td ltx_align_center">0.589</td>
<td id="S7.T4.2.1.4.5" class="ltx_td ltx_align_center">0.554</td>
<td id="S7.T4.2.1.4.6" class="ltx_td ltx_align_center">0.584</td>
<td id="S7.T4.2.1.4.7" class="ltx_td ltx_nopad_r ltx_align_center">0.498</td></tr>
<tr id="S7.T4.2.1.5" class="ltx_tr">
<th id="S7.T4.2.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">UDCG</th>
<td id="S7.T4.2.1.5.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S7.T4.2.1.5.2.1" class="ltx_text ltx_font_bold">0.536</span></td>
<td id="S7.T4.2.1.5.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S7.T4.2.1.5.3.1" class="ltx_text ltx_font_bold">0.611</span></td>
<td id="S7.T4.2.1.5.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S7.T4.2.1.5.4.1" class="ltx_text ltx_font_bold">0.665</span></td>
<td id="S7.T4.2.1.5.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S7.T4.2.1.5.5.1" class="ltx_text ltx_font_bold">0.587</span></td>
<td id="S7.T4.2.1.5.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S7.T4.2.1.5.6.1" class="ltx_text ltx_font_bold">0.629</span></td>
<td id="S7.T4.2.1.5.7" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t"><span id="S7.T4.2.1.5.7.1" class="ltx_text ltx_font_bold">0.605</span></td></tr>
