<td id="S3.T1.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t">75.56</td>
<td id="S3.T1.2.1.2.4" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">5.55</td></tr>
<tr id="S3.T1.2.1.3" class="ltx_tr">
<th id="S3.T1.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Llama 8B</th>
<td id="S3.T1.2.1.3.2" class="ltx_td ltx_align_center">89.44</td>
