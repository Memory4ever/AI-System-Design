<td id="S7.T4.2.1.2.7" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t"><span id="S7.T4.2.1.2.7.1" class="ltx_text ltx_font_bold">0.601</span></td></tr>
<tr id="S7.T4.2.1.3" class="ltx_tr">
