<td id="A5.T2.5.3.6" class="ltx_td ltx_align_center">✓</td>
<td id="A5.T2.5.3.7" class="ltx_td"></td></tr>
<tr id="A5.T2.5.4" class="ltx_tr">
<td id="A5.T2.5.4.1" class="ltx_td ltx_align_center"><math id="A5.T2.m4" class="ltx_Math" alttext="r_{bounce}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></msub><annotation encoding="application/x-tex">r_{bounce}</annotation></semantics></math></td>
