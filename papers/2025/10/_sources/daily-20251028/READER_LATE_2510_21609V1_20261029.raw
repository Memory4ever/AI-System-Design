<th id="A5.T2.5.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><em id="A5.T2.5.1.6.1" class="ltx_emph ltx_font_italic">Bounce</em></th>
<th id="A5.T2.5.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><em id="A5.T2.5.1.7.1" class="ltx_emph ltx_font_italic">Baoding</em></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A5.T2.5.2" class="ltx_tr">
<td id="A5.T2.5.2.1" class="ltx_td ltx_align_center ltx_border_t"><math id="A5.T2.m1" class="ltx_Math" alttext="r_{dist}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">r_{dist}</annotation></semantics></math></td>
<td id="A5.T2.5.2.2" class="ltx_td ltx_align_center ltx_border_t">distance to target</td>
<td id="A5.T2.5.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="A5.T2.m2" class="ltx_Math" alttext="1-\tanh{d_{target}/0.1}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mi>tanh</mi><mo lspace="0.167em">⁡</mo><msub><mi>d</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow><mo>/</mo><mn>0.1</mn></mrow></mrow><annotation encoding="application/x-tex">1-\tanh{d_{target}/0.1}</annotation></semantics></math></td>
<td id="A5.T2.5.2.4" class="ltx_td ltx_align_center ltx_border_t">1, 0.1</td>
<td id="A5.T2.5.2.5" class="ltx_td ltx_align_center ltx_border_t">✓</td>
<td id="A5.T2.5.2.6" class="ltx_td ltx_border_t"></td>
<td id="A5.T2.5.2.7" class="ltx_td ltx_align_center ltx_border_t">✓✓</td></tr>
<tr id="A5.T2.5.3" class="ltx_tr">
<td id="A5.T2.5.3.1" class="ltx_td ltx_align_center"><math id="A5.T2.m3" class="ltx_Math" alttext="r_{air}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">r_{air}</annotation></semantics></math></td>
<td id="A5.T2.5.3.2" class="ltx_td ltx_align_center">time without contact</td>
