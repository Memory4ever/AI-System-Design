<div id="A7.T4.5" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:176.9pt;vertical-align:-86.8pt;"><span class="ltx_transformed_inner" style="transform:translate(-86.9pt,44.5pt) scale(0.665072898101147,0.665072898101147) ;">
<table id="A7.T4.5.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="A7.T4.5.1.1" class="ltx_tr">
<th id="A7.T4.5.1.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">Environment</th>
<th id="A7.T4.5.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">Experiment</th>
<th id="A7.T4.5.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="A7.T4.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math></th>
<th id="A7.T4.5.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="A7.T4.m2" class="ltx_Math" alttext="mb" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><annotation encoding="application/x-tex">mb</annotation></semantics></math></th>
<th id="A7.T4.5.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="A7.T4.m3" class="ltx_Math" alttext="le" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><annotation encoding="application/x-tex">le</annotation></semantics></math></th>
