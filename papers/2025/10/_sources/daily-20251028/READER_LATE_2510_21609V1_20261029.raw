<td id="A5.T2.5.6.4" class="ltx_td ltx_align_center ltx_border_b">10</td>
<td id="A5.T2.5.6.5" class="ltx_td ltx_border_b"></td>
<td id="A5.T2.5.6.6" class="ltx_td ltx_align_center ltx_border_b">✓</td>
