<td id="A5.T2.5.6.1" class="ltx_td ltx_align_center ltx_border_b"><math id="A5.T2.m7" class="ltx_Math" alttext="r_{fall}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">r_{fall}</annotation></semantics></math></td>
