<td id="A5.T2.5.5.2" class="ltx_td ltx_align_center">successful rotation</td>
<td id="A5.T2.5.5.3" class="ltx_td ltx_align_center">+1 if <math id="A5.T2.m6" class="ltx_Math" alttext="d_{1\&amp;2}&lt;1.0" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">&amp;</mo><mn>2</mn></mrow></msub><mo>&lt;</mo><mn>1.0</mn></mrow><annotation encoding="application/x-tex">d_{1\&amp;2}&lt;1.0</annotation></semantics></math>cm</td>
