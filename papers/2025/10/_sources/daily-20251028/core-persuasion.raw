<figure id="A2.T6" class="ltx_table">
<table id="A2.T6.2" class="ltx_tabular ltx_align_middle">
<tr id="A2.T6.2.1" class="ltx_tr">
<td id="A2.T6.2.1.1" class="ltx_td ltx_align_center ltx_align_top ltx_border_tt"><span id="A2.T6.2.1.1.1" class="ltx_text ltx_font_bold">Persuasion Contexts</span></td>
<td id="A2.T6.2.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="A2.T6.2.1.2.1" class="ltx_text ltx_font_bold">Tags</span></td></tr>
<tr id="A2.T6.2.2" class="ltx_tr">
<td id="A2.T6.2.2.1" class="ltx_td ltx_align_center ltx_align_top ltx_border_bb ltx_border_t">Subjective Persuasion</td>
<td id="A2.T6.2.2.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_bb ltx_border_t">
<span id="A2.T6.2.2.2.1" class="ltx_inline-block ltx_align_top">
