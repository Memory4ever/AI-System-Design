<span id="A3.T7.2.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:367.3pt;height:85.2pt;vertical-align:-40.1pt;"><span class="ltx_transformed_inner" style="transform:translate(0.0pt,0.0pt) scale(1,1) ;">
<span id="A3.T7.2.1.1.1.1" class="ltx_p"><span id="A3.T7.2.1.1.1.1.1" class="ltx_text">

