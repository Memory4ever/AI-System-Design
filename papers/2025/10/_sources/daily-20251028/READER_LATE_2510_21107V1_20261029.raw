<th id="A1.SSx2.p1.1.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column"><span id="A1.SSx2.p1.1.1.2.1" class="ltx_text ltx_font_bold">Full Form</span></th></tr>
