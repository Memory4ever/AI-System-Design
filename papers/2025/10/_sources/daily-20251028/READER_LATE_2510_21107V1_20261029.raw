<td id="A5.T3.1.1.2.4" class="ltx_td ltx_align_center ltx_border_t">29.8</td>
<td id="A5.T3.1.1.2.5" class="ltx_td ltx_align_center ltx_border_t">6.3</td>
<td id="A5.T3.1.1.2.6" class="ltx_td ltx_align_center ltx_border_t">1.5</td></tr>
<tr id="A5.T3.1.1.3" class="ltx_tr">
