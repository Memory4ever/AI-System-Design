<td id="S4.T1.6.4.2" class="ltx_td ltx_align_center"><span id="S4.T1.6.4.2.1" class="ltx_text" style="font-size:90%;">0.381 <math id="S4.T1.m4" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.07</span></td>
<td id="S4.T1.6.4.3" class="ltx_td ltx_align_center"><span id="S4.T1.6.4.3.1" class="ltx_text" style="font-size:90%;">10.246 <math id="S4.T1.m5" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.35</span></td>
<td id="S4.T1.6.4.4" class="ltx_td ltx_align_center"><span id="S4.T1.6.4.4.1" class="ltx_text" style="font-size:90%;">4.213 <math id="S4.T1.m6" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.59</span></td></tr>
