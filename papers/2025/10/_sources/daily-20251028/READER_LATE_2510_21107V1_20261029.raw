<th id="A6.T4.1.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t"><math id="A6.T4.m1" class="ltx_Math" alttext="n_{\text{particles}}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mtext>particles</mtext></msub><annotation encoding="application/x-tex">n_{\text{particles}}</annotation></semantics></math></th>
<td id="A6.T4.1.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">100</td>
<td id="A6.T4.1.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">100</td>
<td id="A6.T4.1.2.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">100</td></tr>
<tr id="A6.T4.1.3" class="ltx_tr">
<th id="A6.T4.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r"><math id="A6.T4.m2" class="ltx_Math" alttext="d_{\text{state}}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mtext>state</mtext></msub><annotation encoding="application/x-tex">d_{\text{state}}</annotation></semantics></math></th>
<td id="A6.T4.1.3.2" class="ltx_td ltx_align_center ltx_border_r">10</td>
<td id="A6.T4.1.3.3" class="ltx_td ltx_align_center ltx_border_r">20</td>
