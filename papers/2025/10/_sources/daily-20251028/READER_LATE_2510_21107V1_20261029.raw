<td id="S4.T1.6.3.2" class="ltx_td ltx_align_center"><span id="S4.T1.6.3.2.1" class="ltx_text" style="font-size:90%;">0.347 <math id="S4.T1.m1" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.03</span></td>
<td id="S4.T1.6.3.3" class="ltx_td ltx_align_center"><span id="S4.T1.6.3.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">9.063 <math id="S4.T1.m2" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.51</span></td>
<td id="S4.T1.6.3.4" class="ltx_td ltx_align_center"><span id="S4.T1.6.3.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">3.665 <math id="S4.T1.m3" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.31</span></td></tr>
