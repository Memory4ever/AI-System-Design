</span></span></td>
<td id="S5.T1.3.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.5pt 5.0pt;" colspan="4"><span id="S5.T1.3.1.3.1" class="ltx_text ltx_font_bold">MAPEs</span></td></tr>
<tr id="S5.T1.3.2" class="ltx_tr">
<td id="S5.T1.3.2.1" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.5pt 5.0pt;">GPU</td>
<td id="S5.T1.3.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.5pt 5.0pt;">1 CPU</td>
<td id="S5.T1.3.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.5pt 5.0pt;">2 CPUs</td>
<td id="S5.T1.3.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.5pt 5.0pt;">3 CPUs</td></tr>
<tr id="S5.T1.3.3" class="ltx_tr">
<td id="S5.T1.3.3.1" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.5pt 5.0pt;" rowspan="2"><span id="S5.T1.3.3.1.1" class="ltx_text">Pixel 4</span></td>
<td id="S5.T1.3.3.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.5pt 5.0pt;">Linear</td>
<td id="S5.T1.3.3.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.5pt 5.0pt;">4.4%</td>
<td id="S5.T1.3.3.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.5pt 5.0pt;">11.5%</td>
<td id="S5.T1.3.3.5" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.5pt 5.0pt;">7.1%</td>
