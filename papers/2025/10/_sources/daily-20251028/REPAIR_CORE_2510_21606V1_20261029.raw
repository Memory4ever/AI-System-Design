<td id="A1.T5.6.1.11.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="A1.T5.6.1.11.2.1" class="ltx_text ltx_font_smallcaps">Modest-Align</span> (ours)</td>
<td id="A1.T5.6.1.11.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="A1.T5.6.1.11.3.1" class="ltx_text ltx_font_bold">65.72</span></td>
<td id="A1.T5.6.1.11.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="A1.T5.6.1.11.4.1" class="ltx_text ltx_font_bold">87.82</span></td>
<td id="A1.T5.6.1.11.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="A1.T5.6.1.11.5.1" class="ltx_text ltx_font_bold">92.50</span></td>
<td id="A1.T5.6.1.11.6" class="ltx_td ltx_align_center ltx_border_bb"><span id="A1.T5.6.1.11.6.1" class="ltx_text ltx_font_bold">81.60</span></td>
<td id="A1.T5.6.1.11.7" class="ltx_td ltx_align_center ltx_border_bb">96.00</td>
<td id="A1.T5.6.1.11.8" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="A1.T5.6.1.11.8.1" class="ltx_text ltx_font_bold">98.30</span></td>
<td id="A1.T5.6.1.11.9" class="ltx_td ltx_align_center ltx_border_bb"><span id="A1.T5.6.1.11.9.1" class="ltx_text ltx_font_bold">45.86</span></td>
<td id="A1.T5.6.1.11.10" class="ltx_td ltx_align_center ltx_border_bb"><span id="A1.T5.6.1.11.10.1" class="ltx_text ltx_font_bold">73.73</span></td>
<td id="A1.T5.6.1.11.11" class="ltx_td ltx_align_center ltx_border_bb"><span id="A1.T5.6.1.11.11.1" class="ltx_text ltx_font_bold">83.16</span></td>
<td id="A1.T5.6.1.11.12" class="ltx_td ltx_align_center ltx_border_bb"><span id="A1.T5.6.1.11.12.1" class="ltx_text ltx_font_bold">62.86</span></td>
<td id="A1.T5.6.1.11.13" class="ltx_td ltx_align_center ltx_border_bb">85.66</td>
<td id="A1.T5.6.1.11.14" class="ltx_td ltx_align_center ltx_border_bb">92.42</td></tr>
</table>
</span></div>
