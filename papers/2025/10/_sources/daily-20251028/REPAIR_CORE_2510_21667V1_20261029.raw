<td id="S4.T2.3.1.5" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T2.3.1.5.1" class="ltx_text ltx_font_bold">TCC<math id="S4.T2.m5" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td></tr>
<tr id="S4.T2.3.2" class="ltx_tr">
<th id="S4.T2.3.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Ground Truth</th>
<td id="S4.T2.3.2.2" class="ltx_td ltx_align_center ltx_border_t">1.0</td>
