<span id="S4.T2.2.1.1.1.1.1.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.25pt;padding-bottom:-0.25pt;">91</span>
<span id="S4.T2.2.1.1.1.1.1.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.25pt;padding-bottom:-0.25pt;">0.93</span></span>
<span id="S4.T2.2.1.1.1.1.1.1.3" class="ltx_tr">
<span id="S4.T2.2.1.1.1.1.1.1.3.1" class="ltx_td ltx_align_left" style="padding-top:-0.25pt;padding-bottom:-0.25pt;">Gemini 2.5-flash</span>
