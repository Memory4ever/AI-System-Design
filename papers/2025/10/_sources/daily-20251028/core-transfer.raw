<td id="S5.T2.2.1.2.5" class="ltx_td ltx_align_right ltx_border_t"><math id="S5.T2.m4" class="ltx_math_unparsed" alttext="-0.06^{***}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>0.06</mn><msup><mrow></mrow><mrow><mo rspace="0em">∗</mo><mo lspace="0em" rspace="0em">∗</mo><mo lspace="0em">∗</mo></mrow></msup></mrow><annotation encoding="application/x-tex">-0.06^{***}</annotation></semantics></math></td></tr>
