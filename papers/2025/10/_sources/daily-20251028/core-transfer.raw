<td id="S5.T2.2.1.1.4" class="ltx_td ltx_align_right ltx_border_tt"><span id="S5.T2.2.1.1.4.1" class="ltx_text ltx_font_bold">Llama 2</span></td>
<td id="S5.T2.2.1.1.5" class="ltx_td ltx_align_right ltx_border_tt"><span id="S5.T2.2.1.1.5.1" class="ltx_text ltx_font_bold">Llama 3.2</span></td></tr>
