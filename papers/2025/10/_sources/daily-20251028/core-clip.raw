<td id="A1.T8.2.1.34.7" class="ltx_td ltx_align_center">52.73</td>
<td id="A1.T8.2.1.34.8" class="ltx_td ltx_align_center">52.61</td>
<td id="A1.T8.2.1.34.9" class="ltx_td ltx_align_center">50.38</td>
<td id="A1.T8.2.1.34.10" class="ltx_td ltx_align_center">52.73</td>
<td id="A1.T8.2.1.34.11" class="ltx_td ltx_align_center ltx_border_r">54.41</td>
<td id="A1.T8.2.1.34.12" class="ltx_td ltx_align_center">+2.39</td></tr>
<tr id="A1.T8.2.1.35" class="ltx_tr">
<td id="A1.T8.2.1.35.1" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_tt" rowspan="2"><span id="A1.T8.2.1.35.1.1" class="ltx_text">Avg.</span></td>
