<td id="A1.T8.2.1.35.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt">0.09</td>
<td id="A1.T8.2.1.35.4" class="ltx_td ltx_align_center ltx_border_tt">0.96</td>
<td id="A1.T8.2.1.35.5" class="ltx_td ltx_align_center ltx_border_tt">6.51</td>
<td id="A1.T8.2.1.35.6" class="ltx_td ltx_align_center ltx_border_tt">10.03</td>
<td id="A1.T8.2.1.35.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt">7.03</td>
<td id="A1.T8.2.1.35.8" class="ltx_td ltx_align_center ltx_border_tt">0.06</td>
