<td id="S3.T1.2.1.3.11" class="ltx_td ltx_align_center ltx_border_t">28.75</td>
<td id="S3.T1.2.1.3.12" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="--ltx-bg-color:#F7FCFF;"><span id="S3.T1.2.1.3.12.1" class="ltx_text ltx_font_bold">59.18</span></td>
<td id="S3.T1.2.1.3.13" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#FDF8F8;"><span id="S3.T1.2.1.3.13.1" class="ltx_text" style="--ltx-fg-color:#800000;">+58.44</span></td></tr>
<tr id="S3.T1.2.1.4" class="ltx_tr">
<td id="S3.T1.2.1.4.1" class="ltx_td ltx_align_center ltx_border_r">Acc.</td>
<td id="S3.T1.2.1.4.2" class="ltx_td ltx_align_center ltx_border_r">85.12</td>
<td id="S3.T1.2.1.4.3" class="ltx_td ltx_align_center">84.90</td>
<td id="S3.T1.2.1.4.4" class="ltx_td ltx_align_center">64.61</td>
<td id="S3.T1.2.1.4.5" class="ltx_td ltx_align_center">70.69</td>
<td id="S3.T1.2.1.4.6" class="ltx_td ltx_align_center ltx_border_r">74.44</td>
<td id="S3.T1.2.1.4.7" class="ltx_td ltx_align_center">81.18</td>
<td id="S3.T1.2.1.4.8" class="ltx_td ltx_align_center">83.52</td>
<td id="S3.T1.2.1.4.9" class="ltx_td ltx_align_center">78.23</td>
