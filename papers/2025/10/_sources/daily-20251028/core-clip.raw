<td id="S3.T1.2.1.4.12" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FDF8F8;">-2.88</td></tr>
<tr id="S3.T1.2.1.5" class="ltx_tr">
<td id="S3.T1.2.1.5.1" class="ltx_td ltx_align_center ltx_border_r" rowspan="2"><span id="S3.T1.2.1.5.1.1" class="ltx_text">CIFAR100</span></td>
<td id="S3.T1.2.1.5.2" class="ltx_td ltx_align_center ltx_border_r">Rob.</td>
<td id="S3.T1.2.1.5.3" class="ltx_td ltx_align_center ltx_border_r">0.26</td>
<td id="S3.T1.2.1.5.4" class="ltx_td ltx_align_center">0.90</td>
<td id="S3.T1.2.1.5.5" class="ltx_td ltx_align_center">18.95</td>
<td id="S3.T1.2.1.5.6" class="ltx_td ltx_align_center">22.52</td>
<td id="S3.T1.2.1.5.7" class="ltx_td ltx_align_center ltx_border_r">11.40</td>
<td id="S3.T1.2.1.5.8" class="ltx_td ltx_align_center">0.67</td>
<td id="S3.T1.2.1.5.9" class="ltx_td ltx_align_center">5.73</td>
<td id="S3.T1.2.1.5.10" class="ltx_td ltx_align_center">3.86</td>
<td id="S3.T1.2.1.5.11" class="ltx_td ltx_align_center">14.31</td>
<td id="S3.T1.2.1.5.12" class="ltx_td ltx_align_center ltx_border_r" style="--ltx-bg-color:#F7FCFF;"><span id="S3.T1.2.1.5.12.1" class="ltx_text ltx_font_bold">32.09</span></td>
<td id="S3.T1.2.1.5.13" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FDF8F8;"><span id="S3.T1.2.1.5.13.1" class="ltx_text" style="--ltx-fg-color:#800000;">+31.83</span></td></tr>
