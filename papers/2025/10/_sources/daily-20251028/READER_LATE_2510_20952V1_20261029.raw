<td id="S5.T1.5.1.2.2" class="ltx_td ltx_align_center ltx_border_t">5.644</td>
<td id="S5.T1.5.1.2.3" class="ltx_td ltx_align_center ltx_border_t">4.992</td></tr>
<tr id="S5.T1.5.1.3" class="ltx_tr">
