<span id="S7.T7.2.1.1.1.7" class="ltx_tr">
<span id="S7.T7.2.1.1.1.7.1" class="ltx_td" style="padding-top:1pt;padding-bottom:1pt;"></span>
<span id="S7.T7.2.1.1.1.7.2" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:1pt;padding-bottom:1pt;">enhanced</span>
<span id="S7.T7.2.1.1.1.7.3" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;"><span id="S7.T7.2.1.1.1.7.3.1" class="ltx_text ltx_font_bold">6.67 (-29.35)</span></span></span>
<span id="S7.T7.2.1.1.1.8" class="ltx_tr">
<span id="S7.T7.2.1.1.1.8.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">Re-attack(both)</span>
<span id="S7.T7.2.1.1.1.8.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">original</span>
<span id="S7.T7.2.1.1.1.8.3" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">28.44</span></span>
<span id="S7.T7.2.1.1.1.9" class="ltx_tr">
<span id="S7.T7.2.1.1.1.9.1" class="ltx_td" style="padding-top:1pt;padding-bottom:1pt;"></span>
<span id="S7.T7.2.1.1.1.9.2" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:1pt;padding-bottom:1pt;">enhanced</span>
<span id="S7.T7.2.1.1.1.9.3" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;"><span id="S7.T7.2.1.1.1.9.3.1" class="ltx_text ltx_font_bold">3.44 (-25.00)</span></span></span>
<span id="S7.T7.2.1.1.1.10" class="ltx_tr">
<span id="S7.T7.2.1.1.1.10.1" class="ltx_td ltx_align_left ltx_border_b ltx_border_r ltx_border_t ltx_rowspan ltx_rowspan_4" style="padding-top:1pt;padding-bottom:1pt;"><span id="S7.T7.2.1.1.1.10.1.1" class="ltx_text">Deepseek-vl2-small</span></span>
<span id="S7.T7.2.1.1.1.10.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">+Opt image <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib34" title="" class="ltx_ref">34</a>]</cite></span>
<span id="S7.T7.2.1.1.1.10.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">original</span>
<span id="S7.T7.2.1.1.1.10.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">51.37</span></span>
<span id="S7.T7.2.1.1.1.11" class="ltx_tr">
<span id="S7.T7.2.1.1.1.11.1" class="ltx_td" style="padding-top:1pt;padding-bottom:1pt;"></span>
<span id="S7.T7.2.1.1.1.11.2" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:1pt;padding-bottom:1pt;">enhanced</span>
<span id="S7.T7.2.1.1.1.11.3" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;"><span id="S7.T7.2.1.1.1.11.3.1" class="ltx_text ltx_font_bold">3.11 (-48.26)</span></span></span>
<span id="S7.T7.2.1.1.1.12" class="ltx_tr">
<span id="S7.T7.2.1.1.1.12.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">Re-attack(both)</span>
<span id="S7.T7.2.1.1.1.12.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">original</span>
<span id="S7.T7.2.1.1.1.12.3" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">35.40</span></span>
