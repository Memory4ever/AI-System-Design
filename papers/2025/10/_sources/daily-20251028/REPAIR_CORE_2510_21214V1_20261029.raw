<span id="S7.T3.2.1.1.1.1.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">Model</span>
<span id="S7.T3.2.1.1.1.1.2" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">Setting</span>
