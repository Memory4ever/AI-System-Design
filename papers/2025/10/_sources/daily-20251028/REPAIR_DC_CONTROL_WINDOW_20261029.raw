{"data":[{"id":"10.6084/m9.figshare.30451772.v1","type":"dois","attributes":{"doi":"10.6084/m9.figshare.30451772.v1","identifiers":[],"creators":[{"givenName":"Paisley","familyName":"Ruddy","name":"Paisley Ruddy","affiliation":[],"nameIdentifiers":[]},{"givenName":"Naomi","familyName":"Lee","name":"Naomi Lee","affiliation":[],"nameIdentifiers":[]},{"givenName":"Mikahlea","familyName":"Compuesto","name":"Mikahlea Compuesto","affiliation":[],"nameIdentifiers":[]},{"givenName":"Jennie","familyName":"Jin","name":"Jennie Jin","affiliation":[],"nameIdentifiers":[]},{"givenName":"Monique","familyName":"Le","name":"Monique Le","affiliation":[],"nameIdentifiers":[]},{"givenName":"Tina","familyName":"Yu","name":"Tina Yu","affiliation":[],"nameIdentifiers":[]},{"givenName":"Leela","familyName":"Sessoms","name":"Leela Sessoms","affiliation":[],"nameIdentifiers":[]},{"givenName":"Rishi","familyName":"Pandhi","name":"Rishi Pandhi","affiliation":[],"nameIdentifiers":[]},{"givenName":"Hongting","familyName":"Liu","name":"Hongting Liu","affiliation":[],"nameIdentifiers":[]},{"givenName":"Snow","familyName":"Pan","name":"Snow Pan","affiliation":[],"nameIdentifiers":[]},{"givenName":"Veronica","familyName":"Gomez-Godinez","name":"Veronica Gomez-Godinez","affiliation":[],"nameIdentifiers":[]},{"givenName":"Linda Z.","familyName":"Shi","name":"Linda Z. Shi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Does DNA damage increase the presence of DNA Rods?"}],"publisher":"figshare","container":{},"publicationYear":2025,"subjects":[{"classificationCode":"310104","schemeUri":"http://www.abs.gov.au/ausstats/abs@.nsf/0/6BB427AB9696C225CA2574180004463E","subject":"Cell neurochemistry","subjectScheme":"ANZSRC Fields of Research"}],"contributors":[],"dates":[{"date":"2025-10-27","dateType":"Created"},{"date":"2026-10-29","dateType":"Updated"},{"date":"2025-10-27","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"Poster","resourceTypeGeneral":"Poster","citeproc":"document","bibtex":"misc","ris":"GEN","resourceType":"Poster"},"relatedIdentifiers":[{"relationType":"IsPreviousVersionOf","relatedIdentifier":"10.6084/m9.figshare.30451772","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":["186490 Bytes"],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This study investigates whether DNA damage increases the presence of inter-telomeric tethers, also known as DNA rods, during anaphase. Using PtK2 cells treated with hydrogen peroxide to induce DNA damage, researchers applied DAPI and γH2AX staining to visualize DNA and damage markers. Confocal imaging and FIJI/ImageJ analysis revealed a higher percentage of tether presence in peroxide-treated cells compared to controls. These preliminary results suggest that DNA rods may play a stabilizing role in the poleward movement of damaged chromatids, potentially compensating for structural anomalies caused by DNA damage. Further research will explore histone involvement and expand sample size for validation."}],"geoLocations":[],"fundingReferences":[],"url":"https://figshare.com/articles/poster/Does_DNA_damage_increase_the_presence_of_DNA_Rods_/30451772/1","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-27T05:06:43Z","registered":"2025-10-27T05:06:44Z","published":null,"updated":"2026-10-29T05:54:59Z"},"relationships":{"client":{"data":{"id":"figshare.ars","type":"clients"}}}}],"meta":{"total":59559,"totalPages":10000,"page":1},"links":{"self":"https://api.datacite.org/dois?query=registered%3A%5B2025-10-26T16%3A00%3A00Z%20TO%202025-10-27T15%3A59%3A59Z%5D\u0026page%5Bsize%5D=1","next":"https://api.datacite.org/dois?page%5Bnumber%5D=2\u0026page%5Bsize%5D=1\u0026query=registered%3A%5B2025-10-26T16%3A00%3A00Z+TO+2025-10-27T15%3A59%3A59Z%5D"}}