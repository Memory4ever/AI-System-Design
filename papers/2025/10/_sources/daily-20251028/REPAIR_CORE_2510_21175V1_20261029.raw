<td id="S6.T3.st1.2.8.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T3.st1.2.8.4.1" class="ltx_text ltx_font_bold">82.79</span></td></tr>
<tr id="S6.T3.st1.2.9" class="ltx_tr">
