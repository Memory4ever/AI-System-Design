<div id="lstnumberx135" class="ltx_listingline"><span id="lstnumberx135.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Be</span><span id="lstnumberx135.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx135.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">mindful</span><span id="lstnumberx135.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx135.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">of</span><span id="lstnumberx135.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx135.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">and</span><span id="lstnumberx135.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx135.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">adapt</span><span id="lstnumberx135.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx135.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">your</span><span id="lstnumberx135.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx135.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">strategy</span><span id="lstnumberx135.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx135.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">to</span><span id="lstnumberx135.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx135.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx135.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx135.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter">limited</span><span id="lstnumberx135.20" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx135.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter">reasoning</span><span id="lstnumberx135.22" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx135.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter">resources</span><span id="lstnumberx135.24" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx135.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter">that</span><span id="lstnumberx135.26" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx135.27" class="ltx_text ltx_lst_identifier ltx_font_typewriter">you</span><span id="lstnumberx135.28" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx135.29" class="ltx_text ltx_lst_identifier ltx_font_typewriter">have</span><span id="lstnumberx135.30" class="ltx_text ltx_font_typewriter">.</span>
