<td id="S4.T2.7.17.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:5.0pt;padding-right:5.0pt;"><math id="S4.T2.m87" class="ltx_math_unparsed" style="--ltx-bg-color:#E6E6E6;" alttext="\bm{47.37\pm_{9.84}}" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-bg-color:#E6E6E6;" class="ltx_mathvariant_bold" mathbackground="#E6E6E6" mathvariant="bold">47.37</mn><mo style="--ltx-bg-color:#E6E6E6;" class="ltx_mathvariant_bold" mathbackground="#E6E6E6" mathvariant="bold">±</mo><msub><mrow></mrow><mn style="--ltx-bg-color:#E6E6E6;" class="ltx_mathvariant_bold" mathbackground="#E6E6E6" mathvariant="bold">9.84</mn></msub></mrow><annotation encoding="application/x-tex">\bm{47.37\pm_{9.84}}</annotation></semantics></math></td>
