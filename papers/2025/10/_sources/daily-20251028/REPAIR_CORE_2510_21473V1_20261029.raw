ect style="--ltx-fo-width:1.9em;--ltx-fo-height:0.55em;--ltx-fo-depth:0em;font-size:8.19pt;" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="21.57"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F3.pic1.m15" class="ltx_Math" alttext="25.0" display="inline" intent=":literal"><semantics><mn mathsize="0.700em">25.0</mn><annotation encoding="application/x-tex">25.0</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -34.21 64.75)"><foreignObject style="--ltx-fo-width:1.9em;--ltx-fo-height:0.55em;--ltx-fo-depth:0em;font-size:8.19pt;" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="21.57"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F3.pic1.m16" class="ltx_Math" alttext="30.0" display="inline" intent=":literal"><semantics><mn mathsize="0.700em">30.0</mn><annotation encoding="application/x-tex">30.0</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -34.21 80.91)"><foreignObject style="--ltx-fo-width:1.9em;--ltx-fo-height:0.55em;--ltx-fo-depth:0em;font-size:8.19pt;" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="21.57"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F3.pic1.m17" class="ltx_Math" alttext="35.0" display="inline" intent=":literal"><semantics><mn mathsize="0.700em">35.0</mn><annotation encoding="application/x-tex">35.0</annotation></semantics></math></span></span></foreignObject></g><clipPath id="pgfcp15"><path d="M -9.13 0 L 100.46 0 L 100.46 90.49 L -9.13 90.49 Z"></path></clipPath><g clip-path="url(#pgfcp15)"><g stroke-width="1.2pt"><path style="fill