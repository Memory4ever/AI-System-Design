<td id="A3.T6.2.1.3.2" class="ltx_td ltx_align_center ltx_border_t"><span id="A3.T6.2.1.3.2.1" class="ltx_text ltx_font_bold">34.2</span></td>
<td id="A3.T6.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t"><span id="A3.T6.2.1.3.3.1" class="ltx_text ltx_font_bold">36.2</span></td>
<td id="A3.T6.2.1.3.4" class="ltx_td ltx_align_center ltx_border_t"><span id="A3.T6.2.1.3.4.1" class="ltx_text ltx_font_bold">32.1</span></td>
<td id="A3.T6.2.1.3.5" class="ltx_td ltx_align_center ltx_border_t"><span id="A3.T6.2.1.3.5.1" class="ltx_text ltx_font_bold">34.3</span></td></tr>
