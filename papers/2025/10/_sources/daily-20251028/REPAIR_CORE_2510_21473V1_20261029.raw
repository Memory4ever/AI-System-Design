<th id="A4.T7.2.1.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">512</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A4.T7.2.1.3" class="ltx_tr">
<th id="A4.T7.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">DiffuLLaMA</th>
