<td id="A3.T4.2.1.4.4" class="ltx_td ltx_align_center"><span id="A3.T4.2.1.4.4.1" class="ltx_text ltx_font_bold">82.6</span></td>
<td id="A3.T4.2.1.4.5" class="ltx_td ltx_align_center">31.0</td>
<td id="A3.T4.2.1.4.6" class="ltx_td ltx_align_center">34.2</td>
<td id="A3.T4.2.1.4.7" class="ltx_td ltx_align_center">36.2</td>
<td id="A3.T4.2.1.4.8" class="ltx_td ltx_align_center">26.3</td>
<td id="A3.T4.2.1.4.9" class="ltx_td ltx_align_center">32.1</td>
