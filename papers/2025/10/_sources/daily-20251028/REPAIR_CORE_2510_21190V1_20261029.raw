<th id="S5.T1.4.1.9" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T1.4.1.9.1" class="ltx_text" style="font-size:90%;">Llama3-8B</span></th></tr>
