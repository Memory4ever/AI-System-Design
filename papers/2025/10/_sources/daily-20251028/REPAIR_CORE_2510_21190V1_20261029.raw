<th id="S5.T1.4.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t"><span id="S5.T1.4.2.2.1" class="ltx_text" style="font-size:90%;">Jailbroken</span></th>
