client.P6ud_8Vb.js" props="{&quot;href&quot;:[0,&quot;/gpt-5-sensitive-conversations/introduction&quot;],&quot;ariaLabel&quot;:[0,&quot;Copy permalink to 1. Introduction&quot;]}" ssr client="idle" opts="{&quot;name&quot;:&quot;PermalinkButton&quot;,&quot;value&quot;:true}" await-children><button type="button" aria-label="Copy permalink to 1. Introduction" title="Copy permalink to 1. Introduction" data-analytics-id="copy-permalink-to-1-introduction" class="flex h-9 w-9 items-center justify-center rounded-full border border-primary-12 text-primary-80 transition hover:bg-primary-4 hover:text-primary-60 focus:outline focus:outline-2 focus:outline-primary-44"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path fill="currentColor" d="M3.534 6.094A.75.75 0 0 1 4.608 7.14l-.834.857-.006.007c-1.086 1.086-1.119 2.874.118 4.11 1.236 1.236 3.023 1.205 4.11.118l.008-.007.855-.834a.75.75 0 0 1 1.047 1.076l-.856.832c-1.705 1.697-4.437 1.663-6.225-.124-1.788-1.788-1.821-4.52-.124-6.225z" style="fill-opacity:1"/><path fill="currentColor" d="M9.47 5.47a.75.75 0 0 1 1.06 1.06l-4 4a.75.75 0 1 1-1.06-1.06z" style="fill-opacity:1"/><path fill="currentColor" d="M6.943 2.707c1.704-1.704 4.441-1.672 6.232.118 1.787 1.788 1.821 4.52.125 6.225l-.833.856a.75.75 0 0 1-1.076-1.047l.834-.855.007-.008c1.087-1.087 1.118-2.874-.118-4.11s-3.024-1.206-4.11-.12l-.007.007-.857.834a.75.75 0 0 1-1.046-1.074z" style="fill-opacity:1"/></svg></button><!--astro:end--></astro-island> </div> </header> <div class="*:first:mt-0">  <article> <div class="system-card-richtext"><p>When we launched GPT-5, we <a href="https://openai.com/index/gpt-5-system-card/">noted</a> in the
system card that we were working to establish better benchmarks and to
continue to strengthen model safety in areas related to mental and
emotional distress. On October 3, we deployed an <a href="https://help.openai.com/en/articles/9624314-model-release-notes">update</a>
that reflected those efforts, improving ChatGPT’s default model to
better recognize and support people in moments of distress. In this
effort, we worked with more than 170 mental health experts to help
ChatGPT more reliably recognize signs of distress, respond with care,
and guide people toward real-world support–reducing responses that fall
short of our desired behavior by 65-80%.</p></div><div class="system-card-richtext"><p>We are publishing a related <a href="https://openai.com/index/strengthening-chatgpt-responses-in-sensitive-conversations/">blog
post</a> that gives more information about this work, and this addendum
to the GPT-5 system card to share baseline safety evaluations. These
evaluations compare the <a href="https://help.openai.com/en/articles/6825453-chatgpt-release-notes#h_6b1adafe01">August
15 version</a> of ChatGPT’s default model, also known as GPT-5 Instant,
to the updated one launched October 3.</p></div> </article>  </div> </section><section id="observed-safety-challenges-and-mitigations" class="scroll-mt-[calc(var(--site-nav-sticky-offset)+var(--system-card-banner-h,0px)+var(--system-card-toc-offset,0px)+var(--anchor-scroll-clearance))] md:scroll-mt-[calc(var(--site-nav-sticky-offset)+var(--system-card-banner-h,0px)+var(--anchor-scroll-clearance))] mt-2xl md:mt-3xl [&#38;>header]:mb-md" data-section data-section-slug="observed-safety-challenges-and-mitigations" data-section-anchor="observed-safety-challenges-and-mitigations" data-section-id="sec-2"> <header id="section.2" class="relative scroll-mt-[inherit]"> <h2 class="text-h2_5 m-0! pe-lg"> 2. Observed Safety Challenges and Mitigations </h2> <div class="not-prose absolute right-0 top-0"> <astro-island uid="ZJhUb0" component-url="/_astro/PermalinkButton.BujwbSR_.js" component-export="default" renderer-url="/_astro/client.P6ud_8Vb.js" props="{&quot;href&quot;:[0,&quot;/gpt-5-sensitive-conversations/observed-safety-challenges-and-mitigations&quot;],&quot;ariaLabel&quot;:[0,&quot;Copy permalink to 2. Observed Safety Challenges and Mitigations&quot;]}" ssr client="idle" opts="{&quot;name&quot;:&quot;PermalinkButton&quot;,&quot;value&quot;:true}" await-children><button type="button" aria-label="Copy permalink to 2. Observed Safety Challenges and Mitigations" title="Copy permalink to 2. Observed Safety Challenges and Mitigations" data-analytics-id="copy-permalink-to-2-observed-safety-challenges-and-mitigations" class="flex h-9 w-9 items-center justify-center rounded-full border border-primary-12 text-primary-80 transition hover:bg-primary-4 hover:text-primary-60 focus:outline focus:outline-2 focus:outline-primary-44"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path fill="currentColor" d="M3.534 6.094A.75.75 0 0 1 4.608 7.14l-.834.857-.006.007c-1.086 1.086-1.119 2.874.118 4.11 1.236 1.236 3.023 1.205 4.11.118l.008-.007.855-.834a.75.75 0 0 1 1.047 1.076l-.856.832c-1.705 1.697-4.437 1.663-6.225-.124-1.788-1.788-1.821-4.52-.124-6.225z" style="fill-opacity:1"/><path fill="currentColor" d="M9.47 5.47a.75.75 0 0 1 1.06 1.06l-4 4a.75.75 0 1 1-1.06-1.06z" style="fill-opacity:1"/><path fill="currentColor" d="M6.943 2.707c1.704-1.704 4.441-1.672 6.232.118 1.787 1.788 1.821 4.52.125 6.225l-.833.856a.75.75 0 0 1-1.076-1.047l.834-.855.007-.008c1.087-1.087 1.118-2.874-.118-4.11s-3.024-1.206-4.11-.12l-.007.007-.857.834a.75.75 0 0 1-1.046-1.074z" style="fill-opacity:1"/></svg></button><!--astro:end--></astro-island> </div> </header> <div class="*:first:mt-0">    </div> </section><section id="disallowed-content-production-benchmarks" class="scroll-mt-[calc(var(--site-nav-sticky-offset)+var(--system-card-banner-h,0px)+var(--system-card-toc-offset,0px)+var(--anchor-scroll-clearance))] md:scroll-mt-[calc(var(--site-nav-sticky-offset)+var(--system-card-banner-h,0px)+var(--anchor-scroll-clearance))] [&#38;>header]:mb-sm" data-section data-section-slug="disallowed-content-production-benchmarks" data-section-anchor="disallowed-content-production-benchmarks" data-section-id="sec-2-1"> <header id="subsection.2.1" class="relative scroll-mt-[inherit]"> <h2 class="text-h3 m-0! pe-lg"> 2.1 Disallowed Content (Production Benchmarks) </h2> <div class="not-prose absolute right-0 top-0"> <astro-island uid="kBpCI" component-url="/_astro/PermalinkButton.BujwbSR_.js" component-export="default" renderer-url="/_astro/client.P6ud_8Vb.js" props="{&quot;href&quot;:[0,&quot;/gpt-5-sensitive-conversations/disallowed-content-production-benchmarks&quot;],&quot;ariaLabel&quot;:[0,&quot;Copy permalink to 2.1 Disallowed Content (Production Benchmarks)&quot;]}" ssr client="idle" opts="{&quot;name&quot;:&quot;PermalinkButton&quot;,&quot;value&quot;:true}" await-children><button type="button" aria-label="Copy permalink to 2.1 Disallowed Content (Production Benchmarks)" title="Copy permalink to 2.1 Disallowed Content (Production Benchmarks)" data-analytics-id="copy-permalink-to-2-1-disallowed-content-production-benchmarks" class="flex h-9 w-9 items-center justify-center rounded-full border border-primary-12 text-primary-80 transition hover:bg-primary-4 hover:text-primary-60 focus:outline focus:outline-2 focus:outline-primary-44"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path fill="currentColor" d="M3.534 6.094A.75.75 0 0 1 4.608 7.14l-.834.857-.006.007c-1.086 1.086-1.119 2.874.118 4.11 1.236 1.236 3.023 1.205 4.11.118l.008-.007.855-.834a.75.75 0 0 1 1.047 1.076l-.856.832c-1.705 1.697-4.437 1.663-6.225-.124-1.788-1.788-1.821-4.52-.124-6.225z" style="fill-opacity:1"/><path fill="currentColor" d="M9.47 5.47a.75.75 0 0 1 1.06 1.06l-4 4a.75.75 0 1 1-1.06-1.06z" style="fill-opacity:1"/><path fill="currentColor" d="M6.943 2.707c1.704-1.704 4.441-1.672 6.232.118 1.787 1.788 1.821 4.52.125 6.225l-.833.856a.75.75 0 0 1-1.076-1.047l.834-.855.007-.008c1.087-1.087 1.118-2.874-.118-4.11s-3.024-1.206-4.11-.12l-.007.007-.857.834a.75.75 0 0 1-1.046-1.074z" style="fill-opacity:1"/></svg></button><!--astro:end--></astro-island> </div> </header> <div class="*:first:mt-0">  <article> <div class="system-card-richtext"><p>We evaluate completions using LLM-based grading models. The primary
metric is not_unsafe, checking that the model did not produce output
that is disallowed under the relevant OpenAI policy.</p></div><div class="system-card-richtext"><p>With this launch, we created the following new evaluation sets:</p></div><ul class="system-card-list"><li class="text-primary-100"><p>Emotional Reliance not_unsafe - tests that the model does not produce
disallowed content under our policies related to unhealthy emotional
dependence or attachment to ChatGPT</p></li><li class="text-primary-100"><p>Mental Health not_unsafe - tests that the model does not produce
disallowed content under our policies in situations where there are
signs that a user may be experiencing isolated delusions, psychosis, or
mania</p></li></ul><div class="system-card-richtext"><p>Our new evaluations for emotional reliance and mental health, like
the existing evaluations in this Production Benchmarks set, were
deliberately intended to be challenging. They were built around cases in
which our existing models were not yet giving ideal responses, and this
is reflected in the initial scores below. Error rates are not
representative of average production traffic.</p></div><div class="system-card-richtext"><p>Note these are new evaluations and may evolve over time.</p></div> </article><article id="tbl-1" class="scroll-mt-[max(6rem,calc(var(--site-nav-sticky-offset)_+_var(--system-card-banner-h,0px)_+_var(--system-card-toc-offset,0px)))] md:scroll-mt-[max(6rem,calc(var(--site-nav-sticky-offset)_+_var(--system-card-banner-h,0px)))] not-prose my-12" aria-labelledby="tbl-1-heading" data-block data-block-ref="tbl-1" data-block-section="disallowed-content-production-benchmarks" tabindex="-1"> <div class="not-prose mb-2xs flex min-w-0 flex-col gap-2xs md:flex-row md:items-start md:justify-between"> <h3 id="tbl-1-heading" class="text-h4 min-w-0 font-normal text-primary-100 md:flex-1"> Table 1: Disallowed Content Evaluations - Production Benchmarks (higher is better) </h3> <div class="shrink-0 self-start"> <script>(()=>{var e=async t=>{await(await t())()};(self.Astro||(self.Astro={})).load=e;window.dispatchEvent(new Event("astro:load"));})();</script><astro-island uid="Z2q1aIv" component-url="/_astro/BlockActions.BmUAId7m.js" component-export="default" renderer-url="/_astro/client.P6ud_8Vb.js" props="{&quot;blockId&quot;:[0,&quot;tbl-1&quot;],&quot;chartId&quot;:[0,null],&quot;copyHref&quot;:[0,&quot;/gpt-5-sensitive-conversations/disallowed-content-production-benchmarks/tbl-1&quot;],&quot;figureHref&quot;:[0,null],&quot;figureKind&quot;:[0]}" ssr client="load" opts="{&quot;name&quot;:&quot;BlockActions&quot;,&quot;value&quot;:true}" await-children><div class="flex items-center gap-4xs"><button type="button" aria-label="Copy permalink" title="Copy permalink" data-analytics-id="copy-permalink" class="flex h-9 w-9 items-center justify-center rounded-full border border-primary-12 text-primary-80 transition hover:bg-primary-4 hover:text-primary-60 focus:outline focus:outline-2 focus:outline-primary-44"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="non