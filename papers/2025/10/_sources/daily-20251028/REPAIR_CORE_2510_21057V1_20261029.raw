<span id="A1.p2.pic1.2.6.1.1" class="ltx_text ltx_font_serif">
</span></span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A1.p3" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A1.p3.pic1" class="ltx_picture" height="91.21" overflow="visible" version="1.1" viewBox="0 0 550 91.21" width="550"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,91.21) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#404040;" fill="#404040" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 85.31 C 0 88.57 2.64 91.21 5.91 91.21 L 544.09 91.21 C 547.36 91.21 550 88.57 550 85.31 L 550 5.91 C 550 2.64 547.36 0 544.09 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 67.26 L 548.03 67.26 L 548.03 5.91 C 548.03 3.73 546.27 1.97 544.09 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 75.85)"><foreignObject style="--ltx-fo-width:36.62em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.15" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="506.72"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
