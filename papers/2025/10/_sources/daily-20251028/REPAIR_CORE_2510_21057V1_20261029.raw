<span id="lstnumberx11" class="ltx_listingline"><span id="lstnumberx11.1" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#32323C;">        </span><span id="lstnumberx11.2" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#32323C;">rewritten</span><span id="lstnumberx11.3" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#32323C;"> </span><span id="lstnumberx11.4" class="ltx_text" style="--ltx-fg-color:#32323C;">=</span><span id="lstnumberx11.5" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#32323C;"> </span><span id="lstnumberx11.6" class="ltx_text" style="--ltx-fg-color:#0000FF;">LLM</span><span id="lstnumberx11.7" class="ltx_text" style="--ltx-fg-color:#32323C;">(</span><span id="lstnumberx11.8" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#32323C;">prompt</span><span id="lstnumberx11.9" class="ltx_text" style="--ltx-fg-color:#32323C;">=</span><span id="lstnumberx11.10" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#32323C;">REWRITE_PROMPT</span><span id="lstnumberx11.11" class="ltx_text" style="--ltx-fg-color:#32323C;">(</span><span id="lstnumberx11.12" class="ltx_text ltx_lst_keyword ltx_lst_keywords2 ltx_font_bold" style="--ltx-fg-color:#32323C;">type</span><span id="lstnumberx11.13" class="ltx_text" style="--ltx-fg-color:#32323C;">),</span><span id="lstnumberx11.14" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#32323C;"> </span><span id="lstnumberx11.15" class="ltx_text ltx_lst_keyword ltx_lst_keywords2 ltx_font_bold" style="--ltx-fg-color:#32323C;">input</span><span id="lstnumberx11.16" class="ltx_text" style="--ltx-fg-color:#32323C;">=</span><span id="lstnumberx11.17" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#32323C;">rewritten</span><span id="lstnumberx11.18" class="ltx_text" style="--ltx-fg-color:#32323C;">)</span>
