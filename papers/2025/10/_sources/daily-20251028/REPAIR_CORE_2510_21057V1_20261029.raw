</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 -4.84)"><foreignObject style="--ltx-fo-width:36.62em;--ltx-fo-height:4.35em;--ltx-fo-depth:0em;font-size:10pt;" height="60.19" overflow="visible" transform="matrix(1 0 0 -1 0 60.19)" width="506.72"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
