</span>
<span id="lstnumberx2" class="ltx_listingline"><span id="lstnumberx2.1" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#32323C;">    </span><span id="lstnumberx2.2" class="ltx_text ltx_lst_string" style="--ltx-fg-color:#32323C;">””</span><span id="lstnumberx2.3" class="ltx_text ltx_lst_string" style="--ltx-fg-color:#32323C;">”</span>
</span>
<span id="lstnumberx3" class="ltx_listingline"><span id="lstnumberx3.1" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#32323C;">␣␣␣␣</span><span id="lstnumberx3.2" class="ltx_text" style="--ltx-fg-color:#32323C;">Applies</span><span id="lstnumberx3.3" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#32323C;">␣</span><span id="lstnumberx3.4" class="ltx_text" style="--ltx-fg-color:#32323C;">a</span><span id="lstnumberx3.5" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#32323C;">␣</span><span id="lstnumberx3.6" class="ltx_text" style="--ltx-fg-color:#32323C;">robust</span><span id="lstnumberx3.7" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#32323C;">␣</span><span id="lstnumberx3.8" class="ltx_text" style="--ltx-fg-color:#32323C;">sanitization</span><span id="lstnumberx3.9" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#32323C;">␣</span><span id="lstnumberx3.10" class="ltx_text" style="--ltx-fg-color:#32323C;">procedure</span><span id="lstnumberx3.11" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#32323C;">␣</span><span id="lstnumberx3.12" class="ltx_text" style="--ltx-fg-color:#32323C;">to</span><span id="lstnumberx3.13" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#32323C;">␣</span><span id="lstnumberx3.14" class="ltx_text" style="--ltx-fg-color:#32323C;">tool</span><span id="lstnumberx3.15" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#32323C;">␣</span><span id="lstnumberx3.16" class="ltx_text" style="--ltx-fg-color:#32323C;">output.</span>
</span>
<span id="lstnumberx4" class="ltx_listingline"><span id="lstnumberx4.1" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#32323C;">␣␣␣␣</span><span id="lstnumberx4.2" class="ltx_text" style="--ltx-fg-color:#32323C;">Returns</span><span id="lstnumberx4.3" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#32323C;">␣</span><span id="lstnumberx4.4" class="ltx_text" style="--ltx-fg-color:#32323C;">either</span><span id="lstnumberx4.5" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#32323C;">␣</span><span id="lstnumberx4.6" class="ltx_text" style="--ltx-fg-color:#32323C;">cleaned</span><span id="lstnumberx4.7" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#32323C;">␣</span><span id="lstnumberx4.8" class="ltx_text" style="--ltx-fg-color:#32323C;">output</span><span id="lstnumberx4.9" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#32323C;">␣</span><span id="lstnumberx4.10" class="ltx_text" style="--ltx-fg-color:#32323C;">or</span><span id="lstnumberx4.11" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#32323C;">␣</span><span id="lstnumberx4.12" class="ltx_text" style="--ltx-fg-color:#32323C;">”&lt;</span><span id="lstnumberx4.13" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#32323C;">HALT</span><span id="lstnumberx4.14" class="ltx_text" style="--ltx-fg-color:#32323C;">&gt;</span><span id="lstnumberx4.15" class="ltx_text ltx_lst_string" style="--ltx-fg-color:#32323C;">”<span id="lstnumberx4.15.1" class="ltx_text ltx_lst_space">␣</span>if<span id="lstnumberx4.15.2" class="ltx_text ltx_lst_space">␣</span>sanitization<span id="lstnumberx4.15.3" class="ltx_text ltx_lst_space">␣</span>fails.</span>
