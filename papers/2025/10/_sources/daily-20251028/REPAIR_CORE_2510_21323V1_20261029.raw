<th id="A2.T16.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">0.6</th>
<th id="A2.T16.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">0.7</th>
<th id="A2.T16.2.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">0.8</th>
<th id="A2.T16.2.1.6" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt">0.9</th></tr>
</thead>
<tbody class="ltx_tbody">
