<th id="S4.T3.2.1.8.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_r" style="padding-left:1.4pt;padding-right:1.4pt;">-Auxiliary Autoencoder</th>
