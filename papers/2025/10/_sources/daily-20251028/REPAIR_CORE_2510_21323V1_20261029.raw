<th id="A2.T15.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">OpenCLIP-ViT-L</th>
<th id="A2.T15.2.1.3" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt">OpenCLIP-ViT-H</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A2.T15.2.2" class="ltx_tr">
