<td id="A2.T16.2.3.4" class="ltx_td ltx_align_center"><span id="A2.T16.2.3.4.1" class="ltx_text ltx_font_bold">84.37</span></td>
<td id="A2.T16.2.3.5" class="ltx_td ltx_align_center">84.23</td>
<td id="A2.T16.2.3.6" class="ltx_td ltx_nopad_r ltx_align_center">84.12</td></tr>
