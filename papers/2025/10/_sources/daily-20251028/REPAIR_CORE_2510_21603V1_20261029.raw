<td id="S5.T2.3.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:-2pt;padding-bottom:-2pt;"><span id="S5.T2.3.1.1.2.1" class="ltx_text ltx_font_bold">Para-</span></td>
<td id="S5.T2.3.1.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-top:-2pt;padding-bottom:-2pt;" colspan="2"><span id="S5.T2.3.1.1.3.1" class="ltx_text ltx_font_bold">Embed</span></td>
<td id="S5.T2.3.1.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-top:-2pt;padding-bottom:-2pt;" colspan="3"><span id="S5.T2.3.1.1.4.1" class="ltx_text ltx_font_bold">M4DocBench</span></td>
<td id="S5.T2.3.1.1.5" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:-2pt;padding-bottom:-2pt;" colspan="2"><span id="S5.T2.3.1.1.5.1" class="ltx_text ltx_font_bold">MMDocIR</span></td></tr>
<tr id="S5.T2.3.1.2" class="ltx_tr">
<td id="S5.T2.3.1.2.1" class="ltx_td ltx_align_center" style="padding-top:-2pt;padding-bottom:-2pt;"><span id="S5.T2.3.1.2.1.1" class="ltx_text ltx_font_bold">meter</span></td>
<td id="S5.T2.3.1.2.2" class="ltx_td ltx_align_center" style="padding-top:-2pt;padding-bottom:-2pt;">type</td>
<td id="S5.T2.3.1.2.3" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:-2pt;padding-bottom:-2pt;">dimension</td>
<td id="S5.T2.3.1.2.4" class="ltx_td ltx_align_center" style="padding-top:-2pt;padding-bottom:-2pt;">doc</td>
<td id="S5.T2.3.1.2.5" class="ltx_td ltx_align_center" style="padding-top:-2pt;padding-bottom:-2pt;">page</td>
<td id="S5.T2.3.1.2.6" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:-2pt;padding-bottom:-2pt;">layout</td>
<td id="S5.T2.3.1.2.7" class="ltx_td ltx_align_center" style="padding-top:-2pt;padding-bottom:-2pt;">page</td>
<td id="S5.T2.3.1.2.8" class="ltx_td ltx_align_center" style="padding-top:-2pt;padding-bottom:-2pt;">layout</td></tr>
<tr id="S5.T2.3.1.3" class="ltx_tr">
<th id="S5.T2.3.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-top:-2pt;padding-bottom:-2pt;" rowspan="13">
<span id="S5.T2.3.1.3.1.1" class="ltx_inline-block ltx_parbox ltx_align_top" style="width:4.3pt;">
<span id="S5.T2.3.1.3.1.1.1" class="ltx_p">
<span id="S5.T2.3.1.3.1.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:6.9pt;height:63.4pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:63.4pt;transform:translate(-28.2pt,-28.2pt) rotate(-90deg) ;">
<span id="S5.T2.3.1.3.1.1.1.1.1" class="ltx_p">Recall@<math id="S5.T2.m1" class="ltx_Math" alttext="k=10" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">k=10</annotation></semantics></math></span>
</span></span></span>
</span></th>
<th id="S5.T2.3.1.3.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-top:-2pt;padding-bottom:-2pt;" rowspan="5">
