<td id="A1.T3.7.8.1" class="ltx_td ltx_align_left ltx_border_l ltx_border_rr"><span id="A1.T3.7.8.1.1" class="ltx_text" style="font-size:70%;">Seed 48</span></td>
<td id="A1.T3.7.8.2" class="ltx_td ltx_align_center"><span id="A1.T3.7.8.2.1" class="ltx_text" style="font-size:70%;">53.9</span></td>
<td id="A1.T3.7.8.3" class="ltx_td ltx_align_center"><span id="A1.T3.7.8.3.1" class="ltx_text" style="font-size:70%;">45.4</span></td>
<td id="A1.T3.7.8.4" class="ltx_td ltx_align_center"><span id="A1.T3.7.8.4.1" class="ltx_text" style="font-size:70%;">82.0</span></td>
<td id="A1.T3.7.8.5" class="ltx_td ltx_align_center ltx_border_r"><span id="A1.T3.7.8.5.1" class="ltx_text" style="font-size:70%;">56.2</span></td></tr>
