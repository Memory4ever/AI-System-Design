               <math id="alg2.l20.m1" class="ltx_Math" alttext="\mathrm{LC}\leftarrow\Psi_{\text{vali}}(\mathcal{D},o_{\leq t},g,f_{n})" display="inline" intent=":literal"><semantics><mrow><mi>LC</mi><mo stretchy="false">←</mo><mrow><msub><mi mathvariant="normal">Ψ</mi><mtext>vali</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>,</mo><msub><mi>o</mi><mrow><mphantom></mphantom><mo>≤</mo><mi>t</mi></mrow></msub><mo>,</mo><mi>g</mi><mo>,</mo><msub><mi>f</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{LC}\leftarrow\Psi_{\text{vali}}(\mathcal{D},o_{\leq t},g,f_{n})</annotation></semantics></math>

