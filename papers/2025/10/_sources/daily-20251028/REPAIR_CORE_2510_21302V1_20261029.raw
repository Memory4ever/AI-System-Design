                 <math id="alg1.l23.m1" class="ltx_Math" alttext="o_{\text{next}}\leftarrow\mathrm{env.step}(a)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>o</mi><mtext>next</mtext></msub><mo stretchy="false">←</mo><mi>env</mi></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mi>step</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">o_{\text{next}}\leftarrow\mathrm{env.step}(a)</annotation></semantics></math>

