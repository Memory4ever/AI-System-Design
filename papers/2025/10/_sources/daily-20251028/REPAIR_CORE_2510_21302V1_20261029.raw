                 <math id="alg1.l24.m1" class="ltx_Math" alttext="\tau_{\text{exe}}\leftarrow\tau_{\text{exe}}\cup(a,o_{\text{next}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mtext>exe</mtext></msub><mo stretchy="false">←</mo><mrow><msub><mi>τ</mi><mtext>exe</mtext></msub><mo>∪</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><msub><mi>o</mi><mtext>next</mtext></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau_{\text{exe}}\leftarrow\tau_{\text{exe}}\cup(a,o_{\text{next}})</annotation></semantics></math>

