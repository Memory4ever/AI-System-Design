<span id="A3.I5.i2.p1.1" class="ltx_p"><span id="A3.I5.i2.p1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Observation:</span><span id="A3.I5.i2.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> </span>
