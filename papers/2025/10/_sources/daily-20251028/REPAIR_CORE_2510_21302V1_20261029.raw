              <math id="alg2.l3.m1" class="ltx_Math" alttext="(\pi_{\text{main}},o_{\leq t},\mathrm{env},\tau)\leftarrow" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mtext>main</mtext></msub><mo>,</mo><msub><mi>o</mi><mrow><mphantom></mphantom><mo>≤</mo><mi>t</mi></mrow></msub><mo>,</mo><mi>env</mi><mo>,</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">(\pi_{\text{main}},o_{\leq t},\mathrm{env},\tau)\leftarrow</annotation></semantics></math>

