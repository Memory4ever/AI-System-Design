              <span id="alg1.l28.2" class="ltx_text ltx_font_bold">return</span> (<math id="alg1.l28.m1" class="ltx_Math" alttext="\tau_{\text{exe}},o_{\leq t},\mathrm{env}" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mtext>exe</mtext></msub><mo>,</mo><msub><mi>o</mi><mrow><mphantom></mphantom><mo>≤</mo><mi>t</mi></mrow></msub><mo>,</mo><mi>env</mi></mrow><annotation encoding="application/x-tex">\tau_{\text{exe}},o_{\leq t},\mathrm{env}</annotation></semantics></math>)

