<td id="S4.T3.9.1.7.13" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T3.9.1.7.13.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">6</span></td></tr>
</tbody>
