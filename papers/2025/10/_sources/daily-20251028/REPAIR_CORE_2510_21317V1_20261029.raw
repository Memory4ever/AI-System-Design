<td id="S4.T2.5.1.4" class="ltx_td ltx_align_center ltx_border_tt"><math id="S4.T2.m2" class="ltx_Math" alttext="|\mathrm{SRCC}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi>SRCC</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathrm{SRCC}|</annotation></semantics></math></td></tr>
