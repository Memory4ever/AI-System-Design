<td id="S5.T2.2.1.4.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bbb" style="padding-left:1.0pt;padding-right:1.0pt;">Anchored</td>
<td id="S5.T2.2.1.4.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bbb" style="padding-left:1.0pt;padding-right:1.0pt;">97.30</td>
<td id="S5.T2.2.1.4.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bbb" style="padding-left:1.0pt;padding-right:1.0pt;">95.11</td>
