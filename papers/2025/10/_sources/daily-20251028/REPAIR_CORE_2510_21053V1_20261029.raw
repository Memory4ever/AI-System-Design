<td id="S5.T1.2.1.1.4" class="ltx_td ltx_align_center ltx_border_ttt" style="padding:-0.75pt 3.0pt;" rowspan="4"><span id="S5.T1.2.1.1.4.1" class="ltx_text"><span id="S5.T1.2.1.1.4.1.1" class="ltx_text"></span> <span id="S5.T1.2.1.1.4.1.2" class="ltx_text">
<span id="S5.T1.2.1.1.4.1.2.1" class="ltx_tabular ltx_align_middle">
<span id="S5.T1.2.1.1.4.1.2.1.1" class="ltx_tr">
<span id="S5.T1.2.1.1.4.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:-0.75pt 3.0pt;"><span id="S5.T1.2.1.1.4.1.2.1.1.1.1" class="ltx_text ltx_font_bold">Overall</span></span></span>
<span id="S5.T1.2.1.1.4.1.2.1.2" class="ltx_tr">
<span id="S5.T1.2.1.1.4.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:-0.75pt 3.0pt;"><span id="S5.T1.2.1.1.4.1.2.1.2.1.1" class="ltx_text ltx_font_bold">AUC</span> <math id="S5.T1.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></span>
</span></span><span id="S5.T1.2.1.1.4.1.3" class="ltx_text"></span></span></td>
<td id="S5.T1.2.1.1.5" class="ltx_td ltx_align_center ltx_border_ttt" style="padding:-0.75pt 3.0pt;" rowspan="4"><span id="S5.T1.2.1.1.5.1" class="ltx_text ltx_font_bold">PPL<math id="S5.T1.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td></tr>
<tr id="S5.T1.2.1.2" class="ltx_tr">
<td id="S5.T1.2.1.2.1" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.75pt 3.0pt;" rowspan="3"><span id="S5.T1.2.1.2.1.1" class="ltx_text ltx_font_bold">Detectability</span> <math id="S5.T1.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="S5.T1.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.75pt 3.0pt;"><span id="S5.T1.2.1.2.2.1" class="ltx_text ltx_font_bold">Robustness</span> <math id="S5.T1.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="S5.T1.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.75pt 3.0pt;" colspan="2"><span id="S5.T1.2.1.2.3.1" class="ltx_text ltx_font_bold">Security</span> <math id="S5.T1.m5" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td></tr>
<tr id="S5.T1.2.1.3" class="ltx_tr">
<td id="S5.T1.2.1.3.1" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.75pt 3.0pt;">Paraphrase</td>
<td id="S5.T1.2.1.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.75pt 3.0pt;"><span id="S5.T1.2.1.3.2.1" class="ltx_text"></span> <span id="S5.T1.2.1.3.2.2" class="ltx_text">
<span id="S5.T1.2.1.3.2.2.1" class="ltx_tabular ltx_align_middle">
<span id="S5.T1.2.1.3.2.2.1.1" class="ltx_tr">
<span id="S5.T1.2.1.3.2.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:-0.75pt 3.0pt;">Sentiment</span></span>
<span id="S5.T1.2.1.3.2.2.1.2" class="ltx_tr">
<span id="S5.T1.2.1.3.2.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:-0.75pt 3.0pt;">Spoof</span></span>
