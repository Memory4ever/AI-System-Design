<tr id="A7.T34.5.1.11" class="ltx_tr">
<th id="A7.T34.5.1.11.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">DiP(<math id="A7.T34.m10" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>=0.4)</th>
<td id="A7.T34.5.1.11.2" class="ltx_td ltx_align_center">0.43</td>
<td id="A7.T34.5.1.11.3" class="ltx_td ltx_align_center">0.19</td>
<td id="A7.T34.5.1.11.4" class="ltx_td ltx_align_center">0.16</td>
<td id="A7.T34.5.1.11.5" class="ltx_td ltx_align_center">0.37</td>
<td id="A7.T34.5.1.11.6" class="ltx_td ltx_align_center">0.37</td>
<td id="A7.T34.5.1.11.7" class="ltx_td ltx_align_center">0.27</td></tr>
<tr id="A7.T34.5.1.12" class="ltx_tr">
<th id="A7.T34.5.1.12.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_r ltx_border_t"><span id="A7.T34.5.1.12.1.1" class="ltx_text ltx_font_smallcaps">Aligned-IS</span></th>
<td id="A7.T34.5.1.12.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">0.91</td>
<td id="A7.T34.5.1.12.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">0.82</td>
<td id="A7.T34.5.1.12.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">0.84</td>
<td id="A7.T34.5.1.12.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">0.95</td>
<td id="A7.T34.5.1.12.6" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">0.96</td>
<td id="A7.T34.5.1.12.7" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">0.85</td></tr>
</tbody>
</table>
