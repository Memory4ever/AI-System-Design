<td id="S5.T5.5.1.12.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">0.93</td>
<td id="S5.T5.5.1.12.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">0.93</td>
<td id="S5.T5.5.1.12.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">0.94</td>
