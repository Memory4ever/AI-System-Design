<figure id="A5.T20" class="ltx_table">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_table"><span id="A5.T20.3" class="ltx_text" style="font-size:90%;">Table 20</span>: </span><span id="A5.T20.4" class="ltx_text" style="font-size:90%;">Ablation on the optimal number of clusters for SpeechGPT.</span></figcaption>
<table id="A5.T20.5" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
