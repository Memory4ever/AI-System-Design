</span></span><span id="S5.T1.8.1.1.13.3" class="ltx_text"></span></td></tr>
<tr id="S5.T1.8.1.2" class="ltx_tr">
<td id="S5.T1.8.1.2.1" class="ltx_td ltx_align_left ltx_border_t">Hiveformer</td>
<td id="S5.T1.8.1.2.2" class="ltx_td ltx_align_center ltx_border_t">100</td>
<td id="S5.T1.8.1.2.3" class="ltx_td ltx_align_center ltx_border_t">69.1</td>
<td id="S5.T1.8.1.2.4" class="ltx_td ltx_align_center ltx_border_t">64</td>
<td id="S5.T1.8.1.2.5" class="ltx_td ltx_align_center ltx_border_t">92</td>
<td id="S5.T1.8.1.2.6" class="ltx_td ltx_align_center ltx_border_t">12</td>
