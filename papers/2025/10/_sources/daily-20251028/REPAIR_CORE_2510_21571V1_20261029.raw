<td id="S5.T2.1.7.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="padding:-0.45pt 0.5pt;"><span id="S5.T2.1.7.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">  9.9 / 8.1</span></td></tr>
