<figure id="S5.F7" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S5.T2" class="ltx_figure ltx_figure_panel ltx_align_center ltx_align_top" style="width:253.7pt;">
<br class="ltx_break ltx_break">
<table id="S5.T2.1" class="ltx_tabular ltx_centering ltx_figure_panel ltx_guessed_headers ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="S5.T2.1.1" class="ltx_tr">
<th id="S5.T2.1.1.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_tt" style="padding:-0.45pt 0.5pt;" rowspan="2"><span id="S5.T2.1.1.1.1" class="ltx_text" style="font-size:90%;">Method</span></th>
<td id="S5.T2.1.1.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_tt" style="padding:-0.45pt 0.5pt;"><span id="S5.T2.1.1.2.1" class="ltx_text" style="font-size:90%;">Grasp</span></td></tr>
<tr id="S5.T2.1.2" class="ltx_tr">
