<td id="S5.T2.1.5.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding:-0.45pt 0.5pt;"><span id="S5.T2.1.5.2.1" class="ltx_text" style="font-size:90%;">10.5 /  8.8</span></td></tr>
<tr id="S5.T2.1.6" class="ltx_tr">
<th id="S5.T2.1.6.1" class="ltx_td ltx_nopad_r ltx_align_left ltx_th ltx_th_row ltx_border_r" style="padding:-0.45pt 0.5pt;"><span id="S5.T2.1.6.1.1" class="ltx_text" style="font-size:90%;">No trajectory overlay</span></th>
<td id="S5.T2.1.6.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding:-0.45pt 0.5pt;"><span id="S5.T2.1.6.2.1" class="ltx_text" style="font-size:90%;">11.7 / 10.7</span></td></tr>
