<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex5.m1" class="ltx_Math" alttext="\displaystyle\quad\quad\quad+\alpha_{t-1}\left(r_{i}(t{-}1)+\gamma\hat{Q}_{i}^{t{-}1}(\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}}(t),\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}(t),\hat{\boldsymbol{\omega}}^{\circ}_{\mathcal{N}_{i}^{\kappa}})\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><msub><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>r</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mi>i</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msubsup><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad\quad+\alpha_{t-1}\left(r_{i}(t{-}1)+\gamma\hat{Q}_{i}^{t{-}1}(\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}}(t),\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}(t),\hat{\boldsymbol{\omega}}^{\circ}_{\mathcal{N}_{i}^{\kappa}})\right),</annotation></semantics></math></td>
