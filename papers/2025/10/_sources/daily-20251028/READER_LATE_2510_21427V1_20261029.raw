<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A8.F8.sf3.3" class="ltx_text" style="font-size:90%;">(c)</span> </span><span id="A8.F8.sf3.4" class="ltx_text" style="font-size:90%;">grid size 5</span></figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A8.F8.3" class="ltx_text" style="font-size:90%;">Figure 8</span>: </span><span id="A8.F8.4" class="ltx_text" style="font-size:90%;">Adaptation comparison for different grid sizes in traffic control benchmark.</span></figcaption>
</figure>
<figure id="A8.F9" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_3">
<figure id="A8.F9.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.21427v1/figures/p_target_0.4_comparison.png" id="A8.F9.sf1.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/374;" width="476" height="374" alt="Refer to caption">
