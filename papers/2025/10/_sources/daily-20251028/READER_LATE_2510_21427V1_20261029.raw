<div id="alg4.l34" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l34.1" class="ltx_text" style="font-size:80%;">34:</span></span>
              
              
               Estimate policy gradient:

<table id="A4.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex22.m1" class="ltx_math_unparsed" alttext="\hat{g}_{i}(k)=\sum_{t=0}^{T}\gamma^{t}\cdot\frac{1}{n}\sum_{j\in\mathcal{N}_{i}^{\kappa}}\hat{Q}_{j}^{T}(\mathbf{s}^{\circ}_{\mathcal{N}_{j}^{\kappa}}(t),\mathbf{a}_{\mathcal{N}_{j}^{\kappa}}(t),\hat{\boldsymbol{\omega}}^{\circ}_{\mathcal{N}_{j}^{\kappa}})\nabla_{\theta_{i}}\log\pi_{i}^{\theta_{i}(k)}(\mathbf{a}_{i}(t)\mid\mathbf{s}^{\circ}_{i}(t),\hat{\boldsymbol{\omega}}^{\circ}_{i})" display="block" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>g</mi><mo>^</mo></mover><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">=</mo><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mi>T</mi></munderover><msup><mi>γ</mi><mi>t</mi></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></mrow></munder><msubsup><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mi>j</mi><mi>T</mi></msubsup><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>j</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>j</mi><mi>κ</mi></msubsup></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msubsup><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>j</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo rspace="0.167em" stretchy="false">)</mo></mrow><msub><mo rspace="0.167em">∇</mo><msub><mi>θ</mi><mi>i</mi></msub></msub><mi>log</mi><msubsup><mi>π</mi><mi>i</mi><mrow><msub><mi>θ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>𝐚</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msubsup><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mi>i</mi><mo>∘</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{g}_{i}(k)=\sum_{t=0}^{T}\gamma^{t}\cdot\frac{1}{n}\sum_{j\in\mathcal{N}_{i}^{\kappa}}\hat{Q}_{j}^{T}(\mathbf{s}^{\circ}_{\mathcal{N}_{j}^{\kappa}}(t),\mathbf{a}_{\mathcal{N}_{j}^{\kappa}}(t),\hat{\boldsymbol{\omega}}^{\circ}_{\mathcal{N}_{j}^{\kappa}})\nabla_{\theta_{i}}\log\pi_{i}^{\theta_{i}(k)}(\mathbf{a}_{i}(t)\mid\mathbf{s}^{\circ}_{i}(t),\hat{\boldsymbol{\omega}}^{\circ}_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="alg4.l35" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l35.1" class="ltx_text" style="font-size:80%;">35:</span></span>
              
              
               Update policy: <math id="alg4.l35.m1" class="ltx_Math" alttext="\theta_{i}(k+1)=\theta_{i}(k)+\eta_{k}\hat{g}_{i}(k),\ \text{where }\eta_{k}=\frac{\eta}{\sqrt{k+1}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>θ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>θ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>η</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>g</mi><mo>^</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mtext>where </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>k</mi></msub></mrow><mo>=</mo><mfrac><mi>η</mi><msqrt><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msqrt></mfrac></mrow></mrow><annotation encoding="application/x-tex">\theta_{i}(k+1)=\theta_{i}(k)+\eta_{k}\hat{g}_{i}(k),\ \text{where }\eta_{k}=\frac{\eta}{\sqrt{k+1}}</annotation></semantics></math>

</div>
<div id="alg4.l36" class="ltx_listingline">
