<div id="alg5.l30" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l30.1" class="ltx_text" style="font-size:80%;">30:</span></span>
              
              
               Update policy: <math id="alg5.l30.m1" class="ltx_Math" alttext="\theta_{i}(k+1)=\theta_{i}(k)+\eta_{k}\hat{g}_{i}(k),\ \text{where }\eta_{k}=\frac{\eta}{\sqrt{k+1}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>θ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>θ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>η</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>g</mi><mo>^</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mtext>where </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>k</mi></msub></mrow><mo>=</mo><mfrac><mi>η</mi><msqrt><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msqrt></mfrac></mrow></mrow><annotation encoding="application/x-tex">\theta_{i}(k+1)=\theta_{i}(k)+\eta_{k}\hat{g}_{i}(k),\ \text{where }\eta_{k}=\frac{\eta}{\sqrt{k+1}}</annotation></semantics></math>

</div>
<div id="alg5.l31" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l31.1" class="ltx_text" style="font-size:80%;">31:</span></span>
              
              
              <span id="alg5.l31.3" class="ltx_text ltx_font_bold">end</span> <span id="alg5.l31.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg5.l32" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l32.1" class="ltx_text" style="font-size:80%;">32:</span></span>
              
              
            <span id="alg5.l32.3" class="ltx_text ltx_font_bold">end</span> <span id="alg5.l32.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg5.l33" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l33.1" class="ltx_text" style="font-size:80%;">33:</span></span>
              
              
            // <span id="alg5.l33.3" class="ltx_text ltx_font_italic">Phase 3: adaptation to new domain</span>

</div>
<div id="alg5.l34" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l34.1" class="ltx_text" style="font-size:80%;">34:</span></span>
              
              
            Collect few trajectories <math id="alg5.l34.m1" class="ltx_Math" alttext="\tau^{M+1}=\{(\mathbf{s}(t),\mathbf{a}(t),\mathbf{s}(t+1))\}_{t=0}^{T_{a}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>τ</mi><mrow><mi>M</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐚</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><msub><mi>T</mi><mi>a</mi></msub></msubsup></mrow><annotation encoding="application/x-tex">\tau^{M+1}=\{(\mathbf{s}(t),\mathbf{a}(t),\mathbf{s}(t+1))\}_{t=0}^{T_{a}}</annotation></semantics></math> in the new domain

</div>
<div id="alg5.l35" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l35.1" class="ltx_text" style="font-size:80%;">35:</span></span>
              
              
            <span id="alg5.l35.3" class="ltx_text ltx_font_bold">for</span> each agent <math id="alg5.l35.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> <span id="alg5.l35.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg5.l36" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l36.1" class="ltx_text" style="font-size:80%;">36:</span></span>
              
              
              Infer domain factor <math id="alg5.l36.m1" class="ltx_Math" alttext="\hat{\boldsymbol{\omega}}_{i}^{M+1}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mi>i</mi><mrow><mi>M</mi><mo>+</mo><mn>1</mn></mrow></msubsup><annotation encoding="application/x-tex">\hat{\boldsymbol{\omega}}_{i}^{M+1}</annotation></semantics></math>

</div>
<div id="alg5.l37" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l37.1" class="ltx_text" style="font-size:80%;">37:</span></span>
              
              
              Deploy policy <math id="alg5.l37.m1" class="ltx_math_unparsed" alttext="\pi^{\theta(K)}_{i}(\cdot|\mathbf{s}_{i},\hat{\boldsymbol{\omega}}^{M+1}_{i})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>π</mi><mi>i</mi><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mo>,</mo><msubsup><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mi>i</mi><mrow><mi>M</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi^{\theta(K)}_{i}(\cdot|\mathbf{s}_{i},\hat{\boldsymbol{\omega}}^{M+1}_{i})</annotation></semantics></math>

</div>
<div id="alg5.l38" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l38.1" class="ltx_text" style="font-size:80%;">38:</span></span>
              
              
            <span id="alg5.l38.3" class="ltx_text ltx_font_bold">end</span> <span id="alg5.l38.4" class="ltx_text ltx_font_bold">for</span>
</div>
</div>
</figure>
</section>
</section>
<section id="A5" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix E </span>Missing proofs in Section <a href="#S3" title="3 Approximately compact representation ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a></h2>

<section id="A5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.1 </span>Value ACR</h3>

<div id="A5.SS1.p1" class="ltx_para">
<p id="A5.SS1.p1.1" class="ltx_p">Definition <a href="#Thmdefinition1" title="Definition 1 (Value ACR). ‣ 3.1 ACR for fixed environment ‣ 3 Approximately compact representation ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> recursively identifies the key state components within the <math id="A5.SS1.p1.m1" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>-hop neighborhood that influence an agent’s reward, yielding a compact subset <math id="A5.SS1.p1.m2" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}}\subset\mathbf{s}_{\mathcal{N}^{\kappa}_{i}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo>⊂</mo><msub><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub></mrow><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}}\subset\mathbf{s}_{\mathcal{N}^{\kappa}_{i}}</annotation></semantics></math> with an exponentially small approximation error in the <math id="A5.SS1.p1.m3" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>-function. This definition assumes a fixed number of time steps <math id="A5.SS1.p1.m4" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>. In contrast, Definition <a href="#Thmdefinition4" title="Definition 4 (Value ACR). ‣ E.1 Value ACR ‣ Appendix E Missing proofs in Section ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> exactly identifies all state components in <math id="A5.SS1.p1.m5" class="ltx_Math" alttext="\mathbf{s}_{\mathcal{N}^{\kappa}_{i}}" display="inline" intent=":literal"><semantics><msub><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><annotation encoding="application/x-tex">\mathbf{s}_{\mathcal{N}^{\kappa}_{i}}</annotation></semantics></math> that influence the agent’s reward but requires a variable number of time steps. Notably, Definition <a href="#Thmdefinition4" title="Definition 4 (Value ACR). ‣ E.1 Value ACR ‣ Appendix E Missing proofs in Section ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> is stricter and implies Definition <a href="#Thmdefinition1" title="Definition 1 (Value ACR). ‣ 3.1 ACR for fixed environment ‣ 3 Approximately compact representation ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>. Specifically, the former identifies only the components that influence the reward within <math id="A5.SS1.p1.m6" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> steps, while the latter includes all components in <math id="A5.SS1.p1.m7" class="ltx_Math" alttext="\mathbf{s}_{\mathcal{N}^{\kappa}_{i}}" display="inline" intent=":literal"><semantics><msub><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><annotation encoding="application/x-tex">\mathbf{s}_{\mathcal{N}^{\kappa}_{i}}</annotation></semantics></math> that have a direct or indirect influence on the reward, possibly through longer dependencies.</p>
</div>
<div id="Thmdefinition4" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmdefinition4.2" class="ltx_text ltx_font_bold">Definition 4</span></span><span id="Thmdefinition4.3" class="ltx_text ltx_font_bold"> </span>(Value ACR)<span id="Thmdefinition4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmdefinition4.p1" class="ltx_para">
<p id="Thmdefinition4.p1.1" class="ltx_p">Given the graph <math id="Thmdefinition4.p1.m1" class="ltx_Math" alttext="\mathscr{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">𝒢</mi><annotation encoding="application/x-tex">\mathscr{G}</annotation></semantics></math> encoded by the binary masks <math id="Thmdefinition4.p1.m2" class="ltx_Math" alttext="\mathbf{c}" display="inline" intent=":literal"><semantics><mi>𝐜</mi><annotation encoding="application/x-tex">\mathbf{c}</annotation></semantics></math>, for each agent <math id="Thmdefinition4.p1.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> and its <math id="Thmdefinition4.p1.m4" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>-hop neighborhood <math id="Thmdefinition4.p1.m5" class="ltx_Math" alttext="\mathcal{N}^{\kappa}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><annotation encoding="application/x-tex">\mathcal{N}^{\kappa}_{i}</annotation></semantics></math>, we recursively define the <math id="Thmdefinition4.p1.m6" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>-hop ACR <math id="Thmdefinition4.p1.m7" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}}(t)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}}(t)</annotation></semantics></math> as the set of state components <math id="Thmdefinition4.p1.m8" class="ltx_Math" alttext="s_{\mathcal{N}^{\kappa}_{i},j}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">s_{\mathcal{N}^{\kappa}_{i},j}</annotation></semantics></math> satisfying at least one of the following:</p>
<ul id="A5.I1" class="ltx_itemize">
<li id="A5.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I1.i1.p1" class="ltx_para">
<p id="A5.I1.i1.p1.1" class="ltx_p"><math id="A5.I1.i1.p1.m1" class="ltx_Math" alttext="s_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">s_{i,j}</annotation></semantics></math> has a direct link to agent <math id="A5.I1.i1.p1.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>’s reward <math id="A5.I1.i1.p1.m3" class="ltx_Math" alttext="r_{i}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>i</mi></msub><annotation encoding="application/x-tex">r_{i}</annotation></semantics></math>, i.e., <math id="A5.I1.i1.p1.m4" class="ltx_Math" alttext="c^{s\rightarrow r}_{i,j}=1" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>c</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mi>s</mi><mo stretchy="false">→</mo><mi>r</mi></mrow></msubsup><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c^{s\rightarrow r}_{i,j}=1</annotation></semantics></math>, or</p>
</div></li>
<li id="A5.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I1.i2.p1" class="ltx_para">
<p id="A5.I1.i2.p1.1" class="ltx_p"><math id="A5.I1.i2.p1.m1" class="ltx_Math" alttext="s_{\mathcal{N}^{\kappa}_{i},j}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{\mathcal{N}^{\kappa}_{i},j}(t)</annotation></semantics></math> has an edge to another state component <math id="A5.I1.i2.p1.m2" class="ltx_Math" alttext="s_{l,\mathcal{N}^{\kappa}_{i}}(t+1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>l</mi><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{l,\mathcal{N}^{\kappa}_{i}}(t+1)</annotation></semantics></math> such that <math id="A5.I1.i2.p1.m3" class="ltx_Math" alttext="s_{l,\mathcal{N}^{\kappa}_{i}}(t)\in\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>s</mi><mrow><mi>l</mi><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup></mrow><annotation encoding="application/x-tex">s_{l,\mathcal{N}^{\kappa}_{i}}(t)\in\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}}</annotation></semantics></math>,</p>
</div></li>
</ul>
</div>
</div>
<div id="A5.SS1.p2" class="ltx_para">
<p id="A5.SS1.p2.1" class="ltx_p">We provide the proof of Proposition <a href="#Thmproposition1" title="Proposition 1 (Approximation error of value ACR). ‣ 3.1 ACR for fixed environment ‣ 3 Approximately compact representation ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> here.</p>
</div>
<div id="A5.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Proposition <a href="#Thmproposition1" title="Proposition 1 (Approximation error of value ACR). ‣ 3.1 ACR for fixed environment ‣ 3 Approximately compact representation ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.</h6>
<div id="A5.SS1.p3" class="ltx_para">
<p id="A5.SS1.p3.1" class="ltx_p"><span id="A5.SS1.p3.1.1" class="ltx_text">Denote <math id="A5.SS1.p3.m1" class="ltx_Math" alttext="\mathbf{s}=\left(\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}},\mathbf{s}/\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}}\right)" display="inline" intent=":literal"><semantics><mrow><mi>𝐬</mi><mo>=</mo><mrow><mo>(</mo><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo>,</mo><mrow><mi>𝐬</mi><mo>/</mo><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}=\left(\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}},\mathbf{s}/\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}}\right)</annotation></semantics></math>,
<math id="A5.SS1.p3.m2" class="ltx_Math" alttext="\mathbf{a}=\left(\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\mathbf{a}_{\mathcal{N}_{-i}^{\kappa}}\right);\mathbf{s}^{\prime}=\left(\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}},\mathbf{s}^{\prime}/\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐚</mi><mo>=</mo><mrow><mo>(</mo><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>,</mo><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo>−</mo><mi>i</mi></mrow><mi>κ</mi></msubsup></msub><mo>)</mo></mrow></mrow><mo>;</mo><mrow><msup><mi>𝐬</mi><mo>′</mo></msup><mo>=</mo><mrow><mo>(</mo><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo>,</mo><mrow><msup><mi>𝐬</mi><mo>′</mo></msup><mo>/</mo><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{a}=\left(\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\mathbf{a}_{\mathcal{N}_{-i}^{\kappa}}\right);\mathbf{s}^{\prime}=\left(\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}},\mathbf{s}^{\prime}/\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}}\right)</annotation></semantics></math> and <math id="A5.SS1.p3.m3" class="ltx_Math" alttext="\mathbf{a}^{\prime}=\left(\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\mathbf{a}^{\prime}_{\mathcal{N}_{-i}^{\kappa}}\right)" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐚</mi><mo>′</mo></msup><mo>=</mo><mrow><mo>(</mo><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>,</mo><msubsup><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo>−</mo><mi>i</mi></mrow><mi>κ</mi></msubsup><mo>′</mo></msubsup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{a}^{\prime}=\left(\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\mathbf{a}^{\prime}_{\mathcal{N}_{-i}^{\kappa}}\right)</annotation></semantics></math>. Let <math id="A5.SS1.p3.m4" class="ltx_Math" alttext="\rho_{t,i}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">\rho_{t,i}</annotation></semantics></math> be the distribution of <math id="A5.SS1.p3.m5" class="ltx_Math" alttext="\left(\mathbf{s}_{i}(t),\mathbf{a}_{i}(t)\right)" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mrow><msub><mi>𝐬</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><annotation encoding="application/x-tex">\left(\mathbf{s}_{i}(t),\mathbf{a}_{i}(t)\right)</annotation></semantics></math> conditioned on <math id="A5.SS1.p3.m6" class="ltx_Math" alttext="(\mathbf{s}(0),\mathbf{a}(0))=(\mathbf{s},\mathbf{a})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐚</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(\mathbf{s}(0),\mathbf{a}(0))=(\mathbf{s},\mathbf{a})</annotation></semantics></math> under policy <math id="A5.SS1.p3.m7" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>, and let <math id="A5.SS1.p3.m8" class="ltx_Math" alttext="\rho_{t,i}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>ρ</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">\rho_{t,i}^{\prime}</annotation></semantics></math> be the distribution of <math id="A5.SS1.p3.m9" class="ltx_Math" alttext="\left(\mathbf{s}_{i}(t),\mathbf{a}_{i}(t)\right)" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mrow><msub><mi>𝐬</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><annotation encoding="application/x-tex">\left(\mathbf{s}_{i}(t),\mathbf{a}_{i}(t)\right)</annotation></semantics></math> conditioned on <math id="A5.SS1.p3.m10" class="ltx_Math" alttext="(\mathbf{s}(0),\mathbf{a}(0))=\left(\mathbf{s}^{\prime},\mathbf{a}^{\prime}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐚</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo>(</mo><msup><mi>𝐬</mi><mo>′</mo></msup><mo>,</mo><msup><mi>𝐚</mi><mo>′</mo></msup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">(\mathbf{s}(0),\mathbf{a}(0))=\left(\mathbf{s}^{\prime},\mathbf{a}^{\prime}\right)</annotation></semantics></math> under policy <math id="A5.SS1.p3.m11" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS1.p4" class="ltx_para">
<p id="A5.SS1.p4.1" class="ltx_p"><span id="A5.SS1.p4.1.1" class="ltx_text">Due to the local dependence structure, and the localized policy structure, <math id="A5.SS1.p4.m1" class="ltx_Math" alttext="\rho_{t,i}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">\rho_{t,i}</annotation></semantics></math> only depends on <math id="A5.SS1.p4.m2" class="ltx_Math" alttext="\left(\mathbf{s}_{\mathcal{N}_{i}^{t}},\mathbf{a}_{\mathcal{N}_{i}^{t}}\right)" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><msub><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>t</mi></msubsup></msub><mo>,</mo><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>t</mi></msubsup></msub><mo>)</mo></mrow><annotation encoding="application/x-tex">\left(\mathbf{s}_{\mathcal{N}_{i}^{t}},\mathbf{a}_{\mathcal{N}_{i}^{t}}\right)</annotation></semantics></math> which is the same as <math id="A5.SS1.p4.m3" class="ltx_Math" alttext="\left(\mathbf{s}_{\mathcal{N}_{i}^{t}}^{\prime},\mathbf{a}_{\mathcal{N}_{i}^{t}}^{\prime}\right)" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>t</mi></msubsup><mo>′</mo></msubsup><mo>,</mo><msubsup><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>t</mi></msubsup><mo>′</mo></msubsup><mo>)</mo></mrow><annotation encoding="application/x-tex">\left(\mathbf{s}_{\mathcal{N}_{i}^{t}}^{\prime},\mathbf{a}_{\mathcal{N}_{i}^{t}}^{\prime}\right)</annotation></semantics></math> when <math id="A5.SS1.p4.m4" class="ltx_Math" alttext="t\leq\kappa" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≤</mo><mi>κ</mi></mrow><annotation encoding="application/x-tex">t\leq\kappa</annotation></semantics></math>. Furthermore, by the definition of ACR, we must have <math id="A5.SS1.p4.m5" class="ltx_Math" alttext="\rho_{t,i}=\rho_{t,i}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>=</mo><msubsup><mi>ρ</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">\rho_{t,i}=\rho_{t,i}^{\prime}</annotation></semantics></math> for all <math id="A5.SS1.p4.m6" class="ltx_Math" alttext="t\leq\kappa" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≤</mo><mi>κ</mi></mrow><annotation encoding="application/x-tex">t\leq\kappa</annotation></semantics></math> per the way the initial state <math id="A5.SS1.p4.m7" class="ltx_Math" alttext="(\mathbf{s},\mathbf{a}),\left(\mathbf{s}^{\prime},\mathbf{a}^{\prime}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo>(</mo><msup><mi>𝐬</mi><mo>′</mo></msup><mo>,</mo><msup><mi>𝐚</mi><mo>′</mo></msup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">(\mathbf{s},\mathbf{a}),\left(\mathbf{s}^{\prime},\mathbf{a}^{\prime}\right)</annotation></semantics></math> are chosen. With these definitions, we expand the definition of <math id="A5.SS1.p4.m8" class="ltx_Math" alttext="Q_{i}^{\pi}" display="inline" intent=":literal"><semantics><msubsup><mi>Q</mi><mi>i</mi><mi>π</mi></msubsup><annotation encoding="application/x-tex">Q_{i}^{\pi}</annotation></semantics></math>,</span></p>
<table id="A5.Ex27" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A5.Ex27X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex27X.m2" class="ltx_Math" alttext="\displaystyle\left|Q_{i}^{\pi}(\mathbf{s},\mathbf{a})-Q_{i}^{\pi}\left(\mathbf{s}^{\prime},\mathbf{a}^{\prime}\right)\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><msubsup><mi>Q</mi><mi>i</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>Q</mi><mi>i</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mi>𝐬</mi><mo>′</mo></msup><mo>,</mo><msup><mi>𝐚</mi><mo>′</mo></msup><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|Q_{i}^{\pi}(\mathbf{s},\mathbf{a})-Q_{i}^{\pi}\left(\mathbf{s}^{\prime},\mathbf{a}^{\prime}\right)\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex27Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex27Xa.m2" class="ltx_Math" alttext="\displaystyle\leq\sum_{t=0}^{\infty}\left|\mathbb{E}\left[\gamma^{t}r_{i}\left(\mathbf{s}_{i}(t),\mathbf{a}_{i}(t)\right)\mid(\mathbf{s}(0),\mathbf{a}(0))=(\mathbf{s},\mathbf{a})\right]-\mathbb{E}\left[\gamma^{t}r_{i}\left(\mathbf{s}_{i}(t),\mathbf{a}_{i}(t)\right)\mid(\mathbf{s}(0),\mathbf{a}(0))=\left(\mathbf{s}^{\prime},\mathbf{a}^{\prime}\right)\right]\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><mo>|</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msup><mi>γ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>𝐬</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐚</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msup><mi>γ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>𝐬</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐚</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo>(</mo><msup><mi>𝐬</mi><mo>′</mo></msup><mo>,</mo><msup><mi>𝐚</mi><mo>′</mo></msup><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{t=0}^{\infty}\left|\mathbb{E}\left[\gamma^{t}r_{i}\left(\mathbf{s}_{i}(t),\mathbf{a}_{i}(t)\right)\mid(\mathbf{s}(0),\mathbf{a}(0))=(\mathbf{s},\mathbf{a})\right]-\mathbb{E}\left[\gamma^{t}r_{i}\left(\mathbf{s}_{i}(t),\mathbf{a}_{i}(t)\right)\mid(\mathbf{s}(0),\mathbf{a}(0))=\left(\mathbf{s}^{\prime},\mathbf{a}^{\prime}\right)\right]\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex27Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex27Xb.m2" class="ltx_Math" alttext="\displaystyle=\sum_{t=0}^{\infty}\left|\gamma^{t}\mathbb{E}_{\left(\mathbf{s}_{i},\mathbf{a}_{i}\right)\sim\rho_{t,i}}r_{i}\left(\mathbf{s}_{i},\mathbf{a}_{i}\right)-\gamma^{t}\mathbb{E}_{\left(\mathbf{s}_{i},\mathbf{a}_{i}\right)\sim\rho_{t,i}^{\prime}}r_{i}\left(\mathbf{s}_{i},\mathbf{a}_{i}\right)\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><mo>|</mo><mrow><mrow><msup><mi>γ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mrow><mo>(</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐚</mi><mi>i</mi></msub><mo>)</mo></mrow><mo>∼</mo><msub><mi>ρ</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐚</mi><mi>i</mi></msub><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>γ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mrow><mo>(</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐚</mi><mi>i</mi></msub><mo>)</mo></mrow><mo>∼</mo><msubsup><mi>ρ</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐚</mi><mi>i</mi></msub><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{t=0}^{\infty}\left|\gamma^{t}\mathbb{E}_{\left(\mathbf{s}_{i},\mathbf{a}_{i}\right)\sim\rho_{t,i}}r_{i}\left(\mathbf{s}_{i},\mathbf{a}_{i}\right)-\gamma^{t}\mathbb{E}_{\left(\mathbf{s}_{i},\mathbf{a}_{i}\right)\sim\rho_{t,i}^{\prime}}r_{i}\left(\mathbf{s}_{i},\mathbf{a}_{i}\right)\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex27Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex27Xc.m2" class="ltx_Math" alttext="\displaystyle=\sum_{t=\kappa+1}^{\infty}\left|\gamma^{t}\mathbb{E}_{\left(\mathbf{s}_{i},\mathbf{a}_{i}\right)\sim\rho_{t,i}}r_{i}\left(\mathbf{s}_{i},\mathbf{a}_{i}\right)-\gamma^{t}\mathbb{E}_{\left(\mathbf{s}_{i},\mathbf{a}_{i}\right)\sim\rho_{t,i}^{\prime}}r_{i}\left(\mathbf{s}_{i},\mathbf{a}_{i}\right)\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><mo>|</mo><mrow><mrow><msup><mi>γ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mrow><mo>(</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐚</mi><mi>i</mi></msub><mo>)</mo></mrow><mo>∼</mo><msub><mi>ρ</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐚</mi><mi>i</mi></msub><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>γ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mrow><mo>(</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐚</mi><mi>i</mi></msub><mo>)</mo></mrow><mo>∼</mo><msubsup><mi>ρ</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐚</mi><mi>i</mi></msub><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{t=\kappa+1}^{\infty}\left|\gamma^{t}\mathbb{E}_{\left(\mathbf{s}_{i},\mathbf{a}_{i}\right)\sim\rho_{t,i}}r_{i}\left(\mathbf{s}_{i},\mathbf{a}_{i}\right)-\gamma^{t}\mathbb{E}_{\left(\mathbf{s}_{i},\mathbf{a}_{i}\right)\sim\rho_{t,i}^{\prime}}r_{i}\left(\mathbf{s}_{i},\mathbf{a}_{i}\right)\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex27Xd"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex27Xd.m2" class="ltx_Math" alttext="\displaystyle\leq\sum_{t=\kappa+1}^{\infty}\gamma^{t}\bar{r}\mathrm{TV}\left(\rho_{t,i},\rho_{t,i}^{\prime}\right)\leq\frac{\bar{r}}{1-\gamma}\gamma^{\kappa+1}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><msup><mi>γ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>r</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>TV</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>ρ</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>,</mo><msubsup><mi>ρ</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup><mo>)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mover accent="true"><mi>r</mi><mo>¯</mo></mover><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{t=\kappa+1}^{\infty}\gamma^{t}\bar{r}\mathrm{TV}\left(\rho_{t,i},\rho_{t,i}^{\prime}\right)\leq\frac{\bar{r}}{1-\gamma}\gamma^{\kappa+1},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p4.2" class="ltx_p"><span id="A5.SS1.p4.2.1" class="ltx_text">where <math id="A5.SS1.p4.m9" class="ltx_Math" alttext="\operatorname{TV}\left(\rho_{t,i},\rho_{t,i}^{\prime}\right)\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>TV</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>ρ</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>,</mo><msubsup><mi>ρ</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup><mo>)</mo></mrow></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\operatorname{TV}\left(\rho_{t,i},\rho_{t,i}^{\prime}\right)\leq 1</annotation></semantics></math> is the total variation distance between <math id="A5.SS1.p4.m10" class="ltx_Math" alttext="\rho_{t,i}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">\rho_{t,i}</annotation></semantics></math> and <math id="A5.SS1.p4.m11" class="ltx_Math" alttext="\rho_{t,i}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>ρ</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">\rho_{t,i}^{\prime}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="A5.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.2 </span>Policy ACR</h3>

<div id="A5.SS2.p1" class="ltx_para">
<p id="A5.SS2.p1.1" class="ltx_p">We begin by presenting Proposition <a href="#Thmproposition6" title="Proposition 6 (Compactness of policy ACR). ‣ E.2 Policy ACR ‣ Appendix E Missing proofs in Section ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> and its proof, which establishes the guarantee of Algorithm <a href="#alg2" title="Algorithm 2 ‣ D.2 Policy ACR ‣ Appendix D Algorithm design ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, and then proceed to the proof of Proposition <a href="#Thmproposition2" title="Proposition 2 (Approximation error). ‣ 3.1 ACR for fixed environment ‣ 3 Approximately compact representation ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.</p>
</div>
<div id="Thmproposition6" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmproposition6.2" class="ltx_text ltx_font_bold">Proposition 6</span></span><span id="Thmproposition6.3" class="ltx_text ltx_font_bold"> </span>(Compactness of policy ACR)<span id="Thmproposition6.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmproposition6.p1" class="ltx_para">
<p id="Thmproposition6.p1.1" class="ltx_p">Let <math id="Thmproposition6.p1.m1" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> be an arbitrary localized policy and <math id="Thmproposition6.p1.m2" class="ltx_Math" alttext="\tilde{\pi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>π</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\pi}</annotation></semantics></math> be the corresponding approximately compact localized policy output by Algorithm <a href="#alg2" title="Algorithm 2 ‣ D.2 Policy ACR ‣ Appendix D Algorithm design ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, for each agent <math id="Thmproposition6.p1.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, and any <math id="Thmproposition6.p1.m4" class="ltx_Math" alttext="(\mathbf{s},\mathbf{a})\in\mathcal{S}\times\mathcal{A}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow></mrow><annotation encoding="application/x-tex">(\mathbf{s},\mathbf{a})\in\mathcal{S}\times\mathcal{A}</annotation></semantics></math>, we have</p>
<table id="A5.Ex28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex28.m1" class="ltx_Math" alttext="Q_{i}^{\tilde{\pi}}(\mathbf{s},\mathbf{a})=Q_{i}^{\pi}(\mathbf{s},\mathbf{a})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>Q</mi><mi>i</mi><mover accent="true"><mi>π</mi><mo>~</mo></mover></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>Q</mi><mi>i</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Q_{i}^{\tilde{\pi}}(\mathbf{s},\mathbf{a})=Q_{i}^{\pi}(\mathbf{s},\mathbf{a}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS2.p2" class="ltx_para">
<p id="A5.SS2.p2.1" class="ltx_p">To prove Proposition <a href="#Thmproposition6" title="Proposition 6 (Compactness of policy ACR). ‣ E.2 Policy ACR ‣ Appendix E Missing proofs in Section ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>, we start with some technical lemmas. Using the definition of policy ACR (Algorithm <a href="#alg2" title="Algorithm 2 ‣ D.2 Policy ACR ‣ Appendix D Algorithm design ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>), we obtain Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ E.2 Policy ACR ‣ Appendix E Missing proofs in Section ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>.</p>
</div>
<div id="Thmlemma3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma3.2" class="ltx_text ltx_font_bold">Lemma 3</span></span><span id="Thmlemma3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma3.p1" class="ltx_para">
<p id="Thmlemma3.p1.1" class="ltx_p">Fix <math id="Thmlemma3.p1.m1" class="ltx_Math" alttext="i\in\mathscr{N}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mi class="ltx_font_mathscript">𝒩</mi></mrow><annotation encoding="application/x-tex">i\in\mathscr{N}</annotation></semantics></math>. For any <math id="Thmlemma3.p1.m2" class="ltx_Math" alttext="j\in[d^{s}_{i}]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>d</mi><mi>i</mi><mi>s</mi></msubsup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[d^{s}_{i}]</annotation></semantics></math>, <math id="Thmlemma3.p1.m3" class="ltx_Math" alttext="s_{i,j}\in\mathbf{s}^{\circ}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>∈</mo><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup></mrow><annotation encoding="application/x-tex">s_{i,j}\in\mathbf{s}^{\circ}_{i}</annotation></semantics></math> if and only if either of the following holds</p>
<ul id="A5.I2" class="ltx_itemize">
<li id="A5.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I2.i1.p1" class="ltx_para">
<p id="A5.I2.i1.p1.1" class="ltx_p">(i) <math id="A5.I2.i1.p1.m1" class="ltx_Math" alttext="s_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">s_{i,j}</annotation></semantics></math> has an edge to <math id="A5.I2.i1.p1.m2" class="ltx_Math" alttext="r_{i}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>i</mi></msub><annotation encoding="application/x-tex">r_{i}</annotation></semantics></math>, or</p>
</div></li>
<li id="A5.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I2.i2.p1" class="ltx_para">
<p id="A5.I2.i2.p1.1" class="ltx_p">(ii) there exists <math id="A5.I2.i2.p1.m1" class="ltx_Math" alttext="i^{\prime}\in\mathscr{N}" display="inline" intent=":literal"><semantics><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathscript">𝒩</mi></mrow><annotation encoding="application/x-tex">i^{\prime}\in\mathscr{N}</annotation></semantics></math> such that there exists a path from <math id="A5.I2.i2.p1.m2" class="ltx_Math" alttext="s_{i,j}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{i,j}(t)</annotation></semantics></math> to <math id="A5.I2.i2.p1.m3" class="ltx_Math" alttext="r_{i^{\prime}}(t+l)" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><msup><mi>i</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r_{i^{\prime}}(t+l)</annotation></semantics></math></p>
<table id="A5.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex29.m1" class="ltx_math_unparsed" alttext="s_{i,j}(t)\rightarrow s_{i(t+1),j(t+1)}(t+1)\rightarrow s_{i(t+2),j(t+2)}(t+2)\cdots\rightarrow s_{i(t+l),j(t+l)}(t+l)\rightarrow r_{i^{\prime}}(t+l)," display="block" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><msub><mi>s</mi><mrow><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><msub><mi>s</mi><mrow><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>+</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em" stretchy="false">→</mo><msub><mi>s</mi><mrow><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>+</mo><mi>l</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><msub><mi>r</mi><msup><mi>i</mi><mo>′</mo></msup></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>+</mo><mi>l</mi><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">s_{i,j}(t)\rightarrow s_{i(t+1),j(t+1)}(t+1)\rightarrow s_{i(t+2),j(t+2)}(t+2)\cdots\rightarrow s_{i(t+l),j(t+l)}(t+l)\rightarrow r_{i^{\prime}}(t+l),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.I2.i2.p1.2" class="ltx_p">where <math id="A5.I2.i2.p1.m4" class="ltx_Math" alttext="i(t+l)=i^{\prime}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mi>i</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">i(t+l)=i^{\prime}</annotation></semantics></math> and <math id="A5.I2.i2.p1.m5" class="ltx_Math" alttext="i(t+m)\in\mathcal{N}_{i(t+m-1)}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>t</mi><mo>+</mo><mi>m</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">i(t+m)\in\mathcal{N}_{i(t+m-1)}</annotation></semantics></math> for any <math id="A5.I2.i2.p1.m6" class="ltx_Math" alttext="m\in[l]" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>l</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">m\in[l]</annotation></semantics></math> and for some <math id="A5.I2.i2.p1.m7" class="ltx_Math" alttext="l\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">l\geq 1</annotation></semantics></math>. Moreover, <math id="A5.I2.i2.p1.m8" class="ltx_Math" alttext="s_{j(t+m),i(t+m)}(t+m)\in\mathbf{s}^{\circ}_{i(t+m)}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>s</mi><mrow><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msubsup><mi>𝐬</mi><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∘</mo></msubsup></mrow><annotation encoding="application/x-tex">s_{j(t+m),i(t+m)}(t+m)\in\mathbf{s}^{\circ}_{i(t+m)}</annotation></semantics></math> for all <math id="A5.I2.i2.p1.m9" class="ltx_Math" alttext="m\in[l]" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>l</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">m\in[l]</annotation></semantics></math>.</p>
</div></li>
</ul>
</div>
</div>
<div id="A5.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ E.2 Policy ACR ‣ Appendix E Missing proofs in Section ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>.</h6>
<div id="A5.SS2.p3" class="ltx_para">
<p id="A5.SS2.p3.1" class="ltx_p"><span id="A5.SS2.p3.1.1" class="ltx_text">We prove this by induction on the iterations of the while loop in Algorithm <a href="#alg2" title="Algorithm 2 ‣ D.2 Policy ACR ‣ Appendix D Algorithm design ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.</span></p>
</div>
<div id="A5.SS2.p4" class="ltx_para">
<p id="A5.SS2.p4.1" class="ltx_p"><span id="A5.SS2.p4.1.1" class="ltx_text ltx_font_bold">Base case:<span id="A5.SS2.p4.1.1.1" class="ltx_text ltx_font_medium"> After initialization (lines 2-8 of Algorithm <a href="#alg2" title="Algorithm 2 ‣ D.2 Policy ACR ‣ Appendix D Algorithm design ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>), <math id="A5.SS2.p4.m1" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{i}</annotation></semantics></math> contains exactly those state components <math id="A5.SS2.p4.m2" class="ltx_Math" alttext="s_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">s_{i,j}</annotation></semantics></math> that have a direct edge to <math id="A5.SS2.p4.m3" class="ltx_Math" alttext="r_{i}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>i</mi></msub><annotation encoding="application/x-tex">r_{i}</annotation></semantics></math> (i.e., where <math id="A5.SS2.p4.m4" class="ltx_Math" alttext="\mathbf{c}^{s\to r}_{i,j}=1" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐜</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mi>s</mi><mo stretchy="false">→</mo><mi>r</mi></mrow></msubsup><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\mathbf{c}^{s\to r}_{i,j}=1</annotation></semantics></math>). This corresponds precisely to condition (i).</span></span></p>
</div>
<div id="A5.SS2.p5" class="ltx_para">
<p id="A5.SS2.p5.1" class="ltx_p"><span id="A5.SS2.p5.1.1" class="ltx_text ltx_font_bold">Inductive hypothesis:<span id="A5.SS2.p5.1.1.1" class="ltx_text ltx_font_medium"> Suppose that after <math id="A5.SS2.p5.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> iterations of the while loop, for any agent <math id="A5.SS2.p5.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> and component <math id="A5.SS2.p5.m3" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>, <math id="A5.SS2.p5.m4" class="ltx_Math" alttext="s_{i,j}\in\mathbf{s}^{\circ}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>∈</mo><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup></mrow><annotation encoding="application/x-tex">s_{i,j}\in\mathbf{s}^{\circ}_{i}</annotation></semantics></math> if and only if either:</span></span></p>
<ul id="A5.I3" class="ltx_itemize">
<li id="A5.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I3.i1.p1" class="ltx_para">
<p id="A5.I3.i1.p1.1" class="ltx_p"><math id="A5.I3.i1.p1.m1" class="ltx_Math" alttext="s_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">s_{i,j}</annotation></semantics></math> has a direct edge to <math id="A5.I3.i1.p1.m2" class="ltx_Math" alttext="r_{i}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>i</mi></msub><annotation encoding="application/x-tex">r_{i}</annotation></semantics></math>, or</p>
</div></li>
<li id="A5.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I3.i2.p1" class="ltx_para">
<p id="A5.I3.i2.p1.1" class="ltx_p">there exists a path from <math id="A5.I3.i2.p1.m1" class="ltx_Math" alttext="s_{i,j}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{i,j}(t)</annotation></semantics></math> to some <math id="A5.I3.i2.p1.m2" class="ltx_Math" alttext="r_{i^{\prime}}(t+m)" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><msup><mi>i</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r_{i^{\prime}}(t+m)</annotation></semantics></math> where <math id="A5.I3.i2.p1.m3" class="ltx_Math" alttext="m\leq k" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≤</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">m\leq k</annotation></semantics></math>, such that all intermediate state components are in their respective <math id="A5.I3.i2.p1.m4" class="ltx_Math" alttext="\mathbf{s}^{\circ}" display="inline" intent=":literal"><semantics><msup><mi>𝐬</mi><mo>∘</mo></msup><annotation encoding="application/x-tex">\mathbf{s}^{\circ}</annotation></semantics></math> sets, and each consecutive agent in the path is a neighbor of the previous agent.</p>
</div></li>
</ul>
</div>
<div id="A5.SS2.p6" class="ltx_para">
<p id="A5.SS2.p6.1" class="ltx_p"><span id="A5.SS2.p6.1.1" class="ltx_text ltx_font_bold">Inductive step:<span id="A5.SS2.p6.1.1.1" class="ltx_text ltx_font_medium"> Consider the <math id="A5.SS2.p6.m1" class="ltx_Math" alttext="(k+1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(k+1)</annotation></semantics></math>-th iteration. In this iteration, according to Algorithm <a href="#alg2" title="Algorithm 2 ‣ D.2 Policy ACR ‣ Appendix D Algorithm design ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> (lines 10-17), we add <math id="A5.SS2.p6.m2" class="ltx_Math" alttext="s_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">s_{i,j}</annotation></semantics></math> to <math id="A5.SS2.p6.m3" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{i}</annotation></semantics></math> if there is an edge from <math id="A5.SS2.p6.m4" class="ltx_Math" alttext="s_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">s_{i,j}</annotation></semantics></math> to some component of <math id="A5.SS2.p6.m5" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{\mathcal{N}_{i}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{\mathcal{N}_{i}}</annotation></semantics></math>, where <math id="A5.SS2.p6.m6" class="ltx_math_unparsed" alttext="\mathbf{s}^{\circ}_{\mathcal{N}_{i}}=\cup_{i^{\prime}\in N_{i}}\mathbf{s}^{\circ}_{i^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐬</mi><msup><mrow></mrow><mo>∘</mo></msup><msub><mrow></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo rspace="0em">=</mo><mo lspace="0em">∪</mo><msub><mrow></mrow><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>∈</mo><msub><mi>N</mi><mi>i</mi></msub></mrow></msub><mi>𝐬</mi><msup><mrow></mrow><mo>∘</mo></msup><msub><mrow></mrow><msup><mi>i</mi><mo>′</mo></msup></msub></mrow><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{\mathcal{N}_{i}}=\cup_{i^{\prime}\in N_{i}}\mathbf{s}^{\circ}_{i^{\prime}}</annotation></semantics></math> contains all minimal components of <math id="A5.SS2.p6.m7" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>’s neighbors from the previous iterations.</span></span></p>
</div>
<div id="A5.SS2.p7" class="ltx_para">
<p id="A5.SS2.p7.1" class="ltx_p"><span id="A5.SS2.p7.1.1" class="ltx_text">By the inductive hypothesis, for any <math id="A5.SS2.p7.m1" class="ltx_Math" alttext="i^{\prime}\in\mathcal{N}_{i}" display="inline" intent=":literal"><semantics><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">i^{\prime}\in\mathcal{N}_{i}</annotation></semantics></math> and any component <math id="A5.SS2.p7.m2" class="ltx_Math" alttext="j^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>j</mi><mo>′</mo></msup><annotation encoding="application/x-tex">j^{\prime}</annotation></semantics></math>, <math id="A5.SS2.p7.m3" class="ltx_Math" alttext="s_{i^{\prime},j^{\prime}}\in\mathbf{s}^{\circ}_{i^{\prime}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>,</mo><msup><mi>j</mi><mo>′</mo></msup></mrow></msub><mo>∈</mo><msubsup><mi>𝐬</mi><msup><mi>i</mi><mo>′</mo></msup><mo>∘</mo></msubsup></mrow><annotation encoding="application/x-tex">s_{i^{\prime},j^{\prime}}\in\mathbf{s}^{\circ}_{i^{\prime}}</annotation></semantics></math> if and only if either:</span></p>
<ul id="A5.I4" class="ltx_itemize">
<li id="A5.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I4.i1.p1" class="ltx_para">
<p id="A5.I4.i1.p1.1" class="ltx_p"><math id="A5.I4.i1.p1.m1" class="ltx_Math" alttext="s_{i^{\prime},j^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>,</mo><msup><mi>j</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">s_{i^{\prime},j^{\prime}}</annotation></semantics></math> has a direct edge to <math id="A5.I4.i1.p1.m2" class="ltx_Math" alttext="r_{i^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><msup><mi>i</mi><mo>′</mo></msup></msub><annotation encoding="application/x-tex">r_{i^{\prime}}</annotation></semantics></math>, or</p>
</div></li>
<li id="A5.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I4.i2.p1" class="ltx_para">
<p id="A5.I4.i2.p1.1" class="ltx_p">there exists a path from <math id="A5.I4.i2.p1.m1" class="ltx_Math" alttext="s_{i^{\prime},j^{\prime}}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>,</mo><msup><mi>j</mi><mo>′</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{i^{\prime},j^{\prime}}(t)</annotation></semantics></math> to some <math id="A5.I4.i2.p1.m2" class="ltx_Math" alttext="r_{i^{\prime\prime}}(t+m)" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><msup><mi>i</mi><mo>′′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r_{i^{\prime\prime}}(t+m)</annotation></semantics></math> where <math id="A5.I4.i2.p1.m3" class="ltx_Math" alttext="m\leq k" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≤</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">m\leq k</annotation></semantics></math>, with all intermediate components in their respective <math id="A5.I4.i2.p1.m4" class="ltx_Math" alttext="\mathbf{s}^{\circ}" display="inline" intent=":literal"><semantics><msup><mi>𝐬</mi><mo>∘</mo></msup><annotation encoding="application/x-tex">\mathbf{s}^{\circ}</annotation></semantics></math> sets.</p>
</div></li>
</ul>
</div>
<div id="A5.SS2.p8" class="ltx_para">
<p id="A5.SS2.p8.1" class="ltx_p"><span id="A5.SS2.p8.1.1" class="ltx_text ltx_font_bold">Forward direction:<span id="A5.SS2.p8.1.1.1" class="ltx_text ltx_font_medium"> Suppose <math id="A5.SS2.p8.m1" class="ltx_Math" alttext="s_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">s_{i,j}</annotation></semantics></math> is added to <math id="A5.SS2.p8.m2" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{i}</annotation></semantics></math> in the <math id="A5.SS2.p8.m3" class="ltx_Math" alttext="(k+1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(k+1)</annotation></semantics></math>-th iteration. Then there must be an edge from <math id="A5.SS2.p8.m4" class="ltx_Math" alttext="s_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">s_{i,j}</annotation></semantics></math> to some component <math id="A5.SS2.p8.m5" class="ltx_Math" alttext="s_{i^{\prime},j^{\prime}}\in\mathbf{s}^{\circ}_{i^{\prime}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>,</mo><msup><mi>j</mi><mo>′</mo></msup></mrow></msub><mo>∈</mo><msubsup><mi>𝐬</mi><msup><mi>i</mi><mo>′</mo></msup><mo>∘</mo></msubsup></mrow><annotation encoding="application/x-tex">s_{i^{\prime},j^{\prime}}\in\mathbf{s}^{\circ}_{i^{\prime}}</annotation></semantics></math> for some <math id="A5.SS2.p8.m6" class="ltx_Math" alttext="i^{\prime}\in\mathcal{N}_{i}" display="inline" intent=":literal"><semantics><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">i^{\prime}\in\mathcal{N}_{i}</annotation></semantics></math>. By the inductive hypothesis, either:</span></span></p>
</div>
<div id="A5.SS2.p9" class="ltx_para">
<p id="A5.SS2.p9.1" class="ltx_p"><span id="A5.SS2.p9.1.1" class="ltx_text">Case 1: If <math id="A5.SS2.p9.m1" class="ltx_Math" alttext="s_{i^{\prime},j^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>,</mo><msup><mi>j</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">s_{i^{\prime},j^{\prime}}</annotation></semantics></math> has a direct edge to <math id="A5.SS2.p9.m2" class="ltx_Math" alttext="r_{i^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><msup><mi>i</mi><mo>′</mo></msup></msub><annotation encoding="application/x-tex">r_{i^{\prime}}</annotation></semantics></math>, then we have a path:</span></p>
<table id="A5.Ex30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex30.m1" class="ltx_Math" alttext="s_{i,j}(t)\to s_{i^{\prime},j^{\prime}}(t+1)\to r_{i^{\prime}}(t+1)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi>s</mi><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>,</mo><msup><mi>j</mi><mo>′</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi>r</mi><msup><mi>i</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">s_{i,j}(t)\to s_{i^{\prime},j^{\prime}}(t+1)\to r_{i^{\prime}}(t+1),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p9.2" class="ltx_p"><span id="A5.SS2.p9.2.1" class="ltx_text">which is a path of length 2 (<math id="A5.SS2.p9.m3" class="ltx_Math" alttext="l=1" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">l=1</annotation></semantics></math>) from <math id="A5.SS2.p9.m4" class="ltx_Math" alttext="s_{i,j}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{i,j}(t)</annotation></semantics></math> to <math id="A5.SS2.p9.m5" class="ltx_Math" alttext="r_{i^{\prime}}(t+1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><msup><mi>i</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r_{i^{\prime}}(t+1)</annotation></semantics></math>, satisfying condition (ii).</span></p>
</div>
<div id="A5.SS2.p10" class="ltx_para">
<p id="A5.SS2.p10.1" class="ltx_p"><span id="A5.SS2.p10.1.1" class="ltx_text">Case 2: If there is a path from <math id="A5.SS2.p10.m1" class="ltx_Math" alttext="s_{i^{\prime},j^{\prime}}(t+1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>,</mo><msup><mi>j</mi><mo>′</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{i^{\prime},j^{\prime}}(t+1)</annotation></semantics></math> to <math id="A5.SS2.p10.m2" class="ltx_Math" alttext="r_{i^{\prime\prime}}(t+1+m)" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><msup><mi>i</mi><mo>′′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r_{i^{\prime\prime}}(t+1+m)</annotation></semantics></math> for some <math id="A5.SS2.p10.m3" class="ltx_Math" alttext="m\leq k" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≤</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">m\leq k</annotation></semantics></math>, then we have a longer path:</span></p>
<table id="A5.Ex31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex31.m1" class="ltx_Math" alttext="s_{i,j}(t)\to s_{i^{\prime},j^{\prime}}(t+1)\to\cdots\to r_{i^{\prime\prime}}(t+1+m)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi>s</mi><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>,</mo><msup><mi>j</mi><mo>′</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em" stretchy="false">→</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em" stretchy="false">→</mo><mrow><msub><mi>r</mi><msup><mi>i</mi><mo>′′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">s_{i,j}(t)\to s_{i^{\prime},j^{\prime}}(t+1)\to\cdots\to r_{i^{\prime\prime}}(t+1+m),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p10.2" class="ltx_p"><span id="A5.SS2.p10.2.1" class="ltx_text">which is a path of length <math id="A5.SS2.p10.m4" class="ltx_Math" alttext="m+2" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>+</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">m+2</annotation></semantics></math> (<math id="A5.SS2.p10.m5" class="ltx_Math" alttext="l=m+1\leq k+1" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>=</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo>≤</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">l=m+1\leq k+1</annotation></semantics></math>) from <math id="A5.SS2.p10.m6" class="ltx_Math" alttext="s_{i,j}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{i,j}(t)</annotation></semantics></math> to <math id="A5.SS2.p10.m7" class="ltx_Math" alttext="r_{i^{\prime\prime}}(t+1+m)" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><msup><mi>i</mi><mo>′′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r_{i^{\prime\prime}}(t+1+m)</annotation></semantics></math>, satisfying condition (ii).</span></p>
</div>
<div id="A5.SS2.p11" class="ltx_para">
<p id="A5.SS2.p11.1" class="ltx_p"><span id="A5.SS2.p11.1.1" class="ltx_text">In both cases, <math id="A5.SS2.p11.m1" class="ltx_Math" alttext="i^{\prime}\in\mathcal{N}_{i}" display="inline" intent=":literal"><semantics><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">i^{\prime}\in\mathcal{N}_{i}</annotation></semantics></math> (the neighborhood constraint is satisfied), and all intermediate state components are in their respective <math id="A5.SS2.p11.m2" class="ltx_Math" alttext="\mathbf{s}^{\circ}" display="inline" intent=":literal"><semantics><msup><mi>𝐬</mi><mo>∘</mo></msup><annotation encoding="application/x-tex">\mathbf{s}^{\circ}</annotation></semantics></math> sets by the inductive hypothesis.</span></p>
</div>
<div id="A5.SS2.p12" class="ltx_para">
<p id="A5.SS2.p12.1" class="ltx_p"><span id="A5.SS2.p12.1.1" class="ltx_text ltx_font_bold">Backward direction:<span id="A5.SS2.p12.1.1.1" class="ltx_text ltx_font_medium"> Conversely, suppose there exists a path from <math id="A5.SS2.p12.m1" class="ltx_Math" alttext="s_{i,j}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{i,j}(t)</annotation></semantics></math> to <math id="A5.SS2.p12.m2" class="ltx_Math" alttext="r_{i^{\prime}}(t+l)" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><msup><mi>i</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r_{i^{\prime}}(t+l)</annotation></semantics></math> for some <math id="A5.SS2.p12.m3" class="ltx_Math" alttext="l\leq k+1" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>≤</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">l\leq k+1</annotation></semantics></math>, where all intermediate components are in their respective <math id="A5.SS2.p12.m4" class="ltx_Math" alttext="\mathbf{s}^{\circ}" display="inline" intent=":literal"><semantics><msup><mi>𝐬</mi><mo>∘</mo></msup><annotation encoding="application/x-tex">\mathbf{s}^{\circ}</annotation></semantics></math> sets and each agent is a neighbor of the previous agent.</span></span></p>
</div>
<div id="A5.SS2.p13" class="ltx_para">
<p id="A5.SS2.p13.1" class="ltx_p"><span id="A5.SS2.p13.1.1" class="ltx_text">If <math id="A5.SS2.p13.m1" class="ltx_Math" alttext="l=0" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">l=0</annotation></semantics></math>, then <math id="A5.SS2.p13.m2" class="ltx_Math" alttext="s_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">s_{i,j}</annotation></semantics></math> has a direct edge to <math id="A5.SS2.p13.m3" class="ltx_Math" alttext="r_{i}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>i</mi></msub><annotation encoding="application/x-tex">r_{i}</annotation></semantics></math> (condition (i)), so <math id="A5.SS2.p13.m4" class="ltx_Math" alttext="s_{i,j}\in\mathbf{s}^{\circ}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>∈</mo><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup></mrow><annotation encoding="application/x-tex">s_{i,j}\in\mathbf{s}^{\circ}_{i}</annotation></semantics></math> after initialization.</span></p>
</div>
<div id="A5.SS2.p14" class="ltx_para">
<p id="A5.SS2.p14.1" class="ltx_p"><span id="A5.SS2.p14.1.1" class="ltx_text">If <math id="A5.SS2.p14.m1" class="ltx_Math" alttext="l\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">l\geq 1</annotation></semantics></math>, consider the path:</span></p>
<table id="A5.Ex32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex32.m1" class="ltx_Math" alttext="s_{i,j}(t)\to s_{i(t+1),j(t+1)}(t+1)\to\cdots\to r_{i^{\prime}}(t+l)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi>s</mi><mrow><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em" stretchy="false">→</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em" stretchy="false">→</mo><mrow><msub><mi>r</mi><msup><mi>i</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">s_{i,j}(t)\to s_{i(t+1),j(t+1)}(t+1)\to\cdots\to r_{i^{\prime}}(t+l).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p14.2" class="ltx_p"><span id="A5.SS2.p14.2.1" class="ltx_text">The first transition in this path is from <math id="A5.SS2.p14.m2" class="ltx_Math" alttext="s_{i,j}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{i,j}(t)</annotation></semantics></math> to <math id="A5.SS2.p14.m3" class="ltx_Math" alttext="s_{i(t+1),j(t+1)}(t+1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{i(t+1),j(t+1)}(t+1)</annotation></semantics></math>, where <math id="A5.SS2.p14.m4" class="ltx_Math" alttext="i(t+1)\in N_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msub><mi>N</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">i(t+1)\in N_{i}</annotation></semantics></math> (by the neighborhood constraint). By the path condition, <math id="A5.SS2.p14.m5" class="ltx_Math" alttext="s_{i(t+1),j(t+1)}(t+1)\in\mathbf{s}^{\circ}_{i(t+1)}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>s</mi><mrow><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msubsup><mi>𝐬</mi><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∘</mo></msubsup></mrow><annotation encoding="application/x-tex">s_{i(t+1),j(t+1)}(t+1)\in\mathbf{s}^{\circ}_{i(t+1)}</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS2.p15" class="ltx_para">
<p id="A5.SS2.p15.1" class="ltx_p"><span id="A5.SS2.p15.1.1" class="ltx_text">Furthermore, there exists a path from <math id="A5.SS2.p15.m1" class="ltx_Math" alttext="s_{i(t+1),j(t+1)}(t+1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{i(t+1),j(t+1)}(t+1)</annotation></semantics></math> to <math id="A5.SS2.p15.m2" class="ltx_Math" alttext="r_{i^{\prime}}(t+l)" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><msup><mi>i</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r_{i^{\prime}}(t+l)</annotation></semantics></math> of length <math id="A5.SS2.p15.m3" class="ltx_Math" alttext="l-1\leq k" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo>≤</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">l-1\leq k</annotation></semantics></math>. By the inductive hypothesis, <math id="A5.SS2.p15.m4" class="ltx_Math" alttext="s_{i(t+1),j(t+1)}\in\mathbf{s}^{\circ}_{i(t+1)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo>∈</mo><msubsup><mi>𝐬</mi><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∘</mo></msubsup></mrow><annotation encoding="application/x-tex">s_{i(t+1),j(t+1)}\in\mathbf{s}^{\circ}_{i(t+1)}</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS2.p16" class="ltx_para">
<p id="A5.SS2.p16.1" class="ltx_p"><span id="A5.SS2.p16.1.1" class="ltx_text">Since <math id="A5.SS2.p16.m1" class="ltx_Math" alttext="i(t+1)\in\mathcal{N}_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">i(t+1)\in\mathcal{N}_{i}</annotation></semantics></math>, we have <math id="A5.SS2.p16.m2" class="ltx_Math" alttext="s_{i(t+1),j(t+1)}\in\mathbf{s}^{\circ}_{\mathcal{N}_{i}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo>∈</mo><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup></mrow><annotation encoding="application/x-tex">s_{i(t+1),j(t+1)}\in\mathbf{s}^{\circ}_{\mathcal{N}_{i}}</annotation></semantics></math>. Therefore, there is an edge from <math id="A5.SS2.p16.m3" class="ltx_Math" alttext="s_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">s_{i,j}</annotation></semantics></math> to a component in <math id="A5.SS2.p16.m4" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{\mathcal{N}_{i}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{\mathcal{N}_{i}}</annotation></semantics></math>, which means <math id="A5.SS2.p16.m5" class="ltx_Math" alttext="s_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">s_{i,j}</annotation></semantics></math> will be added to <math id="A5.SS2.p16.m6" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{i}</annotation></semantics></math> in the <math id="A5.SS2.p16.m7" class="ltx_Math" alttext="(k+1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(k+1)</annotation></semantics></math>-th iteration (or earlier).</span></p>
</div>
<div id="A5.SS2.p17" class="ltx_para">
<p id="A5.SS2.p17.1" class="ltx_p"><span id="A5.SS2.p17.1.1" class="ltx_text">By induction, <math id="A5.SS2.p17.m1" class="ltx_Math" alttext="s_{i,j}\in\mathbf{s}^{\circ}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>∈</mo><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup></mrow><annotation encoding="application/x-tex">s_{i,j}\in\mathbf{s}^{\circ}_{i}</annotation></semantics></math> if and only if either condition (i) or condition (ii) holds, completing the proof.
∎</span></p>
</div>
</div>
<div id="Thmlemma4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma4.2" class="ltx_text ltx_font_bold">Lemma 4</span></span><span id="Thmlemma4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma4.p1" class="ltx_para">
<p id="Thmlemma4.p1.1" class="ltx_p">Fix <math id="Thmlemma4.p1.m1" class="ltx_Math" alttext="i\in\mathscr{N}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mi class="ltx_font_mathscript">𝒩</mi></mrow><annotation encoding="application/x-tex">i\in\mathscr{N}</annotation></semantics></math>. For any <math id="Thmlemma4.p1.m2" class="ltx_Math" alttext="j\in[d^{s}_{i}]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>d</mi><mi>i</mi><mi>s</mi></msubsup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[d^{s}_{i}]</annotation></semantics></math>, <math id="Thmlemma4.p1.m3" class="ltx_Math" alttext="s_{i,j}\not\in\mathbf{s}^{\circ}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>∉</mo><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup></mrow><annotation encoding="application/x-tex">s_{i,j}\not\in\mathbf{s}^{\circ}_{i}</annotation></semantics></math>, if and only if each of the following holds</p>
<ul id="A5.I5" class="ltx_itemize">
<li id="A5.I5.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I5.i1.p1" class="ltx_para">
<p id="A5.I5.i1.p1.1" class="ltx_p">(i) <math id="A5.I5.i1.p1.m1" class="ltx_Math" alttext="s_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">s_{i,j}</annotation></semantics></math> does not have an edge to <math id="A5.I5.i1.p1.m2" class="ltx_Math" alttext="r_{i}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>i</mi></msub><annotation encoding="application/x-tex">r_{i}</annotation></semantics></math></p>
</div></li>
<li id="A5.I5.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I5.i2.p1" class="ltx_para">
<p id="A5.I5.i2.p1.1" class="ltx_p">(ii) for any <math id="A5.I5.i2.p1.m1" class="ltx_Math" alttext="i^{\prime}\in\mathscr{N}" display="inline" intent=":literal"><semantics><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathscript">𝒩</mi></mrow><annotation encoding="application/x-tex">i^{\prime}\in\mathscr{N}</annotation></semantics></math>, there exists no path from <math id="A5.I5.i2.p1.m2" class="ltx_Math" alttext="s_{i,j}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{i,j}(t)</annotation></semantics></math> to <math id="A5.I5.i2.p1.m3" class="ltx_Math" alttext="r_{i^{\prime}}(t+l)" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><msup><mi>i</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r_{i^{\prime}}(t+l)</annotation></semantics></math> for some <math id="A5.I5.i2.p1.m4" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math></p>
</div></li>
</ul>
</div>
</div>
<div id="A5.SS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Lemma <a href="#Thmlemma4" title="Lemma 4. ‣ E.2 Policy ACR ‣ Appendix E Missing proofs in Section ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>.</h6>
<div id="A5.SS2.p18" class="ltx_para">
<p id="A5.SS2.p18.1" class="ltx_p"><span id="A5.SS2.p18.1.1" class="ltx_text">This lemma is the logical contrapositive of Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ E.2 Policy ACR ‣ Appendix E Missing proofs in Section ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>. Let’s formalize this relationship.</span></p>
</div>
<div id="A5.SS2.p19" class="ltx_para">
<p id="A5.SS2.p19.1" class="ltx_p"><span id="A5.SS2.p19.1.1" class="ltx_text">Lemma 3 states that <math id="A5.SS2.p19.m1" class="ltx_Math" alttext="s_{i,j}\in\mathbf{s}^{\circ}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>∈</mo><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup></mrow><annotation encoding="application/x-tex">s_{i,j}\in\mathbf{s}^{\circ}_{i}</annotation></semantics></math> if and only if either:</span></p>
<ul id="A5.I6" class="ltx_itemize">
<li id="A5.I6.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I6.i1.p1" class="ltx_para">
<p id="A5.I6.i1.p1.1" class="ltx_p"><math id="A5.I6.i1.p1.m1" class="ltx_Math" alttext="s_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">s_{i,j}</annotation></semantics></math> has an edge to <math id="A5.I6.i1.p1.m2" class="ltx_Math" alttext="r_{i}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>i</mi></msub><annotation encoding="application/x-tex">r_{i}</annotation></semantics></math>, or</p>
</div></li>
<li id="A5.I6.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I6.i2.p1" class="ltx_para">
<p id="A5.I6.i2.p1.1" class="ltx_p">There exists <math id="A5.I6.i2.p1.m1" class="ltx_Math" alttext="i^{\prime}\in\mathscr{N}" display="inline" intent=":literal"><semantics><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathscript">𝒩</mi></mrow><annotation encoding="application/x-tex">i^{\prime}\in\mathscr{N}</annotation></semantics></math> and there exists a path from <math id="A5.I6.i2.p1.m2" class="ltx_Math" alttext="s_{i,j}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{i,j}(t)</annotation></semantics></math> to <math id="A5.I6.i2.p1.m3" class="ltx_Math" alttext="r_{i^{\prime}}(t+l)" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><msup><mi>i</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r_{i^{\prime}}(t+l)</annotation></semantics></math> satisfying certain constraints.</p>
</div></li>
</ul>
</div>
<div id="A5.SS2.p20" class="ltx_para">
<p id="A5.SS2.p20.1" class="ltx_p"><span id="A5.SS2.p20.1.1" class="ltx_text">The logical form of Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ E.2 Policy ACR ‣ Appendix E Missing proofs in Section ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> can be written as: <math id="A5.SS2.p20.m1" class="ltx_Math" alttext="s_{i,j}\in\mathbf{s}^{\circ}_{i}\iff(A)\lor(B)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>∈</mo><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo stretchy="false">⇔</mo><mrow><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mo>∨</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s_{i,j}\in\mathbf{s}^{\circ}_{i}\iff(A)\lor(B)</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS2.p21" class="ltx_para">
<p id="A5.SS2.p21.1" class="ltx_p"><span id="A5.SS2.p21.1.1" class="ltx_text">The contrapositive of this statement is: <math id="A5.SS2.p21.m1" class="ltx_Math" alttext="s_{i,j}\not\in\mathbf{s}^{\circ}_{i}\iff\neg((A)\lor(B))" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>∉</mo><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo stretchy="false">⇔</mo><mrow><mo>¬</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mo>∨</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s_{i,j}\not\in\mathbf{s}^{\circ}_{i}\iff\neg((A)\lor(B))</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS2.p22" class="ltx_para">
<p id="A5.SS2.p22.1" class="ltx_p"><span id="A5.SS2.p22.1.1" class="ltx_text">Using De Morgan’s laws, <math id="A5.SS2.p22.m1" class="ltx_Math" alttext="\neg((A)\lor(B))\iff\neg(A)\land\neg(B)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>¬</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mo>∨</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⇔</mo><mrow><mrow><mo>¬</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∧</mo><mrow><mo>¬</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\neg((A)\lor(B))\iff\neg(A)\land\neg(B)</annotation></semantics></math>, which gives us:</span></p>
</div>
<div id="A5.SS2.p23" class="ltx_para">
<p id="A5.SS2.p23.1" class="ltx_p"><math id="A5.SS2.p23.m1" class="ltx_Math" alttext="s_{i,j}\not\in\mathbf{s}^{\circ}_{i}\iff\neg(A)\land\neg(B)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>∉</mo><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo stretchy="false">⇔</mo><mrow><mrow><mo>¬</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∧</mo><mrow><mo>¬</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">s_{i,j}\not\in\mathbf{s}^{\circ}_{i}\iff\neg(A)\land\neg(B)</annotation></semantics></math><span id="A5.SS2.p23.1.1" class="ltx_text">, where:</span></p>
<ul id="A5.I7" class="ltx_itemize">
<li id="A5.I7.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I7.i1.p1" class="ltx_para">
<p id="A5.I7.i1.p1.1" class="ltx_p"><math id="A5.I7.i1.p1.m1" class="ltx_Math" alttext="\neg(A)" display="inline" intent=":literal"><semantics><mrow><mo>¬</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\neg(A)</annotation></semantics></math>: <math id="A5.I7.i1.p1.m2" class="ltx_Math" alttext="s_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">s_{i,j}</annotation></semantics></math> does not have an edge to <math id="A5.I7.i1.p1.m3" class="ltx_Math" alttext="r_{i}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>i</mi></msub><annotation encoding="application/x-tex">r_{i}</annotation></semantics></math></p>
</div></li>
<li id="A5.I7.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I7.i2.p1" class="ltx_para">
<p id="A5.I7.i2.p1.1" class="ltx_p"><math id="A5.I7.i2.p1.m1" class="ltx_Math" alttext="\neg(B)" display="inline" intent=":literal"><semantics><mrow><mo>¬</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\neg(B)</annotation></semantics></math>: For all <math id="A5.I7.i2.p1.m2" class="ltx_Math" alttext="i^{\prime}\in\mathscr{N}" display="inline" intent=":literal"><semantics><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathscript">𝒩</mi></mrow><annotation encoding="application/x-tex">i^{\prime}\in\mathscr{N}</annotation></semantics></math> and for all <math id="A5.I7.i2.p1.m3" class="ltx_Math" alttext="l\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">l\geq 1</annotation></semantics></math>, there exists no path from <math id="A5.I7.i2.p1.m4" class="ltx_Math" alttext="s_{i,j}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{i,j}(t)</annotation></semantics></math> to <math id="A5.I7.i2.p1.m5" class="ltx_Math" alttext="r_{i^{\prime}}(t+l)" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><msup><mi>i</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r_{i^{\prime}}(t+l)</annotation></semantics></math> that satisfies the constraints on intermediate nodes.</p>
</div></li>
</ul>
</div>
<div id="A5.SS2.p24" class="ltx_para">
<p id="A5.SS2.p24.1" class="ltx_p"><span id="A5.SS2.p24.1.1" class="ltx_text">These are precisely the conditions (i) and (ii) in Lemma <a href="#Thmlemma4" title="Lemma 4. ‣ E.2 Policy ACR ‣ Appendix E Missing proofs in Section ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>. Therefore, by the logical equivalence of a statement and its contrapositive, Lemma <a href="#Thmlemma4" title="Lemma 4. ‣ E.2 Policy ACR ‣ Appendix E Missing proofs in Section ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> is proved.
∎</span></p>
</div>
</div>
<div id="A5.SS2.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Proposition <a href="#Thmproposition6" title="Proposition 6 (Compactness of policy ACR). ‣ E.2 Policy ACR ‣ Appendix E Missing proofs in Section ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>.</h6>
<div id="A5.SS2.p25" class="ltx_para">
<p id="A5.SS2.p25.1" class="ltx_p"><span id="A5.SS2.p25.1.1" class="ltx_text">We will prove that the <math id="A5.SS2.p25.m1" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>-functions are identical by showing that the distribution of rewards collected under both policies is identical. This follows if we can establish that the relevant state-action trajectories have the same distribution under both policies.</span></p>
</div>
<div id="A5.SS2.p26" class="ltx_para">
<p id="A5.SS2.p26.1" class="ltx_p"><span id="A5.SS2.p26.1.1" class="ltx_text">Let us define:</span></p>
<ul id="A5.I8" class="ltx_itemize">
<li id="A5.I8.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I8.i1.p1" class="ltx_para">
<p id="A5.I8.i1.p1.1" class="ltx_p"><math id="A5.I8.i1.p1.m1" class="ltx_math_unparsed" alttext="\rho^{\pi}_{t}(\mathbf{s}(t),\mathbf{a}(t)|\mathbf{s}(0)=\mathbf{s},\mathbf{a}(0)=\mathbf{a})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ρ</mi><mi>t</mi><mi>π</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>𝐚</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐬</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho^{\pi}_{t}(\mathbf{s}(t),\mathbf{a}(t)|\mathbf{s}(0)=\mathbf{s},\mathbf{a}(0)=\mathbf{a})</annotation></semantics></math>: The probability of being in state-action pair <math id="A5.I8.i1.p1.m2" class="ltx_Math" alttext="(\mathbf{s}(t),\mathbf{a}(t))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐚</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbf{s}(t),\mathbf{a}(t))</annotation></semantics></math> at time <math id="A5.I8.i1.p1.m3" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, starting from <math id="A5.I8.i1.p1.m4" class="ltx_Math" alttext="(\mathbf{s}(0)=\mathbf{s},\mathbf{a}(0)=\mathbf{a})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>𝐬</mi></mrow><mo>,</mo><mrow><mrow><mi>𝐚</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>𝐚</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbf{s}(0)=\mathbf{s},\mathbf{a}(0)=\mathbf{a})</annotation></semantics></math> and following policy <math id="A5.I8.i1.p1.m5" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>.</p>
</div></li>
<li id="A5.I8.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I8.i2.p1" class="ltx_para">
<p id="A5.I8.i2.p1.1" class="ltx_p"><math id="A5.I8.i2.p1.m1" class="ltx_Math" alttext="r_{i}(\mathbf{s}_{i},\mathbf{a}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐚</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r_{i}(\mathbf{s}_{i},\mathbf{a}_{i})</annotation></semantics></math>: The reward for agent <math id="A5.I8.i2.p1.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> given its state-action pair.</p>
</div></li>
</ul>
</div>
<div id="A5.SS2.p27" class="ltx_para">
<p id="A5.SS2.p27.1" class="ltx_p"><span id="A5.SS2.p27.1.1" class="ltx_text">The <math id="A5.SS2.p27.m1" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>-function for agent <math id="A5.SS2.p27.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> under policy <math id="A5.SS2.p27.m3" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> can be expressed as:</span></p>
<table id="A5.Ex33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex33.m1" class="ltx_math_unparsed" alttext="Q^{\pi}_{i}(\mathbf{s},\mathbf{a})=\mathbb{E}_{\pi}\left[\sum_{t=0}^{\infty}\gamma^{t}r_{i}(\mathbf{s}_{i}(t),\mathbf{a}_{i}(t))\mid\mathbf{s}(0)=\mathbf{s},\mathbf{a}(0)=\mathbf{a}\right]" display="block" intent=":literal"><semantics><mrow><msubsup><mi>Q</mi><mi>i</mi><mi>π</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><mi>π</mi></msub><mrow><mo>[</mo><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><msup><mi>γ</mi><mi>t</mi></msup><msub><mi>r</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝐚</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐬</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝐚</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">Q^{\pi}_{i}(\mathbf{s},\mathbf{a})=\mathbb{E}_{\pi}\left[\sum_{t=0}^{\infty}\gamma^{t}r_{i}(\mathbf{s}_{i}(t),\mathbf{a}_{i}(t))\mid\mathbf{s}(0)=\mathbf{s},\mathbf{a}(0)=\mathbf{a}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A5.Ex34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex34.m1" class="ltx_math_unparsed" alttext="=\sum_{t=0}^{\infty}\gamma^{t}\sum_{\mathbf{s}(t),\mathbf{a}(t)}\rho^{\pi}_{t}(\mathbf{s}(t),\mathbf{a}_{t}|\mathbf{s}(0)=\mathbf{s},\mathbf{a}(0)=\mathbf{a})\cdot r_{i}(\mathbf{s}_{i}(t),\mathbf{a}_{i}(t))." display="block" intent=":literal"><semantics><mrow><mo rspace="0.111em">=</mo><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><msup><mi>γ</mi><mi>t</mi></msup><munder><mo movablelimits="false">∑</mo><mrow><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐚</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><msubsup><mi>ρ</mi><mi>t</mi><mi>π</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝐚</mi><mi>t</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐬</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝐚</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mi>r</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝐚</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">=\sum_{t=0}^{\infty}\gamma^{t}\sum_{\mathbf{s}(t),\mathbf{a}(t)}\rho^{\pi}_{t}(\mathbf{s}(t),\mathbf{a}_{t}|\mathbf{s}(0)=\mathbf{s},\mathbf{a}(0)=\mathbf{a})\cdot r_{i}(\mathbf{s}_{i}(t),\mathbf{a}_{i}(t)).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS2.p28" class="ltx_para">
<p id="A5.SS2.p28.1" class="ltx_p"><span id="A5.SS2.p28.1.1" class="ltx_text">Similarly, we can define <math id="A5.SS2.p28.m1" class="ltx_Math" alttext="Q^{\tilde{\pi}}_{i}(\mathbf{s},\mathbf{a})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Q</mi><mi>i</mi><mover accent="true"><mi>π</mi><mo>~</mo></mover></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Q^{\tilde{\pi}}_{i}(\mathbf{s},\mathbf{a})</annotation></semantics></math> for the approximately compact policy <math id="A5.SS2.p28.m2" class="ltx_Math" alttext="\tilde{\pi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>π</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\pi}</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS2.p29" class="ltx_para">
<p id="A5.SS2.p29.1" class="ltx_p"><span id="A5.SS2.p29.1.1" class="ltx_text">To prove <math id="A5.SS2.p29.m1" class="ltx_Math" alttext="Q^{\tilde{\pi}}_{i}(\mathbf{s},\mathbf{a})=Q^{\pi}_{i}(\mathbf{s},\mathbf{a})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>Q</mi><mi>i</mi><mover accent="true"><mi>π</mi><mo>~</mo></mover></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>Q</mi><mi>i</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Q^{\tilde{\pi}}_{i}(\mathbf{s},\mathbf{a})=Q^{\pi}_{i}(\mathbf{s},\mathbf{a})</annotation></semantics></math>, it suffices to show that for all <math id="A5.SS2.p29.m2" class="ltx_Math" alttext="t\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t\geq 0</annotation></semantics></math>, the distribution of rewards <math id="A5.SS2.p29.m3" class="ltx_Math" alttext="r_{i}(\mathbf{s}_{i}(t),\mathbf{a}_{i}(t))" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐬</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r_{i}(\mathbf{s}_{i}(t),\mathbf{a}_{i}(t))</annotation></semantics></math> is identical under both policies.</span></p>
</div>
<div id="A5.SS2.p30" class="ltx_para">
<p id="A5.SS2.p30.1" class="ltx_p"><span id="A5.SS2.p30.1.1" class="ltx_text">From Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ E.2 Policy ACR ‣ Appendix E Missing proofs in Section ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, we know that the reward <math id="A5.SS2.p30.m1" class="ltx_Math" alttext="r_{i}(\mathbf{s}_{i},\mathbf{a}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐚</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r_{i}(\mathbf{s}_{i},\mathbf{a}_{i})</annotation></semantics></math> depends only on the components in <math id="A5.SS2.p30.m2" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{i}</annotation></semantics></math> and <math id="A5.SS2.p30.m3" class="ltx_Math" alttext="a_{i}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>i</mi></msub><annotation encoding="application/x-tex">a_{i}</annotation></semantics></math>. This is because any state component not in <math id="A5.SS2.p30.m4" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{i}</annotation></semantics></math> has no path to <math id="A5.SS2.p30.m5" class="ltx_Math" alttext="r_{i}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>i</mi></msub><annotation encoding="application/x-tex">r_{i}</annotation></semantics></math> (directly or indirectly), meaning it cannot influence the reward function. Therefore, we need to prove that the joint distribution of <math id="A5.SS2.p30.m6" class="ltx_Math" alttext="(\mathbf{s}^{\circ}_{i}(t),\mathbf{a}_{i}(t))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbf{s}^{\circ}_{i}(t),\mathbf{a}_{i}(t))</annotation></semantics></math> is the same under both <math id="A5.SS2.p30.m7" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> and <math id="A5.SS2.p30.m8" class="ltx_Math" alttext="\tilde{\pi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>π</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\pi}</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS2.p31" class="ltx_para">
<p id="A5.SS2.p31.1" class="ltx_p"><span id="A5.SS2.p31.1.1" class="ltx_text">We prove this by induction on <math id="A5.SS2.p31.m1" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS2.p32" class="ltx_para">
<p id="A5.SS2.p32.1" class="ltx_p"><span id="A5.SS2.p32.1.1" class="ltx_text ltx_font_bold">Base case (<math id="A5.SS2.p32.m1" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math>)<span id="A5.SS2.p32.1.1.1" class="ltx_text ltx_font_medium">: The initial state <math id="A5.SS2.p32.m2" class="ltx_Math" alttext="\mathbf{s}(0)=\mathbf{s}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>𝐬</mi></mrow><annotation encoding="application/x-tex">\mathbf{s}(0)=\mathbf{s}</annotation></semantics></math> is given, so <math id="A5.SS2.p32.m3" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{i}(0)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{i}(0)</annotation></semantics></math> is the same for both policies. For the initial action, we have:</span></span></p>
</div>
<div id="A5.SS2.p33" class="ltx_para">
<p id="A5.SS2.p33.1" class="ltx_p"><span id="A5.SS2.p33.1.1" class="ltx_text">Under <math id="A5.SS2.p33.m1" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>: <math id="A5.SS2.p33.m2" class="ltx_math_unparsed" alttext="\mathbf{a}_{i}(0)\sim\pi_{i}(\cdot|\mathbf{s}_{\mathcal{N}_{i}}(0))" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>∼</mo><msub><mi>π</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{a}_{i}(0)\sim\pi_{i}(\cdot|\mathbf{s}_{\mathcal{N}_{i}}(0))</annotation></semantics></math></span></p>
</div>
<div id="A5.SS2.p34" class="ltx_para">
<p id="A5.SS2.p34.1" class="ltx_p"><span id="A5.SS2.p34.1.1" class="ltx_text">Under <math id="A5.SS2.p34.m1" class="ltx_Math" alttext="\tilde{\pi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>π</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\pi}</annotation></semantics></math>: <math id="A5.SS2.p34.m2" class="ltx_math_unparsed" alttext="\mathbf{a}_{i}(0)\sim\tilde{\pi}_{i}(\cdot|\mathbf{s}^{\circ}_{\mathcal{N}_{i}}(0))" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>∼</mo><msub><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{a}_{i}(0)\sim\tilde{\pi}_{i}(\cdot|\mathbf{s}^{\circ}_{\mathcal{N}_{i}}(0))</annotation></semantics></math></span></p>
</div>
<div id="A5.SS2.p35" class="ltx_para">
<p id="A5.SS2.p35.1" class="ltx_p"><span id="A5.SS2.p35.1.1" class="ltx_text">By the definition of the approximately compact localized policy:</span></p>
<table id="A5.Ex35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex35.m1" class="ltx_math_unparsed" alttext="\tilde{\pi}_{i}(\cdot|\mathbf{s}^{\circ}_{\mathcal{N}_{i}})=\pi_{i}(\cdot|\mathbf{s}^{\circ}_{\mathcal{N}_{i}},\mathbf{s}_{\mathcal{N}_{i}}/\mathbf{s}^{\circ}_{\mathcal{N}_{i}})" display="block" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>π</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo>,</mo><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo>/</mo><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{\pi}_{i}(\cdot|\mathbf{s}^{\circ}_{\mathcal{N}_{i}})=\pi_{i}(\cdot|\mathbf{s}^{\circ}_{\mathcal{N}_{i}},\mathbf{s}_{\mathcal{N}_{i}}/\mathbf{s}^{\circ}_{\mathcal{N}_{i}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS2.p36" class="ltx_para">
<p id="A5.SS2.p36.1" class="ltx_p"><span id="A5.SS2.p36.1.1" class="ltx_text">for any fixed <math id="A5.SS2.p36.m1" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{\mathcal{N}_{i}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{\mathcal{N}_{i}}</annotation></semantics></math> and for any configuration of the non-minimal components <math id="A5.SS2.p36.m2" class="ltx_Math" alttext="\mathbf{s}_{\mathcal{N}_{i}}/\mathbf{s}^{\circ}_{\mathcal{N}_{i}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo>/</mo><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup></mrow><annotation encoding="application/x-tex">\mathbf{s}_{\mathcal{N}_{i}}/\mathbf{s}^{\circ}_{\mathcal{N}_{i}}</annotation></semantics></math>. Therefore, <math id="A5.SS2.p36.m3" class="ltx_Math" alttext="\mathbf{a}_{i}(0)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{a}_{i}(0)</annotation></semantics></math> has the same distribution under both policies when conditioned on the same initial state.</span></p>
</div>
<div id="A5.SS2.p37" class="ltx_para">
<p id="A5.SS2.p37.1" class="ltx_p"><span id="A5.SS2.p37.1.1" class="ltx_text ltx_font_bold">Inductive hypothesis<span id="A5.SS2.p37.1.1.1" class="ltx_text ltx_font_medium">: Assume that for some <math id="A5.SS2.p37.m1" class="ltx_Math" alttext="t\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t\geq 0</annotation></semantics></math>, the joint distribution of <math id="A5.SS2.p37.m2" class="ltx_Math" alttext="(\mathbf{s}^{\circ}_{i}(t),\mathbf{a}_{i}(t))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbf{s}^{\circ}_{i}(t),\mathbf{a}_{i}(t))</annotation></semantics></math> is the same under both <math id="A5.SS2.p37.m3" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> and <math id="A5.SS2.p37.m4" class="ltx_Math" alttext="\tilde{\pi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>π</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\pi}</annotation></semantics></math> for all agents <math id="A5.SS2.p37.m5" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.</span></span></p>
</div>
<div id="A5.SS2.p38" class="ltx_para">
<p id="A5.SS2.p38.1" class="ltx_p"><span id="A5.SS2.p38.1.1" class="ltx_text ltx_font_bold">Inductive step<span id="A5.SS2.p38.1.1.1" class="ltx_text ltx_font_medium">: We need to show that the joint distribution of <math id="A5.SS2.p38.m1" class="ltx_Math" alttext="(\mathbf{s}^{\circ}_{i}(t+1),\mathbf{a}_{i}(t+1))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbf{s}^{\circ}_{i}(t+1),\mathbf{a}_{i}(t+1))</annotation></semantics></math> is also the same under both policies.</span></span></p>
</div>
<div id="A5.SS2.p39" class="ltx_para">
<p id="A5.SS2.p39.1" class="ltx_p"><span id="A5.SS2.p39.1.1" class="ltx_text">For <math id="A5.SS2.p39.m1" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{i}(t+1)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{i}(t+1)</annotation></semantics></math>, we analyze how it depends on the previous state and action. By the Markov assumption, <math id="A5.SS2.p39.m2" class="ltx_Math" alttext="\mathbf{s}(t+1)" display="inline" intent=":literal"><semantics><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}(t+1)</annotation></semantics></math> depends only on <math id="A5.SS2.p39.m3" class="ltx_Math" alttext="\mathbf{s}(t)" display="inline" intent=":literal"><semantics><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}(t)</annotation></semantics></math> and <math id="A5.SS2.p39.m4" class="ltx_Math" alttext="\mathbf{a}(t)" display="inline" intent=":literal"><semantics><mrow><mi>𝐚</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{a}(t)</annotation></semantics></math>. The key insight is to show that <math id="A5.SS2.p39.m5" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{i}(t+1)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{i}(t+1)</annotation></semantics></math> depends only on <math id="A5.SS2.p39.m6" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{\mathcal{N}_{i}}(t)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{\mathcal{N}_{i}}(t)</annotation></semantics></math> and <math id="A5.SS2.p39.m7" class="ltx_Math" alttext="\mathbf{a}_{\mathcal{N}_{i}}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐚</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{a}_{\mathcal{N}_{i}}(t)</annotation></semantics></math>, not on any component outside <math id="A5.SS2.p39.m8" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{\mathcal{N}_{i}}(t)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{\mathcal{N}_{i}}(t)</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS2.p40" class="ltx_para">
<p id="A5.SS2.p40.1" class="ltx_p"><span id="A5.SS2.p40.1.1" class="ltx_text">Suppose, for contradiction, that there exists a component <math id="A5.SS2.p40.m1" class="ltx_Math" alttext="s_{k,j}(t)\not\in\mathbf{s}^{\circ}_{\mathcal{N}_{i}}(t)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>s</mi><mrow><mi>k</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∉</mo><mrow><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s_{k,j}(t)\not\in\mathbf{s}^{\circ}_{\mathcal{N}_{i}}(t)</annotation></semantics></math> that influences some component <math id="A5.SS2.p40.m2" class="ltx_Math" alttext="s_{i,j^{\prime}}(t+1)\in\mathbf{s}^{\circ}_{i}(t+1)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><msup><mi>j</mi><mo>′</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s_{i,j^{\prime}}(t+1)\in\mathbf{s}^{\circ}_{i}(t+1)</annotation></semantics></math>. This means there is a causal link from <math id="A5.SS2.p40.m3" class="ltx_Math" alttext="s_{k,j}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>k</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{k,j}(t)</annotation></semantics></math> to <math id="A5.SS2.p40.m4" class="ltx_Math" alttext="s_{i,j^{\prime}}(t+1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><msup><mi>j</mi><mo>′</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{i,j^{\prime}}(t+1)</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS2.p41" class="ltx_para">
<p id="A5.SS2.p41.1" class="ltx_p"><span id="A5.SS2.p41.1.1" class="ltx_text">By Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ E.2 Policy ACR ‣ Appendix E Missing proofs in Section ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, since <math id="A5.SS2.p41.m1" class="ltx_Math" alttext="s_{i,j^{\prime}}(t+1)\in\mathbf{s}^{\circ}_{i}(t+1)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><msup><mi>j</mi><mo>′</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s_{i,j^{\prime}}(t+1)\in\mathbf{s}^{\circ}_{i}(t+1)</annotation></semantics></math>, either:</span></p>
<ul id="A5.I9" class="ltx_itemize">
<li id="A5.I9.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I9.i1.p1" class="ltx_para">
<p id="A5.I9.i1.p1.1" class="ltx_p"><math id="A5.I9.i1.p1.m1" class="ltx_Math" alttext="s_{i,j^{\prime}}(t+1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><msup><mi>j</mi><mo>′</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{i,j^{\prime}}(t+1)</annotation></semantics></math> has a direct edge to <math id="A5.I9.i1.p1.m2" class="ltx_Math" alttext="r_{i}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>i</mi></msub><annotation encoding="application/x-tex">r_{i}</annotation></semantics></math>, or</p>
</div></li>
<li id="A5.I9.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I9.i2.p1" class="ltx_para">
<p id="A5.I9.i2.p1.1" class="ltx_p">There exists a path from <math id="A5.I9.i2.p1.m1" class="ltx_Math" alttext="s_{i,j^{\prime}}(t+1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><msup><mi>j</mi><mo>′</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{i,j^{\prime}}(t+1)</annotation></semantics></math> to some reward <math id="A5.I9.i2.p1.m2" class="ltx_Math" alttext="r_{i^{\prime}}(t+1+l)" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><msup><mi>i</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r_{i^{\prime}}(t+1+l)</annotation></semantics></math> for some <math id="A5.I9.i2.p1.m3" class="ltx_Math" alttext="l\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">l\geq 0</annotation></semantics></math>.</p>
</div></li>
</ul>
</div>
<div id="A5.SS2.p42" class="ltx_para">
<p id="A5.SS2.p42.1" class="ltx_p"><span id="A5.SS2.p42.1.1" class="ltx_text">Either way, this creates a path from <math id="A5.SS2.p42.m1" class="ltx_Math" alttext="s_{k,j}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>k</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{k,j}(t)</annotation></semantics></math> to a reward (either directly to <math id="A5.SS2.p42.m2" class="ltx_Math" alttext="r_{i}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>i</mi></msub><annotation encoding="application/x-tex">r_{i}</annotation></semantics></math> through <math id="A5.SS2.p42.m3" class="ltx_Math" alttext="s_{i,j^{\prime}}(t+1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><msup><mi>j</mi><mo>′</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{i,j^{\prime}}(t+1)</annotation></semantics></math>, or to <math id="A5.SS2.p42.m4" class="ltx_Math" alttext="r_{i^{\prime}}(t+1+l)" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><msup><mi>i</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r_{i^{\prime}}(t+1+l)</annotation></semantics></math> via the path from <math id="A5.SS2.p42.m5" class="ltx_Math" alttext="s_{i,j^{\prime}}(t+1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><msup><mi>j</mi><mo>′</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{i,j^{\prime}}(t+1)</annotation></semantics></math>).</span></p>
</div>
<div id="A5.SS2.p43" class="ltx_para">
<p id="A5.SS2.p43.1" class="ltx_p"><span id="A5.SS2.p43.1.1" class="ltx_text">This path satisfies the constraints in Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ E.2 Policy ACR ‣ Appendix E Missing proofs in Section ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> condition (ii), which would imply <math id="A5.SS2.p43.m1" class="ltx_Math" alttext="s_{k,j}(t)\in\mathbf{s}^{\circ}_{k}(t)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>s</mi><mrow><mi>k</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msubsup><mi>𝐬</mi><mi>k</mi><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s_{k,j}(t)\in\mathbf{s}^{\circ}_{k}(t)</annotation></semantics></math>. Since <math id="A5.SS2.p43.m2" class="ltx_Math" alttext="k\in\mathcal{N}_{i}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">k\in\mathcal{N}_{i}</annotation></semantics></math> (there is a causal link from agent <math id="A5.SS2.p43.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> to agent <math id="A5.SS2.p43.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>), we would have <math id="A5.SS2.p43.m5" class="ltx_Math" alttext="s_{k,j}(t)\in\mathbf{s}^{\circ}_{\mathcal{N}_{i}}(t)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>s</mi><mrow><mi>k</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s_{k,j}(t)\in\mathbf{s}^{\circ}_{\mathcal{N}_{i}}(t)</annotation></semantics></math>, contradicting our assumption.</span></p>
</div>
<div id="A5.SS2.p44" class="ltx_para">
<p id="A5.SS2.p44.1" class="ltx_p"><span id="A5.SS2.p44.1.1" class="ltx_text">Therefore, <math id="A5.SS2.p44.m1" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{i}(t+1)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{i}(t+1)</annotation></semantics></math> depends only on <math id="A5.SS2.p44.m2" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{\mathcal{N}_{i}}(t)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{\mathcal{N}_{i}}(t)</annotation></semantics></math> and <math id="A5.SS2.p44.m3" class="ltx_Math" alttext="\mathbf{a}_{\mathcal{N}_{i}}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐚</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{a}_{\mathcal{N}_{i}}(t)</annotation></semantics></math>. By the inductive hypothesis, the joint distribution of <math id="A5.SS2.p44.m4" class="ltx_Math" alttext="(\mathbf{s}^{\circ}_{\mathcal{N}_{i}}(t),\mathbf{a}_{\mathcal{N}_{i}}(t))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbf{s}^{\circ}_{\mathcal{N}_{i}}(t),\mathbf{a}_{\mathcal{N}_{i}}(t))</annotation></semantics></math> is the same under both policies, so the distribution of <math id="A5.SS2.p44.m5" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{i}(t+1)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{i}(t+1)</annotation></semantics></math> is also the same.</span></p>
</div>
<div id="A5.SS2.p45" class="ltx_para">
<p id="A5.SS2.p45.1" class="ltx_p"><span id="A5.SS2.p45.1.1" class="ltx_text">For <math id="A5.SS2.p45.m1" class="ltx_Math" alttext="\mathbf{a}_{i}(t+1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{a}_{i}(t+1)</annotation></semantics></math>, we have:</span></p>
</div>
<div id="A5.SS2.p46" class="ltx_para">
<p id="A5.SS2.p46.1" class="ltx_p"><span id="A5.SS2.p46.1.1" class="ltx_text">Under <math id="A5.SS2.p46.m1" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>: <math id="A5.SS2.p46.m2" class="ltx_math_unparsed" alttext="\mathbf{a}_{i}(t+1)\sim\pi_{i}(\cdot|\mathbf{s}_{\mathcal{N}_{i}}(t+1))" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>∼</mo><msub><mi>π</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{a}_{i}(t+1)\sim\pi_{i}(\cdot|\mathbf{s}_{\mathcal{N}_{i}}(t+1))</annotation></semantics></math></span></p>
</div>
<div id="A5.SS2.p47" class="ltx_para">
<p id="A5.SS2.p47.1" class="ltx_p"><span id="A5.SS2.p47.1.1" class="ltx_text">Under <math id="A5.SS2.p47.m1" class="ltx_Math" alttext="\tilde{\pi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>π</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\pi}</annotation></semantics></math>: <math id="A5.SS2.p47.m2" class="ltx_math_unparsed" alttext="\mathbf{a}_{i}(t+1)\sim\tilde{\pi}_{i}(\cdot|\mathbf{s}^{\circ}_{\mathcal{N}_{i}}(t+1))" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>∼</mo><msub><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{a}_{i}(t+1)\sim\tilde{\pi}_{i}(\cdot|\mathbf{s}^{\circ}_{\mathcal{N}_{i}}(t+1))</annotation></semantics></math></span></p>
</div>
<div id="A5.SS2.p48" class="ltx_para">
<p id="A5.SS2.p48.1" class="ltx_p"><span id="A5.SS2.p48.1.1" class="ltx_text">By the definition of approximately compact policy and the fact that the distribution of <math id="A5.SS2.p48.m1" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{\mathcal{N}_{i}}(t+1)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{\mathcal{N}_{i}}(t+1)</annotation></semantics></math> is the same under both policies, <math id="A5.SS2.p48.m2" class="ltx_Math" alttext="\mathbf{a}_{i}(t+1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{a}_{i}(t+1)</annotation></semantics></math> also has the same distribution under both policies.</span></p>
</div>
<div id="A5.SS2.p49" class="ltx_para">
<p id="A5.SS2.p49.1" class="ltx_p"><span id="A5.SS2.p49.1.1" class="ltx_text">By induction, for all <math id="A5.SS2.p49.m1" class="ltx_Math" alttext="t\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t\geq 0</annotation></semantics></math>, the joint distribution of <math id="A5.SS2.p49.m2" class="ltx_Math" alttext="(\mathbf{s}^{\circ}_{i}(t),\mathbf{a}_{i}(t))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbf{s}^{\circ}_{i}(t),\mathbf{a}_{i}(t))</annotation></semantics></math> is the same under both <math id="A5.SS2.p49.m3" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> and <math id="A5.SS2.p49.m4" class="ltx_Math" alttext="\tilde{\pi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>π</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\pi}</annotation></semantics></math> for all agents <math id="A5.SS2.p49.m5" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS2.p50" class="ltx_para">
<p id="A5.SS2.p50.1" class="ltx_p"><span id="A5.SS2.p50.1.1" class="ltx_text">Since the reward <math id="A5.SS2.p50.m1" class="ltx_Math" alttext="r_{i}(\mathbf{s}_{i}(t),\mathbf{a}_{i}(t))" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐬</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r_{i}(\mathbf{s}_{i}(t),\mathbf{a}_{i}(t))</annotation></semantics></math> depends only on <math id="A5.SS2.p50.m2" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{i}(t)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{i}(t)</annotation></semantics></math> and <math id="A5.SS2.p50.m3" class="ltx_Math" alttext="\mathbf{a}_{i}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{a}_{i}(t)</annotation></semantics></math>, and these have the same distribution under both policies, the expected discounted sum of rewards is also the same.</span></p>
</div>
<div id="A5.SS2.p51" class="ltx_para">
<p id="A5.SS2.p51.1" class="ltx_p"><span id="A5.SS2.p51.1.1" class="ltx_text">Therefore, <math id="A5.SS2.p51.m1" class="ltx_Math" alttext="Q^{\tilde{\pi}}_{i}(\mathbf{s},\mathbf{a})=Q^{\pi}_{i}(\mathbf{s},\mathbf{a})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>Q</mi><mi>i</mi><mover accent="true"><mi>π</mi><mo>~</mo></mover></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>Q</mi><mi>i</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Q^{\tilde{\pi}}_{i}(\mathbf{s},\mathbf{a})=Q^{\pi}_{i}(\mathbf{s},\mathbf{a})</annotation></semantics></math> for all agents <math id="A5.SS2.p51.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> and all state-action pairs <math id="A5.SS2.p51.m3" class="ltx_Math" alttext="(\mathbf{s},\mathbf{a})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbf{s},\mathbf{a})</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="Thmcorollary1" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmcorollary1.2" class="ltx_text ltx_font_bold">Corollary 1</span></span><span id="Thmcorollary1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmcorollary1.p1" class="ltx_para">
<p id="Thmcorollary1.p1.1" class="ltx_p">Let <math id="Thmcorollary1.p1.m1" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> be an arbitrary localized policy and <math id="Thmcorollary1.p1.m2" class="ltx_Math" alttext="\tilde{\pi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>π</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\pi}</annotation></semantics></math> be the corresponding approximately compact localized policy output by Algorithm <a href="#alg2" title="Algorithm 2 ‣ D.2 Policy ACR ‣ Appendix D Algorithm design ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, for each agent <math id="Thmcorollary1.p1.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, and any <math id="Thmcorollary1.p1.m4" class="ltx_Math" alttext="(\mathbf{s},\mathbf{a})\in\mathcal{S}\times\mathcal{A}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow></mrow><annotation encoding="application/x-tex">(\mathbf{s},\mathbf{a})\in\mathcal{S}\times\mathcal{A}</annotation></semantics></math>, the approximation error between <math id="Thmcorollary1.p1.m5" class="ltx_Math" alttext="\tilde{Q}_{i}^{\tilde{\pi}}\left(\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}\right)" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>Q</mi><mo>~</mo></mover><mi>i</mi><mover accent="true"><mi>π</mi><mo>~</mo></mover></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo>,</mo><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{Q}_{i}^{\tilde{\pi}}\left(\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}\right)</annotation></semantics></math> and <math id="Thmcorollary1.p1.m6" class="ltx_Math" alttext="Q_{i}^{\pi}\left(\mathbf{s},\mathbf{a}\right)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Q</mi><mi>i</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">Q_{i}^{\pi}\left(\mathbf{s},\mathbf{a}\right)</annotation></semantics></math> can be bounded as</p>
<table id="A5.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex36.m1" class="ltx_Math" alttext="\displaystyle\sup_{(\mathbf{s},\mathbf{a})\in\mathcal{S}\times\mathcal{A}}\left\lvert\tilde{Q}_{i}^{\tilde{\pi}}\left(\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}\right)-Q_{i}^{\pi}\left(\mathbf{s},\mathbf{a}\right)\right\rvert\leq\frac{\bar{r}}{1-\gamma}\gamma^{\kappa+1}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow></mrow></munder><mrow><mo lspace="0em">|</mo><mrow><mrow><msubsup><mover accent="true"><mi>Q</mi><mo>~</mo></mover><mi>i</mi><mover accent="true"><mi>π</mi><mo>~</mo></mover></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo>,</mo><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>Q</mi><mi>i</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mover accent="true"><mi>r</mi><mo>¯</mo></mover><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{(\mathbf{s},\mathbf{a})\in\mathcal{S}\times\mathcal{A}}\left\lvert\tilde{Q}_{i}^{\tilde{\pi}}\left(\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}\right)-Q_{i}^{\pi}\left(\mathbf{s},\mathbf{a}\right)\right\rvert\leq\frac{\bar{r}}{1-\gamma}\gamma^{\kappa+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS2.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS2.p52" class="ltx_para">
<p id="A5.SS2.p52.1" class="ltx_p"><span id="A5.SS2.p52.1.1" class="ltx_text">Using Proposition <a href="#Thmproposition6" title="Proposition 6 (Compactness of policy ACR). ‣ E.2 Policy ACR ‣ Appendix E Missing proofs in Section ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>, we have</span></p>
<table id="A5.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex37.m1" class="ltx_Math" alttext="\displaystyle\left\lvert\tilde{Q}_{i}^{\tilde{\pi}}\left(\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}\right)-Q_{i}^{\pi}\left(\mathbf{s},\mathbf{a}\right)\right\rvert" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><msubsup><mover accent="true"><mi>Q</mi><mo>~</mo></mover><mi>i</mi><mover accent="true"><mi>π</mi><mo>~</mo></mover></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo>,</mo><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>Q</mi><mi>i</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\lvert\tilde{Q}_{i}^{\tilde{\pi}}\left(\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}\right)-Q_{i}^{\pi}\left(\mathbf{s},\mathbf{a}\right)\right\rvert</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex37.m2" class="ltx_Math" alttext="\displaystyle\leq\left\lvert\tilde{Q}_{i}^{\tilde{\pi}}\left(\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}\right)-Q_{i}^{\tilde{\pi}}\left(\mathbf{s},\mathbf{a}\right)\right\rvert+\left\lvert Q_{i}^{\tilde{\pi}}\left(\mathbf{s},\mathbf{a}\right)-Q_{i}^{\pi}\left(\mathbf{s},\mathbf{a}\right)\right\rvert" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>|</mo><mrow><mrow><msubsup><mover accent="true"><mi>Q</mi><mo>~</mo></mover><mi>i</mi><mover accent="true"><mi>π</mi><mo>~</mo></mover></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo>,</mo><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>Q</mi><mi>i</mi><mover accent="true"><mi>π</mi><mo>~</mo></mover></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>+</mo><mrow><mo>|</mo><mrow><mrow><msubsup><mi>Q</mi><mi>i</mi><mover accent="true"><mi>π</mi><mo>~</mo></mover></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>Q</mi><mi>i</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\lvert\tilde{Q}_{i}^{\tilde{\pi}}\left(\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}\right)-Q_{i}^{\tilde{\pi}}\left(\mathbf{s},\mathbf{a}\right)\right\rvert+\left\lvert Q_{i}^{\tilde{\pi}}\left(\mathbf{s},\mathbf{a}\right)-Q_{i}^{\pi}\left(\mathbf{s},\mathbf{a}\right)\right\rvert</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex38.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{\bar{r}}{1-\gamma}\gamma^{\kappa+1}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mover accent="true"><mi>r</mi><mo>¯</mo></mover><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\bar{r}}{1-\gamma}\gamma^{\kappa+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS2.p53" class="ltx_para">
<p id="A5.SS2.p53.1" class="ltx_p"><span id="A5.SS2.p53.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="Thmproposition7" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmproposition7.2" class="ltx_text ltx_font_bold">Proposition 7</span></span><span id="Thmproposition7.3" class="ltx_text ltx_font_bold"> </span>(Approximation error of policy ACR)<span id="Thmproposition7.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmproposition7.p1" class="ltx_para">
<p id="Thmproposition7.p1.1" class="ltx_p">For any policy <math id="Thmproposition7.p1.m1" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>, let <math id="Thmproposition7.p1.m2" class="ltx_Math" alttext="\tilde{\pi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>π</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\pi}</annotation></semantics></math> be the corresponding approximately compact policy constructed using Algorithm <a href="#alg3" title="Algorithm 3 ‣ D.2 Policy ACR ‣ Appendix D Algorithm design ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, for any <math id="Thmproposition7.p1.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, we have</p>
<table id="A5.EGx10" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex39.m1" class="ltx_Math" alttext="\displaystyle\sup_{(\mathbf{s},\mathbf{a})\in\mathcal{S}\times\mathcal{A}}\left\lvert Q_{i}^{\tilde{\pi}}\left(\mathbf{s},\mathbf{a}\right)-Q_{i}^{\pi}\left(\mathbf{s},\mathbf{a}\right)\right\rvert\leq\frac{\bar{r}}{1-\gamma}\gamma^{\kappa+1}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow></mrow></munder><mrow><mo lspace="0em">|</mo><mrow><mrow><msubsup><mi>Q</mi><mi>i</mi><mover accent="true"><mi>π</mi><mo>~</mo></mover></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>Q</mi><mi>i</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mover accent="true"><mi>r</mi><mo>¯</mo></mover><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{(\mathbf{s},\mathbf{a})\in\mathcal{S}\times\mathcal{A}}\left\lvert Q_{i}^{\tilde{\pi}}\left(\mathbf{s},\mathbf{a}\right)-Q_{i}^{\pi}\left(\mathbf{s},\mathbf{a}\right)\right\rvert\leq\frac{\bar{r}}{1-\gamma}\gamma^{\kappa+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS2.6" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Proposition <a href="#Thmproposition7" title="Proposition 7 (Approximation error of policy ACR). ‣ E.2 Policy ACR ‣ Appendix E Missing proofs in Section ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>.</h6>
<div id="A5.SS2.p54" class="ltx_para">
<p id="A5.SS2.p54.1" class="ltx_p"><span id="A5.SS2.p54.1.1" class="ltx_text">Let us first establish precise definitions:</span></p>
<ul id="A5.I10" class="ltx_itemize">
<li id="A5.I10.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I10.i1.p1" class="ltx_para">
<p id="A5.I10.i1.p1.1" class="ltx_p">Let <math id="A5.I10.i1.p1.m1" class="ltx_Math" alttext="\mathbf{s}^{\circ,\infty}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐬</mi><mi>i</mi><mrow><mo rspace="0em">∘</mo><mo>,</mo><mi mathvariant="normal">∞</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathbf{s}^{\circ,\infty}_{i}</annotation></semantics></math> denote the minimal state representation for agent <math id="A5.I10.i1.p1.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> obtained from Algorithm <a href="#alg2" title="Algorithm 2 ‣ D.2 Policy ACR ‣ Appendix D Algorithm design ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> (with indefinite recursion until convergence).</p>
</div></li>
<li id="A5.I10.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I10.i2.p1" class="ltx_para">
<p id="A5.I10.i2.p1.1" class="ltx_p">Let <math id="A5.I10.i2.p1.m1" class="ltx_Math" alttext="\mathbf{s}^{\circ,\kappa}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐬</mi><mi>i</mi><mrow><mo rspace="0em">∘</mo><mo>,</mo><mi>κ</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathbf{s}^{\circ,\kappa}_{i}</annotation></semantics></math> denote the minimal state representation for agent <math id="A5.I10.i2.p1.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> obtained from Algorithm <a href="#alg3" title="Algorithm 3 ‣ D.2 Policy ACR ‣ Appendix D Algorithm design ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> (with exactly <math id="A5.I10.i2.p1.m3" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> steps).</p>
</div></li>
<li id="A5.I10.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I10.i3.p1" class="ltx_para">
<p id="A5.I10.i3.p1.1" class="ltx_p">Let <math id="A5.I10.i3.p1.m1" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> be the original localized (1-hop) policy.</p>
</div></li>
<li id="A5.I10.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I10.i4.p1" class="ltx_para">
<p id="A5.I10.i4.p1.1" class="ltx_p">Let <math id="A5.I10.i4.p1.m1" class="ltx_Math" alttext="\tilde{\pi}^{\infty}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">\tilde{\pi}^{\infty}</annotation></semantics></math> be the approximately compact policy derived from Algorithm <a href="#alg2" title="Algorithm 2 ‣ D.2 Policy ACR ‣ Appendix D Algorithm design ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.</p>
</div></li>
<li id="A5.I10.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I10.i5.p1" class="ltx_para">
<p id="A5.I10.i5.p1.1" class="ltx_p">Let <math id="A5.I10.i5.p1.m1" class="ltx_Math" alttext="\tilde{\pi}^{\kappa}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi>κ</mi></msup><annotation encoding="application/x-tex">\tilde{\pi}^{\kappa}</annotation></semantics></math> be the approximately compact policy derived from Algorithm <a href="#alg3" title="Algorithm 3 ‣ D.2 Policy ACR ‣ Appendix D Algorithm design ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> with <math id="A5.I10.i5.p1.m2" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> steps.</p>
</div></li>
</ul>
</div>
<div id="A5.SS2.p55" class="ltx_para">
<p id="A5.SS2.p55.1" class="ltx_p"><span id="A5.SS2.p55.1.1" class="ltx_text ltx_font_bold">Relationship between minimal representations:<span id="A5.SS2.p55.1.1.1" class="ltx_text ltx_font_medium"> By construction of the algorithms, we have <math id="A5.SS2.p55.m1" class="ltx_Math" alttext="\mathbf{s}^{\circ,\kappa}_{i}\subseteq\mathbf{s}^{\circ,\infty}_{i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mrow><mo rspace="0em">∘</mo><mo>,</mo><mi>κ</mi></mrow></msubsup><mo>⊆</mo><msubsup><mi>𝐬</mi><mi>i</mi><mrow><mo rspace="0em">∘</mo><mo>,</mo><mi mathvariant="normal">∞</mi></mrow></msubsup></mrow><annotation encoding="application/x-tex">\mathbf{s}^{\circ,\kappa}_{i}\subseteq\mathbf{s}^{\circ,\infty}_{i}</annotation></semantics></math> for any finite <math id="A5.SS2.p55.m2" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>. This is because Algorithm <a href="#alg3" title="Algorithm 3 ‣ D.2 Policy ACR ‣ Appendix D Algorithm design ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> performs exactly <math id="A5.SS2.p55.m3" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> iterations, while Algorithm <a href="#alg2" title="Algorithm 2 ‣ D.2 Policy ACR ‣ Appendix D Algorithm design ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> continues until convergence, which may require more than <math id="A5.SS2.p55.m4" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> iterations.</span></span></p>
</div>
<div id="Thmlemma5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma5.2" class="ltx_text ltx_font_bold">Lemma 5</span></span><span id="Thmlemma5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma5.p1" class="ltx_para">
<p id="Thmlemma5.p1.1" class="ltx_p">For any agent <math id="Thmlemma5.p1.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, <math id="Thmlemma5.p1.m2" class="ltx_Math" alttext="\mathbf{s}^{\circ,\kappa}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐬</mi><mi>i</mi><mrow><mo rspace="0em">∘</mo><mo>,</mo><mi>κ</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathbf{s}^{\circ,\kappa}_{i}</annotation></semantics></math> captures all state components that can influence rewards within <math id="Thmlemma5.p1.m3" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> time steps.</p>
</div>
</div>
<div id="A5.SS2.6.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS2.p56" class="ltx_para">
<p id="A5.SS2.p56.1" class="ltx_p"><span id="A5.SS2.p56.1.1" class="ltx_text">By the structure of Algorithm <a href="#alg3" title="Algorithm 3 ‣ D.2 Policy ACR ‣ Appendix D Algorithm design ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, in step 1, <math id="A5.SS2.p56.m1" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{i}(1)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{i}(1)</annotation></semantics></math> includes all state components that directly affect the reward <math id="A5.SS2.p56.m2" class="ltx_Math" alttext="r_{i}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>i</mi></msub><annotation encoding="application/x-tex">r_{i}</annotation></semantics></math>. In each subsequent step <math id="A5.SS2.p56.m3" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> (for <math id="A5.SS2.p56.m4" class="ltx_Math" alttext="l=1,2,...,\kappa-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>κ</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">l=1,2,...,\kappa-1</annotation></semantics></math>), any state component that can affect a component in <math id="A5.SS2.p56.m5" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{i}(l)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{i}(l)</annotation></semantics></math> within one time step is added to <math id="A5.SS2.p56.m6" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{i}(l+1)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{i}(l+1)</annotation></semantics></math>. By induction, after <math id="A5.SS2.p56.m7" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> steps, <math id="A5.SS2.p56.m8" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{i}(\kappa)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>κ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{i}(\kappa)</annotation></semantics></math> contains all state components that can affect the reward within <math id="A5.SS2.p56.m9" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> time steps.
∎</span></p>
</div>
</div>
<div id="A5.SS2.p57" class="ltx_para">
<p id="A5.SS2.p57.1" class="ltx_p"><span id="A5.SS2.p57.1.1" class="ltx_text ltx_font_bold">Policy equivalence and divergence:<span id="A5.SS2.p57.1.1.1" class="ltx_text ltx_font_medium"> From Proposition <a href="#Thmproposition6" title="Proposition 6 (Compactness of policy ACR). ‣ E.2 Policy ACR ‣ Appendix E Missing proofs in Section ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>, we know that for the indefinite recursion case:</span></span></p>
<table id="A5.Ex40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex40.m1" class="ltx_Math" alttext="Q^{\tilde{\pi}^{\infty}}_{i}(\mathbf{s},\mathbf{a})=Q^{\pi}_{i}(\mathbf{s},\mathbf{a})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>Q</mi><mi>i</mi><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi mathvariant="normal">∞</mi></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>Q</mi><mi>i</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Q^{\tilde{\pi}^{\infty}}_{i}(\mathbf{s},\mathbf{a})=Q^{\pi}_{i}(\mathbf{s},\mathbf{a}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS2.p58" class="ltx_para">
<p id="A5.SS2.p58.1" class="ltx_p"><span id="A5.SS2.p58.1.1" class="ltx_text">Therefore, to prove Proposition <a href="#Thmproposition7" title="Proposition 7 (Approximation error of policy ACR). ‣ E.2 Policy ACR ‣ Appendix E Missing proofs in Section ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>, we need to show:</span></p>
<table id="A5.Ex41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex41.m1" class="ltx_Math" alttext="\sup_{(\mathbf{s},\mathbf{a})\in S\times A}|Q^{\tilde{\pi}^{\kappa}}_{i}(\mathbf{s},\mathbf{a})-Q^{\tilde{\pi}^{\infty}}_{i}(\mathbf{s},\mathbf{a})|\leq\frac{\bar{r}}{1-\gamma}\gamma^{\kappa+1}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi>S</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>A</mi></mrow></mrow></munder><mrow><mo lspace="0em" stretchy="false">|</mo><mrow><mrow><msubsup><mi>Q</mi><mi>i</mi><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi>κ</mi></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>Q</mi><mi>i</mi><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi mathvariant="normal">∞</mi></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><mover accent="true"><mi>r</mi><mo>¯</mo></mover><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sup_{(\mathbf{s},\mathbf{a})\in S\times A}|Q^{\tilde{\pi}^{\kappa}}_{i}(\mathbf{s},\mathbf{a})-Q^{\tilde{\pi}^{\infty}}_{i}(\mathbf{s},\mathbf{a})|\leq\frac{\bar{r}}{1-\gamma}\gamma^{\kappa+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS2.p59" class="ltx_para">
<p id="A5.SS2.p59.1" class="ltx_p"><span id="A5.SS2.p59.1.1" class="ltx_text ltx_font_bold">Trajectory analysis:<span id="A5.SS2.p59.1.1.1" class="ltx_text ltx_font_medium"> For any initial state-action pair <math id="A5.SS2.p59.m1" class="ltx_Math" alttext="(\mathbf{s},\mathbf{a})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbf{s},\mathbf{a})</annotation></semantics></math>, we’ll analyze the difference in trajectories under policies <math id="A5.SS2.p59.m2" class="ltx_Math" alttext="\tilde{\pi}^{\kappa}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi>κ</mi></msup><annotation encoding="application/x-tex">\tilde{\pi}^{\kappa}</annotation></semantics></math> and <math id="A5.SS2.p59.m3" class="ltx_Math" alttext="\tilde{\pi}^{\infty}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">\tilde{\pi}^{\infty}</annotation></semantics></math>.</span></span></p>
</div>
<div id="Thmlemma6" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma6.2" class="ltx_text ltx_font_bold">Lemma 6</span></span><span id="Thmlemma6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma6.p1" class="ltx_para">
<p id="Thmlemma6.p1.1" class="ltx_p">For any initial state <math id="Thmlemma6.p1.m1" class="ltx_Math" alttext="\mathbf{s}(0)=\mathbf{s}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>𝐬</mi></mrow><annotation encoding="application/x-tex">\mathbf{s}(0)=\mathbf{s}</annotation></semantics></math> and action <math id="Thmlemma6.p1.m2" class="ltx_Math" alttext="\mathbf{a}(0)=\mathbf{a}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐚</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>𝐚</mi></mrow><annotation encoding="application/x-tex">\mathbf{a}(0)=\mathbf{a}</annotation></semantics></math>, the distribution of states and actions under policies <math id="Thmlemma6.p1.m3" class="ltx_Math" alttext="\tilde{\pi}^{\kappa}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi>κ</mi></msup><annotation encoding="application/x-tex">\tilde{\pi}^{\kappa}</annotation></semantics></math> and <math id="Thmlemma6.p1.m4" class="ltx_Math" alttext="\tilde{\pi}^{\infty}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">\tilde{\pi}^{\infty}</annotation></semantics></math> are identical for the first <math id="Thmlemma6.p1.m5" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> time steps, i.e., for <math id="Thmlemma6.p1.m6" class="ltx_Math" alttext="t=0,1,...,\kappa" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>κ</mi></mrow><annotation encoding="application/x-tex">t=0,1,...,\kappa</annotation></semantics></math>.</p>
</div>
</div>
<div id="A5.SS2.6.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS2.p60" class="ltx_para">
<p id="A5.SS2.p60.1" class="ltx_p"><span id="A5.SS2.p60.1.1" class="ltx_text">We prove this by induction.</span></p>
</div>
<div id="A5.SS2.p61" class="ltx_para">
<p id="A5.SS2.p61.1" class="ltx_p"><span id="A5.SS2.p61.1.1" class="ltx_text ltx_font_italic">Base case</span><span id="A5.SS2.p61.1.2" class="ltx_text"> (<math id="A5.SS2.p61.m1" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math>): By definition, <math id="A5.SS2.p61.m2" class="ltx_Math" alttext="\mathbf{s}(0)=\mathbf{s}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>𝐬</mi></mrow><annotation encoding="application/x-tex">\mathbf{s}(0)=\mathbf{s}</annotation></semantics></math> and <math id="A5.SS2.p61.m3" class="ltx_Math" alttext="\mathbf{a}(0)=\mathbf{a}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐚</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>𝐚</mi></mrow><annotation encoding="application/x-tex">\mathbf{a}(0)=\mathbf{a}</annotation></semantics></math> for both policies.</span></p>
</div>
<div id="A5.SS2.p62" class="ltx_para">
<p id="A5.SS2.p62.1" class="ltx_p"><span id="A5.SS2.p62.1.1" class="ltx_text ltx_font_italic">Inductive step</span><span id="A5.SS2.p62.1.2" class="ltx_text">: Assume the distributions are identical for time steps <math id="A5.SS2.p62.m1" class="ltx_Math" alttext="0,1,...,t" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">0,1,...,t</annotation></semantics></math> where <math id="A5.SS2.p62.m2" class="ltx_Math" alttext="t&lt;\kappa" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&lt;</mo><mi>κ</mi></mrow><annotation encoding="application/x-tex">t&lt;\kappa</annotation></semantics></math>. At time <math id="A5.SS2.p62.m3" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, given identical state distributions, both policies make decisions based on the minimal state representations:</span></p>
<ul id="A5.I11" class="ltx_itemize">
<li id="A5.I11.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I11.i1.p1" class="ltx_para">
<p id="A5.I11.i1.p1.1" class="ltx_p"><math id="A5.I11.i1.p1.m1" class="ltx_Math" alttext="\tilde{\pi}^{\kappa}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi>κ</mi></msup><annotation encoding="application/x-tex">\tilde{\pi}^{\kappa}</annotation></semantics></math> uses <math id="A5.I11.i1.p1.m2" class="ltx_Math" alttext="\mathbf{s}^{\circ,\kappa}_{\mathcal{N}_{i}}(t)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mrow><mo rspace="0em">∘</mo><mo>,</mo><mi>κ</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}^{\circ,\kappa}_{\mathcal{N}_{i}}(t)</annotation></semantics></math></p>
</div></li>
<li id="A5.I11.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I11.i2.p1" class="ltx_para">
<p id="A5.I11.i2.p1.1" class="ltx_p"><math id="A5.I11.i2.p1.m1" class="ltx_Math" alttext="\tilde{\pi}^{\infty}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">\tilde{\pi}^{\infty}</annotation></semantics></math> uses <math id="A5.I11.i2.p1.m2" class="ltx_Math" alttext="\mathbf{s}^{\circ,\infty}_{\mathcal{N}_{i}}(t)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mrow><mo rspace="0em">∘</mo><mo>,</mo><mi mathvariant="normal">∞</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}^{\circ,\infty}_{\mathcal{N}_{i}}(t)</annotation></semantics></math></p>
</div></li>
</ul>
</div>
<div id="A5.SS2.p63" class="ltx_para">
<p id="A5.SS2.p63.1" class="ltx_p"><span id="A5.SS2.p63.1.1" class="ltx_text">For any component <math id="A5.SS2.p63.m1" class="ltx_Math" alttext="s_{i,j}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{i,j}(t)</annotation></semantics></math> that affects rewards within <math id="A5.SS2.p63.m2" class="ltx_Math" alttext="\kappa-t" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>−</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">\kappa-t</annotation></semantics></math> time steps, by Lemma 5, <math id="A5.SS2.p63.m3" class="ltx_Math" alttext="s_{i,j}(t)\in\mathbf{s}^{\circ,\kappa}_{i}(t)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mrow><mo rspace="0em">∘</mo><mo>,</mo><mi>κ</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s_{i,j}(t)\in\mathbf{s}^{\circ,\kappa}_{i}(t)</annotation></semantics></math>. Since <math id="A5.SS2.p63.m4" class="ltx_Math" alttext="t&lt;\kappa" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&lt;</mo><mi>κ</mi></mrow><annotation encoding="application/x-tex">t&lt;\kappa</annotation></semantics></math>, both policies have identical information about all state components that can affect rewards within the remaining time steps. Therefore, the action distributions at time <math id="A5.SS2.p63.m5" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> are identical, which leads to identical state distributions at time <math id="A5.SS2.p63.m6" class="ltx_Math" alttext="t+1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t+1</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A5.SS2.p64" class="ltx_para">
<p id="A5.SS2.p64.1" class="ltx_p"><math id="A5.SS2.p64.m1" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math><span id="A5.SS2.p64.1.1" class="ltx_text ltx_font_bold">-function decomposition:<span id="A5.SS2.p64.1.1.1" class="ltx_text ltx_font_medium"> For any initial state-action pair <math id="A5.SS2.p64.m2" class="ltx_Math" alttext="(\mathbf{s},\mathbf{a})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbf{s},\mathbf{a})</annotation></semantics></math>, we can decompose the <math id="A5.SS2.p64.m3" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>-functions as follows:</span></span></p>
<table id="A5.EGx11" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex42"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex42.m1" class="ltx_Math" alttext="\displaystyle Q^{\tilde{\pi}^{\kappa}}_{i}(\mathbf{s},\mathbf{a})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Q</mi><mi>i</mi><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi>κ</mi></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Q^{\tilde{\pi}^{\kappa}}_{i}(\mathbf{s},\mathbf{a})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex42.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{\tilde{\pi}^{\kappa}}\left[\sum_{t=0}^{\kappa}\gamma^{t}r_{i}(\mathbf{s}_{i}(t),\mathbf{a}_{i}(t))\mid\mathbf{s}(0)=\mathbf{s},\mathbf{a}(0)=\mathbf{a}\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi>κ</mi></msup></msub><mrow><mo>[</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mi>κ</mi></munderover></mstyle><msup><mi>γ</mi><mi>t</mi></msup><msub><mi>r</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝐚</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐬</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝐚</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\tilde{\pi}^{\kappa}}\left[\sum_{t=0}^{\kappa}\gamma^{t}r_{i}(\mathbf{s}_{i}(t),\mathbf{a}_{i}(t))\mid\mathbf{s}(0)=\mathbf{s},\mathbf{a}(0)=\mathbf{a}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex43.m1" class="ltx_math_unparsed" alttext="\displaystyle+\mathbb{E}_{\tilde{\pi}^{\kappa}}\left[\sum_{t=\kappa+1}^{\infty}\gamma^{t}r_{i}(\mathbf{s}_{i}(t),\mathbf{a}_{i}(t))\mid\mathbf{s}(0)=\mathbf{s},\mathbf{a}(0)=\mathbf{a}\right]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mi>𝔼</mi><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi>κ</mi></msup></msub><mrow><mo>[</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><msup><mi>γ</mi><mi>t</mi></msup><msub><mi>r</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝐚</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐬</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝐚</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\mathbb{E}_{\tilde{\pi}^{\kappa}}\left[\sum_{t=\kappa+1}^{\infty}\gamma^{t}r_{i}(\mathbf{s}_{i}(t),\mathbf{a}_{i}(t))\mid\mathbf{s}(0)=\mathbf{s},\mathbf{a}(0)=\mathbf{a}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex44"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex44.m1" class="ltx_Math" alttext="\displaystyle Q^{\tilde{\pi}^{\infty}}_{i}(\mathbf{s},\mathbf{a})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Q</mi><mi>i</mi><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi mathvariant="normal">∞</mi></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Q^{\tilde{\pi}^{\infty}}_{i}(\mathbf{s},\mathbf{a})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex44.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{\tilde{\pi}^{\infty}}\left[\sum_{t=0}^{\kappa}\gamma^{t}r_{i}(\mathbf{s}_{i}(t),\mathbf{a}_{i}(t))\mid\mathbf{s}(0)=\mathbf{s},\mathbf{a}(0)=\mathbf{a}\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi mathvariant="normal">∞</mi></msup></msub><mrow><mo>[</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mi>κ</mi></munderover></mstyle><msup><mi>γ</mi><mi>t</mi></msup><msub><mi>r</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝐚</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐬</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝐚</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\tilde{\pi}^{\infty}}\left[\sum_{t=0}^{\kappa}\gamma^{t}r_{i}(\mathbf{s}_{i}(t),\mathbf{a}_{i}(t))\mid\mathbf{s}(0)=\mathbf{s},\mathbf{a}(0)=\mathbf{a}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex45.m1" class="ltx_math_unparsed" alttext="\displaystyle+\mathbb{E}_{\tilde{\pi}^{\infty}}\left[\sum_{t=\kappa+1}^{\infty}\gamma^{t}r_{i}(\mathbf{s}_{i}(t),\mathbf{a}_{i}(t))\mid\mathbf{s}(0)=\mathbf{s},\mathbf{a}(0)=\mathbf{a}\right]." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mi>𝔼</mi><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi mathvariant="normal">∞</mi></msup></msub><mrow><mo>[</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><msup><mi>γ</mi><mi>t</mi></msup><msub><mi>r</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝐚</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐬</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝐚</mi><mo>]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\mathbb{E}_{\tilde{\pi}^{\infty}}\left[\sum_{t=\kappa+1}^{\infty}\gamma^{t}r_{i}(\mathbf{s}_{i}(t),\mathbf{a}_{i}(t))\mid\mathbf{s}(0)=\mathbf{s},\mathbf{a}(0)=\mathbf{a}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS2.p65" class="ltx_para">
<p id="A5.SS2.p65.1" class="ltx_p"><span id="A5.SS2.p65.1.1" class="ltx_text">By Lemma 2, the first terms are identical. Therefore:</span></p>
<table id="A5.EGx12" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex46"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex46.m1" class="ltx_Math" alttext="\displaystyle|Q^{\tilde{\pi}^{\kappa}}_{i}(\mathbf{s},\mathbf{a})-Q^{\tilde{\pi}^{\infty}}_{i}(\mathbf{s},\mathbf{a})|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mrow><msubsup><mi>Q</mi><mi>i</mi><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi>κ</mi></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>Q</mi><mi>i</mi><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi mathvariant="normal">∞</mi></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle|Q^{\tilde{\pi}^{\kappa}}_{i}(\mathbf{s},\mathbf{a})-Q^{\tilde{\pi}^{\infty}}_{i}(\mathbf{s},\mathbf{a})|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex46.m2" class="ltx_math_unparsed" alttext="\displaystyle=\left|\mathbb{E}_{\tilde{\pi}^{\kappa}}\left[\sum_{t=\kappa+1}^{\infty}\gamma^{t}r_{i}(\mathbf{s}_{i}(t),\mathbf{a}_{i}(t))\mid\mathbf{s}(0)=\mathbf{s},\mathbf{a}(0)=\mathbf{a}\right]\right." display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo fence="false" rspace="0.167em">|</mo><msub><mi>𝔼</mi><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi>κ</mi></msup></msub><mrow><mo>[</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><msup><mi>γ</mi><mi>t</mi></msup><msub><mi>r</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝐚</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐬</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝐚</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left|\mathbb{E}_{\tilde{\pi}^{\kappa}}\left[\sum_{t=\kappa+1}^{\infty}\gamma^{t}r_{i}(\mathbf{s}_{i}(t),\mathbf{a}_{i}(t))\mid\mathbf{s}(0)=\mathbf{s},\mathbf{a}(0)=\mathbf{a}\right]\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex47"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex47.m1" class="ltx_math_unparsed" alttext="\displaystyle-\left.\mathbb{E}_{\tilde{\pi}^{\infty}}\left[\sum_{t=\kappa+1}^{\infty}\gamma^{t}r_{i}(\mathbf{s}_{i}(t),\mathbf{a}_{i}(t))\mid\mathbf{s}(0)=\mathbf{s},\mathbf{a}(0)=\mathbf{a}\right]\right|." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><msub><mi>𝔼</mi><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi mathvariant="normal">∞</mi></msup></msub><mrow><mo>[</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><msup><mi>γ</mi><mi>t</mi></msup><msub><mi>r</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝐚</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐬</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝐚</mi><mo>]</mo></mrow><mo fence="false">|</mo><mo lspace="0.167em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\left.\mathbb{E}_{\tilde{\pi}^{\infty}}\left[\sum_{t=\kappa+1}^{\infty}\gamma^{t}r_{i}(\mathbf{s}_{i}(t),\mathbf{a}_{i}(t))\mid\mathbf{s}(0)=\mathbf{s},\mathbf{a}(0)=\mathbf{a}\right]\right|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS2.p66" class="ltx_para">
<p id="A5.SS2.p66.1" class="ltx_p"><span id="A5.SS2.p66.1.1" class="ltx_text ltx_font_bold">Error bound:<span id="A5.SS2.p66.1.1.1" class="ltx_text ltx_font_medium">
Let <math id="A5.SS2.p66.m1" class="ltx_Math" alttext="\rho^{\tilde{\pi}^{\kappa}}_{t}" display="inline" intent=":literal"><semantics><msubsup><mi>ρ</mi><mi>t</mi><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi>κ</mi></msup></msubsup><annotation encoding="application/x-tex">\rho^{\tilde{\pi}^{\kappa}}_{t}</annotation></semantics></math> and <math id="A5.SS2.p66.m2" class="ltx_Math" alttext="\rho^{\tilde{\pi}^{\infty}}_{t}" display="inline" intent=":literal"><semantics><msubsup><mi>ρ</mi><mi>t</mi><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi mathvariant="normal">∞</mi></msup></msubsup><annotation encoding="application/x-tex">\rho^{\tilde{\pi}^{\infty}}_{t}</annotation></semantics></math> be the distributions of <math id="A5.SS2.p66.m3" class="ltx_Math" alttext="(\mathbf{s}_{i}(t),\mathbf{a}_{i}(t))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐬</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbf{s}_{i}(t),\mathbf{a}_{i}(t))</annotation></semantics></math> under policies <math id="A5.SS2.p66.m4" class="ltx_Math" alttext="\tilde{\pi}^{\kappa}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi>κ</mi></msup><annotation encoding="application/x-tex">\tilde{\pi}^{\kappa}</annotation></semantics></math> and <math id="A5.SS2.p66.m5" class="ltx_Math" alttext="\tilde{\pi}^{\infty}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">\tilde{\pi}^{\infty}</annotation></semantics></math> respectively, conditioned on <math id="A5.SS2.p66.m6" class="ltx_Math" alttext="(\mathbf{s}(0),\mathbf{a}(0))=(\mathbf{s},\mathbf{a})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐚</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(\mathbf{s}(0),\mathbf{a}(0))=(\mathbf{s},\mathbf{a})</annotation></semantics></math>.</span></span></p>
</div>
<div id="A5.SS2.p67" class="ltx_para">
<p id="A5.SS2.p67.1" class="ltx_p"><span id="A5.SS2.p67.1.1" class="ltx_text">From Lemma 6, we know that <math id="A5.SS2.p67.m1" class="ltx_Math" alttext="\rho^{\tilde{\pi}^{\kappa}}_{t}=\rho^{\tilde{\pi}^{\infty}}_{t}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ρ</mi><mi>t</mi><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi>κ</mi></msup></msubsup><mo>=</mo><msubsup><mi>ρ</mi><mi>t</mi><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi mathvariant="normal">∞</mi></msup></msubsup></mrow><annotation encoding="application/x-tex">\rho^{\tilde{\pi}^{\kappa}}_{t}=\rho^{\tilde{\pi}^{\infty}}_{t}</annotation></semantics></math> for <math id="A5.SS2.p67.m2" class="ltx_Math" alttext="t\leq\kappa" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≤</mo><mi>κ</mi></mrow><annotation encoding="application/x-tex">t\leq\kappa</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS2.p68" class="ltx_para">
<p id="A5.SS2.p68.1" class="ltx_p"><span id="A5.SS2.p68.1.1" class="ltx_text">For <math id="A5.SS2.p68.m1" class="ltx_Math" alttext="t&gt;\kappa" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&gt;</mo><mi>κ</mi></mrow><annotation encoding="application/x-tex">t&gt;\kappa</annotation></semantics></math>, we can bound the total variation distance between these distributions:</span></p>
<table id="A5.Ex48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex48.m1" class="ltx_Math" alttext="\text{TV}(\rho^{\tilde{\pi}^{\kappa}}_{t},\rho^{\tilde{\pi}^{\infty}}_{t})\leq 1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mtext>TV</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>ρ</mi><mi>t</mi><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi>κ</mi></msup></msubsup><mo>,</mo><msubsup><mi>ρ</mi><mi>t</mi><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi mathvariant="normal">∞</mi></msup></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\text{TV}(\rho^{\tilde{\pi}^{\kappa}}_{t},\rho^{\tilde{\pi}^{\infty}}_{t})\leq 1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS2.p69" class="ltx_para">
<p id="A5.SS2.p69.1" class="ltx_p"><span id="A5.SS2.p69.1.1" class="ltx_text">Therefore:</span></p>
<table id="A5.EGx13" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex49.m1" class="ltx_Math" alttext="\displaystyle|Q^{\tilde{\pi}^{\kappa}}_{i}(\mathbf{s},\mathbf{a})-Q^{\tilde{\pi}^{\infty}}_{i}(\mathbf{s},\mathbf{a})|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mrow><msubsup><mi>Q</mi><mi>i</mi><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi>κ</mi></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>Q</mi><mi>i</mi><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi mathvariant="normal">∞</mi></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle|Q^{\tilde{\pi}^{\kappa}}_{i}(\mathbf{s},\mathbf{a})-Q^{\tilde{\pi}^{\infty}}_{i}(\mathbf{s},\mathbf{a})|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex49.m2" class="ltx_Math" alttext="\displaystyle=\left|\sum_{t=\kappa+1}^{\infty}\gamma^{t}\left(\mathbb{E}_{(\mathbf{s}_{i},\mathbf{a}_{i})\sim\rho^{\tilde{\pi}^{\kappa}}_{t}}[r_{i}(\mathbf{s}_{i},\mathbf{a}_{i})]-\mathbb{E}_{(s_{i},a_{i})\sim\rho^{\tilde{\pi}^{\infty}}_{t}}[r_{i}(\mathbf{s}_{i},\mathbf{a}_{i})]\right)\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><msup><mi>γ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>𝔼</mi><mrow><mrow><mo stretchy="false">(</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐚</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>∼</mo><msubsup><mi>ρ</mi><mi>t</mi><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi>κ</mi></msup></msubsup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>r</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐚</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mrow><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>i</mi></msub><mo>,</mo><msub><mi>a</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>∼</mo><msubsup><mi>ρ</mi><mi>t</mi><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi mathvariant="normal">∞</mi></msup></msubsup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>r</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐚</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left|\sum_{t=\kappa+1}^{\infty}\gamma^{t}\left(\mathbb{E}_{(\mathbf{s}_{i},\mathbf{a}_{i})\sim\rho^{\tilde{\pi}^{\kappa}}_{t}}[r_{i}(\mathbf{s}_{i},\mathbf{a}_{i})]-\mathbb{E}_{(s_{i},a_{i})\sim\rho^{\tilde{\pi}^{\infty}}_{t}}[r_{i}(\mathbf{s}_{i},\mathbf{a}_{i})]\right)\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex50.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{t=\kappa+1}^{\infty}\gamma^{t}\bar{r}\cdot\text{TV}(\rho^{\tilde{\pi}^{\kappa}}_{t},\rho^{\tilde{\pi}^{\infty}}_{t})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><msup><mi>γ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>r</mi><mo>¯</mo></mover></mrow></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mtext>TV</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>ρ</mi><mi>t</mi><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi>κ</mi></msup></msubsup><mo>,</mo><msubsup><mi>ρ</mi><mi>t</mi><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi mathvariant="normal">∞</mi></msup></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{t=\kappa+1}^{\infty}\gamma^{t}\bar{r}\cdot\text{TV}(\rho^{\tilde{\pi}^{\kappa}}_{t},\rho^{\tilde{\pi}^{\infty}}_{t})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex51.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{t=\kappa+1}^{\infty}\gamma^{t}\bar{r}=\bar{r}\gamma^{\kappa+1}\frac{1}{1-\gamma}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><msup><mi>γ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>r</mi><mo>¯</mo></mover></mrow></mrow><mo>=</mo><mrow><mover accent="true"><mi>r</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{t=\kappa+1}^{\infty}\gamma^{t}\bar{r}=\bar{r}\gamma^{\kappa+1}\frac{1}{1-\gamma}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS2.p70" class="ltx_para">
<p id="A5.SS2.p70.1" class="ltx_p"><span id="A5.SS2.p70.1.1" class="ltx_text">This gives us the desired bound:</span></p>
<table id="A5.Ex52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex52.m1" class="ltx_Math" alttext="\sup_{(\mathbf{s},\mathbf{a})\in S\times A}|Q^{\tilde{\pi}^{\kappa}}_{i}(\mathbf{s},\mathbf{a})-Q^{\tilde{\pi}^{\infty}}_{i}(\mathbf{s},\mathbf{a})|\leq\frac{\bar{r}}{1-\gamma}\gamma^{\kappa+1}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi>S</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>A</mi></mrow></mrow></munder><mrow><mo lspace="0em" stretchy="false">|</mo><mrow><mrow><msubsup><mi>Q</mi><mi>i</mi><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi>κ</mi></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>Q</mi><mi>i</mi><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi mathvariant="normal">∞</mi></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><mover accent="true"><mi>r</mi><mo>¯</mo></mover><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sup_{(\mathbf{s},\mathbf{a})\in S\times A}|Q^{\tilde{\pi}^{\kappa}}_{i}(\mathbf{s},\mathbf{a})-Q^{\tilde{\pi}^{\infty}}_{i}(\mathbf{s},\mathbf{a})|\leq\frac{\bar{r}}{1-\gamma}\gamma^{\kappa+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS2.p71" class="ltx_para">
<p id="A5.SS2.p71.1" class="ltx_p"><span id="A5.SS2.p71.1.1" class="ltx_text">Since <math id="A5.SS2.p71.m1" class="ltx_Math" alttext="Q^{\tilde{\pi}^{\infty}}_{i}(\mathbf{s},\mathbf{a})=Q^{\pi}_{i}(\mathbf{s},\mathbf{a})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>Q</mi><mi>i</mi><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi mathvariant="normal">∞</mi></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>Q</mi><mi>i</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Q^{\tilde{\pi}^{\infty}}_{i}(\mathbf{s},\mathbf{a})=Q^{\pi}_{i}(\mathbf{s},\mathbf{a})</annotation></semantics></math> from Proposition <a href="#Thmproposition6" title="Proposition 6 (Compactness of policy ACR). ‣ E.2 Policy ACR ‣ Appendix E Missing proofs in Section ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>, we have:</span></p>
<table id="A5.Ex53" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex53.m1" class="ltx_Math" alttext="\sup_{(\mathbf{s},\mathbf{a})\in S\times A}|Q^{\tilde{\pi}^{\kappa}}_{i}(\mathbf{s},\mathbf{a})-Q^{\pi}_{i}(\mathbf{s},\mathbf{a})|\leq\frac{\bar{r}}{1-\gamma}\gamma^{\kappa+1}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi>S</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>A</mi></mrow></mrow></munder><mrow><mo lspace="0em" stretchy="false">|</mo><mrow><mrow><msubsup><mi>Q</mi><mi>i</mi><msup><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi>κ</mi></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>Q</mi><mi>i</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><mover accent="true"><mi>r</mi><mo>¯</mo></mover><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sup_{(\mathbf{s},\mathbf{a})\in S\times A}|Q^{\tilde{\pi}^{\kappa}}_{i}(\mathbf{s},\mathbf{a})-Q^{\pi}_{i}(\mathbf{s},\mathbf{a})|\leq\frac{\bar{r}}{1-\gamma}\gamma^{\kappa+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS2.p72" class="ltx_para">
<p id="A5.SS2.p72.1" class="ltx_p"><span id="A5.SS2.p72.1.1" class="ltx_text">This completes the proof of Proposition <a href="#Thmproposition7" title="Proposition 7 (Approximation error of policy ACR). ‣ E.2 Policy ACR ‣ Appendix E Missing proofs in Section ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>.
∎</span></p>
</div>
</div>
<div id="A5.SS2.7" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Proposition <a href="#Thmproposition2" title="Proposition 2 (Approximation error). ‣ 3.1 ACR for fixed environment ‣ 3 Approximately compact representation ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.</h6>
<div id="A5.SS2.p73" class="ltx_para">
<p id="A5.SS2.p73.1" class="ltx_p"><span id="A5.SS2.p73.1.1" class="ltx_text">Using Proposition <a href="#Thmproposition7" title="Proposition 7 (Approximation error of policy ACR). ‣ E.2 Policy ACR ‣ Appendix E Missing proofs in Section ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>, we have</span></p>
<table id="A5.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex54.m1" class="ltx_Math" alttext="\displaystyle\left\lvert\tilde{Q}_{i}^{\tilde{\pi}}\left(\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}\right)-Q_{i}^{\pi}\left(\mathbf{s},\mathbf{a}\right)\right\rvert" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><msubsup><mover accent="true"><mi>Q</mi><mo>~</mo></mover><mi>i</mi><mover accent="true"><mi>π</mi><mo>~</mo></mover></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo>,</mo><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>Q</mi><mi>i</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\lvert\tilde{Q}_{i}^{\tilde{\pi}}\left(\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}\right)-Q_{i}^{\pi}\left(\mathbf{s},\mathbf{a}\right)\right\rvert</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex54.m2" class="ltx_Math" alttext="\displaystyle\leq\left\lvert\tilde{Q}_{i}^{\tilde{\pi}}\left(\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}\right)-Q_{i}^{\tilde{\pi}}\left(\mathbf{s},\mathbf{a}\right)\right\rvert+\left\lvert Q_{i}^{\tilde{\pi}}\left(\mathbf{s},\mathbf{a}\right)-Q_{i}^{\pi}\left(\mathbf{s},\mathbf{a}\right)\right\rvert" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>|</mo><mrow><mrow><msubsup><mover accent="true"><mi>Q</mi><mo>~</mo></mover><mi>i</mi><mover accent="true"><mi>π</mi><mo>~</mo></mover></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo>,</mo><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>Q</mi><mi>i</mi><mover accent="true"><mi>π</mi><mo>~</mo></mover></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>+</mo><mrow><mo>|</mo><mrow><mrow><msubsup><mi>Q</mi><mi>i</mi><mover accent="true"><mi>π</mi><mo>~</mo></mover></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>Q</mi><mi>i</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\lvert\tilde{Q}_{i}^{\tilde{\pi}}\left(\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}\right)-Q_{i}^{\tilde{\pi}}\left(\mathbf{s},\mathbf{a}\right)\right\rvert+\left\lvert Q_{i}^{\tilde{\pi}}\left(\mathbf{s},\mathbf{a}\right)-Q_{i}^{\pi}\left(\mathbf{s},\mathbf{a}\right)\right\rvert</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex55"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex55.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{3\bar{r}}{1-\gamma}\gamma^{\kappa+1}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>r</mi><mo>¯</mo></mover></mrow><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{3\bar{r}}{1-\gamma}\gamma^{\kappa+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p73.2" class="ltx_p"><span id="A5.SS2.p73.2.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A5.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.3 </span>Cross domain</h3>

<div id="A5.SS3.p1" class="ltx_para">
<p id="A5.SS3.p1.1" class="ltx_p">Denote by <math id="A5.SS3.p1.m1" class="ltx_Math" alttext="\boldsymbol{\omega}_{\mathcal{N}_{i}^{\kappa}}:=(\boldsymbol{\omega}_{i})_{i\in\mathcal{N}_{i}^{\kappa}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝝎</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>:=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝝎</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></mrow></msub></mrow><annotation encoding="application/x-tex">\boldsymbol{\omega}_{\mathcal{N}_{i}^{\kappa}}:=(\boldsymbol{\omega}_{i})_{i\in\mathcal{N}_{i}^{\kappa}}</annotation></semantics></math> and <math id="A5.SS3.p1.m2" class="ltx_Math" alttext="\boldsymbol{\omega}_{\mathcal{N}^{\kappa}_{-i}}:=\boldsymbol{\omega}/\boldsymbol{\omega}_{\mathcal{N}_{i}^{\kappa}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝝎</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo>−</mo><mi>i</mi></mrow><mi>κ</mi></msubsup></msub><mo>:=</mo><mrow><mi>𝝎</mi><mo>/</mo><msub><mi>𝝎</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\omega}_{\mathcal{N}^{\kappa}_{-i}}:=\boldsymbol{\omega}/\boldsymbol{\omega}_{\mathcal{N}_{i}^{\kappa}}</annotation></semantics></math>.</p>
</div>
<div id="Thmlemma7" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma7.2" class="ltx_text ltx_font_bold">Lemma 7</span></span><span id="Thmlemma7.3" class="ltx_text ltx_font_bold"> </span>(Exponential decay property of domain-specific value functions)<span id="Thmlemma7.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma7.p1" class="ltx_para">
<p id="Thmlemma7.p1.1" class="ltx_p">For any localized policy <math id="Thmlemma7.p1.m1" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>, for any <math id="Thmlemma7.p1.m2" class="ltx_math_unparsed" alttext="i\in\mathscr{N},\mathbf{s}_{\mathcal{N}_{i}^{\kappa}}\in\mathcal{S}_{\mathcal{N}_{i}^{\kappa}},\mathbf{s}_{\mathcal{N}_{-i}^{\kappa}},\mathbf{s}_{\mathcal{N}_{-i}^{\kappa}}^{\prime}\in\mathcal{S}_{\mathcal{N}_{-i}^{\kappa}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}\in\mathcal{A}_{\mathcal{N}_{i}^{\kappa}},\mathbf{a}_{\mathcal{N}_{-i}^{\kappa}},\mathbf{a}_{\mathcal{N}_{-i}^{\kappa}}^{\prime}\in\mathcal{A}_{\mathcal{N}_{-i}^{\kappa}},\boldsymbol{\omega}_{\mathcal{N}_{i}^{\kappa}}\in\Omega_{\mathcal{N}_{i}^{\kappa}},\boldsymbol{\omega}_{\mathcal{N}^{\kappa}_{-i}},\boldsymbol{\omega}^{\prime}_{\mathcal{N}^{\kappa}_{-i}}\in\Omega_{\mathcal{N}_{-i}^{\kappa}}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mi class="ltx_font_mathscript">𝒩</mi><mo>,</mo><mi>𝐬</mi><msub><mrow></mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><msub><mrow></mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>,</mo><mi>𝐬</mi><msub><mrow></mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo>−</mo><mi>i</mi></mrow><mi>κ</mi></msubsup></msub><mo>,</mo><mi>𝐬</mi><msub><mrow></mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo>−</mo><mi>i</mi></mrow><mi>κ</mi></msubsup></msub><msup><mrow></mrow><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><msub><mrow></mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo>−</mo><mi>i</mi></mrow><mi>κ</mi></msubsup></msub><mo>,</mo><mi>𝐚</mi><msub><mrow></mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mrow></mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>,</mo><mi>𝐚</mi><msub><mrow></mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo>−</mo><mi>i</mi></mrow><mi>κ</mi></msubsup></msub><mo>,</mo><mi>𝐚</mi><msub><mrow></mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo>−</mo><mi>i</mi></mrow><mi>κ</mi></msubsup></msub><msup><mrow></mrow><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mrow></mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo>−</mo><mi>i</mi></mrow><mi>κ</mi></msubsup></msub><mo>,</mo><mi>𝝎</mi><msub><mrow></mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>∈</mo><mi mathvariant="normal">Ω</mi><msub><mrow></mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>,</mo><mi>𝝎</mi><msub><mrow></mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo>−</mo><mi>i</mi></mrow><mi>κ</mi></msubsup></msub><mo>,</mo><mi>𝝎</mi><msup><mrow></mrow><mo>′</mo></msup><msub><mrow></mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo>−</mo><mi>i</mi></mrow><mi>κ</mi></msubsup></msub><mo>∈</mo><mi mathvariant="normal">Ω</mi><msub><mrow></mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo>−</mo><mi>i</mi></mrow><mi>κ</mi></msubsup></msub></mrow><annotation encoding="application/x-tex">i\in\mathscr{N},\mathbf{s}_{\mathcal{N}_{i}^{\kappa}}\in\mathcal{S}_{\mathcal{N}_{i}^{\kappa}},\mathbf{s}_{\mathcal{N}_{-i}^{\kappa}},\mathbf{s}_{\mathcal{N}_{-i}^{\kappa}}^{\prime}\in\mathcal{S}_{\mathcal{N}_{-i}^{\kappa}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}\in\mathcal{A}_{\mathcal{N}_{i}^{\kappa}},\mathbf{a}_{\mathcal{N}_{-i}^{\kappa}},\mathbf{a}_{\mathcal{N}_{-i}^{\kappa}}^{\prime}\in\mathcal{A}_{\mathcal{N}_{-i}^{\kappa}},\boldsymbol{\omega}_{\mathcal{N}_{i}^{\kappa}}\in\Omega_{\mathcal{N}_{i}^{\kappa}},\boldsymbol{\omega}_{\mathcal{N}^{\kappa}_{-i}},\boldsymbol{\omega}^{\prime}_{\mathcal{N}^{\kappa}_{-i}}\in\Omega_{\mathcal{N}_{-i}^{\kappa}}</annotation></semantics></math>, the following holds</p>
<table id="A5.Ex56" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex56.m1" class="ltx_Math" alttext="\left|Q_{i}^{\pi}\left(\mathbf{s}_{\mathcal{N}_{i}^{\kappa}},\mathbf{s}_{\mathcal{N}^{\kappa}_{-i}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\mathbf{a}_{\mathcal{N}^{\kappa}_{-i}},\boldsymbol{\omega}_{\mathcal{N}_{i}^{\kappa}},\boldsymbol{\omega}_{\mathcal{N}^{\kappa}_{-i}}\right)-Q_{i}^{\pi}\left(\mathbf{s}_{\mathcal{N}_{i}^{\kappa}},\mathbf{s}_{\mathcal{N}_{-i}^{\kappa}}^{\prime},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\mathbf{a}_{\mathcal{N}^{\kappa}_{-i}}^{\prime},\boldsymbol{\omega}_{\mathcal{N}_{i}^{\kappa}},\boldsymbol{\omega}^{\prime}_{\mathcal{N}^{\kappa}_{-i}}\right)\right|\leq\frac{\bar{r}}{1-\gamma}\gamma^{\kappa}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mrow><msubsup><mi>Q</mi><mi>i</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>,</mo><msub><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo>−</mo><mi>i</mi></mrow><mi>κ</mi></msubsup></msub><mo>,</mo><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>,</mo><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo>−</mo><mi>i</mi></mrow><mi>κ</mi></msubsup></msub><mo>,</mo><msub><mi>𝝎</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>,</mo><msub><mi>𝝎</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo>−</mo><mi>i</mi></mrow><mi>κ</mi></msubsup></msub><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>Q</mi><mi>i</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>,</mo><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo>−</mo><mi>i</mi></mrow><mi>κ</mi></msubsup><mo>′</mo></msubsup><mo>,</mo><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>,</mo><msubsup><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo>−</mo><mi>i</mi></mrow><mi>κ</mi></msubsup><mo>′</mo></msubsup><mo>,</mo><msub><mi>𝝎</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>,</mo><msubsup><mi>𝝎</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo>−</mo><mi>i</mi></mrow><mi>κ</mi></msubsup><mo>′</mo></msubsup><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mfrac><mover accent="true"><mi>r</mi><mo>¯</mo></mover><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mi>κ</mi></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|Q_{i}^{\pi}\left(\mathbf{s}_{\mathcal{N}_{i}^{\kappa}},\mathbf{s}_{\mathcal{N}^{\kappa}_{-i}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\mathbf{a}_{\mathcal{N}^{\kappa}_{-i}},\boldsymbol{\omega}_{\mathcal{N}_{i}^{\kappa}},\boldsymbol{\omega}_{\mathcal{N}^{\kappa}_{-i}}\right)-Q_{i}^{\pi}\left(\mathbf{s}_{\mathcal{N}_{i}^{\kappa}},\mathbf{s}_{\mathcal{N}_{-i}^{\kappa}}^{\prime},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\mathbf{a}_{\mathcal{N}^{\kappa}_{-i}}^{\prime},\boldsymbol{\omega}_{\mathcal{N}_{i}^{\kappa}},\boldsymbol{\omega}^{\prime}_{\mathcal{N}^{\kappa}_{-i}}\right)\right|\leq\frac{\bar{r}}{1-\gamma}\gamma^{\kappa}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS3.p2" class="ltx_para">
<p id="A5.SS3.p2.1" class="ltx_p"><span id="A5.SS3.p2.1.1" class="ltx_text">The proof follows from that of Lemma <a href="#Thmlemma1" title="Lemma 1. ‣ Appendix C Background in networked MARL ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>
by augmenting the state space of each agent by <math id="A5.SS3.p2.m1" class="ltx_Math" alttext="\mathcal{S}_{i}\times\Omega_{i}\ni(\mathbf{s}_{i},\boldsymbol{\omega}_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi mathvariant="normal">Ω</mi><mi>i</mi></msub></mrow><mo>∋</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝝎</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{S}_{i}\times\Omega_{i}\ni(\mathbf{s}_{i},\boldsymbol{\omega}_{i})</annotation></semantics></math>, where the augmented state variable <math id="A5.SS3.p2.m2" class="ltx_Math" alttext="\boldsymbol{\omega}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝝎</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\boldsymbol{\omega}_{i}</annotation></semantics></math> degenerates to a deterministic state (<math id="A5.SS3.p2.m3" class="ltx_Math" alttext="\boldsymbol{\omega}_{i}(t)=\boldsymbol{\omega}_{i},\forall t" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝝎</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>𝝎</mi><mi>i</mi></msub></mrow><mo>,</mo><mrow><mo rspace="0.167em">∀</mo><mi>t</mi></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\omega}_{i}(t)=\boldsymbol{\omega}_{i},\forall t</annotation></semantics></math>).
∎</span></p>
</div>
</div>
<section id="A5.SS3.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">E.3.1 </span>Value functions</h4>

<div id="A5.SS3.SSS1.p1" class="ltx_para">
<p id="A5.SS3.SSS1.p1.1" class="ltx_p">Given the generative model (Equation <a href="#S2.E6" title="In Networked MARL under domain generalization ‣ 2 Preliminaries ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>), we define <math id="A5.SS3.SSS1.p1.m1" class="ltx_Math" alttext="\boldsymbol{\omega}" display="inline" intent=":literal"><semantics><mi>𝝎</mi><annotation encoding="application/x-tex">\boldsymbol{\omega}</annotation></semantics></math>-ACR for <math id="A5.SS3.SSS1.p1.m2" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>-functions as follows.</p>
</div>
<div id="Thmdefinition5" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmdefinition5.2" class="ltx_text ltx_font_bold">Definition 5</span></span><span id="Thmdefinition5.3" class="ltx_text ltx_font_bold"> </span>(Value <math id="Thmdefinition5.m1" class="ltx_Math" alttext="\boldsymbol{\omega}" display="inline" intent=":literal"><semantics><mi>𝝎</mi><annotation encoding="application/x-tex">\boldsymbol{\omega}</annotation></semantics></math>-ACR)<span id="Thmdefinition5.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmdefinition5.p1" class="ltx_para">
<p id="Thmdefinition5.p1.1" class="ltx_p">Given the graphical representation of the networked system model <math id="Thmdefinition5.p1.m1" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> that is encoded in the binary masks <math id="Thmdefinition5.p1.m2" class="ltx_math_unparsed" alttext="c^{\cdot\rightarrow\cdot}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><msup><mrow></mrow><mrow><mo rspace="0em">⋅</mo><mo lspace="0em" rspace="0em" stretchy="false">→</mo><mo lspace="0em">⋅</mo></mrow></msup></mrow><annotation encoding="application/x-tex">c^{\cdot\rightarrow\cdot}</annotation></semantics></math>, the value ACR <math id="Thmdefinition5.p1.m3" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}}</annotation></semantics></math> (Definition <a href="#Thmdefinition1" title="Definition 1 (Value ACR). ‣ 3.1 ACR for fixed environment ‣ 3 Approximately compact representation ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>), for each agent <math id="Thmdefinition5.p1.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> and its <math id="Thmdefinition5.p1.m5" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>-hop neighborhood <math id="Thmdefinition5.p1.m6" class="ltx_Math" alttext="\mathcal{N}^{\kappa}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><annotation encoding="application/x-tex">\mathcal{N}^{\kappa}_{i}</annotation></semantics></math>, we recursively define <span id="Thmdefinition5.p1.1.1" class="ltx_text ltx_font_bold">domain-specific ACR</span> <math id="Thmdefinition5.p1.m7" class="ltx_Math" alttext="\boldsymbol{\omega}^{\circ}_{\mathcal{N}^{\kappa}_{i}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝝎</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><annotation encoding="application/x-tex">\boldsymbol{\omega}^{\circ}_{\mathcal{N}^{\kappa}_{i}}</annotation></semantics></math>: the latent change factors <math id="Thmdefinition5.p1.m8" class="ltx_Math" alttext="\boldsymbol{\omega}_{\mathcal{N}^{\kappa}_{i}}" display="inline" intent=":literal"><semantics><msub><mi>𝝎</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><annotation encoding="application/x-tex">\boldsymbol{\omega}_{\mathcal{N}^{\kappa}_{i}}</annotation></semantics></math> that either</p>
<ul id="A5.I12" class="ltx_itemize">
<li id="A5.I12.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I12.i1.p1" class="ltx_para">
<p id="A5.I12.i1.p1.1" class="ltx_p"><math id="A5.I12.i1.p1.m1" class="ltx_Math" alttext="\boldsymbol{\omega}_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>𝝎</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\boldsymbol{\omega}_{i,j}</annotation></semantics></math> has a direct link to agent <math id="A5.I12.i1.p1.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>’s reward <math id="A5.I12.i1.p1.m3" class="ltx_Math" alttext="r_{i}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>i</mi></msub><annotation encoding="application/x-tex">r_{i}</annotation></semantics></math>, i.e., <math id="A5.I12.i1.p1.m4" class="ltx_Math" alttext="\boldsymbol{\omega}_{i,j}=\boldsymbol{\omega}^{r}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝝎</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>=</mo><msubsup><mi>𝝎</mi><mi>i</mi><mi>r</mi></msubsup></mrow><annotation encoding="application/x-tex">\boldsymbol{\omega}_{i,j}=\boldsymbol{\omega}^{r}_{i}</annotation></semantics></math> and <math id="A5.I12.i1.p1.m5" class="ltx_Math" alttext="\mathbf{c}^{\boldsymbol{\omega}\rightarrow r_{i}}_{i,j}=1" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐜</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mi>𝝎</mi><mo stretchy="false">→</mo><msub><mi>r</mi><mi>i</mi></msub></mrow></msubsup><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\mathbf{c}^{\boldsymbol{\omega}\rightarrow r_{i}}_{i,j}=1</annotation></semantics></math>, or</p>
</div></li>
<li id="A5.I12.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I12.i2.p1" class="ltx_para">
<p id="A5.I12.i2.p1.1" class="ltx_p"><math id="A5.I12.i2.p1.m1" class="ltx_Math" alttext="\boldsymbol{\omega}_{i^{\prime},j}" display="inline" intent=":literal"><semantics><msub><mi>𝝎</mi><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\boldsymbol{\omega}_{i^{\prime},j}</annotation></semantics></math> has an edge to a state component <math id="A5.I12.i2.p1.m2" class="ltx_Math" alttext="s_{i^{\prime},l}\in\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>,</mo><mi>l</mi></mrow></msub><mo>∈</mo><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup></mrow><annotation encoding="application/x-tex">s_{i^{\prime},l}\in\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}}</annotation></semantics></math>, i.e., <math id="A5.I12.i2.p1.m3" class="ltx_Math" alttext="\mathbf{c}^{\boldsymbol{\omega}\rightarrow s}_{i^{\prime},j,l}=1" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐜</mi><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>,</mo><mi>j</mi><mo>,</mo><mi>l</mi></mrow><mrow><mi>𝝎</mi><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\mathbf{c}^{\boldsymbol{\omega}\rightarrow s}_{i^{\prime},j,l}=1</annotation></semantics></math> and <math id="A5.I12.i2.p1.m4" class="ltx_Math" alttext="s_{i^{\prime},l}\in\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>,</mo><mi>l</mi></mrow></msub><mo>∈</mo><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup></mrow><annotation encoding="application/x-tex">s_{i^{\prime},l}\in\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}}</annotation></semantics></math>.</p>
</div></li>
</ul>
</div>
</div>
<div id="A5.SS3.SSS1.p2" class="ltx_para">
<p id="A5.SS3.SSS1.p2.1" class="ltx_p">Definition <a href="#Thmdefinition5" title="Definition 5 (Value 𝝎-ACR). ‣ E.3.1 Value functions ‣ E.3 Cross domain ‣ Appendix E Missing proofs in Section ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> also defines agent-wise ACR: <math id="A5.SS3.SSS1.p2.m1" class="ltx_math_unparsed" alttext="\cup_{i^{\prime}\in\mathcal{N}^{\kappa}_{i}}\boldsymbol{\omega}^{\circ}_{i^{\prime}}=\boldsymbol{\omega}^{\circ}_{\mathcal{N}^{\kappa}_{i}}" display="inline" intent=":literal"><semantics><mrow><mo>∪</mo><msub><mrow></mrow><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></mrow></msub><mi>𝝎</mi><msup><mrow></mrow><mo>∘</mo></msup><msub><mrow></mrow><msup><mi>i</mi><mo>′</mo></msup></msub><mo>=</mo><mi>𝝎</mi><msup><mrow></mrow><mo>∘</mo></msup><msub><mrow></mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub></mrow><annotation encoding="application/x-tex">\cup_{i^{\prime}\in\mathcal{N}^{\kappa}_{i}}\boldsymbol{\omega}^{\circ}_{i^{\prime}}=\boldsymbol{\omega}^{\circ}_{\mathcal{N}^{\kappa}_{i}}</annotation></semantics></math>.</p>
</div>
<div id="Thmdefinition6" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmdefinition6.2" class="ltx_text ltx_font_bold">Definition 6</span></span><span id="Thmdefinition6.3" class="ltx_text ltx_font_bold"> </span>(Approximately compact <math id="Thmdefinition6.m1" class="ltx_Math" alttext="\boldsymbol{\omega}" display="inline" intent=":literal"><semantics><mi>𝝎</mi><annotation encoding="application/x-tex">\boldsymbol{\omega}</annotation></semantics></math>-conditioned <math id="Thmdefinition6.m2" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>-function)<span id="Thmdefinition6.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmdefinition6.p1" class="ltx_para">
<p id="Thmdefinition6.p1.1" class="ltx_p">Fix <math id="Thmdefinition6.p1.m1" class="ltx_Math" alttext="i\in\mathscr{N}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mi class="ltx_font_mathscript">𝒩</mi></mrow><annotation encoding="application/x-tex">i\in\mathscr{N}</annotation></semantics></math> and an arbitrary <math id="Thmdefinition6.p1.m2" class="ltx_Math" alttext="\bar{s}_{\mathcal{N}_{i}^{\kappa}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>s</mi><mo>¯</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><annotation encoding="application/x-tex">\bar{s}_{\mathcal{N}_{i}^{\kappa}}</annotation></semantics></math> and <math id="Thmdefinition6.p1.m3" class="ltx_Math" alttext="\bar{\boldsymbol{\omega}}_{\mathcal{N}_{i}^{\kappa}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝝎</mi><mo>¯</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><annotation encoding="application/x-tex">\bar{\boldsymbol{\omega}}_{\mathcal{N}_{i}^{\kappa}}</annotation></semantics></math>. Define the approximately compact <math id="Thmdefinition6.p1.m4" class="ltx_Math" alttext="\boldsymbol{\omega}" display="inline" intent=":literal"><semantics><mi>𝝎</mi><annotation encoding="application/x-tex">\boldsymbol{\omega}</annotation></semantics></math>-conditioned <math id="Thmdefinition6.p1.m5" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>-function as</p>
<table id="A5.Ex57" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex57.m1" class="ltx_Math" alttext="\tilde{Q}_{i}^{\pi}\left(\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\boldsymbol{\omega}_{\mathcal{N}^{\kappa}_{i}}^{\circ}\right):=\hat{Q}_{i}^{\pi}\left(\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}},\bar{\mathbf{s}}_{\mathcal{N}_{i}^{\kappa}}/\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\boldsymbol{\omega}_{\mathcal{N}^{\kappa}_{i}}^{\circ},\bar{\boldsymbol{\omega}}_{\mathcal{N}_{i}^{\kappa}}/\boldsymbol{\omega}_{\mathcal{N}^{\kappa}_{i}}^{\circ}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mover accent="true"><mi>Q</mi><mo>~</mo></mover><mi>i</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo>,</mo><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>,</mo><msubsup><mi>𝝎</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo>)</mo></mrow></mrow><mo>:=</mo><mrow><msubsup><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mi>i</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo>,</mo><mrow><msub><mover accent="true"><mi>𝐬</mi><mo>¯</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>/</mo><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup></mrow><mo>,</mo><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>,</mo><msubsup><mi>𝝎</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo>,</mo><mrow><msub><mover accent="true"><mi>𝝎</mi><mo>¯</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>/</mo><msubsup><mi>𝝎</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{Q}_{i}^{\pi}\left(\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\boldsymbol{\omega}_{\mathcal{N}^{\kappa}_{i}}^{\circ}\right):=\hat{Q}_{i}^{\pi}\left(\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}},\bar{\mathbf{s}}_{\mathcal{N}_{i}^{\kappa}}/\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\boldsymbol{\omega}_{\mathcal{N}^{\kappa}_{i}}^{\circ},\bar{\boldsymbol{\omega}}_{\mathcal{N}_{i}^{\kappa}}/\boldsymbol{\omega}_{\mathcal{N}^{\kappa}_{i}}^{\circ}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="Thmproposition8" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmproposition8.2" class="ltx_text ltx_font_bold">Proposition 8</span></span><span id="Thmproposition8.3" class="ltx_text ltx_font_bold"> </span>(Approximation error of value ACR)<span id="Thmproposition8.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmproposition8.p1" class="ltx_para">
<p id="Thmproposition8.p1.1" class="ltx_p">For each agent <math id="Thmproposition8.p1.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, the approximation error between <math id="Thmproposition8.p1.m2" class="ltx_Math" alttext="\tilde{Q}_{i}^{\pi}\left(\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\boldsymbol{\omega}_{\mathcal{N}^{\kappa}_{i}}^{\circ}\right)" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>Q</mi><mo>~</mo></mover><mi>i</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo>,</mo><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>,</mo><msubsup><mi>𝝎</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{Q}_{i}^{\pi}\left(\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\boldsymbol{\omega}_{\mathcal{N}^{\kappa}_{i}}^{\circ}\right)</annotation></semantics></math> and <math id="Thmproposition8.p1.m3" class="ltx_Math" alttext="Q_{i}^{\pi}\left(\mathbf{s},\mathbf{a},\boldsymbol{\omega}\right)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Q</mi><mi>i</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo>,</mo><mi>𝝎</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">Q_{i}^{\pi}\left(\mathbf{s},\mathbf{a},\boldsymbol{\omega}\right)</annotation></semantics></math> can be bounded as</p>
<table id="A5.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex58"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex58.m1" class="ltx_Math" alttext="\displaystyle\sup_{(\mathbf{s},\mathbf{a})\in\mathcal{S}\times\mathcal{A}}\left\lvert\tilde{Q}_{i}^{\pi}\left(\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\boldsymbol{\omega}_{\mathcal{N}^{\kappa}_{i}}^{\circ}\right)-Q_{i}^{\pi}\left(\mathbf{s},\mathbf{a},\boldsymbol{\omega}\right)\right\rvert\leq\frac{2\bar{r}}{1-\gamma}\gamma^{\kappa+1}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow></mrow></munder><mrow><mo lspace="0em">|</mo><mrow><mrow><msubsup><mover accent="true"><mi>Q</mi><mo>~</mo></mover><mi>i</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo>,</mo><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>,</mo><msubsup><mi>𝝎</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>Q</mi><mi>i</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo>,</mo><mi>𝝎</mi><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>r</mi><mo>¯</mo></mover></mrow><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{(\mathbf{s},\mathbf{a})\in\mathcal{S}\times\mathcal{A}}\left\lvert\tilde{Q}_{i}^{\pi}\left(\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\boldsymbol{\omega}_{\mathcal{N}^{\kappa}_{i}}^{\circ}\right)-Q_{i}^{\pi}\left(\mathbf{s},\mathbf{a},\boldsymbol{\omega}\right)\right\rvert\leq\frac{2\bar{r}}{1-\gamma}\gamma^{\kappa+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS3.SSS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS3.SSS1.p3" class="ltx_para">
<p id="A5.SS3.SSS1.p3.1" class="ltx_p"><span id="A5.SS3.SSS1.p3.1.1" class="ltx_text">The proof follows from that of Proposition <a href="#Thmproposition1" title="Proposition 1 (Approximation error of value ACR). ‣ 3.1 ACR for fixed environment ‣ 3 Approximately compact representation ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> by augmenting the state space of each agent by <math id="A5.SS3.SSS1.p3.m1" class="ltx_Math" alttext="\mathcal{S}_{i}\times\Omega_{i}\ni(\mathbf{s}_{i},\boldsymbol{\omega}_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi mathvariant="normal">Ω</mi><mi>i</mi></msub></mrow><mo>∋</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝝎</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{S}_{i}\times\Omega_{i}\ni(\mathbf{s}_{i},\boldsymbol{\omega}_{i})</annotation></semantics></math>, where the augmented state variable <math id="A5.SS3.SSS1.p3.m2" class="ltx_Math" alttext="\boldsymbol{\omega}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝝎</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\boldsymbol{\omega}_{i}</annotation></semantics></math> degenerates to a deterministic state (<math id="A5.SS3.SSS1.p3.m3" class="ltx_Math" alttext="\boldsymbol{\omega}_{i}(t)=\boldsymbol{\omega}_{i},\forall t" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝝎</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>𝝎</mi><mi>i</mi></msub></mrow><mo>,</mo><mrow><mo rspace="0.167em">∀</mo><mi>t</mi></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\omega}_{i}(t)=\boldsymbol{\omega}_{i},\forall t</annotation></semantics></math>).
∎</span></p>
</div>
</div>
</section>
<section id="A5.SS3.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">E.3.2 </span>Policies</h4>

<div id="Thmdefinition7" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmdefinition7.2" class="ltx_text ltx_font_bold">Definition 7</span></span><span id="Thmdefinition7.3" class="ltx_text ltx_font_bold"> </span>(<math id="Thmdefinition7.m1" class="ltx_Math" alttext="\boldsymbol{\omega}" display="inline" intent=":literal"><semantics><mi>𝝎</mi><annotation encoding="application/x-tex">\boldsymbol{\omega}</annotation></semantics></math>-ACR for localized policies)<span id="Thmdefinition7.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmdefinition7.p1" class="ltx_para">
<p id="Thmdefinition7.p1.1" class="ltx_p">Given the graphical representation of the networked system model <math id="Thmdefinition7.p1.m1" class="ltx_Math" alttext="\mathscr{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">𝒢</mi><annotation encoding="application/x-tex">\mathscr{G}</annotation></semantics></math> that is encoded in the binary masks <math id="Thmdefinition7.p1.m2" class="ltx_Math" alttext="\mathbf{c}" display="inline" intent=":literal"><semantics><mi>𝐜</mi><annotation encoding="application/x-tex">\mathbf{c}</annotation></semantics></math>, the policy ACR <math id="Thmdefinition7.p1.m3" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{\mathcal{N}_{i}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{\mathcal{N}_{i}}</annotation></semantics></math> obtained from Algorithm <a href="#alg2" title="Algorithm 2 ‣ D.2 Policy ACR ‣ Appendix D Algorithm design ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> or Algorithm <a href="#alg3" title="Algorithm 3 ‣ D.2 Policy ACR ‣ Appendix D Algorithm design ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, for each agent <math id="Thmdefinition7.p1.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> and its <math id="Thmdefinition7.p1.m5" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>-hop neighborhood <math id="Thmdefinition7.p1.m6" class="ltx_Math" alttext="\mathcal{N}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{N}_{i}</annotation></semantics></math>, we recursively define <span id="Thmdefinition7.p1.1.1" class="ltx_text ltx_font_bold">domain-specific ACR</span> <math id="Thmdefinition7.p1.m7" class="ltx_Math" alttext="\omega^{\circ}_{\mathcal{N}_{i}}" display="inline" intent=":literal"><semantics><msubsup><mi>ω</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><annotation encoding="application/x-tex">\omega^{\circ}_{\mathcal{N}_{i}}</annotation></semantics></math>: the latent factors <math id="Thmdefinition7.p1.m8" class="ltx_Math" alttext="\boldsymbol{\omega}_{\mathcal{N}_{i}}" display="inline" intent=":literal"><semantics><msub><mi>𝝎</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><annotation encoding="application/x-tex">\boldsymbol{\omega}_{\mathcal{N}_{i}}</annotation></semantics></math> that either</p>
<ul id="A5.I13" class="ltx_itemize">
<li id="A5.I13.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I13.i1.p1" class="ltx_para">
<p id="A5.I13.i1.p1.1" class="ltx_p"><math id="A5.I13.i1.p1.m1" class="ltx_Math" alttext="\boldsymbol{\omega}_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>𝝎</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\boldsymbol{\omega}_{i,j}</annotation></semantics></math> has a direct link to agent <math id="A5.I13.i1.p1.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>’s reward <math id="A5.I13.i1.p1.m3" class="ltx_Math" alttext="r_{i}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>i</mi></msub><annotation encoding="application/x-tex">r_{i}</annotation></semantics></math>, i.e., <math id="A5.I13.i1.p1.m4" class="ltx_Math" alttext="\boldsymbol{\omega}_{i,j}=\boldsymbol{\omega}^{r}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝝎</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>=</mo><msubsup><mi>𝝎</mi><mi>i</mi><mi>r</mi></msubsup></mrow><annotation encoding="application/x-tex">\boldsymbol{\omega}_{i,j}=\boldsymbol{\omega}^{r}_{i}</annotation></semantics></math> and <math id="A5.I13.i1.p1.m5" class="ltx_Math" alttext="\mathbf{c}^{\boldsymbol{\omega}\rightarrow r_{i}}_{i,j}=1" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐜</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mi>𝝎</mi><mo stretchy="false">→</mo><msub><mi>r</mi><mi>i</mi></msub></mrow></msubsup><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\mathbf{c}^{\boldsymbol{\omega}\rightarrow r_{i}}_{i,j}=1</annotation></semantics></math>, or</p>
</div></li>
<li id="A5.I13.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I13.i2.p1" class="ltx_para">
<p id="A5.I13.i2.p1.1" class="ltx_p"><math id="A5.I13.i2.p1.m1" class="ltx_Math" alttext="\boldsymbol{\omega}_{i^{\prime},j}" display="inline" intent=":literal"><semantics><msub><mi>𝝎</mi><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\boldsymbol{\omega}_{i^{\prime},j}</annotation></semantics></math> has an edge to a state component <math id="A5.I13.i2.p1.m2" class="ltx_Math" alttext="s_{i^{\prime},l}\in\mathbf{s}^{\circ}_{\mathcal{N}_{i}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>,</mo><mi>l</mi></mrow></msub><mo>∈</mo><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup></mrow><annotation encoding="application/x-tex">s_{i^{\prime},l}\in\mathbf{s}^{\circ}_{\mathcal{N}_{i}}</annotation></semantics></math>, i.e., <math id="A5.I13.i2.p1.m3" class="ltx_Math" alttext="\mathbf{c}^{\boldsymbol{\omega}\rightarrow s}_{i^{\prime},j,l}=1" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐜</mi><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>,</mo><mi>j</mi><mo>,</mo><mi>l</mi></mrow><mrow><mi>𝝎</mi><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\mathbf{c}^{\boldsymbol{\omega}\rightarrow s}_{i^{\prime},j,l}=1</annotation></semantics></math> and <math id="A5.I13.i2.p1.m4" class="ltx_Math" alttext="s_{i^{\prime},l}\in\mathbf{s}^{\circ}_{\mathcal{N}_{i}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>,</mo><mi>l</mi></mrow></msub><mo>∈</mo><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup></mrow><annotation encoding="application/x-tex">s_{i^{\prime},l}\in\mathbf{s}^{\circ}_{\mathcal{N}_{i}}</annotation></semantics></math>.</p>
</div></li>
</ul>
</div>
</div>
<div id="Thmdefinition8" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmdefinition8.2" class="ltx_text ltx_font_bold">Definition 8</span></span><span id="Thmdefinition8.3" class="ltx_text ltx_font_bold"> </span>(Approximately compact <math id="Thmdefinition8.m1" class="ltx_Math" alttext="\boldsymbol{\omega}" display="inline" intent=":literal"><semantics><mi>𝝎</mi><annotation encoding="application/x-tex">\boldsymbol{\omega}</annotation></semantics></math>-conditioned policy)<span id="Thmdefinition8.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmdefinition8.p1" class="ltx_para">
<p id="Thmdefinition8.p1.1" class="ltx_p">A domain-specific localized policy <math id="Thmdefinition8.p1.m1" class="ltx_Math" alttext="\pi=\left(\pi_{1},\ldots,\pi_{n}\right)" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>=</mo><mrow><mo>(</mo><msub><mi>π</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>π</mi><mi>n</mi></msub><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi=\left(\pi_{1},\ldots,\pi_{n}\right)</annotation></semantics></math> is called an approximately compact localized policy if the following holds for all <math id="Thmdefinition8.p1.m2" class="ltx_Math" alttext="i\in\mathcal{N},\mathbf{s}_{\mathcal{N}_{i}},\mathbf{s}^{\prime}_{\mathcal{N}_{i}}\in\mathcal{S}_{\mathcal{N}_{i}},\boldsymbol{\omega}_{\mathcal{N}_{i}},\boldsymbol{\omega}^{\prime}_{\mathcal{N}_{i}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow><mo>,</mo><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo>,</mo><mrow><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>′</mo></msubsup><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub></mrow><mo>,</mo><msub><mi>𝝎</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo>,</mo><msubsup><mi>𝝎</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">i\in\mathcal{N},\mathbf{s}_{\mathcal{N}_{i}},\mathbf{s}^{\prime}_{\mathcal{N}_{i}}\in\mathcal{S}_{\mathcal{N}_{i}},\boldsymbol{\omega}_{\mathcal{N}_{i}},\boldsymbol{\omega}^{\prime}_{\mathcal{N}_{i}}</annotation></semantics></math>:</p>
<table id="A5.Ex59" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex59.m1" class="ltx_math_unparsed" alttext="\pi_{i}\left(\cdot\mid\mathbf{s}^{\circ}_{\mathcal{N}_{i}},\mathbf{s}_{\mathcal{N}_{i}}/\mathbf{s}^{\circ}_{\mathcal{N}_{i}},\boldsymbol{\omega}_{\mathcal{N}_{i}}^{\circ},\boldsymbol{\omega}_{\mathcal{N}_{i}}/\boldsymbol{\omega}_{\mathcal{N}_{i}}^{\circ}\right)=\pi_{i}\left(\cdot\mid\mathbf{s}^{\circ}_{\mathcal{N}_{i}},\mathbf{s}^{\prime}_{\mathcal{N}_{i}}/\mathbf{s}^{\circ}_{\mathcal{N}_{i}},\boldsymbol{\omega}_{\mathcal{N}_{i}}^{\circ},\boldsymbol{\omega}^{\prime}_{\mathcal{N}_{i}}/\boldsymbol{\omega}_{\mathcal{N}_{i}}^{\circ}\right)." display="block" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>i</mi></msub><mrow><mo>(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo>,</mo><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo>/</mo><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo>,</mo><msubsup><mi>𝝎</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo>,</mo><msub><mi>𝝎</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo>/</mo><msubsup><mi>𝝎</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo>)</mo></mrow><mo>=</mo><msub><mi>π</mi><mi>i</mi></msub><mrow><mo>(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo>,</mo><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>′</mo></msubsup><mo>/</mo><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo>,</mo><msubsup><mi>𝝎</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo>,</mo><msubsup><mi>𝝎</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>′</mo></msubsup><mo>/</mo><msubsup><mi>𝝎</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\pi_{i}\left(\cdot\mid\mathbf{s}^{\circ}_{\mathcal{N}_{i}},\mathbf{s}_{\mathcal{N}_{i}}/\mathbf{s}^{\circ}_{\mathcal{N}_{i}},\boldsymbol{\omega}_{\mathcal{N}_{i}}^{\circ},\boldsymbol{\omega}_{\mathcal{N}_{i}}/\boldsymbol{\omega}_{\mathcal{N}_{i}}^{\circ}\right)=\pi_{i}\left(\cdot\mid\mathbf{s}^{\circ}_{\mathcal{N}_{i}},\mathbf{s}^{\prime}_{\mathcal{N}_{i}}/\mathbf{s}^{\circ}_{\mathcal{N}_{i}},\boldsymbol{\omega}_{\mathcal{N}_{i}}^{\circ},\boldsymbol{\omega}^{\prime}_{\mathcal{N}_{i}}/\boldsymbol{\omega}_{\mathcal{N}_{i}}^{\circ}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmdefinition8.p1.2" class="ltx_p">In other words, there exists <math id="Thmdefinition8.p1.m3" class="ltx_Math" alttext="\tilde{\pi}_{i}:\mathcal{S}^{\circ}_{\mathcal{N}_{i}}\times\Omega^{\circ}_{\mathcal{N}_{i}}\mapsto\Delta_{\mathcal{A}_{i}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi mathvariant="normal">Ω</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup></mrow><mo stretchy="false">↦</mo><msub><mi mathvariant="normal">Δ</mi><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>i</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">\tilde{\pi}_{i}:\mathcal{S}^{\circ}_{\mathcal{N}_{i}}\times\Omega^{\circ}_{\mathcal{N}_{i}}\mapsto\Delta_{\mathcal{A}_{i}}</annotation></semantics></math> such that <math id="Thmdefinition8.p1.m4" class="ltx_math_unparsed" alttext="\pi_{i}\left(\cdot\mid\mathbf{s}^{\circ}_{\mathcal{N}_{i}},\mathbf{s}_{\mathcal{N}_{i}}/\mathbf{s}^{\circ}_{\mathcal{N}_{i}},\boldsymbol{\omega}_{\mathcal{N}_{i}}^{\circ},\boldsymbol{\omega}_{\mathcal{N}_{i}}/\boldsymbol{\omega}_{\mathcal{N}_{i}}^{\circ}\right)=\tilde{\pi}_{i}\left(\cdot\mid\mathbf{s}^{\circ}_{\mathcal{N}_{i}},\boldsymbol{\omega}_{\mathcal{N}_{i}}^{\circ}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>i</mi></msub><mrow><mo>(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo>,</mo><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo>/</mo><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo>,</mo><msubsup><mi>𝝎</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo>,</mo><msub><mi>𝝎</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo>/</mo><msubsup><mi>𝝎</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo>)</mo></mrow><mo>=</mo><msub><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi>i</mi></msub><mrow><mo>(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo>,</mo><msubsup><mi>𝝎</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{i}\left(\cdot\mid\mathbf{s}^{\circ}_{\mathcal{N}_{i}},\mathbf{s}_{\mathcal{N}_{i}}/\mathbf{s}^{\circ}_{\mathcal{N}_{i}},\boldsymbol{\omega}_{\mathcal{N}_{i}}^{\circ},\boldsymbol{\omega}_{\mathcal{N}_{i}}/\boldsymbol{\omega}_{\mathcal{N}_{i}}^{\circ}\right)=\tilde{\pi}_{i}\left(\cdot\mid\mathbf{s}^{\circ}_{\mathcal{N}_{i}},\boldsymbol{\omega}_{\mathcal{N}_{i}}^{\circ}\right)</annotation></semantics></math>. For convenience, we fix an arbitrary <math id="Thmdefinition8.p1.m5" class="ltx_Math" alttext="\mathbf{s}_{\mathcal{N}_{i}}/\mathbf{s}^{\circ}_{\mathcal{N}_{i}},\boldsymbol{\omega}_{\mathcal{N}_{i}}/\boldsymbol{\omega}_{\mathcal{N}_{i}}^{\circ}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo>/</mo><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup></mrow><mo>,</mo><mrow><msub><mi>𝝎</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo>/</mo><msubsup><mi>𝝎</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}_{\mathcal{N}_{i}}/\mathbf{s}^{\circ}_{\mathcal{N}_{i}},\boldsymbol{\omega}_{\mathcal{N}_{i}}/\boldsymbol{\omega}_{\mathcal{N}_{i}}^{\circ}</annotation></semantics></math>, and denote by <math id="Thmdefinition8.p1.m6" class="ltx_math_unparsed" alttext="\tilde{\pi}_{i}\left(\cdot\mid\mathbf{s}^{\circ}_{\mathcal{N}_{i}},\boldsymbol{\omega}_{\mathcal{N}_{i}}^{\circ}\right):=\pi_{i}\left(\cdot\mid\mathbf{s}^{\circ}_{\mathcal{N}_{i}},\mathbf{s}_{\mathcal{N}_{i}}/\mathbf{s}^{\circ}_{\mathcal{N}_{i}},\boldsymbol{\omega}_{\mathcal{N}_{i}}^{\circ},\boldsymbol{\omega}_{\mathcal{N}_{i}}/\boldsymbol{\omega}_{\mathcal{N}_{i}}^{\circ}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi>i</mi></msub><mrow><mo>(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo>,</mo><msubsup><mi>𝝎</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo>)</mo></mrow><mo>:=</mo><msub><mi>π</mi><mi>i</mi></msub><mrow><mo>(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo>,</mo><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo>/</mo><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo>,</mo><msubsup><mi>𝝎</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo>,</mo><msub><mi>𝝎</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo>/</mo><msubsup><mi>𝝎</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{\pi}_{i}\left(\cdot\mid\mathbf{s}^{\circ}_{\mathcal{N}_{i}},\boldsymbol{\omega}_{\mathcal{N}_{i}}^{\circ}\right):=\pi_{i}\left(\cdot\mid\mathbf{s}^{\circ}_{\mathcal{N}_{i}},\mathbf{s}_{\mathcal{N}_{i}}/\mathbf{s}^{\circ}_{\mathcal{N}_{i}},\boldsymbol{\omega}_{\mathcal{N}_{i}}^{\circ},\boldsymbol{\omega}_{\mathcal{N}_{i}}/\boldsymbol{\omega}_{\mathcal{N}_{i}}^{\circ}\right)</annotation></semantics></math>.</p>
</div>
</div>
<div id="Thmproposition9" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmproposition9.2" class="ltx_text ltx_font_bold">Proposition 9</span></span><span id="Thmproposition9.3" class="ltx_text ltx_font_bold"> </span>(Compactness of cross-domain policy ACR)<span id="Thmproposition9.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmproposition9.p1" class="ltx_para">
<p id="Thmproposition9.p1.1" class="ltx_p">Let <math id="Thmproposition9.p1.m1" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> be an arbitrary localized policy and <math id="Thmproposition9.p1.m2" class="ltx_Math" alttext="\tilde{\pi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>π</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\pi}</annotation></semantics></math> be the corresponding approximately compact localized policy (Definition <a href="#Thmdefinition8" title="Definition 8 (Approximately compact 𝝎-conditioned policy). ‣ E.3.2 Policies ‣ E.3 Cross domain ‣ Appendix E Missing proofs in Section ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>), for each agent <math id="Thmproposition9.p1.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, and any <math id="Thmproposition9.p1.m4" class="ltx_Math" alttext="(\mathbf{s},\mathbf{a},\boldsymbol{\omega})\in\mathcal{S}\times\mathcal{A}\times\Omega" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo>,</mo><mi>𝝎</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi mathvariant="normal">Ω</mi></mrow></mrow><annotation encoding="application/x-tex">(\mathbf{s},\mathbf{a},\boldsymbol{\omega})\in\mathcal{S}\times\mathcal{A}\times\Omega</annotation></semantics></math>, we have</p>
<table id="A5.Ex60" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex60.m1" class="ltx_Math" alttext="Q_{i}^{\tilde{\pi}}(\mathbf{s},\mathbf{a},\boldsymbol{\omega})=Q_{i}^{\pi}(\mathbf{s},\mathbf{a},\boldsymbol{\omega})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>Q</mi><mi>i</mi><mover accent="true"><mi>π</mi><mo>~</mo></mover></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo>,</mo><mi>𝝎</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>Q</mi><mi>i</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo>,</mo><mi>𝝎</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Q_{i}^{\tilde{\pi}}(\mathbf{s},\mathbf{a},\boldsymbol{\omega})=Q_{i}^{\pi}(\mathbf{s},\mathbf{a},\boldsymbol{\omega}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS3.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS3.SSS2.p1" class="ltx_para">
<p id="A5.SS3.SSS2.p1.1" class="ltx_p"><span id="A5.SS3.SSS2.p1.1.1" class="ltx_text">The proof follows from that of Proposition <a href="#Thmproposition6" title="Proposition 6 (Compactness of policy ACR). ‣ E.2 Policy ACR ‣ Appendix E Missing proofs in Section ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> by augmenting the state space of each agent by <math id="A5.SS3.SSS2.p1.m1" class="ltx_Math" alttext="\mathcal{S}_{i}\times\Omega_{i}\ni(\mathbf{s}_{i},\boldsymbol{\omega}_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi mathvariant="normal">Ω</mi><mi>i</mi></msub></mrow><mo>∋</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝝎</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{S}_{i}\times\Omega_{i}\ni(\mathbf{s}_{i},\boldsymbol{\omega}_{i})</annotation></semantics></math>, where the augmented state variable <math id="A5.SS3.SSS2.p1.m2" class="ltx_Math" alttext="\boldsymbol{\omega}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝝎</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\boldsymbol{\omega}_{i}</annotation></semantics></math> degenerates to a deterministic state (<math id="A5.SS3.SSS2.p1.m3" class="ltx_Math" alttext="\boldsymbol{\omega}_{i}(t)=\boldsymbol{\omega}_{i},\forall t" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝝎</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>𝝎</mi><mi>i</mi></msub></mrow><mo>,</mo><mrow><mo rspace="0.167em">∀</mo><mi>t</mi></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\omega}_{i}(t)=\boldsymbol{\omega}_{i},\forall t</annotation></semantics></math>).
∎</span></p>
</div>
</div>
<div id="Thmcorollary2" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmcorollary2.2" class="ltx_text ltx_font_bold">Corollary 2</span></span><span id="Thmcorollary2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmcorollary2.p1" class="ltx_para">
<p id="Thmcorollary2.p1.1" class="ltx_p">Let <math id="Thmcorollary2.p1.m1" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> be an arbitrary localized policy and <math id="Thmcorollary2.p1.m2" class="ltx_Math" alttext="\tilde{\pi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>π</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\pi}</annotation></semantics></math> be the corresponding approximately compact localized policy output by Algorithm <a href="#alg2" title="Algorithm 2 ‣ D.2 Policy ACR ‣ Appendix D Algorithm design ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, for each agent <math id="Thmcorollary2.p1.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, and any <math id="Thmcorollary2.p1.m4" class="ltx_Math" alttext="(\mathbf{s},\mathbf{a},\boldsymbol{\omega})\in\mathcal{S}\times\mathcal{A}\times\Omega" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo>,</mo><mi>𝝎</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi mathvariant="normal">Ω</mi></mrow></mrow><annotation encoding="application/x-tex">(\mathbf{s},\mathbf{a},\boldsymbol{\omega})\in\mathcal{S}\times\mathcal{A}\times\Omega</annotation></semantics></math>, the approximation error between <math id="Thmcorollary2.p1.m5" class="ltx_Math" alttext="\tilde{Q}_{i}^{\tilde{\pi}}\left(\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\boldsymbol{\omega}_{\mathcal{N}^{\kappa}_{i}}^{\circ}\right)" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>Q</mi><mo>~</mo></mover><mi>i</mi><mover accent="true"><mi>π</mi><mo>~</mo></mover></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo>,</mo><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>,</mo><msubsup><mi>𝝎</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{Q}_{i}^{\tilde{\pi}}\left(\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\boldsymbol{\omega}_{\mathcal{N}^{\kappa}_{i}}^{\circ}\right)</annotation></semantics></math> and <math id="Thmcorollary2.p1.m6" class="ltx_Math" alttext="Q_{i}^{\pi}\left(\mathbf{s},\mathbf{a}\right)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Q</mi><mi>i</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">Q_{i}^{\pi}\left(\mathbf{s},\mathbf{a}\right)</annotation></semantics></math> can be bounded as</p>
<table id="A5.EGx16" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex61"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex61.m1" class="ltx_Math" alttext="\displaystyle\sup_{(\mathbf{s},\mathbf{a})\in\mathcal{S}\times\mathcal{A}}\left\lvert\tilde{Q}_{i}^{\tilde{\pi}}\left(\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\boldsymbol{\omega}_{\mathcal{N}^{\kappa}_{i}}^{\circ}\right)-Q_{i}^{\pi}\left(\mathbf{s},\mathbf{a},\boldsymbol{\omega}\right)\right\rvert\leq\frac{2\bar{r}}{1-\gamma}\gamma^{\kappa+1}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow></mrow></munder><mrow><mo lspace="0em">|</mo><mrow><mrow><msubsup><mover accent="true"><mi>Q</mi><mo>~</mo></mover><mi>i</mi><mover accent="true"><mi>π</mi><mo>~</mo></mover></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo>,</mo><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>,</mo><msubsup><mi>𝝎</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>Q</mi><mi>i</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo>,</mo><mi>𝝎</mi><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>r</mi><mo>¯</mo></mover></mrow><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{(\mathbf{s},\mathbf{a})\in\mathcal{S}\times\mathcal{A}}\left\lvert\tilde{Q}_{i}^{\tilde{\pi}}\left(\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\boldsymbol{\omega}_{\mathcal{N}^{\kappa}_{i}}^{\circ}\right)-Q_{i}^{\pi}\left(\mathbf{s},\mathbf{a},\boldsymbol{\omega}\right)\right\rvert\leq\frac{2\bar{r}}{1-\gamma}\gamma^{\kappa+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS3.SSS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS3.SSS2.p2" class="ltx_para">
<p id="A5.SS3.SSS2.p2.1" class="ltx_p"><span id="A5.SS3.SSS2.p2.1.1" class="ltx_text">The proof follows from that of Corollary <a href="#Thmcorollary1" title="Corollary 1. ‣ E.2 Policy ACR ‣ Appendix E Missing proofs in Section ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> by augmenting the state space of each agent by <math id="A5.SS3.SSS2.p2.m1" class="ltx_Math" alttext="\mathcal{S}_{i}\times\Omega_{i}\ni(\mathbf{s}_{i},\boldsymbol{\omega}_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi mathvariant="normal">Ω</mi><mi>i</mi></msub></mrow><mo>∋</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝝎</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{S}_{i}\times\Omega_{i}\ni(\mathbf{s}_{i},\boldsymbol{\omega}_{i})</annotation></semantics></math>, where the augmented state variable <math id="A5.SS3.SSS2.p2.m2" class="ltx_Math" alttext="\boldsymbol{\omega}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝝎</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\boldsymbol{\omega}_{i}</annotation></semantics></math> degenerates to a deterministic state (<math id="A5.SS3.SSS2.p2.m3" class="ltx_Math" alttext="\boldsymbol{\omega}_{i}(t)=\boldsymbol{\omega}_{i},\forall t" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝝎</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>𝝎</mi><mi>i</mi></msub></mrow><mo>,</mo><mrow><mo rspace="0.167em">∀</mo><mi>t</mi></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\omega}_{i}(t)=\boldsymbol{\omega}_{i},\forall t</annotation></semantics></math>).
∎</span></p>
</div>
</div>
<div id="Thmproposition10" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmproposition10.2" class="ltx_text ltx_font_bold">Proposition 10</span></span><span id="Thmproposition10.3" class="ltx_text ltx_font_bold"> </span>(Approximation error)<span id="Thmproposition10.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmproposition10.p1" class="ltx_para">
<p id="Thmproposition10.p1.1" class="ltx_p">Let <math id="Thmproposition10.p1.m1" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> be an arbitrary localized policy and <math id="Thmproposition10.p1.m2" class="ltx_Math" alttext="\tilde{\pi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>π</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\pi}</annotation></semantics></math> be the corresponding approximately compact localized policy output by Algorithm <a href="#alg3" title="Algorithm 3 ‣ D.2 Policy ACR ‣ Appendix D Algorithm design ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, for each agent <math id="Thmproposition10.p1.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, and any <math id="Thmproposition10.p1.m4" class="ltx_Math" alttext="(\mathbf{s},\mathbf{a},\boldsymbol{\omega})\in\mathcal{S}\times\mathcal{A}\times\Omega" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo>,</mo><mi>𝝎</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi mathvariant="normal">Ω</mi></mrow></mrow><annotation encoding="application/x-tex">(\mathbf{s},\mathbf{a},\boldsymbol{\omega})\in\mathcal{S}\times\mathcal{A}\times\Omega</annotation></semantics></math>, we have</p>
<table id="A5.EGx17" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex62"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex62.m1" class="ltx_Math" alttext="\displaystyle\sup_{(\mathbf{s},\mathbf{a})\in\mathcal{S}\times\mathcal{A}}\left\lvert Q_{i}^{\tilde{\pi}}\left(\mathbf{s},\mathbf{a},\boldsymbol{\omega}\right)-Q_{i}^{\pi}\left(\mathbf{s},\mathbf{a},\boldsymbol{\omega}\right)\right\rvert\leq\frac{\bar{r}}{1-\gamma}\gamma^{\kappa+1}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow></mrow></munder><mrow><mo lspace="0em">|</mo><mrow><mrow><msubsup><mi>Q</mi><mi>i</mi><mover accent="true"><mi>π</mi><mo>~</mo></mover></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo>,</mo><mi>𝝎</mi><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>Q</mi><mi>i</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo>,</mo><mi>𝝎</mi><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mover accent="true"><mi>r</mi><mo>¯</mo></mover><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{(\mathbf{s},\mathbf{a})\in\mathcal{S}\times\mathcal{A}}\left\lvert Q_{i}^{\tilde{\pi}}\left(\mathbf{s},\mathbf{a},\boldsymbol{\omega}\right)-Q_{i}^{\pi}\left(\mathbf{s},\mathbf{a},\boldsymbol{\omega}\right)\right\rvert\leq\frac{\bar{r}}{1-\gamma}\gamma^{\kappa+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="Thmcorollary3" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmcorollary3.2" class="ltx_text ltx_font_bold">Corollary 3</span></span><span id="Thmcorollary3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmcorollary3.p1" class="ltx_para">
<p id="Thmcorollary3.p1.1" class="ltx_p">Let <math id="Thmcorollary3.p1.m1" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> be an arbitrary localized policy and <math id="Thmcorollary3.p1.m2" class="ltx_Math" alttext="\tilde{\pi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>π</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\pi}</annotation></semantics></math> be the corresponding approximately compact localized policy output by Algorithm <a href="#alg3" title="Algorithm 3 ‣ D.2 Policy ACR ‣ Appendix D Algorithm design ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, for each agent <math id="Thmcorollary3.p1.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, and any <math id="Thmcorollary3.p1.m4" class="ltx_Math" alttext="(\mathbf{s},\mathbf{a},\boldsymbol{\omega})\in\mathcal{S}\times\mathcal{A}\times\Omega" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo>,</mo><mi>𝝎</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi mathvariant="normal">Ω</mi></mrow></mrow><annotation encoding="application/x-tex">(\mathbf{s},\mathbf{a},\boldsymbol{\omega})\in\mathcal{S}\times\mathcal{A}\times\Omega</annotation></semantics></math>, the approximation error between <math id="Thmcorollary3.p1.m5" class="ltx_Math" alttext="\tilde{Q}_{i}^{\tilde{\pi}}\left(\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\boldsymbol{\omega}_{\mathcal{N}^{\kappa}_{i}}^{\circ}\right)" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>Q</mi><mo>~</mo></mover><mi>i</mi><mover accent="true"><mi>π</mi><mo>~</mo></mover></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo>,</mo><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>,</mo><msubsup><mi>𝝎</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{Q}_{i}^{\tilde{\pi}}\left(\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\boldsymbol{\omega}_{\mathcal{N}^{\kappa}_{i}}^{\circ}\right)</annotation></semantics></math> and <math id="Thmcorollary3.p1.m6" class="ltx_Math" alttext="Q_{i}^{\pi}\left(\mathbf{s},\mathbf{a}\right)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Q</mi><mi>i</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">Q_{i}^{\pi}\left(\mathbf{s},\mathbf{a}\right)</annotation></semantics></math> can be bounded as</p>
<table id="A5.EGx18" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex63.m1" class="ltx_Math" alttext="\displaystyle\sup_{(\mathbf{s},\mathbf{a})\in\mathcal{S}\times\mathcal{A}}\left\lvert\tilde{Q}_{i}^{\tilde{\pi}}\left(\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\boldsymbol{\omega}_{\mathcal{N}^{\kappa}_{i}}^{\circ}\right)-Q_{i}^{\pi}\left(\mathbf{s},\mathbf{a},\boldsymbol{\omega}\right)\right\rvert\leq\frac{3\bar{r}}{1-\gamma}\gamma^{\kappa+1}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow></mrow></munder><mrow><mo lspace="0em">|</mo><mrow><mrow><msubsup><mover accent="true"><mi>Q</mi><mo>~</mo></mover><mi>i</mi><mover accent="true"><mi>π</mi><mo>~</mo></mover></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo>,</mo><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>,</mo><msubsup><mi>𝝎</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>Q</mi><mi>i</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo>,</mo><mi>𝝎</mi><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>r</mi><mo>¯</mo></mover></mrow><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{(\mathbf{s},\mathbf{a})\in\mathcal{S}\times\mathcal{A}}\left\lvert\tilde{Q}_{i}^{\tilde{\pi}}\left(\mathbf{s}^{\circ}_{\mathcal{N}^{\kappa}_{i}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\boldsymbol{\omega}_{\mathcal{N}^{\kappa}_{i}}^{\circ}\right)-Q_{i}^{\pi}\left(\mathbf{s},\mathbf{a},\boldsymbol{\omega}\right)\right\rvert\leq\frac{3\bar{r}}{1-\gamma}\gamma^{\kappa+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS3.SSS2.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS3.SSS2.p3" class="ltx_para">
<p id="A5.SS3.SSS2.p3.1" class="ltx_p"><span id="A5.SS3.SSS2.p3.1.1" class="ltx_text">The proof follows from that of Corollary <a href="#Thmproposition2" title="Proposition 2 (Approximation error). ‣ 3.1 ACR for fixed environment ‣ 3 Approximately compact representation ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> by augmenting the state space of each agent by <math id="A5.SS3.SSS2.p3.m1" class="ltx_Math" alttext="\mathcal{S}_{i}\times\Omega_{i}\ni(\mathbf{s}_{i},\boldsymbol{\omega}_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi mathvariant="normal">Ω</mi><mi>i</mi></msub></mrow><mo>∋</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝝎</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{S}_{i}\times\Omega_{i}\ni(\mathbf{s}_{i},\boldsymbol{\omega}_{i})</annotation></semantics></math>, where the augmented state variable <math id="A5.SS3.SSS2.p3.m2" class="ltx_Math" alttext="\boldsymbol{\omega}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝝎</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\boldsymbol{\omega}_{i}</annotation></semantics></math> degenerates to a deterministic state (<math id="A5.SS3.SSS2.p3.m3" class="ltx_Math" alttext="\boldsymbol{\omega}_{i}(t)=\boldsymbol{\omega}_{i},\forall t" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝝎</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>𝝎</mi><mi>i</mi></msub></mrow><mo>,</mo><mrow><mo rspace="0.167em">∀</mo><mi>t</mi></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\omega}_{i}(t)=\boldsymbol{\omega}_{i},\forall t</annotation></semantics></math>).
∎</span></p>
</div>
</div>
</section>
</section>
</section>
<section id="A6" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix F </span>Missing proofs in Section <a href="#S5" title="5 Causal recovery and domain factor estimation ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a></h2>

<section id="A6.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">F.1 </span>Discussion on assumptions in Proposition <a href="#Thmproposition5" title="Proposition 5 (Informal). ‣ 5 Causal recovery and domain factor estimation ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a></h3>

<div id="A6.SS1.p1" class="ltx_para">
<p id="A6.SS1.p1.1" class="ltx_p">Our assumptions in Proposition <a href="#Thmproposition5" title="Proposition 5 (Informal). ‣ 5 Causal recovery and domain factor estimation ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> are standard in causal discovery and theoretical MARL.</p>
</div>
<div id="A6.SS1.p2" class="ltx_para">
<ul id="A6.I1" class="ltx_itemize ltx_leftmargin_flush">
<li id="A6.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I1.i1.p1" class="ltx_para">
<p id="A6.I1.i1.p1.1" class="ltx_p">Faithfulness and sub-Gaussian noise: these are classical and standard requirements to ensure identifiability <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib17" title="" class="ltx_ref">17</a>, <a href="#bib.bib9" title="" class="ltx_ref">9</a>]</cite> and finite-sample recovery.</p>
</div></li>
<li id="A6.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I1.i2.p1" class="ltx_para">
<p id="A6.I1.i2.p1.1" class="ltx_p">Bounded degree: bounded neighborhood degree is natural in networked systems where agents have limited communication range. For example, this holds when each intersection connects to only a few roads, or each wireless node has limited interference range.</p>
</div></li>
<li id="A6.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I1.i3.p1" class="ltx_para">
<p id="A6.I1.i3.p1.1" class="ltx_p">Full observability: while we currently assume full local observability, the ACR construction can be extended to partially observable settings using learned belief states or latent encoders. This is part of our future work.</p>
</div></li>
<li id="A6.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I1.i4.p1" class="ltx_para">
<p id="A6.I1.i4.p1.1" class="ltx_p">Lipschitz continuity: this mild smoothness assumption is satisfied by most smooth policies.</p>
</div></li>
</ul>
</div>
<div id="A6.SS1.p3" class="ltx_para">
<p id="A6.SS1.p3.1" class="ltx_p">Importantly, our algorithm can still be applied when assumptions are violated, only the theoretical guarantees may not hold exactly.</p>
</div>
</section>
<section id="A6.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">F.2 </span>Proof of Theorem <a href="#Thmtheorem1" title="Theorem 1 (Structural identifiability in networked MARL). ‣ 5 Causal recovery and domain factor estimation ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a></h3>

<div id="A6.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A6.SS2.p1" class="ltx_para">
<p id="A6.SS2.p1.1" class="ltx_p"><span id="A6.SS2.p1.1.1" class="ltx_text">We will prove this theorem by analyzing the causal structure from the perspective of each individual agent while accounting for inter-agent influences through the network structure.</span></p>
</div>
<div id="A6.SS2.p2" class="ltx_para">
<p id="A6.SS2.p2.1" class="ltx_p"><span id="A6.SS2.p2.1.1" class="ltx_text">For each agent <math id="A6.SS2.p2.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, we define the variable set <math id="A6.SS2.p2.m2" class="ltx_Math" alttext="\mathcal{V}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{V}_{i}</annotation></semantics></math> that includes:</span></p>
<ul id="A6.I2" class="ltx_itemize">
<li id="A6.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I2.i1.p1" class="ltx_para">
<p id="A6.I2.i1.p1.1" class="ltx_p">States of agent <math id="A6.I2.i1.p1.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> at time <math id="A6.I2.i1.p1.m2" class="ltx_Math" alttext="t-1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t-1</annotation></semantics></math>: <math id="A6.I2.i1.p1.m3" class="ltx_Math" alttext="\mathbf{s}_{i}(t-1)=(s_{i,1}(t-1),\ldots,s_{i,d_{i}}(t-1))" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐬</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><msub><mi>d</mi><mi>i</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}_{i}(t-1)=(s_{i,1}(t-1),\ldots,s_{i,d_{i}}(t-1))</annotation></semantics></math></p>
</div></li>
<li id="A6.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I2.i2.p1" class="ltx_para">
<p id="A6.I2.i2.p1.1" class="ltx_p">States of neighboring agents at time <math id="A6.I2.i2.p1.m1" class="ltx_Math" alttext="t-1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t-1</annotation></semantics></math>: <math id="A6.I2.i2.p1.m2" class="ltx_Math" alttext="\mathbf{s}_{\mathcal{N}_{i}\setminus i}(t-1)=\{\mathbf{s}_{j}(t-1):j\in\mathcal{N}_{i}\setminus\{i\}\}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐬</mi><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∖</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>𝐬</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mi>j</mi><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∖</mo><mrow><mo stretchy="false">{</mo><mi>i</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}_{\mathcal{N}_{i}\setminus i}(t-1)=\{\mathbf{s}_{j}(t-1):j\in\mathcal{N}_{i}\setminus\{i\}\}</annotation></semantics></math></p>
</div></li>
<li id="A6.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I2.i3.p1" class="ltx_para">
<p id="A6.I2.i3.p1.1" class="ltx_p">States of agent <math id="A6.I2.i3.p1.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> at time <math id="A6.I2.i3.p1.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>: <math id="A6.I2.i3.p1.m3" class="ltx_Math" alttext="\mathbf{s}_{i}(t)=(s_{i,1}(t),\ldots,s_{i,d_{i}}(t))" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐬</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><msub><mi>d</mi><mi>i</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}_{i}(t)=(s_{i,1}(t),\ldots,s_{i,d_{i}}(t))</annotation></semantics></math></p>
</div></li>
<li id="A6.I2.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I2.i4.p1" class="ltx_para">
<p id="A6.I2.i4.p1.1" class="ltx_p">Actions of agent <math id="A6.I2.i4.p1.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> at time <math id="A6.I2.i4.p1.m2" class="ltx_Math" alttext="t-1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t-1</annotation></semantics></math>: <math id="A6.I2.i4.p1.m3" class="ltx_Math" alttext="\mathbf{a}_{i}(t-1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{a}_{i}(t-1)</annotation></semantics></math></p>
</div></li>
</ul>
</div>
<div id="A6.SS2.p3" class="ltx_para">
<p id="A6.SS2.p3.1" class="ltx_p"><span id="A6.SS2.p3.1.1" class="ltx_text">We denote by <math id="A6.SS2.p3.m1" class="ltx_Math" alttext="m\in\{1,\ldots,M\}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>M</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">m\in\{1,\ldots,M\}</annotation></semantics></math> the domain index, which serves as a surrogate variable for the unobserved change factors <math id="A6.SS2.p3.m2" class="ltx_Math" alttext="\boldsymbol{\omega}^{m}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi>𝝎</mi><mi>i</mi><mi>m</mi></msubsup><annotation encoding="application/x-tex">\boldsymbol{\omega}^{m}_{i}</annotation></semantics></math>. Let <math id="A6.SS2.p3.m3" class="ltx_Math" alttext="\mathcal{G}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{i}</annotation></semantics></math> be the causal graph over variables in <math id="A6.SS2.p3.m4" class="ltx_Math" alttext="\mathcal{V}_{i}\cup\{k\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>i</mi></msub><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>k</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{V}_{i}\cup\{k\}</annotation></semantics></math>. Our goal is to identify the binary structural matrices <math id="A6.SS2.p3.m5" class="ltx_Math" alttext="\mathbf{c}_{i}^{s\rightarrow s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐜</mi><mi>i</mi><mrow><mi>s</mi><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathbf{c}_{i}^{s\rightarrow s}</annotation></semantics></math>, <math id="A6.SS2.p3.m6" class="ltx_Math" alttext="\mathbf{c}_{i}^{a\rightarrow s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐜</mi><mi>i</mi><mrow><mi>a</mi><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathbf{c}_{i}^{a\rightarrow s}</annotation></semantics></math>, and <math id="A6.SS2.p3.m7" class="ltx_Math" alttext="\mathbf{c}_{i}^{\boldsymbol{\omega}^{m}\rightarrow s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐜</mi><mi>i</mi><mrow><msup><mi>𝝎</mi><mi>m</mi></msup><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathbf{c}_{i}^{\boldsymbol{\omega}^{m}\rightarrow s}</annotation></semantics></math> which encode the edges in <math id="A6.SS2.p3.m8" class="ltx_Math" alttext="\mathcal{G}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{i}</annotation></semantics></math>.
Under the Markov condition and faithfulness assumption, we can apply the following fundamental result from causal discovery:</span></p>
</div>
<div id="Thmlemma8" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma8.2" class="ltx_text ltx_font_bold">Lemma 8</span></span><span id="Thmlemma8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma8.p1" class="ltx_para">
<p id="Thmlemma8.p1.1" class="ltx_p">For any two variables <math id="Thmlemma8.p1.m1" class="ltx_Math" alttext="V_{r},V_{s}\in\mathcal{V}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>r</mi></msub><mo>,</mo><mrow><msub><mi>V</mi><mi>s</mi></msub><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">V_{r},V_{s}\in\mathcal{V}_{i}</annotation></semantics></math>, they are not adjacent in <math id="Thmlemma8.p1.m2" class="ltx_Math" alttext="\mathcal{G}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{i}</annotation></semantics></math> if and only if they are independent conditional on some subset of <math id="Thmlemma8.p1.m3" class="ltx_math_unparsed" alttext="\{V_{t}:t\neq r,t\neq s\}\cup\{m\}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi><mo>≠</mo><mi>r</mi><mo>,</mo><mi>t</mi><mo>≠</mo><mi>s</mi><mo stretchy="false">}</mo></mrow><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>m</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\{V_{t}:t\neq r,t\neq s\}\cup\{m\}</annotation></semantics></math>.</p>
</div>
</div>
<div id="A6.SS2.p4" class="ltx_para">
<p id="A6.SS2.p4.1" class="ltx_p"><span id="A6.SS2.p4.1.1" class="ltx_text">This lemma follows from the properties of d-separation in causal Bayesian networks, as established in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib10" title="" class="ltx_ref">10</a>]</cite> and <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib17" title="" class="ltx_ref">17</a>]</cite>. For each agent <math id="A6.SS2.p4.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, we can therefore identify the skeleton of <math id="A6.SS2.p4.m2" class="ltx_Math" alttext="\mathcal{G}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{i}</annotation></semantics></math> by testing conditional independence relationships among the variables in <math id="A6.SS2.p4.m3" class="ltx_Math" alttext="\mathcal{V}_{i}\cup\{m\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>i</mi></msub><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>m</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{V}_{i}\cup\{m\}</annotation></semantics></math>.
The networked MARL system forms a Dynamic Bayesian Network (DBN), where the temporal structure imposes constraints on the edge directions:</span></p>
<ol id="A6.I3" class="ltx_enumerate">
<li id="A6.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A6.I3.i1.p1" class="ltx_para">
<p id="A6.I3.i1.p1.1" class="ltx_p">Edges can only go from variables at time <math id="A6.I3.i1.p1.m1" class="ltx_Math" alttext="t-1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t-1</annotation></semantics></math> to variables at time <math id="A6.I3.i1.p1.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>.</p>
</div></li>
<li id="A6.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A6.I3.i2.p1" class="ltx_para">
<p id="A6.I3.i2.p1.1" class="ltx_p">There are no instantaneous causal effects between variables at the same time point.</p>
</div></li>
</ol>
<p id="A6.SS2.p4.2" class="ltx_p"><span id="A6.SS2.p4.2.1" class="ltx_text">Therefore, for any edge identified in the skeleton of <math id="A6.SS2.p4.m4" class="ltx_Math" alttext="\mathcal{G}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{i}</annotation></semantics></math> between a variable at time <math id="A6.SS2.p4.m5" class="ltx_Math" alttext="t-1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t-1</annotation></semantics></math> and a variable at time <math id="A6.SS2.p4.m6" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, the direction is determined by the temporal order. Specifically, for each state component <math id="A6.SS2.p4.m7" class="ltx_Math" alttext="s_{i,j}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{i,j}(t)</annotation></semantics></math> of agent <math id="A6.SS2.p4.m8" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, any edge from a state component <math id="A6.SS2.p4.m9" class="ltx_Math" alttext="s_{l,m}(t-1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>l</mi><mo>,</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{l,m}(t-1)</annotation></semantics></math> (where <math id="A6.SS2.p4.m10" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> could be <math id="A6.SS2.p4.m11" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> or any neighbor of <math id="A6.SS2.p4.m12" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>) to <math id="A6.SS2.p4.m13" class="ltx_Math" alttext="s_{i,j}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{i,j}(t)</annotation></semantics></math> must be directed from <math id="A6.SS2.p4.m14" class="ltx_Math" alttext="s_{l,m}(t-1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>l</mi><mo>,</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{l,m}(t-1)</annotation></semantics></math> to <math id="A6.SS2.p4.m15" class="ltx_Math" alttext="s_{i,j}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{i,j}(t)</annotation></semantics></math>. Similarly, any edge from the action <math id="A6.SS2.p4.m16" class="ltx_Math" alttext="\mathbf{a}_{i}(t-1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{a}_{i}(t-1)</annotation></semantics></math> to <math id="A6.SS2.p4.m17" class="ltx_Math" alttext="s_{i,j}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{i,j}(t)</annotation></semantics></math> must be directed from <math id="A6.SS2.p4.m18" class="ltx_Math" alttext="\mathbf{a}_{i}(t-1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{a}_{i}(t-1)</annotation></semantics></math> to <math id="A6.SS2.p4.m19" class="ltx_Math" alttext="s_{i,j}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{i,j}(t)</annotation></semantics></math>.</span></p>
</div>
<div id="A6.SS2.p5" class="ltx_para">
<p id="A6.SS2.p5.1" class="ltx_p"><span id="A6.SS2.p5.1.1" class="ltx_text">Given the directed edges in <math id="A6.SS2.p5.m1" class="ltx_Math" alttext="\mathcal{G}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{i}</annotation></semantics></math>, we can now identify the structural matrices:</span></p>
<ol id="A6.I4" class="ltx_enumerate">
<li id="A6.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A6.I4.i1.p1" class="ltx_para">
<p id="A6.I4.i1.p1.1" class="ltx_p"><span id="A6.I4.i1.p1.1.1" class="ltx_text ltx_font_bold">Identification of <math id="A6.I4.i1.p1.m1" class="ltx_Math" alttext="\mathbf{c}_{i}^{s\rightarrow s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐜</mi><mi>i</mi><mrow><mi>s</mi><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathbf{c}_{i}^{s\rightarrow s}</annotation></semantics></math></span>: For each state component <math id="A6.I4.i1.p1.m2" class="ltx_Math" alttext="s_{i,j}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{i,j}(t)</annotation></semantics></math> of agent <math id="A6.I4.i1.p1.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, the <math id="A6.I4.i1.p1.m4" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>-th row of <math id="A6.I4.i1.p1.m5" class="ltx_Math" alttext="\mathbf{c}_{i}^{s\rightarrow s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐜</mi><mi>i</mi><mrow><mi>s</mi><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathbf{c}_{i}^{s\rightarrow s}</annotation></semantics></math>, denoted by <math id="A6.I4.i1.p1.m6" class="ltx_Math" alttext="\mathbf{c}_{i,j}^{s\rightarrow s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐜</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mi>s</mi><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathbf{c}_{i,j}^{s\rightarrow s}</annotation></semantics></math>, is a binary vector where entry <math id="A6.I4.i1.p1.m7" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> is 1 if and only if there is a directed edge from <math id="A6.I4.i1.p1.m8" class="ltx_Math" alttext="s_{\mathcal{N}_{i},m}(t-1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>,</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{\mathcal{N}_{i},m}(t-1)</annotation></semantics></math> to <math id="A6.I4.i1.p1.m9" class="ltx_Math" alttext="s_{i,j}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{i,j}(t)</annotation></semantics></math> in <math id="A6.I4.i1.p1.m10" class="ltx_Math" alttext="\mathcal{G}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{i}</annotation></semantics></math>.</p>
</div></li>
<li id="A6.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A6.I4.i2.p1" class="ltx_para">
<p id="A6.I4.i2.p1.1" class="ltx_p"><span id="A6.I4.i2.p1.1.1" class="ltx_text ltx_font_bold">Identification of <math id="A6.I4.i2.p1.m1" class="ltx_Math" alttext="\mathbf{c}_{i}^{a\rightarrow s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐜</mi><mi>i</mi><mrow><mi>a</mi><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathbf{c}_{i}^{a\rightarrow s}</annotation></semantics></math></span>: For each state component <math id="A6.I4.i2.p1.m2" class="ltx_Math" alttext="s_{i,j}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{i,j}(t)</annotation></semantics></math> of agent <math id="A6.I4.i2.p1.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, the entry <math id="A6.I4.i2.p1.m4" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> of <math id="A6.I4.i2.p1.m5" class="ltx_Math" alttext="\mathbf{c}_{i}^{a\rightarrow s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐜</mi><mi>i</mi><mrow><mi>a</mi><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathbf{c}_{i}^{a\rightarrow s}</annotation></semantics></math> is 1 if and only if there is a directed edge from <math id="A6.I4.i2.p1.m6" class="ltx_Math" alttext="\mathbf{a}_{i}(t-1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{a}_{i}(t-1)</annotation></semantics></math> to <math id="A6.I4.i2.p1.m7" class="ltx_Math" alttext="s_{i,j}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{i,j}(t)</annotation></semantics></math> in <math id="A6.I4.i2.p1.m8" class="ltx_Math" alttext="\mathcal{G}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{i}</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="A6.SS2.p5.2" class="ltx_p"><span id="A6.SS2.p5.2.1" class="ltx_text">To identify <math id="A6.SS2.p5.m2" class="ltx_Math" alttext="\mathbf{c}_{i}^{\boldsymbol{\omega}^{m}\rightarrow s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐜</mi><mi>i</mi><mrow><msup><mi>𝝎</mi><mi>m</mi></msup><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathbf{c}_{i}^{\boldsymbol{\omega}^{m}\rightarrow s}</annotation></semantics></math>, we need to determine which state components have distribution changes across domains.</span></p>
</div>
<div id="Thmlemma9" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma9.2" class="ltx_text ltx_font_bold">Lemma 9</span></span><span id="Thmlemma9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma9.p1" class="ltx_para">
<p id="Thmlemma9.p1.1" class="ltx_p">For a variable <math id="Thmlemma9.p1.m1" class="ltx_Math" alttext="V_{r}\in\mathcal{V}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>r</mi></msub><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">V_{r}\in\mathcal{V}_{i}</annotation></semantics></math>, its distribution module changes across domains if and only if <math id="Thmlemma9.p1.m2" class="ltx_Math" alttext="V_{r}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>r</mi></msub><annotation encoding="application/x-tex">V_{r}</annotation></semantics></math> and <math id="Thmlemma9.p1.m3" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> are not independent given any subset of other variables in <math id="Thmlemma9.p1.m4" class="ltx_Math" alttext="\mathcal{V}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{V}_{i}</annotation></semantics></math>.</p>
</div>
</div>
<div id="A6.SS2.p6" class="ltx_para">
<p id="A6.SS2.p6.1" class="ltx_p"><span id="A6.SS2.p6.1.1" class="ltx_text">This follows from the definition of the domain-specific changes: if a variable’s distribution remains invariant across domains, then it is independent of the domain index <math id="A6.SS2.p6.m1" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> conditional on its parents. For each state component <math id="A6.SS2.p6.m2" class="ltx_Math" alttext="s_{i,j}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{i,j}(t)</annotation></semantics></math>, we test whether <math id="A6.SS2.p6.m3" class="ltx_Math" alttext="s_{i,j}(t)\perp\!\!\!\perp m|\mathcal{Z}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mpadded style="width:0.518em;" width="0.518em"><mo>⟂</mo></mpadded><mphantom></mphantom><mo>⟂</mo><mi>m</mi></mrow><mo fence="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></mrow><annotation encoding="application/x-tex">s_{i,j}(t)\perp\!\!\!\perp m|\mathcal{Z}</annotation></semantics></math> for any subset <math id="A6.SS2.p6.m4" class="ltx_Math" alttext="\mathcal{Z}\subseteq\mathcal{V}_{i}\setminus\{s_{i,j}(t)\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒵</mi><mo>⊆</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>i</mi></msub><mo>∖</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{Z}\subseteq\mathcal{V}_{i}\setminus\{s_{i,j}(t)\}</annotation></semantics></math>. If no such conditional independence holds, then the distribution of <math id="A6.SS2.p6.m5" class="ltx_Math" alttext="s_{i,j}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{i,j}(t)</annotation></semantics></math> varies across domains, and therefore <math id="A6.SS2.p6.m6" class="ltx_Math" alttext="\mathbf{c}_{i,j}^{\boldsymbol{\omega}^{m}\rightarrow s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐜</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><msup><mi>𝝎</mi><mi>m</mi></msup><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathbf{c}_{i,j}^{\boldsymbol{\omega}^{m}\rightarrow s}</annotation></semantics></math> has at least one non-zero entry.</span></p>
</div>
<div id="A6.SS2.p7" class="ltx_para">
<p id="A6.SS2.p7.1" class="ltx_p"><span id="A6.SS2.p7.1.1" class="ltx_text">To identify the specific entries of <math id="A6.SS2.p7.m1" class="ltx_Math" alttext="\mathbf{c}_{i}^{\boldsymbol{\omega}^{m}\rightarrow s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐜</mi><mi>i</mi><mrow><msup><mi>𝝎</mi><mi>m</mi></msup><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathbf{c}_{i}^{\boldsymbol{\omega}^{m}\rightarrow s}</annotation></semantics></math>, we exploit the fact that changes in distributions are localized according to the causal structure.</span></p>
</div>
<div id="A6.SS2.p8" class="ltx_para">
<p id="A6.SS2.p8.1" class="ltx_p"><span id="A6.SS2.p8.1.1" class="ltx_text">To complete the proof, we need to show that the structural matrices are uniquely identified from the observed data:</span></p>
<ol id="A6.I5" class="ltx_enumerate">
<li id="A6.I5.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A6.I5.i1.p1" class="ltx_para">
<p id="A6.I5.i1.p1.1" class="ltx_p"><span id="A6.I5.i1.p1.1.1" class="ltx_text ltx_font_bold">Uniqueness of <math id="A6.I5.i1.p1.m1" class="ltx_Math" alttext="\mathbf{c}_{i}^{s\rightarrow s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐜</mi><mi>i</mi><mrow><mi>s</mi><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathbf{c}_{i}^{s\rightarrow s}</annotation></semantics></math> and <math id="A6.I5.i1.p1.m2" class="ltx_Math" alttext="\mathbf{c}_{i}^{a\rightarrow s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐜</mi><mi>i</mi><mrow><mi>a</mi><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathbf{c}_{i}^{a\rightarrow s}</annotation></semantics></math></span>: These matrices encode the causal connections in the DBN structure. Under the Markov and faithfulness assumptions, the skeleton of the DBN is uniquely identified. Combined with the temporal constraints on edge directions, the matrices <math id="A6.I5.i1.p1.m3" class="ltx_Math" alttext="\mathbf{c}_{i}^{s\rightarrow s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐜</mi><mi>i</mi><mrow><mi>s</mi><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathbf{c}_{i}^{s\rightarrow s}</annotation></semantics></math> and <math id="A6.I5.i1.p1.m4" class="ltx_Math" alttext="\mathbf{c}_{i}^{a\rightarrow s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐜</mi><mi>i</mi><mrow><mi>a</mi><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathbf{c}_{i}^{a\rightarrow s}</annotation></semantics></math> are uniquely determined.</p>
</div></li>
<li id="A6.I5.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A6.I5.i2.p1" class="ltx_para">
<p id="A6.I5.i2.p1.1" class="ltx_p"><span id="A6.I5.i2.p1.1.1" class="ltx_text ltx_font_bold">Uniqueness of <math id="A6.I5.i2.p1.m1" class="ltx_Math" alttext="\mathbf{c}_{i}^{\boldsymbol{\omega}^{m}\rightarrow s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐜</mi><mi>i</mi><mrow><msup><mi>ω</mi><mi>m</mi></msup><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathbf{c}_{i}^{\boldsymbol{\omega}^{m}\rightarrow s}</annotation></semantics></math></span>: This matrix encodes which state components have distribution changes across domains. Under the faithfulness assumption, a state component’s distribution changes across domains if and only if it is not conditionally independent of the domain index <math id="A6.I5.i2.p1.m2" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> given any subset of other variables. This provides a unique characterization of the non-zero entries in <math id="A6.I5.i2.p1.m3" class="ltx_Math" alttext="\mathbf{c}_{i}^{\boldsymbol{\omega}^{m}\rightarrow s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐜</mi><mi>i</mi><mrow><msup><mi>𝝎</mi><mi>m</mi></msup><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathbf{c}_{i}^{\boldsymbol{\omega}^{m}\rightarrow s}</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="A6.SS2.p8.2" class="ltx_p"><span id="A6.SS2.p8.2.1" class="ltx_text">A critical aspect of our proof is that we treat each agent’s local model separately while accounting for the influence of neighboring agents through their observed states. This is justified by the factorization of the joint transition model:</span></p>
<table id="A6.Ex64" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex64.m1" class="ltx_Math" alttext="P(\mathbf{s}(t+1)|\mathbf{s}(t),\mathbf{a}(t))=\prod_{i=1}^{n}P_{i}(\mathbf{s}_{i}(t+1)|\mathbf{s}_{\mathcal{N}_{i}}(t),\mathbf{a}_{i}(t))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐚</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msub><mi>P</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐬</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><mrow><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P(\mathbf{s}(t+1)|\mathbf{s}(t),\mathbf{a}(t))=\prod_{i=1}^{n}P_{i}(\mathbf{s}_{i}(t+1)|\mathbf{s}_{\mathcal{N}_{i}}(t),\mathbf{a}_{i}(t)).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.p8.3" class="ltx_p"><span id="A6.SS2.p8.3.1" class="ltx_text">This factorization ensures that, for each agent <math id="A6.SS2.p8.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, we only need to consider the states of its neighbors <math id="A6.SS2.p8.m2" class="ltx_Math" alttext="\mathcal{N}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{N}_{i}</annotation></semantics></math> to fully capture the relevant causal influences.</span></p>
</div>
<div id="A6.SS2.p9" class="ltx_para">
<p id="A6.SS2.p9.1" class="ltx_p"><span id="A6.SS2.p9.1.1" class="ltx_text">Therefore, under the Markov condition and faithfulness assumption, the structural matrices <math id="A6.SS2.p9.m1" class="ltx_Math" alttext="\mathbf{c}_{i}^{s\rightarrow s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐜</mi><mi>i</mi><mrow><mi>s</mi><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathbf{c}_{i}^{s\rightarrow s}</annotation></semantics></math>, <math id="A6.SS2.p9.m2" class="ltx_Math" alttext="\mathbf{c}_{i}^{a\rightarrow s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐜</mi><mi>i</mi><mrow><mi>a</mi><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathbf{c}_{i}^{a\rightarrow s}</annotation></semantics></math>, and <math id="A6.SS2.p9.m3" class="ltx_Math" alttext="\mathbf{c}_{i}^{\boldsymbol{\omega}^{m}\rightarrow s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐜</mi><mi>i</mi><mrow><msup><mi>𝝎</mi><mi>m</mi></msup><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathbf{c}_{i}^{\boldsymbol{\omega}^{m}\rightarrow s}</annotation></semantics></math> are identifiable for each agent <math id="A6.SS2.p9.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> in the networked MARL system.
∎</span></p>
</div>
</div>
</section>
<section id="A6.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">F.3 </span>Proof of Proposition <a href="#Thmproposition4" title="Proposition 4 (Informal). ‣ 5 Causal recovery and domain factor estimation ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a></h3>

<div id="Thmproposition11" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmproposition11.2" class="ltx_text ltx_font_bold">Proposition 11</span></span><span id="Thmproposition11.3" class="ltx_text ltx_font_bold"> </span>(Formal statement of proposition <a href="#Thmproposition4" title="Proposition 4 (Informal). ‣ 5 Causal recovery and domain factor estimation ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>)<span id="Thmproposition11.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmproposition11.p1" class="ltx_para">
<p id="Thmproposition11.p1.1" class="ltx_p">Suppose the following conditions hold: (i) the Markov condition and faithfulness assumption are satisfied for the causal graph <math id="Thmproposition11.p1.m1" class="ltx_Math" alttext="\mathcal{G}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{i}</annotation></semantics></math> of each agent <math id="Thmproposition11.p1.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, (ii) For each true causal edge <math id="Thmproposition11.p1.m3" class="ltx_Math" alttext="(X\rightarrow Y)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><mi>Y</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(X\rightarrow Y)</annotation></semantics></math> in <math id="Thmproposition11.p1.m4" class="ltx_Math" alttext="\mathcal{G}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{i}</annotation></semantics></math>, the minimal conditional mutual information is lower-bounded: <math id="Thmproposition11.p1.m5" class="ltx_Math" alttext="I(X;Y|Z)\geq\lambda&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>;</mo><mi>Y</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mi>λ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">I(X;Y|Z)\geq\lambda&gt;0</annotation></semantics></math> for any conditioning set <math id="Thmproposition11.p1.m6" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math> that d-separates <math id="Thmproposition11.p1.m7" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> and <math id="Thmproposition11.p1.m8" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> in <math id="Thmproposition11.p1.m9" class="ltx_math_unparsed" alttext="\mathcal{G}_{i}\setminus\{X\rightarrow Y\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub><mo>∖</mo><mrow><mo stretchy="false">{</mo><mi>X</mi><mo stretchy="false">→</mo><mi>Y</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{G}_{i}\setminus\{X\rightarrow Y\}</annotation></semantics></math>, (iii) The maximal in-degree of any node in <math id="Thmproposition11.p1.m10" class="ltx_Math" alttext="\mathcal{G}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{i}</annotation></semantics></math> is bounded by <math id="Thmproposition11.p1.m11" class="ltx_Math" alttext="d_{\max}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>max</mi></msub><annotation encoding="application/x-tex">d_{\max}</annotation></semantics></math>, (iv) The noise terms <math id="Thmproposition11.p1.m12" class="ltx_Math" alttext="\epsilon_{i,j}^{s}(t)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ϵ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mi>s</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\epsilon_{i,j}^{s}(t)</annotation></semantics></math> are sub-Gaussian with parameter <math id="Thmproposition11.p1.m13" class="ltx_Math" alttext="\sigma^{2}" display="inline" intent=":literal"><semantics><msup><mi>σ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\sigma^{2}</annotation></semantics></math>, (v) Each element of <math id="Thmproposition11.p1.m14" class="ltx_Math" alttext="\mathbf{s}_{\mathcal{N}_{i}}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}_{\mathcal{N}_{i}}(t)</annotation></semantics></math> and <math id="Thmproposition11.p1.m15" class="ltx_Math" alttext="\mathbf{a}_{i}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{a}_{i}(t)</annotation></semantics></math> has bounded magnitude by <math id="Thmproposition11.p1.m16" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>, (vi) The transition functions <math id="Thmproposition11.p1.m17" class="ltx_Math" alttext="f_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">f_{i,j}</annotation></semantics></math> are <math id="Thmproposition11.p1.m18" class="ltx_Math" alttext="L_{f}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>f</mi></msub><annotation encoding="application/x-tex">L_{f}</annotation></semantics></math>-Lipschitz continuous in all arguments. Then, with probability at least <math id="Thmproposition11.p1.m19" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>, the estimated causal masks <math id="Thmproposition11.p1.m20" class="ltx_Math" alttext="\hat{\mathbf{C}}_{i}^{s\rightarrow s}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>𝐂</mi><mo>^</mo></mover><mi>i</mi><mrow><mi>s</mi><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><annotation encoding="application/x-tex">\hat{\mathbf{C}}_{i}^{s\rightarrow s}</annotation></semantics></math>, <math id="Thmproposition11.p1.m21" class="ltx_Math" alttext="\hat{\mathbf{c}}_{i}^{a\rightarrow s}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>𝐜</mi><mo>^</mo></mover><mi>i</mi><mrow><mi>a</mi><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><annotation encoding="application/x-tex">\hat{\mathbf{c}}_{i}^{a\rightarrow s}</annotation></semantics></math>, and <math id="Thmproposition11.p1.m22" class="ltx_Math" alttext="\hat{\mathbf{C}}_{i}^{\omega\rightarrow s}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>𝐂</mi><mo>^</mo></mover><mi>i</mi><mrow><mi>ω</mi><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><annotation encoding="application/x-tex">\hat{\mathbf{C}}_{i}^{\omega\rightarrow s}</annotation></semantics></math> will match the true causal masks for</p>
<table id="A6.Ex65" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex65.m1" class="ltx_Math" alttext="T_{e}=\Omega\left(\frac{d_{i}\cdot d_{\max}\cdot\log(d_{i}\cdot n/\delta)}{\lambda^{2}}\right)," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mi>e</mi></msub><mo>=</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>d</mi><mi>max</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>n</mi></mrow><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msup><mi>λ</mi><mn>2</mn></msup></mfrac><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">T_{e}=\Omega\left(\frac{d_{i}\cdot d_{\max}\cdot\log(d_{i}\cdot n/\delta)}{\lambda^{2}}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmproposition11.p1.2" class="ltx_p">where <math id="Thmproposition11.p1.m23" class="ltx_Math" alttext="d_{i}=\dim(\mathbf{s}_{\mathcal{N}_{i}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>i</mi></msub><mo rspace="0.1389em">=</mo><mrow><mo lspace="0.1389em" rspace="0em">dim</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d_{i}=\dim(\mathbf{s}_{\mathcal{N}_{i}})</annotation></semantics></math> is the total dimension of the state space for agent <math id="Thmproposition11.p1.m24" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> and its neighbors.</p>
</div>
</div>
<div id="A6.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A6.SS3.p1" class="ltx_para">
<p id="A6.SS3.p1.1" class="ltx_p"><span id="A6.SS3.p1.1.1" class="ltx_text">The proof consists of four main parts: (1) formulating the statistical estimation problem, (2) analyzing the error in conditional independence tests, (3) bounding the error probability in structure learning, and (4) deriving the sample complexity.</span></p>
</div>
<div id="A6.SS3.p2" class="ltx_para">
<p id="A6.SS3.p2.1" class="ltx_p"><span id="A6.SS3.p2.1.1" class="ltx_text ltx_font_bold">Step 1: Formulation of the statistical estimation problem.<span id="A6.SS3.p2.1.1.1" class="ltx_text ltx_font_medium"> For each agent <math id="A6.SS3.p2.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, we need to estimate the causal graph <math id="A6.SS3.p2.m2" class="ltx_Math" alttext="\mathcal{G}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{i}</annotation></semantics></math> from observed trajectories <math id="A6.SS3.p2.m3" class="ltx_Math" alttext="\{(\mathbf{s}_{\mathcal{N}_{i}}(t),\mathbf{a}_{i}(t),\mathbf{s}_{i}(t+1))\}_{t=0}^{T_{e}-1}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐬</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><msub><mi>T</mi><mi>e</mi></msub><mo>−</mo><mn>1</mn></mrow></msubsup><annotation encoding="application/x-tex">\{(\mathbf{s}_{\mathcal{N}_{i}}(t),\mathbf{a}_{i}(t),\mathbf{s}_{i}(t+1))\}_{t=0}^{T_{e}-1}</annotation></semantics></math>.</span></span></p>
</div>
<div id="A6.SS3.p3" class="ltx_para">
<p id="A6.SS3.p3.1" class="ltx_p"><span id="A6.SS3.p3.1.1" class="ltx_text">Define the variable set <math id="A6.SS3.p3.m1" class="ltx_Math" alttext="\mathcal{V}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{V}_{i}</annotation></semantics></math> for agent <math id="A6.SS3.p3.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> that includes:</span></p>
<ul id="A6.I6" class="ltx_itemize">
<li id="A6.I6.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I6.i1.p1" class="ltx_para">
<p id="A6.I6.i1.p1.1" class="ltx_p">States of agent <math id="A6.I6.i1.p1.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> at time <math id="A6.I6.i1.p1.m2" class="ltx_Math" alttext="t-1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t-1</annotation></semantics></math>: <math id="A6.I6.i1.p1.m3" class="ltx_Math" alttext="\mathbf{s}_{i}(t-1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐬</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}_{i}(t-1)</annotation></semantics></math></p>
</div></li>
<li id="A6.I6.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I6.i2.p1" class="ltx_para">
<p id="A6.I6.i2.p1.1" class="ltx_p">States of neighboring agents at time <math id="A6.I6.i2.p1.m1" class="ltx_Math" alttext="t-1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t-1</annotation></semantics></math>: <math id="A6.I6.i2.p1.m2" class="ltx_Math" alttext="\mathbf{s}_{\mathcal{N}_{i}\setminus i}(t-1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐬</mi><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∖</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}_{\mathcal{N}_{i}\setminus i}(t-1)</annotation></semantics></math></p>
</div></li>
<li id="A6.I6.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I6.i3.p1" class="ltx_para">
<p id="A6.I6.i3.p1.1" class="ltx_p">States of agent <math id="A6.I6.i3.p1.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> at time <math id="A6.I6.i3.p1.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>: <math id="A6.I6.i3.p1.m3" class="ltx_Math" alttext="\mathbf{s}_{i}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐬</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}_{i}(t)</annotation></semantics></math></p>
</div></li>
<li id="A6.I6.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I6.i4.p1" class="ltx_para">
<p id="A6.I6.i4.p1.1" class="ltx_p">Actions of agent <math id="A6.I6.i4.p1.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> at time <math id="A6.I6.i4.p1.m2" class="ltx_Math" alttext="t-1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t-1</annotation></semantics></math>: <math id="A6.I6.i4.p1.m3" class="ltx_Math" alttext="\mathbf{a}_{i}(t-1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{a}_{i}(t-1)</annotation></semantics></math></p>
</div></li>
<li id="A6.I6.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I6.i5.p1" class="ltx_para">
<p id="A6.I6.i5.p1.1" class="ltx_p">Domain index <math id="A6.I6.i5.p1.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, which serves as a surrogate for the unobserved change factors <math id="A6.I6.i5.p1.m2" class="ltx_Math" alttext="\boldsymbol{\omega}_{i}^{k}" display="inline" intent=":literal"><semantics><msubsup><mi>𝝎</mi><mi>i</mi><mi>k</mi></msubsup><annotation encoding="application/x-tex">\boldsymbol{\omega}_{i}^{k}</annotation></semantics></math></p>
</div></li>
</ul>
</div>
<div id="A6.SS3.p4" class="ltx_para">
<p id="A6.SS3.p4.1" class="ltx_p"><span id="A6.SS3.p4.1.1" class="ltx_text">We employ a constraint-based causal discovery approach, which identifies the causal structure by performing a series of conditional independence tests based on the key insight from Lemma 13:</span></p>
</div>
<div id="Thmlemma10" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma10.2" class="ltx_text ltx_font_bold">Lemma 10</span></span><span id="Thmlemma10.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma10.p1" class="ltx_para">
<p id="Thmlemma10.p1.1" class="ltx_p">For any two variables <math id="Thmlemma10.p1.m1" class="ltx_Math" alttext="V_{r},V_{s}\in\mathcal{V}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>r</mi></msub><mo>,</mo><mrow><msub><mi>V</mi><mi>s</mi></msub><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">V_{r},V_{s}\in\mathcal{V}_{i}</annotation></semantics></math>, they are not adjacent in <math id="Thmlemma10.p1.m2" class="ltx_Math" alttext="\mathcal{G}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{i}</annotation></semantics></math> if and only if they are independent conditional on some subset of <math id="Thmlemma10.p1.m3" class="ltx_math_unparsed" alttext="\{V_{t}:t\neq r,t\neq s\}\cup\{m\}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi><mo>≠</mo><mi>r</mi><mo>,</mo><mi>t</mi><mo>≠</mo><mi>s</mi><mo stretchy="false">}</mo></mrow><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>m</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\{V_{t}:t\neq r,t\neq s\}\cup\{m\}</annotation></semantics></math>.</p>
</div>
</div>
<div id="A6.SS3.p5" class="ltx_para">
<p id="A6.SS3.p5.1" class="ltx_p"><span id="A6.SS3.p5.1.1" class="ltx_text ltx_font_bold">Step 2: Analysis of conditional independence tests.<span id="A6.SS3.p5.1.1.1" class="ltx_text ltx_font_medium"> For analyzing conditional independence, we use the mutual information measure. For variables <math id="A6.SS3.p5.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> and <math id="A6.SS3.p5.m2" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> conditional on set <math id="A6.SS3.p5.m3" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math>, the conditional mutual information is:</span></span></p>
<table id="A6.Ex66" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex66.m1" class="ltx_Math" alttext="I(X;Y|Z)=\E_{X,Y,Z}\left[\log\frac{P(X,Y|Z)}{P(X|Z)P(Y|Z)}\right]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>;</mo><mi>Y</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>X</mi><mo>,</mo><mi>Y</mi><mo>,</mo><mi>Z</mi></mrow></msub><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>,</mo><mi>Y</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo lspace="0em" rspace="0em">|</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo lspace="0em" rspace="0em">|</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">I(X;Y|Z)=\E_{X,Y,Z}\left[\log\frac{P(X,Y|Z)}{P(X|Z)P(Y|Z)}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.p5.2" class="ltx_p"><span id="A6.SS3.p5.2.1" class="ltx_text">In practice, we estimate this from data using the empirical distributions:</span></p>
<table id="A6.Ex67" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex67.m1" class="ltx_Math" alttext="\hat{I}(X;Y|Z)=\sum_{x,y,z}\hat{P}(x,y,z)\log\frac{\hat{P}(x,y,z)\hat{P}(z)}{\hat{P}(x,z)\hat{P}(y,z)}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mi>I</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>;</mo><mi>Y</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi></mrow></munder><mrow><mover accent="true"><mi>P</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><mover accent="true"><mi>P</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>P</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mover accent="true"><mi>P</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>P</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\hat{I}(X;Y|Z)=\sum_{x,y,z}\hat{P}(x,y,z)\log\frac{\hat{P}(x,y,z)\hat{P}(z)}{\hat{P}(x,z)\hat{P}(y,z)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.p5.3" class="ltx_p"><span id="A6.SS3.p5.3.1" class="ltx_text">where <math id="A6.SS3.p5.m4" class="ltx_Math" alttext="\hat{P}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>P</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{P}</annotation></semantics></math> denotes empirical probabilities based on the observed data.</span></p>
</div>
<div id="A6.SS3.p6" class="ltx_para">
<p id="A6.SS3.p6.1" class="ltx_p"><span id="A6.SS3.p6.1.1" class="ltx_text">The estimation error can be bounded using concentration inequalities. For any <math id="A6.SS3.p6.m1" class="ltx_Math" alttext="\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon&gt;0</annotation></semantics></math>:</span></p>
<table id="A6.Ex68" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex68.m1" class="ltx_Math" alttext="P(|\hat{I}(X;Y|Z)-I(X;Y|Z)|&gt;\epsilon)\leq 2\exp\left(-\frac{T_{e}\epsilon^{2}}{C_{1}|\mathcal{X}||\mathcal{Y}||\mathcal{Z}|}\right)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><mover accent="true"><mi>I</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>;</mo><mi>Y</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>;</mo><mi>Y</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>&gt;</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mfrac><mrow><msub><mi>T</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup></mrow><mrow><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></mrow><mo stretchy="false">|</mo></mrow></mrow></mfrac></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">P(|\hat{I}(X;Y|Z)-I(X;Y|Z)|&gt;\epsilon)\leq 2\exp\left(-\frac{T_{e}\epsilon^{2}}{C_{1}|\mathcal{X}||\mathcal{Y}||\mathcal{Z}|}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.p6.2" class="ltx_p"><span id="A6.SS3.p6.2.1" class="ltx_text">where <math id="A6.SS3.p6.m2" class="ltx_Math" alttext="|\mathcal{X}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathcal{X}|</annotation></semantics></math>, <math id="A6.SS3.p6.m3" class="ltx_Math" alttext="|\mathcal{Y}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathcal{Y}|</annotation></semantics></math>, and <math id="A6.SS3.p6.m4" class="ltx_Math" alttext="|\mathcal{Z}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathcal{Z}|</annotation></semantics></math> are the cardinalities of the respective variable domains, and <math id="A6.SS3.p6.m5" class="ltx_Math" alttext="C_{1}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mn>1</mn></msub><annotation encoding="application/x-tex">C_{1}</annotation></semantics></math> is a universal constant.</span></p>
</div>
<div id="A6.SS3.p7" class="ltx_para">
<p id="A6.SS3.p7.1" class="ltx_p"><span id="A6.SS3.p7.1.1" class="ltx_text">For continuous variables, we can use kernel-based estimators or discretization. With appropriate binning of continuous variables, the error bound becomes:</span></p>
<table id="A6.Ex69" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex69.m1" class="ltx_Math" alttext="P(|\hat{I}(X;Y|Z)-I(X;Y|Z)|&gt;\epsilon)\leq 2\exp\left(-\frac{T_{e}\epsilon^{2}}{C_{2}b_{X}b_{Y}b_{Z}\log^{2}(T_{e})}\right)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><mover accent="true"><mi>I</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>;</mo><mi>Y</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>;</mo><mi>Y</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>&gt;</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mfrac><mrow><msub><mi>T</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup></mrow><mrow><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>Y</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>Z</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>e</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">P(|\hat{I}(X;Y|Z)-I(X;Y|Z)|&gt;\epsilon)\leq 2\exp\left(-\frac{T_{e}\epsilon^{2}}{C_{2}b_{X}b_{Y}b_{Z}\log^{2}(T_{e})}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.p7.2" class="ltx_p"><span id="A6.SS3.p7.2.1" class="ltx_text">where <math id="A6.SS3.p7.m1" class="ltx_Math" alttext="b_{X}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mi>X</mi></msub><annotation encoding="application/x-tex">b_{X}</annotation></semantics></math>, <math id="A6.SS3.p7.m2" class="ltx_Math" alttext="b_{Y}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mi>Y</mi></msub><annotation encoding="application/x-tex">b_{Y}</annotation></semantics></math>, and <math id="A6.SS3.p7.m3" class="ltx_Math" alttext="b_{Z}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mi>Z</mi></msub><annotation encoding="application/x-tex">b_{Z}</annotation></semantics></math> are the number of bins used for each variable, and <math id="A6.SS3.p7.m4" class="ltx_Math" alttext="C_{2}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mn>2</mn></msub><annotation encoding="application/x-tex">C_{2}</annotation></semantics></math> is a constant. The <math id="A6.SS3.p7.m5" class="ltx_Math" alttext="\log^{2}(T_{e})" display="inline" intent=":literal"><semantics><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>e</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\log^{2}(T_{e})</annotation></semantics></math> term arises from the adaptive discretization of continuous variables.</span></p>
</div>
<div id="A6.SS3.p8" class="ltx_para">
<p id="A6.SS3.p8.1" class="ltx_p"><span id="A6.SS3.p8.1.1" class="ltx_text ltx_font_bold">Step 3: bounding the error probability in structure learning.<span id="A6.SS3.p8.1.1.1" class="ltx_text ltx_font_medium"> Let <math id="A6.SS3.p8.m1" class="ltx_Math" alttext="\mathcal{G}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{i}</annotation></semantics></math> be the true causal graph for agent <math id="A6.SS3.p8.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, and <math id="A6.SS3.p8.m3" class="ltx_Math" alttext="\hat{\mathcal{G}}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>^</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\hat{\mathcal{G}}_{i}</annotation></semantics></math> be the estimated graph. We need to bound <math id="A6.SS3.p8.m4" class="ltx_Math" alttext="P(\hat{\mathcal{G}}_{i}\neq\mathcal{G}_{i})" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>^</mo></mover><mi>i</mi></msub><mo>≠</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P(\hat{\mathcal{G}}_{i}\neq\mathcal{G}_{i})</annotation></semantics></math>.</span></span></p>
</div>
<div id="A6.SS3.p9" class="ltx_para">
<p id="A6.SS3.p9.1" class="ltx_p"><span id="A6.SS3.p9.1.1" class="ltx_text">The structure learning error can occur in two ways:</span></p>
<ol id="A6.I7" class="ltx_enumerate">
<li id="A6.I7.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A6.I7.i1.p1" class="ltx_para">
<p id="A6.I7.i1.p1.1" class="ltx_p">Missing a true edge (Type II error in a conditional independence test)</p>
</div></li>
<li id="A6.I7.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A6.I7.i2.p1" class="ltx_para">
<p id="A6.I7.i2.p1.1" class="ltx_p">Adding a spurious edge (Type I error in a conditional independence test)</p>
</div></li>
</ol>
</div>
<div id="A6.SS3.p10" class="ltx_para">
<p id="A6.SS3.p10.1" class="ltx_p"><span id="A6.SS3.p10.1.1" class="ltx_text">For Type I errors, we set the significance level to <math id="A6.SS3.p10.m1" class="ltx_Math" alttext="\alpha=\frac{\delta}{2M}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mfrac><mi>δ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">\alpha=\frac{\delta}{2M}</annotation></semantics></math>, where <math id="A6.SS3.p10.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> is the total number of conditional independence tests performed. For Type II errors, we use the fact that when variables are dependent with conditional mutual information at least <math id="A6.SS3.p10.m3" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>, the probability of wrongly concluding independence is:</span></p>
<table id="A6.Ex70" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex70.m1" class="ltx_Math" alttext="P(\text{Type II error})\leq\exp\left(-\frac{T_{e}\gamma^{2}}{C_{3}|\mathcal{X}||\mathcal{Y}||\mathcal{Z}|}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mtext>Type II error</mtext><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mfrac><mrow><msub><mi>T</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><mrow><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></mrow><mo stretchy="false">|</mo></mrow></mrow></mfrac></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P(\text{Type II error})\leq\exp\left(-\frac{T_{e}\gamma^{2}}{C_{3}|\mathcal{X}||\mathcal{Y}||\mathcal{Z}|}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.p10.2" class="ltx_p"><span id="A6.SS3.p10.2.1" class="ltx_text">where <math id="A6.SS3.p10.m4" class="ltx_Math" alttext="C_{3}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mn>3</mn></msub><annotation encoding="application/x-tex">C_{3}</annotation></semantics></math> is a constant that depends on the distribution properties.</span></p>
</div>
<div id="A6.SS3.p11" class="ltx_para">
<p id="A6.SS3.p11.1" class="ltx_p"><span id="A6.SS3.p11.1.1" class="ltx_text">The total number of conditional independence tests is bounded by <math id="A6.SS3.p11.m1" class="ltx_Math" alttext="M\leq d_{i}^{2}\cdot\sum_{j=0}^{d_{\max}}\binom{d_{i}-2}{j}\leq d_{i}^{2}\cdot\binom{d_{i}}{d_{\max}}\leq d_{i}^{2}\cdot(ed_{i}/d_{\max})^{d_{\max}}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>≤</mo><mrow><msubsup><mi>d</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0.222em" rspace="0.055em">⋅</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><msub><mi>d</mi><mi>max</mi></msub></msubsup><mrow><mo>(</mo><mfrac linethickness="0pt"><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>−</mo><mn>2</mn></mrow><mi>j</mi></mfrac><mo>)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><msubsup><mi>d</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><msub><mi>d</mi><mi>i</mi></msub><msub><mi>d</mi><mi>max</mi></msub></mfrac><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><msubsup><mi>d</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>i</mi></msub></mrow><mo>/</mo><msub><mi>d</mi><mi>max</mi></msub></mrow><mo stretchy="false">)</mo></mrow><msub><mi>d</mi><mi>max</mi></msub></msup></mrow></mrow><annotation encoding="application/x-tex">M\leq d_{i}^{2}\cdot\sum_{j=0}^{d_{\max}}\binom{d_{i}-2}{j}\leq d_{i}^{2}\cdot\binom{d_{i}}{d_{\max}}\leq d_{i}^{2}\cdot(ed_{i}/d_{\max})^{d_{\max}}</annotation></semantics></math>.</span></p>
</div>
<div id="A6.SS3.p12" class="ltx_para">
<p id="A6.SS3.p12.1" class="ltx_p"><span id="A6.SS3.p12.1.1" class="ltx_text">By the union bound, the probability of any error in structure learning is:</span></p>
<table id="A6.Ex71" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex71.m1" class="ltx_Math" alttext="P(\hat{\mathcal{G}}_{i}\neq\mathcal{G}_{i})\leq M\cdot\max\left\{\alpha,\exp\left(-\frac{T_{e}\gamma^{2}}{C_{3}d_{\max}}\right)\right\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>^</mo></mover><mi>i</mi></msub><mo>≠</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mi>α</mi><mo>,</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mfrac><mrow><msub><mi>T</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><mrow><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>max</mi></msub></mrow></mfrac></mrow><mo>)</mo></mrow></mrow><mo>}</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P(\hat{\mathcal{G}}_{i}\neq\mathcal{G}_{i})\leq M\cdot\max\left\{\alpha,\exp\left(-\frac{T_{e}\gamma^{2}}{C_{3}d_{\max}}\right)\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.p12.2" class="ltx_p"><span id="A6.SS3.p12.2.1" class="ltx_text">where we’ve used that the maximum size of any conditioning set is <math id="A6.SS3.p12.m1" class="ltx_Math" alttext="d_{\max}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>max</mi></msub><annotation encoding="application/x-tex">d_{\max}</annotation></semantics></math>, and the maximum cardinality of any variable domain is bounded by a function of <math id="A6.SS3.p12.m2" class="ltx_Math" alttext="d_{\max}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>max</mi></msub><annotation encoding="application/x-tex">d_{\max}</annotation></semantics></math> given our discretization scheme.</span></p>
</div>
<div id="A6.SS3.p13" class="ltx_para">
<p id="A6.SS3.p13.1" class="ltx_p"><span id="A6.SS3.p13.1.1" class="ltx_text ltx_font_bold">Step 4: deriving the sample complexity.<span id="A6.SS3.p13.1.1.1" class="ltx_text ltx_font_medium"> To ensure <math id="A6.SS3.p13.m1" class="ltx_Math" alttext="P(\hat{\mathcal{G}}_{i}\neq\mathcal{G}_{i})\leq\delta" display="inline" intent=":literal"><semantics><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>^</mo></mover><mi>i</mi></msub><mo>≠</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">P(\hat{\mathcal{G}}_{i}\neq\mathcal{G}_{i})\leq\delta</annotation></semantics></math>, we need:</span></span></p>
<ol id="A6.I8" class="ltx_enumerate">
<li id="A6.I8.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A6.I8.i1.p1" class="ltx_para">
<p id="A6.I8.i1.p1.1" class="ltx_p"><math id="A6.I8.i1.p1.m1" class="ltx_Math" alttext="\alpha=\frac{\delta}{2M}\leq\frac{\delta}{2d_{i}^{2}\cdot(ed_{i}/d_{\max})^{d_{\max}}}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mfrac><mi>δ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mfrac><mo>≤</mo><mfrac><mi>δ</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mi>i</mi><mn>2</mn></msubsup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>i</mi></msub></mrow><mo>/</mo><msub><mi>d</mi><mi>max</mi></msub></mrow><mo stretchy="false">)</mo></mrow><msub><mi>d</mi><mi>max</mi></msub></msup></mrow></mfrac></mrow><annotation encoding="application/x-tex">\alpha=\frac{\delta}{2M}\leq\frac{\delta}{2d_{i}^{2}\cdot(ed_{i}/d_{\max})^{d_{\max}}}</annotation></semantics></math>.</p>
</div></li>
<li id="A6.I8.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A6.I8.i2.p1" class="ltx_para">
<p id="A6.I8.i2.p1.1" class="ltx_p"><math id="A6.I8.i2.p1.m1" class="ltx_Math" alttext="\exp\left(-\frac{T_{e}\gamma^{2}}{C_{3}d_{\max}}\right)\leq\frac{\delta}{2M}\leq\frac{\delta}{2d_{i}^{2}\cdot(ed_{i}/d_{\max})^{d_{\max}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mfrac><mrow><msub><mi>T</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><mrow><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>max</mi></msub></mrow></mfrac></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mfrac><mi>δ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mfrac><mo>≤</mo><mfrac><mi>δ</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mi>i</mi><mn>2</mn></msubsup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>i</mi></msub></mrow><mo>/</mo><msub><mi>d</mi><mi>max</mi></msub></mrow><mo stretchy="false">)</mo></mrow><msub><mi>d</mi><mi>max</mi></msub></msup></mrow></mfrac></mrow><annotation encoding="application/x-tex">\exp\left(-\frac{T_{e}\gamma^{2}}{C_{3}d_{\max}}\right)\leq\frac{\delta}{2M}\leq\frac{\delta}{2d_{i}^{2}\cdot(ed_{i}/d_{\max})^{d_{\max}}}</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
<div id="A6.SS3.p14" class="ltx_para">
<p id="A6.SS3.p14.1" class="ltx_p"><span id="A6.SS3.p14.1.1" class="ltx_text">From the second condition, we derive:</span></p>
<table id="A6.Ex72" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex72.m1" class="ltx_Math" alttext="\frac{T_{e}\gamma^{2}}{C_{3}d_{\max}}\geq\log\left(\frac{2d_{i}^{2}\cdot(ed_{i}/d_{\max})^{d_{\max}}}{\delta}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><msub><mi>T</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><mrow><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>max</mi></msub></mrow></mfrac><mo>≥</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mi>i</mi><mn>2</mn></msubsup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>i</mi></msub></mrow><mo>/</mo><msub><mi>d</mi><mi>max</mi></msub></mrow><mo stretchy="false">)</mo></mrow><msub><mi>d</mi><mi>max</mi></msub></msup></mrow><mi>δ</mi></mfrac><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{T_{e}\gamma^{2}}{C_{3}d_{\max}}\geq\log\left(\frac{2d_{i}^{2}\cdot(ed_{i}/d_{\max})^{d_{\max}}}{\delta}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.SS3.p15" class="ltx_para">
<p id="A6.SS3.p15.1" class="ltx_p"><span id="A6.SS3.p15.1.1" class="ltx_text">Therefore:</span></p>
<table id="A6.Ex73" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex73.m1" class="ltx_Math" alttext="T_{e}\geq\frac{C_{3}d_{\max}}{\gamma^{2}}\log\left(\frac{2d_{i}^{2}\cdot(ed_{i}/d_{\max})^{d_{\max}}}{\delta}\right)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mi>e</mi></msub><mo>≥</mo><mrow><mfrac><mrow><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>max</mi></msub></mrow><msup><mi>γ</mi><mn>2</mn></msup></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mi>i</mi><mn>2</mn></msubsup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>i</mi></msub></mrow><mo>/</mo><msub><mi>d</mi><mi>max</mi></msub></mrow><mo stretchy="false">)</mo></mrow><msub><mi>d</mi><mi>max</mi></msub></msup></mrow><mi>δ</mi></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T_{e}\geq\frac{C_{3}d_{\max}}{\gamma^{2}}\log\left(\frac{2d_{i}^{2}\cdot(ed_{i}/d_{\max})^{d_{\max}}}{\delta}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.SS3.p16" class="ltx_para">
<p id="A6.SS3.p16.1" class="ltx_p"><span id="A6.SS3.p16.1.1" class="ltx_text">Now, we need to analyze this expression more carefully:</span></p>
<table id="A6.Ex74" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex74.m1" class="ltx_Math" alttext="\log\left(\frac{2d_{i}^{2}\cdot(ed_{i}/d_{\max})^{d_{\max}}}{\delta}\right)=\log\left(\frac{2d_{i}^{2}}{\delta}\right)+d_{\max}\log\left(\frac{ed_{i}}{d_{\max}}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mi>i</mi><mn>2</mn></msubsup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>i</mi></msub></mrow><mo>/</mo><msub><mi>d</mi><mi>max</mi></msub></mrow><mo stretchy="false">)</mo></mrow><msub><mi>d</mi><mi>max</mi></msub></msup></mrow><mi>δ</mi></mfrac><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mi>i</mi><mn>2</mn></msubsup></mrow><mi>δ</mi></mfrac><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>d</mi><mi>max</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>i</mi></msub></mrow><msub><mi>d</mi><mi>max</mi></msub></mfrac><mo>)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\log\left(\frac{2d_{i}^{2}\cdot(ed_{i}/d_{\max})^{d_{\max}}}{\delta}\right)=\log\left(\frac{2d_{i}^{2}}{\delta}\right)+d_{\max}\log\left(\frac{ed_{i}}{d_{\max}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.SS3.p17" class="ltx_para">
<p id="A6.SS3.p17.1" class="ltx_p"><span id="A6.SS3.p17.1.1" class="ltx_text">Under the sparsity assumption (<math id="A6.SS3.p17.m1" class="ltx_Math" alttext="d_{\max}\ll d_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>max</mi></msub><mo>≪</mo><msub><mi>d</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">d_{\max}\ll d_{i}</annotation></semantics></math>), we have:</span></p>
<table id="A6.Ex75" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex75.m1" class="ltx_Math" alttext="d_{\max}\log\left(\frac{ed_{i}}{d_{\max}}\right)\leq d_{\max}\log(ed_{i})=O(d_{\max}\log(d_{i}))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>d</mi><mi>max</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>i</mi></msub></mrow><msub><mi>d</mi><mi>max</mi></msub></mfrac><mo>)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><msub><mi>d</mi><mi>max</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mi>max</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">d_{\max}\log\left(\frac{ed_{i}}{d_{\max}}\right)\leq d_{\max}\log(ed_{i})=O(d_{\max}\log(d_{i})).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.SS3.p18" class="ltx_para">
<p id="A6.SS3.p18.1" class="ltx_p"><span id="A6.SS3.p18.1.1" class="ltx_text">Therefore:</span></p>
<table id="A6.Ex76" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex76.m1" class="ltx_Math" alttext="T_{e}\geq\frac{C_{3}d_{\max}}{\gamma^{2}}\left[\log\left(\frac{2d_{i}^{2}}{\delta}\right)+O(d_{\max}\log(d_{i}))\right]." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mi>e</mi></msub><mo>≥</mo><mrow><mfrac><mrow><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>max</mi></msub></mrow><msup><mi>γ</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mi>i</mi><mn>2</mn></msubsup></mrow><mi>δ</mi></mfrac><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mi>max</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T_{e}\geq\frac{C_{3}d_{\max}}{\gamma^{2}}\left[\log\left(\frac{2d_{i}^{2}}{\delta}\right)+O(d_{\max}\log(d_{i}))\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.p18.2" class="ltx_p"><span id="A6.SS3.p18.2.1" class="ltx_text">This simplifies to:</span></p>
<table id="A6.Ex77" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex77.m1" class="ltx_Math" alttext="T_{e}=O\left(\frac{d_{\max}^{2}\log(d_{i})+d_{\max}\log(1/\delta)}{\gamma^{2}}\right)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mi>e</mi></msub><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><mrow><msubsup><mi>d</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>d</mi><mi>max</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><msup><mi>γ</mi><mn>2</mn></msup></mfrac><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T_{e}=O\left(\frac{d_{\max}^{2}\log(d_{i})+d_{\max}\log(1/\delta)}{\gamma^{2}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.SS3.p19" class="ltx_para">
<p id="A6.SS3.p19.1" class="ltx_p"><span id="A6.SS3.p19.1.1" class="ltx_text">For most practical scenarios where <math id="A6.SS3.p19.m1" class="ltx_Math" alttext="d_{\max}=O(\log(d_{i}))" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>max</mi></msub><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d_{\max}=O(\log(d_{i}))</annotation></semantics></math> (very sparse graphs), this further simplifies to:</span></p>
<table id="A6.Ex78" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex78.m1" class="ltx_Math" alttext="T_{e}=O\left(\frac{d_{\max}\log(d_{i})\log(d_{i}/\delta)}{\gamma^{2}}\right)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mi>e</mi></msub><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msub><mi>d</mi><mi>max</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msup><mi>γ</mi><mn>2</mn></msup></mfrac><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T_{e}=O\left(\frac{d_{\max}\log(d_{i})\log(d_{i}/\delta)}{\gamma^{2}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.SS3.p20" class="ltx_para">
<p id="A6.SS3.p20.1" class="ltx_p"><span id="A6.SS3.p20.1.1" class="ltx_text">However, for a more general bound without assuming extreme sparsity, we have:</span></p>
<table id="A6.Ex79" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex79.m1" class="ltx_Math" alttext="T_{e}=O\left(\frac{d_{\max}^{2}\log(d_{i})+d_{\max}\log(1/\delta)}{\gamma^{2}}\right)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mi>e</mi></msub><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><mrow><msubsup><mi>d</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>d</mi><mi>max</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><msup><mi>γ</mi><mn>2</mn></msup></mfrac><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T_{e}=O\left(\frac{d_{\max}^{2}\log(d_{i})+d_{\max}\log(1/\delta)}{\gamma^{2}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.SS3.p21" class="ltx_para">
<p id="A6.SS3.p21.1" class="ltx_p"><span id="A6.SS3.p21.1.1" class="ltx_text">Now, accounting for the fact that we’re learning causal masks for all <math id="A6.SS3.p21.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> agents, and applying a union bound across agents, we replace <math id="A6.SS3.p21.m2" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> with <math id="A6.SS3.p21.m3" class="ltx_Math" alttext="\delta/n" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>/</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">\delta/n</annotation></semantics></math>, yielding:</span></p>
<table id="A6.Ex80" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex80.m1" class="ltx_Math" alttext="T_{e}=O\left(\frac{d_{\max}^{2}\log(d_{i})+d_{\max}\log(n/\delta)}{\gamma^{2}}\right)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mi>e</mi></msub><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><mrow><msubsup><mi>d</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>d</mi><mi>max</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><msup><mi>γ</mi><mn>2</mn></msup></mfrac><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T_{e}=O\left(\frac{d_{\max}^{2}\log(d_{i})+d_{\max}\log(n/\delta)}{\gamma^{2}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.SS3.p22" class="ltx_para">
<p id="A6.SS3.p22.1" class="ltx_p"><span id="A6.SS3.p22.1.1" class="ltx_text">For typical networked systems where <math id="A6.SS3.p22.m1" class="ltx_Math" alttext="d_{i}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>i</mi></msub><annotation encoding="application/x-tex">d_{i}</annotation></semantics></math> scales with the number of neighbors, this gives us our final sample complexity:</span></p>
<table id="A6.Ex81" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex81.m1" class="ltx_Math" alttext="T_{e}=\Omega\left(\frac{d_{i}\cdot d_{\max}\cdot\log(d_{i}\cdot n/\delta)}{\gamma^{2}}\right)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mi>e</mi></msub><mo>=</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>d</mi><mi>max</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>n</mi></mrow><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msup><mi>γ</mi><mn>2</mn></msup></mfrac><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T_{e}=\Omega\left(\frac{d_{i}\cdot d_{\max}\cdot\log(d_{i}\cdot n/\delta)}{\gamma^{2}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.p22.2" class="ltx_p"><span id="A6.SS3.p22.2.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A6.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">F.4 </span>Proof of Proposition <a href="#Thmproposition5" title="Proposition 5 (Informal). ‣ 5 Causal recovery and domain factor estimation ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a></h3>

<div id="Thmproposition12" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmproposition12.2" class="ltx_text ltx_font_bold">Proposition 12</span></span><span id="Thmproposition12.3" class="ltx_text ltx_font_bold"> </span>(Formal statement of Proposition <a href="#Thmproposition5" title="Proposition 5 (Informal). ‣ 5 Causal recovery and domain factor estimation ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>)<span id="Thmproposition12.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmproposition12.p1" class="ltx_para">
<p id="Thmproposition12.p1.1" class="ltx_p">Suppose the following conditions hold: (i) The true causal masks are estimated accurately, (ii) the transition dynamics are identifiable with respect to the domain factor, i.e., for any two distinct domain factors <math id="Thmproposition12.p1.m1" class="ltx_Math" alttext="\boldsymbol{\omega}_{i}\neq\boldsymbol{\omega}_{i}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝝎</mi><mi>i</mi></msub><mo>≠</mo><msubsup><mi>𝝎</mi><mi>i</mi><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">\boldsymbol{\omega}_{i}\neq\boldsymbol{\omega}_{i}^{\prime}</annotation></semantics></math>, there exists a set of states and actions with non-zero measure such that the conditional distributions <math id="Thmproposition12.p1.m2" class="ltx_Math" alttext="P(\mathbf{s}_{i,j}(t+1)|\mathbf{s}_{\mathcal{N}_{i}}(t),\mathbf{a}_{i}(t),\boldsymbol{\omega}_{i})" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐬</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><mrow><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝝎</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P(\mathbf{s}_{i,j}(t+1)|\mathbf{s}_{\mathcal{N}_{i}}(t),\mathbf{a}_{i}(t),\boldsymbol{\omega}_{i})</annotation></semantics></math> and <math id="Thmproposition12.p1.m3" class="ltx_Math" alttext="P(s_{i,j}(t+1)|\mathbf{s}_{\mathcal{N}_{i}}(t),\mathbf{a}_{i}(t),\boldsymbol{\omega}_{i}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><mrow><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msubsup><mi>𝝎</mi><mi>i</mi><mo>′</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P(s_{i,j}(t+1)|\mathbf{s}_{\mathcal{N}_{i}}(t),\mathbf{a}_{i}(t),\boldsymbol{\omega}_{i}^{\prime})</annotation></semantics></math> are distinguishable. (iii) The noise terms <math id="Thmproposition12.p1.m4" class="ltx_Math" alttext="\epsilon_{i,j}^{s}(t)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ϵ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mi>s</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\epsilon_{i,j}^{s}(t)</annotation></semantics></math> are independent, sub-Gaussian with parameter <math id="Thmproposition12.p1.m5" class="ltx_Math" alttext="\sigma^{2}" display="inline" intent=":literal"><semantics><msup><mi>σ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\sigma^{2}</annotation></semantics></math>. (iv) The domain factor <math id="Thmproposition12.p1.m6" class="ltx_Math" alttext="\boldsymbol{\omega}_{i}^{m}\in\Omega_{i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝝎</mi><mi>i</mi><mi>m</mi></msubsup><mo>∈</mo><msub><mi mathvariant="normal">Ω</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\boldsymbol{\omega}_{i}^{m}\in\Omega_{i}</annotation></semantics></math> belongs to a compact set with diameter <math id="Thmproposition12.p1.m7" class="ltx_Math" alttext="D_{\Omega}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi mathvariant="normal">Ω</mi></msub><annotation encoding="application/x-tex">D_{\Omega}</annotation></semantics></math>. (v) For any two distinct domain factors <math id="Thmproposition12.p1.m8" class="ltx_Math" alttext="\boldsymbol{\omega}_{i}\neq\boldsymbol{\omega}_{i}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝝎</mi><mi>i</mi></msub><mo>≠</mo><msubsup><mi>𝝎</mi><mi>i</mi><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">\boldsymbol{\omega}_{i}\neq\boldsymbol{\omega}_{i}^{\prime}</annotation></semantics></math> with <math id="Thmproposition12.p1.m9" class="ltx_Math" alttext="\|\boldsymbol{\omega}_{i}-\boldsymbol{\omega}_{i}^{\prime}\|_{2}\geq\epsilon" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝝎</mi><mi>i</mi></msub><mo>−</mo><msubsup><mi>𝝎</mi><mi>i</mi><mo>′</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≥</mo><mi>ϵ</mi></mrow><annotation encoding="application/x-tex">\|\boldsymbol{\omega}_{i}-\boldsymbol{\omega}_{i}^{\prime}\|_{2}\geq\epsilon</annotation></semantics></math>,</p>
<table id="A6.Ex82" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex82.m1" class="ltx_Math" alttext="\|P(\mathbf{s}_{i}(t+1)|\mathbf{s}_{\mathcal{N}_{i}}(t),\mathbf{a}_{i}(t),\boldsymbol{\omega}_{i})-P(\mathbf{s}_{i}(t+1)|\mathbf{s}_{\mathcal{N}_{i}}(t),\mathbf{a}_{i}(t),\boldsymbol{\omega}_{i}^{\prime})\|_{\text{TV}}\geq\alpha\epsilon" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐬</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><mrow><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝝎</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐬</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><mrow><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msubsup><mi>𝝎</mi><mi>i</mi><mo>′</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mtext>TV</mtext></msub><mo>≥</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow><annotation encoding="application/x-tex">\|P(\mathbf{s}_{i}(t+1)|\mathbf{s}_{\mathcal{N}_{i}}(t),\mathbf{a}_{i}(t),\boldsymbol{\omega}_{i})-P(\mathbf{s}_{i}(t+1)|\mathbf{s}_{\mathcal{N}_{i}}(t),\mathbf{a}_{i}(t),\boldsymbol{\omega}_{i}^{\prime})\|_{\text{TV}}\geq\alpha\epsilon</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmproposition12.p1.2" class="ltx_p">for some constant <math id="Thmproposition12.p1.m10" class="ltx_Math" alttext="\alpha&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\alpha&gt;0</annotation></semantics></math>. Then, for any domain with true domain factor <math id="Thmproposition12.p1.m11" class="ltx_Math" alttext="\boldsymbol{\omega}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝝎</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\boldsymbol{\omega}^{*}</annotation></semantics></math>, given a trajectory of length <math id="Thmproposition12.p1.m12" class="ltx_Math" alttext="T_{e}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>e</mi></msub><annotation encoding="application/x-tex">T_{e}</annotation></semantics></math>, the estimated domain factor <math id="Thmproposition12.p1.m13" class="ltx_Math" alttext="\hat{\boldsymbol{\omega}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\boldsymbol{\omega}}</annotation></semantics></math> satisfies:</p>
<table id="A6.Ex83" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex83.m1" class="ltx_Math" alttext="\|\hat{\boldsymbol{\omega}}-\boldsymbol{\omega}^{*}\|_{2}\leq C_{\boldsymbol{\omega}}\sqrt{\frac{D_{\Omega}\log(nT_{e}/\delta)}{T_{e}}}" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mo>−</mo><msup><mi>𝝎</mi><mo>∗</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><msub><mi>C</mi><mi>𝝎</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><msub><mi>D</mi><mi mathvariant="normal">Ω</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>e</mi></msub></mrow><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msub><mi>T</mi><mi>e</mi></msub></mfrac></msqrt></mrow></mrow><annotation encoding="application/x-tex">\|\hat{\boldsymbol{\omega}}-\boldsymbol{\omega}^{*}\|_{2}\leq C_{\boldsymbol{\omega}}\sqrt{\frac{D_{\Omega}\log(nT_{e}/\delta)}{T_{e}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmproposition12.p1.3" class="ltx_p">with probability at least <math id="Thmproposition12.p1.m14" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>, where <math id="Thmproposition12.p1.m15" class="ltx_Math" alttext="D_{\Omega}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi mathvariant="normal">Ω</mi></msub><annotation encoding="application/x-tex">D_{\Omega}</annotation></semantics></math> is the dimension of the domain factor space, and <math id="Thmproposition12.p1.m16" class="ltx_Math" alttext="C_{\boldsymbol{\omega}}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>𝝎</mi></msub><annotation encoding="application/x-tex">C_{\boldsymbol{\omega}}</annotation></semantics></math> is a constant that depends on <math id="Thmproposition12.p1.m17" class="ltx_Math" alttext="L_{f}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>f</mi></msub><annotation encoding="application/x-tex">L_{f}</annotation></semantics></math>, <math id="Thmproposition12.p1.m18" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math>, <math id="Thmproposition12.p1.m19" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>, and the conditioning of the estimation problem.</p>
</div>
</div>
<div id="A6.SS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A6.SS4.p1" class="ltx_para">
<p id="A6.SS4.p1.1" class="ltx_p"><span id="A6.SS4.p1.1.1" class="ltx_text">The proof consists of three main parts: (1) formulating the domain factor estimation problem, (2) analyzing the estimation error using statistical learning theory, and (3) deriving the final sample complexity bound.</span></p>
</div>
<div id="A6.SS4.p2" class="ltx_para">
<p id="A6.SS4.p2.1" class="ltx_p"><span id="A6.SS4.p2.1.1" class="ltx_text ltx_font_bold">Step 1: formulation of the domain factor estimation problem.<span id="A6.SS4.p2.1.1.1" class="ltx_text ltx_font_medium"> Given the known causal structure encoded by masks <math id="A6.SS4.p2.m1" class="ltx_Math" alttext="\mathbf{C}_{i}^{s\rightarrow s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐂</mi><mi>i</mi><mrow><mi>s</mi><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathbf{C}_{i}^{s\rightarrow s}</annotation></semantics></math>, <math id="A6.SS4.p2.m2" class="ltx_Math" alttext="\mathbf{c}_{i}^{a\rightarrow s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐜</mi><mi>i</mi><mrow><mi>a</mi><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathbf{c}_{i}^{a\rightarrow s}</annotation></semantics></math>, and <math id="A6.SS4.p2.m3" class="ltx_Math" alttext="\mathbf{C}_{i}^{\omega\rightarrow s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐂</mi><mi>i</mi><mrow><mi>ω</mi><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathbf{C}_{i}^{\omega\rightarrow s}</annotation></semantics></math>, the domain factor estimation problem can be formulated as finding the domain factor <math id="A6.SS4.p2.m4" class="ltx_Math" alttext="\boldsymbol{\omega}" display="inline" intent=":literal"><semantics><mi>𝝎</mi><annotation encoding="application/x-tex">\boldsymbol{\omega}</annotation></semantics></math> that best explains the observed transitions.</span></span></p>
</div>
<div id="A6.SS4.p3" class="ltx_para">
<p id="A6.SS4.p3.1" class="ltx_p"><span id="A6.SS4.p3.1.1" class="ltx_text">For agent <math id="A6.SS4.p3.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, we have observed trajectories <math id="A6.SS4.p3.m2" class="ltx_Math" alttext="\{(\mathbf{s}_{\mathcal{N}_{i}}(t),\mathbf{a}_{i}(t),\mathbf{s}_{i}(t+1))\}_{t=0}^{T_{e}-1}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐬</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><msub><mi>T</mi><mi>e</mi></msub><mo>−</mo><mn>1</mn></mrow></msubsup><annotation encoding="application/x-tex">\{(\mathbf{s}_{\mathcal{N}_{i}}(t),\mathbf{a}_{i}(t),\mathbf{s}_{i}(t+1))\}_{t=0}^{T_{e}-1}</annotation></semantics></math> generated from the true domain factor <math id="A6.SS4.p3.m3" class="ltx_Math" alttext="\boldsymbol{\omega}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝝎</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\boldsymbol{\omega}^{*}</annotation></semantics></math>. We can define a negative log-likelihood function for each agent <math id="A6.SS4.p3.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>:</span></p>
</div>
<div id="A6.SS4.p4" class="ltx_para">
<table id="A6.Ex84" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex84.m1" class="ltx_math_unparsed" alttext="\mathcal{L}_{i}(\boldsymbol{\omega})=-\frac{1}{T_{e}}\sum_{t=0}^{T_{e}-1}\log P(\mathbf{s}_{i}(t+1)|\mathbf{s}_{\mathcal{N}_{i}}(t),\mathbf{a}_{i}(t),\boldsymbol{\omega})." display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝝎</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mfrac><mn>1</mn><msub><mi>T</mi><mi>e</mi></msub></mfrac><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><msub><mi>T</mi><mi>e</mi></msub><mo>−</mo><mn>1</mn></mrow></munderover><mi>log</mi><mi>P</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝐚</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>𝝎</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{i}(\boldsymbol{\omega})=-\frac{1}{T_{e}}\sum_{t=0}^{T_{e}-1}\log P(\mathbf{s}_{i}(t+1)|\mathbf{s}_{\mathcal{N}_{i}}(t),\mathbf{a}_{i}(t),\boldsymbol{\omega}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS4.p4.1" class="ltx_p"><span id="A6.SS4.p4.1.1" class="ltx_text">The maximum likelihood estimator (MLE) for the domain factor is:</span></p>
<table id="A6.Ex85" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex85.m1" class="ltx_Math" alttext="\hat{\boldsymbol{\omega}}=\arg\min_{\boldsymbol{\omega}\in\Omega}\frac{1}{n}\sum_{i=1}^{n}\mathcal{L}_{i}(\boldsymbol{\omega})." display="block" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mo>=</mo><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><munder><mi>min</mi><mrow><mi>𝝎</mi><mo>∈</mo><mi mathvariant="normal">Ω</mi></mrow></munder></mrow><mo lspace="0.167em" rspace="0em">​</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝝎</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\hat{\boldsymbol{\omega}}=\arg\min_{\boldsymbol{\omega}\in\Omega}\frac{1}{n}\sum_{i=1}^{n}\mathcal{L}_{i}(\boldsymbol{\omega}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.SS4.p5" class="ltx_para">
<p id="A6.SS4.p5.1" class="ltx_p"><span id="A6.SS4.p5.1.1" class="ltx_text ltx_font_bold">Step 2: analysis of the estimation error.<span id="A6.SS4.p5.1.1.1" class="ltx_text ltx_font_medium"> To analyze the estimation error, we use the theory of M-estimators and the properties of the negative log-likelihood function. First, we establish some key properties of the negative log-likelihood.</span></span></p>
</div>
<div id="Thmlemma11" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma11.2" class="ltx_text ltx_font_bold">Lemma 11</span></span><span id="Thmlemma11.3" class="ltx_text ltx_font_bold"> </span>(Lipschitz continuity of negative log-likelihood)<span id="Thmlemma11.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma11.p1" class="ltx_para">
<p id="Thmlemma11.p1.1" class="ltx_p">Under the assumption that the transition function <math id="Thmlemma11.p1.m1" class="ltx_Math" alttext="f_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">f_{i,j}</annotation></semantics></math> is <math id="Thmlemma11.p1.m2" class="ltx_Math" alttext="L_{f}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>f</mi></msub><annotation encoding="application/x-tex">L_{f}</annotation></semantics></math>-Lipschitz continuous with respect to all arguments, the negative log-likelihood function <math id="Thmlemma11.p1.m3" class="ltx_Math" alttext="\mathcal{L}_{i}(\boldsymbol{\omega})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝝎</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{i}(\boldsymbol{\omega})</annotation></semantics></math> is <math id="Thmlemma11.p1.m4" class="ltx_Math" alttext="L_{\mathcal{L}}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi class="ltx_font_mathcaligraphic">ℒ</mi></msub><annotation encoding="application/x-tex">L_{\mathcal{L}}</annotation></semantics></math>-Lipschitz continuous with respect to <math id="Thmlemma11.p1.m5" class="ltx_Math" alttext="\boldsymbol{\omega}" display="inline" intent=":literal"><semantics><mi>𝝎</mi><annotation encoding="application/x-tex">\boldsymbol{\omega}</annotation></semantics></math>, where <math id="Thmlemma11.p1.m6" class="ltx_Math" alttext="L_{\mathcal{L}}=O(L_{f}/\sigma^{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi class="ltx_font_mathcaligraphic">ℒ</mi></msub><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>f</mi></msub><mo>/</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">L_{\mathcal{L}}=O(L_{f}/\sigma^{2})</annotation></semantics></math>.</p>
</div>
</div>
<div id="A6.SS4.2.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A6.SS4.p6" class="ltx_para">
<p id="A6.SS4.p6.1" class="ltx_p"><span id="A6.SS4.p6.1.1" class="ltx_text">For Gaussian noise with variance <math id="A6.SS4.p6.m1" class="ltx_Math" alttext="\sigma^{2}" display="inline" intent=":literal"><semantics><msup><mi>σ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\sigma^{2}</annotation></semantics></math>, the conditional probability density is:</span></p>
<table id="A6.EGx19" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex86.m1" class="ltx_Math" alttext="\displaystyle P(\mathbf{s}_{i}(t+1)|\mathbf{s}_{\mathcal{N}_{i}}(t),\mathbf{a}_{i}(t),\boldsymbol{\omega})" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐬</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><mrow><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>𝝎</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle P(\mathbf{s}_{i}(t+1)|\mathbf{s}_{\mathcal{N}_{i}}(t),\mathbf{a}_{i}(t),\boldsymbol{\omega})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex87.m1" class="ltx_Math" alttext="\displaystyle=\prod_{j=1}^{d_{i}}\frac{1}{\sqrt{2\pi\sigma^{2}}}\exp\left(-\frac{(s_{i,j}(t+1)-f_{i,j}(\mathbf{c}_{\mathcal{N}_{i},j}^{s\rightarrow s}\odot\mathbf{s}_{\mathcal{N}_{i}}(t),\mathbf{c}_{i,j}^{a\rightarrow s}\cdot\mathbf{a}_{i}(t),\mathbf{c}_{i,j}^{\omega\rightarrow s}\odot\boldsymbol{\omega},0))^{2}}{2\sigma^{2}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>d</mi><mi>i</mi></msub></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></msqrt></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>𝐜</mi><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>,</mo><mi>j</mi></mrow><mrow><mi>s</mi><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">⊙</mo><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mrow><msubsup><mi>𝐜</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mi>a</mi><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝐚</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>𝐜</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mi>ω</mi><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">⊙</mo><mi>𝝎</mi></mrow><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\prod_{j=1}^{d_{i}}\frac{1}{\sqrt{2\pi\sigma^{2}}}\exp\left(-\frac{(s_{i,j}(t+1)-f_{i,j}(\mathbf{c}_{\mathcal{N}_{i},j}^{s\rightarrow s}\odot\mathbf{s}_{\mathcal{N}_{i}}(t),\mathbf{c}_{i,j}^{a\rightarrow s}\cdot\mathbf{a}_{i}(t),\mathbf{c}_{i,j}^{\omega\rightarrow s}\odot\boldsymbol{\omega},0))^{2}}{2\sigma^{2}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS4.p6.2" class="ltx_p"><span id="A6.SS4.p6.2.1" class="ltx_text">Taking the negative logarithm:</span></p>
<table id="A6.EGx20" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex88.m1" class="ltx_Math" alttext="\displaystyle-\log P(\mathbf{s}_{i}(t+1)|\mathbf{s}_{\mathcal{N}_{i}}(t),\mathbf{a}_{i}(t),\boldsymbol{\omega})" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐬</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><mrow><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>𝝎</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\log P(\mathbf{s}_{i}(t+1)|\mathbf{s}_{\mathcal{N}_{i}}(t),\mathbf{a}_{i}(t),\boldsymbol{\omega})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex89"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex89.m1" class="ltx_Math" alttext="\displaystyle=\sum_{j=1}^{d_{i}}\left[\frac{1}{2}\log(2\pi\sigma^{2})+\frac{(s_{i,j}(t+1)-f_{i,j}(\mathbf{c}_{\mathcal{N}_{i},j}^{s\rightarrow s}\odot\mathbf{s}_{\mathcal{N}_{i}}(t),\mathbf{c}_{i,j}^{a\rightarrow s}\cdot\mathbf{a}_{i}(t),\mathbf{c}_{i,j}^{\omega\rightarrow s}\odot\boldsymbol{\omega},0))^{2}}{2\sigma^{2}}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>d</mi><mi>i</mi></msub></munderover></mstyle><mrow><mo>[</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>𝐜</mi><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>,</mo><mi>j</mi></mrow><mrow><mi>s</mi><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">⊙</mo><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mrow><msubsup><mi>𝐜</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mi>a</mi><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝐚</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>𝐜</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mi>ω</mi><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">⊙</mo><mi>𝝎</mi></mrow><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{j=1}^{d_{i}}\left[\frac{1}{2}\log(2\pi\sigma^{2})+\frac{(s_{i,j}(t+1)-f_{i,j}(\mathbf{c}_{\mathcal{N}_{i},j}^{s\rightarrow s}\odot\mathbf{s}_{\mathcal{N}_{i}}(t),\mathbf{c}_{i,j}^{a\rightarrow s}\cdot\mathbf{a}_{i}(t),\mathbf{c}_{i,j}^{\omega\rightarrow s}\odot\boldsymbol{\omega},0))^{2}}{2\sigma^{2}}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.SS4.p7" class="ltx_para">
<p id="A6.SS4.p7.1" class="ltx_p"><span id="A6.SS4.p7.1.1" class="ltx_text">The gradient with respect to <math id="A6.SS4.p7.m1" class="ltx_Math" alttext="\boldsymbol{\omega}" display="inline" intent=":literal"><semantics><mi>𝝎</mi><annotation encoding="application/x-tex">\boldsymbol{\omega}</annotation></semantics></math> is:</span></p>
<table id="A6.Ex90" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex90.m1" class="ltx_math_unparsed" alttext="\nabla_{\boldsymbol{\omega}}[-\log P(\mathbf{s}_{i}(t+1)|\mathbf{s}_{\mathcal{N}_{i}}(t),\mathbf{a}_{i}(t),\boldsymbol{\omega})]=-\sum_{j=1}^{d_{i}}\frac{(s_{i,j}(t+1)-f_{i,j})}{\sigma^{2}}\nabla_{\boldsymbol{\omega}}f_{i,j}." display="block" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>𝝎</mi></msub><mrow><mo stretchy="false">[</mo><mo lspace="0em">−</mo><mi>log</mi><mi>P</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝐚</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>𝝎</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em" rspace="0.055em">−</mo><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>d</mi><mi>i</mi></msub></munderover><mfrac><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>f</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><msup><mi>σ</mi><mn>2</mn></msup></mfrac><msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>𝝎</mi></msub><msub><mi>f</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\nabla_{\boldsymbol{\omega}}[-\log P(\mathbf{s}_{i}(t+1)|\mathbf{s}_{\mathcal{N}_{i}}(t),\mathbf{a}_{i}(t),\boldsymbol{\omega})]=-\sum_{j=1}^{d_{i}}\frac{(s_{i,j}(t+1)-f_{i,j})}{\sigma^{2}}\nabla_{\boldsymbol{\omega}}f_{i,j}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.SS4.p8" class="ltx_para">
<p id="A6.SS4.p8.1" class="ltx_p"><span id="A6.SS4.p8.1.1" class="ltx_text">Since <math id="A6.SS4.p8.m1" class="ltx_Math" alttext="f_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">f_{i,j}</annotation></semantics></math> is <math id="A6.SS4.p8.m2" class="ltx_Math" alttext="L_{f}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>f</mi></msub><annotation encoding="application/x-tex">L_{f}</annotation></semantics></math>-Lipschitz and <math id="A6.SS4.p8.m3" class="ltx_Math" alttext="\|\nabla_{\boldsymbol{\omega}}f_{i,j}\|\leq L_{f}\|\mathbf{c}_{i,j}^{\omega\rightarrow s}\|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>𝝎</mi></msub><msub><mi>f</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mrow><msub><mi>L</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><msubsup><mi>𝐜</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mi>ω</mi><mo stretchy="false">→</mo><mi>s</mi></mrow></msubsup><mo stretchy="false">‖</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\|\nabla_{\boldsymbol{\omega}}f_{i,j}\|\leq L_{f}\|\mathbf{c}_{i,j}^{\omega\rightarrow s}\|</annotation></semantics></math>, we have:</span></p>
<table id="A6.Ex91" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex91.m1" class="ltx_Math" alttext="\|\nabla_{\boldsymbol{\omega}}[-\log P(\mathbf{s}_{i}(t+1)|\mathbf{s}_{\mathcal{N}_{i}}(t),\mathbf{a}_{i}(t),\boldsymbol{\omega})]\|\leq\frac{d_{i}L_{f}B}{\sigma^{2}}=\mathcal{O}\left(\frac{L_{f}}{\sigma^{2}}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mo>∇</mo><mi>𝝎</mi></msub><mrow><mo stretchy="false">[</mo><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐬</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><mrow><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>𝝎</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mfrac><mrow><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><msup><mi>σ</mi><mn>2</mn></msup></mfrac><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><msub><mi>L</mi><mi>f</mi></msub><msup><mi>σ</mi><mn>2</mn></msup></mfrac><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\nabla_{\boldsymbol{\omega}}[-\log P(\mathbf{s}_{i}(t+1)|\mathbf{s}_{\mathcal{N}_{i}}(t),\mathbf{a}_{i}(t),\boldsymbol{\omega})]\|\leq\frac{d_{i}L_{f}B}{\sigma^{2}}=\mathcal{O}\left(\frac{L_{f}}{\sigma^{2}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.SS4.p9" class="ltx_para">
<p id="A6.SS4.p9.1" class="ltx_p"><span id="A6.SS4.p9.1.1" class="ltx_text">Therefore, <math id="A6.SS4.p9.m1" class="ltx_Math" alttext="\mathcal{L}_{i}(\boldsymbol{\omega})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝝎</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{i}(\boldsymbol{\omega})</annotation></semantics></math> is <math id="A6.SS4.p9.m2" class="ltx_Math" alttext="L_{\mathcal{L}}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi class="ltx_font_mathcaligraphic">ℒ</mi></msub><annotation encoding="application/x-tex">L_{\mathcal{L}}</annotation></semantics></math>-Lipschitz continuous with <math id="A6.SS4.p9.m3" class="ltx_Math" alttext="L_{\mathcal{L}}=\mathcal{O}(L_{f}/\sigma^{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi class="ltx_font_mathcaligraphic">ℒ</mi></msub><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>f</mi></msub><mo>/</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">L_{\mathcal{L}}=\mathcal{O}(L_{f}/\sigma^{2})</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="Thmlemma12" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma12.2" class="ltx_text ltx_font_bold">Lemma 12</span></span><span id="Thmlemma12.3" class="ltx_text ltx_font_bold"> </span>(Strong convexity of expected negative log-likelihood)<span id="Thmlemma12.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma12.p1" class="ltx_para">
<p id="Thmlemma12.p1.1" class="ltx_p">Under the identifiability assumption and the total variation distance condition, the expected negative log-likelihood <math id="Thmlemma12.p1.m1" class="ltx_Math" alttext="\E[\mathcal{L}_{i}(\boldsymbol{\omega})]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝝎</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\E[\mathcal{L}_{i}(\boldsymbol{\omega})]</annotation></semantics></math> is <math id="Thmlemma12.p1.m2" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math>-strongly convex in a neighborhood of the true domain factor <math id="Thmlemma12.p1.m3" class="ltx_Math" alttext="\boldsymbol{\omega}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝝎</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\boldsymbol{\omega}^{*}</annotation></semantics></math>, where <math id="Thmlemma12.p1.m4" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math> depends on <math id="Thmlemma12.p1.m5" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> and the minimum eigenvalue of the Fisher information matrix.</p>
</div>
</div>
<div id="A6.SS4.2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A6.SS4.p10" class="ltx_para">
<p id="A6.SS4.p10.1" class="ltx_p"><span id="A6.SS4.p10.1.1" class="ltx_text">The expected negative log-likelihood is:</span></p>
<table id="A6.Ex92" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex92.m1" class="ltx_Math" alttext="\E[\mathcal{L}_{i}(\boldsymbol{\omega})]=-\E_{\mathbf{s}_{\mathcal{N}_{i}},\mathbf{a}_{i},\mathbf{s}_{i}(t+1)}[\log P(\mathbf{s}_{i}(t+1)|\mathbf{s}_{\mathcal{N}_{i}}(t),\mathbf{a}_{i}(t),\boldsymbol{\omega})]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝝎</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mo rspace="0.167em">−</mo><mrow><msub><mi>𝔼</mi><mrow><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo>,</mo><msub><mi>𝐚</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>𝐬</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐬</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><mrow><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>𝝎</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\E[\mathcal{L}_{i}(\boldsymbol{\omega})]=-\E_{\mathbf{s}_{\mathcal{N}_{i}},\mathbf{a}_{i},\mathbf{s}_{i}(t+1)}[\log P(\mathbf{s}_{i}(t+1)|\mathbf{s}_{\mathcal{N}_{i}}(t),\mathbf{a}_{i}(t),\boldsymbol{\omega})].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.SS4.p11" class="ltx_para">
<p id="A6.SS4.p11.1" class="ltx_p"><span id="A6.SS4.p11.1.1" class="ltx_text">The Hessian matrix of this function is the Fisher information matrix:</span></p>
<table id="A6.Ex93" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex93.m1" class="ltx_Math" alttext="H(\boldsymbol{\omega})=\E_{\mathbf{s}_{\mathcal{N}_{i}},\mathbf{a}_{i}}\left[\E_{\mathbf{s}_{i}(t+1)|\mathbf{s}_{\mathcal{N}_{i}},\mathbf{a}_{i},\boldsymbol{\omega}^{*}}\left[\nabla_{\boldsymbol{\omega}}\log P(\mathbf{s}_{i}(t+1)|\mathbf{s}_{\mathcal{N}_{i}},\mathbf{a}_{i},\boldsymbol{\omega})\nabla_{\boldsymbol{\omega}}\log P(\mathbf{s}_{i}(t+1)|\mathbf{s}_{\mathcal{N}_{i}},\mathbf{a}_{i},\boldsymbol{\omega})^{T}\right]\right]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝝎</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo>,</mo><msub><mi>𝐚</mi><mi>i</mi></msub></mrow></msub><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>𝔼</mi><mrow><mrow><msub><mi>𝐬</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo fence="false">|</mo><mrow><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo>,</mo><msub><mi>𝐚</mi><mi>i</mi></msub><mo>,</mo><msup><mi>𝝎</mi><mo>∗</mo></msup></mrow></mrow></msub><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mo>∇</mo><mi>𝝎</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐬</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo>,</mo><msub><mi>𝐚</mi><mi>i</mi></msub><mo>,</mo><mi>𝝎</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><msub><mo>∇</mo><mi>𝝎</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐬</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></msub><mo>,</mo><msub><mi>𝐚</mi><mi>i</mi></msub><mo>,</mo><mi>𝝎</mi></mrow><mo stretchy="false">)</mo></mrow><mi>T</mi></msup></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H(\boldsymbol{\omega})=\E_{\mathbf{s}_{\mathcal{N}_{i}},\mathbf{a}_{i}}\left[\E_{\mathbf{s}_{i}(t+1)|\mathbf{s}_{\mathcal{N}_{i}},\mathbf{a}_{i},\boldsymbol{\omega}^{*}}\left[\nabla_{\boldsymbol{\omega}}\log P(\mathbf{s}_{i}(t+1)|\mathbf{s}_{\mathcal{N}_{i}},\mathbf{a}_{i},\boldsymbol{\omega})\nabla_{\boldsymbol{\omega}}\log P(\mathbf{s}_{i}(t+1)|\mathbf{s}_{\mathcal{N}_{i}},\mathbf{a}_{i},\boldsymbol{\omega})^{T}\right]\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.SS4.p12" class="ltx_para">
<p id="A6.SS4.p12.1" class="ltx_p"><span id="A6.SS4.p12.1.1" class="ltx_text">By the identifiability assumption and the total variation distance condition, for any unit vector <math id="A6.SS4.p12.m1" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math>, we have:</span></p>
<table id="A6.Ex94" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex94.m1" class="ltx_Math" alttext="v^{T}H(\boldsymbol{\omega}^{*})v\geq\alpha^{2}&gt;0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>v</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝎</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>≥</mo><msup><mi>α</mi><mn>2</mn></msup><mo>&gt;</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">v^{T}H(\boldsymbol{\omega}^{*})v\geq\alpha^{2}&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.SS4.p13" class="ltx_para">
<p id="A6.SS4.p13.1" class="ltx_p"><span id="A6.SS4.p13.1.1" class="ltx_text">Therefore, in a neighborhood of <math id="A6.SS4.p13.m1" class="ltx_Math" alttext="\boldsymbol{\omega}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝝎</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\boldsymbol{\omega}^{*}</annotation></semantics></math>, the expected negative log-likelihood is <math id="A6.SS4.p13.m2" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math>-strongly convex with <math id="A6.SS4.p13.m3" class="ltx_Math" alttext="\mu\geq\alpha^{2}" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>≥</mo><msup><mi>α</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\mu\geq\alpha^{2}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A6.SS4.p14" class="ltx_para">
<p id="A6.SS4.p14.1" class="ltx_p"><span id="A6.SS4.p14.1.1" class="ltx_text">Now, we can analyze the estimation error using concentration inequalities for empirical processes. Let:</span></p>
<table id="A6.Ex95" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex95.m1" class="ltx_Math" alttext="\mathcal{L}(\boldsymbol{\omega})=\frac{1}{n}\sum_{i=1}^{n}\mathcal{L}_{i}(\boldsymbol{\omega})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝝎</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝝎</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}(\boldsymbol{\omega})=\frac{1}{n}\sum_{i=1}^{n}\mathcal{L}_{i}(\boldsymbol{\omega}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="Thmproposition13" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmproposition13.2" class="ltx_text ltx_font_bold">Proposition 13</span></span><span id="Thmproposition13.3" class="ltx_text ltx_font_bold"> </span>(Uniform convergence)<span id="Thmproposition13.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmproposition13.p1" class="ltx_para">
<p id="Thmproposition13.p1.1" class="ltx_p">With probability at least <math id="Thmproposition13.p1.m1" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>, for all <math id="Thmproposition13.p1.m2" class="ltx_Math" alttext="\boldsymbol{\omega}\in\Omega" display="inline" intent=":literal"><semantics><mrow><mi>𝝎</mi><mo>∈</mo><mi mathvariant="normal">Ω</mi></mrow><annotation encoding="application/x-tex">\boldsymbol{\omega}\in\Omega</annotation></semantics></math>:</p>
<table id="A6.Ex96" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex96.m1" class="ltx_Math" alttext="|\mathcal{L}(\boldsymbol{\omega})-\E[\mathcal{L}(\boldsymbol{\omega})]|\leq C\sqrt{\frac{D_{\Omega}\log(T_{e}/\delta)}{T_{e}}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝝎</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝝎</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><msub><mi>D</mi><mi mathvariant="normal">Ω</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>e</mi></msub><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msub><mi>T</mi><mi>e</mi></msub></mfrac></msqrt></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">|\mathcal{L}(\boldsymbol{\omega})-\E[\mathcal{L}(\boldsymbol{\omega})]|\leq C\sqrt{\frac{D_{\Omega}\log(T_{e}/\delta)}{T_{e}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmproposition13.p1.2" class="ltx_p">where <math id="Thmproposition13.p1.m3" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> is a constant depending on <math id="Thmproposition13.p1.m4" class="ltx_Math" alttext="L_{\mathcal{L}}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi class="ltx_font_mathcaligraphic">ℒ</mi></msub><annotation encoding="application/x-tex">L_{\mathcal{L}}</annotation></semantics></math> and <math id="Thmproposition13.p1.m5" class="ltx_Math" alttext="D_{\Omega}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi mathvariant="normal">Ω</mi></msub><annotation encoding="application/x-tex">D_{\Omega}</annotation></semantics></math>.</p>
</div>
</div>
<div id="A6.SS4.2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A6.SS4.p15" class="ltx_para">
<p id="A6.SS4.p15.1" class="ltx_p"><span id="A6.SS4.p15.1.1" class="ltx_text">Since <math id="A6.SS4.p15.m1" class="ltx_Math" alttext="\mathcal{L}_{i}(\boldsymbol{\omega})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝝎</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{i}(\boldsymbol{\omega})</annotation></semantics></math> is <math id="A6.SS4.p15.m2" class="ltx_Math" alttext="L_{\mathcal{L}}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi class="ltx_font_mathcaligraphic">ℒ</mi></msub><annotation encoding="application/x-tex">L_{\mathcal{L}}</annotation></semantics></math>-Lipschitz continuous, we can use covering number arguments. The <math id="A6.SS4.p15.m3" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>-covering number of the domain factor space <math id="A6.SS4.p15.m4" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math> with diameter <math id="A6.SS4.p15.m5" class="ltx_Math" alttext="D_{\Omega}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi mathvariant="normal">Ω</mi></msub><annotation encoding="application/x-tex">D_{\Omega}</annotation></semantics></math> is <math id="A6.SS4.p15.m6" class="ltx_Math" alttext="N(\Omega,\epsilon)\leq(1+\frac{D_{\Omega}}{\epsilon})^{D_{\Omega}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ω</mi><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mfrac><msub><mi>D</mi><mi mathvariant="normal">Ω</mi></msub><mi>ϵ</mi></mfrac></mrow><mo stretchy="false">)</mo></mrow><msub><mi>D</mi><mi mathvariant="normal">Ω</mi></msub></msup></mrow><annotation encoding="application/x-tex">N(\Omega,\epsilon)\leq(1+\frac{D_{\Omega}}{\epsilon})^{D_{\Omega}}</annotation></semantics></math>.</span></p>
</div>
<div id="A6.SS4.p16" class="ltx_para">
<p id="A6.SS4.p16.1" class="ltx_p"><span id="A6.SS4.p16.1.1" class="ltx_text">By the union bound over an <math id="A6.SS4.p16.m1" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>-net and Hoeffding’s inequality, we have:</span></p>
<table id="A6.Ex97" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex97.m1" class="ltx_Math" alttext="P\left(\sup_{\boldsymbol{\omega}\in\Omega}|\mathcal{L}(\boldsymbol{\omega})-\E[\mathcal{L}(\boldsymbol{\omega})]|&gt;\epsilon\right)\leq 2N(\Omega,\frac{\epsilon}{2L_{\mathcal{L}}})\exp\left(-\frac{2T_{e}\epsilon^{2}}{B_{\mathcal{L}}^{2}}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>𝝎</mi><mo>∈</mo><mi mathvariant="normal">Ω</mi></mrow></munder><mrow><mo stretchy="false">|</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝝎</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝝎</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>&gt;</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ω</mi><mo>,</mo><mfrac><mi>ϵ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi class="ltx_font_mathcaligraphic">ℒ</mi></msub></mrow></mfrac><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup></mrow><msubsup><mi>B</mi><mi class="ltx_font_mathcaligraphic">ℒ</mi><mn>2</mn></msubsup></mfrac></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P\left(\sup_{\boldsymbol{\omega}\in\Omega}|\mathcal{L}(\boldsymbol{\omega})-\E[\mathcal{L}(\boldsymbol{\omega})]|&gt;\epsilon\right)\leq 2N(\Omega,\frac{\epsilon}{2L_{\mathcal{L}}})\exp\left(-\frac{2T_{e}\epsilon^{2}}{B_{\mathcal{L}}^{2}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS4.p16.2" class="ltx_p"><span id="A6.SS4.p16.2.1" class="ltx_text">where <math id="A6.SS4.p16.m2" class="ltx_Math" alttext="B_{\mathcal{L}}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi class="ltx_font_mathcaligraphic">ℒ</mi></msub><annotation encoding="application/x-tex">B_{\mathcal{L}}</annotation></semantics></math> is the bound on the negative log-likelihood function. Setting the right-hand side to <math id="A6.SS4.p16.m3" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> and solving for <math id="A6.SS4.p16.m4" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>, we get:</span></p>
<table id="A6.Ex98" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex98.m1" class="ltx_Math" alttext="\epsilon=\mathcal{O}\left(\sqrt{\frac{D_{\Omega}\log(T_{e}/\delta)}{T_{e}}}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mi>ϵ</mi><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msqrt><mfrac><mrow><msub><mi>D</mi><mi mathvariant="normal">Ω</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>e</mi></msub><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msub><mi>T</mi><mi>e</mi></msub></mfrac></msqrt><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\epsilon=\mathcal{O}\left(\sqrt{\frac{D_{\Omega}\log(T_{e}/\delta)}{T_{e}}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS4.p16.3" class="ltx_p"><span id="A6.SS4.p16.3.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A6.SS4.p17" class="ltx_para">
<p id="A6.SS4.p17.1" class="ltx_p"><span id="A6.SS4.p17.1.1" class="ltx_text ltx_font_bold">Step 3: Deriving the sample complexity bound.<span id="A6.SS4.p17.1.1.1" class="ltx_text ltx_font_medium"> By combining the strong convexity of <math id="A6.SS4.p17.m1" class="ltx_Math" alttext="\E[\mathcal{L}(\boldsymbol{\omega})]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝝎</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\E[\mathcal{L}(\boldsymbol{\omega})]</annotation></semantics></math> and the uniform convergence bound, we can derive the estimation error. For the true domain factor <math id="A6.SS4.p17.m2" class="ltx_Math" alttext="\boldsymbol{\omega}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝝎</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\boldsymbol{\omega}^{*}</annotation></semantics></math> and the estimated domain factor <math id="A6.SS4.p17.m3" class="ltx_Math" alttext="\hat{\boldsymbol{\omega}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\boldsymbol{\omega}}</annotation></semantics></math>, we have:</span></span></p>
<table id="A6.Ex99" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex99.m1" class="ltx_Math" alttext="\mathcal{L}(\hat{\boldsymbol{\omega}})\leq\mathcal{L}(\boldsymbol{\omega}^{*})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝎</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}(\hat{\boldsymbol{\omega}})\leq\mathcal{L}(\boldsymbol{\omega}^{*}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS4.p17.2" class="ltx_p"><span id="A6.SS4.p17.2.1" class="ltx_text">This implies:</span></p>
<table id="A6.EGx21" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex100"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex100.m1" class="ltx_Math" alttext="\displaystyle\E[\mathcal{L}(\hat{\boldsymbol{\omega}})]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\E[\mathcal{L}(\hat{\boldsymbol{\omega}})]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex100.m2" class="ltx_Math" alttext="\displaystyle\leq\mathcal{L}(\hat{\boldsymbol{\omega}})+\epsilon\leq\mathcal{L}(\boldsymbol{\omega}^{*})+\epsilon\leq\E[\mathcal{L}(\boldsymbol{\omega}^{*})]+2\epsilon." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>ϵ</mi></mrow><mo>≤</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝎</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>ϵ</mi></mrow><mo>≤</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝎</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathcal{L}(\hat{\boldsymbol{\omega}})+\epsilon\leq\mathcal{L}(\boldsymbol{\omega}^{*})+\epsilon\leq\E[\mathcal{L}(\boldsymbol{\omega}^{*})]+2\epsilon.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS4.p17.3" class="ltx_p"><span id="A6.SS4.p17.3.1" class="ltx_text">By the strong convexity of <math id="A6.SS4.p17.m4" class="ltx_Math" alttext="\E[\mathcal{L}(\boldsymbol{\omega})]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝝎</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\E[\mathcal{L}(\boldsymbol{\omega})]</annotation></semantics></math>, we have:</span></p>
<table id="A6.Ex101" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex101.m1" class="ltx_Math" alttext="\E[\mathcal{L}(\hat{\boldsymbol{\omega}})]-\E[\mathcal{L}(\boldsymbol{\omega}^{*})]\geq\frac{\mu}{2}\|\hat{\boldsymbol{\omega}}-\boldsymbol{\omega}^{*}\|_{2}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝎</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>≥</mo><mrow><mfrac><mi>μ</mi><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mo>−</mo><msup><mi>𝝎</mi><mo>∗</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\E[\mathcal{L}(\hat{\boldsymbol{\omega}})]-\E[\mathcal{L}(\boldsymbol{\omega}^{*})]\geq\frac{\mu}{2}\|\hat{\boldsymbol{\omega}}-\boldsymbol{\omega}^{*}\|_{2}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS4.p17.4" class="ltx_p"><span id="A6.SS4.p17.4.1" class="ltx_text">Combining these inequalities:</span></p>
<table id="A6.Ex102" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex102.m1" class="ltx_Math" alttext="\frac{\mu}{2}\|\hat{\boldsymbol{\omega}}-\boldsymbol{\omega}^{*}\|_{2}^{2}\leq 2\epsilon=O\left(\sqrt{\frac{D_{\Omega}\log(T_{e}/\delta)}{T_{e}}}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mi>μ</mi><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mo>−</mo><msup><mi>𝝎</mi><mo>∗</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><msqrt><mfrac><mrow><msub><mi>D</mi><mi mathvariant="normal">Ω</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>e</mi></msub><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msub><mi>T</mi><mi>e</mi></msub></mfrac></msqrt><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\mu}{2}\|\hat{\boldsymbol{\omega}}-\boldsymbol{\omega}^{*}\|_{2}^{2}\leq 2\epsilon=O\left(\sqrt{\frac{D_{\Omega}\log(T_{e}/\delta)}{T_{e}}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS4.p17.5" class="ltx_p"><span id="A6.SS4.p17.5.1" class="ltx_text">Therefore:</span></p>
<table id="A6.Ex103" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex103.m1" class="ltx_Math" alttext="\|\hat{\boldsymbol{\omega}}-\boldsymbol{\omega}^{*}\|_{2}\leq O\left(\sqrt{\frac{D_{\Omega}\log(T_{e}/\delta)}{\mu T_{e}}}\right)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mo>−</mo><msup><mi>𝝎</mi><mo>∗</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><msqrt><mfrac><mrow><msub><mi>D</mi><mi mathvariant="normal">Ω</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>e</mi></msub><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>e</mi></msub></mrow></mfrac></msqrt><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\hat{\boldsymbol{\omega}}-\boldsymbol{\omega}^{*}\|_{2}\leq O\left(\sqrt{\frac{D_{\Omega}\log(T_{e}/\delta)}{\mu T_{e}}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS4.p17.6" class="ltx_p"><span id="A6.SS4.p17.6.1" class="ltx_text">Now, accounting for the fact that we have <math id="A6.SS4.p17.m5" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> agents, we apply a union bound across all agents by replacing <math id="A6.SS4.p17.m6" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> with <math id="A6.SS4.p17.m7" class="ltx_Math" alttext="\delta/n" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>/</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">\delta/n</annotation></semantics></math>. This gives us:</span></p>
<table id="A6.Ex104" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex104.m1" class="ltx_Math" alttext="\|\hat{\boldsymbol{\omega}}-\boldsymbol{\omega}^{*}\|_{2}\leq C_{\boldsymbol{\omega}}\sqrt{\frac{D_{\Omega}\log(nT_{e}/\delta)}{T_{e}}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mo>−</mo><msup><mi>𝝎</mi><mo>∗</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><msub><mi>C</mi><mi>𝝎</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><msub><mi>D</mi><mi mathvariant="normal">Ω</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>e</mi></msub></mrow><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msub><mi>T</mi><mi>e</mi></msub></mfrac></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\hat{\boldsymbol{\omega}}-\boldsymbol{\omega}^{*}\|_{2}\leq C_{\boldsymbol{\omega}}\sqrt{\frac{D_{\Omega}\log(nT_{e}/\delta)}{T_{e}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS4.p17.7" class="ltx_p"><span id="A6.SS4.p17.7.1" class="ltx_text">with probability at least <math id="A6.SS4.p17.m8" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>, where <math id="A6.SS4.p17.m9" class="ltx_Math" alttext="C_{\boldsymbol{\omega}}=O(1/\sqrt{\mu})=O(1/\alpha)" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>𝝎</mi></msub><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><msqrt><mi>μ</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C_{\boldsymbol{\omega}}=O(1/\sqrt{\mu})=O(1/\alpha)</annotation></semantics></math> is a constant depending on the problem parameters. This completes the proof of the theorem, providing a rigorous guarantee on the accuracy of domain factor estimation based on the trajectory length <math id="A6.SS4.p17.m10" class="ltx_Math" alttext="T_{e}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>e</mi></msub><annotation encoding="application/x-tex">T_{e}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="A7" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix G </span>Missing proofs in Section <a href="#S6" title="6 Convergence results and adaptation gap ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a></h2>

<section id="A7.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">G.1 </span>Discussions on Assumption <a href="#Thmassumption1" title="Assumption 1. ‣ 6.1 Convergence ‣ 6 Convergence results and adaptation gap ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>-<a href="#Thmassumption6" title="Assumption 6. ‣ 6.1 Convergence ‣ 6 Convergence results and adaptation gap ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a></h3>

<div id="A7.SS1.p1" class="ltx_para">
<p id="A7.SS1.p1.1" class="ltx_p">While Assumption <a href="#Thmassumption1" title="Assumption 1. ‣ 6.1 Convergence ‣ 6 Convergence results and adaptation gap ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>-<a href="#Thmassumption6" title="Assumption 6. ‣ 6.1 Convergence ‣ 6 Convergence results and adaptation gap ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> are standard for establishing theoretical guarantees, we discuss whether they hold exactly in practice as follows.</p>
</div>
<div id="A7.SS1.p2" class="ltx_para">
<p id="A7.SS1.p2.1" class="ltx_p">Finite MDP (Assumption <a href="#Thmassumption1" title="Assumption 1. ‣ 6.1 Convergence ‣ 6 Convergence results and adaptation gap ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>): in some systems, the state or action spaces might not finite or continuous. For such cases, our results can still extend by applying state aggregation or clipping methods to ensure boundedness while incurring small approximation error.</p>
</div>
<div id="A7.SS1.p3" class="ltx_para">
<p id="A7.SS1.p3.1" class="ltx_p">Mixing properties (Assumption <a href="#Thmassumption2" title="Assumption 2. ‣ 6.1 Convergence ‣ 6 Convergence results and adaptation gap ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>): real-world networked systems may exhibit slow mixing or non-Lipschitz dynamics. Our theoretical results would degrade gracefully, leading to larger constants <math id="A7.SS1.p3.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> in the sample complexity bounds.</p>
</div>
<div id="A7.SS1.p4" class="ltx_para">
<p id="A7.SS1.p4.1" class="ltx_p">Smoothness (Assumption <a href="#Thmassumption3" title="Assumption 3. ‣ 6.1 Convergence ‣ 6 Convergence results and adaptation gap ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>): the assumption requires the policy gradients <math id="A7.SS1.p4.m1" class="ltx_Math" alttext="\nabla_{\theta_{i}}\log\pi_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><msub><mi>θ</mi><mi>i</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>π</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\nabla_{\theta_{i}}\log\pi_{i}</annotation></semantics></math> to be Lipschitz and uniformly bounded. This holds for all commonly used policy parameterizations (e.g., softmax policies) with bounded inputs and finite-dimensional parameter vectors. It ensures stable policy updates and is common in the convergence analysis of policy gradient and actor-critic algorithms. <span id="A7.SS1.p4.1.1" class="ltx_text ltx_markedasmath ltx_font_typewriter">GSAC</span> uses softmax parameterizations for policies, where <math id="A7.SS1.p4.m3" class="ltx_Math" alttext="\log\pi_{\theta_{i}}" display="inline" intent=":literal"><semantics><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><msub><mi>θ</mi><mi>i</mi></msub></msub></mrow><annotation encoding="application/x-tex">\log\pi_{\theta_{i}}</annotation></semantics></math> is smooth and has bounded gradients when action probabilities are not close to zero (a condition satisfied by entropy regularization or initialization).</p>
</div>
<div id="A7.SS1.p5" class="ltx_para">
<p id="A7.SS1.p5.1" class="ltx_p">Compact parameter space (Assumption <a href="#Thmassumption4" title="Assumption 4. ‣ 6.1 Convergence ‣ 6 Convergence results and adaptation gap ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>): policy parameters <math id="A7.SS1.p5.m1" class="ltx_Math" alttext="\theta_{i}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\theta_{i}</annotation></semantics></math> are always constrained within a finite range due to neural network weight regularization, weight clipping, or bounded initialization. This is standard in actor-critic methods, where optimization is performed with bounded learning rates and regularizer that implicitly keep the parameters within a compact set.</p>
</div>
<div id="A7.SS1.p6" class="ltx_para">
<p id="A7.SS1.p6.1" class="ltx_p">Smoothness w.r.t. domain factor (Assumption <a href="#Thmassumption5" title="Assumption 5. ‣ 6.1 Convergence ‣ 6 Convergence results and adaptation gap ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>): this is reasonable because domain factors, e.g., channel gains, traffic loads, represent physical parameters that vary smoothly. The local dynamics <math id="A7.SS1.p6.m1" class="ltx_Math" alttext="P_{i}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>i</mi></msub><annotation encoding="application/x-tex">P_{i}</annotation></semantics></math> are typically analytic or polynomial in <math id="A7.SS1.p6.m2" class="ltx_Math" alttext="\omega_{i}" display="inline" intent=":literal"><semantics><msub><mi>ω</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\omega_{i}</annotation></semantics></math>, so small perturbations in <math id="A7.SS1.p6.m3" class="ltx_Math" alttext="\omega_{i}" display="inline" intent=":literal"><semantics><msub><mi>ω</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\omega_{i}</annotation></semantics></math> induce proportionally small changes in state transitions and rewards. Consequently, the Q-function <math id="A7.SS1.p6.m4" class="ltx_Math" alttext="Q^{\pi}_{i}(s,a,\omega)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Q</mi><mi>i</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>a</mi><mo>,</mo><mi>ω</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Q^{\pi}_{i}(s,a,\omega)</annotation></semantics></math> and policy gradient <math id="A7.SS1.p6.m5" class="ltx_Math" alttext="\nabla_{\theta_{i}}J(\theta,\omega)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><msub><mi>θ</mi><mi>i</mi></msub></msub><mi>J</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>ω</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\theta_{i}}J(\theta,\omega)</annotation></semantics></math> inherit this smoothness. Moreover, standard policy parameterizations and neural network approximators are Lipschitz when combined with bounded weights or gradient clipping. Thus, Assumption <a href="#Thmassumption5" title="Assumption 5. ‣ 6.1 Convergence ‣ 6 Convergence results and adaptation gap ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> aligns well with both the structure of real-world systems and common RL practices. Moreover, even if the true dynamics were not strictly Lipschitz, domain factor estimation (Proposition 5) uses a small-perturbation assumption around <math id="A7.SS1.p6.m6" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math> for adaptation. In practice, state or reward clipping and function approximation, which are inherently Lipschitz, effectively enforce this assumption.</p>
</div>
<div id="A7.SS1.p7" class="ltx_para">
<p id="A7.SS1.p7.1" class="ltx_p">Compact domain factor space (Assumption <a href="#Thmassumption6" title="Assumption 6. ‣ 6.1 Convergence ‣ 6 Convergence results and adaptation gap ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>): the latent domain factors <math id="A7.SS1.p7.m1" class="ltx_Math" alttext="\omega_{i}" display="inline" intent=":literal"><semantics><msub><mi>ω</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\omega_{i}</annotation></semantics></math> represent bounded variations in environment dynamics (e.g., channel gains, traffic intensities, or reward scaling factors), which are inherently limited by the physical system. In real-world networked systems, these factors are naturally confined to finite ranges determined by system design (e.g., transmission powers, queue lengths). Hence, assuming <math id="A7.SS1.p7.m2" class="ltx_Math" alttext="\Omega_{i}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ω</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\Omega_{i}</annotation></semantics></math> is compact with bounded diameter <math id="A7.SS1.p7.m3" class="ltx_Math" alttext="D_{\Omega}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi mathvariant="normal">Ω</mi></msub><annotation encoding="application/x-tex">D_{\Omega}</annotation></semantics></math> is both reasonable and practical.</p>
</div>
<div id="A7.SS1.p8" class="ltx_para">
<p id="A7.SS1.p8.1" class="ltx_p">For simplicity, we also write <math id="A7.SS1.p8.m1" class="ltx_Math" alttext="Q^{\boldsymbol{\omega}}:=Q(\cdot,\cdot,\boldsymbol{\omega})" display="inline" intent=":literal"><semantics><mrow><msup><mi>Q</mi><mi>𝝎</mi></msup><mo>:=</mo><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>𝝎</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Q^{\boldsymbol{\omega}}:=Q(\cdot,\cdot,\boldsymbol{\omega})</annotation></semantics></math> and <math id="A7.SS1.p8.m2" class="ltx_Math" alttext="\mathbf{z}:=(\mathbf{s},\mathbf{a})" display="inline" intent=":literal"><semantics><mrow><mi>𝐳</mi><mo>:=</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{z}:=(\mathbf{s},\mathbf{a})</annotation></semantics></math>.</p>
</div>
</section>
<section id="A7.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">G.2 </span>Proof of Theorem <a href="#Thmtheorem2" title="Theorem 2 (Critic error bound, informal). ‣ Critic error bound. ‣ 6.1 Convergence ‣ 6 Convergence results and adaptation gap ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a></h3>

<div id="Thmtheorem5" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem5.2" class="ltx_text ltx_font_bold">Theorem 5</span></span><span id="Thmtheorem5.3" class="ltx_text ltx_font_bold"> </span>(Critic error bound)<span id="Thmtheorem5.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem5.p1" class="ltx_para">
<p id="Thmtheorem5.p1.1" class="ltx_p">Under Assumptions <a href="#Thmassumption1" title="Assumption 1. ‣ 6.1 Convergence ‣ 6 Convergence results and adaptation gap ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>-<a href="#Thmassumption6" title="Assumption 6. ‣ 6.1 Convergence ‣ 6 Convergence results and adaptation gap ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>, suppose the critic stepsize <math id="Thmtheorem5.p1.m1" class="ltx_Math" alttext="\alpha_{t}=\frac{h}{t+t_{0}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>t</mi></msub><mo>=</mo><mfrac><mi>h</mi><mrow><mi>t</mi><mo>+</mo><msub><mi>t</mi><mn>0</mn></msub></mrow></mfrac></mrow><annotation encoding="application/x-tex">\alpha_{t}=\frac{h}{t+t_{0}}</annotation></semantics></math> satisfies <math id="Thmtheorem5.p1.m2" class="ltx_Math" alttext="h\geq\frac{1}{\sigma}\max(2,\frac{1}{1-\sqrt{\gamma}})" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>≥</mo><mrow><mfrac><mn>1</mn><mi>σ</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msqrt><mi>γ</mi></msqrt></mrow></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">h\geq\frac{1}{\sigma}\max(2,\frac{1}{1-\sqrt{\gamma}})</annotation></semantics></math>, <math id="Thmtheorem5.p1.m3" class="ltx_Math" alttext="t_{0}\geq\max(2h,4\sigma h,\tau)" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>≥</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo>,</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo>,</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t_{0}\geq\max(2h,4\sigma h,\tau)</annotation></semantics></math>, and the domain factors are estimated with <math id="Thmtheorem5.p1.m4" class="ltx_Math" alttext="T_{e}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>e</mi></msub><annotation encoding="application/x-tex">T_{e}</annotation></semantics></math> trajectories. Then, inside outer loop iteration <math id="Thmtheorem5.p1.m5" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> with domain factor <math id="Thmtheorem5.p1.m6" class="ltx_Math" alttext="\boldsymbol{\omega}^{m(k)}" display="inline" intent=":literal"><semantics><msup><mi>𝝎</mi><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup><annotation encoding="application/x-tex">\boldsymbol{\omega}^{m(k)}</annotation></semantics></math>, for each <math id="Thmtheorem5.p1.m7" class="ltx_Math" alttext="i\in\mathcal{N}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow><annotation encoding="application/x-tex">i\in\mathcal{N}</annotation></semantics></math>, with probability at least <math id="Thmtheorem5.p1.m8" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>:</p>
<table id="A7.Ex105" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A7.Ex105X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex105X.m2" class="ltx_Math" alttext="\displaystyle\left|Q_{i}(\mathbf{s},\mathbf{a},\boldsymbol{\omega})-\hat{Q}_{i}^{T}(\mathbf{s}_{\mathcal{N}_{i}^{\kappa}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\hat{\boldsymbol{\omega}}_{\mathcal{N}_{i}^{\kappa}})\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><msub><mi>Q</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo>,</mo><mi>𝝎</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mi>i</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>,</mo><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>,</mo><msub><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|Q_{i}(\mathbf{s},\mathbf{a},\boldsymbol{\omega})-\hat{Q}_{i}^{T}(\mathbf{s}_{\mathcal{N}_{i}^{\kappa}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\hat{\boldsymbol{\omega}}_{\mathcal{N}_{i}^{\kappa}})\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex105X.m3" class="ltx_Math" alttext="\displaystyle\leq\frac{C_{a}}{\sqrt{T+t_{0}}}+\frac{C^{\prime}_{a}}{T+t_{0}}+\frac{2c\rho^{\kappa+1}}{(1-\gamma)^{2}}+C^{\prime}_{\boldsymbol{\omega}}\sqrt{\frac{\log(nT_{e}/\delta)}{T_{e}}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>C</mi><mi>a</mi></msub><msqrt><mrow><mi>T</mi><mo>+</mo><msub><mi>t</mi><mn>0</mn></msub></mrow></msqrt></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>C</mi><mi>a</mi><mo>′</mo></msubsup><mrow><mi>T</mi><mo>+</mo><msub><mi>t</mi><mn>0</mn></msub></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo>+</mo><mrow><msubsup><mi>C</mi><mi>𝝎</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>e</mi></msub></mrow><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><msub><mi>T</mi><mi>e</mi></msub></mfrac></mstyle></msqrt></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{C_{a}}{\sqrt{T+t_{0}}}+\frac{C^{\prime}_{a}}{T+t_{0}}+\frac{2c\rho^{\kappa+1}}{(1-\gamma)^{2}}+C^{\prime}_{\boldsymbol{\omega}}\sqrt{\frac{\log(nT_{e}/\delta)}{T_{e}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem5.p1.2" class="ltx_p">where <math id="Thmtheorem5.p1.m9" class="ltx_Math" alttext="C_{a}:=\frac{6\bar{\epsilon}}{1-\sqrt{\gamma}}\sqrt{\frac{\tau h}{\sigma}[\log(\frac{2\tau T^{2}}{\delta})+f(\kappa)\log SA]}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>a</mi></msub><mo>:=</mo><mrow><mfrac><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>ϵ</mi><mo>¯</mo></mover></mrow><mrow><mn>1</mn><mo>−</mo><msqrt><mi>γ</mi></msqrt></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mfrac><mrow><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mi>σ</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mn>2</mn></msup></mrow><mi>δ</mi></mfrac><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>κ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>S</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">C_{a}:=\frac{6\bar{\epsilon}}{1-\sqrt{\gamma}}\sqrt{\frac{\tau h}{\sigma}[\log(\frac{2\tau T^{2}}{\delta})+f(\kappa)\log SA]}</annotation></semantics></math>,
<math id="Thmtheorem5.p1.m10" class="ltx_Math" alttext="C^{\prime}_{a}:=\frac{2}{1-\sqrt{\gamma}}\max(\frac{16\bar{\epsilon}h\tau}{\sigma},\frac{2\bar{r}}{1-\gamma}(\tau+t_{0}))" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>C</mi><mi>a</mi><mo>′</mo></msubsup><mo>:=</mo><mrow><mfrac><mn>2</mn><mrow><mn>1</mn><mo>−</mo><msqrt><mi>γ</mi></msqrt></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mfrac><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>ϵ</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow><mi>σ</mi></mfrac><mo>,</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>r</mi><mo>¯</mo></mover></mrow><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>+</mo><msub><mi>t</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">C^{\prime}_{a}:=\frac{2}{1-\sqrt{\gamma}}\max(\frac{16\bar{\epsilon}h\tau}{\sigma},\frac{2\bar{r}}{1-\gamma}(\tau+t_{0}))</annotation></semantics></math>,
with <math id="Thmtheorem5.p1.m11" class="ltx_Math" alttext="\bar{\epsilon}:=4\frac{\bar{r}}{1-\gamma}+2\bar{r}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>ϵ</mi><mo>¯</mo></mover><mo>:=</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mfrac><mover accent="true"><mi>r</mi><mo>¯</mo></mover><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow></mfrac></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>r</mi><mo>¯</mo></mover></mrow></mrow></mrow><annotation encoding="application/x-tex">\bar{\epsilon}:=4\frac{\bar{r}}{1-\gamma}+2\bar{r}</annotation></semantics></math>, and <math id="Thmtheorem5.p1.m12" class="ltx_Math" alttext="C^{\prime}_{\boldsymbol{\omega}}:=L_{Q}C_{\boldsymbol{\omega}}\sqrt{D_{\Omega}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>C</mi><mi>𝝎</mi><mo>′</mo></msubsup><mo>:=</mo><mrow><msub><mi>L</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>𝝎</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>D</mi><mi mathvariant="normal">Ω</mi></msub></msqrt></mrow></mrow><annotation encoding="application/x-tex">C^{\prime}_{\boldsymbol{\omega}}:=L_{Q}C_{\boldsymbol{\omega}}\sqrt{D_{\Omega}}</annotation></semantics></math>.</p>
</div>
</div>
<div id="A7.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof sketch of Theorem <a href="#Thmtheorem2" title="Theorem 2 (Critic error bound, informal). ‣ Critic error bound. ‣ 6.1 Convergence ‣ 6 Convergence results and adaptation gap ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.</h6>
<div id="A7.SS2.p1" class="ltx_para">
<p id="A7.SS2.p1.1" class="ltx_p"><span id="A7.SS2.p1.1.1" class="ltx_text">The proof follows a similar structure to the Theorem 5 in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib20" title="" class="ltx_ref">20</a>]</cite>, with modifications to account for domain factors. First, we decompose</span></p>
<table id="A7.EGx22" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex106"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex106.m1" class="ltx_Math" alttext="\displaystyle Q_{i}(\mathbf{z},\boldsymbol{\omega})-\hat{Q}_{i}^{T}(\mathbf{z}_{\mathcal{N}_{i}^{\kappa}},\hat{\boldsymbol{\omega}}_{\mathcal{N}_{i}^{\kappa}})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Q</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo>,</mo><mi>𝝎</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mi>i</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>,</mo><msub><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Q_{i}(\mathbf{z},\boldsymbol{\omega})-\hat{Q}_{i}^{T}(\mathbf{z}_{\mathcal{N}_{i}^{\kappa}},\hat{\boldsymbol{\omega}}_{\mathcal{N}_{i}^{\kappa}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex106.m2" class="ltx_Math" alttext="\displaystyle=Q_{i}(\mathbf{z},\boldsymbol{\omega})-Q_{i}(\mathbf{z},\hat{\boldsymbol{\omega}})+Q_{i}(\mathbf{z},\hat{\boldsymbol{\omega}})-\hat{Q}_{i}^{T}(\mathbf{z}_{\mathcal{N}_{i}^{\kappa}},\hat{\boldsymbol{\omega}}_{\mathcal{N}_{i}^{\kappa}})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mrow><msub><mi>Q</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo>,</mo><mi>𝝎</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>Q</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo>,</mo><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>Q</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo>,</mo><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mi>i</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>,</mo><msub><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=Q_{i}(\mathbf{z},\boldsymbol{\omega})-Q_{i}(\mathbf{z},\hat{\boldsymbol{\omega}})+Q_{i}(\mathbf{z},\hat{\boldsymbol{\omega}})-\hat{Q}_{i}^{T}(\mathbf{z}_{\mathcal{N}_{i}^{\kappa}},\hat{\boldsymbol{\omega}}_{\mathcal{N}_{i}^{\kappa}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.SS2.p1.2" class="ltx_p"><span id="A7.SS2.p1.2.1" class="ltx_text">The first difference term accounts for the error due to domain factor estimation. Using the domain factor identifiability in Proposition <a href="#Thmproposition5" title="Proposition 5 (Informal). ‣ 5 Causal recovery and domain factor estimation ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> and the Lipschitz continuity of <math id="A7.SS2.p1.m1" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> with respect to <math id="A7.SS2.p1.m2" class="ltx_Math" alttext="\boldsymbol{\omega}" display="inline" intent=":literal"><semantics><mi>𝝎</mi><annotation encoding="application/x-tex">\boldsymbol{\omega}</annotation></semantics></math> (Assumption <a href="#Thmassumption5" title="Assumption 5. ‣ 6.1 Convergence ‣ 6 Convergence results and adaptation gap ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> (ii)), we have</span></p>
<table id="A7.EGx23" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex107"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex107.m1" class="ltx_Math" alttext="\displaystyle Q_{i}(\mathbf{z},\boldsymbol{\omega})-Q_{i}(\mathbf{z},\hat{\boldsymbol{\omega}})\leq L_{Q}\left\lVert\boldsymbol{\omega}-\hat{\boldsymbol{\omega}}\right\rVert_{2}\leq L_{Q}\delta_{\boldsymbol{\omega}}(T_{e})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>Q</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo>,</mo><mi>𝝎</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>Q</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo>,</mo><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><msub><mi>L</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>𝝎</mi><mo>−</mo><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><mrow><msub><mi>L</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mi>𝝎</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>e</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle Q_{i}(\mathbf{z},\boldsymbol{\omega})-Q_{i}(\mathbf{z},\hat{\boldsymbol{\omega}})\leq L_{Q}\left\lVert\boldsymbol{\omega}-\hat{\boldsymbol{\omega}}\right\rVert_{2}\leq L_{Q}\delta_{\boldsymbol{\omega}}(T_{e}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A7.SS2.p2" class="ltx_para">
<p id="A7.SS2.p2.1" class="ltx_p"><span id="A7.SS2.p2.1.1" class="ltx_text">For <math id="A7.SS2.p2.m1" class="ltx_Math" alttext="\hat{\boldsymbol{\omega}}=\hat{\boldsymbol{\omega}}^{m(k)}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mo>=</mo><msup><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\hat{\boldsymbol{\omega}}=\hat{\boldsymbol{\omega}}^{m(k)}</annotation></semantics></math>, the critic update follows:</span></p>
<table id="A7.EGx24" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex108"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex108.m1" class="ltx_Math" alttext="\displaystyle\hat{Q}_{i}^{t}(\mathbf{s}_{\mathcal{N}_{i}^{\kappa}}(t-1),\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}(t-1),\hat{\boldsymbol{\omega}}_{\mathcal{N}_{i}^{\kappa}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mi>i</mi><mi>t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{Q}_{i}^{t}(\mathbf{s}_{\mathcal{N}_{i}^{\kappa}}(t-1),\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}(t-1),\hat{\boldsymbol{\omega}}_{\mathcal{N}_{i}^{\kappa}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex108.m2" class="ltx_Math" alttext="\displaystyle=(1-\alpha_{t-1})\hat{Q}_{i}^{t-1}(\mathbf{s}_{\mathcal{N}_{i}^{\kappa}}(t-1),\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}(t-1),\hat{\boldsymbol{\omega}}_{\mathcal{N}_{i}^{\kappa}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mi>i</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=(1-\alpha_{t-1})\hat{Q}_{i}^{t-1}(\mathbf{s}_{\mathcal{N}_{i}^{\kappa}}(t-1),\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}(t-1),\hat{\boldsymbol{\omega}}_{\mathcal{N}_{i}^{\kappa}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex109"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex109.m1" class="ltx_Math" alttext="\displaystyle+\alpha_{t-1}(r_{i}(t-1)+\gamma\hat{Q}_{i}^{t-1}(\mathbf{s}_{\mathcal{N}_{i}^{\kappa}}(t),\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}(t),\hat{\boldsymbol{\omega}}_{\mathcal{N}_{i}^{\kappa}}))." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><msub><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>r</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mi>i</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\alpha_{t-1}(r_{i}(t-1)+\gamma\hat{Q}_{i}^{t-1}(\mathbf{s}_{\mathcal{N}_{i}^{\kappa}}(t),\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}(t),\hat{\boldsymbol{\omega}}_{\mathcal{N}_{i}^{\kappa}})).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.SS2.p2.2" class="ltx_p"><span id="A7.SS2.p2.2.1" class="ltx_text">The steps from the original proof apply with the augmentation of <math id="A7.SS2.p2.m2" class="ltx_Math" alttext="\boldsymbol{\omega}^{m}_{\mathcal{N}_{i}^{\kappa}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝝎</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mi>m</mi></msubsup><annotation encoding="application/x-tex">\boldsymbol{\omega}^{m}_{\mathcal{N}_{i}^{\kappa}}</annotation></semantics></math> to the state-action representation. The key difference is that we need to account for the error in domain factor estimation. Let <math id="A7.SS2.p2.m3" class="ltx_Math" alttext="\xi_{t}:=\sup_{(\mathbf{z})\in\mathcal{S}\times\mathcal{A}}|Q_{i}(\mathbf{z},\hat{\boldsymbol{\omega}})-\hat{Q}_{i}^{t}(\mathbf{z}_{\mathcal{N}_{i}^{\kappa}},\hat{\boldsymbol{\omega}}_{\mathcal{N}_{i}^{\kappa}})|" display="inline" intent=":literal"><semantics><mrow><msub><mi>ξ</mi><mi>t</mi></msub><mo rspace="0.1389em">:=</mo><mrow><msub><mo lspace="0.1389em" rspace="0em">sup</mo><mrow><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow></mrow></msub><mrow><mo stretchy="false">|</mo><mrow><mrow><msub><mi>Q</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo>,</mo><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mi>i</mi><mi>t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>,</mo><msub><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\xi_{t}:=\sup_{(\mathbf{z})\in\mathcal{S}\times\mathcal{A}}|Q_{i}(\mathbf{z},\hat{\boldsymbol{\omega}})-\hat{Q}_{i}^{t}(\mathbf{z}_{\mathcal{N}_{i}^{\kappa}},\hat{\boldsymbol{\omega}}_{\mathcal{N}_{i}^{\kappa}})|</annotation></semantics></math>.</span></p>
</div>
<div id="A7.SS2.p3" class="ltx_para">
<p id="A7.SS2.p3.1" class="ltx_p"><span id="A7.SS2.p3.1.1" class="ltx_text">Following the decomposition in the original proof (Lemma 7 in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib20" title="" class="ltx_ref">20</a>]</cite>), we have:</span></p>
<table id="A7.EGx25" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex110"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex110.m1" class="ltx_Math" alttext="\displaystyle\xi_{t}" display="inline" intent=":literal"><semantics><msub><mi>ξ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\displaystyle\xi_{t}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex110.m2" class="ltx_Math" alttext="\displaystyle\leq\tilde{\beta}_{\tau-1,t}\xi_{\tau}+\gamma\sup_{z_{\mathcal{N}_{i}^{\kappa}}}\sum_{k=\tau}^{t-1}b_{k,t}(\mathbf{z}_{\mathcal{N}_{i}^{\kappa}})\xi_{k}+\frac{2c\rho^{\kappa+1}}{1-\gamma}+\left\|\sum_{k=\tau}^{t-1}\alpha_{k}\tilde{B}_{k,t}\epsilon_{k}\right\|_{\infty}+\left\|\sum_{k=\tau}^{t-1}\alpha_{k}\tilde{B}_{k,t}\phi_{k}\right\|_{\infty}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msub><mover accent="true"><mi>β</mi><mo>~</mo></mover><mrow><mrow><mi>τ</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>τ</mi></msub></mrow><mo>+</mo><mrow><mi>γ</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0.167em">sup</mo><msub><mi>z</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub></munder><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mi>τ</mi></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>b</mi><mrow><mi>k</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>k</mi></msub></mrow></mrow></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow></mfrac></mstyle><mo>+</mo><msub><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mi>τ</mi></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>α</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>B</mi><mo>~</mo></mover><mrow><mi>k</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mi>k</mi></msub></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>+</mo><msub><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mi>τ</mi></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>α</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>B</mi><mo>~</mo></mover><mrow><mi>k</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϕ</mi><mi>k</mi></msub></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\tilde{\beta}_{\tau-1,t}\xi_{\tau}+\gamma\sup_{z_{\mathcal{N}_{i}^{\kappa}}}\sum_{k=\tau}^{t-1}b_{k,t}(\mathbf{z}_{\mathcal{N}_{i}^{\kappa}})\xi_{k}+\frac{2c\rho^{\kappa+1}}{1-\gamma}+\left\|\sum_{k=\tau}^{t-1}\alpha_{k}\tilde{B}_{k,t}\epsilon_{k}\right\|_{\infty}+\left\|\sum_{k=\tau}^{t-1}\alpha_{k}\tilde{B}_{k,t}\phi_{k}\right\|_{\infty}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.SS2.p3.2" class="ltx_p"><span id="A7.SS2.p3.2.1" class="ltx_text">Following the same induction argument as in the original proof and combining all terms, we get the stated bound.
∎</span></p>
</div>
</div>
</section>
<section id="A7.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">G.3 </span>Proof of Theorem <a href="#Thmtheorem3" title="Theorem 3 (Policy gradient convergence, informal). ‣ Actor convergence. ‣ 6.1 Convergence ‣ 6 Convergence results and adaptation gap ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a></h3>

<div id="Thmtheorem6" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem6.2" class="ltx_text ltx_font_bold">Theorem 6</span></span><span id="Thmtheorem6.3" class="ltx_text ltx_font_bold"> </span>(Convergence)<span id="Thmtheorem6.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem6.p1" class="ltx_para">
<p id="Thmtheorem6.p1.1" class="ltx_p">Under Assumptions <a href="#Thmassumption1" title="Assumption 1. ‣ 6.1 Convergence ‣ 6 Convergence results and adaptation gap ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>-<a href="#Thmassumption6" title="Assumption 6. ‣ 6.1 Convergence ‣ 6 Convergence results and adaptation gap ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>, for any <math id="Thmtheorem6.p1.m1" class="ltx_Math" alttext="\delta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,1)</annotation></semantics></math>, <math id="Thmtheorem6.p1.m2" class="ltx_Math" alttext="K\geq 3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>≥</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K\geq 3</annotation></semantics></math>, suppose the critic stepsize <math id="Thmtheorem6.p1.m3" class="ltx_Math" alttext="\alpha_{t}=\frac{h}{t+t_{0}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>t</mi></msub><mo>=</mo><mfrac><mi>h</mi><mrow><mi>t</mi><mo>+</mo><msub><mi>t</mi><mn>0</mn></msub></mrow></mfrac></mrow><annotation encoding="application/x-tex">\alpha_{t}=\frac{h}{t+t_{0}}</annotation></semantics></math> and <math id="Thmtheorem6.p1.m4" class="ltx_Math" alttext="\eta_{k}=\frac{\eta}{\sqrt{k+1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>k</mi></msub><mo>=</mo><mfrac><mi>η</mi><msqrt><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msqrt></mfrac></mrow><annotation encoding="application/x-tex">\eta_{k}=\frac{\eta}{\sqrt{k+1}}</annotation></semantics></math> with <math id="Thmtheorem6.p1.m5" class="ltx_Math" alttext="\eta\leq\frac{1}{6L^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>≤</mo><mfrac><mn>1</mn><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mo>′</mo></msup></mrow></mfrac></mrow><annotation encoding="application/x-tex">\eta\leq\frac{1}{6L^{\prime}}</annotation></semantics></math>. For sufficiently large the inner loop length <math id="Thmtheorem6.p1.m6" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> such that <math id="Thmtheorem6.p1.m7" class="ltx_Math" alttext="T+1\geq\frac{\log(c(1-\gamma)/\bar{r})+(\kappa+1)\log_{\gamma}\rho}{\log\gamma}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow><mo>≥</mo><mfrac><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mover accent="true"><mi>r</mi><mo>¯</mo></mover></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>log</mi><mi>γ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>ρ</mi></mrow></mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>γ</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">T+1\geq\frac{\log(c(1-\gamma)/\bar{r})+(\kappa+1)\log_{\gamma}\rho}{\log\gamma}</annotation></semantics></math> and <math id="Thmtheorem6.p1.m8" class="ltx_Math" alttext="\frac{C_{a}(\delta/2nK,T)}{\sqrt{T+t_{0}}}+\frac{C^{\prime}_{a}}{T+t_{0}}\leq\frac{2c\rho^{\kappa+1}}{(1-\gamma)^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><msub><mi>C</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>δ</mi><mo>/</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>,</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><msqrt><mrow><mi>T</mi><mo>+</mo><msub><mi>t</mi><mn>0</mn></msub></mrow></msqrt></mfrac><mo>+</mo><mfrac><msubsup><mi>C</mi><mi>a</mi><mo>′</mo></msubsup><mrow><mi>T</mi><mo>+</mo><msub><mi>t</mi><mn>0</mn></msub></mrow></mfrac></mrow><mo>≤</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow><annotation encoding="application/x-tex">\frac{C_{a}(\delta/2nK,T)}{\sqrt{T+t_{0}}}+\frac{C^{\prime}_{a}}{T+t_{0}}\leq\frac{2c\rho^{\kappa+1}}{(1-\gamma)^{2}}</annotation></semantics></math>,
Then, with probability at least <math id="Thmtheorem6.p1.m9" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>, when domain factors are estimated with <math id="Thmtheorem6.p1.m10" class="ltx_Math" alttext="T_{e}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>e</mi></msub><annotation encoding="application/x-tex">T_{e}</annotation></semantics></math> trajectories:</p>
<table id="A7.EGx26" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex111"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex111.m1" class="ltx_Math" alttext="\displaystyle\frac{\sum_{k=0}^{K-1}\eta_{k}\|\nabla J(\theta(k))\|^{2}}{\sum_{k=0}^{K-1}\eta_{k}}\leq\frac{\frac{2\bar{r}}{\eta(1-\gamma)}+\frac{8\bar{r}^{2}L^{2}}{(1-\gamma)^{4}}\sqrt{\log K\log\dfrac{4}{\delta}}+\frac{240\bar{r}^{2}L^{\prime}L^{2}}{(1-\gamma)^{4}}\eta\log K}{\sqrt{K+1}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><msub><mi>η</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>J</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mi>η</mi><mi>k</mi></msub></mrow></mfrac></mstyle><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>r</mi><mo>¯</mo></mover></mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>+</mo><mrow><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>r</mi><mo>¯</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>K</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mn>4</mn><mi>δ</mi></mfrac></mstyle></mrow></mrow></mrow></msqrt></mrow><mo>+</mo><mrow><mfrac><mrow><mn>240</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>r</mi><mo>¯</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>K</mi></mrow></mrow></mrow><msqrt><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow></msqrt></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\sum_{k=0}^{K-1}\eta_{k}\|\nabla J(\theta(k))\|^{2}}{\sum_{k=0}^{K-1}\eta_{k}}\leq\frac{\frac{2\bar{r}}{\eta(1-\gamma)}+\frac{8\bar{r}^{2}L^{2}}{(1-\gamma)^{4}}\sqrt{\log K\log\dfrac{4}{\delta}}+\frac{240\bar{r}^{2}L^{\prime}L^{2}}{(1-\gamma)^{4}}\eta\log K}{\sqrt{K+1}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex112"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex112.m1" class="ltx_Math" alttext="\displaystyle+\frac{12L^{2}c\bar{r}}{(1-\gamma)^{5}}\rho^{\kappa+1}+\frac{2\bar{r}LL_{J}C_{\boldsymbol{\omega}}}{(1-\gamma)^{2}}\sqrt{\frac{\log(4nM/\delta)}{T_{e}}}+\frac{2C_{5}(\bar{r}L+L_{\theta})d^{\theta}}{(1-\gamma)^{2}}\sqrt{\frac{\log(4M/\delta)}{M}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>r</mi><mo>¯</mo></mover></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>5</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>r</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>J</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>𝝎</mi></msub></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><msub><mi>T</mi><mi>e</mi></msub></mfrac></mstyle></msqrt></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>5</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mover accent="true"><mi>r</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><msub><mi>L</mi><mi>θ</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mi>θ</mi></msup></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>M</mi></mfrac></mstyle></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{12L^{2}c\bar{r}}{(1-\gamma)^{5}}\rho^{\kappa+1}+\frac{2\bar{r}LL_{J}C_{\boldsymbol{\omega}}}{(1-\gamma)^{2}}\sqrt{\frac{\log(4nM/\delta)}{T_{e}}}+\frac{2C_{5}(\bar{r}L+L_{\theta})d^{\theta}}{(1-\gamma)^{2}}\sqrt{\frac{\log(4M/\delta)}{M}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A7.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof sketch of Theorem <a href="#Thmtheorem3" title="Theorem 3 (Policy gradient convergence, informal). ‣ Actor convergence. ‣ 6.1 Convergence ‣ 6 Convergence results and adaptation gap ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>.</h6>
<div id="A7.SS3.p1" class="ltx_para">
<p id="A7.SS3.p1.1" class="ltx_p"><span id="A7.SS3.p1.1.1" class="ltx_text">We adapt the proof of Theorem 4 in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib20" title="" class="ltx_ref">20</a>]</cite> to account for domain factors. The key difference is that the policy gradient now depends on the domain factors, and we need to account for the error in domain factor estimation.</span></p>
</div>
<div id="A7.SS3.p2" class="ltx_para">
<p id="A7.SS3.p2.1" class="ltx_p"><span id="A7.SS3.p2.1.1" class="ltx_text">Note that for any <math id="A7.SS3.p2.m1" class="ltx_Math" alttext="\theta\in\Theta" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><mi mathvariant="normal">Θ</mi></mrow><annotation encoding="application/x-tex">\theta\in\Theta</annotation></semantics></math>, we have</span></p>
<table id="A7.Ex113" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex113.m1" class="ltx_math_unparsed" alttext="\nabla_{\theta_{i}}\log\pi^{\theta}(\mathbf{a}|\mathbf{s},\boldsymbol{\omega})=\nabla_{\theta_{i}}\sum_{j\in\mathcal{N}}\log\pi_{j}^{\theta_{j}}(\mathbf{a}_{j}|\mathbf{s}_{j},\boldsymbol{\omega}_{j})=\nabla_{\theta_{i}}\log\pi_{i}^{\theta_{i}}(\mathbf{a}_{i}|\mathbf{s}_{i},\boldsymbol{\omega}_{j})." display="block" intent=":literal"><semantics><mrow><msub><mo>∇</mo><msub><mi>θ</mi><mi>i</mi></msub></msub><mi>log</mi><msup><mi>π</mi><mi>θ</mi></msup><mrow><mo stretchy="false">(</mo><mi>𝐚</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝐬</mi><mo>,</mo><mi>𝝎</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mo>∇</mo><msub><mi>θ</mi><mi>i</mi></msub></msub><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow></munder><mi>log</mi><msubsup><mi>π</mi><mi>j</mi><msub><mi>θ</mi><mi>j</mi></msub></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>𝐚</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝐬</mi><mi>j</mi></msub><mo>,</mo><msub><mi>𝝎</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mo rspace="0.167em">∇</mo><msub><mi>θ</mi><mi>i</mi></msub></msub><mi>log</mi><msubsup><mi>π</mi><mi>i</mi><msub><mi>θ</mi><mi>i</mi></msub></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>𝐚</mi><mi>i</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝝎</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\nabla_{\theta_{i}}\log\pi^{\theta}(\mathbf{a}|\mathbf{s},\boldsymbol{\omega})=\nabla_{\theta_{i}}\sum_{j\in\mathcal{N}}\log\pi_{j}^{\theta_{j}}(\mathbf{a}_{j}|\mathbf{s}_{j},\boldsymbol{\omega}_{j})=\nabla_{\theta_{i}}\log\pi_{i}^{\theta_{i}}(\mathbf{a}_{i}|\mathbf{s}_{i},\boldsymbol{\omega}_{j}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.SS3.p2.2" class="ltx_p"><span id="A7.SS3.p2.2.1" class="ltx_text">Let us define the approximation of the policy gradient and the true policy gradient</span></p>
<table id="A7.EGx27" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex114"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex114.m1" class="ltx_Math" alttext="\displaystyle\hat{g}_{i}(k)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>g</mi><mo>^</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{g}_{i}(k)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex114.m2" class="ltx_Math" alttext="\displaystyle=\sum_{t=0}^{T}\gamma^{t}\frac{1}{n}\sum_{j\in\mathcal{N}_{i}^{\kappa}}\hat{Q}_{j}^{T}(\mathbf{s}_{\mathcal{N}_{j}^{\kappa}}(t),\mathbf{a}_{\mathcal{N}_{j}^{\kappa}}(t),\hat{\boldsymbol{\omega}}^{m(k)}_{\mathcal{N}_{j}^{\kappa}})\nabla_{\theta_{i}}\log\pi_{i}^{\theta_{i}(k)}(\mathbf{a}_{i}(t)|\mathbf{s}_{i}(t),\hat{\boldsymbol{\omega}}^{m(k)}_{i})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msup><mi>γ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></mrow></munder></mstyle><mrow><msubsup><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mi>j</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>j</mi><mi>κ</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>j</mi><mi>κ</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msubsup><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>j</mi><mi>κ</mi></msubsup><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><msub><mo>∇</mo><msub><mi>θ</mi><mi>i</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msubsup><mi>π</mi><mi>i</mi><mrow><msub><mi>θ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><mrow><msub><mi>𝐬</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msubsup><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mi>i</mi><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{t=0}^{T}\gamma^{t}\frac{1}{n}\sum_{j\in\mathcal{N}_{i}^{\kappa}}\hat{Q}_{j}^{T}(\mathbf{s}_{\mathcal{N}_{j}^{\kappa}}(t),\mathbf{a}_{\mathcal{N}_{j}^{\kappa}}(t),\hat{\boldsymbol{\omega}}^{m(k)}_{\mathcal{N}_{j}^{\kappa}})\nabla_{\theta_{i}}\log\pi_{i}^{\theta_{i}(k)}(\mathbf{a}_{i}(t)|\mathbf{s}_{i}(t),\hat{\boldsymbol{\omega}}^{m(k)}_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex115"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex115.m1" class="ltx_Math" alttext="\displaystyle g_{i}(k)" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle g_{i}(k)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex115.m2" class="ltx_Math" alttext="\displaystyle:=\sum_{t=0}^{T}\gamma^{t}\frac{1}{n}\sum_{j\in\mathcal{N}_{i}^{\kappa}}Q_{j}^{\theta(k)}(\mathbf{s}(t),\mathbf{a}(t),\hat{\boldsymbol{\omega}}^{m(k)})\nabla_{\theta_{i}}\log\pi_{i}^{\theta_{i}(k)}(\mathbf{a}_{i}(t)|\mathbf{s}_{i}(t),\hat{\boldsymbol{\omega}}^{m(k)}_{i})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msup><mi>γ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></mrow></munder></mstyle><mrow><msubsup><mi>Q</mi><mi>j</mi><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐚</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msup><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><msub><mo>∇</mo><msub><mi>θ</mi><mi>i</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msubsup><mi>π</mi><mi>i</mi><mrow><msub><mi>θ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><mrow><msub><mi>𝐬</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msubsup><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mi>i</mi><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle:=\sum_{t=0}^{T}\gamma^{t}\frac{1}{n}\sum_{j\in\mathcal{N}_{i}^{\kappa}}Q_{j}^{\theta(k)}(\mathbf{s}(t),\mathbf{a}(t),\hat{\boldsymbol{\omega}}^{m(k)})\nabla_{\theta_{i}}\log\pi_{i}^{\theta_{i}(k)}(\mathbf{a}_{i}(t)|\mathbf{s}_{i}(t),\hat{\boldsymbol{\omega}}^{m(k)}_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex116"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex116.m1" class="ltx_Math" alttext="\displaystyle h_{i}(k)" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle h_{i}(k)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex116.m2" class="ltx_math_unparsed" alttext="\displaystyle:=\sum_{m=1}^{M}\frac{1}{M}\sum_{t=0}^{T}\mathbb{E}_{\mathbf{s}\sim\rho_{t}^{\theta(k)},\,\mathbf{a}\sim\pi^{\theta(k)}(\cdot|\mathbf{s},\hat{\boldsymbol{\omega}}^{m})}\left[\gamma^{t}\frac{1}{n}\sum_{j\in\mathcal{N}_{i}^{\kappa}}Q_{j}^{\theta(k)}(\mathbf{s},\mathbf{a},\hat{\boldsymbol{\omega}}^{m})\nabla_{\theta_{i}}\log\pi_{i}^{\theta_{i}(k)}(\mathbf{a}_{i}|\mathbf{s}_{i},\hat{\boldsymbol{\omega}}_{i}^{m})\right]" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">:</mo><mo lspace="0em">=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>M</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mi>T</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>𝐬</mi><mo>∼</mo><mi>ρ</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo rspace="0.337em">,</mo><mi>𝐚</mi><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐬</mi><mo>,</mo><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><msup><mrow></mrow><mi>m</mi></msup><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><msup><mi>γ</mi><mi>t</mi></msup><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></mrow></munder><