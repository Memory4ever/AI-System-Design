<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex117.m2" class="ltx_math_unparsed" alttext="\displaystyle:=\sum_{m=1}^{M}\frac{1}{M}\sum_{t=0}^{\infty}\mathbb{E}_{\mathbf{s}\sim\rho_{t}^{\theta(k)},\mathbf{a}\sim\pi^{\theta(k)}(\cdot|\mathbf{s},\hat{\boldsymbol{\omega}}^{m})}\left[\gamma^{t}Q^{\theta(k)}(\mathbf{s},\mathbf{a},\hat{\boldsymbol{\omega}}^{m})\nabla_{\theta_{i}}\log\pi^{\theta(k)}(\mathbf{a}|\mathbf{s},\hat{\boldsymbol{\omega}}^{m})\right]" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">:</mo><mo lspace="0em">=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>M</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>𝐬</mi><mo>∼</mo><mi>ρ</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo>,</mo><mi>𝐚</mi><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐬</mi><mo>,</mo><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><msup><mrow></mrow><mi>m</mi></msup><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><msup><mi>γ</mi><mi>t</mi></msup><msup><mi>Q</mi><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo>,</mo><mi>𝐚</mi><mo>,</mo><msup><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mi>m</mi></msup><mo rspace="0.167em" stretchy="false">)</mo></mrow