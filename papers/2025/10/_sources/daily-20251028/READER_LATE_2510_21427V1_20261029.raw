<math id="alg3.l5.m4" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{i}(1)\leftarrow\mathbf{s}^{\circ}_{i}(1)\cup\left\{s_{i,j}\right\}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>∪</mo><mrow><mo>{</mo><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{i}(1)\leftarrow\mathbf{s}^{\circ}_{i}(1)\cup\left\{s_{i,j}\right\}</annotation></semantics></math>

</div>
