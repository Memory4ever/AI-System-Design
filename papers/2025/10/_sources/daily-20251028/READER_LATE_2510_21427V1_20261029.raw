<math id="alg2.l14.m3" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{i}\leftarrow\mathbf{s}^{\circ}_{i}\cup\left\{s_{i,j}\right\}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo stretchy="false">←</mo><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo>∪</mo><mrow><mo>{</mo><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{i}\leftarrow\mathbf{s}^{\circ}_{i}\cup\left\{s_{i,j}\right\}</annotation></semantics></math>

