              <span id="alg3.l11.3" class="ltx_text ltx_font_bold">for</span>  agent <math id="alg3.l11.m1" class="ltx_Math" alttext="i=1,2,\dots," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">i=1,2,\dots,</annotation></semantics></math> <span id="alg3.l11.4" class="ltx_text ltx_font_bold">do</span>

