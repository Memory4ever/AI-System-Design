<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex19.m1" class="ltx_Math" alttext="\displaystyle\hat{Q}_{i}^{t}(\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}}(t{-}1),\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}(t{-}1),\hat{\boldsymbol{\omega}}^{\circ}_{\mathcal{N}_{i}^{\kappa}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mi>i</mi><mi>t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msubsup><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{Q}_{i}^{t}(\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}}(t{-}1),\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}(t{-}1),\hat{\boldsymbol{\omega}}^{\circ}_{\mathcal{N}_{i}^{\kappa}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex19.m2" class="ltx_Math" alttext="\displaystyle\leftarrow(1-\alpha_{t-1})\hat{Q}_{i}^{t{-}1}(\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}}(t{-}1),\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}(t{-}1),\hat{\boldsymbol{\omega}}^{\circ}_{\mathcal{N}_{i}^{\kappa}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo stretchy="false">←</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mi>i</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msubsup><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leftarrow(1-\alpha_{t-1})\hat{Q}_{i}^{t{-}1}(\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}}(t{-}1),\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}(t{-}1),\hat{\boldsymbol{\omega}}^{\circ}_{\mathcal{N}_{i}^{\kappa}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex20.m1" class="ltx_Math" alttext="\displaystyle+\alpha_{t-1}\left(r_{i}(t{-}1)+\gamma\hat{Q}_{i}^{t{-}1}(\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}}(t),\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}(t),\hat{\boldsymbol{\omega}}^{\circ}_{\mathcal{N}_{i}^{\kappa}})\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><msub><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>r</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mi>i</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msubsup><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\alpha_{t-1}\left(r_{i}(t{-}1)+\gamma\hat{Q}_{i}^{t{-}1}(\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}}(t),\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}(t),\hat{\boldsymbol{\omega}}^{\circ}_{\mathcal{N}_{i}^{\kappa}})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>

</div>
<div id="alg4.l30" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l30.1" class="ltx_text" style="font-size:80%;">30:</span></span>
              
              
                 For all other <math id="alg4.l30.m1" class="ltx_Math" alttext="(\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}})\neq(\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}}(t{-}1),\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}(t{-}1))" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo>,</mo><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow><mo>≠</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}})\neq(\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}}(t{-}1),\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}(t{-}1))</annotation></semantics></math>, set:

<table id="A4.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex21.m1" class="ltx_Math" alttext="\hat{Q}_{i}^{t}(\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\hat{\boldsymbol{\omega}}^{\circ}_{\mathcal{N}_{i}^{\kappa}})=\hat{Q}_{i}^{t{-}1}(\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\hat{\boldsymbol{\omega}}^{\circ}_{\mathcal{N}_{i}^{\kappa}})" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mi>i</mi><mi>t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo>,</mo><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>,</mo><msubsup><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mi>i</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo>,</mo><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo>,</mo><msubsup><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{Q}_{i}^{t}(\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\hat{\boldsymbol{\omega}}^{\circ}_{\mathcal{N}_{i}^{\kappa}})=\hat{Q}_{i}^{t{-}1}(\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\hat{\boldsymbol{\omega}}^{\circ}_{\mathcal{N}_{i}^{\kappa}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
