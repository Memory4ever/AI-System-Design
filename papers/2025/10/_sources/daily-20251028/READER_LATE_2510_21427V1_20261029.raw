</div>
<div id="alg3.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
              
              
               <math id="alg3.l13.m1" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{i}(l+1)\leftarrow\mathbf{s}^{\circ}_{i}(l)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{i}(l+1)\leftarrow\mathbf{s}^{\circ}_{i}(l)</annotation></semantics></math>

</div>
<div id="alg3.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
              
              
               <span id="alg3.l14.3" class="ltx_text ltx_font_bold">for</span>  component <math id="alg3.l14.m1" class="ltx_Math" alttext="j=1,2,\dots,d^{s}_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>d</mi><mi>i</mi><mi>s</mi></msubsup></mrow><annotation encoding="application/x-tex">j=1,2,\dots,d^{s}_{i}</annotation></semantics></math> <span id="alg3.l14.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg3.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
              
              
                 <span id="alg3.l15.3" class="ltx_text ltx_font_bold">if</span> there is an edge from <math id="alg3.l15.m1" class="ltx_Math" alttext="s_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">s_{i,j}</annotation></semantics></math> to <math id="alg3.l15.m2" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{\mathcal{N}_{i}}(l)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{\mathcal{N}_{i}}(l)</annotation></semantics></math> <span id="alg3.l15.4" class="ltx_text ltx_font_bold">then</span>
<math id="alg3.l15.m3" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{i}(l+1)\leftarrow\mathbf{s}^{\circ}_{i}(l+1)\cup\left\{s_{i,j}\right\}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∪</mo><mrow><mo>{</mo><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{i}(l+1)\leftarrow\mathbf{s}^{\circ}_{i}(l+1)\cup\left\{s_{i,j}\right\}</annotation></semantics></math>

</div>
<div id="alg3.l16" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
              
              
                 <span id="alg3.l16.3" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l16.4" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg3.l17" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l17.1" class="ltx_text" style="font-size:80%;">17:</span></span>
              
              
               <span id="alg3.l17.3" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l17.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg3.l18" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l18.1" class="ltx_text" style="font-size:80%;">18:</span></span>
              
              
              <span id="alg3.l18.3" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l18.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg3.l19" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l19.1" class="ltx_text" style="font-size:80%;">19:</span></span>
              
              
            <span id="alg3.l19.3" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l19.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg3.l20" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l20.1" class="ltx_text" style="font-size:80%;">20:</span></span>
              
              
            <span id="alg3.l20.3" class="ltx_text ltx_font_bold">for</span>  agent <math id="alg3.l20.m1" class="ltx_Math" alttext="i=1,2,\dots," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">i=1,2,\dots,</annotation></semantics></math> <span id="alg3.l20.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg3.l21" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l21.1" class="ltx_text" style="font-size:80%;">21:</span></span>
              
              
              agent <math id="alg3.l21.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> receives <math id="alg3.l21.m2" class="ltx_Math" alttext="\left(\mathbf{s}^{\circ}_{i^{\prime}}(\kappa)\right)_{i^{\prime}\in\mathcal{N}_{i}/i}" display="inline" intent=":literal"><semantics><msub><mrow><mo>(</mo><mrow><msubsup><mi>𝐬</mi><msup><mi>i</mi><mo>′</mo></msup><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>κ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>/</mo><mi>i</mi></mrow></mrow></msub><annotation encoding="application/x-tex">\left(\mathbf{s}^{\circ}_{i^{\prime}}(\kappa)\right)_{i^{\prime}\in\mathcal{N}_{i}/i}</annotation></semantics></math> from its neighbors and <math id="alg3.l21.m3" class="ltx_math_unparsed" alttext="\mathbf{s}^{\circ}_{\mathcal{N}_{i}}\leftarrow\cup_{i^{\prime}\in\mathcal{N}_{i}}\left\{\mathbf{s}^{\circ}_{i^{\prime}}(\kappa)\right\}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo rspace="0em" stretchy="false">←</mo><msub><mo lspace="0em">∪</mo><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub></mrow></msub><mrow><mo>{</mo><msubsup><mi>𝐬</mi><msup><mi>i</mi><mo>′</mo></msup><mo>∘</mo></msubsup><mrow><mo stretchy="false">(</mo><mi>κ</mi><mo stretchy="false">)</mo></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{\mathcal{N}_{i}}\leftarrow\cup_{i^{\prime}\in\mathcal{N}_{i}}\left\{\mathbf{s}^{\circ}_{i^{\prime}}(\kappa)\right\}</annotation></semantics></math>

</div>
<div id="alg3.l22" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l22.1" class="ltx_text" style="font-size:80%;">22:</span></span>
              
              
            <span id="alg3.l22.3" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l22.4" class="ltx_text ltx_font_bold">for</span>
</div>
</div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<p id="alg3.8" class="ltx_p ltx_figure_panel"><span id="alg3.8.1" class="ltx_text ltx_font_bold">Output: policy ACR <math id="alg3.m2" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{\mathcal{N}_{i}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{\mathcal{N}_{i}}</annotation></semantics></math> for each agent <math id="alg3.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math></span></p></div></div>
</figure>
</section>
<section id="A4.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.3 </span>GSAC</h3>

<div id="A4.SS3.p1" class="ltx_para">
<p id="A4.SS3.p1.1" class="ltx_p">We provide the complete pseudo-code of <span id="A4.SS3.p1.1.1" class="ltx_text ltx_font_typewriter">GSAC</span> in Algorithm <a href="#alg4" title="Algorithm 4 ‣ D.3 GSAC ‣ Appendix D Algorithm design ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>.</p>
</div>
<figure id="alg4" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg4.4" class="ltx_text ltx_font_bold">Algorithm 4</span> </span> <span id="alg4.5" class="ltx_text ltx_font_smallcaps">Generalizable and Scalable Actor-critic </span></figcaption>
<div id="alg4.6" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg4.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
            <span id="alg4.l1.3" class="ltx_text ltx_font_bold">Input:</span> <math id="alg4.l1.m1" class="ltx_Math" alttext="\theta_{i}(0)" display="inline" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\theta_{i}(0)</annotation></semantics></math>; parameter <math id="alg4.l1.m2" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>; <math id="alg4.l1.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, length of each episode; stepsize parameters <math id="alg4.l1.m4" class="ltx_Math" alttext="h,t_{0},\eta" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>,</mo><msub><mi>t</mi><mn>0</mn></msub><mo>,</mo><mi>η</mi></mrow><annotation encoding="application/x-tex">h,t_{0},\eta</annotation></semantics></math>.

</div>
<div id="alg4.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
            // <span id="alg4.l2.3" class="ltx_text ltx_font_italic">Phase 1: local causal model learning</span>

</div>
<div id="alg4.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
            <span id="alg4.l3.3" class="ltx_text ltx_font_bold">for</span> source domain index <math id="alg4.l3.m1" class="ltx_Math" alttext="m=1,2,\dots,M" display="inline" intent=":literal"><semantics><mrow><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">m=1,2,\dots,M</annotation></semantics></math> <span id="alg4.l3.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg4.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
              Sample <math id="alg4.l4.m1" class="ltx_Math" alttext="\boldsymbol{\omega}^{m}\sim\mathcal{D}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝝎</mi><mi>m</mi></msup><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow><annotation encoding="application/x-tex">\boldsymbol{\omega}^{m}\sim\mathcal{D}</annotation></semantics></math>

</div>
<div id="alg4.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
              Collect trajectories <math id="alg4.l5.m1" class="ltx_Math" alttext="\tau^{m}=\left(\mathbf{s}^{m}(t),\mathbf{a}^{m}(t),r^{m}(t),\mathbf{s}^{m}(t+1)\right)_{t=1}^{T_{e}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>τ</mi><mi>m</mi></msup><mo>=</mo><msubsup><mrow><mo>(</mo><mrow><msup><mi>𝐬</mi><mi>m</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>𝐚</mi><mi>m</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>r</mi><mi>m</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>𝐬</mi><mi>m</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>T</mi><mi>e</mi></msub></msubsup></mrow><annotation encoding="application/x-tex">\tau^{m}=\left(\mathbf{s}^{m}(t),\mathbf{a}^{m}(t),r^{m}(t),\mathbf{s}^{m}(t+1)\right)_{t=1}^{T_{e}}</annotation></semantics></math>

</div>
<div id="alg4.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
              
              
              Split <math id="alg4.l6.m1" class="ltx_Math" alttext="\tau^{m}" display="inline" intent=":literal"><semantics><msup><mi>τ</mi><mi>m</mi></msup><annotation encoding="application/x-tex">\tau^{m}</annotation></semantics></math> into <math id="alg4.l6.m2" class="ltx_Math" alttext="\tau^{m}_{i}=\left(\mathbf{s}^{m}_{\mathcal{N}_{i}}(t),\mathbf{a}^{m}_{i}(t),r_{i}(t),\mathbf{s}^{m}_{i}(t+1)\right)_{t=1}^{T_{e}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>τ</mi><mi>i</mi><mi>m</mi></msubsup><mo>=</mo><msubsup><mrow><mo>(</mo><mrow><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mi>m</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>𝐚</mi><mi>i</mi><mi>m</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>r</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mi>m</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>T</mi><mi>e</mi></msub></msubsup></mrow><annotation encoding="application/x-tex">\tau^{m}_{i}=\left(\mathbf{s}^{m}_{\mathcal{N}_{i}}(t),\mathbf{a}^{m}_{i}(t),r_{i}(t),\mathbf{s}^{m}_{i}(t+1)\right)_{t=1}^{T_{e}}</annotation></semantics></math> for each agent <math id="alg4.l6.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>

</div>
<div id="alg4.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
              
              
              Each agent <math id="alg4.l7.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> estimate the causal mask <math id="alg4.l7.m2" class="ltx_Math" alttext="\mathbf{c}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝐜</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathbf{c}_{i}</annotation></semantics></math>, model parameter <math id="alg4.l7.m3" class="ltx_Math" alttext="\psi_{i}" display="inline" intent=":literal"><semantics><msub><mi>ψ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\psi_{i}</annotation></semantics></math>, and domain factor <math id="alg4.l7.m4" class="ltx_Math" alttext="\hat{\boldsymbol{\omega}}^{m}_{i}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mi>i</mi><mi>m</mi></msubsup><annotation encoding="application/x-tex">\hat{\boldsymbol{\omega}}^{m}_{i}</annotation></semantics></math>

</div>
<div id="alg4.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
              
              
            <span id="alg4.l8.3" class="ltx_text ltx_font_bold">end</span> <span id="alg4.l8.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg4.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
              
              
            // <span id="alg4.l9.3" class="ltx_text ltx_font_italic">Phase 2: approximately compact representation</span>

</div>
<div id="alg4.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
              
              
            <span id="alg4.l10.3" class="ltx_text ltx_font_bold">for</span> each agent <math id="alg4.l10.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> <span id="alg4.l10.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg4.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
              
              
