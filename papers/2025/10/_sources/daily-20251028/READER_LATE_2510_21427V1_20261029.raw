ace="0.667em">,</mo><mrow><mrow><mtext>for</mtext><mo lspace="0.500em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo>,</mo><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{Q}_{i}^{t}(\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\hat{\boldsymbol{\omega}}^{\circ}_{\mathcal{N}_{i}^{\kappa}})\leftarrow\hat{Q}_{i}^{t{-}1}(\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}},\hat{\boldsymbol{\omega}}^{\circ}_{\mathcal{N}_{i}^{\kappa}}),\ \text{for}\ (\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}},\mathbf{a}_{\mathcal{N}_{i}^{\kappa}})\neq(\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}}(t{-}1),\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}(t{-}1))</annotation></semantics></math></td>
