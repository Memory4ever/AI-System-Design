            // <span id="alg2.l1.3" class="ltx_text ltx_font_italic">Initialization</span>:

</div>
<div id="alg2.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
            <math id="alg2.l2.m1" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{i}\leftarrow\varnothing" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{i}\leftarrow\varnothing</annotation></semantics></math> for all <math id="alg2.l2.m2" class="ltx_Math" alttext="i\in\mathscr{N}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mi class="ltx_font_mathscript">𝒩</mi></mrow><annotation encoding="application/x-tex">i\in\mathscr{N}</annotation></semantics></math>

</div>
<div id="alg2.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
            <span id="alg2.l3.3" class="ltx_text ltx_font_bold">for</span>  agent <math id="alg2.l3.m1" class="ltx_Math" alttext="i=1,2,\dots," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">i=1,2,\dots,</annotation></semantics></math> <span id="alg2.l3.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg2.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
              <span id="alg2.l4.3" class="ltx_text ltx_font_bold">for</span>  component <math id="alg2.l4.m1" class="ltx_Math" alttext="j=1,2,\dots,d^{s}_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>d</mi><mi>i</mi><mi>s</mi></msubsup></mrow><annotation encoding="application/x-tex">j=1,2,\dots,d^{s}_{i}</annotation></semantics></math> <span id="alg2.l4.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg2.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
               <span id="alg2.l5.3" class="ltx_text ltx_font_bold">if</span> there is a direct link from <math id="alg2.l5.m1" class="ltx_Math" alttext="s_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">s_{i,j}</annotation></semantics></math> to <math id="alg2.l5.m2" class="ltx_Math" alttext="r_{i}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>i</mi></msub><annotation encoding="application/x-tex">r_{i}</annotation></semantics></math>, i.e., <math id="alg2.l5.m3" class="ltx_Math" alttext="c^{s\rightarrow r}_{i,j}=1" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>c</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mi>s</mi><mo stretchy="false">→</mo><mi>r</mi></mrow></msubsup><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c^{s\rightarrow r}_{i,j}=1</annotation></semantics></math> <span id="alg2.l5.4" class="ltx_text ltx_font_bold">then</span>
<math id="alg2.l5.m4" class="ltx_Math" alttext="\mathbf{s}^{\circ}_{i}\leftarrow\mathbf{s}^{\circ}_{i}\cup\left\{s_{i,j}\right\}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo stretchy="false">←</mo><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo>∪</mo><mrow><mo>{</mo><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}^{\circ}_{i}\leftarrow\mathbf{s}^{\circ}_{i}\cup\left\{s_{i,j}\right\}</annotation></semantics></math>

</div>
<div id="alg2.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
              
              
               <span id="alg2.l6.3" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l6.4" class="ltx_text ltx_font_bold">if</span>
</div>
