</div>
<div id="alg1.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
              
              
            <span id="alg1.l8.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l8.4" class="ltx_text ltx_font_bold">for</span>

</div>
<div id="alg1.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
              
              
            <span id="alg1.l9.3" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l9.m1" class="ltx_Math" alttext="k=0,1,2,\dots,K-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">k=0,1,2,\dots,K-1</annotation></semantics></math> <span id="alg1.l9.4" class="ltx_text ltx_font_bold">do</span> <span id="alg1.l9.5" class="ltx_text" style="float:right;"><math id="alg1.l9.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <span id="alg1.l9.5.1" class="ltx_text ltx_font_italic">P3: meta-learning</span>
</span>
</div>
<div id="alg1.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
              
              
              Sample domain index <math id="alg1.l10.m1" class="ltx_Math" alttext="m(k)\sim\{1,\dots,K\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∼</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>K</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">m(k)\sim\{1,\dots,K\}</annotation></semantics></math>, set <math id="alg1.l10.m2" class="ltx_Math" alttext="\hat{\boldsymbol{\omega}}^{\circ}\leftarrow\hat{\boldsymbol{\omega}}^{m(k),\circ}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mo>∘</mo></msup><mo stretchy="false">←</mo><msup><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mrow><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0em">,</mo><mo lspace="0em">∘</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\hat{\boldsymbol{\omega}}^{\circ}\leftarrow\hat{\boldsymbol{\omega}}^{m(k),\circ}</annotation></semantics></math>, sample <math id="alg1.l10.m3" class="ltx_Math" alttext="\mathbf{s}(0)\sim\rho_{0}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>∼</mo><msub><mi>ρ</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\mathbf{s}(0)\sim\rho_{0}</annotation></semantics></math> 
</div>
<div id="alg1.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
              
              
              Each agent <math id="alg1.l11.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> takes action <math id="alg1.l11.m2" class="ltx_math_unparsed" alttext="\mathbf{a}_{i}(0)\sim\pi_{i}^{\theta_{i}(k)}(\cdot\mid\mathbf{s}^{\circ}_{\mathcal{N}_{i}}(0),\hat{\boldsymbol{\omega}}^{\circ}_{\mathcal{N}_{i}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>∼</mo><msubsup><mi>π</mi><mi>i</mi><mrow><msub><mi>θ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><msubsup><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{a}_{i}(0)\sim\pi_{i}^{\theta_{i}(k)}(\cdot\mid\mathbf{s}^{\circ}_{\mathcal{N}_{i}}(0),\hat{\boldsymbol{\omega}}^{\circ}_{\mathcal{N}_{i}})</annotation></semantics></math>, and receive reward <math id="alg1.l11.m3" class="ltx_Math" alttext="r_{i}(0)" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r_{i}(0)</annotation></semantics></math>

</div>
<div id="alg1.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
              
              
              Initialize critic <math id="alg1.l12.m1" class="ltx_Math" alttext="\hat{Q}_{i}^{0}\in\mathbb{R}^{\mathcal{S}^{\circ}_{\mathcal{N}_{i}^{\kappa}}\times\mathcal{A}_{\mathcal{N}_{i}^{\kappa}}\times\Omega^{\circ}_{\mathcal{N}_{i}^{\kappa}}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mi>i</mi><mn>0</mn></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi mathvariant="normal">Ω</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup></mrow></msup></mrow><annotation encoding="application/x-tex">\hat{Q}_{i}^{0}\in\mathbb{R}^{\mathcal{S}^{\circ}_{\mathcal{N}_{i}^{\kappa}}\times\mathcal{A}_{\mathcal{N}_{i}^{\kappa}}\times\Omega^{\circ}_{\mathcal{N}_{i}^{\kappa}}}</annotation></semantics></math> to be all zeros

</div>
<div id="alg1.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
              
              
              <span id="alg1.l13.3" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l13.m1" class="ltx_Math" alttext="t=1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=1</annotation></semantics></math> to <math id="alg1.l13.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> <span id="alg1.l13.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
              
              
               Get state <math id="alg1.l14.m1" class="ltx_Math" alttext="\mathbf{s}_{i}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐬</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}_{i}(t)</annotation></semantics></math>, take action <math id="alg1.l14.m2" class="ltx_math_unparsed" alttext="\mathbf{a}_{i}(t)\sim\pi_{i}^{\theta_{i}(k)}(\cdot\mid\mathbf{s}^{\circ}_{\mathcal{N}_{i}}(t),\hat{\boldsymbol{\omega}}^{\circ}_{\mathcal{N}_{i}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>∼</mo><msubsup><mi>π</mi><mi>i</mi><mrow><msub><mi>θ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msubsup><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>∘</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{a}_{i}(t)\sim\pi_{i}^{\theta_{i}(k)}(\cdot\mid\mathbf{s}^{\circ}_{\mathcal{N}_{i}}(t),\hat{\boldsymbol{\omega}}^{\circ}_{\mathcal{N}_{i}})</annotation></semantics></math>, get reward <math id="alg1.l14.m3" class="ltx_Math" alttext="r_{i}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r_{i}(t)</annotation></semantics></math>

</div>
<div id="alg1.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
              
              
               Update <math id="alg1.l15.m1" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>-function with stepsize <math id="alg1.l15.m2" class="ltx_Math" alttext="\alpha_{t-1}\leftarrow\frac{h}{t-1+t_{0}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">←</mo><mfrac><mi>h</mi><mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo>+</mo><msub><mi>t</mi><mn>0</mn></msub></mrow></mfrac></mrow><annotation encoding="application/x-tex">\alpha_{t-1}\leftarrow\frac{h}{t-1+t_{0}}</annotation></semantics></math>:

<table id="S4.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex4.m1" class="ltx_Math" alttext="\displaystyle\hat{Q}_{i}^{t}(\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}}(t{-}1),\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}(t{-}1),\hat{\boldsymbol{\omega}}^{\circ}_{\mathcal{N}_{i}^{\kappa}})\leftarrow(1-\alpha_{t-1})\hat{Q}_{i}^{t{-}1}(\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}}(t{-}1),\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}(t{-}1),\hat{\boldsymbol{\omega}}^{\circ}_{\mathcal{N}_{i}^{\kappa}})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mi>i</mi><mi>t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msubsup><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mi>i</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐬</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msubsup><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup><mo>∘</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{Q}_{i}^{t}(\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}}(t{-}1),\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}(t{-}1),\hat{\boldsymbol{\omega}}^{\circ}_{\mathcal{N}_{i}^{\kappa}})\leftarrow(1-\alpha_{t-1})\hat{Q}_{i}^{t{-}1}(\mathbf{s}^{\circ}_{\mathcal{N}_{i}^{\kappa}}(t{-}1),\mathbf{a}_{\mathcal{N}_{i}^{\kappa}}(t{-}1),\hat{\boldsymbol{\omega}}^{\circ}_{\mathcal{N}_{i}^{\kappa}})</annotation></semantics></math></td>
