<div id="alg4.l39" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l39.1" class="ltx_text" style="font-size:80%;">39:</span></span>
              
              
            Collect few trajectories <math id="alg4.l39.m1" class="ltx_Math" alttext="\tau^{M+1}=\{(\mathbf{s}(t),\mathbf{a}(t),\mathbf{s}(t+1))\}_{t=0}^{T_{a}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>τ</mi><mrow><mi>M</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐚</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><msub><mi>T</mi><mi>a</mi></msub></msubsup></mrow><annotation encoding="application/x-tex">\tau^{M+1}=\{(\mathbf{s}(t),\mathbf{a}(t),\mathbf{s}(t+1))\}_{t=0}^{T_{a}}</annotation></semantics></math> in the new domain

</div>
<div id="alg4.l40" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l40.1" class="ltx_text" style="font-size:80%;">40:</span></span>
              
              
            <span id="alg4.l40.3" class="ltx_text ltx_font_bold">for</span> each agent <math id="alg4.l40.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> <span id="alg4.l40.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg4.l41" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l41.1" class="ltx_text" style="font-size:80%;">41:</span></span>
              
              
              Infer domain factor <math id="alg4.l41.m1" class="ltx_Math" alttext="\hat{\boldsymbol{\omega}}_{i}^{M+1}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mi>i</mi><mrow><mi>M</mi><mo>+</mo><mn>1</mn></mrow></msubsup><annotation encoding="application/x-tex">\hat{\boldsymbol{\omega}}_{i}^{M+1}</annotation></semantics></math>

</div>
<div id="alg4.l42" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l42.1" class="ltx_text" style="font-size:80%;">42:</span></span>
              
              
              Deploy policy <math id="alg4.l42.m1" class="ltx_math_unparsed" alttext="\pi^{\theta(K)}_{i}(\cdot|\mathbf{s}^{\circ}_{i},\hat{\boldsymbol{\omega}}^{M+1,\circ}_{i})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>π</mi><mi>i</mi><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>𝐬</mi><mi>i</mi><mo>∘</mo></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mi>i</mi><mrow><mrow><mi>M</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0em">,</mo><mo lspace="0em">∘</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi^{\theta(K)}_{i}(\cdot|\mathbf{s}^{\circ}_{i},\hat{\boldsymbol{\omega}}^{M+1,\circ}_{i})</annotation></semantics></math>

</div>
<div id="alg4.l43" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l43.1" class="ltx_text" style="font-size:80%;">43:</span></span>
              
              
            <span id="alg4.l43.3" class="ltx_text ltx_font_bold">end</span> <span id="alg4.l43.4" class="ltx_text ltx_font_bold">for</span>
</div>
</div>
</figure>
</section>
<section id="A4.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.4 </span>ACR-free GSAC</h3>

<div id="A4.SS4.p1" class="ltx_para">
<p id="A4.SS4.p1.1" class="ltx_p">We provide the complete pseudo-code of <span id="A4.SS4.p1.1.1" class="ltx_text ltx_font_typewriter">ACR-free GSAC</span> in Algorithm <a href="#alg5" title="Algorithm 5 ‣ D.4 ACR-free GSAC ‣ Appendix D Algorithm design ‣ Causality Meets Locality: Provably Generalizable and Scalable Policy Learning for Networked Systems" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>.</p>
</div>
<figure id="alg5" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg5.4" class="ltx_text ltx_font_bold">Algorithm 5</span> </span> <span id="alg5.5" class="ltx_text ltx_font_smallcaps">Generalizable and Scalable Actor-critic without ACR</span></figcaption>
<div id="alg5.6" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg5.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
            <span id="alg5.l1.3" class="ltx_text ltx_font_bold">Input:</span> <math id="alg5.l1.m1" class="ltx_Math" alttext="\theta_{i}(0)" display="inline" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\theta_{i}(0)</annotation></semantics></math>; parameter <math id="alg5.l1.m2" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>; <math id="alg5.l1.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, length of each episode; stepsize parameters <math id="alg5.l1.m4" class="ltx_Math" alttext="h,t_{0},\eta" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>,</mo><msub><mi>t</mi><mn>0</mn></msub><mo>,</mo><mi>η</mi></mrow><annotation encoding="application/x-tex">h,t_{0},\eta</annotation></semantics></math>.

</div>
<div id="alg5.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
            // <span id="alg5.l2.3" class="ltx_text ltx_font_italic">Phase 1: domain estimation</span>

</div>
<div id="alg5.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
            <span id="alg5.l3.3" class="ltx_text ltx_font_bold">for</span> source domain index <math id="alg5.l3.m1" class="ltx_Math" alttext="m=1,2,\dots,M" display="inline" intent=":literal"><semantics><mrow><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">m=1,2,\dots,M</annotation></semantics></math> <span id="alg5.l3.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg5.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
              Sample <math id="alg5.l4.m1" class="ltx_Math" alttext="\boldsymbol{\omega}^{m}\sim\mathcal{D}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝝎</mi><mi>m</mi></msup><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow><annotation encoding="application/x-tex">\boldsymbol{\omega}^{m}\sim\mathcal{D}</annotation></semantics></math>

</div>
<div id="alg5.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
              Collect trajectories <math id="alg5.l5.m1" class="ltx_Math" alttext="\tau^{m}=\left(\mathbf{s}^{m}(t),\mathbf{a}^{m}(t),r^{m}(t),\mathbf{s}^{m}(t+1)\right)_{t=1}^{T_{e}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>τ</mi><mi>m</mi></msup><mo>=</mo><msubsup><mrow><mo>(</mo><mrow><msup><mi>𝐬</mi><mi>m</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>𝐚</mi><mi>m</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>r</mi><mi>m</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>𝐬</mi><mi>m</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>T</mi><mi>e</mi></msub></msubsup></mrow><annotation encoding="application/x-tex">\tau^{m}=\left(\mathbf{s}^{m}(t),\mathbf{a}^{m}(t),r^{m}(t),\mathbf{s}^{m}(t+1)\right)_{t=1}^{T_{e}}</annotation></semantics></math>

</div>
<div id="alg5.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
              
              
              Split <math id="alg5.l6.m1" class="ltx_Math" alttext="\tau^{m}" display="inline" intent=":literal"><semantics><msup><mi>τ</mi><mi>m</mi></msup><annotation encoding="application/x-tex">\tau^{m}</annotation></semantics></math> into <math id="alg5.l6.m2" class="ltx_Math" alttext="\tau^{m}_{i}=\left(\mathbf{s}^{m}_{\mathcal{N}_{i}}(t),\mathbf{a}^{m}_{i}(t),r_{i}(t),\mathbf{s}^{m}_{i}(t+1)\right)_{t=1}^{T_{e}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>τ</mi><mi>i</mi><mi>m</mi></msubsup><mo>=</mo><msubsup><mrow><mo>(</mo><mrow><msubsup><mi>𝐬</mi><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mi>m</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>𝐚</mi><mi>i</mi><mi>m</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>r</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mi>m</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>T</mi><mi>e</mi></msub></msubsup></mrow><annotation encoding="application/x-tex">\tau^{m}_{i}=\left(\mathbf{s}^{m}_{\mathcal{N}_{i}}(t),\mathbf{a}^{m}_{i}(t),r_{i}(t),\mathbf{s}^{m}_{i}(t+1)\right)_{t=1}^{T_{e}}</annotation></semantics></math> for each agent <math id="alg5.l6.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>

</div>
<div id="alg5.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
              
              
              Each agent <math id="alg5.l7.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> estimate the domain factor <math id="alg5.l7.m2" class="ltx_Math" alttext="\hat{\boldsymbol{\omega}}^{m}_{i}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mi>i</mi><mi>m</mi></msubsup><annotation encoding="application/x-tex">\hat{\boldsymbol{\omega}}^{m}_{i}</annotation></semantics></math>

</div>
<div id="alg5.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
              
              
            <span id="alg5.l8.3" class="ltx_text ltx_font_bold">end</span> <span id="alg5.l8.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg5.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
              
              
            // <span id="alg5.l9.3" class="ltx_text ltx_font_italic">Phase 2: meta-learning</span>

</div>
<div id="alg5.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
              
              
            <span id="alg5.l10.3" class="ltx_text ltx_font_bold">for</span> <math id="alg5.l10.m1" class="ltx_Math" alttext="k=0,1,2,\dots,K-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">k=0,1,2,\dots,K-1</annotation></semantics></math> <span id="alg5.l10.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg5.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
              
              
              Sample domain index <math id="alg5.l11.m1" class="ltx_Math" alttext="m(k)" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">m(k)</annotation></semantics></math> uniformly from <math id="alg5.l11.m2" class="ltx_Math" alttext="\{1,\dots,K\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>K</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{1,\dots,K\}</annotation></semantics></math>

</div>
<div id="alg5.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
              
              
              Set <math id="alg5.l12.m1" class="ltx_Math" alttext="\hat{\boldsymbol{\omega}}=\hat{\boldsymbol{\omega}}^{m(k)}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mo>=</mo><msup><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\hat{\boldsymbol{\omega}}=\hat{\boldsymbol{\omega}}^{m(k)}</annotation></semantics></math> <span id="alg5.l12.3" class="ltx_text" style="float:right;"><math id="alg5.l12.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Current domain factors
</span>
</div>
<div id="alg5.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
              
              
              Sample initial state <math id="alg5.l13.m1" class="ltx_Math" alttext="\mathbf{s}(0)\sim\rho_{0}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>∼</mo><msub><mi>ρ</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\mathbf{s}(0)\sim\rho_{0}</annotation></semantics></math>

</div>
<div id="alg5.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
              
              
              <span id="alg5.l14.3" class="ltx_text ltx_font_bold">for</span> each agent <math id="alg5.l14.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> <span id="alg5.l14.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg5.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
              
              
               Take action <math id="alg5.l15.m1" class="ltx_math_unparsed" alttext="\mathbf{a}_{i}(0)\sim\pi_{i}^{\theta_{i}(k)}(\cdot\mid\mathbf{s}_{i}(0),\hat{\boldsymbol{\omega}}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>∼</mo><msubsup><mi>π</mi><mi>i</mi><mrow><msub><mi>θ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝐬</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mover accent="true"><mi>𝝎</mi><mo>^</mo></mover><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{a}_{i}(0)\sim\pi_{i}^{\theta_{i}(k)}(\cdot\mid\mathbf{s}_{i}(0),\hat{\boldsymbol{\omega}}_{i})</annotation></semantics></math>

</div>
<div id="alg5.l16" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
              
              
               Receive reward <math id="alg5.l16.m1" class="ltx_Math" alttext="r_{i}(0)=r_{i}(\mathbf{s}_{i}(0),\mathbf{a}_{i}(0))" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>r</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>r</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐬</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r_{i}(0)=r_{i}(\mathbf{s}_{i}(0),\mathbf{a}_{i}(0))</annotation></semantics></math>

</div>
<div id="alg5.l17" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l17.1" class="ltx_text" style="font-size:80%;">17:</span></span>
              
              
               Initialize critic <math id="alg5.l17.m1" class="ltx_Math" alttext="\hat{Q}_{i}^{0}\in\mathbb{R}^{\mathcal{S}_{\mathcal{N}_{i}^{\kappa}}\times\mathcal{A}_{\mathcal{N}_{i}^{\kappa}}\times\Omega_{\mathcal{N}_{i}^{\kappa}}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mi>i</mi><mn>0</mn></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi mathvariant="normal">Ω</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi><mi>κ</mi></msubsup></msub></mrow></msup></mrow><annotation encoding="application/x-tex">\hat{Q}_{i}^{0}\in\mathbb{R}^{\mathcal{S}_{\mathcal{N}_{i}^{\kappa}}\times\mathcal{A}_{\mathcal{N}_{i}^{\kappa}}\times\Omega_{\mathcal{N}_{i}^{\kappa}}}</annotation></semantics></math> to zero

</div>
<div id="alg5.l18" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l18.1" class="ltx_text" style="font-size:80%;">18:</span></span>
              
              
              <span id="alg5.l18.3" class="ltx_text ltx_font_bold">end</span> <span id="alg5.l18.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg5.l19" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l19.1" class="ltx_text" style="font-size:80%;">19:</span></span>
              
              
              <span id="alg5.l19.3" class="ltx_text ltx_font_bold">for</span> <math id="alg5.l19.m1" class="ltx_Math" alttext="t=1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=1</annotation></semantics></math> to <math id="alg5.l19.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> <span id="alg5.l19.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg5.l20" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l20.1" class="ltx_text" style="font-size:80%;">20:</span></span>
              
              
               <span id="alg5.l20.3" class="ltx_text ltx_font_bold">for</span> each agent <math id="alg5.l20.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> <span id="alg5.l20.4" class="ltx_text ltx_font_bold">do</span>

</div>
