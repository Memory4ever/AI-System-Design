<th id="S4.T2.2.1.3" class="ltx_td ltx_th ltx_th_column ltx_border_tt"></th>
<th id="S4.T2.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="3"><span id="S4.T2.2.1.4.1" class="ltx_text ltx_font_bold">Stereotype Slope</span></th></tr>
