<span id="S4.T5.2.1.1.1.1.1.1.17.2" class="ltx_td ltx_align_right"><math id="S4.T5.m75" class="ltx_Math" alttext="-0.81" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>0.81</mn></mrow><annotation encoding="application/x-tex">-0.81</annotation></semantics></math></span>
