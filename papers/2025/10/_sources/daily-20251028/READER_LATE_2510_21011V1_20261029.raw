<span id="S4.T4.2.1.1.1.1.1.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column"><span id="S4.T4.2.1.1.1.1.1.1.2.2.1" class="ltx_text ltx_font_bold">Group</span></span>
<span id="S4.T4.2.1.1.1.1.1.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="S4.T4.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math><span id="S4.T4.2.1.1.1.1.1.1.2.3.1" class="ltx_text ltx_font_bold"> (logit)</span></span>
<span id="S4.T4.2.1.1.1.1.1.1.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S4.T4.2.1.1.1.1.1.1.2.4.1" class="ltx_text ltx_font_bold">Systematic shift (pp)</span></span>
<span id="S4.T4.2.1.1.1.1.1.1.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S4.T4.2.1.1.1.1.1.1.2.5.1" class="ltx_text ltx_font_bold">Interpretation</span></span>
