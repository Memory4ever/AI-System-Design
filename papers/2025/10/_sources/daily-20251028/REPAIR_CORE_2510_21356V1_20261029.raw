<th id="A1.T7.2.13.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T7.m22" class="ltx_Math" alttext="\eta_{\text{observed}}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mtext>observed</mtext></msub><annotation encoding="application/x-tex">\eta_{\text{observed}}</annotation></semantics></math></th>
<td id="A1.T7.2.13.2" class="ltx_td ltx_align_left">Proportion of pixels with flow discrepancy <math id="A1.T7.m23" class="ltx_Math" alttext="&gt;\epsilon" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>&gt;</mo><mi>ϵ</mi></mrow><annotation encoding="application/x-tex">&gt;\epsilon</annotation></semantics></math></td></tr>
<tr id="A1.T7.2.14" class="ltx_tr">
<th id="A1.T7.2.14.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T7.m24" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math></th>
<td id="A1.T7.2.14.2" class="ltx_td ltx_align_left">Threshold for pixel-level flow discrepancy</td></tr>
<tr id="A1.T7.2.15" class="ltx_tr">
<th id="A1.T7.2.15.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T7.m25" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math></th>
<td id="A1.T7.2.15.2" class="ltx_td ltx_align_left">Threshold for deciding major occlusion (set to 60%)</td></tr>
