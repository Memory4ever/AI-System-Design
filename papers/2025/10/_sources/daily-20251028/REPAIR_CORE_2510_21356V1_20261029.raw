<th id="A1.T7.2.16.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><math id="A1.T7.m26" class="ltx_Math" alttext="o_{\tau}" display="inline" intent=":literal"><semantics><msub><mi>o</mi><mi>τ</mi></msub><annotation encoding="application/x-tex">o_{\tau}</annotation></semantics></math></th>
<td id="A1.T7.2.16.2" class="ltx_td ltx_align_left ltx_border_bb">Binary occlusion validity flag for frame <math id="A1.T7.m27" class="ltx_Math" alttext="I_{\tau}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>τ</mi></msub><annotation encoding="application/x-tex">I_{\tau}</annotation></semantics></math></td></tr>
