<td id="A1.T14.2.4.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="A1.T14.2.4.2.1" class="ltx_text ltx_font_bold">0.7505</span></td>
<td id="A1.T14.2.4.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="A1.T14.2.4.3.1" class="ltx_text ltx_font_bold">0.5173</span></td></tr>
</tbody>
