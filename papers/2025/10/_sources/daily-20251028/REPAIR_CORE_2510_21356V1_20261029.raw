<thead class="ltx_thead">
<tr id="A1.T7.2.1" class="ltx_tr">
<th id="A1.T7.2.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="A1.T7.2.1.1.1" class="ltx_text ltx_font_bold">Symbol</span></th>
<th id="A1.T7.2.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="A1.T7.2.1.2.1" class="ltx_text ltx_font_bold">Description</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A1.T7.2.2" class="ltx_tr">
<th id="A1.T7.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><math id="A1.T7.m1" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math></th>
<td id="A1.T7.2.2.2" class="ltx_td ltx_align_left ltx_border_t">Timestamp of current frame</td></tr>
