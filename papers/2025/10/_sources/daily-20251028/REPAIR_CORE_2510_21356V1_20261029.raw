<th id="A1.T7.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T7.m3" class="ltx_Math" alttext="I_{t}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>t</mi></msub><annotation encoding="application/x-tex">I_{t}</annotation></semantics></math></th>
