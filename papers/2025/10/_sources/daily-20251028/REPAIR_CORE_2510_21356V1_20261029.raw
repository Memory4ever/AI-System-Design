<td id="A1.T7.2.8.2" class="ltx_td ltx_align_left">Forward optical flow from frame <math id="A1.T7.m12" class="ltx_Math" alttext="I_{\tau}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>τ</mi></msub><annotation encoding="application/x-tex">I_{\tau}</annotation></semantics></math> to <math id="A1.T7.m13" class="ltx_Math" alttext="I_{t}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>t</mi></msub><annotation encoding="application/x-tex">I_{t}</annotation></semantics></math></td></tr>
<tr id="A1.T7.2.9" class="ltx_tr">
<th id="A1.T7.2.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T7.m14" class="ltx_Math" alttext="f_{t\rightarrow\tau}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi>t</mi><mo stretchy="false">→</mo><mi>τ</mi></mrow></msub><annotation encoding="application/x-tex">f_{t\rightarrow\tau}</annotation></semantics></math></th>
<td id="A1.T7.2.9.2" class="ltx_td ltx_align_left">Backward optical flow from <math id="A1.T7.m15" class="ltx_Math" alttext="I_{t}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>t</mi></msub><annotation encoding="application/x-tex">I_{t}</annotation></semantics></math> to <math id="A1.T7.m16" class="ltx_Math" alttext="I_{\tau}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>τ</mi></msub><annotation encoding="application/x-tex">I_{\tau}</annotation></semantics></math></td></tr>
<tr id="A1.T7.2.10" class="ltx_tr">
<th id="A1.T7.2.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T7.m17" class="ltx_Math" alttext="\mathbf{p}" display="inline" intent=":literal"><semantics><mi>𝐩</mi><annotation encoding="application/x-tex">\mathbf{p}</annotation></semantics></math></th>
<td id="A1.T7.2.10.2" class="ltx_td ltx_align_left">Designated pixel location in image <math id="A1.T7.m18" class="ltx_Math" alttext="I_{\tau}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>τ</mi></msub><annotation encoding="application/x-tex">I_{\tau}</annotation></semantics></math></td></tr>
<tr id="A1.T7.2.11" class="ltx_tr">
<th id="A1.T7.2.11.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T7.m19" class="ltx_Math" alttext="\hat{\mathbf{p}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝐩</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\mathbf{p}}</annotation></semantics></math></th>
<td id="A1.T7.2.11.2" class="ltx_td ltx_align_left">Translated pixel location in <math id="A1.T7.m20" class="ltx_Math" alttext="I_{t}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>t</mi></msub><annotation encoding="application/x-tex">I_{t}</annotation></semantics></math> using forward flow</td></tr>
<tr id="A1.T7.2.12" class="ltx_tr">
<th id="A1.T7.2.12.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T7.m21" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math></th>
<td id="A1.T7.2.12.2" class="ltx_td ltx_align_left">Discrepancy between forward and backward flow vectors</td></tr>
