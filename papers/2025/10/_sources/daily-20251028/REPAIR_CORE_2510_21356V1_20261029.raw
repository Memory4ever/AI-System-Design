<td id="A1.T14.2.3.2" class="ltx_td ltx_align_center"><span id="A1.T14.2.3.2.1" class="ltx_text ltx_font_smallcaps">0.6701</span></td>
<td id="A1.T14.2.3.3" class="ltx_td ltx_align_center"><span id="A1.T14.2.3.3.1" class="ltx_text ltx_font_smallcaps">0.4393</span></td></tr>
