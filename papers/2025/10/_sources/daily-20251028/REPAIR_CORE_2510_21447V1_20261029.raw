<th id="S4.T5.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">CD<math id="S4.T5.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></th>
