<tr id="S3.T2.2.9.5.1.1" class="ltx_tr">
<td id="S3.T2.2.9.5.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left"><span id="S3.T2.2.9.5.1.1.1.1" class="ltx_text" style="font-size:70%;">output: <span id="S3.T2.2.9.5.1.1.1.1.1" class="ltx_text" style="--ltx-bg-color:#CCD9FF;">Proud Poor</span></span></td></tr>
