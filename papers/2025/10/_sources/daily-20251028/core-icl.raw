<tbody id="A3.E22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E22.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{\{\mathcal{S}_{t}\}}\Pr_{x\sim\mathcal{D}_{0}}[\mathcal{M}(\mathcal{S}_{0};\mathcal{S}_{1},\ldots,\mathcal{S}_{T})(x)\neq f_{0}(x)]." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mo stretchy="false">{</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow></msub><munder><mi>Pr</mi><mrow><mi>x</mi><mo>∼</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>0</mn></msub></mrow></munder><mrow><mo stretchy="false">[</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mn>0</mn></msub><mo>;</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>≠</mo><msub><mi>f</mi><mn>0</mn></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\{\mathcal{S}_{t}\}}\Pr_{x\sim\mathcal{D}_{0}}[\mathcal{M}(\mathcal{S}_{0};\mathcal{S}_{1},\ldots,\mathcal{S}_{T})(x)\neq f_{0}(x)].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
</table>
<p id="A3.p8.3" class="ltx_p"><span id="A3.p8.3.1" class="ltx_text">Combining the above two inequalities, we have</span></p>
<table id="A3.EGx11" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E23.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}_{\{\mathcal{S}_{t}\}}\Pr_{x\sim\mathcal{D}_{0}}[\mathcal{M}(\mathcal{S}_{0};\mathcal{S}_{1},\ldots,\mathcal{S}_{T})(x)\neq f_{0}(x)]\geq\frac{T-1}{T+1}\Delta." display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mo stretchy="false">{</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow></msub><munder><mi>Pr</mi><mrow><mi>x</mi><mo>∼</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>0</mn></msub></mrow></munder><mrow><mo stretchy="false">[</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mn>0</mn></msub><mo>;</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>≠</mo><msub><mi>f</mi><mn>0</mn></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>≥</mo><mstyle displaystyle="true"><mfrac><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mstyle><mi mathvariant="normal">Δ</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\{\mathcal{S}_{t}\}}\Pr_{x\sim\mathcal{D}_{0}}[\mathcal{M}(\mathcal{S}_{0};\mathcal{S}_{1},\ldots,\mathcal{S}_{T})(x)\neq f_{0}(x)]\geq\frac{T-1}{T+1}\Delta.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
</table>
<p id="A3.p8.4" class="ltx_p"><span id="A3.p8.4.1" class="ltx_text">This finishes the proof.
∎</span></p>
</div>
</div>
<div id="Thmtheorem2" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem2.2" class="ltx_text ltx_font_bold">Theorem 2</span></span><span id="Thmtheorem2.3" class="ltx_text ltx_font_bold"> </span>(Restatement of Theorem <a href="#Thmtheorem1" title="Theorem 1. ‣ 4 Theoretical Analysis ‣ Can Language Models Compose Skills In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>)<span id="Thmtheorem2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem2.p1" class="ltx_para">
<p id="Thmtheorem2.p1.1" class="ltx_p"><span id="Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Suppose we are given <math id="Thmtheorem2.p1.m1" class="ltx_Math" alttext="k_{t}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>t</mi></msub><annotation encoding="application/x-tex">k_{t}</annotation></semantics></math> examples <math id="Thmtheorem2.p1.m2" class="ltx_Math" alttext="\mathcal{S}_{t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathcal{S}_{t}</annotation></semantics></math> from <math id="Thmtheorem2.p1.m3" class="ltx_Math" alttext="(\mathcal{D}_{t},f_{t})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>t</mi></msub><mo>,</mo><msub><mi>f</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{D}_{t},f_{t})</annotation></semantics></math> for <math id="Thmtheorem2.p1.m4" class="ltx_Math" alttext="t\in[T]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[T]</annotation></semantics></math> and <math id="Thmtheorem2.p1.m5" class="ltx_Math" alttext="k_{c}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>c</mi></msub><annotation encoding="application/x-tex">k_{c}</annotation></semantics></math> examples <math id="Thmtheorem2.p1.m6" class="ltx_Math" alttext="\mathcal{S}_{0}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\mathcal{S}_{0}</annotation></semantics></math> from <math id="Thmtheorem2.p1.m7" class="ltx_Math" alttext="(\mathcal{D}_{0},f_{0})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>0</mn></msub><mo>,</mo><msub><mi>f</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{D}_{0},f_{0})</annotation></semantics></math> with <math id="Thmtheorem2.p1.m8" class="ltx_Math" alttext="f_{0}=f_{T}\circ\ldots\circ f_{2}\circ f_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>0</mn></msub><mo>=</mo><mrow><msub><mi>f</mi><mi>T</mi></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi mathvariant="normal">…</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>f</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">f_{0}=f_{T}\circ\ldots\circ f_{2}\circ f_{1}</annotation></semantics></math>.
Suppose <math id="Thmtheorem2.p1.m9" class="ltx_Math" alttext="\mathcal{H}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">\mathcal{H}</annotation></semantics></math> is distinguishable: for some <math id="Thmtheorem2.p1.m10" class="ltx_Math" alttext="\epsilon_{0}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϵ</mi><mn>0</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon_{0}&gt;0</annotation></semantics></math>, for any <math id="Thmtheorem2.p1.m11" class="ltx_Math" alttext="f\neq g\in\mathcal{H}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>≠</mo><mi>g</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow><annotation encoding="application/x-tex">f\neq g\in\mathcal{H}</annotation></semantics></math> and <math id="Thmtheorem2.p1.m12" class="ltx_Math" alttext="\mathcal{D}_{t}(0\leq t\leq T)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>0</mn><mo>≤</mo><mi>t</mi><mo>≤</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{D}_{t}(0\leq t\leq T)</annotation></semantics></math>, <math id="Thmtheorem2.p1.m13" class="ltx_math_unparsed" alttext="\Pr_{x\sim\mathcal{D}_{t}}[f(x)\neq g(x)]&gt;\epsilon_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Pr</mi><mrow><mi>x</mi><mo>∼</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>t</mi></msub></mrow></msub><mrow><mo stretchy="false">[</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>≠</mo><mi>g</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>&gt;</mo><msub><mi>ϵ</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\Pr_{x\sim\mathcal{D}_{t}}[f(x)\neq g(x)]&gt;\epsilon_{0}</annotation></semantics></math>.
There exists a learning rule <math id="Thmtheorem2.p1.m14" class="ltx_Math" alttext="\mathcal{M}:((\mathcal{X}\times\Sigma^{*})^{*})^{T+1}\rightarrow\Sigma^{\mathcal{X}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi mathvariant="normal">Σ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></msup><mo stretchy="false">→</mo><msup><mi mathvariant="normal">Σ</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\mathcal{M}:((\mathcal{X}\times\Sigma^{*})^{*})^{T+1}\rightarrow\Sigma^{\mathcal{X}}</annotation></semantics></math> such that for every <math id="Thmtheorem2.p1.m15" class="ltx_Math" alttext="0&lt;\delta&lt;1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>δ</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0&lt;\delta&lt;1</annotation></semantics></math>, if</span></p>
<table id="A3.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex2.m1" class="ltx_Math" alttext="\max(k_{c},k_{t})\geq\frac{2}{\epsilon_{0}}\left(\ln|\mathcal{H}|+\ln\frac{T}{\delta}\right),\quad\forall t\in[T]," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mi>c</mi></msub><mo>,</mo><msub><mi>k</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mfrac><mn>2</mn><msub><mi>ϵ</mi><mn>0</mn></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mfrac><mi>T</mi><mi>δ</mi></mfrac></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>t</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\max(k_{c},k_{t})\geq\frac{2}{\epsilon_{0}}\left(\ln|\mathcal{H}|+\ln\frac{T}{\delta}\right),\quad\forall t\in[T],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem2.p1.2" class="ltx_p"><span id="Thmtheorem2.p1.2.1" class="ltx_text ltx_font_italic">then with probability at least <math id="Thmtheorem2.p1.m16" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math> over <math id="Thmtheorem2.p1.m17" class="ltx_Math" alttext="\{\mathcal{S}_{t}\}_{t=0}^{T}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mi>T</mi></msubsup><annotation encoding="application/x-tex">\{\mathcal{S}_{t}\}_{t=0}^{T}</annotation></semantics></math>, we have <math id="Thmtheorem2.p1.m18" class="ltx_Math" alttext="\mathcal{M}(\mathcal{S}_{0};\mathcal{S}_{1},\ldots,\mathcal{S}_{T})=f_{0}" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mn>0</mn></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>f</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\mathcal{M}(\mathcal{S}_{0};\mathcal{S}_{1},\ldots,\mathcal{S}_{T})=f_{0}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A3.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.p9" class="ltx_para">
<p id="A3.p9.1" class="ltx_p"><span id="A3.p9.1.1" class="ltx_text">Consider each step <math id="A3.p9.m1" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> in the composition, which can be learned by the examples from this simple task and the corresponding intermediate outputs from the composite task examples. This high-level idea is similar to that in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib5" title="" class="ltx_ref">5</a>, <a href="#bib.bib28" title="" class="ltx_ref">28</a>]</cite>, but our setting is quite different, e.g., we have examples for each single step of the composition.</span></p>
</div>
<div id="A3.p10" class="ltx_para">
<p id="A3.p10.1" class="ltx_p"><span id="A3.p10.1.1" class="ltx_text">More precisely, for learning <math id="A3.p10.m1" class="ltx_Math" alttext="f_{t}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>t</mi></msub><annotation encoding="application/x-tex">f_{t}</annotation></semantics></math>, we have <math id="A3.p10.m2" class="ltx_Math" alttext="\mathcal{S}_{t}=\{(x_{i},y_{i}):i\in[k_{t}]\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>t</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>k</mi><mi>t</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{S}_{t}=\{(x_{i},y_{i}):i\in[k_{t}]\}</annotation></semantics></math> from the simple task, and <math id="A3.p10.m3" class="ltx_Math" alttext="\mathcal{S}_{0,t}=\{(z^{t}_{i},z^{t+1}_{i}):i\in[k_{c}]\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mn>0</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>z</mi><mi>i</mi><mi>t</mi></msubsup><mo>,</mo><msubsup><mi>z</mi><mi>i</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>k</mi><mi>c</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{S}_{0,t}=\{(z^{t}_{i},z^{t+1}_{i}):i\in[k_{c}]\}</annotation></semantics></math> from the composite task CoT examples. Output a model consistent with all these data:</span></p>
<table id="A3.EGx12" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E24.m1" class="ltx_math_unparsed" alttext="\displaystyle\hat{f}_{t}\in\{g\in\mathcal{H}:g(x)=y,\forall(x,y)\in\mathcal{S}_{t}\cup\mathcal{S}_{0,t}\}." display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>f</mi><mo>^</mo></mover><mi>t</mi></msub><mo>∈</mo><mrow><mo stretchy="false">{</mo><mi>g</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>g</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>y</mi><mo>,</mo><mo>∀</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>t</mi></msub><mo>∪</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mn>0</mn><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\hat{f}_{t}\in\{g\in\mathcal{H}:g(x)=y,\forall(x,y)\in\mathcal{S}_{t}\cup\mathcal{S}_{0,t}\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
<p id="A3.p10.2" class="ltx_p"><span id="A3.p10.2.1" class="ltx_text">For a fixed <math id="A3.p10.m4" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> with <math id="A3.p10.m5" class="ltx_math_unparsed" alttext="\Pr_{x\sim\mathcal{D}_{t}}[g(x)\neq f_{t}(x)]&gt;\epsilon_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Pr</mi><mrow><mi>x</mi><mo>∼</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>t</mi></msub></mrow></msub><mrow><mo stretchy="false">[</mo><mi>g</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>≠</mo><msub><mi>f</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>&gt;</mo><msub><mi>ϵ</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\Pr_{x\sim\mathcal{D}_{t}}[g(x)\neq f_{t}(x)]&gt;\epsilon_{0}</annotation></semantics></math>, we have</span></p>
<table id="A3.EGx13" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E25.m1" class="ltx_math_unparsed" alttext="\displaystyle\Pr[g(x)=y,\forall(x,y)\in\mathcal{S}_{t}]\leq(1-\epsilon_{0})^{k_{t}}." display="inline" intent=":literal"><semantics><mrow><mi>Pr</mi><mrow><mo stretchy="false">[</mo><mi>g</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>y</mi><mo>,</mo><mo>∀</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>t</mi></msub><mo stretchy="false">]</mo></mrow><mo>≤</mo><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><msub><mi>ϵ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><msub><mi>k</mi><mi>t</mi></msub></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Pr[g(x)=y,\forall(x,y)\in\mathcal{S}_{t}]\leq(1-\epsilon_{0})^{k_{t}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
<p id="A3.p10.3" class="ltx_p"><span id="A3.p10.3.1" class="ltx_text">So</span></p>
<table id="A3.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E26.m1" class="ltx_math_unparsed" alttext="\displaystyle\Pr[\exists g\in\mathcal{H}^{T},g(x)=y,\forall(x,y)\in\mathcal{S}_{c}]\leq|\mathcal{H}|(1-\epsilon_{0})^{k_{t}}." display="inline" intent=":literal"><semantics><mrow><mi>Pr</mi><mrow><mo stretchy="false">[</mo><mo rspace="0.167em">∃</mo><mi>g</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>T</mi></msup><mo>,</mo><mi>g</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>y</mi><mo>,</mo><mo>∀</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>c</mi></msub><mo stretchy="false">]</mo></mrow><mo rspace="0em">≤</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><msub><mi>ϵ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><msub><mi>k</mi><mi>t</mi></msub></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Pr[\exists g\in\mathcal{H}^{T},g(x)=y,\forall(x,y)\in\mathcal{S}_{c}]\leq|\mathcal{H}|(1-\epsilon_{0})^{k_{t}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
</table>
<p id="A3.p10.4" class="ltx_p"><span id="A3.p10.4.1" class="ltx_text">Letting the right-hand side bounded by <math id="A3.p10.m6" class="ltx_Math" alttext="\delta/T" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>/</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">\delta/T</annotation></semantics></math>, we know that if</span></p>
<table id="A3.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E27.m1" class="ltx_Math" alttext="\displaystyle k_{t}\geq\frac{1}{\epsilon_{0}}\left(\ln|\mathcal{H}|+\ln\frac{T}{\delta}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>k</mi><mi>t</mi></msub><mo>≥</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>ϵ</mi><mn>0</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mi>T</mi><mi>δ</mi></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle k_{t}\geq\frac{1}{\epsilon_{0}}\left(\ln|\mathcal{H}|+\ln\frac{T}{\delta}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(27)</span></td></tr></tbody>
</table>
<p id="A3.p10.5" class="ltx_p"><span id="A3.p10.5.1" class="ltx_text">then with probability at least <math id="A3.p10.m7" class="ltx_Math" alttext="1-\delta/T" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mi>T</mi></mrow></mrow><annotation encoding="application/x-tex">1-\delta/T</annotation></semantics></math>, <math id="A3.p10.m8" class="ltx_Math" alttext="\hat{f}_{t}=f_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>f</mi><mo>^</mo></mover><mi>t</mi></msub><mo>=</mo><msub><mi>f</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\hat{f}_{t}=f_{t}</annotation></semantics></math>.
A similar argument holds for the <math id="A3.p10.m9" class="ltx_Math" alttext="k_{c}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>c</mi></msub><annotation encoding="application/x-tex">k_{c}</annotation></semantics></math> examples from the composite task.
Taking a union bound over the <math id="A3.p10.m10" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> steps leads to the statement.
∎</span></p>
</div>
</div>
<div id="A3.p11" class="ltx_para">
<p id="A3.p11.1" class="ltx_p">Note that if the <math id="A3.p11.m1" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>-th simple task example input data distribution <math id="A3.p11.m2" class="ltx_Math" alttext="\mathcal{D}_{t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathcal{D}_{t}</annotation></semantics></math> is the same as the distribution of <math id="A3.p11.m3" class="ltx_Math" alttext="f_{t}\circ\ldots\circ f_{1}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>t</mi></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi mathvariant="normal">…</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{t}\circ\ldots\circ f_{1}(x)</annotation></semantics></math> where <math id="A3.p11.m4" class="ltx_Math" alttext="x\sim\mathcal{D}_{0}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∼</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">x\sim\mathcal{D}_{0}</annotation></semantics></math>, then the sample complexity is improved to:</p>
<table id="A3.EGx16" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E28.m1" class="ltx_Math" alttext="\displaystyle k_{c}+k_{t}\geq\frac{1}{\epsilon_{0}}\left(\ln|\mathcal{H}|+\ln\frac{T}{\delta}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>k</mi><mi>c</mi></msub><mo>+</mo><msub><mi>k</mi><mi>t</mi></msub></mrow><mo>≥</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>ϵ</mi><mn>0</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mi>T</mi><mi>δ</mi></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle k_{c}+k_{t}\geq\frac{1}{\epsilon_{0}}\left(\ln|\mathcal{H}|+\ln\frac{T}{\delta}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
</table>
</div>
</section>
