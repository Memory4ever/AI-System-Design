_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Mixtral-8x7B_allfigure.svg" id="A2.F9.g9" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama3.3-70b_allfigure.svg" id="A2.F9.g10" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Deepseek-Qwen3-8b_allfigure.svg" id="A2.F9.g11" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/deepseek-Llama70b_allfigure.svg" id="A2.F9.g12" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div></div>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">Figure 9: </span>The effect of in-context simple task examples for each model and <math id="A2.F9.m2" class="ltx_Math" alttext="k_{c}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>c</mi></msub><annotation encoding="application/x-tex">k_{c}</annotation></semantics></math>, averaged over tasks.
</figcaption>
</figure>
<figure id="A2.F10" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama-13b_allfigure_avgtask.svg" id="A2.F10.g1" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama-7b_allfigure_avgtask.svg" id="A2.F10.g2" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama-30b_allfigure_avgtask.svg" id="A2.F10.g3" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama-65b_allfigure_avgtask.svg" id="A2.F10.g4" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama-2-7b-hf_allfigure_avgtask.svg" id="A2.F10.g5" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama-2-13b-hf_allfigure_avgtask.svg" id="A2.F10.g6" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama-2-70b-hf_allfigure_avgtask.svg" id="A2.F10.g7" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Mistral-7b_allfigure_avgtask.svg" id="A2.F10.g8" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Mixtral-8x7B_allfigure_avgtask.svg" id="A2.F10.g9" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama3.3-70b_allfigure_avgtask.svg" id="A2.F10.g10" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Deepseek-Qwen3-8b_allfigure_avgtask.svg" id="A2.F10.g11" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/deepseek-Llama70b_allfigure_avgtask.svg" id="A2.F10.g12" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div></div>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">Figure 10: </span>The effect of in-context simple task examples for each model and task, averaged over <math id="A2.F10.m2" class="ltx_Math" alttext="k_{c}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>c</mi></msub><annotation encoding="application/x-tex">k_{c}</annotation></semantics></math>.
</figcaption>
</figure>
<div id="A2.SS2.p5" class="ltx_para ltx_noindent">
<p id="A2.SS2.p5.1" class="ltx_p"><span id="A2.SS2.p5.1.1" class="ltx_text ltx_font_bold">In-context composite task examples.</span>
<a href="#A2.F11" title="In B.2 Detailed results for the effect of in-context examples ‣ Appendix B Experimental Details and More Results ‣ Can Language Models Compose Skills In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Fig.</span> <span class="ltx_text ltx_ref_tag">11</span></a> shows the effect of in-context composite task examples for each <math id="A2.SS2.p5.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> and model (the reported accuracy is averaged over tasks). More precisely, we draw a subfigure for each model and draw a curve for each <math id="A2.SS2.p5.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>; the <math id="A2.SS2.p5.m3" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>-axis is the number <math id="A2.SS2.p5.m4" class="ltx_Math" alttext="k_{c}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>c</mi></msub><annotation encoding="application/x-tex">k_{c}</annotation></semantics></math> of examples from the composite task, and <math id="A2.SS2.p5.m5" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math>-axis is the accuracy averaged over all the composite tasks.</p>
</div>
<div id="A2.SS2.p6" class="ltx_para">
<p id="A2.SS2.p6.1" class="ltx_p">The trend is consistent across different models and <math id="A2.SS2.p6.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>’s: more composite task examples indeed help the performance on the composite queries as expected.</p>
</div>
<figure id="A2.F11" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama-13b_allfigure_transpose.svg" id="A2.F11.g1" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama-7b_allfigure_transpose.svg" id="A2.F11.g2" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama-30b_allfigure_transpose.svg" id="A2.F11.g3" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama-65b_allfigure_transpose.svg" id="A2.F11.g4" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama-2-7b-hf_allfigure_transpose.svg" id="A2.F11.g5" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama-2-13b-hf_allfigure_transpose.svg" id="A2.F11.g6" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama-2-70b-hf_allfigure_transpose.svg" id="A2.F11.g7" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Mistral-7b_allfigure_transpose.svg" id="A2.F11.g8" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Mixtral-8x7B_allfigure_transpose.svg" id="A2.F11.g9" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama3.3-70b_allfigure_transpose.svg" id="A2.F11.g10" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Deepseek-Qwen3-8b_allfigure_transpose.svg" id="A2.F11.g11" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/deepseek-Llama70b_allfigure_transpose.svg" id="A2.F11.g12" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div></div>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">Figure 11: </span>The effect of in-context composite task examples for each model and <math id="A2.F11.m2" class="ltx_Math" alttext="k_{c}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>c</mi></msub><annotation encoding="application/x-tex">k_{c}</annotation></semantics></math>, averaged over tasks.
</figcaption>
</figure>
<section id="A2.SS2.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">B.2.1 </span>Composite task examples are harmful for simple task queries</h4>

<div id="A2.SS2.SSS1.p1" class="ltx_para">
<p id="A2.SS2.SSS1.p1.1" class="ltx_p"><a href="#S3.SS1" title="3.1 Composite task examples help but simple task examples hurt composition ‣ 3 Empirical Study on the In-Context Composition Ability of LLMs ‣ Can Language Models Compose Skills In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">3.1</span></a> presents the result that simple task examples have an negative impact on the performance of the model on composite task queries. Here we also investigate the impact of composite task examples on the performance of the model on simple task queries.</p>
</div>
<div id="A2.SS2.SSS1.p2" class="ltx_para">
<p id="A2.SS2.SSS1.p2.1" class="ltx_p"><a href="#A2.F12" title="In B.2.1 Composite task examples are harmful for simple task queries ‣ B.2 Detailed results for the effect of in-context examples ‣ Appendix B Experimental Details and More Results ‣ Can Language Models Compose Skills In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Fig.</span> <span class="ltx_text ltx_ref_tag">12</span></a> shows the change of accuracy on simple task queries when the number <math id="A2.SS2.SSS1.p2.m1" class="ltx_Math" alttext="k_{c}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>c</mi></msub><annotation encoding="application/x-tex">k_{c}</annotation></semantics></math> of composite task examples increases. This again confirms that the models does not correctly distinguish between composite and simple task examples for addressing the query.</p>
</div>
<figure id="A2.F12" class="ltx_figure"><object type="image/svg+xml" data="2510.22993v1/kc_fullfigure.svg" id="A2.F12.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:215/161;" width="215" height="161"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 12: </span>The effect of composite task examples on the performance on simple task queries, averaged over <math id="A2.F12.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> and tasks. </figcaption>
</figure>
</section>
</section>
<section id="A2.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.3 </span>More results for the output distribution</h3>

<div id="A2.SS3.p1" class="ltx_para">
<p id="A2.SS3.p1.1" class="ltx_p">In the main body we examine how increasing the number <math id="A2.SS3.p1.m1" class="ltx_Math" alttext="k_{1}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mn>1</mn></msub><annotation encoding="application/x-tex">k_{1}</annotation></semantics></math> of simple task 1 examples affects the output distribution on the opposition+swap task, with <math id="A2.SS3.p1.m2" class="ltx_Math" alttext="k_{2}=10" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mn>2</mn></msub><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">k_{2}=10</annotation></semantics></math> and <math id="A2.SS3.p1.m3" class="ltx_Math" alttext="k_{c}=5" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mi>c</mi></msub><mo>=</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">k_{c}=5</annotation></semantics></math>.
Here we examine how increasing the number <math id="A2.SS3.p1.m4" class="ltx_Math" alttext="k_{c}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>c</mi></msub><annotation encoding="application/x-tex">k_{c}</annotation></semantics></math> of composite task examples affects the output. More precisely, we use the Llama-2-70B model on the opposition+swap task and use the Llama-2-7B model on the pastTense+swap task, and vary the number of composite task examples <math id="A2.SS3.p1.m5" class="ltx_Math" alttext="k_{c}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>c</mi></msub><annotation encoding="application/x-tex">k_{c}</annotation></semantics></math> and fix <math id="A2.SS3.p1.m6" class="ltx_Math" alttext="k_{1}=k_{2}=10" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>=</mo><msub><mi>k</mi><mn>2</mn></msub><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">k_{1}=k_{2}=10</annotation></semantics></math>.</p>
</div>
<div id="A2.SS3.p2" class="ltx_para">
<p id="A2.SS3.p2.1" class="ltx_p"><a href="#A2.F13" title="In B.3 More results for the output distribution ‣ Appendix B Experimental Details and More Results ‣ Can Language Models Compose Skills In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Fig.</span> <span class="ltx_text ltx_ref_tag">13</span></a> shows the results. As expected, when <math id="A2.SS3.p2.m1" class="ltx_Math" alttext="k_{c}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>c</mi></msub><annotation encoding="application/x-tex">k_{c}</annotation></semantics></math> increases, the correspondence to the composite task increases while those to the simple tasks decreases. This again supports that the model does not distinguish between composite and simple task examples when utilizing them to address the query.</p>
</div>
<figure id="A2.F13" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2"><object type="image/svg+xml" data="2510.22993v1/pic5_2.svg" id="A2.F13.g1" class="ltx_graphics ltx_centering ltx_figure_panel ltx_img_landscape" style="aspect-ratio:215/161;" width="215" height="161"></object></div><div class="ltx_flex_cell ltx_flex_size_2"><object type="image/svg+xml" data="2510.22993v1/pic5_1.svg" id="A2.F13.g2" class="ltx_graphics ltx_centering ltx_figure_panel ltx_img_landscape" style="aspect-ratio:215/161;" width="215" height="161"></object></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 13: </span>The output distribution for different numbers of composite task examples (<math id="A2.F13.m2" class="ltx_Math" alttext="k_{c}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>c</mi></msub><annotation encoding="application/x-tex">k_{c}</annotation></semantics></math>).</figcaption>
</figure>
</section>
<section id="A2.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.4 </span>Detailed results for irrelevant content/operator</h3>

<div id="A2.SS4.p1" class="ltx_para">
<p id="A2.SS4.p1.1" class="ltx_p">Here we present detailed results for ablating the content or the operator in the composite task examples. We choose representative settings: <math id="A2.SS4.p1.m1" class="ltx_Math" alttext="k_{c}=2,5" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>k</mi><mi>c</mi></msub><mo>=</mo><mn>2</mn></mrow><mo>,</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">k_{c}=2,5</annotation></semantics></math> for the tasks including
opposition+pastTense, opposition+swap, pastTense+swap, pastTense+plusOne, and pastTense+capitalization. We report the accuracy average over the tasks (and random shuffling).</p>
</div>
<div id="A2.SS4.p2" class="ltx_para">
<p id="A2.SS4.p2.1" class="ltx_p"><a href="#A2.F14" title="In B.4 Detailed results for irrelevant content/operator ‣ Appendix B Experimental Details and More Results ‣ Can Language Models Compose Skills In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Fig.</span> <span class="ltx_text ltx_ref_tag">14</span></a> shows that after ablating the content, the trend of performance decreasing with larger <math id="A2.SS4.p2.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is roughly the same as before. This suggests that the content may not be the main factor here.
<a href="#A2.F15" title="In B.4 Detailed results for irrelevant content/operator ‣ Appendix B Experimental Details and More Results ‣ Can Language Models Compose Skills In-Context?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Fig.</span> <span class="ltx_text ltx_ref_tag">15</span></a> shows that after ablating the operator, the negative impact of larger <math id="A2.SS4.p2.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is not as significant. This suggests that the operator may play an important role in how the model utilizes the examples.</p>
</div>
<figure id="A2.F14" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama-13b_allfigure_irrlcontent.svg" id="A2.F14.g1" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama-7b_allfigure_irrlcontent.svg" id="A2.F14.g2" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama-30b_allfigure_irrlcontent.svg" id="A2.F14.g3" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama-65b_allfigure_irrlcontent.svg" id="A2.F14.g4" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama-2-7b-hf_allfigure_irrlcontent.svg" id="A2.F14.g5" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama-2-13b-hf_allfigure_irrlcontent.svg" id="A2.F14.g6" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama-2-70b-hf_allfigure_irrlcontent.svg" id="A2.F14.g7" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Mistral-7b_allfigure_irrlcontent.svg" id="A2.F14.g8" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Mixtral-8x7B_allfigure_irrlcontent.svg" id="A2.F14.g9" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama3.3-70b_allfigure_irrlcontent.svg" id="A2.F14.g10" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Deepseekr1-qwen3-8B_allfigure_irrlcontent.svg" id="A2.F14.g11" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Deepseekr1-Llama-70B_allfigure_irrlcontent.svg" id="A2.F14.g12" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div></div>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">Figure 14: </span>Results after ablating the content in the composite task examples.
</figcaption>
</figure>
<figure id="A2.F15" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama-13b_allfigure_irrloperator.svg" id="A2.F15.g1" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama-7b_allfigure_irrloperator.svg" id="A2.F15.g2" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama-30b_allfigure_irrloperator.svg" id="A2.F15.g3" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama-65b_allfigure_irrloperator.svg" id="A2.F15.g4" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama-2-7b-hf_allfigure_irrloperator.svg" id="A2.F15.g5" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama-2-13b-hf_allfigure_irrloperator.svg" id="A2.F15.g6" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama-2-70b-hf_allfigure_irrloperator.svg" id="A2.F15.g7" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Mistral-7b_allfigure_irrloperator.svg" id="A2.F15.g8" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Mixtral-8x7B_allfigure_irrloperator.svg" id="A2.F15.g9" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Llama3.3-70b_allfigure_irrloperator.svg" id="A2.F15.g10" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Deepseekr1-qwen3-8B_allfigure_irrloperator.svg" id="A2.F15.g11" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div><div class="ltx_flex_cell ltx_flex_size_4"><object type="image/svg+xml" data="2510.22993v1/Deepseekr1-Llama-70B_allfigure_irrloperator.svg" id="A2.F15.g12" class="ltx_graphics ltx_figure_panel ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118"></object></div></div>
