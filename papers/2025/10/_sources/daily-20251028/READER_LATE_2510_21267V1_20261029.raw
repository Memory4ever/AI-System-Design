<tr id="S5.T3.4.1.4" class="ltx_tr">
<td id="S5.T3.4.1.4.1" class="ltx_td ltx_align_left"><span id="S5.T3.4.1.4.1.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">#classes</span></td>
<td id="S5.T3.4.1.4.2" class="ltx_td ltx_align_center"><span id="S5.T3.4.1.4.2.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">5</span></td>
<td id="S5.T3.4.1.4.3" class="ltx_td ltx_align_center"><span id="S5.T3.4.1.4.3.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">2</span></td>
<td id="S5.T3.4.1.4.4" class="ltx_td ltx_align_center"><span id="S5.T3.4.1.4.4.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">2</span></td>
<td id="S5.T3.4.1.4.5" class="ltx_td ltx_align_center"><span id="S5.T3.4.1.4.5.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">18</span></td>
<td id="S5.T3.4.1.4.6" class="ltx_td ltx_align_center"><span id="S5.T3.4.1.4.6.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">2</span></td></tr>
<tr id="S5.T3.4.1.5" class="ltx_tr">
<td id="S5.T3.4.1.5.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S5.T3.4.1.5.1.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">GCN</span></td>
<td id="S5.T3.4.1.5.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T3.4.1.5.2.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">48.70</span><sub id="S5.T3.4.1.5.2.2" class="ltx_sub"><span id="S5.T3.4.1.5.2.2.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">±0.63</span></sub></td>
