<tr id="S5.T3.4.1.2" class="ltx_tr">
<td id="S5.T3.4.1.2.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S5.T3.4.1.2.1.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">#nodes</span></td>
<td id="S5.T3.4.1.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T3.4.1.2.2.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">24,492</span></td>
<td id="S5.T3.4.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T3.4.1.2.3.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">10,000</span></td>
<td id="S5.T3.4.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T3.4.1.2.4.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">48,921</span></td>
<td id="S5.T3.4.1.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T3.4.1.2.5.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">22,662</span></td>
<td id="S5.T3.4.1.2.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T3.4.1.2.6.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">11,758</span></td></tr>
<tr id="S5.T3.4.1.3" class="ltx_tr">
<td id="S5.T3.4.1.3.1" class="ltx_td ltx_align_left"><span id="S5.T3.4.1.3.1.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">#features</span></td>
<td id="S5.T3.4.1.3.2" class="ltx_td ltx_align_center"><span id="S5.T3.4.1.3.2.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">300</span></td>
<td id="S5.T3.4.1.3.3" class="ltx_td ltx_align_center"><span id="S5.T3.4.1.3.3.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">7</span></td>
<td id="S5.T3.4.1.3.4" class="ltx_td ltx_align_center"><span id="S5.T3.4.1.3.4.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">301</span></td>
<td id="S5.T3.4.1.3.5" class="ltx_td ltx_align_center"><span id="S5.T3.4.1.3.5.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">300</span></td>
