<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex134.m1" class="ltx_Math" alttext="\displaystyle q_{W}(1+q_{G})DL+(1-\beta^{t})q_{W}(1+q_{G})t\eta\sqrt{r}L." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>β</mi><mi>t</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle q_{W}(1+q_{G})DL+(1-\beta^{t})q_{W}(1+q_{G})t\eta\sqrt{r}L.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex135"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex135.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex135.m2" class="ltx_Math" alttext="\displaystyle\beta^{t}\cdot\frac{2\sigma}{\sqrt{B}}+\sqrt{\frac{1-\beta}{1+\beta}}\cdot\frac{2\sigma}{\sqrt{B}}+2q_{G}(\sigma+G)+2q_{G}t\eta\sqrt{r}L+" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>β</mi><mi>t</mi></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow><msqrt><mi>B</mi></msqrt></mfrac></mstyle></mrow><mo>+</mo><mrow><msqrt><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mrow><mn>1</mn><mo>+</mo><mi>β</mi></mrow></mfrac></mstyle></msqrt><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow><msqrt><mi>B</mi></msqrt></mfrac></mstyle></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>+</mo><mi>G</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\beta^{t}\cdot\frac{2\sigma}{\sqrt{B}}+\sqrt{\frac{1-\beta}{1+\beta}}\cdot\frac{2\sigma}{\sqrt{B}}+2q_{G}(\sigma+G)+2q_{G}t\eta\sqrt{r}L+</annotation></semantics></math></td>
