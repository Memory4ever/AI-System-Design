<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex17.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{|m^{\prime}_{t,i}|}{\sqrt{\epsilon+LB_{t,i}}}\frac{v^{\prime}_{t,i}-LB_{t,i}}{\epsilon+v^{\prime}_{t,i}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><msubsup><mi>m</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup><mo stretchy="false">|</mo></mrow><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup><mo>−</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow><mrow><mi>ϵ</mi><mo>+</mo><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{|m^{\prime}_{t,i}|}{\sqrt{\epsilon+LB_{t,i}}}\frac{v^{\prime}_{t,i}-LB_{t,i}}{\epsilon+v^{\prime}_{t,i}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E16.m1" class="ltx_Math" alttext="\displaystyle\hskip-56.9055pt=\frac{\sum_{k=0}^{t}\beta_{1}^{t-k}|g_{k,i}+\delta_{k,i}|}{\sqrt{\epsilon+\sum_{k=0}^{t}(\beta_{2}(1-q_{V}))^{t-k}(g_{k,i}+\delta_{k,i})^{2}}}\cdot\frac{\sum_{k=0}^{t}(\beta_{2}^{t-k}-(\beta_{2}(1-q_{V}))^{t-k})(g_{k,i}+\delta_{k,i})^{2}}{\epsilon+\sum_{k=0}^{t}\beta_{2}^{t-k}(g_{k,i}+\delta_{k,i})^{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></msubsup><mrow><msubsup><mi>β</mi><mn>1</mn><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>g</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>δ</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><msqrt><mrow><mi>ϵ</mi><mo rspace="0.055em">+</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></msubsup><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>g</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>δ</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></msqrt></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></msubsup><mrow><mrow><mo lspace="0em" stretchy="false">(</mo><mrow><msubsup><mi>β</mi><mn>2</mn><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>g</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>δ</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mrow><mi>ϵ</mi><mo rspace="0.055em">+</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></msubsup><mrow><msubsup><mi>β</mi><mn>2</mn><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>g</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>δ</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hskip-56.9055pt=\frac{\sum_{k=0}^{t}\beta_{1}^{t-k}|g_{k,i}+\delta_{k,i}|}{\sqrt{\epsilon+\sum_{k=0}^{t}(\beta_{2}(1-q_{V}))^{t-k}(g_{k,i}+\delta_{k,i})^{2}}}\cdot\frac{\sum_{k=0}^{t}(\beta_{2}^{t-k}-(\beta_{2}(1-q_{V}))^{t-k})(g_{k,i}+\delta_{k,i})^{2}}{\epsilon+\sum_{k=0}^{t}\beta_{2}^{t-k}(g_{k,i}+\delta_{k,i})^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.16)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p7.2" class="ltx_p">The first fraction is bounded by Lemma <a href="#A1.Thmtheorem4" title="Lemma A.4 (Finite Geometric Series Ratio Bounded by Infinite Sum). ‣ A.5 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.4</span></a>: <math id="A1.SS2.p7.m1" class="ltx_Math" alttext="\frac{\sum_{k=0}^{t}\beta_{1}^{k}|a_{t-k,i}|}{\sqrt{\epsilon+\sum_{k=0}^{t}(\beta_{2}(1-q_{V}))^{k}a_{t-k,i}}}\leq\frac{1}{\sqrt{1-\beta_{1}^{2}/(\beta_{2}(1-q_{V}))}}" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></msubsup></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">|</mo></mrow></mrow></mrow><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></msubsup></mstyle><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow></mrow></msqrt></mfrac><mo>≤</mo><mfrac><mn>1</mn><msqrt><mrow><mn>1</mn><mo>−</mo><mrow><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt></mfrac></mrow><annotation encoding="application/x-tex">\frac{\sum_{k=0}^{t}\beta_{1}^{k}|a_{t-k,i}|}{\sqrt{\epsilon+\sum_{k=0}^{t}(\beta_{2}(1-q_{V}))^{k}a_{t-k,i}}}\leq\frac{1}{\sqrt{1-\beta_{1}^{2}/(\beta_{2}(1-q_{V}))}}</annotation></semantics></math>.
The second fraction is a ratio of weighted sums <math id="A1.SS2.p7.m2" class="ltx_Math" alttext="\frac{\sum_{k=0}^{t}(\beta_{2}^{k}-(\beta_{2}(1-q_{V}))^{k})a_{t-k,i}}{\epsilon+\sum_{k=0}^{t}\beta_{2}^{k}a_{t-k,i}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></msubsup></mstyle><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>β</mi><mn>2</mn><mi>k</mi></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>k</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow><mrow><mi>ϵ</mi><mo>+</mo><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></msubsup></mstyle><mrow><msubsup><mi>β</mi><mn>2</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow></mrow></mfrac><annotation encoding="application/x-tex">\frac{\sum_{k=0}^{t}(\beta_{2}^{k}-(\beta_{2}(1-q_{V}))^{k})a_{t-k,i}}{\epsilon+\sum_{k=0}^{t}\beta_{2}^{k}a_{t-k,i}}</annotation></semantics></math>. This ratio is bounded by the maximum ratio of its coefficients:</p>
<table id="A1.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex18.m1" class="ltx_Math" alttext="\max_{k\in\{0,\dots,t\}}\frac{\beta_{2}^{k}-(\beta_{2}(1-q_{V}))^{k}}{\beta_{2}^{k}}=\max_{k\in\{0,\dots,t\}}(1-(1-q_{V})^{k})=1-(1-q_{V})^{t}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mi>max</mi><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>t</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></munder><mo lspace="0.167em">⁡</mo><mfrac><mrow><msubsup><mi>β</mi><mn>2</mn><mi>k</mi></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>k</mi></msup></mrow><msubsup><mi>β</mi><mn>2</mn><mi>k</mi></msubsup></mfrac></mrow><mo>=</mo><mrow><munder><mi>max</mi><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>t</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></munder><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mi>k</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mi>t</mi></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\max_{k\in\{0,\dots,t\}}\frac{\beta_{2}^{k}-(\beta_{2}(1-q_{V}))^{k}}{\beta_{2}^{k}}=\max_{k\in\{0,\dots,t\}}(1-(1-q_{V})^{k})=1-(1-q_{V})^{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p7.3" class="ltx_p">Combining these bounds, the term for Case I is bounded by <math id="A1.SS2.p7.m3" class="ltx_Math" alttext="\frac{1}{\sqrt{1-\beta_{1}^{2}/(\beta_{2}(1-q_{V}))}}(1-(1-q_{V})^{t})" display="inline" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><msqrt><mrow><mn>1</mn><mo>−</mo><mrow><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mi>t</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\frac{1}{\sqrt{1-\beta_{1}^{2}/(\beta_{2}(1-q_{V}))}}(1-(1-q_{V})^{t})</annotation></semantics></math>.</p>
</div>
<div id="A1.SS2.p8" class="ltx_para">
<p id="A1.SS2.p8.1" class="ltx_p"><span id="A1.SS2.p8.1.1" class="ltx_text ltx_font_bold">Case II (Deviation from Upper Bound):</span> Similarly, we bound the second term:</p>
<table id="A1.EGx22" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex19.m1" class="ltx_Math" alttext="\displaystyle|m^{\prime}_{t,i}|\left(\frac{1}{\sqrt{\epsilon+v^{\prime}_{t,i}}}-\frac{1}{\sqrt{\epsilon+UB_{t,i}}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msubsup><mi>m</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow></msqrt></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow></msqrt></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle|m^{\prime}_{t,i}|\left(\frac{1}{\sqrt{\epsilon+v^{\prime}_{t,i}}}-\frac{1}{\sqrt{\epsilon+UB_{t,i}}}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex19.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{|m^{\prime}_{t,i}|}{\sqrt{\epsilon+v^{\prime}_{t,i}}}\frac{UB_{t,i}-v^{\prime}_{t,i}}{\epsilon+UB_{t,i}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><msubsup><mi>m</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup><mo stretchy="false">|</mo></mrow><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo>−</mo><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow><mrow><mi>ϵ</mi><mo>+</mo><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{|m^{\prime}_{t,i}|}{\sqrt{\epsilon+v^{\prime}_{t,i}}}\frac{UB_{t,i}-v^{\prime}_{t,i}}{\epsilon+UB_{t,i}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p8.2" class="ltx_p">Applying Lemma <a href="#A1.Thmtheorem4" title="Lemma A.4 (Finite Geometric Series Ratio Bounded by Infinite Sum). ‣ A.5 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.4</span></a> and the maximum ratio:</p>
<table id="A1.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex20.m1" class="ltx_Math" alttext="\leq\frac{1}{\sqrt{1-\beta_{1}^{2}/\beta_{2}}}\cdot\left(1-(1+q_{V})^{-t}\right)" display="block" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mfrac><mn>1</mn><msqrt><mrow><mn>1</mn><mo>−</mo><mrow><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mo>/</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></mrow></msqrt></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mi>t</mi></mrow></msup></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\leq\frac{1}{\sqrt{1-\beta_{1}^{2}/\beta_{2}}}\cdot\left(1-(1+q_{V})^{-t}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p8.3" class="ltx_p">Comparing the bounds from the two cases, the bound from Case I is larger since <math id="A1.SS2.p8.m1" class="ltx_Math" alttext="1-(1-q_{V})^{t}&gt;1-(1+q_{V})^{-t}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mi>t</mi></msup></mrow><mo>&gt;</mo><mrow><mn>1</mn><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mi>t</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">1-(1-q_{V})^{t}&gt;1-(1+q_{V})^{-t}</annotation></semantics></math> and the denominator term <math id="A1.SS2.p8.m2" class="ltx_Math" alttext="\sqrt{1-\beta_{1}^{2}/(\beta_{2}(1-q_{V}))}" display="inline" intent=":literal"><semantics><msqrt><mrow><mn>1</mn><mo>−</mo><mrow><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt><annotation encoding="application/x-tex">\sqrt{1-\beta_{1}^{2}/(\beta_{2}(1-q_{V}))}</annotation></semantics></math> is smaller than <math id="A1.SS2.p8.m3" class="ltx_Math" alttext="\sqrt{1-\beta_{1}^{2}/\beta_{2}}" display="inline" intent=":literal"><semantics><msqrt><mrow><mn>1</mn><mo>−</mo><mrow><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mo>/</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></mrow></msqrt><annotation encoding="application/x-tex">\sqrt{1-\beta_{1}^{2}/\beta_{2}}</annotation></semantics></math>. Therefore, taking the maximum and summing over <math id="A1.SS2.p8.m4" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> dimensions:</p>
<table id="A1.EGx23" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E17.m1" class="ltx_Math" alttext="\displaystyle|A_{2}|\leq\sum_{i\in[d]}R\frac{1-(1-q_{V})^{t}}{\sqrt{1-\frac{\beta_{1}^{2}}{\beta_{2}(1-q_{V})}}}=\frac{dR(1-(1-q_{V})^{t})}{\sqrt{1-\frac{\beta_{1}^{2}}{\beta_{2}(1-q_{V})}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi>A</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mi>t</mi></msup></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><mfrac><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></msqrt></mfrac></mstyle></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mi>t</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><mfrac><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></msqrt></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle|A_{2}|\leq\sum_{i\in[d]}R\frac{1-(1-q_{V})^{t}}{\sqrt{1-\frac{\beta_{1}^{2}}{\beta_{2}(1-q_{V})}}}=\frac{dR(1-(1-q_{V})^{t})}{\sqrt{1-\frac{\beta_{1}^{2}}{\beta_{2}(1-q_{V})}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.17)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p8.4" class="ltx_p">Combining the bounds for <math id="A1.SS2.p8.m5" class="ltx_Math" alttext="|A_{1}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><msub><mi>A</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|A_{1}|</annotation></semantics></math> and <math id="A1.SS2.p8.m6" class="ltx_Math" alttext="|A_{2}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><msub><mi>A</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|A_{2}|</annotation></semantics></math>, we can get the bound for term A:</p>
<table id="A1.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E18.m1" class="ltx_Math" alttext="|A|\leq|A_{1}|+|A_{2}|\leq q_{M}\cdot dR\cdot C_{q}+\frac{dR(1-(1-q_{V})^{t})}{\sqrt{1-\frac{\beta_{1}^{2}}{\beta_{2}(1-q_{V})}}}\triangleq Q(t)" display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>A</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>A</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><mo stretchy="false">|</mo><msub><mi>A</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mrow><mrow><msub><mi>q</mi><mi>M</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>C</mi><mi>q</mi></msub></mrow><mo>+</mo><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mi>t</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><mfrac><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></msqrt></mfrac></mrow><mo>≜</mo><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">|A|\leq|A_{1}|+|A_{2}|\leq q_{M}\cdot dR\cdot C_{q}+\frac{dR(1-(1-q_{V})^{t})}{\sqrt{1-\frac{\beta_{1}^{2}}{\beta_{2}(1-q_{V})}}}\triangleq Q(t)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.18)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.p9" class="ltx_para">
<p id="A1.SS2.p9.1" class="ltx_p">Now we move on to bound Term B. Let us now focus on bounding Term B from (<a href="#A1.E12" title="In A.2 Detailed Proof ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.12</span></a>). By expanding the definition of the first moment estimate <math id="A1.SS2.p9.m1" class="ltx_Math" alttext="m^{\prime}_{t,i}" display="inline" intent=":literal"><semantics><msubsup><mi>m</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">m^{\prime}_{t,i}</annotation></semantics></math>, we can decompose Term B into two parts, which we will call Term C and Term D:</p>
<table id="A1.EGx24" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E19.m1" class="ltx_Math" alttext="\displaystyle\sum_{i\in[d]}\mathcal{G}_{t,i}\frac{m^{\prime}_{t,i}}{\sqrt{\epsilon+v^{\prime}_{t,i}}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>m</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow></msqrt></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i\in[d]}\mathcal{G}_{t,i}\frac{m^{\prime}_{t,i}}{\sqrt{\epsilon+v^{\prime}_{t,i}}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E19.m2" class="ltx_Math" alttext="\displaystyle=\sum_{i\in[d]}\mathcal{G}_{t,i}\sum_{k=0}^{t-1}\beta_{1}^{k}\frac{g_{t-k,i}+\delta_{t-k,i}}{\sqrt{\epsilon+v^{\prime}_{t,i}}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>g</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>δ</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow></msqrt></mfrac></mstyle></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i\in[d]}\mathcal{G}_{t,i}\sum_{k=0}^{t-1}\beta_{1}^{k}\frac{g_{t-k,i}+\delta_{t-k,i}}{\sqrt{\epsilon+v^{\prime}_{t,i}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.19)</span></td></tr></tbody>
<tbody id="A1.E20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E20.m1" class="ltx_Math" alttext="\displaystyle=\underbrace{\sum_{i\in[d]}\sum_{k=0}^{t-1}\beta_{1}^{k}\mathcal{G}_{t-k,i}\frac{g_{t-k,i}+\delta_{t-k,i}}{\sqrt{\epsilon+{v^{\prime}_{t,i}}}}}_{C}+\underbrace{\sum_{i\in[d]}\sum_{k=0}^{t-1}\beta_{1}^{k}\left(\mathcal{G}_{t,i}-\mathcal{G}_{t-k,i}\right)\frac{g_{t-k,i}+\delta_{t-k,i}}{\sqrt{\epsilon+v^{\prime}_{t,i}}}}_{D}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><munder><munder accentunder="true"><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>g</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>δ</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow></msqrt></mfrac></mstyle></mrow></mrow></mrow><mo stretchy="true">⏟</mo></munder><mi>C</mi></munder><mo>+</mo><munder><munder accentunder="true"><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>g</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>δ</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow></msqrt></mfrac></mstyle></mrow></mrow></mrow><mo stretchy="true">⏟</mo></munder><mi>D</mi></munder></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\underbrace{\sum_{i\in[d]}\sum_{k=0}^{t-1}\beta_{1}^{k}\mathcal{G}_{t-k,i}\frac{g_{t-k,i}+\delta_{t-k,i}}{\sqrt{\epsilon+{v^{\prime}_{t,i}}}}}_{C}+\underbrace{\sum_{i\in[d]}\sum_{k=0}^{t-1}\beta_{1}^{k}\left(\mathcal{G}_{t,i}-\mathcal{G}_{t-k,i}\right)\frac{g_{t-k,i}+\delta_{t-k,i}}{\sqrt{\epsilon+v^{\prime}_{t,i}}}}_{D}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.20)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p9.2" class="ltx_p">The magnitude of Term D, which captures the error from gradient drift, is bounded by Lemma <a href="#A1.Thmtheorem8" title="Lemma A.8 (Bound on Term D). ‣ A.9 Proof of Lemma (Bound on Term D) ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.8</span></a>:</p>
<table id="A1.EGx25" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E21.m1" class="ltx_Math" alttext="\displaystyle|D|\leq\frac{\eta_{t}^{2}L^{2}\sqrt{1-\beta_{1}}}{4(1+q_{G})R}\left(\sum_{l=1}^{t-1}\|\mathbf{u}_{t-l}\|_{2}^{2}\sum_{k=l}^{t-1}\beta_{1}^{k}\sqrt{k}\right)+\frac{(1+q_{G})R}{\sqrt{1-\beta_{1}}}\sum_{k=0}^{t-1}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{k}\sqrt{k+1}\|\mathbf{U}_{t-k}\|_{2}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mi>D</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>η</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐮</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mi>l</mi></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>k</mi></msqrt></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>β</mi><mn>1</mn></msub><msub><mi>β</mi><mn>2</mn></msub></mfrac></mstyle><mo>)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐔</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle|D|\leq\frac{\eta_{t}^{2}L^{2}\sqrt{1-\beta_{1}}}{4(1+q_{G})R}\left(\sum_{l=1}^{t-1}\|\mathbf{u}_{t-l}\|_{2}^{2}\sum_{k=l}^{t-1}\beta_{1}^{k}\sqrt{k}\right)+\frac{(1+q_{G})R}{\sqrt{1-\beta_{1}}}\sum_{k=0}^{t-1}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{k}\sqrt{k+1}\|\mathbf{U}_{t-k}\|_{2}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.21)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p9.3" class="ltx_p">For Term C, we establish a lower bound on its expectation in Lemma <a href="#A1.Thmtheorem9" title="Lemma A.9 (Lower Bound on the Expectation of Term C). ‣ A.10 Proof of Lemma (Lower Bound on Term C) ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.9</span></a>:</p>
<table id="A1.EGx26" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex21.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[C\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mi>C</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[C\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex21.m2" class="ltx_Math" alttext="\displaystyle\geq\frac{1}{2}\left(\sum_{i\in[d]}\sum_{k=0}^{t-1}\beta_{1}^{k}\mathbb{E}\left[\frac{\mathcal{G}_{t-k,i}^{2}}{\sqrt{\epsilon+\tilde{v}_{t,k+1,i}}}\right]\right)-\frac{2(1+q_{G})R}{\sqrt{1-\beta_{1}}}\left(\sum_{i\in[d]}\sum_{k=0}^{t-1}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{k}\sqrt{k+1}\mathbb{E}\left[\|\mathbf{U}_{t-k}\|_{2}^{2}\right]\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msub><mover accent="true"><mi>v</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>,</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow></msqrt></mfrac></mstyle><mo>]</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>β</mi><mn>1</mn></msub><msub><mi>β</mi><mn>2</mn></msub></mfrac></mstyle><mo>)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐔</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\frac{1}{2}\left(\sum_{i\in[d]}\sum_{k=0}^{t-1}\beta_{1}^{k}\mathbb{E}\left[\frac{\mathcal{G}_{t-k,i}^{2}}{\sqrt{\epsilon+\tilde{v}_{t,k+1,i}}}\right]\right)-\frac{2(1+q_{G})R}{\sqrt{1-\beta_{1}}}\left(\sum_{i\in[d]}\sum_{k=0}^{t-1}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{k}\sqrt{k+1}\mathbb{E}\left[\|\mathbf{U}_{t-k}\|_{2}^{2}\right]\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E22.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad-d\sum_{k=0}^{t-1}\beta_{1}^{k}M_{t-k}." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>d</mi><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>β</mi><msub><mrow></mrow><mn>1</mn></msub><msup><mrow></mrow><mi>k</mi></msup><mi>M</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad-d\sum_{k=0}^{t-1}\beta_{1}^{k}M_{t-k}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.22)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p9.4" class="ltx_p">where <math id="A1.SS2.p9.m2" class="ltx_Math" alttext="M_{t-k}=\frac{q_{G}R^{2}+Lq_{W}R\|\mathbf{w}_{t-k-1}\|_{2}}{\sqrt{\epsilon}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub><mo>=</mo><mfrac><mrow><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><msqrt><mi>ϵ</mi></msqrt></mfrac></mrow><annotation encoding="application/x-tex">M_{t-k}=\frac{q_{G}R^{2}+Lq_{W}R\|\mathbf{w}_{t-k-1}\|_{2}}{\sqrt{\epsilon}}</annotation></semantics></math>. Injecting (<a href="#A1.E22" title="In A.2 Detailed Proof ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.22</span></a>) ,(<a href="#A1.E21" title="In A.2 Detailed Proof ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.21</span></a>)and (<a href="#A1.E20" title="In A.2 Detailed Proof ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.20</span></a>) into (<a href="#A1.E12" title="In A.2 Detailed Proof ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.12</span></a>) . We get the final lower bound for <math id="A1.SS2.p9.m3" class="ltx_Math" alttext="\mathcal{G}_{t}^{T}\mathbf{u}_{t}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>t</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐮</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\mathcal{G}_{t}^{T}\mathbf{u}_{t}</annotation></semantics></math>:</p>
</div>
<div id="A1.SS2.p10" class="ltx_para">
<table id="A1.E23" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A1.E23X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E23X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\sum_{i\in[d]}\mathcal{G}_{t,i}\frac{m_{t,i}}{\sqrt{\epsilon+v_{t,i}}}\right]\geq\frac{1}{2}\left(\sum_{i\in[d]}\sum_{k=0}^{t-1}\beta_{1}^{k}\mathbb{E}\left[\frac{\mathcal{G}_{t-k,i}^{2}}{\sqrt{\epsilon+\tilde{v}_{t,k+1,i}}}\right]\right)-Q(t)-d\sum_{k=0}^{t-1}\beta_{1}^{k}M_{t-k}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi>m</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></msqrt></mfrac></mstyle></mrow></mrow><mo>]</mo></mrow></mrow><mo>≥</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msub><mover accent="true"><mi>v</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>,</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow></msqrt></mfrac></mstyle><mo>]</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\sum_{i\in[d]}\mathcal{G}_{t,i}\frac{m_{t,i}}{\sqrt{\epsilon+v_{t,i}}}\right]\geq\frac{1}{2}\left(\sum_{i\in[d]}\sum_{k=0}^{t-1}\beta_{1}^{k}\mathbb{E}\left[\frac{\mathcal{G}_{t-k,i}^{2}}{\sqrt{\epsilon+\tilde{v}_{t,k+1,i}}}\right]\right)-Q(t)-d\sum_{k=0}^{t-1}\beta_{1}^{k}M_{t-k}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(A.23)</span></td></tr>
<tr id="A1.E23Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E23Xa.m2" class="ltx_Math" alttext="\displaystyle-\frac{\eta_{t}^{2}L^{2}}{4(1+q_{G})R}\sqrt{1-\beta_{1}}\left(\sum_{l=1}^{t-1}\|\mathbf{u}_{t-l}\|_{2}^{2}\sum_{k=l}^{t-1}\beta_{1}^{k}\sqrt{k}\right)-\frac{3(1+q_{G})R}{\sqrt{1-\beta_{1}}}\left(\sum_{k=0}^{t-1}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{k}\sqrt{k+1}\|\mathbf{U}_{t-k}\|_{2}^{2}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>η</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐮</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mi>l</mi></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>k</mi></msqrt></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>β</mi><mn>1</mn></msub><msub><mi>β</mi><mn>2</mn></msub></mfrac></mstyle><mo>)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐔</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{\eta_{t}^{2}L^{2}}{4(1+q_{G})R}\sqrt{1-\beta_{1}}\left(\sum_{l=1}^{t-1}\|\mathbf{u}_{t-l}\|_{2}^{2}\sum_{k=l}^{t-1}\beta_{1}^{k}\sqrt{k}\right)-\frac{3(1+q_{G})R}{\sqrt{1-\beta_{1}}}\left(\sum_{k=0}^{t-1}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{k}\sqrt{k+1}\|\mathbf{U}_{t-k}\|_{2}^{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.p11" class="ltx_para">
<p id="A1.SS2.p11.1" class="ltx_p">Now lets look back at:</p>
<table id="A1.EGx27" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex22.m1" class="ltx_Math" alttext="\displaystyle F(\mathbf{w}_{t})\leq F(\mathbf{w}_{t-1})-\eta_{t}\mathcal{G}_{t}^{T}\mathbf{u}_{t}+\frac{\eta_{t}^{2}L}{2}\|\mathbf{u}_{t}\|^{2}_{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>t</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐮</mi><mi>t</mi></msub></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>η</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐮</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle F(\mathbf{w}_{t})\leq F(\mathbf{w}_{t-1})-\eta_{t}\mathcal{G}_{t}^{T}\mathbf{u}_{t}+\frac{\eta_{t}^{2}L}{2}\|\mathbf{u}_{t}\|^{2}_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.p12" class="ltx_para">
<p id="A1.SS2.p12.1" class="ltx_p">inject (<a href="#A1.E23" title="In A.2 Detailed Proof ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.23</span></a>) into it:</p>
<table id="A1.EGx28" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex23.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[F(\mathbf{w}_{t})\right]\leq\mathbb{E}\left[F(\mathbf{w}_{t-1})\right]-\frac{\eta_{t}}{2}\left(\sum_{i\in[d]}\sum_{k=0}^{t-1}\beta_{1}^{k}\mathbb{E}\left[\frac{\mathcal{G}_{t-k,i}^{2}}{\sqrt{\epsilon+\tilde{v}_{t,k+1,i}}}\right]\right)+\frac{\eta_{t}^{2}L}{2}\mathbb{E}\left[\|\mathbf{u}_{t}\|^{2}_{2}\right]+\eta_{t}Q(t)+\eta_{t}d\sum_{k=0}^{t-1}\beta_{1}^{k}M_{t-k}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>η</mi><mi>t</mi></msub><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msub><mover accent="true"><mi>v</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>,</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow></msqrt></mfrac></mstyle><mo>]</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>η</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐮</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[F(\mathbf{w}_{t})\right]\leq\mathbb{E}\left[F(\mathbf{w}_{t-1})\right]-\frac{\eta_{t}}{2}\left(\sum_{i\in[d]}\sum_{k=0}^{t-1}\beta_{1}^{k}\mathbb{E}\left[\frac{\mathcal{G}_{t-k,i}^{2}}{\sqrt{\epsilon+\tilde{v}_{t,k+1,i}}}\right]\right)+\frac{\eta_{t}^{2}L}{2}\mathbb{E}\left[\|\mathbf{u}_{t}\|^{2}_{2}\right]+\eta_{t}Q(t)+\eta_{t}d\sum_{k=0}^{t-1}\beta_{1}^{k}M_{t-k}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E24.m1" class="ltx_Math" alttext="\displaystyle\quad+\frac{\eta_{t}^{3}L^{2}}{4(1+q_{G})R}\sqrt{1-\beta_{1}}\left(\sum_{l=1}^{t-1}\|\mathbf{u}_{t-l}\|_{2}^{2}\sum_{k=l}^{t-1}\beta_{1}^{k}\sqrt{k}\right)+\frac{3\eta_{t}(1+q_{G})R}{\sqrt{1-\beta_{1}}}\left(\sum_{k=0}^{t-1}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{k}\sqrt{k+1}\|\mathbf{U}_{t-k}\|_{2}^{2}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>η</mi><mi>t</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐮</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mi>l</mi></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>k</mi></msqrt></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>β</mi><mn>1</mn></msub><msub><mi>β</mi><mn>2</mn></msub></mfrac></mstyle><mo>)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐔</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\frac{\eta_{t}^{3}L^{2}}{4(1+q_{G})R}\sqrt{1-\beta_{1}}\left(\sum_{l=1}^{t-1}\|\mathbf{u}_{t-l}\|_{2}^{2}\sum_{k=l}^{t-1}\beta_{1}^{k}\sqrt{k}\right)+\frac{3\eta_{t}(1+q_{G})R}{\sqrt{1-\beta_{1}}}\left(\sum_{k=0}^{t-1}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{k}\sqrt{k+1}\|\mathbf{U}_{t-k}\|_{2}^{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.24)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.p13" class="ltx_para">
<p id="A1.SS2.p13.1" class="ltx_p">We have for any <math id="A1.SS2.p13.m1" class="ltx_Math" alttext="k\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">k\in\mathbb{N}</annotation></semantics></math>, <math id="A1.SS2.p13.m2" class="ltx_Math" alttext="k&lt;t" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>&lt;</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">k&lt;t</annotation></semantics></math>, and any coordinate <math id="A1.SS2.p13.m3" class="ltx_Math" alttext="i\in[d]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[d]</annotation></semantics></math>,
<math id="A1.SS2.p13.m4" class="ltx_Math" alttext="\sqrt{\epsilon+\tilde{v}_{t,k+1,i}}\leq(1+q_{G})R\sqrt{\sum_{j=0}^{t-1}\beta_{2}^{j}}" display="inline" intent=":literal"><semantics><mrow><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msub><mover accent="true"><mi>v</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>,</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow></msqrt><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msubsup><mi>β</mi><mn>2</mn><mi>j</mi></msubsup></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">\sqrt{\epsilon+\tilde{v}_{t,k+1,i}}\leq(1+q_{G})R\sqrt{\sum_{j=0}^{t-1}\beta_{2}^{j}}</annotation></semantics></math>.
Introducing <math id="A1.SS2.p13.m5" class="ltx_Math" alttext="\Omega_{t}=\sqrt{\sum_{j=0}^{t-1}\beta_{2}^{j}}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Ω</mi><mi>t</mi></msub><mo>=</mo><msqrt><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msubsup><mi>β</mi><mn>2</mn><mi>j</mi></msubsup></mrow></msqrt></mrow><annotation encoding="application/x-tex">\Omega_{t}=\sqrt{\sum_{j=0}^{t-1}\beta_{2}^{j}}</annotation></semantics></math>,
we have</p>
<table id="A1.EGx29" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex24.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[F(\mathbf{w}_{t})\right]\leq\mathbb{E}\left[F(\mathbf{w}_{t-1})\right]-\frac{\eta_{t}}{2(1+q_{G})R\Omega_{t}}\sum_{k=0}^{t-1}\beta_{1}^{k}\mathbb{E}\left[\|\mathcal{G}_{t-k}\|_{2}^{2}\right]+\frac{\eta_{t}^{2}L}{2}\mathbb{E}\left[\|\mathbf{u}_{t}\|^{2}_{2}\right]+\eta_{t}Q(t)+\eta_{t}d\mathbb{E}\left[\sum_{k=0}^{t-1}\beta_{1}^{k}M_{t-k}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>η</mi><mi>t</mi></msub><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Ω</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>η</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐮</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[F(\mathbf{w}_{t})\right]\leq\mathbb{E}\left[F(\mathbf{w}_{t-1})\right]-\frac{\eta_{t}}{2(1+q_{G})R\Omega_{t}}\sum_{k=0}^{t-1}\beta_{1}^{k}\mathbb{E}\left[\|\mathcal{G}_{t-k}\|_{2}^{2}\right]+\frac{\eta_{t}^{2}L}{2}\mathbb{E}\left[\|\mathbf{u}_{t}\|^{2}_{2}\right]+\eta_{t}Q(t)+\eta_{t}d\mathbb{E}\left[\sum_{k=0}^{t-1}\beta_{1}^{k}M_{t-k}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E25.m1" class="ltx_Math" alttext="\displaystyle\quad+\frac{\eta_{t}^{3}L^{2}}{4(1+q_{G})R}\sqrt{1-\beta_{1}}\left(\sum_{l=1}^{t-1}\|\mathbf{u}_{t-l}\|_{2}^{2}\sum_{k=l}^{t-1}\beta_{1}^{k}\sqrt{k}\right)+\frac{3\eta_{t}(1+q_{G})R}{\sqrt{1-\beta_{1}}}\left(\sum_{k=0}^{t-1}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{k}\sqrt{k+1}\|\mathbf{U}_{t-k}\|_{2}^{2}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>η</mi><mi>t</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐮</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mi>l</mi></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>k</mi></msqrt></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>β</mi><mn>1</mn></msub><msub><mi>β</mi><mn>2</mn></msub></mfrac></mstyle><mo>)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐔</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\frac{\eta_{t}^{3}L^{2}}{4(1+q_{G})R}\sqrt{1-\beta_{1}}\left(\sum_{l=1}^{t-1}\|\mathbf{u}_{t-l}\|_{2}^{2}\sum_{k=l}^{t-1}\beta_{1}^{k}\sqrt{k}\right)+\frac{3\eta_{t}(1+q_{G})R}{\sqrt{1-\beta_{1}}}\left(\sum_{k=0}^{t-1}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{k}\sqrt{k+1}\|\mathbf{U}_{t-k}\|_{2}^{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.25)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.p14" class="ltx_para">
<p id="A1.SS2.p14.1" class="ltx_p">Now summing over all iterations <math id="A1.SS2.p14.m1" class="ltx_Math" alttext="t\in[T]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[T]</annotation></semantics></math> for <math id="A1.SS2.p14.m2" class="ltx_Math" alttext="T\in\mathbb{N}^{*}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>∈</mo><msup><mi>ℕ</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">T\in\mathbb{N}^{*}</annotation></semantics></math>, and <math id="A1.SS2.p14.m3" class="ltx_Math" alttext="\eta_{t}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\eta_{t}</annotation></semantics></math> is non-decreasing, as well the fact that <math id="A1.SS2.p14.m4" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> is bounded below by <math id="A1.SS2.p14.m5" class="ltx_Math" alttext="F_{*}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mo>∗</mo></msub><annotation encoding="application/x-tex">F_{*}</annotation></semantics></math>, we get</p>
<table id="A1.EGx30" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex25.m1" class="ltx_Math" alttext="\displaystyle\underbrace{\frac{1}{2(1+q_{G})R}\sum_{t=1}^{T}\frac{\eta_{t}}{\Omega_{t}}\sum_{k=0}^{t-1}\beta_{1}^{k}\mathbb{E}\left[\|\mathcal{G}_{t-k}\|_{2}^{2}\right]}_{\tilde{A}}\leq F(\mathbf{w}_{0})-F_{*}+\underbrace{\frac{\eta_{T}^{2}L}{2}\sum_{t=1}^{T}\mathbb{E}\left[\|\mathbf{u}_{t}\|^{2}_{2}\right]}_{\tilde{B}}+\underbrace{\eta_{T}\sum_{t=1}^{T}Q(t)}_{E_{Q}}+\underbrace{\eta_{T}d\sum_{t=1}^{T}\mathbb{E}\left[\sum_{k=0}^{t-1}\beta_{1}^{k}M_{t-k}\right]}_{M}" display="inline" intent=":literal"><semantics><mrow><munder><munder accentunder="true"><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><msub><mi>η</mi><mi>t</mi></msub><msub><mi mathvariant="normal">Ω</mi><mi>t</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo stretchy="true">⏟</mo></munder><mover accent="true"><mi>A</mi><mo>~</mo></mover></munder><mo>≤</mo><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>F</mi><mo>∗</mo></msub></mrow><mo>+</mo><munder><munder accentunder="true"><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>η</mi><mi>T</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐮</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow></mrow><mo stretchy="true">⏟</mo></munder><mover accent="true"><mi>B</mi><mo>~</mo></mover></munder><mo>+</mo><munder><munder accentunder="true"><mrow><msub><mi>η</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="true">⏟</mo></munder><msub><mi>E</mi><mi>Q</mi></msub></munder><mo>+</mo><munder><munder accentunder="true"><mrow><msub><mi>η</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo stretchy="true">⏟</mo></munder><mi>M</mi></munder></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\underbrace{\frac{1}{2(1+q_{G})R}\sum_{t=1}^{T}\frac{\eta_{t}}{\Omega_{t}}\sum_{k=0}^{t-1}\beta_{1}^{k}\mathbb{E}\left[\|\mathcal{G}_{t-k}\|_{2}^{2}\right]}_{\tilde{A}}\leq F(\mathbf{w}_{0})-F_{*}+\underbrace{\frac{\eta_{T}^{2}L}{2}\sum_{t=1}^{T}\mathbb{E}\left[\|\mathbf{u}_{t}\|^{2}_{2}\right]}_{\tilde{B}}+\underbrace{\eta_{T}\sum_{t=1}^{T}Q(t)}_{E_{Q}}+\underbrace{\eta_{T}d\sum_{t=1}^{T}\mathbb{E}\left[\sum_{k=0}^{t-1}\beta_{1}^{k}M_{t-k}\right]}_{M}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E26.m1" class="ltx_Math" alttext="\displaystyle\quad+\underbrace{\frac{\eta_{T}^{3}L^{2}}{4(1+q_{G})R}\sqrt{1-\beta_{1}}\sum_{t=1}^{T}\sum_{l=1}^{t-1}\mathbb{E}\left[\|\mathbf{u}_{t-l}\|^{2}_{2}\right]\sum_{k=l}^{t-1}\beta_{1}^{k}\sqrt{k}}_{\tilde{C}}+\underbrace{\frac{3\eta_{T}(1+q_{G})R}{\sqrt{1-\beta_{1}}}\sum_{t=1}^{T}\sum_{k=0}^{t-1}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{k}\sqrt{k+1}\mathbb{E}\left[\|\mathbf{U}_{t-k}\|^{2}_{2}\right]}_{\tilde{D}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><munder><munder accentunder="true"><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>η</mi><mi>T</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐮</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mi>l</mi></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>k</mi></msqrt></mrow></mrow></mrow></mrow></mrow></mrow><mo stretchy="true">⏟</mo></munder><mover accent="true"><mi>C</mi><mo>~</mo></mover></munder></mrow><mo>+</mo><munder><munder accentunder="true"><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>β</mi><mn>1</mn></msub><msub><mi>β</mi><mn>2</mn></msub></mfrac></mstyle><mo>)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐔</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow></mrow></mrow><mo stretchy="true">⏟</mo></munder><mover accent="true"><mi>D</mi><mo>~</mo></mover></munder></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\underbrace{\frac{\eta_{T}^{3}L^{2}}{4(1+q_{G})R}\sqrt{1-\beta_{1}}\sum_{t=1}^{T}\sum_{l=1}^{t-1}\mathbb{E}\left[\|\mathbf{u}_{t-l}\|^{2}_{2}\right]\sum_{k=l}^{t-1}\beta_{1}^{k}\sqrt{k}}_{\tilde{C}}+\underbrace{\frac{3\eta_{T}(1+q_{G})R}{\sqrt{1-\beta_{1}}}\sum_{t=1}^{T}\sum_{k=0}^{t-1}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{k}\sqrt{k+1}\mathbb{E}\left[\|\mathbf{U}_{t-k}\|^{2}_{2}\right]}_{\tilde{D}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.26)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.p15" class="ltx_para">
<p id="A1.SS2.p15.1" class="ltx_p">First lets bound Term <math id="A1.SS2.p15.m1" class="ltx_Math" alttext="\tilde{A}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>A</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{A}</annotation></semantics></math>. We have <math id="A1.SS2.p15.m2" class="ltx_Math" alttext="\eta_{t}=(1-\beta_{1})\Omega_{t}\eta" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>t</mi></msub><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Ω</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mrow><annotation encoding="application/x-tex">\eta_{t}=(1-\beta_{1})\Omega_{t}\eta</annotation></semantics></math>. Thus, we can simplify the <math id="A1.SS2.p15.m3" class="ltx_Math" alttext="\tilde{A}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>A</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{A}</annotation></semantics></math> term from (<a href="#A1.E26" title="In A.2 Detailed Proof ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.26</span></a>), also using the usual change of index <math id="A1.SS2.p15.m4" class="ltx_Math" alttext="j=t-k" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></mrow><annotation encoding="application/x-tex">j=t-k</annotation></semantics></math>, to get</p>
<table id="A1.EGx31" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex26.m1" class="ltx_Math" alttext="\displaystyle\tilde{A}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>A</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\displaystyle\tilde{A}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex26.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{2(1+q_{G})R}\sum_{t=1}^{T}\frac{\eta_{t}}{\Omega_{t}}\sum_{j=1}^{t}\beta_{1}^{t-j}\mathbb{E}\left[\|\mathcal{G}_{j}\|_{2}^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><msub><mi>η</mi><mi>t</mi></msub><msub><mi mathvariant="normal">Ω</mi><mi>t</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mrow><mi>t</mi><mo>−</mo><mi>j</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>j</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{2(1+q_{G})R}\sum_{t=1}^{T}\frac{\eta_{t}}{\Omega_{t}}\sum_{j=1}^{t}\beta_{1}^{t-j}\mathbb{E}\left[\|\mathcal{G}_{j}\|_{2}^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex27.m1" class="ltx_Math" alttext="\displaystyle=\frac{\eta(1-\beta_{1})}{2(1+q_{G})R}\sum_{j=1}^{T}\mathbb{E}\left[\|\mathcal{G}_{j}\|_{2}^{2}\right]\sum_{t=j}^{T}\beta_{1}^{t-j}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>j</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mi>j</mi></mrow><mi>T</mi></munderover></mstyle><msubsup><mi>β</mi><mn>1</mn><mrow><mi>t</mi><mo>−</mo><mi>j</mi></mrow></msubsup></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\eta(1-\beta_{1})}{2(1+q_{G})R}\sum_{j=1}^{T}\mathbb{E}\left[\|\mathcal{G}_{j}\|_{2}^{2}\right]\sum_{t=j}^{T}\beta_{1}^{t-j}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex28.m1" class="ltx_Math" alttext="\displaystyle=\frac{\eta}{2(1+q_{G})R}\sum_{j=1}^{T}(1-\beta_{1}^{T-j+1})\mathbb{E}\left[\|\mathcal{G}_{j}\|_{2}^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mi>η</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msubsup><mi>β</mi><mn>1</mn><mrow><mrow><mi>T</mi><mo>−</mo><mi>j</mi></mrow><mo>+</mo><mn>1</mn></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>j</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\eta}{2(1+q_{G})R}\sum_{j=1}^{T}(1-\beta_{1}^{T-j+1})\mathbb{E}\left[\|\mathcal{G}_{j}\|_{2}^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex29.m1" class="ltx_Math" alttext="\displaystyle=\frac{\eta}{2(1+q_{G})R}\sum_{j=1}^{T}(1-\beta_{1}^{T-j+1})\mathbb{E}\left[\|\nabla F(\mathbf{w}_{j-1})\|_{2}^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mi>η</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msubsup><mi>β</mi><mn>1</mn><mrow><mrow><mi>T</mi><mo>−</mo><mi>j</mi></mrow><mo>+</mo><mn>1</mn></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\eta}{2(1+q_{G})R}\sum_{j=1}^{T}(1-\beta_{1}^{T-j+1})\mathbb{E}\left[\|\nabla F(\mathbf{w}_{j-1})\|_{2}^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E27.m1" class="ltx_Math" alttext="\displaystyle=\frac{\eta}{2(1+q_{G})R}\sum_{j=0}^{T-1}(1-\beta_{1}^{T-j})\mathbb{E}\left[\|\nabla F(\mathbf{w}_{j})\|_{2}^{2}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mi>η</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msubsup><mi>β</mi><mn>1</mn><mrow><mi>T</mi><mo>−</mo><mi>j</mi></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\eta}{2(1+q_{G})R}\sum_{j=0}^{T-1}(1-\beta_{1}^{T-j})\mathbb{E}\left[\|\nabla F(\mathbf{w}_{j})\|_{2}^{2}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.27)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.p16" class="ltx_para">
<p id="A1.SS2.p16.1" class="ltx_p">To establish our convergence guarantee, we analyze the expected gradient norm at a randomly selected iteration <math id="A1.SS2.p16.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>, drawn from the set <math id="A1.SS2.p16.m2" class="ltx_Math" alttext="\{0,\ldots,T-1\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{0,\ldots,T-1\}</annotation></semantics></math>. The selection is not uniform but is instead weighted to properly account for the influence of the momentum term over the iterations. The probability of selecting a specific iteration <math id="A1.SS2.p16.m3" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> is defined as:</p>
<table id="A1.EGx32" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E28.m1" class="ltx_Math" alttext="\displaystyle\forall t\in\{0,\ldots,T-1\},\quad\mathbb{P}(\tau=t)\propto 1-\beta_{1}^{T-t}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo rspace="0.167em">∀</mo><mi>t</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>=</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∝</mo><mrow><mn>1</mn><mo>−</mo><msubsup><mi>β</mi><mn>1</mn><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\forall t\in\{0,\ldots,T-1\},\quad\mathbb{P}(\tau=t)\propto 1-\beta_{1}^{T-t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.28)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p16.2" class="ltx_p">We can notice that</p>
<table id="A1.EGx33" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E29.m1" class="ltx_Math" alttext="\displaystyle\sum_{j=0}^{T-1}(1-\beta_{1}^{T-j})=T-\beta_{1}\frac{1-\beta_{1}^{T}}{1-\beta_{1}}\geq T-\frac{\beta_{1}}{1-\beta_{1}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msubsup><mi>β</mi><mn>1</mn><mrow><mi>T</mi><mo>−</mo><mi>j</mi></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>T</mi><mo>−</mo><mrow><msub><mi>β</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msubsup><mi>β</mi><mn>1</mn><mi>T</mi></msubsup></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></mfrac></mstyle></mrow></mrow><mo>≥</mo><mrow><mi>T</mi><mo>−</mo><mstyle displaystyle="true"><mfrac><msub><mi>β</mi><mn>1</mn></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{j=0}^{T-1}(1-\beta_{1}^{T-j})=T-\beta_{1}\frac{1-\beta_{1}^{T}}{1-\beta_{1}}\geq T-\frac{\beta_{1}}{1-\beta_{1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.29)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p16.3" class="ltx_p">Introducing</p>
<table id="A1.E30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E30.m1" class="ltx_Math" alttext="\tilde{T}=T-\frac{\beta_{1}}{1-\beta_{1}}," display="block" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>T</mi><mo>~</mo></mover><mo>=</mo><mrow><mi>T</mi><mo>−</mo><mfrac><msub><mi>β</mi><mn>1</mn></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></mfrac></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\tilde{T}=T-\frac{\beta_{1}}{1-\beta_{1}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.30)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p16.4" class="ltx_p">we then have</p>
<table id="A1.EGx34" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E31.m1" class="ltx_Math" alttext="\displaystyle\tilde{A}\geq\frac{\eta\tilde{T}}{2(1+q_{G})R}\mathbb{E}\left[\|\nabla F(\mathbf{w}_{\tau})\|_{2}^{2}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo>≥</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>T</mi><mo>~</mo></mover></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>τ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{A}\geq\frac{\eta\tilde{T}}{2(1+q_{G})R}\mathbb{E}\left[\|\nabla F(\mathbf{w}_{\tau})\|_{2}^{2}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.31)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.p17" class="ltx_para">
<p id="A1.SS2.p17.1" class="ltx_p">Next looking at <math id="A1.SS2.p17.m1" class="ltx_Math" alttext="\tilde{B}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>B</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{B}</annotation></semantics></math>, we apply Lemma <a href="#A1.Thmtheorem13" title="Lemma A.13 (Upper bound of ∑_{𝑡=1}^𝑇𝔼[‖𝐮_𝑡‖^2_2]). ‣ A.14 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.13</span></a>,</p>
<table id="A1.EGx35" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E32.m1" class="ltx_Math" alttext="\displaystyle\tilde{B}\leq B^{\prime}\left(\ln\left(1+\frac{((1+q_{G})R)^{2}}{\epsilon(1-\beta_{2}(1-q_{V}))}\right)-T\ln(\beta_{2}(1-q_{V}))\right)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>B</mi><mo>~</mo></mover><mo>≤</mo><mrow><msup><mi>B</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mi>ϵ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{B}\leq B^{\prime}\left(\ln\left(1+\frac{((1+q_{G})R)^{2}}{\epsilon(1-\beta_{2}(1-q_{V}))}\right)-T\ln(\beta_{2}(1-q_{V}))\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.32)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p17.2" class="ltx_p">with</p>
<table id="A1.EGx36" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="A1.E33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E33.m1" class="ltx_Math" alttext="\displaystyle B^{\prime}=\frac{d\eta_{T}^{2}L}{2(1-\beta_{1}(1+q_{M}))(1-\frac{\beta_{1}(1+q_{M})}{\beta_{2}(1-q_{V})})}." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>B</mi><mo>′</mo></msup><mo>=</mo><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>η</mi><mi>T</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>β</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><msub><mi>β</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle B^{\prime}=\frac{d\eta_{T}^{2}L}{2(1-\beta_{1}(1+q_{M}))(1-\frac{\beta_{1}(1+q_{M})}{\beta_{2}(1-q_{V})})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.33)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.p18" class="ltx_para">
<p id="A1.SS2.p18.1" class="ltx_p">Then looking at <math id="A1.SS2.p18.m1" class="ltx_Math" alttext="\tilde{C}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>C</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{C}</annotation></semantics></math> and introducing the change of index <math id="A1.SS2.p18.m2" class="ltx_Math" alttext="j=t-l" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></mrow><annotation encoding="application/x-tex">j=t-l</annotation></semantics></math>,</p>
<table id="A1.EGx37" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex30.m1" class="ltx_Math" alttext="\displaystyle\tilde{C}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>C</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\displaystyle\tilde{C}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex30.m2" class="ltx_Math" alttext="\displaystyle=\frac{\eta_{T}^{3}L^{2}}{4(1+q_{G})R}\sqrt{1-\beta_{1}}\sum_{t=1}^{T}\sum_{j=1}^{t}\mathbb{E}\left[\|\mathbf{u}_{j}\|^{2}_{2}\right]\sum_{k=t-j}^{t-1}\beta_{1}^{k}\sqrt{k}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>η</mi><mi>T</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐮</mi><mi>j</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>j</mi></mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>k</mi></msqrt></mrow></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\eta_{T}^{3}L^{2}}{4(1+q_{G})R}\sqrt{1-\beta_{1}}\sum_{t=1}^{T}\sum_{j=1}^{t}\mathbb{E}\left[\|\mathbf{u}_{j}\|^{2}_{2}\right]\sum_{k=t-j}^{t-1}\beta_{1}^{k}\sqrt{k}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex31.m1" class="ltx_Math" alttext="\displaystyle=\frac{\eta_{T}^{3}L^{2}}{4(1+q_{G})R}\sqrt{1-\beta_{1}}\sum_{j=1}^{T}\mathbb{E}\left[\|\mathbf{u}_{j}\|^{2}_{2}\right]\sum_{t=j}^{T}\sum_{k=t-j}^{t-1}\beta_{1}^{k}\sqrt{k}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>η</mi><mi>T</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐮</mi><mi>j</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mi>j</mi></mrow><mi>T</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>j</mi></mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>k</mi></msqrt></mrow></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\eta_{T}^{3}L^{2}}{4(1+q_{G})R}\sqrt{1-\beta_{1}}\sum_{j=1}^{T}\mathbb{E}\left[\|\mathbf{u}_{j}\|^{2}_{2}\right]\sum_{t=j}^{T}\sum_{k=t-j}^{t-1}\beta_{1}^{k}\sqrt{k}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex32.m1" class="ltx_Math" alttext="\displaystyle=\frac{\eta_{T}^{3}L^{2}}{4(1+q_{G})R}\sqrt{1-\beta_{1}}\sum_{j=1}^{T}\mathbb{E}\left[\|\mathbf{u}_{j}\|^{2}_{2}\right]\sum_{k=0}^{T-1}\beta_{1}^{k}\sqrt{k}\sum_{t=j}^{j+k}1" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>η</mi><mi>T</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐮</mi><mi>j</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>k</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mi>j</mi></mrow><mrow><mi>j</mi><mo>+</mo><mi>k</mi></mrow></munderover></mstyle><mn>1</mn></mrow></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\eta_{T}^{3}L^{2}}{4(1+q_{G})R}\sqrt{1-\beta_{1}}\sum_{j=1}^{T}\mathbb{E}\left[\|\mathbf{u}_{j}\|^{2}_{2}\right]\sum_{k=0}^{T-1}\beta_{1}^{k}\sqrt{k}\sum_{t=j}^{j+k}1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex33.m1" class="ltx_Math" alttext="\displaystyle=\frac{\eta_{T}^{3}L^{2}}{4(1+q_{G})R}\sqrt{1-\beta_{1}}\sum_{j=1}^{T}\mathbb{E}\left[\|\mathbf{u}_{j}\|^{2}_{2}\right]\sum_{k=0}^{T-1}\beta_{1}^{k}\sqrt{k}(k+1)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>η</mi><mi>T</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐮</mi><mi>j</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>k</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\eta_{T}^{3}L^{2}}{4(1+q_{G})R}\sqrt{1-\beta_{1}}\sum_{j=1}^{T}\mathbb{E}\left[\|\mathbf{u}_{j}\|^{2}_{2}\right]\sum_{k=0}^{T-1}\beta_{1}^{k}\sqrt{k}(k+1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E34.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{\eta_{T}^{3}L^{2}}{(1+q_{G})R}\sum_{j=1}^{T}\mathbb{E}\left[\|\mathbf{u}_{j}\|^{2}_{2}\right]\frac{\beta_{1}}{(1-\beta_{1})^{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>η</mi><mi>T</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐮</mi><mi>j</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi>β</mi><mn>1</mn></msub><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\eta_{T}^{3}L^{2}}{(1+q_{G})R}\sum_{j=1}^{T}\mathbb{E}\left[\|\mathbf{u}_{j}\|^{2}_{2}\right]\frac{\beta_{1}}{(1-\beta_{1})^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.34)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p18.2" class="ltx_p">using Lemma <a href="#A1.Thmtheorem12" title="Lemma A.12 (Lemma A.4 in [ ] ). ‣ A.13 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.12</span></a>. Finally, using Lemma <a href="#A1.Thmtheorem13" title="Lemma A.13 (Upper bound of ∑_{𝑡=1}^𝑇𝔼[‖𝐮_𝑡‖^2_2]). ‣ A.14 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.13</span></a>, we get</p>
<table id="A1.E35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E35.m1" class="ltx_Math" alttext="\tilde{C}\leq C^{\prime}\left(\ln\left(1+\frac{((1+q_{G})R)^{2}}{\epsilon(1-\beta_{2}(1-q_{V}))}\right)-T\ln(\beta_{2}(1-q_{V}))\right)." display="block" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>C</mi><mo>~</mo></mover><mo>≤</mo><mrow><msup><mi>C</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mi>ϵ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{C}\leq C^{\prime}\left(\ln\left(1+\frac{((1+q_{G})R)^{2}}{\epsilon(1-\beta_{2}(1-q_{V}))}\right)-T\ln(\beta_{2}(1-q_{V}))\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.35)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p18.3" class="ltx_p">with</p>
<table id="A1.EGx38" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="A1.E36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E36.m1" class="ltx_Math" alttext="\displaystyle C^{\prime}=\frac{d\eta_{T}^{3}L^{2}\beta_{1}}{(1+q_{G})R(1-\beta_{1})^{2}(1-\beta_{1}(1+q_{M}))(1-\frac{\beta_{1}(1+q_{M})}{\beta_{2}(1-q_{V})})}." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>C</mi><mo>′</mo></msup><mo>=</mo><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>η</mi><mi>T</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>β</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><msub><mi>β</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle C^{\prime}=\frac{d\eta_{T}^{3}L^{2}\beta_{1}}{(1+q_{G})R(1-\beta_{1})^{2}(1-\beta_{1}(1+q_{M}))(1-\frac{\beta_{1}(1+q_{M})}{\beta_{2}(1-q_{V})})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.36)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.p19" class="ltx_para">
<p id="A1.SS2.p19.1" class="ltx_p">introducing the same change of index <math id="A1.SS2.p19.m1" class="ltx_Math" alttext="j=t-k" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></mrow><annotation encoding="application/x-tex">j=t-k</annotation></semantics></math> for <math id="A1.SS2.p19.m2" class="ltx_Math" alttext="\tilde{D}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>D</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{D}</annotation></semantics></math>, we get</p>
<table id="A1.EGx39" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex34.m1" class="ltx_Math" alttext="\displaystyle\tilde{D}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>D</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\displaystyle\tilde{D}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex34.m2" class="ltx_Math" alttext="\displaystyle=\frac{3\eta_{T}(1+q_{G})R}{\sqrt{1-\beta_{1}}}\sum_{t=1}^{T}\sum_{j=1}^{t}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{t-j}\sqrt{1+t-j}\mathbb{E}\left[\|\mathbf{U}_{j}\|_{2}^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>β</mi><mn>1</mn></msub><msub><mi>β</mi><mn>2</mn></msub></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mi>j</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>j</mi></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐔</mi><mi>j</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{3\eta_{T}(1+q_{G})R}{\sqrt{1-\beta_{1}}}\sum_{t=1}^{T}\sum_{j=1}^{t}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{t-j}\sqrt{1+t-j}\mathbb{E}\left[\|\mathbf{U}_{j}\|_{2}^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex35.m1" class="ltx_Math" alttext="\displaystyle=\frac{3\eta_{T}(1+q_{G})R}{\sqrt{1-\beta_{1}}}\sum_{j=1}^{T}\mathbb{E}\left[\|\mathbf{U}_{j}\|_{2}^{2}\right]\sum_{t=j}^{T}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{t-j}\sqrt{1+t-j}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐔</mi><mi>j</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mi>j</mi></mrow><mi>T</mi></munderover></mstyle><mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>β</mi><mn>1</mn></msub><msub><mi>β</mi><mn>2</mn></msub></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mi>j</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>j</mi></mrow></msqrt></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{3\eta_{T}(1+q_{G})R}{\sqrt{1-\beta_{1}}}\sum_{j=1}^{T}\mathbb{E}\left[\|\mathbf{U}_{j}\|_{2}^{2}\right]\sum_{t=j}^{T}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{t-j}\sqrt{1+t-j}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E37.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{6\eta_{T}(1+q_{G})R}{\sqrt{1-\beta_{1}}}\sum_{j=1}^{T}\mathbb{E}\left[\|\mathbf{U}_{j}\|_{2}^{2}\right]\frac{1}{(1-\beta_{1}/\beta_{2})^{3/2}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐔</mi><mi>j</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>/</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup></mfrac></mstyle></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{6\eta_{T}(1+q_{G})R}{\sqrt{1-\beta_{1}}}\sum_{j=1}^{T}\mathbb{E}\left[\|\mathbf{U}_{j}\|_{2}^{2}\right]\frac{1}{(1-\beta_{1}/\beta_{2})^{3/2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.37)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p19.2" class="ltx_p">using Lemma <a href="#A1.Thmtheorem11" title="Lemma A.11 (Lemma A.3 in [ ] ). ‣ A.12 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.11</span></a>. Finally, using Lemma <a href="#A1.Thmtheorem10" title="Lemma A.10 (Lemma A.2 in [ ] ). ‣ A.11 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.10</span></a>, we get</p>
<table id="A1.EGx40" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex36.m1" class="ltx_Math" alttext="\displaystyle\tilde{D}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>D</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\displaystyle\tilde{D}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex36.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{6\eta_{T}(1+q_{G})R}{\sqrt{1-\beta_{1}}(1-\beta_{1}/\beta_{2})^{3/2}}\sum_{i\in[d]}\left(\ln\left(1+\frac{v^{\prime}_{T,i}}{\epsilon}\right)-T\ln(\beta_{2})\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>/</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>v</mi><mrow><mi>T</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup><mi>ϵ</mi></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{6\eta_{T}(1+q_{G})R}{\sqrt{1-\beta_{1}}(1-\beta_{1}/\beta_{2})^{3/2}}\sum_{i\in[d]}\left(\ln\left(1+\frac{v^{\prime}_{T,i}}{\epsilon}\right)-T\ln(\beta_{2})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E38.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{6d\eta_{T}(1+q_{G})R}{\sqrt{1-\beta_{1}}(1-\beta_{1}/\beta_{2})^{3/2}}\left(\ln\left(1+\frac{((1+q_{G})R)^{2}}{\epsilon(1-\beta_{2})}\right)-T\ln(\beta_{2})\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>/</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mi>ϵ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{6d\eta_{T}(1+q_{G})R}{\sqrt{1-\beta_{1}}(1-\beta_{1}/\beta_{2})^{3/2}}\left(\ln\left(1+\frac{((1+q_{G})R)^{2}}{\epsilon(1-\beta_{2})}\right)-T\ln(\beta_{2})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.38)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.p20" class="ltx_para">
<p id="A1.SS2.p20.1" class="ltx_p">Then we rewrite the quantization error term <math id="A1.SS2.p20.m1" class="ltx_Math" alttext="E_{Q}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>Q</mi></msub><annotation encoding="application/x-tex">E_{Q}</annotation></semantics></math>:</p>
<table id="A1.EGx41" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex37.m1" class="ltx_Math" alttext="\displaystyle E_{Q}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>Q</mi></msub><annotation encoding="application/x-tex">\displaystyle E_{Q}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex37.m2" class="ltx_Math" alttext="\displaystyle=\eta_{T}\sum_{t=1}^{T}\left(q_{M}\cdot dR\cdot C_{q}+\frac{dR(1-(1-q_{V})^{t})}{\sqrt{1-\frac{\beta_{1}^{2}}{\beta_{2}(1-q_{V})}}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>η</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mo>(</mo><mrow><mrow><mrow><mrow><msub><mi>q</mi><mi>M</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>C</mi><mi>q</mi></msub></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mi>t</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><mfrac><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></msqrt></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\eta_{T}\sum_{t=1}^{T}\left(q_{M}\cdot dR\cdot C_{q}+\frac{dR(1-(1-q_{V})^{t})}{\sqrt{1-\frac{\beta_{1}^{2}}{\beta_{2}(1-q_{V})}}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex38.m1" class="ltx_Math" alttext="\displaystyle=\eta_{T}\left(\sum_{t=1}^{T}\left(q_{M}\cdot dR\cdot C_{q}+\frac{dR}{\sqrt{1-\frac{\beta_{1}^{2}}{\beta_{2}(1-q_{V})}}}\right)-\sum_{t=1}^{T}\frac{dR(1-q_{V})^{t}}{\sqrt{1-\frac{\beta_{1}^{2}}{\beta_{2}(1-q_{V})}}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>η</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mo>(</mo><mrow><mrow><mrow><mrow><msub><mi>q</mi><mi>M</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>C</mi><mi>q</mi></msub></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><mfrac><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></msqrt></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mi>t</mi></msup></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><mfrac><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></msqrt></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\eta_{T}\left(\sum_{t=1}^{T}\left(q_{M}\cdot dR\cdot C_{q}+\frac{dR}{\sqrt{1-\frac{\beta_{1}^{2}}{\beta_{2}(1-q_{V})}}}\right)-\sum_{t=1}^{T}\frac{dR(1-q_{V})^{t}}{\sqrt{1-\frac{\beta_{1}^{2}}{\beta_{2}(1-q_{V})}}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex39.m1" class="ltx_Math" alttext="\displaystyle=\eta_{T}\left(T\left(q_{M}\cdot dR\cdot C_{q}+\frac{dR}{\sqrt{1-\frac{\beta_{1}^{2}}{\beta_{2}(1-q_{V})}}}\right)-\frac{dR}{\sqrt{1-\frac{\beta_{1}^{2}}{\beta_{2}(1-q_{V})}}}\sum_{t=1}^{T}(1-q_{V})^{t}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>η</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mrow><mrow><msub><mi>q</mi><mi>M</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>C</mi><mi>q</mi></msub></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><mfrac><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></msqrt></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><mfrac><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mi>t</mi></msup></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\eta_{T}\left(T\left(q_{M}\cdot dR\cdot C_{q}+\frac{dR}{\sqrt{1-\frac{\beta_{1}^{2}}{\beta_{2}(1-q_{V})}}}\right)-\frac{dR}{\sqrt{1-\frac{\beta_{1}^{2}}{\beta_{2}(1-q_{V})}}}\sum_{t=1}^{T}(1-q_{V})^{t}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex40"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex40.m1" class="ltx_Math" alttext="\displaystyle=\eta_{T}\left(T\cdot q_{M}\cdot dR\cdot C_{q}+\frac{TdR}{\sqrt{1-\frac{\beta_{1}^{2}}{\beta_{2}(1-q_{V})}}}-\frac{dR}{\sqrt{1-\frac{\beta_{1}^{2}}{\beta_{2}(1-q_{V})}}}\left(\frac{1-q_{V}}{q_{V}}(1-(1-q_{V})^{T})\right)\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>η</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mi>T</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>q</mi><mi>M</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>C</mi><mi>q</mi></msub></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><mfrac><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></msqrt></mfrac></mstyle></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><mfrac><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><msub><mi>q</mi><mi>V</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mi>T</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\eta_{T}\left(T\cdot q_{M}\cdot dR\cdot C_{q}+\frac{TdR}{\sqrt{1-\frac{\beta_{1}^{2}}{\beta_{2}(1-q_{V})}}}-\frac{dR}{\sqrt{1-\frac{\beta_{1}^{2}}{\beta_{2}(1-q_{V})}}}\left(\frac{1-q_{V}}{q_{V}}(1-(1-q_{V})^{T})\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.p21" class="ltx_para">
<p id="A1.SS2.p21.1" class="ltx_p">Finally, we bound Term M using Lemma <a href="#A1.Thmtheorem14" title="Lemma A.14 (Bound on Term M). ‣ A.15 Proof of Lemma (Bound on Term M) ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.14</span></a>:</p>
<table id="A1.EGx42" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E40"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E40.m1" class="ltx_Math" alttext="\displaystyle M\leq\frac{\eta_{T}dT}{\sqrt{\epsilon}(1-\beta_{1})}\left(q_{G}R^{2}+Lq_{W}R\|\mathbf{w}_{0}\|_{2}\right)+\frac{\eta_{T}^{2}d^{\frac{3}{2}}Lq_{W}RT^{2}}{2\sqrt{\epsilon}(1-\beta_{1})\sqrt{1-\frac{\beta_{1}^{2}(1+q_{M})^{2}}{\beta_{2}(1-q_{V})}}}," display="inline" intent=":literal"><semantics><mrow><mrow><mi>M</mi><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>η</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mrow><msqrt><mi>ϵ</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐰</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>η</mi><mi>T</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mfrac><mn>3</mn><mn>2</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mn>2</mn></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>ϵ</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></msqrt></mrow></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle M\leq\frac{\eta_{T}dT}{\sqrt{\epsilon}(1-\beta_{1})}\left(q_{G}R^{2}+Lq_{W}R\|\mathbf{w}_{0}\|_{2}\right)+\frac{\eta_{T}^{2}d^{\frac{3}{2}}Lq_{W}RT^{2}}{2\sqrt{\epsilon}(1-\beta_{1})\sqrt{1-\frac{\beta_{1}^{2}(1+q_{M})^{2}}{\beta_{2}(1-q_{V})}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.40)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.p22" class="ltx_para">
<p id="A1.SS2.p22.1" class="ltx_p">Now putting (<a href="#A1.E31" title="In A.2 Detailed Proof ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.31</span></a>), (<a href="#A1.E32" title="In A.2 Detailed Proof ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.32</span></a>), (<a href="#A1.E35" title="In A.2 Detailed Proof ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.35</span></a>), (<a href="#A1.E38" title="In A.2 Detailed Proof ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.38</span></a>), (<span class="ltx_ref ltx_missing_label ltx_ref_self"></span>) and (<a href="#A1.E40" title="In A.2 Detailed Proof ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.40</span></a>) together into (<a href="#A1.E26" title="In A.2 Detailed Proof ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.26</span></a>) and noting that <math id="A1.SS2.p22.m1" class="ltx_Math" alttext="\eta_{T}\leq\eta\frac{1-\beta_{1}}{\sqrt{1-\beta_{2}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>T</mi></msub><mo>≤</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></msqrt></mfrac></mrow></mrow><annotation encoding="application/x-tex">\eta_{T}\leq\eta\frac{1-\beta_{1}}{\sqrt{1-\beta_{2}}}</annotation></semantics></math>, we get:</p>
</div>
<div id="A1.SS2.p23" class="ltx_para">
<table id="A1.EGx43" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex41"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex41.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\|\nabla F(\mathbf{w}_{\tau})\|_{2}^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>τ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\|\nabla F(\mathbf{w}_{\tau})\|_{2}^{2}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex41.m2" class="ltx_Math" alttext="\displaystyle\leq 2(1+q_{G})R\frac{F_{0}-F_{*}}{\eta\tilde{T}}+\frac{E}{\tilde{T}}\left(\ln\left(1+\frac{((1+q_{G})R)^{2}}{\epsilon(1-\beta_{2})}\right)-T\ln(\beta_{2})\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>F</mi><mn>0</mn></msub><mo>−</mo><msub><mi>F</mi><mo>∗</mo></msub></mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>T</mi><mo>~</mo></mover></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>E</mi><mover accent="true"><mi>T</mi><mo>~</mo></mover></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mi>ϵ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2(1+q_{G})R\frac{F_{0}-F_{*}}{\eta\tilde{T}}+\frac{E}{\tilde{T}}\left(\ln\left(1+\frac{((1+q_{G})R)^{2}}{\epsilon(1-\beta_{2})}\right)-T\ln(\beta_{2})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex42"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex42.m1" class="ltx_Math" alttext="\displaystyle+\frac{H}{\tilde{T}}\left(\ln\left(1+\frac{((1+q_{G})R)^{2}}{\epsilon(1-\beta_{2}(1-q_{V}))}\right)-T\ln(\beta_{2}(1-q_{V}))\right)+\frac{Q(T)}{\tilde{T}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>H</mi><mover accent="true"><mi>T</mi><mo>~</mo></mover></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mi>ϵ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mi>T</mi><mo>~</mo></mover></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{H}{\tilde{T}}\left(\ln\left(1+\frac{((1+q_{G})R)^{2}}{\epsilon(1-\beta_{2}(1-q_{V}))}\right)-T\ln(\beta_{2}(1-q_{V}))\right)+\frac{Q(T)}{\tilde{T}}</annotation></semantics></math></td>
