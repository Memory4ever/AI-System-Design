<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E4.m2" class="ltx_Math" alttext="\displaystyle\beta\mathbf{Y}_{t-1}+(1-\beta)\frac{1}{B}\sum_{i=1}^{B}\nabla^{Q}f(\mathbf{W}_{t};\bm{\xi}_{t,i})," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐘</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>B</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></munderover></mstyle><mrow><mrow><msup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>Q</mi></msup><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝝃</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\beta\mathbf{Y}_{t-1}+(1-\beta)\frac{1}{B}\sum_{i=1}^{B}\nabla^{Q}f(\mathbf{W}_{t};\bm{\xi}_{t,i}),</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E4.m3" class="ltx_Math" alttext="\displaystyle\mathbf{Y}_{0}=\frac{1}{B}\sum_{i=1}^{B}\nabla^{Q}f(\mathbf{W}_{0};\bm{\xi}_{0,i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐘</mi><mn>0</mn></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>B</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></munderover></mstyle><mrow><mrow><msup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>Q</mi></msup><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mn>0</mn></msub><mo>,</mo><msub><mi>𝝃</mi><mrow><mn>0</mn><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{Y}_{0}=\frac{1}{B}\sum_{i=1}^{B}\nabla^{Q}f(\mathbf{W}_{0};\bm{\xi}_{0,i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(B.4)</span></td></tr></tbody>
<tbody id="A2.E5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
