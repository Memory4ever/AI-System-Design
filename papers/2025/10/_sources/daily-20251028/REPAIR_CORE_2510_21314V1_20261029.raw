<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex131.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex131.m2" class="ltx_Math" alttext="\displaystyle(1-\beta)\sum_{k=1}^{t}\beta^{t-k}\frac{1}{B}\sum_{i=1}^{B}q_{G}(\sigma+Lq_{W}\mathbb{E}[\|\mathbf{W}_{k}\|_{F}]+\mathbb{E}[\|\nabla F(\mathbf{W}_{k})\|_{F}])" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>β</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>B</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></munderover></mstyle><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐖</mi><mi>k</mi></msub><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(1-\beta)\sum_{k=1}^{t}\beta^{t-k}\frac{1}{B}\sum_{i=1}^{B}q_{G}(\sigma+Lq_{W}\mathbb{E}[\|\mathbf{W}_{k}\|_{F}]+\mathbb{E}[\|\nabla F(\mathbf{W}_{k})\|_{F}])</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex132"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex132.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex132.m2" class="ltx_Math" alttext="\displaystyle(1-\beta)\sum_{k=1}^{t}\beta^{t-k}\frac{1}{B}\sum_{i=1}^{B}q_{G}(\sigma+Lq_{W}(D+t\eta\sqrt{r})+G+t\eta\sqrt{r}L)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>β</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>B</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></munderover></mstyle><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>D</mi><mo>+</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>G</mi><mo>+</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(1-\beta)\sum_{k=1}^{t}\beta^{t-k}\frac{1}{B}\sum_{i=1}^{B}q_{G}(\sigma+Lq_{W}(D+t\eta\sqrt{r})+G+t\eta\sqrt{r}L)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E16.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E16.m2" class="ltx_Math" alttext="\displaystyle(1-\beta^{t})q_{G}(\sigma+G+q_{W}DL+(1+q_{W})t\eta\sqrt{r}L)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>β</mi><mi>t</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>+</mo><mi>G</mi><mo>+</mo><mrow><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>W</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle(1-\beta^{t})q_{G}(\sigma+G+q_{W}DL+(1+q_{W})t\eta\sqrt{r}L).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(B.16)</span></td></tr></tbody>
</table>
<p id="A2.SS8.SSS0.Px6.p1.1" class="ltx_p">The first inequality is due to Definition <a href="#A2.Ex1" title="In B.1 Preliminaries ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.6</span></a> and the triangle inequality. The second inequality is due to Assumption <a href="#S4.Thmtheorem2" title="Assumption 4.2 (Stochastic Gradient Bounds). ‣ 4 Main Results ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>. The third inequality is due to Assumption <a href="#S4.Thmtheorem3" title="Assumption 4.3 (Smoothness). ‣ 4 Main Results ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a> and the triangle inequality. The fourth inequality is due to Definition <a href="#A2.Ex1" title="In B.1 Preliminaries ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.6</span></a>. The fifth inequality is due to Lemma <a href="#A2.Thmtheorem1" title="Lemma B.1 (Bound of ‖𝐖‖_𝐹 and ‖∇𝐹⁢(𝐖)‖_𝐹 for Muon). ‣ B.3 Proof of Lemma ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1</span></a>.</p>
</div>
</section>
<section id="A2.SS8.SSS0.Px7" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Bound on <math id="A2.SS8.SSS0.Px7.m1" class="ltx_Math" alttext="\mathbb{E}[\|\mathbf{Y}_{t}-\mathbf{Z}_{t}\|_{F}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐘</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝐙</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[\|\mathbf{Y}_{t}-\mathbf{Z}_{t}\|_{F}]</annotation></semantics></math>.</h4>

<div id="A2.SS8.SSS0.Px7.p1" class="ltx_para">
<p id="A2.SS8.SSS0.Px7.p1.1" class="ltx_p">Substituting (<a href="#A2.Ex98" title="In Bound on 𝛽^𝑡⁢𝔼⁢[‖𝐘_0-𝐙_0‖_𝐹]. ‣ B.8 Proof of Lemma ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.11</span></a>), (<a href="#A2.Ex108" title="In Bound on A. ‣ B.8 Proof of Lemma ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.12</span></a>), (<a href="#A2.Ex112" title="In Bound on C. ‣ B.8 Proof of Lemma ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.13</span></a>), (<a href="#A2.Ex117" title="In Bound on H. ‣ B.8 Proof of Lemma ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.14</span></a>), (<a href="#A2.Ex122" title="In Bound on I. ‣ B.8 Proof of Lemma ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.15</span></a>) and (<a href="#A2.Ex127" title="In Bound on J. ‣ B.8 Proof of Lemma ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.16</span></a>) into (<a href="#A2.Ex90" title="In Proof of Lemma . ‣ B.8 Proof of Lemma ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.10</span></a>), we have</p>
<table id="A2.EGx185" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex133"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex133.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\|\mathbf{Y}_{t}-\mathbf{Z}_{t}\|_{F}]\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐘</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝐙</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\|\mathbf{Y}_{t}-\mathbf{Z}_{t}\|_{F}]\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex133.m2" class="ltx_Math" alttext="\displaystyle\beta^{t}\cdot\frac{2\sigma}{\sqrt{B}}+\sqrt{\frac{1-\beta}{1+\beta}}\cdot\frac{2\sigma}{\sqrt{B}}+2q_{G}(\sigma+G)+(1-\beta^{t})2q_{G}t\eta\sqrt{r}L+" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>β</mi><mi>t</mi></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow><msqrt><mi>B</mi></msqrt></mfrac></mstyle></mrow><mo>+</mo><mrow><msqrt><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mrow><mn>1</mn><mo>+</mo><mi>β</mi></mrow></mfrac></mstyle></msqrt><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow><msqrt><mi>B</mi></msqrt></mfrac></mstyle></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>+</mo><mi>G</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>β</mi><mi>t</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\beta^{t}\cdot\frac{2\sigma}{\sqrt{B}}+\sqrt{\frac{1-\beta}{1+\beta}}\cdot\frac{2\sigma}{\sqrt{B}}+2q_{G}(\sigma+G)+(1-\beta^{t})2q_{G}t\eta\sqrt{r}L+</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
