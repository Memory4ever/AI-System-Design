<section id="A2.SS8.SSS0.Px8" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Bound on <math id="A2.SS8.SSS0.Px8.m1" class="ltx_Math" alttext="\mathbb{E}[\|\mathbf{Z}_{t}\|_{F}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐙</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[\|\mathbf{Z}_{t}\|_{F}]</annotation></semantics></math>.</h4>

<div id="A2.SS8.SSS0.Px8.p1" class="ltx_para">
<p id="A2.SS8.SSS0.Px8.p1.1" class="ltx_p">By the definition of <math id="A2.SS8.SSS0.Px8.p1.m1" class="ltx_Math" alttext="\mathbf{Z}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝐙</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathbf{Z}_{t}</annotation></semantics></math> in (<a href="#A2.E5" title="In B.1 Preliminaries ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.5</span></a>), we have</p>
<table id="A2.EGx186" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex137"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex137.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\|\mathbf{Z}_{t}\|_{F}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐙</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\|\mathbf{Z}_{t}\|_{F}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex138"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex138.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex138.m2" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}[\beta^{t}\|\mathbf{Z}_{0}\|_{F}]+\mathbb{E}[(1-\beta)\|\sum_{k=1}^{t}\beta^{t-k}\cdot\frac{1}{B}\sum_{i=1}^{B}\nabla^{Q}f(\mathbf{W}_{k}^{Q};\bm{\xi}_{k,i})\|_{F}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msup><mi>β</mi><mi>t</mi></msup><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>𝐙</mi><mn>0</mn></msub><msub><mo lspace="0em" rspace="0.167em">∥</mo><mi>F</mi></msub><mo stretchy="false">]</mo></mrow><mo>+</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>β</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><msup><mi>β</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>B</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></munderover></mstyle><msup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>Q</mi></msup><mi>f</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐖</mi><mi>k</mi><mi>Q</mi></msubsup><mo>;</mo><msub><mi>𝝃</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><msub><mo lspace="0em" rspace="0.167em">∥</mo><mi>F</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\beta^{t}\|\mathbf{Z}_{0}\|_{F}]+\mathbb{E}[(1-\beta)\|\sum_{k=1}^{t}\beta^{t-k}\cdot\frac{1}{B}\sum_{i=1}^{B}\nabla^{Q}f(\mathbf{W}_{k}^{Q};\bm{\xi}_{k,i})\|_{F}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex139"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex139.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex139.m2" class="ltx_math_unparsed" alttext="\displaystyle\beta^{t}\mathbb{E}[\|\mathbf{Z}_{0}\|_{F}]+\mathbb{E}[(1-\beta)\sum_{k=1}^{t}\beta^{t-k}\cdot\frac{1}{B}\sum_{i=1}^{B}\|\nabla^{Q}f(\mathbf{W}_{k}^{Q};\bm{\xi}_{k,i})-\nabla f(\mathbf{W}_{k}^{Q};\bm{\xi}_{k,i})\|_{F}]+" display="inline" intent=":literal"><semantics><mrow><msup><mi>β</mi><mi>t</mi></msup><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>𝐙</mi><mn>0</mn></msub><msub><mo lspace="0em" rspace="0.167em">∥</mo><mi>F</mi></msub><mo stretchy="false">]</mo></mrow><mo>+</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>β</mi><mo stretchy="false">)</mo></mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><msup><mi>β</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>B</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></munderover></mstyle><mo lspace="0em" rspace="0.167em">∥</mo><msup><mo rspace="0.167em">∇</mo><mi>Q</mi></msup><mi>f</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐖</mi><mi>k</mi><mi>Q</mi></msubsup><mo>;</mo><msub><mi>𝝃</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐖</mi><mi>k</mi><mi>Q</mi></msubsup><mo>;</mo><msub><mi>𝝃</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><msub><mo lspace="0em" rspace="0.167em">∥</mo><mi>F</mi></msub><mo stretchy="false">]</mo></mrow><mo>+</mo></mrow><annotation encoding="application/x-tex">\displaystyle\beta^{t}\mathbb{E}[\|\mathbf{Z}_{0}\|_{F}]+\mathbb{E}[(1-\beta)\sum_{k=1}^{t}\beta^{t-k}\cdot\frac{1}{B}\sum_{i=1}^{B}\|\nabla^{Q}f(\mathbf{W}_{k}^{Q};\bm{\xi}_{k,i})-\nabla f(\mathbf{W}_{k}^{Q};\bm{\xi}_{k,i})\|_{F}]+</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex140"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex140.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[(1-\beta)\|\sum_{k=1}^{t}\beta^{t-k}\cdot(\frac{1}{B}\sum_{i=1}^{B}\nabla f(\mathbf{W}_{k}^{Q};\bm{\xi}_{k,i})-\nabla F(\mathbf{W}_{k}^{Q}))\|_{F}]+" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><msup><mi>β</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>B</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></munderover></mstyle><mrow><mrow><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐖</mi><mi>k</mi><mi>Q</mi></msubsup><mo>,</mo><msub><mi>𝝃</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐖</mi><mi>k</mi><mi>Q</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[(1-\beta)\|\sum_{k=1}^{t}\beta^{t-k}\cdot(\frac{1}{B}\sum_{i=1}^{B}\nabla f(\mathbf{W}_{k}^{Q};\bm{\xi}_{k,i})-\nabla F(\mathbf{W}_{k}^{Q}))\|_{F}]+</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex141"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
