<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex46.m2" class="ltx_Math" alttext="\displaystyle\leq  \underbrace{2(1+q_{G})R\frac{F_{0}-F_{*}}{\eta\tilde{T}}}_{\text{Term 1}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><munder><munder accentunder="true"><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>F</mi><mn>0</mn></msub><mo>−</mo><msub><mi>F</mi><mo>∗</mo></msub></mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>T</mi><mo>~</mo></mover></mrow></mfrac></mstyle></mrow><mo stretchy="true">⏟</mo></munder><mtext>Term 1</mtext></munder></mrow><annotation encoding="application/x-tex">\displaystyle\leq  \underbrace{2(1+q_{G})R\frac{F_{0}-F_{*}}{\eta\tilde{T}}}_{\text{Term 1}}</annotation></semantics></math></td>
