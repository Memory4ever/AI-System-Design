<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex148.m2" class="ltx_Math" alttext="\displaystyle\beta^{t}(q_{G}(\sigma+q_{W}DL+G)+\frac{\sigma}{\sqrt{B}}+q_{W}DL+G)+" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>β</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>+</mo><mrow><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mi>G</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>σ</mi><msqrt><mi>B</mi></msqrt></mfrac></mstyle><mo>+</mo><mrow><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mi>G</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo></mrow><annotation encoding="application/x-tex">\displaystyle\beta^{t}(q_{G}(\sigma+q_{W}DL+G)+\frac{\sigma}{\sqrt{B}}+q_{W}DL+G)+</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex149"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex149.m1" class="ltx_Math" alttext="\displaystyle(1-\beta^{t})q_{G}(\sigma+q_{W}L(D+t\eta\sqrt{r})+G+t\eta\sqrt{r}L)+" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>β</mi><mi>t</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>+</mo><mrow><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>D</mi><mo>+</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>G</mi><mo>+</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo></mrow><annotation encoding="application/x-tex">\displaystyle(1-\beta^{t})q_{G}(\sigma+q_{W}L(D+t\eta\sqrt{r})+G+t\eta\sqrt{r}L)+</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex150"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex150.m1" class="ltx_Math" alttext="\displaystyle\sqrt{\frac{1-\beta}{1+\beta}}\cdot\frac{\sigma}{\sqrt{B}}+(1-\beta^{t})q_{W}L(D+t\eta\sqrt{r})+(1-\beta^{t})(G+t\eta\sqrt{r}L)" display="inline" intent=":literal"><semantics><mrow><mrow><msqrt><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mrow><mn>1</mn><mo>+</mo><mi>β</mi></mrow></mfrac></mstyle></msqrt><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mi>σ</mi><msqrt><mi>B</mi></msqrt></mfrac></mstyle></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>β</mi><mi>t</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>D</mi><mo>+</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>β</mi><mi>t</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo>+</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sqrt{\frac{1-\beta}{1+\beta}}\cdot\frac{\sigma}{\sqrt{B}}+(1-\beta^{t})q_{W}L(D+t\eta\sqrt{r})+(1-\beta^{t})(G+t\eta\sqrt{r}L)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex151"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex151.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex151.m2" class="ltx_Math" alttext="\displaystyle\beta^{t}\frac{\sigma}{\sqrt{B}}+\sqrt{\frac{1-\beta}{1+\beta}}\cdot\frac{\sigma}{\sqrt{B}}+G+q_{G}(\sigma+G)+q_{W}(1+q_{G})DL+" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>β</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>σ</mi><msqrt><mi>B</mi></msqrt></mfrac></mstyle></mrow><mo>+</mo><mrow><msqrt><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mrow><mn>1</mn><mo>+</mo><mi>β</mi></mrow></mfrac></mstyle></msqrt><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mi>σ</mi><msqrt><mi>B</mi></msqrt></mfrac></mstyle></mrow><mo>+</mo><mi>G</mi><mo>+</mo><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>+</mo><mi>G</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\beta^{t}\frac{\sigma}{\sqrt{B}}+\sqrt{\frac{1-\beta}{1+\beta}}\cdot\frac{\sigma}{\sqrt{B}}+G+q_{G}(\sigma+G)+q_{W}(1+q_{G})DL+</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex152"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex152.m1" class="ltx_Math" alttext="\displaystyle(1-\beta^{t})(1+q_{W})(1+q_{G})t\eta\sqrt{r}L" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>β</mi><mi>t</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>W</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">\displaystyle(1-\beta^{t})(1+q_{W})(1+q_{G})t\eta\sqrt{r}L</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex153"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex153.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex153.m2" class="ltx_Math" alttext="\displaystyle\frac{\sigma}{\sqrt{B}}+\sqrt{\frac{1-\beta}{1+\beta}}\cdot\frac{\sigma}{\sqrt{B}}+G+q_{G}(\sigma+G)+q_{W}(1+q_{G})DL+(1+q_{W})(1+q_{G})t\eta\sqrt{r}L." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>σ</mi><msqrt><mi>B</mi></msqrt></mfrac></mstyle><mo>+</mo><mrow><msqrt><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mrow><mn>1</mn><mo>+</mo><mi>β</mi></mrow></mfrac></mstyle></msqrt><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mi>σ</mi><msqrt><mi>B</mi></msqrt></mfrac></mstyle></mrow><mo>+</mo><mi>G</mi><mo>+</mo><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>+</mo><mi>G</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>W</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\sigma}{\sqrt{B}}+\sqrt{\frac{1-\beta}{1+\beta}}\cdot\frac{\sigma}{\sqrt{B}}+G+q_{G}(\sigma+G)+q_{W}(1+q_{G})DL+(1+q_{W})(1+q_{G})t\eta\sqrt{r}L.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS8.SSS0.Px8.p1.2" class="ltx_p">The first and second inequalities are due to the triangle inequality. The third inequality we used Definition <a href="#A2.Ex1" title="In B.1 Preliminaries ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.6</span></a> for the second term, Jensen’s inequality, Assumptions <a href="#S4.Thmtheorem1" title="Assumption 4.1 (Unbiased Stochastic Gradient). ‣ 4 Main Results ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>, <a href="#S4.Thmtheorem2" title="Assumption 4.2 (Stochastic Gradient Bounds). ‣ 4 Main Results ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a> for the third term, Assumption <a href="#S4.Thmtheorem3" title="Assumption 4.3 (Smoothness). ‣ 4 Main Results ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a> and Definition <a href="#A2.Ex1" title="In B.1 Preliminaries ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.6</span></a> for the fourth term. The fourth inequality we used triangle inequality, Assumptions <a href="#S4.Thmtheorem2" title="Assumption 4.2 (Stochastic Gradient Bounds). ‣ 4 Main Results ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>, <a href="#S4.Thmtheorem3" title="Assumption 4.3 (Smoothness). ‣ 4 Main Results ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a>, Definition <a href="#A2.Ex1" title="In B.1 Preliminaries ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.6</span></a>. The fifth inequality is due to Lemma <a href="#A2.Thmtheorem1" title="Lemma B.1 (Bound of ‖𝐖‖_𝐹 and ‖∇𝐹⁢(𝐖)‖_𝐹 for Muon). ‣ B.3 Proof of Lemma ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1</span></a>.</p>
</div>
<div id="A2.SS8.SSS0.Px8.p2" class="ltx_para">
<p id="A2.SS8.SSS0.Px8.p2.1" class="ltx_p">∎</p>
</div>
</section>
</section>
<section id="A2.SS9" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.9 </span>Proof of Lemma <a href="#A2.Thmtheorem7" title="Lemma B.7. ‣ B.9 Proof of Lemma ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.7</span></a></h3>

<div id="A2.Thmtheorem7" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem7.2" class="ltx_text ltx_font_bold">Lemma B.7</span></span><span id="A2.Thmtheorem7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem7.p1" class="ltx_para">
<p id="A2.Thmtheorem7.p1.1" class="ltx_p"><span id="A2.Thmtheorem7.p1.1.1" class="ltx_text ltx_font_italic">Suppose Assumptions <a href="#S4.Thmtheorem1" title="Assumption 4.1 (Unbiased Stochastic Gradient). ‣ 4 Main Results ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>, <a href="#S4.Thmtheorem2" title="Assumption 4.2 (Stochastic Gradient Bounds). ‣ 4 Main Results ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>, <a href="#S4.Thmtheorem3" title="Assumption 4.3 (Smoothness). ‣ 4 Main Results ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a> and <a href="#S3.Thmtheorem1" title="Assumption 3.1 (Quantization Error). ‣ Relative error. ‣ 3.1 Preliminaries ‣ 3 Preliminaries and Problem Setup ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a> hold. For any <math id="A2.Thmtheorem7.p1.m1" class="ltx_Math" alttext="t\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t\geq 0</annotation></semantics></math>, if <math id="A2.Thmtheorem7.p1.m2" class="ltx_Math" alttext="\beta(1+q_{M})&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>β</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\beta(1+q_{M})&lt;1</annotation></semantics></math>, we have</span></p>
<table id="A2.EGx187" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex154"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex154.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\|\mathbf{Z}_{t}-\mathbf{M}_{t}\|_{F}]\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐙</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝐌</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\|\mathbf{Z}_{t}-\mathbf{M}_{t}\|_{F}]\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex154.m2" class="ltx_Math" alttext="\displaystyle\frac{q_{M}\beta}{1-\beta(1+q_{M})}\bigg(\frac{\sigma}{\sqrt{B}}+\sqrt{\frac{1-\beta}{1+\beta}}\cdot\frac{\sigma}{\sqrt{B}}+G+q_{G}(\sigma+G)+\bigg." display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mi>M</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>β</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mi>σ</mi><msqrt><mi>B</mi></msqrt></mfrac></mstyle><mo>+</mo><mrow><msqrt><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mrow><mn>1</mn><mo>+</mo><mi>β</mi></mrow></mfrac></mstyle></msqrt><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mi>σ</mi><msqrt><mi>B</mi></msqrt></mfrac></mstyle></mrow><mo>+</mo><mi>G</mi><mo>+</mo><mrow><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>+</mo><mi>G</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0em">+</mo></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{q_{M}\beta}{1-\beta(1+q_{M})}\bigg(\frac{\sigma}{\sqrt{B}}+\sqrt{\frac{1-\beta}{1+\beta}}\cdot\frac{\sigma}{\sqrt{B}}+G+q_{G}(\sigma+G)+\bigg.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex155"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex155.m1" class="ltx_Math" alttext="\displaystyle\bigg.q_{W}(1+q_{G})DL+(1+q_{W})(1+q_{G})t\eta\sqrt{r}L\bigg)." display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mrow><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>W</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\bigg.q_{W}(1+q_{G})DL+(1+q_{W})(1+q_{G})t\eta\sqrt{r}L\bigg).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.SS9.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Lemma <a href="#A2.Thmtheorem7" title="Lemma B.7. ‣ B.9 Proof of Lemma ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.7</span></a>.</h6>
<div id="A2.SS9.p1" class="ltx_para">
<p id="A2.SS9.p1.1" class="ltx_p"><span id="A2.SS9.p1.1.1" class="ltx_text">By the definitions of <math id="A2.SS9.p1.m1" class="ltx_Math" alttext="\mathbf{Z}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝐙</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathbf{Z}_{t}</annotation></semantics></math> and <math id="A2.SS9.p1.m2" class="ltx_Math" alttext="\mathbf{M}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝐌</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathbf{M}_{t}</annotation></semantics></math> in (<a href="#A2.E5" title="In B.1 Preliminaries ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.5</span></a>) and (<a href="#A2.E1" title="In B.1 Preliminaries ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1</span></a>), we have</span></p>
<table id="A2.EGx188" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex156"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex156.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\|\mathbf{Z}_{t}-\mathbf{M}_{t}\|_{F}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐙</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝐌</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\|\mathbf{Z}_{t}-\mathbf{M}_{t}\|_{F}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex157"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
