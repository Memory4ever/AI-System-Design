<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex158.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\beta\|\mathbf{Z}_{t-1}-\mathbf{M}_{t-1}\|_{F}+\beta\|\mathbf{M}_{t-1}-\mathbf{M}_{t-1}^{Q}\|_{F}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐙</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>𝐌</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐌</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>−</mo><msubsup><mi>𝐌</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>Q</mi></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\beta\|\mathbf{Z}_{t-1}-\mathbf{M}_{t-1}\|_{F}+\beta\|\mathbf{M}_{t-1}-\mathbf{M}_{t-1}^{Q}\|_{F}]</annotation></semantics></math></td>
