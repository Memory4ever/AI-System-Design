<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex7.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\langle\nabla F(\mathbf{W}_{t}),\mathbf{W}_{t}-\mathbf{W}_{t+1}\rangle-\frac{L}{2}\|\mathbf{W}_{t}-\mathbf{W}_{t+1}\|_{F}^{2}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐖</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝐖</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>L</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐖</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝐖</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\langle\nabla F(\mathbf{W}_{t}),\mathbf{W}_{t}-\mathbf{W}_{t+1}\rangle-\frac{L}{2}\|\mathbf{W}_{t}-\mathbf{W}_{t+1}\|_{F}^{2}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex8.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex8.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\eta\langle\nabla F(\mathbf{W}_{t}),\mathbf{U}_{t}\mathbf{V}_{t}^{\top}\rangle-\frac{L}{2}\eta^{2}\|\mathbf{U}_{t}\mathbf{V}_{t}^{\top}\|_{F}^{2}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐔</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐕</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>L</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐔</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐕</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\eta\langle\nabla F(\mathbf{W}_{t}),\mathbf{U}_{t}\mathbf{V}_{t}^{\top}\rangle-\frac{L}{2}\eta^{2}\|\mathbf{U}_{t}\mathbf{V}_{t}^{\top}\|_{F}^{2}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex9.m1" class="ltx_Math" alttext="\displaystyle\geq" display="inline" intent=":literal"><semantics><mo>≥</mo><annotation encoding="application/x-tex">\displaystyle\geq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex9.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\eta\langle\nabla F(\mathbf{W}_{t}),\mathbf{U}_{t}\mathbf{V}_{t}^{\top}\rangle]-\frac{L}{2}\eta^{2}r" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐔</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐕</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>L</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\eta\langle\nabla F(\mathbf{W}_{t}),\mathbf{U}_{t}\mathbf{V}_{t}^{\top}\rangle]-\frac{L}{2}\eta^{2}r</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex10.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex10.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\eta\langle\mathbf{M}_{t},\mathbf{U}_{t}\mathbf{V}_{t}^{\top}\rangle+\eta\langle\nabla F(\mathbf{W}_{t})-\mathbf{M}_{t},\mathbf{U}_{t}\mathbf{V}_{t}^{\top}\rangle]-\frac{L}{2}\eta^{2}r" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>𝐌</mi><mi>t</mi></msub><mo>,</mo><mrow><msub><mi>𝐔</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐕</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo>+</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>𝐌</mi><mi>t</mi></msub></mrow><mo>,</mo><mrow><msub><mi>𝐔</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐕</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>L</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\eta\langle\mathbf{M}_{t},\mathbf{U}_{t}\mathbf{V}_{t}^{\top}\rangle+\eta\langle\nabla F(\mathbf{W}_{t})-\mathbf{M}_{t},\mathbf{U}_{t}\mathbf{V}_{t}^{\top}\rangle]-\frac{L}{2}\eta^{2}r</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex11.m1" class="ltx_Math" alttext="\displaystyle\geq" display="inline" intent=":literal"><semantics><mo>≥</mo><annotation encoding="application/x-tex">\displaystyle\geq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex11.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\eta\|\mathbf{M}_{t}\|_{*}-\eta\|\nabla F(\mathbf{W}_{t})-\mathbf{M}_{t}\|_{F}\cdot\|\mathbf{U}_{t}\mathbf{V}_{t}^{\top}\|_{F}]-\frac{L}{2}\eta^{2}r" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐌</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mo>∗</mo></msub></mrow><mo>−</mo><mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>𝐌</mi><mi>t</mi></msub></mrow><mo rspace="0.055em" stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow><mo rspace="0.222em">⋅</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐔</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐕</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>L</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\eta\|\mathbf{M}_{t}\|_{*}-\eta\|\nabla F(\mathbf{W}_{t})-\mathbf{M}_{t}\|_{F}\cdot\|\mathbf{U}_{t}\mathbf{V}_{t}^{\top}\|_{F}]-\frac{L}{2}\eta^{2}r</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex12.m1" class="ltx_Math" alttext="\displaystyle\geq" display="inline" intent=":literal"><semantics><mo>≥</mo><annotation encoding="application/x-tex">\displaystyle\geq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex12.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\eta\|\nabla F(\mathbf{W}_{t})\|_{*}-\eta\|\nabla F(\mathbf{W}_{t})-\mathbf{M}_{t}\|_{*}-\eta\sqrt{r}\|\nabla F(\mathbf{W}_{t})-\mathbf{M}_{t}\|_{F}]-\frac{L}{2}\eta^{2}r" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>∗</mo></msub></mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>𝐌</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mo>∗</mo></msub></mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>𝐌</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>L</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\eta\|\nabla F(\mathbf{W}_{t})\|_{*}-\eta\|\nabla F(\mathbf{W}_{t})-\mathbf{M}_{t}\|_{*}-\eta\sqrt{r}\|\nabla F(\mathbf{W}_{t})-\mathbf{M}_{t}\|_{F}]-\frac{L}{2}\eta^{2}r</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E7.m1" class="ltx_Math" alttext="\displaystyle\geq" display="inline" intent=":literal"><semantics><mo>≥</mo><annotation encoding="application/x-tex">\displaystyle\geq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E7.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\eta\|\nabla F(\mathbf{W}_{t})\|_{*}-2\eta\sqrt{r}\|\nabla F(\mathbf{W}_{t})-\mathbf{M}_{t}\|_{F}]-\frac{L}{2}\eta^{2}r." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>∗</mo></msub></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>𝐌</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>L</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\eta\|\nabla F(\mathbf{W}_{t})\|_{*}-2\eta\sqrt{r}\|\nabla F(\mathbf{W}_{t})-\mathbf{M}_{t}\|_{F}]-\frac{L}{2}\eta^{2}r.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(B.7)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p1.2" class="ltx_p"><span id="A2.SS2.p1.2.1" class="ltx_text">The second inequality is due to <math id="A2.SS2.p1.m5" class="ltx_Math" alttext="\|\mathbf{U}_{t}\mathbf{V}_{t}^{\top}\|_{F}^{2}=\mathop{\mathrm{Tr}}(\mathbf{V}_{t}\mathbf{U}_{t}^{\top}\mathbf{U}_{t}\mathbf{V}_{t}^{\top})\leq r=\min\{m,n\}" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐔</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐕</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo rspace="0.1389em">=</mo><mrow><mo lspace="0.1389em" rspace="0em">Tr</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐕</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐔</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐔</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐕</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>r</mi><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>m</mi><mo>,</mo><mi>n</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\|\mathbf{U}_{t}\mathbf{V}_{t}^{\top}\|_{F}^{2}=\mathop{\mathrm{Tr}}(\mathbf{V}_{t}\mathbf{U}_{t}^{\top}\mathbf{U}_{t}\mathbf{V}_{t}^{\top})\leq r=\min\{m,n\}</annotation></semantics></math>. The third inequality is due to <math id="A2.SS2.p1.m6" class="ltx_Math" alttext="\mathbf{M}_{t}=\mathbf{U}_{t}\mathbf{S}_{t}\mathbf{V}_{t}^{\top}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐌</mi><mi>t</mi></msub><mo>=</mo><mrow><msub><mi>𝐔</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐒</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐕</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{M}_{t}=\mathbf{U}_{t}\mathbf{S}_{t}\mathbf{V}_{t}^{\top}</annotation></semantics></math> and Cauchy-Schwarz inequality. The last inequality we used the fact that <math id="A2.SS2.p1.m7" class="ltx_Math" alttext="\|\mathbf{A}\|_{*}\leq\sqrt{r}\|\mathbf{A}\|_{F}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝐀</mi><mo stretchy="false">‖</mo></mrow><mo>∗</mo></msub><mo>≤</mo><mrow><msqrt><mi>r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝐀</mi><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\|\mathbf{A}\|_{*}\leq\sqrt{r}\|\mathbf{A}\|_{F}</annotation></semantics></math> for any <math id="A2.SS2.p1.m8" class="ltx_Math" alttext="\mathbf{A}\in\mathbb{R}^{m\times n}" display="inline" intent=":literal"><semantics><mrow><mi>𝐀</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{A}\in\mathbb{R}^{m\times n}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS2.p2" class="ltx_para">
<p id="A2.SS2.p2.1" class="ltx_p"><span id="A2.SS2.p2.1.1" class="ltx_text">Summing Eq. (<a href="#A2.Ex6" title="In Proof. ‣ B.2 Proof of Theorem ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.7</span></a>) over <math id="A2.SS2.p2.m1" class="ltx_Math" alttext="t=0,1,\ldots,T-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">t=0,1,\ldots,T-1</annotation></semantics></math>, we get</span></p>
<table id="A2.EGx155" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex13.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{T}\sum_{t=0}^{T-1}\mathbb{E}[\|\nabla F(\mathbf{W}_{t})\|_{*}]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>∗</mo></msub><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{T}\sum_{t=0}^{T-1}\mathbb{E}[\|\nabla F(\mathbf{W}_{t})\|_{*}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E8.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E8.m2" class="ltx_Math" alttext="\displaystyle\frac{\mathbb{E}[F(\mathbf{W}_{0})-F^{(}\mathbf{W}_{T})]}{T\eta}+\frac{2\sqrt{r}}{T}\sum_{t=0}^{T-1}\mathbb{E}[\|\nabla F(\mathbf{W}_{t})-\mathbf{M}_{t}\|_{F}]+\frac{\eta Lr}{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>𝔼</mi><mo stretchy="false">[</mo><mi>F</mi><mo stretchy="false">(</mo><mi>𝐖</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo>−</mo><mi>F</mi><msup><mrow></mrow><mo stretchy="false">(</mo></msup><mi>𝐖</mi><msub><mrow></mrow><mi>T</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">]</mo></mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>𝐌</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mn>2</mn></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\mathbb{E}[F(\mathbf{W}_{0})-F^{(}\mathbf{W}_{T})]}{T\eta}+\frac{2\sqrt{r}}{T}\sum_{t=0}^{T-1}\mathbb{E}[\|\nabla F(\mathbf{W}_{t})-\mathbf{M}_{t}\|_{F}]+\frac{\eta Lr}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(B.8)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS2.p3" class="ltx_para">
<p id="A2.SS2.p3.1" class="ltx_p"><span id="A2.SS2.p3.1.1" class="ltx_text">Next, we focus on term <math id="A2.SS2.p3.m1" class="ltx_Math" alttext="\mathbb{E}[\|\nabla F(\mathbf{W}_{t})-\mathbf{M}_{t}\|_{F}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>𝐌</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[\|\nabla F(\mathbf{W}_{t})-\mathbf{M}_{t}\|_{F}]</annotation></semantics></math>. With auxiliary variables defined in Eq. (<a href="#A2.E2" title="In B.1 Preliminaries ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a>)-(<a href="#A2.E5" title="In B.1 Preliminaries ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.5</span></a>), we have</span></p>
<table id="A2.EGx156" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex14.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\|\nabla F(\mathbf{W}_{t})-\mathbf{M}_{t}\|_{F}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>𝐌</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\|\nabla F(\mathbf{W}_{t})-\mathbf{M}_{t}\|_{F}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex15.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex15.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\|\nabla F(\mathbf{W}_{t})-\mathbf{C}_{t}\|_{F}+\|\mathbf{C}_{t}-\mathbf{X}_{t}\|_{F}+\|\mathbf{X}_{t}-\mathbf{Y}_{t}\|_{F}+\|\mathbf{Y}_{t}-\mathbf{Z}_{t}\|_{F}+\|\mathbf{Z}_{t}-\mathbf{M}_{t}\|_{F}]." display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>𝐂</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐂</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝐗</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐗</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝐘</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐘</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝐙</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐙</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝐌</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\|\nabla F(\mathbf{W}_{t})-\mathbf{C}_{t}\|_{F}+\|\mathbf{C}_{t}-\mathbf{X}_{t}\|_{F}+\|\mathbf{X}_{t}-\mathbf{Y}_{t}\|_{F}+\|\mathbf{Y}_{t}-\mathbf{Z}_{t}\|_{F}+\|\mathbf{Z}_{t}-\mathbf{M}_{t}\|_{F}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS2.p4" class="ltx_para">
<p id="A2.SS2.p4.1" class="ltx_p"><span id="A2.SS2.p4.1.1" class="ltx_text">By Lemmas <a href="#A2.Thmtheorem3" title="Lemma B.3. ‣ B.5 Proof of Lemma ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.3</span></a>, <a href="#A2.Thmtheorem4" title="Lemma B.4. ‣ B.6 Proof of Lemma ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.4</span></a>, <a href="#A2.Thmtheorem5" title="Lemma B.5. ‣ B.7 Proof of Lemma ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.5</span></a>, <a href="#A2.Thmtheorem6" title="Lemma B.6. ‣ B.8 Proof of Lemma ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.6</span></a>, and <a href="#A2.Thmtheorem7" title="Lemma B.7. ‣ B.9 Proof of Lemma ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.7</span></a>, we have</span></p>
<table id="A2.EGx157" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex16.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\|\nabla F(\mathbf{W}_{t})-\mathbf{M}_{t}\|_{F}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>𝐌</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\|\nabla F(\mathbf{W}_{t})-\mathbf{M}_{t}\|_{F}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex17.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex17.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\|\nabla F(\mathbf{W}_{t})-\mathbf{C}_{t}\|_{F}+\|\mathbf{C}_{t}-\mathbf{X}_{t}\|_{F}+\|\mathbf{X}_{t}-\mathbf{Y}_{t}\|_{F}+\|\mathbf{Y}_{t}-\mathbf{Z}_{t}\|_{F}+\|\mathbf{Z}_{t}-\mathbf{M}_{t}\|_{F}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>𝐂</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐂</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝐗</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐗</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝐘</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐘</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝐙</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐙</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝐌</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\|\nabla F(\mathbf{W}_{t})-\mathbf{C}_{t}\|_{F}+\|\mathbf{C}_{t}-\mathbf{X}_{t}\|_{F}+\|\mathbf{X}_{t}-\mathbf{Y}_{t}\|_{F}+\|\mathbf{Y}_{t}-\mathbf{Z}_{t}\|_{F}+\|\mathbf{Z}_{t}-\mathbf{M}_{t}\|_{F}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex18.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex18.m2" class="ltx_Math" alttext="\displaystyle\frac{\beta L\eta\sqrt{r}}{1-\beta}+\beta^{t}\frac{3\sigma}{\sqrt{B}}+\sqrt{\frac{1-\beta}{1+\beta}}\frac{3\sigma}{\sqrt{B}}+3q_{G}(\sigma+G)+3q_{G}T\eta\sqrt{r}L+q_{W}(1+q_{G})DL+" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow></mfrac></mstyle><mo>+</mo><mrow><msup><mi>β</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow><msqrt><mi>B</mi></msqrt></mfrac></mstyle></mrow><mo>+</mo><mrow><msqrt><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mrow><mn>1</mn><mo>+</mo><mi>β</mi></mrow></mfrac></mstyle></msqrt><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow><msqrt><mi>B</mi></msqrt></mfrac></mstyle></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>+</mo><mi>G</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mrow><mrow><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\beta L\eta\sqrt{r}}{1-\beta}+\beta^{t}\frac{3\sigma}{\sqrt{B}}+\sqrt{\frac{1-\beta}{1+\beta}}\frac{3\sigma}{\sqrt{B}}+3q_{G}(\sigma+G)+3q_{G}T\eta\sqrt{r}L+q_{W}(1+q_{G})DL+</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex19.m1" class="ltx_Math" alttext="\displaystyle q_{W}(1+q_{G})T\eta\sqrt{r}L+\frac{q_{M}\beta}{1-\beta(1+q_{M})}\bigg(\frac{\sigma}{\sqrt{B}}+\sqrt{\frac{1-\beta}{1+\beta}}\cdot\frac{\sigma}{\sqrt{B}}+G+q_{G}(\sigma+G)+\bigg." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mi>M</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>β</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mi>σ</mi><msqrt><mi>B</mi></msqrt></mfrac></mstyle><mo>+</mo><mrow><msqrt><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mrow><mn>1</mn><mo>+</mo><mi>β</mi></mrow></mfrac></mstyle></msqrt><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mi>σ</mi><msqrt><mi>B</mi></msqrt></mfrac></mstyle></mrow><mo>+</mo><mi>G</mi><mo>+</mo><mrow><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>+</mo><mi>G</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0em">+</mo></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle q_{W}(1+q_{G})T\eta\sqrt{r}L+\frac{q_{M}\beta}{1-\beta(1+q_{M})}\bigg(\frac{\sigma}{\sqrt{B}}+\sqrt{\frac{1-\beta}{1+\beta}}\cdot\frac{\sigma}{\sqrt{B}}+G+q_{G}(\sigma+G)+\bigg.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex20.m1" class="ltx_Math" alttext="\displaystyle\bigg.q_{W}(1+q_{G})DL+(1+q_{W})(1+q_{G})T\eta\sqrt{r}L\bigg)." display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mrow><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>W</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\bigg.q_{W}(1+q_{G})DL+(1+q_{W})(1+q_{G})T\eta\sqrt{r}L\bigg).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS2.p5" class="ltx_para">
<p id="A2.SS2.p5.1" class="ltx_p"><span id="A2.SS2.p5.1.1" class="ltx_text">Summing over <math id="A2.SS2.p5.m1" class="ltx_Math" alttext="t=0,1,\ldots,T-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">t=0,1,\ldots,T-1</annotation></semantics></math>, we get</span></p>
<table id="A2.EGx158" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex21.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{T}\sum_{t=0}^{T-1}\mathbb{E}[\|\nabla F(\mathbf{W}_{t})-\mathbf{M}_{t}\|_{F}]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>𝐌</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{T}\sum_{t=0}^{T-1}\mathbb{E}[\|\nabla F(\mathbf{W}_{t})-\mathbf{M}_{t}\|_{F}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex22.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex22.m2" class="ltx_Math" alttext="\displaystyle\frac{\beta L\eta\sqrt{r}}{1-\beta}+\frac{3\sigma}{T(1-\beta)\sqrt{B}}+\sqrt{\frac{1-\beta}{1+\beta}}\frac{3\sigma}{\sqrt{B}}+3q_{G}(\sigma+G)+3q_{G}T\eta\sqrt{r}L+q_{W}(1+q_{G})DL+" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>B</mi></msqrt></mrow></mfrac></mstyle><mo>+</mo><mrow><msqrt><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mrow><mn>1</mn><mo>+</mo><mi>β</mi></mrow></mfrac></mstyle></msqrt><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow><msqrt><mi>B</mi></msqrt></mfrac></mstyle></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>+</mo><mi>G</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mrow><mrow><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\beta L\eta\sqrt{r}}{1-\beta}+\frac{3\sigma}{T(1-\beta)\sqrt{B}}+\sqrt{\frac{1-\beta}{1+\beta}}\frac{3\sigma}{\sqrt{B}}+3q_{G}(\sigma+G)+3q_{G}T\eta\sqrt{r}L+q_{W}(1+q_{G})DL+</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex24.m1" class="ltx_Math" alttext="\displaystyle q_{W}(1+q_{G})T\eta\sqrt{r}L+\frac{q_{M}\beta}{1-\beta(1+q_{M})}\bigg(\frac{\sigma}{\sqrt{B}}+\sqrt{\frac{1-\beta}{1+\beta}}\cdot\frac{\sigma}{\sqrt{B}}+G+q_{G}(\sigma+G)+\bigg." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mi>M</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>β</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mi>σ</mi><msqrt><mi>B</mi></msqrt></mfrac></mstyle><mo>+</mo><mrow><msqrt><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mrow><mn>1</mn><mo>+</mo><mi>β</mi></mrow></mfrac></mstyle></msqrt><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mi>σ</mi><msqrt><mi>B</mi></msqrt></mfrac></mstyle></mrow><mo>+</mo><mi>G</mi><mo>+</mo><mrow><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>+</mo><mi>G</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0em">+</mo></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle q_{W}(1+q_{G})T\eta\sqrt{r}L+\frac{q_{M}\beta}{1-\beta(1+q_{M})}\bigg(\frac{\sigma}{\sqrt{B}}+\sqrt{\frac{1-\beta}{1+\beta}}\cdot\frac{\sigma}{\sqrt{B}}+G+q_{G}(\sigma+G)+\bigg.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E9.m1" class="ltx_Math" alttext="\displaystyle\bigg.q_{W}(1+q_{G})DL+(1+q_{W})(1+q_{G})T\eta\sqrt{r}L\bigg)." display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mrow><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>W</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\bigg.q_{W}(1+q_{G})DL+(1+q_{W})(1+q_{G})T\eta\sqrt{r}L\bigg).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(B.9)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS2.p6" class="ltx_para">
<p id="A2.SS2.p6.1" class="ltx_p"><span id="A2.SS2.p6.1.1" class="ltx_text">Substitute (<a href="#A2.Ex21" title="In Proof. ‣ B.2 Proof of Theorem ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.9</span></a>) into (<a href="#A2.Ex13" title="In Proof. ‣ B.2 Proof of Theorem ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.8</span></a>), with Assumption <a href="#S3.Thmtheorem1" title="Assumption 3.1 (Quantization Error). ‣ Relative error. ‣ 3.1 Preliminaries ‣ 3 Preliminaries and Problem Setup ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>, we have</span></p>
<table id="A2.EGx159" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex25.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{T}\sum_{t=0}^{T-1}\mathbb{E}[\|\nabla F(\mathbf{W}_{t})\|_{*}]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>∗</mo></msub><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{T}\sum_{t=0}^{T-1}\mathbb{E}[\|\nabla F(\mathbf{W}_{t})\|_{*}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex26.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex26.m2" class="ltx_Math" alttext="\displaystyle\frac{\mathbb{E}[F(\mathbf{W}_{0})-F(\mathbf{W}_{T})]}{\eta T}+\frac{L\eta r}{2}+\frac{2\sqrt{r}}{T}\sum_{t=0}^{T-1}\mathbb{E}[\|\nabla F(\mathbf{W}_{t})-\mathbf{M}_{t}\|_{F}]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mn>2</mn></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>𝐌</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\mathbb{E}[F(\mathbf{W}_{0})-F(\mathbf{W}_{T})]}{\eta T}+\frac{L\eta r}{2}+\frac{2\sqrt{r}}{T}\sum_{t=0}^{T-1}\mathbb{E}[\|\nabla F(\mathbf{W}_{t})-\mathbf{M}_{t}\|_{F}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex27.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex27.m2" class="ltx_Math" alttext="\displaystyle\frac{\mathbb{E}[F(\mathbf{W}_{0})-F(\mathbf{W}_{T})]}{\eta T}+\frac{L\eta r}{2}+\frac{2\beta L\eta r}{1-\beta}+\frac{6\sigma\sqrt{r}}{T(1-\beta)\sqrt{B}}+\sqrt{\frac{1-\beta}{1+\beta}}\frac{6\sigma\sqrt{r}}{\sqrt{B}}+" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mn>2</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>B</mi></msqrt></mrow></mfrac></mstyle><mo>+</mo><mrow><mrow><msqrt><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mrow><mn>1</mn><mo>+</mo><mi>β</mi></mrow></mfrac></mstyle></msqrt><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><msqrt><mi>B</mi></msqrt></mfrac></mstyle></mrow><mo>+</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\mathbb{E}[F(\mathbf{W}_{0})-F(\mathbf{W}_{T})]}{\eta T}+\frac{L\eta r}{2}+\frac{2\beta L\eta r}{1-\beta}+\frac{6\sigma\sqrt{r}}{T(1-\beta)\sqrt{B}}+\sqrt{\frac{1-\beta}{1+\beta}}\frac{6\sigma\sqrt{r}}{\sqrt{B}}+</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex28.m1" class="ltx_Math" alttext="\displaystyle 6q_{G}\sqrt{r}(\sigma+G)+6q_{G}T\eta rL+2q_{W}(1+q_{G})DL\sqrt{r}+2q_{W}(1+q_{G})T\eta rL+" display="inline" intent=":literal"><semantics><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>+</mo><mi>G</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><mo>+</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 6q_{G}\sqrt{r}(\sigma+G)+6q_{G}T\eta rL+2q_{W}(1+q_{G})DL\sqrt{r}+2q_{W}(1+q_{G})T\eta rL+</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex29.m1" class="ltx_Math" alttext="\displaystyle\frac{2q_{M}\beta\sqrt{r}}{1-\beta(1+q_{M})}\bigg(\frac{\sigma}{\sqrt{B}}+\sqrt{\frac{1-\beta}{1+\beta}}\cdot\frac{\sigma}{\sqrt{B}}+G+q_{G}(\sigma+G)+\bigg." display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>M</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>β</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mi>σ</mi><msqrt><mi>B</mi></msqrt></mfrac></mstyle><mo>+</mo><mrow><msqrt><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mrow><mn>1</mn><mo>+</mo><mi>β</mi></mrow></mfrac></mstyle></msqrt><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mi>σ</mi><msqrt><mi>B</mi></msqrt></mfrac></mstyle></mrow><mo>+</mo><mi>G</mi><mo>+</mo><mrow><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>+</mo><mi>G</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0em">+</mo></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{2q_{M}\beta\sqrt{r}}{1-\beta(1+q_{M})}\bigg(\frac{\sigma}{\sqrt{B}}+\sqrt{\frac{1-\beta}{1+\beta}}\cdot\frac{\sigma}{\sqrt{B}}+G+q_{G}(\sigma+G)+\bigg.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex30.m1" class="ltx_Math" alttext="\displaystyle\bigg.q_{W}(1+q_{G})DL+(1+q_{W})(1+q_{G})T\eta\sqrt{r}L\bigg)" display="inline" intent=":literal"><semantics><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mrow><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>W</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\bigg.q_{W}(1+q_{G})DL+(1+q_{W})(1+q_{G})T\eta\sqrt{r}L\bigg)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex31.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex31.m2" class="ltx_Math" alttext="\displaystyle\frac{\mathbb{E}[F(\mathbf{W}_{0})-F(\mathbf{W}_{T})]}{\eta T}+\frac{L\eta r}{2}+\frac{2\beta L\eta r}{1-\beta}+\frac{6\sigma\sqrt{r}}{T(1-\beta)\sqrt{B}}+\sqrt{\frac{1-\beta}{1+\beta}}\frac{6\sigma\sqrt{r}}{\sqrt{B}}+" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mn>2</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>B</mi></msqrt></mrow></mfrac></mstyle><mo>+</mo><mrow><mrow><msqrt><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mrow><mn>1</mn><mo>+</mo><mi>β</mi></mrow></mfrac></mstyle></msqrt><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><msqrt><mi>B</mi></msqrt></mfrac></mstyle></mrow><mo>+</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\mathbb{E}[F(\mathbf{W}_{0})-F(\mathbf{W}_{T})]}{\eta T}+\frac{L\eta r}{2}+\frac{2\beta L\eta r}{1-\beta}+\frac{6\sigma\sqrt{r}}{T(1-\beta)\sqrt{B}}+\sqrt{\frac{1-\beta}{1+\beta}}\frac{6\sigma\sqrt{r}}{\sqrt{B}}+</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex32.m1" class="ltx_Math" alttext="\displaystyle\Theta\Bigg(q_{G}+q_{W}+q_{G}T\eta+q_{W}T\eta+\frac{q_{M}\beta}{1-\beta(1+q_{M})}\bigg(1+\sqrt{1-\beta}+q_{G}+q_{W}+T\eta\bigg)\Bigg)." display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><msub><mi>q</mi><mi>G</mi></msub><mo>+</mo><msub><mi>q</mi><mi>W</mi></msub><mo>+</mo><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mo>+</mo><mrow><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mi>M</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>β</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mn>1</mn><mo>+</mo><msqrt><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow></msqrt><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub><mo>+</mo><msub><mi>q</mi><mi>W</mi></msub><mo>+</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Theta\Bigg(q_{G}+q_{W}+q_{G}T\eta+q_{W}T\eta+\frac{q_{M}\beta}{1-\beta(1+q_{M})}\bigg(1+\sqrt{1-\beta}+q_{G}+q_{W}+T\eta\bigg)\Bigg).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS2.p7" class="ltx_para">
<p id="A2.SS2.p7.1" class="ltx_p"><span id="A2.SS2.p7.1.1" class="ltx_text">Let <math id="A2.SS2.p7.m1" class="ltx_Math" alttext="F(\mathbf{W}_{0})-F^{*}\leq\Delta" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi>F</mi><mo>∗</mo></msup></mrow><mo>≤</mo><mi mathvariant="normal">Δ</mi></mrow><annotation encoding="application/x-tex">F(\mathbf{W}_{0})-F^{*}\leq\Delta</annotation></semantics></math>, where <math id="A2.SS2.p7.m2" class="ltx_Math" alttext="\Delta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta&gt;0</annotation></semantics></math> is a constant. By setting <math id="A2.SS2.p7.m3" class="ltx_Math" alttext="B=1" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">B=1</annotation></semantics></math>, <math id="A2.SS2.p7.m4" class="ltx_math_unparsed" alttext="1-\beta=\Theta(T^{-1/2})" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>β</mi><mo>=</mo><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">1-\beta=\Theta(T^{-1/2})</annotation></semantics></math>, <math id="A2.SS2.p7.m5" class="ltx_math_unparsed" alttext="\eta=\Theta((1-\beta)^{1/2}T^{-1/2})" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>β</mi><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\eta=\Theta((1-\beta)^{1/2}T^{-1/2})</annotation></semantics></math>, we have <math id="A2.SS2.p7.m6" class="ltx_Math" alttext="T\eta=\Theta(T^{1/4})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T\eta=\Theta(T^{1/4})</annotation></semantics></math>. Then we have</span></p>
<table id="A2.EGx160" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex33.m1" class="ltx_Math" alttext="\displaystyle\frac{\mathbb{E}[F(\mathbf{W}_{0})-F(\mathbf{W}_{T})]}{\eta T}+\frac{L\eta r}{2}+\frac{2\beta L\eta r}{1-\beta}+\frac{6\sigma\sqrt{r}}{T(1-\beta)\sqrt{B}}+\sqrt{\frac{1-\beta}{1+\beta}}\frac{6\sigma\sqrt{r}}{\sqrt{B}}=\mathcal{O}(\frac{1}{T^{1/4}})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mn>2</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>B</mi></msqrt></mrow></mfrac></mstyle><mo>+</mo><mrow><msqrt><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mrow><mn>1</mn><mo>+</mo><mi>β</mi></mrow></mfrac></mstyle></msqrt><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><msqrt><mi>B</mi></msqrt></mfrac></mstyle></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>T</mi><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup></mfrac></mstyle><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\mathbb{E}[F(\mathbf{W}_{0})-F(\mathbf{W}_{T})]}{\eta T}+\frac{L\eta r}{2}+\frac{2\beta L\eta r}{1-\beta}+\frac{6\sigma\sqrt{r}}{T(1-\beta)\sqrt{B}}+\sqrt{\frac{1-\beta}{1+\beta}}\frac{6\sigma\sqrt{r}}{\sqrt{B}}=\mathcal{O}(\frac{1}{T^{1/4}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS2.p8" class="ltx_para">
<p id="A2.SS2.p8.1" class="ltx_p"><span id="A2.SS2.p8.1.1" class="ltx_text">Moreover, with condition <math id="A2.SS2.p8.m1" class="ltx_Math" alttext="\beta(1+q_{M})&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>β</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\beta(1+q_{M})&lt;1</annotation></semantics></math>, suppose <math id="A2.SS2.p8.m2" class="ltx_math_unparsed" alttext="1-\beta=C_{\beta}T^{-1/2}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>β</mi><mo>=</mo><mi>C</mi><msub><mrow></mrow><mi>β</mi></msub><mi>T</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1-\beta=C_{\beta}T^{-1/2}</annotation></semantics></math>, <math id="A2.SS2.p8.m3" class="ltx_Math" alttext="C_{\beta}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>β</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C_{\beta}&gt;0</annotation></semantics></math> is a constant. Choose <math id="A2.SS2.p8.m4" class="ltx_math_unparsed" alttext="q_{M}=C_{M}T^{-1/2}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><msub><mrow></mrow><mi>M</mi></msub><mo>=</mo><mi>C</mi><msub><mrow></mrow><mi>M</mi></msub><mi>T</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">q_{M}=C_{M}T^{-1/2}</annotation></semantics></math>, where <math id="A2.SS2.p8.m5" class="ltx_Math" alttext="C_{M}&lt;C_{\beta},C_{M}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>M</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>&lt;</mo><mrow><msub><mi>C</mi><mi>β</mi></msub><mo>,</mo><msub><mi>C</mi><mi>M</mi></msub></mrow><mo>&gt;</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C_{M}&lt;C_{\beta},C_{M}&gt;0</annotation></semantics></math> is a constant, then we have</span></p>
<table id="A2.EGx161" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex34.m1" class="ltx_math_unparsed" alttext="\displaystyle\beta(1+q_{M})=(1-C_{\beta}T^{-1/2})(1+C_{M}T^{-1/2})=1-(C_{\beta}-C_{M})T^{-1/2}-C_{\beta}C_{M}T^{-1}&lt;1." display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><msub><mi>C</mi><mi>β</mi></msub><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><msub><mi>C</mi><mi>M</mi></msub><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi>β</mi></msub><mo>−</mo><msub><mi>C</mi><mi>M</mi></msub><mo stretchy="false">)</mo></mrow><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo>−</mo><msub><mi>C</mi><mi>β</mi></msub><msub><mi>C</mi><mi>M</mi></msub><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>&lt;</mo><mn>1</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\beta(1+q_{M})=(1-C_{\beta}T^{-1/2})(1+C_{M}T^{-1/2})=1-(C_{\beta}-C_{M})T^{-1/2}-C_{\beta}C_{M}T^{-1}&lt;1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS2.p9" class="ltx_para">
<p id="A2.SS2.p9.1" class="ltx_p"><span id="A2.SS2.p9.1.1" class="ltx_text">Thus, by setting <math id="A2.SS2.p9.m1" class="ltx_math_unparsed" alttext="q_{G}=\mathcal{O}(T^{-1/2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>G</mi></msub><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q_{G}=\mathcal{O}(T^{-1/2})</annotation></semantics></math>, <math id="A2.SS2.p9.m2" class="ltx_math_unparsed" alttext="q_{W}=\mathcal{O}(T^{-1/2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>W</mi></msub><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q_{W}=\mathcal{O}(T^{-1/2})</annotation></semantics></math>, <math id="A2.SS2.p9.m3" class="ltx_math_unparsed" alttext="q_{M}=\mathcal{O}(T^{-1/2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>M</mi></msub><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q_{M}=\mathcal{O}(T^{-1/2})</annotation></semantics></math>, we have</span></p>
<table id="A2.EGx162" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex35.m1" class="ltx_Math" alttext="\displaystyle q_{G}+q_{W}+q_{G}T\eta+q_{W}T\eta+\frac{q_{M}\beta}{1-\beta(1+q_{M})}\bigg(1+\sqrt{1-\beta}+q_{G}+q_{W}+T\eta\bigg)" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>G</mi></msub><mo>+</mo><msub><mi>q</mi><mi>W</mi></msub><mo>+</mo><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mo>+</mo><mrow><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mi>M</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>β</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mn>1</mn><mo>+</mo><msqrt><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow></msqrt><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub><mo>+</mo><msub><mi>q</mi><mi>W</mi></msub><mo>+</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle q_{G}+q_{W}+q_{G}T\eta+q_{W}T\eta+\frac{q_{M}\beta}{1-\beta(1+q_{M})}\bigg(1+\sqrt{1-\beta}+q_{G}+q_{W}+T\eta\bigg)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex36.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex36.m2" class="ltx_math_unparsed" alttext="\displaystyle\mathcal{O}(T^{-1/2}+T^{-1/2}T^{1/4}+T^{-1/2}(1+T^{-1/4}+T^{-1/2}+T^{1/4}))" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo>+</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><msup><mi>T</mi><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo>+</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo>+</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo>+</mo><msup><mi>T</mi><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{O}(T^{-1/2}+T^{-1/2}T^{1/4}+T^{-1/2}(1+T^{-1/4}+T^{-1/2}+T^{1/4}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex37.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex37.m2" class="ltx_math_unparsed" alttext="\displaystyle\mathcal{O}(T^{-1/4})," display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{O}(T^{-1/4}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p9.2" class="ltx_p"><span id="A2.SS2.p9.2.1" class="ltx_text">where we used the fact <math id="A2.SS2.p9.m4" class="ltx_math_unparsed" alttext="\frac{q_{M}\beta}{1-\beta(1+q_{M})}=\mathcal{O}(q_{M}\beta(1+\beta(1+q_{M})))=\mathcal{O}(T^{-1/2})" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><msub><mi>q</mi><mi>M</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>β</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>M</mi></msub><mi>β</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><mi>β</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\frac{q_{M}\beta}{1-\beta(1+q_{M})}=\mathcal{O}(q_{M}\beta(1+\beta(1+q_{M})))=\mathcal{O}(T^{-1/2})</annotation></semantics></math>, and <math id="A2.SS2.p9.m5" class="ltx_Math" alttext="\beta(1+q_{M})&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>β</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\beta(1+q_{M})&lt;1</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS2.p10" class="ltx_para">
<p id="A2.SS2.p10.1" class="ltx_p"><span id="A2.SS2.p10.1.1" class="ltx_text">Combining the above results, with the fact that <math id="A2.SS2.p10.m1" class="ltx_Math" alttext="\|\mathbf{A}\|_{*}\geq\|\mathbf{A}\|_{F}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝐀</mi><mo stretchy="false">‖</mo></mrow><mo>∗</mo></msub><mo>≥</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝐀</mi><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow><annotation encoding="application/x-tex">\|\mathbf{A}\|_{*}\geq\|\mathbf{A}\|_{F}</annotation></semantics></math> for any matrix <math id="A2.SS2.p10.m2" class="ltx_Math" alttext="\mathbf{A}" display="inline" intent=":literal"><semantics><mi>𝐀</mi><annotation encoding="application/x-tex">\mathbf{A}</annotation></semantics></math>, we complete the proof.</span></p>
</div>
<div id="A2.SS2.p11" class="ltx_para">
<p id="A2.SS2.p11.1" class="ltx_p"><span id="A2.SS2.p11.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A2.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.3 </span>Proof of Lemma <a href="#A2.Thmtheorem1" title="Lemma B.1 (Bound of ‖𝐖‖_𝐹 and ‖∇𝐹⁢(𝐖)‖_𝐹 for Muon). ‣ B.3 Proof of Lemma ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1</span></a></h3>

<div id="A2.Thmtheorem1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem1.2" class="ltx_text ltx_font_bold">Lemma B.1</span></span><span id="A2.Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(Bound of <math id="A2.Thmtheorem1.m1" class="ltx_Math" alttext="\|\mathbf{W}\|_{F}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mi>𝐖</mi><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\|\mathbf{W}\|_{F}</annotation></semantics></math> and <math id="A2.Thmtheorem1.m2" class="ltx_Math" alttext="\|\nabla F(\mathbf{W})\|_{F}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐖</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\|\nabla F(\mathbf{W})\|_{F}</annotation></semantics></math> for Muon)<span id="A2.Thmtheorem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem1.p1" class="ltx_para">
<p id="A2.Thmtheorem1.p1.1" class="ltx_p"><span id="A2.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Suppose Assumptions <a href="#S4.Thmtheorem3" title="Assumption 4.3 (Smoothness). ‣ 4 Main Results ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a> and <a href="#S4.Thmtheorem4" title="Assumption 4.4 (Bounded Initialization). ‣ 4 Main Results ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.4</span></a> hold. The iterates of Muon satisfy that for any <math id="A2.Thmtheorem1.p1.m1" class="ltx_Math" alttext="t\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t\geq 0</annotation></semantics></math>,</span></p>
<table id="A2.EGx163" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex38.m1" class="ltx_Math" alttext="\displaystyle\|\mathbf{W}_{t}\|_{F}\leq D+t\eta\sqrt{r},\quad\|\nabla F(\mathbf{W}_{t})\|_{F}\leq G+t\eta\sqrt{r}L." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>≤</mo><mrow><mi>D</mi><mo>+</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>≤</mo><mrow><mi>G</mi><mo>+</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|\mathbf{W}_{t}\|_{F}\leq D+t\eta\sqrt{r},\quad\|\nabla F(\mathbf{W}_{t})\|_{F}\leq G+t\eta\sqrt{r}L.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Lemma <a href="#A2.Thmtheorem1" title="Lemma B.1 (Bound of ‖𝐖‖_𝐹 and ‖∇𝐹⁢(𝐖)‖_𝐹 for Muon). ‣ B.3 Proof of Lemma ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1</span></a>.</h6>
<div id="A2.SS3.p1" class="ltx_para">
<p id="A2.SS3.p1.1" class="ltx_p"><span id="A2.SS3.p1.1.1" class="ltx_text">According to the update of Muon, we have</span></p>
<table id="A2.EGx164" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex39.m1" class="ltx_Math" alttext="\displaystyle\|\mathbf{W}_{t}\|_{F}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\|\mathbf{W}_{t}\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex40"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex40.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex40.m2" class="ltx_Math" alttext="\displaystyle\|\mathbf{W}_{t-1}-\eta\mathbf{U}_{t}\mathbf{V}_{t}^{\top}\|_{F}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐖</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐔</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐕</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\|\mathbf{W}_{t-1}-\eta\mathbf{U}_{t}\mathbf{V}_{t}^{\top}\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex41"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex41.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex41.m2" class="ltx_Math" alttext="\displaystyle\|\mathbf{W}_{t-1}\|_{F}+\eta\|\mathbf{U}_{t}\mathbf{V}_{t}^{\top}\|_{F}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐖</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐔</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐕</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\|\mathbf{W}_{t-1}\|_{F}+\eta\|\mathbf{U}_{t}\mathbf{V}_{t}^{\top}\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex42"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex42.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex42.m2" class="ltx_Math" alttext="\displaystyle\|\mathbf{W}_{t-1}\|_{F}+\eta\sqrt{\mathop{\mathrm{Tr}}(\mathbf{V}_{t}\mathbf{U}_{t}^{\top}\mathbf{U}_{t}\mathbf{V}_{t}^{\top})}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐖</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mo movablelimits="false" rspace="0em">Tr</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐕</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐔</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐔</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐕</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\|\mathbf{W}_{t-1}\|_{F}+\eta\sqrt{\mathop{\mathrm{Tr}}(\mathbf{V}_{t}\mathbf{U}_{t}^{\top}\mathbf{U}_{t}\mathbf{V}_{t}^{\top})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex43.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex43.m2" class="ltx_Math" alttext="\displaystyle\|\mathbf{W}_{t-1}\|_{F}+\eta\sqrt{r}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐖</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\|\mathbf{W}_{t-1}\|_{F}+\eta\sqrt{r}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex44"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex44.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex44.m2" class="ltx_Math" alttext="\displaystyle\|\mathbf{W}_{0}\|_{F}+t\eta\sqrt{r}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐖</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>+</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\|\mathbf{W}_{0}\|_{F}+t\eta\sqrt{r}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex45.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex45.m2" class="ltx_Math" alttext="\displaystyle D+t\eta\sqrt{r}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>D</mi><mo>+</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle D+t\eta\sqrt{r}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.p1.2" class="ltx_p"><span id="A2.SS3.p1.2.1" class="ltx_text">The third inequality is because <math id="A2.SS3.p1.m1" class="ltx_Math" alttext="\mathbf{U}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝐔</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathbf{U}_{t}</annotation></semantics></math> and <math id="A2.SS3.p1.m2" class="ltx_Math" alttext="\mathbf{V}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝐕</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathbf{V}_{t}</annotation></semantics></math> are orthogonal matrices, and the last inequality is due to Assumption <a href="#S4.Thmtheorem4" title="Assumption 4.4 (Bounded Initialization). ‣ 4 Main Results ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.4</span></a>.</span></p>
<table id="A2.EGx165" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex46"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex46.m1" class="ltx_Math" alttext="\displaystyle\|\nabla F(\mathbf{W}_{t})\|_{F}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\|\nabla F(\mathbf{W}_{t})\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex47"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex47.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex47.m2" class="ltx_Math" alttext="\displaystyle\|\nabla F(\mathbf{W}_{0})\|_{F}+\sum_{k=0}^{t-1}\|\nabla F(\mathbf{W}_{k+1})-\nabla F(\mathbf{W}_{k})\|_{F}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\|\nabla F(\mathbf{W}_{0})\|_{F}+\sum_{k=0}^{t-1}\|\nabla F(\mathbf{W}_{k+1})-\nabla F(\mathbf{W}_{k})\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex48"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex48.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex48.m2" class="ltx_Math" alttext="\displaystyle G+\sum_{k=0}^{t-1}L\|\mathbf{W}_{k+1}-\mathbf{W}_{k}\|_{F}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐖</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>𝐖</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle G+\sum_{k=0}^{t-1}L\|\mathbf{W}_{k+1}-\mathbf{W}_{k}\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex49.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex49.m2" class="ltx_Math" alttext="\displaystyle G+\sum_{k=0}^{t-1}L\eta\sqrt{r}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle G+\sum_{k=0}^{t-1}L\eta\sqrt{r}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex50.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex50.m2" class="ltx_Math" alttext="\displaystyle G+t\eta\sqrt{r}L." display="inline" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo>+</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle G+t\eta\sqrt{r}L.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.p1.3" class="ltx_p"><span id="A2.SS3.p1.3.1" class="ltx_text">The first inequality is due to the triangle inequality, the second inequality is due to Assumption <a href="#S4.Thmtheorem3" title="Assumption 4.3 (Smoothness). ‣ 4 Main Results ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a>, and the last inequality is due to the update of Muon.
∎</span></p>
</div>
</div>
</section>
<section id="A2.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.4 </span>Proof of Lemma <a href="#A2.Thmtheorem2" title="Lemma B.2. ‣ B.4 Proof of Lemma ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a></h3>

<div id="A2.Thmtheorem2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem2.2" class="ltx_text ltx_font_bold">Lemma B.2</span></span><span id="A2.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem2.p1" class="ltx_para">
<p id="A2.Thmtheorem2.p1.1" class="ltx_p"><span id="A2.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Suppose Assumption <a href="#S3.Thmtheorem1" title="Assumption 3.1 (Quantization Error). ‣ Relative error. ‣ 3.1 Preliminaries ‣ 3 Preliminaries and Problem Setup ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a> holds. For any matrix <math id="A2.Thmtheorem2.p1.m1" class="ltx_Math" alttext="\mathbf{X}\in\mathbb{R}^{m\times n}" display="inline" intent=":literal"><semantics><mrow><mi>𝐗</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{X}\in\mathbb{R}^{m\times n}</annotation></semantics></math> and its quantized version <math id="A2.Thmtheorem2.p1.m2" class="ltx_Math" alttext="\mathbf{X}^{Q}" display="inline" intent=":literal"><semantics><msup><mi>𝐗</mi><mi>Q</mi></msup><annotation encoding="application/x-tex">\mathbf{X}^{Q}</annotation></semantics></math>, we have</span></p>
<table id="A2.EGx166" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex51.m1" class="ltx_Math" alttext="\displaystyle\|\mathbf{X}^{Q}-\mathbf{X}\|_{F}\leq q\|\mathbf{X}\|_{F}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝐗</mi><mi>Q</mi></msup><mo>−</mo><mi>𝐗</mi></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>≤</mo><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝐗</mi><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|\mathbf{X}^{Q}-\mathbf{X}\|_{F}\leq q\|\mathbf{X}\|_{F}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.SS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Lemma <a href="#A2.Thmtheorem2" title="Lemma B.2. ‣ B.4 Proof of Lemma ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a>.</h6>
<div id="A2.SS4.p1" class="ltx_para">
<p id="A2.SS4.p1.1" class="ltx_p"><span id="A2.SS4.p1.1.1" class="ltx_text">According to Assumption <a href="#S3.Thmtheorem1" title="Assumption 3.1 (Quantization Error). ‣ Relative error. ‣ 3.1 Preliminaries ‣ 3 Preliminaries and Problem Setup ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>, we have</span></p>
<table id="A2.EGx167" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex52"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex52.m1" class="ltx_Math" alttext="\displaystyle\|\mathbf{X}^{Q}-\mathbf{X}\|_{F}^{2}=" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝐗</mi><mi>Q</mi></msup><mo>−</mo><mi>𝐗</mi></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\|\mathbf{X}^{Q}-\mathbf{X}\|_{F}^{2}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex52.m2" class="ltx_Math" alttext="\displaystyle\sum_{i=1}^{m}\sum_{j=1}^{n}|X_{ij}^{Q}-X_{ij}|^{2}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><msup><mrow><mo stretchy="false">|</mo><mrow><msubsup><mi>X</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>Q</mi></msubsup><mo>−</mo><msub><mi>X</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=1}^{m}\sum_{j=1}^{n}|X_{ij}^{Q}-X_{ij}|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex53.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex53.m2" class="ltx_Math" alttext="\displaystyle\sum_{i=1}^{m}\sum_{j=1}^{n}q^{2}|X_{ij}|^{2}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msup><mi>q</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><msub><mi>X</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=1}^{m}\sum_{j=1}^{n}q^{2}|X_{ij}|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex54.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex54.m2" class="ltx_Math" alttext="\displaystyle q^{2}\|\mathbf{X}\|_{F}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>q</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐗</mi><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle q^{2}\|\mathbf{X}\|_{F}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p1.2" class="ltx_p"><span id="A2.SS4.p1.2.1" class="ltx_text">Taking the square root on both sides, we complete the proof.
∎</span></p>
</div>
</div>
</section>
<section id="A2.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.5 </span>Proof of Lemma <a href="#A2.Thmtheorem3" title="Lemma B.3. ‣ B.5 Proof of Lemma ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.3</span></a></h3>

<div id="A2.Thmtheorem3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem3.2" class="ltx_text ltx_font_bold">Lemma B.3</span></span><span id="A2.Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem3.p1" class="ltx_para">
<p id="A2.Thmtheorem3.p1.1" class="ltx_p"><span id="A2.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Suppose Assumptions <a href="#S4.Thmtheorem3" title="Assumption 4.3 (Smoothness). ‣ 4 Main Results ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a> and <a href="#S4.Thmtheorem4" title="Assumption 4.4 (Bounded Initialization). ‣ 4 Main Results ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.4</span></a> hold. For any <math id="A2.Thmtheorem3.p1.m1" class="ltx_Math" alttext="t\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t\geq 0</annotation></semantics></math>, we have</span></p>
<table id="A2.EGx168" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex55"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex55.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\|\nabla F(\mathbf{W}_{t})-\mathbf{C}_{t}\|_{F}]\leq\frac{\beta L\eta\sqrt{r}}{1-\beta}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>𝐂</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\|\nabla F(\mathbf{W}_{t})-\mathbf{C}_{t}\|_{F}]\leq\frac{\beta L\eta\sqrt{r}}{1-\beta}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.SS5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Lemma <a href="#A2.Thmtheorem3" title="Lemma B.3. ‣ B.5 Proof of Lemma ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.3</span></a>.</h6>
<div id="A2.SS5.p1" class="ltx_para">
<p id="A2.SS5.p1.1" class="ltx_p"><span id="A2.SS5.p1.1.1" class="ltx_text">This proof is a standard technique for bounding the bias term of momentum. We have</span></p>
<table id="A2.EGx169" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex56"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex56.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\|\nabla F(\mathbf{W}_{t})-\mathbf{C}_{t}\|_{F}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>𝐂</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\|\nabla F(\mathbf{W}_{t})-\mathbf{C}_{t}\|_{F}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex57"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex57.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex57.m2" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}[\|\nabla F(\mathbf{W}_{t})-(\beta\mathbf{C}_{t-1}+(1-\beta)\nabla F(\mathbf{W}_{t}))\|_{F}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mo lspace="0em" rspace="0.167em">∥</mo><mo rspace="0.167em">∇</mo><mi>F</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><msub><mi>𝐂</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>+</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>β</mi><mo rspace="0.167em" stretchy="false">)</mo></mrow><mo rspace="0.167em">∇</mo><mi>F</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><msub><mo lspace="0em" rspace="0.167em">∥</mo><mi>F</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\|\nabla F(\mathbf{W}_{t})-(\beta\mathbf{C}_{t-1}+(1-\beta)\nabla F(\mathbf{W}_{t}))\|_{F}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex58"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex58.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex58.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\beta\|\nabla F(\mathbf{W}_{t})-\mathbf{C}_{t-1}\|_{F}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>𝐂</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\beta\|\nabla F(\mathbf{W}_{t})-\mathbf{C}_{t-1}\|_{F}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex59"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex59.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex59.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\beta\|\nabla F(\mathbf{W}_{t-1})-\mathbf{C}_{t-1}\|_{F}+\beta\|\nabla F(\mathbf{W}_{t-1})-\nabla F(\mathbf{W}_{t})\|_{F}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>𝐂</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\beta\|\nabla F(\mathbf{W}_{t-1})-\mathbf{C}_{t-1}\|_{F}+\beta\|\nabla F(\mathbf{W}_{t-1})-\nabla F(\mathbf{W}_{t})\|_{F}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex60"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex60.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex60.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\beta\|\nabla F(\mathbf{W}_{t-1})-\mathbf{C}_{t-1}\|_{F}+\beta L\|\mathbf{W}_{t-1}-\mathbf{W}_{t}\|_{F}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>𝐂</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐖</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>𝐖</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\beta\|\nabla F(\mathbf{W}_{t-1})-\mathbf{C}_{t-1}\|_{F}+\beta L\|\mathbf{W}_{t-1}-\mathbf{W}_{t}\|_{F}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex61"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex61.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex61.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\beta\|\nabla F(\mathbf{W}_{t-1})-\mathbf{C}_{t-1}\|_{F}+\beta L\eta\|\mathbf{U}_{t-1}\mathbf{V}_{t-1}^{\top}\|_{F}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>𝐂</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐔</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐕</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\beta\|\nabla F(\mathbf{W}_{t-1})-\mathbf{C}_{t-1}\|_{F}+\beta L\eta\|\mathbf{U}_{t-1}\mathbf{V}_{t-1}^{\top}\|_{F}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex62"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex62.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex62.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\beta\|\nabla F(\mathbf{W}_{t-1})-\mathbf{C}_{t-1}\|_{F}+\beta L\eta\sqrt{r}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>𝐂</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\beta\|\nabla F(\mathbf{W}_{t-1})-\mathbf{C}_{t-1}\|_{F}+\beta L\eta\sqrt{r}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex63.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex63.m2" class="ltx_Math" alttext="\displaystyle\beta^{t}\|\nabla F(\mathbf{W}_{0})-\mathbf{C}_{0}\|_{F}+\sum_{i=1}^{t}\beta^{i}L\eta\sqrt{r}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>β</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>𝐂</mi><mn>0</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>β</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\beta^{t}\|\nabla F(\mathbf{W}_{0})-\mathbf{C}_{0}\|_{F}+\sum_{i=1}^{t}\beta^{i}L\eta\sqrt{r}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex64"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex64.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex64.m2" class="ltx_Math" alttext="\displaystyle\frac{\beta L\eta\sqrt{r}}{1-\beta}." display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow></mfrac></mstyle><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\beta L\eta\sqrt{r}}{1-\beta}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS5.p1.2" class="ltx_p"><span id="A2.SS5.p1.2.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A2.SS6" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.6 </span>Proof of Lemma <a href="#A2.Thmtheorem4" title="Lemma B.4. ‣ B.6 Proof of Lemma ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.4</span></a></h3>

<div id="A2.Thmtheorem4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem4.2" class="ltx_text ltx_font_bold">Lemma B.4</span></span><span id="A2.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem4.p1" class="ltx_para">
<p id="A2.Thmtheorem4.p1.1" class="ltx_p"><span id="A2.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Suppose Assumptions <a href="#S4.Thmtheorem1" title="Assumption 4.1 (Unbiased Stochastic Gradient). ‣ 4 Main Results ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> and <a href="#S4.Thmtheorem2" title="Assumption 4.2 (Stochastic Gradient Bounds). ‣ 4 Main Results ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a> hold. For any <math id="A2.Thmtheorem4.p1.m1" class="ltx_Math" alttext="t\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t\geq 0</annotation></semantics></math>, we have</span></p>
<table id="A2.EGx170" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex65.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\|\mathbf{C}_{t}-\mathbf{X}_{t}\|_{F}]\leq\beta^{t}\frac{\sigma}{\sqrt{B}}+\sqrt{\frac{1-\beta}{1+\beta}}\frac{\sigma}{\sqrt{B}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐂</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝐗</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mrow><mrow><msup><mi>β</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>σ</mi><msqrt><mi>B</mi></msqrt></mfrac></mstyle></mrow><mo>+</mo><mrow><msqrt><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mrow><mn>1</mn><mo>+</mo><mi>β</mi></mrow></mfrac></mstyle></msqrt><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>σ</mi><msqrt><mi>B</mi></msqrt></mfrac></mstyle></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\|\mathbf{C}_{t}-\mathbf{X}_{t}\|_{F}]\leq\beta^{t}\frac{\sigma}{\sqrt{B}}+\sqrt{\frac{1-\beta}{1+\beta}}\frac{\sigma}{\sqrt{B}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.SS6.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Lemma <a href="#A2.Thmtheorem4" title="Lemma B.4. ‣ B.6 Proof of Lemma ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.4</span></a>.</h6>
<div id="A2.SS6.p1" class="ltx_para">
<p id="A2.SS6.p1.1" class="ltx_p"><span id="A2.SS6.p1.1.1" class="ltx_text">Expanding <math id="A2.SS6.p1.m1" class="ltx_Math" alttext="\mathbf{C}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝐂</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathbf{C}_{t}</annotation></semantics></math> and <math id="A2.SS6.p1.m2" class="ltx_Math" alttext="\mathbf{X}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝐗</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathbf{X}_{t}</annotation></semantics></math> by their definitions in (<a href="#A2.E2" title="In B.1 Preliminaries ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a>) and (<a href="#A2.E3" title="In B.1 Preliminaries ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.3</span></a>), we have</span></p>
<table id="A2.EGx171" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex66"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex66.m1" class="ltx_Math" alttext="\displaystyle\mathbf{C}_{t}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐂</mi><mi>t</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{C}_{t}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex66.m2" class="ltx_math_unparsed" alttext="\displaystyle\beta^{t}\mathbf{C}_{0}+(1-\beta)\sum_{k=1}^{t}\beta^{t-k}\nabla F(\mathbf{W}_{k})," display="inline" intent=":literal"><semantics><mrow><msup><mi>β</mi><mi>t</mi></msup><msub><mi>𝐂</mi><mn>0</mn></msub><mo>+</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>β</mi><mo stretchy="false">)</mo></mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><msup><mi>β</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>F</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\beta^{t}\mathbf{C}_{0}+(1-\beta)\sum_{k=1}^{t}\beta^{t-k}\nabla F(\mathbf{W}_{k}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex67.m1" class="ltx_Math" alttext="\displaystyle\mathbf{X}_{t}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐗</mi><mi>t</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{X}_{t}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex67.m2" class="ltx_Math" alttext="\displaystyle\beta^{t}\mathbf{X}_{0}+(1-\beta)\sum_{k=1}^{t}\beta^{t-k}\frac{1}{B}\sum_{i=1}^{B}\nabla f(\mathbf{W}_{k};\bm{\xi}_{k,i})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>β</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐗</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>β</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>B</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></munderover></mstyle><mrow><mrow><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>k</mi></msub><mo>,</mo><msub><mi>𝝃</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\beta^{t}\mathbf{X}_{0}+(1-\beta)\sum_{k=1}^{t}\beta^{t-k}\frac{1}{B}\sum_{i=1}^{B}\nabla f(\mathbf{W}_{k};\bm{\xi}_{k,i}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS6.p1.2" class="ltx_p"><span id="A2.SS6.p1.2.1" class="ltx_text">Thus, we have</span></p>
<table id="A2.EGx172" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex68.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\|\mathbf{C}_{t}-\mathbf{X}_{t}\|_{F}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐂</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝐗</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\|\mathbf{C}_{t}-\mathbf{X}_{t}\|_{F}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex69.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex69.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\|\beta^{t}(\mathbf{C}_{0}-\mathbf{X}_{0})\|_{F}]+\mathbb{E}[(1-\beta)\|\sum_{k=1}^{t}\beta^{t-k}(\nabla F(\mathbf{W}_{k})-\frac{1}{B}\sum_{i=1}^{B}\nabla f(\mathbf{W}_{k};\bm{\xi}_{k,i}))\|_{F}]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>β</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐂</mi><mn>0</mn></msub><mo>−</mo><msub><mi>𝐗</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>β</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>B</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></munderover></mstyle><mrow><mrow><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>k</mi></msub><mo>,</mo><msub><mi>𝝃</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\|\beta^{t}(\mathbf{C}_{0}-\mathbf{X}_{0})\|_{F}]+\mathbb{E}[(1-\beta)\|\sum_{k=1}^{t}\beta^{t-k}(\nabla F(\mathbf{W}_{k})-\frac{1}{B}\sum_{i=1}^{B}\nabla f(\mathbf{W}_{k};\bm{\xi}_{k,i}))\|_{F}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex70"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex70.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex70.m2" class="ltx_Math" alttext="\displaystyle\beta^{t}\mathbb{E}[\|\mathbf{C}_{0}-\mathbf{X}_{0}\|_{F}]+\sqrt{\mathbb{E}[(1-\beta)^{2}\|\sum_{k=1}^{t}\beta^{t-k}(\nabla F(\mathbf{W}_{k})-\frac{1}{B}\sum_{i=1}^{B}\nabla f(\mathbf{W}_{k};\bm{\xi}_{k,i}))\|_{F}^{2}]}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>β</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐂</mi><mn>0</mn></msub><mo>−</mo><msub><mi>𝐗</mi><mn>0</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><msqrt><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>β</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>B</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></munderover></mstyle><mrow><mrow><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>k</mi></msub><mo>,</mo><msub><mi>𝝃</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle\beta^{t}\mathbb{E}[\|\mathbf{C}_{0}-\mathbf{X}_{0}\|_{F}]+\sqrt{\mathbb{E}[(1-\beta)^{2}\|\sum_{k=1}^{t}\beta^{t-k}(\nabla F(\mathbf{W}_{k})-\frac{1}{B}\sum_{i=1}^{B}\nabla f(\mathbf{W}_{k};\bm{\xi}_{k,i}))\|_{F}^{2}]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex71"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex71.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex71.m2" class="ltx_Math" alttext="\displaystyle\beta^{t}\mathbb{E}[\|\mathbf{C}_{0}-\mathbf{X}_{0}\|_{F}]+\sqrt{\mathbb{E}[(1-\beta)^{2}\sum_{k=1}^{t}\beta^{2(t-k)}\frac{1}{B^{2}}\sum_{i=1}^{B}\|\nabla F(\mathbf{W}_{k};\bm{\xi}_{k,i})-\nabla F(\mathbf{W}_{k})\|_{F}^{2}]}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>β</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐂</mi><mn>0</mn></msub><mo>−</mo><msub><mi>𝐗</mi><mn>0</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><msqrt><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>β</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>B</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></munderover></mstyle><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>k</mi></msub><mo>,</mo><msub><mi>𝝃</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup></mrow></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle\beta^{t}\mathbb{E}[\|\mathbf{C}_{0}-\mathbf{X}_{0}\|_{F}]+\sqrt{\mathbb{E}[(1-\beta)^{2}\sum_{k=1}^{t}\beta^{2(t-k)}\frac{1}{B^{2}}\sum_{i=1}^{B}\|\nabla F(\mathbf{W}_{k};\bm{\xi}_{k,i})-\nabla F(\mathbf{W}_{k})\|_{F}^{2}]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex72"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex72.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex72.m2" class="ltx_Math" alttext="\displaystyle\beta^{t}\mathbb{E}[\|\mathbf{C}_{0}-\mathbf{X}_{0}\|_{F}]+\sqrt{(1-\beta)^{2}\sum_{k=1}^{t}\beta^{2(t-k)}\frac{\sigma^{2}}{B}}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>β</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐂</mi><mn>0</mn></msub><mo>−</mo><msub><mi>𝐗</mi><mn>0</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><msqrt><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>β</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>σ</mi><mn>2</mn></msup><mi>B</mi></mfrac></mstyle></mrow></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle\beta^{t}\mathbb{E}[\|\mathbf{C}_{0}-\mathbf{X}_{0}\|_{F}]+\sqrt{(1-\beta)^{2}\sum_{k=1}^{t}\beta^{2(t-k)}\frac{\sigma^{2}}{B}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex73"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex73.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex73.m2" class="ltx_Math" alttext="\displaystyle\beta^{t}\frac{\sigma}{\sqrt{B}}+\sqrt{\frac{1-\beta}{1+\beta}}\frac{\sigma}{\sqrt{B}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>β</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>σ</mi><msqrt><mi>B</mi></msqrt></mfrac></mstyle></mrow><mo>+</mo><mrow><msqrt><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mrow><mn>1</mn><mo>+</mo><mi>β</mi></mrow></mfrac></mstyle></msqrt><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>σ</mi><msqrt><mi>B</mi></msqrt></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\beta^{t}\frac{\sigma}{\sqrt{B}}+\sqrt{\frac{1-\beta}{1+\beta}}\frac{\sigma}{\sqrt{B}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS6.p1.3" class="ltx_p"><span id="A2.SS6.p1.3.1" class="ltx_text">The second inequality is due to Jensen’s inequality, the first equality is due to the independence of <math id="A2.SS6.p1.m3" class="ltx_Math" alttext="\bm{\xi}_{k,i}" display="inline" intent=":literal"><semantics><msub><mi>𝝃</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">\bm{\xi}_{k,i}</annotation></semantics></math> for different <math id="A2.SS6.p1.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> or <math id="A2.SS6.p1.m5" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, and the third inequality is due to Assumptions <a href="#S4.Thmtheorem1" title="Assumption 4.1 (Unbiased Stochastic Gradient). ‣ 4 Main Results ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> and <a href="#S4.Thmtheorem2" title="Assumption 4.2 (Stochastic Gradient Bounds). ‣ 4 Main Results ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>.
∎</span></p>
</div>
</div>
</section>
<section id="A2.SS7" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.7 </span>Proof of Lemma <a href="#A2.Thmtheorem5" title="Lemma B.5. ‣ B.7 Proof of Lemma ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.5</span></a></h3>

<div id="A2.Thmtheorem5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem5.2" class="ltx_text ltx_font_bold">Lemma B.5</span></span><span id="A2.Thmtheorem5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem5.p1" class="ltx_para">
<p id="A2.Thmtheorem5.p1.1" class="ltx_p"><span id="A2.Thmtheorem5.p1.1.1" class="ltx_text ltx_font_italic">Suppose Assumptions <a href="#S4.Thmtheorem1" title="Assumption 4.1 (Unbiased Stochastic Gradient). ‣ 4 Main Results ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>, <a href="#S4.Thmtheorem2" title="Assumption 4.2 (Stochastic Gradient Bounds). ‣ 4 Main Results ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a> and <a href="#S3.Thmtheorem1" title="Assumption 3.1 (Quantization Error). ‣ Relative error. ‣ 3.1 Preliminaries ‣ 3 Preliminaries and Problem Setup ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a> hold. For any <math id="A2.Thmtheorem5.p1.m1" class="ltx_Math" alttext="t\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t\geq 0</annotation></semantics></math>, we have</span></p>
<table id="A2.EGx173" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex74"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex74.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\|\mathbf{X}_{t}-\mathbf{Y}_{t}\|_{F}]\leq q_{G}(\sigma+G+t\eta\sqrt{r}L)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐗</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝐘</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>+</mo><mi>G</mi><mo>+</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\|\mathbf{X}_{t}-\mathbf{Y}_{t}\|_{F}]\leq q_{G}(\sigma+G+t\eta\sqrt{r}L).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.SS7.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Lemma <a href="#A2.Thmtheorem5" title="Lemma B.5. ‣ B.7 Proof of Lemma ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.5</span></a>.</h6>
<div id="A2.SS7.p1" class="ltx_para">
<p id="A2.SS7.p1.1" class="ltx_p"><span id="A2.SS7.p1.1.1" class="ltx_text">By the definition of <math id="A2.SS7.p1.m1" class="ltx_Math" alttext="\mathbf{X}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝐗</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathbf{X}_{t}</annotation></semantics></math> and <math id="A2.SS7.p1.m2" class="ltx_Math" alttext="\mathbf{Y}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝐘</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathbf{Y}_{t}</annotation></semantics></math> in (<a href="#A2.E3" title="In B.1 Preliminaries ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.3</span></a>) and (<a href="#A2.E4" title="In B.1 Preliminaries ‣ Appendix B Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.4</span></a>), we have</span></p>
<table id="A2.EGx174" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex75"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex75.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\|\mathbf{X}_{t}-\mathbf{Y}_{t}\|_{F}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐗</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝐘</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\|\mathbf{X}_{t}-\mathbf{Y}_{t}\|_{F}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex76"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex76.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex76.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\beta\|\mathbf{X}_{t-1}-\mathbf{Y}_{t-1}\|_{F}]+(1-\beta)\frac{1}{B}\sum_{i=1}^{B}\mathbb{E}[\|\nabla f(\mathbf{W}_{t};\bm{\xi}_{t,i})-\nabla^{Q}f(\mathbf{W}_{t};\bm{\xi}_{t,i})\|_{F}]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐗</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>𝐘</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>B</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝝃</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><msup><mo rspace="0.167em">∇</mo><mi>Q</mi></msup><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝝃</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\beta\|\mathbf{X}_{t-1}-\mathbf{Y}_{t-1}\|_{F}]+(1-\beta)\frac{1}{B}\sum_{i=1}^{B}\mathbb{E}[\|\nabla f(\mathbf{W}_{t};\bm{\xi}_{t,i})-\nabla^{Q}f(\mathbf{W}_{t};\bm{\xi}_{t,i})\|_{F}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex77"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex77.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex77.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\beta\|\mathbf{X}_{t-1}-\mathbf{Y}_{t-1}\|_{F}]+(1-\beta)\frac{1}{B}\sum_{i=1}^{B}\mathbb{E}[q_{G}\|\nabla f(\mathbf{W}_{t};\bm{\xi}_{t,i})\|_{F}]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐗</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>𝐘</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>B</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝝃</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\beta\|\mathbf{X}_{t-1}-\mathbf{Y}_{t-1}\|_{F}]+(1-\beta)\frac{1}{B}\sum_{i=1}^{B}\mathbb{E}[q_{G}\|\nabla f(\mathbf{W}_{t};\bm{\xi}_{t,i})\|_{F}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex78"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex78.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
