<tbody id="A1.Ex48"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex48.m1" class="ltx_Math" alttext="\displaystyle+\underbrace{\frac{E}{\tilde{T}}\left(\ln\left(1+\frac{((1+q_{G})R)^{2}}{\epsilon(1-\beta_{2}(1-q_{V}))}\right)-T\ln(\beta_{2}(1-q_{V}))\right)}_{\text{Term 3}}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><munder><munder accentunder="true"><mrow><mstyle displaystyle="true"><mfrac><mi>E</mi><mover accent="true"><mi>T</mi><mo>~</mo></mover></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mi>ϵ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mtext>Term 3</mtext></munder></mrow><annotation encoding="application/x-tex">\displaystyle+\underbrace{\frac{E}{\tilde{T}}\left(\ln\left(1+\frac{((1+q_{G})R)^{2}}{\epsilon(1-\beta_{2}(1-q_{V}))}\right)-T\ln(\beta_{2}(1-q_{V}))\right)}_{\text{Term 3}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex49.m1" class="ltx_Math" alttext="\displaystyle+\underbrace{\frac{Q(T)}{\tilde{T}}}_{\text{Term 4}}+\underbrace{\frac{2(1+q_{G})dT}{\tilde{T}\sqrt{\epsilon(1-\beta_{2})}}\left(q_{G}R^{3}+Lq_{W}R^{2}\|\mathrm{vec}(\mathbf{W}_{0})\|_{2}\right)}_{\text{Term 5}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><munder><munder accentunder="true"><mstyle displaystyle="true"><mfrac><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mi>T</mi><mo>~</mo></mover></mfrac></mstyle><mo stretchy="true">⏟</mo></munder><mtext>Term 4</mtext></munder></mrow><mo>+</mo><munder><munder accentunder="true"><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mrow><mover accent="true"><mi>T</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>ϵ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>3</mn></msup></mrow><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo>)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mtext>Term 5</mtext></munder></mrow><annotation encoding="application/x-tex">\displaystyle+\underbrace{\frac{Q(T)}{\tilde{T}}}_{\text{Term 4}}+\underbrace{\frac{2(1+q_{G})dT}{\tilde{T}\sqrt{\epsilon(1-\beta_{2})}}\left(q_{G}R^{3}+Lq_{W}R^{2}\|\mathrm{vec}(\mathbf{W}_{0})\|_{2}\right)}_{\text{Term 5}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex50.m1" class="ltx_Math" alttext="\displaystyle+\underbrace{\frac{(1-\beta_{1})d^{\frac{3}{2}}\eta Lq_{W}(1+q_{G})R^{2}T^{2}}{\tilde{T}\sqrt{\epsilon}(1-\beta_{2})\sqrt{1-\frac{\beta_{1}^{2}(1+q_{M})^{2}}{\beta_{2}(1-q_{V})}}}}_{\text{Term 6}}." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><munder><munder accentunder="true"><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mfrac><mn>3</mn><mn>2</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mn>2</mn></msup></mrow><mrow><mover accent="true"><mi>T</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>ϵ</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></msqrt></mrow></mfrac></mstyle><mo stretchy="true">⏟</mo></munder><mtext>Term 6</mtext></munder></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\underbrace{\frac{(1-\beta_{1})d^{\frac{3}{2}}\eta Lq_{W}(1+q_{G})R^{2}T^{2}}{\tilde{T}\sqrt{\epsilon}(1-\beta_{2})\sqrt{1-\frac{\beta_{1}^{2}(1+q_{M})^{2}}{\beta_{2}(1-q_{V})}}}}_{\text{Term 6}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p27.1" class="ltx_p">Our proof strategy is to analyze the asymptotic order of each term under the following scaling assumptions.</p>
</div>
<section id="A1.SS2.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Scaling Assumptions.</h4>

<div id="A1.SS2.SSS0.Px1.p1" class="ltx_para">
<p id="A1.SS2.SSS0.Px1.p1.1" class="ltx_p">We adopt the scaling assumptions provided in the Theorem:</p>
<ul id="A1.I1" class="ltx_itemize ltx_leftmargin_flush">
<li id="A1.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I1.i1.p1" class="ltx_para">
<p id="A1.I1.i1.p1.1" class="ltx_p"><span id="A1.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Quantization Error Schedules:</span> The quantization errors are annealed over time such that <math id="A1.I1.i1.p1.m1" class="ltx_Math" alttext="q_{G}=\mathcal{O}(T^{-1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>G</mi></msub><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q_{G}=\mathcal{O}(T^{-1})</annotation></semantics></math>, <math id="A1.I1.i1.p1.m2" class="ltx_Math" alttext="q_{M}=\mathcal{O}(T^{-1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>M</mi></msub><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q_{M}=\mathcal{O}(T^{-1})</annotation></semantics></math>, <math id="A1.I1.i1.p1.m3" class="ltx_Math" alttext="q_{W}=\mathcal{O}(T^{-2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>W</mi></msub><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q_{W}=\mathcal{O}(T^{-2})</annotation></semantics></math>, and <math id="A1.I1.i1.p1.m4" class="ltx_Math" alttext="q_{V}=\mathcal{O}(T^{-2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>V</mi></msub><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q_{V}=\mathcal{O}(T^{-2})</annotation></semantics></math>.</p>
</div></li>
<li id="A1.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I1.i2.p1" class="ltx_para">
<p id="A1.I1.i2.p1.1" class="ltx_p"><span id="A1.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Adam Hyperparameters:</span> The learning rate and second-moment decay are set as <math id="A1.I1.i2.p1.m1" class="ltx_math_unparsed" alttext="\eta=\Theta(T^{-1/2})" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\eta=\Theta(T^{-1/2})</annotation></semantics></math> and <math id="A1.I1.i2.p1.m2" class="ltx_Math" alttext="1-\beta_{2}=\Theta(1/T)" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1-\beta_{2}=\Theta(1/T)</annotation></semantics></math>, while <math id="A1.I1.i2.p1.m3" class="ltx_Math" alttext="\beta_{1}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\beta_{1}</annotation></semantics></math> is treated as a constant.</p>
</div></li>
</ul>
</div>
</section>
<section id="A1.SS2.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Asymptotic Analysis of Bound Terms.</h4>

<div id="A1.SS2.SSS0.Px2.p1" class="ltx_para">
<p id="A1.SS2.SSS0.Px2.p1.1" class="ltx_p">We now analyze the order of magnitude for each of the six terms.</p>
</div>
<div id="A1.SS2.SSS0.Px2.p2" class="ltx_para">
<p id="A1.SS2.SSS0.Px2.p2.1" class="ltx_p"><span id="A1.SS2.SSS0.Px2.p2.1.1" class="ltx_text ltx_font_bold">Term 1 (Initial Condition Term):</span> This term is given by <math id="A1.SS2.SSS0.Px2.p2.m1" class="ltx_Math" alttext="T_{1}=2(1+q_{G})R\frac{F_{0}-F_{*}}{\eta\tilde{T}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msub><mi>F</mi><mn>0</mn></msub><mo>−</mo><msub><mi>F</mi><mo>∗</mo></msub></mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>T</mi><mo>~</mo></mover></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">T_{1}=2(1+q_{G})R\frac{F_{0}-F_{*}}{\eta\tilde{T}}</annotation></semantics></math>.
We analyze the components of its denominator. The effective number of iterations is <math id="A1.SS2.SSS0.Px2.p2.m2" class="ltx_Math" alttext="\tilde{T}=T-\frac{\beta_{1}}{1-\beta_{1}}=\Theta(T)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>T</mi><mo>~</mo></mover><mo>=</mo><mrow><mi>T</mi><mo>−</mo><mfrac><msub><mi>β</mi><mn>1</mn></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></mfrac></mrow><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{T}=T-\frac{\beta_{1}}{1-\beta_{1}}=\Theta(T)</annotation></semantics></math>. The learning rate scales as <math id="A1.SS2.SSS0.Px2.p2.m3" class="ltx_math_unparsed" alttext="\eta=\Theta(T^{-1/2})" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\eta=\Theta(T^{-1/2})</annotation></semantics></math>. The denominator thus scales as <math id="A1.SS2.SSS0.Px2.p2.m4" class="ltx_math_unparsed" alttext="\eta\tilde{T}=\Theta(T^{-1/2})\Theta(T)=\Theta(T^{1/2})" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mover accent="true"><mi>T</mi><mo>~</mo></mover><mo>=</mo><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\eta\tilde{T}=\Theta(T^{-1/2})\Theta(T)=\Theta(T^{1/2})</annotation></semantics></math>. Since all other quantities are constants and <math id="A1.SS2.SSS0.Px2.p2.m5" class="ltx_Math" alttext="q_{G}\to 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>G</mi></msub><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">q_{G}\to 0</annotation></semantics></math>, the entire term scales as:</p>
<table id="A1.EGx47" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex51.m1" class="ltx_math_unparsed" alttext="\displaystyle T_{1}=\Theta\left(\frac{1}{\eta\tilde{T}}\right)=\Theta\left(\frac{1}{T^{1/2}}\right)=\Theta(T^{-1/2})." display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>=</mo><mi mathvariant="normal">Θ</mi><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>T</mi><mo>~</mo></mover></mrow></mfrac></mstyle><mo>)</mo></mrow><mo>=</mo><mi mathvariant="normal">Θ</mi><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>T</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mfrac></mstyle><mo>)</mo></mrow><mo>=</mo><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle T_{1}=\Theta\left(\frac{1}{\eta\tilde{T}}\right)=\Theta\left(\frac{1}{T^{1/2}}\right)=\Theta(T^{-1/2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.SSS0.Px2.p3" class="ltx_para">
<p id="A1.SS2.SSS0.Px2.p3.1" class="ltx_p"><span id="A1.SS2.SSS0.Px2.p3.1.1" class="ltx_text ltx_font_bold">Term 2 (First Logarithmic Term):</span> This term is:</p>
<table id="A1.EGx48" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex52"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex52.m1" class="ltx_Math" alttext="\displaystyle T_{2}=\frac{12d((1+q_{G})R)^{2}\sqrt{1-\beta_{1}}}{\tilde{T}(1-\beta_{1}/\beta_{2})^{3/2}\sqrt{1-\beta_{2}}}\left(\ln\left(1+\frac{((1+q_{G})R)^{2}}{\epsilon(1-\beta_{2})}\right)-T\ln(\beta_{2})\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>2</mn></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt></mrow><mrow><mover accent="true"><mi>T</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>/</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></msqrt></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mi>ϵ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle T_{2}=\frac{12d((1+q_{G})R)^{2}\sqrt{1-\beta_{1}}}{\tilde{T}(1-\beta_{1}/\beta_{2})^{3/2}\sqrt{1-\beta_{2}}}\left(\ln\left(1+\frac{((1+q_{G})R)^{2}}{\epsilon(1-\beta_{2})}\right)-T\ln(\beta_{2})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.SSS0.Px2.p3.2" class="ltx_p">The leading fraction’s order is determined by its denominator, <math id="A1.SS2.SSS0.Px2.p3.m1" class="ltx_Math" alttext="\tilde{T}\sqrt{1-\beta_{2}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>T</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></msqrt></mrow><annotation encoding="application/x-tex">\tilde{T}\sqrt{1-\beta_{2}}</annotation></semantics></math>. With <math id="A1.SS2.SSS0.Px2.p3.m2" class="ltx_Math" alttext="\tilde{T}=\Theta(T)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>T</mi><mo>~</mo></mover><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{T}=\Theta(T)</annotation></semantics></math> and <math id="A1.SS2.SSS0.Px2.p3.m3" class="ltx_Math" alttext="1-\beta_{2}=\Theta(1/T)" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1-\beta_{2}=\Theta(1/T)</annotation></semantics></math>, we have <math id="A1.SS2.SSS0.Px2.p3.m4" class="ltx_math_unparsed" alttext="\sqrt{1-\beta_{2}}=\Theta(T^{-1/2})" display="inline" intent=":literal"><semantics><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></msqrt><mo>=</mo><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\sqrt{1-\beta_{2}}=\Theta(T^{-1/2})</annotation></semantics></math>. Thus, the fraction scales as <math id="A1.SS2.SSS0.Px2.p3.m5" class="ltx_math_unparsed" alttext="\Theta(\frac{1}{T\cdot T^{-1/2}})=\Theta(T^{-1/2})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><mfrac><mn>1</mn><mrow><mi>T</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>T</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow></mfrac><mo stretchy="false">)</mo></mrow><mo>=</mo><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Theta(\frac{1}{T\cdot T^{-1/2}})=\Theta(T^{-1/2})</annotation></semantics></math>. The term in the parenthesis scales as <math id="A1.SS2.SSS0.Px2.p3.m6" class="ltx_Math" alttext="\ln(1+\Theta(T))-\Theta(1)=\Theta(\ln T)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\ln(1+\Theta(T))-\Theta(1)=\Theta(\ln T)</annotation></semantics></math>. The overall order is:</p>
<table id="A1.EGx49" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex53.m1" class="ltx_math_unparsed" alttext="\displaystyle T_{2}=\Theta\left(\frac{1}{\tilde{T}\sqrt{1-\beta_{2}}}\right)\cdot\Theta(\ln T)=\Theta\left(T^{-1/2}\right)\cdot\Theta(\ln T)=\Theta\left(\frac{\ln T}{\sqrt{T}}\right)." display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>2</mn></msub><mo>=</mo><mi mathvariant="normal">Θ</mi><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mover accent="true"><mi>T</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></msqrt></mrow></mfrac></mstyle><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><mi>ln</mi><mi>T</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi mathvariant="normal">Θ</mi><mrow><mo>(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><mi>ln</mi><mi>T</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi mathvariant="normal">Θ</mi><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><msqrt><mi>T</mi></msqrt></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle T_{2}=\Theta\left(\frac{1}{\tilde{T}\sqrt{1-\beta_{2}}}\right)\cdot\Theta(\ln T)=\Theta\left(T^{-1/2}\right)\cdot\Theta(\ln T)=\Theta\left(\frac{\ln T}{\sqrt{T}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.SSS0.Px2.p4" class="ltx_para">
<p id="A1.SS2.SSS0.Px2.p4.1" class="ltx_p"><span id="A1.SS2.SSS0.Px2.p4.1.1" class="ltx_text ltx_font_bold">Term 3 (Second Logarithmic Term):</span> This term is <math id="A1.SS2.SSS0.Px2.p4.m1" class="ltx_Math" alttext="T_{3}=\frac{E}{\tilde{T}}\left(\ln(...)-T\ln(...)\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>3</mn></msub><mo>=</mo><mrow><mfrac><mi>E</mi><mover accent="true"><mi>T</mi><mo>~</mo></mover></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">…</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">…</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T_{3}=\frac{E}{\tilde{T}}\left(\ln(...)-T\ln(...)\right)</annotation></semantics></math>.
First, we determine the asymptotic order of <math id="A1.SS2.SSS0.Px2.p4.m2" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>, which is defined as:</p>
<table id="A1.Ex54" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex54.m1" class="ltx_Math" alttext="E=\frac{d\eta L(1+q_{G})R(1-\beta_{1})^{2}}{(1-\beta_{1}(1+q_{M}))(1-\frac{\beta_{1}(1+q_{M})}{\beta_{2}(1-q_{V})})(1-\beta_{2})}+\frac{2d\eta^{2}L^{2}\beta_{1}(1-\beta_{1})}{(1-\beta_{1}(1+q_{M}))(1-\frac{\beta_{1}(1+q_{M})}{\beta_{2}(1-q_{V})})(1-\beta_{2})^{\frac{3}{2}}}." display="block" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo>=</mo><mrow><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>β</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><msub><mi>β</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>β</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><msub><mi>β</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mfrac><mn>3</mn><mn>2</mn></mfrac></msup></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">E=\frac{d\eta L(1+q_{G})R(1-\beta_{1})^{2}}{(1-\beta_{1}(1+q_{M}))(1-\frac{\beta_{1}(1+q_{M})}{\beta_{2}(1-q_{V})})(1-\beta_{2})}+\frac{2d\eta^{2}L^{2}\beta_{1}(1-\beta_{1})}{(1-\beta_{1}(1+q_{M}))(1-\frac{\beta_{1}(1+q_{M})}{\beta_{2}(1-q_{V})})(1-\beta_{2})^{\frac{3}{2}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.SSS0.Px2.p4.2" class="ltx_p">For the first part of <math id="A1.SS2.SSS0.Px2.p4.m3" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>, the numerator scales as <math id="A1.SS2.SSS0.Px2.p4.m4" class="ltx_math_unparsed" alttext="\eta=\Theta(T^{-1/2})" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\eta=\Theta(T^{-1/2})</annotation></semantics></math> and the denominator is dominated by <math id="A1.SS2.SSS0.Px2.p4.m5" class="ltx_Math" alttext="(1-\beta_{2})=\Theta(T^{-1})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(1-\beta_{2})=\Theta(T^{-1})</annotation></semantics></math>. This part is <math id="A1.SS2.SSS0.Px2.p4.m6" class="ltx_math_unparsed" alttext="\Theta(T^{-1/2})/\Theta(T^{-1})=\Theta(T^{1/2})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo>/</mo><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Theta(T^{-1/2})/\Theta(T^{-1})=\Theta(T^{1/2})</annotation></semantics></math>. For the second part, the numerator scales as <math id="A1.SS2.SSS0.Px2.p4.m7" class="ltx_Math" alttext="\eta^{2}=\Theta(T^{-1})" display="inline" intent=":literal"><semantics><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta^{2}=\Theta(T^{-1})</annotation></semantics></math> and the denominator is dominated by <math id="A1.SS2.SSS0.Px2.p4.m8" class="ltx_math_unparsed" alttext="(1-\beta_{2})^{3/2}=\Theta(T^{-3/2})" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup><mo>=</mo><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(1-\beta_{2})^{3/2}=\Theta(T^{-3/2})</annotation></semantics></math>. This part is <math id="A1.SS2.SSS0.Px2.p4.m9" class="ltx_math_unparsed" alttext="\Theta(T^{-1})/\Theta(T^{-3/2})=\Theta(T^{1/2})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo>/</mo><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Theta(T^{-1})/\Theta(T^{-3/2})=\Theta(T^{1/2})</annotation></semantics></math>. Thus, <math id="A1.SS2.SSS0.Px2.p4.m10" class="ltx_Math" alttext="E=\Theta(T^{1/2})" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">E=\Theta(T^{1/2})</annotation></semantics></math>. The logarithmic part scales as <math id="A1.SS2.SSS0.Px2.p4.m11" class="ltx_Math" alttext="\Theta(\ln T)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Theta(\ln T)</annotation></semantics></math>, so the entire term scales as:</p>
<table id="A1.EGx50" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex55"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex55.m1" class="ltx_Math" alttext="\displaystyle T_{3}=\Theta\left(\frac{E}{\tilde{T}}\right)\cdot\Theta(\ln T)=\Theta\left(\frac{T^{1/2}}{T}\right)\cdot\Theta(\ln T)=\Theta\left(\frac{\ln T}{\sqrt{T}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mn>3</mn></msub><mo>=</mo><mrow><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>E</mi><mover accent="true"><mi>T</mi><mo>~</mo></mover></mfrac></mstyle><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>T</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mi>T</mi></mfrac></mstyle><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><msqrt><mi>T</mi></msqrt></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle T_{3}=\Theta\left(\frac{E}{\tilde{T}}\right)\cdot\Theta(\ln T)=\Theta\left(\frac{T^{1/2}}{T}\right)\cdot\Theta(\ln T)=\Theta\left(\frac{\ln T}{\sqrt{T}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.SSS0.Px2.p5" class="ltx_para">
<p id="A1.SS2.SSS0.Px2.p5.1" class="ltx_p"><span id="A1.SS2.SSS0.Px2.p5.1.1" class="ltx_text ltx_font_bold">Term 4 (Moment Quantization Error):</span> We rewrite this term as:</p>
<table id="A1.EGx51" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex56"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex56.m1" class="ltx_Math" alttext="\displaystyle T_{4}=\frac{2(1+q_{G})dR^{2}T(1-\beta_{1})}{\tilde{T}\sqrt{1-\beta_{2}}}Q," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mn>4</mn></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mover accent="true"><mi>T</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></msqrt></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle T_{4}=\frac{2(1+q_{G})dR^{2}T(1-\beta_{1})}{\tilde{T}\sqrt{1-\beta_{2}}}Q,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.SSS0.Px2.p5.2" class="ltx_p">where <math id="A1.SS2.SSS0.Px2.p5.m1" class="ltx_Math" alttext="Q=q_{M}\cdot\frac{\sqrt{r^{\prime}(1+r^{\prime})}}{(1+q_{M})(1-r^{\prime})^{3/2}}+\frac{1}{\sqrt{1-\frac{\beta_{1}^{2}}{\beta_{2}(1-q_{V})}}}-\frac{1}{T}\frac{1}{\sqrt{1-\frac{\beta_{1}^{2}}{\beta_{2}(1-q_{V})}}}\left(\frac{1-q_{V}}{q_{V}}(1-(1-q_{V})^{T})\right)" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>=</mo><mrow><mrow><mrow><msub><mi>q</mi><mi>M</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><msqrt><mrow><msup><mi>r</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></msqrt><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow></mfrac></mrow><mo>+</mo><mfrac><mn>1</mn><msqrt><mrow><mn>1</mn><mo>−</mo><mfrac><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></msqrt></mfrac></mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mi>T</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><msqrt><mrow><mn>1</mn><mo>−</mo><mfrac><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><msub><mi>q</mi><mi>V</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mi>T</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">Q=q_{M}\cdot\frac{\sqrt{r^{\prime}(1+r^{\prime})}}{(1+q_{M})(1-r^{\prime})^{3/2}}+\frac{1}{\sqrt{1-\frac{\beta_{1}^{2}}{\beta_{2}(1-q_{V})}}}-\frac{1}{T}\frac{1}{\sqrt{1-\frac{\beta_{1}^{2}}{\beta_{2}(1-q_{V})}}}\left(\frac{1-q_{V}}{q_{V}}(1-(1-q_{V})^{T})\right)</annotation></semantics></math>.</p>
</div>
<div id="A1.SS2.SSS0.Px2.p6" class="ltx_para">
<p id="A1.SS2.SSS0.Px2.p6.1" class="ltx_p">Our goal is to show that <math id="A1.SS2.SSS0.Px2.p6.m1" class="ltx_math_unparsed" alttext="T_{4}=\mathcal{O}(T^{-1/2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>4</mn></msub><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T_{4}=\mathcal{O}(T^{-1/2})</annotation></semantics></math>.</p>
</div>
<div id="A1.SS2.SSS0.Px2.p7" class="ltx_para">
<p id="A1.SS2.SSS0.Px2.p7.1" class="ltx_p">First, the pre-factor has an asymptotic order of:</p>
<table id="A1.EGx52" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex57"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex57.m1" class="ltx_Math" alttext="\displaystyle\frac{2(1+q_{G})dR^{2}T(1-\beta_{1})}{\tilde{T}\sqrt{1-\beta_{2}}}=\Theta\left(\frac{T}{T\cdot T^{-1/2}}\right)=\Theta(T^{1/2})." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mover accent="true"><mi>T</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></msqrt></mrow></mfrac></mstyle><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>T</mi><mrow><mi>T</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>T</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{2(1+q_{G})dR^{2}T(1-\beta_{1})}{\tilde{T}\sqrt{1-\beta_{2}}}=\Theta\left(\frac{T}{T\cdot T^{-1/2}}\right)=\Theta(T^{1/2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.SSS0.Px2.p7.2" class="ltx_p">The core of the analysis thus lies in determining the order of <math id="A1.SS2.SSS0.Px2.p7.m1" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>. We can rewrite <math id="A1.SS2.SSS0.Px2.p7.m2" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> by combining its second and third components:</p>
<table id="A1.EGx53" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex58"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex58.m1" class="ltx_Math" alttext="\displaystyle Q=q_{M}\cdot\frac{\sqrt{r^{\prime}(1+r^{\prime})}}{(1+q_{M})(1-r^{\prime})^{3/2}}+\frac{1}{\sqrt{1-\frac{\beta_{1}^{2}}{\beta_{2}(1-q_{V})}}}\left[1-\frac{1}{T}\left(\frac{1-q_{V}}{q_{V}}(1-(1-q_{V})^{T})\right)\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mi>Q</mi><mo>=</mo><mrow><mrow><msub><mi>q</mi><mi>M</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><msqrt><mrow><msup><mi>r</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></msqrt><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mn>1</mn><mo>−</mo><mfrac><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><msub><mi>q</mi><mi>V</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mi>T</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle Q=q_{M}\cdot\frac{\sqrt{r^{\prime}(1+r^{\prime})}}{(1+q_{M})(1-r^{\prime})^{3/2}}+\frac{1}{\sqrt{1-\frac{\beta_{1}^{2}}{\beta_{2}(1-q_{V})}}}\left[1-\frac{1}{T}\left(\frac{1-q_{V}}{q_{V}}(1-(1-q_{V})^{T})\right)\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.SSS0.Px2.p7.3" class="ltx_p">The first part of <math id="A1.SS2.SSS0.Px2.p7.m3" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> is clearly <math id="A1.SS2.SSS0.Px2.p7.m4" class="ltx_Math" alttext="\mathcal{O}(q_{M})=\mathcal{O}(T^{-1})" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>M</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(q_{M})=\mathcal{O}(T^{-1})</annotation></semantics></math>. The common factor in the second part, <math id="A1.SS2.SSS0.Px2.p7.m5" class="ltx_Math" alttext="\frac{1}{\sqrt{1-\dots}}" display="inline" intent=":literal"><semantics><mfrac><mn>1</mn><msqrt><mrow><mn>1</mn><mo>−</mo><mi mathvariant="normal">…</mi></mrow></msqrt></mfrac><annotation encoding="application/x-tex">\frac{1}{\sqrt{1-\dots}}</annotation></semantics></math>, converges to a constant as <math id="A1.SS2.SSS0.Px2.p7.m6" class="ltx_Math" alttext="T\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">T\to\infty</annotation></semantics></math>, so it is <math id="A1.SS2.SSS0.Px2.p7.m7" class="ltx_Math" alttext="\mathcal{O}(1)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(1)</annotation></semantics></math>. The analysis therefore simplifies to finding the order of the bracketed term.</p>
</div>
<div id="A1.SS2.SSS0.Px2.p8" class="ltx_para">
<p id="A1.SS2.SSS0.Px2.p8.1" class="ltx_p">Let <math id="A1.SS2.SSS0.Px2.p8.m1" class="ltx_Math" alttext="x=q_{V}=\mathcal{O}(T^{-2})" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><msub><mi>q</mi><mi>V</mi></msub><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x=q_{V}=\mathcal{O}(T^{-2})</annotation></semantics></math>. We perform a Taylor expansion on <math id="A1.SS2.SSS0.Px2.p8.m2" class="ltx_Math" alttext="(1-x)^{T}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><annotation encoding="application/x-tex">(1-x)^{T}</annotation></semantics></math>:</p>
<table id="A1.EGx54" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex59"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex59.m1" class="ltx_Math" alttext="\displaystyle(1-x)^{T}=1-Tx+\frac{T(T-1)}{2}x^{2}+\mathcal{O}(T^{3}x^{3})." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mo>=</mo><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>T</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mn>3</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle(1-x)^{T}=1-Tx+\frac{T(T-1)}{2}x^{2}+\mathcal{O}(T^{3}x^{3}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.SSS0.Px2.p8.2" class="ltx_p">This allows us to analyze the term inside the bracket:</p>
<table id="A1.EGx55" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex60"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex60.m1" class="ltx_Math" alttext="\displaystyle 1-\frac{1}{T}\left(\frac{1-x}{x}(1-(1-x)^{T})\right)" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>x</mi></mrow><mi>x</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mi>T</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 1-\frac{1}{T}\left(\frac{1-x}{x}(1-(1-x)^{T})\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex60.m2" class="ltx_Math" alttext="\displaystyle=1-\frac{1}{T}\frac{1-x}{x}\left(Tx-\frac{T(T-1)}{2}x^{2}+\mathcal{O}(T^{3}x^{3})\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>x</mi></mrow><mi>x</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>T</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mn>3</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=1-\frac{1}{T}\frac{1-x}{x}\left(Tx-\frac{T(T-1)}{2}x^{2}+\mathcal{O}(T^{3}x^{3})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex61"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex61.m1" class="ltx_Math" alttext="\displaystyle=1-\frac{1}{T}(1-x)\left(T-\frac{T(T-1)}{2}x+\mathcal{O}(T^{3}x^{2})\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>T</mi><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>T</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=1-\frac{1}{T}(1-x)\left(T-\frac{T(T-1)}{2}x+\mathcal{O}(T^{3}x^{2})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex62"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex62.m1" class="ltx_Math" alttext="\displaystyle=1-\frac{1}{T}\left(T-\frac{T(T-1)}{2}x-Tx+\mathcal{O}(T^{2}x^{2})\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>T</mi><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>−</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>T</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=1-\frac{1}{T}\left(T-\frac{T(T-1)}{2}x-Tx+\mathcal{O}(T^{2}x^{2})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex63.m1" class="ltx_Math" alttext="\displaystyle=1-\left(1-\frac{T(T+1)}{2T}x+\mathcal{O}(T^{2}x^{2})\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><mo>(</mo><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>T</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=1-\left(1-\frac{T(T+1)}{2T}x+\mathcal{O}(T^{2}x^{2})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex64"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex64.m1" class="ltx_Math" alttext="\displaystyle=\frac{T+1}{2}x-\mathcal{O}(T^{2}x^{2})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>T</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{T+1}{2}x-\mathcal{O}(T^{2}x^{2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.SSS0.Px2.p8.3" class="ltx_p">Substituting back <math id="A1.SS2.SSS0.Px2.p8.m3" class="ltx_Math" alttext="x=q_{V}=\mathcal{O}(T^{-2})" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><msub><mi>q</mi><mi>V</mi></msub><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x=q_{V}=\mathcal{O}(T^{-2})</annotation></semantics></math>, the bracketed term has an order of:</p>
<table id="A1.EGx56" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex65.m1" class="ltx_Math" alttext="\displaystyle\mathcal{O}(T\cdot q_{V})=\mathcal{O}(T\cdot T^{-2})=\mathcal{O}(T^{-1})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{O}(T\cdot q_{V})=\mathcal{O}(T\cdot T^{-2})=\mathcal{O}(T^{-1}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.SSS0.Px2.p8.4" class="ltx_p">Therefore, the entire second component of <math id="A1.SS2.SSS0.Px2.p8.m4" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> is <math id="A1.SS2.SSS0.Px2.p8.m5" class="ltx_Math" alttext="\mathcal{O}(1)\cdot\mathcal{O}(T^{-1})=\mathcal{O}(T^{-1})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(1)\cdot\mathcal{O}(T^{-1})=\mathcal{O}(T^{-1})</annotation></semantics></math>.
Combining both components of <math id="A1.SS2.SSS0.Px2.p8.m6" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>, we find its overall order:</p>
<table id="A1.EGx57" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex66"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex66.m1" class="ltx_Math" alttext="\displaystyle Q=\mathcal{O}(T^{-1})+\mathcal{O}(T^{-1})=\mathcal{O}(T^{-1})." display="inline" intent=":literal"><semantics><mrow><mrow><mi>Q</mi><mo>=</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle Q=\mathcal{O}(T^{-1})+\mathcal{O}(T^{-1})=\mathcal{O}(T^{-1}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.SSS0.Px2.p8.5" class="ltx_p">Finally, we compute the order of Term 4 by combining the pre-factor and <math id="A1.SS2.SSS0.Px2.p8.m7" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>:</p>
<table id="A1.EGx58" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex67.m1" class="ltx_math_unparsed" alttext="\displaystyle T_{4}=\Theta(T^{1/2})\cdot\mathcal{O}(T^{-1})=\mathcal{O}(T^{-1/2})." display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>4</mn></msub><mo>=</mo><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle T_{4}=\Theta(T^{1/2})\cdot\mathcal{O}(T^{-1})=\mathcal{O}(T^{-1/2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.SSS0.Px2.p9" class="ltx_para">
<p id="A1.SS2.SSS0.Px2.p9.1" class="ltx_p"><span id="A1.SS2.SSS0.Px2.p9.1.1" class="ltx_text ltx_font_bold">Term 5 (Initial W/G Quantization Error):</span> This term is:</p>
<table id="A1.EGx59" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex68.m1" class="ltx_Math" alttext="\displaystyle T_{5}=\frac{2(1+q_{G})dT}{\tilde{T}\sqrt{\epsilon(1-\beta_{2})}}\left(q_{G}R^{3}+Lq_{W}R^{2}\|\mathrm{vec}(\mathbf{W}_{0})\|_{2}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>5</mn></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mrow><mover accent="true"><mi>T</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>ϵ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>3</mn></msup></mrow><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle T_{5}=\frac{2(1+q_{G})dT}{\tilde{T}\sqrt{\epsilon(1-\beta_{2})}}\left(q_{G}R^{3}+Lq_{W}R^{2}\|\mathrm{vec}(\mathbf{W}_{0})\|_{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.SSS0.Px2.p9.2" class="ltx_p">The leading fraction scales as <math id="A1.SS2.SSS0.Px2.p9.m1" class="ltx_Math" alttext="\frac{T}{\tilde{T}\sqrt{1-\beta_{2}}}=\frac{\Theta(T)}{\Theta(T)\Theta(T^{-1/2})}=\Theta(T^{1/2})" display="inline" intent=":literal"><semantics><mrow><mfrac><mi>T</mi><mrow><mover accent="true"><mi>T</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></msqrt></mrow></mfrac><mo>=</mo><mfrac><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi mathvariant="normal">Θ</mi><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">(</mo><mi>T</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mfrac><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{T}{\tilde{T}\sqrt{1-\beta_{2}}}=\frac{\Theta(T)}{\Theta(T)\Theta(T^{-1/2})}=\Theta(T^{1/2})</annotation></semantics></math>. The parenthesis scales with its dominant term <math id="A1.SS2.SSS0.Px2.p9.m2" class="ltx_Math" alttext="q_{G}=\mathcal{O}(T^{-1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>G</mi></msub><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q_{G}=\mathcal{O}(T^{-1})</annotation></semantics></math>. The total order is:</p>
<table id="A1.EGx60" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex69.m1" class="ltx_math_unparsed" alttext="\displaystyle T_{5}=\Theta(T^{1/2})\cdot\mathcal{O}(q_{G}+q_{W})=\Theta(T^{1/2})\cdot(\mathcal{O}(T^{-1})+\mathcal{O}(T^{-2}))=\mathcal{O}(T^{-1/2})." display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>5</mn></msub><mo>=</mo><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>G</mi></msub><mo>+</mo><msub><mi>q</mi><mi>W</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo>+</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle T_{5}=\Theta(T^{1/2})\cdot\mathcal{O}(q_{G}+q_{W})=\Theta(T^{1/2})\cdot(\mathcal{O}(T^{-1})+\mathcal{O}(T^{-2}))=\mathcal{O}(T^{-1/2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.SSS0.Px2.p10" class="ltx_para">
<p id="A1.SS2.SSS0.Px2.p10.1" class="ltx_p"><span id="A1.SS2.SSS0.Px2.p10.1.1" class="ltx_text ltx_font_bold">Term 6 (Weight Growth Quantization Error):</span> This term is <math id="A1.SS2.SSS0.Px2.p10.m1" class="ltx_Math" alttext="T_{6}=\frac{(1-\beta_{1})d^{\frac{3}{2}}\eta Lq_{W}(1+q_{G})R^{2}T^{2}}{\tilde{T}\sqrt{\epsilon}(1-\beta_{2})\sqrt{1-\frac{\beta_{1}^{2}(1+q_{M})^{2}}{\beta_{2}(1-q_{V})}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>6</mn></msub><mo>=</mo><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mfrac><mn>3</mn><mn>2</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mn>2</mn></msup></mrow><mrow><mover accent="true"><mi>T</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>ϵ</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></msqrt></mrow></mfrac></mrow><annotation encoding="application/x-tex">T_{6}=\frac{(1-\beta_{1})d^{\frac{3}{2}}\eta Lq_{W}(1+q_{G})R^{2}T^{2}}{\tilde{T}\sqrt{\epsilon}(1-\beta_{2})\sqrt{1-\frac{\beta_{1}^{2}(1+q_{M})^{2}}{\beta_{2}(1-q_{V})}}}</annotation></semantics></math>.
First, we analyze <math id="A1.SS2.SSS0.Px2.p10.m2" class="ltx_Math" alttext="\sqrt{\frac{1}{1-\frac{\beta_{1}^{2}(1+q_{M})^{2}}{\beta_{2}(1-q_{V})}}}" display="inline" intent=":literal"><semantics><msqrt><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mfrac></msqrt><annotation encoding="application/x-tex">\sqrt{\frac{1}{1-\frac{\beta_{1}^{2}(1+q_{M})^{2}}{\beta_{2}(1-q_{V})}}}</annotation></semantics></math>. As <math id="A1.SS2.SSS0.Px2.p10.m3" class="ltx_Math" alttext="T\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">T\to\infty</annotation></semantics></math>, the denominator converges to the constant <math id="A1.SS2.SSS0.Px2.p10.m4" class="ltx_Math" alttext="1-\beta_{1}^{2}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">1-\beta_{1}^{2}</annotation></semantics></math>, so its contribution is <math id="A1.SS2.SSS0.Px2.p10.m5" class="ltx_Math" alttext="\mathcal{O}(1)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(1)</annotation></semantics></math>. The term’s order is determined by the scaling of its other components: <math id="A1.SS2.SSS0.Px2.p10.m6" class="ltx_math_unparsed" alttext="\eta=\Theta(T^{-1/2})" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\eta=\Theta(T^{-1/2})</annotation></semantics></math>, <math id="A1.SS2.SSS0.Px2.p10.m7" class="ltx_Math" alttext="q_{W}=\mathcal{O}(T^{-2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>W</mi></msub><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q_{W}=\mathcal{O}(T^{-2})</annotation></semantics></math>, <math id="A1.SS2.SSS0.Px2.p10.m8" class="ltx_Math" alttext="\tilde{T}=\Theta(T)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>T</mi><mo>~</mo></mover><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{T}=\Theta(T)</annotation></semantics></math>, and <math id="A1.SS2.SSS0.Px2.p10.m9" class="ltx_Math" alttext="(1-\beta_{2})=\Theta(T^{-1})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(1-\beta_{2})=\Theta(T^{-1})</annotation></semantics></math>. The total order is:</p>
<table id="A1.EGx61" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex70"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex70.m1" class="ltx_math_unparsed" alttext="\displaystyle T_{6}=\Theta\left(\frac{\eta\cdot q_{W}\cdot T^{2}}{\tilde{T}\cdot(1-\beta_{2})}\right)=\Theta\left(\frac{T^{-1/2}\cdot T^{-2}\cdot T^{2}}{T\cdot T^{-1}}\right)=\Theta(T^{-1/2})." display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>6</mn></msub><mo>=</mo><mi mathvariant="normal">Θ</mi><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>T</mi><mn>2</mn></msup></mrow><mrow><mover accent="true"><mi>T</mi><mo>~</mo></mover><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><mo>=</mo><mi mathvariant="normal">Θ</mi><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>T</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>T</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>T</mi><msup><mrow></mrow><mn>2</mn></msup></mrow><mrow><mi>T</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mfrac></mstyle><mo>)</mo></mrow><mo>=</mo><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle T_{6}=\Theta\left(\frac{\eta\cdot q_{W}\cdot T^{2}}{\tilde{T}\cdot(1-\beta_{2})}\right)=\Theta\left(\frac{T^{-1/2}\cdot T^{-2}\cdot T^{2}}{T\cdot T^{-1}}\right)=\Theta(T^{-1/2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.SS2.SSS0.Px3" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Conclusion.</h4>

<div id="A1.SS2.SSS0.Px3.p1" class="ltx_para">
<p id="A1.SS2.SSS0.Px3.p1.1" class="ltx_p">By comparing the asymptotic orders of all terms, we identify those that converge to zero at the slowest rate, as they will dominate the overall convergence bound. The orders are:</p>
<ul id="A1.I2" class="ltx_itemize ltx_leftmargin_flush">
<li id="A1.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I2.i1.p1" class="ltx_para">
<p id="A1.I2.i1.p1.1" class="ltx_p">Term 1, 4, 5, 6: <math id="A1.I2.i1.p1.m1" class="ltx_math_unparsed" alttext="\mathcal{O}(T^{-1/2})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(T^{-1/2})</annotation></semantics></math> or <math id="A1.I2.i1.p1.m2" class="ltx_math_unparsed" alttext="\Theta(T^{-1/2})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Theta(T^{-1/2})</annotation></semantics></math>.</p>
</div></li>
<li id="A1.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I2.i2.p1" class="ltx_para">
<p id="A1.I2.i2.p1.1" class="ltx_p">Term 2, 3: <math id="A1.I2.i2.p1.m1" class="ltx_math_unparsed" alttext="\Theta(T^{-1/2}\ln T)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mi>ln</mi><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Theta(T^{-1/2}\ln T)</annotation></semantics></math>.</p>
</div></li>
</ul>
<p id="A1.SS2.SSS0.Px3.p1.2" class="ltx_p">The dominant terms are the second and third, which are of order <math id="A1.SS2.SSS0.Px3.p1.m1" class="ltx_math_unparsed" alttext="\Theta(T^{-1/2}\ln T)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mi>ln</mi><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Theta(T^{-1/2}\ln T)</annotation></semantics></math>. These terms form the bottleneck that determines the overall convergence rate. Thus, under the specified parameter schedule, the expected squared gradient norm converges to zero at the following rate:</p>
<table id="A1.EGx62" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex71"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex71.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\|\nabla F(\mathbf{w}_{\tau})\|_{2}^{2}\right]=\Theta\left(\frac{\ln T}{\sqrt{T}}\right)=\tilde{\mathcal{O}}\left(\frac{1}{\sqrt{T}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>τ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><msqrt><mi>T</mi></msqrt></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mi>T</mi></msqrt></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\|\nabla F(\mathbf{w}_{\tau})\|_{2}^{2}\right]=\Theta\left(\frac{\ln T}{\sqrt{T}}\right)=\tilde{\mathcal{O}}\left(\frac{1}{\sqrt{T}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.SSS0.Px3.p1.3" class="ltx_p">This matches the known convergence rate for full-precision Adam.</p>
</div>
<div id="A1.SS2.SSS0.Px3.p2" class="ltx_para">
<p id="A1.SS2.SSS0.Px3.p2.1" class="ltx_p">Furthermore, we derive the convergence rate for the expected gradient norm, <math id="A1.SS2.SSS0.Px3.p2.m1" class="ltx_Math" alttext="\mathbb{E}\left[\|\nabla F(\mathbf{w}_{\tau})\|_{2}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>τ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\|\nabla F(\mathbf{w}_{\tau})\|_{2}\right]</annotation></semantics></math>, from the rate of its squared value. We use Jensen’s inequality, which states that for a convex function <math id="A1.SS2.SSS0.Px3.p2.m2" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> and a random variable <math id="A1.SS2.SSS0.Px3.p2.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>, <math id="A1.SS2.SSS0.Px3.p2.m4" class="ltx_Math" alttext="\phi(\mathbb{E}[X])\leq\mathbb{E}[\phi(X)]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>X</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi(\mathbb{E}[X])\leq\mathbb{E}[\phi(X)]</annotation></semantics></math>.</p>
</div>
<div id="A1.SS2.SSS0.Px3.p3" class="ltx_para">
<p id="A1.SS2.SSS0.Px3.p3.1" class="ltx_p">Let the random variable be <math id="A1.SS2.SSS0.Px3.p3.m1" class="ltx_Math" alttext="X=\|\nabla F(\mathbf{w}_{\tau})\|_{2}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>=</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>τ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">X=\|\nabla F(\mathbf{w}_{\tau})\|_{2}</annotation></semantics></math> and the convex function be <math id="A1.SS2.SSS0.Px3.p3.m2" class="ltx_Math" alttext="\phi(x)=x^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mi>x</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\phi(x)=x^{2}</annotation></semantics></math>. Applying Jensen’s inequality yields:</p>
<table id="A1.EGx63" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex72"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex72.m1" class="ltx_Math" alttext="\displaystyle\left(\mathbb{E}\left[\|\nabla F(\mathbf{w}_{\tau})\|_{2}\right]\right)^{2}\leq\mathbb{E}\left[\|\nabla F(\mathbf{w}_{\tau})\|_{2}^{2}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo>(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>τ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>]</mo></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo>≤</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>τ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left(\mathbb{E}\left[\|\nabla F(\mathbf{w}_{\tau})\|_{2}\right]\right)^{2}\leq\mathbb{E}\left[\|\nabla F(\mathbf{w}_{\tau})\|_{2}^{2}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.SSS0.Px3.p3.2" class="ltx_p">By taking the square root of both sides, we obtain a bound on the expected norm:</p>
<table id="A1.EGx64" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex73"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex73.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\|\nabla F(\mathbf{w}_{\tau})\|_{2}\right]\leq\sqrt{\mathbb{E}\left[\|\nabla F(\mathbf{w}_{\tau})\|_{2}^{2}\right]}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>τ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>]</mo></mrow></mrow><mo>≤</mo><msqrt><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>τ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></msqrt></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\|\nabla F(\mathbf{w}_{\tau})\|_{2}\right]\leq\sqrt{\mathbb{E}\left[\|\nabla F(\mathbf{w}_{\tau})\|_{2}^{2}\right]}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.SSS0.Px3.p3.3" class="ltx_p">Substituting our previously derived convergence rate:</p>
<table id="A1.EGx65" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex74"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex74.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\|\nabla F(\mathbf{w}_{\tau})\|_{2}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>τ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\|\nabla F(\mathbf{w}_{\tau})\|_{2}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex74.m2" class="ltx_Math" alttext="\displaystyle\leq\sqrt{\tilde{\mathcal{O}}\left(\frac{1}{\sqrt{T}}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><msqrt><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mi>T</mi></msqrt></mfrac></mstyle><mo>)</mo></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sqrt{\tilde{\mathcal{O}}\left(\frac{1}{\sqrt{T}}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex75"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex75.m1" class="ltx_Math" alttext="\displaystyle=\tilde{\mathcal{O}}\left(\sqrt{T^{-1/2}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msqrt><mrow><mi>T</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow></msqrt><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\tilde{\mathcal{O}}\left(\sqrt{T^{-1/2}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex76"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex76.m1" class="ltx_math_unparsed" alttext="\displaystyle=\tilde{\mathcal{O}}\left(T^{-1/4}\right)." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>~</mo></mover><mrow><mo>(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\tilde{\mathcal{O}}\left(T^{-1/4}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.SSS0.Px3.p3.4" class="ltx_p">Thus, the expected gradient norm converges to zero at a rate of <math id="A1.SS2.SSS0.Px3.p3.m3" class="ltx_math_unparsed" alttext="\tilde{\mathcal{O}}(T^{-1/4})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{\mathcal{O}}(T^{-1/4})</annotation></semantics></math>. This finalizes the proof of the theorem.</p>
</div>
</section>
</section>
<section id="A1.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.3 </span>Proof of Lemma <a href="#A1.Thmtheorem2" title="Lemma A.2 (The value range of 𝑣_{𝑡,𝑖} and the upper bound of |{1/√{ϵ+𝑣_{𝑡,𝑖}}}-{1/√{ϵ+𝑣^′_{𝑡,𝑖}}}|). ‣ A.3 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2</span></a></h3>

<div id="A1.Thmtheorem2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem2.2" class="ltx_text ltx_font_bold">Lemma A.2</span></span><span id="A1.Thmtheorem2.3" class="ltx_text ltx_font_bold"> </span>(The value range of <math id="A1.Thmtheorem2.m1" class="ltx_Math" alttext="v_{t,i}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">v_{t,i}</annotation></semantics></math> and the upper bound of <math id="A1.Thmtheorem2.m2" class="ltx_Math" alttext="|\frac{1}{\sqrt{\epsilon+v_{t,i}}}-\frac{1}{\sqrt{\epsilon+v^{\prime}_{t,i}}}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mfrac><mn>1</mn><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></msqrt></mfrac><mo>−</mo><mfrac><mn>1</mn><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow></msqrt></mfrac></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\frac{1}{\sqrt{\epsilon+v_{t,i}}}-\frac{1}{\sqrt{\epsilon+v^{\prime}_{t,i}}}|</annotation></semantics></math>)<span id="A1.Thmtheorem2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem2.p1" class="ltx_para">
<p id="A1.Thmtheorem2.p1.1" class="ltx_p"><span id="A1.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A1.Thmtheorem2.p1.m1" class="ltx_Math" alttext="LB_{t,i}=\sum_{k=0}^{t}\beta_{2}^{t-k}(1-q_{V})^{t-k}(\nabla_{i}f_{k}(\mathbf{w}_{k-1})+\delta_{k,i})^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></msubsup><mrow><msubsup><mi>β</mi><mn>2</mn><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><msub><mi>f</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>δ</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">LB_{t,i}=\sum_{k=0}^{t}\beta_{2}^{t-k}(1-q_{V})^{t-k}(\nabla_{i}f_{k}(\mathbf{w}_{k-1})+\delta_{k,i})^{2}</annotation></semantics></math> and <math id="A1.Thmtheorem2.p1.m2" class="ltx_Math" alttext="UB_{t,i}=\sum_{k=0}^{t}\beta_{2}^{t-k}(1+q_{V})^{t-k}(\nabla_{i}f_{k}(\mathbf{w}_{k-1})+\delta_{k,i})^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></msubsup><mrow><msubsup><mi>β</mi><mn>2</mn><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><msub><mi>f</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>δ</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">UB_{t,i}=\sum_{k=0}^{t}\beta_{2}^{t-k}(1+q_{V})^{t-k}(\nabla_{i}f_{k}(\mathbf{w}_{k-1})+\delta_{k,i})^{2}</annotation></semantics></math>. We have:</span></p>
<table id="A1.EGx66" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E44"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E44.m1" class="ltx_Math" alttext="\displaystyle\sum_{k=0}^{t}\beta_{2}^{t-k}(1-q_{V})^{t-k}(\nabla_{i}f_{k}(\mathbf{w}_{k-1})+\delta_{k,i})^{2}\leq v_{t,i}\leq\sum_{k=0}^{t}\beta_{2}^{t-k}(1+q_{V})^{t-k}(\nabla_{i}f_{k}(\mathbf{w}_{k-1})+\delta_{k,i})^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>2</mn><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><msub><mi>f</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>δ</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>≤</mo><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>2</mn><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><msub><mi>f</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>δ</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{k=0}^{t}\beta_{2}^{t-k}(1-q_{V})^{t-k}(\nabla_{i}f_{k}(\mathbf{w}_{k-1})+\delta_{k,i})^{2}\leq v_{t,i}\leq\sum_{k=0}^{t}\beta_{2}^{t-k}(1+q_{V})^{t-k}(\nabla_{i}f_{k}(\mathbf{w}_{k-1})+\delta_{k,i})^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.44)</span></td></tr></tbody>
</table>
<table id="A1.EGx67" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E45.m1" class="ltx_Math" alttext="\displaystyle\left|\frac{1}{\sqrt{\epsilon+v_{t,i}}}-\frac{1}{\sqrt{\epsilon+v^{\prime}_{t,i}}}\right|\leq\max\left\{\frac{1}{\sqrt{\epsilon+LB_{t,i}}}-\frac{1}{\sqrt{\epsilon+v^{\prime}_{t,i}}},\frac{1}{\sqrt{\epsilon+v^{\prime}_{t,i}}}-\frac{1}{\sqrt{\epsilon+UB_{t,i}}}\right\}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></msqrt></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow></msqrt></mfrac></mstyle></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow></msqrt></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow></msqrt></mfrac></mstyle></mrow><mo>,</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow></msqrt></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow></msqrt></mfrac></mstyle></mrow></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left|\frac{1}{\sqrt{\epsilon+v_{t,i}}}-\frac{1}{\sqrt{\epsilon+v^{\prime}_{t,i}}}\right|\leq\max\left\{\frac{1}{\sqrt{\epsilon+LB_{t,i}}}-\frac{1}{\sqrt{\epsilon+v^{\prime}_{t,i}}},\frac{1}{\sqrt{\epsilon+v^{\prime}_{t,i}}}-\frac{1}{\sqrt{\epsilon+UB_{t,i}}}\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.45)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS3.p1" class="ltx_para">
<p id="A1.SS3.p1.1" class="ltx_p"><span id="A1.SS3.p1.1.1" class="ltx_text">The proof consists of two parts.</span></p>
</div>
<div id="A1.SS3.p2" class="ltx_para">
<p id="A1.SS3.p2.1" class="ltx_p"><span id="A1.SS3.p2.1.1" class="ltx_text ltx_font_bold">Part 1: Bounding <math id="A1.SS3.p2.m1" class="ltx_Math" alttext="v_{t,i}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">v_{t,i}</annotation></semantics></math><span id="A1.SS3.p2.1.1.1" class="ltx_text"></span></span></p>
</div>
<div id="A1.SS3.p3" class="ltx_para">
<p id="A1.SS3.p3.1" class="ltx_p"><span id="A1.SS3.p3.1.1" class="ltx_text">The update rule for the second moment estimate is <math id="A1.SS3.p3.m1" class="ltx_Math" alttext="v_{t,i}=\beta_{2}(v_{t-1,i}+\theta_{t-1,i})+(\nabla_{i}f_{t}(\mathbf{w}_{t-1})+\delta_{t,i})^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>=</mo><mrow><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>v</mi><mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>θ</mi><mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><msub><mi>f</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>δ</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">v_{t,i}=\beta_{2}(v_{t-1,i}+\theta_{t-1,i})+(\nabla_{i}f_{t}(\mathbf{w}_{t-1})+\delta_{t,i})^{2}</annotation></semantics></math>. The quantization noise is assumed to be a relative error, bounded by <math id="A1.SS3.p3.m2" class="ltx_Math" alttext="|\theta_{t-1,i}|\leq q_{V}|v_{t-1,i}|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi>θ</mi><mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><msub><mi>q</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>v</mi><mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">|\theta_{t-1,i}|\leq q_{V}|v_{t-1,i}|</annotation></semantics></math>. This implies that <math id="A1.SS3.p3.m3" class="ltx_Math" alttext="(1-q_{V})v_{t-1,i}\leq v_{t-1,i}+\theta_{t-1,i}\leq(1+q_{V})v_{t-1,i}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo>≤</mo><mrow><msub><mi>v</mi><mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>θ</mi><mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">(1-q_{V})v_{t-1,i}\leq v_{t-1,i}+\theta_{t-1,i}\leq(1+q_{V})v_{t-1,i}</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS3.p4" class="ltx_para">
<p id="A1.SS3.p4.1" class="ltx_p"><span id="A1.SS3.p4.1.1" class="ltx_text">Applying this to the update rule, we can establish the lower bound by recursively unrolling the inequality:</span></p>
<table id="A1.EGx68" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex77"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex77.m1" class="ltx_Math" alttext="\displaystyle v_{t,i}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">\displaystyle v_{t,i}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex77.m2" class="ltx_Math" alttext="\displaystyle\geq\beta_{2}(1-q_{V})v_{t-1,i}+(\nabla_{i}f_{t}(\mathbf{w}_{t-1})+\delta_{t,i})^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><msub><mi>f</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>δ</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\beta_{2}(1-q_{V})v_{t-1,i}+(\nabla_{i}f_{t}(\mathbf{w}_{t-1})+\delta_{t,i})^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex78"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex78.m1" class="ltx_Math" alttext="\displaystyle\geq\beta_{2}(1-q_{V})\left[\beta_{2}(1-q_{V})v_{t-2,i}+(\nabla_{i}f_{t-1}(\mathbf{w}_{t-2})+\delta_{t-1,i})^{2}\right]+(\nabla_{i}f_{t}(\mathbf{w}_{t-1})+\delta_{t,i})^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mrow><mrow><mi>t</mi><mo>−</mo><mn>2</mn></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><msub><mi>f</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>δ</mi><mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>]</mo></mrow></mrow><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><msub><mi>f</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>δ</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\beta_{2}(1-q_{V})\left[\beta_{2}(1-q_{V})v_{t-2,i}+(\nabla_{i}f_{t-1}(\mathbf{w}_{t-2})+\delta_{t-1,i})^{2}\right]+(\nabla_{i}f_{t}(\mathbf{w}_{t-1})+\delta_{t,i})^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex79"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex79.m1" class="ltx_Math" alttext="\displaystyle=\dots" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\dots</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E46"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E46.m1" class="ltx_Math" alttext="\displaystyle=\sum_{k=0}^{t}\beta_{2}^{t-k}(1-q_{V})^{t-k}(\nabla_{i}f_{k}(\mathbf{w}_{k-1})+\delta_{k,i})^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>2</mn><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><msub><mi>f</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>δ</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k=0}^{t}\beta_{2}^{t-k}(1-q_{V})^{t-k}(\nabla_{i}f_{k}(\mathbf{w}_{k-1})+\delta_{k,i})^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.46)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p4.2" class="ltx_p"><span id="A1.SS3.p4.2.1" class="ltx_text">Similarly, we can establish the upper bound:</span></p>
<table id="A1.EGx69" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex80"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex80.m1" class="ltx_Math" alttext="\displaystyle v_{t,i}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">\displaystyle v_{t,i}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex80.m2" class="ltx_Math" alttext="\displaystyle\leq\beta_{2}(1+q_{V})v_{t-1,i}+(\nabla_{i}f_{t}(\mathbf{w}_{t-1})+\delta_{t,i})^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><msub><mi>f</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>δ</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\beta_{2}(1+q_{V})v_{t-1,i}+(\nabla_{i}f_{t}(\mathbf{w}_{t-1})+\delta_{t,i})^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E47"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E47.m1" class="ltx_Math" alttext="\displaystyle=\sum_{k=0}^{t}\beta_{2}^{t-k}(1+q_{V})^{t-k}(\nabla_{i}f_{k}(\mathbf{w}_{k-1})+\delta_{k,i})^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>2</mn><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><msub><mi>f</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>δ</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k=0}^{t}\beta_{2}^{t-k}(1+q_{V})^{t-k}(\nabla_{i}f_{k}(\mathbf{w}_{k-1})+\delta_{k,i})^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.47)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p4.3" class="ltx_p"><span id="A1.SS3.p4.3.1" class="ltx_text">This completes the proof of the first statement in the lemma.</span></p>
</div>
<div id="A1.SS3.p5" class="ltx_para">
<p id="A1.SS3.p5.1" class="ltx_p"><span id="A1.SS3.p5.1.1" class="ltx_text ltx_font_bold">Part 2: Bounding the difference of the inverse square roots<span id="A1.SS3.p5.1.1.1" class="ltx_text"></span></span></p>
</div>
<div id="A1.SS3.p6" class="ltx_para">
<p id="A1.SS3.p6.1" class="ltx_p"><span id="A1.SS3.p6.1.1" class="ltx_text">Let <math id="A1.SS3.p6.m1" class="ltx_Math" alttext="v^{\prime}_{t,i}" display="inline" intent=":literal"><semantics><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">v^{\prime}_{t,i}</annotation></semantics></math> be the idealized second moment estimate, updated without the quantization noise <math id="A1.SS3.p6.m2" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>. Its explicit form is:</span></p>
<table id="A1.EGx70" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E48"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E48.m1" class="ltx_Math" alttext="\displaystyle v^{\prime}_{t,i}=\sum_{k=0}^{t}\beta_{2}^{t-k}(\nabla_{i}f_{k}(\mathbf{w}_{k-1})+\delta_{k,i})^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>2</mn><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><msub><mi>f</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>δ</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle v^{\prime}_{t,i}=\sum_{k=0}^{t}\beta_{2}^{t-k}(\nabla_{i}f_{k}(\mathbf{w}_{k-1})+\delta_{k,i})^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.48)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p6.2" class="ltx_p"><span id="A1.SS3.p6.2.1" class="ltx_text">From Part 1, we know that <math id="A1.SS3.p6.m3" class="ltx_Math" alttext="v_{t,i}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">v_{t,i}</annotation></semantics></math> is in the interval <math id="A1.SS3.p6.m4" class="ltx_Math" alttext="[LB_{t,i},UB_{t,i}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo>,</mo><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[LB_{t,i},UB_{t,i}]</annotation></semantics></math>, where <math id="A1.SS3.p6.m5" class="ltx_Math" alttext="LB_{t,i}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><annotation encoding="application/x-tex">LB_{t,i}</annotation></semantics></math> and <math id="A1.SS3.p6.m6" class="ltx_Math" alttext="UB_{t,i}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><annotation encoding="application/x-tex">UB_{t,i}</annotation></semantics></math> are the bounds established.</span></p>
</div>
<div id="A1.SS3.p7" class="ltx_para">
<p id="A1.SS3.p7.1" class="ltx_p"><span id="A1.SS3.p7.1.1" class="ltx_text">Now, we compare <math id="A1.SS3.p7.m1" class="ltx_Math" alttext="v^{\prime}_{t,i}" display="inline" intent=":literal"><semantics><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">v^{\prime}_{t,i}</annotation></semantics></math> with these bounds. Since <math id="A1.SS3.p7.m2" class="ltx_Math" alttext="0&lt;\beta_{2}&lt;1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><msub><mi>β</mi><mn>2</mn></msub><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0&lt;\beta_{2}&lt;1</annotation></semantics></math> and we assume <math id="A1.SS3.p7.m3" class="ltx_Math" alttext="0&lt;q_{V}&lt;1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><msub><mi>q</mi><mi>V</mi></msub><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0&lt;q_{V}&lt;1</annotation></semantics></math>, we have <math id="A1.SS3.p7.m4" class="ltx_Math" alttext="\beta_{2}(1-q_{V})&lt;\beta_{2}&lt;\beta_{2}(1+q_{V})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><msub><mi>β</mi><mn>2</mn></msub><mo>&lt;</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta_{2}(1-q_{V})&lt;\beta_{2}&lt;\beta_{2}(1+q_{V})</annotation></semantics></math>. This implies a term-by-term inequality, leading to:</span></p>
<table id="A1.EGx71" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E49.m1" class="ltx_Math" alttext="\displaystyle LB_{t,i}&lt;v^{\prime}_{t,i}&lt;UB_{t,i}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo>&lt;</mo><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup><mo>&lt;</mo><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle LB_{t,i}&lt;v^{\prime}_{t,i}&lt;UB_{t,i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.49)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p7.2" class="ltx_p"><span id="A1.SS3.p7.2.1" class="ltx_text">Consider the function <math id="A1.SS3.p7.m5" class="ltx_Math" alttext="f(y)=1/\sqrt{\epsilon+y}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>/</mo><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mi>y</mi></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">f(y)=1/\sqrt{\epsilon+y}</annotation></semantics></math> for <math id="A1.SS3.p7.m6" class="ltx_Math" alttext="y\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">y\geq 0</annotation></semantics></math>. This function is monotonically decreasing and convex. The value <math id="A1.SS3.p7.m7" class="ltx_Math" alttext="v_{t,i}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">v_{t,i}</annotation></semantics></math> lies in the interval <math id="A1.SS3.p7.m8" class="ltx_Math" alttext="[LB_{t,i},UB_{t,i}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo>,</mo><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[LB_{t,i},UB_{t,i}]</annotation></semantics></math>, and <math id="A1.SS3.p7.m9" class="ltx_Math" alttext="v^{\prime}_{t,i}" display="inline" intent=":literal"><semantics><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">v^{\prime}_{t,i}</annotation></semantics></math> is a point within this interval. The maximum absolute difference <math id="A1.SS3.p7.m10" class="ltx_Math" alttext="|f(v_{t,i})-f(v^{\prime}_{t,i})|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|f(v_{t,i})-f(v^{\prime}_{t,i})|</annotation></semantics></math> must occur when <math id="A1.SS3.p7.m11" class="ltx_Math" alttext="v_{t,i}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">v_{t,i}</annotation></semantics></math> is at one of the endpoints of the interval. Therefore, we can bound the difference as:</span></p>
<table id="A1.EGx72" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E50.m1" class="ltx_Math" alttext="\displaystyle\left|\frac{1}{\sqrt{\epsilon+v_{t,i}}}-\frac{1}{\sqrt{\epsilon+v^{\prime}_{t,i}}}\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></msqrt></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow></msqrt></mfrac></mstyle></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\frac{1}{\sqrt{\epsilon+v_{t,i}}}-\frac{1}{\sqrt{\epsilon+v^{\prime}_{t,i}}}\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E50.m2" class="ltx_Math" alttext="\displaystyle\leq\max\left\{\left|\frac{1}{\sqrt{\epsilon+LB_{t,i}}}-\frac{1}{\sqrt{\epsilon+v^{\prime}_{t,i}}}\right|,\left|\frac{1}{\sqrt{\epsilon+UB_{t,i}}}-\frac{1}{\sqrt{\epsilon+v^{\prime}_{t,i}}}\right|\right\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow></msqrt></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow></msqrt></mfrac></mstyle></mrow><mo>|</mo></mrow><mo>,</mo><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow></msqrt></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow></msqrt></mfrac></mstyle></mrow><mo>|</mo></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\max\left\{\left|\frac{1}{\sqrt{\epsilon+LB_{t,i}}}-\frac{1}{\sqrt{\epsilon+v^{\prime}_{t,i}}}\right|,\left|\frac{1}{\sqrt{\epsilon+UB_{t,i}}}-\frac{1}{\sqrt{\epsilon+v^{\prime}_{t,i}}}\right|\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.50)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p7.3" class="ltx_p"><span id="A1.SS3.p7.3.1" class="ltx_text">Since <math id="A1.SS3.p7.m12" class="ltx_Math" alttext="LB_{t,i}&lt;v^{\prime}_{t,i}&lt;UB_{t,i}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo>&lt;</mo><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup><mo>&lt;</mo><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">LB_{t,i}&lt;v^{\prime}_{t,i}&lt;UB_{t,i}</annotation></semantics></math> and the function is decreasing, we have <math id="A1.SS3.p7.m13" class="ltx_Math" alttext="1/\sqrt{\epsilon+UB_{t,i}}&lt;1/\sqrt{\epsilon+v^{\prime}_{t,i}}&lt;1/\sqrt{\epsilon+LB_{t,i}}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>/</mo><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow></msqrt></mrow><mo>&lt;</mo><mrow><mn>1</mn><mo>/</mo><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow></msqrt></mrow><mo>&lt;</mo><mrow><mn>1</mn><mo>/</mo><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">1/\sqrt{\epsilon+UB_{t,i}}&lt;1/\sqrt{\epsilon+v^{\prime}_{t,i}}&lt;1/\sqrt{\epsilon+LB_{t,i}}</annotation></semantics></math>. We can therefore remove the absolute value signs:</span></p>
<table id="A1.EGx73" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E51.m1" class="ltx_Math" alttext="\displaystyle\left|\frac{1}{\sqrt{\epsilon+v_{t,i}}}-\frac{1}{\sqrt{\epsilon+v^{\prime}_{t,i}}}\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></msqrt></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow></msqrt></mfrac></mstyle></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\frac{1}{\sqrt{\epsilon+v_{t,i}}}-\frac{1}{\sqrt{\epsilon+v^{\prime}_{t,i}}}\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E51.m2" class="ltx_Math" alttext="\displaystyle\leq\max\left\{\frac{1}{\sqrt{\epsilon+LB_{t,i}}}-\frac{1}{\sqrt{\epsilon+v^{\prime}_{t,i}}},\frac{1}{\sqrt{\epsilon+v^{\prime}_{t,i}}}-\frac{1}{\sqrt{\epsilon+UB_{t,i}}}\right\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow></msqrt></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow></msqrt></mfrac></mstyle></mrow><mo>,</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow></msqrt></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow></msqrt></mfrac></mstyle></mrow></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\max\left\{\frac{1}{\sqrt{\epsilon+LB_{t,i}}}-\frac{1}{\sqrt{\epsilon+v^{\prime}_{t,i}}},\frac{1}{\sqrt{\epsilon+v^{\prime}_{t,i}}}-\frac{1}{\sqrt{\epsilon+UB_{t,i}}}\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.51)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p7.4" class="ltx_p"><span id="A1.SS3.p7.4.1" class="ltx_text">This completes the proof of the second statement.
∎</span></p>
</div>
</div>
</section>
<section id="A1.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.4 </span>Proof of Lemma <a href="#A1.Thmtheorem3" title="Lemma A.3 (Bound on Discrete Error). ‣ A.4 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.3</span></a></h3>

<div id="A1.Thmtheorem3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem3.2" class="ltx_text ltx_font_bold">Lemma A.3</span></span><span id="A1.Thmtheorem3.3" class="ltx_text ltx_font_bold"> </span>(Bound on Discrete Error)<span id="A1.Thmtheorem3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem3.p1" class="ltx_para">
<p id="A1.Thmtheorem3.p1.1" class="ltx_p"><span id="A1.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Given two discrete-time systems defined for <math id="A1.Thmtheorem3.p1.m1" class="ltx_Math" alttext="t\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t\geq 1</annotation></semantics></math>:</span></p>
<ul id="A1.I3" class="ltx_itemize">
<li id="A1.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I3.i1.p1" class="ltx_para">
<p id="A1.I3.i1.p1.1" class="ltx_p"><span id="A1.I3.i1.p1.1.1" class="ltx_text ltx_font_italic">System A: </span><math id="A1.I3.i1.p1.m1" class="ltx_Math" alttext="a_{t}=k(a_{t-1}+c_{t-1})+d_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>t</mi></msub><mo>=</mo><mrow><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>a</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>+</mo><msub><mi>c</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>d</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">a_{t}=k(a_{t-1}+c_{t-1})+d_{t}</annotation></semantics></math></p>
</div></li>
<li id="A1.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I3.i2.p1" class="ltx_para">
<p id="A1.I3.i2.p1.1" class="ltx_p"><span id="A1.I3.i2.p1.1.1" class="ltx_text ltx_font_italic">System B: </span><math id="A1.I3.i2.p1.m1" class="ltx_Math" alttext="b_{t}=kb_{t-1}+d_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mi>t</mi></msub><mo>=</mo><mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><msub><mi>d</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">b_{t}=kb_{t-1}+d_{t}</annotation></semantics></math></p>
</div></li>
</ul>
<p id="A1.Thmtheorem3.p1.2" class="ltx_p"><span id="A1.Thmtheorem3.p1.2.1" class="ltx_text ltx_font_italic">where the perturbation term <math id="A1.Thmtheorem3.p1.m2" class="ltx_Math" alttext="c_{t}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mi>t</mi></msub><annotation encoding="application/x-tex">c_{t}</annotation></semantics></math> is bounded by <math id="A1.Thmtheorem3.p1.m3" class="ltx_Math" alttext="|c_{t}|\leq q|a_{t}|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi>c</mi><mi>t</mi></msub><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mi>t</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">|c_{t}|\leq q|a_{t}|</annotation></semantics></math> for all <math id="A1.Thmtheorem3.p1.m4" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, and the constants <math id="A1.Thmtheorem3.p1.m5" class="ltx_Math" alttext="k,q" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>,</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">k,q</annotation></semantics></math> satisfy <math id="A1.Thmtheorem3.p1.m6" class="ltx_Math" alttext="0&lt;k&lt;1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>k</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0&lt;k&lt;1</annotation></semantics></math> and <math id="A1.Thmtheorem3.p1.m7" class="ltx_Math" alttext="q&lt;k" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>&lt;</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">q&lt;k</annotation></semantics></math>.</span></p>
</div>
<div id="A1.Thmtheorem3.p2" class="ltx_para">
<p id="A1.Thmtheorem3.p2.1" class="ltx_p"><span id="A1.Thmtheorem3.p2.1.1" class="ltx_text ltx_font_italic">Under zero initial conditions, where <math id="A1.Thmtheorem3.p2.m1" class="ltx_Math" alttext="a_{0}=b_{0}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mn>0</mn></msub><mo>=</mo><msub><mi>b</mi><mn>0</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a_{0}=b_{0}=0</annotation></semantics></math>, the absolute error between the states of the two systems is bounded by:</span></p>
<table id="A1.EGx74" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E52"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E52.m1" class="ltx_Math" alttext="\displaystyle|a_{t}-b_{t}|\leq\sum_{j=1}^{t-1}\left[(k(1+q))^{t-j}-k^{t-j}\right]|d_{j}|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>a</mi><mi>t</mi></msub><mo>−</mo><msub><mi>b</mi><mi>t</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mo>[</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mi>j</mi></mrow></msup><mo>−</mo><msup><mi>k</mi><mrow><mi>t</mi><mo>−</mo><mi>j</mi></mrow></msup></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>d</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle|a_{t}-b_{t}|\leq\sum_{j=1}^{t-1}\left[(k(1+q))^{t-j}-k^{t-j}\right]|d_{j}|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.52)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.SS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS4.p1" class="ltx_para">
<p id="A1.SS4.p1.1" class="ltx_p"><span id="A1.SS4.p1.1.1" class="ltx_text">First, define the error as <math id="A1.SS4.p1.m1" class="ltx_Math" alttext="e_{t}=a_{t}-b_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mi>t</mi></msub><mo>=</mo><mrow><msub><mi>a</mi><mi>t</mi></msub><mo>−</mo><msub><mi>b</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">e_{t}=a_{t}-b_{t}</annotation></semantics></math>. Subtracting the two system equations yields the error recurrence relation:</span></p>
<table id="A1.EGx75" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E53.m1" class="ltx_Math" alttext="\displaystyle e_{t}=ke_{t-1}+kc_{t-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mi>t</mi></msub><mo>=</mo><mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle e_{t}=ke_{t-1}+kc_{t-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.53)</span></td></tr></tbody>
</table>
<p id="A1.SS4.p1.2" class="ltx_p"><span id="A1.SS4.p1.2.1" class="ltx_text">The explicit solution to this recurrence is <math id="A1.SS4.p1.m2" class="ltx_Math" alttext="e_{t}=k^{t}e_{0}+\sum_{j=0}^{t-1}k^{t-j}c_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mi>t</mi></msub><mo>=</mo><mrow><mrow><msup><mi>k</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>0</mn></msub></mrow><mo rspace="0.055em">+</mo><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><msup><mi>k</mi><mrow><mi>t</mi><mo>−</mo><mi>j</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi>j</mi></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">e_{t}=k^{t}e_{0}+\sum_{j=0}^{t-1}k^{t-j}c_{j}</annotation></semantics></math>. Under the zero initial condition <math id="A1.SS4.p1.m3" class="ltx_Math" alttext="a_{0}=b_{0}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mn>0</mn></msub><mo>=</mo><msub><mi>b</mi><mn>0</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a_{0}=b_{0}=0</annotation></semantics></math>, this simplifies to:</span></p>
<table id="A1.EGx76" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E54.m1" class="ltx_Math" alttext="\displaystyle e_{t}=\sum_{j=0}^{t-1}k^{t-j}c_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mi>t</mi></msub><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>k</mi><mrow><mi>t</mi><mo>−</mo><mi>j</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi>j</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle e_{t}=\sum_{j=0}^{t-1}k^{t-j}c_{j}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.54)</span></td></tr></tbody>
</table>
<p id="A1.SS4.p1.3" class="ltx_p"><span id="A1.SS4.p1.3.1" class="ltx_text">Taking the absolute value and applying the given condition <math id="A1.SS4.p1.m4" class="ltx_Math" alttext="|c_{j}|\leq q|a_{j}|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi>c</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">|c_{j}|\leq q|a_{j}|</annotation></semantics></math>, we have:</span></p>
<table id="A1.EGx77" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E55"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E55.m1" class="ltx_Math" alttext="\displaystyle|e_{t}|\leq\sum_{j=0}^{t-1}k^{t-j}|c_{j}|\leq q\sum_{j=0}^{t-1}k^{t-j}|a_{j}|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi>e</mi><mi>t</mi></msub><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>k</mi><mrow><mi>t</mi><mo>−</mo><mi>j</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>c</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>k</mi><mrow><mi>t</mi><mo>−</mo><mi>j</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle|e_{t}|\leq\sum_{j=0}^{t-1}k^{t-j}|c_{j}|\leq q\sum_{j=0}^{t-1}k^{t-j}|a_{j}|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.55)</span></td></tr></tbody>
</table>
<p id="A1.SS4.p1.4" class="ltx_p"><span id="A1.SS4.p1.4.1" class="ltx_text">Since <math id="A1.SS4.p1.m5" class="ltx_Math" alttext="a_{0}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mn>0</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a_{0}=0</annotation></semantics></math>, the sum starts from <math id="A1.SS4.p1.m6" class="ltx_Math" alttext="j=1" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">j=1</annotation></semantics></math>. The state <math id="A1.SS4.p1.m7" class="ltx_Math" alttext="|a_{j}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|a_{j}|</annotation></semantics></math> can be bounded from its own recurrence <math id="A1.SS4.p1.m8" class="ltx_Math" alttext="|a_{t}|\leq k(1+q)|a_{t-1}|+|d_{t}|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mi>t</mi></msub><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mrow><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mo stretchy="false">|</mo><msub><mi>d</mi><mi>t</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">|a_{t}|\leq k(1+q)|a_{t-1}|+|d_{t}|</annotation></semantics></math>, which for <math id="A1.SS4.p1.m9" class="ltx_Math" alttext="a_{0}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mn>0</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a_{0}=0</annotation></semantics></math> unrolls to:</span></p>
<table id="A1.EGx78" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E56"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E56.m1" class="ltx_Math" alttext="\displaystyle|a_{j}|\leq\sum_{i=1}^{j}(k(1+q))^{j-i}|d_{i}|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>j</mi></munderover></mstyle><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>d</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle|a_{j}|\leq\sum_{i=1}^{j}(k(1+q))^{j-i}|d_{i}|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.56)</span></td></tr></tbody>
</table>
<p id="A1.SS4.p1.5" class="ltx_p"><span id="A1.SS4.p1.5.1" class="ltx_text">Substituting the bound for <math id="A1.SS4.p1.m10" class="ltx_Math" alttext="|a_{j}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|a_{j}|</annotation></semantics></math> into the inequality for <math id="A1.SS4.p1.m11" class="ltx_Math" alttext="|e_{t}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><msub><mi>e</mi><mi>t</mi></msub><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|e_{t}|</annotation></semantics></math> gives a double summation:</span></p>
<table id="A1.EGx79" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E57"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E57.m1" class="ltx_Math" alttext="\displaystyle|e_{t}|\leq q\sum_{j=1}^{t-1}k^{t-j}\left(\sum_{i=1}^{j}(k(1+q))^{j-i}|d_{i}|\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi>e</mi><mi>t</mi></msub><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>k</mi><mrow><mi>t</mi><mo>−</mo><mi>j</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>j</mi></munderover></mstyle><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>d</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle|e_{t}|\leq q\sum_{j=1}^{t-1}k^{t-j}\left(\sum_{i=1}^{j}(k(1+q))^{j-i}|d_{i}|\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.57)</span></td></tr></tbody>
</table>
<p id="A1.SS4.p1.6" class="ltx_p"><span id="A1.SS4.p1.6.1" class="ltx_text">By swapping the order of summation and evaluating the inner geometric series, we obtain the final result:</span></p>
<table id="A1.EGx80" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E58"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E58.m1" class="ltx_Math" alttext="\displaystyle|a_{t}-b_{t}|\leq\sum_{j=1}^{t-1}\left[(k(1+q))^{t-j}-k^{t-j}\right]|d_{j}|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>a</mi><mi>t</mi></msub><mo>−</mo><msub><mi>b</mi><mi>t</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mo>[</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mi>j</mi></mrow></msup><mo>−</mo><msup><mi>k</mi><mrow><mi>t</mi><mo>−</mo><mi>j</mi></mrow></msup></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>d</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle|a_{t}-b_{t}|\leq\sum_{j=1}^{t-1}\left[(k(1+q))^{t-j}-k^{t-j}\right]|d_{j}|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.58)</span></td></tr></tbody>
</table>
<p id="A1.SS4.p1.7" class="ltx_p"><span id="A1.SS4.p1.7.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A1.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.5 </span>Proof of Lemma <a href="#A1.Thmtheorem4" title="Lemma A.4 (Finite Geometric Series Ratio Bounded by Infinite Sum). ‣ A.5 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.4</span></a></h3>

<div id="A1.Thmtheorem4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem4.2" class="ltx_text ltx_font_bold">Lemma A.4</span></span><span id="A1.Thmtheorem4.3" class="ltx_text ltx_font_bold"> </span>(Finite Geometric Series Ratio Bounded by Infinite Sum)<span id="A1.Thmtheorem4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem4.p1" class="ltx_para">
<p id="A1.Thmtheorem4.p1.1" class="ltx_p"><span id="A1.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A1.Thmtheorem4.p1.m1" class="ltx_Math" alttext="(g_{k})_{k=0}^{t}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></msubsup><annotation encoding="application/x-tex">(g_{k})_{k=0}^{t}</annotation></semantics></math> be a sequence of scalars for any finite <math id="A1.Thmtheorem4.p1.m2" class="ltx_Math" alttext="t\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">t\in\mathbb{N}</annotation></semantics></math>. Let the weights be terms of two geometric series, <math id="A1.Thmtheorem4.p1.m3" class="ltx_Math" alttext="A_{k}=a^{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>k</mi></msub><mo>=</mo><msup><mi>a</mi><mi>k</mi></msup></mrow><annotation encoding="application/x-tex">A_{k}=a^{k}</annotation></semantics></math> and <math id="A1.Thmtheorem4.p1.m4" class="ltx_Math" alttext="B_{k}=b^{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>k</mi></msub><mo>=</mo><msup><mi>b</mi><mi>k</mi></msup></mrow><annotation encoding="application/x-tex">B_{k}=b^{k}</annotation></semantics></math>, where <math id="A1.Thmtheorem4.p1.m5" class="ltx_Math" alttext="a,b\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">a,b\in(0,1)</annotation></semantics></math> are the base ratios.</span></p>
</div>
<div id="A1.Thmtheorem4.p2" class="ltx_para">
<p id="A1.Thmtheorem4.p2.1" class="ltx_p"><span id="A1.Thmtheorem4.p2.1.1" class="ltx_text ltx_font_italic">If the condition <math id="A1.Thmtheorem4.p2.m1" class="ltx_Math" alttext="a^{2}&lt;b" display="inline" intent=":literal"><semantics><mrow><msup><mi>a</mi><mn>2</mn></msup><mo>&lt;</mo><mi>b</mi></mrow><annotation encoding="application/x-tex">a^{2}&lt;b</annotation></semantics></math> holds, then the ratio of the weighted sum is bounded by a constant derived from the corresponding infinite series:</span></p>
<table id="A1.EGx81" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E59"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E59.m1" class="ltx_Math" alttext="\displaystyle\frac{\sum_{k=0}^{t}a^{k}|g_{k}|}{\sqrt{\sum_{k=0}^{t}b^{k}g_{k}^{2}}}\leq\sqrt{\frac{1}{1-a^{2}/b}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></msubsup><mrow><msup><mi>a</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow><msqrt><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></msubsup><mrow><msup><mi>b</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>g</mi><mi>k</mi><mn>2</mn></msubsup></mrow></mrow></msqrt></mfrac></mstyle><mo>≤</mo><msqrt><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mrow><msup><mi>a</mi><mn>2</mn></msup><mo>/</mo><mi>b</mi></mrow></mrow></mfrac></mstyle></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\sum_{k=0}^{t}a^{k}|g_{k}|}{\sqrt{\sum_{k=0}^{t}b^{k}g_{k}^{2}}}\leq\sqrt{\frac{1}{1-a^{2}/b}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.59)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.SS5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS5.p1" class="ltx_para">
<p id="A1.SS5.p1.1" class="ltx_p"><span id="A1.SS5.p1.1.1" class="ltx_text">Let the numerator be <math id="A1.SS5.p1.m1" class="ltx_Math" alttext="N_{t}=\sum_{k=0}^{t}a^{k}|g_{k}|" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mi>t</mi></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></msubsup><mrow><msup><mi>a</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">N_{t}=\sum_{k=0}^{t}a^{k}|g_{k}|</annotation></semantics></math> and the denominator be <math id="A1.SS5.p1.m2" class="ltx_Math" alttext="D_{t}=\sqrt{\sum_{k=0}^{t}b^{k}g_{k}^{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>t</mi></msub><mo>=</mo><msqrt><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></msubsup><mrow><msup><mi>b</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>g</mi><mi>k</mi><mn>2</mn></msubsup></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">D_{t}=\sqrt{\sum_{k=0}^{t}b^{k}g_{k}^{2}}</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS5.p2" class="ltx_para">
<p id="A1.SS5.p2.1" class="ltx_p"><span id="A1.SS5.p2.1.1" class="ltx_text">We rewrite the numerator as:</span></p>
<table id="A1.EGx82" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E60"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E60.m1" class="ltx_Math" alttext="\displaystyle N_{t}=\sum_{k=0}^{t}\left(\frac{a^{k}}{\sqrt{b^{k}}}\right)\cdot\left(\sqrt{b^{k}}|g_{k}|\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mi>t</mi></msub><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>a</mi><mi>k</mi></msup><msqrt><msup><mi>b</mi><mi>k</mi></msup></msqrt></mfrac></mstyle><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><msqrt><msup><mi>b</mi><mi>k</mi></msup></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">|</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle N_{t}=\sum_{k=0}^{t}\left(\frac{a^{k}}{\sqrt{b^{k}}}\right)\cdot\left(\sqrt{b^{k}}|g_{k}|\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.60)</span></td></tr></tbody>
</table>
<p id="A1.SS5.p2.2" class="ltx_p"><span id="A1.SS5.p2.2.1" class="ltx_text">Applying the Cauchy-Schwarz inequality to these finite sums, we get:</span></p>
<table id="A1.EGx83" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex81.m1" class="ltx_Math" alttext="\displaystyle N_{t}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>N</mi><mi>t</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">\displaystyle N_{t}^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex81.m2" class="ltx_Math" alttext="\displaystyle\leq\left(\sum_{k=0}^{t}\left(\frac{a^{k}}{\sqrt{b^{k}}}\right)^{2}\right)\cdot\left(\sum_{k=0}^{t}\left(\sqrt{b^{k}}|g_{k}|\right)^{2}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>a</mi><mi>k</mi></msup><msqrt><msup><mi>b</mi><mi>k</mi></msup></msqrt></mfrac></mstyle><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><msup><mrow><mo>(</mo><mrow><msqrt><msup><mi>b</mi><mi>k</mi></msup></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">|</mo></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\sum_{k=0}^{t}\left(\frac{a^{k}}{\sqrt{b^{k}}}\right)^{2}\right)\cdot\left(\sum_{k=0}^{t}\left(\sqrt{b^{k}}|g_{k}|\right)^{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex82"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex82.m1" class="ltx_Math" alttext="\displaystyle=\left(\sum_{k=0}^{t}\frac{a^{2k}}{b^{k}}\right)\cdot\left(\sum_{k=0}^{t}b^{k}g_{k}^{2}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><msup><mi>a</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><msup><mi>b</mi><mi>k</mi></msup></mfrac></mstyle></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>b</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>g</mi><mi>k</mi><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\sum_{k=0}^{t}\frac{a^{2k}}{b^{k}}\right)\cdot\left(\sum_{k=0}^{t}b^{k}g_{k}^{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E61"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E61.m1" class="ltx_Math" alttext="\displaystyle=\left(\sum_{k=0}^{t}\left(\frac{a^{2}}{b}\right)^{k}\right)\cdot D_{t}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>a</mi><mn>2</mn></msup><mi>b</mi></mfrac></mstyle><mo>)</mo></mrow><mi>k</mi></msup></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>D</mi><mi>t</mi><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\sum_{k=0}^{t}\left(\frac{a^{2}}{b}\right)^{k}\right)\cdot D_{t}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.61)</span></td></tr></tbody>
</table>
<p id="A1.SS5.p2.3" class="ltx_p"><span id="A1.SS5.p2.3.1" class="ltx_text">The first term is a finite geometric series. Since the condition <math id="A1.SS5.p2.m1" class="ltx_Math" alttext="a^{2}&lt;b" display="inline" intent=":literal"><semantics><mrow><msup><mi>a</mi><mn>2</mn></msup><mo>&lt;</mo><mi>b</mi></mrow><annotation encoding="application/x-tex">a^{2}&lt;b</annotation></semantics></math> implies that the ratio <math id="A1.SS5.p2.m2" class="ltx_Math" alttext="r=a^{2}/b" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mrow><msup><mi>a</mi><mn>2</mn></msup><mo>/</mo><mi>b</mi></mrow></mrow><annotation encoding="application/x-tex">r=a^{2}/b</annotation></semantics></math> is positive and less than 1, all terms in the series are positive. Therefore, the finite sum is always less than or equal to the sum of the infinite series:</span></p>
<table id="A1.EGx84" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E62"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E62.m1" class="ltx_Math" alttext="\displaystyle\sum_{k=0}^{t}\left(\frac{a^{2}}{b}\right)^{k}\leq\sum_{k=0}^{\infty}\left(\frac{a^{2}}{b}\right)^{k}=\frac{1}{1-a^{2}/b}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>a</mi><mn>2</mn></msup><mi>b</mi></mfrac></mstyle><mo>)</mo></mrow><mi>k</mi></msup></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>a</mi><mn>2</mn></msup><mi>b</mi></mfrac></mstyle><mo>)</mo></mrow><mi>k</mi></msup></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mrow><msup><mi>a</mi><mn>2</mn></msup><mo>/</mo><mi>b</mi></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{k=0}^{t}\left(\frac{a^{2}}{b}\right)^{k}\leq\sum_{k=0}^{\infty}\left(\frac{a^{2}}{b}\right)^{k}=\frac{1}{1-a^{2}/b}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.62)</span></td></tr></tbody>
</table>
<p id="A1.SS5.p2.4" class="ltx_p"><span id="A1.SS5.p2.4.1" class="ltx_text">Substituting this upper bound back into the inequality for <math id="A1.SS5.p2.m3" class="ltx_Math" alttext="N_{t}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>N</mi><mi>t</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">N_{t}^{2}</annotation></semantics></math>, we have:</span></p>
<table id="A1.EGx85" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E63.m1" class="ltx_Math" alttext="\displaystyle N_{t}^{2}\leq\left(\frac{1}{1-a^{2}/b}\right)\cdot D_{t}^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>N</mi><mi>t</mi><mn>2</mn></msubsup><mo>≤</mo><mrow><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mrow><msup><mi>a</mi><mn>2</mn></msup><mo>/</mo><mi>b</mi></mrow></mrow></mfrac></mstyle><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>D</mi><mi>t</mi><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle N_{t}^{2}\leq\left(\frac{1}{1-a^{2}/b}\right)\cdot D_{t}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.63)</span></td></tr></tbody>
</table>
<p id="A1.SS5.p2.5" class="ltx_p"><span id="A1.SS5.p2.5.1" class="ltx_text">Taking the square root of both sides gives:</span></p>
<table id="A1.EGx86" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E64"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E64.m1" class="ltx_Math" alttext="\displaystyle N_{t}\leq\sqrt{\frac{1}{1-a^{2}/b}}\cdot D_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mi>t</mi></msub><mo>≤</mo><mrow><msqrt><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mrow><msup><mi>a</mi><mn>2</mn></msup><mo>/</mo><mi>b</mi></mrow></mrow></mfrac></mstyle></msqrt><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>D</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle N_{t}\leq\sqrt{\frac{1}{1-a^{2}/b}}\cdot D_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.64)</span></td></tr></tbody>
</table>
<p id="A1.SS5.p2.6" class="ltx_p"><span id="A1.SS5.p2.6.1" class="ltx_text">Finally, dividing by <math id="A1.SS5.p2.m4" class="ltx_Math" alttext="D_{t}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>t</mi></msub><annotation encoding="application/x-tex">D_{t}</annotation></semantics></math> yields the desired result for any finite <math id="A1.SS5.p2.m5" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>:</span></p>
<table id="A1.EGx87" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E65.m1" class="ltx_Math" alttext="\displaystyle\frac{N_{t}}{D_{t}}=\frac{\sum_{k=0}^{t}a^{k}|g_{k}|}{\sqrt{\sum_{k=0}^{t}b^{k}g_{k}^{2}}}\leq\sqrt{\frac{1}{1-a^{2}/b}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><msub><mi>N</mi><mi>t</mi></msub><msub><mi>D</mi><mi>t</mi></msub></mfrac></mstyle><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></msubsup><mrow><msup><mi>a</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow><msqrt><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></msubsup><mrow><msup><mi>b</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>g</mi><mi>k</mi><mn>2</mn></msubsup></mrow></mrow></msqrt></mfrac></mstyle><mo>≤</mo><msqrt><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mrow><msup><mi>a</mi><mn>2</mn></msup><mo>/</mo><mi>b</mi></mrow></mrow></mfrac></mstyle></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle\frac{N_{t}}{D_{t}}=\frac{\sum_{k=0}^{t}a^{k}|g_{k}|}{\sqrt{\sum_{k=0}^{t}b^{k}g_{k}^{2}}}\leq\sqrt{\frac{1}{1-a^{2}/b}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.65)</span></td></tr></tbody>
</table>
<p id="A1.SS5.p2.7" class="ltx_p"><span id="A1.SS5.p2.7.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A1.SS6" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.6 </span>Proof of Lemma <a href="#A1.Thmtheorem5" title="Lemma A.5 (Bound on the Quantized Momentum Error Ratio). ‣ A.6 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.5</span></a></h3>

<div id="A1.Thmtheorem5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem5.2" class="ltx_text ltx_font_bold">Lemma A.5</span></span><span id="A1.Thmtheorem5.3" class="ltx_text ltx_font_bold"> </span>(Bound on the Quantized Momentum Error Ratio)<span id="A1.Thmtheorem5.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem5.p1" class="ltx_para">
<p id="A1.Thmtheorem5.p1.1" class="ltx_p"><span id="A1.Thmtheorem5.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A1.Thmtheorem5.p1.m1" class="ltx_Math" alttext="(g_{k})_{k=0}^{t}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></msubsup><annotation encoding="application/x-tex">(g_{k})_{k=0}^{t}</annotation></semantics></math> be a sequence of scalars. Let the weights be <math id="A1.Thmtheorem5.p1.m2" class="ltx_Math" alttext="A_{k}=\beta_{1}^{k}((1+q_{M})^{k}-1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>k</mi></msub><mo>=</mo><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A_{k}=\beta_{1}^{k}((1+q_{M})^{k}-1)</annotation></semantics></math> and <math id="A1.Thmtheorem5.p1.m3" class="ltx_Math" alttext="B_{k}=(\beta_{2}(1-q_{V}))^{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>k</mi></msub><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>k</mi></msup></mrow><annotation encoding="application/x-tex">B_{k}=(\beta_{2}(1-q_{V}))^{k}</annotation></semantics></math>.
If the condition <math id="A1.Thmtheorem5.p1.m4" class="ltx_Math" alttext="\beta_{1}^{2}(1+q_{M})^{2}&lt;\beta_{2}(1-q_{V})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>&lt;</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta_{1}^{2}(1+q_{M})^{2}&lt;\beta_{2}(1-q_{V})</annotation></semantics></math> holds, then the ratio of the weighted sum is bounded by:</span></p>
<table id="A1.Ex83" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex83.m1" class="ltx_Math" alttext="\frac{\sum_{k=0}^{t}A_{k}|g_{k}|}{\sqrt{\sum_{k=0}^{t}B_{k}g_{k}^{2}}}\leq q_{M}\cdot\frac{\sqrt{r^{\prime}(1+r^{\prime})}}{(1+q_{M})(1-r^{\prime})^{3/2}}" display="block" intent=":literal"><semantics><mrow><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></msubsup><mrow><msub><mi>A</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow><msqrt><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></msubsup><mrow><msub><mi>B</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>g</mi><mi>k</mi><mn>2</mn></msubsup></mrow></mrow></msqrt></mfrac><mo>≤</mo><mrow><msub><mi>q</mi><mi>M</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><msqrt><mrow><msup><mi>r</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></msqrt><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">\frac{\sum_{k=0}^{t}A_{k}|g_{k}|}{\sqrt{\sum_{k=0}^{t}B_{k}g_{k}^{2}}}\leq q_{M}\cdot\frac{\sqrt{r^{\prime}(1+r^{\prime})}}{(1+q_{M})(1-r^{\prime})^{3/2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.Thmtheorem5.p1.2" class="ltx_p"><span id="A1.Thmtheorem5.p1.2.1" class="ltx_text ltx_font_italic">where <math id="A1.Thmtheorem5.p1.m5" class="ltx_Math" alttext="r^{\prime}=\frac{\beta_{1}^{2}(1+q_{M})^{2}}{\beta_{2}(1-q_{V})}" display="inline" intent=":literal"><semantics><mrow><msup><mi>r</mi><mo>′</mo></msup><mo>=</mo><mfrac><mrow><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">r^{\prime}=\frac{\beta_{1}^{2}(1+q_{M})^{2}}{\beta_{2}(1-q_{V})}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A1.SS6.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS6.p1" class="ltx_para">
<p id="A1.SS6.p1.1" class="ltx_p"><span id="A1.SS6.p1.1.1" class="ltx_text">Following the proof of Lemma <a href="#A1.Thmtheorem4" title="Lemma A.4 (Finite Geometric Series Ratio Bounded by Infinite Sum). ‣ A.5 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.4</span></a>, we apply the Cauchy-Schwarz inequality to get:</span></p>
<table id="A1.EGx88" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E66"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E66.m1" class="ltx_Math" alttext="\displaystyle\left(\sum_{k=0}^{t}A_{k}|g_{k}|\right)^{2}\leq\left(\sum_{k=0}^{t}\frac{A_{k}^{2}}{B_{k}}\right)\cdot\left(\sum_{k=0}^{t}B_{k}g_{k}^{2}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msub><mi>A</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo>≤</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><msubsup><mi>A</mi><mi>k</mi><mn>2</mn></msubsup><msub><mi>B</mi><mi>k</mi></msub></mfrac></mstyle></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msub><mi>B</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>g</mi><mi>k</mi><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left(\sum_{k=0}^{t}A_{k}|g_{k}|\right)^{2}\leq\left(\sum_{k=0}^{t}\frac{A_{k}^{2}}{B_{k}}\right)\cdot\left(\sum_{k=0}^{t}B_{k}g_{k}^{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.66)</span></td></tr></tbody>
</table>
<p id="A1.SS6.p1.2" class="ltx_p"><span id="A1.SS6.p1.2.1" class="ltx_text">This implies that the ratio is bounded by the square root of the first term on the right-hand side. We now focus on bounding the term <math id="A1.SS6.p1.m1" class="ltx_Math" alttext="\sum_{k=0}^{t}\frac{A_{k}^{2}}{B_{k}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></msubsup><mfrac><msubsup><mi>A</mi><mi>k</mi><mn>2</mn></msubsup><msub><mi>B</mi><mi>k</mi></msub></mfrac></mrow><annotation encoding="application/x-tex">\sum_{k=0}^{t}\frac{A_{k}^{2}}{B_{k}}</annotation></semantics></math>. First, we express the ratio <math id="A1.SS6.p1.m2" class="ltx_Math" alttext="\frac{A_{k}^{2}}{B_{k}}" display="inline" intent=":literal"><semantics><mfrac><msubsup><mi>A</mi><mi>k</mi><mn>2</mn></msubsup><msub><mi>B</mi><mi>k</mi></msub></mfrac><annotation encoding="application/x-tex">\frac{A_{k}^{2}}{B_{k}}</annotation></semantics></math> as:</span></p>
<table id="A1.EGx89" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex84"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex84.m1" class="ltx_Math" alttext="\displaystyle\frac{A_{k}^{2}}{B_{k}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><msubsup><mi>A</mi><mi>k</mi><mn>2</mn></msubsup><msub><mi>B</mi><mi>k</mi></msub></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{A_{k}^{2}}{B_{k}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex84.m2" class="ltx_Math" alttext="\displaystyle=\frac{(\beta_{1}^{k}((1+q_{M})^{k}-1))^{2}}{(\beta_{2}(1-q_{V}))^{k}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>k</mi></msup></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{(\beta_{1}^{k}((1+q_{M})^{k}-1))^{2}}{(\beta_{2}(1-q_{V}))^{k}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E67.m1" class="ltx_Math" alttext="\displaystyle=\left(\frac{\beta_{1}^{2}}{\beta_{2}(1-q_{V})}\right)^{k}((1+q_{M})^{k}-1)^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\frac{\beta_{1}^{2}}{\beta_{2}(1-q_{V})}\right)^{k}((1+q_{M})^{k}-1)^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.67)</span></td></tr></tbody>
</table>
<p id="A1.SS6.p1.3" class="ltx_p"><span id="A1.SS6.p1.3.1" class="ltx_text">To bound the term <math id="A1.SS6.p1.m3" class="ltx_Math" alttext="((1+q_{M})^{k}-1)^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">((1+q_{M})^{k}-1)^{2}</annotation></semantics></math>, we first establish an inequality for <math id="A1.SS6.p1.m4" class="ltx_Math" alttext="(1+q_{M})^{k}-1" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">(1+q_{M})^{k}-1</annotation></semantics></math> using the Mean Value Theorem. Let <math id="A1.SS6.p1.m5" class="ltx_Math" alttext="f(x)=x^{k}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mi>x</mi><mi>k</mi></msup></mrow><annotation encoding="application/x-tex">f(x)=x^{k}</annotation></semantics></math>. For <math id="A1.SS6.p1.m6" class="ltx_Math" alttext="q_{M}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>M</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">q_{M}&gt;0</annotation></semantics></math>, by the Mean Value Theorem, there exists a <math id="A1.SS6.p1.m7" class="ltx_Math" alttext="c\in(1,1+q_{M})" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">c\in(1,1+q_{M})</annotation></semantics></math> such that:</span></p>
<table id="A1.EGx90" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E68.m1" class="ltx_Math" alttext="\displaystyle\frac{f(1+q_{M})-f(1)}{(1+q_{M})-1}=f^{\prime}(c)\implies(1+q_{M})^{k}-1=q_{M}\cdot(kc^{k-1})." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle><mo>=</mo><mrow><msup><mi>f</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟹</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo>−</mo><mn>1</mn></mrow><mo>=</mo><mrow><msub><mi>q</mi><mi>M</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>c</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{f(1+q_{M})-f(1)}{(1+q_{M})-1}=f^{\prime}(c)\implies(1+q_{M})^{k}-1=q_{M}\cdot(kc^{k-1}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.68)</span></td></tr></tbody>
</table>
<p id="A1.SS6.p1.4" class="ltx_p"><span id="A1.SS6.p1.4.1" class="ltx_text">Since <math id="A1.SS6.p1.m8" class="ltx_Math" alttext="c&lt;1+q_{M}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&lt;</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow></mrow><annotation encoding="application/x-tex">c&lt;1+q_{M}</annotation></semantics></math>, and for <math id="A1.SS6.p1.m9" class="ltx_Math" alttext="k\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k\geq 1</annotation></semantics></math>, we have <math id="A1.SS6.p1.m10" class="ltx_Math" alttext="c^{k-1}\leq(1+q_{M})^{k-1}" display="inline" intent=":literal"><semantics><mrow><msup><mi>c</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>≤</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">c^{k-1}\leq(1+q_{M})^{k-1}</annotation></semantics></math>. This leads to the inequality:</span></p>
<table id="A1.EGx91" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E69.m1" class="ltx_Math" alttext="\displaystyle(1+q_{M})^{k}-1\leq k\cdot q_{M}\cdot(1+q_{M})^{k-1}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo>−</mo><mn>1</mn></mrow><mo>≤</mo><mrow><mi>k</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>q</mi><mi>M</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle(1+q_{M})^{k}-1\leq k\cdot q_{M}\cdot(1+q_{M})^{k-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.69)</span></td></tr></tbody>
</table>
<p id="A1.SS6.p1.5" class="ltx_p"><span id="A1.SS6.p1.5.1" class="ltx_text">Squaring both sides of (<a href="#A1.E69" title="In Proof. ‣ A.6 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.69</span></a>) gives:</span></p>
<table id="A1.EGx92" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex85"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex85.m1" class="ltx_Math" alttext="\displaystyle((1+q_{M})^{k}-1)^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\displaystyle((1+q_{M})^{k}-1)^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex85.m2" class="ltx_Math" alttext="\displaystyle\leq k^{2}q_{M}^{2}(1+q_{M})^{2(k-1)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msup><mi>k</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>M</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq k^{2}q_{M}^{2}(1+q_{M})^{2(k-1)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E70"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E70.m1" class="ltx_Math" alttext="\displaystyle=\frac{k^{2}q_{M}^{2}}{(1+q_{M})^{2}}(1+q_{M})^{2k}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>k</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>M</mi><mn>2</mn></msubsup></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{k^{2}q_{M}^{2}}{(1+q_{M})^{2}}(1+q_{M})^{2k}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.70)</span></td></tr></tbody>
</table>
<p id="A1.SS6.p1.6" class="ltx_p"><span id="A1.SS6.p1.6.1" class="ltx_text">Substituting this back into (<a href="#A1.E67" title="In Proof. ‣ A.6 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.67</span></a>), and using the definition <math id="A1.SS6.p1.m11" class="ltx_Math" alttext="r^{\prime}=\frac{\beta_{1}^{2}(1+q_{M})^{2}}{\beta_{2}(1-q_{V})}" display="inline" intent=":literal"><semantics><mrow><msup><mi>r</mi><mo>′</mo></msup><mo>=</mo><mfrac><mrow><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">r^{\prime}=\frac{\beta_{1}^{2}(1+q_{M})^{2}}{\beta_{2}(1-q_{V})}</annotation></semantics></math>, we get:</span></p>
<table id="A1.EGx93" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex86.m1" class="ltx_Math" alttext="\displaystyle\frac{A_{k}^{2}}{B_{k}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><msubsup><mi>A</mi><mi>k</mi><mn>2</mn></msubsup><msub><mi>B</mi><mi>k</mi></msub></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{A_{k}^{2}}{B_{k}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex86.m2" class="ltx_Math" alttext="\displaystyle\leq\left(\frac{\beta_{1}^{2}}{\beta_{2}(1-q_{V})}\right)^{k}\frac{k^{2}q_{M}^{2}}{(1+q_{M})^{2}}(1+q_{M})^{2k}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>k</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>M</mi><mn>2</mn></msubsup></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\frac{\beta_{1}^{2}}{\beta_{2}(1-q_{V})}\right)^{k}\frac{k^{2}q_{M}^{2}}{(1+q_{M})^{2}}(1+q_{M})^{2k}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex87.m1" class="ltx_Math" alttext="\displaystyle=\frac{q_{M}^{2}}{(1+q_{M})^{2}}k^{2}\left(\frac{\beta_{1}^{2}(1+q_{M})^{2}}{\beta_{2}(1-q_{V})}\right)^{k}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>q</mi><mi>M</mi><mn>2</mn></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><mi>k</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{q_{M}^{2}}{(1+q_{M})^{2}}k^{2}\left(\frac{\beta_{1}^{2}(1+q_{M})^{2}}{\beta_{2}(1-q_{V})}\right)^{k}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E71"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E71.m1" class="ltx_Math" alttext="\displaystyle=\frac{q_{M}^{2}}{(1+q_{M})^{2}}k^{2}(r^{\prime})^{k}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>q</mi><mi>M</mi><mn>2</mn></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mi>k</mi></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{q_{M}^{2}}{(1+q_{M})^{2}}k^{2}(r^{\prime})^{k}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.71)</span></td></tr></tbody>
</table>
<p id="A1.SS6.p1.7" class="ltx_p"><span id="A1.SS6.p1.7.1" class="ltx_text">Now we sum this term. The condition <math id="A1.SS6.p1.m12" class="ltx_Math" alttext="r^{\prime}&lt;1" display="inline" intent=":literal"><semantics><mrow><msup><mi>r</mi><mo>′</mo></msup><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">r^{\prime}&lt;1</annotation></semantics></math> ensures the convergence of the infinite series. We first derive the closed-form expression for <math id="A1.SS6.p1.m13" class="ltx_Math" alttext="\sum_{k=0}^{\infty}k^{2}x^{k}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></msubsup><mrow><msup><mi>k</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mi>k</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\sum_{k=0}^{\infty}k^{2}x^{k}</annotation></semantics></math> for <math id="A1.SS6.p1.m14" class="ltx_Math" alttext="|x|&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>x</mi><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">|x|&lt;1</annotation></semantics></math>. We start with the geometric series:</span></p>
<table id="A1.EGx94" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E72"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E72.m1" class="ltx_Math" alttext="\displaystyle\sum_{k=0}^{\infty}x^{k}=\frac{1}{1-x}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><msup><mi>x</mi><mi>k</mi></msup></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>x</mi></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{k=0}^{\infty}x^{k}=\frac{1}{1-x}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.72)</span></td></tr></tbody>
</table>
<p id="A1.SS6.p1.8" class="ltx_p"><span id="A1.SS6.p1.8.1" class="ltx_text">Differentiating with respect to <math id="A1.SS6.p1.m15" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> and multiplying by <math id="A1.SS6.p1.m16" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> gives:</span></p>
<table id="A1.EGx95" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E73"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E73.m1" class="ltx_Math" alttext="\displaystyle\sum_{k=0}^{\infty}kx^{k}=x\frac{d}{dx}\left(\frac{1}{1-x}\right)=\frac{x}{(1-x)^{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mi>k</mi></msup></mrow></mrow><mo>=</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>x</mi></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mi>x</mi><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{k=0}^{\infty}kx^{k}=x\frac{d}{dx}\left(\frac{1}{1-x}\right)=\frac{x}{(1-x)^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.73)</span></td></tr></tbody>
</table>
<p id="A1.SS6.p1.9" class="ltx_p"><span id="A1.SS6.p1.9.1" class="ltx_text">Differentiating one more time and multiplying by <math id="A1.SS6.p1.m17" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> yields:</span></p>
<table id="A1.EGx96" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E74"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E74.m1" class="ltx_Math" alttext="\displaystyle\sum_{k=0}^{\infty}k^{2}x^{k}=x\frac{d}{dx}\left(\frac{x}{(1-x)^{2}}\right)=x\frac{1(1-x)^{2}-x(2(1-x)(-1))}{(1-x)^{4}}=\frac{x(1+x)}{(1-x)^{3}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><msup><mi>k</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mi>k</mi></msup></mrow></mrow><mo>=</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>x</mi><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup></mfrac></mstyle></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{k=0}^{\infty}k^{2}x^{k}=x\frac{d}{dx}\left(\frac{x}{(1-x)^{2}}\right)=x\frac{1(1-x)^{2}-x(2(1-x)(-1))}{(1-x)^{4}}=\frac{x(1+x)}{(1-x)^{3}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.74)</span></td></tr></tbody>
</table>
<p id="A1.SS6.p1.10" class="ltx_p"><span id="A1.SS6.p1.10.1" class="ltx_text">Using this result with <math id="A1.SS6.p1.m18" class="ltx_Math" alttext="x=r^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">x=r^{\prime}</annotation></semantics></math>, we can bound the sum <math id="A1.SS6.p1.m19" class="ltx_Math" alttext="\sum_{k=0}^{t}\frac{A_{k}^{2}}{B_{k}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></msubsup><mfrac><msubsup><mi>A</mi><mi>k</mi><mn>2</mn></msubsup><msub><mi>B</mi><mi>k</mi></msub></mfrac></mrow><annotation encoding="application/x-tex">\sum_{k=0}^{t}\frac{A_{k}^{2}}{B_{k}}</annotation></semantics></math> by extending it to an infinite series:</span></p>
<table id="A1.EGx97" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex88.m1" class="ltx_Math" alttext="\displaystyle\sum_{k=0}^{t}\frac{A_{k}^{2}}{B_{k}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><msubsup><mi>A</mi><mi>k</mi><mn>2</mn></msubsup><msub><mi>B</mi><mi>k</mi></msub></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{k=0}^{t}\frac{A_{k}^{2}}{B_{k}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex88.m2" class="ltx_Math" alttext="\displaystyle\leq\sum_{k=0}^{\infty}\frac{A_{k}^{2}}{B_{k}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><msubsup><mi>A</mi><mi>k</mi><mn>2</mn></msubsup><msub><mi>B</mi><mi>k</mi></msub></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{k=0}^{\infty}\frac{A_{k}^{2}}{B_{k}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex89"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex89.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{k=0}^{\infty}\frac{q_{M}^{2}}{(1+q_{M})^{2}}k^{2}(r^{\prime})^{k}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>q</mi><mi>M</mi><mn>2</mn></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mi>k</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{k=0}^{\infty}\frac{q_{M}^{2}}{(1+q_{M})^{2}}k^{2}(r^{\prime})^{k}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex90"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex90.m1" class="ltx_Math" alttext="\displaystyle=\frac{q_{M}^{2}}{(1+q_{M})^{2}}\sum_{k=0}^{\infty}k^{2}(r^{\prime})^{k}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>q</mi><mi>M</mi><mn>2</mn></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><msup><mi>k</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mi>k</mi></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{q_{M}^{2}}{(1+q_{M})^{2}}\sum_{k=0}^{\infty}k^{2}(r^{\prime})^{k}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E75"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E75.m1" class="ltx_Math" alttext="\displaystyle=\frac{q_{M}^{2}}{(1+q_{M})^{2}}\frac{r^{\prime}(1+r^{\prime})}{(1-r^{\prime})^{3}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>q</mi><mi>M</mi><mn>2</mn></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>r</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{q_{M}^{2}}{(1+q_{M})^{2}}\frac{r^{\prime}(1+r^{\prime})}{(1-r^{\prime})^{3}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.75)</span></td></tr></tbody>
</table>
<p id="A1.SS6.p1.11" class="ltx_p"><span id="A1.SS6.p1.11.1" class="ltx_text">Finally, taking the square root of (<a href="#A1.E75" title="In Proof. ‣ A.6 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.75</span></a>) and substituting it back into the result from the Cauchy-Schwarz inequality (<a href="#A1.E66" title="In Proof. ‣ A.6 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.66</span></a>) gives the desired bound:</span></p>
<table id="A1.EGx98" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E76"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E76.m1" class="ltx_Math" alttext="\displaystyle\frac{\sum_{k=0}^{t}A_{k}|g_{k}|}{\sqrt{\sum_{k=0}^{t}B_{k}g_{k}^{2}}}\leq\sqrt{\sum_{k=0}^{t}\frac{A_{k}^{2}}{B_{k}}}\leq\sqrt{\frac{q_{M}^{2}}{(1+q_{M})^{2}}\frac{r^{\prime}(1+r^{\prime})}{(1-r^{\prime})^{3}}}=q_{M}\cdot\frac{\sqrt{r^{\prime}(1+r^{\prime})}}{(1+q_{M})(1-r^{\prime})^{3/2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></msubsup><mrow><msub><mi>A</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow><msqrt><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></msubsup><mrow><msub><mi>B</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>g</mi><mi>k</mi><mn>2</mn></msubsup></mrow></mrow></msqrt></mfrac></mstyle><mo>≤</mo><msqrt><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><msubsup><mi>A</mi><mi>k</mi><mn>2</mn></msubsup><msub><mi>B</mi><mi>k</mi></msub></mfrac></mstyle></mrow></msqrt><mo>≤</mo><msqrt><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>q</mi><mi>M</mi><mn>2</mn></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>r</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mfrac></mstyle></mrow></msqrt><mo>=</mo><mrow><msub><mi>q</mi><mi>M</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><msqrt><mrow><msup><mi>r</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></msqrt><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\sum_{k=0}^{t}A_{k}|g_{k}|}{\sqrt{\sum_{k=0}^{t}B_{k}g_{k}^{2}}}\leq\sqrt{\sum_{k=0}^{t}\frac{A_{k}^{2}}{B_{k}}}\leq\sqrt{\frac{q_{M}^{2}}{(1+q_{M})^{2}}\frac{r^{\prime}(1+r^{\prime})}{(1-r^{\prime})^{3}}}=q_{M}\cdot\frac{\sqrt{r^{\prime}(1+r^{\prime})}}{(1+q_{M})(1-r^{\prime})^{3/2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.76)</span></td></tr></tbody>
</table>
<p id="A1.SS6.p1.12" class="ltx_p"><span id="A1.SS6.p1.12.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A1.SS7" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.7 </span>Proof of Lemma <a href="#A1.Thmtheorem6" title="Lemma A.6 (Bound on the Quantized Gradient Estimator). ‣ A.7 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.6</span></a></h3>

<div id="A1.Thmtheorem6" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem6.2" class="ltx_text ltx_font_bold">Lemma A.6</span></span><span id="A1.Thmtheorem6.3" class="ltx_text ltx_font_bold"> </span>(Bound on the Quantized Gradient Estimator)<span id="A1.Thmtheorem6.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem6.p1" class="ltx_para">
<p id="A1.Thmtheorem6.p1.1" class="ltx_p"><span id="A1.Thmtheorem6.p1.1.1" class="ltx_text ltx_font_italic">Let the stochastic gradient be bounded in infinity norm almost surely by <math id="A1.Thmtheorem6.p1.m1" class="ltx_Math" alttext="\|\nabla f_{t}(\mathbf{w};\gamma)\|_{\infty}\leq R-\sqrt{\epsilon}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐰</mi><mo>,</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><mi>R</mi><mo>−</mo><msqrt><mi>ϵ</mi></msqrt></mrow></mrow><annotation encoding="application/x-tex">\|\nabla f_{t}(\mathbf{w};\gamma)\|_{\infty}\leq R-\sqrt{\epsilon}</annotation></semantics></math> for any parameters <math id="A1.Thmtheorem6.p1.m2" class="ltx_Math" alttext="\mathbf{w}" display="inline" intent=":literal"><semantics><mi>𝐰</mi><annotation encoding="application/x-tex">\mathbf{w}</annotation></semantics></math>. Let the gradient quantization operator satisfy the relative error model <math id="A1.Thmtheorem6.p1.m3" class="ltx_Math" alttext="|Q(z)-z|\leq q_{G}|z|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>z</mi></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>z</mi><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">|Q(z)-z|\leq q_{G}|z|</annotation></semantics></math> for any scalar <math id="A1.Thmtheorem6.p1.m4" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math>. The quantized gradient estimator <math id="A1.Thmtheorem6.p1.m5" class="ltx_Math" alttext="\hat{\mathbf{g}_{t}}" display="inline" intent=":literal"><semantics><mover accent="true"><msub><mi>𝐠</mi><mi>t</mi></msub><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\mathbf{g}_{t}}</annotation></semantics></math> is defined component-wise for <math id="A1.Thmtheorem6.p1.m6" class="ltx_Math" alttext="i\in[d]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[d]</annotation></semantics></math> as:</span></p>
<table id="A1.EGx99" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E77"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E77.m1" class="ltx_Math" alttext="\displaystyle\hat{g}_{t,i}=\frac{1}{B}\sum_{j=1}^{B}[\nabla^{Q}f(\mathbf{w}_{t-1}^{Q};\gamma_{t,j})]_{i}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>g</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>B</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></munderover></mstyle><msub><mrow><mo stretchy="false">[</mo><mrow><mrow><msup><mo rspace="0.167em">∇</mo><mi>Q</mi></msup><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>Q</mi></msubsup><mo>,</mo><msub><mi>γ</mi><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow><mi>i</mi></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\hat{g}_{t,i}=\frac{1}{B}\sum_{j=1}^{B}[\nabla^{Q}f(\mathbf{w}_{t-1}^{Q};\gamma_{t,j})]_{i},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.77)</span></td></tr></tbody>
</table>
<p id="A1.Thmtheorem6.p1.2" class="ltx_p"><span id="A1.Thmtheorem6.p1.2.1" class="ltx_text ltx_font_italic">where we use <math id="A1.Thmtheorem6.p1.m7" class="ltx_Math" alttext="\nabla^{Q}f(\cdot)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mo>∇</mo><mi>Q</mi></msup><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla^{Q}f(\cdot)</annotation></semantics></math> as shorthand for <math id="A1.Thmtheorem6.p1.m8" class="ltx_Math" alttext="Q(\nabla f(\cdot))" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Q(\nabla f(\cdot))</annotation></semantics></math> and <math id="A1.Thmtheorem6.p1.m9" class="ltx_Math" alttext="[\cdot]_{i}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">[</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">]</mo></mrow><mi>i</mi></msub><annotation encoding="application/x-tex">[\cdot]_{i}</annotation></semantics></math> to denote the i-th component. Then, the infinity norm of the estimator is bounded almost surely:</span></p>
<table id="A1.EGx100" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E78"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E78.m1" class="ltx_Math" alttext="\displaystyle\|\hat{\mathbf{g}_{t}}\|_{\infty}\leq(1+q_{G})(R-\sqrt{\epsilon})." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mover accent="true"><msub><mi>𝐠</mi><mi>t</mi></msub><mo>^</mo></mover><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>R</mi><mo>−</mo><msqrt><mi>ϵ</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|\hat{\mathbf{g}_{t}}\|_{\infty}\leq(1+q_{G})(R-\sqrt{\epsilon}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.78)</span></td></tr></tbody>
</table>
<p id="A1.Thmtheorem6.p1.3" class="ltx_p"><span id="A1.Thmtheorem6.p1.3.1" class="ltx_text ltx_font_italic">For notational simplicity in subsequent proofs, we will use the slightly looser bound <math id="A1.Thmtheorem6.p1.m10" class="ltx_Math" alttext="\|\hat{\mathbf{g}_{t}}\|_{\infty}\leq(1+q_{G})R" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mover accent="true"><msub><mi>𝐠</mi><mi>t</mi></msub><mo>^</mo></mover><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mrow><annotation encoding="application/x-tex">\|\hat{\mathbf{g}_{t}}\|_{\infty}\leq(1+q_{G})R</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A1.SS7.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS7.p1" class="ltx_para">
<p id="A1.SS7.p1.1" class="ltx_p"><span id="A1.SS7.p1.1.1" class="ltx_text">We first bound the infinity norm of a single quantized gradient vector <math id="A1.SS7.p1.m1" class="ltx_Math" alttext="\nabla^{Q}f(\cdot)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mo>∇</mo><mi>Q</mi></msup><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla^{Q}f(\cdot)</annotation></semantics></math>. For any component <math id="A1.SS7.p1.m2" class="ltx_Math" alttext="i\in[d]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[d]</annotation></semantics></math>, we have:</span></p>
<table id="A1.EGx101" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex91"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex91.m1" class="ltx_Math" alttext="\displaystyle\left|\nabla_{i}^{Q}f(\mathbf{w}_{t-1}^{Q};\gamma_{t,j})\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><msubsup><mo>∇</mo><mi>i</mi><mi>Q</mi></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>Q</mi></msubsup><mo>,</mo><msub><mi>γ</mi><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\nabla_{i}^{Q}f(\mathbf{w}_{t-1}^{Q};\gamma_{t,j})\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex91.m2" class="ltx_Math" alttext="\displaystyle=\left|\nabla_{i}f(\mathbf{w}_{t-1}^{Q};\gamma_{t,j})+\left(\nabla_{i}^{Q}f(\mathbf{w}_{t-1}^{Q};\gamma_{t,j})-\nabla_{i}f(\mathbf{w}_{t-1}^{Q};\gamma_{t,j})\right)\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>|</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>Q</mi></msubsup><mo>,</mo><msub><mi>γ</mi><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mo>(</mo><mrow><mrow><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>i</mi><mi>Q</mi></msubsup><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>Q</mi></msubsup><mo>,</mo><msub><mi>γ</mi><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>Q</mi></msubsup><mo>,</mo><msub><mi>γ</mi><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left|\nabla_{i}f(\mathbf{w}_{t-1}^{Q};\gamma_{t,j})+\left(\nabla_{i}^{Q}f(\mathbf{w}_{t-1}^{Q};\gamma_{t,j})-\nabla_{i}f(\mathbf{w}_{t-1}^{Q};\gamma_{t,j})\right)\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex92"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex92.m1" class="ltx_Math" alttext="\displaystyle\leq\left|\nabla_{i}f(\mathbf{w}_{t-1}^{Q};\gamma_{t,j})\right|+\left|\nabla_{i}^{Q}f(\mathbf{w}_{t-1}^{Q};\gamma_{t,j})-\nabla_{i}f(\mathbf{w}_{t-1}^{Q};\gamma_{t,j})\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>|</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>Q</mi></msubsup><mo>,</mo><msub><mi>γ</mi><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>+</mo><mrow><mo>|</mo><mrow><mrow><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>i</mi><mi>Q</mi></msubsup><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>Q</mi></msubsup><mo>,</mo><msub><mi>γ</mi><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>Q</mi></msubsup><mo>,</mo><msub><mi>γ</mi><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left|\nabla_{i}f(\mathbf{w}_{t-1}^{Q};\gamma_{t,j})\right|+\left|\nabla_{i}^{Q}f(\mathbf{w}_{t-1}^{Q};\gamma_{t,j})-\nabla_{i}f(\mathbf{w}_{t-1}^{Q};\gamma_{t,j})\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex93"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex93.m1" class="ltx_Math" alttext="\displaystyle\leq\left|\nabla_{i}f(\mathbf{w}_{t-1}^{Q};\gamma_{t,j})\right|+q_{G}\left|\nabla_{i}f(\mathbf{w}_{t-1}^{Q};\gamma_{t,j})\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>|</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>Q</mi></msubsup><mo>,</mo><msub><mi>γ</mi><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>+</mo><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>Q</mi></msubsup><mo>,</mo><msub><mi>γ</mi><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left|\nabla_{i}f(\mathbf{w}_{t-1}^{Q};\gamma_{t,j})\right|+q_{G}\left|\nabla_{i}f(\mathbf{w}_{t-1}^{Q};\gamma_{t,j})\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E79"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E79.m1" class="ltx_Math" alttext="\displaystyle=(1+q_{G})\left|\nabla_{i}f(\mathbf{w}_{t-1}^{Q};\gamma_{t,j})\right|." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>Q</mi></msubsup><mo>,</mo><msub><mi>γ</mi><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=(1+q_{G})\left|\nabla_{i}f(\mathbf{w}_{t-1}^{Q};\gamma_{t,j})\right|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.79)</span></td></tr></tbody>
</table>
<p id="A1.SS7.p1.2" class="ltx_p"><span id="A1.SS7.p1.2.1" class="ltx_text">Since this holds for any component, it also holds for the component with the maximum absolute value. Therefore, by taking the maximum over <math id="A1.SS7.p1.m3" class="ltx_Math" alttext="i\in[d]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[d]</annotation></semantics></math>, we can bound the infinity norm:</span></p>
<table id="A1.EGx102" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex94"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex94.m1" class="ltx_Math" alttext="\displaystyle\|\nabla^{Q}f(\mathbf{w}_{t-1}^{Q};\gamma_{t,j})\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msup><mo rspace="0.167em">∇</mo><mi>Q</mi></msup><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>Q</mi></msubsup><mo>,</mo><msub><mi>γ</mi><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\displaystyle\|\nabla^{Q}f(\mathbf{w}_{t-1}^{Q};\gamma_{t,j})\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex94.m2" class="ltx_Math" alttext="\displaystyle\leq(1+q_{G})\|\nabla f(\mathbf{w}_{t-1}^{Q};\gamma_{t,j})\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>Q</mi></msubsup><mo>,</mo><msub><mi>γ</mi><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq(1+q_{G})\|\nabla f(\mathbf{w}_{t-1}^{Q};\gamma_{t,j})\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E80"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E80.m1" class="ltx_Math" alttext="\displaystyle\leq(1+q_{G})(R-\sqrt{\epsilon})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>R</mi><mo>−</mo><msqrt><mi>ϵ</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq(1+q_{G})(R-\sqrt{\epsilon}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.80)</span></td></tr></tbody>
</table>
<p id="A1.SS7.p1.3" class="ltx_p"><span id="A1.SS7.p1.3.1" class="ltx_text">Finally, we apply the triangle inequality to the full estimator <math id="A1.SS7.p1.m4" class="ltx_Math" alttext="\hat{\mathbf{g}_{t}}" display="inline" intent=":literal"><semantics><mover accent="true"><msub><mi>𝐠</mi><mi>t</mi></msub><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\mathbf{g}_{t}}</annotation></semantics></math>, which is the average over <math id="A1.SS7.p1.m5" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> such vectors:</span></p>
<table id="A1.EGx103" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex95"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex95.m1" class="ltx_Math" alttext="\displaystyle\|\hat{\mathbf{g}_{t}}\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mover accent="true"><msub><mi>𝐠</mi><mi>t</mi></msub><mo>^</mo></mover><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\displaystyle\|\hat{\mathbf{g}_{t}}\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex95.m2" class="ltx_Math" alttext="\displaystyle=\|\frac{1}{B}\sum_{j=1}^{B}\nabla^{Q}f(\mathbf{w}_{t-1}^{Q};\gamma_{t,j})\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>B</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></munderover></mstyle><mrow><mrow><msup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>Q</mi></msup><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>Q</mi></msubsup><mo>,</mo><msub><mi>γ</mi><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\|\frac{1}{B}\sum_{j=1}^{B}\nabla^{Q}f(\mathbf{w}_{t-1}^{Q};\gamma_{t,j})\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex96"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex96.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{1}{B}\sum_{j=1}^{B}\|\nabla^{Q}f(\mathbf{w}_{t-1}^{Q};\gamma_{t,j})\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>B</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></munderover></mstyle><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msup><mo rspace="0.167em">∇</mo><mi>Q</mi></msup><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>Q</mi></msubsup><mo>,</mo><msub><mi>γ</mi><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{B}\sum_{j=1}^{B}\|\nabla^{Q}f(\mathbf{w}_{t-1}^{Q};\gamma_{t,j})\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex97"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex97.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{1}{B}\sum_{j=1}^{B}(1+q_{G})(R-\sqrt{\epsilon})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>B</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></munderover></mstyle><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>R</mi><mo>−</mo><msqrt><mi>ϵ</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{B}\sum_{j=1}^{B}(1+q_{G})(R-\sqrt{\epsilon})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E81.m1" class="ltx_Math" alttext="\displaystyle=(1+q_{G})(R-\sqrt{\epsilon})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>R</mi><mo>−</mo><msqrt><mi>ϵ</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=(1+q_{G})(R-\sqrt{\epsilon}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.81)</span></td></tr></tbody>
</table>
<p id="A1.SS7.p1.4" class="ltx_p"><span id="A1.SS7.p1.4.1" class="ltx_text">This concludes the proof.
∎</span></p>
</div>
</div>
</section>
<section id="A1.SS8" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.8 </span>Proof of Lemma <a href="#A1.Thmtheorem7" title="Lemma A.7 (Bound on the Expected Gradient Error with Biased Quantization). ‣ A.8 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.7</span></a></h3>

<div id="A1.Thmtheorem7" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem7.2" class="ltx_text ltx_font_bold">Lemma A.7</span></span><span id="A1.Thmtheorem7.3" class="ltx_text ltx_font_bold"> </span>(Bound on the Expected Gradient Error with Biased Quantization)<span id="A1.Thmtheorem7.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem7.p1" class="ltx_para">
<p id="A1.Thmtheorem7.p1.1" class="ltx_p"><span id="A1.Thmtheorem7.p1.1.1" class="ltx_text ltx_font_italic">Under the assumptions that the infinity norm of stochastic gradient is up bounded (Assumption <a href="#S4.Thmtheorem2" title="Assumption 4.2 (Stochastic Gradient Bounds). ‣ 4 Main Results ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>), the objective <math id="A1.Thmtheorem7.p1.m1" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> is L-smooth (Assumption <a href="#S4.Thmtheorem3" title="Assumption 4.3 (Smoothness). ‣ 4 Main Results ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a>), and the quantization relative error model holds (Assumption <a href="#S3.Thmtheorem1" title="Assumption 3.1 (Quantization Error). ‣ Relative error. ‣ 3.1 Preliminaries ‣ 3 Preliminaries and Problem Setup ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>), the magnitude of the conditional expectation of the total error term <math id="A1.Thmtheorem7.p1.m2" class="ltx_Math" alttext="\delta_{t,i}" display="inline" intent=":literal"><semantics><msub><mi>δ</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">\delta_{t,i}</annotation></semantics></math> is bounded by:</span></p>
<table id="A1.Ex98" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex98.m1" class="ltx_Math" alttext="|\mathbb{E}_{t-1}\left[\delta_{t,i}\right]|\leq q_{G}R+Lq_{W}\|\mathbf{w}_{t-1}\|_{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>𝔼</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msub><mi>δ</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>]</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|\mathbb{E}_{t-1}\left[\delta_{t,i}\right]|\leq q_{G}R+Lq_{W}\|\mathbf{w}_{t-1}\|_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.SS8.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS8.p1" class="ltx_para">
<p id="A1.SS8.p1.1" class="ltx_p"><span id="A1.SS8.p1.1.1" class="ltx_text">We start from the decomposition of the conditional expectation of <math id="A1.SS8.p1.m1" class="ltx_Math" alttext="\delta_{t,i}" display="inline" intent=":literal"><semantics><msub><mi>δ</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">\delta_{t,i}</annotation></semantics></math>, which we derived previously:</span></p>
<table id="A1.EGx104" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex99"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex99.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{t-1}\left[\delta_{t,i}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msub><mi>δ</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{t-1}\left[\delta_{t,i}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex99.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{\gamma}\left[\nabla_{i}^{Q}f(\mathbf{w}_{t-1}^{Q};\gamma)-\nabla_{i}f(\mathbf{w}_{t-1}^{Q};\gamma)\right]+\mathbb{E}_{\gamma}\left[\nabla_{i}f(\mathbf{w}_{t-1}^{Q};\gamma)-\nabla_{i}f(\mathbf{w}_{t-1};\gamma)\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>𝔼</mi><mi>γ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>i</mi><mi>Q</mi></msubsup><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>Q</mi></msubsup><mo>,</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>Q</mi></msubsup><mo>,</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>𝔼</mi><mi>γ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>Q</mi></msubsup><mo>,</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\gamma}\left[\nabla_{i}^{Q}f(\mathbf{w}_{t-1}^{Q};\gamma)-\nabla_{i}f(\mathbf{w}_{t-1}^{Q};\gamma)\right]+\mathbb{E}_{\gamma}\left[\nabla_{i}f(\mathbf{w}_{t-1}^{Q};\gamma)-\nabla_{i}f(\mathbf{w}_{t-1};\gamma)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E82"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E82.m1" class="ltx_math_unparsed" alttext="\displaystyle=\underbrace{\mathbb{E}_{\gamma}\left[\nabla_{i}^{Q}f(\mathbf{w}_{t-1}^{Q};\gamma)-\nabla_{i}f(\mathbf{w}_{t-1}^{Q};\gamma)\right]}_{\text{Term I: Gradient Quantization Bias}}+\underbrace{\left(\nabla_{i}F(\mathbf{w}_{t-1}^{Q})-\nabla_{i}F(\mathbf{w}_{t-1})\right)}_{\text{Term II: Weight Quantization Bias}}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><munder accentunder="true"><mrow><msub><mi>𝔼</mi><mi>γ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>i</mi><mi>Q</mi></msubsup><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>Q</mi></msubsup><mo>,</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>Q</mi></msubsup><mo>,</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><msub><mrow></mrow><mtext>Term I: Gradient Quantization Bias</mtext></msub><mo>+</mo><munder accentunder="true"><mrow><mo>(</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>Q</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo stretchy="true">⏟</mo></munder><msub><mrow></mrow><mtext>Term II: Weight Quantization Bias</mtext></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\underbrace{\mathbb{E}_{\gamma}\left[\nabla_{i}^{Q}f(\mathbf{w}_{t-1}^{Q};\gamma)-\nabla_{i}f(\mathbf{w}_{t-1}^{Q};\gamma)\right]}_{\text{Term I: Gradient Quantization Bias}}+\underbrace{\left(\nabla_{i}F(\mathbf{w}_{t-1}^{Q})-\nabla_{i}F(\mathbf{w}_{t-1})\right)}_{\text{Term II: Weight Quantization Bias}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.82)</span></td></tr></tbody>
</table>
<p id="A1.SS8.p1.2" class="ltx_p"><span id="A1.SS8.p1.2.1" class="ltx_text">Using the triangle inequality, we can bound the magnitude as:</span></p>
<table id="A1.EGx105" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E83"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E83.m1" class="ltx_Math" alttext="\displaystyle|\mathbb{E}_{t-1}\left[\delta_{t,i}\right]|\leq|\text{Term I}|+|\text{Term II}|." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>𝔼</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msub><mi>δ</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>]</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">|</mo><mtext>Term I</mtext><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><mo stretchy="false">|</mo><mtext>Term II</mtext><mo stretchy="false">|</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle|\mathbb{E}_{t-1}\left[\delta_{t,i}\right]|\leq|\text{Term I}|+|\text{Term II}|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.83)</span></td></tr></tbody>
</table>
<p id="A1.SS8.p1.3" class="ltx_p"><span id="A1.SS8.p1.3.1" class="ltx_text">We bound each term separately.</span></p>
</div>
<div id="A1.SS8.p2" class="ltx_para">
<p id="A1.SS8.p2.1" class="ltx_p"><span id="A1.SS8.p2.1.1" class="ltx_text ltx_font_bold">Bounding Term I:<span id="A1.SS8.p2.1.1.1" class="ltx_text ltx_font_medium">
This term is the expected bias from the (potentially biased) gradient quantization. We first apply Jensen’s inequality for absolute values, i.e., <math id="A1.SS8.p2.m1" class="ltx_Math" alttext="|\mathbb{E}[X]|\leq\mathbb{E}[|X|]" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>X</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">|</mo><mi>X</mi><mo stretchy="false">|</mo></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">|\mathbb{E}[X]|\leq\mathbb{E}[|X|]</annotation></semantics></math>:</span></span></p>
<table id="A1.EGx106" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex100"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex100.m1" class="ltx_Math" alttext="\displaystyle|\text{Term I}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mtext>Term I</mtext><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle|\text{Term I}|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex100.m2" class="ltx_Math" alttext="\displaystyle=\left|\mathbb{E}_{\gamma}\left[\nabla_{i}^{Q}f(\mathbf{w}_{t-1}^{Q};\gamma)-\nabla_{i}f(\mathbf{w}_{t-1}^{Q};\gamma)\right]\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>|</mo><mrow><msub><mi>𝔼</mi><mi>γ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>i</mi><mi>Q</mi></msubsup><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>Q</mi></msubsup><mo>,</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>Q</mi></msubsup><mo>,</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left|\mathbb{E}_{\gamma}\left[\nabla_{i}^{Q}f(\mathbf{w}_{t-1}^{Q};\gamma)-\nabla_{i}f(\mathbf{w}_{t-1}^{Q};\gamma)\right]\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E84"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E84.m1" class="ltx_Math" alttext="\displaystyle\leq\mathbb{E}_{\gamma}\left[\left|\nabla_{i}^{Q}f(\mathbf{w}_{t-1}^{Q};\gamma)-\nabla_{i}f(\mathbf{w}_{t-1}^{Q};\gamma)\right|\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>𝔼</mi><mi>γ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mo>|</mo><mrow><mrow><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>i</mi><mi>Q</mi></msubsup><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>Q</mi></msubsup><mo>,</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>Q</mi></msubsup><mo>,</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathbb{E}_{\gamma}\left[\left|\nabla_{i}^{Q}f(\mathbf{w}_{t-1}^{Q};\gamma)-\nabla_{i}f(\mathbf{w}_{t-1}^{Q};\gamma)\right|\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.84)</span></td></tr></tbody>
</table>
<p id="A1.SS8.p2.2" class="ltx_p"><span id="A1.SS8.p2.2.1" class="ltx_text">By the relative error model for gradient quantization (Assumption <a href="#S3.Thmtheorem1" title="Assumption 3.1 (Quantization Error). ‣ Relative error. ‣ 3.1 Preliminaries ‣ 3 Preliminaries and Problem Setup ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a> with factor <math id="A1.SS8.p2.m2" class="ltx_Math" alttext="q_{G}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi>G</mi></msub><annotation encoding="application/x-tex">q_{G}</annotation></semantics></math>):</span></p>
<table id="A1.EGx107" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E85"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E85.m1" class="ltx_Math" alttext="\displaystyle|\text{Term I}|\leq\mathbb{E}_{\gamma}\left[q_{G}\left|\nabla_{i}f(\mathbf{w}_{t-1}^{Q};\gamma)\right|\right]\leq q_{G}R." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mtext>Term I</mtext><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><msub><mi>𝔼</mi><mi>γ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>Q</mi></msubsup><mo>,</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle|\text{Term I}|\leq\mathbb{E}_{\gamma}\left[q_{G}\left|\nabla_{i}f(\mathbf{w}_{t-1}^{Q};\gamma)\right|\right]\leq q_{G}R.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.85)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS8.p3" class="ltx_para">
<p id="A1.SS8.p3.1" class="ltx_p"><span id="A1.SS8.p3.1.1" class="ltx_text ltx_font_bold">Bounding Term II:<span id="A1.SS8.p3.1.1.1" class="ltx_text ltx_font_medium">
This term represents the bias from weight quantization. Using the L-smoothness of <math id="A1.SS8.p3.m1" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> (Assumption <a href="#S4.Thmtheorem3" title="Assumption 4.3 (Smoothness). ‣ 4 Main Results ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a>) and the relative error for weights (Assumption <a href="#S3.Thmtheorem1" title="Assumption 3.1 (Quantization Error). ‣ Relative error. ‣ 3.1 Preliminaries ‣ 3 Preliminaries and Problem Setup ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>):</span></span></p>
<table id="A1.EGx108" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E86.m1" class="ltx_Math" alttext="\displaystyle|\text{Term II}|=|\nabla_{i}F(\mathbf{w}_{t-1}^{Q})-\nabla_{i}F(\mathbf{w}_{t-1})|\leq\|\nabla F(\mathbf{w}_{t-1}^{Q})-\nabla F(\mathbf{w}_{t-1})\|_{2}\leq Lq_{W}\|\mathbf{w}_{t-1}\|_{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mtext>Term II</mtext><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>Q</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>Q</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle|\text{Term II}|=|\nabla_{i}F(\mathbf{w}_{t-1}^{Q})-\nabla_{i}F(\mathbf{w}_{t-1})|\leq\|\nabla F(\mathbf{w}_{t-1}^{Q})-\nabla F(\mathbf{w}_{t-1})\|_{2}\leq Lq_{W}\|\mathbf{w}_{t-1}\|_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.86)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS8.p4" class="ltx_para">
<p id="A1.SS8.p4.1" class="ltx_p"><span id="A1.SS8.p4.1.1" class="ltx_text ltx_font_bold">Combining the Bounds:<span id="A1.SS8.p4.1.1.1" class="ltx_text ltx_font_medium">
Summing the bounds for Term I and Term II, we arrive at the final result:</span></span></p>
<table id="A1.EGx109" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E87.m1" class="ltx_Math" alttext="\displaystyle|\mathbb{E}_{t-1}\left[\delta_{t,i}\right]|\leq|\text{Term I}|+|\text{Term II}|\leq q_{G}R+Lq_{W}\|\mathbf{w}_{t-1}\|_{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>𝔼</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msub><mi>δ</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>]</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">|</mo><mtext>Term I</mtext><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><mo stretchy="false">|</mo><mtext>Term II</mtext><mo stretchy="false">|</mo></mrow></mrow><mo>≤</mo><mrow><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle|\mathbb{E}_{t-1}\left[\delta_{t,i}\right]|\leq|\text{Term I}|+|\text{Term II}|\leq q_{G}R+Lq_{W}\|\mathbf{w}_{t-1}\|_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.87)</span></td></tr></tbody>
</table>
<p id="A1.SS8.p4.2" class="ltx_p"><span id="A1.SS8.p4.2.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A1.SS9" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.9 </span>Proof of Lemma <a href="#A1.Thmtheorem8" title="Lemma A.8 (Bound on Term D). ‣ A.9 Proof of Lemma (Bound on Term D) ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.8</span></a> (Bound on Term D)</h3>

<div id="A1.Thmtheorem8" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem8.2" class="ltx_text ltx_font_bold">Lemma A.8</span></span><span id="A1.Thmtheorem8.3" class="ltx_text ltx_font_bold"> </span>(Bound on Term D)<span id="A1.Thmtheorem8.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem8.p1" class="ltx_para">
<p id="A1.Thmtheorem8.p1.1" class="ltx_p"><span id="A1.Thmtheorem8.p1.1.1" class="ltx_text ltx_font_italic">The term D, which captures the error from gradient drift as defined in (<a href="#A1.E20" title="In A.2 Detailed Proof ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.20</span></a>), is bounded by:</span></p>
<table id="A1.EGx110" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E88.m1" class="ltx_Math" alttext="\displaystyle|D|\leq\frac{\eta_{t}^{2}L^{2}\sqrt{1-\beta_{1}}}{4(1+q_{G})R}\left(\sum_{l=1}^{t-1}\|\mathbf{u}_{t-l}\|_{2}^{2}\sum_{k=l}^{t-1}\beta_{1}^{k}\sqrt{k}\right)+\frac{(1+q_{G})R}{\sqrt{1-\beta_{1}}}\sum_{k=0}^{t-1}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{k}\sqrt{k+1}\|\mathbf{U}_{t-k}\|_{2}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mi>D</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>η</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐮</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mi>l</mi></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>k</mi></msqrt></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>β</mi><mn>1</mn></msub><msub><mi>β</mi><mn>2</mn></msub></mfrac></mstyle><mo>)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐔</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle|D|\leq\frac{\eta_{t}^{2}L^{2}\sqrt{1-\beta_{1}}}{4(1+q_{G})R}\left(\sum_{l=1}^{t-1}\|\mathbf{u}_{t-l}\|_{2}^{2}\sum_{k=l}^{t-1}\beta_{1}^{k}\sqrt{k}\right)+\frac{(1+q_{G})R}{\sqrt{1-\beta_{1}}}\sum_{k=0}^{t-1}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{k}\sqrt{k+1}\|\mathbf{U}_{t-k}\|_{2}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.88)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.SS9.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS9.p1" class="ltx_para">
<p id="A1.SS9.p1.1" class="ltx_p"><span id="A1.SS9.p1.1.1" class="ltx_text">We start with the definition of Term D:</span></p>
<table id="A1.Ex101" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex101.m1" class="ltx_Math" alttext="D=\sum_{i\in[d]}\sum_{k=0}^{t-1}\beta_{1}^{k}\left(\mathcal{G}_{t,i}-\mathcal{G}_{t-k,i}\right)\frac{g_{t-k,i}+\delta_{t-k,i}}{\sqrt{\epsilon+v^{\prime}_{t,i}}}" display="block" intent=":literal"><semantics><mrow><mi>D</mi><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msub><mi>g</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>δ</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow></msqrt></mfrac></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">D=\sum_{i\in[d]}\sum_{k=0}^{t-1}\beta_{1}^{k}\left(\mathcal{G}_{t,i}-\mathcal{G}_{t-k,i}\right)\frac{g_{t-k,i}+\delta_{t-k,i}}{\sqrt{\epsilon+v^{\prime}_{t,i}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS9.p1.2" class="ltx_p"><span id="A1.SS9.p1.2.1" class="ltx_text">To tackle this, we employ the weighted Young’s inequality, which states that for any <math id="A1.SS9.p1.m1" class="ltx_Math" alttext="\lambda&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda&gt;0</annotation></semantics></math>,</span></p>
<table id="A1.E89" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E89.m1" class="ltx_Math" alttext="xy\leq\frac{\lambda}{2}x^{2}+\frac{1}{2\lambda}y^{2}" display="block" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>≤</mo><mrow><mrow><mfrac><mi>λ</mi><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">xy\leq\frac{\lambda}{2}x^{2}+\frac{1}{2\lambda}y^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.89)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS9.p2" class="ltx_para">
<p id="A1.SS9.p2.1" class="ltx_p"><span id="A1.SS9.p2.1.1" class="ltx_text">We apply this inequality to each product within the summation for Term D, setting</span></p>
<table id="A1.Ex102" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex102.m1" class="ltx_math_unparsed" alttext="x=|{\mathcal{G}_{t,i}-\mathcal{G}_{t-k,i}}|,\quad y=\frac{|{g_{t-k,i}+\delta_{t-k,i}}|}{\sqrt{\epsilon+v^{\prime}_{t,i}}},\quad\text{and}\quad\lambda=\frac{\sqrt{1-\beta_{1}}}{2(1+q_{G})R\sqrt{k+1}}." display="block" intent=":literal"><semantics><mrow><mi>x</mi><mo rspace="0em">=</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>−</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo rspace="1.167em">,</mo><mi>y</mi><mo>=</mo><mfrac><mrow><mo stretchy="false">|</mo><mrow><msub><mi>g</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>δ</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">|</mo></mrow><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow></msqrt></mfrac><mo rspace="1.167em">,</mo><mtext>and</mtext><mi>λ</mi><mo>=</mo><mfrac><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msqrt></mrow></mfrac><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">x=|{\mathcal{G}_{t,i}-\mathcal{G}_{t-k,i}}|,\quad y=\frac{|{g_{t-k,i}+\delta_{t-k,i}}|}{\sqrt{\epsilon+v^{\prime}_{t,i}}},\quad\text{and}\quad\lambda=\frac{\sqrt{1-\beta_{1}}}{2(1+q_{G})R\sqrt{k+1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS9.p2.2" class="ltx_p"><span id="A1.SS9.p2.2.1" class="ltx_text">This application gives us an initial bound on the magnitude of D:</span></p>
<table id="A1.EGx111" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E90"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E90.m1" class="ltx_Math" alttext="\displaystyle|D|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi>D</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle|D|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E90.m2" class="ltx_Math" alttext="\displaystyle\leq\sum_{i\in[d]}\sum_{k=0}^{t-1}\beta_{1}^{k}\left(\frac{\sqrt{1-\beta_{1}}}{4(1+q_{G})R\sqrt{k+1}}\left(\mathcal{G}_{t,i}-\mathcal{G}_{t-k,i}\right)^{2}+\frac{(1+q_{G})R\sqrt{k+1}}{\sqrt{1-\beta_{1}}}\frac{(g_{t-k,i}+\delta_{t-k,i})^{2}}{\epsilon+v^{\prime}_{t,i}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msqrt></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msqrt></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>g</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>δ</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mi>ϵ</mi><mo>+</mo><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{i\in[d]}\sum_{k=0}^{t-1}\beta_{1}^{k}\left(\frac{\sqrt{1-\beta_{1}}}{4(1+q_{G})R\sqrt{k+1}}\left(\mathcal{G}_{t,i}-\mathcal{G}_{t-k,i}\right)^{2}+\frac{(1+q_{G})R\sqrt{k+1}}{\sqrt{1-\beta_{1}}}\frac{(g_{t-k,i}+\delta_{t-k,i})^{2}}{\epsilon+v^{\prime}_{t,i}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.90)</span></td></tr></tbody>
</table>
<p id="A1.SS9.p2.3" class="ltx_p"><span id="A1.SS9.p2.3.1" class="ltx_text">To simplify this expression further, we must establish bounds for two of its key components.</span></p>
</div>
<div id="A1.SS9.p3" class="ltx_para">
<p id="A1.SS9.p3.1" class="ltx_p"><span id="A1.SS9.p3.1.1" class="ltx_text">First, we can find a lower bound for the denominator term. For any coordinate <math id="A1.SS9.p3.m1" class="ltx_Math" alttext="i\in[d]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[d]</annotation></semantics></math>, the recursive definition of <math id="A1.SS9.p3.m2" class="ltx_Math" alttext="v^{\prime}_{t,i}" display="inline" intent=":literal"><semantics><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">v^{\prime}_{t,i}</annotation></semantics></math> implies that <math id="A1.SS9.p3.m3" class="ltx_Math" alttext="\epsilon+v^{\prime}_{t,i}\geq\epsilon+\beta_{2}^{k}v^{\prime}_{t-k,i}\geq\beta_{2}^{k}(\epsilon+v^{\prime}_{t-k,i})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϵ</mi><mo>+</mo><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow><mo>≥</mo><mrow><mi>ϵ</mi><mo>+</mo><mrow><msubsup><mi>β</mi><mn>2</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>v</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow></mrow><mo>≥</mo><mrow><msubsup><mi>β</mi><mn>2</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><msubsup><mi>v</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\epsilon+v^{\prime}_{t,i}\geq\epsilon+\beta_{2}^{k}v^{\prime}_{t-k,i}\geq\beta_{2}^{k}(\epsilon+v^{\prime}_{t-k,i})</annotation></semantics></math>. This allows us to bound the fraction as:</span></p>
<table id="A1.E91" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E91.m1" class="ltx_Math" alttext="\frac{(g_{t-k,i}+\delta_{t-k,i})^{2}}{\epsilon+v^{\prime}_{t,i}}\leq\frac{1}{\beta_{2}^{k}}U_{t-k,i}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>g</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>δ</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mi>ϵ</mi><mo>+</mo><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow></mfrac><mo>≤</mo><mrow><mfrac><mn>1</mn><msubsup><mi>β</mi><mn>2</mn><mi>k</mi></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>U</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{(g_{t-k,i}+\delta_{t-k,i})^{2}}{\epsilon+v^{\prime}_{t,i}}\leq\frac{1}{\beta_{2}^{k}}U_{t-k,i}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.91)</span></td></tr></tbody>
</table>
<p id="A1.SS9.p3.2" class="ltx_p"><span id="A1.SS9.p3.2.1" class="ltx_text">Second, we bound the squared gradient difference using the L-smoothness of the objective function <math id="A1.SS9.p3.m4" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>.</span></p>
<table id="A1.EGx112" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex103"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex103.m1" class="ltx_Math" alttext="\displaystyle\|\mathcal{G}_{t}-\mathcal{G}_{t-k}\|_{2}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>t</mi></msub><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><annotation encoding="application/x-tex">\displaystyle\|\mathcal{G}_{t}-\mathcal{G}_{t-k}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex103.m2" class="ltx_Math" alttext="\displaystyle\leq L^{2}\|\mathbf{w}_{t-1}-\mathbf{w}_{t-k-1}\|_{2}^{2}=L^{2}\left\|\sum_{l=1}^{k}\eta_{t-l}\mathbf{u}_{t-l}\right\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>=</mo><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover></mstyle><mrow><msub><mi>η</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐮</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msub></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq L^{2}\|\mathbf{w}_{t-1}-\mathbf{w}_{t-k-1}\|_{2}^{2}=L^{2}\left\|\sum_{l=1}^{k}\eta_{t-l}\mathbf{u}_{t-l}\right\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E92"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E92.m1" class="ltx_Math" alttext="\displaystyle\leq\eta_{t}^{2}L^{2}k\sum_{l=1}^{k}\|\mathbf{u}_{t-l}\|^{2}_{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msubsup><mi>η</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover></mstyle><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐮</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\eta_{t}^{2}L^{2}k\sum_{l=1}^{k}\|\mathbf{u}_{t-l}\|^{2}_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.92)</span></td></tr></tbody>
</table>
<p id="A1.SS9.p3.3" class="ltx_p"><span id="A1.SS9.p3.3.1" class="ltx_text">The final step above follows from Jensen’s inequality and the fact that the step size schedule <math id="A1.SS9.p3.m5" class="ltx_Math" alttext="\eta_{t}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\eta_{t}</annotation></semantics></math> is non-decreasing.</span></p>
</div>
<div id="A1.SS9.p4" class="ltx_para">
<p id="A1.SS9.p4.1" class="ltx_p"><span id="A1.SS9.p4.1.1" class="ltx_text">With these two intermediate results, (<a href="#A1.E91" title="In Proof. ‣ A.9 Proof of Lemma (Bound on Term D) ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.91</span></a>) and (<a href="#A1.E92" title="In Proof. ‣ A.9 Proof of Lemma (Bound on Term D) ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.92</span></a>), we can return to our main inequality (<a href="#A1.E90" title="In Proof. ‣ A.9 Proof of Lemma (Bound on Term D) ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.90</span></a>). Substituting these bounds yields:</span></p>
<table id="A1.EGx113" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex104"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex104.m1" class="ltx_Math" alttext="\displaystyle|D|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi>D</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle|D|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex104.m2" class="ltx_Math" alttext="\displaystyle\leq\left(\sum_{k=0}^{t-1}\frac{\eta_{t}^{2}L^{2}\sqrt{1-\beta_{1}}\beta_{1}^{k}}{4(1+q_{G})R\sqrt{k+1}}\left(k\sum_{l=1}^{k}\|\mathbf{u}_{t-l}\|^{2}_{2}\right)\right)+\left(\sum_{k=0}^{t-1}\frac{(1+q_{G})R\beta_{1}^{k}\sqrt{k+1}}{\sqrt{1-\beta_{1}}\beta_{2}^{k}}\|\mathbf{U}_{t-k}\|_{2}^{2}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>η</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msqrt></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover></mstyle><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐮</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo>+</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msqrt></mrow><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mn>2</mn><mi>k</mi></msubsup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐔</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\sum_{k=0}^{t-1}\frac{\eta_{t}^{2}L^{2}\sqrt{1-\beta_{1}}\beta_{1}^{k}}{4(1+q_{G})R\sqrt{k+1}}\left(k\sum_{l=1}^{k}\|\mathbf{u}_{t-l}\|^{2}_{2}\right)\right)+\left(\sum_{k=0}^{t-1}\frac{(1+q_{G})R\beta_{1}^{k}\sqrt{k+1}}{\sqrt{1-\beta_{1}}\beta_{2}^{k}}\|\mathbf{U}_{t-k}\|_{2}^{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex105"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex105.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{\eta_{t}^{2}L^{2}\sqrt{1-\beta_{1}}}{4(1+q_{G})R}\left(\sum_{k=0}^{t-1}\beta_{1}^{k}\sqrt{k}\sum_{l=1}^{k}\|\mathbf{u}_{t-l}\|^{2}_{2}\right)+\frac{(1+q_{G})R}{\sqrt{1-\beta_{1}}}\sum_{k=0}^{t-1}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{k}\sqrt{k+1}\|\mathbf{U}_{t-k}\|_{2}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>η</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>k</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover></mstyle><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐮</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>β</mi><mn>1</mn></msub><msub><mi>β</mi><mn>2</mn></msub></mfrac></mstyle><mo>)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐔</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\eta_{t}^{2}L^{2}\sqrt{1-\beta_{1}}}{4(1+q_{G})R}\left(\sum_{k=0}^{t-1}\beta_{1}^{k}\sqrt{k}\sum_{l=1}^{k}\|\mathbf{u}_{t-l}\|^{2}_{2}\right)+\frac{(1+q_{G})R}{\sqrt{1-\beta_{1}}}\sum_{k=0}^{t-1}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{k}\sqrt{k+1}\|\mathbf{U}_{t-k}\|_{2}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS9.p4.2" class="ltx_p"><span id="A1.SS9.p4.2.1" class="ltx_text">Finally, by rearranging the order of summation in the first term, we arrive at our desired bound:</span></p>
<table id="A1.EGx114" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E93"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E93.m1" class="ltx_Math" alttext="\displaystyle|D|\leq\frac{\eta_{t}^{2}L^{2}\sqrt{1-\beta_{1}}}{4(1+q_{G})R}\left(\sum_{l=1}^{t-1}\|\mathbf{u}_{t-l}\|_{2}^{2}\sum_{k=l}^{t-1}\beta_{1}^{k}\sqrt{k}\right)+\frac{(1+q_{G})R}{\sqrt{1-\beta_{1}}}\sum_{k=0}^{t-1}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{k}\sqrt{k+1}\|\mathbf{U}_{t-k}\|_{2}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mi>D</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>η</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐮</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mi>l</mi></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>k</mi></msqrt></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>β</mi><mn>1</mn></msub><msub><mi>β</mi><mn>2</mn></msub></mfrac></mstyle><mo>)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐔</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle|D|\leq\frac{\eta_{t}^{2}L^{2}\sqrt{1-\beta_{1}}}{4(1+q_{G})R}\left(\sum_{l=1}^{t-1}\|\mathbf{u}_{t-l}\|_{2}^{2}\sum_{k=l}^{t-1}\beta_{1}^{k}\sqrt{k}\right)+\frac{(1+q_{G})R}{\sqrt{1-\beta_{1}}}\sum_{k=0}^{t-1}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{k}\sqrt{k+1}\|\mathbf{U}_{t-k}\|_{2}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.93)</span></td></tr></tbody>
</table>
<p id="A1.SS9.p4.3" class="ltx_p"><span id="A1.SS9.p4.3.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A1.SS10" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.10 </span>Proof of Lemma <a href="#A1.Thmtheorem9" title="Lemma A.9 (Lower Bound on the Expectation of Term C). ‣ A.10 Proof of Lemma (Lower Bound on Term C) ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.9</span></a> (Lower Bound on Term C)</h3>

<div id="A1.Thmtheorem9" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem9.2" class="ltx_text ltx_font_bold">Lemma A.9</span></span><span id="A1.Thmtheorem9.3" class="ltx_text ltx_font_bold"> </span>(Lower Bound on the Expectation of Term C)<span id="A1.Thmtheorem9.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem9.p1" class="ltx_para">
<p id="A1.Thmtheorem9.p1.1" class="ltx_p"><span id="A1.Thmtheorem9.p1.1.1" class="ltx_text ltx_font_italic">The expectation of term C, defined in (<a href="#A1.E20" title="In A.2 Detailed Proof ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.20</span></a>), is lower-bounded by:</span></p>
<table id="A1.EGx115" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex106"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex106.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[C\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mi>C</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[C\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex106.m2" class="ltx_Math" alttext="\displaystyle\geq\frac{1}{2}\left(\sum_{i\in[d]}\sum_{k=0}^{t-1}\beta_{1}^{k}\mathbb{E}\left[\frac{\mathcal{G}_{t-k,i}^{2}}{\sqrt{\epsilon+\tilde{v}_{t,k+1,i}}}\right]\right)-\frac{2(1+q_{G})R}{\sqrt{1-\beta_{1}}}\left(\sum_{i\in[d]}\sum_{k=0}^{t-1}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{k}\sqrt{k+1}\mathbb{E}\left[\|\mathbf{U}_{t-k}\|_{2}^{2}\right]\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msub><mover accent="true"><mi>v</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>,</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow></msqrt></mfrac></mstyle><mo>]</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>β</mi><mn>1</mn></msub><msub><mi>β</mi><mn>2</mn></msub></mfrac></mstyle><mo>)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐔</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\frac{1}{2}\left(\sum_{i\in[d]}\sum_{k=0}^{t-1}\beta_{1}^{k}\mathbb{E}\left[\frac{\mathcal{G}_{t-k,i}^{2}}{\sqrt{\epsilon+\tilde{v}_{t,k+1,i}}}\right]\right)-\frac{2(1+q_{G})R}{\sqrt{1-\beta_{1}}}\left(\sum_{i\in[d]}\sum_{k=0}^{t-1}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{k}\sqrt{k+1}\mathbb{E}\left[\|\mathbf{U}_{t-k}\|_{2}^{2}\right]\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E94"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E94.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad-d\sum_{k=0}^{t-1}\beta_{1}^{k}M_{t-k}." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>d</mi><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>β</mi><msub><mrow></mrow><mn>1</mn></msub><msup><mrow></mrow><mi>k</mi></msup><mi>M</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad-d\sum_{k=0}^{t-1}\beta_{1}^{k}M_{t-k}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.94)</span></td></tr></tbody>
</table>
<p id="A1.Thmtheorem9.p1.2" class="ltx_p"><span id="A1.Thmtheorem9.p1.2.1" class="ltx_text ltx_font_italic">where <math id="A1.Thmtheorem9.p1.m1" class="ltx_Math" alttext="M_{t-k}=\frac{q_{G}R^{2}+Lq_{W}R\|\mathbf{w}_{t-k-1}\|_{2}}{\sqrt{\epsilon}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub><mo>=</mo><mfrac><mrow><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><msqrt><mi>ϵ</mi></msqrt></mfrac></mrow><annotation encoding="application/x-tex">M_{t-k}=\frac{q_{G}R^{2}+Lq_{W}R\|\mathbf{w}_{t-k-1}\|_{2}}{\sqrt{\epsilon}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A1.SS10.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS10.p1" class="ltx_para">
<p id="A1.SS10.p1.1" class="ltx_p"><span id="A1.SS10.p1.1.1" class="ltx_text">We study the main term of the summation in C, i.e. for <math id="A1.SS10.p1.m1" class="ltx_Math" alttext="i\in[d]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[d]</annotation></semantics></math> and <math id="A1.SS10.p1.m2" class="ltx_Math" alttext="k&lt;t" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>&lt;</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">k&lt;t</annotation></semantics></math>:</span></p>
<table id="A1.EGx116" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E95"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E95.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\mathcal{G}_{t-k,i}\frac{g_{t-k,i}+\delta_{t-k,i}}{\sqrt{\epsilon+v_{t,i}}}\right]=\mathbb{E}\left[\nabla_{i}F(\mathbf{w}_{t-k-1})\frac{\nabla_{i}f_{t-k}(\mathbf{w}_{t-k-1})+\delta_{t-k,i}}{\sqrt{\epsilon+v_{t,i}}}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>g</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>δ</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></msqrt></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><msub><mo>∇</mo><mi>i</mi></msub><msub><mi>f</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>δ</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></msqrt></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\mathcal{G}_{t-k,i}\frac{g_{t-k,i}+\delta_{t-k,i}}{\sqrt{\epsilon+v_{t,i}}}\right]=\mathbb{E}\left[\nabla_{i}F(\mathbf{w}_{t-k-1})\frac{\nabla_{i}f_{t-k}(\mathbf{w}_{t-k-1})+\delta_{t-k,i}}{\sqrt{\epsilon+v_{t,i}}}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.95)</span></td></tr></tbody>
</table>
<p id="A1.SS10.p1.2" class="ltx_p"><span id="A1.SS10.p1.2.1" class="ltx_text">We will further drop indices in the rest of the proof, noting <math id="A1.SS10.p1.m3" class="ltx_Math" alttext="\mathcal{G}=\mathcal{G}_{t-k,i}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>=</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{G}=\mathcal{G}_{t-k,i}</annotation></semantics></math>,
<math id="A1.SS10.p1.m4" class="ltx_Math" alttext="g=g_{t-k,i}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><msub><mi>g</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow><annotation encoding="application/x-tex">g=g_{t-k,i}</annotation></semantics></math>, <math id="A1.SS10.p1.m5" class="ltx_Math" alttext="\delta=\delta_{t-k,i}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>=</mo><msub><mi>δ</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\delta=\delta_{t-k,i}</annotation></semantics></math>,<math id="A1.SS10.p1.m6" class="ltx_Math" alttext="\tilde{v}=\tilde{v}_{t,k+1,i}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>v</mi><mo>~</mo></mover><mo>=</mo><msub><mover accent="true"><mi>v</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>,</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\tilde{v}=\tilde{v}_{t,k+1,i}</annotation></semantics></math> and <math id="A1.SS10.p1.m7" class="ltx_Math" alttext="v=v^{\prime}_{t,i}" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>=</mo><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">v=v^{\prime}_{t,i}</annotation></semantics></math>. Finally, let us note</span></p>
<table id="A1.E96" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E96.m1" class="ltx_Math" alttext="s^{2}=\sum_{j=t-k}^{t}\beta_{2}^{t-j}(g_{j,i}+\delta_{j,i})^{2}\qquad\text{and}\qquad r^{2}=\mathbb{E}_{t-k-1}\left[s^{2}\right]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>s</mi><mn>2</mn></msup><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></mrow><mi>t</mi></munderover><mrow><msubsup><mi>β</mi><mn>2</mn><mrow><mi>t</mi><mo>−</mo><mi>j</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>g</mi><mrow><mi>j</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>δ</mi><mrow><mi>j</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mtext>and</mtext><mspace style="width:2em;" width="2em"></mspace><mrow><msup><mi>r</mi><mn>2</mn></msup><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mi>s</mi><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">s^{2}=\sum_{j=t-k}^{t}\beta_{2}^{t-j}(g_{j,i}+\delta_{j,i})^{2}\qquad\text{and}\qquad r^{2}=\mathbb{E}_{t-k-1}\left[s^{2}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.96)</span></td></tr></tbody>
</table>
<p id="A1.SS10.p1.3" class="ltx_p"><span id="A1.SS10.p1.3.1" class="ltx_text">In particular we have <math id="A1.SS10.p1.m8" class="ltx_Math" alttext="\tilde{v}-v=r^{2}-s^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>v</mi><mo>~</mo></mover><mo>−</mo><mi>v</mi></mrow><mo>=</mo><mrow><msup><mi>r</mi><mn>2</mn></msup><mo>−</mo><msup><mi>s</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\tilde{v}-v=r^{2}-s^{2}</annotation></semantics></math>. With our new notations, we can rewrite (<a href="#A1.E95" title="In Proof. ‣ A.10 Proof of Lemma (Lower Bound on Term C) ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.95</span></a>) as</span></p>
<table id="A1.EGx117" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex107"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex107.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\mathcal{G}\frac{g+\delta}{\sqrt{\epsilon+v}}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>g</mi><mo>+</mo><mi>δ</mi></mrow><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mi>v</mi></mrow></msqrt></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\mathcal{G}\frac{g+\delta}{\sqrt{\epsilon+v}}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex107.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\left[\mathcal{G}\frac{g+\delta}{\sqrt{\epsilon+\tilde{v}}}+\mathcal{G}(g+\delta)\left(\frac{1}{\sqrt{\epsilon+v}}-\frac{1}{\sqrt{\epsilon+\tilde{v}}}\right)\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>g</mi><mo>+</mo><mi>δ</mi></mrow><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow></msqrt></mfrac></mstyle></mrow><mo>+</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>+</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mi>v</mi></mrow></msqrt></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow></msqrt></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\left[\mathcal{G}\frac{g+\delta}{\sqrt{\epsilon+\tilde{v}}}+\mathcal{G}(g+\delta)\left(\frac{1}{\sqrt{\epsilon+v}}-\frac{1}{\sqrt{\epsilon+\tilde{v}}}\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex108"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex108.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\left[\mathbb{E}_{t-k-1}\left[\mathcal{G}\frac{g+\delta}{\sqrt{\epsilon+\tilde{v}}}\right]+\mathcal{G}(g+\delta)\frac{r^{2}-s^{2}}{\sqrt{\epsilon+v}\sqrt{\epsilon+\tilde{v}}(\sqrt{\epsilon+v}+\sqrt{\epsilon+\tilde{v}})}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>g</mi><mo>+</mo><mi>δ</mi></mrow><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow></msqrt></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>+</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>r</mi><mn>2</mn></msup><mo>−</mo><msup><mi>s</mi><mn>2</mn></msup></mrow><mrow><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mi>v</mi></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mi>v</mi></mrow></msqrt><mo>+</mo><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\left[\mathbb{E}_{t-k-1}\left[\mathcal{G}\frac{g+\delta}{\sqrt{\epsilon+\tilde{v}}}\right]+\mathcal{G}(g+\delta)\frac{r^{2}-s^{2}}{\sqrt{\epsilon+v}\sqrt{\epsilon+\tilde{v}}(\sqrt{\epsilon+v}+\sqrt{\epsilon+\tilde{v}})}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex109"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex109.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\left[\frac{\mathcal{G}^{2}}{\sqrt{\epsilon+\tilde{v}}}\right]+\mathbb{E}\left[\frac{\mathcal{G}\mathbb{E}_{t-k-1}\left[\delta\right]}{\sqrt{\epsilon+\tilde{v}}}\right]+\mathbb{E}\left[\underbrace{\mathcal{G}(g+\delta)\frac{r^{2}-s^{2}}{\sqrt{\epsilon+v}\sqrt{\epsilon+\tilde{v}}(\sqrt{\epsilon+v}+\sqrt{\epsilon+\tilde{v}})}}_{E}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mn>2</mn></msup><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow></msqrt></mfrac></mstyle><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mi>δ</mi><mo>]</mo></mrow></mrow><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow></msqrt></mfrac></mstyle><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><munder><munder accentunder="true"><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>+</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>r</mi><mn>2</mn></msup><mo>−</mo><msup><mi>s</mi><mn>2</mn></msup></mrow><mrow><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mi>v</mi></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mi>v</mi></mrow></msqrt><mo>+</mo><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo stretchy="true">⏟</mo></munder><mi>E</mi></munder><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\left[\frac{\mathcal{G}^{2}}{\sqrt{\epsilon+\tilde{v}}}\right]+\mathbb{E}\left[\frac{\mathcal{G}\mathbb{E}_{t-k-1}\left[\delta\right]}{\sqrt{\epsilon+\tilde{v}}}\right]+\mathbb{E}\left[\underbrace{\mathcal{G}(g+\delta)\frac{r^{2}-s^{2}}{\sqrt{\epsilon+v}\sqrt{\epsilon+\tilde{v}}(\sqrt{\epsilon+v}+\sqrt{\epsilon+\tilde{v}})}}_{E}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E97"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E97.m1" class="ltx_Math" alttext="\displaystyle\geq\mathbb{E}\left[\frac{\mathcal{G}^{2}}{\sqrt{\epsilon+\tilde{v}}}\right]-\frac{q_{G}R^{2}+Lq_{W}R\|\mathbf{w}_{t-k-1}\|_{2}}{\sqrt{\epsilon}}+\mathbb{E}\left[E\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≥</mo><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mn>2</mn></msup><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow></msqrt></mfrac></mstyle><mo>]</mo></mrow></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><msqrt><mi>ϵ</mi></msqrt></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mi>E</mi><mo>]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq\mathbb{E}\left[\frac{\mathcal{G}^{2}}{\sqrt{\epsilon+\tilde{v}}}\right]-\frac{q_{G}R^{2}+Lq_{W}R\|\mathbf{w}_{t-k-1}\|_{2}}{\sqrt{\epsilon}}+\mathbb{E}\left[E\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.97)</span></td></tr></tbody>
</table>
<p id="A1.SS10.p1.4" class="ltx_p"><span id="A1.SS10.p1.4.1" class="ltx_text">The inequality uses Lemma <a href="#A1.Thmtheorem7" title="Lemma A.7 (Bound on the Expected Gradient Error with Biased Quantization). ‣ A.8 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.7</span></a> and the bound for <math id="A1.SS10.p1.m9" class="ltx_Math" alttext="\|\nabla F(\cdot)\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\|\nabla F(\cdot)\|_{\infty}</annotation></semantics></math>. We denote <math id="A1.SS10.p1.m10" class="ltx_Math" alttext="\frac{q_{G}R^{2}+Lq_{W}R\|\mathbf{w}_{t-k-1}\|_{2}}{\sqrt{\epsilon}}\triangleq M_{t-k}" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><msqrt><mi>ϵ</mi></msqrt></mfrac><mo>≜</mo><msub><mi>M</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\frac{q_{G}R^{2}+Lq_{W}R\|\mathbf{w}_{t-k-1}\|_{2}}{\sqrt{\epsilon}}\triangleq M_{t-k}</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS10.p2" class="ltx_para">
<p id="A1.SS10.p2.1" class="ltx_p"><span id="A1.SS10.p2.1.1" class="ltx_text">Then we focus on <math id="A1.SS10.p2.m1" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>:</span></p>
<table id="A1.EGx118" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex110"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex110.m1" class="ltx_Math" alttext="\displaystyle|E|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi>E</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle|E|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex110.m2" class="ltx_Math" alttext="\displaystyle\leq\underbrace{|\mathcal{G}(g+\delta)|\frac{r^{2}}{\sqrt{\epsilon+v}(\epsilon+\tilde{v})}}_{\kappa}+\underbrace{|\mathcal{G}(g+\delta)|\frac{s^{2}}{(\epsilon+v)\sqrt{\epsilon+\tilde{v}}}}_{\rho}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><munder><munder accentunder="true"><mrow><mrow><mo stretchy="false">|</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>+</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>r</mi><mn>2</mn></msup><mrow><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mi>v</mi></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo stretchy="true">⏟</mo></munder><mi>κ</mi></munder><mo>+</mo><munder><munder accentunder="true"><mrow><mrow><mo stretchy="false">|</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>+</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>s</mi><mn>2</mn></msup><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow></msqrt></mrow></mfrac></mstyle></mrow><mo stretchy="true">⏟</mo></munder><mi>ρ</mi></munder></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\underbrace{|\mathcal{G}(g+\delta)|\frac{r^{2}}{\sqrt{\epsilon+v}(\epsilon+\tilde{v})}}_{\kappa}+\underbrace{|\mathcal{G}(g+\delta)|\frac{s^{2}}{(\epsilon+v)\sqrt{\epsilon+\tilde{v}}}}_{\rho},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS10.p2.2" class="ltx_p"><span id="A1.SS10.p2.2.1" class="ltx_text">due to the fact that <math id="A1.SS10.p2.m2" class="ltx_Math" alttext="\sqrt{\epsilon+v}+\sqrt{\epsilon+\tilde{v}}\geq\max(\sqrt{\epsilon+v},\sqrt{\epsilon+\tilde{v}})" display="inline" intent=":literal"><semantics><mrow><mrow><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mi>v</mi></mrow></msqrt><mo>+</mo><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow></msqrt></mrow><mo>≥</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mi>v</mi></mrow></msqrt><mo>,</mo><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow></msqrt><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sqrt{\epsilon+v}+\sqrt{\epsilon+\tilde{v}}\geq\max(\sqrt{\epsilon+v},\sqrt{\epsilon+\tilde{v}})</annotation></semantics></math> and
<math id="A1.SS10.p2.m3" class="ltx_Math" alttext="|r^{2}-s^{2}|\leq r^{2}+s^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><msup><mi>r</mi><mn>2</mn></msup><mo>−</mo><msup><mi>s</mi><mn>2</mn></msup></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><msup><mi>r</mi><mn>2</mn></msup><mo>+</mo><msup><mi>s</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">|r^{2}-s^{2}|\leq r^{2}+s^{2}</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS10.p3" class="ltx_para">
<p id="A1.SS10.p3.1" class="ltx_p"><span id="A1.SS10.p3.1.1" class="ltx_text">Applying Young’s inequality to <math id="A1.SS10.p3.m1" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> with</span></p>
<table id="A1.Ex111" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex111.m1" class="ltx_Math" alttext="\lambda=\frac{\sqrt{1-\beta_{1}}\sqrt{\epsilon+\tilde{v}}}{2},\;x=\frac{|\mathcal{G}|}{\sqrt{\epsilon+\tilde{v}}},\;y=\frac{|g+\delta|r^{2}}{\sqrt{\epsilon+\tilde{v}}\sqrt{\epsilon+v}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>λ</mi><mo>=</mo><mfrac><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow></msqrt></mrow><mn>2</mn></mfrac></mrow><mo rspace="0.447em">,</mo><mrow><mi>x</mi><mo>=</mo><mfrac><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo stretchy="false">|</mo></mrow><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow></msqrt></mfrac></mrow><mo rspace="0.447em">,</mo><mrow><mi>y</mi><mo>=</mo><mfrac><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>g</mi><mo>+</mo><mi>δ</mi></mrow><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mn>2</mn></msup></mrow><mrow><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mi>v</mi></mrow></msqrt></mrow></mfrac></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\lambda=\frac{\sqrt{1-\beta_{1}}\sqrt{\epsilon+\tilde{v}}}{2},\;x=\frac{|\mathcal{G}|}{\sqrt{\epsilon+\tilde{v}}},\;y=\frac{|g+\delta|r^{2}}{\sqrt{\epsilon+\tilde{v}}\sqrt{\epsilon+v}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS10.p3.2" class="ltx_p"><span id="A1.SS10.p3.2.1" class="ltx_text">we obtain</span></p>
<table id="A1.EGx119" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex112"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex112.m1" class="ltx_Math" alttext="\displaystyle\kappa\leq\frac{\mathcal{G}^{2}}{4\sqrt{\epsilon+\tilde{v}}}+\frac{1}{\sqrt{1-\beta_{1}}}\frac{(g+\delta)^{2}r^{4}}{(\epsilon+\tilde{v})^{3/2}(\epsilon+v)}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>κ</mi><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mn>2</mn></msup><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow></msqrt></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>+</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mn>4</mn></msup></mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\kappa\leq\frac{\mathcal{G}^{2}}{4\sqrt{\epsilon+\tilde{v}}}+\frac{1}{\sqrt{1-\beta_{1}}}\frac{(g+\delta)^{2}r^{4}}{(\epsilon+\tilde{v})^{3/2}(\epsilon+v)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS10.p3.3" class="ltx_p"><span id="A1.SS10.p3.3.1" class="ltx_text">Given that <math id="A1.SS10.p3.m2" class="ltx_Math" alttext="\epsilon+\tilde{v}\geq r^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow><mo>≥</mo><msup><mi>r</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\epsilon+\tilde{v}\geq r^{2}</annotation></semantics></math> and taking the conditional expectation, we can simplify as</span></p>
<table id="A1.EGx120" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E98"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E98.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{t-k-1}\left[\kappa\right]\leq\frac{\mathcal{G}^{2}}{4\sqrt{\epsilon+\tilde{v}}}+\frac{1}{\sqrt{1-\beta_{1}}}\frac{r^{2}}{\sqrt{\epsilon+\tilde{v}}}\mathbb{E}_{t-k-1}\left[\frac{(g+\delta)^{2}}{\epsilon+v}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mi>κ</mi><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mn>2</mn></msup><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow></msqrt></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>r</mi><mn>2</mn></msup><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>+</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mi>ϵ</mi><mo>+</mo><mi>v</mi></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{t-k-1}\left[\kappa\right]\leq\frac{\mathcal{G}^{2}}{4\sqrt{\epsilon+\tilde{v}}}+\frac{1}{\sqrt{1-\beta_{1}}}\frac{r^{2}}{\sqrt{\epsilon+\tilde{v}}}\mathbb{E}_{t-k-1}\left[\frac{(g+\delta)^{2}}{\epsilon+v}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.98)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS10.p4" class="ltx_para">
<p id="A1.SS10.p4.1" class="ltx_p"><span id="A1.SS10.p4.1.1" class="ltx_text">Now turning to <math id="A1.SS10.p4.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>, we use Young’s inequality with</span></p>
<table id="A1.Ex113" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex113.m1" class="ltx_Math" alttext="\lambda=\frac{\sqrt{1-\beta_{1}}\sqrt{\epsilon+\tilde{v}}}{2r^{2}},\;x=\frac{|\mathcal{G}s|}{\sqrt{\epsilon+\tilde{v}}},\;y=\frac{|s(g+\delta)|}{\epsilon+v}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>λ</mi><mo>=</mo><mfrac><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow></msqrt></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mn>2</mn></msup></mrow></mfrac></mrow><mo rspace="0.447em">,</mo><mrow><mi>x</mi><mo>=</mo><mfrac><mrow><mo stretchy="false">|</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">|</mo></mrow><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow></msqrt></mfrac></mrow><mo rspace="0.447em">,</mo><mrow><mi>y</mi><mo>=</mo><mfrac><mrow><mo stretchy="false">|</mo><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>+</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><mi>ϵ</mi><mo>+</mo><mi>v</mi></mrow></mfrac></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\lambda=\frac{\sqrt{1-\beta_{1}}\sqrt{\epsilon+\tilde{v}}}{2r^{2}},\;x=\frac{|\mathcal{G}s|}{\sqrt{\epsilon+\tilde{v}}},\;y=\frac{|s(g+\delta)|}{\epsilon+v},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS10.p4.2" class="ltx_p"><span id="A1.SS10.p4.2.1" class="ltx_text">we obtain</span></p>
<table id="A1.EGx121" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E99"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E99.m1" class="ltx_Math" alttext="\displaystyle\rho\leq\frac{\mathcal{G}^{2}}{4\sqrt{\epsilon+\tilde{v}}}\frac{s^{2}}{r^{2}}+\frac{1}{\sqrt{1-\beta_{1}}}\frac{r^{2}}{\sqrt{\epsilon+\tilde{v}}}\frac{(g+\delta)^{2}s^{2}}{(\epsilon+v)^{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mn>2</mn></msup><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow></msqrt></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>s</mi><mn>2</mn></msup><msup><mi>r</mi><mn>2</mn></msup></mfrac></mstyle></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>r</mi><mn>2</mn></msup><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>+</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mn>2</mn></msup></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\rho\leq\frac{\mathcal{G}^{2}}{4\sqrt{\epsilon+\tilde{v}}}\frac{s^{2}}{r^{2}}+\frac{1}{\sqrt{1-\beta_{1}}}\frac{r^{2}}{\sqrt{\epsilon+\tilde{v}}}\frac{(g+\delta)^{2}s^{2}}{(\epsilon+v)^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.99)</span></td></tr></tbody>
</table>
<p id="A1.SS10.p4.3" class="ltx_p"><span id="A1.SS10.p4.3.1" class="ltx_text">Given that <math id="A1.SS10.p4.m2" class="ltx_Math" alttext="\epsilon+v\geq s^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϵ</mi><mo>+</mo><mi>v</mi></mrow><mo>≥</mo><msup><mi>s</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\epsilon+v\geq s^{2}</annotation></semantics></math>, and <math id="A1.SS10.p4.m3" class="ltx_Math" alttext="\mathbb{E}_{t-k-1}\left[\frac{s^{2}}{r^{2}}\right]=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mfrac><msup><mi>s</mi><mn>2</mn></msup><msup><mi>r</mi><mn>2</mn></msup></mfrac><mo>]</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}_{t-k-1}\left[\frac{s^{2}}{r^{2}}\right]=1</annotation></semantics></math>, we obtain after taking the conditional expectation,</span></p>
<table id="A1.EGx122" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E100"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E100.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{t-k-1}\left[\rho\right]\leq\frac{\mathcal{G}^{2}}{4\sqrt{\epsilon+\tilde{v}}}+\frac{1}{\sqrt{1-\beta_{1}}}\frac{r^{2}}{\sqrt{\epsilon+\tilde{v}}}\mathbb{E}_{t-k-1}\left[\frac{(g+\delta)^{2}}{\epsilon+v}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mi>ρ</mi><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mn>2</mn></msup><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow></msqrt></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>r</mi><mn>2</mn></msup><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>+</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mi>ϵ</mi><mo>+</mo><mi>v</mi></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{t-k-1}\left[\rho\right]\leq\frac{\mathcal{G}^{2}}{4\sqrt{\epsilon+\tilde{v}}}+\frac{1}{\sqrt{1-\beta_{1}}}\frac{r^{2}}{\sqrt{\epsilon+\tilde{v}}}\mathbb{E}_{t-k-1}\left[\frac{(g+\delta)^{2}}{\epsilon+v}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.100)</span></td></tr></tbody>
</table>
<p id="A1.SS10.p4.4" class="ltx_p"><span id="A1.SS10.p4.4.1" class="ltx_text">Notice that in (<a href="#A1.E99" title="In Proof. ‣ A.10 Proof of Lemma (Lower Bound on Term C) ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.99</span></a>), we possibly divide by zero. It suffice to notice that if <math id="A1.SS10.p4.m4" class="ltx_Math" alttext="r^{2}=0" display="inline" intent=":literal"><semantics><mrow><msup><mi>r</mi><mn>2</mn></msup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">r^{2}=0</annotation></semantics></math> then <math id="A1.SS10.p4.m5" class="ltx_Math" alttext="s^{2}=0" display="inline" intent=":literal"><semantics><mrow><msup><mi>s</mi><mn>2</mn></msup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">s^{2}=0</annotation></semantics></math> a.s. so that <math id="A1.SS10.p4.m6" class="ltx_Math" alttext="\rho=0" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\rho=0</annotation></semantics></math> and (<a href="#A1.E100" title="In Proof. ‣ A.10 Proof of Lemma (Lower Bound on Term C) ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.100</span></a>) is still verified.
Summing (<a href="#A1.E98" title="In Proof. ‣ A.10 Proof of Lemma (Lower Bound on Term C) ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.98</span></a>) and (<a href="#A1.E100" title="In Proof. ‣ A.10 Proof of Lemma (Lower Bound on Term C) ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.100</span></a>), we get</span></p>
<table id="A1.EGx123" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E101"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E101.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{t-k-1}\left[|E|\right]\leq\frac{\mathcal{G}^{2}}{2\sqrt{\epsilon+\tilde{v}}}+\frac{2}{\sqrt{1-\beta_{1}}}\frac{r^{2}}{\sqrt{\epsilon+\tilde{v}}}\mathbb{E}_{t-k-1}\left[\frac{(g+\delta)^{2}}{\epsilon+v}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mo stretchy="false">|</mo><mi>E</mi><mo stretchy="false">|</mo></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow></msqrt></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>r</mi><mn>2</mn></msup><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>+</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mi>ϵ</mi><mo>+</mo><mi>v</mi></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{t-k-1}\left[|E|\right]\leq\frac{\mathcal{G}^{2}}{2\sqrt{\epsilon+\tilde{v}}}+\frac{2}{\sqrt{1-\beta_{1}}}\frac{r^{2}}{\sqrt{\epsilon+\tilde{v}}}\mathbb{E}_{t-k-1}\left[\frac{(g+\delta)^{2}}{\epsilon+v}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.101)</span></td></tr></tbody>
</table>
<p id="A1.SS10.p4.5" class="ltx_p"><span id="A1.SS10.p4.5.1" class="ltx_text">Given that <math id="A1.SS10.p4.m7" class="ltx_Math" alttext="r\leq\sqrt{\epsilon+\tilde{v}}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>≤</mo><msqrt><mrow><mi>ϵ</mi><mo>+</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow></msqrt></mrow><annotation encoding="application/x-tex">r\leq\sqrt{\epsilon+\tilde{v}}</annotation></semantics></math> by definition of <math id="A1.SS10.p4.m8" class="ltx_Math" alttext="\tilde{v}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>v</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{v}</annotation></semantics></math>, and that <math id="A1.SS10.p4.m9" class="ltx_Math" alttext="r\leq\sqrt{k+1}(1+q_{G})R" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>≤</mo><mrow><msqrt><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mrow><annotation encoding="application/x-tex">r\leq\sqrt{k+1}(1+q_{G})R</annotation></semantics></math>, reintroducing the indices we had dropped</span></p>
<table id="A1.EGx124" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E102"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E102.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{t-k-1}\left[|E|\right]\leq\frac{\mathcal{G}_{t-k,i}^{2}}{2\sqrt{\epsilon+\tilde{v}_{t,k+1,i}}}+\frac{2(1+q_{G})R}{\sqrt{1-\beta_{1}}}\sqrt{k+1}\mathbb{E}_{t-k-1}\left[\frac{(g_{t-k,i}+\delta_{t-k,i})^{2}}{\epsilon+v^{\prime}_{t,i}}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mo stretchy="false">|</mo><mi>E</mi><mo stretchy="false">|</mo></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msub><mover accent="true"><mi>v</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>,</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow></msqrt></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>g</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>δ</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mi>ϵ</mi><mo>+</mo><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{t-k-1}\left[|E|\right]\leq\frac{\mathcal{G}_{t-k,i}^{2}}{2\sqrt{\epsilon+\tilde{v}_{t,k+1,i}}}+\frac{2(1+q_{G})R}{\sqrt{1-\beta_{1}}}\sqrt{k+1}\mathbb{E}_{t-k-1}\left[\frac{(g_{t-k,i}+\delta_{t-k,i})^{2}}{\epsilon+v^{\prime}_{t,i}}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.102)</span></td></tr></tbody>
</table>
<p id="A1.SS10.p4.6" class="ltx_p"><span id="A1.SS10.p4.6.1" class="ltx_text">Taking the complete expectation and using that by definition <math id="A1.SS10.p4.m10" class="ltx_Math" alttext="\epsilon+v^{\prime}_{t,i}\geq\epsilon+\beta_{2}^{k}v^{\prime}_{t-k,i}\geq\beta_{2}^{k}(\epsilon+v^{\prime}_{t-k,i})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϵ</mi><mo>+</mo><msubsup><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow><mo>≥</mo><mrow><mi>ϵ</mi><mo>+</mo><mrow><msubsup><mi>β</mi><mn>2</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>v</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow></mrow><mo>≥</mo><mrow><msubsup><mi>β</mi><mn>2</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><msubsup><mi>v</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\epsilon+v^{\prime}_{t,i}\geq\epsilon+\beta_{2}^{k}v^{\prime}_{t-k,i}\geq\beta_{2}^{k}(\epsilon+v^{\prime}_{t-k,i})</annotation></semantics></math> we get</span></p>
<table id="A1.EGx125" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E103"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E103.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[|E|\right]\leq\frac{1}{2}\mathbb{E}\left[\frac{\mathcal{G}_{t-k,i}^{2}}{\sqrt{\epsilon+\tilde{v}_{t,k+1,i}}}\right]+\frac{2(1+q_{G})R}{\sqrt{1-\beta_{1}}\beta_{2}^{k}}\sqrt{k+1}\mathbb{E}\left[\frac{(g_{t-k,i}+\delta_{t-k,i})^{2}}{\epsilon+v^{\prime}_{t-k,i}}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mo stretchy="false">|</mo><mi>E</mi><mo stretchy="false">|</mo></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msub><mover accent="true"><mi>v</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>,</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow></msqrt></mfrac></mstyle><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mn>2</mn><mi>k</mi></msubsup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>g</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>δ</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mi>ϵ</mi><mo>+</mo><msubsup><mi>v</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[|E|\right]\leq\frac{1}{2}\mathbb{E}\left[\frac{\mathcal{G}_{t-k,i}^{2}}{\sqrt{\epsilon+\tilde{v}_{t,k+1,i}}}\right]+\frac{2(1+q_{G})R}{\sqrt{1-\beta_{1}}\beta_{2}^{k}}\sqrt{k+1}\mathbb{E}\left[\frac{(g_{t-k,i}+\delta_{t-k,i})^{2}}{\epsilon+v^{\prime}_{t-k,i}}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.103)</span></td></tr></tbody>
</table>
<p id="A1.SS10.p4.7" class="ltx_p"><span id="A1.SS10.p4.7.1" class="ltx_text">Injecting (<a href="#A1.E103" title="In Proof. ‣ A.10 Proof of Lemma (Lower Bound on Term C) ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.103</span></a>) into (<a href="#A1.E97" title="In Proof. ‣ A.10 Proof of Lemma (Lower Bound on Term C) ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.97</span></a>) gives us</span></p>
<table id="A1.EGx126" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex114"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex114.m1" class="ltx_Math" alttext="\displaystyle\sum_{i\in[d]}\sum_{k=0}^{t-1}\beta_{1}^{k}\mathbb{E}\left[\mathcal{G}_{t-k,i}\frac{g_{t-k,i}+\delta_{t-k,i}}{\sqrt{\epsilon+v_{t,i}}}\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>g</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>δ</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></msqrt></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i\in[d]}\sum_{k=0}^{t-1}\beta_{1}^{k}\mathbb{E}\left[\mathcal{G}_{t-k,i}\frac{g_{t-k,i}+\delta_{t-k,i}}{\sqrt{\epsilon+v_{t,i}}}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E104"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E104.m1" class="ltx_Math" alttext="\displaystyle\geq\sum_{i\in[d]}\sum_{k=0}^{t-1}\beta_{1}^{k}\left(\mathbb{E}\left[\frac{\mathcal{G}_{t-k,i}^{2}}{\sqrt{\epsilon+\tilde{v}_{t,k+1,i}}}\right]-\mathbb{E}\left[|E|\right]-M_{t-k}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msub><mover accent="true"><mi>v</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>,</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow></msqrt></mfrac></mstyle><mo>]</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mo stretchy="false">|</mo><mi>E</mi><mo stretchy="false">|</mo></mrow><mo>]</mo></mrow></mrow><mo>−</mo><msub><mi>M</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\sum_{i\in[d]}\sum_{k=0}^{t-1}\beta_{1}^{k}\left(\mathbb{E}\left[\frac{\mathcal{G}_{t-k,i}^{2}}{\sqrt{\epsilon+\tilde{v}_{t,k+1,i}}}\right]-\mathbb{E}\left[|E|\right]-M_{t-k}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.104)</span></td></tr></tbody>
<tbody id="A1.Ex115"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex115.m1" class="ltx_Math" alttext="\displaystyle\geq\sum_{i\in[d]}\sum_{k=0}^{t-1}\beta_{1}^{k}\left(\mathbb{E}\left[\frac{\mathcal{G}_{t-k,i}^{2}}{\sqrt{\epsilon+\tilde{v}_{t,k+1,i}}}\right]-\left(\frac{1}{2}\mathbb{E}\left[\frac{\mathcal{G}_{t-k,i}^{2}}{\sqrt{\epsilon+\tilde{v}_{t,k,i}}}\right]+\frac{2(1+q_{G})R\sqrt{k+1}}{\sqrt{1-\beta_{1}}\beta_{2}^{k}}\mathbb{E}\left[\frac{(g_{t-k,i}+\delta_{t-k,i})^{2}}{\epsilon+v^{\prime}_{t-k,i}}\right]+M_{t-k}\right)\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msub><mover accent="true"><mi>v</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>,</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow></msqrt></mfrac></mstyle><mo>]</mo></mrow></mrow><mo>−</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msub><mover accent="true"><mi>v</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></msqrt></mfrac></mstyle><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msqrt></mrow><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mn>2</mn><mi>k</mi></msubsup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>g</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>δ</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mi>ϵ</mi><mo>+</mo><msubsup><mi>v</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow><mo>+</mo><msub><mi>M</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\sum_{i\in[d]}\sum_{k=0}^{t-1}\beta_{1}^{k}\left(\mathbb{E}\left[\frac{\mathcal{G}_{t-k,i}^{2}}{\sqrt{\epsilon+\tilde{v}_{t,k+1,i}}}\right]-\left(\frac{1}{2}\mathbb{E}\left[\frac{\mathcal{G}_{t-k,i}^{2}}{\sqrt{\epsilon+\tilde{v}_{t,k,i}}}\right]+\frac{2(1+q_{G})R\sqrt{k+1}}{\sqrt{1-\beta_{1}}\beta_{2}^{k}}\mathbb{E}\left[\frac{(g_{t-k,i}+\delta_{t-k,i})^{2}}{\epsilon+v^{\prime}_{t-k,i}}\right]+M_{t-k}\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E105"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E105.m1" class="ltx_Math" alttext="\displaystyle\geq\frac{1}{2}\left(\sum_{i\in[d]}\sum_{k=0}^{t-1}\beta_{1}^{k}\mathbb{E}\left[\frac{\mathcal{G}_{t-k,i}^{2}}{\sqrt{\epsilon+\tilde{v}_{t,k+1,i}}}\right]\right)-\frac{2(1+q_{G})R}{\sqrt{1-\beta_{1}}}\left(\sum_{i\in[d]}\sum_{k=0}^{t-1}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{k}\sqrt{k+1}\mathbb{E}\left[\|\mathbf{U}_{t-k}\|_{2}^{2}\right]\right)-d\sum_{k=0}^{t-1}\beta_{1}^{k}M_{t-k}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≥</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup><msqrt><mrow><mi>ϵ</mi><mo>+</mo><msub><mover accent="true"><mi>v</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>,</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow></msqrt></mfrac></mstyle><mo>]</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>β</mi><mn>1</mn></msub><msub><mi>β</mi><mn>2</mn></msub></mfrac></mstyle><mo>)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐔</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq\frac{1}{2}\left(\sum_{i\in[d]}\sum_{k=0}^{t-1}\beta_{1}^{k}\mathbb{E}\left[\frac{\mathcal{G}_{t-k,i}^{2}}{\sqrt{\epsilon+\tilde{v}_{t,k+1,i}}}\right]\right)-\frac{2(1+q_{G})R}{\sqrt{1-\beta_{1}}}\left(\sum_{i\in[d]}\sum_{k=0}^{t-1}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{k}\sqrt{k+1}\mathbb{E}\left[\|\mathbf{U}_{t-k}\|_{2}^{2}\right]\right)-d\sum_{k=0}^{t-1}\beta_{1}^{k}M_{t-k}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.105)</span></td></tr></tbody>
</table>
<p id="A1.SS10.p4.8" class="ltx_p"><span id="A1.SS10.p4.8.1" class="ltx_text">This is the desired lower bound for <math id="A1.SS10.p4.m11" class="ltx_Math" alttext="\mathbb{E}\left[C\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mi>C</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[C\right]</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="A1.SS11" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.11 </span>Proof of Lemma <a href="#A1.Thmtheorem10" title="Lemma A.10 (Lemma A.2 in [ ] ). ‣ A.11 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.10</span></a></h3>

<div id="A1.Thmtheorem10" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem10.2" class="ltx_text ltx_font_bold">Lemma A.10</span></span><span id="A1.Thmtheorem10.3" class="ltx_text ltx_font_bold"> </span>(Lemma A.2 in <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib8" title="" class="ltx_ref">Défossez et al. [2022]</a></cite>)<span id="A1.Thmtheorem10.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem10.p1" class="ltx_para">
<p id="A1.Thmtheorem10.p1.1" class="ltx_p"><span id="A1.Thmtheorem10.p1.1.1" class="ltx_text ltx_font_italic">Assume we have <math id="A1.Thmtheorem10.p1.m1" class="ltx_Math" alttext="0&lt;\beta_{1}&lt;\beta_{2}\leq 1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><msub><mi>β</mi><mn>1</mn></msub><mo>&lt;</mo><msub><mi>β</mi><mn>2</mn></msub><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0&lt;\beta_{1}&lt;\beta_{2}\leq 1</annotation></semantics></math> and a sequence of real numbers <math id="A1.Thmtheorem10.p1.m2" class="ltx_Math" alttext="(a_{n})_{n\in\mathbb{N}^{*}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>∈</mo><msup><mi>ℕ</mi><mo>∗</mo></msup></mrow></msub><annotation encoding="application/x-tex">(a_{n})_{n\in\mathbb{N}^{*}}</annotation></semantics></math>. We define for all <math id="A1.Thmtheorem10.p1.m3" class="ltx_Math" alttext="n\in\mathbb{N}^{*}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>∈</mo><msup><mi>ℕ</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">n\in\mathbb{N}^{*}</annotation></semantics></math>:</span></p>
<table id="A1.Ex116" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex116.m1" class="ltx_Math" alttext="b_{n}=\sum_{j=1}^{n}\beta_{2}^{n-j}a_{j}^{2}\quad\text{and}\quad c_{n}=\sum_{j=1}^{n}\beta_{1}^{n-j}a_{j}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>b</mi><mi>n</mi></msub><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msubsup><mi>β</mi><mn>2</mn><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>a</mi><mi>j</mi><mn>2</mn></msubsup></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext class="ltx_mathvariant_italic">and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mi>c</mi><mi>n</mi></msub><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msubsup><mi>β</mi><mn>1</mn><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>j</mi></msub></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">b_{n}=\sum_{j=1}^{n}\beta_{2}^{n-j}a_{j}^{2}\quad\text{and}\quad c_{n}=\sum_{j=1}^{n}\beta_{1}^{n-j}a_{j}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.Thmtheorem10.p1.2" class="ltx_p"><span id="A1.Thmtheorem10.p1.2.1" class="ltx_text ltx_font_italic">Then for any <math id="A1.Thmtheorem10.p1.m4" class="ltx_Math" alttext="\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon&gt;0</annotation></semantics></math>, we have the following inequality:</span></p>
<table id="A1.E106" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E106.m1" class="ltx_Math" alttext="\sum_{j=1}^{n}\frac{c_{j}^{2}}{\epsilon+b_{j}}\leq\frac{1}{(1-\beta_{1})(1-\beta_{1}/\beta_{2})}\left(\ln\left(1+\frac{b_{n}}{\epsilon}\right)-n\ln(\beta_{2})\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mfrac><msubsup><mi>c</mi><mi>j</mi><mn>2</mn></msubsup><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>b</mi><mi>j</mi></msub></mrow></mfrac></mrow><mo>≤</mo><mrow><mfrac><mn>1</mn><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>/</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mfrac><msub><mi>b</mi><mi>n</mi></msub><mi>ϵ</mi></mfrac></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mi>n</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{j=1}^{n}\frac{c_{j}^{2}}{\epsilon+b_{j}}\leq\frac{1}{(1-\beta_{1})(1-\beta_{1}/\beta_{2})}\left(\ln\left(1+\frac{b_{n}}{\epsilon}\right)-n\ln(\beta_{2})\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.106)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.SS11.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS11.p1" class="ltx_para">
<p id="A1.SS11.p1.1" class="ltx_p"><span id="A1.SS11.p1.1.1" class="ltx_text">First, we use Jensen’s inequality on <math id="A1.SS11.p1.m1" class="ltx_Math" alttext="c_{j}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>c</mi><mi>j</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">c_{j}^{2}</annotation></semantics></math>, noting that <math id="A1.SS11.p1.m2" class="ltx_Math" alttext="\sum_{l=1}^{j}\beta_{1}^{j-l}=\frac{1-\beta_{1}^{j}}{1-\beta_{1}}\leq\frac{1}{1-\beta_{1}}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>j</mi></msubsup><msubsup><mi>β</mi><mn>1</mn><mrow><mi>j</mi><mo>−</mo><mi>l</mi></mrow></msubsup></mrow><mo>=</mo><mfrac><mrow><mn>1</mn><mo>−</mo><msubsup><mi>β</mi><mn>1</mn><mi>j</mi></msubsup></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></mfrac><mo>≤</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></mfrac></mrow><annotation encoding="application/x-tex">\sum_{l=1}^{j}\beta_{1}^{j-l}=\frac{1-\beta_{1}^{j}}{1-\beta_{1}}\leq\frac{1}{1-\beta_{1}}</annotation></semantics></math>, to get:</span></p>
<table id="A1.EGx127" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex117"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex117.m1" class="ltx_Math" alttext="\displaystyle c_{j}^{2}=\left(\sum_{l=1}^{j}\beta_{1}^{j-l}a_{l}\right)^{2}\leq\left(\sum_{l=1}^{j}\beta_{1}^{j-l}\right)\left(\sum_{l=1}^{j}\beta_{1}^{j-l}a_{l}^{2}\right)\leq\frac{1}{1-\beta_{1}}\sum_{l=1}^{j}\beta_{1}^{j-l}a_{l}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>c</mi><mi>j</mi><mn>2</mn></msubsup><mo>=</mo><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>j</mi></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mrow><mi>j</mi><mo>−</mo><mi>l</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>l</mi></msub></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo>≤</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>j</mi></munderover></mstyle><msubsup><mi>β</mi><mn>1</mn><mrow><mi>j</mi><mo>−</mo><mi>l</mi></mrow></msubsup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>j</mi></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mrow><mi>j</mi><mo>−</mo><mi>l</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>a</mi><mi>l</mi><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>j</mi></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mrow><mi>j</mi><mo>−</mo><mi>l</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>a</mi><mi>l</mi><mn>2</mn></msubsup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle c_{j}^{2}=\left(\sum_{l=1}^{j}\beta_{1}^{j-l}a_{l}\right)^{2}\leq\left(\sum_{l=1}^{j}\beta_{1}^{j-l}\right)\left(\sum_{l=1}^{j}\beta_{1}^{j-l}a_{l}^{2}\right)\leq\frac{1}{1-\beta_{1}}\sum_{l=1}^{j}\beta_{1}^{j-l}a_{l}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS11.p1.2" class="ltx_p"><span id="A1.SS11.p1.2.1" class="ltx_text">Dividing by <math id="A1.SS11.p1.m3" class="ltx_Math" alttext="\epsilon+b_{j}" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>b</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">\epsilon+b_{j}</annotation></semantics></math> and using the fact that for <math id="A1.SS11.p1.m4" class="ltx_Math" alttext="l\leq j" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>≤</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">l\leq j</annotation></semantics></math>, <math id="A1.SS11.p1.m5" class="ltx_Math" alttext="b_{j}\geq\beta_{2}^{j-l}b_{l}" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mi>j</mi></msub><mo>≥</mo><mrow><msubsup><mi>β</mi><mn>2</mn><mrow><mi>j</mi><mo>−</mo><mi>l</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>l</mi></msub></mrow></mrow><annotation encoding="application/x-tex">b_{j}\geq\beta_{2}^{j-l}b_{l}</annotation></semantics></math>, which implies <math id="A1.SS11.p1.m6" class="ltx_Math" alttext="\epsilon+b_{j}\geq\beta_{2}^{j-l}(\epsilon+b_{l})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>b</mi><mi>j</mi></msub></mrow><mo>≥</mo><mrow><msubsup><mi>β</mi><mn>2</mn><mrow><mi>j</mi><mo>−</mo><mi>l</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>b</mi><mi>l</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\epsilon+b_{j}\geq\beta_{2}^{j-l}(\epsilon+b_{l})</annotation></semantics></math>, we obtain:</span></p>
<table id="A1.EGx128" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E107"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E107.m1" class="ltx_Math" alttext="\displaystyle\frac{c_{j}^{2}}{\epsilon+b_{j}}\leq\frac{1}{1-\beta_{1}}\sum_{l=1}^{j}\beta_{1}^{j-l}\frac{a_{l}^{2}}{\epsilon+b_{j}}\leq\frac{1}{1-\beta_{1}}\sum_{l=1}^{j}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{j-l}\frac{a_{l}^{2}}{\epsilon+b_{l}}." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>c</mi><mi>j</mi><mn>2</mn></msubsup><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>b</mi><mi>j</mi></msub></mrow></mfrac></mstyle><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>j</mi></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mrow><mi>j</mi><mo>−</mo><mi>l</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>a</mi><mi>l</mi><mn>2</mn></msubsup><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>b</mi><mi>j</mi></msub></mrow></mfrac></mstyle></mrow></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>j</mi></munderover></mstyle><mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>β</mi><mn>1</mn></msub><msub><mi>β</mi><mn>2</mn></msub></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>j</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>a</mi><mi>l</mi><mn>2</mn></msubsup><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>b</mi><mi>l</mi></msub></mrow></mfrac></mstyle></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{c_{j}^{2}}{\epsilon+b_{j}}\leq\frac{1}{1-\beta_{1}}\sum_{l=1}^{j}\beta_{1}^{j-l}\frac{a_{l}^{2}}{\epsilon+b_{j}}\leq\frac{1}{1-\beta_{1}}\sum_{l=1}^{j}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{j-l}\frac{a_{l}^{2}}{\epsilon+b_{l}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.107)</span></td></tr></tbody>
</table>
<p id="A1.SS11.p1.3" class="ltx_p"><span id="A1.SS11.p1.3.1" class="ltx_text">Now, we sum over <math id="A1.SS11.p1.m7" class="ltx_Math" alttext="j\in[n]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[n]</annotation></semantics></math> and swap the order of summation:</span></p>
<table id="A1.EGx129" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex118"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex118.m1" class="ltx_Math" alttext="\displaystyle\sum_{j=1}^{n}\frac{c_{j}^{2}}{\epsilon+b_{j}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><msubsup><mi>c</mi><mi>j</mi><mn>2</mn></msubsup><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>b</mi><mi>j</mi></msub></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{j=1}^{n}\frac{c_{j}^{2}}{\epsilon+b_{j}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex118.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{1}{1-\beta_{1}}\sum_{j=1}^{n}\sum_{l=1}^{j}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{j-l}\frac{a_{l}^{2}}{\epsilon+b_{l}}=\frac{1}{1-\beta_{1}}\sum_{l=1}^{n}\frac{a_{l}^{2}}{\epsilon+b_{l}}\sum_{j=l}^{n}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{j-l}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>j</mi></munderover></mstyle><mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>β</mi><mn>1</mn></msub><msub><mi>β</mi><mn>2</mn></msub></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>j</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>a</mi><mi>l</mi><mn>2</mn></msubsup><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>b</mi><mi>l</mi></msub></mrow></mfrac></mstyle></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>a</mi><mi>l</mi><mn>2</mn></msubsup><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>b</mi><mi>l</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mi>l</mi></mrow><mi>n</mi></munderover></mstyle><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>β</mi><mn>1</mn></msub><msub><mi>β</mi><mn>2</mn></msub></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>j</mi><mo>−</mo><mi>l</mi></mrow></msup></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{1-\beta_{1}}\sum_{j=1}^{n}\sum_{l=1}^{j}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{j-l}\frac{a_{l}^{2}}{\epsilon+b_{l}}=\frac{1}{1-\beta_{1}}\sum_{l=1}^{n}\frac{a_{l}^{2}}{\epsilon+b_{l}}\sum_{j=l}^{n}\left(\frac{\beta_{1}}{\beta_{2}}\right)^{j-l}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E108"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E108.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{1}{(1-\beta_{1})(1-\beta_{1}/\beta_{2})}\sum_{l=1}^{n}\frac{a_{l}^{2}}{\epsilon+b_{l}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>/</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><msubsup><mi>a</mi><mi>l</mi><mn>2</mn></msubsup><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>b</mi><mi>l</mi></msub></mrow></mfrac></mstyle></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{(1-\beta_{1})(1-\beta_{1}/\beta_{2})}\sum_{l=1}^{n}\frac{a_{l}^{2}}{\epsilon+b_{l}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.108)</span></td></tr></tbody>
</table>
<p id="A1.SS11.p1.4" class="ltx_p"><span id="A1.SS11.p1.4.1" class="ltx_text">where the last step uses the sum of a geometric series, since <math id="A1.SS11.p1.m8" class="ltx_Math" alttext="\beta_{1}/\beta_{2}&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>/</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\beta_{1}/\beta_{2}&lt;1</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS11.p2" class="ltx_para">
<p id="A1.SS11.p2.1" class="ltx_p"><span id="A1.SS11.p2.1.1" class="ltx_text">The next step is to bound the final sum. Let’s denote <math id="A1.SS11.p2.m1" class="ltx_Math" alttext="x_{l}=a_{l}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>l</mi></msub><mo>=</mo><msubsup><mi>a</mi><mi>l</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">x_{l}=a_{l}^{2}</annotation></semantics></math>. The sum is <math id="A1.SS11.p2.m2" class="ltx_Math" alttext="\sum_{l=1}^{n}\frac{x_{l}}{\epsilon+b_{l}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mfrac><msub><mi>x</mi><mi>l</mi></msub><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>b</mi><mi>l</mi></msub></mrow></mfrac></mrow><annotation encoding="application/x-tex">\sum_{l=1}^{n}\frac{x_{l}}{\epsilon+b_{l}}</annotation></semantics></math>, where <math id="A1.SS11.p2.m3" class="ltx_Math" alttext="b_{l}=\sum_{k=1}^{l}\beta_{2}^{l-k}x_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mi>l</mi></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>l</mi></msubsup><mrow><msubsup><mi>β</mi><mn>2</mn><mrow><mi>l</mi><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>k</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">b_{l}=\sum_{k=1}^{l}\beta_{2}^{l-k}x_{k}</annotation></semantics></math>. Note that <math id="A1.SS11.p2.m4" class="ltx_Math" alttext="b_{l}-x_{l}=\beta_{2}b_{l-1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>b</mi><mi>l</mi></msub><mo>−</mo><msub><mi>x</mi><mi>l</mi></msub></mrow><mo>=</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">b_{l}-x_{l}=\beta_{2}b_{l-1}</annotation></semantics></math> (with <math id="A1.SS11.p2.m5" class="ltx_Math" alttext="b_{0}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mn>0</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">b_{0}=0</annotation></semantics></math>). Using the inequality <math id="A1.SS11.p2.m6" class="ltx_Math" alttext="\frac{x}{y}\leq\ln(y)-\ln(y-x)" display="inline" intent=":literal"><semantics><mrow><mfrac><mi>x</mi><mi>y</mi></mfrac><mo>≤</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{x}{y}\leq\ln(y)-\ln(y-x)</annotation></semantics></math> for <math id="A1.SS11.p2.m7" class="ltx_Math" alttext="0&lt;x&lt;y" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>x</mi><mo>&lt;</mo><mi>y</mi></mrow><annotation encoding="application/x-tex">0&lt;x&lt;y</annotation></semantics></math>, we have:</span></p>
<table id="A1.EGx130" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex119"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex119.m1" class="ltx_Math" alttext="\displaystyle\frac{x_{l}}{\epsilon+b_{l}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><msub><mi>x</mi><mi>l</mi></msub><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>b</mi><mi>l</mi></msub></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{x_{l}}{\epsilon+b_{l}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex119.m2" class="ltx_Math" alttext="\displaystyle\leq\ln(\epsilon+b_{l})-\ln(\epsilon+b_{l}-x_{l})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>b</mi><mi>l</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>b</mi><mi>l</mi></msub></mrow><mo>−</mo><msub><mi>x</mi><mi>l</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\ln(\epsilon+b_{l})-\ln(\epsilon+b_{l}-x_{l})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex120"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex120.m1" class="ltx_Math" alttext="\displaystyle=\ln(\epsilon+b_{l})-\ln(\epsilon+\beta_{2}b_{l-1})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>b</mi><mi>l</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\ln(\epsilon+b_{l})-\ln(\epsilon+\beta_{2}b_{l-1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex121"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex121.m1" class="ltx_Math" alttext="\displaystyle=\ln\left(\frac{\epsilon+b_{l}}{\epsilon+b_{l-1}}\right)+\ln\left(\frac{\epsilon+b_{l-1}}{\epsilon+\beta_{2}b_{l-1}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>b</mi><mi>l</mi></msub></mrow><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>b</mi><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>b</mi><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mrow><mi>ϵ</mi><mo>+</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\ln\left(\frac{\epsilon+b_{l}}{\epsilon+b_{l-1}}\right)+\ln\left(\frac{\epsilon+b_{l-1}}{\epsilon+\beta_{2}b_{l-1}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS11.p2.2" class="ltx_p"><span id="A1.SS11.p2.2.1" class="ltx_text">Summing from <math id="A1.SS11.p2.m8" class="ltx_Math" alttext="l=1" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">l=1</annotation></semantics></math> to <math id="A1.SS11.p2.m9" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>, the first term forms a telescoping series equal to <math id="A1.SS11.p2.m10" class="ltx_Math" alttext="\ln(\epsilon+b_{n})-\ln(\epsilon)=\ln(1+b_{n}/\epsilon)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>b</mi><mi>n</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>b</mi><mi>n</mi></msub><mo>/</mo><mi>ϵ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\ln(\epsilon+b_{n})-\ln(\epsilon)=\ln(1+b_{n}/\epsilon)</annotation></semantics></math>. For the second term, since <math id="A1.SS11.p2.m11" class="ltx_Math" alttext="\beta_{2}\leq 1" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>2</mn></msub><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\beta_{2}\leq 1</annotation></semantics></math> and <math id="A1.SS11.p2.m12" class="ltx_Math" alttext="b_{l-1}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">b_{l-1}\geq 0</annotation></semantics></math>, we have <math id="A1.SS11.p2.m13" class="ltx_Math" alttext="\frac{\epsilon+\beta_{2}b_{l-1}}{\epsilon+b_{l-1}}\geq\beta_{2}" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><mi>ϵ</mi><mo>+</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>b</mi><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mfrac><mo>≥</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\frac{\epsilon+\beta_{2}b_{l-1}}{\epsilon+b_{l-1}}\geq\beta_{2}</annotation></semantics></math>, which implies <math id="A1.SS11.p2.m14" class="ltx_Math" alttext="\ln\left(\frac{\epsilon+b_{l-1}}{\epsilon+\beta_{2}b_{l-1}}\right)\leq-\ln(\beta_{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>b</mi><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mrow><mi>ϵ</mi><mo>+</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></mfrac><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mo rspace="0.167em">−</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\ln\left(\frac{\epsilon+b_{l-1}}{\epsilon+\beta_{2}b_{l-1}}\right)\leq-\ln(\beta_{2})</annotation></semantics></math>. Thus, summing over <math id="A1.SS11.p2.m15" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> gives:</span></p>
<table id="A1.E109" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E109.m1" class="ltx_Math" alttext="\sum_{l=1}^{n}\frac{a_{l}^{2}}{\epsilon+b_{l}}\leq\ln\left(1+\frac{b_{n}}{\epsilon}\right)-n\ln(\beta_{2})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mfrac><msubsup><mi>a</mi><mi>l</mi><mn>2</mn></msubsup><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>b</mi><mi>l</mi></msub></mrow></mfrac></mrow><mo>≤</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mfrac><msub><mi>b</mi><mi>n</mi></msub><mi>ϵ</mi></mfrac></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mi>n</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{l=1}^{n}\frac{a_{l}^{2}}{\epsilon+b_{l}}\leq\ln\left(1+\frac{b_{n}}{\epsilon}\right)-n\ln(\beta_{2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.109)</span></td></tr></tbody>
</table>
<p id="A1.SS11.p2.3" class="ltx_p"><span id="A1.SS11.p2.3.1" class="ltx_text">This inequality is a useful result in itself, corresponding to the special case where <math id="A1.SS11.p2.m16" class="ltx_Math" alttext="c_{j}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>c</mi><mi>j</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">c_{j}^{2}</annotation></semantics></math> is replaced by <math id="A1.SS11.p2.m17" class="ltx_Math" alttext="a_{j}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>a</mi><mi>j</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">a_{j}^{2}</annotation></semantics></math> (or equivalently <math id="A1.SS11.p2.m18" class="ltx_Math" alttext="\beta_{1}\to 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>1</mn></msub><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\beta_{1}\to 0</annotation></semantics></math> and <math id="A1.SS11.p2.m19" class="ltx_Math" alttext="a_{j}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>j</mi></msub><annotation encoding="application/x-tex">a_{j}</annotation></semantics></math> is replaced by <math id="A1.SS11.p2.m20" class="ltx_Math" alttext="a_{j}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>a</mi><mi>j</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">a_{j}^{2}</annotation></semantics></math>).</span></p>
</div>
<div id="A1.SS11.p3" class="ltx_para">
<p id="A1.SS11.p3.1" class="ltx_p"><span id="A1.SS11.p3.1.1" class="ltx_text">Finally, substituting the bound from (<a href="#A1.E109" title="In Proof. ‣ A.11 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.109</span></a>) into (<a href="#A1.E108" title="In Proof. ‣ A.11 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.108</span></a>) yields the desired result.
∎</span></p>
</div>
</div>
</section>
<section id="A1.SS12" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.12 </span>Proof of Lemma <a href="#A1.Thmtheorem11" title="Lemma A.11 (Lemma A.3 in [ ] ). ‣ A.12 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.11</span></a></h3>

<div id="A1.Thmtheorem11" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem11.2" class="ltx_text ltx_font_bold">Lemma A.11</span></span><span id="A1.Thmtheorem11.3" class="ltx_text ltx_font_bold"> </span>(Lemma A.3 in <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib8" title="" class="ltx_ref">Défossez et al. [2022]</a></cite>)<span id="A1.Thmtheorem11.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem11.p1" class="ltx_para">
<p id="A1.Thmtheorem11.p1.1" class="ltx_p"><span id="A1.Thmtheorem11.p1.1.1" class="ltx_text ltx_font_italic">For any scalar <math id="A1.Thmtheorem11.p1.m1" class="ltx_Math" alttext="\rho\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho\in(0,1)</annotation></semantics></math> and any integer <math id="A1.Thmtheorem11.p1.m2" class="ltx_Math" alttext="K\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">K\in\mathbb{N}</annotation></semantics></math>, the following bound holds for the finite geometric sum:</span></p>
<table id="A1.E110" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E110.m1" class="ltx_Math" alttext="\sum_{k=0}^{K-1}\rho^{k}\sqrt{k+1}\leq\frac{2}{(1-\rho)^{3/2}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><msup><mi>ρ</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msqrt></mrow></mrow><mo>≤</mo><mfrac><mn>2</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{k=0}^{K-1}\rho^{k}\sqrt{k+1}\leq\frac{2}{(1-\rho)^{3/2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.110)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.SS12.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS12.p1" class="ltx_para">
<p id="A1.SS12.p1.1" class="ltx_p"><span id="A1.SS12.p1.1.1" class="ltx_text">Let the sum be denoted by <math id="A1.SS12.p1.m1" class="ltx_Math" alttext="S_{K}=\sum_{k=0}^{K-1}\rho^{k}\sqrt{k+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>K</mi></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><msup><mi>ρ</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msqrt></mrow></mrow></mrow><annotation encoding="application/x-tex">S_{K}=\sum_{k=0}^{K-1}\rho^{k}\sqrt{k+1}</annotation></semantics></math>. We analyze the term <math id="A1.SS12.p1.m2" class="ltx_Math" alttext="(1-\rho)S_{K}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>K</mi></msub></mrow><annotation encoding="application/x-tex">(1-\rho)S_{K}</annotation></semantics></math>:</span></p>
<table id="A1.EGx131" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex122"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex122.m1" class="ltx_Math" alttext="\displaystyle(1-\rho)S_{K}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>K</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle(1-\rho)S_{K}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex122.m2" class="ltx_Math" alttext="\displaystyle=\sum_{k=0}^{K-1}\rho^{k}\sqrt{k+1}-\sum_{j=1}^{K}\rho^{j}\sqrt{j}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>ρ</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msqrt></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mrow><msup><mi>ρ</mi><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>j</mi></msqrt></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k=0}^{K-1}\rho^{k}\sqrt{k+1}-\sum_{j=1}^{K}\rho^{j}\sqrt{j}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex123"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex123.m1" class="ltx_Math" alttext="\displaystyle=1+\sum_{k=1}^{K-1}\rho^{k}(\sqrt{k+1}-\sqrt{k})-\rho^{K}\sqrt{K}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>ρ</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msqrt><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msqrt><mo>−</mo><msqrt><mi>k</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msup><mi>ρ</mi><mi>K</mi></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>K</mi></msqrt></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=1+\sum_{k=1}^{K-1}\rho^{k}(\sqrt{k+1}-\sqrt{k})-\rho^{K}\sqrt{K}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS12.p1.2" class="ltx_p"><span id="A1.SS12.p1.2.1" class="ltx_text">By the concavity of the square root function, <math id="A1.SS12.p1.m3" class="ltx_Math" alttext="\sqrt{k+1}-\sqrt{k}\leq\frac{1}{2\sqrt{k}}" display="inline" intent=":literal"><semantics><mrow><mrow><msqrt><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msqrt><mo>−</mo><msqrt><mi>k</mi></msqrt></mrow><mo>≤</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>k</mi></msqrt></mrow></mfrac></mrow><annotation encoding="application/x-tex">\sqrt{k+1}-\sqrt{k}\leq\frac{1}{2\sqrt{k}}</annotation></semantics></math>. This implies:</span></p>
<table id="A1.EGx132" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex124"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex124.m1" class="ltx_Math" alttext="\displaystyle(1-\rho)S_{K}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>K</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle(1-\rho)S_{K}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex124.m2" class="ltx_Math" alttext="\displaystyle\leq 1+\sum_{k=1}^{K-1}\frac{\rho^{k}}{2\sqrt{k}}\leq 1+\int_{0}^{\infty}\frac{\rho^{t}}{2\sqrt{t}}\mathrm{d}t." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mstyle displaystyle="true"><mfrac><msup><mi>ρ</mi><mi>k</mi></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>k</mi></msqrt></mrow></mfrac></mstyle></mrow></mrow><mo>≤</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi mathvariant="normal">∞</mi></msubsup></mstyle><mrow><mstyle displaystyle="true"><mfrac><msup><mi>ρ</mi><mi>t</mi></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>t</mi></msqrt></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 1+\sum_{k=1}^{K-1}\frac{\rho^{k}}{2\sqrt{k}}\leq 1+\int_{0}^{\infty}\frac{\rho^{t}}{2\sqrt{t}}\mathrm{d}t.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS12.p1.3" class="ltx_p"><span id="A1.SS12.p1.3.1" class="ltx_text">The integral is a standard Gaussian integral form which evaluates to <math id="A1.SS12.p1.m4" class="ltx_Math" alttext="\frac{\sqrt{\pi}}{2\sqrt{-\ln(\rho)}}" display="inline" intent=":literal"><semantics><mfrac><msqrt><mi>π</mi></msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mo rspace="0.167em">−</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt></mrow></mfrac><annotation encoding="application/x-tex">\frac{\sqrt{\pi}}{2\sqrt{-\ln(\rho)}}</annotation></semantics></math>. Using the inequality <math id="A1.SS12.p1.m5" class="ltx_Math" alttext="-\ln(\rho)\geq 1-\rho" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">−</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow></mrow><annotation encoding="application/x-tex">-\ln(\rho)\geq 1-\rho</annotation></semantics></math>, we have:</span></p>
<table id="A1.EGx133" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex125"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex125.m1" class="ltx_Math" alttext="\displaystyle(1-\rho)S_{K}\leq 1+\frac{\sqrt{\pi}}{2\sqrt{1-\rho}}\leq\frac{2}{\sqrt{1-\rho}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>K</mi></msub></mrow><mo>≤</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><msqrt><mi>π</mi></msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow></msqrt></mrow></mfrac></mstyle></mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><msqrt><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow></msqrt></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle(1-\rho)S_{K}\leq 1+\frac{\sqrt{\pi}}{2\sqrt{1-\rho}}\leq\frac{2}{\sqrt{1-\rho}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS12.p1.4" class="ltx_p"><span id="A1.SS12.p1.4.1" class="ltx_text">Dividing by <math id="A1.SS12.p1.m6" class="ltx_Math" alttext="(1-\rho)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1-\rho)</annotation></semantics></math> yields the desired result.
∎</span></p>
</div>
</div>
</section>
<section id="A1.SS13" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.13 </span>Proof of Lemma <a href="#A1.Thmtheorem12" title="Lemma A.12 (Lemma A.4 in [ ] ). ‣ A.13 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.12</span></a></h3>

<div id="A1.Thmtheorem12" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem12.2" class="ltx_text ltx_font_bold">Lemma A.12</span></span><span id="A1.Thmtheorem12.3" class="ltx_text ltx_font_bold"> </span>(Lemma A.4 in <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib8" title="" class="ltx_ref">Défossez et al. [2022]</a></cite>)<span id="A1.Thmtheorem12.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem12.p1" class="ltx_para">
<p id="A1.Thmtheorem12.p1.1" class="ltx_p"><span id="A1.Thmtheorem12.p1.1.1" class="ltx_text ltx_font_italic">For any scalar <math id="A1.Thmtheorem12.p1.m1" class="ltx_Math" alttext="\rho\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho\in(0,1)</annotation></semantics></math> and any integer <math id="A1.Thmtheorem12.p1.m2" class="ltx_Math" alttext="K\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">K\in\mathbb{N}</annotation></semantics></math>, the following bound holds:</span></p>
<table id="A1.E111" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E111.m1" class="ltx_Math" alttext="\sum_{k=0}^{K-1}\rho^{k}\sqrt{k}(k+1)\leq\frac{4\rho}{(1-\rho)^{5/2}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><msup><mi>ρ</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>k</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>5</mn><mo>/</mo><mn>2</mn></mrow></msup></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{k=0}^{K-1}\rho^{k}\sqrt{k}(k+1)\leq\frac{4\rho}{(1-\rho)^{5/2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.111)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.SS13.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS13.p1" class="ltx_para">
<p id="A1.SS13.p1.1" class="ltx_p"><span id="A1.SS13.p1.1.1" class="ltx_text">Let the sum be denoted by <math id="A1.SS13.p1.m1" class="ltx_Math" alttext="S_{K}=\sum_{k=0}^{K-1}\rho^{k}\sqrt{k}(k+1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>K</mi></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><msup><mi>ρ</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>k</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">S_{K}=\sum_{k=0}^{K-1}\rho^{k}\sqrt{k}(k+1)</annotation></semantics></math>. We proceed by analyzing <math id="A1.SS13.p1.m2" class="ltx_Math" alttext="(1-\rho)S_{K}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>K</mi></msub></mrow><annotation encoding="application/x-tex">(1-\rho)S_{K}</annotation></semantics></math>:</span></p>
<table id="A1.EGx134" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex126"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex126.m1" class="ltx_Math" alttext="\displaystyle(1-\rho)S_{K}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>K</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle(1-\rho)S_{K}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex126.m2" class="ltx_Math" alttext="\displaystyle=\sum_{k=1}^{K-1}\rho^{k}\left[\sqrt{k}(k+1)-k\sqrt{k-1}\right]-\rho^{K}k\sqrt{K-1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>ρ</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msqrt><mi>k</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msqrt></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>−</mo><mrow><msup><mi>ρ</mi><mi>K</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msqrt></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k=1}^{K-1}\rho^{k}\left[\sqrt{k}(k+1)-k\sqrt{k-1}\right]-\rho^{K}k\sqrt{K-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex127"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex127.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{k=1}^{K-1}\rho^{k}(2\sqrt{k})," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>ρ</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>k</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{k=1}^{K-1}\rho^{k}(2\sqrt{k}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS13.p1.2" class="ltx_p"><span id="A1.SS13.p1.2.1" class="ltx_text">where the inequality holds because <math id="A1.SS13.p1.m3" class="ltx_Math" alttext="\sqrt{k}(k+1)-k\sqrt{k-1}\leq 2\sqrt{k}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msqrt><mi>k</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msqrt></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>k</mi></msqrt></mrow></mrow><annotation encoding="application/x-tex">\sqrt{k}(k+1)-k\sqrt{k-1}\leq 2\sqrt{k}</annotation></semantics></math>. Re-indexing the sum gives:</span></p>
<table id="A1.EGx135" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex128"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex128.m1" class="ltx_Math" alttext="\displaystyle(1-\rho)S_{K}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>K</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle(1-\rho)S_{K}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex128.m2" class="ltx_Math" alttext="\displaystyle\leq 2\rho\sum_{k=1}^{K-1}\rho^{k-1}\sqrt{k}=2\rho\sum_{j=0}^{K-2}\rho^{j}\sqrt{j+1}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>ρ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>k</mi></msqrt></mrow></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>K</mi><mo>−</mo><mn>2</mn></mrow></munderover></mstyle><mrow><msup><mi>ρ</mi><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msqrt></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\rho\sum_{k=1}^{K-1}\rho^{k-1}\sqrt{k}=2\rho\sum_{j=0}^{K-2}\rho^{j}\sqrt{j+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS13.p1.3" class="ltx_p"><span id="A1.SS13.p1.3.1" class="ltx_text">Applying the result from Lemma <a href="#A1.Thmtheorem11" title="Lemma A.11 (Lemma A.3 in [ ] ). ‣ A.12 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.11</span></a> to the final sum, we get:</span></p>
<table id="A1.EGx136" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex129"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex129.m1" class="ltx_Math" alttext="\displaystyle(1-\rho)S_{K}\leq 2\rho\left(\frac{2}{(1-\rho)^{3/2}}\right)=\frac{4\rho}{(1-\rho)^{3/2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>K</mi></msub></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle(1-\rho)S_{K}\leq 2\rho\left(\frac{2}{(1-\rho)^{3/2}}\right)=\frac{4\rho}{(1-\rho)^{3/2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS13.p1.4" class="ltx_p"><span id="A1.SS13.p1.4.1" class="ltx_text">Dividing both sides by <math id="A1.SS13.p1.m4" class="ltx_Math" alttext="(1-\rho)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1-\rho)</annotation></semantics></math> completes the proof.
∎</span></p>
</div>
</div>
</section>
<section id="A1.SS14" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.14 </span>Proof of Lemma <a href="#A1.Thmtheorem13" title="Lemma A.13 (Upper bound of ∑_{𝑡=1}^𝑇𝔼[‖𝐮_𝑡‖^2_2]). ‣ A.14 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.13</span></a></h3>

<div id="A1.Thmtheorem13" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem13.2" class="ltx_text ltx_font_bold">Lemma A.13</span></span><span id="A1.Thmtheorem13.3" class="ltx_text ltx_font_bold"> </span>(Upper bound of <math id="A1.Thmtheorem13.m1" class="ltx_Math" alttext="\sum_{t=1}^{T}\mathbb{E}\left[\|\mathbf{u}_{t}\|^{2}_{2}\right]" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐮</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{t=1}^{T}\mathbb{E}\left[\|\mathbf{u}_{t}\|^{2}_{2}\right]</annotation></semantics></math>)<span id="A1.Thmtheorem13.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem13.p1" class="ltx_para">
<p id="A1.Thmtheorem13.p1.1" class="ltx_p"><span id="A1.Thmtheorem13.p1.1.1" class="ltx_text ltx_font_italic">Under the condition that <math id="A1.Thmtheorem13.p1.m1" class="ltx_Math" alttext="\beta_{1}(1+q_{M})&lt;\beta_{2}(1-q_{V})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>β</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta_{1}(1+q_{M})&lt;\beta_{2}(1-q_{V})</annotation></semantics></math>, the expected sum of squared updates over <math id="A1.Thmtheorem13.p1.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> iterations is bounded by:</span></p>
<table id="A1.EGx137" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex130"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex130.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=1}^{T}\mathbb{E}\left[\|\mathbf{u}_{t}\|^{2}_{2}\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐮</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{T}\mathbb{E}\left[\|\mathbf{u}_{t}\|^{2}_{2}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex130.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{d}{(1-\beta_{1}(1+q_{M}))(1-\frac{\beta_{1}(1+q_{M})}{\beta_{2}(1-q_{V})})}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>β</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><msub><mi>β</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{d}{(1-\beta_{1}(1+q_{M}))(1-\frac{\beta_{1}(1+q_{M})}{\beta_{2}(1-q_{V})})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E112"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E112.m1" class="ltx_Math" alttext="\displaystyle\quad\times\left(\ln\left(1+\frac{((1+q_{G})R)^{2}}{\epsilon(1-\beta_{2}(1-q_{V}))}\right)-T\ln(\beta_{2}(1-q_{V}))\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="1.222em" rspace="0.222em">×</mo><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mi>ϵ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\times\left(\ln\left(1+\frac{((1+q_{G})R)^{2}}{\epsilon(1-\beta_{2}(1-q_{V}))}\right)-T\ln(\beta_{2}(1-q_{V}))\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.112)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.SS14.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS14.p1" class="ltx_para">
<p id="A1.SS14.p1.1" class="ltx_p"><span id="A1.SS14.p1.1.1" class="ltx_text">The proof proceeds by first expanding the term of interest, applying bounds on the moment estimates derived from their recurrence relations, and then leveraging Lemma <a href="#A1.Thmtheorem10" title="Lemma A.10 (Lemma A.2 in [ ] ). ‣ A.11 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.10</span></a> to bound the resulting sum.</span></p>
</div>
<div id="A1.SS14.p2" class="ltx_para">
<p id="A1.SS14.p2.1" class="ltx_p"><span id="A1.SS14.p2.1.1" class="ltx_text">We begin by expanding the definition of <math id="A1.SS14.p2.m1" class="ltx_Math" alttext="\|\mathbf{u}_{t}\|_{2}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐮</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><annotation encoding="application/x-tex">\|\mathbf{u}_{t}\|_{2}^{2}</annotation></semantics></math>, separating the sum over the dimension <math id="A1.SS14.p2.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, and taking the expectation:</span></p>
<table id="A1.EGx138" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E113"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E113.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=1}^{T}\mathbb{E}\left[\|\mathbf{u}_{t}\|^{2}_{2}\right]=\sum_{t=1}^{T}\mathbb{E}\left[\sum_{i\in[d]}\frac{m^{2}_{t,i}}{\epsilon+v_{t,i}}\right]=\sum_{i\in[d]}\sum_{t=1}^{T}\mathbb{E}\left[\frac{m^{2}_{t,i}}{\epsilon+v_{t,i}}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐮</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mstyle displaystyle="true"><mfrac><msubsup><mi>m</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>m</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{T}\mathbb{E}\left[\|\mathbf{u}_{t}\|^{2}_{2}\right]=\sum_{t=1}^{T}\mathbb{E}\left[\sum_{i\in[d]}\frac{m^{2}_{t,i}}{\epsilon+v_{t,i}}\right]=\sum_{i\in[d]}\sum_{t=1}^{T}\mathbb{E}\left[\frac{m^{2}_{t,i}}{\epsilon+v_{t,i}}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.113)</span></td></tr></tbody>
</table>
<p id="A1.SS14.p2.2" class="ltx_p"><span id="A1.SS14.p2.2.1" class="ltx_text">For each coordinate <math id="A1.SS14.p2.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, we bound the numerator <math id="A1.SS14.p2.m4" class="ltx_Math" alttext="m_{t,i}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>m</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup><annotation encoding="application/x-tex">m_{t,i}^{2}</annotation></semantics></math> from above and the denominator <math id="A1.SS14.p2.m5" class="ltx_Math" alttext="\epsilon+v_{t,i}" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\epsilon+v_{t,i}</annotation></semantics></math> from below. By unrolling the recurrence for <math id="A1.SS14.p2.m6" class="ltx_Math" alttext="m_{t,i}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">m_{t,i}</annotation></semantics></math> and applying the triangle inequality along with the relative error model, we get an upper bound on its magnitude:</span></p>
<table id="A1.EGx139" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E114"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E114.m1" class="ltx_Math" alttext="\displaystyle|m_{t,i}|\leq\sum_{k=1}^{t}\beta_{1}^{t-k}(1+q_{M})^{t-k}|\nabla_{i}f_{k}(\mathbf{w}_{k-1})+\delta_{k,i}|." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><msub><mi>m</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><msub><mi>f</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>δ</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle|m_{t,i}|\leq\sum_{k=1}^{t}\beta_{1}^{t-k}(1+q_{M})^{t-k}|\nabla_{i}f_{k}(\mathbf{w}_{k-1})+\delta_{k,i}|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.114)</span></td></tr></tbody>
</table>
<p id="A1.SS14.p2.3" class="ltx_p"><span id="A1.SS14.p2.3.1" class="ltx_text">For the denominator, Lemma <a href="#A1.Thmtheorem2" title="Lemma A.2 (The value range of 𝑣_{𝑡,𝑖} and the upper bound of |{1/√{ϵ+𝑣_{𝑡,𝑖}}}-{1/√{ϵ+𝑣^′_{𝑡,𝑖}}}|). ‣ A.3 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2</span></a> provides a lower bound for <math id="A1.SS14.p2.m7" class="ltx_Math" alttext="v_{t,i}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">v_{t,i}</annotation></semantics></math>:</span></p>
<table id="A1.EGx140" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E115"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E115.m1" class="ltx_Math" alttext="\displaystyle v_{t,i}\geq\sum_{k=1}^{t}\beta_{2}^{t-k}(1-q_{V})^{t-k}(\nabla_{i}f_{k}(\mathbf{w}_{k-1})+\delta_{k,i})^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>≥</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>2</mn><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><msub><mi>f</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>δ</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle v_{t,i}\geq\sum_{k=1}^{t}\beta_{2}^{t-k}(1-q_{V})^{t-k}(\nabla_{i}f_{k}(\mathbf{w}_{k-1})+\delta_{k,i})^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.115)</span></td></tr></tbody>
</table>
<p id="A1.SS14.p2.4" class="ltx_p"><span id="A1.SS14.p2.4.1" class="ltx_text">Substituting these into the sum gives the inequality:</span></p>
<table id="A1.EGx141" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E116"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E116.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=1}^{T}\mathbb{E}\left[\|\mathbf{u}_{t}\|^{2}_{2}\right]\leq\sum_{i\in[d]}\sum_{t=1}^{T}\mathbb{E}\left[\frac{\left(\sum_{k=1}^{t}\beta_{1}^{t-k}(1+q_{M})^{t-k}|\hat{g}_{k,i}|\right)^{2}}{\epsilon+\sum_{k=1}^{t}\beta_{2}^{t-k}(1-q_{V})^{t-k}\hat{g}_{k,i}^{2}}\right]," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐮</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo>(</mo><mrow><msubsup><mo lspace="0em">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></msubsup><mrow><msubsup><mi>β</mi><mn>1</mn><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mover accent="true"><mi>g</mi><mo>^</mo></mover><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">|</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><mrow><mi>ϵ</mi><mo rspace="0.055em">+</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></msubsup><mrow><msubsup><mi>β</mi><mn>2</mn><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>g</mi><mo>^</mo></mover><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup></mrow></mrow></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{T}\mathbb{E}\left[\|\mathbf{u}_{t}\|^{2}_{2}\right]\leq\sum_{i\in[d]}\sum_{t=1}^{T}\mathbb{E}\left[\frac{\left(\sum_{k=1}^{t}\beta_{1}^{t-k}(1+q_{M})^{t-k}|\hat{g}_{k,i}|\right)^{2}}{\epsilon+\sum_{k=1}^{t}\beta_{2}^{t-k}(1-q_{V})^{t-k}\hat{g}_{k,i}^{2}}\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.116)</span></td></tr></tbody>
</table>
<p id="A1.SS14.p2.5" class="ltx_p"><span id="A1.SS14.p2.5.1" class="ltx_text">where for brevity we denote <math id="A1.SS14.p2.m8" class="ltx_Math" alttext="\hat{g}_{k,i}=\nabla_{i}f_{k}(\mathbf{w}_{k-1})+\delta_{k,i}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>g</mi><mo>^</mo></mover><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>=</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><msub><mi>f</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>δ</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\hat{g}_{k,i}=\nabla_{i}f_{k}(\mathbf{w}_{k-1})+\delta_{k,i}</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS14.p3" class="ltx_para">
<p id="A1.SS14.p3.1" class="ltx_p"><span id="A1.SS14.p3.1.1" class="ltx_text">The inner sum over <math id="A1.SS14.p3.m1" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> for each coordinate <math id="A1.SS14.p3.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> in (<a href="#A1.E116" title="In Proof. ‣ A.14 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.116</span></a>) perfectly matches the form required by Lemma <a href="#A1.Thmtheorem10" title="Lemma A.10 (Lemma A.2 in [ ] ). ‣ A.11 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.10</span></a>. To apply it, we make the following substitutions into the lemma’s notation:</span></p>
<ul id="A1.I4" class="ltx_itemize ltx_leftmargin_flush">
<li id="A1.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I4.i1.p1" class="ltx_para">
<p id="A1.I4.i1.p1.1" class="ltx_p">Let the sequence <math id="A1.I4.i1.p1.m1" class="ltx_Math" alttext="(a_{j})_{j\in\mathbb{N}^{*}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>∈</mo><msup><mi>ℕ</mi><mo>∗</mo></msup></mrow></msub><annotation encoding="application/x-tex">(a_{j})_{j\in\mathbb{N}^{*}}</annotation></semantics></math> be <math id="A1.I4.i1.p1.m2" class="ltx_Math" alttext="a_{k}=|\hat{g}_{k,i}|" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>k</mi></msub><mo>=</mo><mrow><mo stretchy="false">|</mo><msub><mover accent="true"><mi>g</mi><mo>^</mo></mover><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">a_{k}=|\hat{g}_{k,i}|</annotation></semantics></math>.</p>
</div></li>
<li id="A1.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I4.i2.p1" class="ltx_para">
<p id="A1.I4.i2.p1.1" class="ltx_p">Let the effective decay factors be <math id="A1.I4.i2.p1.m1" class="ltx_Math" alttext="\beta^{\prime}_{1}=\beta_{1}(1+q_{M})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>β</mi><mn>1</mn><mo>′</mo></msubsup><mo>=</mo><mrow><msub><mi>β</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta^{\prime}_{1}=\beta_{1}(1+q_{M})</annotation></semantics></math> and <math id="A1.I4.i2.p1.m2" class="ltx_Math" alttext="\beta^{\prime}_{2}=\beta_{2}(1-q_{V})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>β</mi><mn>2</mn><mo>′</mo></msubsup><mo>=</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta^{\prime}_{2}=\beta_{2}(1-q_{V})</annotation></semantics></math>. The lemma’s condition <math id="A1.I4.i2.p1.m3" class="ltx_Math" alttext="\beta^{\prime}_{1}&lt;\beta^{\prime}_{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>β</mi><mn>1</mn><mo>′</mo></msubsup><mo>&lt;</mo><msubsup><mi>β</mi><mn>2</mn><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">\beta^{\prime}_{1}&lt;\beta^{\prime}_{2}</annotation></semantics></math> is satisfied by our assumption.</p>
</div></li>
</ul>
<p id="A1.SS14.p3.2" class="ltx_p"><span id="A1.SS14.p3.2.1" class="ltx_text">With these substitutions, the numerator term becomes <math id="A1.SS14.p3.m3" class="ltx_Math" alttext="\left(\sum_{k=1}^{t}(\beta^{\prime}_{1})^{t-k}a_{k}\right)^{2}=c_{t}^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>(</mo><mrow><msubsup><mo lspace="0em" rspace="0em">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></msubsup><mrow><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>β</mi><mn>1</mn><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>k</mi></msub></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo>=</mo><msubsup><mi>c</mi><mi>t</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\left(\sum_{k=1}^{t}(\beta^{\prime}_{1})^{t-k}a_{k}\right)^{2}=c_{t}^{2}</annotation></semantics></math> and the sum in the denominator becomes <math id="A1.SS14.p3.m4" class="ltx_Math" alttext="\sum_{k=1}^{t}(\beta^{\prime}_{2})^{t-k}a_{k}^{2}=b_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></msubsup><mrow><msup><mrow><mo lspace="0em" stretchy="false">(</mo><msubsup><mi>β</mi><mn>2</mn><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>a</mi><mi>k</mi><mn>2</mn></msubsup></mrow></mrow><mo>=</mo><msub><mi>b</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\sum_{k=1}^{t}(\beta^{\prime}_{2})^{t-k}a_{k}^{2}=b_{t}</annotation></semantics></math>. Applying Lemma <a href="#A1.Thmtheorem10" title="Lemma A.10 (Lemma A.2 in [ ] ). ‣ A.11 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.10</span></a> to the sum over <math id="A1.SS14.p3.m5" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> for a fixed <math id="A1.SS14.p3.m6" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> yields:</span></p>
<table id="A1.EGx142" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E117"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E117.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=1}^{T}\mathbb{E}\left[\frac{c_{t}^{2}}{\epsilon+b_{t}}\right]\leq\frac{1}{(1-\beta^{\prime}_{1})(1-\beta^{\prime}_{1}/\beta^{\prime}_{2})}\left(\ln\left(1+\frac{b_{T}}{\epsilon}\right)-T\ln(\beta^{\prime}_{2})\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>c</mi><mi>t</mi><mn>2</mn></msubsup><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>b</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msubsup><mi>β</mi><mn>1</mn><mo>′</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msubsup><mi>β</mi><mn>1</mn><mo>′</mo></msubsup><mo>/</mo><msubsup><mi>β</mi><mn>2</mn><mo>′</mo></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><msub><mi>b</mi><mi>T</mi></msub><mi>ϵ</mi></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>β</mi><mn>2</mn><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{T}\mathbb{E}\left[\frac{c_{t}^{2}}{\epsilon+b_{t}}\right]\leq\frac{1}{(1-\beta^{\prime}_{1})(1-\beta^{\prime}_{1}/\beta^{\prime}_{2})}\left(\ln\left(1+\frac{b_{T}}{\epsilon}\right)-T\ln(\beta^{\prime}_{2})\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.117)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS14.p4" class="ltx_para">
<p id="A1.SS14.p4.1" class="ltx_p"><span id="A1.SS14.p4.1.1" class="ltx_text">The final step is to find an upper bound for <math id="A1.SS14.p4.m1" class="ltx_Math" alttext="b_{T}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mi>T</mi></msub><annotation encoding="application/x-tex">b_{T}</annotation></semantics></math>. By definition:</span></p>
<table id="A1.EGx143" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E118"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E118.m1" class="ltx_Math" alttext="\displaystyle b_{T}=\sum_{k=1}^{T}(\beta^{\prime}_{2})^{T-k}a_{k}^{2}=\sum_{k=1}^{T}(\beta_{2}(1-q_{V}))^{T-k}\hat{g}_{k,i}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>b</mi><mi>T</mi></msub><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>β</mi><mn>2</mn><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>T</mi><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>a</mi><mi>k</mi><mn>2</mn></msubsup></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>T</mi><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>g</mi><mo>^</mo></mover><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle b_{T}=\sum_{k=1}^{T}(\beta^{\prime}_{2})^{T-k}a_{k}^{2}=\sum_{k=1}^{T}(\beta_{2}(1-q_{V}))^{T-k}\hat{g}_{k,i}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.118)</span></td></tr></tbody>
</table>
<p id="A1.SS14.p4.2" class="ltx_p"><span id="A1.SS14.p4.2.1" class="ltx_text">From Lemma <a href="#A1.Thmtheorem6" title="Lemma A.6 (Bound on the Quantized Gradient Estimator). ‣ A.7 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.6</span></a>, we have a uniform bound on the quantized gradient estimator, <math id="A1.SS14.p4.m2" class="ltx_Math" alttext="|\hat{g}_{k,i}|\leq(1+q_{G})R" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mover accent="true"><mi>g</mi><mo>^</mo></mover><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mrow><annotation encoding="application/x-tex">|\hat{g}_{k,i}|\leq(1+q_{G})R</annotation></semantics></math>. Therefore:</span></p>
<table id="A1.EGx144" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex131"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex131.m1" class="ltx_Math" alttext="\displaystyle b_{T}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mi>T</mi></msub><annotation encoding="application/x-tex">\displaystyle b_{T}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex131.m2" class="ltx_Math" alttext="\displaystyle\leq\sum_{k=1}^{T}(\beta_{2}(1-q_{V}))^{T-k}((1+q_{G})R)^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>T</mi><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{k=1}^{T}(\beta_{2}(1-q_{V}))^{T-k}((1+q_{G})R)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex132"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex132.m1" class="ltx_Math" alttext="\displaystyle=((1+q_{G})R)^{2}\sum_{j=0}^{T-1}(\beta_{2}(1-q_{V}))^{j}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>j</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=((1+q_{G})R)^{2}\sum_{j=0}^{T-1}(\beta_{2}(1-q_{V}))^{j}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E119"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E119.m1" class="ltx_Math" alttext="\displaystyle\leq((1+q_{G})R)^{2}\frac{1}{1-\beta_{2}(1-q_{V})}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq((1+q_{G})R)^{2}\frac{1}{1-\beta_{2}(1-q_{V})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.119)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS14.p5" class="ltx_para">
<p id="A1.SS14.p5.1" class="ltx_p"><span id="A1.SS14.p5.1.1" class="ltx_text">Substituting the bound for <math id="A1.SS14.p5.m1" class="ltx_Math" alttext="b_{T}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mi>T</mi></msub><annotation encoding="application/x-tex">b_{T}</annotation></semantics></math> back into (<a href="#A1.E117" title="In Proof. ‣ A.14 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.117</span></a>), and re-inserting the definitions of <math id="A1.SS14.p5.m2" class="ltx_Math" alttext="\beta^{\prime}_{1}" display="inline" intent=":literal"><semantics><msubsup><mi>β</mi><mn>1</mn><mo>′</mo></msubsup><annotation encoding="application/x-tex">\beta^{\prime}_{1}</annotation></semantics></math> and <math id="A1.SS14.p5.m3" class="ltx_Math" alttext="\beta^{\prime}_{2}" display="inline" intent=":literal"><semantics><msubsup><mi>β</mi><mn>2</mn><mo>′</mo></msubsup><annotation encoding="application/x-tex">\beta^{\prime}_{2}</annotation></semantics></math>, we obtain the bound for a single coordinate <math id="A1.SS14.p5.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>. As this bound is identical for all <math id="A1.SS14.p5.m5" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> coordinates, we multiply by <math id="A1.SS14.p5.m6" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> to get the final result stated in (<a href="#A1.E112" title="In Lemma A.13 (Upper bound of ∑_{𝑡=1}^𝑇𝔼[‖𝐮_𝑡‖^2_2]). ‣ A.14 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.112</span></a>). This completes the proof.
∎</span></p>
</div>
</div>
</section>
<section id="A1.SS15" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.15 </span>Proof of Lemma <a href="#A1.Thmtheorem14" title="Lemma A.14 (Bound on Term M). ‣ A.15 Proof of Lemma (Bound on Term M) ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.14</span></a> (Bound on Term M)</h3>

<div id="A1.Thmtheorem14" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem14.2" class="ltx_text ltx_font_bold">Lemma A.14</span></span><span id="A1.Thmtheorem14.3" class="ltx_text ltx_font_bold"> </span>(Bound on Term M)<span id="A1.Thmtheorem14.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem14.p1" class="ltx_para">
<p id="A1.Thmtheorem14.p1.1" class="ltx_p"><span id="A1.Thmtheorem14.p1.1.1" class="ltx_text ltx_font_italic">The term M, representing the accumulated quantization bias from (<a href="#A1.E26" title="In A.2 Detailed Proof ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.26</span></a>), is bounded by:</span></p>
<table id="A1.EGx145" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E120"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E120.m1" class="ltx_Math" alttext="\displaystyle M\leq\frac{\eta_{T}dT}{\sqrt{\epsilon}(1-\beta_{1})}\left(q_{G}R^{2}+Lq_{W}R\|\mathbf{w}_{0}\|_{2}\right)+\frac{\eta_{T}^{2}dLq_{W}URT^{2}}{2\sqrt{\epsilon}(1-\beta_{1})}," display="inline" intent=":literal"><semantics><mrow><mrow><mi>M</mi><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>η</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mrow><msqrt><mi>ϵ</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐰</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>η</mi><mi>T</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mn>2</mn></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>ϵ</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle M\leq\frac{\eta_{T}dT}{\sqrt{\epsilon}(1-\beta_{1})}\left(q_{G}R^{2}+Lq_{W}R\|\mathbf{w}_{0}\|_{2}\right)+\frac{\eta_{T}^{2}dLq_{W}URT^{2}}{2\sqrt{\epsilon}(1-\beta_{1})},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.120)</span></td></tr></tbody>
</table>
<p id="A1.Thmtheorem14.p1.2" class="ltx_p"><span id="A1.Thmtheorem14.p1.2.1" class="ltx_text ltx_font_italic">where <math id="A1.Thmtheorem14.p1.m1" class="ltx_Math" alttext="U=\sqrt{\frac{d}{1-\frac{\beta_{1}^{2}(1+q_{M})^{2}}{\beta_{2}(1-q_{V})}}}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>=</mo><msqrt><mfrac><mi>d</mi><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mfrac></msqrt></mrow><annotation encoding="application/x-tex">U=\sqrt{\frac{d}{1-\frac{\beta_{1}^{2}(1+q_{M})^{2}}{\beta_{2}(1-q_{V})}}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A1.SS15.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS15.p1" class="ltx_para">
<p id="A1.SS15.p1.1" class="ltx_p"><span id="A1.SS15.p1.1.1" class="ltx_text">First, we establish a uniform bound on the update norm <math id="A1.SS15.p1.m1" class="ltx_Math" alttext="\|\mathbf{u}_{t}\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐮</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\|\mathbf{u}_{t}\|_{2}</annotation></semantics></math> using Lemma <a href="#A1.Thmtheorem4" title="Lemma A.4 (Finite Geometric Series Ratio Bounded by Infinite Sum). ‣ A.5 Proof of Lemma ‣ Appendix A Proof of Theorem ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.4</span></a>:</span></p>
<table id="A1.EGx146" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex133"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex133.m1" class="ltx_Math" alttext="\displaystyle\|\mathbf{u}_{t}\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐮</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\|\mathbf{u}_{t}\|_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex133.m2" class="ltx_Math" alttext="\displaystyle=\sqrt{\sum_{i\in[d]}\frac{m_{t,i}^{2}}{\epsilon+v_{t,i}}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msqrt><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mstyle displaystyle="true"><mfrac><msubsup><mi>m</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup><mrow><mi>ϵ</mi><mo>+</mo><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></mfrac></mstyle></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle=\sqrt{\sum_{i\in[d]}\frac{m_{t,i}^{2}}{\epsilon+v_{t,i}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex134"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex134.m1" class="ltx_Math" alttext="\displaystyle\leq\sqrt{\sum_{i\in[d]}\frac{(\sum_{k=0}^{t}\beta_{1}^{t-k}(1+q_{M})^{t-k}|\nabla_{i}f_{k}(\mathbf{w}_{k-1})+\delta_{k,i}|)^{2}}{(\sum_{k=0}^{t}\beta_{2}^{t-k}(1-q_{V})^{t-k}(\nabla_{i}f_{k}(\mathbf{w}_{k-1})+\delta_{k,i})^{2})}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><msqrt><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mo lspace="0em">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></msubsup><mrow><msubsup><mi>β</mi><mn>1</mn><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><msub><mi>f</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>δ</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mo lspace="0em">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></msubsup><mrow><msubsup><mi>β</mi><mn>2</mn><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>i</mi></msub><msub><mi>f</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>δ</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mfrac></mstyle></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sqrt{\sum_{i\in[d]}\frac{(\sum_{k=0}^{t}\beta_{1}^{t-k}(1+q_{M})^{t-k}|\nabla_{i}f_{k}(\mathbf{w}_{k-1})+\delta_{k,i}|)^{2}}{(\sum_{k=0}^{t}\beta_{2}^{t-k}(1-q_{V})^{t-k}(\nabla_{i}f_{k}(\mathbf{w}_{k-1})+\delta_{k,i})^{2})}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E121"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E121.m1" class="ltx_Math" alttext="\displaystyle\leq\sqrt{\frac{d}{1-\frac{\beta_{1}^{2}(1+q_{M})^{2}}{\beta_{2}(1-q_{V})}}}\triangleq U" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><msqrt><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mfrac></mstyle></msqrt><mo>≜</mo><mi>U</mi></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sqrt{\frac{d}{1-\frac{\beta_{1}^{2}(1+q_{M})^{2}}{\beta_{2}(1-q_{V})}}}\triangleq U</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.121)</span></td></tr></tbody>
</table>
<p id="A1.SS15.p1.2" class="ltx_p"><span id="A1.SS15.p1.2.1" class="ltx_text">Now, let’s recall the definition of <math id="A1.SS15.p1.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>:</span></p>
<table id="A1.Ex135" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex135.m1" class="ltx_Math" alttext="M=\eta_{T}d\sum_{t=1}^{T}\mathbb{E}\left[\sum_{k=0}^{t-1}\beta_{1}^{k}M_{t-k}\right],\quad\text{where}\quad M_{t-k}=\frac{q_{G}R^{2}+Lq_{W}R\|\mathbf{w}_{t-k-1}\|_{2}}{\sqrt{\epsilon}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>M</mi><mo>=</mo><mrow><msub><mi>η</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mtext>where</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mi>M</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi></mrow></msub><mo>=</mo><mfrac><mrow><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><msqrt><mi>ϵ</mi></msqrt></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">M=\eta_{T}d\sum_{t=1}^{T}\mathbb{E}\left[\sum_{k=0}^{t-1}\beta_{1}^{k}M_{t-k}\right],\quad\text{where}\quad M_{t-k}=\frac{q_{G}R^{2}+Lq_{W}R\|\mathbf{w}_{t-k-1}\|_{2}}{\sqrt{\epsilon}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS15.p1.3" class="ltx_p"><span id="A1.SS15.p1.3.1" class="ltx_text">We can split <math id="A1.SS15.p1.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> into two components: a constant part <math id="A1.SS15.p1.m4" class="ltx_Math" alttext="M_{\text{const}}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mtext>const</mtext></msub><annotation encoding="application/x-tex">M_{\text{const}}</annotation></semantics></math> and a weight-dependent part <math id="A1.SS15.p1.m5" class="ltx_Math" alttext="M_{\text{weights}}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mtext>weights</mtext></msub><annotation encoding="application/x-tex">M_{\text{weights}}</annotation></semantics></math>.</span></p>
<table id="A1.EGx147" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex136"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex136.m1" class="ltx_Math" alttext="\displaystyle M_{\text{const}}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mtext>const</mtext></msub><annotation encoding="application/x-tex">\displaystyle M_{\text{const}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex136.m2" class="ltx_Math" alttext="\displaystyle=\frac{\eta_{T}dq_{G}R^{2}}{\sqrt{\epsilon}}\sum_{t=1}^{T}\sum_{k=0}^{t-1}\beta_{1}^{k}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>η</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><msqrt><mi>ϵ</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\eta_{T}dq_{G}R^{2}}{\sqrt{\epsilon}}\sum_{t=1}^{T}\sum_{k=0}^{t-1}\beta_{1}^{k}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex137"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex137.m1" class="ltx_Math" alttext="\displaystyle M_{\text{weights}}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mtext>weights</mtext></msub><annotation encoding="application/x-tex">\displaystyle M_{\text{weights}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex137.m2" class="ltx_Math" alttext="\displaystyle=\frac{\eta_{T}dLq_{W}R}{\sqrt{\epsilon}}\sum_{t=1}^{T}\sum_{k=0}^{t-1}\beta_{1}^{k}\mathbb{E}\left[\|\mathbf{w}_{t-k-1}\|_{2}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>η</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><msqrt><mi>ϵ</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>]</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\eta_{T}dLq_{W}R}{\sqrt{\epsilon}}\sum_{t=1}^{T}\sum_{k=0}^{t-1}\beta_{1}^{k}\mathbb{E}\left[\|\mathbf{w}_{t-k-1}\|_{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS15.p1.4" class="ltx_p"><span id="A1.SS15.p1.4.1" class="ltx_text">Bounding <math id="A1.SS15.p1.m6" class="ltx_Math" alttext="M_{\text{const}}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mtext>const</mtext></msub><annotation encoding="application/x-tex">M_{\text{const}}</annotation></semantics></math> is straightforward. The inner sum is a geometric series bounded by <math id="A1.SS15.p1.m7" class="ltx_Math" alttext="\frac{1}{1-\beta_{1}}" display="inline" intent=":literal"><semantics><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></mfrac><annotation encoding="application/x-tex">\frac{1}{1-\beta_{1}}</annotation></semantics></math>, so the double summation is bounded by <math id="A1.SS15.p1.m8" class="ltx_Math" alttext="\frac{T}{1-\beta_{1}}" display="inline" intent=":literal"><semantics><mfrac><mi>T</mi><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></mfrac><annotation encoding="application/x-tex">\frac{T}{1-\beta_{1}}</annotation></semantics></math>.</span></p>
<table id="A1.E122" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E122.m1" class="ltx_Math" alttext="M_{\text{const}}\leq\frac{\eta_{T}dq_{G}R^{2}T}{\sqrt{\epsilon}(1-\beta_{1})}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>M</mi><mtext>const</mtext></msub><mo>≤</mo><mfrac><mrow><msub><mi>η</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mrow><msqrt><mi>ϵ</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">M_{\text{const}}\leq\frac{\eta_{T}dq_{G}R^{2}T}{\sqrt{\epsilon}(1-\beta_{1})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.122)</span></td></tr></tbody>
</table>
<p id="A1.SS15.p1.5" class="ltx_p"><span id="A1.SS15.p1.5.1" class="ltx_text">The main challenge is to bound <math id="A1.SS15.p1.m9" class="ltx_Math" alttext="M_{\text{weights}}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mtext>weights</mtext></msub><annotation encoding="application/x-tex">M_{\text{weights}}</annotation></semantics></math>. To do this, we first need a bound on the expected weight norm <math id="A1.SS15.p1.m10" class="ltx_Math" alttext="\mathbb{E}\left[\|\mathbf{w}_{j}\|_{2}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐰</mi><mi>j</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\|\mathbf{w}_{j}\|_{2}\right]</annotation></semantics></math>. From the update rule <math id="A1.SS15.p1.m11" class="ltx_Math" alttext="\mathbf{w}_{j}=\mathbf{w}_{j-1}-\eta_{j}\mathbf{u}_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐰</mi><mi>j</mi></msub><mo>=</mo><mrow><msub><mi>𝐰</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>−</mo><mrow><msub><mi>η</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐮</mi><mi>j</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{w}_{j}=\mathbf{w}_{j-1}-\eta_{j}\mathbf{u}_{j}</annotation></semantics></math>, we can unroll the recursion:</span></p>
<table id="A1.Ex138" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex138.m1" class="ltx_Math" alttext="\mathbf{w}_{j}=\mathbf{w}_{0}-\sum_{l=1}^{j}\eta_{l}\mathbf{u}_{l}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐰</mi><mi>j</mi></msub><mo>=</mo><mrow><msub><mi>𝐰</mi><mn>0</mn></msub><mo rspace="0.055em">−</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>j</mi></munderover><mrow><msub><mi>η</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐮</mi><mi>l</mi></msub></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbf{w}_{j}=\mathbf{w}_{0}-\sum_{l=1}^{j}\eta_{l}\mathbf{u}_{l}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS15.p1.6" class="ltx_p"><span id="A1.SS15.p1.6.1" class="ltx_text">Applying the triangle inequality and taking the expectation, we get:</span></p>
<table id="A1.Ex139" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex139.m1" class="ltx_Math" alttext="\mathbb{E}\left[\|\mathbf{w}_{j}\|_{2}\right]\leq\|\mathbf{w}_{0}\|_{2}+\mathbb{E}\left[\sum_{l=1}^{j}\eta_{l}\|\mathbf{u}_{l}\|_{2}\right]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐰</mi><mi>j</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐰</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>+</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>j</mi></munderover><mrow><msub><mi>η</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐮</mi><mi>l</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\|\mathbf{w}_{j}\|_{2}\right]\leq\|\mathbf{w}_{0}\|_{2}+\mathbb{E}\left[\sum_{l=1}^{j}\eta_{l}\|\mathbf{u}_{l}\|_{2}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS15.p1.7" class="ltx_p"><span id="A1.SS15.p1.7.1" class="ltx_text">Using the uniform bound <math id="A1.SS15.p1.m12" class="ltx_Math" alttext="\|\mathbf{u}_{l}\|_{2}\leq U" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐮</mi><mi>l</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mi>U</mi></mrow><annotation encoding="application/x-tex">\|\mathbf{u}_{l}\|_{2}\leq U</annotation></semantics></math>, we have:</span></p>
<table id="A1.Ex140" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex140.m1" class="ltx_Math" alttext="\mathbb{E}\left[\|\mathbf{w}_{j}\|_{2}\right]\leq\|\mathbf{w}_{0}\|_{2}+U\sum_{l=1}^{j}\eta_{l}\leq\|\mathbf{w}_{0}\|_{2}+Uj\eta_{T}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐰</mi><mi>j</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐰</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>+</mo><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>j</mi></munderover><msub><mi>η</mi><mi>l</mi></msub></mrow></mrow></mrow><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐰</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>+</mo><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>T</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\|\mathbf{w}_{j}\|_{2}\right]\leq\|\mathbf{w}_{0}\|_{2}+U\sum_{l=1}^{j}\eta_{l}\leq\|\mathbf{w}_{0}\|_{2}+Uj\eta_{T}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS15.p2" class="ltx_para">
<p id="A1.SS15.p2.1" class="ltx_p"><span id="A1.SS15.p2.1.1" class="ltx_text">Now we substitute this bound back into the expression for <math id="A1.SS15.p2.m1" class="ltx_Math" alttext="M_{\text{weights}}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mtext>weights</mtext></msub><annotation encoding="application/x-tex">M_{\text{weights}}</annotation></semantics></math>. We first swap the order of summation. Let <math id="A1.SS15.p2.m2" class="ltx_Math" alttext="j=t-k-1" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">j=t-k-1</annotation></semantics></math>. For a fixed <math id="A1.SS15.p2.m3" class="ltx_Math" alttext="j\in\{0,\dots,T-1\}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">j\in\{0,\dots,T-1\}</annotation></semantics></math>, the term <math id="A1.SS15.p2.m4" class="ltx_Math" alttext="\mathbb{E}\left[\|\mathbf{w}_{j}\|_{2}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐰</mi><mi>j</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\|\mathbf{w}_{j}\|_{2}\right]</annotation></semantics></math> appears when <math id="A1.SS15.p2.m5" class="ltx_Math" alttext="k=t-j-1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>j</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">k=t-j-1</annotation></semantics></math>. This is valid for <math id="A1.SS15.p2.m6" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> from <math id="A1.SS15.p2.m7" class="ltx_Math" alttext="j+1" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">j+1</annotation></semantics></math> to <math id="A1.SS15.p2.m8" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>.</span></p>
<table id="A1.EGx148" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex141"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex141.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=1}^{T}\sum_{k=0}^{t-1}\beta_{1}^{k}\mathbb{E}\left[\|\mathbf{w}_{t-k-1}\|_{2}\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mn>1</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐰</mi><mrow><mi>t</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{T}\sum_{k=0}^{t-1}\beta_{1}^{k}\mathbb{E}\left[\|\mathbf{w}_{t-k-1}\|_{2}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex141.m2" class="ltx_Math" alttext="\displaystyle=\sum_{j=0}^{T-1}\mathbb{E}\left[\|\mathbf{w}_{j}\|_{2}\right]\sum_{t=j+1}^{T}\beta_{1}^{t-j-1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐰</mi><mi>j</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>T</mi></munderover></mstyle><msubsup><mi>β</mi><mn>1</mn><mrow><mi>t</mi><mo>−</mo><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{j=0}^{T-1}\mathbb{E}\left[\|\mathbf{w}_{j}\|_{2}\right]\sum_{t=j+1}^{T}\beta_{1}^{t-j-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex142"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex142.m1" class="ltx_Math" alttext="\displaystyle=\sum_{j=0}^{T-1}\mathbb{E}\left[\|\mathbf{w}_{j}\|_{2}\right]\sum_{m=0}^{T-j-1}\beta_{1}^{m}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐰</mi><mi>j</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mi>j</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msubsup><mi>β</mi><mn>1</mn><mi>m</mi></msubsup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{j=0}^{T-1}\mathbb{E}\left[\|\mathbf{w}_{j}\|_{2}\right]\sum_{m=0}^{T-j-1}\beta_{1}^{m}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex143"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex143.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{1}{1-\beta_{1}}\sum_{j=0}^{T-1}\mathbb{E}\left[\|\mathbf{w}_{j}\|_{2}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐰</mi><mi>j</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>]</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{1-\beta_{1}}\sum_{j=0}^{T-1}\mathbb{E}\left[\|\mathbf{w}_{j}\|_{2}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS15.p2.2" class="ltx_p"><span id="A1.SS15.p2.2.1" class="ltx_text">Next, we substitute the linear bound:</span></p>
<table id="A1.EGx149" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex144"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex144.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{1-\beta_{1}}\sum_{j=0}^{T-1}\mathbb{E}\left[\|\mathbf{w}_{j}\|_{2}\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐰</mi><mi>j</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{1-\beta_{1}}\sum_{j=0}^{T-1}\mathbb{E}\left[\|\mathbf{w}_{j}\|_{2}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex144.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{1}{1-\beta_{1}}\sum_{j=0}^{T-1}\left(\|\mathbf{w}_{0}\|_{2}+j\cdot U\cdot\eta_{T}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo>(</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐰</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>+</mo><mrow><mi>j</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>U</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>η</mi><mi>T</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{1-\beta_{1}}\sum_{j=0}^{T-1}\left(\|\mathbf{w}_{0}\|_{2}+j\cdot U\cdot\eta_{T}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex145"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex145.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{1-\beta_{1}}\left(T\|\mathbf{w}_{0}\|_{2}+U\eta_{T}\sum_{j=0}^{T-1}j\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐰</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mi>j</mi></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{1-\beta_{1}}\left(T\|\mathbf{w}_{0}\|_{2}+U\eta_{T}\sum_{j=0}^{T-1}j\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS15.p2.3" class="ltx_p"><span id="A1.SS15.p2.3.1" class="ltx_text">The sum of the first <math id="A1.SS15.p2.m9" class="ltx_Math" alttext="T-1" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">T-1</annotation></semantics></math> integers is <math id="A1.SS15.p2.m10" class="ltx_Math" alttext="\frac{(T-1)T}{2}&lt;\frac{T^{2}}{2}" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mn>2</mn></mfrac><mo>&lt;</mo><mfrac><msup><mi>T</mi><mn>2</mn></msup><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">\frac{(T-1)T}{2}&lt;\frac{T^{2}}{2}</annotation></semantics></math>. This gives:</span></p>
<table id="A1.Ex146" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex146.m1" class="ltx_Math" alttext="\leq\frac{1}{1-\beta_{1}}\left(T\|\mathbf{w}_{0}\|_{2}+\frac{T^{2}}{2}U\eta_{T}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐰</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><mfrac><msup><mi>T</mi><mn>2</mn></msup><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>T</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\leq\frac{1}{1-\beta_{1}}\left(T\|\mathbf{w}_{0}\|_{2}+\frac{T^{2}}{2}U\eta_{T}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS15.p2.4" class="ltx_p"><span id="A1.SS15.p2.4.1" class="ltx_text">Finally, we assemble the complete bound for <math id="A1.SS15.p2.m11" class="ltx_Math" alttext="M_{\text{weights}}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mtext>weights</mtext></msub><annotation encoding="application/x-tex">M_{\text{weights}}</annotation></semantics></math>:</span></p>
<table id="A1.Ex147" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex147.m1" class="ltx_Math" alttext="M_{\text{weights}}\leq\frac{\eta_{T}dLq_{W}R}{\sqrt{\epsilon}(1-\beta_{1})}\left(T\|\mathbf{w}_{0}\|_{2}+\frac{T^{2}}{2}U\eta_{T}\right)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>M</mi><mtext>weights</mtext></msub><mo>≤</mo><mrow><mfrac><mrow><msub><mi>η</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mrow><msqrt><mi>ϵ</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐰</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><mfrac><msup><mi>T</mi><mn>2</mn></msup><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>T</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">M_{\text{weights}}\leq\frac{\eta_{T}dLq_{W}R}{\sqrt{\epsilon}(1-\beta_{1})}\left(T\|\mathbf{w}_{0}\|_{2}+\frac{T^{2}}{2}U\eta_{T}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS15.p2.5" class="ltx_p"><span id="A1.SS15.p2.5.1" class="ltx_text">Combining <math id="A1.SS15.p2.m12" class="ltx_Math" alttext="M_{\text{const}}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mtext>const</mtext></msub><annotation encoding="application/x-tex">M_{\text{const}}</annotation></semantics></math> with <math id="A1.SS15.p2.m13" class="ltx_Math" alttext="M_{\text{weights}}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mtext>weights</mtext></msub><annotation encoding="application/x-tex">M_{\text{weights}}</annotation></semantics></math>, we get the final bound for <math id="A1.SS15.p2.m14" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>.</span></p>
<table id="A1.EGx150" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex148"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex148.m1" class="ltx_Math" alttext="\displaystyle M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">\displaystyle M</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex148.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{\eta_{T}dT}{\sqrt{\epsilon}(1-\beta_{1})}\left(q_{G}R^{2}+Lq_{W}R\|\mathbf{w}_{0}\|_{2}\right)+\frac{\eta_{T}^{2}dLq_{W}URT^{2}}{2\sqrt{\epsilon}(1-\beta_{1})}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>η</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mrow><msqrt><mi>ϵ</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐰</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>η</mi><mi>T</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mn>2</mn></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>ϵ</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\eta_{T}dT}{\sqrt{\epsilon}(1-\beta_{1})}\left(q_{G}R^{2}+Lq_{W}R\|\mathbf{w}_{0}\|_{2}\right)+\frac{\eta_{T}^{2}dLq_{W}URT^{2}}{2\sqrt{\epsilon}(1-\beta_{1})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS15.p2.6" class="ltx_p"><span id="A1.SS15.p2.6.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
</section>
<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Proof of Theorem <a href="#S4.Thmtheorem6" title="Theorem 4.6 (Convergence of Quantized Muon). ‣ 4.2 Theoretical results of Muon ‣ 4 Main Results ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.6</span></a></h2>

<section id="A2.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.1 </span>Preliminaries</h3>

<div id="A2.SS1.p1" class="ltx_para">
<p id="A2.SS1.p1.1" class="ltx_p">The momentum of the quantized Muon (Algorithm <a href="#alg1" title="Algorithm 1 ‣ Optimizers. ‣ 3.2 Problem Setup ‣ 3 Preliminaries and Problem Setup ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, <a href="#alg3" title="Algorithm 3 ‣ Optimizers. ‣ 3.2 Problem Setup ‣ 3 Preliminaries and Problem Setup ‣ A Convergence Analysis of Adaptive Optimizers under Floating-point Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>) is defined as</p>
<table id="A2.EGx151" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E1.m1" class="ltx_Math" alttext="\displaystyle\mathbf{M}_{t}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐌</mi><mi>t</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{M}_{t}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E1.m2" class="ltx_Math" alttext="\displaystyle\beta\mathbf{M}_{t-1}^{Q}+(1-\beta)\frac{1}{B}\sum_{i=1}^{B}\nabla^{Q}f(\mathbf{W}_{t}^{Q};\bm{\xi}_{t,i})," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐌</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>Q</mi></msubsup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>B</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></munderover></mstyle><mrow><mrow><msup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>Q</mi></msup><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐖</mi><mi>t</mi><mi>Q</mi></msubsup><mo>,</mo><msub><mi>𝝃</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\beta\mathbf{M}_{t-1}^{Q}+(1-\beta)\frac{1}{B}\sum_{i=1}^{B}\nabla^{Q}f(\mathbf{W}_{t}^{Q};\bm{\xi}_{t,i}),</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E1.m3" class="ltx_Math" alttext="\displaystyle\mathbf{M}_{0}=\frac{1}{B}\sum_{i=1}^{B}\nabla^{Q}f(\mathbf{W}_{0}^{Q};\bm{\xi}_{0,i})." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐌</mi><mn>0</mn></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>B</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></munderover></mstyle><mrow><mrow><msup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>Q</mi></msup><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐖</mi><mn>0</mn><mi>Q</mi></msubsup><mo>,</mo><msub><mi>𝝃</mi><mrow><mn>0</mn><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{M}_{0}=\frac{1}{B}\sum_{i=1}^{B}\nabla^{Q}f(\mathbf{W}_{0}^{Q};\bm{\xi}_{0,i}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(B.1)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p1.2" class="ltx_p">We define the following auxiliary variables for analysis:</p>
<table id="A2.EGx152" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E2.m1" class="ltx_Math" alttext="\displaystyle\mathbf{C}_{t}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐂</mi><mi>t</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{C}_{t}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E2.m2" class="ltx_math_unparsed" alttext="\displaystyle\beta\mathbf{C}_{t-1}+(1-\beta)\nabla F(\mathbf{W}_{t})," display="inline" intent=":literal"><semantics><mrow><mi>β</mi><msub><mi>𝐂</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>+</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>β</mi><mo rspace="0.167em" stretchy="false">)</mo></mrow><mo rspace="0.167em">∇</mo><mi>F</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\beta\mathbf{C}_{t-1}+(1-\beta)\nabla F(\mathbf{W}_{t}),</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E2.m3" class="ltx_Math" alttext="\displaystyle\mathbf{C}_{0}=\nabla F(\mathbf{W}_{0})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐂</mi><mn>0</mn></msub><mo>=</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{C}_{0}=\nabla F(\mathbf{W}_{0})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(B.2)</span></td></tr></tbody>
<tbody id="A2.E3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E3.m1" class="ltx_Math" alttext="\displaystyle\mathbf{X}_{t}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐗</mi><mi>t</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{X}_{t}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E3.m2" class="ltx_Math" alttext="\displaystyle\beta\mathbf{X}_{t-1}+(1-\beta)\frac{1}{B}\sum_{i=1}^{B}\nabla f(\mathbf{W}_{t};\bm{\xi}_{t,i})," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐗</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>B</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></munderover></mstyle><mrow><mrow><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝝃</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\beta\mathbf{X}_{t-1}+(1-\beta)\frac{1}{B}\sum_{i=1}^{B}\nabla f(\mathbf{W}_{t};\bm{\xi}_{t,i}),</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E3.m3" class="ltx_Math" alttext="\displaystyle\mathbf{X}_{0}=\frac{1}{B}\sum_{i=1}^{B}\nabla f(\mathbf{W}_{0};\bm{\xi}_{0,i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐗</mi><mn>0</mn></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>B</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></munderover></mstyle><mrow><mrow><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mn>0</mn></msub><mo>,</mo><msub><mi>𝝃</mi><mrow><mn>0</mn><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{X}_{0}=\frac{1}{B}\sum_{i=1}^{B}\nabla f(\mathbf{W}_{0};\bm{\xi}_{0,i})</annotation></semantics></math></td>
