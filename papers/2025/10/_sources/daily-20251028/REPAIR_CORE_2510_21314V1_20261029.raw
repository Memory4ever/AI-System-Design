<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex82.m2" class="ltx_Math" alttext="\displaystyle q_{G}(\sigma+G)+(1-\beta^{t})q_{G}t\eta\sqrt{r}L" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>+</mo><mi>G</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>β</mi><mi>t</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle q_{G}(\sigma+G)+(1-\beta^{t})q_{G}t\eta\sqrt{r}L</annotation></semantics></math></td>
