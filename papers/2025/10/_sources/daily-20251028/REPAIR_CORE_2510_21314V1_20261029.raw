<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E41.m1" class="ltx_Math" alttext="\displaystyle+\frac{2(1+q_{G})dT}{\tilde{T}\sqrt{\epsilon(1-\beta_{2})}}\left(q_{G}R^{3}+Lq_{W}R^{2}\|\mathbf{w}_{0}\|_{2}\right)+\frac{(1-\beta_{1})d^{\frac{3}{2}}\eta Lq_{W}(1+q_{G})R^{2}T^{2}}{\tilde{T}\sqrt{\epsilon}(1-\beta_{2})\sqrt{1-\frac{\beta_{1}^{2}(1+q_{M})^{2}}{\beta_{2}(1-q_{V})}}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mrow><mover accent="true"><mi>T</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>ϵ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>q</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>3</mn></msup></mrow><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐰</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mfrac><mn>3</mn><mn>2</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mn>2</mn></msup></mrow><mrow><mover accent="true"><mi>T</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>ϵ</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>V</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></msqrt></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{2(1+q_{G})dT}{\tilde{T}\sqrt{\epsilon(1-\beta_{2})}}\left(q_{G}R^{3}+Lq_{W}R^{2}\|\mathbf{w}_{0}\|_{2}\right)+\frac{(1-\beta_{1})d^{\frac{3}{2}}\eta Lq_{W}(1+q_{G})R^{2}T^{2}}{\tilde{T}\sqrt{\epsilon}(1-\beta_{2})\sqrt{1-\frac{\beta_{1}^{2}(1+q_{M})^{2}}{\beta_{2}(1-q_{V})}}}.</annotation></semantics></math></td>
