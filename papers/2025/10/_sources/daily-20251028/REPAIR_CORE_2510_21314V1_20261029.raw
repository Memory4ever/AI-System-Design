<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex47.m1" class="ltx_Math" alttext="\displaystyle+\underbrace{\frac{12d((1+q_{G})R)^{2}\sqrt{1-\beta_{1}}}{\tilde{T}(1-\beta_{1}/\beta_{2})^{3/2}\sqrt{1-\beta_{2}}}\left(\ln\left(1+\frac{((1+q_{G})R)^{2}}{\epsilon(1-\beta_{2})}\right)-T\ln(\beta_{2})\right)}_{\text{Term 2}}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><munder><munder accentunder="true"><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>1</mn></msub></mrow></msqrt></mrow><mrow><mover accent="true"><mi>T</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>/</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></msqrt></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>q</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mi>ϵ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mtext>Term 2</mtext></munder></mrow><annotation encoding="application/x-tex">\displaystyle+\underbrace{\frac{12d((1+q_{G})R)^{2}\sqrt{1-\beta_{1}}}{\tilde{T}(1-\beta_{1}/\beta_{2})^{3/2}\sqrt{1-\beta_{2}}}\left(\ln\left(1+\frac{((1+q_{G})R)^{2}}{\epsilon(1-\beta_{2})}\right)-T\ln(\beta_{2})\right)}_{\text{Term 2}}</annotation></semantics></math></td>
