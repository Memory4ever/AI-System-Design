lor:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.8 0.0 0.0 0.8 19.81 -53.96)"><foreignObject style="--ltx-fo-width:2.11em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="29.21"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F3.pic1.6" class="ltx_text">-0.35</span></span></span></foreignObject></g><g style="--ltx-fill-color:#70B870;" fill="#70B870"><path style="stroke:none" d="M 78.74 -37.8 L 47.24 -37.8 L 47.24 -62.99 L 78.74 -62.99 Z M 47.24 -62.99"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.8 0.0 0.0 0.8 51.31 -53.96)"><foreignObject style="--ltx-fo-width:2.11em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="29.21"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F3.pic1.7" class="ltx_text">-0.28</span></span></span></foreignObject></g><g style="--ltx-fill-color:#99CC99;" fill="#99CC99"><path style="stroke:none" d="M 110.24 -37.8 L 78.74 -37.8 L 78.74 -62.99 L 110.24 -62.99 Z M 78.74 -62.99"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.8 0.0 0.0 0.8 82.8 -53.96)"><foreignObject style="--ltx-fo-width:2.11em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="29.21"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F3.pic1.8" class="ltx_text">-0.20</span></span></span></foreignObject></g><g style="--ltx-fill-color:#99CC99;" fill="#99CC99"><path style="stroke:none" d="M 141.73 -37.8 L 110.24 -37.8 L 110.24 -62.99 L 141.73 -62.99 Z M 110.24 -62.99"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.8 0.0 0.0 0.8 114.3 -53.96)"><foreignObject style="--ltx-fo-width:2.11em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="29.21"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F3.pic1.9" class="ltx_text">-0.20</span></span></span></foreignObject></g><g style="--ltx-fill-color:#80BF80;" fill="#80BF80"><path style="stroke:none" d="M 173.23 -37.8 L 141.73 -37.8 L 141.73 -62.99 L 173.23 -62.99 Z M 141.73 -62.99"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.8 0.0 0.0 0.8 145.8 -53.96)"><foreignObject style="--ltx-fo-width:2.11em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="29.21"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F3.pic1.10" class="ltx_text">-0.25</span></span></span></foreignObject></g><g style="--ltx-fill-color:#2E962E;" fill="#2E962E"><path style="stroke:none" d="M 47.24 -62.99 L 15.75 -62.99 L 15.75 -88.19 L 47.24 -88.19 Z M 15.75 -88.19"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.8 0.0 0.0 0.8 19.81 -79.16)"><foreignObject style="--ltx-fo-width:2.11em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="29.21"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F3.pic1.11" class="ltx_text">-0.41</span></span></span></foreignObject></g><g style="--ltx-fill-color:#61B061;" fill="#61B061"><path style="stroke:none" d="M 78.74 -62.99 L 47.24 -62.99 L 47.24 -88.19 L 78.74 -88.19 Z M 47.24 -88.19"></path></g><g style="--ltx-stroke-co