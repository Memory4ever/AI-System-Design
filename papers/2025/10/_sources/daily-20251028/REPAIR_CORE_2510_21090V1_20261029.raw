<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Detailed Algorithm of SRPPO</h2>

<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> SRPPO</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
            
            
           <span id="alg1.l1.3" class="ltx_text ltx_font_bold">Input:</span> Demonstartion dataset <math id="alg1.l1.m1" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math>; Prompt set <math id="alg1.l1.m2" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math>; Pretrained LLM <math id="alg1.l1.m3" class="ltx_Math" alttext="p_{\boldsymbol{\theta}^{(\textrm{PT})}}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><msup><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mtext>PT</mtext><mo stretchy="false">)</mo></mrow></msup></msub><annotation encoding="application/x-tex">p_{\boldsymbol{\theta}^{(\textrm{PT})}}</annotation></semantics></math>.

</div>
<div id="alg1.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
            
            
           <span id="alg1.l2.3" class="ltx_text ltx_font_bold">Supervised fine-tune</span> <math id="alg1.l2.m1" class="ltx_Math" alttext="p_{\boldsymbol{\theta}^{(\textrm{PT})}}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><msup><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mtext>PT</mtext><mo stretchy="false">)</mo></mrow></msup></msub><annotation encoding="application/x-tex">p_{\boldsymbol{\theta}^{(\textrm{PT})}}</annotation></semantics></math> using <math id="alg1.l2.m2" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math> and obtain <math id="alg1.l2.m3" class="ltx_Math" alttext="p_{\boldsymbol{\theta}^{(\textrm{SFT})}}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><msup><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mtext>SFT</mtext><mo stretchy="false">)</mo></mrow></msup></msub><annotation encoding="application/x-tex">p_{\boldsymbol{\theta}^{(\textrm{SFT})}}</annotation></semantics></math>.

</div>
<div id="alg1.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
            
            
           <span id="alg1.l3.3" class="ltx_text ltx_font_bold">Derive</span> <math id="alg1.l3.m1" class="ltx_Math" alttext="\tilde{r}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>r</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{r}</annotation></semantics></math> using <math id="alg1.l3.m2" class="ltx_Math" alttext="p_{\boldsymbol{\theta}^{(\textrm{PT})}}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><msup><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mtext>PT</mtext><mo stretchy="false">)</mo></mrow></msup></msub><annotation encoding="application/x-tex">p_{\boldsymbol{\theta}^{(\textrm{PT})}}</annotation></semantics></math> and <math id="alg1.l3.m3" class="ltx_Math" alttext="p_{\boldsymbol{\theta}^{(\textrm{SFT})}}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><msup><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mtext>SFT</mtext><mo stretchy="false">)</mo></mrow></msup></msub><annotation encoding="application/x-tex">p_{\boldsymbol{\theta}^{(\textrm{SFT})}}</annotation></semantics></math>.

