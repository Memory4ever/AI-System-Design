<td id="A4.T5.2.4.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="A4.T5.2.4.5.1" class="ltx_text" style="font-size:90%;">10 epochs</span></td></tr>
<tr id="A4.T5.2.5" class="ltx_tr">
