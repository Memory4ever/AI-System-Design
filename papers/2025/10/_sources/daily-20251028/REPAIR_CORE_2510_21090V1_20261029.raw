           <span id="alg1.l4.3" class="ltx_text ltx_font_bold">PPO fine-tune</span> <math id="alg1.l4.m1" class="ltx_Math" alttext="p_{\boldsymbol{\theta}^{(\textrm{SFT})}}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><msup><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mtext>SFT</mtext><mo stretchy="false">)</mo></mrow></msup></msub><annotation encoding="application/x-tex">p_{\boldsymbol{\theta}^{(\textrm{SFT})}}</annotation></semantics></math> using <math id="alg1.l4.m2" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math> and the reward <math id="alg1.l4.m3" class="ltx_Math" alttext="\tilde{r}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>r</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{r}</annotation></semantics></math>.

