<td id="S5.T2.7.1.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T2.7.1.1.2.1" class="ltx_text ltx_font_bold">Epochs</span></td>
<td id="S5.T2.7.1.1.3" class="ltx_td ltx_align_center ltx_border_tt"><math id="S5.T2.m9" class="ltx_Math" alttext="\#" display="inline" intent=":literal"><semantics><mi>#</mi><annotation encoding="application/x-tex">\#</annotation></semantics></math><span id="S5.T2.7.1.1.3.1" class="ltx_text ltx_font_bold">Params.</span></td>
