<tr id="S5.T2.7.1.7" class="ltx_tr">
<td id="S5.T2.7.1.7.1" class="ltx_td ltx_align_left ltx_border_r">MDTv2-XL <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib62" title="" class="ltx_ref">62</a>]</cite><sup id="S5.T2.7.1.7.1.1" class="ltx_sup"><span id="S5.T2.7.1.7.1.1.1" class="ltx_text ltx_font_italic">†</span></sup></td>
<td id="S5.T2.7.1.7.2" class="ltx_td ltx_align_center">1080</td>
<td id="S5.T2.7.1.7.3" class="ltx_td ltx_align_center">675M</td>
