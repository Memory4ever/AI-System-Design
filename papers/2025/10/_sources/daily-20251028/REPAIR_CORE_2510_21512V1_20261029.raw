<td id="A4.T12.2.1.6" class="ltx_td ltx_align_center ltx_border_tt" style="padding:1pt 10.0pt;">CLIP<math id="A4.T12.m6" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td></tr>
