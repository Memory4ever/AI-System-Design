<td id="A4.T12.2.6.4" class="ltx_td ltx_align_center" style="padding:1pt 10.0pt;"><span id="A4.T12.2.6.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E0ECF7;">29.20</span></td>
