<td id="A4.T11.2.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding:1pt 3.0pt;">HPSv2<math id="A4.T11.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="A4.T11.2.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding:1pt 3.0pt;">AES<math id="A4.T11.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
