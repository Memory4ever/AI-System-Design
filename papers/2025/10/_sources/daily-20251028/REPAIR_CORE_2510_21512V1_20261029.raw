<tr id="S3.T2.2.8" class="ltx_tr">
<td id="S3.T2.2.8.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:1pt 2.5pt;">CFG<math id="S3.T2.m11" class="ltx_Math" alttext="\times 2" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\times 2</annotation></semantics></math></td>
