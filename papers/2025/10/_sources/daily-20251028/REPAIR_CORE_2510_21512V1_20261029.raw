<td id="A4.T12.2.7.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:1pt 10.0pt;">CFG<math id="A4.T12.m7" class="ltx_Math" alttext="\times 2" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\times 2</annotation></semantics></math></td>
<td id="A4.T12.2.7.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:1pt 10.0pt;">100</td>
<td id="A4.T12.2.7.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:1pt 10.0pt;">117.84</td>
<td id="A4.T12.2.7.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:1pt 10.0pt;">29.25</td>
<td id="A4.T12.2.7.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:1pt 10.0pt;">6.33</td>
