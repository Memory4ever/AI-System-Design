              <math id="algorithm2.m14" class="ltx_Math" alttext="\xi_{t}=\sqrt{1-\bar{\alpha}_{t}}-\sqrt{\alpha_{t}-\bar{\alpha}_{t}}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">ξ</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">=</mo><mrow><msqrt><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><msub><mover accent="true"><mi mathsize="0.900em">α</mi><mo>¯</mo></mover><mi mathsize="0.900em">t</mi></msub></mrow></msqrt><mo mathsize="0.900em">−</mo><msqrt><mrow><msub><mi mathsize="0.900em">α</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">−</mo><msub><mover accent="true"><mi mathsize="0.900em">α</mi><mo>¯</mo></mover><mi mathsize="0.900em">t</mi></msub></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">\xi_{t}=\sqrt{1-\bar{\alpha}_{t}}-\sqrt{\alpha_{t}-\bar{\alpha}_{t}}</annotation></semantics></math><span id="algorithm2.4.7.5" class="ltx_text" style="font-size:90%;">;</span>
</div>
<div id="algorithm2.4.8" class="ltx_listingline"><span id="algorithm2.4.8.1" class="ltx_text" style="font-size:90%;"> </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm2.4.8.2" class="ltx_text" style="font-size:90%;">   </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm2.4.8.3" class="ltx_text" style="font-size:90%;">  </span>
