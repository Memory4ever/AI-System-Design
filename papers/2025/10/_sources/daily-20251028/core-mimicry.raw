<span id="S4.T4.2.10.2.1" class="ltx_inline-block ltx_align_top" style="width:62.6pt;">
<span id="S4.T4.2.10.2.1.1" class="ltx_p"><span id="S4.T4.2.10.2.1.1.1" class="ltx_text" style="font-size:50%;">3/5; 60.0%; [23.1%, 88.2%]</span></span>
</span></td>
<td id="S4.T4.2.10.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb">
<span id="S4.T4.2.10.3.1" class="ltx_inline-block ltx_align_top" style="width:62.6pt;">
<span id="S4.T4.2.10.3.1.1" class="ltx_p"><span id="S4.T4.2.10.3.1.1.1" class="ltx_text" style="font-size:50%;">4/5; 80.0%; [37.6%, 96.4%]</span></span>
</span></td>
<td id="S4.T4.2.10.4" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb">
<span id="S4.T4.2.10.4.1" class="ltx_inline-block ltx_align_top" style="width:62.6pt;">
<span id="S4.T4.2.10.4.1.1" class="ltx_p"><span id="S4.T4.2.10.4.1.1.1" class="ltx_text" style="font-size:50%;">5/5; 100.0%; [56.6%, 100.0%]</span></span>
</span></td>
