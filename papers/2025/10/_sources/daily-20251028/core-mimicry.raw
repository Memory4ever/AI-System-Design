</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#666666;--ltx-fill-color:#F2F2F2;" fill="#F2F2F2" stroke="#666666" stroke-width="0.9pt"><path d="M 448.35 43.31 L 333.68 43.31 C 329.1 43.31 325.38 39.59 325.38 35 L 325.38 -35 C 325.38 -39.59 329.1 -43.31 333.68 -43.31 L 448.35 -43.31 C 452.94 -43.31 456.65 -39.59 456.65 -35 L 456.65 35 C 456.65 39.59 452.94 43.31 448.35 43.31 Z M 325.38 -43.31"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.9pt" transform="matrix(1.0 0.0 0.0 1.0 329.99 21.06)"><foreignObject style="--ltx-fo-width:10.38em;--ltx-fo-height:0.56em;--ltx-fo-depth:3.6em;font-size:10pt;" height="57.5" overflow="visible" transform="matrix(1 0 0 -1 0 7.69)" width="143.63"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
