<td id="S4.T4.2.8.5" class="ltx_td ltx_align_left ltx_align_top">
<span id="S4.T4.2.8.5.1" class="ltx_inline-block ltx_align_top" style="width:62.6pt;">
<span id="S4.T4.2.8.5.1.1" class="ltx_p"><span id="S4.T4.2.8.5.1.1.1" class="ltx_text" style="font-size:50%;">7/11; 63.6%; [35.2%, 84.8%]</span></span>
</span></td></tr>
<tr id="S4.T4.2.9" class="ltx_tr">
<td id="S4.T4.2.9.1" class="ltx_td ltx_align_left ltx_align_top">
<span id="S4.T4.2.9.1.1" class="ltx_inline-block ltx_align_top" style="width:71.1pt;">
<span id="S4.T4.2.9.1.1.1" class="ltx_p"><span id="S4.T4.2.9.1.1.1.1" class="ltx_text" style="font-size:50%;">Psychological Manipulation</span></span>
</span></td>
<td id="S4.T4.2.9.2" class="ltx_td ltx_align_left ltx_align_top">
<span id="S4.T4.2.9.2.1" class="ltx_inline-block ltx_align_top" style="width:62.6pt;">
<span id="S4.T4.2.9.2.1.1" class="ltx_p"><span id="S4.T4.2.9.2.1.1.1" class="ltx_text" style="font-size:50%;">11/21; 52.4%; [32.4%, 71.7%]</span></span>
</span></td>
<td id="S4.T4.2.9.3" class="ltx_td ltx_align_left ltx_align_top">
<span id="S4.T4.2.9.3.1" class="ltx_inline-block ltx_align_top" style="width:62.6pt;">
<span id="S4.T4.2.9.3.1.1" class="ltx_p"><span id="S4.T4.2.9.3.1.1.1" class="ltx_text" style="font-size:50%;">16/21; 76.2%; [54.9%, 89.4%]</span></span>
</span></td>
<td id="S4.T4.2.9.4" class="ltx_td ltx_align_left ltx_align_top">
<span id="S4.T4.2.9.4.1" class="ltx_inline-block ltx_align_top" style="width:62.6pt;">
<span id="S4.T4.2.9.4.1.1" class="ltx_p"><span id="S4.T4.2.9.4.1.1.1" class="ltx_text" style="font-size:50%;">9/21; 42.9%; [24.5%, 63.5%]</span></span>
</span></td>
<td id="S4.T4.2.9.5" class="ltx_td ltx_align_left ltx_align_top">
<span id="S4.T4.2.9.5.1" class="ltx_inline-block ltx_align_top" style="width:62.6pt;">
<span id="S4.T4.2.9.5.1.1" class="ltx_p"><span id="S4.T4.2.9.5.1.1.1" class="ltx_text" style="font-size:50%;">5/21; 23.8%; [10.6%, 45.1%]</span></span>
</span></td></tr>
<tr id="S4.T4.2.10" class="ltx_tr">
<td id="S4.T4.2.10.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb">
