<div id="alg1.l12" class="ltx_listingline">
            
            
           Output: new parameters <math id="alg1.l12.m1" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> and <math id="alg1.l12.m2" class="ltx_Math" alttext="\xi" display="inline" intent=":literal"><semantics><mi>ξ</mi><annotation encoding="application/x-tex">\xi</annotation></semantics></math> for <math id="alg1.l12.m3" class="ltx_Math" alttext="p_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">p_{\theta}</annotation></semantics></math> and <math id="alg1.l12.m4" class="ltx_Math" alttext="q_{\xi}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi>ξ</mi></msub><annotation encoding="application/x-tex">q_{\xi}</annotation></semantics></math>

