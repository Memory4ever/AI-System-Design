<td id="S5.T1.12.1.4.5" class="ltx_td ltx_align_center" style="padding:0.25pt 7.1pt;"><math id="S5.T1.m10" class="ltx_Math" alttext="-" display="inline" intent=":literal"><semantics><mo mathsize="0.900em">−</mo><annotation encoding="application/x-tex">-</annotation></semantics></math></td>
<td id="S5.T1.12.1.4.6" class="ltx_td ltx_align_center ltx_border_r" style="padding:0.25pt 7.1pt;"><math id="S5.T1.m11" class="ltx_Math" alttext="-" display="inline" intent=":literal"><semantics><mo mathsize="0.900em">−</mo><annotation encoding="application/x-tex">-</annotation></semantics></math></td>
<td id="S5.T1.12.1.4.7" class="ltx_td ltx_align_center" style="padding:0.25pt 7.1pt;"><span id="S5.T1.12.1.4.7.1" class="ltx_text" style="font-size:90%;">400M</span></td>
<td id="S5.T1.12.1.4.8" class="ltx_td ltx_align_center ltx_border_r" style="padding:0.25pt 7.1pt;"><span id="S5.T1.12.1.4.8.1" class="ltx_text" style="font-size:90%;">250</span></td>
