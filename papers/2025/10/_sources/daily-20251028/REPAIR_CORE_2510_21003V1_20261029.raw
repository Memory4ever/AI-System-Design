<td id="A2.T6.8.1.2.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding:0.25pt 7.1pt;"><span id="A2.T6.8.1.2.3.1" class="ltx_text" style="font-size:90%;">5.43</span></td>
<td id="A2.T6.8.1.2.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding:0.25pt 7.1pt;"><span id="A2.T6.8.1.2.4.1" class="ltx_text" style="font-size:90%;">4.91</span></td>
<td id="A2.T6.8.1.2.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding:0.25pt 7.1pt;"><span id="A2.T6.8.1.2.5.1" class="ltx_text" style="font-size:90%;">35.6</span></td>
<td id="A2.T6.8.1.2.6" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding:0.25pt 7.1pt;"><span id="A2.T6.8.1.2.6.1" class="ltx_text" style="font-size:90%;">136.5</span></td>
<td id="A2.T6.8.1.2.7" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding:0.25pt 7.1pt;"><span id="A2.T6.8.1.2.7.1" class="ltx_text" style="font-size:90%;">69.7</span></td>
<td id="A2.T6.8.1.2.8" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding:0.25pt 7.1pt;"><span id="A2.T6.8.1.2.8.1" class="ltx_text" style="font-size:90%;">44.8</span></td>
