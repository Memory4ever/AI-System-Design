</span>
<span id="alg4.l4" class="ltx_listingline">
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l4.1" class="ltx_text" style="font-size:89%;">4:</span></span>
                  
                  
                   <math id="alg4.l4.m1" class="ltx_Math" alttext="X[t]\leftarrow q_{t}^{\prime}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">←</mo><msubsup><mi>q</mi><mi>t</mi><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">X[t]\leftarrow q_{t}^{\prime}</annotation></semantics></math>

