<td id="A2.T6.8.1.1.7" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.25pt 7.1pt;"><span id="A2.T6.8.1.1.7.1" class="ltx_text" style="font-size:90%;">CT</span><cite class="ltx_cite ltx_citemacro_citep"><span id="A2.T6.8.1.1.7.2" class="ltx_text" style="font-size:90%;">[</span><a href="#bib.bib33" title="" class="ltx_ref">33</a><span id="A2.T6.8.1.1.7.3" class="ltx_text" style="font-size:90%;">]</span></cite></td>
