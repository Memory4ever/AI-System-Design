                 <span id="alg4.l2.5" class="ltx_text ltx_font_bold">for</span> <math id="alg4.l2.m1" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> in <math id="alg4.l2.m2" class="ltx_Math" alttext="\{n-k+2,\ldots,n\}" display="inline" intent=":literal"><semantics><mrow><mo maxsize="1.110em" minsize="1.110em">{</mo><mrow><mrow><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mn>2</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi></mrow><mo maxsize="1.110em" minsize="1.110em">}</mo></mrow><annotation encoding="application/x-tex">\{n-k+2,\ldots,n\}</annotation></semantics></math> <span id="alg4.l2.6" class="ltx_text ltx_font_bold">do</span>



</span>
<span id="alg4.l3" class="ltx_listingline">
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l3.1" class="ltx_text" style="font-size:89%;">3:</span></span>
                  
                  
