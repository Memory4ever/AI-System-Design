<td id="A2.T6.8.1.1.9" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.25pt 7.1pt;"><span id="A2.T6.8.1.1.9.1" class="ltx_text" style="font-size:90%;">Shortcut</span><cite class="ltx_cite ltx_citemacro_citep"><span id="A2.T6.8.1.1.9.2" class="ltx_text" style="font-size:90%;">[</span><a href="#bib.bib7" title="" class="ltx_ref">7</a><span id="A2.T6.8.1.1.9.3" class="ltx_text" style="font-size:90%;">]</span></cite></td></tr>
<tr id="A2.T6.8.1.2" class="ltx_tr">
<td id="A2.T6.8.1.2.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r ltx_border_t" style="padding:0.25pt 7.1pt;"><span id="A2.T6.8.1.2.1.1" class="ltx_text" style="font-size:90%;">FID</span><math id="A2.T6.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo mathsize="0.900em" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td>
