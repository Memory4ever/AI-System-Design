<td id="A2.T6.8.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.25pt 7.1pt;"><span id="A2.T6.8.1.1.3.1" class="ltx_text" style="font-size:90%;">DD2-VAR-d20</span></td>
