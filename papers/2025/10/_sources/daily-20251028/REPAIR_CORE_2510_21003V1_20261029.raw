<div id="alg2.4" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.4.1" class="ltx_listingline">
<span id="alg2.4.1.1" class="ltx_text" style="font-size:90%;">




















































<span id="alg2.4.1.1.1" class="ltx_listing ltx_listing">
<span id="alg2.l0" class="ltx_listingline">
                        <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l0.1" class="ltx_text" style="font-size:89%;">0:</span></span>
                        
                        
                       dataset <math id="alg2.l0.m1" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math>, the pre-trained teacher AR model <math id="alg2.l0.m2" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math>, AR-diffusion model <math id="alg2.l0.m3" class="ltx_Math" alttext="\Psi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ψ</mi><annotation encoding="application/x-tex">\Psi</annotation></semantics></math>.

</span>
<span id="alg2.4.1.1.1.1" class="ltx_listingline">
</span>
<span id="alg2.l1" class="ltx_listingline">
                        <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l1.1" class="ltx_text" style="font-size:89%;">1:</span></span>
                        
                        
                       initialize the backbone of <math id="alg2.l1.m1" class="ltx_Math" alttext="\Psi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ψ</mi><annotation encoding="application/x-tex">\Psi</annotation></semantics></math> with the backbone of <math id="alg2.l1.m2" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math>, randomly initialize the MLP head of <math id="alg2.l1.m3" class="ltx_Math" alttext="\Psi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ψ</mi><annotation encoding="application/x-tex">\Psi</annotation></semantics></math>

</span>
<span id="alg2.4.1.1.1.2" class="ltx_listingline">
</span>
<span id="alg2.l2" class="ltx_listingline">
                        <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l2.1" class="ltx_text" style="font-size:89%;">2:</span></span>
                        
                        
                       <span id="alg2.l2.5" class="ltx_text ltx_font_bold">while</span> not converged <span id="alg2.l2.6" class="ltx_text ltx_font_bold">do</span>



</span>
<span id="alg2.l3" class="ltx_listingline">
                        <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l3.1" class="ltx_text" style="font-size:89%;">3:</span></span>
                        
                        
                         Sample <math id="alg2.l3.m1" class="ltx_Math" alttext="z=(q_{1},\ldots,q_{n})\sim\mathcal{D}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>q</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow><annotation encoding="application/x-tex">z=(q_{1},\ldots,q_{n})\sim\mathcal{D}</annotation></semantics></math>

</span>
<span id="alg2.l4" class="ltx_listingline">
                        <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l4.1" class="ltx_text" style="font-size:89%;">4:</span></span>
                        
                        
                         Sample <math id="alg2.l4.m1" class="ltx_Math" alttext="t=(t_{1},\ldots,t_{n})" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>t</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">t=(t_{1},\ldots,t_{n})</annotation></semantics></math>, sample <math id="alg2.l4.m2" class="ltx_Math" alttext="z_{\epsilon}=(\epsilon_{1},\ldots,\epsilon_{n})" display="inline" intent=":literal"><semantics><mrow><msub><mi>z</mi><mi>ϵ</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>ϵ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>ϵ</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">z_{\epsilon}=(\epsilon_{1},\ldots,\epsilon_{n})</annotation></semantics></math> from Gaussian distribution

</span>
<span id="alg2.l5" class="ltx_listingline">
                        <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l5.1" class="ltx_text" style="font-size:89%;">5:</span></span>
                        
                        
                         <math id="alg2.l5.m1" class="ltx_Math" alttext="z^{t}=(q^{t_{1}}_{1},\ldots,q^{t_{n}}_{n})\leftarrow(1-t)z+tz_{\epsilon}" display="inline" intent=":literal"><semantics><mrow><msup><mi>z</mi><mi>t</mi></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>q</mi><mn>1</mn><msub><mi>t</mi><mn>1</mn></msub></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>q</mi><mi>n</mi><msub><mi>t</mi><mi>n</mi></msub></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">←</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow><mo>+</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>z</mi><mi>ϵ</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">z^{t}=(q^{t_{1}}_{1},\ldots,q^{t_{n}}_{n})\leftarrow(1-t)z+tz_{\epsilon}</annotation></semantics></math>

</span>
<span id="alg2.l6" class="ltx_listingline">
                        <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l6.1" class="ltx_text" style="font-size:89%;">6:</span></span>
                        
                        
                         update <math id="alg2.l6.m1" class="ltx_Math" alttext="\Psi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ψ</mi><annotation encoding="application/x-tex">\Psi</annotation></semantics></math> with <math id="alg2.l6.m2" class="ltx_Math" alttext="\mathcal{L}_{GTS}(z^{t},z,t,\Psi,\Phi)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>z</mi><mi>t</mi></msup><mo>,</mo><mi>z</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi mathvariant="normal">Ψ</mi><mo>,</mo><mi mathvariant="normal">Φ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{GTS}(z^{t},z,t,\Psi,\Phi)</annotation></semantics></math> <a href="#S3.E6" title="In 3.3 Initialization of Generator and Guidance Network ‣ 3 Distilled Decoding 2 ‣ Distilled Decoding 2: One-step Sampling of Image Auto-regressive Models with Conditional Score Distillation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">6</span></a>.

</span>
<span id="alg2.l7" class="ltx_listingline">
                        <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l7.1" class="ltx_text" style="font-size:89%;">7:</span></span>
                        
                        
                       <span id="alg2.l7.5" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l7.6" class="ltx_text ltx_font_bold">while</span>
</span>
<span id="alg2.l8" class="ltx_listingline">
                        <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l8.1" class="ltx_text" style="font-size:89%;">8:</span></span>
                        
                        
