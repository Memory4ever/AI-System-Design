</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
<figure id="S2.F2.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.21110v1/figures/masked_pong_obs.jpg" id="S2.F2.sf2.g1" class="ltx_graphics ltx_centering ltx_img_portrait" style="aspect-ratio:476/624;" width="476" height="624" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S2.F2.sf2.3" class="ltx_text" style="font-size:90%;">(b)</span> </span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
