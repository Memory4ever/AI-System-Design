<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S2.F2.sf3.3" class="ltx_text" style="font-size:90%;">(c)</span> </span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
