              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.13.1" class="ltx_text ltx_font_bold">12</span></span>
            Action <math id="algorithm2.m25" class="ltx_Math" alttext="a_{t}\leftarrow\pi(s_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>t</mi></msub><mo stretchy="false">←</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">a_{t}\leftarrow\pi(s_{t})</annotation></semantics></math>, observe <math id="algorithm2.m26" class="ltx_Math" alttext="s_{t+1}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">s_{t+1}</annotation></semantics></math>
</div>
<div id="algorithm2.6.14" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.14.1" class="ltx_text ltx_font_bold">13</span></span>
            Update window with <math id="algorithm2.m27" class="ltx_Math" alttext="s_{t+1}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">s_{t+1}</annotation></semantics></math>
</div>
<div id="algorithm2.6.15" class="ltx_listingline">
