            <span id="algorithm2.6.2.2" class="ltx_text ltx_font_bold">Training:</span>
</div>
<div id="algorithm2.6.3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.3.1" class="ltx_text ltx_font_bold">2</span></span>
            Initialize ensemble of Isolation Forests <math id="algorithm2.m7" class="ltx_Math" alttext="\text{IF}=\{\text{IF}_{1},\dots,\text{IF}_{N}\}" display="inline" intent=":literal"><semantics><mrow><mtext>IF</mtext><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mtext>IF</mtext><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mtext>IF</mtext><mi>N</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\text{IF}=\{\text{IF}_{1},\dots,\text{IF}_{N}\}</annotation></semantics></math>
</div>
<div id="algorithm2.6.4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.4.1" class="ltx_text ltx_font_bold">3</span></span>
            Partition <math id="algorithm2.m8" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> into windows of size <math id="algorithm2.m9" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math>
</div>
<div id="algorithm2.6.5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.5.1" class="ltx_text ltx_font_bold">4</span></span>
            <span id="algorithm2.6.5.2" class="ltx_text ltx_font_bold">for</span> <em id="algorithm2.6.5.3" class="ltx_emph ltx_font_italic">each <math id="algorithm2.m10" class="ltx_Math" alttext="X_{i}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>i</mi></msub><annotation encoding="application/x-tex">X_{i}</annotation></semantics></math> in windows</em> <span id="algorithm2.6.5.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm2.6.6" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
