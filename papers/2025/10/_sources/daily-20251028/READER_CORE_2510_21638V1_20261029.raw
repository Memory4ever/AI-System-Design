<td id="S4.T3.2.1.6.14" class="ltx_td ltx_align_center ltx_border_b ltx_border_r">0.65</td>
<td id="S4.T3.2.1.6.15" class="ltx_td ltx_align_center ltx_border_b">0.65</td>
