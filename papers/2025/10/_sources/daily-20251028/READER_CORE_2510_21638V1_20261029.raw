            <span id="algorithm2.6.11.2" class="ltx_text ltx_font_bold">Anomaly Score Computation <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib13" title="" class="ltx_ref">Nasvytis et al., 2024</a>)</cite>:</span>
</div>
<div id="algorithm2.6.12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.12.1" class="ltx_text ltx_font_bold">11</span></span>
            <span id="algorithm2.6.12.2" class="ltx_text ltx_font_bold">for</span> <em id="algorithm2.6.12.3" class="ltx_emph ltx_font_italic">Time <math id="algorithm2.m22" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> from <math id="algorithm2.m23" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> to <math id="algorithm2.m24" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math></em> <span id="algorithm2.6.12.4" class="ltx_text ltx_font_bold">do</span>
