            Train <math id="algorithm2.m20" class="ltx_Math" alttext="\text{IF}_{n}" display="inline" intent=":literal"><semantics><msub><mtext>IF</mtext><mi>n</mi></msub><annotation encoding="application/x-tex">\text{IF}_{n}</annotation></semantics></math> using <math id="algorithm2.m21" class="ltx_Math" alttext="\mathcal{V}^{(n)}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\mathcal{V}^{(n)}</annotation></semantics></math>
