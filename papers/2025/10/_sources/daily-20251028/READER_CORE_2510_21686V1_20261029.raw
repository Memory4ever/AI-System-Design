<tr id="S4.T1.2.2" class="ltx_tr">
<td id="S4.T1.2.2.1" class="ltx_td ltx_align_left ltx_border_t">Black Hole Mass</td>
<td id="S4.T1.2.2.2" class="ltx_td ltx_align_left ltx_border_t">1</td>
<td id="S4.T1.2.2.3" class="ltx_td ltx_align_left ltx_border_t">0</td>
<td id="S4.T1.2.2.4" class="ltx_td ltx_align_left ltx_border_t">2.77</td>
<td id="S4.T1.2.2.5" class="ltx_td ltx_align_left ltx_border_t">0</td>
<td id="S4.T1.2.2.6" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t">2.63</td></tr>
<tr id="S4.T1.2.3" class="ltx_tr">
<td id="S4.T1.2.3.1" class="ltx_td ltx_align_left ltx_border_bb">Atmospheric Effect</td>
<td id="S4.T1.2.3.2" class="ltx_td ltx_align_left ltx_border_bb">0</td>
<td id="S4.T1.2.3.3" class="ltx_td ltx_align_left ltx_border_bb">1</td>
<td id="S4.T1.2.3.4" class="ltx_td ltx_align_left ltx_border_bb">2.77</td>
<td id="S4.T1.2.3.5" class="ltx_td ltx_align_left ltx_border_bb">3.33</td>
<td id="S4.T1.2.3.6" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_bb">2.63</td></tr>
