<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex59X.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{n}\sum_{g=1}^{G}\sum_{t=1}^{n_{g}}\|\widehat{\pi}(\mathbf{X}_{g},\mathbf{S}_{gt})-{\pi}(\mathbf{X}_{g},\mathbf{S}_{gt})\|\|\widehat{\mu}(\mathbf{X}_{g},\mathbf{S}_{gt})-{\mu}(\mathbf{X}_{g},\mathbf{S}_{gt})\|" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>g</mi><mo>=</mo><mn>1</mn></mrow><mi>G</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>n</mi><mi>g</mi></msub></munderover></mstyle><mrow><mrow><mo stretchy="false">‖</mo><mrow><mrow><mover accent="true"><mi>π</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mi>g</mi></msub><mo>,</mo><msub><mi>𝐒</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mi>g</mi></msub><mo>,</mo><msub><mi>𝐒</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><mrow><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mi>g</mi></msub><mo>,</mo><msub><mi>𝐒</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mi>g</mi></msub><mo>,</mo><msub><mi>𝐒</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{n}\sum_{g=1}^{G}\sum_{t=1}^{n_{g}}\|\widehat{\pi}(\mathbf{X}_{g},\mathbf{S}_{gt})-{\pi}(\mathbf{X}_{g},\mathbf{S}_{gt})\|\|\widehat{\mu}(\mathbf{X}_{g},\mathbf{S}_{gt})-{\mu}(\mathbf{X}_{g},\mathbf{S}_{gt})\|</annotation></semantics></math></td>
