>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mi>g</mi></msub><mo>,</mo><msub><mi>𝐒</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\frac{\pi(\mathbf{X}_{g},\mathbf{S}_{gt})(\mu(\mathbf{X}_{g},\mathbf{S}_{gt})-\widehat{\mu}(\mathbf{X}_{g},\mathbf{S}_{gt}))}{\widehat{\pi}(\mathbf{X}_{g},\mathbf{S}_{gt})}+\widehat{\mu}(\mathbf{X}_{g},\mathbf{S}_{gt})-{\mu}(\mathbf{X}_{g},\mathbf{S}_{gt})\right]</annotation></semantics></math></td>
