<th id="A5.T1.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">IPW estimator</th>
<th id="A5.T1.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">DR estimator</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A5.T1.2.2" class="ltx_tr">
<th id="A5.T1.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><math id="A5.T1.m1" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math> correct, <math id="A5.T1.m2" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> correct</th>
<td id="A5.T1.2.2.2" class="ltx_td ltx_align_center ltx_border_t">0.0562</td>
<td id="A5.T1.2.2.3" class="ltx_td ltx_align_center ltx_border_t">0.0561</td>
<td id="A5.T1.2.2.4" class="ltx_td ltx_align_center ltx_border_t">0.0563</td></tr>
<tr id="A5.T1.2.3" class="ltx_tr">
<th id="A5.T1.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A5.T1.m3" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math> correct, <math id="A5.T1.m4" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> wrong</th>
