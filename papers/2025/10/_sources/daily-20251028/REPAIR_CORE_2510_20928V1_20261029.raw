<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex58Xe.m3" class="ltx_Math" alttext="\displaystyle\frac{1}{\epsilon}\sqrt{\sup_{\boldsymbol{x},\boldsymbol{s}}\mathbb{E}_{D}(\widehat{\pi}(\boldsymbol{x},\boldsymbol{s})-{\pi}(\boldsymbol{x},\boldsymbol{s}))^{2}\sup_{\boldsymbol{x},\boldsymbol{s}}\mathbb{E}_{D}(\widehat{\mu}(\boldsymbol{x},\boldsymbol{s})-{\mu}(\boldsymbol{x},\boldsymbol{s}))^{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>ϵ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒔</mi></mrow></munder><mrow><msub><mi>𝔼</mi><mi>D</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mover accent="true"><mi>π</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒔</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒔</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0.167em">sup</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒔</mi></mrow></munder><mrow><msub><mi>𝔼</mi><mi>D</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒔</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒔</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow></msqrt></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac