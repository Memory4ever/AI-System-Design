<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex52Xa.m3" class="ltx_Math" alttext="\displaystyle O_{\mathbb{P}}\left(\frac{\sqrt{\sum_{g=1}^{G}\operatorname{Var}\left(\sum_{t=1}^{n_{g}}\widehat{\varphi}(\mathbf{Z}_{gt})-\varphi(\mathbf{Z}_{gt})\mid D\right)}}{n}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>O</mi><mi>ℙ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msqrt><mrow><msubsup><mo>∑</mo><mrow><mi>g</mi><mo>=</mo><mn>1</mn></mrow><mi>G</mi></msubsup><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><msubsup><mo lspace="0em">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>n</mi><mi>g</mi></msub></msubsup><mrow><mover accent="true"><mi>φ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>D</mi><mo>)</mo></mrow></mrow></mrow></msqrt><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle O_{\mathbb{P}}\left(\frac{\sqrt{\sum_{g=1}^{G}\operatorname{Var}\left(\sum_{t=1}^{n_{g}}\widehat{\varphi}(\mathbf{Z}_{gt})-\varphi(\mathbf{Z}_{gt})\mid D\right)}}{n}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
