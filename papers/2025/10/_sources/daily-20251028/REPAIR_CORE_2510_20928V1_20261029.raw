<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex53Xd.m3" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\frac{(\pi(\mathbf{X}_{g},\mathbf{S}_{gt})-\widehat{\pi}(\mathbf{X}_{g},\mathbf{S}_{gt}))(\mu(\mathbf{X}_{g},\mathbf{S}_{gt})-\widehat{\mu}(\mathbf{X}_{g},\mathbf{S}_{gt}))}{\widehat{\pi}(\mathbf{X}_{g},\mathbf{S}_{gt})}\right]," display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mi>g</mi></msub><mo>,</mo><msub><mi>𝐒</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi>π</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mi>g</mi></msub><mo>,</mo><msub><mi>𝐒</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mi>g</mi></msub><mo>,</mo><msub><mi>𝐒</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mi>g</mi></msub><mo>,</mo><msub><mi>𝐒</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mover accent="true"><mi>π</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mi>g</mi></msub><mo>,</mo><msub><mi>𝐒</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\frac{(\pi(\mathbf{X}_{g},\mathbf{S}_{gt})-\widehat{\pi}(\mathbf{X}_{g},\mathbf{S}_{gt}))(\mu(\mathbf{X}_{g},\mathbf{S}_{gt})-\widehat{\mu}(\mathbf{X}_{g},\mathbf{S}_{gt}))}{\widehat{\pi}(\mathbf{X}_{g},\mathbf{S}_{gt})}\right],</annotation></semantics></math></td>
