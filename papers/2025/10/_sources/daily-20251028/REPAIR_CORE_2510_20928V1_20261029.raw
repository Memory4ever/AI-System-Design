<tr id="A5.T1.2.4" class="ltx_tr">
<th id="A5.T1.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A5.T1.m5" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math> wrong, <math id="A5.T1.m6" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> correct</th>
<td id="A5.T1.2.4.2" class="ltx_td ltx_align_center">2.0356</td>
<td id="A5.T1.2.4.3" class="ltx_td ltx_align_center">0.0563</td>
<td id="A5.T1.2.4.4" class="ltx_td ltx_align_center">0.0572</td></tr>
<tr id="A5.T1.2.5" class="ltx_tr">
<th id="A5.T1.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><math id="A5.T1.m7" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math> wrong, <math id="A5.T1.m8" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> wrong</th>
<td id="A5.T1.2.5.2" class="ltx_td ltx_align_center ltx_border_bb">2.0603</td>
