<tbody id="A9.Ex56Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex56Xc.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex56Xc.m3" class="ltx_Math" alttext="\displaystyle\sum_{g=1}^{G}\sum_{i,j}\left[\sqrt{\mathbb{E}_{\mathbf{Z}_{gi}}\left[\mathbb{E}_{D}\left(\widehat{\varphi}(\mathbf{Z}_{gi})-{\varphi}(\mathbf{Z}_{gi})\right)^{2}\right]\mathbb{E}_{\mathbf{Z}_{gj}}\left[\mathbb{E}_{D}\left(\widehat{\varphi}(\mathbf{Z}_{gj})-{\varphi}(\mathbf{Z}_{gj})\right)^{2}\right]}\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>g</mi><mo>=</mo><mn>1</mn></mrow><mi>G</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></munder></mstyle><mrow><mo>[</mo><msqrt><mrow><msub><mi>𝔼</mi><msub><mi>𝐙</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mi>𝔼</mi><mi>D</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mover accent="true"><mi>φ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msub><mi>𝐙</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mi>𝔼</mi><mi>D</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mover accent="true"><mi>φ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>]</mo></mrow></mrow></msqrt><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{g=1}^{G}\sum_{i,j}\left[\sqrt{\mathbb{E}_{\mathbf{Z}_{gi}}\left[\mathbb{E}_{D}\left(\widehat{\varphi}(\mathbf{Z}_{gi})-{\varphi}(\mathbf{Z}_{gi})\right)^{2}\right]\mathbb{E}_{\mathbf{Z}_{gj}}\left[\mathbb{E}_{D}\left(\widehat{\varphi}(\mathbf{Z}_{gj})-{\varphi}(\mathbf{Z}_{gj})\right)^{2}\right]}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex56Xd"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex56Xd.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex56Xd.m3" class="ltx_Math" alttext="\displaystyle\sum_{g=1}^{G}\sum_{i,j}\sup_{\mathbf{z}}\mathbb{E}_{D}\left[(\widehat{\varphi}(\mathbf{z})-{\varphi}(\mathbf{z}))^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>g</mi><mo>=</mo><mn>1</mn></mrow><mi>G</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></munder></mstyle><mrow><munder><mo lspace="0.167em" movablelimits="false" rspace="0.167em">sup</mo><mi>𝐳</mi></munder><mrow><msub><mi>𝔼</mi><mi>D</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mover accent="true"><mi>φ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{g=1}^{G}\sum_{i,j}\sup_{\mathbf{z}}\mathbb{E}_{D}\left[(\widehat{\varphi}(\mathbf{z})-{\varphi}(\mathbf{z}))^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex56Xe"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex56Xe.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex56Xe.m3" class="ltx_Math" alttext="\displaystyle\sum_{g=1}^{G}n_{g}^{2}\mathbb{E}_{D}\left[(\widehat{\varphi}(\mathbf{z})-{\varphi}(\mathbf{z}))^{2}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>g</mi><mo>=</mo><mn>1</mn></mrow><mi>G</mi></munderover></mstyle><mrow><msubsup><mi>n</mi><mi>g</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>D</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mover accent="true"><mi>φ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{g=1}^{G}n_{g}^{2}\mathbb{E}_{D}\left[(\widehat{\varphi}(\mathbf{z})-{\varphi}(\mathbf{z}))^{2}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A9.p1.3" class="ltx_p">Thus we have</p>
<table id="A9.Ex57" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A9.Ex57.m1" class="ltx_Math" alttext="\frac{1}{n}\sqrt{\sum_{g=1}^{G}\operatorname{Var}\left(\sum_{i=1}^{n_{g}}(\widehat{\varphi}(\mathbf{Z}_{gi})-{\varphi}(\mathbf{Z}_{gi}))\mid D\right)}=O_{\mathbb{P}}\left(\frac{1}{n}\sqrt{\sum_{g=1}^{G}n_{g}^{2}\sup_{\mathbf{z}}\mathbb{E}_{D}\left[\widehat{\varphi}(\mathbf{z})-{\varphi}(\mathbf{z})^{2}\right]}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>g</mi><mo>=</mo><mn>1</mn></mrow><mi>G</mi></munderover><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>n</mi><mi>g</mi></msub></munderover><mrow><mo stretchy="false">(</mo><mrow><mrow><mover accent="true"><mi>φ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>D</mi><mo>)</mo></mrow></mrow></mrow></msqrt></mrow><mo>=</mo><mrow><msub><mi>O</mi><mi>ℙ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>g</mi><mo>=</mo><mn>1</mn></mrow><mi>G</mi></munderover><mrow><msubsup><mi>n</mi><mi>g</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0.167em">sup</mo><mi>𝐳</mi></munder><mrow><msub><mi>𝔼</mi><mi>D</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mover accent="true"><mi>φ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>φ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow></msqrt></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{1}{n}\sqrt{\sum_{g=1}^{G}\operatorname{Var}\left(\sum_{i=1}^{n_{g}}(\widehat{\varphi}(\mathbf{Z}_{gi})-{\varphi}(\mathbf{Z}_{gi}))\mid D\right)}=O_{\mathbb{P}}\left(\frac{1}{n}\sqrt{\sum_{g=1}^{G}n_{g}^{2}\sup_{\mathbf{z}}\mathbb{E}_{D}\left[\widehat{\varphi}(\mathbf{z})-{\varphi}(\mathbf{z})^{2}\right]}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A9.p1.4" class="ltx_p">For the bias term, from equation (<a href="#A8.E7" title="In Appendix H Proof of Theorem ‣ Handling Missing Responses under Cluster Dependence with Applications to Language Model Evaluation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>) the proof of Theorem <a href="#Thmtheorem2" title="Theorem 2. ‣ 4 Clustered Missing Data under Sequential Sampling ‣ Handling Missing Responses under Cluster Dependence with Applications to Language Model Evaluation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> we have</p>
<table id="A9.Ex58" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A9.Ex58X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex58X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{D}\left[\left|\frac{1}{n}\sum_{g=1}^{G}\sum_{t=1}^{n_{g}}\mathbb{P}[\widehat{\varphi}(\mathbf{Z}_{gt})-{\varphi}(\mathbf{Z}_{gt})]\right|\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi>D</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>g</mi><mo>=</mo><mn>1</mn></mrow><mi>G</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>n</mi><mi>g</mi></msub></munderover></mstyle><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mover accent="true"><mi>φ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><mo>|</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{D}\left[\left|\frac{1}{n}\sum_{g=1}^{G}\sum_{t=1}^{n_{g}}\mathbb{P}[\widehat{\varphi}(\mathbf{Z}_{gt})-{\varphi}(\mathbf{Z}_{gt})]\right|\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
