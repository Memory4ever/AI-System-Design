<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex56Xb.m3" class="ltx_Math" alttext="\displaystyle\sum_{g=1}^{G}\sum_{i,j}\left[\sqrt{\mathbb{E}_{D}\left[\mathbb{E}_{\mathbf{Z}_{gi}}\left(\widehat{\varphi}(\mathbf{Z}_{gi})-{\varphi}(\mathbf{Z}_{gi}))^{2}\right)\right]\mathbb{E}_{D}\left[\mathbb{E}_{\mathbf{Z}_{gj}}\left((\widehat{\varphi}(\mathbf{Z}_{gj})-{\varphi}(\mathbf{Z}_{gj}))^{2}\right)\right]}\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>g</mi><mo>=</mo><mn>1</mn></mrow><mi>G</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></munder></mstyle><mrow><mo>[</mo><msqrt><mrow><mi>𝔼</mi><msub><mrow></mrow><mi>D</mi></msub><mo>[</mo><mi>𝔼</mi><msub><mrow></mrow><msub><mi>𝐙</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub></msub><mo>(</mo><mover accent="true"><mi>φ</mi><mo>^</mo></mover><mo stretchy="false">(</mo><mi>𝐙</mi><msub><mrow></mrow><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo><mo>−</mo><mi>φ</mi><mo stretchy="false">(</mo><mi>𝐙</mi><msub><mrow></mrow><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><msup><mrow></mrow><mn>2</mn></msup><mo>)</mo><mo>]</mo><mi>𝔼</mi><msub><mrow></mrow><mi>D</mi></msub><mo>[</mo><mi>𝔼</mi><msub><mrow></mrow><msub><mi>𝐙</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></msub><mo>(</mo><mo stretchy="false">(</mo><mover accent="true"><mi>φ</mi><mo>^</mo></mover><mo stretchy="false">(</mo><mi>𝐙</mi><msub><mrow></mrow><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo><mo>−</mo><mi>φ</mi><mo stretchy="false">(</mo><mi>𝐙</mi><msub><mrow></mrow><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><msup><mrow></mrow><mn>2</mn></msup><mo>)</mo><mo>]</mo></mrow></msqrt><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{g=1}^{G}\sum_{i,j}\left[\sqrt{\mathbb{E}_{D}\left[\mathbb{E}_{\mathbf{Z}_{gi}}\left(\widehat{\varphi}(\mathbf{Z}_{gi})-{\varphi}(\mathbf{Z}_{gi}))^{2}\right)\right]\mathbb{E}_{D}\left[\mathbb{E}_{\mathbf{Z}_{gj}}\left((\widehat{\varphi}(\mathbf{Z}_{gj})-{\varphi}(\mathbf{Z}_{gj}))^{2}\right)\right]}\right]</annotation></semantics></math></td>
