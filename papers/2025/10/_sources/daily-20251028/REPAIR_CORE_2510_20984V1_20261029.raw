<th id="A8.T11.4.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-top:-0.2pt;padding-bottom:-0.2pt;"><span id="A8.T11.4.1.1.2.1" class="ltx_text" style="font-size:80%;">Tokens</span></th>
