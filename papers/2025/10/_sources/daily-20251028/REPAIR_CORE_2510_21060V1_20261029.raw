<td id="A8.T1.2.5.5" class="ltx_td ltx_align_center">500.00</td></tr>
<tr id="A8.T1.2.6" class="ltx_tr">
<th id="A8.T1.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A8.T1.2.6.1.1" class="ltx_text ltx_font_typewriter">DP<span id="A8.T1.2.6.1.1.1" class="ltx_text">-</span>NPG</span></th>
<th id="A8.T1.2.6.2" class="ltx_td ltx_align_center ltx_th ltx_th_row">5</th>
<td id="A8.T1.2.6.3" class="ltx_td ltx_align_center">478.73</td>
