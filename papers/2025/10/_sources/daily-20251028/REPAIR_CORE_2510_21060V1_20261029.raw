">\displaystyle=\mathbb{E}\left[\left\|\nabla J(\theta)+\frac{\lambda}{|\mathcal{X}|}\left(\frac{\mathbf{1}}{|\mathcal{Y}|}-[\pi_{x}(\theta)]_{x\in\mathcal{X}}\right)+\widetilde{\nabla}_{m}J(\theta)-\nabla J(\theta)\right\|^{2}\right]</annotation></semantics></math></td>
