<th id="A8.T1.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A8.T1.2.3.1.1" class="ltx_text ltx_font_typewriter">DP<span id="A8.T1.2.3.1.1.1" class="ltx_text">-</span>PG</span></th>
