<th id="A8.T1.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_tt"><math id="A8.T1.m1" class="ltx_Math" alttext="\boldsymbol{\varepsilon}" display="inline" intent=":literal"><semantics><mi>𝜺</mi><annotation encoding="application/x-tex">\boldsymbol{\varepsilon}</annotation></semantics></math></th>
<th id="A8.T1.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A8.T1.2.1.3.1" class="ltx_text ltx_font_bold">Mean Final Reward</span></th>
<th id="A8.T1.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A8.T1.2.1.4.1" class="ltx_text ltx_font_bold">Std Final Reward</span></th>
<th id="A8.T1.2.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A8.T1.2.1.5.1" class="ltx_text ltx_font_bold">Best Epoch Mean</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A8.T1.2.2" class="ltx_tr">
<th id="A8.T1.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">PG</th>
