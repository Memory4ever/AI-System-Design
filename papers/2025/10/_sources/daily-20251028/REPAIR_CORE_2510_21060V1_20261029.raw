e">[</mo><mrow><msub><mi>π</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow></msub></mrow><mo>)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mi>m</mi></mfrac></mstyle><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle(d)}}{{\leqslant}}\left(1-\frac{1}{m}\right)\|\nabla J_{\lambda}(\theta)\|^{2}+\frac{2\mathbb{E}\left[\|g_{\theta}(\tau_{1})\|^{2}\right]+2\left\|\frac{\lambda}{|\mathcal{X}|}\left(\frac{\mathbf{1}}{|\mathcal{Y}|}-[\pi_{x}(\theta)]_{x\in\mathcal{X}}\right)\right\|^{2}}{m}+d\sigma^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.SSS1.p7.2" class="ltx_p"><span id="A5.SS3.SSS1.p7.2.1" class="ltx_text">where <math id="A5.SS3.SSS1.p7.m1" class="ltx_Math" alttext="(a)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a)</annotation></semantics></math> and <math id="A5.SS3.SSS1.p7.m2" class="ltx_Math" alttext="(c)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(c)</annotation></semantics></math> hold by definition of <math id="A5.SS3.SSS1.p7.m3" class="ltx_Math" alttext="\nabla J_{\lambda}(\theta)" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>J</mi><mi>λ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla J_{\lambda}(\theta)</annotation></semantics></math>; <math id="A5.SS3.SSS1.p7.m4" class="ltx_Math" alttext="(b)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b)</annotation></semantics></math> holds by definition of <math id="A5.SS3.SSS1.p7.m5" class="ltx_Math" alttext="\widetilde{\nabla}_{m}J(\theta)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mo>∇</mo><mo>~</mo></mover><mi>m</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\nabla}_{m}J(\theta)</annotation></semantics></math>; <math id="A5.SS3.SSS1.p7.m6" class="ltx_Math" alttext="(d)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(d)</annotation></semantics></math> holds by <math id="A5.SS3.SSS1.p7.m7" class="ltx_Math" alttext="(p+q)^{2}\leqslant 2p^{2}+2q^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>+</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>⩽</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">(p+q)^{2}\leqslant 2p^{2}+2q^{2}</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS3.SSS1.p8" class="ltx_para">
<p id="A5.SS3.SSS1.p8.1" class="ltx_p"><span id="A5.SS3.SSS1.p8.1.1" class="ltx_text">In particular, we have</span></p>
<table id="A5.EGx51" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex71"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex71.m1" class="ltx_Math" alttext="\displaystyle\left\|\frac{\lambda}{|\mathcal{X}|}\left(\frac{\mathbf{1}}{|\mathcal{Y}|}-[\pi_{x}(\theta)]_{x\in\mathcal{X}}\right)\right\|^{2}\leqslant\frac{\lambda^{2}}{|\mathcal{X}|^{2}}\left(\frac{|\mathcal{X}||\mathcal{Y}|}{|\mathcal{Y}|^{2}}-2\frac{|\mathcal{X}|}{|\mathcal{Y}|}+|\mathcal{X}|\right)=\frac{\lambda^{2}}{|\mathcal{X}|}\left(1-\frac{1}{|\mathcal{Y}|}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><mfrac><mi>λ</mi><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>𝟏</mn><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo>−</mo><msub><mrow><mo stretchy="false">[</mo><mrow><msub><mi>π</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow></msub></mrow><mo>)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>⩽</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>λ</mi><mn>2</mn></msup><msup><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mrow><msup><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mfrac></mstyle></mrow></mrow><mo>+</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>λ</mi><mn>2</mn></msup><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\frac{\lambda}{|\mathcal{X}|}\left(\frac{\mathbf{1}}{|\mathcal{Y}|}-[\pi_{x}(\theta)]_{x\in\mathcal{X}}\right)\right\|^{2}\leqslant\frac{\lambda^{2}}{|\mathcal{X}|^{2}}\left(\frac{|\mathcal{X}||\mathcal{Y}|}{|\mathcal{Y}|^{2}}-2\frac{|\mathcal{X}|}{|\mathcal{Y}|}+|\mathcal{X}|\right)=\frac{\lambda^{2}}{|\mathcal{X}|}\left(1-\frac{1}{|\mathcal{Y}|}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.SSS1.p8.2" class="ltx_p"><span id="A5.SS3.SSS1.p8.2.1" class="ltx_text">where the inequality is obtained by using <math id="A5.SS3.SSS1.p8.m1" class="ltx_Math" alttext="\|\pi_{x}(\theta)\|^{2}\leqslant 1" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>π</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>⩽</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|\pi_{x}(\theta)\|^{2}\leqslant 1</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS3.SSS1.p9" class="ltx_para">
<p id="A5.SS3.SSS1.p9.1" class="ltx_p"><span id="A5.SS3.SSS1.p9.1.1" class="ltx_text">As for <math id="A5.SS3.SSS1.p9.m1" class="ltx_Math" alttext="\mathbb{E}\left[\|g_{\theta}(\tau_{1})\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>g</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\|g_{\theta}(\tau_{1})\|^{2}\right]</annotation></semantics></math>, we have</span></p>
</div>
<div id="A5.SS3.SSS1.p10" class="ltx_para">
<table id="A5.EGx52" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex72"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex72.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\|g_{\theta}(\tau_{1})\|^{2}\right]\leqslant 4R_{\max}^{2}G^{2}=4R_{\max}^{2}\left(1-\frac{1}{|\mathcal{Y}|}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>g</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>⩽</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup></mrow><mo>=</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\|g_{\theta}(\tau_{1})\|^{2}\right]\leqslant 4R_{\max}^{2}G^{2}=4R_{\max}^{2}\left(1-\frac{1}{|\mathcal{Y}|}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS3.SSS1.p11" class="ltx_para">
<p id="A5.SS3.SSS1.p11.1" class="ltx_p"><span id="A5.SS3.SSS1.p11.1.1" class="ltx_text">where the equality is obtained by Assumption <a href="#Thmassumption1" title="Assumption 1 (Lipschitz Smoothness (LS)). ‣ 5.1 First-order Stationary Point Convergence ‣ 5 Differentially Private Policy Gradient ‣ On the Sample Complexity of Differentially Private Policy Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> with <math id="A5.SS3.SSS1.p11.m1" class="ltx_Math" alttext="G^{2}=\left(1-\frac{1}{|\mathcal{Y}|}\right)" display="inline" intent=":literal"><semantics><mrow><msup><mi>G</mi><mn>2</mn></msup><mo>=</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mfrac></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">G^{2}=\left(1-\frac{1}{|\mathcal{Y}|}\right)</annotation></semantics></math> .</span></p>
</div>
<div id="A5.SS3.SSS1.p12" class="ltx_para">
<p id="A5.SS3.SSS1.p12.1" class="ltx_p"><span id="A5.SS3.SSS1.p12.1.1" class="ltx_text">Combining above, we proved the gradient estimator <math id="A5.SS3.SSS1.p12.m1" class="ltx_Math" alttext="\widetilde{\nabla}_{m}J_{\lambda}(\theta)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mo>∇</mo><mo>~</mo></mover><mi>m</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>J</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\nabla}_{m}J_{\lambda}(\theta)</annotation></semantics></math> satisfies ABC assumption with</span></p>
</div>
<div id="A5.SS3.SSS1.p13" class="ltx_para">
<table id="A5.EGx53" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex73"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex73.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\left\|\widetilde{\nabla}_{m}J_{\lambda}(\theta)\right\|^{2}\right]\leqslant\left(1-\frac{1}{m}\right)\|\nabla J_{\lambda}(\theta)\|^{2}+\frac{2}{m}\left(1-\frac{1}{|\mathcal{Y}|}\right)\left(4R_{\max}^{2}+\frac{\lambda^{2}}{|\mathcal{X}|}\right)+d\sigma^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mo>∇</mo><mo>~</mo></mover><mi>m</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>J</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>⩽</mo><mrow><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>J</mi><mi>λ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mi>λ</mi><mn>2</mn></msup><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\left\|\widetilde{\nabla}_{m}J_{\lambda}(\theta)\right\|^{2}\right]\leqslant\left(1-\frac{1}{m}\right)\|\nabla J_{\lambda}(\theta)\|^{2}+\frac{2}{m}\left(1-\frac{1}{|\mathcal{Y}|}\right)\left(4R_{\max}^{2}+\frac{\lambda^{2}}{|\mathcal{X}|}\right)+d\sigma^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS3.SSS1.p14" class="ltx_para">
<p id="A5.SS3.SSS1.p14.1" class="ltx_p"><span id="A5.SS3.SSS1.p14.1.1" class="ltx_text">where</span></p>
<table id="A5.Ex74" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex74.m1" class="ltx_Math" alttext="A=0,\quad B=1-\frac{1}{m},\quad C=\frac{2}{m}\left(1-\frac{1}{|\mathcal{Y}|}\right)\left(4R_{\max}^{2}+\frac{\lambda^{2}}{|\mathcal{X}|}\right)+d\sigma^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>A</mi><mo>=</mo><mn>0</mn></mrow><mo rspace="1.167em">,</mo><mrow><mi>B</mi><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mi>m</mi></mfrac></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>C</mi><mo>=</mo><mrow><mrow><mfrac><mn>2</mn><mi>m</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mo>+</mo><mfrac><msup><mi>λ</mi><mn>2</mn></msup><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow></mfrac></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">A=0,\quad B=1-\frac{1}{m},\quad C=\frac{2}{m}\left(1-\frac{1}{|\mathcal{Y}|}\right)\left(4R_{\max}^{2}+\frac{\lambda^{2}}{|\mathcal{X}|}\right)+d\sigma^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS3.SSS1.p15" class="ltx_para">
<p id="A5.SS3.SSS1.p15.1" class="ltx_p"><span id="A5.SS3.SSS1.p15.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="Thmlemma7" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma7.2" class="ltx_text ltx_font_bold">Lemma 7</span></span><span id="Thmlemma7.3" class="ltx_text ltx_font_bold"> </span>(Regularized FOSP Convergence)<span id="Thmlemma7.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma7.p1" class="ltx_para">
<p id="Thmlemma7.p1.1" class="ltx_p"><span id="Thmlemma7.p1.1.1" class="ltx_text ltx_font_italic">Under the learning rate condition <math id="Thmlemma7.p1.m1" class="ltx_Math" alttext="\eta&lt;\frac{1}{LB}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>&lt;</mo><mfrac><mn>1</mn><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">\eta&lt;\frac{1}{LB}</annotation></semantics></math>, the iterates satisfy:</span></p>
<table id="A5.EGx54" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E18.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\left\|\nabla J_{\lambda}(\theta_{U})\right\|^{2}\right]\leqslant\frac{2\delta_{1}}{\eta T}+LC\eta," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>J</mi><mi>λ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mi>U</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>⩽</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mn>1</mn></msub></mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\left\|\nabla J_{\lambda}(\theta_{U})\right\|^{2}\right]\leqslant\frac{2\delta_{1}}{\eta T}+LC\eta,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
<p id="Thmlemma7.p1.2" class="ltx_p"><span id="Thmlemma7.p1.2.1" class="ltx_text ltx_font_italic">where <math id="Thmlemma7.p1.m2" class="ltx_Math" alttext="B=1-1/m" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>m</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">B=1-1/m</annotation></semantics></math>, <math id="Thmlemma7.p1.m3" class="ltx_Math" alttext="\delta_{1}=J^{*}-J(\theta_{1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>δ</mi><mn>1</mn></msub><mo>=</mo><mrow><msup><mi>J</mi><mo>∗</mo></msup><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta_{1}=J^{*}-J(\theta_{1})</annotation></semantics></math>, <math id="Thmlemma7.p1.m4" class="ltx_Math" alttext="L=2R_{\max}(2-\frac{1}{|\mathcal{Y}|})" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>−</mo><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mfrac></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">L=2R_{\max}(2-\frac{1}{|\mathcal{Y}|})</annotation></semantics></math>, and <math id="Thmlemma7.p1.m5" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> as defined in Lemma <a href="#Thmlemma6" title="Lemma 6. ‣ E.3.1 FOSP of softmax policy ‣ E.3 Proof of Theorem ‣ Appendix E Proof of Chapter ‣ On the Sample Complexity of Differentially Private Policy Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>.</span></p>
</div>
</div>
<div id="A5.SS3.SSS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS3.SSS1.p16" class="ltx_para">
<p id="A5.SS3.SSS1.p16.1" class="ltx_p"><span id="A5.SS3.SSS1.p16.1.1" class="ltx_text">To proceed with the analysis, we first introduce the following key lemma:</span></p>
</div>
<div id="Thmlemma8" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma8.2" class="ltx_text ltx_font_bold">Lemma 8</span></span><span id="Thmlemma8.3" class="ltx_text ltx_font_bold"> </span>(Adapted from Lemma E.3 in <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib6" title="" class="ltx_ref">Yuan et al. [6]</a></cite>)<span id="Thmlemma8.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma8.p1" class="ltx_para">
<p id="Thmlemma8.p1.1" class="ltx_p"><math id="Thmlemma8.p1.m1" class="ltx_Math" alttext="J(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">J(\cdot)</annotation></semantics></math><span id="Thmlemma8.p1.1.1" class="ltx_text ltx_font_italic"> with the softmax tabular policy is <math id="Thmlemma8.p1.m2" class="ltx_Math" alttext="2R_{\max}\left(2-\frac{1}{|\mathcal{Y}|}\right)" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo>−</mo><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mfrac></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">2R_{\max}\left(2-\frac{1}{|\mathcal{Y}|}\right)</annotation></semantics></math>-smooth and <math id="Thmlemma8.p1.m3" class="ltx_Math" alttext="2R_{\max}\sqrt{1-\frac{1}{|\mathcal{Y}|}}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mfrac></mrow></msqrt></mrow><annotation encoding="application/x-tex">2R_{\max}\sqrt{1-\frac{1}{|\mathcal{Y}|}}</annotation></semantics></math>-Lipschitz.</span></p>
</div>
</div>
<div id="A5.SS3.SSS1.p17" class="ltx_para">
<p id="A5.SS3.SSS1.p17.1" class="ltx_p"><span id="A5.SS3.SSS1.p17.1.1" class="ltx_text">From Lemma <a href="#Thmlemma8" title="Lemma 8 (Adapted from Lemma E.3 in [ ] ). ‣ Proof. ‣ E.3.1 FOSP of softmax policy ‣ E.3 Proof of Theorem ‣ Appendix E Proof of Chapter ‣ On the Sample Complexity of Differentially Private Policy Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>, we know that <math id="A5.SS3.SSS1.p17.m1" class="ltx_Math" alttext="J_{\lambda}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>J</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">J_{\lambda}(\cdot)</annotation></semantics></math> is smooth and Lipschitz. Then, based on Lemma <a href="#Thmlemma5" title="Lemma 5 (Adapted from Theorem 3.4 in [ ] ). ‣ E.1 Proof of Theorem ‣ Appendix E Proof of Chapter ‣ On the Sample Complexity of Differentially Private Policy Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>, we have:</span></p>
<table id="A5.EGx55" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex75"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex75.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\left\|\nabla J_{\lambda}(\theta_{U})\right\|^{2}\right]\leqslant\frac{2\delta_{1}}{\eta T(2-LB\eta)}+\frac{LC\eta}{2-LB\eta}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>J</mi><mi>λ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mi>U</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>⩽</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mn>1</mn></msub></mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>−</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mrow><mn>2</mn><mo>−</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\left\|\nabla J_{\lambda}(\theta_{U})\right\|^{2}\right]\leqslant\frac{2\delta_{1}}{\eta T(2-LB\eta)}+\frac{LC\eta}{2-LB\eta}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS3.SSS1.p18" class="ltx_para">
<p id="A5.SS3.SSS1.p18.1" class="ltx_p"><span id="A5.SS3.SSS1.p18.1.1" class="ltx_text">Assuming <math id="A5.SS3.SSS1.p18.m1" class="ltx_Math" alttext="\eta&lt;\frac{1}{LB}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>&lt;</mo><mfrac><mn>1</mn><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">\eta&lt;\frac{1}{LB}</annotation></semantics></math>, the above equation simplifies to:</span></p>
<table id="A5.EGx56" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex76"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex76.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\left\|\nabla J_{\lambda}(\theta_{U})\right\|^{2}\right]\leqslant\frac{2\delta_{1}}{\eta T}+LC\eta," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>J</mi><mi>λ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mi>U</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>⩽</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mn>1</mn></msub></mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\left\|\nabla J_{\lambda}(\theta_{U})\right\|^{2}\right]\leqslant\frac{2\delta_{1}}{\eta T}+LC\eta,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.SSS1.p18.2" class="ltx_p"><span id="A5.SS3.SSS1.p18.2.1" class="ltx_text">where <math id="A5.SS3.SSS1.p18.m2" class="ltx_Math" alttext="B=1-1/m" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>m</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">B=1-1/m</annotation></semantics></math>, <math id="A5.SS3.SSS1.p18.m3" class="ltx_Math" alttext="\delta_{1}=J^{*}-J(\theta_{1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>δ</mi><mn>1</mn></msub><mo>=</mo><mrow><msup><mi>J</mi><mo>∗</mo></msup><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta_{1}=J^{*}-J(\theta_{1})</annotation></semantics></math>, <math id="A5.SS3.SSS1.p18.m4" class="ltx_Math" alttext="L=2R_{\max}(2-\frac{1}{|\mathcal{Y}|})" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>−</mo><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mfrac></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">L=2R_{\max}(2-\frac{1}{|\mathcal{Y}|})</annotation></semantics></math>, <math id="A5.SS3.SSS1.p18.m5" class="ltx_Math" alttext="C=\frac{2}{m}\left(1-\frac{1}{|\mathcal{Y}|}\right)\left(4R_{\max}^{2}+\frac{\lambda^{2}}{|\mathcal{X}|}\right)+d\sigma^{2}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mrow><mrow><mfrac><mn>2</mn><mi>m</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mo>+</mo><mfrac><msup><mi>λ</mi><mn>2</mn></msup><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow></mfrac></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">C=\frac{2}{m}\left(1-\frac{1}{|\mathcal{Y}|}\right)\left(4R_{\max}^{2}+\frac{\lambda^{2}}{|\mathcal{X}|}\right)+d\sigma^{2}</annotation></semantics></math>, <math id="A5.SS3.SSS1.p18.m6" class="ltx_Math" alttext="G^{2}=1-\frac{1}{|\mathcal{Y}|}" display="inline" intent=":literal"><semantics><mrow><msup><mi>G</mi><mn>2</mn></msup><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">G^{2}=1-\frac{1}{|\mathcal{Y}|}</annotation></semantics></math> and <math id="A5.SS3.SSS1.p18.m7" class="ltx_Math" alttext="F=1" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">F=1</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A5.SS3.SSS1.p19" class="ltx_para">
<p id="A5.SS3.SSS1.p19.1" class="ltx_p">Note that the sensitivity <math id="A5.SS3.SSS1.p19.m1" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> of the gradient estimator <math id="A5.SS3.SSS1.p19.m2" class="ltx_Math" alttext="\widetilde{\nabla}_{m}J_{\lambda}(\theta)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mo>∇</mo><mo>~</mo></mover><mi>m</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>J</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\nabla}_{m}J_{\lambda}(\theta)</annotation></semantics></math> is dominated by the data-dependent term. Despite introducing the regularization term <math id="A5.SS3.SSS1.p19.m3" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>, this term only depends on the policy parameters <math id="A5.SS3.SSS1.p19.m4" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> (independent of data), thus it does not affect the sensitivity. So the <math id="A5.SS3.SSS1.p19.m5" class="ltx_Math" alttext="\ell_{2}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\ell_{2}</annotation></semantics></math>-sensitivity of the gradient remains same as before.</p>
</div>
<div id="Thmlemma9" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma9.2" class="ltx_text ltx_font_bold">Lemma 9</span></span><span id="Thmlemma9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma9.p1" class="ltx_para">
<p id="Thmlemma9.p1.1" class="ltx_p"><span id="Thmlemma9.p1.1.1" class="ltx_text ltx_font_italic">let <math id="Thmlemma9.p1.m1" class="ltx_Math" alttext="\sigma^{2}=\frac{16\ln(1.25/\delta)\cdot R_{\max}^{2}G^{2}}{m^{2}\varepsilon^{2}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo>=</mo><mfrac><mrow><mrow><mrow><mn>16</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1.25</mn><mo>/</mo><mi>δ</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup></mrow><mrow><msup><mi>m</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ε</mi><mn>2</mn></msup></mrow></mfrac></mrow><annotation encoding="application/x-tex">\sigma^{2}=\frac{16\ln(1.25/\delta)\cdot R_{\max}^{2}G^{2}}{m^{2}\varepsilon^{2}}</annotation></semantics></math>, the batch size <math id="Thmlemma9.p1.m2" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> be set as: <math id="Thmlemma9.p1.m3" class="ltx_Math" alttext="m=\left(1/\varepsilon\right)^{2/3}(Nd)^{1/3}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>/</mo><mi>ε</mi></mrow><mo>)</mo></mrow><mrow><mn>2</mn><mo>/</mo><mn>3</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>3</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">m=\left(1/\varepsilon\right)^{2/3}(Nd)^{1/3}</annotation></semantics></math>, and <math id="Thmlemma9.p1.m4" class="ltx_Math" alttext="\eta=min(\frac{1}{LB},\frac{\sqrt{2\delta_{1}}}{\sqrt{TLC}})" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mfrac><mn>1</mn><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mfrac><mo>,</mo><mfrac><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mn>1</mn></msub></mrow></msqrt><msqrt><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow></msqrt></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta=min(\frac{1}{LB},\frac{\sqrt{2\delta_{1}}}{\sqrt{TLC}})</annotation></semantics></math>, we have:</span></p>
<table id="A5.EGx57" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E19.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\left\|\nabla J_{\lambda}(\theta_{U})\right\|^{2}\right]\leqslant O\left(\frac{1}{\sqrt{N}}+\left(\frac{\sqrt{d}}{N\varepsilon}\right)^{2/3}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>J</mi><mi>λ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mi>U</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>⩽</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mi>N</mi></msqrt></mfrac></mstyle><mo>+</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msqrt><mi>d</mi></msqrt><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mrow><mn>2</mn><mo>/</mo><mn>3</mn></mrow></msup></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\left\|\nabla J_{\lambda}(\theta_{U})\right\|^{2}\right]\leqslant O\left(\frac{1}{\sqrt{N}}+\left(\frac{\sqrt{d}}{N\varepsilon}\right)^{2/3}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS3.SSS1.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS3.SSS1.p20" class="ltx_para">
<p id="A5.SS3.SSS1.p20.1" class="ltx_p"><span id="A5.SS3.SSS1.p20.1.1" class="ltx_text">for <math id="A5.SS3.SSS1.p20.m1" class="ltx_Math" alttext="\eta=min(\frac{1}{LB},\frac{\sqrt{2\delta_{1}}}{\sqrt{TLC}})" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mfrac><mn>1</mn><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mfrac><mo>,</mo><mfrac><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mn>1</mn></msub></mrow></msqrt><msqrt><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow></msqrt></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta=min(\frac{1}{LB},\frac{\sqrt{2\delta_{1}}}{\sqrt{TLC}})</annotation></semantics></math> we know:</span></p>
<table id="A5.EGx58" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex77"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex77.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\left\|\nabla J_{\lambda}(\theta_{U})\right\|^{2}\right]\leqslant\frac{2\delta_{1}LB}{T}+\frac{2\sqrt{2\delta_{1}LC}}{\sqrt{T}}=O\left(\frac{1}{T}+\frac{\sqrt{C}}{\sqrt{T}}\right)=O\left(\frac{m}{N}+\frac{1}{\sqrt{N}}+\frac{\sigma\sqrt{md}}{\sqrt{N}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>J</mi><mi>λ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mi>U</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>⩽</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mi>T</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow></msqrt></mrow><msqrt><mi>T</mi></msqrt></mfrac></mstyle></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msqrt><mi>C</mi></msqrt><msqrt><mi>T</mi></msqrt></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mi>m</mi><mi>N</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mi>N</mi></msqrt></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msqrt></mrow><msqrt><mi>N</mi></msqrt></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\left\|\nabla J_{\lambda}(\theta_{U})\right\|^{2}\right]\leqslant\frac{2\delta_{1}LB}{T}+\frac{2\sqrt{2\delta_{1}LC}}{\sqrt{T}}=O\left(\frac{1}{T}+\frac{\sqrt{C}}{\sqrt{T}}\right)=O\left(\frac{m}{N}+\frac{1}{\sqrt{N}}+\frac{\sigma\sqrt{md}}{\sqrt{N}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS3.SSS1.p21" class="ltx_para">
<p id="A5.SS3.SSS1.p21.1" class="ltx_p"><span id="A5.SS3.SSS1.p21.1.1" class="ltx_text">Plug in <math id="A5.SS3.SSS1.p21.m1" class="ltx_Math" alttext="\sigma^{2}=\frac{16\ln(1.25/\delta)\cdot R_{\max}^{2}G}{m^{2}\varepsilon^{2}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo>=</mo><mfrac><mrow><mrow><mrow><mn>16</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1.25</mn><mo>/</mo><mi>δ</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mrow><msup><mi>m</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ε</mi><mn>2</mn></msup></mrow></mfrac></mrow><annotation encoding="application/x-tex">\sigma^{2}=\frac{16\ln(1.25/\delta)\cdot R_{\max}^{2}G}{m^{2}\varepsilon^{2}}</annotation></semantics></math> and <math id="A5.SS3.SSS1.p21.m2" class="ltx_Math" alttext="m=(1/\varepsilon)^{2/3}(Nd)^{1/3}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo>/</mo><mn>3</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>3</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">m=(1/\varepsilon)^{2/3}(Nd)^{1/3}</annotation></semantics></math>, we have:</span></p>
<table id="A5.EGx59" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex78"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex78.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\left\|\nabla J_{\lambda}(\theta_{U})\right\|^{2}\right]\leqslant O\left(\frac{1}{\sqrt{N}}+(\frac{\sqrt{d}}{N\varepsilon})^{2/3}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>J</mi><mi>λ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mi>U</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>⩽</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mi>N</mi></msqrt></mfrac></mstyle><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><msqrt><mi>d</mi></msqrt><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow></mfrac></mstyle><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo>/</mo><mn>3</mn></mrow></msup></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\left\|\nabla J_{\lambda}(\theta_{U})\right\|^{2}\right]\leqslant O\left(\frac{1}{\sqrt{N}}+(\frac{\sqrt{d}}{N\varepsilon})^{2/3}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.SSS1.p21.2" class="ltx_p"><span id="A5.SS3.SSS1.p21.2.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A5.SS3.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">E.3.2 </span>Global optimum convergence</h4>

<div id="A5.SS3.SSS2.p1" class="ltx_para">
<p id="A5.SS3.SSS2.p1.1" class="ltx_p">We first introduce an important proposition to bound our global private optimum convergence of softmax with log barrier regularization.</p>
</div>
<div id="Thmproposition2" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmproposition2.2" class="ltx_text ltx_font_bold">Proposition 2</span></span><span id="Thmproposition2.3" class="ltx_text ltx_font_bold"> </span>(Adapted from Theorem 5.2 in <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib5" title="" class="ltx_ref">Agarwal et al. [5]</a></cite>)<span id="Thmproposition2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmproposition2.p1" class="ltx_para">
<p id="Thmproposition2.p1.1" class="ltx_p"><span id="Thmproposition2.p1.1.1" class="ltx_text ltx_font_italic">Suppose <math id="Thmproposition2.p1.m1" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> is such that <math id="Thmproposition2.p1.m2" class="ltx_Math" alttext="\|\nabla J_{\lambda}(\theta)\|\leqslant\frac{\lambda}{2|\mathcal{X}||\mathcal{Y}|}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>J</mi><mi>λ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>⩽</mo><mfrac><mi>λ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">\|\nabla J_{\lambda}(\theta)\|\leqslant\frac{\lambda}{2|\mathcal{X}||\mathcal{Y}|}</annotation></semantics></math>. Then for every initial distribution <math id="Thmproposition2.p1.m3" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>, we have</span></p>
<table id="A5.E20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E20.m1" class="ltx_Math" alttext="J^{*}-J(\theta)\leqslant 2\lambda." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>J</mi><mo>∗</mo></msup><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⩽</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">J^{*}-J(\theta)\leqslant 2\lambda.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS3.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS3.SSS2.p2" class="ltx_para">
<p id="A5.SS3.SSS2.p2.1" class="ltx_p"><span id="A5.SS3.SSS2.p2.1.1" class="ltx_text">Firstly, we define the following set of “bad” iterates:</span></p>
</div>
<div id="A5.SS3.SSS2.p3" class="ltx_para">
<table id="A5.EGx60" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex79"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex79.m1" class="ltx_Math" alttext="\displaystyle I^{+}\triangleq\left\{t\in\{1,\dots,T\}\;\middle|\;\|\nabla J_{\lambda}(\theta_{t})\|\geqslant\frac{\lambda}{2|\mathcal{X}||\mathcal{Y}|}\right\}," display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>I</mi><mo>+</mo></msup><mo>≜</mo><mrow><mo>{</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="true">|</mo><mrow><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>J</mi><mi>λ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>⩾</mo><mstyle displaystyle="true"><mfrac><mi>λ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mrow></mfrac></mstyle></mrow><mo>}</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle I^{+}\triangleq\left\{t\in\{1,\dots,T\}\;\middle|\;\|\nabla J_{\lambda}(\theta_{t})\|\geqslant\frac{\lambda}{2|\mathcal{X}||\mathcal{Y}|}\right\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS3.SSS2.p4" class="ltx_para">
<p id="A5.SS3.SSS2.p4.1" class="ltx_p"><span id="A5.SS3.SSS2.p4.1.1" class="ltx_text">with <math id="A5.SS3.SSS2.p4.m1" class="ltx_Math" alttext="\lambda=\frac{\alpha}{2}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mfrac><mi>α</mi><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">\lambda=\frac{\alpha}{2}</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS3.SSS2.p5" class="ltx_para">
<p id="A5.SS3.SSS2.p5.1" class="ltx_p"><span id="A5.SS3.SSS2.p5.1.1" class="ltx_text">From Proposition <a href="#Thmproposition2" title="Proposition 2 (Adapted from Theorem 5.2 in [ ] ). ‣ E.3.2 Global optimum convergence ‣ E.3 Proof of Theorem ‣ Appendix E Proof of Chapter ‣ On the Sample Complexity of Differentially Private Policy Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, we know that if <math id="A5.SS3.SSS2.p5.m1" class="ltx_Math" alttext="\|\nabla J_{\lambda}(\theta)\|\leqslant\frac{\lambda}{2|\mathcal{X}||\mathcal{Y}|}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>J</mi><mi>λ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>⩽</mo><mfrac><mi>λ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">\|\nabla J_{\lambda}(\theta)\|\leqslant\frac{\lambda}{2|\mathcal{X}||\mathcal{Y}|}</annotation></semantics></math>, we have <math id="A5.SS3.SSS2.p5.m2" class="ltx_Math" alttext="J^{*}-J(\theta)\leqslant 2\lambda." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>J</mi><mo>∗</mo></msup><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⩽</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">J^{*}-J(\theta)\leqslant 2\lambda.</annotation></semantics></math></span></p>
</div>
<div id="A5.SS3.SSS2.p6" class="ltx_para">
<p id="A5.SS3.SSS2.p6.1" class="ltx_p"><span id="A5.SS3.SSS2.p6.1.1" class="ltx_text">Hence, we have:</span></p>
</div>
<div id="A5.SS3.SSS2.p7" class="ltx_para">
<table id="A5.EGx61" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex81.m1" class="ltx_Math" alttext="\displaystyle J^{*}-\frac{1}{T}\sum_{t=1}^{T}J(\theta_{t})" display="inline" intent=":literal"><semantics><mrow><msup><mi>J</mi><mo>∗</mo></msup><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle J^{*}-\frac{1}{T}\sum_{t=1}^{T}J(\theta_{t})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex81.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{T}\sum_{t\in I^{+}}J^{*}-J(\theta_{t})+\frac{1}{T}\sum_{t\notin I^{+}}J^{*}-J(\theta_{t})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>∈</mo><msup><mi>I</mi><mo>+</mo></msup></mrow></munder></mstyle><msup><mi>J</mi><mo>∗</mo></msup></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>∉</mo><msup><mi>I</mi><mo>+</mo></msup></mrow></munder></mstyle><msup><mi>J</mi><mo>∗</mo></msup></mrow></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{T}\sum_{t\in I^{+}}J^{*}-J(\theta_{t})+\frac{1}{T}\sum_{t\notin I^{+}}J^{*}-J(\theta_{t})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex82"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex82.m1" class="ltx_Math" alttext="\displaystyle\stackrel{{\scriptstyle(a)}}{{\leqslant}}\frac{|I^{+}|}{T}\cdot 4R_{\max}+\frac{1}{T}\sum_{t\notin I^{+}}J^{*}-J(\theta_{t})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mover><mo>⩽</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mover><mrow><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><msup><mi>I</mi><mo>+</mo></msup><mo stretchy="false">|</mo></mrow><mi>T</mi></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>4</mn></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>max</mi></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>∉</mo><msup><mi>I</mi><mo>+</mo></msup></mrow></munder></mstyle><msup><mi>J</mi><mo>∗</mo></msup></mrow></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle(a)}}{{\leqslant}}\frac{|I^{+}|}{T}\cdot 4R_{\max}+\frac{1}{T}\sum_{t\notin I^{+}}J^{*}-J(\theta_{t})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex83"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex83.m1" class="ltx_Math" alttext="\displaystyle\stackrel{{\scriptstyle(\ref{eq:softmax_j*-j})}}{{\leqslant}}\frac{|I^{+}|}{T}\cdot 4R_{\max}+\frac{T-|I^{+}|}{T}\cdot 2\lambda" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mover><mo>⩽</mo><mrow><mo stretchy="false">(</mo><mtext class="ltx_mathvariant_italic"><a href="#A5.E20" title="In Proposition 2 (Adapted from Theorem 5.2 in [ ] ). ‣ E.3.2 Global optimum convergence ‣ E.3 Proof of Theorem ‣ Appendix E Proof of Chapter ‣ On the Sample Complexity of Differentially Private Policy Optimization" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">20</span></a></mtext><mo stretchy="false">)</mo></mrow></mover><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><msup><mi>I</mi><mo>+</mo></msup><mo stretchy="false">|</mo></mrow><mi>T</mi></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>4</mn></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>max</mi></msub></mrow><mo>+</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>T</mi><mo>−</mo><mrow><mo stretchy="false">|</mo><msup><mi>I</mi><mo>+</mo></msup><mo stretchy="false">|</mo></mrow></mrow><mi>T</mi></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle(\ref{eq:softmax_j*-j})}}{{\leqslant}}\frac{|I^{+}|}{T}\cdot 4R_{\max}+\frac{T-|I^{+}|}{T}\cdot 2\lambda</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex84"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex84.m1" class="ltx_Math" alttext="\displaystyle\leqslant\frac{|I^{+}|}{T}\cdot 4R_{\max}+2\lambda" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>⩽</mo><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><msup><mi>I</mi><mo>+</mo></msup><mo stretchy="false">|</mo></mrow><mi>T</mi></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>4</mn></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>max</mi></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leqslant\frac{|I^{+}|}{T}\cdot 4R_{\max}+2\lambda</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.E21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E21.m1" class="ltx_Math" alttext="\displaystyle\leqslant\frac{|I^{+}|}{T}\cdot 4R_{\max}+\alpha," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>⩽</mo><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><msup><mi>I</mi><mo>+</mo></msup><mo stretchy="false">|</mo></mrow><mi>T</mi></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>4</mn></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>max</mi></msub></mrow><mo>+</mo><mi>α</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leqslant\frac{|I^{+}|}{T}\cdot 4R_{\max}+\alpha,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS3.SSS2.p8" class="ltx_para">
<p id="A5.SS3.SSS2.p8.1" class="ltx_p"><span id="A5.SS3.SSS2.p8.1.1" class="ltx_text">where (a) holds by <math id="A5.SS3.SSS2.p8.m1" class="ltx_Math" alttext="J(\cdot)\leqslant 2R_{\max}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>⩽</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>max</mi></msub></mrow></mrow><annotation encoding="application/x-tex">J(\cdot)\leqslant 2R_{\max}</annotation></semantics></math>, then <math id="A5.SS3.SSS2.p8.m2" class="ltx_Math" alttext="J^{*}-J(\theta_{t})\leqslant J^{*}+J(\theta_{t})\leqslant 4R_{\max}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>J</mi><mo>∗</mo></msup><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⩽</mo><mrow><msup><mi>J</mi><mo>∗</mo></msup><mo>+</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⩽</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>max</mi></msub></mrow></mrow><annotation encoding="application/x-tex">J^{*}-J(\theta_{t})\leqslant J^{*}+J(\theta_{t})\leqslant 4R_{\max}</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS3.SSS2.p9" class="ltx_para">
<p id="A5.SS3.SSS2.p9.1" class="ltx_p"><span id="A5.SS3.SSS2.p9.1.1" class="ltx_text">Now we turn to bound <math id="A5.SS3.SSS2.p9.m1" class="ltx_Math" alttext="|I^{+}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><msup><mi>I</mi><mo>+</mo></msup><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|I^{+}|</annotation></semantics></math>. From the definition, we have:</span></p>
</div>
<div id="A5.SS3.SSS2.p10" class="ltx_para">
<table id="A5.EGx62" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex85"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex85.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=1}^{T}\|\nabla J_{\lambda}(\theta_{t})\|^{2}\geqslant\sum_{t\in I^{+}}\|\nabla J_{\lambda}(\theta_{t})\|^{2}\geqslant\frac{|I^{+}|\lambda^{2}}{4|\mathcal{X}|^{2}|\mathcal{Y}|^{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>J</mi><mi>λ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>⩾</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>∈</mo><msup><mi>I</mi><mo>+</mo></msup></mrow></munder></mstyle><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>J</mi><mi>λ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>⩾</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><msup><mi>I</mi><mo>+</mo></msup><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{T}\|\nabla J_{\lambda}(\theta_{t})\|^{2}\geqslant\sum_{t\in I^{+}}\|\nabla J_{\lambda}(\theta_{t})\|^{2}\geqslant\frac{|I^{+}|\lambda^{2}}{4|\mathcal{X}|^{2}|\mathcal{Y}|^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS3.SSS2.p11" class="ltx_para">
<p id="A5.SS3.SSS2.p11.1" class="ltx_p"><span id="A5.SS3.SSS2.p11.1.1" class="ltx_text">Through a straightforward mathematical transformation, we get</span></p>
<table id="A5.EGx63" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex86.m1" class="ltx_Math" alttext="\displaystyle\frac{|I^{+}|}{T}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><msup><mi>I</mi><mo>+</mo></msup><mo stretchy="false">|</mo></mrow><mi>T</mi></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{|I^{+}|}{T}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex86.m2" class="ltx_math_unparsed" alttext="\displaystyle\leqslant\frac{4|\mathcal{X}|^{2}|\mathcal{Y}|^{2}}{\lambda^{2}}\cdot\frac{1}{T}\sum_{t=1}^{T}\|\nabla J_{\lambda}(\theta_{t})\|^{2}" display="inline" intent=":literal"><semantics><mrow><mo>⩽</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow><msup><mi>λ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mo lspace="0em" rspace="0.167em">∥</mo><mo rspace="0.167em">∇</mo><msub><mi>J</mi><mi>λ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><msup><mo lspace="0em">∥</mo><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leqslant\frac{4|\mathcal{X}|^{2}|\mathcal{Y}|^{2}}{\lambda^{2}}\cdot\frac{1}{T}\sum_{t=1}^{T}\|\nabla J_{\lambda}(\theta_{t})\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex87.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{16}{\alpha^{2}}\cdot|\mathcal{X}|^{2}|\mathcal{Y}|^{2}\cdot\frac{1}{T}\sum_{t=1}^{T}\|\nabla J_{\lambda}(\theta_{t})\|^{2}." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>16</mn><msup><mi>α</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.222em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mn>2</mn></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><msup><mo fence="false" stretchy="false">|</mo><mn>2</mn></msup><mo lspace="0em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mo lspace="0em" rspace="0.167em">∥</mo><mo rspace="0.167em">∇</mo><msub><mi>J</mi><mi>λ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><msup><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msup><mo lspace="0.0835em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{16}{\alpha^{2}}\cdot|\mathcal{X}|^{2}|\mathcal{Y}|^{2}\cdot\frac{1}{T}\sum_{t=1}^{T}\|\nabla J_{\lambda}(\theta_{t})\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS3.SSS2.p12" class="ltx_para">
<p id="A5.SS3.SSS2.p12.1" class="ltx_p"><span id="A5.SS3.SSS2.p12.1.1" class="ltx_text">Thus, we have</span></p>
</div>
<div id="A5.SS3.SSS2.p13" class="ltx_para">
<table id="A5.EGx64" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex88.m1" class="ltx_Math" alttext="\displaystyle J^{*}-\frac{1}{T}\sum_{t=1}^{T}J(\theta_{t})" display="inline" intent=":literal"><semantics><mrow><msup><mi>J</mi><mo>∗</mo></msup><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle J^{*}-\frac{1}{T}\sum_{t=1}^{T}J(\theta_{t})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex88.m2" class="ltx_math_unparsed" alttext="\displaystyle\stackrel{{\scriptstyle(\ref{eq:soft_init_result})}}{{\leqslant}}\frac{64R_{\max}}{\alpha^{2}}|\mathcal{X}|^{2}|\mathcal{Y}|^{2}\cdot\frac{1}{T}\sum_{t=1}^{T}\|\nabla J_{\lambda}(\theta_{t})\|^{2}+\alpha." display="inline" intent=":literal"><semantics><mrow><mover><mo>⩽</mo><mrow><mo stretchy="false">(</mo><mtext class="ltx_mathvariant_italic"><a href="#A5.E21" title="In Proof. ‣ E.3.2 Global optimum convergence ‣ E.3 Proof of Theorem ‣ Appendix E Proof of Chapter ‣ On the Sample Complexity of Differentially Private Policy Optimization" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">21</span></a></mtext><mo stretchy="false">)</mo></mrow></mover><mstyle displaystyle="true"><mfrac><mrow><mn>64</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>max</mi></msub></mrow><msup><mi>α</mi><mn>2</mn></msup></mfrac></mstyle><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mn>2</mn></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><msup><mo fence="false" stretchy="false">|</mo><mn>2</mn></msup><mo lspace="0em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mo lspace="0em" rspace="0.167em">∥</mo><mo rspace="0.167em">∇</mo><msub><mi>J</mi><mi>λ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><msup><mo lspace="0em" rspace="0em">∥</mo><mn>2</mn></msup><mo lspace="0em">+</mo><mi>α</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle(\ref{eq:soft_init_result})}}{{\leqslant}}\frac{64R_{\max}}{\alpha^{2}}|\mathcal{X}|^{2}|\mathcal{Y}|^{2}\cdot\frac{1}{T}\sum_{t=1}^{T}\|\nabla J_{\lambda}(\theta_{t})\|^{2}+\alpha.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS3.SSS2.p14" class="ltx_para">
<p id="A5.SS3.SSS2.p14.1" class="ltx_p"><span id="A5.SS3.SSS2.p14.1.1" class="ltx_text">Taking expectation over the iterations on both sides, we have</span></p>
</div>
<div id="A5.SS3.SSS2.p15" class="ltx_para">
<table id="A5.EGx65" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex89"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex89.m1" class="ltx_math_unparsed" alttext="\displaystyle J^{*}-\frac{1}{T}\sum_{t=1}^{T}\mathbb{E}\left[J(\theta_{t})\right]\leqslant\frac{64R_{\max}}{\alpha^{2}}|\mathcal{X}|^{2}|\mathcal{Y}|^{2}\cdot\frac{1}{T}\sum_{t=1}^{T}\mathbb{E}\left[\|\nabla J_{\lambda}(\theta_{t})\|^{2}\right]+\alpha." display="inline" intent=":literal"><semantics><mrow><msup><mi>J</mi><mo>∗</mo></msup><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mi>𝔼</mi><mrow><mo>[</mo><mi>J</mi><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>⩽</mo><mstyle displaystyle="true"><mfrac><mrow><mn>64</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>max</mi></msub></mrow><msup><mi>α</mi><mn>2</mn></msup></mfrac></mstyle><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mn>2</mn></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><msup><mo fence="false" stretchy="false">|</mo><mn>2</mn></msup><mo lspace="0em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mi>𝔼</mi><mrow><mo>[</mo><mo lspace="0em" rspace="0.167em">∥</mo><mo rspace="0.167em">∇</mo><msub><mi>J</mi><mi>λ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><msup><mo lspace="0em" rspace="0.167em">∥</mo><mn>2</mn></msup><mo>]</mo></mrow><mo>+</mo><mi>α</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle J^{*}-\frac{1}{T}\sum_{t=1}^{T}\mathbb{E}\left[J(\theta_{t})\right]\leqslant\frac{64R_{\max}}{\alpha^{2}}|\mathcal{X}|^{2}|\mathcal{Y}|^{2}\cdot\frac{1}{T}\sum_{t=1}^{T}\mathbb{E}\left[\|\nabla J_{\lambda}(\theta_{t})\|^{2}\right]+\alpha.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS3.SSS2.p16" class="ltx_para">
<p id="A5.SS3.SSS2.p16.1" class="ltx_p"><span id="A5.SS3.SSS2.p16.1.1" class="ltx_text">To guarantee that <math id="A5.SS3.SSS2.p16.m1" class="ltx_Math" alttext="J^{*}-\frac{1}{T}\sum_{t=1}^{T}\mathbb{E}\left[J(\theta_{t})\right]\leqslant\alpha" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>J</mi><mo>∗</mo></msup><mo>−</mo><mrow><mfrac><mn>1</mn><mi>T</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow><mo>⩽</mo><mi>α</mi></mrow><annotation encoding="application/x-tex">J^{*}-\frac{1}{T}\sum_{t=1}^{T}\mathbb{E}\left[J(\theta_{t})\right]\leqslant\alpha</annotation></semantics></math>, we need to show:</span></p>
<table id="A5.EGx66" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex90"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex90.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{T}\sum_{t=1}^{T}\mathbb{E}\left[\|\nabla J_{\lambda}(\theta_{t})\|^{2}\right]\leqslant\alpha^{3}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>J</mi><mi>λ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow></mrow><mo>⩽</mo><msup><mi>α</mi><mn>3</mn></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{T}\sum_{t=1}^{T}\mathbb{E}\left[\|\nabla J_{\lambda}(\theta_{t})\|^{2}\right]\leqslant\alpha^{3},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS3.SSS2.p17" class="ltx_para">
<p id="A5.SS3.SSS2.p17.1" class="ltx_p"><span id="A5.SS3.SSS2.p17.1.1" class="ltx_text">Obviously, we have:</span></p>
<table id="A5.EGx67" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex91"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex91.m1" class="ltx_Math" alttext="\displaystyle E\left[\left\|\nabla J_{\lambda}(\theta_{U})\right\|^{2}\right]=\frac{1}{T}\sum_{t=1}^{T}\mathbb{E}\left[\left\|\nabla J_{\lambda}(\theta_{t})\right\|^{2}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>J</mi><mi>λ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mi>U</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>J</mi><mi>λ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle E\left[\left\|\nabla J_{\lambda}(\theta_{U})\right\|^{2}\right]=\frac{1}{T}\sum_{t=1}^{T}\mathbb{E}\left[\left\|\nabla J_{\lambda}(\theta_{t})\right\|^{2}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS3.SSS2.p18" class="ltx_para">
<p id="A5.SS3.SSS2.p18.1" class="ltx_p"><span id="A5.SS3.SSS2.p18.1.1" class="ltx_text">Hence, based on Lemma <a href="#Thmlemma9" title="Lemma 9. ‣ E.3.1 FOSP of softmax policy ‣ E.3 Proof of Theorem ‣ Appendix E Proof of Chapter ‣ On the Sample Complexity of Differentially Private Policy Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>, it is obvious to show that:</span></p>
<table id="A5.EGx68" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex92"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex92.m1" class="ltx_Math" alttext="\displaystyle N\geqslant O\left(\frac{1}{\alpha^{6}}+\frac{\sqrt{d}}{\alpha^{9/2}\varepsilon}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mi>N</mi><mo>⩾</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>α</mi><mn>6</mn></msup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msqrt><mi>d</mi></msqrt><mrow><msup><mi>α</mi><mrow><mn>9</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle N\geqslant O\left(\frac{1}{\alpha^{6}}+\frac{\sqrt{d}}{\alpha^{9/2}\varepsilon}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS3.SSS2.p19" class="ltx_para">
<p id="A5.SS3.SSS2.p19.1" class="ltx_p"><span id="A5.SS3.SSS2.p19.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
</section>
</section>
<section id="A6" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix F </span>Proof of Chapter <a href="#S6" title="6 Differentially Private NPG and REBEL ‣ On the Sample Complexity of Differentially Private Policy Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a></h2>

<section id="A6.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">F.1 </span>Proof of Theorem <a href="#Thmtheorem4" title="Theorem 4 (Master theorem). ‣ 6.1 A Master Algorithm and Guarantee ‣ 6 Differentially Private NPG and REBEL ‣ On the Sample Complexity of Differentially Private Policy Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a></h3>

<div id="A6.SS1.p1" class="ltx_para">
<p id="A6.SS1.p1.1" class="ltx_p">For notation simplicity, we let <math id="A6.SS1.p1.m1" class="ltx_Math" alttext="\pi_{t}=\pi_{\theta_{t}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>t</mi></msub><mo>=</mo><msub><mi>π</mi><msub><mi>θ</mi><mi>t</mi></msub></msub></mrow><annotation encoding="application/x-tex">\pi_{t}=\pi_{\theta_{t}}</annotation></semantics></math>. By the performance difference lemma, we have</p>
<table id="A6.EGx69" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex93"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex93.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=1}^{T}J(\pi^{*})-J(\pi_{t})" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{T}J(\pi^{*})-J(\pi_{t})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex93.m2" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{t=1}^{T}\mathbb{E}_{x\sim\rho,y\sim\pi^{*}(\cdot|x)}\left[A^{\pi_{\theta_{t}}}(x,y)\right]." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi>ρ</mi><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mo>∗</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><msup><mi>A</mi><msub><mi>π</mi><msub><mi>θ</mi><mi>t</mi></msub></msub></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{t=1}^{T}\mathbb{E}_{x\sim\rho,y\sim\pi^{*}(\cdot|x)}\left[A^{\pi_{\theta_{t}}}(x,y)\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.SS1.p2" class="ltx_para">
<p id="A6.SS1.p2.1" class="ltx_p">Define <math id="A6.SS1.p2.m1" class="ltx_math_unparsed" alttext="\text{err}_{t}^{*}:=\mathbb{E}_{x\sim\rho,y\sim\pi^{*}(\cdot|x)}\left[\left(A^{\pi_{\theta_{t}}}(x,y)-w_{t}^{\top}\nabla\log\pi_{\theta_{t}}(y\mid x)\right)\right]" display="inline" intent=":literal"><semantics><mrow><msubsup><mtext>err</mtext><mi>t</mi><mo>∗</mo></msubsup><mo>:=</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi>ρ</mi><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mo>∗</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><mrow><mo>(</mo><msup><mi>A</mi><msub><mi>π</mi><msub><mi>θ</mi><mi>t</mi></msub></msub></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msubsup><mi>w</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>log</mi><msub><mi>π</mi><msub><mi>θ</mi><mi>t</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\text{err}_{t}^{*}:=\mathbb{E}_{x\sim\rho,y\sim\pi^{*}(\cdot|x)}\left[\left(A^{\pi_{\theta_{t}}}(x,y)-w_{t}^{\top}\nabla\log\pi_{\theta_{t}}(y\mid x)\right)\right]</annotation></semantics></math>. Then, we have</p>
<table id="A6.EGx70" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex94"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex94.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=1}^{T}J(\pi^{*})-J(\pi_{t})" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{T}J(\pi^{*})-J(\pi_{t})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex94.m2" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{t=1}^{T}\mathbb{E}_{x\sim\rho,y\sim\pi^{*}(\cdot|x)}\left[A^{\pi_{t}}(x,y)\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi>ρ</mi><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mo>∗</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><msup><mi>A</mi><msub><mi>π</mi><mi>t</mi></msub></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{t=1}^{T}\mathbb{E}_{x\sim\rho,y\sim\pi^{*}(\cdot|x)}\left[A^{\pi_{t}}(x,y)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex95"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex95.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{t=1}^{T}\mathbb{E}_{x\sim\rho,y\sim\pi^{*}(\cdot|x)}\left[\langle w_{t},\nabla_{\theta}\log\pi_{t}(y\mid x)\rangle\right]+\sum_{t=1}^{T}\text{err}_{t}^{*}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi>ρ</mi><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mo>∗</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><mrow><mo stretchy="false">⟨</mo><msub><mi>w</mi><mi>t</mi></msub><mo>,</mo><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>log</mi><msub><mi>π</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">⟩</mo></mrow><mo>]</mo></mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msubsup><mtext>err</mtext><mi>t</mi><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{t=1}^{T}\mathbb{E}_{x\sim\rho,y\sim\pi^{*}(\cdot|x)}\left[\langle w_{t},\nabla_{\theta}\log\pi_{t}(y\mid x)\rangle\right]+\sum_{t=1}^{T}\text{err}_{t}^{*}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex96"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex96.m1" class="ltx_math_unparsed" alttext="\displaystyle\overset{(a)}{=}\sum_{t=1}^{T}\mathbb{E}_{x\sim\rho,y\sim\pi^{*}(\cdot|x)}\left[\frac{1}{\eta}\langle\theta_{t+1}-\theta_{t},\nabla_{\theta}\log\pi_{t}(y\mid x)\rangle\right]+\sum_{t=1}^{T}\text{err}_{t}^{*}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>=</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">a</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi>ρ</mi><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mo>∗</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>η</mi></mfrac></mstyle><mrow><mo stretchy="false">⟨</mo><msub><mi>θ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>θ</mi><mi>t</mi></msub><mo>,</mo><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>log</mi><msub><mi>π</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">⟩</mo></mrow><mo>]</mo></mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msubsup><mtext>err</mtext><mi>t</mi><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(a)}{=}\sum_{t=1}^{T}\mathbb{E}_{x\sim\rho,y\sim\pi^{*}(\cdot|x)}\left[\frac{1}{\eta}\langle\theta_{t+1}-\theta_{t},\nabla_{\theta}\log\pi_{t}(y\mid x)\rangle\right]+\sum_{t=1}^{T}\text{err}_{t}^{*}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex97"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex97.m1" class="ltx_math_unparsed" alttext="\displaystyle\overset{(b)}{\leqslant}\sum_{t=1}^{T}\mathbb{E}_{x\sim\rho,y\sim\pi^{*}(\cdot|x)}\left[\frac{1}{\eta}\log\left(\frac{\pi_{t+1}(y\mid x)}{\pi_{t}(y\mid x)}\right)\right]+\sum_{t=1}^{T}\frac{\eta\beta}{2}\|w_{t}\|^{2}+\sum_{t=1}^{T}\text{err}_{t}^{*}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>⩽</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">b</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi>ρ</mi><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mo>∗</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>η</mi></mfrac></mstyle><mi>log</mi><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><mo>]</mo></mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>w</mi><mi>t</mi></msub><msup><mo lspace="0em" rspace="0em">∥</mo><mn>2</mn></msup><mo lspace="0em">+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msubsup><mtext>err</mtext><mi>t</mi><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(b)}{\leqslant}\sum_{t=1}^{T}\mathbb{E}_{x\sim\rho,y\sim\pi^{*}(\cdot|x)}\left[\frac{1}{\eta}\log\left(\frac{\pi_{t+1}(y\mid x)}{\pi_{t}(y\mid x)}\right)\right]+\sum_{t=1}^{T}\frac{\eta\beta}{2}\|w_{t}\|^{2}+\sum_{t=1}^{T}\text{err}_{t}^{*}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex98"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex98.m1" class="ltx_math_unparsed" alttext="\displaystyle\overset{(c)}{\leqslant}\mathbb{E}_{x\sim\rho,y\sim\pi^{*}(\cdot|x)}\left[\frac{1}{\eta}\log\left(\frac{\pi_{T+1}(y\mid x)}{\pi_{1}(y\mid x)}\right)\right]+\frac{T\eta\beta}{2}W^{2}+\sum_{t=1}^{T}\text{err}_{t}^{*}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>⩽</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">c</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi>ρ</mi><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mo>∗</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>η</mi></mfrac></mstyle><mi>log</mi><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><mo>]</mo></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mn>2</mn></mfrac></mstyle><msup><mi>W</mi><mn>2</mn></msup><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msubsup><mtext>err</mtext><mi>t</mi><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(c)}{\leqslant}\mathbb{E}_{x\sim\rho,y\sim\pi^{*}(\cdot|x)}\left[\frac{1}{\eta}\log\left(\frac{\pi_{T+1}(y\mid x)}{\pi_{1}(y\mid x)}\right)\right]+\frac{T\eta\beta}{2}W^{2}+\sum_{t=1}^{T}\text{err}_{t}^{*}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex99"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex99.m1" class="ltx_Math" alttext="\displaystyle\overset{(d)}{\leqslant}\frac{1}{\eta}\log|\mathcal{Y}|+\frac{T\eta\beta}{2}W^{2}+\sum_{t=1}^{T}\text{err}_{t}^{*}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mo>⩽</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">d</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>η</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msubsup><mtext>err</mtext><mi>t</mi><mo>∗</mo></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(d)}{\leqslant}\frac{1}{\eta}\log|\mathcal{Y}|+\frac{T\eta\beta}{2}W^{2}+\sum_{t=1}^{T}\text{err}_{t}^{*},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.p2.2" class="ltx_p">where (a) holds by the update rule of our algorithm; (b) is true since the <math id="A6.SS1.p2.m2" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>-smooth condition of <math id="A6.SS1.p2.m3" class="ltx_Math" alttext="\log\pi_{\theta}(y|x)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\log\pi_{\theta}(y|x)</annotation></semantics></math> is equivalent to the following inequality:</p>
<table id="A6.EGx71" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex100"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex100.m1" class="ltx_Math" alttext="\displaystyle\forall\theta,\theta^{\prime},x,y:\quad\left|\log\pi_{\theta^{\prime}}(y\mid x)-\log\pi_{\theta}(y\mid x)-\nabla\log\pi_{\theta}(y\mid x)\cdot(\theta^{\prime}-\theta)\right|\leqslant\frac{\beta}{2}\|\theta-\theta^{\prime}\|_{2}^{2};" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.167em">∀</mo><mi>θ</mi></mrow><mo>,</mo><msup><mi>θ</mi><mo>′</mo></msup><mo>,</mo><mi>x</mi><mo>,</mo><mrow><mi>y</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mphantom></mphantom></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mo>|</mo><mrow><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><msup><mi>θ</mi><mo>′</mo></msup></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>log</mi></mrow><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>θ</mi><mo>′</mo></msup><mo>−</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>⩽</mo><mrow><mstyle displaystyle="true"><mfrac><mi>β</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>θ</mi><mo>−</mo><msup><mi>θ</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle\forall\theta,\theta^{\prime},x,y:\quad\left|\log\pi_{\theta^{\prime}}(y\mid x)-\log\pi_{\theta}(y\mid x)-\nabla\log\pi_{\theta}(y\mid x)\cdot(\theta^{\prime}-\theta)\right|\leqslant\frac{\beta}{2}\|\theta-\theta^{\prime}\|_{2}^{2};</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.SS1.p3" class="ltx_para">
<p id="A6.SS1.p3.1" class="ltx_p">(c) follows from the Assumption <a href="#Thmassumption5" title="Assumption 5 (𝛽-smoothness and boundedness). ‣ 6.1 A Master Algorithm and Guarantee ‣ 6 Differentially Private NPG and REBEL ‣ On the Sample Complexity of Differentially Private Policy Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>, which has a bounded norm of <math id="A6.SS1.p3.m1" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math>, along with telescope sum; (d) is true since <math id="A6.SS1.p3.m2" class="ltx_Math" alttext="\pi_{1}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\pi_{1}</annotation></semantics></math> is a uniform distribution at each state. Thus, dividing by T on both sides and choosing <math id="A6.SS1.p3.m3" class="ltx_Math" alttext="\eta=\sqrt{\frac{2\log|\mathcal{Y}|}{T\beta{W}^{2}}}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><msqrt><mfrac><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mrow></mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mn>2</mn></msup></mrow></mfrac></msqrt></mrow><annotation encoding="application/x-tex">\eta=\sqrt{\frac{2\log|\mathcal{Y}|}{T\beta{W}^{2}}}</annotation></semantics></math>, yields</p>
</div>
<div id="A6.SS1.p4" class="ltx_para">
<table id="A6.EGx72" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex101"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex101.m1" class="ltx_Math" alttext="\displaystyle J(\pi^{*})-\frac{1}{T}\sum_{t=1}^{T}J(\pi_{t})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle J(\pi^{*})-\frac{1}{T}\sum_{t=1}^{T}J(\pi_{t})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex101.m2" class="ltx_Math" alttext="\displaystyle\leqslant\frac{\log|\mathcal{Y}|}{\eta T}+\frac{\eta\beta W^{2}}{2}+\frac{1}{T}\sum_{t=1}^{T}\text{err}_{t}^{*}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>⩽</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mn>2</mn></msup></mrow><mn>2</mn></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msubsup><mtext>err</mtext><mi>t</mi><mo>∗</mo></msubsup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leqslant\frac{\log|\mathcal{Y}|}{\eta T}+\frac{\eta\beta W^{2}}{2}+\frac{1}{T}\sum_{t=1}^{T}\text{err}_{t}^{*}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex102"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex102.m1" class="ltx_Math" alttext="\displaystyle\leqslant\sqrt{\frac{\beta W^{2}\log|\mathcal{Y}|}{2T}}+\frac{1}{T}\sum_{t=1}^{T}\text{err}_{t}^{*}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>⩽</mo><mrow><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle></msqrt><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msubsup><mtext>err</mtext><mi>t</mi><mo>∗</mo></msubsup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leqslant\sqrt{\frac{\beta W^{2}\log|\mathcal{Y}|}{2T}}+\frac{1}{T}\sum_{t=1}^{T}\text{err}_{t}^{*}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.SS1.p5" class="ltx_para">
<p id="A6.SS1.p5.1" class="ltx_p">To bound <math id="A6.SS1.p5.m1" class="ltx_Math" alttext="\text{err}_{t}^{*}" display="inline" intent=":literal"><semantics><msubsup><mtext>err</mtext><mi>t</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">\text{err}_{t}^{*}</annotation></semantics></math>, we will simply leverage the guarantee of the regression oracle and the concentrability coefficient to transfer from <math id="A6.SS1.p5.m2" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math> to <math id="A6.SS1.p5.m3" class="ltx_Math" alttext="\pi^{*}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\pi^{*}</annotation></semantics></math>. In particular, we have for any <math id="A6.SS1.p5.m4" class="ltx_Math" alttext="t\in[T]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[T]</annotation></semantics></math></p>
<table id="A6.EGx73" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex103"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex103.m1" class="ltx_Math" alttext="\displaystyle\text{err}_{t}^{*}" display="inline" intent=":literal"><semantics><msubsup><mtext>err</mtext><mi>t</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">\displaystyle\text{err}_{t}^{*}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex103.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{x\sim\rho,y\sim\pi^{*}(\cdot|x)}\left[\left(A^{\pi_{\theta_{t}}}(x,y)-w_{t}^{\top}\nabla\log\pi_{\theta_{t}}(y\mid x)\right)\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi>ρ</mi><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mo>∗</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><mrow><mo>(</mo><msup><mi>A</mi><msub><mi>π</mi><msub><mi>θ</mi><mi>t</mi></msub></msub></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msubsup><mi>w</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>log</mi><msub><mi>π</mi><msub><mi>θ</mi><mi>t</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{x\sim\rho,y\sim\pi^{*}(\cdot|x)}\left[\left(A^{\pi_{\theta_{t}}}(x,y)-w_{t}^{\top}\nabla\log\pi_{\theta_{t}}(y\mid x)\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex104"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex104.m1" class="ltx_Math" alttext="\displaystyle\overset{(a)}{\leqslant}\sqrt{\mathbb{E}_{x\sim\rho,y\sim\pi^{*}(\cdot|x)}\left[\left(A^{\pi_{\theta_{t}}}(x,y)-w_{t}^{\top}\nabla\log\pi_{\theta_{t}}(y\mid x)\right)^{2}\right]}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>⩽</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">a</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi>ρ</mi><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mo>∗</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mo>(</mo><mi>A</mi><msup><mrow></mrow><msub><mi>π</mi><msub><mi>θ</mi><mi>t</mi></msub></msub></msup><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo><mo>−</mo><mi>w</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>log</mi><mi>π</mi><msub><mrow></mrow><msub><mi>θ</mi><mi>t</mi></msub></msub><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo stretchy="false">)</mo><mo>)</mo><msup><mrow></mrow><mn>2</mn></msup><mo>]</mo></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(a)}{\leqslant}\sqrt{\mathbb{E}_{x\sim\rho,y\sim\pi^{*}(\cdot|x)}\left[\left(A^{\pi_{\theta_{t}}}(x,y)-w_{t}^{\top}\nabla\log\pi_{\theta_{t}}(y\mid x)\right)^{2}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex105"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex105.m1" class="ltx_Math" alttext="\displaystyle\overset{(b)}{\leqslant}\sqrt{C_{\mu\rightarrow\pi^{*}}\mathbb{E}_{x\sim\rho,y\sim\mu(\cdot|x)}\left[\left(A^{\pi_{\theta_{t}}}(x,y)-w_{t}^{\top}\nabla\log\pi_{\theta_{t}}(y\mid x)\right)^{2}\right]}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>⩽</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">b</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>C</mi><msub><mrow></mrow><mrow><mi>μ</mi><mo stretchy="false">→</mo><msup><mi>π</mi><mo>∗</mo></msup></mrow></msub><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi>ρ</mi><mo>,</mo><mi>y</mi><mo>∼</mo><mi>μ</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mo>(</mo><mi>A</mi><msup><mrow></mrow><msub><mi>π</mi><msub><mi>θ</mi><mi>t</mi></msub></msub></msup><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo><mo>−</mo><mi>w</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>log</mi><mi>π</mi><msub><mrow></mrow><msub><mi>θ</mi><mi>t</mi></msub></msub><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo stretchy="false">)</mo><mo>)</mo><msup><mrow></mrow><mn>2</mn></msup><mo>]</mo></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(b)}{\leqslant}\sqrt{C_{\mu\rightarrow\pi^{*}}\mathbb{E}_{x\sim\rho,y\sim\mu(\cdot|x)}\left[\left(A^{\pi_{\theta_{t}}}(x,y)-w_{t}^{\top}\nabla\log\pi_{\theta_{t}}(y\mid x)\right)^{2}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex106"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex106.m1" class="ltx_Math" alttext="\displaystyle\overset{(c)}{\leqslant}\sqrt{C_{\mu\rightarrow\pi^{*}}\cdot\text{err}_{t}^{2}(m,\varepsilon,\delta,\zeta)}," display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mo>⩽</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">c</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><msub><mi>C</mi><mrow><mi>μ</mi><mo stretchy="false">→</mo><msup><mi>π</mi><mo>∗</mo></msup></mrow></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mtext>err</mtext><mi>t</mi><mn>2</mn></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>ε</mi><mo>,</mo><mi>δ</mi><mo>,</mo><mi>ζ</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(c)}{\leqslant}\sqrt{C_{\mu\rightarrow\pi^{*}}\cdot\text{err}_{t}^{2}(m,\varepsilon,\delta,\zeta)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.p5.2" class="ltx_p">where (a) holds by Cauchy–Schwarz inequality; in (b), we define the single-policy concentrability coefficient <math id="A6.SS1.p5.m5" class="ltx_Math" alttext="C_{\mu\rightarrow\pi^{*}}:=\max_{x,y}\frac{\pi^{*}(y|x)}{\mu(y|x)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><mi>μ</mi><mo stretchy="false">→</mo><msup><mi>π</mi><mo>∗</mo></msup></mrow></msub><mo>:=</mo><mrow><msub><mi>max</mi><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow></msub><mo lspace="0.167em">⁡</mo><mfrac><mrow><msup><mi>π</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">C_{\mu\rightarrow\pi^{*}}:=\max_{x,y}\frac{\pi^{*}(y|x)}{\mu(y|x)}</annotation></semantics></math>; (c) follows directly from the guarantee of <span id="A6.SS1.p5.2.1" class="ltx_text ltx_font_typewriter">PrivateLS</span> oracle.</p>
</div>
<div id="A6.SS1.p6" class="ltx_para">
<p id="A6.SS1.p6.1" class="ltx_p">Finally, putting everything together, yields</p>
<table id="A6.EGx74" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex107"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex107.m1" class="ltx_Math" alttext="\displaystyle J(\pi^{*})-\frac{1}{T}\sum_{t=1}^{T}J(\pi_{t})\leqslant\sqrt{\frac{\beta W^{2}\log|\mathcal{Y}|}{2T}}+\frac{\sqrt{C_{\mu\rightarrow\pi^{*}}}}{T}\sum_{t=1}^{T}\text{err}_{t}(m,\varepsilon,\delta,\zeta)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>⩽</mo><mrow><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle></msqrt><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msqrt><msub><mi>C</mi><mrow><mi>μ</mi><mo stretchy="false">→</mo><msup><mi>π</mi><mo>∗</mo></msup></mrow></msub></msqrt><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mtext>err</mtext><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>ε</mi><mo>,</mo><mi>δ</mi><mo>,</mo><mi>ζ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle J(\pi^{*})-\frac{1}{T}\sum_{t=1}^{T}J(\pi_{t})\leqslant\sqrt{\frac{\beta W^{2}\log|\mathcal{Y}|}{2T}}+\frac{\sqrt{C_{\mu\rightarrow\pi^{*}}}}{T}\sum_{t=1}^{T}\text{err}_{t}(m,\varepsilon,\delta,\zeta).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A6.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">F.2 </span>Proof of Lemma <a href="#Thmlemma2" title="Lemma 2 (Private LS with exponential mechanism). ‣ 6.2 Applications ‣ 6 Differentially Private NPG and REBEL ‣ On the Sample Complexity of Differentially Private Policy Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a></h3>

<div id="A6.SS2.p1" class="ltx_para">
<p id="A6.SS2.p1.1" class="ltx_p">A key lemma in our proof is the following form of Freedman’s inequality.</p>
</div>
<div id="Thmlemma10" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma10.2" class="ltx_text ltx_font_bold">Lemma 10</span></span><span id="Thmlemma10.3" class="ltx_text ltx_font_bold"> </span>(Lemma A.2 in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib74" title="" class="ltx_ref">74</a>]</cite>)<span id="Thmlemma10.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma10.p1" class="ltx_para">
<p id="Thmlemma10.p1.1" class="ltx_p"><span id="Thmlemma10.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma10.p1.m1" class="ltx_Math" alttext="\{X_{i}\}_{i\leq n}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>≤</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\{X_{i}\}_{i\leq n}</annotation></semantics></math> be a real-valued martingale difference sequence adapted to a filtration <math id="Thmlemma10.p1.m2" class="ltx_Math" alttext="\{\mathcal{F}_{i}\}_{i\leq n}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>≤</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\{\mathcal{F}_{i}\}_{i\leq n}</annotation></semantics></math>. If <math id="Thmlemma10.p1.m3" class="ltx_Math" alttext="|X_{i}|\leq R" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">|X_{i}|\leq R</annotation></semantics></math> almost surely, then for any <math id="Thmlemma10.p1.m4" class="ltx_Math" alttext="\eta\in(0,1/R)" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\eta\in(0,1/R)</annotation></semantics></math>, with probability at least <math id="Thmlemma10.p1.m5" class="ltx_Math" alttext="1-\zeta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>ζ</mi></mrow><annotation encoding="application/x-tex">1-\zeta</annotation></semantics></math>,</span></p>
<table id="A6.EGx75" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex108"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex108.m1" class="ltx_Math" alttext="\displaystyle\sum_{i=1}^{n}X_{i}\leq\eta\sum_{i=1}^{n}\mathbb{E}_{i-1}[X_{i}^{2}]+\frac{\log(1/\zeta)}{\eta}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><msub><mi>X</mi><mi>i</mi></msub></mrow><mo>≤</mo><mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi>𝔼</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>X</mi><mi>i</mi><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>ζ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>η</mi></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=1}^{n}X_{i}\leq\eta\sum_{i=1}^{n}\mathbb{E}_{i-1}[X_{i}^{2}]+\frac{\log(1/\zeta)}{\eta},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma10.p1.2" class="ltx_p"><span id="Thmlemma10.p1.2.1" class="ltx_text ltx_font_italic">where <math id="Thmlemma10.p1.m6" class="ltx_math_unparsed" alttext="\mathbb{E}_{i-1}[\cdot]:=\mathbb{E}[\cdot|\mathcal{F}_{i-1}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">[</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">]</mo></mrow><mo>:=</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}_{i-1}[\cdot]:=\mathbb{E}[\cdot|\mathcal{F}_{i-1}]</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A6.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Lemma <a href="#Thmlemma2" title="Lemma 2 (Private LS with exponential mechanism). ‣ 6.2 Applications ‣ 6 Differentially Private NPG and REBEL ‣ On the Sample Complexity of Differentially Private Policy Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.</h6>
<div id="A6.SS2.p2" class="ltx_para">
<p id="A6.SS2.p2.1" class="ltx_p"><span id="A6.SS2.p2.1.1" class="ltx_text">For any fixed <math id="A6.SS2.p2.m1" class="ltx_Math" alttext="h\in\mathcal{H}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow><annotation encoding="application/x-tex">h\in\mathcal{H}</annotation></semantics></math>, we define</span></p>
<table id="A6.EGx76" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex109"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex109.m1" class="ltx_Math" alttext="\displaystyle U_{i}^{h}:=(h(u_{i})-z_{i})^{2}-(h^{*}(u_{i})-z_{i})^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>U</mi><mi>i</mi><mi>h</mi></msubsup><mo>:=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>z</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>h</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>z</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle U_{i}^{h}:=(h(u_{i})-z_{i})^{2}-(h^{*}(u_{i})-z_{i})^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.p2.2" class="ltx_p"><span id="A6.SS2.p2.2.1" class="ltx_text">If we define the filtration <math id="A6.SS2.p2.m2" class="ltx_Math" alttext="\mathcal{F}_{i}=\sigma(u_{1},z_{1},\ldots,u_{i},z_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub><mo>=</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mn>1</mn></msub><mo>,</mo><msub><mi>z</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>u</mi><mi>i</mi></msub><mo>,</mo><msub><mi>z</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}_{i}=\sigma(u_{1},z_{1},\ldots,u_{i},z_{i})</annotation></semantics></math> and let <math id="A6.SS2.p2.m3" class="ltx_math_unparsed" alttext="\mathbb{E}_{i-1}[\cdot]=\mathbb{E}[\cdot|\mathcal{F}_{i-1}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">[</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">]</mo></mrow><mo>=</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}_{i-1}[\cdot]=\mathbb{E}[\cdot|\mathcal{F}_{i-1}]</annotation></semantics></math>, then we have that <math id="A6.SS2.p2.m4" class="ltx_Math" alttext="\{D_{i}^{h}\}_{i\leq m}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msubsup><mi>D</mi><mi>i</mi><mi>h</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>≤</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">\{D_{i}^{h}\}_{i\leq m}</annotation></semantics></math> where</span></p>
<table id="A6.EGx77" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex110"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex110.m1" class="ltx_Math" alttext="\displaystyle D_{i}^{h}:=\mathbb{E}_{i-1}[U_{i}^{h}]-U_{i}^{h}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>D</mi><mi>i</mi><mi>h</mi></msubsup><mo>:=</mo><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>U</mi><mi>i</mi><mi>h</mi></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><msubsup><mi>U</mi><mi>i</mi><mi>h</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle D_{i}^{h}:=\mathbb{E}_{i-1}[U_{i}^{h}]-U_{i}^{h}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.p2.3" class="ltx_p"><span id="A6.SS2.p2.3.1" class="ltx_text">is a martingale difference sequence adapted to <math id="A6.SS2.p2.m5" class="ltx_Math" alttext="\{\mathcal{F}_{i}\}_{i\leq m}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>≤</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">\{\mathcal{F}_{i}\}_{i\leq m}</annotation></semantics></math>. We further notice that</span></p>
<table id="A6.EGx78" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex111"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex111.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{i-1}[(D_{i}^{h})^{2}]\leq\mathbb{E}_{i-1}[(U_{i}^{h})^{2}]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>D</mi><mi>i</mi><mi>h</mi></msubsup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>𝔼</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>U</mi><mi>i</mi><mi>h</mi></msubsup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{i-1}[(D_{i}^{h})^{2}]\leq\mathbb{E}_{i-1}[(U_{i}^{h})^{2}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex111.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{i-1}[(h(u_{i})-h^{*}(u_{i}))^{2}(h(u_{i})+h^{*}(u_{i})-2z_{i})^{2}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>h</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>h</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>z</mi><mi>i</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{i-1}[(h(u_{i})-h^{*}(u_{i}))^{2}(h(u_{i})+h^{*}(u_{i})-2z_{i})^{2}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex112"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex112.m1" class="ltx_Math" alttext="\displaystyle\lesssim R^{2}\cdot\mathbb{E}_{i-1}[(h(u_{i})-h^{*}(u_{i}))^{2}]," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≲</mo><mrow><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>h</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim R^{2}\cdot\mathbb{E}_{i-1}[(h(u_{i})-h^{*}(u_{i}))^{2}],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.p2.4" class="ltx_p"><span id="A6.SS2.p2.4.1" class="ltx_text">where the last step holds by the boundedness of <math id="A6.SS2.p2.m6" class="ltx_Math" alttext="z_{i}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mi>i</mi></msub><annotation encoding="application/x-tex">z_{i}</annotation></semantics></math>, <math id="A6.SS2.p2.m7" class="ltx_Math" alttext="h\in\mathcal{H}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow><annotation encoding="application/x-tex">h\in\mathcal{H}</annotation></semantics></math> and <math id="A6.SS2.p2.m8" class="ltx_Math" alttext="h^{*}" display="inline" intent=":literal"><semantics><msup><mi>h</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">h^{*}</annotation></semantics></math>. Moreover, by definition, we have</span></p>
<table id="A6.EGx79" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex113"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex113.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{i-1}[U_{i}^{h}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>U</mi><mi>i</mi><mi>h</mi></msubsup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{i-1}[U_{i}^{h}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex113.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{i-1}[(h(u_{i})-h^{*}(u_{i}))(h(u_{i})+h^{*}(u_{i})-2z_{i})]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>h</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>h</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>z</mi><mi>i</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{i-1}[(h(u_{i})-h^{*}(u_{i}))(h(u_{i})+h^{*}(u_{i})-2z_{i})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex114"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex114.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{i-1}[(h(u_{i})-h^{*}(u_{i}))^{2}]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>h</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{i-1}[(h(u_{i})-h^{*}(u_{i}))^{2}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.SS2.p3" class="ltx_para">
<p id="A6.SS2.p3.1" class="ltx_p"><span id="A6.SS2.p3.1.1" class="ltx_text">With the above results, we first apply Lemma <a href="#Thmlemma10" title="Lemma 10 (Lemma A.2 in []). ‣ F.2 Proof of Lemma ‣ Appendix F Proof of Chapter ‣ On the Sample Complexity of Differentially Private Policy Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a> to <math id="A6.SS2.p3.m1" class="ltx_Math" alttext="\{D_{i}^{h}\}_{i\leq m}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msubsup><mi>D</mi><mi>i</mi><mi>h</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>≤</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">\{D_{i}^{h}\}_{i\leq m}</annotation></semantics></math> along with a union bound, yielding that with probability at least <math id="A6.SS2.p3.m2" class="ltx_Math" alttext="1-\zeta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>ζ</mi></mrow><annotation encoding="application/x-tex">1-\zeta</annotation></semantics></math>, for all <math id="A6.SS2.p3.m3" class="ltx_Math" alttext="h\in\mathcal{H}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow><annotation encoding="application/x-tex">h\in\mathcal{H}</annotation></semantics></math></span></p>
<table id="A6.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.E22.m1" class="ltx_Math" alttext="\sum_{i=1}^{m}\mathbb{E}_{i-1}[(h(u_{i})-h^{*}(u_{i}))^{2}]\lesssim\sum_{t=i}^{m}U_{i}^{h}+R^{2}\cdot\log(|\mathcal{H}|/\zeta)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><mrow><msub><mi>𝔼</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>h</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo rspace="0.111em">≲</mo><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mi>i</mi></mrow><mi>m</mi></munderover><msubsup><mi>U</mi><mi>i</mi><mi>h</mi></msubsup></mrow><mo>+</mo><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo>/</mo><mi>ζ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{m}\mathbb{E}_{i-1}[(h(u_{i})-h^{*}(u_{i}))^{2}]\lesssim\sum_{t=i}^{m}U_{i}^{h}+R^{2}\cdot\log(|\mathcal{H}|/\zeta).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
</table>
<p id="A6.SS2.p3.2" class="ltx_p"><span id="A6.SS2.p3.2.1" class="ltx_text">Similarly, we can apply Lemma <a href="#Thmlemma10" title="Lemma 10 (Lemma A.2 in []). ‣ F.2 Proof of Lemma ‣ Appendix F Proof of Chapter ‣ On the Sample Complexity of Differentially Private Policy Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a> to <math id="A6.SS2.p3.m4" class="ltx_Math" alttext="\{-D_{i}^{h}\}_{i\leq m}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><mo>−</mo><msubsup><mi>D</mi><mi>i</mi><mi>h</mi></msubsup></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>≤</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">\{-D_{i}^{h}\}_{i\leq m}</annotation></semantics></math> along with a union bound, which give us</span></p>
<table id="A6.EGx80" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.E23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.E23.m1" class="ltx_Math" alttext="\displaystyle\sum_{i=1}^{m}U_{i}^{h}\lesssim\sum_{i=1}^{m}\mathbb{E}_{i-1}[(h(u_{i})-h^{*}(u_{i}))^{2}]+\log(|\mathcal{H}|/\zeta)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msubsup><mi>U</mi><mi>i</mi><mi>h</mi></msubsup></mrow><mo>≲</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msub><mi>𝔼</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>h</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo>/</mo><mi>ζ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=1}^{m}U_{i}^{h}\lesssim\sum_{i=1}^{m}\mathbb{E}_{i-1}[(h(u_{i})-h^{*}(u_{i}))^{2}]+\log(|\mathcal{H}|/\zeta).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
</table>
</div>
<div id="A6.SS2.p4" class="ltx_para">
<p id="A6.SS2.p4.1" class="ltx_p"><span id="A6.SS2.p4.1.1" class="ltx_text">Now, we set <math id="A6.SS2.p4.m1" class="ltx_Math" alttext="h=\widehat{h}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>=</mo><mover accent="true"><mi>h</mi><mo>^</mo></mover></mrow><annotation encoding="application/x-tex">h=\widehat{h}</annotation></semantics></math> in (<a href="#A6.E22" title="In Proof of Lemma . ‣ F.2 Proof of Lemma ‣ Appendix F Proof of Chapter ‣ On the Sample Complexity of Differentially Private Policy Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>), i.e., the output of the exponential mechanism, and by the standard utility guarantee of the exponential mechanism <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib33" title="" class="ltx_ref">33</a>]</cite>, we have</span></p>
<table id="A6.EGx81" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex115"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex115.m1" class="ltx_Math" alttext="\displaystyle\sum_{i=1}^{m}\mathbb{E}_{i-1}[(\widehat{h}(u_{i})-h^{*}(u_{i}))^{2}]\lesssim\sum_{i=1}^{m}U_{t}^{h^{\prime}}+R^{2}\log(|\mathcal{H}|/\zeta)+R^{2}\frac{\log(|\mathcal{H}|/\zeta)}{\varepsilon}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msub><mi>𝔼</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mover accent="true"><mi>h</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>h</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>≲</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msubsup><mi>U</mi><mi>t</mi><msup><mi>h</mi><mo>′</mo></msup></msubsup></mrow><mo>+</mo><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo>/</mo><mi>ζ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo>/</mo><mi>ζ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>ε</mi></mfrac></mstyle></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=1}^{m}\mathbb{E}_{i-1}[(\widehat{h}(u_{i})-h^{*}(u_{i}))^{2}]\lesssim\sum_{i=1}^{m}U_{t}^{h^{\prime}}+R^{2}\log(|\mathcal{H}|/\zeta)+R^{2}\frac{\log(|\mathcal{H}|/\zeta)}{\varepsilon},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.p4.2" class="ltx_p"><span id="A6.SS2.p4.2.1" class="ltx_text">where <math id="A6.SS2.p4.m2" class="ltx_Math" alttext="h^{\prime}\in\arg\min_{h\in\mathcal{H}}L(h)=\arg\min_{h\in\mathcal{H}}\sum_{i\in[m]}(h(u_{i})-z_{i})^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>h</mi><mo>′</mo></msup><mo>∈</mo><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mrow><msub><mi>min</mi><mrow><mi>h</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow></msub><mo lspace="0.167em">⁡</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mmultiscripts><mo>∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow><mrow></mrow><mprescripts></mprescripts><mrow><mi>h</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow><mrow></mrow></mmultiscripts><mo lspace="0em">⁡</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>z</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">h^{\prime}\in\arg\min_{h\in\mathcal{H}}L(h)=\arg\min_{h\in\mathcal{H}}\sum_{i\in[m]}(h(u_{i})-z_{i})^{2}</annotation></semantics></math>. Since <math id="A6.SS2.p4.m3" class="ltx_Math" alttext="\sum_{i=1}^{m}U_{i}^{h^{\prime}}\leq\sum_{i=1}^{m}U_{i}^{\widetilde{h}}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><msubsup><mi>U</mi><mi>i</mi><msup><mi>h</mi><mo>′</mo></msup></msubsup></mrow><mo rspace="0.111em">≤</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><msubsup><mi>U</mi><mi>i</mi><mover accent="true"><mi>h</mi><mo>~</mo></mover></msubsup></mrow></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{m}U_{i}^{h^{\prime}}\leq\sum_{i=1}^{m}U_{i}^{\widetilde{h}}</annotation></semantics></math> where <math id="A6.SS2.p4.m4" class="ltx_Math" alttext="\widetilde{h}:=\mathop{\mathrm{argmin}}_{h\in\mathcal{H}}\sum_{i=1}^{m}\mathbb{E}_{i-1}[(h(u_{i})-h^{*}(u_{i}))^{2}]" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>h</mi><mo>~</mo></mover><mo rspace="0.1389em">:=</mo><mrow><msub><mo lspace="0.1389em" rspace="0em">argmin</mo><mrow><mi>h</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow></msub><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><mrow><msub><mi>𝔼</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>h</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{h}:=\mathop{\mathrm{argmin}}_{h\in\mathcal{H}}\sum_{i=1}^{m}\mathbb{E}_{i-1}[(h(u_{i})-h^{*}(u_{i}))^{2}]</annotation></semantics></math> , by (<a href="#A6.E23" title="In Proof of Lemma . ‣ F.2 Proof of Lemma ‣ Appendix F Proof of Chapter ‣ On the Sample Complexity of Differentially Private Policy Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>) and the above inequality, we have</span></p>
</div>
<div id="A6.SS2.p5" class="ltx_para">
<table id="A6.EGx82" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex116"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex116.m1" class="ltx_Math" alttext="\displaystyle\sum_{i=1}^{m}\mathbb{E}_{i-1}[(\widehat{h}(u_{i})-h^{*}(u_{i}))^{2}]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msub><mi>𝔼</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mover accent="true"><mi>h</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>h</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=1}^{m}\mathbb{E}_{i-1}[(\widehat{h}(u_{i})-h^{*}(u_{i}))^{2}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex116.m2" class="ltx_Math" alttext="\displaystyle\lesssim\sum_{i=1}^{m}\mathbb{E}_{i-1}[(\widetilde{h}(u_{i})-h^{*}(u_{i}))^{2}]+R^{2}\log(|\mathcal{H}|/\zeta)+R^{2}\frac{\log(|\mathcal{H}|/\zeta)}{\varepsilon}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≲</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msub><mi>𝔼</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mover accent="true"><mi>h</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>h</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo>/</mo><mi>ζ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo>/</mo><mi>ζ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>ε</mi></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\sum_{i=1}^{m}\mathbb{E}_{i-1}[(\widetilde{h}(u_{i})-h^{*}(u_{i}))^{2}]+R^{2}\log(|\mathcal{H}|/\zeta)+R^{2}\frac{\log(|\mathcal{H}|/\zeta)}{\varepsilon}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex117"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex117.m1" class="ltx_Math" alttext="\displaystyle\mathop{\leq}\limits^{(a)}m\alpha_{\mathsf{approx}}+R^{2}\log(|\mathcal{H}|/\zeta)+R^{2}\frac{\log(|\mathcal{H}|/\zeta)}{\varepsilon}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mover><mo movablelimits="false">≤</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mover><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>𝖺𝗉𝗉𝗋𝗈𝗑</mi></msub></mrow></mrow><mo>+</mo><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo>/</mo><mi>ζ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo>/</mo><mi>ζ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>ε</mi></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathop{\leq}\limits^{(a)}m\alpha_{\mathsf{approx}}+R^{2}\log(|\mathcal{H}|/\zeta)+R^{2}\frac{\log(|\mathcal{H}|/\zeta)}{\varepsilon},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.p5.1" class="ltx_p"><span id="A6.SS2.p5.1.1" class="ltx_text">where <math id="A6.SS2.p5.m1" class="ltx_Math" alttext="(a)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a)</annotation></semantics></math> holds the assumption on the approximation error.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="A7" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix G </span>Proof of Appendix <a href="#A4" title="Appendix D Differentially Private REBEL ‣ On the Sample Complexity of Differentially Private Policy Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D</span></a></h2>

<div id="Thmlemma11" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma11.2" class="ltx_text ltx_font_bold">Lemma 11</span></span><span id="Thmlemma11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma11.p1" class="ltx_para">
<p id="Thmlemma11.p1.1" class="ltx_p"><span id="Thmlemma11.p1.1.1" class="ltx_text ltx_font_italic">Consider any <math id="Thmlemma11.p1.m1" class="ltx_Math" alttext="t\in[T]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[T]</annotation></semantics></math>. For notation simplicity, we define <math id="Thmlemma11.p1.m2" class="ltx_Math" alttext="f_{t}(x,y):=\frac{1}{\eta}ln\frac{\pi_{t+1}(y|x)}{\pi_{t}(y|x)}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mfrac><mn>1</mn><mi>η</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msub><mi>π</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">f_{t}(x,y):=\frac{1}{\eta}ln\frac{\pi_{t+1}(y|x)}{\pi_{t}(y|x)}</annotation></semantics></math>. Define <math id="Thmlemma11.p1.m3" class="ltx_Math" alttext="\Delta(x,y)=f_{t}(x,y)-r(x,y)" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>f</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta(x,y)=f_{t}(x,y)-r(x,y)</annotation></semantics></math>. Define <math id="Thmlemma11.p1.m4" class="ltx_math_unparsed" alttext="\Delta_{\pi_{t}}(x)=\mathbb{E}_{y\sim\pi_{t}(\cdot|x)}\Delta(x,y)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><msub><mi>π</mi><mi>t</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mi mathvariant="normal">Δ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta_{\pi_{t}}(x)=\mathbb{E}_{y\sim\pi_{t}(\cdot|x)}\Delta(x,y)</annotation></semantics></math> and <math id="Thmlemma11.p1.m5" class="ltx_math_unparsed" alttext="\Delta_{\mu}(x)=\mathbb{E}_{y\sim\mu(\cdot|x)}\Delta(x,y)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>μ</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>y</mi><mo>∼</mo><mi>μ</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mi mathvariant="normal">Δ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta_{\mu}(x)=\mathbb{E}_{y\sim\mu(\cdot|x)}\Delta(x,y)</annotation></semantics></math>. Under Assumption <a href="#Thmassumption6" title="Assumption 6 (Private estimation error). ‣ Appendix D Differentially Private REBEL ‣ On the Sample Complexity of Differentially Private Policy Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>, for all <math id="Thmlemma11.p1.m6" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, we have the following:</span></p>
</div>
<div id="Thmlemma11.p2" class="ltx_para">
<table id="A7.EGx83" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex118"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex118.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}_{x,y\sim\pi_{t}(\cdot|x)}\left(f_{t}(x,y)-r(x,y)-\Delta_{\pi_{t}}(x)\right)^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><msup><mrow><mo>(</mo><msub><mi>f</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi mathvariant="normal">Δ</mi><msub><mi>π</mi><mi>t</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{x,y\sim\pi_{t}(\cdot|x)}\left(f_{t}(x,y)-r(x,y)-\Delta_{\pi_{t}}(x)\right)^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex118.m2" class="ltx_Math" alttext="\displaystyle\leqslant\mathrm{err}^{2}_{t}(m,\varepsilon,\delta,\zeta)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>⩽</mo><mrow><msubsup><mi>err</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>ε</mi><mo>,</mo><mi>δ</mi><mo>,</mo><mi>ζ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leqslant\mathrm{err}^{2}_{t}(m,\varepsilon,\delta,\zeta),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex119"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex119.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}_{x,y\sim\mu(\cdot|x)}\left(f_{t}(x,y)-r(x,y)-\Delta_{\mu}(x)\right)^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>,</mo><mi>y</mi><mo>∼</mo><mi>μ</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><msup><mrow><mo>(</mo><msub><mi>f</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi mathvariant="normal">Δ</mi><mi>μ</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{x,y\sim\mu(\cdot|x)}\left(f_{t}(x,y)-r(x,y)-\Delta_{\mu}(x)\right)^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex119.m2" class="ltx_Math" alttext="\displaystyle\leqslant\mathrm{err}^{2}_{t}(m,\varepsilon,\delta,\zeta)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>⩽</mo><mrow><msubsup><mi>err</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>ε</mi><mo>,</mo><mi>δ</mi><mo>,</mo><mi>ζ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leqslant\mathrm{err}^{2}_{t}(m,\varepsilon,\delta,\zeta),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex120"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex120.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{x}\left(\Delta_{\pi_{t}}(x)-\Delta_{\mu}(x)\right)^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><msub><mi mathvariant="normal">Δ</mi><msub><mi>π</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{x}\left(\Delta_{\pi_{t}}(x)-\Delta_{\mu}(x)\right)^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex120.m2" class="ltx_Math" alttext="\displaystyle\leqslant\mathrm{err}^{2}_{t}(m,\varepsilon,\delta,\zeta)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>⩽</mo><mrow><msubsup><mi>err</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>ε</mi><mo>,</mo><mi>δ</mi><mo>,</mo><mi>ζ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leqslant\mathrm{err}^{2}_{t}(m,\varepsilon,\delta,\zeta).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A7.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A7.p1" class="ltx_para">
<p id="A7.p1.1" class="ltx_p"><span id="A7.p1.1.1" class="ltx_text">From Assumption <a href="#Thmassumption6" title="Assumption 6 (Private estimation error). ‣ Appendix D Differentially Private REBEL ‣ On the Sample Complexity of Differentially Private Policy Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>, we have:</span></p>
</div>
<div id="A7.p2" class="ltx_para">
<table id="A7.EGx84" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex121"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
