<td id="A8.T1.2.4.5" class="ltx_td ltx_align_center">187.17</td></tr>
<tr id="A8.T1.2.5" class="ltx_tr">
<th id="A8.T1.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">NPG</th>
<th id="A8.T1.2.5.2" class="ltx_td ltx_align_center ltx_th ltx_th_row">N/A</th>
