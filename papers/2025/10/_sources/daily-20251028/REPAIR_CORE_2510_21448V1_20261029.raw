<td id="S4.T1.2.14.2" class="ltx_td ltx_align_center">81.4</td>
<td id="S4.T1.2.14.3" class="ltx_td ltx_align_center"><span id="S4.T1.2.14.3.1" class="ltx_text ltx_font_bold">97</span></td>
<td id="S4.T1.2.14.4" class="ltx_td ltx_align_center">88.3</td>
<td id="S4.T1.2.14.5" class="ltx_td ltx_align_center">92.4</td>
<td id="S4.T1.2.14.6" class="ltx_td ltx_align_center"><span id="S4.T1.2.14.6.1" class="ltx_text ltx_underline">93.4</span></td></tr>
<tr id="S4.T1.2.15" class="ltx_tr">
<td id="S4.T1.2.15.1" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.2.15.1.1" class="ltx_text ltx_font_bold">antmaze-umaze</span></td>
<td id="S4.T1.2.15.2" class="ltx_td ltx_align_center ltx_border_t">69.8</td>
<td id="S4.T1.2.15.3" class="ltx_td ltx_align_center ltx_border_t">76</td>
<td id="S4.T1.2.15.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.2.15.4.1" class="ltx_text ltx_underline">79</span></td>
<td id="S4.T1.2.15.5" class="ltx_td ltx_align_center ltx_border_t">71</td>
<td id="S4.T1.2.15.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.2.15.6.1" class="ltx_text ltx_font_bold">80</span></td></tr>
<tr id="S4.T1.2.16" class="ltx_tr">
