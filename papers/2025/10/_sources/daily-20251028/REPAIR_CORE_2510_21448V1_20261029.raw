<td id="S4.T1.2.16.2" class="ltx_td ltx_align_center ltx_border_bb">70.3</td>
<td id="S4.T1.2.16.3" class="ltx_td ltx_align_center ltx_border_bb">66</td>
<td id="S4.T1.2.16.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T1.2.16.4.1" class="ltx_text ltx_font_bold">80</span></td>
<td id="S4.T1.2.16.5" class="ltx_td ltx_align_center ltx_border_bb">65</td>
<td id="S4.T1.2.16.6" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T1.2.16.6.1" class="ltx_text ltx_underline">78</span></td></tr>
