<td id="S4.T2.2.3.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.0pt;padding-right:1.0pt;"><span class="ltx_inline-block"><svg id="S4.T2.pic8" class="ltx_picture" height="14.45" overflow="visible" style="vertical-align:-2.77px" version="1.1" viewBox="0 0 30.13 14.45" width="30.13"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,14.45) matrix(1 0 0 -1 0 0) translate(15.07,0) translate(0,7.23)"><g style="--ltx-fill-color:#FFD9D9;" fill="#FFD9D9"><path style="stroke:none" d="M -15.07 -7.23 h 30.13 v 14.45 h -30.13 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -12.3 -4.46)"><foreignObject style="--ltx-fo-width:1.78em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="24.6"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.T2.pic8.1" class="ltx_text">3.18</span></span></span></foreignObject></g></g></svg></span></td></tr>
<tr id="S4.T2.2.4" class="ltx_tr">
<td id="S4.T2.2.4.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_align_top ltx_border_r" style="padding-left:1.0pt;padding-right:1.0pt;">
<span id="S4.T2.2.4.1.1" class="ltx_inline-block ltx_align_top" style="width:71.1pt;">
<span id="S4.T2.2.4.1.1.1" class="ltx_p">w/o Emotional Attitude</span>
</span></td>
