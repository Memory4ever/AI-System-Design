<td id="S4.T2.2.7.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb ltx_border_r ltx_border_t" style="padding-left:1.0pt;padding-right:1.0pt;"><span id="S4.T2.2.7.3.1" class="ltx_text ltx_font_bold">4.55</span></td>
