<td id="A5.T22.4.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="A5.T22.4.2.2.1" class="ltx_text" style="font-size:90%;">0.588 <math id="A5.T22.m1" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 1.45</span></td>
<td id="A5.T22.4.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="A5.T22.4.2.3.1" class="ltx_text" style="font-size:90%;">0.601 <math id="A5.T22.m2" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.001</span></td>
<td id="A5.T22.4.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="A5.T22.4.2.4.1" class="ltx_text" style="font-size:90%;">0.652 <math id="A5.T22.m3" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.013</span></td>
<td id="A5.T22.4.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="A5.T22.4.2.5.1" class="ltx_text" style="font-size:90%;">0.688 <math id="A5.T22.m4" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.010</span></td>
<td id="A5.T22.4.2.6" class="ltx_td ltx_align_center ltx_border_t"><span id="A5.T22.4.2.6.1" class="ltx_text" style="font-size:90%;">0.723 <math id="A5.T22.m5" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.010</span></td></tr>
