<div id="alg1.l3" class="ltx_listingline">
              
              
            <math id="alg1.l3.m1" class="ltx_Math" alttext="\bm{Q}^{\prime}\leftarrow\bm{P}_{\sigma}\bm{Q},\bm{K}^{\prime}\leftarrow\bm{P}_{\pi}\bm{K},\bm{V}^{\prime}\leftarrow\bm{P}_{\pi}\bm{V}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">𝑸</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">′</mo></msup><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">←</mo><mrow><msub><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">𝑷</mi><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">σ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">𝑸</mi></mrow></mrow><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">,</mo><mrow><msup><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">𝑲</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">′</mo></msup><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">←</mo><mrow><msub><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">𝑷</mi><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">π</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">𝑲</mi></mrow></mrow><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">,</mo><mrow><msup><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">𝑽</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">′</mo></msup><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">←</mo><mrow><msub><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">𝑷</mi><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">π</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">𝑽</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{Q}^{\prime}\leftarrow\bm{P}_{\sigma}\bm{Q},\bm{K}^{\prime}\leftarrow\bm{P}_{\pi}\bm{K},\bm{V}^{\prime}\leftarrow\bm{P}_{\pi}\bm{V}</annotation></semantics></math> <span id="alg1.l3.2" class="ltx_text" style="float:right;"><math id="alg1.l3.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Apply permutation
</span>
</div>
<div id="alg1.l4" class="ltx_listingline">
              
              
            Divide <math id="alg1.l4.m1" class="ltx_Math" alttext="\bm{Q}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝑸</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\bm{Q}^{\prime}</annotation></semantics></math> into <math id="alg1.l4.m2" class="ltx_Math" alttext="T_{r}=\lceil\frac{N}{B}\rceil" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>r</mi></msub><mo>=</mo><mrow><mo stretchy="false">⌈</mo><mfrac><mi>N</mi><mi>B</mi></mfrac><mo stretchy="false">⌉</mo></mrow></mrow><annotation encoding="application/x-tex">T_{r}=\lceil\frac{N}{B}\rceil</annotation></semantics></math> blocks <math id="alg1.l4.m3" class="ltx_Math" alttext="\bm{Q}^{\prime}_{1},\dots,\bm{Q}^{\prime}_{T_{r}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑸</mi><mn>1</mn><mo>′</mo></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>𝑸</mi><msub><mi>T</mi><mi>r</mi></msub><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">\bm{Q}^{\prime}_{1},\dots,\bm{Q}^{\prime}_{T_{r}}</annotation></semantics></math>; divide <math id="alg1.l4.m4" class="ltx_Math" alttext="\bm{K}^{\prime},\bm{V}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑲</mi><mo>′</mo></msup><mo>,</mo><msup><mi>𝑽</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">\bm{K}^{\prime},\bm{V}^{\prime}</annotation></semantics></math> into <math id="alg1.l4.m5" class="ltx_Math" alttext="T_{c}=\lceil\frac{N}{B}\rceil" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>c</mi></msub><mo>=</mo><mrow><mo stretchy="false">⌈</mo><mfrac><mi>N</mi><mi>B</mi></mfrac><mo stretchy="false">⌉</mo></mrow></mrow><annotation encoding="application/x-tex">T_{c}=\lceil\frac{N}{B}\rceil</annotation></semantics></math> blocks <math id="alg1.l4.m6" class="ltx_Math" alttext="\bm{K}^{\prime}_{1},\dots,\bm{K}^{\prime}_{T_{c}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑲</mi><mn>1</mn><mo>′</mo></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>𝑲</mi><msub><mi>T</mi><mi>c</mi></msub><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">\bm{K}^{\prime}_{1},\dots,\bm{K}^{\prime}_{T_{c}}</annotation></semantics></math> and <math id="alg1.l4.m7" class="ltx_Math" alttext="\bm{V}^{\prime}_{1},\dots,\bm{V}^{\prime}_{T_{c}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑽</mi><mn>1</mn><mo>′</mo></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>𝑽</mi><msub><mi>T</mi><mi>c</mi></msub><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">\bm{V}^{\prime}_{1},\dots,\bm{V}^{\prime}_{T_{c}}</annotation></semantics></math>;

</div>
<div id="alg1.l5" class="ltx_listingline">
              
              
            <math id="alg1.l5.m1" class="ltx_Math" alttext="\bm{M}\leftarrow\text{BLOCK\_SELECTION}(\bm{Q}^{\prime},\bm{K}^{\prime},B,S)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">𝑴</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">←</mo><mrow><mtext style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">BLOCK_SELECTION</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">(</mo><msup><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">𝑸</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">′</mo></msup><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">,</mo><msup><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">𝑲</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">′</mo></msup><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">,</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">B</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">,</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">S</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{M}\leftarrow\text{BLOCK\_SELECTION}(\bm{Q}^{\prime},\bm{K}^{\prime},B,S)</annotation></semantics></math> <span id="alg1.l5.2" class="ltx_text" style="float:right;"><math id="alg1.l5.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Select blocks, see Appendix <a href="#A2" title="Appendix B Block Selection ‣ Sparser Block-Sparse Attention via Token Permutation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a>
</span>
