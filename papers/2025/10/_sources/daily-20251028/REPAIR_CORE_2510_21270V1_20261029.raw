</div>
<div id="alg1.l19" class="ltx_listingline">
              
              
              <math id="alg1.l19.m1" class="ltx_Math" alttext="\bm{O}^{\prime}_{i}\leftarrow\text{diag}((\bm{l}_{i}^{(T_{c})})^{-1})\,\bm{O}_{i}^{(T_{c})}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑶</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">←</mo><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒍</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>c</mi></msub><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>𝑶</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>c</mi></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">\bm{O}^{\prime}_{i}\leftarrow\text{diag}((\bm{l}_{i}^{(T_{c})})^{-1})\,\bm{O}_{i}^{(T_{c})}</annotation></semantics></math>; Write <math id="alg1.l19.m2" class="ltx_Math" alttext="\bm{O}^{\prime}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑶</mi><mi>i</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">\bm{O}^{\prime}_{i}</annotation></semantics></math> back to its rows in <math id="alg1.l19.m3" class="ltx_Math" alttext="\bm{O}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝑶</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\bm{O}^{\prime}</annotation></semantics></math>;

