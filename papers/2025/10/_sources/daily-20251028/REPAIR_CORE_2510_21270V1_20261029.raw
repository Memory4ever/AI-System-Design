            <span id="alg1.l7.2" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l7.m1" class="ltx_Math" alttext="i=1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i=1</annotation></semantics></math> to <math id="alg1.l7.m2" class="ltx_Math" alttext="T_{r}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>r</mi></msub><annotation encoding="application/x-tex">T_{r}</annotation></semantics></math> <span id="alg1.l7.3" class="ltx_text ltx_font_bold">do</span>

