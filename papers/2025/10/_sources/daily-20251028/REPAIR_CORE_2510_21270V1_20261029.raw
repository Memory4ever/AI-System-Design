</figure>
<figure id="A4.F9" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2">
<figure id="A4.F9.sf1" class="ltx_figure ltx_figure_panel ltx_align_center">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2"><img src="2510.21270v1/qwen_layer0_head0_no_perm.png" id="A4.F9.sf1.g1" class="ltx_graphics ltx_centering ltx_figure_panel ltx_img_square" style="aspect-ratio:264/270;" width="264" height="270" alt="Refer to caption"></div><div class="ltx_flex_cell ltx_flex_size_2"><img src="2510.21270v1/qwen_layer0_head0_perm.png" id="A4.F9.sf1.g2" class="ltx_graphics ltx_centering ltx_figure_panel ltx_img_square" style="aspect-ratio:264/270;" width="264" height="270" alt="Refer to caption"></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(a) </span>Layer 0, Head 0</figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="A4.F9.sf2" class="ltx_figure ltx_figure_panel ltx_align_center">
<div class="ltx_flex_figure">
