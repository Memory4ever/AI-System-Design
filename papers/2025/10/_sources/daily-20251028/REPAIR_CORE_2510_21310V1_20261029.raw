            <span id="alg1.l6.3" class="ltx_text" style="font-size:90%;">  </span><math id="alg1.l6.m1" class="ltx_Math" alttext="\mathrm{token}\leftarrow\texttt{&lt;BOS&gt;}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">token</mi><mo mathsize="0.900em" stretchy="false">←</mo><mtext class="ltx_mathvariant_monospace" mathsize="0.900em">&lt;BOS&gt;</mtext></mrow><annotation encoding="application/x-tex">\mathrm{token}\leftarrow\texttt{&lt;BOS&gt;}</annotation></semantics></math><span id="alg1.l6.4" class="ltx_text" style="font-size:90%;">
</span>
