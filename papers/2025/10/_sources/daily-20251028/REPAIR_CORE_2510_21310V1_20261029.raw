            <math id="alg1.l3.m1" class="ltx_Math" alttext="\mathcal{S}\leftarrow\varnothing" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒮</mi><mo mathsize="0.900em" stretchy="false">←</mo><mi mathsize="0.900em" mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\mathcal{S}\leftarrow\varnothing</annotation></semantics></math><span id="alg1.l3.3" class="ltx_text" style="font-size:90%;">
</span>
</div>
