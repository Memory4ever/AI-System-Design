            <span id="alg1.l4.3" class="ltx_text ltx_font_bold" style="font-size:90%;">for</span><span id="alg1.l4.4" class="ltx_text" style="font-size:90%;"> </span><math id="alg1.l4.m1" class="ltx_Math" alttext="i=1" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">1</mn></mrow><annotation encoding="application/x-tex">i=1</annotation></semantics></math><span id="alg1.l4.5" class="ltx_text" style="font-size:90%;"> </span><span id="alg1.l4.6" class="ltx_text ltx_font_bold" style="font-size:90%;">to</span><span id="alg1.l4.7" class="ltx_text" style="font-size:90%;"> </span><math id="alg1.l4.m2" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math><span id="alg1.l4.8" class="ltx_text" style="font-size:90%;"> </span><span id="alg1.l4.9" class="ltx_text ltx_font_bold" style="font-size:90%;">do</span><span id="alg1.l4.10" class="ltx_text" style="font-size:90%;">
</span>
</div>
