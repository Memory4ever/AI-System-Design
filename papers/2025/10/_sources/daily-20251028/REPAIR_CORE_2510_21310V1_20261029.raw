          <math id="alg2.l3.m1" class="ltx_Math" alttext="\mathcal{S}\leftarrow\varnothing" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒮</mi><mo mathsize="0.900em" stretchy="false">←</mo><mi mathsize="0.900em" mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\mathcal{S}\leftarrow\varnothing</annotation></semantics></math><span id="alg2.l3.3" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg2.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
            
            
          <span id="alg2.l4.3" class="ltx_text ltx_font_bold" style="font-size:90%;">for</span><span id="alg2.l4.4" class="ltx_text" style="font-size:90%;"> </span><math id="alg2.l4.m1" class="ltx_Math" alttext="i=1" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">1</mn></mrow><annotation encoding="application/x-tex">i=1</annotation></semantics></math><span id="alg2.l4.5" class="ltx_text" style="font-size:90%;"> </span><span id="alg2.l4.6" class="ltx_text ltx_font_bold" style="font-size:90%;">to</span><span id="alg2.l4.7" class="ltx_text" style="font-size:90%;"> </span><math id="alg2.l4.m2" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math><span id="alg2.l4.8" class="ltx_text" style="font-size:90%;"> </span><span id="alg2.l4.9" class="ltx_text ltx_font_bold" style="font-size:90%;">do</span><span id="alg2.l4.10" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg2.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
            
            
          <span id="alg2.l5.3" class="ltx_text" style="font-size:90%;">  </span><math id="alg2.l5.m1" class="ltx_Math" alttext="y^{(T)}\leftarrow\textsc{MaskTokens}(x)" display="inline" intent=":literal"><semantics><mrow><msup><mi mathsize="0.900em">y</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">T</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msup><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps" mathsize="0.900em">MaskTokens</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">x</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">y^{(T)}\leftarrow\textsc{MaskTokens}(x)</annotation></semantics></math><span id="alg2.l5.4" class="ltx_text" style="font-size:90%;">
</span><span id="alg2.l5.5" class="ltx_text" style="font-size:90%;float:right;"><math id="alg2.l5.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Initialize by masking random spans of the input sequence
</span>
</div>
<div id="alg2.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
            
            
          <span id="alg2.l6.3" class="ltx_text" style="font-size:90%;">  </span><span id="alg2.l6.4" class="ltx_text ltx_font_bold" style="font-size:90%;">for</span><span id="alg2.l6.5" class="ltx_text" style="font-size:90%;"> </span><math id="alg2.l6.m1" class="ltx_Math" alttext="t=T{-}1" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">=</mo><mrow><mi mathsize="0.900em">T</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></mrow><annotation encoding="application/x-tex">t=T{-}1</annotation></semantics></math><span id="alg2.l6.6" class="ltx_text" style="font-size:90%;"> </span><span id="alg2.l6.7" class="ltx_text ltx_font_bold" style="font-size:90%;">downto</span><span id="alg2.l6.8" class="ltx_text" style="font-size:90%;"> </span><math id="alg2.l6.m2" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math><span id="alg2.l6.9" class="ltx_text" style="font-size:90%;"> </span><span id="alg2.l6.10" class="ltx_text ltx_font_bold" style="font-size:90%;">do</span><span id="alg2.l6.11" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg2.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
            
            
          <span id="alg2.l7.3" class="ltx_text" style="font-size:90%;">   </span><math id="alg2.l7.m1" class="ltx_Math" alttext="\mathcal{M}_{t}\leftarrow\textsc{SelectMask}(y^{(t+1)})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℳ</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps" mathsize="0.900em">SelectMask</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mi mathsize="0.900em">y</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{M}_{t}\leftarrow\textsc{SelectMask}(y^{(t+1)})</annotation></semantics></math><span id="alg2.l7.4" class="ltx_text" style="font-size:90%;">
</span><span id="alg2.l7.5" class="ltx_text" style="font-size:90%;float:right;"><math id="alg2.l7.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Choose subset of masked positions to fill at step <math id="alg2.l7.m3" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>
</span>
</div>
<div id="alg2.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
            
            
          <span id="alg2.l8.3" class="ltx_text" style="font-size:90%;">   </span><span id="alg2.l8.4" class="ltx_text ltx_font_bold" style="font-size:90%;">for</span><span id="alg2.l8.5" class="ltx_text" style="font-size:90%;"> each position </span><math id="alg2.l8.m1" class="ltx_Math" alttext="m\in\mathcal{M}_{t}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">m</mi><mo mathsize="0.900em">∈</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℳ</mi><mi mathsize="0.900em">t</mi></msub></mrow><annotation encoding="application/x-tex">m\in\mathcal{M}_{t}</annotation></semantics></math><span id="alg2.l8.6" class="ltx_text" style="font-size:90%;"> </span><span id="alg2.l8.7" class="ltx_text ltx_font_bold" style="font-size:90%;">do</span><span id="alg2.l8.8" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg2.l9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
            
            
          <span id="alg2.l9.3" class="ltx_text" style="font-size:90%;">      </span><span id="alg2.l9.4" class="ltx_text ltx_font_bold" style="font-size:90%;">for</span><span id="alg2.l9.5" class="ltx_text" style="font-size:90%;"> each candidate token </span><math id="alg2.l9.m1" class="ltx_Math" alttext="\mathrm{next}\in\mathcal{V}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">next</mi><mo mathsize="0.900em">∈</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒱</mi></mrow><annotation encoding="application/x-tex">\mathrm{next}\in\mathcal{V}</annotation></semantics></math><span id="alg2.l9.6" class="ltx_text" style="font-size:90%;"> </span><span id="alg2.l9.7" class="ltx_text ltx_font_bold" style="font-size:90%;">do</span><span id="alg2.l9.8" class="ltx_text" style="font-size:90%;"> </span><span id="alg2.l9.9" class="ltx_text" style="font-size:90%;float:right;"><math id="alg2.l9.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Can alternatively consider the top-<math id="alg2.l9.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> tokens only
</span>
</div>
<div id="alg2.l10" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
            
            
          <span id="alg2.l10.3" class="ltx_text" style="font-size:90%;">       </span><math id="alg2.l10.m1" class="ltx_Math" alttext="\ell(\mathrm{next})\leftarrow\log p\bigl(y^{(t)}_{m}{=}\mathrm{next}\mid y^{(t+1)}\bigr)" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.900em" mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">next</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mi mathsize="0.900em">log</mi><mo lspace="0.167em">⁡</mo><mrow><mi mathsize="0.900em">p</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mi mathsize="0.900em">y</mi><mi mathsize="0.900em">m</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">t</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msubsup><mo mathsize="0.900em">=</mo><mi mathsize="0.900em">next</mi></mrow><mo fence="true" lspace="0em" mathsize="0.900em" rspace="0em">∣</mo><msup><mi mathsize="0.900em">y</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\ell(\mathrm{next})\leftarrow\log p\bigl(y^{(t)}_{m}{=}\mathrm{next}\mid y^{(t+1)}\bigr)</annotation></semantics></math><span id="alg2.l10.4" class="ltx_text" style="font-size:90%;">
</span><span id="alg2.l10.5" class="ltx_text" style="font-size:90%;float:right;"><math id="alg2.l10.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Base model logits for current mask
</span>
</div>
<div id="alg2.l11" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
            
            
          <span id="alg2.l11.3" class="ltx_text" style="font-size:90%;">       </span><math id="alg2.l11.m1" class="ltx_Math" alttext="\hat{y}^{(t)}\leftarrow y^{(t+1)}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi mathsize="0.900em">y</mi><mo>^</mo></mover><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">t</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msup><mo mathsize="0.900em" stretchy="false">←</mo><msup><mi mathsize="0.900em">y</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\hat{y}^{(t)}\leftarrow y^{(t+1)}</annotation></semantics></math><span id="alg2.l11.4" class="ltx_text" style="font-size:90%;">; </span><math id="alg2.l11.m2" class="ltx_Math" alttext="\hat{y}^{(t)}_{m}\leftarrow\mathrm{next}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi mathsize="0.900em">y</mi><mo>^</mo></mover><mi mathsize="0.900em">m</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">t</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msubsup><mo mathsize="0.900em" stretchy="false">←</mo><mi mathsize="0.900em">next</mi></mrow><annotation encoding="application/x-tex">\hat{y}^{(t)}_{m}\leftarrow\mathrm{next}</annotation></semantics></math><span id="alg2.l11.5" class="ltx_text" style="font-size:90%;">
</span><span id="alg2.l11.6" class="ltx_text" style="font-size:90%;float:right;"><math id="alg2.l11.m3" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Temporarily fill mask with candidate token
</span>
</div>
<div id="alg2.l12" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
            
            
          <span id="alg2.l12.3" class="ltx_text" style="font-size:90%;">       </span><math id="alg2.l12.m1" class="ltx_Math" alttext="\hat{s}\leftarrow\mathrm{decode}(\hat{y}^{(t)})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi mathsize="0.900em">s</mi><mo>^</mo></mover><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mi mathsize="0.900em">decode</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mover accent="true"><mi mathsize="0.900em">y</mi><mo>^</mo></mover><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">t</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{s}\leftarrow\mathrm{decode}(\hat{y}^{(t)})</annotation></semantics></math><span id="alg2.l12.4" class="ltx_text" style="font-size:90%;">
</span><span id="alg2.l12.5" class="ltx_text" style="font-size:90%;float:right;"><math id="alg2.l12.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Form partially denoised sequence
</span>
</div>
<div id="alg2.l13" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
            
            
          <span id="alg2.l13.3" class="ltx_text" style="font-size:90%;">       </span><math id="alg2.l13.m1" class="ltx_Math" alttext="\pi\leftarrow\displaystyle\max_{s\in\mathcal{S}}E\bigl(\hat{s},s\bigr)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">π</mi><mo mathsize="0.900em" stretchy="false">←</mo><mrow><munder><mi mathsize="0.900em">max</mi><mrow><mi mathsize="0.900em">s</mi><mo mathsize="0.900em">∈</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒮</mi></mrow></munder><mo lspace="0.167em">⁡</mo><mrow><mi mathsize="0.900em">E</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mover accent="true"><mi mathsize="0.900em">s</mi><mo>^</mo></mover><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">s</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi\leftarrow\displaystyle\max_{s\in\mathcal{S}}E\bigl(\hat{s},s\bigr)</annotation></semantics></math><span id="alg2.l13.4" class="ltx_text" style="font-size:90%;">
</span><span id="alg2.l13.5" class="ltx_text" style="font-size:90%;float:right;"><math id="alg2.l13.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Similarity score with the most similar existing generation
</span>
</div>
<div id="alg2.l14" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
            
            
          <span id="alg2.l14.3" class="ltx_text" style="font-size:90%;">       </span><math id="alg2.l14.m1" class="ltx_Math" alttext="\ell^{\prime}(\mathrm{next})\leftarrow\ell(\mathrm{next})-\lambda\pi" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi mathsize="0.900em" mathvariant="normal">ℓ</mi><mo mathsize="0.900em">′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">next</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mrow><mi mathsize="0.900em" mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">next</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><mi mathsize="0.900em">λ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">π</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\ell^{\prime}(\mathrm{next})\leftarrow\ell(\mathrm{next})-\lambda\pi</annotation></semantics></math><span id="alg2.l14.4" class="ltx_text" style="font-size:90%;">
</span><span id="alg2.l14.5" class="ltx_text" style="font-size:90%;float:right;"><math id="alg2.l14.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Repel toward semantic novelty
</span>
</div>
<div id="alg2.l15" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
            
            
          <span id="alg2.l15.3" class="ltx_text" style="font-size:90%;">      </span><span id="alg2.l15.4" class="ltx_text ltx_font_bold" style="font-size:90%;">end</span><span id="alg2.l15.5" class="ltx_text" style="font-size:90%;"> </span><span id="alg2.l15.6" class="ltx_text ltx_font_bold" style="font-size:90%;">for</span>
</div>
<div id="alg2.l16" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
            
            
          <span id="alg2.l16.3" class="ltx_text" style="font-size:90%;">      </span><math id="alg2.l16.m1" class="ltx_Math" alttext="y^{(t)}_{m}\sim\mathrm{Categorical}\bigl(\mathrm{softmax}(\ell^{\prime})\bigr)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.900em">y</mi><mi mathsize="0.900em">m</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">t</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msubsup><mo mathsize="0.900em">∼</mo><mrow><mi mathsize="0.900em">Categorical</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi mathsize="0.900em">softmax</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mi mathsize="0.900em" mathvariant="normal">ℓ</mi><mo mathsize="0.900em">′</mo></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">y^{(t)}_{m}\sim\mathrm{Categorical}\bigl(\mathrm{softmax}(\ell^{\prime})\bigr)</annotation></semantics></math><span id="alg2.l16.4" class="ltx_text" style="font-size:90%;">
</span><span id="alg2.l16.5" class="ltx_text" style="font-size:90%;float:right;"><math id="alg2.l16.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Sample a token for the current masked position
</span>
</div>
<div id="alg2.l17" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l17.1" class="ltx_text" style="font-size:80%;">17:</span></span>
            
            
          <span id="alg2.l17.3" class="ltx_text" style="font-size:90%;">   </span><span id="alg2.l17.4" class="ltx_text ltx_font_bold" style="font-size:90%;">end</span><span id="alg2.l17.5" class="ltx_text" style="font-size:90%;"> </span><span id="alg2.l17.6" class="ltx_text ltx_font_bold" style="font-size:90%;">for</span>
</div>
<div id="alg2.l18" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l18.1" class="ltx_text" style="font-size:80%;">18:</span></span>
            
            
          <span id="alg2.l18.3" class="ltx_text" style="font-size:90%;">   </span><math id="alg2.l18.m1" class="ltx_Math" alttext="y^{(t)}\leftarrow\textsc{FillMasks}(y^{(t+1)},y^{(t)}_{\mathcal{M}_{t}})" display="inline" intent=":literal"><semantics><mrow><msup><mi mathsize="0.900em">y</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">t</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msup><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps" mathsize="0.900em">FillMasks</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mi mathsize="0.900em">y</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msup><mo mathsize="0.900em">,</mo><msubsup><mi mathsize="0.900em">y</mi><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℳ</mi><mi mathsize="0.900em">t</mi></msub><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">t</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">y^{(t)}\leftarrow\textsc{FillMasks}(y^{(t+1)},y^{(t)}_{\mathcal{M}_{t}})</annotation></semantics></math><span id="alg2.l18.4" class="ltx_text" style="font-size:90%;">
</span><span id="alg2.l18.5" class="ltx_text" style="font-size:90%;float:right;"><math id="alg2.l18.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Update denoised sequence
</span>
</div>
<div id="alg2.l19" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l19.1" class="ltx_text" style="font-size:80%;">19:</span></span>
            
            
          <span id="alg2.l19.3" class="ltx_text" style="font-size:90%;">  </span><span id="alg2.l19.4" class="ltx_text ltx_font_bold" style="font-size:90%;">end</span><span id="alg2.l19.5" class="ltx_text" style="font-size:90%;"> </span><span id="alg2.l19.6" class="ltx_text ltx_font_bold" style="font-size:90%;">for</span>
</div>
<div id="alg2.l20" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l20.1" class="ltx_text" style="font-size:80%;">20:</span></span>
            
            
          <span id="alg2.l20.3" class="ltx_text" style="font-size:90%;">  </span><math id="alg2.l20.m1" class="ltx_Math" alttext="s^{(i)}\leftarrow\mathrm{decode}(y^{(0)})" display="inline" intent=":literal"><semantics><mrow><msup><mi mathsize="0.900em">s</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">i</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msup><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mi mathsize="0.900em">decode</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mi mathsize="0.900em">y</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mn mathsize="0.900em">0</mn><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s^{(i)}\leftarrow\mathrm{decode}(y^{(0)})</annotation></semantics></math><span id="alg2.l20.4" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg2.l21" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l21.1" class="ltx_text" style="font-size:80%;">21:</span></span>
            
            
          <span id="alg2.l21.3" class="ltx_text" style="font-size:90%;">  </span><math id="alg2.l21.m1" class="ltx_Math" alttext="\mathcal{S}\!\leftarrow\!\mathcal{S}\,\cup\,\{s^{(i)}\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒮</mi><mo lspace="0.128em" mathsize="0.900em" rspace="0.128em" stretchy="false">←</mo><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒮</mi><mo lspace="0.392em" mathsize="0.900em" rspace="0.392em">∪</mo><mrow><mo stretchy="false">{</mo><msup><mi mathsize="0.900em">s</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">i</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msup><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{S}\!\leftarrow\!\mathcal{S}\,\cup\,\{s^{(i)}\}</annotation></semantics></math><span id="alg2.l21.4" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg2.l22" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l22.1" class="ltx_text" style="font-size:80%;">22:</span></span>
            
            
          <span id="alg2.l22.3" class="ltx_text ltx_font_bold" style="font-size:90%;">end</span><span id="alg2.l22.4" class="ltx_text" style="font-size:90%;"> </span><span id="alg2.l22.5" class="ltx_text ltx_font_bold" style="font-size:90%;">for</span>
</div>
<div id="alg2.l23" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l23.1" class="ltx_text" style="font-size:80%;">23:</span></span>
            
            
          <span id="alg2.l23.3" class="ltx_text ltx_font_bold" style="font-size:90%;">return</span><span id="alg2.l23.4" class="ltx_text" style="font-size:90%;"> </span><math id="alg2.l23.m1" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math><span id="alg2.l23.5" class="ltx_text" style="font-size:90%;">
</span>
