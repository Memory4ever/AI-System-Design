            <span id="alg1.l7.3" class="ltx_text" style="font-size:90%;">  </span><span id="alg1.l7.4" class="ltx_text ltx_font_bold" style="font-size:90%;">while</span><span id="alg1.l7.5" class="ltx_text" style="font-size:90%;"> </span><math id="alg1.l7.m1" class="ltx_Math" alttext="\mathrm{token}\neq\texttt{&lt;EOS&gt;}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">token</mi><mo mathsize="0.900em">≠</mo><mtext class="ltx_mathvariant_monospace" mathsize="0.900em">&lt;EOS&gt;</mtext></mrow><annotation encoding="application/x-tex">\mathrm{token}\neq\texttt{&lt;EOS&gt;}</annotation></semantics></math><span id="alg1.l7.6" class="ltx_text" style="font-size:90%;"> </span><span id="alg1.l7.7" class="ltx_text ltx_font_bold" style="font-size:90%;">do</span><span id="alg1.l7.8" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg1.l8" class="ltx_listingline">
