<div id="lstnumberx108" class="ltx_listingline">1.<span id="lstnumberx108.1" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx108.2" class="ltx_text ltx_lst_identifier">Think</span><span id="lstnumberx108.3" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx108.4" class="ltx_text ltx_lst_identifier">deeply</span><span id="lstnumberx108.5" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx108.6" class="ltx_text ltx_lst_identifier">and</span><span id="lstnumberx108.7" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx108.8" class="ltx_text ltx_lst_identifier">carefully</span><span id="lstnumberx108.9" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx108.10" class="ltx_text ltx_lst_identifier">about</span><span id="lstnumberx108.11" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx108.12" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx108.13" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx108.14" class="ltx_text ltx_lst_identifier">game</span><span id="lstnumberx108.15" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx108.16" class="ltx_text ltx_lst_identifier">situation</span>,<span id="lstnumberx108.17" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx108.18" class="ltx_text ltx_lst_identifier">and</span><span id="lstnumberx108.19" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx108.20" class="ltx_text ltx_lst_identifier">enclose</span><span id="lstnumberx108.21" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx108.22" class="ltx_text ltx_lst_identifier">this</span><span id="lstnumberx108.23" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx108.24" class="ltx_text ltx_lst_identifier">reasoning</span><span id="lstnumberx108.25" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx108.26" class="ltx_text ltx_lst_identifier">within</span><span id="lstnumberx108.27" class="ltx_text ltx_lst_space"> </span>‘&lt;<span id="lstnumberx108.28" class="ltx_text ltx_lst_identifier">thinking</span>&gt;‘<span id="lstnumberx108.29" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx108.30" class="ltx_text ltx_lst_identifier">and</span><span id="lstnumberx108.31" class="ltx_text ltx_lst_space"> </span>‘&lt;/<span id="lstnumberx108.32" class="ltx_text ltx_lst_identifier">thinking</span>&gt;‘<span id="lstnumberx108.33" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx108.34" class="ltx_text ltx_lst_identifier">tags</span>.<span id="lstnumberx108.35" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx108.36" class="ltx_text ltx_lst_identifier">You</span><span id="lstnumberx108.37" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx108.38" class="ltx_text ltx_lst_identifier">must</span><span id="lstnumberx108.39" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx108.40" class="ltx_text ltx_lst_identifier">select</span><span id="lstnumberx108.41" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx108.42" class="ltx_text ltx_lst_identifier">ONE</span><span id="lstnumberx108.43" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx108.44" class="ltx_text ltx_lst_identifier">move</span><span id="lstnumberx108.45" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx108.46" class="ltx_text ltx_lst_identifier">that</span><span id="lstnumberx108.47" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx108.48" class="ltx_text ltx_lst_identifier">maximizes</span><span id="lstnumberx108.49" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx108.50" class="ltx_text ltx_lst_identifier">your</span><span id="lstnumberx108.51" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx108.52" class="ltx_text ltx_lst_identifier">chances</span><span id="lstnumberx108.53" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx108.54" class="ltx_text ltx_lst_identifier">of</span><span id="lstnumberx108.55" class="ltx_text ltx_lst_space"> </span><