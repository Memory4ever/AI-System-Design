</div>
<div id="algorithm1.6.12" class="ltx_listingline"><span id="algorithm1.6.12.1" class="ltx_text" style="font-size:70%;">  </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm1.6.12.2" class="ltx_text" style="font-size:70%;">           </span><math id="algorithm1.m12" class="ltx_Math" alttext="\nabla_{\boldsymbol{\theta}}\|\mathbf{n}-\hat{\mathbf{n}}(\mathbf{y}_{t},t;\boldsymbol{\theta})\|^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mo mathsize="0.700em">∇</mo><mi mathsize="0.700em">𝜽</mi></msub><msup><mrow><mo maxsize="0.700em" minsize="0.700em" stretchy="true">‖</mo><mrow><mi mathsize="0.700em">𝐧</mi><mo mathsize="0.700em">−</mo><mrow><mover accent="true"><mi mathsize="0.700em">𝐧</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">𝐲</mi><mi mathsize="0.700em">t</mi></msub><mo mathsize="0.700em">,</mo><mi mathsize="0.700em">t</mi><mo mathsize="0.700em">,</mo><mi mathsize="0.700em">𝜽</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></mrow><mo maxsize="0.700em" minsize="0.700em" stretchy="true">‖</mo></mrow><mn mathsize="0.700em">2</mn></msup></mrow><annotation encoding="application/x-tex">\nabla_{\boldsymbol{\theta}}\|\mathbf{n}-\hat{\mathbf{n}}(\mathbf{y}_{t},t;\boldsymbol{\theta})\|^{2}</annotation></semantics></math><span id="algorithm1.6.12.3" class="ltx_text" style="font-size:70%;">;</span>
</div>
