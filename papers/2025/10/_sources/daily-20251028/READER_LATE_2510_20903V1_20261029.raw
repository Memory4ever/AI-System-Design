<td id="A2.T6.5.1.4.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-bottom: 14.0pt;"><math id="A2.T6.m12" class="ltx_Math" alttext="\dfrac{a}{2}\displaystyle\int_{\eta_{0}}^{\eta_{1}}\!s_{-}(\eta)\,\mathbb{E}_{\mathbf{n}}[\|\mathbf{n}-\hat{\mathbf{n}}(\mathbf{y}_{t},\eta;{\boldsymbol{\theta}})\|_{2}^{2}]\,d\eta" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi mathsize="0.900em">a</mi><mn mathsize="0.900em">2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo maxsize="0.900em" minsize="0.900em" stretchy="true">∫</mo><msub><mi mathsize="0.900em">η</mi><mn mathsize="0.900em">0</mn></msub><msub><mi mathsize="0.900em">η</mi><mn mathsize="0.900em">1</mn></msub></msubsup></mstyle><mrow><msub><mi mathsize="0.900em">s</mi><mo mathsize="0.900em">−</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">η</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi mathsize="0.900em">𝔼</mi><mi mathsize="0.900em">𝐧</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><msubsup><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mi mathsize="0.900em">𝐧</mi><mo mathsize="0.900em">−</mo><mrow><mover accent="true"><mi mathsize="0.900em">𝐧</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝐲</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">η</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">𝜽</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mn mathsize="0.900em">2</mn><mn mathsize="0.900em">2</mn></msubsup><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo mathsize="0.900em" rspace="0em">𝑑</mo><mi mathsize="0.900em">η</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\dfrac{a}{2}\displaystyle\int_{\eta_{0}}^{\eta_{1}}\!s_{-}(\eta)\,\mathbb{E}_{\mathbf{n}}[\|\mathbf{n}-\hat{\mathbf{n}}(\mathbf{y}_{t},\eta;{\boldsymbol{\theta}})\|_{2}^{2}]\,d\eta</annotation></semantics></math></td>
<td id="A2.T6.5.1.4.3" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_bb" style="padding-bottom: 14.0pt;"><math id="A2.T6.m13" class="ltx_Math" alttext="\displaystyle\int_{\eta_{0}}^{\eta_{1}}\!s_{-}(2\eta)\,\mathbb{E}_{\mathbf{n}}\,[\|\mathbf{n}-\hat{\mathbf{n}}(\mathbf{y}_{t},\eta;{\boldsymbol{\theta}})\|_{2}^{2}]\,\mathrm{d}\eta" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msubsup><mo maxsize="0.900em" minsize="0.900em" stretchy="true">∫</mo><msub><mi mathsize="0.900em">η</mi><mn mathsize="0.900em">0</mn></msub><msub><mi mathsize="0.900em">η</mi><mn mathsize="0.900em">1</mn></msub></msubsup></mstyle><mrow><msub><mi mathsize="0.900em">s</mi><mo mathsize="0.900em">−</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi mathsize="0.900em">𝔼</mi><mi mathsize="0.900em">𝐧</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><msubsup><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mi mathsize="0.900em">𝐧</mi><mo mathsize="0.900em">−</mo><mrow><mover accent="true"><mi mathsize="0.900em">𝐧</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝐲</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">η</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">𝜽</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mn mathsize="0.900em">2</mn><mn mathsize="0.900em">2</mn></msubsup><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo mathsize="0.900em" rspace="0em">𝑑</mo><mi mathsize="0.900em">η</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{\eta_{0}}^{\eta_{1}}\!s_{-}(2\eta)\,\mathbb{E}_{\mathbf{n}}\,[\|\mathbf{n}-\hat{\mathbf{n}}(\mathbf{y}_{t},\eta;{\boldsymbol{\theta}})\|_{2}^{2}]\,\mathrm{d}\eta</annotation></semantics></math></td></tr>
</tbody>
</table>
</span></div>
</figure>
<div id="A2.SS4.SSS0.Px3.p2" class="ltx_para">
<p id="A2.SS4.SSS0.Px3.p2.1" class="ltx_p">Thus, we can derive their specific objectives and equivalent predictors using the formula for general noise schedules. We summarize them in Table <a href="#A2.T5" title="Table 5 ‣ Squashed Hyperbolic tangent. ‣ B.4 Log-SNR-Timed Channel with Different Variance Functions ‣ Appendix B Improve the Likelihood Estimation Bounds ‣ Information Theoretic Learning for Diffusion Models with Warm Start" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> and Table <a href="#A2.T6" title="Table 6 ‣ Squashed Hyperbolic tangent. ‣ B.4 Log-SNR-Timed Channel with Different Variance Functions ‣ Appendix B Improve the Likelihood Estimation Bounds ‣ Information Theoretic Learning for Diffusion Models with Warm Start" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>.</p>
</div>
</section>
</section>
<section id="A2.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.5 </span>Empirical Results</h3>

