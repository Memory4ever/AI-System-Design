<td id="A2.T7.st1.5.4.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="A2.T7.st1.5.4.2.1" class="ltx_text" style="font-size:90%;">2.50</span></td>
<td id="A2.T7.st1.5.4.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="A2.T7.st1.5.4.3.1" class="ltx_text" style="font-size:90%;">2.78</span></td></tr>
