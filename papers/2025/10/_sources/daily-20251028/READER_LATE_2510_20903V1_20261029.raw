<td id="S5.T1.5.6.7" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S5.T1.5.6.7.1" class="ltx_text" style="font-size:70%;">1.6</span></td></tr>
<tr id="S5.T1.5.7" class="ltx_tr">
