<div id="algorithm1.6.5" class="ltx_listingline"><span id="algorithm1.6.5.1" class="ltx_text" style="font-size:70%;">  </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm1.6.5.2" class="ltx_text" style="font-size:70%;">   </span><math id="algorithm1.m5" class="ltx_Math" alttext="\tilde{\mathbf{x}}\leftarrow\alpha_{0}\cdot\mathbf{x}+\sigma(0)\cdot\mathbf{u}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi mathsize="0.700em">𝐱</mi><mo>~</mo></mover><mo mathsize="0.700em" stretchy="false">←</mo><mrow><mrow><msub><mi mathsize="0.700em">α</mi><mn mathsize="0.700em">0</mn></msub><mo lspace="0.222em" mathsize="0.700em" rspace="0.222em">⋅</mo><mi mathsize="0.700em">𝐱</mi></mrow><mo mathsize="0.700em">+</mo><mrow><mrow><mi mathsize="0.700em">σ</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mn mathsize="0.700em">0</mn><mo maxsize="0.700em" minsize="0.700em" rspace="0.055em">)</mo></mrow></mrow><mo mathsize="0.700em" rspace="0.222em">⋅</mo><mi mathsize="0.700em">𝐮</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{\mathbf{x}}\leftarrow\alpha_{0}\cdot\mathbf{x}+\sigma(0)\cdot\mathbf{u}</annotation></semantics></math><span id="algorithm1.6.5.3" class="ltx_text" style="font-size:70%;">;      
