<td id="A2.T13.5.6.3" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;"><span id="A2.T13.5.6.3.1" class="ltx_text ltx_font_italic">Total = 2.51</span></td></tr>
