<td id="A1.T5.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t">71.7</td>
<td id="A1.T5.2.1.3.4" class="ltx_td ltx_align_center ltx_border_t">84.9</td>
<td id="A1.T5.2.1.3.5" class="ltx_td ltx_align_center ltx_border_t">80.2</td>
