<td id="A1.T5.2.1.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="A1.T5.2.1.2.5.1" class="ltx_text ltx_font_bold">FP-S</span></td>
<td id="A1.T5.2.1.2.6" class="ltx_td ltx_align_center ltx_border_t"><span id="A1.T5.2.1.2.6.1" class="ltx_text ltx_font_bold">FP-C</span></td>
<td id="A1.T5.2.1.2.7" class="ltx_td ltx_align_center ltx_border_t"><span id="A1.T5.2.1.2.7.1" class="ltx_text ltx_font_bold">CP</span></td></tr>
<tr id="A1.T5.2.1.3" class="ltx_tr">
