<td id="S4.T2.4.1.5.5" class="ltx_td ltx_align_center">60.1%</td>
<td id="S4.T2.4.1.5.6" class="ltx_td ltx_align_center">0.710</td>
<td id="S4.T2.4.1.5.7" class="ltx_td ltx_align_center ltx_border_r">5.79</td>
<td id="S4.T2.4.1.5.8" class="ltx_td ltx_align_center">65.2%</td>
<td id="S4.T2.4.1.5.9" class="ltx_td ltx_align_center">0.946</td>
<td id="S4.T2.4.1.5.10" class="ltx_td ltx_align_center ltx_border_r">9.83</td>
<td id="S4.T2.4.1.5.11" class="ltx_td ltx_align_center">82.3%</td></tr>
<tr id="S4.T2.4.1.6" class="ltx_tr">
<td id="S4.T2.4.1.6.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">GA</td>
