</thead>
<tbody class="ltx_tbody">
<tr id="A3.T5.5.1.3" class="ltx_tr">
<th id="A3.T5.5.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" style="padding-top:0.4pt;padding-bottom:0.4pt;" rowspan="4"><span id="A3.T5.5.1.3.1.1" class="ltx_text" style="font-size:70%;">
<span id="A3.T5.5.1.3.1.1.1" class="ltx_inline-block ltx_align_center">
<span id="A3.T5.5.1.3.1.1.1.1" class="ltx_p"><span id="A3.T5.5.1.3.1.1.1.1.1" class="ltx_text ltx_font_typewriter">Amazon</span></span>
<span id="A3.T5.5.1.3.1.1.1.2" class="ltx_p"><span id="A3.T5.5.1.3.1.1.1.2.1" class="ltx_text ltx_font_typewriter">Polarity</span></span>
