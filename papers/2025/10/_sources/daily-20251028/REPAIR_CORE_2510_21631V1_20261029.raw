<th id="A3.T5.5.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-top:0.4pt;padding-bottom:0.4pt;" colspan="6"><span id="A3.T5.5.1.1.2.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Total Samples (<math id="A3.T5.m9" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>)</span></th></tr>
