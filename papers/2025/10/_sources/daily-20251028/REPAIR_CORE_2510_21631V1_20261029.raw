<th id="A3.T5.5.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:0.4pt;padding-bottom:0.4pt;"><span id="A3.T5.5.1.2.3.1" class="ltx_text ltx_font_bold" style="font-size:70%;">8</span></th>
