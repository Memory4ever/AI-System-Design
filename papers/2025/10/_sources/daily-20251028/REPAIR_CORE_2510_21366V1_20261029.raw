                        <span class="ltx_tag ltx_tag_listingline"><span id="algx2.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
                        
                        
                      <span id="algx2.l4.3" class="ltx_text" style="font-size:90%;">  </span><math id="algx2.l4.m1" class="ltx_Math" alttext="\hat{\boldsymbol{\epsilon}}_{\theta}\leftarrow\boldsymbol{\epsilon}_{\theta}(\mathbf{x}_{t},t,H_{\text{target}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_mathvariant_bold-italic" mathsize="0.900em" mathvariant="bold-italic">ϵ</mi><mo>^</mo></mover><mi mathsize="0.900em">θ</mi></msub><mo mathsize="0.900em" stretchy="false">←</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathsize="0.900em" mathvariant="bold-italic">ϵ</mi><mi mathsize="0.900em">θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝐱</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">H</mi><mtext mathsize="0.900em">target</mtext></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\boldsymbol{\epsilon}}_{\theta}\leftarrow\boldsymbol{\epsilon}_{\theta}(\mathbf{x}_{t},t,H_{\text{target}})</annotation></semantics></math><span id="algx2.l4.4" class="ltx_text" style="font-size:90%;">
</span>
