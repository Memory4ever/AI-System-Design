<td id="S4.T1.7.3.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T1.7.3.6.1" class="ltx_text" style="font-size:80%;">28.5</span></td>
<td id="S4.T1.7.3.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T1.7.3.7.1" class="ltx_text" style="font-size:80%;">16.2</span></td>
