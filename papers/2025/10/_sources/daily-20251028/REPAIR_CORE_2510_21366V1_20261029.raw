                      <math id="algx2.l2.m1" class="ltx_Math" alttext="\mathbf{x}_{T}\sim\mathcal{N}(\mathbf{0},\mathbf{I})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">𝐱</mi><mi mathsize="0.900em">T</mi></msub><mo mathsize="0.900em">∼</mo><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒩</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mn mathsize="0.900em">𝟎</mn><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">𝐈</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}_{T}\sim\mathcal{N}(\mathbf{0},\mathbf{I})</annotation></semantics></math><span id="algx2.l2.3" class="ltx_text" style="font-size:90%;">
</span>
</span>
<span id="algx2.l3" class="ltx_listingline">
                        <span class="ltx_tag ltx_tag_listingline"><span id="algx2.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
                        
                        
                      <span id="algx2.l3.3" class="ltx_text ltx_font_bold" style="font-size:90%;">for</span><span id="algx2.l3.4" class="ltx_text" style="font-size:90%;"> </span><math id="algx2.l3.m1" class="ltx_Math" alttext="t=T,\dots,1" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">=</mo><mi mathsize="0.900em">T</mi></mrow><mo mathsize="0.900em">,</mo><mi mathsize="0.900em" mathvariant="normal">…</mi><mo mathsize="0.900em">,</mo><mn mathsize="0.900em">1</mn></mrow><annotation encoding="application/x-tex">t=T,\dots,1</annotation></semantics></math><span id="algx2.l3.5" class="ltx_text" style="font-size:90%;"> </span><span id="algx2.l3.6" class="ltx_text ltx_font_bold" style="font-size:90%;">do</span><span id="algx2.l3.7" class="ltx_text" style="font-size:90%;">
</span>
