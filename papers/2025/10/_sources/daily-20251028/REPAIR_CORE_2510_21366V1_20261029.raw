                      <span id="algx2.l1.3" class="ltx_text" style="font-size:90%;">target entropy </span><math id="algx2.l1.m1" class="ltx_Math" alttext="H_{\text{target}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">H</mi><mtext mathsize="0.900em">target</mtext></msub><annotation encoding="application/x-tex">H_{\text{target}}</annotation></semantics></math><span id="algx2.l1.4" class="ltx_text" style="font-size:90%;">
