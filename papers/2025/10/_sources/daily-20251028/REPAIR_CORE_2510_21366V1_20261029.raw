<th id="S4.T5.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Cascade (SD + LIC)</th>
<td id="S4.T5.2.1.3.2" class="ltx_td ltx_align_center">30.7</td>
<td id="S4.T5.2.1.3.3" class="ltx_td ltx_align_center">19.2</td>
<td id="S4.T5.2.1.3.4" class="ltx_td ltx_align_center">13.1</td></tr>
<tr id="S4.T5.2.1.4" class="ltx_tr">
<th id="S4.T5.2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Early-Stop + LIC</th>
<td id="S4.T5.2.1.4.2" class="ltx_td ltx_align_center">41.8</td>
<td id="S4.T5.2.1.4.3" class="ltx_td ltx_align_center">27.5</td>
<td id="S4.T5.2.1.4.4" class="ltx_td ltx_align_center">18.0</td></tr>
