<th id="S4.T3.1.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Time<math id="S4.SS3.m4" class="ltx_Math" alttext="\!\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\!\downarrow</annotation></semantics></math></th></tr>
</thead>
<tbody class="ltx_tbody">
