tex">\{\tilde{C}_{n_{T},1,1:(T/2)},\tilde{C}_{n_{T},1,(T/2+1):T}\}\leftarrow\{\tilde{C}_{(n_{T}-1),L,(T/2+1):T},\ \tilde{C}_{(n_{T}-1),L,T}+\sigma_{\text{conf}}\epsilon_{\text{conf}}\}</annotation></semantics></math>

