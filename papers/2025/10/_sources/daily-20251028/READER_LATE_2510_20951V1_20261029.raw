            <math id="algorithm1.m28" class="ltx_math_unparsed" alttext="\texttt{frame\_inds}\leftarrow\texttt{repeat}(\texttt{cat}(\{t\}_{t=0}^{T-1},1),\ \text{``}T\rightarrow T\ N_{P^{q}}\ 1\text{''})\in\mathbb{R}^{T\times N_{P^{q}}\times 1}" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">frame_inds</mtext><mo stretchy="false">←</mo><mtext class="ltx_mathvariant_monospace">repeat</mtext><mrow><mo stretchy="false">(</mo><mtext class="ltx_mathvariant_monospace">cat</mtext><mrow><mo stretchy="false">(</mo><msubsup><mrow><mo stretchy="false">{</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo rspace="0.667em">,</mo><mtext>“</mtext><mi>T</mi><mo stretchy="false">→</mo><mi>T</mi><msub><mi>N</mi><msup><mi>P</mi><mi>q</mi></msup></msub><mn> 1</mn><mtext>”</mtext><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>T</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>N</mi><msup><mi>P</mi><mi>q</mi></msup></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\texttt{frame\_inds}\leftarrow\texttt{repeat}(\texttt{cat}(\{t\}_{t=0}^{T-1},1),\ \text{``}T\rightarrow T\ N_{P^{q}}\ 1\text{''})\in\mathbb{R}^{T\times N_{P^{q}}\times 1}</annotation></semantics></math>

