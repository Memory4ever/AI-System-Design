            <span id="algorithm2.4.19.2" class="ltx_text ltx_font_bold">if</span> <em id="algorithm2.4.19.3" class="ltx_emph ltx_font_italic"><math id="algorithm2.m26" class="ltx_Math" alttext="n_{T}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n_{T}=1</annotation></semantics></math></em> <span id="algorithm2.4.19.4" class="ltx_text ltx_font_bold">then</span>
