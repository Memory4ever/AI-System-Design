<div id="algorithm2.4.31" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.31.1" class="ltx_text ltx_font_bold">20</span></span>
            <span id="algorithm2.4.31.2" class="ltx_text ltx_font_bold">for</span> <em id="algorithm2.4.31.3" class="ltx_emph ltx_font_italic"><math id="algorithm2.m33" class="ltx_Math" alttext="l\leftarrow 1" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo stretchy="false">←</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">l\leftarrow 1</annotation></semantics></math> <span id="algorithm2.4.31.3.1" class="ltx_text ltx_font_bold ltx_font_upright">to</span> <math id="algorithm2.m34" class="ltx_Math" alttext="L-1" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">L-1</annotation></semantics></math></em> <span id="algorithm2.4.31.4" class="ltx_text ltx_font_bold">do</span>
</div>
