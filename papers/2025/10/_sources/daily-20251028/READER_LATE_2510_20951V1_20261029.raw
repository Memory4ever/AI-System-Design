            <math id="algorithm1.m33" class="ltx_math_unparsed" alttext="\{\tilde{P}_{n_{T},1,1:(T/2)},\tilde{P}_{n_{T},1,(T/2+1):T}\}\leftarrow\{\hat{P}_{(n_{T}-1),K,l,(T/2+1):T},\ \hat{P}_{(n_{T}-1),K,l,T}+\sigma_{\text{coord}}\epsilon_{\text{coord}}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi>P</mi><mo>~</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mn>1</mn><mo>,</mo><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>P</mi><mo>~</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mn>1</mn><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>T</mi><mo>/</mo><mn>2</mn></mrow><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>T</mi></mrow></mrow></msub><mo stretchy="false">}</mo></mrow><mo stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>K</mi><mo>,</mo><mi>l</mi><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>T</mi><mo>/</mo><mn>2</mn></mrow><mo>+</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>T</mi></mrow></mrow></msub><mo rspace="0.667em">,</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>K</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>T</mi></mrow></msub><mo>+</mo><msub><mi>σ</mi><mtext>coord</mtext></msub><msub><mi>ϵ</mi><mtext>coord</mtext></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\{\tilde{P}_{n_{T},1,1:(T/2)},\tilde{P}_{n_{T},1,(T/2+1):T}\}\leftarrow\{\hat{P}_{(n_{T}-1),K,l,(T/2+1):T},\ \hat{P}_{(n_{T}-1),K,l,T}+\sigma_{\text{coord}}\epsilon_{\text{coord}}\}</annotation></semantics></math>

