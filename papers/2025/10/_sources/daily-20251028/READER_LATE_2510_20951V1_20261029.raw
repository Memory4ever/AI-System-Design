>\{\tilde{V}_{n_{T},1,1:(T/2)},\tilde{V}_{n_{T},1,(T/2+1):T}\}\leftarrow\{\tilde{V}_{(n_{T}-1),L,(T/2+1):T},\ \tilde{V}_{(n_{T}-1),L,T}+\sigma_{\text{vis}}\epsilon_{\text{vis}}\}</annotation></semantics></math>

