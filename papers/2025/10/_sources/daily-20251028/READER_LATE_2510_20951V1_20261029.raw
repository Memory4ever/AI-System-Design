row><annotation encoding="application/x-tex">\{\tilde{C}_{n_{T},1,1:(T/2)},\tilde{C}_{n_{T},1,(T/2+1):T}\}\leftarrow\{\hat{C}_{(n_{T}-1),K,l,(T/2+1):T},\ \hat{C}_{(n_{T}-1),K,l,T}+\sigma_{\text{conf}}\epsilon_{\text{conf}}\}</annotation></semantics></math>

</div>
