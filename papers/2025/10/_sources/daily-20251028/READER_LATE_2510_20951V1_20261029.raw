<annotation encoding="application/x-tex">\{\tilde{V}_{n_{T},1,1:(T/2)},\tilde{V}_{n_{T},1,(T/2+1):T}\}\leftarrow\{\hat{V}_{(n_{T}-1),K,l,(T/2+1):T},\ \hat{V}_{(n_{T}-1),K,l,T}+\sigma_{\text{vis}}\epsilon_{\text{vis}}\}</annotation></semantics></math>

